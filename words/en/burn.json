{
    "word_family": [
        "burner",
        "burning",
        "burnout",
        "sunburn",
        "heartburn",
        "afterburn"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d545f1ac-70a3-35f7-b5a8-e14a821d9a60",
                    "sense_definition": "To destroy, damage, or consume something by fire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fire_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>burned</w> the old letters in the fireplace to destroy the evidence.",
                            "target_lang_translations": {
                                "ru": "Он <w>сжёг</w> старые письма в камине, чтобы уничтожить улики.",
                                "zh": "他在壁炉里<w>烧毁</w>了旧信件以销毁证据。",
                                "de": "Er <w>verbrannte</w> die alten Briefe im Kamin, um die Beweise zu vernichten."
                            }
                        },
                        {
                            "text": "Farmers often <w>burn</w> the fields after the harvest to clear the land.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто <w>сжигают</w> поля после сбора урожая, чтобы очистить землю.",
                                "zh": "农民常在收获后<w>焚烧</w>田地以清理土地。",
                                "de": "Landwirte <w>verbrennen</w> oft die Felder nach der Ernte, um das Land zu roden."
                            }
                        }
                    ],
                    "synonyms": [
                        "incinerate",
                        "torch"
                    ],
                    "common_phrases": [
                        "burn down",
                        "burn to the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничтожать, повреждать или поглощать что-либо огнем.",
                        "zh": "通过火来销毁、损坏或消耗某物。",
                        "de": "Etwas durch Feuer zerstören, beschädigen oder verbrauchen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжигать",
                                "target_lang_sense_clarification": "уничтожать огнем"
                            },
                            {
                                "target_lang_word": "сжечь",
                                "target_lang_sense_clarification": "уничтожить огнем (сов. вид)"
                            },
                            {
                                "target_lang_word": "жечь",
                                "target_lang_sense_clarification": "предавать огню"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烧毁",
                                "target_lang_sense_clarification": "用火彻底破坏"
                            },
                            {
                                "target_lang_word": "焚烧",
                                "target_lang_sense_clarification": "正式的烧毁"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verbrennen",
                                "target_lang_sense_clarification": "etwas durch Feuer vernichten"
                            },
                            {
                                "target_lang_word": "niederbrennen",
                                "target_lang_sense_clarification": "ein Gebäude oder eine Fläche vollständig durch Feuer zerstören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87de5871-b1ee-3cd6-b4ea-2a51d5b77fa4",
                    "sense_definition": "To be on fire or to be destroyed by flames.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fire_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle <w>burned</w> brightly on the table throughout the dinner.",
                            "target_lang_translations": {
                                "ru": "Свеча ярко <w>горела</w> на столе во время ужина.",
                                "zh": "晚餐期间，蜡烛在桌上明亮地<w>燃烧</w>着。",
                                "de": "Die Kerze <w>brannte</w> während des gesamten Abendessens hell auf dem Tisch."
                            }
                        },
                        {
                            "text": "We watched helplessly as the old wooden barn <w>burned</w>.",
                            "target_lang_translations": {
                                "ru": "Мы беспомощно смотрели, как <w>горел</w> старый деревянный сарай.",
                                "zh": "我们无助地看着那座旧木谷仓在<w>烧</w>。",
                                "de": "Wir sahen hilflos zu, wie die alte Holzscheune <w>brannte</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "combust",
                        "go up",
                        "blaze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть охваченным огнем или уничтожаться пламенем.",
                        "zh": "处于燃烧状态或被火焰摧毁。",
                        "de": "In Flammen stehen oder durch Feuer zerstört werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гореть",
                                "target_lang_sense_clarification": "быть в огне"
                            },
                            {
                                "target_lang_word": "сгореть",
                                "target_lang_sense_clarification": "быть уничтоженным огнем"
                            },
                            {
                                "target_lang_word": "пылать",
                                "target_lang_sense_clarification": "ярко гореть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "燃烧",
                                "target_lang_sense_clarification": "处于着火状态"
                            },
                            {
                                "target_lang_word": "烧",
                                "target_lang_sense_clarification": "着火"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "brennen",
                                "target_lang_sense_clarification": "in Flammen stehen, dem Feuer ausgesetzt sein"
                            },
                            {
                                "target_lang_word": "in Flammen stehen",
                                "target_lang_sense_clarification": "weithin sichtbar brennen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "045a0995-1a81-3672-848b-ecaa17052907",
                    "sense_definition": "To injure a person or part of the body with heat, chemicals, or radiation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>burn</w> your hand on the hot stove.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>обожги</w> руку о горячую плиту.",
                                "zh": "小心别让热炉子<w>烫伤</w>了你的手。",
                                "de": "Pass auf, dass du dir nicht die Hand am heißen Herd <w>verbrennst</w>."
                            }
                        },
                        {
                            "text": "She <w>burned</w> her shoulders because she stayed in the sun too long.",
                            "target_lang_translations": {
                                "ru": "Она <w>обожгла</w> плечи, потому что слишком долго была на солнце.",
                                "zh": "她因为在太阳下待得太久，肩膀被<w>晒伤</w>了。",
                                "de": "Sie hat sich die Schultern <w>verbrannt</w>, weil sie zu lange in der Sonne war."
                            }
                        }
                    ],
                    "synonyms": [
                        "singe",
                        "scald",
                        "scorch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Травмировать человека или часть тела теплом, химикатами или излучением.",
                        "zh": "因热、化学物质或辐射而伤害人体或身体部位。",
                        "de": "Sich oder eine andere Person durch Hitze, Chemikalien oder Strahlung verletzen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжечь",
                                "target_lang_sense_clarification": "нанести ожог"
                            },
                            {
                                "target_lang_word": "обжигать",
                                "target_lang_sense_clarification": "наносить ожог (несов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烫伤",
                                "target_lang_sense_clarification": "因热液体或物体受伤"
                            },
                            {
                                "target_lang_word": "烧伤",
                                "target_lang_sense_clarification": "因火或高温受伤"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verbrennen",
                                "target_lang_sense_clarification": "sich durch Hitze oder Feuer eine Verletzung zuziehen"
                            },
                            {
                                "target_lang_word": "sich verbrühen",
                                "target_lang_sense_clarification": "sich durch heiße Flüssigkeiten oder Dampf verletzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39946b75-01fd-33e8-844e-4aecd4a2bf56",
                    "sense_definition": "To cook food for too long so that it becomes black, bitter, or unusable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally <w>burned</w> the toast while talking on the phone.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>сжёг</w> тост, пока разговаривал по телефону.",
                                "zh": "我打电话时一不小心把吐司<w>烧焦</w>了。",
                                "de": "Ich habe versehentlich den Toast <w>verbrannt</w>, während ich telefonierte."
                            }
                        },
                        {
                            "text": "The chef was upset because he <w>burned</w> the steak.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар расстроился, потому что <w>сжёг</w> стейк.",
                                "zh": "厨师很沮丧，因为他把牛排<w>煎糊</w>了。",
                                "de": "Der Koch war verärgert, weil er das Steak <w>verbrannt</w> hatte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить еду слишком долго, так что она чернеет, становится горькой или непригодной.",
                        "zh": "烹饪时间过长导致食物变黑、变苦或无法食用。",
                        "de": "Essen zu lange kochen, sodass es schwarz, bitter oder ungenießbar wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжечь",
                                "target_lang_sense_clarification": "испортить еду огнем"
                            },
                            {
                                "target_lang_word": "спалить",
                                "target_lang_sense_clarification": "разг. испортить готовкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烧焦",
                                "target_lang_sense_clarification": "因过热而变黑"
                            },
                            {
                                "target_lang_word": "糊",
                                "target_lang_sense_clarification": "烹饪过头"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anbrennen",
                                "target_lang_sense_clarification": "wegen zu großer Hitze im Kochgefäß ansetzen oder schwarz werden"
                            },
                            {
                                "target_lang_word": "verbrennen",
                                "target_lang_sense_clarification": "eine Speise durch zu langes Garen verkohlen lassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0c86b8-8a69-3053-b902-40f05edd8f9c",
                    "sense_definition": "To feel very hot, painful, or stinging; to feel a strong emotion like embarrassment or anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His cheeks <w>burned</w> with shame when he realized his mistake.",
                            "target_lang_translations": {
                                "ru": "Его щеки <w>горели</w> от стыда, когда он осознал свою ошибку.",
                                "zh": "当他意识到自己的错误时，脸颊因羞愧而<w>发烫</w>。",
                                "de": "Seine Wangen <w>brannten</w> vor Scham, als er seinen Fehler bemerkte."
                            }
                        },
                        {
                            "text": "My eyes started to <w>burn</w> from the smoke in the room.",
                            "target_lang_translations": {
                                "ru": "Мои глаза начали <w>гореть</w> от дыма в комнате.",
                                "zh": "房间里的烟熏得我的眼睛开始<w>刺痛</w>。",
                                "de": "Meine Augen fingen an, vom Rauch im Raum zu <w>brennen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burn with shame",
                        "burn with anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать сильный жар, боль или жжение; испытывать сильную эмоцию, например стыд или гнев.",
                        "zh": "感到非常热、疼痛或刺痛；感受到强烈的羞耻或愤怒等情绪。",
                        "de": "Ein heißes, schmerzhaftes oder stechendes Gefühl haben; eine starke Emotion wie Scham oder Wut empfinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гореть",
                                "target_lang_sense_clarification": "ощущать жар или сильную эмоцию"
                            },
                            {
                                "target_lang_word": "пылать",
                                "target_lang_sense_clarification": "испытывать сильное чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发烫",
                                "target_lang_sense_clarification": "感到灼热"
                            },
                            {
                                "target_lang_word": "火辣辣",
                                "target_lang_sense_clarification": "形容刺痛感"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "brennen",
                                "target_lang_sense_clarification": "ein stechendes oder heißes Gefühl auf der Haut oder in den Augen verursachen"
                            },
                            {
                                "target_lang_word": "glühen",
                                "target_lang_sense_clarification": "vor Scham oder Aufregung heiß werden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c39fa59-de47-3e7d-bc24-fb9cab078212",
                    "sense_definition": "To write data to a permanent storage medium like a compact disc.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>burn</w> these music files onto a CD for the car.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>записать</w> эти музыкальные файлы на CD для машины.",
                                "zh": "我需要把这些音乐文件<w>刻录</w>到CD里以便在车里听。",
                                "de": "Ich muss diese Musikdateien für das Auto auf eine CD <w>brennen</w>."
                            }
                        },
                        {
                            "text": "The software allows you to <w>burn</w> a DVD in just a few minutes.",
                            "target_lang_translations": {
                                "ru": "Программа позволяет <w>записать</w> DVD всего за несколько минут.",
                                "zh": "该软件让你能在几分钟内<w>刻录</w>一张DVD。",
                                "de": "Die Software ermöglicht es dir, in nur wenigen Minuten eine DVD zu <w>brennen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burn a CD",
                        "burn a disc"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать данные на постоянный носитель, например на компакт-диск.",
                        "zh": "将数据写入光盘等永久存储介质。",
                        "de": "Daten auf ein dauerhaftes Speichermedium wie eine CD oder DVD schreiben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записать",
                                "target_lang_sense_clarification": "сохранить данные на диск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刻录",
                                "target_lang_sense_clarification": "将数据写入光盘"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "brennen",
                                "target_lang_sense_clarification": "Daten auf ein optisches Speichermedium schreiben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05e5f65-0e42-31c7-bb3a-47244fd17ccb",
                    "sense_definition": "To waste money, time, or resources quickly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup company <w>burned</w> through its funding in less than a year.",
                            "target_lang_translations": {
                                "ru": "Стартап <w>растратил</w> свое финансирование менее чем за год.",
                                "zh": "这家初创公司不到一年就<w>挥霍</w>光了资金。",
                                "de": "Das Startup-Unternehmen hat sein Kapital in weniger als einem Jahr <w>verbrannt</w>."
                            }
                        },
                        {
                            "text": "We have an hour to <w>burn</w> before our train leaves.",
                            "target_lang_translations": {
                                "ru": "У нас есть час, который нужно <w>убить</w> до отправления поезда.",
                                "zh": "火车出发前我们还有一个小时可以<w>打发</w>。",
                                "de": "Wir haben noch eine Stunde Zeit zu <w>vertrödeln</w>, bevor unser Zug abfährt."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "fritter"
                    ],
                    "common_phrases": [
                        "money to burn",
                        "burn through"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро тратить деньги, время или ресурсы.",
                        "zh": "快速浪费金钱、时间或资源。",
                        "de": "Geld, Zeit oder Ressourcen schnell verschwenden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прожигать",
                                "target_lang_sense_clarification": "тратить впустую"
                            },
                            {
                                "target_lang_word": "тратить",
                                "target_lang_sense_clarification": "расходовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挥霍",
                                "target_lang_sense_clarification": "浪费金钱"
                            },
                            {
                                "target_lang_word": "虚度",
                                "target_lang_sense_clarification": "浪费时间"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verbrennen",
                                "target_lang_sense_clarification": "Geld oder Ressourcen sinnlos ausgeben"
                            },
                            {
                                "target_lang_word": "vergeuden",
                                "target_lang_sense_clarification": "Zeit oder Geld verschwenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "647d1443-a66a-3b51-b498-507693fd27c8",
                    "sense_definition": "To insult or defeat someone effectively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He really <w>burned</w> you with that clever comeback.",
                            "target_lang_translations": {
                                "ru": "Он реально тебя <w>уделал</w> этим остроумным ответом.",
                                "zh": "他那句机智的反击真是让你<w>难堪</w>。",
                                "de": "Er hat dich mit dieser schlagfertigen Antwort wirklich <w>fertiggemacht</w>."
                            }
                        },
                        {
                            "text": "I just <w>burned</w> you again in this game.",
                            "target_lang_translations": {
                                "ru": "Я снова тебя <w>сделал</w> в этой игре.",
                                "zh": "在这场游戏中，我又一次<w>完胜</w>了你。",
                                "de": "Ich habe dich gerade wieder in diesem Spiel <w>abgezogen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффективно оскорбить или победить кого-либо.",
                        "zh": "有效地侮辱或击败某人。",
                        "de": "Jemanden effektiv beleidigen oder besiegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уделать",
                                "target_lang_sense_clarification": "сленг. победить или унизить"
                            },
                            {
                                "target_lang_word": "осадить",
                                "target_lang_sense_clarification": "поставить на место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "言语上的打击"
                            },
                            {
                                "target_lang_word": "完胜",
                                "target_lang_sense_clarification": "彻底击败"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fertigmachen",
                                "target_lang_sense_clarification": "jemanden verbal bloßstellen oder besiegen"
                            },
                            {
                                "target_lang_word": "abkanzeln",
                                "target_lang_sense_clarification": "jemanden scharf zurechtweisen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a3513b7-6d4e-3503-bc4b-4ae87ae324ff",
                    "sense_definition": "A physical injury caused by heat, cold, electricity, radiation, or chemicals.",
                    "learner_level": "B1",
