        "nl-extract.jsonl": [
            {
                "entry_id": "f3a92c39-de21-3687-9e12-995f5355f503",
                "word": "indopen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11798501-5ea0-3882-a998-10df868e3375",
                        "entry_id": "f3a92c39-de21-3687-9e12-995f5355f503",
                        "glosses": [
                            "voorzichtig in een vloeistof stoppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbbce3d6-d045-4dae-98bd-a7af36a69f4b",
                                "sense_id": "11798501-5ea0-3882-a998-10df868e3375",
                                "text": "Na bakken: indopen of besprenkelen met getempereerde witte, pure of melkchocolade"
                            },
                            {
                                "example_id": "fce1c8da-7576-4d22-b7af-227b928a3869",
                                "sense_id": "11798501-5ea0-3882-a998-10df868e3375",
                                "text": "Indopen deed je in de inktpot. Die pot was ingebouwd in de schoolbank. Hij werd bijgevuld met een grote fles schoolinkt, meestal van het merk Talens. In ouderwetse, vaste schoolbanken kon de inktpot er niet uit, waardoor na verloop van jaren de inkt steeds modderiger werd. Na de oorlog verschenen er losse schooltafeltjes met een uitneembaar inktpotje, afgedekt door een rood schuifje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e48d80c2-e2d6-4220-a2cf-217fc0c1e474",
                        "source_entry_id": "f3a92c39-de21-3687-9e12-995f5355f503",
                        "source_sense_id": "11798501-5ea0-3882-a998-10df868e3375",
                        "source_sense_description": "voorzichtig in een vloeistof stoppen",
                        "target_lang_word": "soak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff3125d9-baf7-3c0e-b657-2301c254caec",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To be saturated with liquid by being immersed in it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c01ff82c-ca3c-462b-833c-93759d3f82ce",
                                                "sense_id": "ff3125d9-baf7-3c0e-b657-2301c254caec",
                                                "text": "I'm going to soak in the bath for a couple of hours."
                                            },
                                            {
                                                "example_id": "ba83fffa-0a36-44f0-96c9-db62e0115d3b",
                                                "sense_id": "ff3125d9-baf7-3c0e-b657-2301c254caec",
                                                "text": "Their land shall be soaked with blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234bafb4-6946-3523-b3fc-4150d3ed1541",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To immerse in liquid to the point of saturation or thorough permeation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11c0067-ba7d-4410-9a50-75167982a0d8",
                                                "sense_id": "234bafb4-6946-3523-b3fc-4150d3ed1541",
                                                "text": "Soak the beans overnight before cooking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e643910f-3362-3988-8c30-59a38fbd160e",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To penetrate or permeate by saturation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47165d47-7d35-4168-9239-0a2904402524",
                                                "sense_id": "e643910f-3362-3988-8c30-59a38fbd160e",
                                                "text": "The water soaked into my shoes and gave me wet feet."
                                            },
                                            {
                                                "example_id": "5b2cee4e-5f3d-46b2-a6dd-a51e78fa6e63",
                                                "sense_id": "e643910f-3362-3988-8c30-59a38fbd160e",
                                                "text": "The rivulet beneath […]soaked its way obscurely through wreaths of snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5809fcf-6bd7-3021-a251-edd1c949d074",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To allow (especially a liquid) to be absorbed; to take in, receive. (usually + up)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976c7b72-00a9-4882-a9e6-6864d8907dca",
                                                "sense_id": "c5809fcf-6bd7-3021-a251-edd1c949d074",
                                                "text": "A sponge soaks up water; the skin soaks in moisture."
                                            },
                                            {
                                                "example_id": "0dbfeb6c-4e09-41ae-86eb-37958612326e",
                                                "sense_id": "c5809fcf-6bd7-3021-a251-edd1c949d074",
                                                "text": "I soaked up all the knowledge I could at university."
                                            },
                                            {
                                                "example_id": "8ea8fda1-5996-45bd-9b55-1cd3f780290e",
                                                "sense_id": "c5809fcf-6bd7-3021-a251-edd1c949d074",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f08f2a7-ec00-3394-8b2c-adf4a7d48075",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To overcharge or swindle out of a large amount of money."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0777404a-b6ce-4bda-943b-4d96c7a4cf36",
                                                "sense_id": "5f08f2a7-ec00-3394-8b2c-adf4a7d48075",
                                                "text": "It's a blackmail ring, and the district attorneys get a share of the loot. […] Well, they got him in the same kind of jam, and soaked him to the tune of three hundred and eighty-six thousand."
                                            },
                                            {
                                                "example_id": "a9e49d51-4b1b-4369-8a1d-25e1739aa6a9",
                                                "sense_id": "5f08f2a7-ec00-3394-8b2c-adf4a7d48075",
                                                "text": "Sure, if we own an aerospace contracting company, a five-thousand-acre sugar-beet farm, or a savings and loan with the president's son on the board of directors, we can soak Uncle Sucker for millions."
                                            },
                                            {
                                                "example_id": "56b9d0eb-294e-414e-bdb9-2da5a39c6882",
                                                "sense_id": "5f08f2a7-ec00-3394-8b2c-adf4a7d48075",
                                                "text": "I think you’re totally right that there is a big constituency, especially now that the party has been transformed, of Republican- and populist-leaning Republican voters who would be fine with some soaking the rich in the context of a bigger budget deal. […] Just maintaining the changes to the state and local tax deduction that was, I think, one of the genuinely populist victories of the first Trump term. And I should say, it soaked me, it soaked the upper middle class in blue states."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "097befda-d6ec-363d-a3e7-ef86d66fa347",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To drink intemperately or gluttonously."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5a1ec77-9925-3e31-9c47-0eceb71f1364",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To heat (a metal) before shaping it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "925258a7-b09c-3317-8150-a03ad12ec32c",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To hold a kiln at a particular temperature for a given period of time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd27fb8-f5b1-42a1-b889-c3db535db4ce",
                                                "sense_id": "925258a7-b09c-3317-8150-a03ad12ec32c",
                                                "text": "We should soak the kiln at cone 9 for half an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0616348-71b9-3091-a34e-f87dcbce8cc9",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To absorb; to drain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b293df17-5722-4e90-9e8e-b7563ea0fbe9",
                                                "sense_id": "d0616348-71b9-3091-a34e-f87dcbce8cc9",
                                                "text": "That they will want a certaine sucking and soaking"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "863acac2-387a-3469-a59e-a39545786fb2",
                                        "entry_id": "60ee9346-e66c-38c1-a4e7-055854db22b0",
                                        "glosses": [
                                            "To engage in penetrative sex without hip thrusting."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "slang"
                                        ],
