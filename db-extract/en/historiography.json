                                        "glosses": [
                                            "zbiory naukowych opracowań historycznych na temat danego okresu, regionu, postaci itp."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
