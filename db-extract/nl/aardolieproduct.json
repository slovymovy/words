                        "entry_id": "3b7fb9c5-ee9f-308c-8eca-3202906274ab",
                        "tags": [],
                        "form": "aardolieprodukt",
                        "note": "voorkeursvariant in de officiële spelling van 1955 tot 1996"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8884413-6894-3f2b-8fd2-5c19bef214fe",
                        "entry_id": "3b7fb9c5-ee9f-308c-8eca-3202906274ab",
                        "glosses": [
                            "verhandelbaar resultaat van het bewerken van aardolie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c128ca5d-4ac5-4172-a0cd-4130b9111fd1",
                                "sense_id": "a8884413-6894-3f2b-8fd2-5c19bef214fe",
                                "text": "Aardolie kan door raffineren en kraken omgezet worden in allerlei aardolieproducten die dienst doen als brandstoffen of grondstoffen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4f279c3-1f28-4568-9225-dfa263fce938",
                        "source_entry_id": "3b7fb9c5-ee9f-308c-8eca-3202906274ab",
                        "source_sense_id": "a8884413-6894-3f2b-8fd2-5c19bef214fe",
                        "source_sense_description": "verhandelbaar resultaat van het bewerken van aardolie",
                        "target_lang_word": "Erdölprodukt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdölprodukt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                        "entry_id": "c6937d87-fc8c-39b0-a18f-8382c16e2186",
                                        "glosses": [
                                            "Produkt, das aus Erdöl hergestellt ist (beispielsweise Benzin, Schmieröl)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa26a0a-81b9-46d4-854e-d9984dfb697e",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "Bekannte Erdölprodukte sind Kerosin, Bitumen, Paraffin und Vaseline."
                                            },
                                            {
                                                "example_id": "6550585d-c663-4a9a-8cc4-67ba6f7d2cdc",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„2022 transportierte das Unternehmen 2,5 Millionen Tonnen Erdölprodukte und 250 Tausend Tonnen Eisenerz.“"
                                            },
                                            {
                                                "example_id": "40f5c3ab-75d2-4b15-98df-8850e1b4b00c",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Bis heute produziert die erste Raffinerie des Landes zwei Millionen Tonnen Erdölprodukte jährlich.“"
                                            },
                                            {
                                                "example_id": "de7f0297-f95b-4356-9705-9725ebcef2cb",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Kondensat ist ein Erdölprodukt, das viele kurze Moleküle enthält und daher leicht verdunstet und sich schnell entzündet. Aus ihm wird unter anderem Benzin hergestellt.“"
                                            },
                                            {
                                                "example_id": "febfe193-23e6-4985-ba7f-fd8b90df1036",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Bis zur ersten Ölkrise 1973 erlebt das Erdölprodukt Plastiktüte in Kaufhäusern und Supermärkten einen ungebremsten Siegeszug.“"
                                            },
                                            {
                                                "example_id": "cba044b0-55ce-4d51-9b3d-f7b3eadc8f7f",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "[11. Jnanuar 1974:] „Die französische Regierung erhöht die Preise für Erdölprodukte. Ab sofort kostet z. B. 1 l Normalbenzin 1,62 statt 1,25 Franc (0,87 DM statt bisher 0,68 DM).“"
                                            },
                                            {
                                                "example_id": "7d2fd91f-dcc2-4b8f-a2fc-f4e8f20b4c1a",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Das Verbrennen von Erdölprodukten zur Fortbewegung wird teurer.“"
                                            },
                                            {
                                                "example_id": "0c095ff8-23fe-44ab-9a14-9250436c7839",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "[Eastport/Maine, 20. März 2022:] „Einem russischen Schiff mit 8.000 Tonnen Erdölprodukt ist das Anlegen an der östlichsten Spitze der USA verweigert worden.“"
                                            },
                                            {
                                                "example_id": "16c16b62-c75a-404a-847f-1629a78c490e",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Der Export von Erdölprodukten wie Diesel ist für Russland ein Milliardengeschäft und das jeden Monat.“"
                                            },
                                            {
                                                "example_id": "27beba51-f649-4a69-9bf7-4a9e56972c91",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Die russische Invasion in die Ukraine hat die Energiepreise von Erdölprodukten, von Gas und“ […] „auch von Elektrizität sowie die Nahrungsmittelpreise in die Höhe schießen lassen.“"
                                            },
                                            {
                                                "example_id": "2d207228-ac8f-4f04-af10-8821c384939c",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Weil es sich um ein Erdölprodukt handelt, gilt die Klimabilanz von Paraffinkerzen als schlecht.“"
                                            },
                                            {
                                                "example_id": "c000951d-89c1-4796-8915-7164125b786d",
                                                "sense_id": "52b3b47f-c035-3779-9157-82bf9cdc82dd",
                                                "text": "„Damals machten er und seine Familie einen bemerkenswerten Selbstversuch: Sie wollten ein Jahr lang auf Erdöl und Erdölprodukte verzichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
