                        "entry_id": "583f1f10-44ad-325f-9502-7defacd3d2d3",
                        "glosses": [
                            "To march or force a person forward while holding their arms from behind or the side, as a prisoner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba35494-4f52-4f9e-a6f4-0fcd6ece7b64",
                                "sense_id": "38367460-be40-3e92-9edc-1fd287a424f5",
                                "text": "Maybe it happened during the COVID-19 lockdowns, when no one could work and soldiers frog-marched curfew-breakers through the township streets like criminals."
                            }
                        ]
                    },
                    {
                        "sense_id": "b68d56ac-80a0-334e-9835-b2fbf7fd6bf6",
                        "entry_id": "583f1f10-44ad-325f-9502-7defacd3d2d3",
                        "glosses": [
                            "To force a person forward against their will."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "76f0e811-571e-49c3-a3e0-d545064667a3",
                                "sense_id": "b68d56ac-80a0-334e-9835-b2fbf7fd6bf6",
                                "text": "The wind frogmarched me at a run into the house."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a0a0e34-1f8a-305c-9cc5-bf727c186b5c",
                        "entry_id": "583f1f10-44ad-325f-9502-7defacd3d2d3",
                        "glosses": [
                            "To carry a person face-down with one person holding each limb."
