                                "target_senses": [
                                    {
                                        "sense_id": "228f2699-5a15-3060-88a1-4a824a03d6c0",
                                        "entry_id": "ff0e0643-440e-3a25-9426-495fa9d4518f",
                                        "glosses": [
                                            "A large Arctic marine mammal related to seals and having long tusks, tough, wrinkled skin, and four flippers, Odobenus rosmarus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea8e381-0627-4e9e-9c05-ee8b1789bac5",
                                                "sense_id": "228f2699-5a15-3060-88a1-4a824a03d6c0",
                                                "text": "Of all the Phocine family none present so terrible and grotesque an appearance as the gigantic Walrus, also known as the morse and sea-horse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "766080d2-95dd-335a-a948-8e7e017b7b2d",
                                        "entry_id": "ff0e0643-440e-3a25-9426-495fa9d4518f",
                                        "glosses": [
                                            "A man with a walrus moustache."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e7be67-dc8d-47c5-9767-59ba2350ce22",
                                                "sense_id": "766080d2-95dd-335a-a948-8e7e017b7b2d",
                                                "text": "You old walrus, don't you think it is time for you to lop your whiskers off?"
                                            },
                                            {
                                                "example_id": "5a45a72f-fbb1-4f3c-b2e4-8d0e971c3a85",
                                                "sense_id": "766080d2-95dd-335a-a948-8e7e017b7b2d",
                                                "text": "One, a rumpled, whiskered walrus of a man, held a lantern near Mother's face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "walrus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a32c8b9-21e3-3d07-b93c-4a75ac3f2155",
                                        "entry_id": "830d6c19-079a-3d18-a359-67060ed4d4ef",
                                        "glosses": [
                                            "To hunt walruses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24a8d15-b6b9-4177-82e6-f8abd8643b05",
                                                "sense_id": "7a32c8b9-21e3-3d07-b93c-4a75ac3f2155",
                                                "text": "It's strange to see parties of merrymakers gather where I nearly drowned, and later walrused with David Isaakovich, Father Basil and the rest of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f1b346-46bc-30c0-a16f-4db38eff92f5",
                                        "entry_id": "830d6c19-079a-3d18-a359-67060ed4d4ef",
                                        "glosses": [
                                            "To be like a walrus",
                                            "To move dragging one's belly along the floor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997e0325-5058-49a3-9f7e-52907ce5844e",
                                                "sense_id": "06f1b346-46bc-30c0-a16f-4db38eff92f5",
                                                "text": "Gaddy walrused herself from the back seat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ee549d-557c-3d04-a202-a78eddc7c6fd",
                                        "entry_id": "830d6c19-079a-3d18-a359-67060ed4d4ef",
                                        "glosses": [
                                            "To be like a walrus",
                                            "To hang like a walrus's moustache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499b0c0a-4f0a-43a1-a42d-08cc5d9c9c39",
                                                "sense_id": "f6ee549d-557c-3d04-a202-a78eddc7c6fd",
                                                "text": "His untrimmed mustache walrused down and over his hidden mouth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9c4668-c4e3-3ab9-8f13-de70ccec522b",
                                        "entry_id": "830d6c19-079a-3d18-a359-67060ed4d4ef",
                                        "glosses": [
                                            "To be like a walrus",
                                            "To be prominent, like tusks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826b6417-db68-42fe-bd8f-df83d8f7f2ab",
                                                "sense_id": "cf9c4668-c4e3-3ab9-8f13-de70ccec522b",
                                                "text": "Where a mammal had its canine teeth, great fangs walrused down from the grezzen's upper jaw, as long as scimitars and as thick as human thighs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
