                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7c3b3bb-693e-3fb4-8d59-cf5418cca51c",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A metal strip strengthening the waists of shoes. (Also shankpiece.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e681c811-792f-3ed0-92e2-64a0a88bd113",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "An improvised stabbing weapon, originally in prison, possibly from the strips of metal in shoes."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8cb799-b923-4004-b6cf-738c291f0142",
                                                "sense_id": "e681c811-792f-3ed0-92e2-64a0a88bd113",
                                                "text": "LBC's tryna blackball me / And tryna blame your boy for knife crime (Like, what?) / I don't use a shank, I got money in the bank / Man, I'd rather do a drive-by"
                                            },
                                            {
                                                "example_id": "01dff380-e55d-49c4-883b-24e2fb92fac8",
                                                "sense_id": "e681c811-792f-3ed0-92e2-64a0a88bd113",
                                                "text": "One of the shot callers' responsibilities was to control the shanks within the prison population—the crude homemade knives used for stabbing another prisoner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b99091-5c18-3fff-9516-d5c4d6673856",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A loop forming an eye to a button."
