{
    "word_family": [
        "aridity",
        "aridness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "605be8b5-b542-3a6f-84d5-21bc8e27f5e4",
                    "sense_definition": "Describing a climate with very little rainfall.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dryness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deserts are known for being <w>arid</w>.",
                            "target_lang_translations": {
                                "tr": "Çöller <w>kurak</w> olmalarıyla bilinir."
                            }
                        },
                        {
                            "text": "The <w>arid</w> landscape of the region makes farming very difficult.",
                            "target_lang_translations": {
                                "tr": "Bölgenin <w>kurak</w> coğrafyası tarım yapmayı çok zorlaştırıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "xeric"
                    ],
                    "antonyms": [
                        "wet",
                        "drenched",
                        "damp",
                        "moist",
                        "humid",
                        "rainforest"
                    ],
                    "common_phrases": [
                        "arid climate",
                        "arid region"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok az yağış alan iklimleri tanımlar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kurak",
                                "target_lang_sense_clarification": "Yağışsız hava, mevsim veya iklim için kullanılır."
                            },
                            {
                                "target_lang_word": "çorak",
                                "target_lang_sense_clarification": "Verimsiz, bitki yetişmeyen topraklar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a9c100a-b747-31ea-964d-b7bef8ae88f8",
                    "sense_definition": "Extremely dry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dryness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bread was completely <w>arid</w> and hard to chew.",
                            "target_lang_translations": {
                                "tr": "Bayat ekmek tamamen <w>kuru</w> ve çiğnenmesi zordu."
                            }
                        },
                        {
                            "text": "The <w>arid</w> soil cracked under the intense summer sun.",
                            "target_lang_translations": {
                                "tr": "<w>Kurak</w> toprak, yoğun yaz güneşi altında çatladı."
                            }
                        }
                    ],
                    "antonyms": [
                        "wet",
                        "damp",
                        "moist"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı derecede kuru."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuru",
                                "target_lang_sense_clarification": "Suyu veya nemi olmayan, yaşın karşıtı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3a14566-d793-30f9-8ba5-7591558ff272",
                    "sense_definition": "Lacking interest or value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found the long lecture on tax law to be quite <w>arid</w>.",
                            "target_lang_translations": {
                                "tr": "Vergi hukuku üzerine olan uzun dersi oldukça <w>kuru</w> buldu."
                            }
                        },
                        {
                            "text": "The book was an <w>arid</w> collection of facts without any real insight.",
                            "target_lang_translations": {
                                "tr": "Kitap, gerçek bir içgörüden yoksun, <w>kuru</w> bir bilgi yığınıydı."
                            }
                        }
                    ],
                    "antonyms": [
                        "valuable",
                        "costly",
                        "precious"
                    ],
                    "target_lang_definitions": {
                        "tr": "İlgi veya değerden yoksun, sıkıcı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kuru",
                                "target_lang_sense_clarification": "Heyecanı, tadı olmayan, tekdüze veya duygudan yoksun anlatımlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}