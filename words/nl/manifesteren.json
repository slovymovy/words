                    "sense_definition": "zichbaar of merkbaar worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verschijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eerste symptomen van de ziekte <w>manifesteren</w> zich meestal na een week.",
                            "target_lang_translations": {
                                "en": "The first symptoms of the disease usually <w>manifest</w> themselves after a week."
                            }
                        },
                        {
                            "text": "Het probleem <w>manifesteert</w> zich vooral tijdens het opstarten van de computer.",
                            "target_lang_translations": {
                                "en": "The problem <w>appears</w> mainly during the computer's startup."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich duidelijk manifesteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to become visible or noticeable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manifest",
                                "target_lang_sense_clarification": "to become apparent or reveal itself"
                            },
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to become visible"
                            },
                            {
                                "target_lang_word": "show up",
                                "target_lang_sense_clarification": "to become evident"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c132ef-5868-317c-8653-baa9ab7b6cca",
                    "sense_definition": "iets aan iedereen bekendmaken of duidelijk laten blijken",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bekendmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar wilde zijn visie aan de wereld <w>manifesteren</w> via zijn schilderijen.",
                            "target_lang_translations": {
                                "en": "The artist wanted to <w>manifest</w> his vision to the world through his paintings."
                            }
                        },
                        {
                            "text": "Het succes van de familie werd tijdens het grote feest eindelijk <w>gemanifesteerd</w>.",
                            "target_lang_translations": {
                                "en": "The family's success was finally <w>revealed</w> during the big party."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekendmaken",
                        "openbaarmaken"
                    ],
                    "common_phrases": [
                        "je mening manifesteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something known to everyone or to show it clearly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manifest",
                                "target_lang_sense_clarification": "to display or show a quality or feeling"
                            },
                            {
                                "target_lang_word": "reveal",
                                "target_lang_sense_clarification": "to make known to others"
                            },
                            {
                                "target_lang_word": "proclaim",
                                "target_lang_sense_clarification": "to announce publicly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd658228-4787-3afa-b114-997979163336",
                    "sense_definition": "deelnemen aan een openbare bijeenkomst om een mening te uiten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protesteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studenten besloten op het plein te <w>manifesteren</w> tegen de nieuwe wet.",
                            "target_lang_translations": {
                                "en": "The students decided to <w>demonstrate</w> on the square against the new law."
                            }
                        },
                        {
                            "text": "Duizenden mensen kwamen samen om vreedzaam te <w>manifesteren</w> voor een beter klimaat.",
                            "target_lang_translations": {
                                "en": "Thousands of people gathered to <w>protest</w> peacefully for a better climate."
                            }
                        }
                    ],
                    "synonyms": [
                        "betogen",
                        "demonstreren"
                    ],
                    "common_phrases": [
                        "vreedzaam manifesteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to participate in a public meeting to express an opinion or protest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demonstrate",
                                "target_lang_sense_clarification": "to take part in a public protest"
                            },
                            {
                                "target_lang_word": "protest",
                                "target_lang_sense_clarification": "to publicly express objection"
                            },
                            {
                                "target_lang_word": "march",
                                "target_lang_sense_clarification": "to walk in a public group as a protest"
                            }
                        ]
                    }
                }
