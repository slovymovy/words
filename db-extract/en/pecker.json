                                "example_id": "cd1a4abd-4c7d-4685-8cd9-6756cd194056",
                                "sense_id": "d4add38b-27fe-38b3-a2b6-fa04b71a0512",
                                "text": "Fred and I managed to keep our peckers up somehow."
                            }
                        ]
