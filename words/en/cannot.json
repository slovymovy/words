{
    "word_family": [
        "can"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ae23b2b-ae75-3adc-ab26-c2762926cb74",
                    "sense_definition": "To be unable to perform a specific action or task.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>cannot</w> open the window because it is stuck.",
                            "target_lang_translations": {
                                "ru": "Я <w>не могу</w> открыть окно, потому что оно застряло.",
                                "zh": "窗户卡住了，我<w>不能</w>打开它。"
                            }
                        },
                        {
                            "text": "She <w>cannot</w> come to the party tonight.",
                            "target_lang_translations": {
                                "ru": "Она <w>не может</w> прийти сегодня вечером на вечеринку.",
                                "zh": "她今晚<w>无法</w>来参加聚会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "can't"
                    ],
                    "antonyms": [
                        "can"
                    ],
                    "common_phrases": [
                        "cannot wait",
                        "cannot believe",
                        "cannot help"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть не в состоянии выполнить определенное действие или задачу.",
                        "zh": "无法执行某项特定动作或任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не мо́чь",
                                "target_lang_sense_clarification": "быть не в состоянии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不能",
                                "target_lang_sense_clarification": "表示没有能力或条件做某事"
                            },
                            {
                                "target_lang_word": "无法",
                                "target_lang_sense_clarification": "表示客观上没有办法做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87883ee3-af47-3278-8f46-5a2cd9473af8",
                    "sense_definition": "To be forbidden or not permitted to do something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You <w>cannot</w> enter the hall without a valid ticket.",
                            "target_lang_translations": {
                                "ru": "Вам <w>нельзя</w> входить в зал без действительного билета.",
                                "zh": "没有有效门票，你<w>不可以</w>进入大厅。"
                            }
                        },
                        {
                            "text": "Students <w>cannot</w> use their mobile phones during the exam.",
                            "target_lang_translations": {
                                "ru": "Студентам <w>нельзя</w> пользоваться мобильными телефонами во время экзамена.",
                                "zh": "考试期间学生<w>禁止</w>使用手机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "can't"
                    ],
                    "antonyms": [
                        "can",
                        "may"
                    ],
                    "common_phrases": [
                        "cannot be used",
                        "cannot afford"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть лишенным права или разрешения делать что-либо.",
                        "zh": "被禁止或不被允许做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нельзя́",
                                "target_lang_sense_clarification": "запрещено"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可以",
                                "target_lang_sense_clarification": "表示不被允许"
                            },
                            {
                                "target_lang_word": "禁止",
                                "target_lang_sense_clarification": "表示明令禁止"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f721919f-5d61-3e89-8210-720dea27c9ce",
                    "sense_definition": "Something that is impossible to do or achieve.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat down to discuss the cans and <w>cannots</w> of the new project.",
                            "target_lang_translations": {
                                "ru": "Мы сели обсудить, что можно, а чего <w>нельзя</w> в новом проекте.",
                                "zh": "我们坐下来讨论了新项目的可行性与<w>禁忌</w>。"
                            }
                        },
                        {
                            "text": "He was frustrated by the many <w>cannots</w> in the strict regulations.",
                            "target_lang_translations": {
                                "ru": "Он был расстроен множеством <w>запретов</w> в строгих правилах.",
                                "zh": "严格的规章制度中有很多<w>限制</w>，这让他感到沮丧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cans and cannots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что невозможно сделать или достичь.",
                        "zh": "无法做到或实现的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невозможное",
                                "target_lang_sense_clarification": "то, что невозможно сделать"
                            },
                            {
                                "target_lang_word": "запрет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "禁忌",
                                "target_lang_sense_clarification": "指禁止做的事"
                            },
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "指规则中的禁止项"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d359c67d-7952-3075-bbba-1969d7fe7331",
                    "sense_definition": "A person who is unable to do a particular thing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a team of high achievers, he felt like a <w>cannot</w>.",
                            "target_lang_translations": {
                                "ru": "В команде успешных людей он чувствовал себя <w>неудачником</w>.",
                                "zh": "在一群成就卓著的团队中，他觉得自己像个<w>无能者</w>。"
                            }
                        },
                        {
                            "text": "Do not be a <w>cannot</w>; try to find a solution to the problem.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>беспомощным</w>; попытайся найти решение проблемы.",
                                "zh": "别做个<w>无能者</w>，试着去寻找解决问题的方法。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не способен что-либо сделать.",
                        "zh": "无法完成特定任务的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неумеха",
                                "target_lang_sense_clarification": "тот, кто не способен что-либо сделать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无能者",
                                "target_lang_sense_clarification": "指缺乏能力的人"
                            },
                            {
                                "target_lang_word": "失败者",
                                "target_lang_sense_clarification": "指在某方面无法成功的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}