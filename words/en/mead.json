{
    "word_family": [
        "meadow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69d1b003-5cf2-357f-924e-15a353dd563b",
                    "sense_definition": "An alcoholic beverage made by fermenting a mixture of honey and water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests enjoyed a glass of sweet <w>mead</w> during the medieval-themed feast.",
                            "target_lang_translations": {
                                "ru": "Во время пира в средневековом стиле гости наслаждались бокалом сладкого <w>мёда</w>."
                            }
                        },
                        {
                            "text": "Ancient cultures often celebrated their victories by drinking <w>mead</w> together.",
                            "target_lang_translations": {
                                "ru": "Древние культуры часто праздновали свои победы, вместе распивая <w>медовуху</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "honey wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Алкогольный напиток, получаемый путем брожения смеси мёда и воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мёд",
                                "target_lang_sense_clarification": "устаревшее название алкогольного напитка на основе мёда"
                            },
                            {
                                "target_lang_word": "медову́ха",
                                "target_lang_sense_clarification": "современный термин для слабоалкогольного напитка на основе мёда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db6c8d38-632f-3001-b83f-01ab362d07be",
                    "sense_definition": "A non-alcoholic drink made from flavored syrup and water, sometimes carbonated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old-fashioned shop served a refreshing <w>mead</w> made with sarsaparilla syrup.",
                            "target_lang_translations": {
                                "ru": "В старомодном магазине подавали освежающий напиток, приготовленный на основе сиропа сарсапарели."
                            }
                        },
                        {
                            "text": "He ordered a chilled <w>mead</w> to cool down on the hot summer afternoon.",
                            "target_lang_translations": {
                                "ru": "Он заказал охлажденный напиток, чтобы освежиться в жаркий летний день."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Безалкогольный напиток из ароматизированного сиропа и воды, иногда газированный."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "d0504f7d-a3d9-3293-8e1f-9581e47d02a0",
                    "sense_definition": "A field of grass or pasture land.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep grazed peacefully in the green <w>mead</w> near the river.",
                            "target_lang_translations": {
                                "ru": "Овцы мирно паслись на зеленом <w>лугу</w> у реки."
                            }
                        },
                        {
                            "text": "Wildflowers bloomed across the vast <w>mead</w> during the spring season.",
                            "target_lang_translations": {
                                "ru": "Весной по всему обширному <w>лугу</w> цвели полевые цветы."
                            }
                        }
                    ],
                    "synonyms": [
                        "meadow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Commonly used in poetry and literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Травянистое поле или пастбище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "луг",
                                "target_lang_sense_clarification": "участок земли, покрытый травянистой растительностью"
                            },
                            {
                                "target_lang_word": "пастбище",
                                "target_lang_sense_clarification": "земля, используемая для выпаса скота"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "635ed495-dd50-3f24-945d-1d2895796e7c",
                    "sense_definition": "A surname of Old English origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the genealogy of the <w>Mead</w> family.",
                            "target_lang_translations": {
                                "ru": "Историк исследовал генеалогию семьи <w>Мид</w>."
                            }
                        },
                        {
                            "text": "Margaret <w>Mead</w> was a famous American cultural anthropologist.",
                            "target_lang_translations": {
                                "ru": "Маргарет <w>Мид</w> была известным американским культурным антропологом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия древнеанглийского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мид",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49522ff6-adf5-3635-9448-03cf98d1175a",
                    "sense_definition": "A rural community in Ontario, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the quiet town of <w>Mead</w> on their way north.",
                            "target_lang_translations": {
                                "ru": "По пути на север они проезжали через тихий городок <w>Мид</w>."
                            }
                        },
                        {
                            "text": "The small settlement of <w>Mead</w> is located in the Cochrane District.",
                            "target_lang_translations": {
                                "ru": "Небольшое поселение <w>Мид</w> расположено в округе Кокран."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельское поселение в Онтарио, Канада."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мид",
                                "target_lang_sense_clarification": "транслитерация названия населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}