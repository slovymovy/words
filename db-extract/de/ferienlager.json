                                "target_senses": [
                                    {
                                        "sense_id": "1f4a781f-f487-30d8-821e-20eeeef74235",
                                        "entry_id": "1bfe2278-4494-334c-b1eb-c39e2b696933",
                                        "glosses": [
                                            "Établissement public, privé, ou associatif ayant pour but d’héberger des enfants et des adolescents pendant la période des vacances, de leur faire faire des activités de plein air, sportives ou culturelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef8e1e3-4d6c-4fe1-b0d0-8465c2420520",
                                                "sense_id": "1f4a781f-f487-30d8-821e-20eeeef74235",
                                                "text": "Et là tout près, à un millier de mètres au-dessus du niveau de la mer, parmi les forêts de sapins et les clairières, se trouve le camp de vacances où ils séjourneront trois semaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5563bdba-c07a-4ea3-a87c-6c34992076d1",
                        "source_entry_id": "4c940c66-2b72-32d1-9fcd-f12621f75594",
                        "source_sense_id": "4d3d855b-1650-3542-b7c7-95fe97ae76c1",
                        "source_sense_description": "vorübergehender Aufenthalt für die Ferien",
                        "target_lang_word": "colonie de vacances",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonie de vacances",
