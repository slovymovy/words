                        "glosses": [
                            "мн. ч.: истор. отряд из 50 человек, состоящих под начальством офицера, называемого делилер-агасы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9eaf144-803e-40de-8382-b8f54372946f",
                                "sense_id": "c08b5020-5b2c-3a19-967d-5deabe109530",
                                "text": "Вскоре показались делибаши и закружились в долине, перестреливаясь с нашими казаками."
                            }
                        ]
