                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01bebb2-9cca-4ac7-b595-dbfe7881a4f7",
                                "sense_id": "51db85c3-e463-3de5-87a5-aa01a88e7682",
                                "text": "Savons-nous en fin de compte nous parentaliser ?"
                            },
                            {
                                "example_id": "626936f4-7af0-4cc6-a066-4e7aefbb9858",
                                "sense_id": "51db85c3-e463-3de5-87a5-aa01a88e7682",
                                "text": "A l’inverse de l’enfant parentifié, l’enfant parentalisé ne prend pas la place du parent mais occupe plutôt un rôle d’auxiliaire dans la dynamique familiale."
                            },
                            {
                                "example_id": "185fa561-1a7f-4f9b-b0ed-ccf101b29a50",
                                "sense_id": "51db85c3-e463-3de5-87a5-aa01a88e7682",
                                "text": "bonsoir...voilà je suis une thérapie depuis 3 mois maintenant et ma psychologue me dit que jai trop été parentalisée, que je considère trop mes parents comme mes enfants, et qu'ils ont quelque sorte agi de la sorte..."
                            }
                        ]
