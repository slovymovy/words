                        "glosses": [
                            "That cannot be explained."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6882cf16-778e-41a0-87ea-bfb38b612cb2",
                                "sense_id": "e9ae0ac5-e10c-32a2-a3c5-8a53e3a76664",
                                "text": "The rider himself after a time becomes infected with this inexplainable desperation of terror, and I suppose I must have done so; but for a time I kept the upper hand."
                            },
                            {
                                "example_id": "c1b1c3e8-a7c6-41e6-9f24-2e108b4a79d2",
                                "sense_id": "e9ae0ac5-e10c-32a2-a3c5-8a53e3a76664",
                                "text": "[…]kneeling down before my dead betrothed, I kissed her cold white hand with sincere compunction, before attempting the garbled and probably totally incoherent story with which I endeavoured to explain the inexplainable situation."
                            }
                        ]
                    }
                ],
