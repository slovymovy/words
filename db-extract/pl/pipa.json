                ],
                "senses": [
                    {
                        "sense_id": "fd0d3a3d-bb6d-3174-b8ea-196bd6dc9d96",
                        "entry_id": "760e42fb-a535-340b-b50d-515e269f1aa0",
                        "glosses": [
                            "chiński instrument szarpany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56090c69-c808-4266-9b26-882ea75fb9b7",
                                "sense_id": "fd0d3a3d-bb6d-3174-b8ea-196bd6dc9d96",
                                "text": "Pipa to instrument strunowy szarpany – czasami nazywany chińską lutnią, ponieważ ma pudło rezonansowe o gruszkowatym kształcie"
                            },
                            {
                                "example_id": "fd38ba40-f77a-45ba-9d74-d7e5a7c195db",
                                "sense_id": "fd0d3a3d-bb6d-3174-b8ea-196bd6dc9d96",
                                "text": "Jako instrument muzyczny pipa funkcjonuje w Chinach od ponad dwóch tysięcy lat"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c315cf96-0451-3da5-a58a-1679a806e546",
                        "entry_id": "760e42fb-a535-340b-b50d-515e269f1aa0",
                        "glosses": [
                            "narząd płciowy kobiety"
                        ],
                        "tags": [
                            "commonly"
                        ],
                        "examples": [
                            {
                                "example_id": "ef83f788-1704-4700-84db-d6a30212e809",
                                "sense_id": "c315cf96-0451-3da5-a58a-1679a806e546",
                                "text": "Aaaa, Kaśka pipę pokazała! – krzyknął umorusany blondynek, wskazując brudnym paluchem na dziewczynkę, której twarz natychmiast pokryła się rumieńcem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
