{
    "word_family": [
        "barcoding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5514f40-9d66-3dd1-8d93-ffc635704fc1",
                    "sense_definition": "A machine-readable pattern of parallel lines and spaces of various widths, printed on a commodity to identify it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier scanned the <w>barcode</w> on the cereal box to find its price.",
                            "target_lang_translations": {
                                "zh": "收银员扫描了麦片盒上的<w>条形码</w>以获取价格。"
                            }
                        },
                        {
                            "text": "Make sure you do not cover the printed <w>barcode</w> when wrapping the parcel.",
                            "target_lang_translations": {
                                "zh": "打包包裹时，确保不要遮挡打印的<w>条形码</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bar code"
                    ],
                    "common_phrases": [
                        "scan the barcode",
                        "barcode scanner"
                    ],
                    "target_lang_definitions": {
                        "zh": "印在商品上、由粗细不等的平行线条和间隙组成的机器可读图案，用于识别商品信息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "条形码",
                                "target_lang_sense_clarification": "商品标识码的标准全称"
                            },
                            {
                                "target_lang_word": "条码",
                                "target_lang_sense_clarification": "条形码的常用简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d038cf1-6956-3f34-b288-f6cfbf83dee9",
                    "sense_definition": "A short sequence of DNA used to identify and distinguish a particular species.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "identification_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologists analyzed the genetic <w>barcode</w> to identify the newly discovered insect species.",
                            "target_lang_translations": {
                                "zh": "生物学家分析了基因<w>条形码</w>，以识别新发现的昆虫物种。"
                            }
                        },
                        {
                            "text": "Each sample has a unique mitochondrial <w>barcode</w> that distinguishes it from related taxa.",
                            "target_lang_translations": {
                                "zh": "每个样本都有独特的线粒体<w>条形码</w>，用于将其与相关分类群区分开来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "DNA barcode"
                    ],
                    "common_phrases": [
                        "DNA barcode"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于识别和区分特定物种的短DNA序列。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "DNA条形码",
                                "target_lang_sense_clarification": "生物学中用于物种鉴定的特定DNA序列"
                            },
                            {
                                "target_lang_word": "基因条形码",
                                "target_lang_sense_clarification": "生物学中基因标识序列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40e14e1f-3f9b-37fc-9b94-aa574750452d",
                    "sense_definition": "A pattern of self-inflicted parallel cuts or scars on the skin resembling a machine-readable code.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gently examined the faded <w>barcode</w> of scars across the patient's forearm.",
                            "target_lang_translations": {
                                "zh": "医生轻柔地检查了患者前臂上变淡的<w>条形码状伤疤</w>。"
                            }
                        },
                        {
                            "text": "Years after recovering, she decided to get a tattoo covering the <w>barcode</w> on her wrist.",
                            "target_lang_translations": {
                                "zh": "康复数年后，她决定纹身来遮盖手腕上的<w>条形伤痕</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used colloquially or in online communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "皮肤上由自残造成的形似条形码的平行划痕或伤疤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "条形码状伤疤",
                                "target_lang_sense_clarification": "形似条形码的自残刀疤"
                            },
                            {
                                "target_lang_word": "条形伤痕",
                                "target_lang_sense_clarification": "平行的条状割伤痕迹"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}