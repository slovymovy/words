                "senses": [
                    {
                        "sense_id": "a32a7b0a-cb85-34c1-a178-220eaebfaa5a",
                        "entry_id": "0bb8c68c-7c4c-325c-9412-098447d0fdae",
                        "glosses": [
                            "Considérer de façon irénique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34fad45e-d7e6-4680-997b-1224f2de7b96",
                                "sense_id": "a32a7b0a-cb85-34c1-a178-220eaebfaa5a",
                                "text": "Pour autant, il ne faudrait pas iréniser le boycott et y voir une panacée."
                            },
                            {
                                "example_id": "5b4a82ed-321c-4d4b-9b93-c8a6f7dc48de",
                                "sense_id": "a32a7b0a-cb85-34c1-a178-220eaebfaa5a",
                                "text": "Confrontés au « péril islamiste », nous devons nous garder d’iréniser l’islam comme le font certains musulmans, de le diaboliser comme y inclinent trop d’Occidentaux, et de confondre les musulmans avec les islamistes qui aspirent au pouvoir politique sus le couvert de l’islam."
                            }
                        ]
                    }
