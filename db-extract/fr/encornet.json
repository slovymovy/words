                ],
                "senses": [
                    {
                        "sense_id": "4926c3d4-1958-327e-b8ae-b49debdb7e6c",
                        "entry_id": "51f21942-9d42-3c12-9192-897e46381e5c",
                        "glosses": [
                            "Calmar, mollusque céphalopode à dix bras appartenant à l’ordre Teuthida, surtout considéré comme aliment ou appât pour la pêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c71d1d7c-6157-47d4-ac9c-e9536b779ec1",
                                "sense_id": "4926c3d4-1958-327e-b8ae-b49debdb7e6c",
                                "text": "D’autres, armées d’un bâton que termine un fort hameçon, fouillent sous les pierres, dans les creux du rocher, et en retirent soit le congre à la peau glissante, soit le poulpe aux huit bras, la sèche ou l’encornet, qui tentent vainement d'échapper en s’entourant d'un nuage coloré."
                            },
                            {
                                "example_id": "cb65f011-19c4-4b4b-8273-a11df7b94aa1",
                                "sense_id": "4926c3d4-1958-327e-b8ae-b49debdb7e6c",
                                "text": "Tout d'abord, calmar est bien le terme scientifique approprié, et les autres noms souvent plus vulgaires de « calamar », « chipiron » ou « encornet » ne sont que des appellations vernaculaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9551eea-2afe-3850-b6ac-e60fec9d63ee",
                        "entry_id": "51f21942-9d42-3c12-9192-897e46381e5c",
                        "glosses": [
                            "Nom servant à désigner d’autres mollusques céphalopodes comme la seiche ou le poulpe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8dc806f-74e6-4168-a170-eb88a68f2e6d",
                        "source_entry_id": "51f21942-9d42-3c12-9192-897e46381e5c",
                        "target_lang_word": "Kalmar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalmar",
