                                        "examples": [
                                            {
                                                "example_id": "0c93ee3e-ac1f-4dba-a1c1-602a6d9c2bc7",
                                                "sense_id": "8f1d2e4d-e5d8-3391-8b75-a617ec43517d",
                                                "text": "According to Iversen the steep decline of Hedera must be effected by a change of climate, viz. a fall in winter temperatures which would be characteristic of the Subboreal time."
                                            },
                                            {
                                                "example_id": "15a703dc-8207-4a66-a81b-c6f8940e8732",
                                                "sense_id": "8f1d2e4d-e5d8-3391-8b75-a617ec43517d",
                                                "text": "The people had a significant effect on the vegetation in the Subboreal (accelerated replacement of deciduous trees by Picea)."
                                            },
                                            {
                                                "example_id": "ee3d28b9-a414-43ed-b660-02218adb91b7",
                                                "sense_id": "8f1d2e4d-e5d8-3391-8b75-a617ec43517d",
                                                "text": "Results obtained from disciplines as varied as pollen analysis, geomorphology and archeology point at more humid and cool climate for the beginning of the Subboreal (5.500 – +/- 4.000 BP) (28) (32) (18) in the Levant."
                                            }
