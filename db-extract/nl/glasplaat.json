                                    },
                                    {
                                        "sense_id": "f36772f4-bfeb-3968-bbd2-b6717ec480b4",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "Precipitation of such quantity and force as to resemble a thin, virtually solid wall."
                                        ],
