                        "source_sense_description": "Sinn, Grund der Existenz, des Daseins von etwas",
                        "target_lang_word": "reason for existence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
