                "senses": [
                    {
                        "sense_id": "36431434-c38b-3532-98e9-c992a7b53948",
                        "entry_id": "f0ee24a8-dbbb-3226-9b5a-faa6b84db893",
                        "glosses": [
                            "Donner un caractère théophilanthrope à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5724ecc2-e3df-4c1f-9951-574f270eaa0d",
                                "sense_id": "36431434-c38b-3532-98e9-c992a7b53948",
                                "text": "Après avoir ainsi payé sa dette à sa position, il s’élève contre la possibilité de créer une religion nouvelle, appelle les théophilanthropes, qui veulent théophilanthropiser le peuple, les frêles rejetons des unitaires ; il se moque du calendrier républicain et de son décadi."
                            },
                            {
                                "example_id": "dece4ba7-5e2a-464e-aa36-2a70f0850f01",
                                "sense_id": "36431434-c38b-3532-98e9-c992a7b53948",
                                "text": "La députation demanda la liberté des cultes et la conservation des églises et des biens de fondation : non, tout sera théophilanthropisé."
                            }
                        ]
                    }
                ],
