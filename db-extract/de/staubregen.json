                "senses": [
                    {
                        "sense_id": "b42184fd-61a5-3d1f-90df-68436c763c7a",
                        "entry_id": "b89ee2c3-95a5-3a56-82fe-ec54a4a0f532",
                        "glosses": [
                            "Regen, der in Form von ganz feinen Regentropfen niedergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78799095-ade3-485d-aa8b-c0cc13507e91",
                                "sense_id": "b42184fd-61a5-3d1f-90df-68436c763c7a",
                                "text": "„Der Himmel hatte sich indessen ganz umzogen, und ein feiner, durchdringender Staubregen fing an niederzufallen.«“"
                            },
                            {
                                "example_id": "2ca0018e-bda1-4663-b22f-5436e94d4851",
                                "sense_id": "b42184fd-61a5-3d1f-90df-68436c763c7a",
                                "text": "„Kurz danach rieselte ein kalter Staubregen auf ihn nieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f9b2f86-c911-3fd0-b899-6b43d31f6c49",
