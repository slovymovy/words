                        "glosses": [
                            "Brain-washing, conditioning people to abandon their beliefs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12318ab3-8b0b-4507-b949-d8c2cc9c580d",
                                "sense_id": "c5c16115-1505-3beb-a6d2-62261a649c8b",
                                "text": "In the last phases of brainwashing and menticide, the self-humiliating submission of the victims serves as an inner defensive device annihilating the prosecuting inquisitor in a magic way."
                            }
                        ]
                    },
                    {
                        "sense_id": "649353d3-c7f0-3eba-b66e-56cb5d91a879",
                        "entry_id": "039b04a8-92c0-35c7-8db5-b5e4d4a20c99",
                        "glosses": [
                            "Efforts to destroy the mind or the will of an individual or group of people."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5017a851-e213-4371-beb8-1f45e7d6c8b7",
                                "sense_id": "649353d3-c7f0-3eba-b66e-56cb5d91a879",
                                "text": "In response, black groups accuse school personnel of practicing genocide and \"menticide\" (miseducation) for allowing black children to get away with conduct they would not condone in white children."
                            },
                            {
                                "example_id": "5f0ecabe-808d-45f2-b42b-c6c0e27b7ad9",
                                "sense_id": "649353d3-c7f0-3eba-b66e-56cb5d91a879",
                                "text": "I wanted then — and I want today — no laws against \"mental kidnapping\" or \"mentacide\" or any other socially unacceptable state of mind."
                            }
                        ]
                    }
                ],
