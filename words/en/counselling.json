{
    "word_family": [
        "counsel",
        "counsellor",
        "counselor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f259e6e3-13e4-3f03-b864-2ac87f0e50f6",
                    "sense_definition": "Professional advice or guidance provided by a trained person to help someone with personal or psychological problems.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "therapy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the traumatic event, the school offered <w>counselling</w> to all students and staff.",
                            "target_lang_translations": {
                                "ru": "После травмирующего события школа предложила <w>психологическую помощь</w> всем ученикам и сотрудникам."
                            }
                        },
                        {
                            "text": "She decided to seek marriage <w>counselling</w> to help resolve the ongoing conflicts in her relationship.",
                            "target_lang_translations": {
                                "ru": "Она решила обратиться за <w>консультацией по вопросам брака</w>, чтобы помочь разрешить затянувшиеся конфликты в отношениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "therapy",
                        "guidance",
                        "advice"
                    ],
                    "common_phrases": [
                        "marriage counselling",
                        "grief counselling",
                        "seek counselling",
                        "trauma counselling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональная помощь или руководство, предоставляемое специалистом для решения личных или психологических проблем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консультирование",
                                "target_lang_sense_clarification": "процесс оказания психологической помощи"
                            },
                            {
                                "target_lang_word": "психологическая помощь",
                                "target_lang_sense_clarification": "поддержка специалиста"
                            },
                            {
                                "target_lang_word": "терапия",
                                "target_lang_sense_clarification": "в контексте психотерапевтических сессий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "784dbd77-6f9a-3d0f-b834-a1e7bdb532d5",
                    "sense_definition": "The act of giving professional advice or guidance to someone; the present participle of <w>counsel</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer is currently <w>counselling</w> his client on the best way to proceed with the case.",
                            "target_lang_translations": {
                                "ru": "Адвокат в настоящее время <w>консультирует</w> своего клиента о том, как лучше всего вести дело."
                            }
                        },
                        {
                            "text": "By <w>counselling</w> young people, she hopes to prevent them from making the same mistakes she did.",
                            "target_lang_translations": {
                                "ru": "<w>Давая советы</w> молодым людям, она надеется уберечь их от тех же ошибок, которые совершила сама."
                            }
                        }
                    ],
                    "synonyms": [
                        "advising",
                        "guiding",
                        "mentoring"
                    ],
                    "common_phrases": [
                        "counselling a client",
                        "counselling students"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс предоставления профессионального совета или руководства; причастие настоящего времени от глагола «консультировать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консультирование",
                                "target_lang_sense_clarification": "действие по предоставлению совета"
                            },
                            {
                                "target_lang_word": "давать советы",
                                "target_lang_sense_clarification": "в профессиональном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}