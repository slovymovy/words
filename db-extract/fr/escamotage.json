                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ba1533-da93-468c-afe5-3cb9e06d0651",
                                                "sense_id": "76f3cc96-bf85-354d-9d8d-e9966bb20aa1",
                                                "text": "Hij kwam terug van zijn maandelijkse verdwijntruc en was op weg naar huis."
                                            },
                                            {
                                                "example_id": "3e97e1c5-e8ce-44ce-8ce7-bd96d6d99590",
                                                "sense_id": "76f3cc96-bf85-354d-9d8d-e9966bb20aa1",
                                                "text": "Het Spaanse verbond voor Slachtoffers van Terrorisme spreekt van \"een verdwijntruc, een pantomime, een farce\"."
                                            }
                                        ]
                                    }
                                ]
                            }
