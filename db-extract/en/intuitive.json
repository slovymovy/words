                    {
                        "translation_id": "36655a51-41d5-4bab-a846-d5c64b0d4914",
                        "source_entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "source_sense_description": "automatic, without requiring conscious thought",
                        "target_lang_word": "intuïtief",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intuïtief",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "db7bb038-68ad-3512-b711-f6fba3708f18",
                                        "entry_id": "a8d5de7d-5003-3bba-b304-b3454b35d41a",
                                        "glosses": [
                                            "gevoelsmatig, instinctmatig, gedachteloos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86a3fd3-0a8c-400a-9f18-d611597262ed",
                                                "sense_id": "db7bb038-68ad-3512-b711-f6fba3708f18",
                                                "text": "Albert weet niet wat hem overkomt, intuïtief pakt hij de schouder van de oude man en duwt. De dode rolt log om en komt op zijn buik te liggen. Albert heeft een paar seconden nodig voor hij het beseft. Dan springt de waarheid hem in het oog: als je op de vijand afgaat, sterf je niet door twee kogels in je rug."
                                            },
                                            {
                                                "example_id": "b7f7065c-9000-4e9b-8a75-229871066431",
                                                "sense_id": "db7bb038-68ad-3512-b711-f6fba3708f18",
                                                "text": "Een jongen van 20 jaar uit Texas had me verteld dat hij na het afronden van zijn school direct twee banen had moeten nemen en zich rot verveelde in zijn leven. Heel intuïtief besloot hij drie weken voor vertrek alles op te zeggen en te gaan lopen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8048db7f-8b4e-47fe-9ace-335bcc2526b1",
                        "source_entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "source_sense_description": "automatic, without requiring conscious thought",
                        "target_lang_word": "intuitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intuitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                                        "glosses": [
                                            "Qui fait appel à l’intuition, qui est automatique ou inné et ne fait pas ou peu appel à la raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e678760-f794-40ce-af91-20478f4ea22f",
                                                "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                                            },
                                            {
                                                "example_id": "b09c1fd8-3e18-430b-83c2-4c97221d647a",
                                                "sense_id": "2fb102dc-8e8b-3083-be0f-24c9a1ffdcc2",
                                                "text": "Elle est très intuitive dans ses jugements sur les gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                                        "glosses": [
                                            "Qui résulte de l’intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf2a0442-1e5c-478e-a987-27b218d34ca8",
                                                "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                                                "text": "Les bienheureux ont la vision intuitive de Dieu."
                                            },
                                            {
                                                "example_id": "ed2e6d01-70a5-4fad-b042-0244c067b33e",
                                                "sense_id": "3e09e9c9-933d-3978-8404-f836fb5602d9",
                                                "text": "Connaissance intuitive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6b11263-869e-3af5-8b9a-2c95404b4ed4",
                                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                                        "glosses": [
                                            "Qui fait appel au sens plutôt qu’au raisonnement ou à la mémoire de celui qui apprend."
                                        ],
                                        "tags": [
                                            "Pédagogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc945ff-4aab-400e-83b4-6a116c141297",
                                                "sense_id": "e6b11263-869e-3af5-8b9a-2c95404b4ed4",
                                                "text": "Méthode intuitive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intuitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2194ea5-e04f-3986-a81c-bee518e169cb",
                                        "entry_id": "9b9d6b1a-2818-3a60-bd86-452906e2aa05",
                                        "glosses": [
                                            "Personne qui fait appel à son intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e429311e-42bb-4f33-9a57-bd86dc5b6eb3",
                                                "sense_id": "e2194ea5-e04f-3986-a81c-bee518e169cb",
                                                "text": "C’est un intuitif."
                                            },
                                            {
                                                "example_id": "96f336f5-453f-43fe-958a-6268b6ee45e1",
                                                "sense_id": "e2194ea5-e04f-3986-a81c-bee518e169cb",
                                                "text": "Dire que je ne me sentais pas en sécurité à propos de son nouveau petit ami pourrait sembler être une déclaration simple et générique, mais pour un intuitif, cela signifie beaucoup plus que ça."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb94360-accf-4e88-ba0e-34e1568845cc",
                        "source_entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
