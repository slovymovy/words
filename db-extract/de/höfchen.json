                "senses": [
                    {
                        "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                        "entry_id": "41b1cba4-0097-39bc-89db-9b5f0a3e6ef1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a438124-0544-48e7-871c-33f1dedee205",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Frau Höfchen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bf2b639b-d10e-4d01-b56b-8fd9df6d5fd3",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Herr Höfchen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7b5e8309-25fe-4f0f-9d4f-c6e807496bce",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Die Höfchens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b950c382-a46d-4d5e-bd8e-84888ae12e2e",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Der Höfchen trägt nie die Schals, die die Höfchen ihm strickt."
                            },
                            {
                                "example_id": "98b3cd73-151d-4128-9eb5-c6297b65b43d",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Höfchen kommt, geht der Herr Höfchen.“"
                            },
                            {
                                "example_id": "46e8f6e8-d284-4b5c-b412-3046efb6d953",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Höfchen kommt und geht."
                            },
                            {
                                "example_id": "4a1a3b38-f129-4fc4-a877-91749731f834",
                                "sense_id": "9dce31fc-1a3c-3510-9f0c-842dd18717e6",
                                "text": "Höfchens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
