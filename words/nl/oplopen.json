                        "steil oplopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To slope upwards (regarding a road or terrain).",
                        "ru": "Идти на подъём или иметь уклон вверх (о дороге или местности).",
                        "zh": "指道路或地形向上倾斜。"
                    },
                    "translations": {
