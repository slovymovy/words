                {
                    "sense_id": "3867eea4-4fe5-3a90-a09b-9a2e0c9ed210",
                    "sense_definition": "iemand een voldaan gevoel geven door volledig aan een behoefte of honger te voldoen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voldoening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de uitgebreide maaltijd voelde hij zich eindelijk volledig <w>verzadigd</w>.",
                            "target_lang_translations": {
                                "en": "After the extensive meal, he finally felt completely <w>satiated</w>."
                            }
                        },
                        {
                            "text": "Deze stevige soep zal de hongerige wandelaars zeker <w>verzadigen</w>.",
                            "target_lang_translations": {
                                "en": "This hearty soup will certainly <w>satisfy</w> the hungry hikers."
                            }
                        }
                    ],
                    "synonyms": [
