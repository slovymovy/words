                "word": "radioactivity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "12e0969d-87f2-4634-bdde-db14dc44f017",
                        "entry_id": "3053d7b8-4911-3221-a93b-5aeaac50645c",
                        "tags": [
                            "plural"
                        ],
                        "form": "radioactivities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e4ab773-bbc9-3c6e-9fe5-a9cc04a8e2e2",
                        "entry_id": "3053d7b8-4911-3221-a93b-5aeaac50645c",
                        "glosses": [
                            "Spontaneous emission of ionizing radiation as a consequence of a nuclear reaction, or directly from the breakdown of an unstable nucleus."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5c6f6a3a-d84d-4e07-9552-cdd41f05b345",
                                "sense_id": "1e4ab773-bbc9-3c6e-9fe5-a9cc04a8e2e2",
                                "text": "Today, no one would intentionally smear radioactive materials on their face, but in 1933, the dangers of radioactivity were not yet fully understood."
                            }
                        ]
                    },
                    {
                        "sense_id": "061ce6c6-bd5f-35c4-a3c5-f2e80fd27f47",
                        "entry_id": "3053d7b8-4911-3221-a93b-5aeaac50645c",
                        "glosses": [
                            "The radiation so emitted; including gamma rays, alpha particles, neutrons, electrons, positrons, etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30fdb3d3-3e32-446f-a419-a0cf7cbeff0c",
