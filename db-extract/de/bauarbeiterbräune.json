                "senses": [
                    {
                        "sense_id": "8a970922-0b74-3330-97bb-e60ec294c383",
                        "entry_id": "283f3c1e-c328-3b19-8369-bb508c71fc38",
                        "glosses": [
                            "beim Sonnenbad oder Arbeiten entstehende Bräunung der Haut, die charakteristische helle Fehlstellen durch zuvor getragene Kleidungsstücke aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8cb56af-1417-4a51-8f53-aaeba06ef9b8",
                                "sense_id": "8a970922-0b74-3330-97bb-e60ec294c383",
                                "text": "Nachdem ich gestern den ganzen Tag mit dem Fahrrad fuhr, hatte ich eine Bauarbeiterbräune."
                            },
                            {
                                "example_id": "09ecd722-ce13-43fe-ac1c-e4cdaf01a85e",
                                "sense_id": "8a970922-0b74-3330-97bb-e60ec294c383",
                                "text": "„Die Bauarbeiterbräune tritt ebenfalls hauptsächlich in Zeiten vermehrter natürlicher Sonnenbestrahlung auf.“"
                            },
                            {
                                "example_id": "823be55f-817b-4d5c-b0eb-23669e8b70b6",
                                "sense_id": "8a970922-0b74-3330-97bb-e60ec294c383",
                                "text": "„Es geht voran: Die Sonne scheint wieder über Berlin. Zur Bauarbeiterbräune reichen die Strahlen vermutlich noch nicht, aber die Arbeit an der U-Bahn-Baustelle an der Friedrichstraße macht Fortschritte.“"
                            }
                        ],
