                "senses": [
                    {
                        "sense_id": "3d3fc2b7-399e-3af3-ad15-3a5c73c16860",
                        "entry_id": "a1406d8b-f3c1-358a-a1f3-af2eccf598f3",
                        "glosses": [
                            "Zustand, dass ein größerer Teil des Kopfhaares fehlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91376f31-2af0-47b7-8e3c-e2ea5c460427",
                                "sense_id": "3d3fc2b7-399e-3af3-ad15-3a5c73c16860",
                                "text": "„Er war groß, hatte eine Halbglatze und ein Gesicht voller Lachfältchen.“"
                            },
                            {
                                "example_id": "3180998c-1f83-44be-801f-d779cd93bb09",
                                "sense_id": "3d3fc2b7-399e-3af3-ad15-3a5c73c16860",
                                "text": "„Mit seinem brustlangen Bart und der Halbglatze erinnert Kumar an einen weisen Gelehrten.“"
                            },
                            {
                                "example_id": "55cee8f7-4dfc-47b0-8273-c868a9e34ea2",
                                "sense_id": "3d3fc2b7-399e-3af3-ad15-3a5c73c16860",
                                "text": "„Der Kellner, ein großer dünner Mann, der seine wenigen Haare quer über die Halbglatze geklatscht hatte und einen dichten altmodischen Dragonerschnurrbart trug, wiederholte die Bestellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
