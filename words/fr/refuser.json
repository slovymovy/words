{
    "word_family": [
        "refus",
        "refusable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3477e1cd-772c-3dc1-a0f9-8f5fe602b2ff",
                    "sense_definition": "Dire non à une demande ou à un ordre ; ne pas vouloir faire ce qui est demandé ou exigé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "refuser_ne_pas_accepter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>refusé</w> de venir à la fête hier soir."
                        },
                        {
                            "text": "Le témoin <w>refuse</w> de répondre aux questions du juge."
                        },
                        {
                            "text": "Ma sœur <w>refuse</w> de manger du poisson depuis qu'elle est petite."
                        }
                    ],
                    "antonyms": [
                        "accorder"
                    ],
                    "common_phrases": [
                        "refuser de répondre",
                        "refuser de participer",
                        "refuser catégoriquement"
                    ]
                },
                {
                    "sense_id": "7d025043-23c2-3798-acf9-46847ef32345",
                    "sense_definition": "Ne pas accepter ce qui est offert ou proposé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "refuser_ne_pas_accepter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lui ai proposé de l'aider, mais il a <w>refusé</w> poliment."
                        },
                        {
                            "text": "Elle a <w>refusé</w> l'offre d'emploi parce que le salaire était trop bas."
                        },
                        {
                            "text": "Nous avons <w>refusé</w> leur invitation à dîner car nous étions fatigués."
                        }
                    ],
                    "synonyms": [
                        "rejeter"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "refuser une offre",
                        "refuser une invitation",
                        "refuser poliment"
                    ]
                },
                {
                    "sense_id": "0df7e55b-8a68-3c4e-8218-571ecf30a0e6",
                    "sense_definition": "Ne pas admettre quelqu'un (à un examen, à l'entrée d'un lieu, dans un groupe) ; ne pas accepter sa candidature ou sa demande.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refuser_quelqu_un",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le videur a <w>refusé</w> plusieurs personnes à l'entrée de la boîte de nuit."
                        },
                        {
                            "text": "Il a été <w>refusé</w> à son examen de conduite pour la deuxième fois."
                        },
                        {
                            "text": "L'école a <w>refusé</w> beaucoup de candidats cette année, faute de places."
                        }
                    ],
                    "common_phrases": [
                        "refuser du monde",
                        "refusé à un examen"
                    ]
                },
                {
                    "sense_id": "ef065850-b985-3f4f-83e3-7bdb56092466",
                    "sense_definition": "Ne pas donner ni accorder quelque chose à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refuser_ne_pas_accepter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque lui a <w>refusé</w> un prêt malgré ses garanties."
                        },
                        {
                            "text": "On ne peut pas lui <w>refuser</w> ce droit, il est inscrit dans la loi."
                        },
                        {
                            "text": "L'ambassade a <w>refusé</w> son visa sans donner d'explication."
                        }
                    ],
                    "antonyms": [
                        "accorder"
                    ],
                    "common_phrases": [
                        "refuser un prêt",
                        "refuser un visa",
                        "refuser un droit"
                    ]
                },
                {
                    "sense_id": "e1ee91c6-6a9c-3204-ac5d-20b403b99108",
                    "sense_definition": "Écarter quelqu'un en refusant de le recevoir ou de le fréquenter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refuser_quelqu_un",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis leur dispute, il <w>refuse</w> tous ses anciens amis."
                        },
                        {
                            "text": "Elle est si fâchée qu'elle <w>refuse</w> tout le monde, même sa famille."
                        }
                    ],
                    "common_phrases": [
                        "refuser tout le monde"
                    ]
                },
                {
                    "sense_id": "c81036f3-cae3-3fef-b38a-e5ecffcac17c",
                    "sense_definition": "Éviter d'engager une action, surtout un combat ; ne pas s'y engager.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ennemi <w>refusait</w> le combat et restait derrière ses murs."
                        },
                        {
                            "text": "Le général a <w>refusé</w> la bataille pour protéger ses troupes."
                        }
                    ],
                    "common_phrases": [
                        "refuser le combat",
                        "refuser la bataille"
                    ]
                },
                {
                    "sense_id": "6106f76c-503b-3cc1-80d8-01a63f3c99ea",
                    "sense_definition": "En parlant du vent, devenir contraire à la direction suivie par un bateau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent <w>refuse</w> et le capitaine doit changer de cap."
                        },
                        {
                            "text": "Vers midi, le vent a <w>refusé</w> et nous avons dû louvoyer jusqu'au port."
                        }
                    ]
                }
            ]
        }
    ]
}