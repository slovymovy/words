                        "glosses": [
                            "Relating to, derived from, or characteristic of mushrooms of the genus Boletus."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d80fa9f6-9331-433e-a26a-cd3b5694af2b",
                                "sense_id": "41487c4f-8762-3472-ae37-784cfd5c5267",
                                "text": "Its shady recesses would then harbor that special boletic reek which makes a Russian’s nostrils dilate— a dark, dank, satisfying blend of damp moss, rich earth, rotting leaves."
                            },
                            {
                                "example_id": "ddb65289-83d4-43da-bae7-32853fbc7be0",
                                "sense_id": "41487c4f-8762-3472-ae37-784cfd5c5267",
                                "text": "I inhaled deeply the dank, boletic smell around the woody fungus."
                            },
                            {
                                "example_id": "01932d26-0c41-442c-923b-7d6183741044",
                                "sense_id": "41487c4f-8762-3472-ae37-784cfd5c5267",
                                "text": "It was the dank smell of the earth turning leaves and needles to rich soil, a beautiful rotting boletic smell that meant mushrooms."
                            }
                        ]
                    }
