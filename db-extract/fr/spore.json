                                        "sense_id": "dbaf1d6b-9821-375a-99d3-00f7c06ad02e",
                                        "entry_id": "6ee56234-e875-3cd8-8625-64aaf62c1214",
                                        "glosses": [
                                            "A reproductive particle, usually a single cell, released by a fungus, alga, or plant that may germinate into another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0039e296-b689-4d41-ba32-f2908785d78d",
                                                "sense_id": "dbaf1d6b-9821-375a-99d3-00f7c06ad02e",
                                                "text": "Thresher maws are subterranean carnivores that spend their entire lives eating or searching for something to eat. Threshers reproduce via spores that lie dormant for millennia, yet are robust enough to survive prolonged periods in deep space and atmospheric re-entry. As a result, thresher spores appear on many worlds, spread by previous generations of space travelers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf2c1e3b-d797-388d-ab0e-d90db735b014",
                                        "entry_id": "6ee56234-e875-3cd8-8625-64aaf62c1214",
                                        "glosses": [
                                            "A thick resistant particle produced by a bacterium or protist to survive in harsh or unfavorable conditions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
