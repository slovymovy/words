    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2c8b060-774b-3746-882e-f6051f9bba8b",
                    "sense_definition": "Местность, удалённая от столицы или крупных культурных и промышленных центров; также окраинные районы города.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие молодые специалисты уезжают из столицы и успешно работают на <w>периферии</w>."
                        },
                        {
                            "text": "Жизнь на городской <w>периферии</w> обычно протекает гораздо спокойнее, чем в шумном центре."
                        }
                    ],
                    "synonyms": [
                        "окраина"
                    ],
                    "antonyms": [
                        "центр"
                    ],
                    "common_phrases": [
                        "глухая периферия",
                        "жить на периферии"
                    ]
                },
                {
                    "sense_id": "73b4b23c-8860-3360-b264-9e2371fee9e7",
                    "sense_definition": "Внешняя или удалённая от центра часть какого-либо пространства, предмета или системы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outer_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>периферии</w> поля зрения внезапно возникло какое-то странное движение."
                        },
                        {
                            "text": "Температура вещества на <w>периферии</w> диска заметно ниже, чем в его центральной области."
                        }
                    ],
                    "synonyms": [
                        "край"
                    ],
                    "antonyms": [
                        "центр"
                    ],
                    "common_phrases": [
                        "на периферии зрения"
                    ]
                },
                {
                    "sense_id": "a2d4ab80-5eab-3c89-8b9e-efd5feb0745b",
                    "sense_definition": "Внешние аппаратные компоненты компьютера, предназначенные для ввода, вывода или долговременного хранения информации.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После сборки системного блока необходимо правильно подключить всю компьютерную <w>периферию</w>."
                        },
                        {
                            "text": "В магазине продаются качественные мониторы, клавиатуры и другая полезная <w>периферия</w>."
                        }
                    ],
                    "synonyms": [
                        "периферийные устройства"
                    ],
                    "common_phrases": [
                        "компьютерная периферия",
                        "подключение периферии"
                    ],
                    "traits": [
