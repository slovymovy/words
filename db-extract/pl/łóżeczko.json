                                        "entry_id": "dbaf6e46-6a48-37ad-9dc9-a594b08567a9",
                                        "glosses": [
                                            "A simple bed, especially one for portable or temporary purposes."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc09cfc9-8ee8-4b3e-a035-be7c17021f1e",
                                                "sense_id": "b77201d6-6626-30b2-a355-0835a8659715",
                                                "text": "There was a flickering of lanterns about the camp that night, and a rumor that brought men out of their cots to the tent doors, a paddling of the naked feet of doolie-bearers and the rush of a galloping horse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31dc2cdc-6635-3738-bdbf-ab4ab508c0a6",
                                        "entry_id": "dbaf6e46-6a48-37ad-9dc9-a594b08567a9",
                                        "glosses": [
                                            "A bed for infants or small children, with high, often slatted, often moveable sides."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67d17292-2646-3959-947d-5ae6919118b6",
                                        "entry_id": "dbaf6e46-6a48-37ad-9dc9-a594b08567a9",
                                        "glosses": [
                                            "A wooden bed frame, slung by its corners from a beam, in which officers slept before the introduction of bunks."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cot",
