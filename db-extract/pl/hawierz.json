                        "cross_references": [
                            {
                                "target_word": "Hauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2040377-e2f6-3af1-bfc1-5688addc1ffc",
                                        "entry_id": "d4acf4d4-c185-3747-8ad4-ccbfabc9297b",
                                        "glosses": [
                                            "Plural 3 Bergmann, Arbeiter im Bergbau, der Bodenschätze und Gestein aus dem Berg löst"
                                        ],
                                        "tags": [
                                            "Bergbau",
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d530df49-fb41-4f7d-be3b-8b1b82817886",
                                                "sense_id": "c2040377-e2f6-3af1-bfc1-5688addc1ffc",
                                                "text": "Hauer sind Bergleute."
                                            },
                                            {
                                                "example_id": "cb25a10f-0633-4d7e-b6f7-67aaa63b0910",
                                                "sense_id": "c2040377-e2f6-3af1-bfc1-5688addc1ffc",
                                                "text": "„Schröder, der auf der Schachtanlage Walsum zunächst Hauer lernte, erwarb zwar viele Sachbücher und Werke namhafter Dichter, Schriftsteller oder Großdenker; aber mindestens ebenso viel Geld gab er für Trivialliteratur aus.“"
                                            },
                                            {
                                                "example_id": "0661d3fe-f2d7-440e-b5eb-aae05d323d1f",
                                                "sense_id": "c2040377-e2f6-3af1-bfc1-5688addc1ffc",
                                                "text": "„Mehrere Jahre arbeitete er in Bottrop und Elberfeld als Hauer und Steiger.“"
                                            },
                                            {
                                                "example_id": "72aab270-c191-41fb-ba3a-b7491c753edd",
                                                "sense_id": "c2040377-e2f6-3af1-bfc1-5688addc1ffc",
                                                "text": "„Wenn der Hauer die Erzbrocken aus dem Stollen geklopft hat, sind sie noch lange nicht aus dem Berg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82827c3b-3ef9-350c-9b73-9f85ac31ee2b",
                                        "entry_id": "d4acf4d4-c185-3747-8ad4-ccbfabc9297b",
                                        "glosses": [
                                            "die hervorstehenden Eckzähne eines Keilers"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdaa453a-2a5d-4faf-825c-2b2c3e7aed1a",
                                                "sense_id": "82827c3b-3ef9-350c-9b73-9f85ac31ee2b",
                                                "text": "Manche Tiere haben mächtige Hauer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60ff0f4b-0263-3080-a85f-dd7305ee8804",
                                        "entry_id": "d4acf4d4-c185-3747-8ad4-ccbfabc9297b",
                                        "glosses": [
                                            "der Weinbauer, der Winzer"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
