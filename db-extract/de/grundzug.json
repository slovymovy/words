                "senses": [
                    {
                        "sense_id": "35040224-6335-39ea-b4fc-71eeaf49d55f",
                        "entry_id": "c917aea9-3493-3927-862c-845fdc47e0a7",
                        "glosses": [
                            "wichtigste Eckpunkte"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "37c327d9-b948-4b5d-a201-9a87eb7b0392",
                                "sense_id": "35040224-6335-39ea-b4fc-71eeaf49d55f",
                                "text": "„Gleichwohl bestreiten die Kreationisten nicht nur die Evolution, sondern auch die Grundzüge der Erdgeschichte, der Biologie, Zoologie, Paläontologie, Geschichte et cetera.“"
                            },
                            {
                                "example_id": "b31e1afb-ec64-4e86-8f56-c0779237e9bd",
                                "sense_id": "35040224-6335-39ea-b4fc-71eeaf49d55f",
                                "text": "Davon habe ich nur die Grundzüge begriffen, eigentlich ist mir das zu hoch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ecc64ff5-0b5d-3028-9b80-cf0f99a0b5b9",
                        "entry_id": "c917aea9-3493-3927-862c-845fdc47e0a7",
                        "glosses": [
                            "hervorstechendes Merkmal; eine Haupteigenschaft, die charakteristisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c098057-2b12-4dd9-8bb7-25cf8ee18f8a",
                                "sense_id": "ecc64ff5-0b5d-3028-9b80-cf0f99a0b5b9",
                                "text": "Ein Grundzug des Verfahrens ist die größtmögliche Transparenz und damit die Überprüfbarkeit der Ergebnisse."
                            },
                            {
                                "example_id": "a8979f24-1107-42f6-98a3-085c52576983",
                                "sense_id": "ecc64ff5-0b5d-3028-9b80-cf0f99a0b5b9",
                                "text": "„Ehrenstein schildert als einen Grundzug des Lebens den menschlichen Masochismus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
