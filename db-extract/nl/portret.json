                        ],
                        "form": "portretjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                        "entry_id": "39633e21-4b6e-3586-8577-54eb586541f7",
                        "glosses": [
                            "schilderij, foto of andere artistieke voorstelling van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea5091c-ea4f-43ff-aa33-df5c7928be79",
                                "sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                                "text": "Hebt u het portret gezien boven de haard? U herkent zonder twijfel de markante en nobele trekken van Niccoló Paganini. Ik zal de eerste zijn om uw gelijk te beamen wanneer u zegt dat het in schilderkundig opzicht geen meesterwerk betreft. Het is gemaakt door een brave, mindere meester, die er zelfs in zijn tijd niet om bekendstond dat hij zijn tijd vooruit was."
                            },
                            {
                                "example_id": "735bb079-c9c0-41cf-ba6b-07f5f68d03b6",
                                "sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                                "text": "Ik ben Krijn van Noordwijk zeer erkentelijk voor het fotograferen van mijn portret."
                            }
                        ]
                    },
                    {
                        "sense_id": "286fc7cc-9dc9-34b1-9435-1beba019bb63",
                        "entry_id": "39633e21-4b6e-3586-8577-54eb586541f7",
                        "glosses": [
                            "een markant persoon"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b03fd0f3-35d3-4f91-b282-36618c6d0cf1",
                        "source_entry_id": "39633e21-4b6e-3586-8577-54eb586541f7",
                        "source_sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                        "source_sense_description": "schilderij, foto of andere artistieke voorstelling van een persoon",
                        "target_lang_word": "Porträt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Porträt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8fbb0ae-7a59-3fd3-a6fd-bfaa58068690",
                                        "entry_id": "4084540a-02e6-305c-b4a7-eda1ae37012c",
                                        "glosses": [
                                            "eine Darstellung einer Person, meist in Form eines Gemäldes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49783bdb-f0ea-420b-b215-daa526db8d6c",
                                                "sense_id": "d8fbb0ae-7a59-3fd3-a6fd-bfaa58068690",
                                                "text": "„Die Absicht eines Porträts ist, das Wesen, beziehungsweise die Persönlichkeit der porträtierten Person zum Ausdruck zu bringen.“ - Wikipedia.de"
                                            },
                                            {
                                                "example_id": "ddf5e4e8-8b2c-4681-a387-8b9a2e146685",
                                                "sense_id": "d8fbb0ae-7a59-3fd3-a6fd-bfaa58068690",
                                                "text": "„Das Vorhandensein des Porträts störte mich mehr als das Vorhandensein des Porträtierten.“"
                                            },
                                            {
                                                "example_id": "a98c3746-13e3-4f94-97f3-96d7323a460c",
                                                "sense_id": "d8fbb0ae-7a59-3fd3-a6fd-bfaa58068690",
                                                "text": "„An die Wand hängte sie das Porträt Konrad Adenauers von Oskar Kokoschka.“"
                                            },
                                            {
                                                "example_id": "b077daf9-c0ac-4b1a-b6d5-779be964f613",
                                                "sense_id": "d8fbb0ae-7a59-3fd3-a6fd-bfaa58068690",
                                                "text": "„Außerdem verordnete er der neuen Republik eine Briefmarkenserie mit seinem Porträt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "023a949d-9d6b-36a7-a110-38af32371c3a",
                                        "entry_id": "4084540a-02e6-305c-b4a7-eda1ae37012c",
                                        "glosses": [
                                            "eine schriftliche Beschreibung einer Person beziehungsweise eines Gegenstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30177979-fbc3-427b-8bf6-576f1ee062f3",
                                                "sense_id": "023a949d-9d6b-36a7-a110-38af32371c3a",
                                                "text": "„In einem schönen Porträt schildert er Rilkes Umgang mit Menschen, mit Dingen und mit Orten, seine lautlose, zurückhaltende Art, seinen Schönheitssinn, seine Absonderung.“"
                                            },
                                            {
                                                "example_id": "851484a4-7448-4fbb-9161-69f2d7f521e6",
                                                "sense_id": "023a949d-9d6b-36a7-a110-38af32371c3a",
                                                "text": "„Seine Mutter bestätigte ihm dann auch, dass das Porträt das Wesen des Vaters trotz der Verfremdung bis in die Nuancen genau getroffen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1d1ad48-4c6e-4e2a-a589-45f1d5b4f0e7",
                        "source_entry_id": "39633e21-4b6e-3586-8577-54eb586541f7",
                        "source_sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                        "source_sense_description": "schilderij, foto of andere artistieke voorstelling van een persoon",
                        "target_lang_word": "portrait",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portrait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117896a3-0871-3af1-8343-43a602714dbc",
                                        "entry_id": "803180f2-32d0-3cf3-899e-4643b8764db8",
                                        "glosses": [
                                            "A painting or other picture of a person, especially the head and shoulders."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b23c25b-d0ca-4285-a7a3-1e8dde77e934",
                                                "sense_id": "117896a3-0871-3af1-8343-43a602714dbc",
                                                "text": "In portraits, the grace, and, we may add, the likeness, consists more in the general air than in the exact similitude of every feature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35a493da-1ead-3be7-b748-2918f00240d7",
                                        "entry_id": "803180f2-32d0-3cf3-899e-4643b8764db8",
                                        "glosses": [
                                            "An accurate depiction of a person, a mood, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41831f2a-0df5-4c0c-8216-4813a5f09894",
                                                "sense_id": "35a493da-1ead-3be7-b748-2918f00240d7",
                                                "text": "The author painted a good portrait of urban life in New York in his latest book."
                                            },
                                            {
                                                "example_id": "de4eb3b1-3187-4e0b-b4b5-92a9bd04dd0b",
                                                "sense_id": "35a493da-1ead-3be7-b748-2918f00240d7",
                                                "text": "She showed me her portrait, written by herself. I only remember what she states of her mouth, which, she says, was not only beautiful and red, but had a thousand little natural airs and graces not to be found in any other mouth. Oh, I must not forget her figure, which, she assured the reader, was the best-made and the finest that could be seen: nothing could be more regular, more graceful, or more easy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "262a693d-90b0-3daa-a814-e00c38c0da54",
                                        "entry_id": "803180f2-32d0-3cf3-899e-4643b8764db8",
                                        "glosses": [
                                            "A print orientation where the vertical sides are longer than the horizontal sides."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "portrait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d937e2ca-6ddf-34d6-941e-50869d94cd7a",
                                        "entry_id": "92b73813-de06-390c-a995-da9c7467ce9c",
                                        "glosses": [
                                            "To portray; to draw."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11404d09-a068-48e8-9646-0e2e141805ee",
                                                "sense_id": "d937e2ca-6ddf-34d6-941e-50869d94cd7a",
                                                "text": "But all as in most exquisite pictures, they vse to blaze and portrait, not only the daintie lineaments or beautie, but also round about it to shadowe the rude thickets and craggy clifts"
                                            },
                                            {
                                                "example_id": "0d2e2ee9-f6e3-4ede-8b12-0c16beed25e7",
                                                "sense_id": "d937e2ca-6ddf-34d6-941e-50869d94cd7a",
                                                "text": "Methinkes yᵉ picture of Sᵗ George fighting with yᵉ Dragon hath some resemblance of Sᵗ Michael fighting with the Devil, who is pourtrated like a Dragon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "portrait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87f69b04-0e02-3d1c-9eef-4c89290ad243",
                                        "entry_id": "de44f2f5-6694-3a79-a97d-1d2b2f3a8268",
                                        "glosses": [
                                            "Representing the actual features of an individual; not ideal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f48697b5-4c89-4bc7-8893-9706f5201e29",
                                                "sense_id": "87f69b04-0e02-3d1c-9eef-4c89290ad243",
                                                "text": "a portrait bust; a portrait statue"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c226b59a-6e9d-4273-b1bc-e5ad0e85212d",
                        "source_entry_id": "39633e21-4b6e-3586-8577-54eb586541f7",
                        "source_sense_id": "d04caf1c-6628-338c-8932-de39eb4ee8cf",
                        "source_sense_description": "schilderij, foto of andere artistieke voorstelling van een persoon",
                        "target_lang_word": "portrait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portrait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Image, représentation d’une personne, faite avec le pinceau, le crayon, le burin, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7605307-d34e-4546-a584-626152ea01e2",
                                                "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                                "text": "Les portraits de feu Mme Crevel, de Crevel, de sa fille et de son gendre, dus au pinceau de Pierre Grassou, le peintre en renom dans la bourgeoisie, à qui Crevel devait le ridicule de son attitude byronienne, garnissaient les parois, mis tous les quatre en pendants."
                                            },
                                            {
                                                "example_id": "9543c752-5ddd-4901-8078-ff64d398cab6",
                                                "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                                "text": "Il songe à tout, aux plus petites choses. Il crayonne de malicieux portraits, raconte avec enjouement des anecdotes spirituelles."
                                            },
                                            {
                                                "example_id": "18174144-86ea-4dd2-a3d5-fdf973e6e578",
                                                "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                                "text": "Elle disposa les fleurs au chevet, fit arrêter le balancier de l'horloge, voiler les glaces et les miroirs, fermer les fenêtres et cacher les portraits."
                                            },
                                            {
                                                "example_id": "f1bc246a-1c77-485b-b6c3-6b836035a0fe",
                                                "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                                "text": "Selon les statuts de cette société savante, ses futurs membres s'engageaient à offrir, pour leur intronisation, leur portrait grandeur nature. Bach fit donc peindre son portrait par Elias Gottlob Haussmann, le peintre officiel de Leipzig."
                                            },
                                            {
                                                "example_id": "53d62cb9-7fb7-4a15-8c3e-6031e221ec90",
                                                "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                                                "text": "Son ultime coquetterie avant de monter à l'échafaud ? Faire réaliser son portrait. Le selfie de l'époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d83e3f6-1378-3641-aadc-8231416ecc6f",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Ressemblance physique ou morale, se dit d’un fils, d’une fille qui ressemble à son père ou à sa mère, et de toute personne qui ressemble beaucoup à une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973290e4-0a41-41c8-b87e-fa9bf23d214e",
                                                "sense_id": "2d83e3f6-1378-3641-aadc-8231416ecc6f",
                                                "text": "C’est le portrait de son père tout craché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9260bf-15ca-315f-a23d-07e39aea2e80",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Description qu’on fait de l’extérieur ou du caractère d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3409752-75e4-4c6c-8d1e-90cc87327161",
                                                "sense_id": "dc9260bf-15ca-315f-a23d-07e39aea2e80",
                                                "text": "Le portrait du « publiphile » serait donc celui d'un homme riche, dans la force de l'âge, habitant une grande agglomération. C'est dire assez l'importance des motivations personnelles et sociales dans l'accueil réservé au message publicitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd058e4f-4e55-386e-824d-d096dbf6846f",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Description de toute sorte d’objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437828b1-76c1-4a33-8eb6-de312b3ee55a",
                                                "sense_id": "cd058e4f-4e55-386e-824d-d096dbf6846f",
                                                "text": "Finalement, ce n’est qu’à la fin du mois qu’on aura un portrait réel de l’état de la ventilation dans les écoles."
                                            },
                                            {
                                                "example_id": "f9511d17-362a-4fed-a098-6142f24d10db",
                                                "sense_id": "cd058e4f-4e55-386e-824d-d096dbf6846f",
                                                "text": "Il a tracé un portrait fidèle des mœurs de son siècle."
                                            },
                                            {
                                                "example_id": "0b6296a3-c8ce-48e1-a0df-4913ec511382",
                                                "sense_id": "cd058e4f-4e55-386e-824d-d096dbf6846f",
                                                "text": "Une bonne comédie est un portrait de la vie humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f521d2b-fe53-34ee-92ff-10aa0d114817",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Image d’une personne, assez près pour être reconnaissable, prise grâce à la méthode photographique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c895d942-76f8-31ee-8aeb-e11db78081b0",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Photo."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fafc1959-e661-45c9-be34-fa3a1a8a043a",
                                                "sense_id": "c895d942-76f8-31ee-8aeb-e11db78081b0",
                                                "text": "Regarde les portraits de mes dernières vacances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e24aa7d9-a68f-321f-aa2a-44a8bd654f65",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Décor, situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f81586b-0276-4106-9360-50b832223fa2",
                                                "sense_id": "e24aa7d9-a68f-321f-aa2a-44a8bd654f65",
                                                "text": "Ma mère et moi. Le Grec allait se fait éjecter du portrait rapido presto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c746a969-9951-3ad3-b8d1-e01828cb581b",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Figure, face."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0258a3-3135-4fdc-8e01-5d5cc6e16e77",
                                                "sense_id": "c746a969-9951-3ad3-b8d1-e01828cb581b",
                                                "text": "Je vais lui démolir le portrait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17922bda-c307-3bf7-a013-3971b60b88c7",
                                        "entry_id": "ab66799b-736e-331b-8e95-9953e51854e1",
                                        "glosses": [
                                            "Image verticale, dont la hauteur est supérieure à la largeur."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    }
                                ]
