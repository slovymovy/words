{
    "word_family": [
        "affection",
        "affectionately",
        "affectionateness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19376608-33ec-3fc9-a454-0e292267aabc",
                    "sense_definition": "Feeling or showing love, fondness, or warm regard for someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "loving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is very <w>affectionate</w> toward her younger brother and always gives him a hug.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>ласкова</w> со своим младшим братом и всегда обнимает его."
                            }
                        },
                        {
                            "text": "The dog is an <w>affectionate</w> companion who loves to sit by his owner's feet.",
                            "target_lang_translations": {
                                "ru": "Эта собака — <w>любящий</w> компаньон, который обожает сидеть у ног хозяина."
                            }
                        }
                    ],
                    "synonyms": [
                        "loving",
                        "fond",
                        "caring",
                        "warm-hearted",
                        "tender"
                    ],
                    "antonyms": [
                        "callous",
                        "heartless"
                    ],
                    "common_phrases": [
                        "affectionate nature",
                        "affectionate hug",
                        "warm and affectionate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или проявляющий любовь, нежность или теплое отношение к кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласковый",
                                "target_lang_sense_clarification": "проявляющий нежность"
                            },
                            {
                                "target_lang_word": "любящий",
                                "target_lang_sense_clarification": "полный любви"
                            },
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "проявляющий мягкость и теплоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c7b67e-18d2-3bb0-a8c2-ed5f017d64a8",
                    "sense_definition": "Expressing or characterized by love or tenderness, such as in a message or look.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "loving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sent an <w>affectionate</w> message to his parents before leaving for his trip.",
                            "target_lang_translations": {
                                "ru": "Он отправил <w>нежное</w> сообщение родителям перед отъездом в путешествие."
                            }
                        },
                        {
                            "text": "She gave him an <w>affectionate</w> glance as he walked across the room.",
                            "target_lang_translations": {
                                "ru": "Она бросила на него <w>любящий</w> взгляд, когда он шел по комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "tender",
                        "heartfelt",
                        "cordial"
                    ],
                    "common_phrases": [
                        "affectionate message",
                        "affectionate glance",
                        "affectionate care"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий любовь или нежность (например, во взгляде или сообщении)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "о взгляде или жесте"
                            },
                            {
                                "target_lang_word": "теплый",
                                "target_lang_sense_clarification": "о словах или приеме"
                            },
                            {
                                "target_lang_word": "любящий",
                                "target_lang_sense_clarification": "выражающий привязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53c32035-dde0-3f7c-a2c6-4fea90628ad1",
                    "sense_definition": "Having a strong inclination or passionate desire toward something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "passionate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>affectionate</w> toward the pursuit of knowledge from a very young age.",
                            "target_lang_translations": {
                                "ru": "С самого раннего возраста он был <w>предан</w> поиску знаний."
                            }
                        },
                        {
                            "text": "The scholar remained <w>affectionate</w> to his studies despite many distractions.",
                            "target_lang_translations": {
                                "ru": "Ученый оставался <w>приверженным</w> своим исследованиям, несмотря на множество отвлекающих факторов."
                            }
                        }
                    ],
                    "synonyms": [
                        "earnest",
                        "ardent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сильную склонность или страстное стремление к чему-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "увлеченный делом"
                            },
                            {
                                "target_lang_word": "приверженный",
                                "target_lang_sense_clarification": "имеющий склонность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d602706d-ed0f-3408-a3cc-0a61f11fe3db",
                    "sense_definition": "To show affection to or to have affection for someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "show_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was once common to see how a mother would <w>affectionate</w> her child in public.",
                            "target_lang_translations": {
                                "ru": "Когда-то было обычным делом видеть, как мать <w>ласкает</w> своего ребенка на людях."
                            }
                        },
                        {
                            "text": "He did not know how to <w>affectionate</w> those he cared for most.",
                            "target_lang_translations": {
                                "ru": "Он не знал, как <w>проявлять нежность</w> к тем, кто был ему дороже всего."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "The verb form is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять нежность или питать привязанность к кому-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласкать",
                                "target_lang_sense_clarification": "проявлять нежность"
                            },
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "питать привязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3baba70-df2a-30d0-a3f2-1ec970b6858f",
                    "sense_definition": "To become emotionally attached to something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was better <w>affectionated</w> to the parliament than his predecessors.",
                            "target_lang_translations": {
                                "ru": "Король был более <w>благосклонен</w> к парламенту, чем его предшественники."
                            }
                        },
                        {
                            "text": "People often <w>affectionate</w> themselves to small pets for comfort.",
                            "target_lang_translations": {
                                "ru": "Люди часто <w>привязываются</w> к маленьким питомцам ради утешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "attached",
                        "devoted"
                    ],
                    "common_phrases": [
                        "affectionated to"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться эмоционально привязанным к кому-либо или чему-либо (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привязываться",
                                "target_lang_sense_clarification": "становиться привязанным"
                            },
                            {
                                "target_lang_word": "благоволить",
                                "target_lang_sense_clarification": "хорошо относиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}