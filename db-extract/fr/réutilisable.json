                "senses": [
                    {
                        "sense_id": "d731df17-b66d-3ba4-b8cc-d3342f2ee3c2",
                        "entry_id": "93721d8c-23ed-3637-b1b2-569cb629dd52",
                        "glosses": [
                            "Que l’on peut utiliser de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe093670-3364-4e4d-9e34-5944bcbd5d96",
                                "sense_id": "d731df17-b66d-3ba4-b8cc-d3342f2ee3c2",
                                "text": "« L’idée, c’est d’embarquer dans sa valise des alternatives réutilisables (un tote bag, une gourde, des contenants ou des couverts, à avoir avec soi dans un sac à dos quand on se balade »."
                            },
                            {
                                "example_id": "cd6d97e4-6a9f-4331-8dd5-e34355cbfad4",
                                "sense_id": "d731df17-b66d-3ba4-b8cc-d3342f2ee3c2",
                                "text": "Le fait que ce matériau soit réutilisable et recyclable joue également un rôle important dans notre société toujours plus soucieuse de son environnement."
                            },
                            {
                                "example_id": "29c12de3-466e-4248-aace-f1bcc8b9b694",
                                "sense_id": "d731df17-b66d-3ba4-b8cc-d3342f2ee3c2",
                                "text": "Autre exemple, nous travaillons avec la start-up Hipli et son colis réutilisable une centaine de fois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b822716e-ea52-423f-9dfc-0ed2f197bb28",
                        "source_entry_id": "93721d8c-23ed-3637-b1b2-569cb629dd52",
