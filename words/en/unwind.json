{
    "word_family": [
        "wind",
        "winder",
        "winding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "361c6134-9a41-35e9-b75f-0ded19b31ac8",
                    "sense_definition": "To relax or rest after a period of work or stress.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day at the office, I like to <w>unwind</w> by listening to soft music."
                        },
                        {
                            "text": "Many people find that a warm bath helps them <w>unwind</w> before going to sleep."
                        }
                    ],
                    "common_phrases": [
                        "time to unwind",
                        "help to unwind"
                    ]
                },
                {
                    "sense_id": "90e86cf5-156d-3315-86cc-29d100b09816",
                    "sense_definition": "To separate something that has been wound or coiled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>unwind</w> the garden hose so we can water the plants."
                        },
                        {
                            "text": "She had to <w>unwind</w> the tangled yarn before she could start knitting."
                        }
                    ],
                    "synonyms": [
                        "untwist",
                        "untwine"
                    ],
                    "common_phrases": [
                        "unwind the cord",
                        "unwind the rope"
                    ]
                },
                {
                    "sense_id": "9a27d94a-b0b4-3f80-a4bd-3ff75e0a0139",
                    "sense_definition": "To free oneself from a complicated or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disentangle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took hours to <w>unwind</w> the legal mess caused by the contract error."
                        },
                        {
                            "text": "He struggled to <w>unwind</w> himself from the web of lies he had created."
                        }
                    ],
                    "common_phrases": [
                        "unwind the situation"
                    ]
                },
                {
                    "sense_id": "51624315-6b13-3380-ab80-f995d9214e2a",
                    "sense_definition": "To process a sequence of computer operations in reverse order to handle an error or return to a previous state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program will <w>unwind</w> the stack to find the correct error handler."
                        },
                        {
                            "text": "When an exception occurs, the system must <w>unwind</w> the call stack safely."
                        }
                    ],
                    "common_phrases": [
                        "unwind the stack"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7428897f-51a8-32fb-abe2-8a93d1729922",
                    "sense_definition": "A device or process used to release or uncoil material.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine features an automatic <w>unwind</w> for the heavy paper rolls."
                        },
                        {
                            "text": "The <w>unwind</w> mechanism ensures the wire does not snap during the process."
                        }
                    ],
                    "common_phrases": [
                        "automatic unwind",
                        "unwind mechanism"
                    ]
                }
            ]
        }
    ]
