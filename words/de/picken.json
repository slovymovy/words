                    "frequency": "Middle",
                    "semantic_group_id": "haften",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Kneten <w>pickte</w> der zähe Teig überall an meinen Händen."
                        },
                        {
                            "text": "Der alte Kaugummi <w>pickt</w> so fest am Tisch, dass man ihn kaum entfernen kann."
                        }
                    ],
                    "synonyms": [
