                        "glosses": [
                            "gegevens over een product zoals deze verstrekt worden door de fabrikant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed6a29d5-b381-402d-8d73-afb1ef733718",
                                "sense_id": "8da71c98-39e1-3824-b03e-bd8ff5b51d0f",
                                "text": "Auto's verbruiken ruim 35 procent meer brandstof dan fabrikanten in de brochures beloven. Auto's die op papier het zuinigst zijn, blijken in de praktijk het meest van de fabrieksopgave af te wijken."
                            },
                            {
                                "example_id": "839e92b9-456b-4b6e-98bd-0454574da229",
                                "sense_id": "8da71c98-39e1-3824-b03e-bd8ff5b51d0f",
                                "text": "Auto's die op papier het zuinigst zijn, blijken in de praktijk het meest van de fabrieksopgave af te wijken. Dat blijkt uit cijfers van Travelcard, een bedrijf dat tankpassen levert voor de zakelijke markt. Het deed onderzoek op verzoek van de NOS."
                            },
                            {
                                "example_id": "129f5c07-588e-44ca-af45-d22f49307ef6",
                                "sense_id": "8da71c98-39e1-3824-b03e-bd8ff5b51d0f",
                                "text": "De Europese ECE-test bepaalt welk verbruik autofabrikanten in hun brochures mogen zetten. In de praktijk blijken die cijfers veel te rooskleurig. Travelcard berekende op verzoek van de NOS de afwijking van 400.000 auto's die vorig jaar in ons land zijn verkocht. Uit die berekeningen blijkt dat auto's gemiddeld ruim 35% meer brandstof verbruiken dan de fabrieksopgave."
                            }
                        ]
