                                        "entry_id": "d38abfca-2ea1-32ec-80af-f57b4453d5e6",
                                        "glosses": [
                                            "SI-Basiseinheit der absoluten Temperatur und zugleich gesetzliche Temperatureinheit, die auch zur Angabe von Temperaturdifferenzen verwendet wird und am absoluten Nullpunkt beginnt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b4dc67-df26-471b-8086-c257071ff0d8",
                                                "sense_id": "7812eb8d-240b-3bfc-88f4-f1a21ff9c517",
                                                "text": "Der absolute Nullpunkt ist per definitionem bei 0 Kelvin."
                                            },
                                            {
                                                "example_id": "932db8e8-9fda-4063-9d3a-97693e1ef274",
                                                "sense_id": "7812eb8d-240b-3bfc-88f4-f1a21ff9c517",
                                                "text": "„Der Schmelzpunkt des Eises entspricht 273.15 (Grad) Kelvin. Der Siedepunkt des Wassers ist also bei 373.15 (Grad) Kelvin.“"
                                            }
                                        ],
