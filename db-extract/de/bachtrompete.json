                        "examples": [
                            {
                                "example_id": "ef5a7558-7d28-4e0d-9e2a-81625a440c8f",
                                "sense_id": "12084d4e-ef3b-3743-9f38-2e2fb6bfa676",
                                "text": "„Die letztlich vergebliche Suche nach dem Rätsel der Clarinen, der Soprantrompeten, endete mit einem Kompromiß, genannt ‚Bachtrompete‘.“"
                            },
                            {
                                "example_id": "61ca9047-9596-4458-9d18-c08d42deca3c",
                                "sense_id": "12084d4e-ef3b-3743-9f38-2e2fb6bfa676",
                                "text": "„Den Auftakt der Abendmusik machte Hans Kurt Rennig auf seiner Bachtrompete, an der restaurierten Orgel begleitet von Detlev Zeller.“"
                            }
                        ],
