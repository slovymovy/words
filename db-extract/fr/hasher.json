                                "example_id": "359329d0-f936-4842-806b-53858499114c",
                                "sense_id": "4f87d4d8-13f4-375e-96b4-bf5f85d2b5d5",
                                "text": "Augmenter le nombre d’itérations signifie que nous allons hasher plusieurs fois le mot de passe."
                            },
                            {
                                "example_id": "7714a8d6-f93a-4cbd-bf9b-36221eca3b5a",
                                "sense_id": "4f87d4d8-13f4-375e-96b4-bf5f85d2b5d5",
                                "text": "Pourquoi devrais-je hasher les mots de passe envoyés par les utilisateurs de mon application ?"
                            },
                            {
                                "example_id": "82d949c4-2269-4e3a-9bc2-98d2ae99b65f",
