                "senses": [
                    {
                        "sense_id": "afe7040b-98fa-358f-8c98-85580fcb9be5",
                        "entry_id": "8fee0962-46b1-3577-b83e-f2fee0cfcb44",
                        "glosses": [
                            "goody-goody, paragon"
                        ],
                        "tags": [
                            "masculine",
