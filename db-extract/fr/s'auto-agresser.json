                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19fa2309-f926-40ff-82cb-d763b796d96e",
                                "sense_id": "7ef8d064-05d4-397a-83cc-3dffdc8e4f11",
                                "text": "Le vivant perd sa propre identité ou son image ; il risque de s’auto-agresser ; les tissus se sclérosent."
                            },
                            {
                                "example_id": "a9c583de-c7e3-4cb7-948f-9bffb66ea48d",
                                "sense_id": "7ef8d064-05d4-397a-83cc-3dffdc8e4f11",
                                "text": "Pour autant, ce ne sont pas des accidents puisqu’il y avait tout de même une intention de s’auto-agresser."
                            }
