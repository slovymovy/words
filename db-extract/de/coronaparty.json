                ],
                "senses": [
                    {
                        "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                        "entry_id": "dd3133bc-50b2-34a0-9901-fac4cab3e50c",
                        "glosses": [
                            "privat organisierte Party, die trotz der Kontaktbeschränkungen zur Eindämmung des Coronavirus SARS-CoV-2 während eines Lockdowns veranstaltet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045b78c5-5686-4409-a58a-650496865d8f",
                                "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                                "text": "Das Coronavirus schränkt das öffentliche Leben ein. Einige junge Leute lassen sich vom Feiern trotzdem nicht abhalten - und veranstalten Coronapartys."
                            },
                            {
                                "example_id": "c79d86be-fb35-4325-a9f4-4a989bd6dc28",
                                "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                                "text": "Das Video einer feucht-fröhlichen Coronaparty in der Südsteiermark sorgt am Freitag für Aufsehen. Darauf zu sehen sind mehrere Personen, darunter Unternehmer, die offenbar in einem privaten Hallenbad feiern."
                            },
                            {
                                "example_id": "4580566d-eb40-481a-ad3e-7afcd2fe9a58",
                                "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                                "text": "Am Freitagabend stürmte die Kriminalpolizei gemeinsam mit der Spezialeinheit Wega und einem Drogenspürhund ein bekanntes Szene-Lokal in Wien-Döbling. Der Grund: 21 Personen und zwei Kellner hatten sich dort offenbar zu einer illegalen „Coronaparty“ getroffen."
                            },
                            {
                                "example_id": "d108ba74-8fa4-45f7-8388-7ccf87dcc286",
                                "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                                "text": "Bei der Sachverhaltsaufnahme stellten die Beamten fest, dass die Gruppe offenbar eine „Coronaparty“ gefeiert hatte."
                            },
                            {
                                "example_id": "65a078a1-e5ce-4017-b559-17418f7f22fe",
                                "sense_id": "e7983aaa-0012-3895-8ffd-95615b58b97a",
                                "text": "„Coronapolizist“, „Coronasünder“, „Coronaparty“ – neue Wörter halten durch die Pandemie Einzug in die deutsche Sprache."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
