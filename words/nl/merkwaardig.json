                        "vreemd",
                        "raar"
                    ],
                    "antonyms": [
                        "gewoon",
                        "normaal"
                    ],
                    "common_phrases": [
                        "merkwaardige gewoonte",
                        "merkwaardig verhaal"
                    ],
                    "target_lang_definitions": {
                        "en": "different from what you expect and therefore a bit strange or odd"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strange",
                                "target_lang_sense_clarification": "unusual or surprising"
                            },
                            {
