                                    },
                                    {
                                        "sense_id": "69c47a02-826a-38f6-b322-c7b316c4442f",
                                        "entry_id": "40b8ecb7-4e42-374e-8bc5-d3f8ff59ba12",
                                        "glosses": [
                                            "En particular se aplicó a los que querían abolir la esclavitud durante el siglo XIX."
                                        ],
