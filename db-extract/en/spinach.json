        "de-extract.jsonl": [
            {
                "entry_id": "04bf36a6-d53a-3292-8f78-b151fd72529e",
                "word": "spinach",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69800b77-bedc-338e-8d06-9f6ae1c3b2ab",
                        "entry_id": "04bf36a6-d53a-3292-8f78-b151fd72529e",
                        "glosses": [
                            "ist eine zu den Fuchsschwanzgewächsen gehörende Art aus der Gattung Spinat; der Spinat (wissenschaftlich: Spinacia oleracea)"
                        ],
                        "tags": [],
