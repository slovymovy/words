                "senses": [
                    {
                        "sense_id": "e627c339-0115-3a60-a40a-5af95cfd848e",
                        "entry_id": "5110f759-6667-3878-b0e1-074fa28527ab",
                        "glosses": [
                            "Qui se rapporte à l’abbaye de Thélème, imaginée par François Rabelais, et dont la devise est « Fays ce que vouldras », ou aux membres de sa communauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8e5d97-3d3e-46bd-b8df-f2d4d9d3a645",
                                "sense_id": "e627c339-0115-3a60-a40a-5af95cfd848e",
                                "text": "Vous êtes entré en religion dans votre abbaye thélémite avec une Bible sous le bras, mi-rabelaisienne, mi-janséniste…"
                            },
                            {
                                "example_id": "18a105db-e69d-4046-bf00-29eb081b4581",
                                "sense_id": "e627c339-0115-3a60-a40a-5af95cfd848e",
                                "text": "À supposer que le programme de Ponocrates soit autre chose qu’un jeu et réponde à une intention didactique, son rapport avec l’idéal thélémite demeure irrésolu."
                            },
                            {
                                "example_id": "1f55b9ea-b80f-474c-a0cd-960c07b74c86",
                                "sense_id": "e627c339-0115-3a60-a40a-5af95cfd848e",
                                "text": "La plupart des violentes diatribes de Frère Jean contre les abus monastiques sont également maintenues, comme si l’utopie thélémite, idéal d’où la religiosité n’est pas exclue, autorisait la virulence de l’invective satirique dirigée contre les perversions du monde conventuel."
                            },
                            {
                                "example_id": "65d1058f-355c-44db-89a1-cd0fb37afe56",
                                "sense_id": "e627c339-0115-3a60-a40a-5af95cfd848e",
                                "text": "La philosophie thélémite se fonde sur le principe de l’émulation —de l’imitation— et considère que vouloir individuel et vouloir social sont identiques : ils s’appliquent à « faire tous ce que à un seul voyaient plaire »."
                            }
                        ]
                    }
