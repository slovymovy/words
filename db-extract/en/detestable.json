                                    {
                                        "sense_id": "af365698-cfbe-3200-abdb-238f2722535b",
                                        "entry_id": "ada70554-c2bf-3ff4-9f12-72385f5fdc6d",
                                        "glosses": [
                                            "so geartet, dass Abscheu/Ablehnung ausgelöst werden sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ce7ecd-8802-44e4-a43e-258afe67b2f0",
                                                "sense_id": "af365698-cfbe-3200-abdb-238f2722535b",
                                                "text": "Das ist eine verabscheuungswürdige Tat."
                                            },
                                            {
                                                "example_id": "eb9e3eb7-01f8-4678-8810-378a557286af",
                                                "sense_id": "af365698-cfbe-3200-abdb-238f2722535b",
                                                "text": "„Eigentlich gilt der Schwangerschaftsabbruch in der Katholischen Kirche als ‚verabscheuungswürdiges Verbrechen‘.“"
                                            },
                                            {
                                                "example_id": "286ea0d2-c999-4030-b1b9-503b956d3cad",
                                                "sense_id": "af365698-cfbe-3200-abdb-238f2722535b",
                                                "text": "„Der Suizid, von Augustinus als ‚verabscheuungswürdiges Verbrechen und verwerflicher Frevel‘ verurteilt, gilt der katholischen Kirche bis heute als Todsünde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f5cd1f-1a8b-40f6-a429-f642ad702aa5",
                        "source_entry_id": "74914c1b-8c4d-3086-91e0-712d71074ec6",
                        "source_sense_id": "1b79a69e-75a2-3c8b-aa59-d7419ef4fba8",
                        "source_sense_description": "verabscheuungswürdig, widerwärtig, abscheulich",
                        "target_lang_word": "widerwärtig",
                        "target_lang_code": "de",
