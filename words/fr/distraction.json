                },
                {
                    "sense_id": "39d4594a-e416-3fdb-bfa4-c7142d64b672",
                    "sense_definition": "Erreur, maladresse ou oubli provoqué par un manque d'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux professeur est célèbre pour ses <w>distractions</w>, comme venir en cours en pantoufles.",
                            "target_lang_translations": {
                                "en": "This old professor is famous for his <w>lapses</w> of attention, such as coming to class in slippers.",
                                "ru": "Этот старый профессор славится своей <w>рассеянностью</w>: например, он приходит на занятия в тапочках.",
                                "de": "Dieser alte Professor ist berühmt für seine <w>Zerstreutheit</w>, etwa dass er in Pantoffeln zum Unterricht kommt.",
                                "es": "Este viejo profesor es famoso por sus <w>despistes</w>, como ir a clase en pantuflas.",
                                "zh": "这位年迈的教授因各种<w>疏忽</w>而出名，比如穿着拖鞋来上课。"
                            }
                        },
                        {
                            "text": "Oublier de signer ce document important était une regrettable <w>distraction</w> de sa part.",
                            "target_lang_translations": {
                                "en": "Forgetting to sign this important document was a regrettable <w>oversight</w> on his part.",
                                "ru": "Забыть подписать этот важный документ было досадным <w>недосмотром</w> с его стороны.",
                                "de": "Das Vergessen, dieses wichtige Dokument zu unterschreiben, war von ihm ein bedauerliches <w>Versehen</w>.",
                                "es": "Olvidarse de firmar este documento importante fue un lamentable <w>descuido</w> por su parte.",
                                "zh": "忘了在这份重要文件上签字，是他的一次令人遗憾的<w>失误</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "étourderie",
                        "bévue",
                        "inadvertance"
                    ],
                    "common_phrases": [
                        "erreur de distraction"
                    ],
                    "target_lang_definitions": {
                        "en": "A mistake, clumsy error or oversight caused by a lack of attention.",
                        "ru": "Ошибка, промах или упущение, допущенные из-за недостатка внимания.",
                        "de": "Fehler, Ungeschicklichkeit oder Versäumnis, das durch fehlende Aufmerksamkeit verursacht wird.",
                        "es": "Error, torpeza u olvido causado por falta de atención.",
                        "zh": "因注意力不集中而犯的错误、笨拙的失误或疏漏。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lapse",
                                "target_lang_sense_clarification": "momentary mental lapse"
                            },
                            {
