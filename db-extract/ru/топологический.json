                                "target_senses": [
                                    {
                                        "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                                        "entry_id": "e1db1c07-5cbc-307d-93d5-58f71f25be69",
                                        "glosses": [
                                            "Relatif à la topologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be8182e-0dab-4c15-8847-7faedaa5e2ce",
                                                "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                                                "text": "A l'inverse, l'étendue de telle plaine divisée en une mosaïque de parcelles culturalement distinctes se verra différenciée par des contenus, eux aussi dotés d'attributs géométriques et de surface, mais sans que des discontinuités topologiques les séparent pourtant."
                                            },
                                            {
                                                "example_id": "4b2c35fc-933a-4e57-ad68-96d3017b6509",
                                                "sense_id": "1ecb6f27-13a2-3774-bd8f-860d1760d256",
                                                "text": "Il s’agissait de faire intervenir des cordes cosmiques, des sortes de défauts topologiques analogues à ceux que l’on trouve dans un réseau cristallin lorsqu’un liquide devient solide en se refroidissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4668860-5609-3040-98e0-7f092c9a991b",
                                        "entry_id": "e1db1c07-5cbc-307d-93d5-58f71f25be69",
                                        "glosses": [
                                            "Qualifie une représentation moléculaire utilisée en chimie organique (Voir formule topologique)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
