                "senses": [
                    {
                        "sense_id": "28029269-1b13-311b-9cd7-49477ffe6a61",
                        "entry_id": "0492666c-84cb-3a4d-b073-b232b83e359b",
                        "glosses": [
                            "Gruppe von Sternen, die sich als Sternhaufen oder als weit auseinanderliegende Sterne parallel durch den Weltraum bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720e8e10-dae6-4f7d-a7c6-5cf3badecba7",
                                "sense_id": "28029269-1b13-311b-9cd7-49477ffe6a61",
                                "text": "„Diese liegen zuerst in der Hypothese, daß die Raumbewegungen der einzelnen Sterne eines Stromes tatsächlich alle untereinander parallel sind, und zweitens in der Annahme, daß der einzelne Stern, dessen Parallaxe bestimmt werden soll, wirklich dem Sternstrome angehört und sich nicht zufällig in der durch die Sonne und den gemeinsamen Vertex des Stromes definierten Ebene bewegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
