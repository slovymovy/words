                            {
                                "example_id": "3f09277a-b7e7-4c88-8f97-63475cc0ddfc",
                                "sense_id": "3e3db95c-e003-324d-a508-21b442bc59d6",
                                "text": "Un vrai enfant qui joue avec ses bébelles !"
                            },
                            {
                                "example_id": "29624a0a-4afc-4b26-8fac-3cc9dbdbcb2f",
                                "sense_id": "3e3db95c-e003-324d-a508-21b442bc59d6",
                                "text": "Père Noël, Père Noël,\nApporte-moé des bébelles!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5dff49f-b717-325c-a1c5-d1ca1f846b24",
                        "entry_id": "3784f7dd-7f4b-35db-aaee-d17eda75dc57",
                        "glosses": [
                            "Objet personnel, considéré comme sans valeur."
