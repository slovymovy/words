                "senses": [
                    {
                        "sense_id": "82ae682c-2244-390c-acdf-567ced31a38a",
                        "entry_id": "ba1cac0b-7631-3e64-bee1-001ba2057afd",
                        "glosses": [
                            "Impfung, um eine Masernerkrankung zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c93fff97-69ec-4c85-83d0-6024f32e2cc8",
                                "sense_id": "82ae682c-2244-390c-acdf-567ced31a38a",
                                "text": "Die Masernimpfung ist bei uns kostenlos."
                            },
                            {
                                "example_id": "8a29ffb0-1c0d-4daf-8771-d54df3310492",
                                "sense_id": "82ae682c-2244-390c-acdf-567ced31a38a",
                                "text": "„Wissenschafter hätten nun in einer aufwendigen statistischen Analyse die in England, den USA und Dänemark aufgezeichneten Fallzahlen von Masern seit der Vorimpfära über den Zeitpunkt der Einführung der Masernimpfung bis zum Erreichen hoher Durchimpfungsraten (von den 1950er-Jahren bis zur Gegenwart) mit der Sterblichkeitsrate bei anderen Infektionskrankheiten ausgewertet.“"
                            },
                            {
                                "example_id": "96b459b8-36d5-471b-9499-fe06cfff3a70",
                                "sense_id": "82ae682c-2244-390c-acdf-567ced31a38a",
                                "text": "„Der stichhaltigste Grund für die Masernimpfung liegt in ihrem Erfolg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
