                "senses": [
                    {
                        "sense_id": "9114545b-29e8-320e-b08e-5efb0dbd31cf",
                        "entry_id": "d8593954-e3ce-3999-82ca-b8ee7f71d2a1",
                        "glosses": [
                            "militärischer Gewaltakt aus der Luft gegen Bodenziele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10bb8ddb-f660-470c-a3e1-865333b96a5a",
                                "sense_id": "9114545b-29e8-320e-b08e-5efb0dbd31cf",
                                "text": "„Es gibt jetzt jeden Tag Fliegerangriffe, sie werden immer häufiger.“"
                            },
                            {
                                "example_id": "d3985c33-bed9-4ea1-9dd4-4d47e03e6530",
                                "sense_id": "9114545b-29e8-320e-b08e-5efb0dbd31cf",
                                "text": "„Das halbwegs normale Leben wurde aber immer wieder durch Fliegerangriffe gestört.“"
                            },
                            {
                                "example_id": "2074ee17-ea80-47b6-b8e7-ba125a53fe44",
                                "sense_id": "9114545b-29e8-320e-b08e-5efb0dbd31cf",
                                "text": "„Das Eiserne Kreuz erster Klasse erwarb er sich seiner Zeit in Maubeuge bei einem Fliegerangriff, wo zwei Aufwartefrauen getötet wurden.“"
                            },
                            {
                                "example_id": "d89c3f82-040c-49f1-a7d1-d657ea3fb40f",
                                "sense_id": "9114545b-29e8-320e-b08e-5efb0dbd31cf",
                                "text": "„Eigentlich war er nur als Luftschutzraum bei Fliegerangriffen gedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
