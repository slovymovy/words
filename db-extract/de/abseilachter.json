                                                "example_id": "2b4a73ed-bb10-488e-a29f-f3cf03908674",
                                                "sense_id": "db3cd670-6201-314f-8dde-a849ee472439",
                                                "text": "The giant drifter is stowed in the foc'sl in the rolled condition, being figure eighted against the side of the bow on hooks."
                                            },
