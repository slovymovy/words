                "senses": [
                    {
                        "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                        "entry_id": "0a0ed920-ea83-3bbf-92e0-3e86f896b8fb",
                        "glosses": [
                            "Rohrformstück aus Kunststoff, das nach bestimmten, meist standardisierten Maßen gebogen oder geformt ist; Kunststoffhohlkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0739cd40-ece8-4b18-8303-9dcb9aeaddef",
                                "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                                "text": "„Im Jahr 1989 gründete er die KURO Kunststoffe GmbH in Westerstede und begann mit der Herstellung von Kunststoffrohrbogen für Rohrpostanlagen.“"
                            },
                            {
                                "example_id": "e59936d8-8c4f-42b2-a045-0c4a5b70cd55",
                                "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                                "text": "„Für die Fertigung von Rohrbögen, deren textile Bewehrung in Form einer Gewindeflanke um den inneren Kunststoffrohrbogen positioniert ist, wurde das vorhandene Nähwirkverfahren mit maschengerechtem Schussfadeneintrag um eine neuartige Zuführung exakt zugemessener Kettfadenlängen erweitert sowie eine maschinelle Umwindetechnologie entwickelt.“"
                            },
                            {
                                "example_id": "6a4051e4-02da-43fb-b209-d154884a6ec7",
                                "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                                "text": "„Durch den Einsatz von Kunststoffrohrbögen, Kunststoffrohren und der kernlosen Förderspirale werden flexible Förderwege möglich.“"
                            },
                            {
                                "example_id": "a4c8291e-864c-4557-9088-f86c2c7d21e0",
                                "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                                "text": "„Ein Kunststoffrohrbogen, DIN 50/45 Grad mit eingestecktem Scheuerlappen, hatte sich in der Druckleitung verkeilt und den Abwasserfluss in’s Stocken gebracht.“"
                            },
                            {
                                "example_id": "30ec1fe1-9df1-46ba-b152-384bb6d29d1c",
                                "sense_id": "09d7ce15-5f44-34a8-adc8-35928eac2586",
                                "text": "„Wärmetauscher zuerst mit dem Kunststoffrohrbogen von oben durch die Öffnung in der Bodenplatte fädeln und den Abgasrohranschluß an die mit Dichtungsmasse versehene Abgasöffnung des Gußblocks drücken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
