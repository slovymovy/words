                ],
                "senses": [
                    {
                        "sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
                        "entry_id": "ce24f660-04b9-344e-82e2-d984a4595ce3",
                        "glosses": [
                            "asexuelle, Sporen-bildende, diploide Phase bei diplohaplontischen Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b866c08-5399-4e8e-afe0-916a9f17e683",
                                "sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
                                "text": "„… Diese Form des Kernphasenwechsel ist mit dem Alternieren einer haploiden Generation (Gametophyt, Gamont) und einer diploiden Generation (Sporophyt, Agamont) – also mit einem heterophasischen Generationswechsel – verbunden.“"
                            },
                            {
                                "example_id": "8d0376ba-5c2c-41fb-90bd-5762a299cd16",
                                "sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
                                "text": "„Bei den Gefäßpflanzen ist der Sporophyt sehr viel größer und komplizierter gebaut (Baum, Strauch, krautige Pflanze) als der Gametophyt (♂= mehrzelliges Pollenkorn; ♀= mehrzellige Samenanlage bzw. befruchtungsfähiger Embryosack mit acht Kernen) und ernährt ihn in der Regel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a6832d-2fd9-48a4-a8d6-4b651d972450",
                        "source_entry_id": "ce24f660-04b9-344e-82e2-d984a4595ce3",
                        "source_sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
                        "target_lang_word": "sporophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sporophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5fbc220-4eef-328f-86d3-7341f818f366",
                                        "entry_id": "b8f046db-3dff-33dc-b1eb-bf29f8283393",
                                        "glosses": [
                                            "A plant (or the diploid phase in its life cycle) which produces spores by meiosis in order to produce gametophytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0ed3ba-1ffa-4c20-9b88-feca7fac4d69",
                                                "sense_id": "b5fbc220-4eef-328f-86d3-7341f818f366",
                                                "text": "(b) sporophyte with foot reduced, the entire sporophyte enveloped by the calyptra, which is ± stipitate at the base."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9948d705-8c4d-4241-bb87-616c1208412b",
                        "source_entry_id": "ce24f660-04b9-344e-82e2-d984a4595ce3",
                        "source_sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
                        "target_lang_word": "sporophyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sporophyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86bbfb6f-108f-312f-91bf-364cff3bacc2",
                                        "entry_id": "e5ef8fd8-a986-330a-8d00-c6ae8e9d979c",
                                        "glosses": [
                                            "Phase diploïde du cycle de vie des plantes et de certaines algues, issue de la fécondation, qui se développe à partir du zygote et produit des spores par méiose. Chez les bryophytes, le sporophyte est réduit à une capsule portée par une soie, tandis que chez les plantes vasculaires il correspond à l’organisme dominant et visible."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Biologie évolutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74ea54c-e115-4377-b8bb-ae9e53ec1562",
                                                "sense_id": "86bbfb6f-108f-312f-91bf-364cff3bacc2",
                                                "text": "Le cycle des plantes concernées est une alternance de sporophytes et de gamétophytes qui produisent des gamètes. Cette phase sporophyte du cycle de développement fait suite à la fécondation et contient donc le double de chromosomes du gamétophyte."
                                            },
                                            {
                                                "example_id": "83e0b829-719e-4d42-939e-97d92865d171",
                                                "sense_id": "86bbfb6f-108f-312f-91bf-364cff3bacc2",
                                                "text": "Champignons se cachant discrètement à l’ombre de sporophytes, petits insectes se débattant pour fuir leur emprise, les corps étrangers qu’elles abritaient étaient également distrayants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bba1d16-4a6b-4c40-be52-c7f22c004bca",
                        "source_entry_id": "ce24f660-04b9-344e-82e2-d984a4595ce3",
                        "source_sense_id": "10121d93-af3d-39ef-9a33-019febf7d19f",
