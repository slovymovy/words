            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ffe9b1c-77aa-3c22-ba96-ccd36638a888",
                    "sense_definition": "A network of blood vessels or nerves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rete</w> mirabile is a complex of arteries and veins lying very close to each other.",
                            "target_lang_translations": {
                                "ru": "<w>Чудесная сеть</w> — это комплекс артерий и вен, расположенных очень близко друг к другу."
                            }
                        },
                        {
                            "text": "Researchers studied the intricate <w>rete</w> of nerves within the spinal cord.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили сложную <w>сеть</w> нервов внутри спинного мозга."
                            }
                        }
                    ],
                    "synonyms": [
                        "plexus",
                        "network"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеть кровеносных сосудов или нервов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеть",
                                "target_lang_sense_clarification": "анатомическое сплетение сосудов или нервов"
                            },
                            {
                                "target_lang_word": "сплетение",
                                "target_lang_sense_clarification": "анатомическое переплетение нервных волокон или сосудов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094134df-40e1-316e-90f9-46447753726e",
                    "sense_definition": "An anatomical part resembling or including a network.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rete</w> testis is a network of tubules in the center of the testicle.",
                            "target_lang_translations": {
                                "ru": "<w>Сеть яичка</w> — это система канальцев в центре яичка."
                            }
                        },
                        {
                            "text": "This specific <w>rete</w> structure helps in the transport of fluids within the organ.",
                            "target_lang_translations": {
                                "ru": "Эта специфическая <w>сетчатая структура</w> помогает в транспортировке жидкостей внутри органа."
                            }
                        }
                    ],
                    "synonyms": [
                        "meshwork"
                    ],
                    "target_lang_definitions": {
                        "ru": "Анатомическая структура, напоминающая сеть или состоящая из нее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеть",
                                "target_lang_sense_clarification": "анатомическая структура в виде сетки"
                            },
                            {
                                "target_lang_word": "сетка",
                                "target_lang_sense_clarification": "структура, состоящая из переплетенных канальцев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28640e96-ce0d-3842-a382-9a336ab953cc",
                    "sense_definition": "A rotating cutaway plate on an astrolabe used to locate stars.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The user rotates the <w>rete</w> to align the star pointers with the current time.",
                            "target_lang_translations": {
                                "ru": "Пользователь вращает <w>рету</w>, чтобы совместить указатели звезд с текущим временем."
                            }
                        },
                        {
                            "text": "The intricate metalwork of the <w>rete</w> allows for precise astronomical calculations.",
                            "target_lang_translations": {
                                "ru": "Искусная металлическая <w>рета</w> позволяет выполнять точные астрономические расчеты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращающаяся ажурная пластина астролябии, используемая для определения положения звезд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рета",
                                "target_lang_sense_clarification": "подвижная часть астролябии (звездная карта)"
                            },
                            {
                                "target_lang_word": "паук",
                                "target_lang_sense_clarification": "историческое название подвижной части астролябии"
