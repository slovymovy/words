                "senses": [
                    {
                        "sense_id": "c52fb8e2-19e7-3156-9d63-a637eaffcf1a",
                        "entry_id": "73868637-a053-371a-8693-c7492cd3e5dd",
                        "glosses": [
                            "To cover with a hard crust."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e71a88-8a9e-40fa-96e2-ae073297addd",
                                "sense_id": "c52fb8e2-19e7-3156-9d63-a637eaffcf1a",
                                "text": "iron encrusted with rust"
                            },
                            {
                                "example_id": "5b42dcb3-6fb6-4dc7-ad47-97bd9d621783",
                                "sense_id": "c52fb8e2-19e7-3156-9d63-a637eaffcf1a",
                                "text": "a doughnut encrusted with sugar"
                            },
                            {
                                "example_id": "c03a5243-0b94-4e7d-985a-d110b34fd12e",
                                "sense_id": "c52fb8e2-19e7-3156-9d63-a637eaffcf1a",
                                "text": "And by the frost refin'd the whiter snow,\n Incrusted hard."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d752f43-4d6f-3d3d-be15-16a9522632d5",
                        "entry_id": "73868637-a053-371a-8693-c7492cd3e5dd",
                        "glosses": [
                            "To form a crust."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2753b792-25da-3874-80df-92a90305bee9",
                        "entry_id": "73868637-a053-371a-8693-c7492cd3e5dd",
                        "glosses": [
                            "To inset or affix decorative materials upon (a surface); to inlay into, as a piece of carving or other ornamental object."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2d799e8b-d7b9-44a7-b4e9-e3c9405efcfa",
                                "sense_id": "2753b792-25da-3874-80df-92a90305bee9",
                                "text": "The jeweller encrusted the ring with gems."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c3224b8-9e75-4174-8a9d-63e262517d11",
                        "source_entry_id": "73868637-a053-371a-8693-c7492cd3e5dd",
                        "source_sense_description": "To cover with a hard crust",
                        "target_lang_word": "encroûter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encroûter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c34a208-1d58-347a-ac55-d4c271cda165",
                                        "entry_id": "ef77ab41-ec97-33dd-b843-1b43799d3623",
                                        "glosses": [
                                            "Enduire un mur de mortier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "378dc419-c9ca-4f5f-b0c3-ecae2255ae8f",
                                                "sense_id": "2c34a208-1d58-347a-ac55-d4c271cda165",
                                                "text": "… une église qui serait passable, d’ailleurs, si elle n’était encroûtée par le plus épais des badigeons qu’aient jamais rêvés les conseils de fabrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366e80b4-4b1c-39f8-9e5f-511ad1885085",
                                        "entry_id": "ef77ab41-ec97-33dd-b843-1b43799d3623",
                                        "glosses": [
                                            "Recouvrir d'une couche de crasse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "665f47ca-5c84-4f34-ab66-7033767143a6",
                                                "sense_id": "366e80b4-4b1c-39f8-9e5f-511ad1885085",
                                                "text": "La façade, ornée et fleurie des plus pures arabesques de la renaissance, est un chef-d’œuvre d’élégance et de noblesse. L’ardent soleil d’Espagne, qui rougit le marbre et donne à la pierre des tons de safran, l’a revêtue d’une robe de couleurs riches et vigoureuses, bien différentes de la lèpre noire dont les siècles encroûtent nos vieux édifices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad9967f-dd72-303e-a22b-6724a494f0eb",
                                        "entry_id": "ef77ab41-ec97-33dd-b843-1b43799d3623",
                                        "glosses": [
                                            "Recouvrir d’une substance qui a séché."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab8e1c8-472a-4b95-bdf7-a31b8691aba4",
                                                "sense_id": "dad9967f-dd72-303e-a22b-6724a494f0eb",
                                                "text": "Ses narines et ses lèvres encroûtées d’une sèche écume jaune remuaient, flairaient, goûtaient le vent léger du soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "982a02cd-3c0a-3749-b2b7-7cfeee7f1a16",
                                        "entry_id": "ef77ab41-ec97-33dd-b843-1b43799d3623",
                                        "glosses": [
                                            "Se figer dans des habitudes constantes et se replier sur soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9eb400f-ff9d-43c1-a82b-c3238a87545c",
                                                "sense_id": "982a02cd-3c0a-3749-b2b7-7cfeee7f1a16",
                                                "text": "Toutes ces opérations anti-isolement, antihospice, antiségrégation se font dans un climat de gentillesse, mais Tabernacle ! — comme on dit ici — il ne s’agit plus de laisser les vieux s’encroûter ni se gaver de potions et de pilules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
