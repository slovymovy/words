                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "39074ab1-f803-46e2-aa3b-9fce45d8c5e5",
                        "source_entry_id": "f2a98d6b-2c11-3112-a24b-37e39ab32fa5",
                        "source_sense_id": "7a3382c3-a815-3d6c-a992-126de0ef9d67",
