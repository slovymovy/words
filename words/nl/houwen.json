    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ebcf088-23ab-3da4-9f33-c6241663e6ca",
                    "sense_definition": "Met een scherp werktuig (zoals een bijl of zwaard) krachtige slagen toebrengen om iets af te hakken of te beschadigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de veldslag <w>hieuwen</w> de ridders met hun zwaarden wild in het rond.",
                            "target_lang_translations": {
                                "en": "In the battle, the knights <w>hacked</w> wildly all around with their swords."
                            }
                        },
                        {
                            "text": "De houthakker begon met zijn bijl op de dikke boomstam in te <w>houwen</w>.",
                            "target_lang_translations": {
                                "en": "The lumberjack began to <w>chop</w> away at the thick tree trunk with his axe."
                            }
                        }
                    ],
                    "synonyms": [
                        "hakken",
                        "slaan"
                    ],
                    "common_phrases": [
                        "in het rond houwen",
                        "op elkaar inhouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To strike powerful blows with a sharp tool (such as an axe or sword) in order to cut off or damage something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hack",
                                "target_lang_sense_clarification": "to cut or chop with rough, heavy blows"
                            },
                            {
                                "target_lang_word": "hew",
                                "target_lang_sense_clarification": "to chop or cut down with an axe or sword"
                            },
                            {
                                "target_lang_word": "chop",
                                "target_lang_sense_clarification": "to cut something with a sharp tool using a quick blow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec48b4a7-12a8-38f0-a144-1af4367d64d4",
                    "sense_definition": "Door middel van hakken of beitelen vormgeven aan een hard materiaal, zoals steen of hout.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vormgeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beeldhouwer was in zijn atelier een prachtig standbeeld uit marmer aan het <w>houwen</w>.",
                            "target_lang_translations": {
                                "en": "The sculptor was <w>carving</w> a beautiful statue out of marble in his studio."
                            }
                        },
                        {
                            "text": "Zijn woorden stonden voor altijd in steen <w>gehouwen</w> in het geheugen van de gemeenschap.",
                            "target_lang_translations": {
                                "en": "His words were forever <w>carved</w> in stone in the memory of the community."
                            }
                        }
                    ],
                    "synonyms": [
                        "beitelen",
                        "beeldhouwen"
                    ],
                    "common_phrases": [
                        "in steen gehouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To shape hard material, such as stone or wood, by chopping or chiseling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carve",
                                "target_lang_sense_clarification": "to shape a hard material like stone or wood"
                            },
                            {
                                "target_lang_word": "sculpt",
                                "target_lang_sense_clarification": "to create a work of art by carving stone or wood"
                            },
                            {
                                "target_lang_word": "hew",
                                "target_lang_sense_clarification": "to shape or form by cutting"
                            },
                            {
                                "target_lang_word": "chisel",
                                "target_lang_sense_clarification": "to shape stone or wood with a chisel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20c3a950-91e6-35c5-81f7-02a4e24d607e",
                    "sense_definition": "Spreektaaluitspraak of informele spelling van het werkwoord <w>houden</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spreektaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan echt niet meer van die man <w>houwen</w> na alles wat er gebeurd is.",
                            "target_lang_translations": {
                                "en": "I really can't <w>love</w> that man anymore after everything that has happened."
                            }
                        },
                        {
                            "text": "Je moet je mond <w>houwen</w> als de leraar aan het praten is.",
                            "target_lang_translations": {
                                "en": "You must <w>keep</w> your mouth shut when the teacher is talking."
                            }
                        }
                    ],
                    "synonyms": [
                        "houden"
                    ],
                    "common_phrases": [
                        "van iemand houwen",
                        "je mond houwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Spreektaalvariant van 'houden'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial pronunciation or informal spelling of the verb 'houden' (to hold, to keep, to love)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "love",
                                "target_lang_sense_clarification": "colloquial variant of 'houden van'"
                            },
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "colloquial variant of 'houden'"
                            },
                            {
                                "target_lang_word": "hold",
                                "target_lang_sense_clarification": "colloquial variant of 'houden'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b3ba5c1-2bbf-3911-ae81-6797c5af0fe4",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>houw</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De diepe <w>houwen</w> in het schild lieten zien hoe hevig de strijd was geweest.",
                            "target_lang_translations": {
                                "en": "The deep <w>cuts</w> in the shield showed how fierce the battle had been."
                            }
                        },
                        {
                            "text": "Met enkele krachtige <w>houwen</w> wist hij de houten deur te forceren.",
                            "target_lang_translations": {
                                "en": "With a few powerful <w>blows</w>, he managed to force the wooden door open."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'houw' (blow, slash, cut)."
                    },
                    "translations": {
