                                        "glosses": [
                                            "Forme de danse sportive et acrobatique, souvent appelée breakdance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb26b61-a82e-475c-a149-68b3a4d2d84b",
                                                "sense_id": "7ee9f483-efa5-3d09-9753-91bcb5c0bd79",
                                                "text": "Mélange de danse et de gymnastique, le breaking est l’autre (et vrai) nom du breakdance."
                                            },
