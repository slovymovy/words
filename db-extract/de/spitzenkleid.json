                "senses": [
                    {
                        "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                        "entry_id": "875f06fb-9ec0-3e85-b546-54f041921dac",
                        "glosses": [
                            "Kleid, das mit Spitze verziert oder aus Spitze gefertigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08387f93-1798-4a19-94f8-b3a69f2d98a8",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "Zu meiner Hochzeit werde ich selbstverständlich ein weißes Spitzenkleid tragen."
                            },
                            {
                                "example_id": "a0da9631-f28b-45ea-9f2e-5f3c3d514414",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Um acht Uhr in der Früh stehen sich Braut und Bräutigam vor dem protestantischen Pfarrer Tschudi gegenüber, Cosima in einem extra für das Fest angefertigten Spitzenkleid.“"
                            },
                            {
                                "example_id": "f6bd1f7d-c69b-4db8-bc4f-f3d3007ae0e6",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "[«We did it!» Patricia Boser hat sich getraut:] „In einem rosa Spitzenkleid wurde Patricia Boser von ihrem neunjährigen Sohn vor den Altar geführt.“"
                            },
                            {
                                "example_id": "f4b473a4-34a1-4a33-9031-259a943d4db2",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Im knappen Spitzenkleid und mit Blumen im Haar ehelicht Schlagersternchen Vanessa Mai (25) ihren Freund und Manager Andreas Ferber (33) auf Mallorca.“"
                            },
                            {
                                "example_id": "202bf87a-92bd-4461-ac12-7337b37bf604",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„»Ich habe mich für ein dunkelblaues Spitzenkleid entschieden, das knieumspielend ist und dazu einen schönen goldenen Schmuck gewählt.«“"
                            },
                            {
                                "example_id": "3d3ab7bd-ebd9-4290-a689-fa99403a57d8",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "[Bildunterschrift:] „Madonna 1984: Frech und brav zugleich - bei den MTV Video Music Awards und ihrer Perfomance von \"Like a virgin\" hat Madonna ein weißes Spitzenkleid und ihren Boy-Toy-Gürtel an.“"
                            },
                            {
                                "example_id": "305e6c9f-a1ef-48be-8a97-76e38e9e0f1e",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Sie sollte nie wieder dieselbe sein. Nicht, dass sie noch nie einen Bettler gesehen hätte. Aber der hier - der kam zum falschen Zeitpunkt, wie wenn man gestoßen wird und Rotwein auf ein weißes Spitzenkleid schüttet.“"
                            },
                            {
                                "example_id": "1f6ef244-cd08-412a-89c5-8ea4c939bc1c",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Aufwendig ging es auch bei Chanel zu. Chefdesigner Karl Lagerfeld präsentierte mädchenhafte Spitzenkleider in Weiß, bestickt mit den für Chanel typischen Stoffblüten.“"
                            },
                            {
                                "example_id": "e35088bc-4f2c-4344-8b7e-351662666fe8",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Pierpaolo Piccioli, der italienische Lokalmatador, verpasste derweil bei Valentino den bodenlangen Spitzenkleidern und geklöppelten Stehkragen mit Nietenriemen und Boots eine Spur Edelpunk.“"
                            },
                            {
                                "example_id": "54498c0f-259b-4239-b095-13d3ca7eef27",
                                "sense_id": "33ceba60-fc39-309d-b3f9-1b676e27d881",
                                "text": "„Das erste, was mir in den Kopf kommt, sind diese Klischeebilder. Sittsam und brav, im weißen Spitzenkleid und so anmutig, daß es eine wahre Augenweide ist. In jedem Fall aber wartend auf den Prinzen, der es an der Hand nehmen und durch das weistere Leben führen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
