                "senses": [
                    {
                        "sense_id": "85d66ddb-a35f-3904-87a4-e2ee537f5faf",
                        "entry_id": "837b4aa1-40d7-3c02-a79f-8c3b4b5a1119",
                        "glosses": [
                            "ice cream"
                        ],
                        "tags": [
                            "Liechtenstein",
                            "Switzerland",
                            "feminine",
                            "mixed",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "fb9fc005-1f29-4f7b-a1e3-c19efbc6cd5a",
                                "sense_id": "85d66ddb-a35f-3904-87a4-e2ee537f5faf",
                                "text": "Es gibt so viele Kinder, die ich noch im Bauch drin kennengelernt habe, und heute hötterlen sie dahin und holen ihr Glace. Dann zupfen sie am Hosenbein, zeigen auf ein Bild, nehmen das Glace und rennen ganz stolz wieder zur Mama."
                            },
                            {
                                "example_id": "80fc2c9b-0b80-4a6e-88d3-939be99b8c3b",
                                "sense_id": "85d66ddb-a35f-3904-87a4-e2ee537f5faf",
                                "text": "Darunter nicht nur Falafelbällchen oder eine ganze Palette an mit verschiedensten Zutaten aufgepepptem Tofu, sondern auch vegane Glace, vegane Schoggi, vegane Joghurts."
                            }
                        ]
                    }
