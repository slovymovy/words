                "senses": [
                    {
                        "sense_id": "4650a47c-71b8-36b0-b2bf-3e737bf66346",
                        "entry_id": "89a35bad-0bff-3198-a3d7-bbadefd328d7",
                        "glosses": [
                            "eine im Handelsjargon übliche Bezeichnung für überhöhte Preisangaben zum Zwecke der Ermöglichung eines täuschend hohen Preisnachlasses (zum Beispiel im Schlussverkauf oder bei Sonderangeboten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb9db61-31bd-4020-b8ef-4c7cbb5c796d",
                                "sense_id": "4650a47c-71b8-36b0-b2bf-3e737bf66346",
                                "text": "Zuerst wurde der Artikel von € 65,99 auf den Mondpreis von € 79,99 erhöht, um ihn dann als Angebot um € 50,00 zu verkaufen!"
                            },
                            {
                                "example_id": "1e78f9de-1ef3-4a46-9d24-0a19a28f0ec3",
                                "sense_id": "4650a47c-71b8-36b0-b2bf-3e737bf66346",
                                "text": "Viele unverbindliche Preisempfehlungen sind reine Mondpreise."
                            },
                            {
                                "example_id": "daf38c95-19c9-40d2-9e1b-b359f5c6e08f",
                                "sense_id": "4650a47c-71b8-36b0-b2bf-3e737bf66346",
                                "text": "„Die Architekten hätten die Möglichkeit haben müssen, zu prüfen, ob die Bieter „Mondpreise“ vorgelegt hätten oder ob die eigene Kalkulation falsch war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "297efe92-9415-3d4f-b12e-9e0a4dc84cc1",
                        "entry_id": "89a35bad-0bff-3198-a3d7-bbadefd328d7",
                        "glosses": [
                            "ein meist außergewöhnlich hoher Preis, dessen Preisfindung sich nicht nachvollziehen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673c94de-2954-4b12-9de9-04e9f927cc78",
                                "sense_id": "297efe92-9415-3d4f-b12e-9e0a4dc84cc1",
                                "text": "„In Deutschland gibt es viele Maler – in allen Erscheinungsweisen, nicht nur Gerhard Richter (80), dessen Bilder \"Mondpreise\" erzielen, wie im November 2011 bei Sotheby's: $ 20,8 Millionen.“"
                            },
                            {
                                "example_id": "815a84d6-65a7-427a-94b1-4b62984a0c96",
                                "sense_id": "297efe92-9415-3d4f-b12e-9e0a4dc84cc1",
                                "text": "Preise für Netzanschriften oder Domänen / domains sind Mond- und Bauchpreise."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
