                        "examples": [
                            {
                                "example_id": "10180533-3e15-4ee4-8cd7-1172b1821d06",
                                "sense_id": "94bccd7b-bf0b-3d31-aa1f-345b36adcd91",
                                "text": "Dat wekt wellicht enige verbazing. Acteursregie is bij Maas immers altijd een ondergeschoven kindje geweest. Een uitspraak als “Over acteurs heb je minder controle dan over ontploffingen” zegt veel over zijn aanpak."
                            },
                            {
                                "example_id": "723b7cd9-7195-40ca-9abb-0f46d7edc548",
                                "sense_id": "94bccd7b-bf0b-3d31-aa1f-345b36adcd91",
                                "text": "De ijzersterke acteursregie van Luca Guadagnino is gebleven, waarin kleine gebaren boekdelen kunnen spreken en allerlei onverwachte bewegingen de elektrische lading van de film versterken."
                            }
                        ]
