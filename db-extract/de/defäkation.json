                "senses": [
                    {
                        "sense_id": "fea8b475-386d-33a9-b428-80be7bccf95a",
                        "entry_id": "7ce42137-4dc0-30aa-bca2-9ccfae86e4c5",
                        "glosses": [
                            "die Stuhlentleerung, der Stuhlgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12281a78-e8e8-4073-9a60-0c51bde5c038",
                                "sense_id": "fea8b475-386d-33a9-b428-80be7bccf95a",
                                "text": "„Auslösender Reiz der Defäkation ist bei Wirbeltieren eine Druckerhöhung im Rektum.“"
                            },
                            {
                                "example_id": "f8096251-e37d-43fa-a914-bbf5862ed197",
                                "sense_id": "fea8b475-386d-33a9-b428-80be7bccf95a",
                                "text": "„Schon der einfachste Hinweis auf den Abort, das Bade- oder Schlafzimmer, auf einen Nachttopf, auf die Phasen des Verdauungsprozesses, den Stuhlgang, das Pissen, die Defäkation, vermögen einfache Gemüter, insbesondere aber auch Kinder, zu schallendem Gelächter zu bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95fba682-a155-46cf-a6cf-fd6bfa25ba1e",
                        "source_entry_id": "7ce42137-4dc0-30aa-bca2-9ccfae86e4c5",
                        "source_sense_id": "fea8b475-386d-33a9-b428-80be7bccf95a",
