                ],
                "senses": [
                    {
                        "sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                        "entry_id": "81b3f3a1-0c99-3fc1-a8fe-267b7b5d0638",
                        "glosses": [
                            "устар., разг. поспать недолго, вздремнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "994efed7-7d8f-47d9-8492-d05eb0e7e0e3",
                                "sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                                "text": "Павел Константиныч прилег, по обыкновению, соснуть."
                            },
                            {
                                "example_id": "dad4d118-5dd3-459f-a73f-578ba310f868",
                                "sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                                "text": "Бросив телогрейку на кедровый лапник, он собрался соснуть часок, но пробудился засветло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "945a1245-a254-4d91-8932-ebd2b7b734c2",
                        "source_entry_id": "81b3f3a1-0c99-3fc1-a8fe-267b7b5d0638",
                        "source_sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                        "target_lang_word": "dösen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dösen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87841c89-664c-3c6f-b124-b8c47d26f704",
                                        "entry_id": "1fff8dde-312c-3c57-a804-79f8006ec8bd",
                                        "glosses": [
                                            "innerlich abwesend sein"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dbf229d-581a-4f7d-8119-13f8a3a43e80",
                                                "sense_id": "87841c89-664c-3c6f-b124-b8c47d26f704",
                                                "text": "Die lange sinnlose Warterei verführte mich zu dösen."
                                            },
                                            {
                                                "example_id": "5029201c-1812-4b3d-83b3-1a392e1932df",
                                                "sense_id": "87841c89-664c-3c6f-b124-b8c47d26f704",
                                                "text": "Und dös nicht die ganze Zeit bei der Busfahrt, pass auf, wer einsteigt und grüß die Leute!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b48f811-c77d-3263-9834-d6d146aaf4c5",
                                        "entry_id": "1fff8dde-312c-3c57-a804-79f8006ec8bd",
                                        "glosses": [
                                            "sich in einem Zustand zwischen wach und schlafend (Halbschlaf) befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0707f4-e470-4dc7-acf4-652c36940853",
                                                "sense_id": "8b48f811-c77d-3263-9834-d6d146aaf4c5",
                                                "text": "Bist du mir schon wieder böse, nur weil ich noch ein bisschen döse?"
                                            },
                                            {
                                                "example_id": "7862bdac-33c5-4cd1-ae9b-e8ea4e6c3e74",
                                                "sense_id": "8b48f811-c77d-3263-9834-d6d146aaf4c5",
                                                "text": "Ich habe nicht richtig geschlafen, nur eine halbe Stunde in der Sonne gedöst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cba75294-4573-4dc8-8578-61fa6ec4a0a4",
                        "source_entry_id": "81b3f3a1-0c99-3fc1-a8fe-267b7b5d0638",
                        "source_sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                        "target_lang_word": "einnicken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einnicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                        "entry_id": "c05d55f2-6bb5-3ee4-9078-cfbf79ddcc13",
                                        "glosses": [
                                            "(zumeist im Sitzen während einer Tätigkeit) übermannt von Müdigkeit (für kürzere Zeit) in Schlummer fallen (wobei der Kopf nach vorn sinkt und sich im Takt der Atmung leicht nickend bewegt)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800354c6-ab62-48b1-9b1a-273a5087a4fc",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Am Abend endlich, nachdem Balla nun doch erschöpft eingenickt war, auf der Bank im Büro der Ingenieure, wurde der Beton ausgeschalt.“"
                                            },
                                            {
                                                "example_id": "afa9ddfa-1e65-48e4-a900-7f326980d163",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Sie möchte am liebsten zu Bett gehen, aber in der Glotze läuft noch ein Krimi. Edith schaut lustlos zu, Adolf nickt zwischendurch ein.“"
                                            },
                                            {
                                                "example_id": "c6f0f588-a6d2-4156-8099-039353d47463",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Alt sein, das hieß auch, daß man an jedem Ort einnicken konnte.“"
                                            },
                                            {
                                                "example_id": "b7bc34a1-ab64-4799-83ee-d61bbf01847e",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Er war so müde, daß er immer wieder einnickte.“"
                                            },
                                            {
                                                "example_id": "c37ba801-cd83-4ed6-bdf7-3ffb6214ce10",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Er musste doch eingenickt sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "einnicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                        "entry_id": "cd591e3f-aaeb-3be0-875d-8fb5d14f97fa",
                                        "glosses": [
                                            "(den Ball) mühelos mit einer nickenden Kopfbewegung (ins Tor) köpfen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d4f90c-2be2-4ded-99c5-5ba98a699eaa",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Von der Strafraumgrenze aus hob sie den Ball ins Netz, wenig später nickte sie auch noch eine präzise Flanke ein.“"
                                            },
                                            {
                                                "example_id": "12532522-914a-4a3c-9ea9-42c01e832424",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Wieder war der Libero zur richtigen Zeit vor dem richtigen Tor und konnte das Leder nach einer weiteren Ecke unhaltbar ins Netz einnicken.“"
                                            },
                                            {
                                                "example_id": "968b023b-65cb-434c-841c-704b93a2b5e0",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Als Philipp Lahm den Ball nach 79. Minuten nach Innen flankte und Miroslav Klose zum umjubelten 2:1 eingenickt hatte, watschelte Ballack zum kleinen Lahm, nahm ihn liebevoll in den Schwitzkasten und tätschelte ihm wie ein großer Bruder den Kopf.“"
                                            },
                                            {
                                                "example_id": "9e4dac97-2a6f-4f2b-a721-7dbc6a961549",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Nach einem Freistoss von Zaugg aus dem rechten Halbfeld lief Popp in den Ball und nickte zum 1:0 ein.“"
                                            },
                                            {
                                                "example_id": "9bb5e27f-8837-4751-b4d6-eaa9910dc81d",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Doch postwendend verkürzt der neue Oranje-Starstürmer Dennis Bergkamp mit schönem Dropkick ins lange Eck; und gut zehn Minuten später jubeln wieder die Fans in Orange, als Aaron Winter den Ball nach einem Corner einnickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d67814e-1f05-42d3-828d-cdbd3f46093d",
                        "source_entry_id": "81b3f3a1-0c99-3fc1-a8fe-267b7b5d0638",
                        "source_sense_id": "c603ba55-543b-394c-9fab-047543560f64",
                        "target_lang_word": "somnoler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnoler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf258cf4-124b-39b5-a4cd-7822aec0255d",
                                        "entry_id": "efe7ccce-672d-3a18-b38b-bbc656a7a150",
                                        "glosses": [
                                            "Être dans un état de somnolence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226d0771-b80d-445f-baed-13c366ed2ccf",
                                                "sense_id": "bf258cf4-124b-39b5-a4cd-7822aec0255d",
                                                "text": "Tout en somnolant, en s'étirant, en maugréant, la nuit se passe et, à 6 heures ce matin du 20, nous débarquons à 500 m de Bussy-le-Repos où nous allons cantonner."
                                            },
                                            {
                                                "example_id": "d27783c1-8716-4345-859a-e1fc8ad3e0c4",
                                                "sense_id": "bf258cf4-124b-39b5-a4cd-7822aec0255d",
                                                "text": "Rompu par toutes ses émotions, Victor somnole un temps, à peine réveillé par un premier arrêt. « Nouzonville » a murmuré son voisin. C'est à la gare suivante : Bogny-sur-Meuse, qu'il reprend lentement ses esprits."
                                            },
                                            {
                                                "example_id": "4c53e859-7d17-4781-9098-0865d478da3c",
                                                "sense_id": "bf258cf4-124b-39b5-a4cd-7822aec0255d",
                                                "text": "Les étranges faiblesses de son style sont les faiblesses d’un écrivain qui parfois somnole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
