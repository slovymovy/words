                            {
                                "example_id": "133d7b65-8868-4e33-99b1-39af349fc086",
                                "sense_id": "4d5dd6b2-766c-3fc5-945c-7b3acd1ae058",
                                "text": "Ça et là, en chaque vallée traversée, des cascades à la fine silhouette argentée se jetaient du haut des parois rocheuses et couraient rejoindre la Norsen, zigzaguant entre rocs et troncs, formant rus et ruisseaux gentelets, à l’eau pure et froide."
                            },
                            {
                                "example_id": "638553f9-e603-4aaf-a12e-fbdd754f2c7d",
                                "sense_id": "4d5dd6b2-766c-3fc5-945c-7b3acd1ae058",
                                "text": "Sylvestre, à coup sûr, avait eu de belles heures avec une si gentelette."
                            }
                        ]
                    }
