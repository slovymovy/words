                "senses": [
                    {
                        "sense_id": "61a07698-de8a-3841-a5a6-14c440e906a3",
                        "entry_id": "d0f01396-e0b4-34cc-8978-f59f7906cb9b",
                        "glosses": [
                            "редк. расположенный на могиле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ac6015-8699-44a0-b846-313b8315a344",
                                "sense_id": "61a07698-de8a-3841-a5a6-14c440e906a3",
                                "text": "Судьба противостала и злобным и мирным моим желаниям; вскоре после похорон Фелиции она оторвала меня даже от тех мест, где бы я мог выплакать душу, как цветок намогильный."
                            },
                            {
                                "example_id": "e56202a7-1aae-4a2d-ae02-c614f99346cf",
                                "sense_id": "61a07698-de8a-3841-a5a6-14c440e906a3",
                                "text": "Всюду тихо, лишь кузнечики неустанно трещат в намогильной траве и в спелой яри на несжатых еще яровых полях."
                            }
                        ]
                    }
