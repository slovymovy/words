                        ],
                        "examples": [
                            {
                                "example_id": "e56efaa4-e72c-46c8-a1fb-ef771508cbab",
                                "sense_id": "be3af091-6947-3f96-b846-34ee4e9e1d10",
                                "text": "Une cocarde de rubans passementée de jayet étoffait la lourde boucle nouée sur la nuque."
                            },
                            {
                                "example_id": "648cd2e7-c86b-4ba5-96d3-9c616900c61c",
                                "sense_id": "be3af091-6947-3f96-b846-34ee4e9e1d10",
                                "text": "Je ne te dirai point qu’elle est belle, qu’elle a des yeux de saphir ou de jayet."
                            },
                            {
                                "example_id": "10481b01-a80c-4a16-866b-1c554d942268",
                                "sense_id": "be3af091-6947-3f96-b846-34ee4e9e1d10",
                                "text": "Une variété de lignite peut être facilement polie et s’emploie en bijouterie sous le nom de jais ou jayet."
                            }
                        ]
                    }
