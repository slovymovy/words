                ],
                "senses": [
                    {
                        "sense_id": "cb0e36c4-e860-34f8-b498-5c8613f60548",
                        "entry_id": "94bcd800-46d8-313c-9328-dd0f3721a81a",
                        "glosses": [
                            "Télégraphie sans fil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5195e231-4bb2-4b32-abea-0f6489206b44",
                                "sense_id": "cb0e36c4-e860-34f8-b498-5c8613f60548",
                                "text": "Les progrès réalisés en ces dernières années par la radiotélégraphie permettent d'envoyer actuellement des signaux à des milliers de kilomètres."
                            },
                            {
                                "example_id": "45955151-c4e2-41e2-805f-cec74db0fffc",
                                "sense_id": "cb0e36c4-e860-34f8-b498-5c8613f60548",
                                "text": "Il réalise alors les premiers essais de radiotélégraphie entre la forteresse du Mont-Valérien, l'hôtel national des Invalides et le château de Saint-Germain-en-Laye."
                            },
                            {
                                "example_id": "0d72b461-1e7e-4cc7-86ec-139d4bd3d6bc",
                                "sense_id": "cb0e36c4-e860-34f8-b498-5c8613f60548",
                                "text": "Ces investissements techniques et professionnels réalisés pour des radiotélégraphies internationales permettaient d'assurer également des liaisons radiotéléphoniques internationales, mais pour ce faire les industriels vont devoir composer avec l'administration des PTT."
                            }
                        ]
                    }
                ],
