                        "entry_id": "f3d2169b-0aa3-3dd3-bfea-df4b37812c12",
                        "glosses": [
                            "Qu’on peut anticiper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b5adb3-8db4-4d93-a0e4-1d875d0bfb7e",
                                "sense_id": "4c953fae-9fd9-3b6b-89fa-172e7a0e350a",
                                "text": "Si, par causalité ou autrement, tout a dépendu des premières données de manière à être anticipable à la représentation d’une conscience qui aurait existé alors …."
                            },
                            {
                                "example_id": "7550b275-74dd-44ce-894b-acf81730d431",
                                "sense_id": "4c953fae-9fd9-3b6b-89fa-172e7a0e350a",
                                "text": "Un acte humain … peut être sinon prévu, du moins anticipable, prenant une place déterminée dans une série d’actes."
                            },
                            {
                                "example_id": "75ad656a-96d4-49ed-9559-4b3a1a34429e",
                                "sense_id": "4c953fae-9fd9-3b6b-89fa-172e7a0e350a",
                                "text": "L’objectif est de lever l’incertitude sur les sanctions et d’avoir un dispositif crédible et anticipable."
                            }
                        ]
                    }
                ],
