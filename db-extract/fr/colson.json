                "entry_id": "f9e5b2dd-97f8-3d91-a22e-5b018bbaf73a",
                "word": "colson",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ccb3a3b-18a0-4f2a-8c07-80a789a37aea",
                        "entry_id": "f9e5b2dd-97f8-3d91-a22e-5b018bbaf73a",
                        "tags": [
                            "plural"
                        ],
                        "form": "colsons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e381a0af-663d-3c47-bdd5-8b3c2d7a295a",
                        "entry_id": "f9e5b2dd-97f8-3d91-a22e-5b018bbaf73a",
                        "glosses": [
                            "Collier de matière plastique qui sert à attacher les câbles électriques ensemble."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f8186622-7e0f-4d3f-baa4-f0e5b7635ab4",
                                "sense_id": "e381a0af-663d-3c47-bdd5-8b3c2d7a295a",
                                "text": "Il suffit de placer un colson à côté de chaque rayon à chaque roue, bien serrer, comptez une trentaine de câbles par roue."
                            }
                        ]
                    },
                    {
                        "sense_id": "258fdce0-89d8-3ae8-9e9b-dae3198186b2",
                        "entry_id": "f9e5b2dd-97f8-3d91-a22e-5b018bbaf73a",
                        "glosses": [
                            "Collier en matière plastique utilisé par les forces de l’ordre pour menotter des individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e19d11-43d6-450c-b9f0-e65e7256973c",
                                "sense_id": "258fdce0-89d8-3ae8-9e9b-dae3198186b2",
                                "text": "L'effroi s'empara de lui. Un homme était étendu sur le sol à guère plus de trois mètres de lui.\nMais il était inerte, les mains liées dans le dos par un colson. Et il était nu."
                            },
                            {
                                "example_id": "5f32053e-1fe1-4099-96ac-f3f8a1519d78",
                                "sense_id": "258fdce0-89d8-3ae8-9e9b-dae3198186b2",
                                "text": "Corps découvert vers 4 h 30 par une femme de 25 à 30 ans, rousse, alcoolisée. Le corps est assis sur une chaise, nu, les membres attachés à la structure du meuble par des colsons."
                            },
                            {
                                "example_id": "d5f9dcc6-8c68-4843-b353-7d600cac5c0f",
                                "sense_id": "258fdce0-89d8-3ae8-9e9b-dae3198186b2",
                                "text": "Quand on le sait... c'est mieux! Un colson de chaque côté du caoutchouc et tout est réglé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6419bf7e-7d11-4a79-990e-655999564be3",
                        "source_entry_id": "f9e5b2dd-97f8-3d91-a22e-5b018bbaf73a",
