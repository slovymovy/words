                    {
                        "sense_id": "10d334a5-1278-3757-9dc4-9e6c58db2e91",
                        "entry_id": "c4b5380b-9113-3e70-8e9e-860037f0f8e7",
                        "glosses": [
                            "etwas, worüber jedes Mitglied in einer Gemeinschaft verfügen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7ee5cb-e424-4bc1-a821-054093e14df9",
                                "sense_id": "10d334a5-1278-3757-9dc4-9e6c58db2e91",
                                "text": "„Es hilft auch nicht viel, wenn Sie plötzlich feststellen, daß viele Mommilies Gemeingut sind, das Sie immer schon mit etlichen Leidensgenossen teilen mußten.“"
                            },
                            {
                                "example_id": "0b19dd40-d29d-42b5-ba78-76dd2f2af765",
                                "sense_id": "10d334a5-1278-3757-9dc4-9e6c58db2e91",
                                "text": "„Das Alphabet ist Gemeingut, und es steht jedem frei, sich seiner zu bedienen, um daraus ein Wort zu bilden und es zu seinem eigenen Namen zu machen; Voltaire hätte unter dem Namen Arouet nicht in die Unsterblichkeit eingehen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
