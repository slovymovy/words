{
    "word_family": [
        "indecency",
        "indecently",
        "decent",
        "decency",
        "decently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb7ac442-e566-35c6-9e0b-0c3c0fc09f8b",
                    "sense_definition": "Not conforming to accepted moral standards of behavior, modesty, or propriety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impropriety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor was criticized for making <w>indecent</w> remarks during the family television show.",
                            "target_lang_translations": {
                                "ru": "Актёра раскритиковали за <w>непристойные</w> высказывания во время семейного телешоу."
                            }
                        },
                        {
                            "text": "He was arrested on charges of <w>indecent</w> exposure in the city park.",
                            "target_lang_translations": {
                                "ru": "Его арестовали по обвинению в <w>непристойном</w> обнажении в городском парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "immodest",
                        "immoral",
                        "improper",
                        "unseemly"
                    ],
                    "antonyms": [
                        "decent",
                        "proper",
                        "modest"
                    ],
                    "common_phrases": [
                        "indecent exposure",
                        "indecent assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не соответствующий принятым моральным нормам поведения, скромности или приличия; аморальный или вульгарный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "о поведении, словах или поступках, нарушающих правила приличия"
                            },
                            {
                                "target_lang_word": "неприличный",
                                "target_lang_sense_clarification": "несоответствующий правилам вежливости и морали"
                            },
                            {
                                "target_lang_word": "неподобающий",
                                "target_lang_sense_clarification": "неуместный, несообразный с моральными нормами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daac3810-adc2-301f-8f4f-35623abe6fca",
                    "sense_definition": "Offensive to good taste; inappropriate or unsuitably rushed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impropriety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They left the funeral with <w>indecent</w> haste to celebrate the reading of the will.",
                            "target_lang_translations": {
                                "ru": "Они покинули похороны с <w>неприличной</w> поспешностью, чтобы отпраздновать оглашение завещания."
                            }
                        },
                        {
                            "text": "Boasting about personal wealth during difficult times was considered thoroughly <w>indecent</w>.",
                            "target_lang_translations": {
                                "ru": "Хвастовство личным богатством в тяжёлые времена считалось совершенно <w>неподобающим</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "distasteful",
                        "offensive"
                    ],
                    "antonyms": [
                        "tasteful"
                    ],
                    "common_phrases": [
                        "indecent haste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбляющий хороший вкус; неуместный, бестактный или неприлично поспешный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприличный",
                                "target_lang_sense_clarification": "бестактный, оскорбляющий хороший вкус"
                            },
                            {
                                "target_lang_word": "неподобающий",
                                "target_lang_sense_clarification": "неуместный в данной ситуации"
                            },
                            {
                                "target_lang_word": "неуместный",
                                "target_lang_sense_clarification": "нарушающий такт или приличия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ea096b-d8bb-3a60-a8b6-9f390cc08b11",
                    "sense_definition": "Containing sexual or excretory material that is considered unsuitable for public broadcasting, without meeting the legal standard for obscenity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio station received a fine for airing <w>indecent</w> material during daytime hours.",
                            "target_lang_translations": {
                                "ru": "Радиостанция получила штраф за трансляцию <w>непристойных</w> материалов в дневные часы."
                            }
                        },
                        {
                            "text": "Regulators drew a strict legal distinction between <w>indecent</w> content and outright obscenity.",
                            "target_lang_translations": {
                                "ru": "Регуляторы провели чёткую юридическую грань между <w>непристойным</w> контентом и откровенной нецензурщиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "indecent material",
                        "indecent broadcasting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий сексуальные или физиологические материалы, недопустимые для открытого вещания, но формально не являющиеся порнографией/нецензурщиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "о материалах и контенте, нарушающем нормы публичного вещания"
                            },
                            {
                                "target_lang_word": "неподобающий",
                                "target_lang_sense_clarification": "недопустимый для эфира"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}