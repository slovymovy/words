                        "glosses": [
                            "Enlever les enfléchures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f43034-2a04-43bd-80b5-af2f20dc12c7",
                                "sense_id": "85a0088a-51cb-337d-93aa-7c0e2dbb62b4",
                                "text": "La facilité avec laquelle on pourra décapeler les haubans en un instant sans toucher à la mâture et sans être obligé de désenflécher."
                            }
                        ]
                    },
                    {
                        "sense_id": "b49e7086-d6f8-341d-b9e0-b29b7ae0eaa2",
                        "entry_id": "7b0f617b-421b-3fa2-99d4-25fd7c5c50ab",
                        "glosses": [
                            "Enlever les fléches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a30cb73a-9de5-411f-a792-8d8d17927026",
                                "sense_id": "b49e7086-d6f8-341d-b9e0-b29b7ae0eaa2",
                                "text": "Pour « désenflécher » les serpents, dans l’eau, avec de l’eau, qu’on les asperge : les flèches de chacun tombent et le serpent est sans plaie (akşata)."
                            }
                        ]
                    }
