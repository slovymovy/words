                ],
                "senses": [
                    {
                        "sense_id": "9c9abb0d-6332-35a5-839d-6309ead7f1be",
                        "entry_id": "3ac10f00-df43-3258-b743-a605cd75cfe1",
                        "glosses": [
                            "powstałe w wyniku nadmiernego rozciągania się skóry i zerwania sieci włókien kolagenowych wrzecionowate pasmo występujące najczęściej na skórze ud, brzucha, pośladków i piersi/klatki piersiowej lub ramion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49426fc-9de2-4cff-a93b-9b5bb2709cdf",
                                "sense_id": "9c9abb0d-6332-35a5-839d-6309ead7f1be",
                                "text": "Chce mieć rozstępy, nie wklepywać codziennie tony kremów, nie kąpać się w płatkach róży, nie używać perfum, które wulgarnie uwydatniają seksowność"
                            },
                            {
                                "example_id": "65bcf8f0-0181-4eb1-b545-99e23215f5ab",
                                "sense_id": "9c9abb0d-6332-35a5-839d-6309ead7f1be",
                                "text": "Dla każdej kobiety od oskarżeń o głupotę o wiele gorsze są rozstępy na skórze […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c20415bd-9029-3520-b99c-06ef0d0fafb5",
                        "entry_id": "3ac10f00-df43-3258-b743-a605cd75cfe1",
                        "glosses": [
                            "wolna, pusta przestrzeń pomiędzy czymś"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1dc783b-e6e7-4260-94a2-925347ae00dc",
                        "source_entry_id": "3ac10f00-df43-3258-b743-a605cd75cfe1",
                        "source_sense_id": "9c9abb0d-6332-35a5-839d-6309ead7f1be",
                        "target_lang_word": "stretch mark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stretch mark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                        "entry_id": "80db9631-0a27-3164-95df-40b364712d9b",
                                        "glosses": [
                                            "Any of a series of red (or purple or faded), irregular stripes on the surface of the skin caused by rapid growth of the tissues lying just underneath. They may appear as a result of pregnancy, puberty, obesity, rapid muscle growth or family history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224e3d45-7a80-4dc9-a8e2-5f299a155c73",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "Nobody in Cameron's family has stretch marks, and he thinks it's because their tissues grow slowly enough for the skin to catch up."
                                            },
                                            {
                                                "example_id": "ba966e26-de68-41ce-8855-4d90b9d2d78e",
                                                "sense_id": "25776b9c-152b-378b-b57c-22416e8ca37c",
                                                "text": "She hadn't even looked pregnant, especially with her clothes on. She'd gotten only one stretch mark. A thin, jagged line on her left booty cheek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
