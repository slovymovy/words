                            },
                            {
                                "target_lang_word": "kiddie pool",
                                "target_lang_sense_clarification": "shallow pool for young children, typically American"
                            },
                            {
                                "target_lang_word": "children's pool",
                                "target_lang_sense_clarification": "general term for a shallow pool at a facility"
                            },
                            {
                                "target_lang_word": "wading pool",
                                "target_lang_sense_clarification": "shallow pool for wading/splashing, US"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c45f35-aaa0-3638-8f64-a8f7a8b36e15",
                    "sense_definition": "Klein, draagbaar badje of teil waarin een baby of jong kind gewassen kan worden.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "badkuip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zetten het plastic <w>kinderbad</w> in de badkamer om de baby te wassen.",
                            "target_lang_translations": {
                                "en": "We put the plastic <w>baby bath</w> in the bathroom to wash the baby."
                            }
                        },
                        {
                            "text": "Na de geboorte kochten de jonge ouders een handig <w>kinderbad</w> op een standaard.",
                            "target_lang_translations": {
                                "en": "After the birth, the young parents bought a handy <w>baby bath</w> on a stand."
                            }
                        }
