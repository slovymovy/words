                    }
                ],
                "translations": [
                    {
                        "translation_id": "87f4e22a-dbba-47c4-8f46-45d05784a64b",
                        "source_entry_id": "90432b1f-324c-3b0d-af4b-47c735d5539f",
                        "target_lang_word": "luette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8353e2a4-ba39-3ac3-b9a9-69ddf6d8d906",
                                        "entry_id": "830373fc-d38b-37e1-8e76-c883027c850d",
                                        "glosses": [
                                            "Partie charnue, saillante, mobile et contractile, au milieu du voile du palais, à l’entrée du gosier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b3b61f-b560-4500-994b-9dc82ae03a2d",
                                                "sense_id": "8353e2a4-ba39-3ac3-b9a9-69ddf6d8d906",
                                                "text": "Il a la luette enflée."
                                            },
                                            {
                                                "example_id": "4ebeb167-573b-42e2-bf09-185535023043",
                                                "sense_id": "8353e2a4-ba39-3ac3-b9a9-69ddf6d8d906",
                                                "text": "La sensation de corps étranger, déterminée par la luette pendante, aurait attiré l’attention des malades, puis des médecins, sur cet organe insignifiant, simple appendice du voile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "529f05bf-bf27-412c-acbc-725d55a73e2f",
                        "source_entry_id": "90432b1f-324c-3b0d-af4b-47c735d5539f",
                        "target_lang_word": "anche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "306968a5-1334-3aa2-aa10-f96fd3eea257",
                                        "entry_id": "14b22049-2fbe-3765-9147-b60dbd04a59d",
                                        "glosses": [
                                            "Languette mobile qui ouvre et ferme alternativement le passage de l’air dans un tuyau, où on la fait vibrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0097f1a9-b987-4db1-b558-a4b3b9a0d53e",
                                                "sense_id": "306968a5-1334-3aa2-aa10-f96fd3eea257",
                                                "text": "C’est de l’anche, qui est la partie la plus délicate du saxo, que dépend la « qualité du son »."
                                            },
                                            {
                                                "example_id": "fc2bdaf0-cb7a-487f-a649-39ce78e008e5",
                                                "sense_id": "306968a5-1334-3aa2-aa10-f96fd3eea257",
                                                "text": "Inlassable fouineur, quand il s’agit de trouver des petits coins dans les morceaux de Thelonius, qu’il va chatouiller du bout de son anche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b031a6-8aed-37d8-a5ec-4fa53b1868d9",
                                        "entry_id": "14b22049-2fbe-3765-9147-b60dbd04a59d",
                                        "glosses": [
                                            "Demi-tuyau de cuivre pour l’orgue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61457413-131f-3e4a-a589-732e1f578422",
                                        "entry_id": "14b22049-2fbe-3765-9147-b60dbd04a59d",
                                        "glosses": [
                                            "Conduit par lequel la farine tombe du moulin dans la huche."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da00f258-0fbe-398b-a3fb-cea5c79a8a19",
                                        "entry_id": "14b22049-2fbe-3765-9147-b60dbd04a59d",
                                        "glosses": [
                                            "Sorte de robinet de bois d'un tonneau, cannelle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed61c1d-d9f9-43a8-a22b-9d5e788c8dfc",
                                                "sense_id": "da00f258-0fbe-398b-a3fb-cea5c79a8a19",
                                                "text": "Plusieurs, pour vider leurs cuves plus aisément, y mettent une anche, par laquelle ils tirent le vin clair dans une cuvette, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606e6df0-e9c2-3576-9f0c-26a8e74ac901",
                                        "entry_id": "14b22049-2fbe-3765-9147-b60dbd04a59d",
                                        "glosses": [
                                            "Sorte de robinet de bois d'un tonneau, cannelle.",
                                            "À l'anche : directement tiré du tonneau, qui n'est pas mis en bouteille. Vin vendu à l'anche : vin vendu en vrac."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e7b4c1-b6dc-44e4-b684-dfc5cce4313a",
                                                "sense_id": "606e6df0-e9c2-3576-9f0c-26a8e74ac901",
                                                "text": "… car on partageait aussitôt « à l'anche de la cuve » ou à la conche du pressoir, chacun emplissant ses propres tonneaux."
                                            },
                                            {
                                                "example_id": "7c4c0687-14bc-49a6-9fdd-d7f377bd1e04",
                                                "sense_id": "606e6df0-e9c2-3576-9f0c-26a8e74ac901",
                                                "text": "Ici nous avons égard qu'à l'industrie qui le produit, et le prix du vin pris à l'anche est habituellement de 16 à 24 frs."
                                            }
                                        ]
                                    }
                                ]
                            },
