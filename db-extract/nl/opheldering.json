                    {
                        "translation_id": "97ccac2c-22e8-4576-b725-c41510a05daa",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "Erläuterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erläuterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "Erklärung (von Zusammenhängen, Sachverhalten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8097fa6-da91-4a30-bdc4-a5133b081776",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "Die Erläuterungen des Vortragenden waren viel zu umständlich."
                                            },
                                            {
                                                "example_id": "b9611590-50de-41c2-8419-2654c873bab8",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Nach dieser Erläuterung erzählte der Mönch die Geschichte der Bank zu Ende, denn die Griechen hatten es nicht bei ihrem Mißtrauen belassen.“"
                                            },
                                            {
                                                "example_id": "45c60c16-f36a-4f67-9f5e-b13c0c5fab60",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Um einen guten und gut erzählten Witz zu verstehen, braucht man natürlich keine Erläuterungen, schon gar keine sprachwissenschaftlich oder sonstwie wissenschaftlich untermauerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "ein Rechtsbehelf"
                                        ],
                                        "tags": [
                                            "schweizerisches Verwaltungsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb3b5df-d1e0-4d72-b052-06ea54523583",
                                                "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                                "text": "Sowohl Erläuterung als auch Berichtigung haben nicht den Zweck der Änderung eines Entscheides, sondern nur einer Klarstellung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea24f480-e9ef-4bcd-b4bd-59a73b160996",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "explanation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explanation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "The act or process of explaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60906a1d-055d-4ea9-9831-60470e103713",
                                                "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                                "text": "The explanation was long and drawn-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "Something that explains or makes understandable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf764402-80f1-4def-944f-8a53943d6e83",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "An explanation for the UFO sightings was easily found."
                                            },
                                            {
                                                "example_id": "cd63b806-2b9c-4ecc-960a-4e7860d0e759",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "The socialist will, of course, see in this merely a proof that the more intelligent person is today bound to become a socialist. But this is far from being the necessary or even the most likely explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "A resolution of disputed points pursuant to discussion; a mutual clarification of disputed points; reconciliation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ace244-1b22-4335-8a9a-4abdf818a43f",
                                                "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                                "text": "This little explanation with Mr. Knightley gave Emma considerable pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dad2fd6-2d4e-40be-b0c0-d456b2a87eaa",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "elucidation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elucidation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                        "entry_id": "5c6304ae-c9bd-370f-b164-ea2c182fefc0",
                                        "glosses": [
                                            "A making clear; the act of elucidating or that which elucidates, as an explanation, an exposition, an illustration"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37df257-9aff-4902-a1b8-c2f88fdb03d8",
                                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                                "text": "The essay might, undoubtedly, have been rendered much more complete by a collection of a greater number of facts in elucidation of the general argument."
                                            },
                                            {
                                                "example_id": "6cdde770-df5d-4e35-bafe-8913540d664f",
                                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                                "text": "At a time like the present when Eastern æsthetics are attracting the attention of scholars in all quarters, and particularly when the great field of Buddhist art is coming more into focus, a view of a little-known aspect of this subject may perhaps be the humble means of assisting in the elucidation of some of the complex problems with which this study is surrounded."
                                            },
                                            {
                                                "example_id": "a5c4575a-9f91-46e2-833b-138aab51e6a3",
                                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                                "text": "This note does not arrive at any conclusions not previously obtained by Bastable, Marshall and Pigou, but it shows the nature of the slip which led Edgeworth to conclusions contrary to theirs, and demonstrates the applicability of Marshall's \"offer curve\" apparatus to the elucidation of this problem."
                                            },
                                            {
                                                "example_id": "391fc9c5-1afc-48b9-8093-5f11b51e0d6c",
                                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                                "text": "2016, December 6, Christopher Hooton writing in The Independent, Westworld: Ed Harris doesn’t have a clue what’s going on either\nThe finale might not provide much elucidation, a feature-length instalment that bombarded the viewer with information."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f5c08ef-79ec-4b09-88c9-a8c14feffd49",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "clarification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clarification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "821fcee2-bb36-3be0-ac6c-f841794e45be",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "The act of clarifying; the act or process of making clear or transparent by freeing visible impurities; particularly, the clearing or fining of liquid substances from impurities via the separation of the insoluble particles which prevent the liquid from being transparent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e48853-1efb-4e91-b0e3-d12055a093c0",
                                                "sense_id": "821fcee2-bb36-3be0-ac6c-f841794e45be",
                                                "text": "The clarification of wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "The act of freeing from obscurities; disambiguation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7753bbfc-0bd4-4ad3-959c-dd2c1ab9d299",
                                                "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                                "text": "Your ideas deserve clarification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba16dd81-c9c1-3215-b255-0c365fecf2a6",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "An explanatory comment on, or question about, a point of obscurity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e31da40-55c4-4c6b-9fec-6df39f5398f1",
                                                "sense_id": "ba16dd81-c9c1-3215-b255-0c365fecf2a6",
                                                "text": "Let me make just one clarification: did he kiss her, or did she kiss him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b07d52a-7ff6-3f71-b966-b0a4cca23a69",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "A small piece of writing supplemental to a previously published text, intended to disambiguate, explain away obscurities, but not contradict or emend the text (as would a correction)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ce5676f-ad50-3094-9d12-d55da8b82e24",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "Clarity, transparency, mutual understanding; to be clear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e65c5f-065f-49b4-a87c-030476c5708f",
                                                "sense_id": "1ce5676f-ad50-3094-9d12-d55da8b82e24",
                                                "text": "So, just for clarification, you're saying your Chihuahua ate your homework?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6229274b-9766-4fda-930e-5710ec733e26",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "éclaircissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaircissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Action de rendre moins serré, moins épais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd9a943-5a64-4d46-95f9-534400ce7e33",
                                                "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                                "text": "L’éclaircissement d’un bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Explication d’une chose obscure ou mal connue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655eb91c-3f16-49d0-9d3c-8d3741a242bb",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Las de se casser la tête sur des énigmes, Hervé remit les éclaircissements au lendemain et regagna l'hôtel du Rhin."
                                            },
                                            {
                                                "example_id": "083912c9-8592-45a8-8ae5-ce9220647875",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "A son retour, il publia sept lettres attribuées à Saint Antoine, qu’on n’avoit point encore imprimées. Théodore les avoit tirées de la bibliothèque des princes de la Mirande, Jean & François Pic. Symphorien Carpentier, médecin d’Antoine, duc de Lorraine, les accompagna de quelques remarques, qui servirent à leur donner de l’éclaircissement."
                                            },
                                            {
                                                "example_id": "18c3d08b-ed4b-41eb-a714-94d0e9d7a144",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Déconverger le modèle social d’une communauté avec les individus qui la composent, bien que de la convergence, là aussi, naissent des éclaircissements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fe46713-5413-45fe-a599-accbac7261f2",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "explication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Discours par lequel on cherche à faire comprendre un texte, une idée ou une œuvre en ajoutant des renseignements supplémentaires ou en en exposant les détails ou les motifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dedcf12-43c2-48d1-8b57-7059c7ae5037",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "Cela demande explication."
                                            },
                                            {
                                                "example_id": "2a3a5f99-23ce-475f-aec7-0b9d578b7173",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "L’explication d’une scène, d’un tableau, d’un panorama."
                                            },
                                            {
                                                "example_id": "f105508c-6da8-4db5-bdbb-7c337fe589e9",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "Cet article n’est pas clair, il peut souffrir/recevoir deux explications différentes."
                                            },
                                            {
                                                "example_id": "821951de-02ad-4b82-bc5c-6a6db8d25174",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "La leçon de droit débute par la dictée des cahiers du professeur, et se poursuit par une explication, voire des interrogations. Cette procédure didactique n'est pas sans rappeler l'enseignement du droit tel qu'il se développe depuis le Moyen Âge."
                                            },
                                            {
                                                "example_id": "27facbce-574d-4f26-a332-aa560b7dacdc",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "En vain donc ces dangereux interprètes nous crient que le gros des Pères n'a jamais examiné critiquement, le vrai ou le faux des explications littérales de la Bible ; […]."
                                            },
                                            {
                                                "example_id": "b89cc3d9-3aca-4ec5-89ad-f0e6ba57918f",
                                                "sense_id": "6e9f2863-5b30-3f48-8837-cc63d11a878b",
                                                "text": "À la fin des trois confinements, on avait 60 millions d’épidémiologistes tellement nous étions abreuvés d’explications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "442b7046-3044-3982-92a9-fc5f6b325eb3",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Ce qui aide à trouver la cause, le motif d’une chose difficile à concevoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61195caf-139f-4f52-be68-4d4b1ab014ee",
                                                "sense_id": "442b7046-3044-3982-92a9-fc5f6b325eb3",
                                                "text": "Cela me donne l’explication d’un fait dont je n’avais pu encore me rendre compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89360ebd-948a-3093-962c-65da5706f67b",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Informations peu satisfaisantes données pour justifier un acte, un comportement ou une situation; faux-fuyant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3abd8b4f-10a0-4a9a-8e3a-e306860e624c",
                                                "sense_id": "89360ebd-948a-3093-962c-65da5706f67b",
                                                "text": "C'est une gang d'hypocrites ! Menteurs un jour, menteurs toujours ! Ils changeront jamais. Tout le temps des cachettes, des belles explications pour se justifier, du blabla, du blabla… pas autre chose que du blabla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630e75f0-1927-3e87-a75f-0ec9f37558c0",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Ce par quoi l'on prouve ou démontre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a361e9b1-a62a-4876-a6cb-21c6d2d53afa",
                                                "sense_id": "630e75f0-1927-3e87-a75f-0ec9f37558c0",
                                                "text": "Enfin ne craignons pas de substituer à la science cabalistique ancienne, l’explication du monde par l’observation des phénomènes de la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                        "entry_id": "7ab6f008-7239-3aeb-9b58-0569b5ac07c8",
                                        "glosses": [
                                            "Simple traduction ou interprétation orale d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9e00e7-d2a9-47a1-b0d0-62dd484c2a48",
                                                "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                                "text": "Le professeur nous fait faire des explications de Virgile, de Tacite."
                                            },
                                            {
                                                "example_id": "a8c3b505-27f4-4797-9e67-8961418015a0",
                                                "sense_id": "cb34c15d-8f41-335f-942c-fa9d612a7b2d",
                                                "text": "Cet élève s’est fort bien tiré de son explication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45272479-fa06-46ee-bea3-e30626aa0fa0",
                        "source_entry_id": "1f52df61-0573-3807-8523-4a292e3f592d",
                        "source_sense_id": "787573d0-9f76-3585-ab7b-9e7e8ef11472",
                        "source_sense_description": "verduidelijking",
                        "target_lang_word": "élucidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élucidation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d04e0f1f-52d6-347c-878a-9d132b385267",
                                        "entry_id": "dfaf636c-ce5b-3300-99fe-3515b14d40ce",
                                        "glosses": [
                                            "Action d’élucider."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7e2065-3bf4-4162-be7b-977dfe2e6706",
                                                "sense_id": "d04e0f1f-52d6-347c-878a-9d132b385267",
                                                "text": "L’élucidation d’un texte obscur."
                                            },
                                            {
                                                "example_id": "611edd78-1130-4b57-9ea6-95ecf670ed4a",
                                                "sense_id": "d04e0f1f-52d6-347c-878a-9d132b385267",
                                                "text": "L’élucidation de la structure tridimensionnelle de la molécule d’ADN, par Watson et Crick en 1953, sous forme d’une double hélice, réalise l’étape ultime de mise en correspondance de la structure et de la fonction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
