                "senses": [
                    {
                        "sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                        "entry_id": "a629469f-1331-3813-82f1-cda20af0776a",
                        "glosses": [
                            "Leben in der Abgeschiedenheit; Zustand des gewollten Fernbleibens von Artgenossen oder Geschehnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2027ef06-3120-41db-a0bd-3a8adaeadeb9",
                                "sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                                "text": "Niemand bemerkte den Tod des seltsamen Fremden, der die letzten Jahre in Zurückgezogenheit verbrachte."
                            },
                            {
                                "example_id": "fd213904-8591-4d44-9f9a-ceef994800c2",
                                "sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                                "text": "„Sie liebte ihn, überschüttete ihn mit Zuneigung und ging sogar so weit, ihm seine Zurückgezogenheit vorzuwerfen, weil sie sich von ihm doch nichts als ein wenig Aufmerksamkeit gewünscht hätte.“"
                            },
                            {
                                "example_id": "4d505507-6331-4833-b16d-68cb0d5373d0",
                                "sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                                "text": "„Nach einigen Wochen kleinstädtischer Zurückgezogenheit ist er im Dezember 1929 nach Berlin zuückgekehrt, um dann im Juli 1930 erneut in seiner Heimatstadt am Roman zu arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97b9ead5-2a75-4608-ae10-d0fb2e64b69c",
                        "source_entry_id": "a629469f-1331-3813-82f1-cda20af0776a",
                        "source_sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                        "source_sense_description": "Leben in der Abgeschiedenheit; Zustand des gewollten Fernbleibens von Artgenossen oder Geschehnissen",
                        "target_lang_word": "retiracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retiracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41eafd10-4c14-3638-bfa7-7303bc147325",
                                        "entry_id": "d533e4ff-ada4-313e-a75f-629181f0ed78",
                                        "glosses": [
                                            "retirement"
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "humorous",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6646fd71-0dc4-48be-b708-0b95365b82da",
                                                "sense_id": "41eafd10-4c14-3638-bfa7-7303bc147325",
                                                "text": "The patriot commanders in the middle of January went into retiracy, having with much judgment commended the forces under them to their own discretion"
                                            },
                                            {
                                                "example_id": "d8a1f362-afc5-41bd-aab4-7946ad4af2f5",
                                                "sense_id": "41eafd10-4c14-3638-bfa7-7303bc147325",
                                                "text": "what one of our great men used to call dignified retiracy"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3606cfad-61cf-483b-b717-68260329a02d",
                        "source_entry_id": "a629469f-1331-3813-82f1-cda20af0776a",
                        "source_sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
                        "source_sense_description": "Leben in der Abgeschiedenheit; Zustand des gewollten Fernbleibens von Artgenossen oder Geschehnissen",
                        "target_lang_word": "solitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e599af-52c2-36fd-9f75-73a791a101a7",
                                        "entry_id": "5f05aaa8-798c-318d-9d3b-ef49e4402746",
                                        "glosses": [
                                            "État d’une personne qui est seule, qui est retirée du commerce du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6047f5f-02c7-49d0-90fb-b3985de177ca",
                                                "sense_id": "b2e599af-52c2-36fd-9f75-73a791a101a7",
                                                "text": "Les hommes peuvent être considérés dans l’état de solitude et dans l’état de multitude."
                                            },
                                            {
                                                "example_id": "c462bf80-4016-4d60-b0c4-c958052641b9",
                                                "sense_id": "b2e599af-52c2-36fd-9f75-73a791a101a7",
                                                "text": "Parfois, dans sa solitude désolée, elle se mettait à chanter les complaintes qu’il avait aimées, et alors elle pleurait, entrecoupant de sanglots déchirants les couplets mélancoliques, […]."
                                            },
                                            {
                                                "example_id": "d6e801dc-4c3a-4a95-86a0-9e0b8c74aba2",
                                                "sense_id": "b2e599af-52c2-36fd-9f75-73a791a101a7",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                                        "entry_id": "5f05aaa8-798c-318d-9d3b-ef49e4402746",
                                        "glosses": [
                                            "Sentiment d'être seul ou abandonné."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f153ae6-5f07-48ec-9ca0-d4a8a18c90a0",
                                                "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                                                "text": "La fatigue, le temps morne (j’entends de la pluie dans le soir), l’ombre qui augmente ma solitude et m’agrandit malgré tous mes efforts et puis quelque chose d’autre, je ne sais quoi, m’attristent."
                                            },
                                            {
                                                "example_id": "a1df0f6c-b2f6-4f5b-8e58-7bb873f56950",
                                                "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                                                "text": "Il savait d’expérience que la pire souffrance est dans la solitude qui l’accompagne."
                                            },
                                            {
                                                "example_id": "857df20d-c2fd-4c1a-9b51-b7a04702ed76",
                                                "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                                                "text": "Elle ne voulait pas être seule. Elle sentait déjà l’horreur de sa solitude, l’insomnie prolongée, le tête-à-tête décevant avec Dieu."
                                            },
                                            {
                                                "example_id": "3f3d93c5-ed95-4d7a-b6b6-cecde416c129",
                                                "sense_id": "ef94953a-da2b-3f2d-81b7-b5f423302039",
                                                "text": "La solitude peut être féconde, captivante, exaltante. Elle est toutefois rarement douce, car elle recèle ce rappel de la mort qui fait que tous la redoutent et sont prêts, pour la fuir, à bien des subterfuges, quelquefois dégradants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                        "entry_id": "5f05aaa8-798c-318d-9d3b-ef49e4402746",
                                        "glosses": [
                                            "Lieu éloigné du commerce, de la vue, de la fréquentation des hommes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad24eb9-bb35-456f-a568-9ca363078054",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "[…] ; le 19, il arriva à El-Araouan et quitta cette ville commerçante pour franchir, à travers mille dangers, les vastes solitudes comprises entre le Soudan et les régions septentrionales de l’Afrique ; enfin il entra à Tanger, et, le 28 septembre, il s’embarqua pour Toulon ; […]."
                                            },
                                            {
                                                "example_id": "0afc055a-703e-4454-8e5d-43304b668938",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "Le désert déroulait maintenant devant nous ses solitudes démesurées."
                                            },
                                            {
                                                "example_id": "c7bddaf4-63e6-4206-901f-ab5e28044d49",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "Et puis le silence , ce grand silence qui plane au-dessus des solitudes islandaises , et que trouble seul le sifflement du vent ou le cri des pluviers dorés."
                                            },
                                            {
                                                "example_id": "65f36b09-2ba4-4e8f-970a-6c8b9db44b53",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "La première sensation, poignante jusqu’à l’angoisse, fut pour Jacques celle de l’emprisonnement dans tout ce sable, derrière toutes ces solitudes, que pendant huit jours, il avait traversées, […]."
                                            },
                                            {
                                                "example_id": "d1e5c90d-da8c-45c2-adb6-126b8f4b2758",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "[…]; on eût dit que son regard, triste et lointain comme le regard des hommes qui ont longtemps vécu sur la mer ou dans les solitudes immenses, gardait comme un reflet de l’infini."
                                            },
                                            {
                                                "example_id": "1a929dc3-38c5-4b9c-b9e9-45e15e2190ef",
                                                "sense_id": "604de7e6-0d9e-3086-821c-c9e10c636488",
                                                "text": "Et tu auras beau houpper, hurler à l'aide, hululer comme une hulotte, la fagne est une solitude, un désert funeste à qui la nargue ; personne ne t'entendra."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83e1094-52d1-4229-b3cc-18b4b0c32e1c",
                        "source_entry_id": "a629469f-1331-3813-82f1-cda20af0776a",
                        "source_sense_id": "be7a40b1-7612-39c9-a021-ac34b3414f1a",
