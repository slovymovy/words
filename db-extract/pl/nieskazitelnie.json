                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6285d61-5eee-396c-a917-86358e329fd4",
                        "entry_id": "4e4575db-56c1-3e38-b8f6-abf7687a6188",
                        "glosses": [
                            "w sposób nieskazitelny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1960cec0-5c01-402c-98d3-7b2536524098",
                                "sense_id": "f6285d61-5eee-396c-a917-86358e329fd4",
                                "text": "Podniósł szklankę, zachwycony tym, jak odbijała surowe światło mesy, rzucając kolory na idealnie odprasowany, nieskazitelnie biały obrus"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef2c3a1-2c23-4ceb-bbb6-186e1d3894ce",
                        "source_entry_id": "4e4575db-56c1-3e38-b8f6-abf7687a6188",
                        "source_sense_id": "f6285d61-5eee-396c-a917-86358e329fd4",
                        "target_lang_word": "impeccably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impeccably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                        "entry_id": "00020e77-8794-3d7c-9ba0-40b4901e068d",
                                        "glosses": [
                                            "In a perfect or flawless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b52299-5ed0-49a6-b433-a31ecf71074f",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "Arley's ferry boat has been replaced by a single-span pedestrian bridge. This leads to the old Harbour Inn and the impeccably restored railway station, now part of the privately run steam-operated Severn Valley Railway."
                                            },
                                            {
                                                "example_id": "2d4df45f-85c0-480a-97ce-5ddff84be33d",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "The great pianist was a prolific composer, who wrote impeccably for the piano."
                                            },
                                            {
                                                "example_id": "7ae703ec-a095-4f5c-8eeb-e5e0cf39546e",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "It is difficult to distinguish one bourgeois from another: the grande bourgeoisie are impeccably dressed at all times and don't speak to anyone outside their own class; the bonne bourgeoisie are impeccably dressed and speak to everyone; the petite bourgeoisie are impeccably dressed and speak only to complain[…]"
                                            },
                                            {
                                                "example_id": "d5cf2606-f436-4863-bf33-f5ce69c3f385",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "In fact, even when I did make some small mistakes with grammar, people still said I spoke impeccably."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5565cc6f-ecb4-4d6e-b32e-aeac45264cfc",
                        "source_entry_id": "4e4575db-56c1-3e38-b8f6-abf7687a6188",
                        "source_sense_id": "f6285d61-5eee-396c-a917-86358e329fd4",
                        "target_lang_word": "impeccablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impeccablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                        "entry_id": "4c66a1f3-9272-32a3-8ff6-f21cb7d82fb2",
                                        "glosses": [
                                            "D’une manière impeccable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e574e8f0-3fc9-470b-bcef-859bf55915c2",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "Elle regardait l’agitation sans broncher, sans que son visage sec et ridé ne trahisse le moindre sentiment : un masque de pâte durcie et craquelée coiffé de cheveux blancs impeccablement tirés sur sa nuque et noués en un petit chignon rachitique."
                                            },
                                            {
                                                "example_id": "7d359ef7-3e74-4289-b2f2-de920851a5d6",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "D'un côté, vous aviez le taulard, vêtu du droguet réglementaire, chaussé de sabots et tondu à ras. De l'autre, le surveillant, impeccablement sanglé dans son uniforme, casquetté de frais, astiqué du ceinturon, agitant des clés nickelées, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
