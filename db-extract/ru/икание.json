                    {
                        "translation_id": "05f198fe-97f4-474f-aedf-12180d59194b",
                        "source_entry_id": "03d27f28-626a-33a1-9802-9a30ba5d0a1e",
                        "target_lang_word": "Schluckauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schluckauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                        "entry_id": "352b6e0b-0bd1-323f-bdcf-511eba49ebe5",
                                        "glosses": [
                                            "unwillkürliches, ruckartiges Einatmen bei gleichzeitigem Von-sich-Geben von glucksenden Geräuschen, hervorgerufen durch ruckartiges Zusammenziehen des Zwerchfells (ähnlich wie beim Husten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ab7698-7d1d-4827-995c-f28932029f9c",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Der Schluckauf geht meistens schnell vorüber."
                                            },
                                            {
                                                "example_id": "c97aabe5-64e8-45f3-985a-555e07800290",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Ein anhaltender Schluckauf ist ziemlich lästig."
                                            },
                                            {
                                                "example_id": "acaf9465-f158-4ac6-9b0e-cfa11c7adf17",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Die meisten Hausrezepte gegen Schluckauf, ein Stück Würfelzucker, Luft anhalten, funktionieren nicht."
                                            },
                                            {
                                                "example_id": "57fbf9c9-d812-4944-8fda-db34b436bc74",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Einen Schluckauf haben, das war nichts Schlimmes, das hatte doch jeder schon mal gehabt.“"
                                            },
                                            {
                                                "example_id": "eacfd738-c89a-4342-a3c4-2332b03ed566",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Wenn ich Sonette lese, bekomme ich auch immer gleich Schluckauf.“"
                                            },
                                            {
                                                "example_id": "c5691d6d-e6bb-42ad-9b48-fd18616fea2f",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Er hatte in jenen Tagen viel Schluckauf, und er weinte oft.“"
                                            },
                                            {
                                                "example_id": "82f90f56-aef3-47aa-a856-b550fe3fcfb5",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Schluckauf, Sodbrennen, Reflux: Diese Symptome hängen mit dem Zwerchfell zusammen. […] Der Schluckauf ist nichts weiter als eine Verkrampfung, eine plötzliche Verkrampfung des Zwerchfells, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "292a3af7-8a1c-4177-8e3c-7fe729dc28db",
                        "source_entry_id": "03d27f28-626a-33a1-9802-9a30ba5d0a1e",
                        "target_lang_word": "hoquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc1c82f-8a0b-3352-8943-0bf73a23a724",
                                        "entry_id": "e37a08de-9795-3996-91d7-57bc0d54218e",
                                        "glosses": [
                                            "Secousse, choc, heurt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb8953c-1236-43c7-99d6-afc285ca2e17",
                                                "sense_id": "6fc1c82f-8a0b-3352-8943-0bf73a23a724",
                                                "text": "L'un contre l'autre jetés\nAu moindre hoquet qu’ils trouvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                        "entry_id": "e37a08de-9795-3996-91d7-57bc0d54218e",
                                        "glosses": [
                                            "Mouvement convulsif du diaphragme, qui s’accompagne d’une espèce de son articulé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f1a233-48df-4ff6-8e24-08aa174a2236",
                                                "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                                "text": "Pierre.– Le ciel me pèse sur la tête comme une voûte de prison, et il me semble que je respire dans les rues des quolibets et des hoquets d’ivrognes."
                                            },
                                            {
                                                "example_id": "ead6d235-f92d-4365-8b90-a5ae573374af",
                                                "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides : depuis un mois, ils avaient bu de l’eau dans laquelle mijotait ce noyé ; depuis un mois tout le pays s’abreuvait de cette pourriture."
                                            },
                                            {
                                                "example_id": "b905924b-d829-4101-ab07-c20fb4507b68",
                                                "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                                "text": "Sa voisine avait le hoquet. Ce fut d’abord un hoquet discret, qui se contentait de soulever à coups réguliers sa poitrine, comme si son cœur lui aussi eût sonné midi, mais il éclata bientôt comme un sanglot, et il semblait que la vue du potage éveillât en elle des souvenirs désespérés."
                                            },
                                            {
                                                "example_id": "6815abfd-01a8-4ba0-b6d6-c360e6099b1e",
                                                "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                                "text": "« Il faudrait peut-être le faire dégueuler », dit-il.\nHonoré emporta son garçon dans la cour pour lui mettre un doigt dans la gorge. Le bruit des hoquets, puis de la coulée de délivrance, arriva jusque sur la table."
                                            },
                                            {
                                                "example_id": "3d2b5778-5149-4166-9239-dc8324b76909",
                                                "sense_id": "7ab4d15d-8e99-3826-acce-6e754198d9d0",
                                                "text": "Quand Djahane réprime un hoquet, manquant de s’étrangler, la cour entière, monarque en tête, part d’un rire franc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0322ad0-9402-303d-bef3-619f78c61a30",
                                        "entry_id": "e37a08de-9795-3996-91d7-57bc0d54218e",
                                        "glosses": [
                                            "Empêchement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6d65b01-2c59-4d78-8419-bf34683bef7e",
                                                "sense_id": "a0322ad0-9402-303d-bef3-619f78c61a30",
                                                "text": "M. de Retz se disposa à se faire recevoir au parlement ; il y trouva un hoquet auquel il n'avait pas lieu de s'attendre ; son habit fut contesté par les magistrats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
