                        "entry_id": "22aefeff-bd6e-386a-b36d-03322a8897e4",
                        "glosses": [
                            "Jurist, der sich mit dem Verfassungsrecht beschäftigt, auf das Verfassungsrecht als Fachgebiet spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00dc45bb-e173-4fd6-9792-e902e61c5fc9",
                                "sense_id": "d915ed1c-aa4b-3ad7-9504-86514b8cc2da",
                                "text": "„Sie galten einmal als die drei großen Verfassungsrechtler ihrer Generation.“"
                            },
                            {
                                "example_id": "03827678-9170-4949-9bd5-cc0e56554233",
                                "sense_id": "d915ed1c-aa4b-3ad7-9504-86514b8cc2da",
                                "text": "„Kube gilt als einer der angesehensten Verfassungsrechtler der Republik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
