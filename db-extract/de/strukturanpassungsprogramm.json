                "senses": [
                    {
                        "sense_id": "e6f0bc18-47bd-387d-af33-f2588388f07d",
                        "entry_id": "baf22142-f136-3b14-824a-70d1eae9ef5b",
                        "glosses": [
                            "wirtschaftliche Maßnahmen (meist in Entwicklungsländern), die vom Internationalen Währungsfonds (IWF) und der Weltbank als Bedingung für Kreditvergabe oder Schuldenerlass verlangt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50beda1-67d0-4d2e-95a8-36b97c8d32ff",
                                "sense_id": "e6f0bc18-47bd-387d-af33-f2588388f07d",
                                "text": "„Er hat ideologische Bekenntnisse aufgegeben und seine politische Richtung mehrfach geändert: In den 1970er und 1980er Jahren bekannte er sich zum Marxismus-Leninismus, dann machte er eine Kehrtwende und akzeptierte 1991 ein neoliberales Strukturanpassungsprogramm des Internationalen Währungsfonds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
