                    "sense_id": "942206c2-0906-3b97-9c00-39efbac30b5a",
                    "sense_definition": "British, Canadian, Commonwealth, and Ireland standard spelling of <w>honor</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spelling_variant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Honour</w>! I would never do such a deceitful thing to a friend.",
                            "target_lang_translations": {
                                "ru": "<w>Честное слово</w>! Я бы никогда не поступил так лживо с другом.",
                                "tr": "<w>Namusum üzerine yemin ederim</w>! Bir arkadaşıma asla böyle alçakça bir şey yapmam."
                            }
                        },
                        {
                            "text": "By my <w>honour</w>! That was the most impressive display of skill I have ever seen.",
                            "target_lang_translations": {
                                "ru": "Клянусь своей <w>честью</w>! Это была самая впечатляющая демонстрация мастерства, которую я когда-либо видел.",
                                "tr": "<w>Şerefim üzerine</w>! Bu şimdiye kadar gördüğüm en etkileyici beceri gösterisiydi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Canadian, Commonwealth, and Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для подтверждения правдивости или выражения удивления.",
                        "tr": "Doğruluğu teyit etmek veya yemin etmek için kullanılan bir ünlem."
                    },
