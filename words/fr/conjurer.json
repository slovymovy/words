{
    "word_family": [
        "conjuration",
        "conjurateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb4924b5-a765-3ad8-9177-d32c49304ff7",
                    "sense_definition": "Détourner ou écarter un malheur, une menace ou un mauvais sort par la prudence, l'action ou la volonté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecarter_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a pris des mesures d'urgence pour <w>conjurer</w> la crise économique naissante."
                        },
                        {
                            "text": "Pour <w>conjurer</w> le sort, elle touchait toujours du bois avant d'entrer sur la scène."
                        }
                    ],
                    "synonyms": [
                        "écarter",
                        "détourner",
                        "prévenir",
                        "exorciser"
                    ],
                    "antonyms": [
                        "provoquer",
                        "attirer"
                    ],
                    "common_phrases": [
                        "conjurer le sort",
                        "conjurer le mauvais sort",
                        "conjurer le danger",
                        "conjurer la crise"
                    ]
                },
                {
                    "sense_id": "a8eefa5c-05ef-36bd-9c2b-a65b78b2484f",
                    "sense_definition": "Prier ou supplier quelqu'un avec une extrême insistance et solennité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supplier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous en <w>conjure</w>, ne prenez aucune décision hâtive avant d'avoir lu mon rapport."
                        },
                        {
                            "text": "Le vieil homme <w>conjura</w> ses enfants d'arrêter cette querelle inutile."
                        }
                    ],
                    "synonyms": [
                        "supplier",
                        "implorer",
                        "adjurer"
                    ],
                    "antonyms": [
                        "ordonner",
                        "exiger"
                    ],
                    "common_phrases": [
                        "je vous en conjure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "souvent employé à la forme je vous en conjure"
                        }
                    ]
                },
                {
                    "sense_id": "a0462656-8e13-3f61-a758-b36a74a63cff",
                    "sense_definition": "Chasser ou neutraliser des démons, des esprits ou des forces occultes au moyen de rituels ou de formules magiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre commença les prières rituelles pour <w>conjurer</w> les démons qui hantaient la demeure."
                        },
                        {
                            "text": "Autrefois, les villageois croyaient pouvoir <w>conjurer</w> les mauvais esprits grâce à des amulettes."
                        }
                    ],
                    "synonyms": [
                        "exorciser",
                        "chasser"
                    ],
                    "antonyms": [
                        "invoquer"
                    ],
                    "common_phrases": [
                        "conjurer les démons",
                        "conjurer les esprits"
                    ]
                },
                {
                    "sense_id": "4e5a9a6e-5a8a-3c02-8530-d6c7fb2c0a21",
                    "sense_definition": "Former une ligue secrète ou comploter contre une autorité, une institution ou une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs officiers rebelles ont secrètement <w>conjuré</w> contre le pouvoir en place pour le renverser."
                        },
                        {
                            "text": "Les sénateurs hostiles à la dictature <w>conjuraient</w> dans l'ombre depuis plusieurs mois."
                        }
                    ],
                    "synonyms": [
                        "conspirer",
                        "comploter"
                    ],
                    "common_phrases": [
                        "conjurer contre le pouvoir"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "sens littéraire ou historique"
                        }
                    ]
                }
            ]
        }
    ]
}