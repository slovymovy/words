                "senses": [
                    {
                        "sense_id": "97151c54-4623-3c25-8be0-40e43cf2897b",
                        "entry_id": "37458e70-287d-3d73-a057-c5f34bc53ff8",
                        "glosses": [
                            "Diminution graduelle d’une partie des éléments d’une substance ou d’un corps."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "93de564d-835d-4335-ba5a-f1f41e3176dd",
                                "sense_id": "97151c54-4623-3c25-8be0-40e43cf2897b",
                                "text": "déperdition de chaleur, de lumière."
                            },
                            {
                                "example_id": "349f7bb6-927d-46e9-85c2-7f2606842123",
                                "sense_id": "97151c54-4623-3c25-8be0-40e43cf2897b",
                                "text": "déperdition de forces à la suite d’une maladie."
                            },
                            {
                                "example_id": "956da5bd-8d84-4de3-8bc1-ff6e9a917774",
                                "sense_id": "97151c54-4623-3c25-8be0-40e43cf2897b",
                                "text": "En admettant donc que les engrais fertilisent le sol en suppléant à la déperdition des matières azotées contenues dans les débris végétaux qui s'épuisent, débris renfermés dans le sol, on peut poser le principe fondamental suivant : « […] »."
                            },
                            {
                                "example_id": "def3f2e3-a423-405e-b2fd-1b818f3c4ad8",
                                "sense_id": "97151c54-4623-3c25-8be0-40e43cf2897b",
                                "text": "Il y a aussi une déperdition importante des éléments minéraux qui sont hydrosolubles."
                            }
                        ]
                    }
                ],
