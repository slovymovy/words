                "senses": [
                    {
                        "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                        "entry_id": "6c16660d-cb5a-31aa-9278-51cceecbdc56",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39b45efb-d363-4849-8cd5-f4539dc7273a",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Frau Kleeberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4987379c-2c2f-4e1b-8c2f-b84e12786507",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Herr Kleeberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4edf2a16-ded9-4f0e-b4de-02288308d5c8",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Die Kleebergs fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "6235ebee-bdf4-46d8-9561-53db346ecdc0",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Der Kleeberg trägt nie die Pullover, die die Kleeberg ihm strickt."
                            },
                            {
                                "example_id": "bdf4697f-6c71-45a6-ae26-4ae2a8a43706",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kleeberg kommt, geht der Herr Kleeberg.“"
                            },
                            {
                                "example_id": "4c4833e7-16af-4024-8822-b8347f069ea7",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Kleeberg kommt und geht."
                            },
                            {
                                "example_id": "828eb1c3-f28b-4c03-bd42-8100f288205a",
                                "sense_id": "7aed1d3b-7092-308c-a13d-f982674aca4e",
                                "text": "Kleebergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
