                            {
                                "example_id": "4a9fadaf-e0ad-4c68-8841-90d42c9a0f86",
                                "sense_id": "6b01fd64-b773-3fb7-b091-f2bc84f91a54",
                                "text": "Ingolstadt ist eine kreisfreie Stadt an der Donau."
                            },
                            {
                                "example_id": "c08d3eb6-8b2f-4683-bb90-98d0422e5238",
                                "sense_id": "6b01fd64-b773-3fb7-b091-f2bc84f91a54",
                                "text": "Das Ingolstadt des 18. Jahrhunderts bildet die Kulisse für „Frankenstein“."
                            },
                            {
                                "example_id": "0d8e1eb9-c5dd-466c-9aea-8cde3bd5061b",
                                "sense_id": "6b01fd64-b773-3fb7-b091-f2bc84f91a54",
                                "text": "„Den Einstieg in das Audi-Q-niversum bildet allerdings der kleine Q1, der womöglich schon 2015 vorgestellt wird. Er basiert auf der Kleinwagen-Plattform des Konzerns, wird aber nicht in Tschechien, sondern in Ingolstadt gefertigt.“"
                            }
                        ],
