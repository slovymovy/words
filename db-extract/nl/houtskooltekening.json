                        "examples": [
                            {
                                "example_id": "2184a970-63fd-4e11-aba7-fb820d16cb20",
                                "sense_id": "e6be5981-fc63-3c48-9472-cb5f24cbf2b5",
                                "text": "De avond was droog als een houtskooltekening."
                            },
                            {
                                "example_id": "84c03df8-bb1a-4853-8f61-b2b7254bd8d1",
                                "sense_id": "e6be5981-fc63-3c48-9472-cb5f24cbf2b5",
                                "text": "De Vereniging Rembrandt hoopt dat een topstuk uit de privécollectie van de koninklijke famile niet naar een koper in het buitenland gaat. De houtskooltekening, een voorstudie van één van Rubens' beroemdste werken, wordt deze maand geveild in New York, met een geschatte opbrengst van zo'n 3 miljoen euro. Directeur Fusien Bijl de Vroe: \"Natuurlijk wil je dat het in Nederland blijft, het is een ontzettend belangrijk werk\"."
                            },
                            {
                                "example_id": "ddca51ec-d2b9-44bb-b431-35268e71a676",
                                "sense_id": "e6be5981-fc63-3c48-9472-cb5f24cbf2b5",
                                "text": "In de grotten van Maastricht wordt deze week de laatste hand gelegd aan de restauratie van een honderd jaar oude replica van de Nachtwacht. Een houtskooltekening, gemaakt door Jules Sondeijker."
                            }
                        ]
                    }
