                    {
                        "form_id": "ff4a25d6-7a44-4ca7-8f84-22501e38e1ed",
                        "entry_id": "ade22adf-a9ae-3a35-a764-71999462ac77",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "разузна́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7544a824-9c98-339d-9905-9bf8f9a498c5",
                        "entry_id": "ade22adf-a9ae-3a35-a764-71999462ac77",
                        "glosses": [
                            "разг. собрать, получить сведения, известия о ком-либо, чём-либо, узнать, выведать в подробностях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9895a26e-7b47-4677-b410-11b21ce5ad7b",
                                "sense_id": "7544a824-9c98-339d-9905-9bf8f9a498c5",
                                "text": "Я вам это дело всё до мелочей разузнаю."
                            },
                            {
                                "example_id": "b2a7366a-ab13-4745-aa90-cda62a5459cb",
                                "sense_id": "7544a824-9c98-339d-9905-9bf8f9a498c5",
                                "text": "Надо о нём разузнать как следует."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d3196b9-a17e-4b87-a5e6-a0ac7fc50f04",
                        "source_entry_id": "ade22adf-a9ae-3a35-a764-71999462ac77",
                        "source_sense_id": "7544a824-9c98-339d-9905-9bf8f9a498c5",
                        "target_lang_word": "find out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "find out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover, as by asking or investigating."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d41972-c2be-429a-8700-fb5fbc415413",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I don't know who the twenty-first president of the United States was, but it should be very easy to find out."
                                            },
                                            {
                                                "example_id": "17479836-6c47-456a-882d-d626c2402730",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "\"Why shouldn't somethin' new and wonderful lie in such a country? And why shouldn't we be the men to find it out?\""
                                            },
                                            {
                                                "example_id": "2698d7f2-9c46-4811-99a8-452e180fa116",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "Somethin' happens when everybody finds out\nSee the vultures circling, dark clouds"
                                            },
                                            {
                                                "example_id": "b5779327-7631-4b2d-8526-b5842c554fbe",
                                                "sense_id": "4a91e8c8-efb6-334b-999b-65454fd2e6ac",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover or expose (someone) as disobedient, dishonest, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168f191d-6882-4262-a319-40a2b21fd1cf",
                                                "sense_id": "1d705c22-1c22-339c-9b77-3db0a7bb9200",
                                                "text": "He had been fiddling the books for years, but finally he was found out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To uncover a weakness in (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7a0f06-075b-446e-90ad-f31d91d112dd",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "He may cope with the multiple choice questions, but the written exam will find him out."
                                            },
                                            {
                                                "example_id": "7f7cf588-e8e4-4a32-8946-dad5dd8b0b78",
                                                "sense_id": "ebe236b6-473e-35ea-8103-842c15884f70",
                                                "text": "If you don't try, you do not find it out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810bfa98-4168-3a61-9601-b446cfb557a3",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To discover (something), as by perceiving or coming upon it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                        "entry_id": "7e59c482-549e-33e6-8e44-1821ac172fc7",
                                        "glosses": [
                                            "To receive the consequences of one's actions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf557d0e-8915-420a-a72e-49f603f56375",
                                                "sense_id": "ac9be373-eebd-37fd-882b-97c21dcbc809",
                                                "text": "With the way he behaved, it's no wonder he found out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e338a1a-ea07-4da8-b2e0-018914809e41",
                        "source_entry_id": "ade22adf-a9ae-3a35-a764-71999462ac77",
