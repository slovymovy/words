                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5afb9c17-f593-4553-bb20-9814adcdb3ec",
                                                "sense_id": "f0d7dc67-7b03-3cb7-8387-6e195d30ee46",
                                                "text": "France and Spain are bordering nations."
                                            },
                                            {
                                                "example_id": "08459a1a-8be0-487e-a2bf-372330a64f12",
                                                "sense_id": "f0d7dc67-7b03-3cb7-8387-6e195d30ee46",
                                                "text": "King Pyrrhus was at dinner at an ale-house bordering on the theatre, when he was summoned to go on the stage."
                                            }
