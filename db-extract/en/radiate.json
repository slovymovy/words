                                "target_senses": [
                                    {
                                        "sense_id": "0c0fd898-a3f8-3ce2-ad7f-7e74cdfd9e01",
                                        "entry_id": "c665ecf3-2881-3228-8a8f-8dc204933fe7",
                                        "glosses": [
                                            "elektromagnetische oder radioaktive Strahlung emittieren oder reflektieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08451a73-7c58-4511-858b-d8d06011b776",
                                                "sense_id": "0c0fd898-a3f8-3ce2-ad7f-7e74cdfd9e01",
                                                "text": "Der Atommüll, den wir heute produzieren, wird noch hunderttausende von Jahren strahlen."
                                            },
                                            {
                                                "example_id": "b9899238-f017-479d-81a8-46d52f7a5c10",
                                                "sense_id": "0c0fd898-a3f8-3ce2-ad7f-7e74cdfd9e01",
                                                "text": "[Fukushima:] „Straßen und Orte wurden gereinigt und freigegeben, obwohl die Erde immer noch strahlte.“"
                                            },
                                            {
                                                "example_id": "7a535202-29a8-4ada-858c-ada3e80d4ac3",
                                                "sense_id": "0c0fd898-a3f8-3ce2-ad7f-7e74cdfd9e01",
                                                "text": "Röntgen war verblüfft: Das Glas war weiter entfernt, als die Kathodenstrahlung eigentlich reichen sollte, und selbst wenn er zwischen die Kathode und das Glas ein Kohlepapier oder ein Holzbrettchen hielt, strahlte das Glas doch weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b818e43e-a3dd-3fca-8aee-1429ed2cc596",
                                        "entry_id": "c665ecf3-2881-3228-8a8f-8dc204933fe7",
                                        "glosses": [
                                            "einen glücklichen, erfreuten Gesichtsausdruck haben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7938696-ce46-414c-8be5-5368506d8af8",
                                                "sense_id": "b818e43e-a3dd-3fca-8aee-1429ed2cc596",
                                                "text": "So wie du strahlst gibt es wohl gute Neuigkeiten?"
                                            },
                                            {
                                                "example_id": "1243b3b7-543a-490b-8dad-7ef78e375ae6",
                                                "sense_id": "b818e43e-a3dd-3fca-8aee-1429ed2cc596",
                                                "text": "Dem Prinzen gelang es nicht auf Anhieb, seiner Gemahlin den Trauring auf den Finger zu stecken. Trotz der kleinen Panne strahlte die Prinzessin über das ganze Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
