                                        "entry_id": "96a1a2ed-6f05-35fc-860d-5bb5de21ab2f",
                                        "glosses": [
                                            "körpereigener Botenstoff, der als Stresshormon und Neurotransmitter wirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dcf8e13-9406-437f-934f-4bfd716f401f",
                                                "sense_id": "2ab1a635-8261-3280-be10-e19e1820786e",
                                                "text": "„Dopamin und Noradrenalin heißen die Neurotransmitter, nach denen das Kokain verrückt ist und von denen es nicht lassen kann.“"
                                            }
