                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bottom of the old wooden boat was completely covered in sharp <w>barnacles</w>.",
                            "target_lang_translations": {
                                "ru": "Дно старой деревянной лодки было полностью покрыто острыми <w>морскими уточками</w>."
                            }
                        },
                        {
                            "text": "Marine biologists studied how <w>barnacles</w> attach themselves to rocks in the intertidal zone.",
                            "target_lang_translations": {
                                "ru": "Морские биологи изучали, как <w>балянусы</w> прикрепляются к скалам в приливно-отливной зоне."
                            }
                        }
                    ],
                    "common_phrases": [
