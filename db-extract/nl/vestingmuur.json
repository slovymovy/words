                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3eb820-8e7d-4711-a736-416a90172693",
                                "sense_id": "38c417fb-24ee-376b-981c-5b025dabcaf5",
                                "text": "Hij had mijn vestingmuur geramd en zich er bovendien goed voor laten betalen."
                            },
                            {
                                "example_id": "5d4a2fe6-5a2d-493f-9dcb-e7563ffa4ce6",
                                "sense_id": "38c417fb-24ee-376b-981c-5b025dabcaf5",
                                "text": "Voor de stichting is het geen probleem dat Waterkasteel De Kemphaan geen eeuwen oud is, maar slechts 18 jaar. Het gebouw heeft genoeg bepalende kenmerken, zoals een ridderzaal, een slotgracht, een kasteeltuin met oranjerie, een brouwerij, een doolhof en een gang aan de binnenkant van een vestingmuur (weergang)."
                            }
                        ]
                    }
