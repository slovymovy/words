                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                        "entry_id": "7cd04b50-5c2d-3464-a111-829f87c5bb56",
                        "glosses": [
                            "geneigd verdenking te koesteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4151ef76-ddb0-435b-ae1d-a97b57ffc2c4",
                                "sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                                "text": "Hij is de achterdochtigste kerel die ik ken."
                            },
                            {
                                "example_id": "3eee70e4-4d43-4934-8f6c-25aff1b229a4",
                                "sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                                "text": "Iemand die ziekelijk achterdochtig is noemen we paranoïde."
                            },
                            {
                                "example_id": "b0aaaa9b-0dee-4bde-bc1e-6192de158cdf",
                                "sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                                "text": "Sarah glimlachte. 'Verstandig. Volgens mij zou iedereen een stuk gelukkiger zijn als we allemaal waren zoals u. Ik kom wel naar u toe. Je weet nooit precies wanneer Harold thuis is, en ik wil niet dat hij achterdochtig wordt.'"
                            },
                            {
                                "example_id": "ca37bbc6-46ed-4e11-bc78-17bfb6c735a0",
                                "sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                                "text": "' Als mensen gaan vertellen hoe geweldig hun partner is, word ik altijd wat achterdochtig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1f18f3c-9aeb-4429-843b-8ab19dba97fd",
                        "source_entry_id": "7cd04b50-5c2d-3464-a111-829f87c5bb56",
                        "source_sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                        "target_lang_word": "suspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Arousing suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa35fb88-2a10-4050-ac80-f679bdbafeff",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "His suspicious behaviour brought him to the attention of the police."
                                            },
                                            {
                                                "example_id": "27a8111f-9f4a-4205-9372-e2404ba097b3",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "If their views were entrancing their sanitation was primeval; if they possessed stables they were also next to the gas-works; if their gardens were delightful there were odours suspicious of mice in the bedrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Distrustful or tending to suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3193b015-3423-4083-a9da-ef80353812ab",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "We know he has a suspicious attitude to get-rich-quick schemes."
                                            },
                                            {
                                                "example_id": "dbd8c4d7-ff77-4d72-bdc0-98c2d27eee70",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Expressing suspicion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6586499-bdf0-4296-a6aa-3e12479378d1",
                                                "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                                "text": "She gave me a suspicious look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1800b6df-dc72-476d-a212-d1fd9403dab5",
                        "source_entry_id": "7cd04b50-5c2d-3464-a111-829f87c5bb56",
                        "source_sense_id": "4b5e89db-92fa-330d-83a5-d86a8c66d22d",
                        "target_lang_word": "soupçonneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soupçonneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                        "entry_id": "2e28323b-1392-3bc5-aa2d-eb8fb2fc3539",
                                        "glosses": [
                                            "Qui est défiant, qui est enclin à soupçonner, qui soupçonne facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72dcff8c-4d81-4049-9b9c-feaf0a6d569c",
                                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                                "text": "Un seul amant, c’est ennuyeux,\nC’est monotone et soupçonneux,\nTandis que deux c’est vraiment mieux."
                                            },
                                            {
                                                "example_id": "1b31b7ab-05f8-4d51-a99b-d4159fce7a3b",
                                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                                "text": "Tout son être se révoltait à la pensée d'épouser un de […] ces intendants soupçonneux et méprisants qui venaient parfois rendre visite à son grand-père et la soupesaient des yeux, comme si elle eût été un animal à vendre."
                                            },
                                            {
                                                "example_id": "b4132cef-2664-42c2-a687-4ab557f9d5bc",
                                                "sense_id": "85c6fcfa-1984-322f-9467-1809fb0cda08",
                                                "text": "— Être d’humeur soupçonneuse, d’un caractère soupçonneux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
