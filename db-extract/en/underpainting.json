                        "entry_id": "386563e1-abcc-3397-9061-839346cdd2fb",
                        "glosses": [
                            "A painting that the artist later painted over to create the final work."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
