                        "cross_references": [
                            {
                                "target_word": "duck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8cfa51c-6ea6-3b15-bc2b-7fc247f77543",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To quickly lower (the head or body), often in order to prevent it from being struck by something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e220e1-56b9-4e8f-beeb-862c25afcec7",
                                                "sense_id": "c8cfa51c-6ea6-3b15-bc2b-7fc247f77543",
                                                "text": "As some raw youth in country bred,\nTo arms by thirst of honour led,\nWhen at a skirmish first he hears\nThe bullets whistling round his ears,\nWill duck his head aside"
                                            },
                                            {
                                                "example_id": "99319756-d420-4845-823e-58756de4a6d9",
                                                "sense_id": "c8cfa51c-6ea6-3b15-bc2b-7fc247f77543",
                                                "text": "Rimmer ducked his body low into his chair, so just his head remained above the table top, and peered past the backs of the examinees in front of him, waiting for the adjudicator to make his move."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01fb3f30-f018-351f-88ad-0213c4a89bc4",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To lower (something) into water; to thrust or plunge under liquid and suddenly withdraw."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "879acd80-b22e-4b6e-8479-a5e262dd96b4",
                                                "sense_id": "01fb3f30-f018-351f-88ad-0213c4a89bc4",
                                                "text": "Adams after ducking the Squire tvvice or thrice leaped out of the Tub, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c491b20a-ba36-3ebf-98bf-d58a7ee1532c",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To go under the surface of water and immediately reappear; to plunge one's head into water or other liquid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "062c6fd3-122e-43bf-8a66-d8613e5d67c6",
                                                "sense_id": "c491b20a-ba36-3ebf-98bf-d58a7ee1532c",
                                                "text": "[…]In Tiber ducking thrice, by break of day[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a529b749-6248-32b7-80db-6d819c8fb50c",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To bow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61862c10-410a-4a46-87cc-4768b73451e8",
                                                "sense_id": "a529b749-6248-32b7-80db-6d819c8fb50c",
                                                "text": "The Learned pate / Duckes to the Golden Foole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d9b290a-5a8a-3bd9-9b16-742fcf3bdb99",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To evade doing something, especially something considered a responsibility."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41dcb614-7a7e-4318-9242-4b37a989c716",
                                                "sense_id": "2d9b290a-5a8a-3bd9-9b16-742fcf3bdb99",
                                                "text": "Victorian women choosing to duck the demands of domestic life to spend their time doing something they enjoyed is hardly a novel idea."
                                            },
                                            {
                                                "example_id": "16919f50-234c-46a2-b8f1-94ba0f6493e8",
                                                "sense_id": "2d9b290a-5a8a-3bd9-9b16-742fcf3bdb99",
                                                "text": "But pressed by Labour's Marsha de Cordov in the House of Commons on June 29, on \"whether he plans to reduce the total number of ticket offices\", Merriman ducked the question but confirmed that the Government wants to close ticket offices."
                                            },
                                            {
                                                "example_id": "ecbee037-7504-4f7b-8136-349e0b95240d",
                                                "sense_id": "2d9b290a-5a8a-3bd9-9b16-742fcf3bdb99",
                                                "text": "That was the moment, but Senate Republicans ducked it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdd8846-05dc-3c05-9710-445839672184",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To lower the volume of (a sound) so that other sounds in the mix can be heard more clearly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d3ebe0-7642-4e45-aeee-0911bd3cbd61",
                                                "sense_id": "ccdd8846-05dc-3c05-9710-445839672184",
                                                "text": "The music is ducked under the voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0d96c43-ad26-3a27-b240-410b44c84093",
                                        "entry_id": "01b40fad-5620-3e8b-bba5-ff435212a4c1",
                                        "glosses": [
                                            "To enter a place for a short moment."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
