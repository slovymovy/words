                {
                    "sense_id": "31eb45b5-84f3-384f-9c09-913b6b604b76",
                    "sense_definition": "Miękkie drewno pozyskiwane z drzewa lipowego, cenione w rzeźbiarstwie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artysta wybrał miękką <w>lipę</w>, aby wyrzeźbić z niej precyzyjne detale figurki.",
                            "target_lang_translations": {
                                "ru": "Художник выбрал мягкую <w>липу</w>, чтобы вырезать из нее точные детали фигурки.",
                                "en": "The artist chose soft <w>linden wood</w> to carve the precise details of the figurine."
                            }
                        },
                        {
                            "text": "Stół wykonany z <w>lipy</w> jest lekki, ale wymaga odpowiedniej konserwacji.",
                            "target_lang_translations": {
                                "ru": "Стол, сделанный из <w>липы</w>, легкий, но требует соответствующего ухода.",
                                "en": "A table made of <w>linden wood</w> is light but requires proper maintenance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rzeźbić w lipie",
                        "drewno z lipy"
