                "senses": [
                    {
                        "sense_id": "13aff7f1-ac78-34ff-ba7d-9461be48289a",
                        "entry_id": "146f0de7-6e93-3e89-b1c9-dcaf2f90ba27",
                        "glosses": [
                            "Text(stelle) der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "646a5e3a-e8b5-41e7-b453-fe1230238736",
                                "sense_id": "13aff7f1-ac78-34ff-ba7d-9461be48289a",
                                "text": "„In früherer Zeit war es maßgebende Ansicht, daß man vom Bibeltexte durchgehends absehen und durch freiere Umschreibungen und Schilderungen die biblischen Wahrheiten und Thatsachen dem Kinde zugänglich machen müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a278b60-db3e-4c54-92c0-06c322d0e386",
                        "source_entry_id": "146f0de7-6e93-3e89-b1c9-dcaf2f90ba27",
                        "source_sense_id": "13aff7f1-ac78-34ff-ba7d-9461be48289a",
                        "source_sense_description": "Text(stelle) der Bibel",
                        "target_lang_word": "Écritures",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Écritures",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad5e1c5-8d9f-3da0-9575-c68eee3fe279",
                                        "entry_id": "c6ee524a-32fd-3a2f-a480-577d376729c4",
                                        "glosses": [
                                            "La Bible hébraïque (l’Ancien Testament des chrétiens)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42d8f430-d041-4d8e-b352-6985f550d51f",
                                                "sense_id": "6ad5e1c5-8d9f-3da0-9575-c68eee3fe279",
                                                "text": "Les Juifs le leur enseignent, car les Écritures avaient clairement désigné Bethléem comme le berceau du Messie, et les Juifs qui possédaient la science des livres saints ne s’y trompent pas."
                                            },
                                            {
                                                "example_id": "8222708d-c526-4b80-a3e9-73e7ff0e630f",
                                                "sense_id": "6ad5e1c5-8d9f-3da0-9575-c68eee3fe279",
                                                "text": "Nous pensons aussi explorer les Saintes Écritures rédigées par les prophètes qui parlent du chemin de justice ouvert par Dieu pour que l’homme puisse être regardé comme juste devant lui."
                                            },
                                            {
                                                "example_id": "de906077-d4cb-48e3-9e4b-c6c8a08904db",
                                                "sense_id": "6ad5e1c5-8d9f-3da0-9575-c68eee3fe279",
                                                "text": "Mais qui es-tu pour croire que tu peux parler des Écritures ! Qui es-tu pour donner des conseils aux autres ? As-tu fait une école rabbinique ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c84974-0270-35e1-b742-3ac31bf8652e",
                                        "entry_id": "c6ee524a-32fd-3a2f-a480-577d376729c4",
                                        "glosses": [
                                            "La Bible, contenant l’Ancien Testament et le Nouveau Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e9f194-7355-4a31-b702-1e1ca282479f",
                                                "sense_id": "e6c84974-0270-35e1-b742-3ac31bf8652e",
                                                "text": "L'Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour “monachiser” ses clercs séculiers et les détacher de la femme tentatrice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
