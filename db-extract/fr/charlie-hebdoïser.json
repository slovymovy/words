                "senses": [
                    {
                        "sense_id": "ed8ac48b-02ca-3c45-975e-0b243632958c",
                        "entry_id": "ed8c476b-18f0-31ba-8db2-6c5267bfbbba",
                        "glosses": [
                            "Donner à quelque chose un caractère rappelant la revue Charlie Hebdo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd382c5-3456-45d9-857f-65b6c80917b7",
                                "sense_id": "ed8ac48b-02ca-3c45-975e-0b243632958c",
                                "text": "Media: Concurrence charlie-hebdoïsée."
                            },
                            {
                                "example_id": "e3a459ba-4c8a-4226-b833-301ba3ea1d64",
                                "sense_id": "ed8ac48b-02ca-3c45-975e-0b243632958c",
                                "text": "Devant le refus de la machine face à la divinité, qui telle le paria ose défier les forces de Krishna, celles si justement représentées par les océans de sagesse de la tradition brahmanique, il me faut couper, réduire, dévaluer, charlie-hebdoïser, profaniser, matérialiser, cacaïser, prout-proutiser... à regrets vous le devinez bien ..."
                            },
                            {
                                "example_id": "3a353e02-669f-48b8-b6cc-83fd125174ab",
                                "sense_id": "ed8ac48b-02ca-3c45-975e-0b243632958c",
                                "text": "Alors, pour rigoler un peu (parce que c'est ça dont il s'agit), moi aussi je veux me \"charlie-hebdoïser\"."
                            }
                        ]
                    }
