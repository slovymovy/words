                    {
                        "translation_id": "22f5dbb9-df1f-4084-be0f-43bc7c9a8095",
                        "source_entry_id": "a5b9a34e-aeb8-3542-9a00-3b512dede185",
                        "source_sense_description": "term of endearment",
                        "target_lang_word": "Kosename",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosename",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                        "entry_id": "63ef1bb9-07c1-3e05-9918-426fafe2e09d",
                                        "glosses": [
                                            "liebevolle Namen für Menschen, die man mag, liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af18355a-0b9f-4d0f-b7d0-9659d3350158",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "Ich gebe meiner Frau Kosenamen."
                                            },
                                            {
                                                "example_id": "feb698fb-2c9c-4ca4-b03d-59790290a6d3",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "„Stark gefühlsbetonte Äußerungen, dazu zählen Flüche, Beschimpfungen, Spott- und Spitznamen, aber auch Kosenamen, sind in einer Fremdsprache nicht leicht zu handhaben.“"
                                            },
                                            {
                                                "example_id": "f7c5645d-83d7-49a5-8b48-baf9be714069",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "„Die Spott- oder Kosenamen waren Legion.“"
                                            },
                                            {
                                                "example_id": "40e72e84-5ee2-4dac-a45e-0e651d8174e2",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "„Doch mit einem einzigen Kosenamen ist es nicht getan.“"
                                            },
                                            {
                                                "example_id": "a9f96f36-20e6-412f-9fa1-5468ceb56f86",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "„Man sah zu ihm empor, die einen salutierten, die andern brüllten Kosenamen hinauf und wieder anderen war das Herz so voll, daß sie nur noch drohend die Faust nach oben schütteln konnten.“"
                                            },
                                            {
                                                "example_id": "7b9d5675-d395-4167-ae2b-73e2b61a717a",
                                                "sense_id": "6e712fed-cd92-3dc3-bb77-8f2d9a86a1c9",
                                                "text": "„Es ist, als habe dieser vom Manne fast nie benutzte Kosename die Frau aus der Welt ihres Schmerzes in dieses Leben zurückgerufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d025b5fe-4be0-4cb7-a5c6-eb8f7b7cb484",
                        "source_entry_id": "a5b9a34e-aeb8-3542-9a00-3b512dede185",
