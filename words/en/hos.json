                        {
                            "trait_type": "colloquial",
                            "comment": "African American Vernacular English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «ho» (сленговое, часто уничижительное обозначение проститутки или распутной женщины).",
                        "tr": "\"Ho\" kelimesinin çoğul hali (argo, fahişe veya hafifmeşrep kadınlar için kullanılan aşağılayıcı bir ifade)."
                    },
                    "translations": {
