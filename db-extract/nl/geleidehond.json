                "senses": [
                    {
                        "sense_id": "ddb3f89b-be4e-31cf-9c40-0c0a42903bd1",
                        "entry_id": "acaf6ba8-837c-3192-b49a-da51353504f0",
                        "glosses": [
                            "een hond die is afgericht om blinde en slechtziende mensen te helpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b776a2b-3c4e-408f-a680-64d3161002a7",
                                "sense_id": "ddb3f89b-be4e-31cf-9c40-0c0a42903bd1",
                                "text": "Radicaal anders geven aan goede doelen. Dat bepleit de Australische filosoof Peter Singer, voorvechter van de effective altruism-beweging. Het komt er kort gezegd op neer dat u, als u 30.000 euro te geven heeft, dit beter aan kinderen in Azië met een trachoom dan aan de opleiding van een blindengeleidehond kunt besteden."
                            },
                            {
                                "example_id": "f2af337b-d594-4953-b959-91a6a1bf4634",
                                "sense_id": "ddb3f89b-be4e-31cf-9c40-0c0a42903bd1",
                                "text": "Een 65-jarige man uit Waddinxveen is zondagavond dood aangetroffen op de Ommeslag in Gouda. Volgens de politie is hij door een ongeval met zijn fiets om het leven gekomen. Een blinde man en zijn geleidehond hebben het slachtoffer gevonden."
                            }
                        ]
                    }
                ],
