                {
                    "sense_id": "42ed0b1b-6a94-3ea5-bae8-fa453a66bb82",
                    "sense_definition": "Het proces van het bouwen, maken of inrichten van iets groots, zoals een weg, park of gebouw.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>aanleg</w> van de nieuwe snelweg zorgde voor veel verkeershinder.",
                            "target_lang_translations": {
                                "ru": "<w>Строительство</w> новой автомагистрали вызвало серьезные затруднения движения.",
                                "en": "The <w>construction</w> of the new highway caused a lot of traffic hindrance.",
                                "pl": "<w>Budowa</w> nowej autostrady spowodowała duże utrudnienia w ruchu drogowym."
                            }
                        },
                        {
                            "text": "Bij de <w>aanleg</w> van de tuin hebben we gekozen voor veel kleurrijke bloemen.",
                            "target_lang_translations": {
                                "ru": "При <w>обустройстве</w> сада мы выбрали много ярких цветов.",
                                "en": "During the <w>laying out</w> of the garden, we chose many colorful flowers.",
                                "pl": "Przy <w>urządzaniu</w> ogrodu postawiliśmy na wiele kolorowych kwiatów."
                            }
                        }
                    ],
                    "synonyms": [
