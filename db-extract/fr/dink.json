                        "entry_id": "2b216d46-9fab-3eef-8288-201dba1fd58d",
                        "glosses": [
                            "Personne en couple, d’environ 25 à 35 ans, sans enfant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83636fa3-4239-40d3-8dc1-7579f3d59355",
                                "sense_id": "f60107d1-6b51-3f29-95c4-50ac6bb18ec0",
                                "text": "Ces actions de promotion visent à toucher en priorité les familles, sur les périodes de vacances scolaires, et les « dinks », les couples sans enfant âgés de 25 à 35 ans."
                            },
                            {
                                "example_id": "2a9001ae-f39c-4f1e-a459-649ac94e00d6",
                                "sense_id": "f60107d1-6b51-3f29-95c4-50ac6bb18ec0",
                                "text": "Léa et son compagnon sont ce que les Anglo-Saxons appellent les « dinks »."
                            }
                        ]
                    }
                ],
