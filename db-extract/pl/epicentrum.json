                    {
                        "sense_id": "e1244aa3-723f-3946-b615-a000a3694526",
                        "entry_id": "363518fd-85ce-38d2-b14c-c294d916728d",
                        "glosses": [
                            "punkt, w którym dane zjawisko występuje w nasilonym stopniu"
