                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4e2b14e-a3ab-440d-8164-d30c29a19241",
                        "source_entry_id": "a56b5616-65e6-3091-a75b-984fe7528a0a",
                        "source_sense_id": "92bbec49-6978-37d7-b0e6-01e7b5bf24f5",
                        "target_lang_word": "glue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6a604e-5aaf-367a-8d19-b62da7475f5a",
                                        "entry_id": "81c25e74-2bd8-3447-8dea-6cd54c55480c",
                                        "glosses": [
                                            "A hard gelatin made by boiling bones and hides, used in solution as an adhesive; or any sticky adhesive substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ddc3d9-7e06-46d2-8ddb-67cebce92469",
                                                "sense_id": "4b6a604e-5aaf-367a-8d19-b62da7475f5a",
                                                "text": "Near-synonyms: adhesive, cement"
                                            },
                                            {
                                                "example_id": "d592b16c-aa77-4219-becd-49a01a5ee34c",
                                                "sense_id": "4b6a604e-5aaf-367a-8d19-b62da7475f5a",
                                                "text": "The wasp has always made the paper from which it constructs its nest, by uniting vegetable fibres with glue, while man was vexing himself with attempts to write on the bark of trees or a waxen or metallic table."
                                            },
                                            {
                                                "example_id": "5d27cfe8-2abb-470a-ba80-073cc5b2a3e6",
                                                "sense_id": "4b6a604e-5aaf-367a-8d19-b62da7475f5a",
                                                "text": "During the next few days, while the meat dried, they were both busy. They finished the bowl boat and coated it with the glue Jondalar made by boiling down the hooves, bone, and hide scraps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91654e2c-f305-34d7-9ee4-c3ffc0c3699d",
                                        "entry_id": "81c25e74-2bd8-3447-8dea-6cd54c55480c",
                                        "glosses": [
                                            "Anything that binds two things or people together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cca69cd0-227d-4722-8cf0-c36c13a5def6",
                                                "sense_id": "91654e2c-f305-34d7-9ee4-c3ffc0c3699d",
                                                "text": "What is a kiss ? Why this, as some approve, / The sure sweet cement, glue, and lime of love."
                                            },
                                            {
                                                "example_id": "f4e1e302-0636-483c-b4a9-39ed540290f1",
                                                "sense_id": "91654e2c-f305-34d7-9ee4-c3ffc0c3699d",
                                                "text": "In other words, the railways are the glue which holds the country together for those without cars, and for those of us who want to get between major cities sustainably and rapidly. The railways are not a 'nice to have extra', but a key component of our infrastructure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdc70b7-ef71-36e2-b7f6-2282fa8c07c2",
                                        "entry_id": "81c25e74-2bd8-3447-8dea-6cd54c55480c",
                                        "glosses": [
                                            "A viscid secretion on the surface of certain plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcca7122-3bc1-3c73-8131-82f4e965b876",
                                        "entry_id": "6d064244-4039-329c-bc44-ed0889ee59ff",
                                        "glosses": [
                                            "To join or attach something using glue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4bd614-06c5-4713-86fb-e31d6490c697",
                                                "sense_id": "fcca7122-3bc1-3c73-8131-82f4e965b876",
                                                "text": "I need to glue the chair-leg back into place."
                                            },
                                            {
                                                "example_id": "955652df-6bf1-4199-8250-945470685266",
                                                "sense_id": "fcca7122-3bc1-3c73-8131-82f4e965b876",
                                                "text": "[…] The flesh [of the mistletoe berry] is sticky, and forms strings and ribbons between my thumb and forefinger. For the mistletoe, this viscous goop – and by the way, viscous comes to English from viscum – is crucial. The stickiness means that, after eating the berries, birds often regurgitate the seeds and then wipe their bills on twigs – leading to the seeds' getting glued to the tree, where they can germinate and begin the cycle anew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                                        "entry_id": "6d064244-4039-329c-bc44-ed0889ee59ff",
                                        "glosses": [
                                            "To cause something to adhere closely to; to cause to follow attentively."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93dafe38-1bc8-46f3-937b-1ba858a34358",
                                                "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                                                "text": "His eyes were glued to the screen."
                                            },
                                            {
                                                "example_id": "0064dcad-1d8c-465a-bba4-52298fcb7236",
                                                "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                                                "text": "So as I lay on the ground with my ear glued close against the wall, who should march round the church but John Trenchard, Esquire, not treading delicately like King Agag, or spying, but just come on a voyage of discovery for himself."
                                            },
                                            {
                                                "example_id": "08e7d1f4-856d-43b9-abaf-003512325d37",
                                                "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                                                "text": "Keep your eyes glued to that set until the station signs off. I can assure you that what you will observe is a vast wasteland."
                                            },
                                            {
                                                "example_id": "b176c556-b008-4dc2-9b5d-6c5649931ed5",
                                                "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                                                "text": "If, like me, you have been confined to your home, glued to the news and nursing ever greater anxiety about the state of the world, you have probably become familiar with the sight of the World Health Organization’s director general, Tedros Adhanom Ghebreyesus, and his daily press briefings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f1fd01-c827-3c5a-bcc7-df3d000cf16c",
                                        "entry_id": "6d064244-4039-329c-bc44-ed0889ee59ff",
                                        "glosses": [
                                            "To apply glue."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f895e4c4-17e5-4286-8b58-b44ab23da58b",
                                                "sense_id": "c0f1fd01-c827-3c5a-bcc7-df3d000cf16c",
                                                "text": "\"This is how the whiskers went, I think. Cut long strips of paper—I'm just using a second paper bag here—and run the flat edge of the scissors down the strip to make it curl. Voilà. Then glue each whisker, like so, next to the nose, four on a side.\" She was watching. I glued quickly so I wouldn't lose her."
                                            },
                                            {
                                                "example_id": "d7d5b84a-0f8d-418b-820c-ef46f487ad5b",
                                                "sense_id": "c0f1fd01-c827-3c5a-bcc7-df3d000cf16c",
                                                "text": "Children need help in understanding such things as how to control a paintbrush, how to cut efficiently, how to glue with care and dexterity, and even how to manage a sponge during a cleanup task."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
