                        "cross_references": [
                            {
                                "target_word": "Altenheim",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffb0542-48da-37f8-b2ff-56a3d069526c",
                                        "entry_id": "7043b942-d630-3008-bdbd-0854e1e1d73d",
                                        "glosses": [
                                            "Einrichtung, in der Menschen im Alter wohnen und je nach Bedarf betreut und gepflegt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0cb462-ef50-4602-b960-cb0e6b05e362",
                                                "sense_id": "1ffb0542-48da-37f8-b2ff-56a3d069526c",
                                                "text": "Sonntags besuchen wir meist Uroma im Altenheim."
                                            },
                                            {
                                                "example_id": "e1d7ca1b-cc8c-47b1-a8ae-b109d1401a84",
                                                "sense_id": "1ffb0542-48da-37f8-b2ff-56a3d069526c",
                                                "text": "„Die Amerikaner übergaben das Schloss schließlich der evangelischen Diakonie, die dort ein Altenheim einrichtete.“"
                                            },
                                            {
                                                "example_id": "112a9a17-b467-4f2c-8407-9acd08951920",
                                                "sense_id": "1ffb0542-48da-37f8-b2ff-56a3d069526c",
                                                "text": "„Ina Seidel stirbt am 2. Oktober 1974 kurz nach ihrem 89. Geburtstag in einem Altenheim in Ebenhausen im Isartal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "826bd3b4-ff1a-4ac0-ba81-b114f8b256ab",
