                    "sense_definition": "A sign or omen that something is coming to an end or failing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bell_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden drop in sales sounded the <w>knell</w> for the struggling company."
                        },
                        {
                            "text": "This new technology might ring the <w>knell</w> for traditional paper books."
                        }
                    ],
                    "common_phrases": [
                        "ring the knell"
                    ]
                }
            ]
        },
        {
