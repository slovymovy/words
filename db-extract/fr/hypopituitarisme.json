                "word": "hypopituitarisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "31d52c20-669e-4871-824f-60659f318556",
                        "entry_id": "70ed7574-c813-3c7b-a2a9-61d5d642e777",
