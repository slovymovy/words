                                        "entry_id": "242e0787-1fc3-3795-91c7-b3cb21dcad7d",
                                        "glosses": [
                                            "südlichste Landschaft in Südamerika, in Chile sowie Argentinien gelegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bca5144-3fbf-42ed-b22f-fbdbbcd23163",
                                                "sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                                                "text": "Der Feuerlandarchipel, welcher südlich der Magellanstraße liegt, wird oft auch zu Patagonien gezählt."
                                            },
                                            {
                                                "example_id": "1ac3bae7-0890-4ec5-84ce-6b4da2444da1",
                                                "sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                                                "text": "Getrennt durch die Anden setzt sich Patagonien aus Westpatagonien (befindet sich v.a. in Chile) und Ostpatagonien (befindet sich v.a. in Argentinien) zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
