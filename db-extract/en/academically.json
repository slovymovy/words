                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3034943d-8283-3c1e-9d1c-da1b79f37948",
                                        "entry_id": "0a1e0618-2542-3b5c-888d-3fc6058ca18f",
                                        "glosses": [
                                            "eine Hochschule oder Universität betreffend, eine Akademie betreffend"
                                        ],
                                        "tags": [
                                            "manchmal",
                                            "aber seltener",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6357f0a-949d-402b-8db8-16380b9958e1",
                                                "sense_id": "3034943d-8283-3c1e-9d1c-da1b79f37948",
                                                "text": "Sie bagann ihre akademische Laufbahn an der Universität Bielefeld."
                                            },
                                            {
                                                "example_id": "704e81be-ab71-42de-a6f5-7d55030721b1",
                                                "sense_id": "3034943d-8283-3c1e-9d1c-da1b79f37948",
                                                "text": "„Die bürgerliche akademische Jugend sei auf Sinnsuche gewesen - wie es ja die bürgerliche Sozialisierung zwingend verlange - um nach kurzer Zeit doch noch Karriere zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb974b04-7039-3baa-9c66-3407fb3b25e4",
                                        "entry_id": "0a1e0618-2542-3b5c-888d-3fc6058ca18f",
                                        "glosses": [
                                            "auf eine Art und Weise, die wenig mit der Praxis zu tun hat, sondern auf theoretischen (manchmal sogar weltfremden) Überlegungen basiert, nur um der Theorie willen, ohne dass es eine Bedeutung für die Praxis hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83af9169-c5d0-401c-ab9d-eac19f76a0eb",
                                                "sense_id": "cb974b04-7039-3baa-9c66-3407fb3b25e4",
                                                "text": "Meine Frage ist natürlich nur rein akademisch."
                                            },
                                            {
                                                "example_id": "c76ae831-1382-45d6-9ce3-5b445eec6de1",
                                                "sense_id": "cb974b04-7039-3baa-9c66-3407fb3b25e4",
                                                "text": "„Dieses Wechselspiel zwischen Pflanze und Bakterium auf mikrobiologischer Ebene zu verstehen, ist - so akademisch das Thema klingt - von ganz praktischer Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
