{
    "word_family": [
        "protrusion",
        "protrusive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51b63d82-f21c-33cb-b498-8e2339b3d4cb",
                    "sense_definition": "To extend from, above or beyond a surface or boundary; to bulge outward; to stick out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extend_outward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sharp rock <w>protrudes</w> from the side of the mountain path.",
                            "target_lang_translations": {
                                "zh": "一块尖锐的岩石从山路边<w>突出</w>来。"
                            }
                        },
                        {
                            "text": "The metal rod <w>protrudes</w> from the wall, so be careful not to hit it.",
                            "target_lang_translations": {
                                "zh": "那根金属杆从墙里<w>突出</w>来，小心别撞到它。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jut",
                        "project",
                        "protuberate"
                    ],
                    "common_phrases": [
                        "protrude from"
                    ],
                    "target_lang_definitions": {
                        "zh": "指从表面或边界向外延伸、凸出或突出。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突出",
                                "target_lang_sense_clarification": "指物体从平面或整体中伸出来。"
                            },
                            {
                                "target_lang_word": "凸出",
                                "target_lang_sense_clarification": "指物体表面向外隆起。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39dcca95-06ea-3ff4-b88a-87e3a584bb7d",
                    "sense_definition": "To cause to extend from a surface or boundary; to cause to stick out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extend_outward",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal <w>protrudes</w> its tongue to catch insects.",
                            "target_lang_translations": {
                                "zh": "这种动物<w>伸出</w>舌头捕捉昆虫。"
                            }
                        },
                        {
                            "text": "He <w>protrudes</w> his chin when he is feeling defiant.",
                            "target_lang_translations": {
                                "zh": "当他感到反抗时，他会<w>伸出</w>下巴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "project"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物从表面或边界向外延伸或伸出。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伸出",
                                "target_lang_sense_clarification": "指主动将身体部位或物体向外伸展。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3020b549-8535-3f9f-8ff3-8e9d62441220",
                    "sense_definition": "To thrust forward; to drive or force along.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political group sought to <w>protrude</w> their agenda into the public discourse.",
                            "target_lang_translations": {
                                "zh": "该政治团体试图将他们的议程<w>推进</w>到公众讨论中。"
                            }
                        },
                        {
                            "text": "The mechanism <w>protrudes</w> the lever forward to engage the gears.",
                            "target_lang_translations": {
                                "zh": "该机械装置将杠杆向前<w>推进</w>以啮合齿轮。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary or technical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "强行推进或推动某事物向前。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推进",
                                "target_lang_sense_clarification": "指推动事物向前发展或移动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}