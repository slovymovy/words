                "senses": [
                    {
                        "sense_id": "6046fb85-2596-3090-8953-ead47a0ecda6",
                        "entry_id": "4f77efc1-0601-335b-a4cf-920309f71304",
                        "glosses": [
                            "sprachliche Schicht, die aus Wörtern besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8708700c-d2a0-469a-92cc-f894eb264550",
                                "sense_id": "6046fb85-2596-3090-8953-ead47a0ecda6",
                                "text": "„Das Interview bietet eine ganze Palette von Strategien, mit Konsequenzen für die Wort- und Satzebene.“"
                            },
                            {
                                "example_id": "672891fe-c544-4c7c-926c-8858721c7d75",
                                "sense_id": "6046fb85-2596-3090-8953-ead47a0ecda6",
                                "text": "„Das Isotopiekonzept arbeitet ‚unterhalb‘ der Wortebene, indem es auf die Semanalyse zurückgreift, also auf die Annahme der Zerlegbarkeit von Wortbedeutungen in eine Menge einzelner semantischer Merkmale (…).“"
                            },
                            {
                                "example_id": "cbf7447b-6e0e-424b-a56c-e1cdf93919f5",
                                "sense_id": "6046fb85-2596-3090-8953-ead47a0ecda6",
                                "text": "„Definitionen mit einer auf den Rahmen Sprecher – Hörer bezogenen Terminologie liegen noch nicht vor, zum Teil wohl deshalb nicht, weil sich die kommunikations- und pragmatikorientierten Richtungen der Linguistik in ihrer Fixierung auf den Text noch kaum auf die Wortebene begeben haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
