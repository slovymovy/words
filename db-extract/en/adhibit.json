                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hereinlassen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                        "entry_id": "66c964a5-a9fb-3e95-a8a6-dc7ff8f51fb8",
                                        "glosses": [
                                            "jemanden oder etwas hereinkommen lassen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33afa3e-643d-4192-959a-c5cb61068e59",
                                                "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                                "text": "Um das Tageslicht hereinzulassen, mussten die vielen Öffnungen in der Dachkonstruktion ein neuartiges Formkonzept für das Dach zulassen."
                                            },
                                            {
                                                "example_id": "cf236fb8-62ad-408f-a24e-ff4c61816e1f",
                                                "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                                "text": "Die technischen Möglichkeiten für eine gute Kühlung sind zwar vorhanden, denn hochwertige Dämmung und Fenster, die wenig Hitze hereinlassen, versprechen Komfort."
                                            },
                                            {
                                                "example_id": "0dcadffe-385b-4dbb-b36b-dd2a42a178eb",
                                                "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                                "text": "Das heisst nicht, dass wir morgen alle hereinlassen sollten, aber man müsste sich das Ziel setzen, dass ein Migrant nach etwa fünf Jahren mit seinem Umfeld ebenso verbunden ist wie jemand, der schon lange hier lebt."
                                            },
                                            {
                                                "example_id": "794b763a-fa03-44bb-8da2-7df441145d5b",
                                                "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                                "text": "„Wir können nur jene in die EU hereinlassen, die vorab eine Erlaubnis erhalten haben.“"
                                            },
                                            {
                                                "example_id": "308bf591-7e09-4d59-b708-bc45649d5202",
                                                "sense_id": "c970d76e-20ae-30d3-8d9b-6ef137351d0e",
                                                "text": "Der Ankömmling, den Netty hereinließ, war nun wirklich Schubert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "279aacd1-cf44-4550-95ec-e122370d6c41",
                        "source_entry_id": "2bc977f7-e8ce-36e0-8555-6b920bfa1214",
                        "source_sense_id": "1191f0a8-d302-3d3c-9258-fe2ebd5fe017",
                        "source_sense_description": "etwas anwenden, benutzen",
                        "target_lang_word": "anwenden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anwenden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29368af2-fc52-354c-b2da-de3842713c1d",
                                        "entry_id": "f855d7fe-19f8-3103-9b1c-a3029f34083d",
                                        "glosses": [
                                            "etwas dazu benutzen, um eine Aufgabe zu erledigen oder ein Ziel zu erreichen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b88277-9dfb-40a3-8489-ca9fcee75b61",
                                                "sense_id": "29368af2-fc52-354c-b2da-de3842713c1d",
                                                "text": "Als er ein Loch in die Wand bohren wollte, entschied er sich, zunächst den kleinsten Bohrer anzuwenden."
                                            },
                                            {
                                                "example_id": "73c0ea8e-caf9-420f-9d04-993ad2fd8166",
                                                "sense_id": "29368af2-fc52-354c-b2da-de3842713c1d",
                                                "text": "Muss man erst Gewalt anwenden, um diese Tür aufzubekommen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cb2c961-0708-394f-850a-7d93cf813950",
                                        "entry_id": "f855d7fe-19f8-3103-9b1c-a3029f34083d",
                                        "glosses": [
                                            "eine (allgemeine) Aussage oder Regel auf einen anderen (besonderen) Sachverhalt oder eine Person übertragen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b6adeef-7f4b-4c0f-99eb-5b776484bfd5",
                                                "sense_id": "8cb2c961-0708-394f-850a-7d93cf813950",
                                                "text": "Das, was in Abschnitt 2 steht, kann man nicht auf diese Situation hier anwenden."
                                            },
                                            {
                                                "example_id": "69555467-5791-4579-8c7a-a7c344da8608",
                                                "sense_id": "8cb2c961-0708-394f-850a-7d93cf813950",
                                                "text": "Auf Gerhard könnte man das Sprichwort »Hochmut kommt vor dem Fall« anwenden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82b97623-4142-4746-aa5d-b2134e3572a1",
                        "source_entry_id": "2bc977f7-e8ce-36e0-8555-6b920bfa1214",
                        "source_sense_id": "1191f0a8-d302-3d3c-9258-fe2ebd5fe017",
                        "source_sense_description": "etwas anwenden, benutzen",
                        "target_lang_word": "benutzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benutzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                        "entry_id": "3da76fcd-e206-3bf1-b12c-1e38912c8e98",
                                        "glosses": [
                                            "verwenden, ausnutzen, zum Vorteil anwenden, brauchen, gebrauchen, nutzbar machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad1b079-a9da-4069-9533-c155f4550346",
                                                "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                                "text": "Auf dem Laptop benutze ich das Betriebssystem eines bekannten Herstellers."
                                            },
                                            {
                                                "example_id": "a8f4c4bd-13a1-4630-baea-904de692eafe",
                                                "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                                "text": "Siehst du nicht, dass er dich nur benutzt!"
                                            },
                                            {
                                                "example_id": "9dfa15e8-be69-4088-bb7e-5d049363a4dc",
                                                "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                                "text": "Oh, diese Gabel ist schon benutzt."
                                            },
                                            {
                                                "example_id": "671a1be7-7b1f-414d-9e14-7bc2c81e5282",
                                                "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                                "text": "Meine Chefin benutzte ständig Fachbegriffe."
                                            },
                                            {
                                                "example_id": "7a423199-75a5-420e-958d-536301c955c3",
                                                "sense_id": "8fb1405f-9ae8-3772-b195-1b8e6a0b42df",
                                                "text": "Darf ich mal Ihre Toilette benutzen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "041fe6ca-b2cf-4f45-9739-c9b38612bef9",
                        "source_entry_id": "2bc977f7-e8ce-36e0-8555-6b920bfa1214",
                        "source_sense_id": "342424a4-5068-30e8-9ad0-1ee8d0766f06",
                        "source_sense_description": "etwas anheften",
                        "target_lang_word": "anheften",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anheften",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                        "entry_id": "ef0bb651-ec35-3999-9d6f-37aa026a2f31",
                                        "glosses": [
                                            "lose (mit einer Klammer oder Nadel) befestigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71fed7d6-d897-45f9-8e6a-70525fe339f3",
                                                "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                                "text": "Ein Schütze trägt seine Erfolge auf der Brust. Wer sich welche Orden anheften darf, ist eine Wissenschaft für sich."
                                            },
                                            {
                                                "example_id": "85a505b9-3ca6-4a3b-863b-e11c5b2b24c9",
                                                "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                                "text": "„Was kann denn so ein Aufnäher schon für Schaden anrichten?“ seufzte eine Frau, die selber nie auf den Gedanken gekommen wäre, ihn anzuheften."
                                            },
                                            {
                                                "example_id": "00c6ec68-3cb6-442f-9ea9-6969e65636bb",
                                                "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                                "text": "Auf jede der Sohlen wird je eins der längeren Filzstücke gelegt und erst mit Stecknadeln angeheftet, dann zusammengenäht."
                                            },
                                            {
                                                "example_id": "cbd35c69-fc9b-452f-bb65-fb53e03b82a1",
                                                "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                                "text": "„Ich will zu Papa“, steht auf dem Transparent geschrieben, das auf dem Kinderbuggy des kleinen Abubakar angeheftet ist."
                                            },
                                            {
                                                "example_id": "b7fee272-883f-463b-bc31-03850e22ea16",
                                                "sense_id": "709ccccd-16e4-39d9-9fac-f17d012ba53a",
                                                "text": "Im Frühstücksraum waren schon überall weiße DIN-A4-Zettel angeheftet, des Inhalts, dass ein wertvoller Band aus dem Fundus des Hauses fehlte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
