                                    {
                                        "sense_id": "3bac34af-62e5-3903-8cb2-37f85b750470",
                                        "entry_id": "2969f15c-71f8-35f0-a1b7-e32ad95c545a",
                                        "glosses": [
                                            "töten, indem die Atmung dadurch verhindert wird, dass die Atmungsorgane unter Wasser gehalten werden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac562dad-f5bf-448c-8d36-cf742e3ce487",
                                                "sense_id": "3bac34af-62e5-3903-8cb2-37f85b750470",
                                                "text": "Du wirst doch nicht etwas vorhaben, die Kätzchen zu ersäufen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "093f9202-0c6c-30f4-9c20-9ffb401209d9",
                                        "entry_id": "2969f15c-71f8-35f0-a1b7-e32ad95c545a",
                                        "glosses": [
                                            "etwas durch etwas verschwinden machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3abd6c8-7ca1-4e75-b2d9-57e40e9c832e",
                                                "sense_id": "093f9202-0c6c-30f4-9c20-9ffb401209d9",
                                                "text": "Er wollte nur noch seinen ganzen Kummer im Alkohol ersäufen, durch reichlichen Konsum von Schnaps vergessen machen."
                                            },
                                            {
                                                "example_id": "7f10161f-8590-4bfc-92c0-d27dfd33a813",
                                                "sense_id": "093f9202-0c6c-30f4-9c20-9ffb401209d9",
                                                "text": "„Kommen Sie einfach mit. Wir ersäufen die Sorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
