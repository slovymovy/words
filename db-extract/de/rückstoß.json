                    {
                        "form_id": "5b28b8c8-cf48-436e-b5f0-3f7ad238fe82",
                        "entry_id": "48d1b31f-13d4-379b-8a58-32a11bc7b518",
                        "tags": [
                            "accusative",
                            "plural"
