                "senses": [
                    {
                        "sense_id": "be472ef1-ce5d-310a-b8b1-ca42211e24da",
                        "entry_id": "aebffb9f-0dac-39ea-9f53-a644e2f6d53c",
                        "glosses": [
                            "clerk"
                        ],
