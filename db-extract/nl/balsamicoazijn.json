                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balsamico",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                        "entry_id": "a4821e47-d3f5-3145-b412-ab8d78fabbc2",
                                        "glosses": [
                                            "milder, meist dunkelbrauner, aromatischer, süßsauer schmeckender Weinessig, der eindickend in Fässern aus verschiedenen Hölzern reift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250c89e2-2181-4aac-a674-37c0855098fb",
                                                "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                                "text": "Die Norditaliener hatten „Aceto Balsamico di Modena“ als geschützte geografische Angabe eintragen lassen. Ihr verwegener Plan: Sie wollten das Wort „Balsamico“ bei dieser Gelegenheit gleich ganz für sich reservieren."
                                            },
                                            {
                                                "example_id": "ea35d387-dfb9-4ce7-ac63-183e92e31889",
                                                "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                                "text": "Der Balsamico wird neun oder 15 Jahre gereift, auch einen sechsjährigen Apfel-Balsam-Essig hat er im Programm."
                                            },
                                            {
                                                "example_id": "5976a18e-86c7-4d8a-8043-ce349a290a7a",
                                                "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                                "text": "Manche nutzen Balsamico nur zum Anmischen ihrer Salatdressings."
                                            },
                                            {
                                                "example_id": "3e156f7f-f2e0-4181-bc53-50e00efe5dc4",
                                                "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                                "text": "Die Linsen mit Salz, Pfeffer, Balsamico und Zucker abschmecken und die Trauben unterrühren."
                                            },
                                            {
                                                "example_id": "238a63f0-076b-4a51-b197-e047fbbcabf5",
                                                "sense_id": "bf3463f8-9a22-3e29-954f-33bb2f75872f",
                                                "text": "Auch der Balsamico, der vom berühmten Weinhaus Masi vertrieben wird, war absolut in Ordnung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
