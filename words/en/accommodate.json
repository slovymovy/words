{
    "word_family": [
        "accommodation",
        "accommodating",
        "accommodative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b07af99-dce9-3469-9bd1-ad98c323ab44",
                    "sense_definition": "To provide a place to stay or live for someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "space_provision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new hotel can <w>accommodate</w> guests in luxury suites.",
                            "target_lang_translations": {
                                "ru": "Новый отель может <w>разместить</w> гостей в номерах люкс.",
                                "zh": "这家新酒店可以为客人<w>提供</w>豪华套房。"
                            }
                        },
                        {
                            "text": "We were happy to <w>accommodate</w> our friends for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы были рады <w>разместить</w> наших друзей на выходные.",
                                "zh": "我们很乐意在周末<w>接待</w>我们的朋友。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accommodate guests",
                        "accommodate tourists"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять жилье или место для проживания.",
                        "zh": "为某人提供住宿或居住的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "предоставлять место для проживания"
                            },
                            {
                                "target_lang_word": "селить",
                                "target_lang_sense_clarification": "помогать устроиться на жительство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提供住宿",
                                "target_lang_sense_clarification": "为他人安排住处"
                            },
                            {
                                "target_lang_word": "容纳",
                                "target_lang_sense_clarification": "指提供居住空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36fe59a-ea98-3c10-b3ad-9a9305a9bc75",
                    "sense_definition": "To have enough space to contain a particular number of people or things.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "space_provision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium was built to <w>accommodate</w> fifty thousand spectators.",
                            "target_lang_translations": {
                                "ru": "Стадион был построен, чтобы <w>вместить</w> пятьдесят тысяч зрителей.",
                                "zh": "这座体育场建成后可<w>容纳</w>五万名观众。"
                            }
                        },
                        {
                            "text": "This small table cannot <w>accommodate</w> such a large group.",
                            "target_lang_translations": {
                                "ru": "Этот маленький столик не может <w>вместить</w> такую большую группу.",
                                "zh": "这张小桌子<w>坐不下</w>这么多人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accommodate up to",
                        "accommodate a large number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь достаточно места, чтобы вместить определенное количество людей или вещей.",
                        "zh": "有足够的空间容纳一定数量的人或物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмещать",
                                "target_lang_sense_clarification": "содержать в себе, иметь емкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容纳",
                                "target_lang_sense_clarification": "指空间大小足以装下"
                            },
                            {
                                "target_lang_word": "装得下",
                                "target_lang_sense_clarification": "口语中表示容量足够"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50d06a90-7fd7-3dd9-af5b-c6711b89aa75",
                    "sense_definition": "To provide what is needed or desired; to do a favor for someone.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "help_adapt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We always try to <w>accommodate</w> the special needs of our clients.",
                            "target_lang_translations": {
                                "ru": "Мы всегда стараемся <w>удовлетворить</w> особые потребности наших клиентов.",
                                "zh": "我们总是尽力<w>满足</w>客户的特殊需求。"
                            }
                        },
                        {
                            "text": "The schedule was changed to <w>accommodate</w> a request from the manager.",
                            "target_lang_translations": {
                                "ru": "Расписание было изменено, чтобы <w>удовлетворить</w> просьбу менеджера.",
                                "zh": "为了<w>迁就</w>经理的要求，日程安排做了调整。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oblige",
                        "suit"
                    ],
                    "antonyms": [
                        "discommodate"
                    ],
                    "common_phrases": [
                        "accommodate needs",
                        "accommodate a request",
                        "accommodate changes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять необходимое или желаемое; оказывать услугу или идти навстречу.",
                        "zh": "提供所需或所求之物；给予方便或满足要求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "потребности или просьбы"
                            },
                            {
                                "target_lang_word": "идти навстречу",
                                "target_lang_sense_clarification": "оказывать любезность, соглашаться помочь"
                            },
                            {
                                "target_lang_word": "учитывать",
                                "target_lang_sense_clarification": "принимать во внимание интересы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满足",
                                "target_lang_sense_clarification": "指满足需求或愿望"
                            },
                            {
                                "target_lang_word": "迁就",
                                "target_lang_sense_clarification": "指为了方便他人而改变自己"
                            },
                            {
                                "target_lang_word": "照顾",
                                "target_lang_sense_clarification": "指考虑到某人的特殊情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3328ce42-a778-39a3-8420-450dd9d28b9e",
                    "sense_definition": "To change behavior or plans to fit new circumstances.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "help_adapt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>accommodate</w> herself to the strict rules of the new school.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>приспособиться</w> к строгим правилам новой школы.",
                                "zh": "她不得不让自己<w>适应</w>新学校严格的校规。"
                            }
                        },
                        {
                            "text": "It took some time to <w>accommodate</w> to the different working environment.",
                            "target_lang_translations": {
                                "ru": "Потребовалось некоторое время, чтобы <w>приспособиться</w> к другой рабочей обстановке.",
                                "zh": "花了一些时间才<w>适应</w>了不同的工作环境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adapt",
                        "adjust",
                        "conform"
                    ],
                    "common_phrases": [
                        "accommodate oneself to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять поведение или планы, чтобы соответствовать новым обстоятельствам.",
                        "zh": "改变行为或计划以适应新的环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспосабливаться",
                                "target_lang_sense_clarification": "адаптироваться к условиям"
                            },
                            {
                                "target_lang_word": "подстраиваться",
                                "target_lang_sense_clarification": "менять поведение под ситуацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适应",
                                "target_lang_sense_clarification": "指调整自己以符合新情况"
                            },
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "指改变状态以适应环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4131bba-d96d-3b02-95f4-003cc4ef26b6",
                    "sense_definition": "To settle a disagreement or bring about harmony.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reconcile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mediator worked hard to <w>accommodate</w> the differences between the two parties.",
                            "target_lang_translations": {
                                "ru": "Посредник усердно работал, чтобы <w>сгладить</w> разногласия между двумя сторонами.",
                                "zh": "调解员努力<w>化解</w>双方之间的分歧。"
                            }
                        },
                        {
                            "text": "They managed to <w>accommodate</w> their disputes without legal action.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>уладить</w> свои споры без судебного разбирательства.",
                                "zh": "他们设法在不诉诸法律的情况下<w>解决了</w>纠纷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reconcile"
                    ],
                    "common_phrases": [
                        "accommodate differences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улаживать разногласия или приводить к согласию.",
                        "zh": "解决分歧或达成和谐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улаживать",
                                "target_lang_sense_clarification": "разрешать спор или конфликт"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "уменьшать противоречия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调解",
                                "target_lang_sense_clarification": "指解决双方的矛盾"
                            },
                            {
                                "target_lang_word": "化解",
                                "target_lang_sense_clarification": "指消除分歧或矛盾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f65e50b0-ee1d-3f50-ab27-9718d7ff279b",
                    "sense_definition": "To change the focus of the eye to see objects at different distances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As people age, their eyes lose the ability to <w>accommodate</w> quickly.",
                            "target_lang_translations": {
                                "ru": "С возрастом глаза людей теряют способность быстро <w>аккомодировать</w>.",
                                "zh": "随着年龄增长，人们眼睛的<w>调节</w>能力会下降。"
                            }
                        },
                        {
                            "text": "The lens must <w>accommodate</w> in order to focus on near objects.",
                            "target_lang_translations": {
                                "ru": "Хрусталик должен <w>аккомодировать</w>, чтобы сфокусироваться на близких объектах.",
                                "zh": "为了看清近处的物体，晶状体必须进行<w>调节</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять фокус глаза, чтобы видеть объекты на разных расстояниях.",
                        "zh": "改变眼睛的焦距以看清不同距离的物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккомодировать",
                                "target_lang_sense_clarification": "термин в офтальмологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "眼科术语，指晶状体改变焦距"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}