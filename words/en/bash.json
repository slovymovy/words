                            },
                            {
                                "target_lang_word": "pecka",
                                "target_lang_sense_clarification": "hovorové označení pro silný úder"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "golpe",
                                "target_lang_sense_clarification": "impacto contundente o porrazo"
                            },
                            {
                                "target_lang_word": "porrazo",
                                "target_lang_sense_clarification": "golpe fuerte o ruidoso"
                            },
                            {
                                "target_lang_word": "leñazo",
                                "target_lang_sense_clarification": "golpe fuerte (coloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                    "sense_definition": "An attempt at doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not sure I can fix this, but I will give it a <w>bash</w>.",
                            "target_lang_translations": {
                                "cs": "Nejsem si jistý, jestli to dokážu opravit, ale <w>zkusím to</w>.",
                                "es": "No estoy seguro de poder arreglarlo, pero voy a <w>probar</w>."
                            }
                        },
                        {
                            "text": "This was my first <w>bash</w> at baking bread, and it turned out well.",
                            "target_lang_translations": {
                                "cs": "Byl to můj první <w>pokus</w> o pečení chleba a dopadlo to dobře.",
                                "es": "Este fue mi primer <w>intento</w> de hacer pan y salió bien."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give it a bash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokus o provedení něčeho.",
                        "es": "Intento de hacer algo."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokus",
                                "target_lang_sense_clarification": "obecné označení pro snahu něco udělat"
                            },
                            {
                                "target_lang_word": "zkusit to",
                                "target_lang_sense_clarification": "vyjádření snahy o provedení akce"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "intento",
                                "target_lang_sense_clarification": "acción de intentar algo"
                            },
                            {
                                "target_lang_word": "tentativa",
                                "target_lang_sense_clarification": "esfuerzo o prueba para lograr algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56568329-5ded-3b38-8563-2305abbf49f9",
                    "sense_definition": "A large party or gala event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "party",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They organized a huge <w>bash</w> to celebrate their company anniversary.",
                            "target_lang_translations": {
                                "cs": "Uspořádali obrovský <w>večírek</w> na oslavu výročí firmy.",
                                "es": "Organizaron una gran <w>fiesta</w> para celebrar el aniversario de la empresa."
                            }
                        },
                        {
                            "text": "Everyone was invited to the birthday <w>bash</w> held at the local hall.",
                            "target_lang_translations": {
                                "cs": "Všichni byli pozváni na narozeninovou <w>oslavu</w> v místním sále.",
                                "es": "Todos estaban invitados al <w>fiestón</w> de cumpleaños celebrado en el salón local."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a celebration."
                        }
