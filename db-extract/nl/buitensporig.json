                ],
                "senses": [
                    {
                        "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                        "entry_id": "6ddb0ca3-f126-38d0-a52a-973a2810eea3",
                        "glosses": [
                            "buiten alle maten, enorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d94b0649-109c-4706-9aee-be9635561d29",
                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                "text": "Die buitensporige reactie werd hem erg kwalijk genomen."
                            },
                            {
                                "example_id": "73e7cf91-b800-4ecc-8ffd-425708f07a76",
                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                "text": "Daarbij wordt er buitensporig geweld gebruikt en onnodig veel schade toegebracht. Kinderen zien hun ouders op brute wijze en zonder toelichting van bed worden gelicht. Acties die zelden leiden tot verder strafrechtelijk onderzoek op verdenking van terrorisme."
                            },
                            {
                                "example_id": "dbabd6b5-10fe-45a2-a4aa-361776c093df",
                                "sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                                "text": "Het was moeilijk om een beleefde manier te vinden om haar woordenvloed te stuiten, ze was buitensporig ambitieus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e26c8c1b-d339-49f4-bb94-2edce40e1853",
                        "source_entry_id": "6ddb0ca3-f126-38d0-a52a-973a2810eea3",
                        "source_sense_id": "10c1fe61-4889-32eb-84dd-d5d9a2749a80",
                        "source_sense_description": "buiten alle maten",
                        "target_lang_word": "excessive",
