                    ]
                },
                {
                    "sense_id": "07625949-3cba-33ad-839e-b28a3a37c9de",
                    "sense_definition": "Fait ou situation qui dépasse la mesure habituelle et atteint un degré extrême d'absurdité ou d'ironie.",
