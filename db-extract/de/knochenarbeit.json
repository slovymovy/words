                "senses": [
                    {
                        "sense_id": "bfab4e07-7a6f-38bf-91ef-7ae1813e7ad2",
                        "entry_id": "70dd6cf4-f8ea-3f26-b576-9bbce918aa96",
                        "glosses": [
                            "körperlich sehr anstrengende Arbeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a321d4ba-e83a-440e-9ef0-34954138103b",
                                "sense_id": "bfab4e07-7a6f-38bf-91ef-7ae1813e7ad2",
                                "text": "In dieser Hitze einen Kanal zu graben ist reinste Knochenarbeit!"
                            },
                            {
                                "example_id": "317efd4c-130a-4921-8625-618275eb512d",
                                "sense_id": "bfab4e07-7a6f-38bf-91ef-7ae1813e7ad2",
                                "text": "Im Steinbruch erwartete ihn dann ein Leben voller Knochenarbeit."
                            },
                            {
                                "example_id": "d89ea510-c97e-4a2a-a009-ca4f686a35b5",
                                "sense_id": "bfab4e07-7a6f-38bf-91ef-7ae1813e7ad2",
                                "text": "„Er verdient bei der Knochenarbeit auf der Baustelle pro Tag umgerechnet rund einen Euro.“"
                            },
                            {
                                "example_id": "9f542423-1380-4cf2-8cb8-f6819f2a8a59",
                                "sense_id": "bfab4e07-7a6f-38bf-91ef-7ae1813e7ad2",
                                "text": "„Das Leben war nicht nur absurd, es war pure Knochenarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
