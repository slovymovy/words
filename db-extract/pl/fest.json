                    {
                        "sense_id": "2522815c-34fa-356c-9836-fb8f788eda81",
                        "entry_id": "b619db5c-fbc4-317a-8127-b388e77f52ad",
                        "glosses": [
                            "gw. (Łódź), gw. (Warszawa)^([potrzebne źródło]) mocno"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f716f03-f8a8-40b1-9b35-4cee1ee5da40",
                                "sense_id": "2522815c-34fa-356c-9836-fb8f788eda81",
                                "text": "Nie ma tak dobrze, skikaj pan z kaczkamy na ulicę, albo trzymaj się fest za kozioł, bo teraz pojadziem na wylot!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d5f34485-82cd-3f68-a632-1bd1aa45df05",
