                "senses": [
                    {
                        "sense_id": "ba41c211-986d-3543-87d0-b02815ebd36b",
                        "entry_id": "9c4a17d9-b4ad-30f4-aaff-77f3bd0790ff",
                        "glosses": [
                            "naive, sich dümmlich und ungeschickt anstellende Person"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "familiär;",
                            "meist als Anrede gegenüber Frauen benutzt"
                        ],
                        "examples": [
                            {
                                "example_id": "9e96fb35-bb05-474a-9d5a-9a3e0e452f0b",
                                "sense_id": "ba41c211-986d-3543-87d0-b02815ebd36b",
                                "text": "Du kleines Dummchen! Du musst erst die Radschrauben entfernen, bevor du das Rad wechseln kannst."
                            },
                            {
                                "example_id": "295e02e9-4a7e-4acf-8608-96a0f3e2406f",
                                "sense_id": "ba41c211-986d-3543-87d0-b02815ebd36b",
                                "text": "„Jeder kennt die Werbung für die Telefonauskunft, bei der Verona Feldbusch ihr Image als grammatikschwaches Dummchen geschickt vermarktet, wenn sie die berühmten Worte spricht: »Da werden Sie geholfen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
