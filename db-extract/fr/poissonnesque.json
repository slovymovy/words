                                            {
                                                "example_id": "754752b7-6daf-4a32-b933-6141c405d8df",
                                                "sense_id": "332b9fad-1277-3747-963c-0cbafc9dcbc7",
                                                "text": "In the ancient Middle East certain cults had piscine deities, or deities with fish attributes of various kinds."
                                            },
                                            {
                                                "example_id": "4c0f26c2-63dd-4fc4-a046-7f48b04c17e1",
                                                "sense_id": "332b9fad-1277-3747-963c-0cbafc9dcbc7",
                                                "text": "2009, David Quammen, Where the Salmon Rule, National Geographic (August 2009), page 40,\nAt age four he caught his first fish and was evermore fascinated by things piscine; […]"
                                            }
                                        ]
