                ],
                "senses": [
                    {
                        "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                        "entry_id": "e801e570-095a-3ec1-a057-b26c602babe8",
                        "glosses": [
                            "Qui n’est pas habité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4abea4bf-f587-40c9-975e-95c587bd3dbf",
                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                "text": "Aux aventureux, l'Islande offre aussi l’attrait de l’inconnu. Le cœur de l’île, inhabité et inhabitable, est encore une terre incognito."
                            },
                            {
                                "example_id": "093fe3ac-4013-4e73-b338-ea3d5c93b0c1",
                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                "text": "Les îles Galapagos, autrefois inhabitées, n'étaient alors visitées que par quelques baleiniers qui venaient s'y ravitailler en eau."
                            },
                            {
                                "example_id": "eba619dc-9392-4da4-8bc9-ee3122e00f28",
                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                "text": "Peu de villages. Quelques rares masures dont la plupart sont inhabitées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac37c7b-e6b0-43c7-b802-528409855953",
                        "source_entry_id": "e801e570-095a-3ec1-a057-b26c602babe8",
                        "source_sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                        "target_lang_word": "uninhabited",
