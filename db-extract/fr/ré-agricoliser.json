                        "glosses": [
                            "Redonner son caractère agricole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdeafb79-a778-476e-b30c-fb0aebc3ad89",
                                "sense_id": "b094bacc-7b2e-3f78-a909-020a43a02efe",
                                "text": "Le \"changement maintenant\" peut aussi être favorable à l'agriculture, car la démonstration est faite que la politique actuelle ne peut aboutir ni à relocaliser ni à \"ré-agricoliser\" les campagnes."
                            },
                            {
                                "example_id": "acda1dc5-7627-4719-9c46-5c242fe3ca56",
                                "sense_id": "b094bacc-7b2e-3f78-a909-020a43a02efe",
                                "text": "Il y a des communes périurbaines où l’agriculture a complètement disparu, où il est question de « ré-agricoliser » l'espace."
                            }
                        ]
