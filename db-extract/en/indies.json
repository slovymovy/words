                "entry_id": "5206abeb-2d0e-3aae-b220-b7fbe7b2adba",
                "word": "Indies",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0356a8aa-73a7-46af-90f0-ec79d4df73a8",
                        "entry_id": "5206abeb-2d0e-3aae-b220-b7fbe7b2adba",
                        "tags": [
                            "canonical",
                            "plural"
                        ],
                        "form": "the Indies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea1ea8ad-917f-317f-b4e2-25b70d0cf2db",
                        "entry_id": "5206abeb-2d0e-3aae-b220-b7fbe7b2adba",
                        "glosses": [
                            "The East Indies, including India, Southeast Asia, Indonesia, and adjacent lands."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "38e8ce73-4b9e-4a26-b7a7-aba5d2b24ab8",
                                "sense_id": "ea1ea8ad-917f-317f-b4e2-25b70d0cf2db",
                                "text": "There followed a remarkable period of maritime expansion by the Portuguese, who by the end of the century would establish a sea route to the Indies, rounding Africa and crossing the Indian Ocean to reach the subcontinent itself and the Spice Islands that lay beyond."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ac02060-d1d2-3ea2-bb03-9303239014b2",
                        "entry_id": "5206abeb-2d0e-3aae-b220-b7fbe7b2adba",
                        "glosses": [
                            "The West Indies, including Cuba, Puerto Rico, and other islands of the Caribbean."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "be5171f0-ab39-3923-9095-fbacbf023735",
                        "entry_id": "5206abeb-2d0e-3aae-b220-b7fbe7b2adba",
                        "glosses": [
                            "The Western Hemisphere, during the early period of European colonization and exploration."
                        ],
                        "tags": [
                            "historical",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae58671-0fc4-4add-b15d-c8331ff99f87",
                                "sense_id": "be5171f0-ab39-3923-9095-fbacbf023735",
                                "text": "the Spanish Indies"
                            }
                        ]
                    }
                ],
