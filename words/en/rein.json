{
    "word_family": [
        "reinless",
        "free-rein"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ac8fd6e-8d98-3970-a2b1-a528c77b45ae",
                    "sense_definition": "A strap or rope attached to a bridle or bit, used to control a horse, animal, or young child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control_straps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pulled gently on the left <w>rein</w> to guide the horse toward the path.",
                            "target_lang_translations": {
                                "pl": "Pociągnęła delikatnie za lewą <w>wodzę</w>, aby skierować konia na ścieżkę."
                            }
                        },
                        {
                            "text": "The rider held the leather <w>reins</w> tightly as the horse began to gallop.",
                            "target_lang_translations": {
                                "pl": "Jeździec mocno trzymał skórzane <w>wodze</w>, gdy koń zaczął galopować."
                            }
                        }
                    ],
                    "synonyms": [
                        "strap",
                        "leash"
                    ],
                    "common_phrases": [
                        "leather reins",
                        "hold the reins"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pasek lub lina przymocowana do uzdy lub wędzidła, służąca do kontrolowania konia, innego zwierzęcia lub małego dziecka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wodze",
                                "target_lang_sense_clarification": "pasy do kierowania koniem"
                            },
                            {
                                "target_lang_word": "lejce",
                                "target_lang_sense_clarification": "pasy rzemienne do powożenia"
                            },
                            {
                                "target_lang_word": "cugle",
                                "target_lang_sense_clarification": "wodze końskie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d7fc6da-7bf7-3753-825d-a9c5962115cf",
                    "sense_definition": "An instrument or means of curbing, restraining, or governing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control_straps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is attempting to keep a tight <w>rein</w> on rising prices.",
                            "target_lang_translations": {
                                "pl": "Rząd próbuje trzymać rosnące ceny na krótkiej <w>smyczy</w>."
                            }
                        },
                        {
                            "text": "He decided to hand over the <w>reins</w> of the company to his daughter.",
                            "target_lang_translations": {
                                "pl": "Postanowił przekazać <w>stery</w> firmy swojej córce."
                            }
                        }
                    ],
                    "synonyms": [
                        "curb",
                        "restraint",
                        "control"
                    ],
                    "common_phrases": [
                        "keep a tight rein",
                        "hand over the reins"
                    ],
                    "target_lang_definitions": {
                        "pl": "Środek lub narzędzie służące do powstrzymywania, kontrolowania lub rządzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wodze",
                                "target_lang_sense_clarification": "kontrola, panowanie nad czymś"
                            },
                            {
                                "target_lang_word": "stery",
                                "target_lang_sense_clarification": "kierowanie organizacją lub firmą"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79a34c62-5033-3eb4-8018-eb633cdb006c",
                    "sense_definition": "The inward impulses, affections, and passions, formerly supposed to be located in the area of the kidneys.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, it is written that God searches the hearts and the <w>reins</w> of men.",
                            "target_lang_translations": {
                                "pl": "W starożytnych tekstach napisane jest, że Bóg bada serca i <w>nerki</w> ludzi."
                            }
                        },
                        {
                            "text": "My <w>reins</w> shall rejoice when thy lips speak right things.",
                            "target_lang_translations": {
                                "pl": "Moje <w>wnętrze</w> będzie się radować, gdy twoje wargi będą mówić to, co prawe."
                            }
                        }
                    ],
                    "synonyms": [
                        "feelings",
                        "passions",
                        "heart"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in biblical or historical contexts to refer to the seat of feelings"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wewnętrzne impulsy, uczucia i namiętności, dawniej uważane za zlokalizowane w okolicach nerek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nerki",
                                "target_lang_sense_clarification": "w znaczeniu biblijnym jako siedlisko uczuć"
                            },
                            {
                                "target_lang_word": "wnętrze",
                                "target_lang_sense_clarification": "głębia duszy, sumienie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1659063-dbda-334b-b9a6-56db6a738453",
                    "sense_definition": "A kidney.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old physician spoke of a disease affecting the patient's <w>reins</w>.",
                            "target_lang_translations": {
                                "pl": "Stary lekarz mówił o chorobie dotykającej <w>nerek</w> pacjenta."
                            }
                        },
                        {
                            "text": "He felt a sharp pain in his <w>reins</w> after riding the horse all day.",
                            "target_lang_translations": {
                                "pl": "Poczuł ostry ból w <w>lędźwiach</w> po całodniowej jeździe konnej."
                            }
                        }
                    ],
                    "synonyms": [
                        "kidney"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "An archaic term for kidneys"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nerka (archaicznie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nerka",
                                "target_lang_sense_clarification": "narząd (przestarzale)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed9cf5a6-732b-3aad-9dd8-432700599647",
                    "sense_definition": "Acronym of repetitive electrical impulse noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician identified <w>REIN</w> as the main cause of the broadband connection drops.",
                            "target_lang_translations": {
                                "pl": "Technik zidentyfikował <w>REIN</w> jako główną przyczynę zerwań połączenia szerokopasmowego."
                            }
                        },
                        {
                            "text": "Faulty power supplies nearby can generate <w>REIN</w> that disrupts local telecommunications.",
                            "target_lang_translations": {
                                "pl": "Wadliwe zasilacze w pobliżu mogą generować zakłócenia <w>REIN</w>, które zakłócają lokalną telekomunikację."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Akronim od powtarzalnego zakłócenia impulsowego sieci elektrycznej (REIN)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "REIN",
                                "target_lang_sense_clarification": "rodzaj zakłóceń elektromagnetycznych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a53995d8-354b-3300-9e65-0983a30dd1ca",
                    "sense_definition": "To restrain, control, or check.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restrain_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>rein</w> in our spending if we want to save enough money for the trip.",
                            "target_lang_translations": {
                                "pl": "Musimy <w>ograniczyć</w> nasze wydatki, jeśli chcemy zaoszczędzić wystarczająco dużo pieniędzy na wycieczkę."
                            }
                        },
                        {
                            "text": "She struggled to <w>rein</w> in her anger during the heated debate.",
                            "target_lang_translations": {
                                "pl": "Z trudem próbowała <w>okiełznać</w> swój gniew podczas burzliwej debaty."
                            }
                        }
                    ],
                    "synonyms": [
                        "restrain",
                        "curb",
                        "control",
                        "check"
                    ],
                    "antonyms": [
                        "unleash",
                        "release"
                    ],
                    "common_phrases": [
                        "rein in spending",
                        "rein in emotions"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powstrzymywać, kontrolować lub ograniczać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "okiełznać",
                                "target_lang_sense_clarification": "opanować emocje lub wydatki"
                            },
                            {
                                "target_lang_word": "powstrzymać",
                                "target_lang_sense_clarification": "ograniczyć coś"
                            },
                            {
                                "target_lang_word": "hamować",
                                "target_lang_sense_clarification": "kontrolować wzrost lub zapędy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0052754f-e87c-3309-af65-f60ec1166bb6",
                    "sense_definition": "To direct or stop a horse by using reins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restrain_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider managed to <w>rein</w> his horse to a sudden halt before the fence.",
                            "target_lang_translations": {
                                "pl": "Jeźdźcowi udało się nagle <w>zatrzymać</w> konia przed ogrodzeniem."
                            }
                        },
                        {
                            "text": "He <w>reined</w> the stallion back as it tried to charge forward.",
                            "target_lang_translations": {
                                "pl": "On <w>ściągnął wodze</w> ogiera, gdy ten próbował ruszyć do przodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "stop"
                    ],
                    "common_phrases": [
                        "rein back",
                        "rein to a halt"
                    ],
                    "target_lang_definitions": {
                        "pl": "Kierować koniem lub zatrzymywać go za pomocą wodzy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ściągać wodze",
                                "target_lang_sense_clarification": "zatrzymywać konia"
                            },
                            {
                                "target_lang_word": "powstrzymywać",
                                "target_lang_sense_clarification": "zatrzymywać konia wodzami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e088278-efc2-3a9d-b6c5-0b85d4da86fe",
                    "sense_definition": "To obey directions given with the reins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young pony is learning quickly and <w>reins</w> well even for inexperienced riders.",
                            "target_lang_translations": {
                                "pl": "Młody kucyk szybko się uczy i dobrze <w>reaguje na wodze</w> nawet przy niedoświadczonych jeźdźcach."
                            }
                        },
                        {
                            "text": "She was pleased to find that the rented horse <w>reined</w> perfectly.",
                            "target_lang_translations": {
                                "pl": "Z przyjemnością stwierdziła, że wynajęty koń idealnie <w>słuchał wodzy</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Słuchać poleceń wydawanych za pomocą wodzy (o koniu)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "iść za wodzą",
                                "target_lang_sense_clarification": "być posłusznym wodzom"
                            },
                            {
                                "target_lang_word": "prowadzić się",
                                "target_lang_sense_clarification": "reagować na wodze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "32514594-129a-39eb-b7c2-4b8a02627892",
                    "sense_definition": "A German surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Rein</w> and his family to our annual neighborhood dinner.",
                            "target_lang_translations": {
                                "pl": "Zaprosiliśmy pana <w>Reina</w> i jego rodzinę na nasz coroczny sąsiedzki obiad."
                            }
                        },
                        {
                            "text": "The academic paper was co-authored by a researcher named Sophia <w>Rein</w>.",
                            "target_lang_translations": {
                                "pl": "Współautorką pracy naukowej była badaczka o nazwisku Sophia <w>Rein</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A family name of German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niemieckie nazwisko."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Rein",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}