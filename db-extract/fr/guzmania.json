                                "example_id": "68538fa2-0a7d-4949-aaee-62de1bf5342c",
                                "sense_id": "7fddf6a4-1fbb-3c93-a105-a4148d749136",
                                "text": "Les guzmanias sont des plantes épiphytes à rosettes de feuilles tendres et vernissées dont le cycle de vie (3 à 4 ans) se termine après la floraison."
                            },
                            {
                                "example_id": "6fe24b9c-389e-49ce-9ff2-3904e3e8cba8",
                                "sense_id": "7fddf6a4-1fbb-3c93-a105-a4148d749136",
                                "text": "Le guzmania appartient à la même famille que l’ananas : les broméliacées."
                            }
                        ]
