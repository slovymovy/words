{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b068660-9c0f-3ce9-a598-1dcf269b2cd6",
                    "sense_definition": "An amount of money spent on something, especially to start a project or buy equipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project requires a huge initial financial <w>outlay</w> before we see any profit.",
                            "target_lang_translations": {
                                "pl": "Projekt wymaga ogromnego początkowego <w>nakładu</w> finansowego, zanim zobaczymy jakikolwiek zysk."
                            }
                        },
                        {
                            "text": "Without too much capital <w>outlay</w>, they managed to set up the new office.",
                            "target_lang_translations": {
                                "pl": "Bez zbyt dużego <w>nakładu</w> kapitałowego udało im się urządzić nowe biuro."
                            }
                        }
                    ],
                    "synonyms": [
                        "expenditure",
                        "expense",
                        "spending",
                        "disbursement"
                    ],
                    "antonyms": [
                        "income",
                        "revenue",
                        "profit"
                    ],
                    "common_phrases": [
                        "capital outlay",
                        "financial outlay",
                        "initial outlay",
                        "cash outlay"
                    ],
                    "target_lang_definitions": {
                        "pl": "Kwota pieniędzy wydana na określony cel, zwłaszcza na rozpoczęcie projektu lub zakup sprzętu; nakład finansowy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nakład",
                                "target_lang_sense_clarification": "środki finansowe lub materialne przeznaczone na przedsięwzięcie"
                            },
                            {
                                "target_lang_word": "wydatek",
                                "target_lang_sense_clarification": "suma wydana na coś"
                            },
                            {
                                "target_lang_word": "inwestycja",
                                "target_lang_sense_clarification": "wkład pieniężny w przedsięwzięcie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67ceb6cc-7a6e-39a2-a446-bd4e2020bcd6",
                    "sense_definition": "A remote haunt, settlement, or habitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scout knew every hidden valley and secluded <w>outlay</w> across the wilderness.",
                            "target_lang_translations": {
                                "pl": "Zwiadowca znał każdą ukrytą dolinę i odosobnione <w>odludzie</w> na tym pustkowiu."
                            }
                        },
                        {
                            "text": "Travelers rarely wandered into that remote <w>outlay</w> beyond the northern hills.",
                            "target_lang_translations": {
                                "pl": "Podróżni rzadko zapuszczali się w tę odległą <w>osadę</w> za północnymi wzgórzami."
                            }
                        }
                    ],
                    "synonyms": [
                        "haunt",
                        "settlement",
                        "outpost"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare historical usage referring to remote settlements or retreats."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Odległa lub odosobniona osada, posterunek bądź siedziba ludzka (znaczenie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odludzie",
                                "target_lang_sense_clarification": "odosobnione miejsce"
                            },
                            {
                                "target_lang_word": "odosobniona osada",
                                "target_lang_sense_clarification": "oddalona osada"
                            },
                            {
                                "target_lang_word": "placówka",
                                "target_lang_sense_clarification": "oddalony posterunek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e05a32fc-d364-31e4-aed5-0a670b0cf91c",
                    "sense_definition": "To spend, expend, or disburse money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>outlay</w> several thousand dollars for the festival.",
                            "target_lang_translations": {
                                "pl": "Komitet postanowił <w>wyłożyć</w> kilka tysięcy dolarów na festiwal."
                            }
                        },
                        {
                            "text": "He had <w>outlaid</w> all his savings to purchase the necessary equipment.",
                            "target_lang_translations": {
                                "pl": "<w>Wydał</w> wszystkie swoje oszczędności, aby kupić niezbędny sprzęt."
                            }
                        }
                    ],
                    "synonyms": [
                        "spend",
                        "expend",
                        "disburse"
                    ],
                    "antonyms": [
                        "save",
                        "earn"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydawać lub wykładać pieniądze na określony cel."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykładać",
                                "target_lang_sense_clarification": "przeznaczać pieniądze na coś"
                            },
                            {
                                "target_lang_word": "wydawać",
                                "target_lang_sense_clarification": "płacić pieniędzmi"
                            },
                            {
                                "target_lang_word": "łożyć",
                                "target_lang_sense_clarification": "przeznaczać środki finansowe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc9cd63f-efe1-3029-be83-e048b19273af",
                    "sense_definition": "To lay or spread out; to expose or display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant began to <w>outlay</w> his finest silks along the wooden counter.",
                            "target_lang_translations": {
                                "pl": "Kupiec zaczął <w>rozkładać</w> swoje najlepsze jedwabie na drewnianej ladzie."
                            }
                        },
                        {
                            "text": "They would <w>outlay</w> their maps on the broad table before planning the journey.",
                            "target_lang_translations": {
                                "pl": "Zwykli <w>rozkładać</w> mapy na szerokim stole przed zaplanowaniem podróży."
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "expose",
                        "spread"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage meaning to spread or display."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozkładać, rozpościerać lub wystawiać coś na widok (znaczenie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozkładać",
                                "target_lang_sense_clarification": "rozpościerać na jakiejś powierzchni"
                            },
                            {
                                "target_lang_word": "wykładać",
                                "target_lang_sense_clarification": "prezentować, wystawiać"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}