                "senses": [
                    {
                        "sense_id": "99f6a54e-2221-3fae-b422-bb99d6253a71",
                        "entry_id": "16e8176c-3422-319b-94e5-2a6caee959dc",
                        "glosses": [
                            "The process of making or declaring a person legitimate."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dfcf48b9-6096-31e4-a063-3a54f4d55bf3",
                        "entry_id": "16e8176c-3422-319b-94e5-2a6caee959dc",
                        "glosses": [
                            "Legitimacy."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "66063bea-a5e7-47e1-baa7-11d4c7841c3e",
                                "sense_id": "dfcf48b9-6096-31e4-a063-3a54f4d55bf3",
                                "text": "I am not Sir Roberts sonne, / I haue disclaim'd Sir Robert and my land, / Legitimation, name, and all is gone […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b606ed04-9e92-3037-9379-76b4f525ffc5",
                        "entry_id": "16e8176c-3422-319b-94e5-2a6caee959dc",
                        "glosses": [
                            "The act of establishing something as lawful; authorization."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "eb44272c-9196-42de-b941-20b2ebf0abdd",
                                "sense_id": "b606ed04-9e92-3037-9379-76b4f525ffc5",
                                "text": "Le Paige established a legitimation for the Parlement's authority which was part history, part romantic fiction, and part political wishful thinking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ab2524b-a17a-4435-a29a-7f6377cdeecf",
                        "source_entry_id": "16e8176c-3422-319b-94e5-2a6caee959dc",
                        "source_sense_description": "process of legitimizing",
                        "target_lang_word": "légitimation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitimation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Changement d’état d’un enfant naturel que ses père et mère reconnaissent, et qui acquiert par là les droits des enfants nés dans le mariage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91b402c8-50f1-4976-8b20-aa68b754f9e9",
                                                "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                                "text": "Autrefois la légitimation pouvait s’opérer par lettres de chancellerie."
                                            },
                                            {
                                                "example_id": "d34be14b-7366-488a-ac6e-c39d92b462b6",
                                                "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                                "text": "[…] l’acte par lequel un bâtard eſt réputé enfant légitime, & jouit des mêmes privilèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df5af302-b4e8-3811-8902-5aa1160bd37b",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Action de légitimer, par le mariage entre le père et la mère."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f055b6bf-abb0-4125-8c98-5a490365ef0a",
                                                "sense_id": "df5af302-b4e8-3811-8902-5aa1160bd37b",
                                                "text": "La légitimation des enfants naturels de Louis XVI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Reconnaissance authentique et juridique des pouvoirs d’un envoyé, d’un mandataire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420d84d4-9e9b-400f-b22f-1b93c51c6d80",
                                                "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                                "text": "La déesse qui lui fait face, Amesemi, parèdre du dieu-lion Apedemak, pose la main sur la nuque de la candace en geste de légitimation, tandis qu'elle lui apporte le souffle de vie représenté par une chaîne de signes ânkh."
                                            },
                                            {
                                                "example_id": "834e0944-c0e8-4bf3-afb3-03b2891a903e",
                                                "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                                "text": "Après la légitimation de ses pouvoirs auprès de la diète, il est entré en fonctions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206d06d3-58ee-3b1f-b369-a5119bdcf413",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Action de prétendre légitime, un fait, une action, qui ne le paraît pas."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7c54c-8bb7-4f6c-8c36-92b883ea0e19",
                                                "sense_id": "206d06d3-58ee-3b1f-b369-a5119bdcf413",
                                                "text": "Le fait que le chef de l’État mobilise cette rhétorique propre à la résistance patriarcale l’enracine dans le débat public. C’est une forme de légitimation par le sommet de l’Etat de l’idée que ce sont les hommes qui sont victimes de lynchage par les féministes. Cette tactique plus ou moins consciente vise à disqualifier les propos des victimes. C’est consternant», analyse la philosophe féministe Camille Froidevaux-Metterie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
