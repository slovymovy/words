                "senses": [
                    {
                        "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                        "entry_id": "26f2e537-7198-3cbe-a8b9-6dc73da94f7b",
                        "glosses": [
                            "nach Betrachtung der Menschenrechtssituation in einem Land zusammengefasste Beurteilung der Lage unter Berücksichtigung von festgestellten Menschenrechtsverletzungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d29cd16-4605-404c-a082-55712e97d28c",
                                "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                                "text": "„Algeriens Menschenrechtsbilanz wurde im Mai 2012 im Rahmen der Universellen Regelmäßigen Überprüfung des UN-Menschenrechtsrats begutachtet.“"
                            },
                            {
                                "example_id": "39b23c3c-f916-4461-9866-60cc5ce22b92",
                                "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                                "text": "„Seit Nordkorea durch die Veröffentlichung zur Menschenrechtsbilanz der UN angeprangert wurde, lässt das Land keine Möglichkeit ungenutzt die USA mit diversen Berichten zu schaden.“"
                            },
                            {
                                "example_id": "6524eb11-937f-462f-b85b-688c13c82844",
                                "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                                "text": "„Mit Blick auf Afghanistan streckt die Regierung die Fühler zu Usbekistan aus, das von allen ehemaligen Sowjetrepubliken eine der schlechtesten Menschenrechtsbilanzen hat.“"
                            },
                            {
                                "example_id": "c37c74e3-2dfb-4b86-ab02-543ce5358229",
                                "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                                "text": "„Außenamtssprecherin Jiang sagte am Donnerstag, im Menschenrechtsrat der Vereinten Nationen in Genf hätten die meisten Staaten die Menschenrechtsbilanz Chinas als positiv anerkannt.“"
                            },
                            {
                                "example_id": "c3b4bf1a-e25f-4efc-817f-72a9191b21c1",
                                "sense_id": "0d9ac7dc-0fa8-3da6-a32d-a1f188e54992",
                                "text": "„Zwar mögen einige Idealisten die Luxuspauschaltrips zum Wohle von Frieden, Völkerverständigung und Fairness auf sich nehmen, doch dem Gros glaubt keiner mehr Selbstlosigkeit, seit das Komitee ohne Skrupel seine Spiele geschäftstüchtig an höchstbietende Bewerber verhökert: So landete Olympia 2008 trotz miserabler Menschenrechtsbilanzen in China, weil der Boommarkt Rekordrenditen versprach“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
