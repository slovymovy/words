                                        "glosses": [
                                            "Instrument de musique, longue épinette à un ou plusieurs claviers dont les cordes sont de métal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5a3f04-91df-4bfb-b1c6-f493bff2e877",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Il entendit Herman jouer sa Coquette, pièce de clavecin qui faisait fureur dans les salons."
                                            },
                                            {
                                                "example_id": "4c7ba97a-9263-4008-82c1-2eaa70f4ce2c",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Tenant dans ses bras Marie, âgée de trois ans, il la présentait avec orgueil aux ambassadeurs étrangers et voulait qu'elle jouât du clavecin en leur présence. C’était merveille de voir courir de si faibles doigts sur les touches avec précision et rapidité."
                                            },
                                            {
                                                "example_id": "5c32dc9e-3b29-4ae9-946a-1aececfeb3f0",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Un instant après on entendit Andrée attaquer vigoureusement les touches de son clavecin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
