                "senses": [
                    {
                        "sense_id": "21d3f770-71bb-3d6b-baaf-0b03bf29c77f",
                        "entry_id": "b5046be8-9e7f-3b68-9d03-f9b56416f45b",
                        "glosses": [
                            "Verwalter oder Aufsichtsbeamter eines größeren Anwesens wie einer Burg oder eines Schlosses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa94222-79eb-4bd9-8858-fd214becd203",
                                "sense_id": "21d3f770-71bb-3d6b-baaf-0b03bf29c77f",
                                "text": "„Lange zogen wir die Glocke, bis schließlich der Kastellan erschien.“"
                            },
                            {
                                "example_id": "7a17914a-330b-45b8-84f6-9d78171960ad",
                                "sense_id": "21d3f770-71bb-3d6b-baaf-0b03bf29c77f",
                                "text": "„Und so wandte man sich denn auch rasch entschlossen dem Kastellan zu, freilich nicht ohne sein Visàvis, den nach links hin stehenden Küster, mit einem hoffnunggebenden Gruße gestreift zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c64a6663-08e8-4e7d-a270-8a17d8ef5ec0",
                        "source_entry_id": "b5046be8-9e7f-3b68-9d03-f9b56416f45b",
                        "source_sense_id": "21d3f770-71bb-3d6b-baaf-0b03bf29c77f",
                        "source_sense_description": "Verwalter oder Aufsichtsbeamter eines größeren Anwesens wie einer Burg oder eines Schlosses",
