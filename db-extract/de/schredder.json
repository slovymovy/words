                    {
                        "sense_id": "469cf5e7-3b5f-34f3-8615-e4be04617195",
                        "entry_id": "2e58fa4c-48b2-3fff-817e-c6692a6d85bb",
                        "glosses": [
                            "mechanisches Gerät zum Zerkleinern von unterschiedlichsten Materialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd96961-321d-41d1-877e-32a17cbf8ede",
                                "sense_id": "469cf5e7-3b5f-34f3-8615-e4be04617195",
                                "text": "Ein Schredder zum Zerkleinern von Gartenabfällen wird auch als Häcksler bezeichnet."
                            },
                            {
                                "example_id": "6b41660b-2ecd-4c58-9fbb-6dc19542f52d",
                                "sense_id": "469cf5e7-3b5f-34f3-8615-e4be04617195",
                                "text": "Oft wird auch der Aktenvernichter als Schredder angesprochen."
                            },
                            {
                                "example_id": "d37985de-457c-41e3-8f74-28493d1ad839",
                                "sense_id": "469cf5e7-3b5f-34f3-8615-e4be04617195",
                                "text": "Der Schredder zerpflückt die [Elektro-]Teile regelrecht. Auch Verbundstoffe fallen auseinander, zum Beispiel Kunststoffe vom Metall oder Schrauben aus einem Blech."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b7f4781-cedc-329f-bd9c-d85a5cc32b99",
                        "entry_id": "2e58fa4c-48b2-3fff-817e-c6692a6d85bb",
                        "glosses": [
                            "Computerprogramm für das unwiederbringliche Löschen von Daten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90790e4-e0f0-470a-b17d-667fa99297f7",
                                "sense_id": "3b7f4781-cedc-329f-bd9c-d85a5cc32b99",
                                "text": "Der Schredder soll verhindern, dass die Daten auf einer Festplatte nach dem Entsorgen der Festplatte von anderen gelesen werden können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
