                "senses": [
                    {
                        "sense_id": "a47dffb6-d201-359e-990e-afb81b9ba5c7",
                        "entry_id": "d4700a61-b9e9-3206-8ea1-c3b502b14e89",
                        "glosses": [
                            "alle transacties waarbij geld en goederen van eigenaar verwisselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbfed779-080d-4cb8-bd2d-d3329c598e5c",
                                "sense_id": "a47dffb6-d201-359e-990e-afb81b9ba5c7",
                                "text": "Goed. Laten we beginnen met de Conversion Rate. Het ligt allemaal nogal voor de hand, maar als er geen echte aankopen werden gedaan en niet werd aangespoord tot echt handelsverkeer, zou de Cirkel niet bestaan, niet groeien en het sluiten van de cirkel niet dichter kunnen benaderen. Wij zijn er om als toegangspoort tot alle informatie ter wereld te dienen, maar we steunen op adverteerders die via ons klanten hopen te bereiken, toch?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe791025-51f1-37bb-bc7e-c19338323568",
                        "entry_id": "d4700a61-b9e9-3206-8ea1-c3b502b14e89",
                        "glosses": [
                            "alle vervoer dat verooraakt wordt en betrekking heeft op de handel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843b3ccc-b463-48ca-b264-571916853320",
                                "sense_id": "fe791025-51f1-37bb-bc7e-c19338323568",
                                "text": "Toerisme zorgt voor nieuw leven in een stadje dat in de zeventiende eeuw als vesting was aangelegd, als grensplaats met veel handelsverkeer altijd druk en levendig was geweest, maar sinds de jaren zeventig, tachtig, mede door de aanleg van de A7, die Nieuweschans links liet liggen, wat was ingeslapen."
                            }
                        ]
                    }
