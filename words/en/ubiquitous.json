{
    "word_family": [
        "ubiquity",
        "ubiquitously",
        "ubiquitousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc2de8a9-ecd6-3d22-8c72-8c73a338bcfe",
                    "sense_definition": "Found or appearing everywhere; very common and widespread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the modern world, smartphones have become <w>ubiquitous</w> across all age groups.",
                            "target_lang_translations": {
                                "ru": "В современном мире смартфоны стали <w>повсеместными</w> среди всех возрастных групп.",
                                "de": "In der modernen Welt sind Smartphones bei allen Altersgruppen <w>allgegenwärtig</w> geworden.",
                                "zh": "在现代社会，智能手机在各个年龄段都变得<w>无处不在</w>。"
                            }
                        },
                        {
                            "text": "The <w>ubiquitous</w> presence of coffee shops in this city makes it easy to find a drink.",
                            "target_lang_translations": {
                                "ru": "<w>Повсеместное</w> присутствие кофеен в этом городе позволяет легко найти напиток.",
                                "de": "Die <w>allgegenwärtige</w> Präsenz von Cafés in dieser Stadt macht es leicht, ein Getränk zu finden.",
                                "zh": "这座城市里<w>随处可见</w>的咖啡馆让人很容易就能买到饮料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "common",
                        "pervasive",
                        "widespread"
                    ],
                    "antonyms": [
                        "rare",
                        "scarce",
                        "uncommon"
                    ],
                    "common_phrases": [
                        "ubiquitous presence",
                        "become ubiquitous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встречающийся или появляющийся повсюду; очень распространенный и широко известный.",
                        "de": "Überall anzutreffen oder vorkommend; sehr verbreitet und weit verbreitet.",
                        "zh": "指在各处都能见到或出现；非常普遍且广泛分布的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повсеместный",
                                "target_lang_sense_clarification": "встречающийся повсюду"
                            },
                            {
                                "target_lang_word": "вездесущий",
                                "target_lang_sense_clarification": "кажущийся присутствующим везде"
                            },
                            {
                                "target_lang_word": "широко распространенный",
                                "target_lang_sense_clarification": "встречающийся во многих местах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "allgegenwärtig",
                                "target_lang_sense_clarification": "überall und jederzeit vorhanden"
                            },
                            {
                                "target_lang_word": "weit verbreitet",
                                "target_lang_sense_clarification": "an vielen Orten anzutreffen"
                            },
                            {
                                "target_lang_word": "überall vorhanden",
                                "target_lang_sense_clarification": "an jedem Ort präsent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普遍的",
                                "target_lang_sense_clarification": "指在很多地方都能见到"
                            },
                            {
                                "target_lang_word": "无处不在的",
                                "target_lang_sense_clarification": "强调在各个地方都有出现"
                            },
                            {
                                "target_lang_word": "广泛分布的",
                                "target_lang_sense_clarification": "指分布范围很广"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e964613-b452-3006-b03e-85b348af8da5",
                    "sense_definition": "Existing or being everywhere at the same time; <w>omnipresent</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omnipresence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many religions describe their deity as a <w>ubiquitous</w> force that exists throughout the universe.",
                            "target_lang_translations": {
                                "ru": "Многие религии описывают свое божество как <w>вездесущую</w> силу, существующую во всей вселенной.",
                                "de": "Viele Religionen beschreiben ihre Gottheit als eine <w>allgegenwärtige</w> Kraft, die im gesamten Universum existiert.",
                                "zh": "许多宗教将神描述为一种存在于整个宇宙中的<w>无所不在</w>的力量。"
                            }
                        },
                        {
                            "text": "The philosopher argued that the <w>ubiquitous</w> nature of time makes it impossible to escape.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>вездесущая</w> природа времени делает невозможным побег от него.",
                                "de": "Der Philosoph argumentierte, dass die <w>allgegenwärtige</w> Natur der Zeit es unmöglich macht, ihr zu entkommen.",
                                "zh": "那位哲学家认为，时间<w>无所不在</w>的本质使其无法逃避。"
                            }
                        }
                    ],
                    "synonyms": [
                        "omnipresent",
                        "ever-present"
                    ],
                    "antonyms": [
                        "localized",
                        "absent"
                    ],
                    "common_phrases": [
                        "ubiquitous nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или находящийся везде одновременно; вездесущий.",
                        "de": "Überall gleichzeitig existierend oder vorhanden; omnipräsent.",
                        "zh": "指同时存在于任何地方；无所不在的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вездесущий",
                                "target_lang_sense_clarification": "присутствующий везде одновременно"
                            },
                            {
                                "target_lang_word": "всеобъемлющий",
                                "target_lang_sense_clarification": "охватывающий всё"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "allgegenwärtig",
                                "target_lang_sense_clarification": "gleichzeitig an allen Orten präsent"
                            },
                            {
                                "target_lang_word": "ubiquitär",
                                "target_lang_sense_clarification": "allgegenwärtig, fachsprachlich für überall verbreitet"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无所不在的",
                                "target_lang_sense_clarification": "指同时存在于所有地方"
                            },
                            {
                                "target_lang_word": "遍布各处的",
                                "target_lang_sense_clarification": "指覆盖了所有空间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
