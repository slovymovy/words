                ],
                "senses": [
                    {
                        "sense_id": "52af8837-8617-3cc0-9e22-4f049ab320d1",
                        "entry_id": "d0cee758-e3f2-3d02-99cb-d56de1a83640",
                        "glosses": [
                            "Qui effleure presque à l’horizontale un obstacle, en parlant d’un rayon lumineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a49148b-ea24-426c-ba0c-6cc1db777f19",
                                "sense_id": "52af8837-8617-3cc0-9e22-4f049ab320d1",
                                "text": "Alors une lueur frisante arrivait de l’horizon ; un reflet traînant, faisant paraître plus sombre le dôme de ce ciel, se répandait sur les crêtes blanches agitées."
                            },
                            {
                                "example_id": "b395553c-2040-4f07-b995-bb7746a6c421",
                                "sense_id": "52af8837-8617-3cc0-9e22-4f049ab320d1",
                                "text": "Les toits, les flaques de boue, les vitres des lucarnes et des fenêtres étincelaient, tout éclaboussés de clartés frisantes, dans le rayonnement du jour triomphal."
                            }
                        ]
                    },
                    {
                        "sense_id": "19d3dc63-4ad8-32f1-b911-f4ba854b5b12",
                        "entry_id": "d0cee758-e3f2-3d02-99cb-d56de1a83640",
                        "glosses": [
                            "Qui frise, en parlant d’une barbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77705495-a700-4a4d-a4ce-a1fdd6c0a724",
                                "sense_id": "19d3dc63-4ad8-32f1-b911-f4ba854b5b12",
                                "text": "Les barbes sont longues, frisantes, les cheveux ondulent, tombent en papillotes grasses sur la blancheur des tempes."
                            },
                            {
                                "example_id": "ab0e6c34-fbb4-454e-96d7-92d3805521bb",
                                "sense_id": "19d3dc63-4ad8-32f1-b911-f4ba854b5b12",
                                "text": "Il avait déjà vingt et un ans, il était d’une beauté délicate, un visage clair avec de grands yeux bruns, de longs cheveux bouclés, une barbe légère et frisante."
                            }
                        ]
                    },
                    {
                        "sense_id": "844a883e-b502-3ff5-a94c-ea3c8d88a980",
                        "entry_id": "d0cee758-e3f2-3d02-99cb-d56de1a83640",
                        "glosses": [
                            "Qui permet de friser les cheveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71371603-ac4e-471a-aba4-5c5b348e030f",
                                "sense_id": "844a883e-b502-3ff5-a94c-ea3c8d88a980",
                                "text": "Il faut ensuite appliquer une lotion frisante pour casser l’ondulation naturelle des cheveux par la dilatation de la membrane des fibres."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
