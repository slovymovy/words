                        "examples": [
                            {
                                "example_id": "6f1e91b4-164d-4981-8204-c3e24647bde2",
                                "sense_id": "f533064e-54a1-32d7-886a-fabe4c96b14d",
                                "text": "Колесо провернулось, и прежде чем Гид утопил педаль сцепления, сделало пол-оборота."
                            },
                            {
                                "example_id": "93ac6124-94de-48f5-82a8-0390fe982c80",
                                "sense_id": "f533064e-54a1-32d7-886a-fabe4c96b14d",
                                "text": "Первый доклад о раскрытии парашюта мы получили от самого Волынова, но перед этим он доложил: «Корабль вращается со скоростью пол-оборота в секунду»."
                            }
                        ]
                    }
