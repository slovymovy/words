                        "examples": [
                            {
                                "example_id": "67e901cb-a800-4c8e-92a1-e221425261b4",
                                "sense_id": "379bbede-bf41-3846-ba79-35e8119bf6b7",
                                "text": "„Besagter Aktivist schlug nun vor, zwei Mexica, ein Pilli und ein Macehualli, ein Adliger und ein Gemeiner, sollten sich melden und sich bereiterklären, sich für die Gemeinschaft aufzuopfern.“"
                            },
                            {
                                "example_id": "6d99860e-d336-4bc9-8dcc-854ded5954be",
                                "sense_id": "379bbede-bf41-3846-ba79-35e8119bf6b7",
                                "text": "„Einfache Macehualtin konnten demnach den Gobernador verklagen, was mit seinem Autoritätsverlust einherging.“"
                            }
                        ],
