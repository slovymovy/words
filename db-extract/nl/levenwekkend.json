                        "examples": [
                            {
                                "example_id": "49e46b3b-678b-4cfa-acc0-da21d648d2ee",
                                "sense_id": "fb8ecf90-67c4-30d5-95f6-605f0779ac38",
                                "text": "Griselle, het kopje scheef, gaf enkele als levenwekkend bedoelde tikjes met een pootje tegen het ineengekronkelde lijf."
                            },
                            {
                                "example_id": "2e8188c8-f0ee-44c5-860c-2180d3e07043",
                                "sense_id": "fb8ecf90-67c4-30d5-95f6-605f0779ac38",
                                "text": "Naar Bijbels-reformatorisch inzicht is de prediking hét heilsmiddel waardoor de wedergeboorte zich in het leven van de gemeente voltrekt (1 Petr. 1:23). God Zelf wil door Zijn Woord tot Zijn gemeente spreken. Levenwekkend, zodat dode zondaren levend worden door de adem van Zijn Geest."
                            }
                        ]
                    }
