                ],
                "senses": [
                    {
                        "sense_id": "67d76fe6-65d4-3d9e-8e04-81f86e727fa7",
                        "entry_id": "6be1efcc-2997-3e32-bf1a-e24afe24f970",
                        "glosses": [
                            "Angehöriger der Hitlerjugend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce26ffc-8603-4d2b-8b3e-b792d4f0be5f",
                                "sense_id": "67d76fe6-65d4-3d9e-8e04-81f86e727fa7",
                                "text": "„Angeblich halten sich in den Wäldern des Isergebirges noch vereinzelt bewaffnete Hitlerjungen versteckt, die vom Krieg nicht lassen wollen, so genannte Werwölfe.“"
                            },
                            {
                                "example_id": "fb83060a-171d-43a1-8421-7ff710327ed4",
                                "sense_id": "67d76fe6-65d4-3d9e-8e04-81f86e727fa7",
                                "text": "„Vor dem Ausgang des Führerbunkers reichte Hitler den zur Geburtstagsgratulation angetretenen Soldaten müde die Hand, tätschelte einige der Hitlerjungen und zeichnete den einen oder anderen mit dem Eisernen Kreuz aus.“"
                            },
                            {
                                "example_id": "68c77560-8d3f-4cb0-9d69-dd73f4d823d4",
                                "sense_id": "67d76fe6-65d4-3d9e-8e04-81f86e727fa7",
                                "text": "„Einem der ostpreußischen Hitlerjungen, Martin Bergau, ist zu verdanken, dass das Verbrechen nicht in Vergessenheit geriet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
