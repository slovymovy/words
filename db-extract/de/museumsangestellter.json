                        "examples": [
                            {
                                "example_id": "3b466142-4270-4f96-a652-e1a80acc7313",
                                "sense_id": "ac3fcffa-4d90-3ce2-a91e-1e9b7d8ad832",
                                "text": "„Ich nehme an, dass die Museumsangestellten trotz der alarmierenden Beobachtung des nervösen Wärters einige Monate zuvor kaum auf solche Einzelheiten achteten, da sie nur zu gut an den ständigen Anblick sonderbarer Exponate gewöhnt waren.“"
                            }
                        ],
