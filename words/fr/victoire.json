                        "fêter la victoire",
                        "belle victoire"
                    ]
                },
                {
                    "sense_id": "e1a56f52-480d-385b-8b75-9d66af45f34d",
                    "sense_definition": "Avantage ou issue favorable qu'une armée remporte sur l'ennemi au cours d'une guerre ou d'une bataille.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "succes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général a annoncé une <w>victoire</w> militaire décisive à l'issue de plusieurs semaines d'affrontements."
                        },
                        {
                            "text": "Cette grande <w>victoire</w> a permis de libérer enfin tout le territoire occupé par l'ennemi."
                        }
                    ],
                    "synonyms": [
                        "triomphe"
                    ],
                    "antonyms": [
