{
    "word_family": [
        "furtively",
        "furtiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b97841d0-afed-3649-b339-62f0f8f8cb33",
                    "sense_definition": "Done with evasive or guilty secrecy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cast a <w>furtive</w> glance at his watch during the long meeting.",
                            "target_lang_translations": {
                                "nl": "Hij wierp tijdens de lange vergadering een <w>steelse</w> blik op zijn horloge.",
                                "ru": "Во время долгого совещания он бросил <w>украдкой</w> взгляд на часы."
                            }
                        },
                        {
                            "text": "The spy made a <w>furtive</w> attempt to hide the secret documents.",
                            "target_lang_translations": {
                                "nl": "De spion deed een <w>heimelijke</w> poging om de geheime documenten te verbergen.",
                                "ru": "Шпион предпринял <w>тайную</w> попытку спрятать секретные документы."
                            }
                        }
                    ],
                    "synonyms": [
                        "clandestine",
                        "surreptitious",
                        "secretive",
                        "covert"
                    ],
                    "common_phrases": [
                        "furtive glance",
                        "furtive look"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gedaan met ontwijkende of schuldige geheimzinnigheid.",
                        "ru": "Совершаемый украдкой, тайком, с чувством вины или стремлением избежать огласки."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "heimelijk",
                                "target_lang_sense_clarification": "geheim of opzettelijk verborgen"
                            },
                            {
                                "target_lang_word": "steels",
                                "target_lang_sense_clarification": "in het geniep, zodat anderen het niet kunnen zien"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "украдчивый",
                                "target_lang_sense_clarification": "о взгляде, движении: тайный, сделанный исподтишка"
                            },
                            {
                                "target_lang_word": "вороватый",
                                "target_lang_sense_clarification": "о поведении или взгляде: виноватый, крадущийся"
                            },
                            {
                                "target_lang_word": "тайный",
                                "target_lang_sense_clarification": "скрытый от других"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62b3dbf3-991d-3d71-a23f-4b366e89ea31",
                    "sense_definition": "Sly or stealthy in behavior or appearance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat moved in a <w>furtive</w> manner as it stalked the bird.",
                            "target_lang_translations": {
                                "nl": "De kat bewoog zich op een <w>stiekeme</w> manier terwijl hij op de vogel joeg.",
                                "ru": "Кошка двигалась <w>крадучись</w>, выслеживая птицу."
                            }
                        },
                        {
                            "text": "His <w>furtive</w> behavior made everyone in the room feel suspicious.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>stiekeme</w> gedrag maakte iedereen in de kamer achterdochtig.",
                                "ru": "Его <w>вороватое</w> поведение вызвало подозрения у всех присутствующих в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "sly",
                        "stealthy",
                        "sneaky"
                    ],
                    "common_phrases": [
                        "furtive manner"
                    ],
                    "target_lang_definitions": {
                        "nl": "Sluw of stiekem in gedrag of uiterlijk.",
                        "ru": "Хитрый, скрытный или крадущийся в поведении или внешнем виде."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stiekem",
                                "target_lang_sense_clarification": "op een manier die niet opgemerkt wil worden"
                            },
                            {
                                "target_lang_word": "sluw",
                                "target_lang_sense_clarification": "bedrieglijk of listig"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скрытный",
                                "target_lang_sense_clarification": "не склонный выдавать свои намерения"
                            },
                            {
                                "target_lang_word": "крадущийся",
                                "target_lang_sense_clarification": "осторожный, бесшумный в движениях"
                            },
                            {
                                "target_lang_word": "вороватый",
                                "target_lang_sense_clarification": "подозрительный, хитрый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88dc0df5-9035-33f3-ad8e-86008cc754ef",
                    "sense_definition": "Acquired by theft or taken stealthily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief enjoyed the <w>furtive</w> gains of his illegal activities.",
                            "target_lang_translations": {
                                "nl": "De dief genoot van de <w>gestolen</w> opbrengsten van zijn illegale activiteiten.",
                                "ru": "Вор наслаждался <w>краденой</w> наживой от своей незаконной деятельности."
                            }
                        },
                        {
                            "text": "He lived comfortably on his <w>furtive</w> gains from the robbery.",
                            "target_lang_translations": {
                                "nl": "Hij leefde comfortabel van zijn <w>gestolen</w> winst uit de overval.",
                                "ru": "Он безбедно жил на свои <w>наворованные</w> доходы от ограбления."
                            }
                        }
                    ],
                    "synonyms": [
                        "stolen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verkregen door diefstal of stiekem meegenomen.",
                        "ru": "Добытый воровством или присвоенный тайком (устаревшее)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gestolen",
                                "target_lang_sense_clarification": "door diefstal verkregen"
                            },
                            {
                                "target_lang_word": "diefachtig",
                                "target_lang_sense_clarification": "met de kenmerken van een dief"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "краденый",
                                "target_lang_sense_clarification": "полученный в результате кражи"
                            },
                            {
                                "target_lang_word": "наворованный",
                                "target_lang_sense_clarification": "нечестно нажитый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9d55913-431d-3a24-9f78-7dc2185bafc0",
                    "sense_definition": "Inclined to steal or pilfer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>furtive</w> child was caught taking coins from the desk.",
                            "target_lang_translations": {
                                "nl": "Het <w>diefachtige</w> kind werd betrapt terwijl hij munten van het bureau pakte.",
                                "ru": "<w>Вороватый</w> ребёнок попался, когда брал монеты со стола."
                            }
                        },
                        {
                            "text": "He had a <w>furtive</w> nature that made his coworkers keep their wallets locked.",
                            "target_lang_translations": {
                                "nl": "Hij had een <w>diefachtig</w> karakter waardoor zijn collega's hun portemonnees op slot hielden.",
                                "ru": "У него была <w>вороватая</w> натура, из-за чего коллеги держали свои кошельки под замком."
                            }
                        }
                    ],
                    "synonyms": [
                        "thievish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geneigd om te stelen of te graaien.",
                        "ru": "Склонный к воровству или мелким кражам."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "diefachtig",
                                "target_lang_sense_clarification": "met de neiging om te stelen"
                            },
                            {
                                "target_lang_word": "graaierig",
                                "target_lang_sense_clarification": "hebzuchtig of geneigd tot kleine diefstallen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вороватый",
                                "target_lang_sense_clarification": "имеющий привычку воровать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}