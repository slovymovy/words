                        "glosses": [
                            "Fullness, especially of conviction or persuasion; the state of being fully persuaded"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318d3976-2fd6-4743-b765-e989e346751a",
                                "sense_id": "bb60763d-c795-3d6e-81ba-b4e88de9e955",
                                "text": "Massaging themselves into the plerophory that there must be something in the cocksure statements of the various movie executives"
                            },
                            {
                                "example_id": "2724fc39-3725-4f9e-82e3-4bf5f2ee4b36",
                                "sense_id": "bb60763d-c795-3d6e-81ba-b4e88de9e955",
                                "text": "\"...my distrust and hatred of vehicles in motion is partly based on my plerophory that their apparent submission to control is illusory and that they may at their pleasure, and sooner or later will, act on whim.\""
                            },
                            {
                                "example_id": "f88596e4-0bcb-4949-a435-888f659f1b56",
                                "sense_id": "bb60763d-c795-3d6e-81ba-b4e88de9e955",
                                "text": "And this, if I do not mistake, the Apostle means by the plerophory or full assurance of faith."
                            },
                            {
                                "example_id": "865576e7-fbe2-4202-8771-4c8cdb4f2703",
                                "sense_id": "bb60763d-c795-3d6e-81ba-b4e88de9e955",
                                "text": "\"... the advertising departments of all journals threatened falling revenues unless a note of sprightly plerophory were maintained\"."
                            },
                            {
                                "example_id": "d6d95289-d6b9-4798-92b1-6e03d40c1efc",
                                "sense_id": "bb60763d-c795-3d6e-81ba-b4e88de9e955",
                                "text": "\"... I reject the plerophory that Mr. Greve is a murderer.\""
                            }
                        ]
                    }
