                "senses": [
                    {
                        "sense_id": "d94b48d1-67fc-39e4-a7bf-30dc82c113a5",
                        "entry_id": "a04bc8d2-e640-3c5e-9bd5-269e939cf31f",
                        "glosses": [
                            "das Erdgeschoss, das mindestens 1,50 Meter über der Straßenhöhe liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f86f07-814f-4f46-ac36-d0b1e3ecd3a5",
                                "sense_id": "d94b48d1-67fc-39e4-a7bf-30dc82c113a5",
                                "text": "Herr Müller wohnt im Hochparterre."
                            },
                            {
                                "example_id": "78f9ccbb-66b5-4888-a03f-ae3f7dfac9df",
                                "sense_id": "d94b48d1-67fc-39e4-a7bf-30dc82c113a5",
                                "text": "„Dann erklommen sie gemeinsam das Hochparterre im Hause 113.“"
                            },
                            {
                                "example_id": "7b6c6517-32ab-4bc9-8a92-c3bba19fe869",
                                "sense_id": "d94b48d1-67fc-39e4-a7bf-30dc82c113a5",
                                "text": "„Rechts ging es zum Stiegenhaus, der Papa führte sie ins Hochparterre und klopfte.“"
                            },
                            {
                                "example_id": "7a12b30f-52f2-47dd-9bce-078d63f36fbd",
                                "sense_id": "d94b48d1-67fc-39e4-a7bf-30dc82c113a5",
                                "text": "„Ein so schnöder Handel empörte die Menge auf der Straße natürlich, sie riefen aufgeregt durcheinander, begleitet vom Brüllen meiner Großmutter aus dem Hochparterre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
