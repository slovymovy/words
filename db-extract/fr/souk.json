                        ],
                        "examples": [
                            {
                                "example_id": "2dbe532d-a0ea-4d02-a618-5b6582b0d080",
                                "sense_id": "1000d583-f09a-3932-b404-7b1575ff2a9f",
                                "text": "Tout sera bien rangé, personne ne viendra foutre le souk chez moi. Je ne donnerai mon adresse à personne.",
                                "translation": "Everything will be tidy, no one will come and mess shit up at my place. I won't give my address to anyone.",
                                "english": "Everything will be tidy, no one will come and mess shit up at my place. I won't give my address to anyone."
                            }
                        ]
                    }
