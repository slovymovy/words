                "senses": [
                    {
                        "sense_id": "7dd84d4c-121b-3ab5-91da-f09766e98376",
                        "entry_id": "f4a47f8f-082d-35d8-a14f-d399160ce866",
                        "glosses": [
                            "to disappear, to vanish, to get lost"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a24543-918b-4af0-93cd-2f3651b273c2",
                                "sense_id": "7dd84d4c-121b-3ab5-91da-f09766e98376",
                                "text": "Куда́ де́лись мои́ очки́?",
                                "translation": "Where did I put my glasses? / What did I do with my glasses?",
                                "english": "Where did I put my glasses? / What did I do with my glasses?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c0a629-ae8e-303e-a318-2e0e08949e73",
                        "entry_id": "f4a47f8f-082d-35d8-a14f-d399160ce866",
                        "glosses": [
                            "to hide, to escape, to get away"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "09902f7d-ac02-47db-ae99-54e8a43d3669",
                                "sense_id": "c7c0a629-ae8e-303e-a318-2e0e08949e73",
                                "text": "Она́ не зна́ла, куда́ де́ться от стыда́.",
                                "translation": "She did not know where to hide out of embarrassment.",
                                "english": "She did not know where to hide out of embarrassment."
                            },
                            {
                                "example_id": "9ea8f542-cad0-491a-b3bc-4567c1f12e28",
                                "sense_id": "c7c0a629-ae8e-303e-a318-2e0e08949e73",
                                "text": "Куда́ мне де́ться?",
                                "translation": "Where shall I go? Where can I hide?",
                                "english": "Where shall I go? Where can I hide?"
                            },
                            {
                                "example_id": "b2f956f6-60b9-4543-ba9c-8d05688b2c76",
                                "sense_id": "c7c0a629-ae8e-303e-a318-2e0e08949e73",
                                "text": "не́куда де́ться",
                                "translation": "there is nowhere to go",
                                "english": "there is nowhere to go"
                            }
                        ]
                    },
