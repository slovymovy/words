                                "target_senses": [
                                    {
                                        "sense_id": "6c13711b-a813-3b2b-b386-35a1ccc17db5",
                                        "entry_id": "569693d5-6cb1-31f3-90e0-4c0efee44935",
                                        "glosses": [
                                            "A flowering plant of species Nardostachys jatamansi, in the valerian family, that grows in the Himalayas and is used as a perfume, an incense, a sedative, and an herbal medicine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7224723f-1ed2-3550-b4dc-c475577ca595",
                                        "entry_id": "569693d5-6cb1-31f3-90e0-4c0efee44935",
                                        "glosses": [
                                            "A fragrant oil from the plant, formerly much prized."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771aca0f-438e-458f-93b0-a46cfe380091",
                                                "sense_id": "7224723f-1ed2-3550-b4dc-c475577ca595",
                                                "text": "[…]there cam a womã with an alablaſter boxe of oyntment / called narde / that was pure and coſtly / and ſhe brake the boxe ãd powred it on his heed."
                                            },
                                            {
                                                "example_id": "6060253b-ad43-4bd2-95bd-5b399ddb79b9",
                                                "sense_id": "7224723f-1ed2-3550-b4dc-c475577ca595",
                                                "text": "The Roman poet Horace refers to a lecherous old fop \"scented with nard.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901fc879-471f-3265-b2c8-45bc9e09ab71",
                                        "entry_id": "569693d5-6cb1-31f3-90e0-4c0efee44935",
                                        "glosses": [
                                            "American spikenard (Aralia racemosa), a North American perennial herb with an aromatic root."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58abf870-5351-3cdc-a1c9-373644bc6e1d",
                                        "entry_id": "6cc546fa-9899-3fc8-9a24-869f1fc4bba2",
                                        "glosses": [
                                            "A testicle."
                                        ],
                                        "tags": [
                                            "US",
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f79d332f-d2fe-4583-8238-8396d02a2c1e",
                                                "sense_id": "58abf870-5351-3cdc-a1c9-373644bc6e1d",
                                                "text": "The soccer ball hit me right in the nards!"
                                            },
                                            {
                                                "example_id": "9be89d05-3ebd-4d1b-a1d3-5dccac993045",
                                                "sense_id": "58abf870-5351-3cdc-a1c9-373644bc6e1d",
                                                "text": "I’m sure whoever was in charge must have been one of the last of the Fulda Fucktards, you know, those generals who spent their nard-drop years training to defend West Germany from Ivan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e352555-2857-3b41-b597-fc7d012e83a6",
                                        "entry_id": "11b11ab6-14d0-3c64-a5ca-c1ccb289e532",
