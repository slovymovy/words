                        "entry_id": "79edf454-ffc8-3081-bc08-e5b262f595c3",
                        "glosses": [
                            "Qui fait penser à Absalon et à sa chevelure abondante."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "9b08ba4e-2ffd-4ddc-abfe-d155fb97fe2b",
                                "sense_id": "b809156b-556b-3ff8-8482-ddc9159d568c",
                                "text": "Sa haute taille, ses yeux verts, sa chevelure absalonienne tirant sur le roux, ne lui eussent pas permis, s’il l’eût voulu, de passer inaperçu."
                            },
                            {
                                "example_id": "a0adefe4-18c9-4e41-bf9c-f3d301fb4f24",
                                "sense_id": "b809156b-556b-3ff8-8482-ddc9159d568c",
                                "text": "Vous savez combien les anars affectionnaient les tignasses absaloniennes, n’est-ce pas ?"
                            }
                        ]
                    }
