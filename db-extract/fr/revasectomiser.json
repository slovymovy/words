                "senses": [
                    {
                        "sense_id": "9004c49c-5d65-3350-9d50-e5477b6b767a",
                        "entry_id": "2f1a41eb-e9ed-3cac-ac45-e96298887fb7",
                        "glosses": [
                            "Vasectomiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf752d1-9865-44c2-b8ec-e8c90481a2f1",
                                "sense_id": "9004c49c-5d65-3350-9d50-e5477b6b767a",
                                "text": "Ben moi mon chum l'a déjà fait une fois, il se l'est fait rebrancher 11 ans plus tard et il va se faire revasectomiser le temps venu."
                            },
                            {
                                "example_id": "feca4fd5-d8dc-4acf-8ac6-0d016ceac6f1",
                                "sense_id": "9004c49c-5d65-3350-9d50-e5477b6b767a",
                                "text": "J'adore le concierge qui sème la zizanie entre les filles qui vont jusqu'à se battre dans la cafétéria devant un Todd surexcité, tout comme j'adore les cafouillages de JD sur sa relation avec Turk (si, si, ils forment bien un couple !) et puis Cox qui se fait vasectomiser, dévasectomiser puis revasectomiser pour faire plaisir à Jordan, royale comme d'habitude !"
                            }
                        ]
                    }
