                            {
                                "example_id": "05a77f16-fc03-4cc9-8753-542c5b8a0fad",
                                "sense_id": "b9f2e14f-eab6-3a1d-87de-238511252fc9",
                                "text": "“Ik laat mijn eigen kleinkinderen gewoon op kunstgras spelen”, zegt bestuurder Kees van Oostenrijk van Band en Milieu, de organisatie die verantwoordelijk is voor de inzameling en het hergebruik van alle acht miljoen afgedankte banden per jaar in Nederland. Het rubbergranulaat op kunstgrasvelden speelt een belangrijke rol in de recyclingketen van de bandenindustrie. Van het materiaal van ingezamelde banden wordt 70 procent hergebruikt, waarvan een groot deel als opvulling in kunstgras."
                            },
                            {
                                "example_id": "8d434f95-0afd-4293-949b-b89537727047",
                                "sense_id": "b9f2e14f-eab6-3a1d-87de-238511252fc9",
                                "text": "De opvulling van de gaten in het lesrooster is heel lastig voor scholen."
                            }
                        ]
                    }
