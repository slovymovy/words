                    },
                    {
                        "translation_id": "ae46ba18-e423-4dbe-8917-9652e1e981c1",
                        "source_entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
                        "source_sense_description": "about or near that place",
                        "target_lang_word": "in der Gegend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "69364418-1e14-4d97-b34f-968805803cf1",
                        "source_entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
                        "source_sense_description": "about or near that place",
                        "target_lang_word": "um die Ecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "um die Ecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b1a4461-ae0e-32e0-8c87-36593c9fa6b2",
                                        "entry_id": "e74a2308-05c2-3a89-a178-7621e5504511",
                                        "glosses": [
                                            "in einem nahezu rechten Winkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e5f9c4-81d7-413a-a741-73aae4731a66",
                                                "sense_id": "3b1a4461-ae0e-32e0-8c87-36593c9fa6b2",
                                                "text": "„Mike. Sie biegen gleich um die Ecke. Geh ihnen entgegen, warte in der Nische vor der Kurve und beweg dich nicht.“"
                                            },
                                            {
                                                "example_id": "17b9e889-ad0c-4ad8-b3bc-75b731631980",
                                                "sense_id": "3b1a4461-ae0e-32e0-8c87-36593c9fa6b2",
                                                "text": "So hat zum Beispiel die Tatsache, daß wir um die Ecke hören können, ihre Ursache in der Beugung der Schallwellen."
                                            },
                                            {
                                                "example_id": "88ff8456-41ab-4b06-8eac-cf063fa92c93",
                                                "sense_id": "3b1a4461-ae0e-32e0-8c87-36593c9fa6b2",
                                                "text": "Diogenes Pendergast schlenderte um die Ecke der Via dello Sprone und zurück in die Via Santo Spirito. Constance Greene war fort, denn sie hatte sich in die Via dei Coverelli geschlichen, so wie er es vorausgesehen hatte. Und jetzt würde sie, im Hinterhalt, darauf warten, dass er um die Ecke bog. […] Ungeheuer vorsichtig spähte er um die Ecke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                        "entry_id": "e74a2308-05c2-3a89-a178-7621e5504511",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2014b059-a33e-43fa-a942-53e151fc9b7f",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "„Ich hole nur schnell Brötchen, bin gleich wieder da, der Bäcker ist ja um die Ecke.“"
                                            },
                                            {
                                                "example_id": "315c50fd-b3d0-47d5-9db9-0395154e7432",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "„Die Deutschen gehen gerne in den Supermarkt um die Ecke und fragen sich dann, warum soll ich online bestellen, wenn direkt um die Ecke der Supermarkt ist?“"
                                            },
                                            {
                                                "example_id": "195c336e-ea5f-4f7a-abc5-352b7d985c76",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "Wer eine Originalpizza essen will, geht zum Italiener um die Ecke."
                                            },
                                            {
                                                "example_id": "18240101-08d6-40fe-ae83-5ca6fd2fe6d5",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "Zigaretten, Getränke, Zeitungen und Süßigkeiten: der Kiosk um die Ecke gehört zu deutschen Städten dazu."
                                            },
                                            {
                                                "example_id": "3f1a86b5-673d-4e10-b0e5-36638bc4228f",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "[Trier:] Wenn sie jetzt durch das römische Tor Porta Nigra in die Altstadt kommen, wird ihnen gleich um die Ecke Karl Marx persönlich den Weg zu seinem Geburtshaus weisen."
                                            },
                                            {
                                                "example_id": "91e17484-c71a-4f44-bcc9-5e36aac81f79",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "Dass wir mit ein und demselben Auto zum Einkaufen um die Ecke fahren und in den Urlaub nach Italien, das wird sich erledigt haben."
                                            },
                                            {
                                                "example_id": "5d548085-29f0-4a8d-955f-728fd321e276",
                                                "sense_id": "4f7b8ab5-a846-388c-843c-ce05c0f1d715",
                                                "text": "Es ist still in der Iuliu Barasch Straße im historischen jüdischen Viertel von Bukarest, Vacaresti. Die allermeisten Juden sind längst ausgewandert […]. Aber gleich um die Ecke stößt man auf reges jüdisches Leben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
