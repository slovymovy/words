                        "examples": [
                            {
                                "example_id": "320897e7-01be-4902-a5a8-435f8920638a",
                                "sense_id": "f2848461-7209-3ca7-a52a-0de84fb67093",
                                "text": "Un enfant strabique, même opéré, n’aura jamais une bonne vision du relief (vision binoculaire) et aura des troubles de localisation spatiale."
                            },
                            {
                                "example_id": "a628121d-788a-41aa-9631-e8c8fc762159",
                                "sense_id": "f2848461-7209-3ca7-a52a-0de84fb67093",
                                "text": "Ils se blotissent dans un coin de porte, les yeux brûlants, strabiques, le menton en danse."
                            }
                        ]
