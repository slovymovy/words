                                    {
                                        "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                                        "entry_id": "7e93fcd9-9b28-3b71-832b-1af2e5081c46",
                                        "glosses": [
                                            "Qui manque d’honnêteté, qui est contraire à l’honneur, à la probité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015cb2af-2f44-4c13-bd97-5cb8dd8993ab",
                                                "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                                                "text": "Il a eu avec moi un procédé malhonnête."
                                            },
                                            {
                                                "example_id": "0628767d-21dc-4f24-91c9-ef1bbce6bf2f",
                                                "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                                                "text": "Cette action est d’un malhonnête homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                                        "entry_id": "7e93fcd9-9b28-3b71-832b-1af2e5081c46",
                                        "glosses": [
                                            "Qui est contraire à la civilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a440f940-c0fc-4d41-963c-429a123a1b55",
                                                "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                                                "text": "Voilà un enfant bien malhonnête."
                                            },
                                            {
                                                "example_id": "0565e95a-289c-4c19-88bd-6f2c1ef92b34",
                                                "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                                                "text": "Il a un ton malhonnête, des manières malhonnêtes. Dans ce sens, il suit généralement les noms de personnes auxquels on le joint ; dans le premier sens, au contraire, il les précède ordinairement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b41de9-f0d2-4875-8fb6-078def8ce9e6",
                        "source_entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "source_sense_description": "dishonest",
                        "target_lang_word": "unehrlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unehrlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c74a8983-6bd6-30ca-8314-36f1662d1756",
                                        "entry_id": "66b355b8-3566-3426-8a08-217d41894720",
                                        "glosses": [
                                            "mit fremden Eigentum nicht korrekt umgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1181f3-f568-438b-b459-2d0663ac716a",
                                                "sense_id": "c74a8983-6bd6-30ca-8314-36f1662d1756",
                                                "text": "Die Aussagen charakterisierten die Mutter als geldgierig, unehrlich und darauf erpicht, die Krankheit ihres Kindes auszunutzen."
                                            },
                                            {
                                                "example_id": "868d968e-ff7a-4967-92d4-791b176071dc",
                                                "sense_id": "c74a8983-6bd6-30ca-8314-36f1662d1756",
                                                "text": "Chinas korrupte Beamte haben Probleme, ihr unehrlich erworbenes Geld zu verbergen."
                                            },
                                            {
                                                "example_id": "f1e05ea4-3958-4637-acb8-c55f9136f779",
                                                "sense_id": "c74a8983-6bd6-30ca-8314-36f1662d1756",
                                                "text": "Es grummelt im Innern vieler Manager. Sie haben es satt, in der Öffentlichkeit als unfähig, unehrlich oder unersättlich angeprangert zu werden, als verschworene Clique, die sich in Aufsichtsräten und anderen Führungszirkeln gegenseitig kontrolliert und vor Schaden bewahrt - und die deshalb durch ein immer enger geknüpftes Netz von Regeln überwacht werden muss."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23a5815b-5aeb-30d8-8d7d-cfbc9c033bc3",
                                        "entry_id": "66b355b8-3566-3426-8a08-217d41894720",
                                        "glosses": [
                                            "seine wahren Absichten oder Ansichten verbergend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fad4847-ac75-4d22-9d4b-4e18d0c88ec6",
                                                "sense_id": "23a5815b-5aeb-30d8-8d7d-cfbc9c033bc3",
                                                "text": "Ariely: Natürlich sind wir unehrlich, weil wir aus Lügen einen Vorteil ziehen wollen. Aber der Mensch und die Welt sind deutlich komplexer."
                                            },
                                            {
                                                "example_id": "2787f879-c8f1-4b7c-a401-23c50bcf2b14",
                                                "sense_id": "23a5815b-5aeb-30d8-8d7d-cfbc9c033bc3",
                                                "text": "Weber: Die Türkei wird kein Mitglied der EU werden. Die jetzige Diskussion ist unehrlich."
                                            },
                                            {
                                                "example_id": "64fece5c-cdeb-4768-bc49-34d1d0626674",
                                                "sense_id": "23a5815b-5aeb-30d8-8d7d-cfbc9c033bc3",
                                                "text": "Eine Gallup-Umfrage förderte zutage, dass 76 Prozent die Volksvertreter für unehrlich halten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
