        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a434b491-2b1f-35f7-9bdc-40a8d74ca6c0",
                    "sense_definition": "Initialism of real estate agent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "real_estate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>REA</w> showed us several houses in the suburbs.",
                            "target_lang_translations": {
                                "ru": "<w>Агент по недвижимости</w> показал нам несколько домов в пригороде."
                            }
                        },
                        {
                            "text": "You should contact a local <w>REA</w> to help sell your property.",
                            "target_lang_translations": {
                                "ru": "Вам следует связаться с местным <w>риелтором</w>, чтобы помочь продать вашу недвижимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "realtor"
                    ],
                    "common_phrases": [
                        "local REA",
                        "licensed REA"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для агента по недвижимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агент по недвижимости",
                                "target_lang_sense_clarification": "специалист по продаже жилья"
                            },
                            {
                                "target_lang_word": "риелтор",
                                "target_lang_sense_clarification": "профессионал в сфере недвижимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9817b163-d8b6-3480-accb-f7875ef05666",
                    "sense_definition": "Abbreviation of reactive arthritis.",
