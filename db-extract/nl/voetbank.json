                    {
                        "sense_id": "bba96272-cd0f-3cdf-b66b-8efb1c2f72d6",
                        "entry_id": "13532519-3a0b-37d4-9610-00e58c4a98a7",
                        "glosses": [
                            "een verhoginkje waarop je de voeten kunt laten rusten als je op een stoel of bank zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb60ccdf-e2bd-4db2-bcfd-40330ee23780",
                                "sense_id": "bba96272-cd0f-3cdf-b66b-8efb1c2f72d6",
                                "text": "Ook Schaman , een fauteuil met voetbank van Eric Jourdan, sprong er uit door zijn aantrekkelijke, dynamische vormgeving."
                            },
                            {
                                "example_id": "bd05fb93-093f-4d7f-9c3c-046c5271daaf",
                                "sense_id": "bba96272-cd0f-3cdf-b66b-8efb1c2f72d6",
                                "text": "De reeks bestaat naast een driezit, een tweezit en een kleine zetel, ook uit twee verschillende voetbanken en een bijbehorend tapijt"
                            },
                            {
                                "example_id": "a104922e-39f2-4d28-b33f-fee7d41ffd09",
                                "sense_id": "bba96272-cd0f-3cdf-b66b-8efb1c2f72d6",
                                "text": "In de voorkamer stond een antiekrode leren chesterfieldfauteuil zij aan zij met een Louis xv -zetel die was voorzien van een oudroze fluwelen bekleding met een rozenmotief, en een voetbankje in ongeveer dezelfde kleur naast een prachtige achttiende-eeuwse salontafel met elegant houtsnijwerk."
                            }
                        ]
                    }
