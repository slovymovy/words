                    {
                        "sense_id": "c99338bc-e004-31f5-8f72-8f57da7abcb6",
                        "entry_id": "fd4c54c6-57a2-398d-9193-9a1ca9a290aa",
                        "glosses": [
                            "Sortierung des Mülls nach dessen Sorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b77fb9f-6a17-4899-911f-d24c2a4b1885",
                                "sense_id": "c99338bc-e004-31f5-8f72-8f57da7abcb6",
                                "text": "Mit Mülltrennung kann man viel erreichen."
                            },
                            {
                                "example_id": "2ce82024-f2e3-4aef-a9f3-8fb01ae06753",
                                "sense_id": "c99338bc-e004-31f5-8f72-8f57da7abcb6",
                                "text": "„Nichts ist für Ausländer einfacher, als über die Mülltrennung in Deutschland zu lästern.“"
                            },
                            {
                                "example_id": "4dd04116-b165-4c1c-80f5-ff9bf6b259f7",
                                "sense_id": "c99338bc-e004-31f5-8f72-8f57da7abcb6",
                                "text": "„Auf ihren Klimaschutz und ihre Mülltrennung sind die Deutschen stolz wie Oskar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
