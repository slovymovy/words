                                "example_id": "18299cd0-d9ed-4170-b9f4-33de9a5b8157",
                                "sense_id": "1bb94a84-6583-3172-bf8f-6c0d0a8e9bcc",
                                "text": "Yoh! I'm so gatvol of this tjoekie and need a zol to handle these moggy people."
