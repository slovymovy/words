                "senses": [
                    {
                        "sense_id": "977405d5-99d3-3a5c-ab1d-281f5c0fcc8b",
                        "entry_id": "c5b6e20a-8a64-3fbf-a95b-12b44b860544",
                        "glosses": [
                            "Manger du pamplemousse, utiliser le pamplemousse, en particulier en cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "396b93cc-920c-442b-8ace-40eedf9abad8",
                                "sense_id": "977405d5-99d3-3a5c-ab1d-281f5c0fcc8b",
                                "text": "Allez je vous propose de pamplemousser Rose de Floride bien entendu !"
                            },
                            {
                                "example_id": "8f606329-8218-4192-a44f-c7ee5428bfa7",
                                "sense_id": "977405d5-99d3-3a5c-ab1d-281f5c0fcc8b",
                                "text": "Ci fait, j'ai appris à réhabiliter les crudités au grand dam de la charcuterie, à préférer le légume vert et bienfaisant à la patate féculente, à vaporiser au lieu de rissoler à la graisse de porc, à pamplemousser et fromageblanter au lieu de saucissonner. (sic)"
                            }
                        ]
                    },
                    {
                        "sense_id": "8fcc2a8b-26be-35b7-883d-37fb919d2174",
                        "entry_id": "c5b6e20a-8a64-3fbf-a95b-12b44b860544",
                        "glosses": [
                            "Se parfumer au pamplemousse."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a747391c-7ff4-47e6-95fd-bb5618b5915e",
                                "sense_id": "8fcc2a8b-26be-35b7-883d-37fb919d2174",
                                "text": "Pour vous pamplemousser en toute tranquillité, essayer l'Eau d'Hadrien, l'Eau Vitaminée de Biotherm, Lipstick Rose, Rose Ikebana, Un Jardin sur le Nil... et même éventuellement Amor Amor, plus cliché \"jeune\", mais pourquoi pas ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0e7e1668-1aaf-3354-9210-dc4e5fd6e41f",
                        "entry_id": "c5b6e20a-8a64-3fbf-a95b-12b44b860544",
                        "glosses": [
                            "Boire du jus de pamplemousse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2530bec-2f9e-49ff-89f0-76102cb1fe16",
                                "sense_id": "0e7e1668-1aaf-3354-9210-dc4e5fd6e41f",
                                "text": "hello: tu viens pamplemousser avec nous???"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a38bb62-8008-362c-af98-77099a6a1b8e",
                        "entry_id": "c5b6e20a-8a64-3fbf-a95b-12b44b860544",
                        "glosses": [
                            "Faire boire du jus de pamplemousse à."
