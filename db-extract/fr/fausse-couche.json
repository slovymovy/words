                                            {
                                                "example_id": "79c9799e-e8d5-4f56-9d7f-189a6dbd000b",
                                                "sense_id": "8d22b710-092f-3dfd-adb5-7d802239bfc5",
                                                "text": "Πώς τσακώθηκες μ' εκείνον, αφού είναι σκέτη αποβολή!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad58337-b7de-31ba-b608-c1cacc880c38",
                                        "entry_id": "49c3a57b-c9d2-3399-9034-bae2aa99dd32",
                                        "glosses": [
                                            "κακοφτιαγμένος άσχημος άνθρωπος"
                                        ],
                                        "tags": [
                                            "familiar",
