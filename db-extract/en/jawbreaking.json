                                                "sense_id": "60576083-c500-392f-bdcd-771ced688632",
                                                "text": "Un mot imprononçable."
                                            },
                                            {
                                                "example_id": "4570baf1-9b67-47f3-a2b1-39e00167496c",
                                                "sense_id": "60576083-c500-392f-bdcd-771ced688632",
                                                "text": "C’est à ce moment que cet écrivain polonais au nom imprononçable démolissait la scène la mieux préparée de l’histoire du désir […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ce9d704-9392-3dc3-bba6-b86340535735",
                                        "entry_id": "433219d1-aa5a-3fe3-8656-faf46c39600d",
                                        "glosses": [
                                            "Que l’on n’a pas le droit de dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
