                "senses": [
                    {
                        "sense_id": "0c19529a-fc16-3f68-87fc-913a6846570e",
                        "entry_id": "c417f945-e8f5-3796-b694-38c7d1bfac34",
                        "glosses": [
                            "vierdimensionale Verbindung der drei Raumkoordinaten und der Zeit"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "d6220674-ef2d-49c5-afa1-fe708ea1b6fe",
                                "sense_id": "0c19529a-fc16-3f68-87fc-913a6846570e",
                                "text": "„Im Kern ist diese letztlich ein Gedankengebäude, das die Erhaltung von Symmetriebeziehungen in dem vierdimensionalen Raum-Zeit-Kontinuum sicherstellt, das wir unser Universum nennen.“"
                            },
                            {
                                "example_id": "d4fe2e4a-afb6-4ad6-9d22-1bfd9ecacf87",
                                "sense_id": "0c19529a-fc16-3f68-87fc-913a6846570e",
                                "text": "„Mit Volldampf ins Chaos Löcher in fremde Raum-Zeit-Kontinuen zu reißen ist für verrückte Wissenschaftler fast schon ein Kavaliersdelikt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
