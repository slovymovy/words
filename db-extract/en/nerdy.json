                                "sense_id": "d7809f28-185e-379b-9e0c-85eb8bb0a81e",
                                "text": "That guy is nerdy and weird."
                            }
                        ]
                    },
                    {
                        "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                        "entry_id": "9e119c26-38e5-3075-b28f-351b6c4f0afd",
                        "glosses": [
                            "Of, pertaining to, in the style of, or appealing to nerds."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a68d2db4-7e19-4e8a-9ebc-4ccbd6277e3f",
                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                "text": "That is a nerdy song."
                            },
                            {
                                "example_id": "b3186288-9104-4bb3-9456-d10cf67e92e6",
                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                "text": "I got a pair of nerdy glasses and clothes for Halloween."
                            },
                            {
                                "example_id": "ef71da8d-a62c-4caa-a1c9-cee6c0138ef1",
                                "sense_id": "de1ce128-79d8-3c68-8987-37a2220b1897",
                                "text": "The cleverest and most prolific inventors, such as Reiner Knizia (who lives in England) are nerdy superstars. Euro (also “German-style”) games must not be confused with “Ameritrash” games, which generally involve high drama and employ plastic pieces, though arguing over what the difference is seems to be gamers' second-favourite pastime."
                            }
                        ]
                    }
