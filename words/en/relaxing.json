    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb021cdf-2560-35a2-82ec-9e9ee31decb1",
                    "sense_definition": "Conducive to relaxation; helping one to relax.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent a very <w>relaxing</w> afternoon sitting by the river.",
                            "target_lang_translations": {
                                "ru": "Мы провели очень <w>расслабляющий</w> день, сидя у реки.",
                                "zh": "我们在河边坐了一个非常<w>令人放松的</w>下午。"
                            }
                        },
                        {
                            "text": "Soft lighting creates a <w>relaxing</w> atmosphere in the living room.",
                            "target_lang_translations": {
                                "ru": "Мягкое освещение создает <w>расслабляющую</w> атмосферу в гостиной.",
                                "zh": "柔和的灯光为客厅营造出一种<w>令人放松的</w>氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calming",
                        "soothing",
                        "restful",
                        "peaceful"
                    ],
                    "antonyms": [
                        "stressful",
                        "tense"
                    ],
                    "common_phrases": [
                        "relaxing atmosphere",
                        "relaxing holiday",
                        "relaxing music",
                        "very relaxing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий отдыху и снятию напряжения; помогающий расслабиться.",
                        "zh": "使人感到轻松、有助于休息的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расслабляющий",
                                "target_lang_sense_clarification": "вызывающий состояние покоя и отдыха"
                            },
                            {
                                "target_lang_word": "успокаивающий",
                                "target_lang_sense_clarification": "снимающий волнение или стресс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人放松的",
                                "target_lang_sense_clarification": "形容事物能让人感到舒适和解压"
                            },
                            {
                                "target_lang_word": "舒适的",
                                "target_lang_sense_clarification": "形容环境或状态让人感到安逸"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4d5975b-e62b-3fcb-a952-76033b11a4d4",
                    "sense_definition": "Present participle and gerund of <w>relax</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>relaxing</w> on the sofa with a good book.",
                            "target_lang_translations": {
                                "ru": "Она <w>расслабляется</w> на диване с хорошей книгой.",
                                "zh": "她正坐在沙发上读着好书，享受着<w>放松</w>时光。"
                            }
                        },
                        {
                            "text": "After a long week, I enjoy <w>relaxing</w> at home with my family.",
                            "target_lang_translations": {
                                "ru": "После долгой недели мне нравится <w>отдыхать</w> дома с семьей.",
                                "zh": "忙碌了一周后，我喜欢和家人在家<w>休息</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resting",
                        "unwinding",
                        "chilling out"
                    ],
                    "antonyms": [
                        "working",
                        "stressing"
                    ],
                    "common_phrases": [
                        "relaxing at home",
                        "just relaxing",
                        "relaxing after work"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола \"relax\" (отдыхать, расслабляться), обозначающая действие в процессе или само занятие.",
                        "zh": "放松、休息（relax的现在分词或动名词形式）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдыхать",
                                "target_lang_sense_clarification": "проводить время без работы, восстанавливать силы"
                            },
                            {
                                "target_lang_word": "расслабляться",
                                "target_lang_sense_clarification": "снимать напряжение, предаваться отдыху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "指身体或精神上的松弛"
                            },
                            {
                                "target_lang_word": "休息",
                                "target_lang_sense_clarification": "指停止工作或活动以恢复体力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aee0cda6-b21e-3e51-8907-8b5c2752939f",
                    "sense_definition": "The process by which something is relaxed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor monitored the periodic <w>relaxings</w> of the patient's muscles.",
                            "target_lang_translations": {
                                "ru": "Врач наблюдал за периодическими <w>расслаблениями</w> мышц пациента.",
                                "zh": "医生监测了病人肌肉的周期性<w>放松</w>。"
                            }
                        },
                        {
                            "text": "Sudden <w>relaxings</w> of the strict rules led to confusion among the staff.",
                            "target_lang_translations": {
                                "ru": "Внезапные <w>ослабления</w> строгих правил привели к замешательству среди персонала.",
                                "zh": "突然<w>放宽</w>严格的规定导致员工们感到困惑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loosening",
                        "easing"
                    ],
                    "antonyms": [
                        "tightening",
                        "tensing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс снижения напряжения, жесткости или строгости чего-либо.",
                        "zh": "使某物变得松弛、减弱或放宽的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослабление",
                                "target_lang_sense_clarification": "смягчение правил или уменьшение натяжения"
                            },
                            {
                                "target_lang_word": "расслабление",
                                "target_lang_sense_clarification": "снятие мышечного тонуса или напряжения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "指肌肉或紧张状态的缓解"
                            },
                            {
                                "target_lang_word": "放宽",
                                "target_lang_sense_clarification": "指对规则或限制的松动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}