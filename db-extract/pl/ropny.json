                        "glosses": [
                            "Eiter enthaltend; eitrig, eiterig, eiternd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09cff5bf-fc9c-4292-9ce4-36af647d1933",
                                "sense_id": "ee19cfdb-9a28-30dc-84fb-2827efdbe087",
                                "text": "„Ukąszenia jakichś drobnych muszek przezroczystych, koloru gnoju, wywoływały obrzmienia i plamy, świerzbiące zrazu, które następnie jątrzyły się i przeistaczały straszliwe ropne rany.“"
                            },
                            {
                                "example_id": "2eae85a0-e23e-4ba7-aa34-71f7c167f1f8",
                                "sense_id": "ee19cfdb-9a28-30dc-84fb-2827efdbe087",
                                "text": "„Ropne zapalenie ogarnęło całe płuco!“"
                            },
                            {
                                "example_id": "e1db1c0a-47b2-42fe-afe9-e4e8b0e33a3d",
                                "sense_id": "ee19cfdb-9a28-30dc-84fb-2827efdbe087",
                                "text": "„Bakteriofagami leczono między innymi pacjentów cierpiących na przewlekłe przetoki ropne, ropne zakażenie nosa, gardła i oskrzeli, posocznicę, ropne zapalenie otrzewnej, odoskrzelowe zapalenie płuc, ropiejące rany pooperacyjne i czyraki.“"
                            }
                        ],
