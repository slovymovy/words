                    {
                        "translation_id": "c512eff3-0ebb-459c-8677-665e4e9f664f",
                        "source_entry_id": "b13bc2d6-6bfd-3c53-b407-936fcf078cfc",
                        "source_sense_description": "close-fitting collarless jacket, with or without sleeves",
                        "target_lang_word": "justaucorps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justaucorps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                        "entry_id": "8b5503f1-331e-32b8-af58-4fa357aa6b5b",
                                        "glosses": [
                                            "Pourpoint, vêtement qui serre le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2845c4df-9d8d-4315-b295-163fd7f76abe",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "Othon […] se fit indiquer le tailleur le mieux assorti de la ville, changea ses habits de velours et de soie contre un justaucorps de drap vert serré avec une ceinture de cuir."
                                            },
                                            {
                                                "example_id": "fdfe375b-892e-4eda-8e5d-249ed06366b5",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "Une fille en foulard et justaucorps sauta de la voiture, et se mis à secouer le portail à coups de poings dignes d’un homme."
                                            },
                                            {
                                                "example_id": "24821b80-8444-4a25-9134-0debc8538d34",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "La guerre de 1914 était responsable de quelques lacunes dans le vocabulaire de mon père, qui les transmit à plusieurs générations. Il nous disait par exemple qu’un autodidacte est un monsieur qui conduit lui-même son automobile ou que la grande surprise se manifeste par un justaucorps subit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b760572b-4767-3161-a39e-0bb6a6837c97",
                                        "entry_id": "8b5503f1-331e-32b8-af58-4fa357aa6b5b",
                                        "glosses": [
                                            "Vêtement moulant utilisé pour faire de la gymnastique, avec ou sans manche."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478d1218-c933-480e-a76f-ec186818b3e8",
                                                "sense_id": "b760572b-4767-3161-a39e-0bb6a6837c97",
                                                "text": "Une femme en justaucorps faisait faire des jumping jacks à un groupe d’adhérentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40b86388-6696-49c3-971f-c4defe177b81",
                        "source_entry_id": "b13bc2d6-6bfd-3c53-b407-936fcf078cfc",
                        "source_sense_description": "close-fitting collarless jacket, with or without sleeves",
                        "target_lang_word": "Jacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                        "entry_id": "a0230f66-884b-3850-9f1a-38262a7e57b3",
                                        "glosses": [
                                            "ein Bekleidungsstück für Männer und Frauen, welches zum Bedecken des Oberkörpers vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ddb63c-eb95-4dbf-a551-58b43c0ece2c",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "Ziehe dir eine Jacke über, es ist Herbst!"
                                            },
                                            {
                                                "example_id": "183fdd4f-44af-46c8-b930-8066d3b34c76",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zieht die Jacke aus.“"
                                            },
                                            {
                                                "example_id": "11dd9b12-096e-49c1-b4ff-cdc16afc161a",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„In Kopenhagen vor einem Haustor von vornehmem Aussehen steht ein Soldat in einer ziemlich neuen Jacke und Stulpenstiefeln, mit Gürtel um den Leib und einem schwarzen Kriegerhut, jedoch ohne Waffen.“"
                                            },
                                            {
                                                "example_id": "a5566e23-d7bd-4edd-a7cf-f8d8e4dbcb15",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zog den Reißverschluss der Jacke höher, setzte die Kapuze auf und beeilte sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b9dc4d1-100b-4dec-bc97-c459922e9294",
                        "source_entry_id": "b13bc2d6-6bfd-3c53-b407-936fcf078cfc",
                        "source_sense_description": "close-fitting collarless jacket, with or without sleeves",
                        "target_lang_word": "Wams",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wams",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f520efe-3aa7-3705-9822-d4c5de79d823",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "Kleidungsstück, das die Ritter unter ihrer Rüstung (Harnisch) oder ihrem Lentner trugen und das bis über die Hüften reichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0d4280-abbf-49f4-adfa-0c0b48c5f0f0",
                                                "sense_id": "5f520efe-3aa7-3705-9822-d4c5de79d823",
                                                "text": "„Unter der Rüstung aus Metall und dem wattierten Wams konnte es im Sommer sehr heiß werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "für die Männerbekleidung in der Zeit des 16.–17. Jahrhunderts charakteristische Jacke, die oftmals wattiert und gesteppt war"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9340bc8f-01ef-4691-9358-4e073016d7f6",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Sein Umhang aus schwarzem Moiré war mit einer von Diamantnadeln gehaltenen Spitze bedeckt. Darunter wurde ein mit erlesenster schwarzer Spitze verziertes Wams aus Silberbrokat sichtbar.“"
                                            },
                                            {
                                                "example_id": "c964dedf-7a36-42a2-93f5-4e4e505581fa",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Sein Wams war ihm zu weit geworden und nur die angenestelte Schamkapsel hielt die Beinkleider noch oben.“"
                                            },
                                            {
                                                "example_id": "d542000c-bdc1-41d9-9972-f6c1ea5dc0e3",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Der deutsche Quartierwirt guckte in Wams und Zipfelmütze, in der Hand die Mistgabel, mit der er den Kuhstall ausgemistet hatte, aus der Stalltür.“"
                                            },
                                            {
                                                "example_id": "c26b68c3-bf89-40a7-8f62-2405ff427dc4",
                                                "sense_id": "0cf01e86-abd9-3eb3-97a7-b8459946f5a7",
                                                "text": "„Dann erhielt er von ihnen Unterzeug, eine Frieshose, ein Wams und Holzschuhe, jedoch keine Strümpfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                        "entry_id": "7b407501-0e63-34df-936a-3dc6325c14cc",
                                        "glosses": [
                                            "(insbesondere zu bestimmten Trachten gehöriges) zumeist hochgeschlossenes, eng anliegendes Kleidungsstück für Männer, das den Oberkörper bis zur Taille bedeckt"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c17a9275-d209-4ea3-b345-d581052be4f8",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "Die traditionelle Tracht unserer Gegend besteht aus einem groben Filzhut, kunstvoll bestickten Beinkleidern und einem roten Wams."
                                            },
                                            {
                                                "example_id": "326105f0-6e2b-425a-9ca5-c0a22dc691d6",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Er trug ein weißes Hemd mit Schlips unter dem Wams, und in Magnus á Gerdunums Kleidergeschäft hatte er sich eine dänische Hose mit Bügelfalten gekauft.“"
                                            },
                                            {
                                                "example_id": "edd1e578-4d32-43ad-ad72-27578bde7535",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Ein blauäugiger Mann in schwarzseidenem Wams steht hinter dem Ladentisch, er guckt auf den Preiszettel und antwortet: Achtzehn Rubel.“"
                                            },
                                            {
                                                "example_id": "8fdcf36c-675b-4832-8433-6e41676b4eea",
                                                "sense_id": "d093ab51-8b5f-3dcb-aae0-dbe90575aad9",
                                                "text": "„Kant schiebt seine linke Hand in das Wams, schaut Lampe – ein wenig selbstzufrieden – an und läßt ihn abtreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
