                ],
                "senses": [
                    {
                        "sense_id": "fdbce1a3-0524-32e2-9513-697ab61633d7",
                        "entry_id": "338114d9-8ef9-37c7-8f42-8905e24873e4",
                        "glosses": [
                            "немного поспать, ненадолго заснуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54bd3c7e-28e3-4844-812d-b6a09c1958a1",
                                "sense_id": "fdbce1a3-0524-32e2-9513-697ab61633d7",
                                "text": "По-хорошему, ему надо было бы дать вздремнуть минут четыреста."
                            },
                            {
                                "example_id": "9d52a5d5-7b5e-4b83-82a0-9c6bf4dfb6dc",
                                "sense_id": "fdbce1a3-0524-32e2-9513-697ab61633d7",
                                "text": "Сел он на камень, вздремнул с полчаса и потом // Снова поехал лесным одиноким путем."
                            },
                            {
                                "example_id": "11e3b9b9-5ab9-41aa-92e7-b12f6312b9c3",
                                "sense_id": "fdbce1a3-0524-32e2-9513-697ab61633d7",
                                "text": "Прилег вздремнуть я у лафета."
                            }
                        ]
                    }
                ],
