                                "target_senses": [
                                    {
                                        "sense_id": "5d701ea2-2db0-3bef-bdf5-706520c6e727",
                                        "entry_id": "5cd6cfe8-a8b2-3d98-bdcb-527ddf2acddb",
                                        "glosses": [
                                            "jede Woche wiederkehrend, in jeder Woche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52edf642-2ffa-407e-9179-02396426822e",
                                                "sense_id": "5d701ea2-2db0-3bef-bdf5-706520c6e727",
                                                "text": "Sie ist stetig besser geworden, seit sie mit ihrer wöchentlichen Nachhilfe begann."
                                            },
                                            {
                                                "example_id": "e51b90e1-0ec1-49e2-932d-04d66181f43c",
                                                "sense_id": "5d701ea2-2db0-3bef-bdf5-706520c6e727",
                                                "text": "„Dr. Taza lud Michael ein, ihn bei seinen wöchentlichen Bordellbesuchen nach Palermo zu begleiten, doch Michael wollte nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
