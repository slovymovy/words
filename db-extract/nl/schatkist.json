                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a5930a-5f44-4291-9ef1-7f1f75c2c6ba",
                                "sense_id": "42a68bb3-3a68-3ab0-914c-f18bfe8ef905",
                                "text": "De piraten begroeven hun schatkist op een onbewoond eiland."
                            }
                        ]
                    },
                    {
                        "sense_id": "867a31eb-154b-3a8b-bdf9-7c3a8228174d",
                        "entry_id": "ff698ccc-7704-3a62-96ba-ac4f9d5ddd52",
                        "glosses": [
                            "overdrachtelijk de financiën van de staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc442c8-7055-4ccd-8003-004cecf60d2c",
                                "sense_id": "867a31eb-154b-3a8b-bdf9-7c3a8228174d",
                                "text": "De schatkist vertoont weer eens een groot tekort."
                            },
                            {
                                "example_id": "66083a8e-c452-4b5d-a801-fa408276d72b",
                                "sense_id": "867a31eb-154b-3a8b-bdf9-7c3a8228174d",
                                "text": "Volgens critici is de 'colataks' vooral bedoeld om de schatkist te spekken. De belasting, die bijna 300 miljoen euro per jaar moet opleveren, geldt immers ook voor alle light-frisdranken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e6d0e0-5722-468e-a0a4-1b46d1287ff4",
                        "source_entry_id": "ff698ccc-7704-3a62-96ba-ac4f9d5ddd52",
                        "source_sense_id": "42a68bb3-3a68-3ab0-914c-f18bfe8ef905",
