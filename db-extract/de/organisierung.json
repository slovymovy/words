                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea1bc3bd-5222-3f7e-b531-f2812f054f6d",
                        "entry_id": "3c3fe3c1-15dc-3682-b856-89b70444498b",
                        "glosses": [
