                    "frequency": "High",
                    "semantic_group_id": "religion_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont célébré leur mariage <w>religieux</w> dans une ancienne chapelle du village."
                        },
                        {
                            "text": "La constitution garantit la liberté <w>religieuse</w> pour tous les citoyens du pays."
                        }
                    ],
                    "common_phrases": [
