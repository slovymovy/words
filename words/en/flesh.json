{
    "word_family": [
        "fleshy",
        "fleshly",
        "fleshless",
        "fleshiness",
        "fleshpot",
        "flesh-colored"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3620de3-d79c-3b18-a4af-9512023e3de4",
                    "sense_definition": "The soft tissue of the body, especially muscle and fat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "body-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow pierced deep into the <w>flesh</w> of his upper arm.",
                            "target_lang_translations": {
                                "ru": "Стрела глубоко вонзилась в <w>плоть</w> его предплечья."
                            }
                        },
                        {
                            "text": "The doctor examined the wound to see if the <w>flesh</w> and bone were damaged.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел рану, чтобы проверить, не повреждены ли <w>мягкие ткани</w> и кость."
                            }
                        }
                    ],
                    "synonyms": [
                        "tissue",
                        "muscle"
                    ],
                    "antonyms": [
                        "bone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкие ткани тела, в частности мышцы и жир."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоть",
                                "target_lang_sense_clarification": "тело как физическая субстанция"
                            },
                            {
                                "target_lang_word": "мягкие ткани",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "мясо",
                                "target_lang_sense_clarification": "мышечная ткань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58674d16-78d3-391c-8eb3-d8ed4b937116",
                    "sense_definition": "Animal tissue regarded as food; meat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people choose not to eat the <w>flesh</w> of any living creature.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди предпочитают не употреблять в пищу <w>плоть</w> живых существ."
                            }
                        },
                        {
                            "text": "The hunter prepared the <w>flesh</w> of the deer for the winter.",
                            "target_lang_translations": {
                                "ru": "Охотник заготовил <w>мясо</w> оленя на зиму."
                            }
                        }
                    ],
                    "synonyms": [
                        "meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ткани животных, используемые в пищу; мясо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мясо",
                                "target_lang_sense_clarification": "пищевой продукт"
                            },
                            {
                                "target_lang_word": "плоть",
                                "target_lang_sense_clarification": "в контексте живых существ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68bfefbc-90d9-3b3f-afa5-8456658ef5fa",
                    "sense_definition": "The soft, often edible, parts of fruits or vegetables.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scoop out the <w>flesh</w> of the avocado and mash it with a fork.",
                            "target_lang_translations": {
                                "ru": "Выньте ложкой <w>мякоть</w> авокадо и раздавите её вилкой."
                            }
                        },
                        {
                            "text": "The sweet <w>flesh</w> of the melon was very refreshing on a hot day.",
                            "target_lang_translations": {
                                "ru": "Сладкая <w>мякоть</w> дыни была очень освежающей в жаркий день."
                            }
                        }
                    ],
                    "synonyms": [
                        "pulp"
                    ],
                    "antonyms": [
                        "skin",
                        "peel",
                        "rind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая, часто съедобная часть фруктов или овощей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мякоть",
                                "target_lang_sense_clarification": "часть плода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f0236c-38d6-30ae-a215-2317412ca422",
                    "sense_definition": "The mortal body of a human being, often contrasted with the spirit or soul.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk believed that the desires of the <w>flesh</w> were a distraction from prayer.",
                            "target_lang_translations": {
                                "ru": "Монах верил, что желания <w>плоти</w> отвлекают от молитвы."
                            }
                        },
                        {
                            "text": "In many religions, the spirit is considered eternal while the <w>flesh</w> is temporary.",
                            "target_lang_translations": {
                                "ru": "Во многих религиях дух считается вечным, в то время как <w>плоть</w> — временна."
                            }
                        }
                    ],
                    "synonyms": [
                        "body"
                    ],
                    "antonyms": [
                        "spirit",
                        "soul"
                    ],
                    "common_phrases": [
                        "sins of the flesh",
                        "weakness of the flesh"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or philosophical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смертное тело человека, часто противопоставляемое духу или душе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоть",
                                "target_lang_sense_clarification": "в религиозном или философском смысле"
                            },
                            {
                                "target_lang_word": "тело",
                                "target_lang_sense_clarification": "материальная оболочка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f40731a-bea9-3468-93ca-9e545da794c4",
                    "sense_definition": "The human body as a physical entity, or a person in physical form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have seen his pictures, but I have never met him in the <w>flesh</w>.",
                            "target_lang_translations": {
                                "ru": "Я видел его фотографии, но никогда не встречал его <w>вживую</w>."
                            }
                        },
                        {
                            "text": "It was a strange experience to see my childhood hero in the <w>flesh</w> at the convention.",
                            "target_lang_translations": {
                                "ru": "Было странно увидеть героя своего детства <w>воочию</w> на съезде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the flesh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человеческое тело как физический объект или человек в физическом обличье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоть",
                                "target_lang_sense_clarification": "физическое присутствие"
                            },
                            {
                                "target_lang_word": "тело",
                                "target_lang_sense_clarification": "организм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b683faac-1001-3914-bef9-9c4d6869fcef",
                    "sense_definition": "A yellowish pink color; the color of some Caucasian human skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a <w>flesh</w> tone to paint the portrait's face.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>телесный</w> тон для написания лица на портрете."
                            }
                        },
                        {
                            "text": "She chose a <w>flesh</w> colored bandage so it wouldn't be too noticeable.",
                            "target_lang_translations": {
                                "ru": "Она выбрала пластырь <w>телесного</w> цвета, чтобы он не был слишком заметен."
                            }
                        }
                    ],
                    "synonyms": [
                        "peach",
                        "nude"
                    ],
                    "common_phrases": [
                        "flesh tone"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now often replaced by more inclusive color names"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтовато-розовый цвет; цвет кожи европеоидной расы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телесный",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b23cdc9-bb41-32ec-b4bf-e794c55b06fd",
                    "sense_definition": "To bury something, especially a weapon, in flesh.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was eager to <w>flesh</w> his sword in the upcoming battle.",
                            "target_lang_translations": {
                                "ru": "Рыцарь жаждал <w>омыть кровью</w> свой меч в предстоящей битве."
                            }
                        },
                        {
                            "text": "He felt a grim satisfaction as he managed to <w>flesh</w> the dagger in his opponent.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал мрачное удовлетворение, когда ему удалось <w>вонзить</w> кинжал в противника."
                            }
                        }
                    ],
                    "synonyms": [
                        "pierce",
                        "stab"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вонзить что-либо, особенно оружие, в тело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонзить",
                                "target_lang_sense_clarification": "оружие в тело"
                            },
                            {
                                "target_lang_word": "погрузить",
                                "target_lang_sense_clarification": "в плоть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ce1f9d5-0d71-3c63-9502-93d69d919729",
                    "sense_definition": "To remove the flesh from the skin during the process of making leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tanner must carefully <w>flesh</w> the hide before it can be cured.",
                            "target_lang_translations": {
                                "ru": "Кожевник должен тщательно <w>очистить от мездры</w> шкуру перед дублением."
                            }
                        },
                        {
                            "text": "Using a sharp tool, the worker began to <w>flesh</w> the animal skin.",
                            "target_lang_translations": {
                                "ru": "Используя острый инструмент, рабочий начал <w>мездрить</w> шкуру животного."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять остатки мяса и жира со шкуры в процессе выделки кожи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мездрить",
                                "target_lang_sense_clarification": "очищать шкуру"
                            },
                            {
                                "target_lang_word": "очищать от мездры",
                                "target_lang_sense_clarification": "процесс выделки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}