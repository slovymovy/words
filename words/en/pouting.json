{
    "word_family": [
        "pout"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0580c151-8834-3dff-beac-849c30122509",
                    "sense_definition": "present participle and gerund of <w>pout</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>pouting</w> because she did not get her way.",
                            "target_lang_translations": {
                                "cs": "Byla <w>trucovitá</w>, protože nebylo po jejím."
                            }
                        },
                        {
                            "text": "Stop <w>pouting</w> and try to enjoy the party.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>trucovat</w> a zkus si užít večírek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost nebo stav, kdy někdo vystrkuje rty jako projev nespokojenosti nebo trucování."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trucování",
                                "target_lang_sense_clarification": "projev nespokojenosti nebo uraženosti"
                            },
                            {
                                "target_lang_word": "špulení rtů",
                                "target_lang_sense_clarification": "fyzický popis výrazu obličeje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17534ae9-71d0-3e32-8ab0-97f1581edaca",
                    "sense_definition": "An expression or motion where the lips are pushed forward to show annoyance or sadness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child had a <w>pouting</w> expression after being told no.",
                            "target_lang_translations": {
                                "cs": "Dítě mělo <w>našpulený</w> výraz poté, co mu bylo řečeno ne."
                            }
                        },
                        {
                            "text": "Her <w>pouting</w> was a clear sign that she was unhappy.",
                            "target_lang_translations": {
                                "cs": "Její <w>trucování</w> bylo jasným znamením, že je nešťastná."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výraz obličeje, při kterém jsou rty vystrčeny dopředu jako projev mrzutosti, smutku nebo uraženosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trucovitý",
                                "target_lang_sense_clarification": "přídavné jméno popisující výraz"
                            },
                            {
                                "target_lang_word": "našpulený",
                                "target_lang_sense_clarification": "popisující stav rtů"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2f1edb7-40bb-3754-8a6b-108722bad77f",
                    "sense_definition": "A fish in the cod family (Gadidae), Trisopterus luscus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pouting</w> is often caught by anglers in coastal waters.",
                            "target_lang_translations": {
                                "cs": "<w>Treska vousatá</w> je často chytána rybáři v pobřežních vodách."
                            }
                        },
                        {
                            "text": "We identified the small fish as a <w>pouting</w> by its distinct markings.",
                            "target_lang_translations": {
                                "cs": "Identifikovali jsme tu malou rybu jako <w>tresku vousatou</w> podle jejích výrazných znaků."
                            }
                        }
                    ],
                    "synonyms": [
                        "bib",
                        "bleg",
                        "pout whiting",
                        "pout"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mořská ryba z čeledi treskovitých (Trisopterus luscus)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "treska vousatá",
                                "target_lang_sense_clarification": "odborný název ryby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}