                "senses": [
                    {
                        "sense_id": "49dc94b1-c783-339c-82dc-ad3cd542faa1",
                        "entry_id": "b6c07c0a-1ffa-3594-bdad-979eaca61c08",
                        "glosses": [
                            "ботан. связанный, соотносящийся по значению с существительным вика; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4b738e-59fe-4b43-8c53-45e062fd886b",
                                "sense_id": "49dc94b1-c783-339c-82dc-ad3cd542faa1",
                                "text": "Виковая тля."
                            },
                            {
                                "example_id": "b44d1a7d-daf2-4d15-a1bf-5fb87b5c1735",
                                "sense_id": "49dc94b1-c783-339c-82dc-ad3cd542faa1",
                                "text": "Посев вики со злаками называется виковой смесью. Виковая смесь на корм высевается в пару."
                            }
                        ]
                    },
                    {
                        "sense_id": "21d1100e-664a-3d3b-b786-a9e3aa3cf95d",
                        "entry_id": "b6c07c0a-1ffa-3594-bdad-979eaca61c08",
                        "glosses": [
                            "приготовленный из кормовой травы, сходной с горохом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ad515e-3aa2-435e-95f5-b93366df4c1a",
                                "sense_id": "21d1100e-664a-3d3b-b786-a9e3aa3cf95d",
                                "text": "Сено виковое."
                            }
                        ]
                    }
