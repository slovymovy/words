                        "examples": [
                            {
                                "example_id": "92aef71a-cb3d-48b7-970d-4d0bcbf84f30",
                                "sense_id": "bee73d73-0c20-34da-a4b6-ed2b6daee1c9",
                                "text": "— Je le lui disait bien, tous les jours, et hier encore, qu'il ne s'en guérirait jamais !... Qu'il continuerait à s’ensoûler comme une brute ! Ces bandits d'Eguzon ! Ils l'ont bien arrangé !"
                            },
                            {
                                "example_id": "437f34aa-c74e-42cb-a1d2-0d4e32b48b99",
                                "sense_id": "bee73d73-0c20-34da-a4b6-ed2b6daee1c9",
                                "text": "Ceux qui en avaient encore la force allaient s’encanailler, s’embordéliser ou s’ensoûler chez madame Kimoto, qui les aidait à faire semblant d’être heureux."
                            }
                        ]
                    }
