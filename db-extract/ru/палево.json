                        "examples": [
                            {
                                "example_id": "c51db47c-709f-43ac-93f8-a430990d060b",
                                "sense_id": "614d2476-411a-31b5-9b59-ec45cd974c14",
                                "text": "По́лное па́лево!",
                                "translation": "#Fail!",
                                "english": "#Fail!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a1045c1-8f36-3d46-89e9-97e6ec80d3b8",
                        "entry_id": "04a84683-7181-3568-916f-6615451db427",
                        "glosses": [
                            "low-quality liquor, hooch, rotgut, such booze that makes a party fail"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "83b32943-0e24-426e-9a3d-dde55b7052bf",
                                "sense_id": "5a1045c1-8f36-3d46-89e9-97e6ec80d3b8",
                                "text": "Купи́ во́дку полу́че, ну норма́льную, что́бы не па́лево бы́ло!",
                                "translation": "Buy some better vodka, I mean a normal one, so it isn’t a rotgut!",
                                "english": "Buy some better vodka, I mean a normal one, so it isn’t a rotgut!"
                            }
                        ]
                    }
