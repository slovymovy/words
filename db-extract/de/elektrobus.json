                "senses": [
                    {
                        "sense_id": "7f958e0d-1201-378d-ba8c-238d6c052652",
                        "entry_id": "bf801939-7446-3ef8-9e1b-cfabb3877ae6",
                        "glosses": [
                            "Autobus, der von einem Elektromotor angetrieben wird"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "17400d6b-3e85-4781-9392-093e9768b39b",
                                "sense_id": "7f958e0d-1201-378d-ba8c-238d6c052652",
                                "text": "„Noch steht der in der Garage, aber bald soll der Elektrobus in Wien seine Runden drehen – und zwar ganz ohne Lenker oder Lenkerin.“"
                            },
                            {
                                "example_id": "59788971-6191-4261-9a07-828277bd1d21",
                                "sense_id": "7f958e0d-1201-378d-ba8c-238d6c052652",
                                "text": "„Seit einigen Jahren ist der Batterieauto-Hersteller BYD auch im Geschäft mit Elektrobussen für den öffentlichen Nahverkehr.“"
                            },
                            {
                                "example_id": "328315f2-0b25-4c43-8fbb-d17538e58ef0",
                                "sense_id": "7f958e0d-1201-378d-ba8c-238d6c052652",
                                "text": "„Zur Reduzierung von Luftschadstoffen können sich Verkehrsbetriebe in Deutschland beim Kauf von sechs oder mehr Elektrobussen bis zu 80 Prozent der Mehrkosten vom Staat bezahlen lassen.“"
                            },
                            {
                                "example_id": "4b5b8a96-b1c5-45fb-9047-dc05dc61c607",
                                "sense_id": "7f958e0d-1201-378d-ba8c-238d6c052652",
                                "text": "„Die Zukunft wird dem Elektrobus gehören. Fragt sich nur: welchem? Dem Batteriebus, dem Oberleitungsbus oder dem Wasserstoffbus, der seinen Strom aus einer Brennstoffzelle bezieht?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
