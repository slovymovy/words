                        "examples": [
                            {
                                "example_id": "4afbb4b4-4a0b-414c-a9d2-0b0a5a003035",
                                "sense_id": "529fb541-d11c-3531-8f02-a2d54b51e141",
                                "text": "Podziękowaliśmy asyżankom za ich gościnę."
                            },
                            {
                                "example_id": "b8918ef3-1453-424a-b165-365dec3e8ca9",
                                "sense_id": "529fb541-d11c-3531-8f02-a2d54b51e141",
                                "text": "Jałowiec uczuł, że znowu w głowie mu się zakręciło, bo oto sam jeden siedzi na kamieniu, owszem, lecz to jest kamienne obramowanie naruszonej przez czas, ale będącej jeszcze w codziennym użytku rzymskiej cysterny, w której dzisiejsze asyżanki tak samo chętnie piorą bieliznę jak tamte niewiasty asyskie sprzed wieków, iluż to"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
