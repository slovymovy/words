{
    "word_family": [
        "oh-oh",
        "ohed",
        "ohing"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "ed5140c5-973d-305d-aa7a-afba533dad94",
                    "sense_definition": "An expression used to show surprise or sudden realization.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>! I didn't see you standing there in the dark.",
                            "target_lang_translations": {
                                "ru": "<w>О</w>! Я не заметил, что ты стоишь там в темноте."
                            }
                        },
                        {
                            "text": "<w>Oh</w> I see what you mean now that you explained it.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, теперь я понимаю, что ты имеешь в виду, раз ты это объяснил."
                            }
                        }
                    ],
                    "synonyms": [
                        "ah",
                        "ooh"
                    ],
                    "common_phrases": [
                        "oh I see"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение, используемое для выражения удивления или внезапного осознания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "удивление или осознание"
                            },
                            {
                                "target_lang_word": "ой",
                                "target_lang_sense_clarification": "внезапное удивление"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "удивление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afdbaed6-0fdf-3874-82cd-7e12d6f390cf",
                    "sense_definition": "An expression of understanding, affirmation, or recognition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>, so that's how the machine works.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, так вот как работает эта машина."
                            }
                        },
                        {
                            "text": "<w>Oh</w> okay, I will meet you there at five.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, хорошо, я встречусь с тобой там в пять."
                            }
                        }
                    ],
                    "synonyms": [
                        "ah",
                        "okay"
                    ],
                    "common_phrases": [
                        "oh okay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение понимания, подтверждения или узнавания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "понимание, догадка"
                            },
                            {
                                "target_lang_word": "ага",
                                "target_lang_sense_clarification": "подтверждение, понимание"
                            },
                            {
                                "target_lang_word": "понятно",
                                "target_lang_sense_clarification": "признание факта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55934003-dd0e-35b7-9a97-fb75259c8bd5",
                    "sense_definition": "An expression of wonder, amazement, or awe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w> wow! That is the most beautiful sunset I have ever seen.",
                            "target_lang_translations": {
                                "ru": "<w>Ого</w>! Это самый красивый закат, который я когда-либо видел."
                            }
                        },
                        {
                            "text": "<w>Oh</w> my goodness, look at how much you have grown!",
                            "target_lang_translations": {
                                "ru": "<w>Боже мой</w>, посмотри, как ты вырос!"
                            }
                        }
                    ],
                    "synonyms": [
                        "wow",
                        "ooh"
                    ],
                    "common_phrases": [
                        "oh wow",
                        "oh my goodness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение изумления, восхищения или благоговения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "восхищение"
                            },
                            {
                                "target_lang_word": "ого",
                                "target_lang_sense_clarification": "изумление"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "восторг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef78ccd-decd-3c99-8f0e-d3736ad5d43e",
                    "sense_definition": "A word used to introduce an added comment, afterthought, or reminder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>, and don't forget to bring your coat tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w>, и не забудь взять пальто сегодня вечером."
                            }
                        },
                        {
                            "text": "<w>Oh</w> by the way, I saw your brother at the store.",
                            "target_lang_translations": {
                                "ru": "<w>Кстати</w>, я видел твоего брата в магазине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oh and",
                        "oh by the way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для введения дополнительного комментария, запоздалой мысли или напоминания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "вводное слово для напоминания"
                            },
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "переход к новой мысли"
                            },
                            {
                                "target_lang_word": "кстати",
                                "target_lang_sense_clarification": "попутное замечание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cccba5-3d74-3574-af25-e55bfbb9c610",
                    "sense_definition": "A word used to precede an offhand, annoyed, or dismissive remark.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>, leave me alone while I am trying to work.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w> оставь ты меня в покое, пока я пытаюсь работать."
                            }
                        },
                        {
                            "text": "<w>Oh</w> please, that story cannot possibly be true.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w> брось, эта история просто не может быть правдой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oh please",
                        "oh stop it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal speech to show irritation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, предшествующее небрежному, раздраженному или пренебрежительному замечанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ой",
                                "target_lang_sense_clarification": "раздражение"
                            },
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "пренебрежение"
                            },
                            {
                                "target_lang_word": "ох",
                                "target_lang_sense_clarification": "досада"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "149c95e4-d1ab-389c-9e73-f5a1b2b386fb",
                    "sense_definition": "An expression of mild skepticism or doubt, often used as a question.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I can run a mile in four minutes.\" \"<w>Oh</w>? Really?\"",
                            "target_lang_translations": {
                                "ru": "«Я могу пробежать милю за четыре минуты». — «<w>Да</w>? Неужели?»"
                            }
                        },
                        {
                            "text": "<w>Oh</w> really? I find that very hard to believe.",
                            "target_lang_translations": {
                                "ru": "<w>Правда</w>? Мне в это очень трудно поверить."
                            }
                        }
                    ],
                    "synonyms": [
                        "really"
                    ],
                    "common_phrases": [
                        "oh really"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение легкого скептицизма или сомнения, часто используемое как вопрос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "да?",
                                "target_lang_sense_clarification": "вопросительное сомнение"
                            },
                            {
                                "target_lang_word": "неужели?",
                                "target_lang_sense_clarification": "скептицизм"
                            },
                            {
                                "target_lang_word": "правда?",
                                "target_lang_sense_clarification": "переспрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3113a7fd-bf1d-3275-a076-d2e83c7eefea",
                    "sense_definition": "An exclamation used to express physical pain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>! That hurt my foot when you stepped on it.",
                            "target_lang_translations": {
                                "ru": "<w>Ой</w>! Мне было больно, когда ты наступил мне на ногу."
                            }
                        },
                        {
                            "text": "<w>Oh</w>, my head is starting to ache again.",
                            "target_lang_translations": {
                                "ru": "<w>Ох</w>, у меня снова начинает болеть голова."
                            }
                        }
                    ],
                    "synonyms": [
                        "ouch",
                        "ow"
                    ],
                    "common_phrases": [
                        "oh that hurts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для выражения физической боли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ой",
                                "target_lang_sense_clarification": "внезапная боль"
                            },
                            {
                                "target_lang_word": "ай",
                                "target_lang_sense_clarification": "острая боль"
                            },
                            {
                                "target_lang_word": "ох",
                                "target_lang_sense_clarification": "ноющая боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461d4ad7-aa5e-3d5e-95fe-2216554bfeed",
                    "sense_definition": "An invocation or address used before a name or term of endearment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w> baby, I have missed you so much while you were away.",
                            "target_lang_translations": {
                                "ru": "<w>О</w>, малыш, я так скучал по тебе, пока тебя не было."
                            }
                        },
                        {
                            "text": "<w>Oh</w> boy, we are in a lot of trouble now.",
                            "target_lang_translations": {
                                "ru": "<w>Ох</w>, ну и влипли же мы теперь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oh baby",
                        "oh boy",
                        "oh dear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение, используемое перед именем или ласковым словом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "эмоциональное обращение"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "восклицание перед обращением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d575ac6-2513-32ff-a18a-c9e0b99d2701",
                    "sense_definition": "An exclamation used for dramatic effect or poetic emphasis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oh</w>, when will this long and cold winter finally end?",
                            "target_lang_translations": {
                                "ru": "<w>О</w>, когда же наконец закончится эта долгая и холодная зима?"
                            }
                        },
                        {
                            "text": "And <w>oh</w> how the wind howled through the empty trees.",
                            "target_lang_translations": {
                                "ru": "И <w>о</w>, как выл ветер в пустых деревьях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oh how"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often found in older literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для драматического эффекта или поэтического акцента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "поэтическое усиление"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "драматический вздох"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdc744cb-5eba-3c3b-936c-e6e086568423",
                    "sense_definition": "The digit 0, especially when spoken in a series of numbers like phone numbers or years.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "numbers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My phone number ends in four <w>oh</w> nine.",
                            "target_lang_translations": {
                                "ru": "Мой номер телефона заканчивается на четыре <w>ноль</w> девять."
                            }
                        },
                        {
                            "text": "The year was nineteen <w>oh</w> seven when the building was finished.",
                            "target_lang_translations": {
                                "ru": "Шел тысяча девятьсот <w>седьмой</w> год, когда здание было достроено."
                            }
                        }
                    ],
                    "synonyms": [
                        "zero",
                        "nought"
                    ],
                    "common_phrases": [
                        "seven oh five"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "standard in spoken English for zero"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифра 0, особенно при произнесении последовательности чисел, таких как номера телефонов или годы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноль",
                                "target_lang_sense_clarification": "цифра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b99b33-da0e-3021-9843-39dbf327e6b4",
                    "sense_definition": "An instance of saying the word 'oh' to express a feeling.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "utterance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were many <w>ohs</w> and ahs from the crowd during the show.",
                            "target_lang_translations": {
                                "ru": "Во время шоу из толпы доносилось много <w>возгласов</w> удивления и восторга."
                            }
                        },
                        {
                            "text": "She let out a soft <w>oh</w> when she saw the gift.",
                            "target_lang_translations": {
                                "ru": "Она издала тихий <w>возглас</w>, когда увидела подарок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ohs and ahs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай произнесения слова «о» для выражения чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оханье",
                                "target_lang_sense_clarification": "звук реакции"
                            },
                            {
                                "target_lang_word": "возглас",
                                "target_lang_sense_clarification": "краткий звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc9cd7a-729b-31a9-bf9f-27862cbaa19f",
                    "sense_definition": "An abbreviation for 'other half', referring to a romantic partner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to check with my <w>OH</w> before I book the flight.",
                            "target_lang_translations": {
                                "ru": "Мне нужно посоветоваться со своей <w>половинкой</w>, прежде чем бронировать рейс."
                            }
                        },
                        {
                            "text": "Is your <w>OH</w> coming to the party with you tonight?",
                            "target_lang_translations": {
                                "ru": "Твоя <w>супруга</w> придет с тобой на вечеринку сегодня?"
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "spouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in internet forums and text messaging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от «other half» (вторая половинка), относящаяся к романтическому партнеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "половинка",
                                "target_lang_sense_clarification": "партнер"
                            },
                            {
                                "target_lang_word": "супруг",
                                "target_lang_sense_clarification": "муж или жена"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bcc8bf86-b237-36d6-ab8b-6958c605a72d",
                    "sense_definition": "The standard postal abbreviation for the U.S. state of Ohio.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The letter was addressed to Columbus, <w>OH</w> 43215.",
                            "target_lang_translations": {
                                "ru": "Письмо было адресовано в Колумбус, <w>Огайо</w> 43215."
                            }
                        },
                        {
                            "text": "He moved from Cleveland, <w>OH</w> to New York last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году он переехал из Кливленда, штат <w>Огайо</w>, в Нью-Йорк."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ohio"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in addresses and official documents"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартное почтовое сокращение для американского штата Огайо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Огайо",
                                "target_lang_sense_clarification": "название штата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1386c668-f4c3-3ff9-99f4-861844fed843",
                    "sense_definition": "A common surname of Korean or Chinese origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Oh</w> is leading the research team this semester.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>О</w> возглавляет исследовательскую группу в этом семестре."
                            }
                        },
                        {
                            "text": "Sandra <w>Oh</w> is a very famous actress from Canada.",
                            "target_lang_translations": {
                                "ru": "Сандра <w>О</w> — очень известная актриса из Канады."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная фамилия корейского или китайского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "О",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1f5526e-416f-34e3-96e4-01f02c9d7abd",
                    "sense_definition": "To say the word 'oh' as a reaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience <w>ohed</w> and ahed as the fireworks lit up the sky.",
                            "target_lang_translations": {
                                "ru": "Зрители <w>ахали</w> и охали, когда фейерверк осветил небо."
                            }
                        },
                        {
