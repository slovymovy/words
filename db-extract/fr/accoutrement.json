                                    {
                                        "sense_id": "73067353-b533-3a46-bfd4-8d30d4e55285",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Castigation; scolding; a dressing down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
