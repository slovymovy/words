                "senses": [
                    {
                        "sense_id": "11444091-9ad1-3f9d-9792-2ec885fcb776",
                        "entry_id": "ddd9c244-525a-347f-b7e6-0c1cc9fb711b",
                        "glosses": [
                            "afgesloten bouwsel op het dek van een boot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032fd37f-f906-41d3-8419-e47dcc222480",
                                "sense_id": "11444091-9ad1-3f9d-9792-2ec885fcb776",
                                "text": "Het gebogen glas in het dekhuis geeft een spectaculair lichteffect en biedt panoramisch uitzicht."
                            },
                            {
                                "example_id": "56d4d0b0-db3b-4e6c-8ca1-d9f65a185cda",
                                "sense_id": "11444091-9ad1-3f9d-9792-2ec885fcb776",
                                "text": "De overeenkomsten zijn de steile boeg, het opvallende dekhuis en de kottertuigage. Het grootste verschil zit in de spiegel, die bij de Zuidkaper iets voller is en daardoor ruimte biedt aan een eigenaarshut onder het achterdek."
                            },
                            {
                                "example_id": "79795710-87c9-4b3f-b864-1782a042cba7",
                                "sense_id": "11444091-9ad1-3f9d-9792-2ec885fcb776",
                                "text": "Doordat een deel van de besturing is geautomatiseerd kan het schip het met de helft van de bemanning van een 'oude' destroyer af. Ook heeft het nieuwe radar- en sonarsystemen aan boord. Die zijn allemaal verborgen in het blokkendoosachtige dekhuis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "475e4d1c-2a09-4669-881f-e5c1825dd3bf",
                        "source_entry_id": "ddd9c244-525a-347f-b7e6-0c1cc9fb711b",
                        "source_sense_id": "11444091-9ad1-3f9d-9792-2ec885fcb776",
                        "source_sense_description": "afgesloten bouwsel op het dek van een boot",
                        "target_lang_word": "deckhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deckhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                                        "entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                                        "glosses": [
                                            "A cabin that protrudes above a ship's deck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceac2e40-809b-4e4a-8769-e5b38c1ccba8",
                                                "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                                                "text": "Flinging himself on hands and knees he dragged the girl down with him. As he did so two of her companions came sliding down to their assistance, and the four glissaded back to the deckhouse as the following roll began."
                                            },
                                            {
                                                "example_id": "d14535fd-f057-4223-a461-abe7448e6e26",
                                                "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                                                "text": "Then, through his web of contacts, he was told that the Nightingale’s original deckhouse was being used as a cottage on a private island outside of Kragero, Norway, a shipbuilding port."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
