                ],
                "senses": [
                    {
                        "sense_id": "83cf8e29-cc66-3071-8cf3-4e6ed04e92b1",
                        "entry_id": "3e743858-e5ce-3854-80d4-c72cf07acb92",
                        "glosses": [
                            "strömende Luftmengen oder Luftmassen in/aus einem Raum, einem Gebäude oder durch eine Lüftungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67d4de8-c3df-4950-9e16-426254c524cb",
                                "sense_id": "83cf8e29-cc66-3071-8cf3-4e6ed04e92b1",
                                "text": "Der Luftaustausch im Hotelzimmer erfolgt über das geöffnete Fenster oder über die eingeschaltete Klimaanlage."
                            },
                            {
                                "example_id": "c7bb7829-cf09-4af5-a644-c27bd6f7cfbe",
                                "sense_id": "83cf8e29-cc66-3071-8cf3-4e6ed04e92b1",
                                "text": "Der Luftaustausch in einem U-Boot erfolgt stets beim Auftauchen an die Wasseroberfläche."
                            },
                            {
                                "example_id": "f35fdd2c-8f22-44ce-bd03-3e32cfadef2d",
                                "sense_id": "83cf8e29-cc66-3071-8cf3-4e6ed04e92b1",
                                "text": "„Entscheidend für eine richtige Lüftungsstrategie ist jedoch, welchen tatsächlichen Einfluss die Fensterlüftung auf den effektiven Luftaustausch hat.“"
                            },
                            {
                                "example_id": "74a9509f-5741-4f24-8488-223dd3315c3a",
                                "sense_id": "83cf8e29-cc66-3071-8cf3-4e6ed04e92b1",
                                "text": "„Um den notwendigen Luftaustausch zwischen innen und außen sicherzustellen, ist es gerade bei neuen und dichten Fenstern besonders wichtig, sogenannte „allgemein bekannte Lüftungsregeln“ zu beachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "baeaaf25-3f0e-3210-83d9-c24b9f4b3976",
                        "entry_id": "3e743858-e5ce-3854-80d4-c72cf07acb92",
                        "glosses": [
                            "Atmung von Luft in die Lunge und der Gasaustausch an den Lungenbläschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41fd58b9-4c40-4a2c-9a79-4c0494839bf9",
                                "sense_id": "baeaaf25-3f0e-3210-83d9-c24b9f4b3976",
                                "text": "„An denen wiederum die blattartigen Fortsetzungen, die Lungenbläschen hängen in denen der Luftaustausch stattfindet,“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
