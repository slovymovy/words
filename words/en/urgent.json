{
    "word_family": [
        "urgency",
        "urgently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f34de082-e798-3e9f-8a73-a44be3db77a7",
                    "sense_definition": "Requiring immediate attention or action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immediate_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital provides <w>urgent</w> care for patients with sudden injuries.",
                            "target_lang_translations": {
                                "ru": "Больница оказывает <w>неотложную</w> помощь пациентам с внезапными травмами.",
                                "zh": "医院为突发伤患提供<w>紧急</w>护理。"
                            }
                        },
                        {
                            "text": "There is an <w>urgent</w> need for food and water in the disaster zone.",
                            "target_lang_translations": {
                                "ru": "В зоне бедствия существует <w>срочная</w> необходимость в еде и воде.",
                                "zh": "灾区对食物和水有着<w>急迫</w>的需求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pressing",
                        "dire",
                        "acute",
                        "exigent",
                        "immediate",
                        "critical"
                    ],
                    "antonyms": [
                        "nonurgent",
                        "unurgent"
                    ],
                    "common_phrases": [
                        "urgent care",
                        "urgent need",
                        "urgent attention",
                        "urgent matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий немедленного внимания или действий.",
                        "zh": "需要立即处理或采取行动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срочный",
                                "target_lang_sense_clarification": "требующий быстрого исполнения"
                            },
                            {
                                "target_lang_word": "неотложный",
                                "target_lang_sense_clarification": "не терпящий отлагательства"
                            },
                            {
                                "target_lang_word": "экстренный",
                                "target_lang_sense_clarification": "чрезвычайный, связанный с острой необходимостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧急",
                                "target_lang_sense_clarification": "情况严重，需要立即处理"
                            },
                            {
                                "target_lang_word": "急迫",
                                "target_lang_sense_clarification": "时间紧迫，需要尽快解决"
                            },
                            {
                                "target_lang_word": "紧要",
                                "target_lang_sense_clarification": "关键且刻不容缓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43653a4-ec5e-3c52-a6b7-3e6cf351536b",
                    "sense_definition": "Insistent or persistent in making demands or requests, often describing a person's manner or tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insistent_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke in an <w>urgent</w> whisper to warn us about the danger.",
                            "target_lang_translations": {
                                "ru": "Она заговорила <w>настойчивым</w> шепотом, чтобы предупредить нас об опасности.",
                                "zh": "她用<w>急切</w>的耳语警告我们注意危险。"
                            }
                        },
                        {
                            "text": "My friends were <w>urgent</w> with me to stay for dinner before leaving.",
                            "target_lang_translations": {
                                "ru": "Мои друзья были <w>настойчивы</w> в просьбе остаться на ужин перед отъездом.",
                                "zh": "我的朋友们<w>坚持</w>要我留下来吃完晚饭再走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imperious",
                        "pressing"
                    ],
                    "common_phrases": [
                        "urgent tone",
                        "urgent voice",
                        "urgent whisper",
                        "urgent request"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчивый, выражающий требование или просьбу (часто о тоне или манере).",
                        "zh": "在提出要求或请求时表现得坚持不懈的，常用于形容人的态度或语气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настойчивый",
                                "target_lang_sense_clarification": "упорный в требованиях"
                            },
                            {
                                "target_lang_word": "настоятельный",
                                "target_lang_sense_clarification": "решительный, не допускающий возражений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "急切",
                                "target_lang_sense_clarification": "态度迫切，急于表达"
                            },
                            {
                                "target_lang_word": "坚持",
                                "target_lang_sense_clarification": "态度坚决，反复要求"
                            },
                            {
                                "target_lang_word": "迫切",
                                "target_lang_sense_clarification": "语气强烈，不容推辞"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}