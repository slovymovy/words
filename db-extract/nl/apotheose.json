                    {
                        "sense_id": "052491f7-0273-378c-b20d-1ca006becca3",
                        "entry_id": "c6a57d93-6285-37b5-b399-00642b1a3b3e",
                        "glosses": [
                            "verheffing van een sterveling tot het niveau van een god, vergoddelijking"
