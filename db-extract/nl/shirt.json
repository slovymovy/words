                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Vêtement en linge ou en laine qu’on porte sur la chair, couvrant le buste et les bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8036225b-a580-4304-ab07-7bc6e1e3e639",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Yasmina, toujours triste et silencieuse, passait toutes ses journées à coudre de grossières chemises de toile."
                                            },
                                            {
                                                "example_id": "36537d6f-0861-4938-9a68-8823c57e892b",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Chacune a quitté, pour se mettre à l’aise,\nLa fine chemise au frais parfum d’ambre,\nLa plus jeune étend les bras, et se cambre."
                                            },
                                            {
                                                "example_id": "716a7624-e647-48c1-b05b-00adaa145396",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Il se leva tout à fait, passa la main entre l’échancrure de son gilet et le plastron de sa chemise qui godait, tira les revers de son habit, et s’assura que le nœud de sa cravate n’avait pas été dérangé."
                                            },
                                            {
                                                "example_id": "2c68fc97-dba2-4d1a-9714-a7dbd0c01188",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Marthe, suivant un usage du pays, acheta de son propre argent, gagné par son travail de brodeuse, la chemise du marié, une belle chemise, dont le devant était gaufré de petits plis."
                                            },
                                            {
                                                "example_id": "cd6523c2-928a-4730-a492-4b6d94b6abf7",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Les chemises de mon mari avaient besoin de boutons et le raccommodage de ses effets m’incombait, naturellement !"
                                            },
                                            {
                                                "example_id": "6da2f610-7050-4c38-ac2d-524b67d4cf89",
                                                "sense_id": "8987b612-5baf-3a66-ae9c-c50577723e32",
                                                "text": "Avec cette chaleur, en pleine nuit, il porte sur le crâne, de guingois, un Borsalino beige, une chemise à pois blancs sur fond noir qui zigzague au bombé de l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "660c028e-11da-365c-95e7-35b22029b82f",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Morceau de toile qui sert d’enveloppe à certaines marchandises, telles que la soie, le drap, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94d3dc96-c361-3c08-ab92-eb4af544cc6d",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Feuille de papier qui renferme et qui couvre d’autres papiers."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c20b31e-636d-4ceb-a589-dc951cdcdbed",
                                                "sense_id": "94d3dc96-c361-3c08-ab92-eb4af544cc6d",
                                                "text": "Mettez une chemise à cette liasse, à ce dossier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed45008c-8426-3965-8014-6ac3ae441624",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Crépi, revêtement de maçonnerie, enveloppe de mortier, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f097d032-7fa8-3646-86eb-446c58f4ca26",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Enveloppe d’un aliment pour le cuire ou le présenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c10d39c-4057-45d9-9911-fbb8672bb0dc",
                                                "sense_id": "f097d032-7fa8-3646-86eb-446c58f4ca26",
                                                "text": "Pour accompagner les terrines aux aubergines voici : les Keftas en chemise de brick ! Les invités ont adoré,.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b0349a-f291-3dea-9905-40f272947621",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Cylindre creux de métal qui, introduit dans une lumière, en ajuste l’alésage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44fe7af-848f-44e6-b4bc-aab33c6bf6e3",
                                                "sense_id": "d5b0349a-f291-3dea-9905-40f272947621",
                                                "text": "La mise en place de la chemise nécessite un tour de mains pas très compliqué :\n- placez le piston au PMB (Point Mort Bas),\n- huilez la chemise sur toute sa surface intérieure et extérieure,\n- alignez vos repères du carter moteur avec celui de la collerette de chemise,\n- puis descendez doucement la chemise dans le carter moteur jusqu’au contact avec le piston."
                                            }
                                        ]
                                    },
