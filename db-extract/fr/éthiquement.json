        "fr-extract.jsonl": [
            {
                "entry_id": "e1322dc0-178e-3fff-bd0d-78eb90008ae6",
                "word": "éthiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "227fbb07-f036-34b6-97b4-c069fbeb11ee",
                        "entry_id": "e1322dc0-178e-3fff-bd0d-78eb90008ae6",
                        "glosses": [
                            "D’un point de vue éthique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897a1905-625b-443a-aaa9-e71ed1116cc4",
                                "sense_id": "227fbb07-f036-34b6-97b4-c069fbeb11ee",
                                "text": "Il commit l’énorme erreur de « zaïriser » les dominantes industrielles de ce pays alors qu’il n’en avait pas l’expertise appropriée, ni techniquement ni éthiquement— (Côme Mankassa, Aimé Césaire, ou l’illusion de la liberté, 2019)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ed139ff-ab32-4d2e-9f8b-66f16bc7ea3b",
                        "source_entry_id": "e1322dc0-178e-3fff-bd0d-78eb90008ae6",
                        "source_sense_id": "227fbb07-f036-34b6-97b4-c069fbeb11ee",
                        "target_lang_word": "ethisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                        "entry_id": "4fa12420-40f5-3149-8d62-c14a21fdfc89",
                                        "glosses": [
                                            "auf die Ethik bezogen, die Ethik betreffend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f650677-141e-4aa1-88f2-43ee471c90c1",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "Die Gesetzesvorlage versucht, ethische Ansprüche zu verwirklichen."
                                            },
                                            {
                                                "example_id": "5a225c91-f2ed-45db-99d4-cd576cb8ce6b",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "„Es gibt keine ethische Rechtfertigung für die Mittel, deren sie sich bedient.“"
                                            },
                                            {
                                                "example_id": "2e030c88-3be5-49c8-be69-6345242759a4",
                                                "sense_id": "c0d9d8ee-5a16-396e-9ced-b43ec314001d",
                                                "text": "„Die gesellschaftlichen Rahmenbedingungen, die ethische Substanz einer Gemeinschaft und die Existenz oder Nichtexistenz einer Wagniserziehung tragen einen wesentlichen Verantwortungsanteil daran, in welche Wertrichtung sich die Wagnistendenzen bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                        "entry_id": "4fa12420-40f5-3149-8d62-c14a21fdfc89",
                                        "glosses": [
                                            "gemäß der Ethik sich verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b95740-bf13-443b-801a-c99e08c5cbf7",
                                                "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                                "text": "Die Vorfälle waren ethisch gesehen unverzeihlich."
                                            },
                                            {
                                                "example_id": "d69d2ade-584d-4514-b1fe-99ffc3fb5fe0",
                                                "sense_id": "dcae3caa-5637-3fac-90e2-2154e4209cac",
                                                "text": "„Man kann nicht nicht beeinflussen. Daher ist die Frage, wie Beeinflussung und Manipulation zu vermeiden wären, absurd; übrig bleibt nur die uns somit nie erlassene Entscheidung darüber, wie dieses Grundgesetz menschlicher Kommunikation verantwortlich und in der humansten, ethischsten und wirkungsvollsten Weise anzuwenden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2188893-0abc-4a6f-bb81-0aec49b1a871",
                        "source_entry_id": "e1322dc0-178e-3fff-bd0d-78eb90008ae6",
                        "source_sense_id": "227fbb07-f036-34b6-97b4-c069fbeb11ee",
                        "target_lang_word": "ethically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7e867e-665c-3f41-a803-2521154469bc",
                                        "entry_id": "42a45333-ad08-37b7-90cc-3d1e75705c27",
                                        "glosses": [
                                            "In an ethical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fef9af-7320-4126-8e23-bf2a7f0fd5f0",
                                                "sense_id": "7b7e867e-665c-3f41-a803-2521154469bc",
                                                "text": "In the final few weeks before the vote, a rash of ads appeared on radio and TV claiming that Hillary Clinton was too frail, too liberal and too ethically compromised to become president."
                                            },
                                            {
                                                "example_id": "a12fff81-4d93-4653-8b4c-28213da4cc2c",
                                                "sense_id": "7b7e867e-665c-3f41-a803-2521154469bc",
                                                "text": "It is easy to implement, is not cost-prohibitive, and provides unbiased randomly sampled data in an ethically acceptable manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01678543-d039-3f84-a4d1-4df772057f97",
