                    {
                        "form_id": "2e36eff7-02bd-4dbb-9cf5-a25936d7f3a1",
                        "entry_id": "ef5188ac-f4ac-3b14-bf18-49ff30ddf54d",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "gauwdiefjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                        "entry_id": "ef5188ac-f4ac-3b14-bf18-49ff30ddf54d",
                        "glosses": [
                            "een handige, slinkse, behendige dief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101fb986-fecf-410b-86dd-c72240625905",
                                "sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                                "text": "Een zoektocht naar de auto, flyeren en aangifte bij de politie leverden niets op. Aanwijzingen ontbraken. Tot afgelopen week, toen de politie van Carmel gauwdief Reid Albrecht arresteerde."
                            },
                            {
                                "example_id": "096142a2-f23a-4fc2-b658-eb188bb4a6f3",
                                "sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                                "text": "De schandpaal staat er morgen pas, dus de 'gauwdief' die gistermorgen op de Middeleeuwse markt in Almelo door veldwachters letterlijk in de kraag werd gevat, had geluk."
                            },
                            {
                                "example_id": "2a941cac-b53a-4055-ae47-42c1cc5819e3",
                                "sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                                "text": "Met een forse slag naar achteren haalde Dinnie met diezelfde tas vol uit naar de straatrover. De eerste klap was gelijk raak. De tas, met zware laptop erin, knalde vol in het gezicht van de brutale gauwdief. Die bleef nog maar net op zijn fiets zitten en droop als een geslagen hond af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8255b6f-7b8c-4ed6-bd8b-dc6bd447302c",
                        "source_entry_id": "ef5188ac-f4ac-3b14-bf18-49ff30ddf54d",
                        "source_sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                        "target_lang_word": "snatcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snatcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8eba19-1a07-3021-8889-ad4c56cd1e4b",
                                        "entry_id": "f031e477-43de-3ef3-b546-5fe5300fc546",
                                        "glosses": [
                                            "One who snatches, or steals by snatching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ec84c1-8a5f-4ae8-af29-9cf3641c3368",
                                                "sense_id": "ce8eba19-1a07-3021-8889-ad4c56cd1e4b",
                                                "text": "He'd thought it through and decided that he needed a swift reaction team to outsnatch the snatchers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2038c2d6-0a1f-4881-90c7-e99891b4010a",
                        "source_entry_id": "ef5188ac-f4ac-3b14-bf18-49ff30ddf54d",
                        "source_sense_id": "43697fd0-b6b0-3df1-82e0-e69282f9f044",
                        "target_lang_word": "pickpocket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pickpocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                        "entry_id": "5702bfae-f19f-315e-b455-9eb57e9722f1",
                                        "glosses": [
                                            "One who steals from the pocket of a passerby, usually by sleight of hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab79c103-6a21-4238-8f38-37a08ead5532",
                                                "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                                "text": "Old men, young men, and boys, stalwart burglars and highway robbers, slept side by side with wizened pickpockets or cunning-featured area-sneaks."
                                            },
                                            {
                                                "example_id": "8d4c3f94-7d42-4bac-b874-f4bbc09f4067",
                                                "sense_id": "97786186-3d23-38cf-aa96-e8d80bd40fdb",
                                                "text": "For several days, Mr. Sammler returning on the customary bus late afternoons from the Forty-second Street Library had been watching a pickpocket at work […] Mr. Sammler if he had not been a tall straphanger would not with his one good eye have seen these things happening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pickpocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1404c2a-c654-3926-922c-ef1eec6e26f4",
                                        "entry_id": "ab9df8f4-72ce-332e-a616-5cef0a339b3a",
                                        "glosses": [
                                            "To pick pockets; to steal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19e4b45-c7a2-42fa-857b-1bf03e7f2f1c",
                                                "sense_id": "d1404c2a-c654-3926-922c-ef1eec6e26f4",
                                                "text": "Vodafone has also dropped its claim against one of Rhys Edwards’s travelling companions – who had been at the same reunion and had his phone pickpocketed two hours later in almost identical circumstances to Rhys Edwards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
