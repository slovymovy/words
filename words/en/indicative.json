{
    "word_family": [
        "indicate",
        "indication",
        "indicator",
        "indicatively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ded8bfea-b462-331e-93a2-0cdef8a51de1",
                    "sense_definition": "Serving as a sign, indication, or suggestion of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden silence was <w>indicative</w> of his growing frustration with the project.",
                            "target_lang_translations": {
                                "ru": "Его внезапное молчание <w>свидетельствовало</w> о его растущем разочаровании в проекте."
                            }
                        },
                        {
                            "text": "The doctor explained that these symptoms are highly <w>indicative</w> of a common cold.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что эти симптомы явно <w>указывают</w> на обычную простуду."
                            }
                        }
                    ],
                    "synonyms": [
                        "suggestive",
                        "characteristic",
                        "symptomatic"
                    ],
                    "common_phrases": [
                        "indicative of a trend",
                        "highly indicative of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий признаком, указанием или намеком на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывающий",
                                "target_lang_sense_clarification": "наводящий на мысль о чем-то"
                            },
                            {
                                "target_lang_word": "свидетельствующий",
                                "target_lang_sense_clarification": "подтверждающий наличие чего-то"
                            },
                            {
                                "target_lang_word": "показывающий",
                                "target_lang_sense_clarification": "демонстрирующий что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16d1666e-259a-3296-aad6-2f29309876d2",
                    "sense_definition": "Of, or relating to, the grammatical mood that represents a state of affairs as an objective fact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the <w>indicative</w> mood is used for factual statements and positive assertions.",
                            "target_lang_translations": {
                                "ru": "В английском языке <w>изъявительное</w> наклонение используется для констатации фактов и утверждений."
                            }
                        },
                        {
                            "text": "You need to use the <w>indicative</w> form of the verb in this simple sentence.",
                            "target_lang_translations": {
                                "ru": "В этом простом предложении вам нужно использовать глагол в <w>изъявительной</w> форме."
                            }
                        }
                    ],
                    "antonyms": [
                        "subjunctive",
                        "imperative"
                    ],
                    "common_phrases": [
                        "indicative mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому наклонению, которое представляет действие как реальный факт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изъявительный",
                                "target_lang_sense_clarification": "о грамматическом наклонении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d73bffb-6358-3bf8-b654-9b83120151c7",
                    "sense_definition": "The <w>indicative</w> mood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most of the sentences we use in daily conversation are in the <w>indicative</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство предложений, которые мы используем в повседневной речи, стоят в <w>изъявительном наклонении</w>."
                            }
                        },
                        {
                            "text": "The teacher explained the difference between the subjunctive and the <w>indicative</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил разницу между сослагательным и <w>изъявительным наклонением</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "subjunctive",
                        "imperative"
                    ],
                    "common_phrases": [
                        "in the indicative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изъявительное наклонение в грамматике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изъявительное наклонение",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae885d45-4f6a-3f0e-aaca-fcd3763e521e",
                    "sense_definition": "A verb form or term in the <w>indicative</w> mood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher noted that foreign speakers often replace imperatives with <w>indicatives</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователь отметил, что иностранцы часто заменяют повелительное наклонение <w>изъявительным</w>."
                            }
                        },
                        {
                            "text": "In this ancient text, many of the verbs appear as simple <w>indicatives</w>.",
                            "target_lang_translations": {
                                "ru": "В этом древнем тексте многие глаголы употребляются в форме простого <w>изъявительного наклонения</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глагольная форма в изъявительном наклонении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форма изъявительного наклонения",
                                "target_lang_sense_clarification": "глагол в изъявительном наклонении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}