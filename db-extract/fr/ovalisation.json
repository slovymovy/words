                ],
                "senses": [
                    {
                        "sense_id": "95d8eab5-728b-36c7-b373-2bf746e291db",
                        "entry_id": "1728239f-e044-372e-8853-c8e82d60e6ec",
                        "glosses": [
                            "Action ou fait d’ovaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32414e60-53ce-4cff-aca0-dd424bb7a6ca",
                                "sense_id": "95d8eab5-728b-36c7-b373-2bf746e291db",
                                "text": "Ce qui semble avoir poussé Rotor à produire ces plateaux avec une ovalisation accrue, c'est l'effet de mode et la demande de certains coureurs professionnels."
                            }
                        ]
                    },
                    {
                        "sense_id": "a172a6f9-9233-35b2-8a55-936b1fcad348",
                        "entry_id": "1728239f-e044-372e-8853-c8e82d60e6ec",
                        "glosses": [
                            "Déformation d’une pièce qui s’ovalise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0017cb4e-e102-46b3-80d5-ad6e9e4b3c37",
                                "sense_id": "a172a6f9-9233-35b2-8a55-936b1fcad348",
                                "text": "Autant que faire se peut, on évite cette dernière disposition qui amène promptement l’ovalisation des cylindres et des pistons."
                            },
                            {
                                "example_id": "896176dc-53b6-43be-a7f7-8a353701ffb6",
                                "sense_id": "a172a6f9-9233-35b2-8a55-936b1fcad348",
                                "text": "Lorsque ces fissures se propagent vers le haut et vers le bas, elle sont dues à une ovalisation de l’axe ; vers le haut seulement elles sont dues à sa déflexion."
                            },
                            {
                                "example_id": "3e499fbc-4faf-45d6-8e06-b47293fa3aea",
                                "sense_id": "a172a6f9-9233-35b2-8a55-936b1fcad348",
                                "text": "En revanche, si un même pneu présente deux plats sur les deux côtés opposés, cela peut provenir d’une ovalisation du tambour de frein."
                            },
                            {
                                "example_id": "0b7749c5-f1b1-4a81-93c2-bddbab7139bb",
                                "sense_id": "a172a6f9-9233-35b2-8a55-936b1fcad348",
                                "text": "Le chantier se terminera ces prochains jours par l’injection d’un béton fluide entre la gaine et l’ancien conduit qui a subi le phénomène d’ovalisation suite au tassement naturel de la chaussée."
                            }
                        ]
                    }
                ],
