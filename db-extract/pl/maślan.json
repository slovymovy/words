                "senses": [
                    {
                        "sense_id": "8a0d5f4a-3ccb-3fed-b99a-8e27086eee80",
                        "entry_id": "3e6bbe07-87dd-35fb-a43d-ccd3211fd92c",
                        "glosses": [
                            "sól lub ester kwasu masłowego"
