                    {
                        "sense_id": "2e3aa29a-6f0a-33b0-b9f5-50a30b11808b",
                        "entry_id": "fc368435-603d-39f8-9254-a8586f27bdc7",
                        "glosses": [
                            "A monastic church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674fe867-9a50-4d77-a2c7-d2b7c5968f55",
                                "sense_id": "2e3aa29a-6f0a-33b0-b9f5-50a30b11808b",
                                "text": "[F]urther south in Kent, there was St. Mildred, whose mother, in 670, founded the minster that still stands there in good nick, with nine nuns who are an ever-present help in trouble to all religions and none."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8f34d21-d259-3a48-b5e2-2f00bed83fa2",
                        "entry_id": "fc368435-603d-39f8-9254-a8586f27bdc7",
                        "glosses": [
                            "A cathedral church without any monastic connection."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "632bbd43-eac3-4edb-85f2-9e39a3105091",
                        "source_entry_id": "fc368435-603d-39f8-9254-a8586f27bdc7",
                        "source_sense_description": "monastic church",
                        "target_lang_word": "moutier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moutier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffb457e-8f7a-3d51-b999-b4bc743f5493",
                                        "entry_id": "46d706c6-a1ee-3c75-9919-a1675a26a3f6",
                                        "glosses": [
                                            "Monastère (conservé en toponymie)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837de383-1d03-4f2d-8f75-24f45a5a6790",
                                                "sense_id": "5ffb457e-8f7a-3d51-b999-b4bc743f5493",
                                                "text": "Au tournant du sentier\nQui mène au moutier\nOn l'aperçoit tout entier\nA chacun l'air courtois\nDe son humble toit\nSemble dire : Enfin, c'est toi ! ..."
                                            },
                                            {
                                                "example_id": "b276276d-10cb-48f5-af4e-d9c09f87cf25",
                                                "sense_id": "5ffb457e-8f7a-3d51-b999-b4bc743f5493",
                                                "text": "La reprise des études du Dr Misès lui avait valu, en effet, une réputation imméritée d’hérésiarque et même quelques retraites punitives en de sévères moutiers."
                                            },
                                            {
                                                "example_id": "995336f7-c7de-4fbb-bd42-c7816b4df1a7",
                                                "sense_id": "5ffb457e-8f7a-3d51-b999-b4bc743f5493",
                                                "text": "Au XIᵉ siècle, un moutier avait poussé là lui aussi, dont le porche seul reste debout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f031a169-cc1e-33b0-bccc-7fb56c3db902",
                                        "entry_id": "46d706c6-a1ee-3c75-9919-a1675a26a3f6",
                                        "glosses": [
                                            "Église paroissiale."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6daea682-4b3b-4d98-80ea-21fad08cb083",
                        "source_entry_id": "fc368435-603d-39f8-9254-a8586f27bdc7",
                        "source_sense_description": "monastic church",
                        "target_lang_word": "Münster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Münster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                        "entry_id": "449e0fa1-f11d-3930-b77e-b7556aae7b49",
                                        "glosses": [
                                            "eine große, bedeutende Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3425c491-0888-40dd-919b-9a26f2a6c968",
                                                "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                                "text": "Das Freiburger Münster ist von weither aus der Oberrheinebene und vom Schwarzwald zu sehen."
                                            },
                                            {
                                                "example_id": "5190f8b8-f914-4a67-a3fa-a2cbfa70a154",
                                                "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                                "text": "Das Ulmer Münster besitzt den welthöchsten Kirchturm."
                                            },
                                            {
                                                "example_id": "31f4b485-d524-4ed0-a9ad-b9dc28423234",
                                                "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                                "text": "„Das Münster ist immer da, diese ruhige Ewigkeit aus rosa Sandstein.“"
                                            },
                                            {
                                                "example_id": "34844ead-f0b0-4f2e-a009-fc99cf2bbd84",
                                                "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                                "text": "„Auf dem Platz vor dem Münster drängen sich die Leute, es herrscht ein reges Kommen und Gehen.“"
                                            },
                                            {
                                                "example_id": "200a40f2-ac98-46fe-b8a8-7e995757bd6f",
                                                "sense_id": "7282d04d-6f90-31e3-9e74-e6f902008714",
                                                "text": "„Das prachtvolle weltliche Rathaus am Marktplatz bedeutete ihm mehr als das christliche Münster hoch auf dem Felsen am Rheinbogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
