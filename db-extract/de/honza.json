                ],
                "senses": [
                    {
                        "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                        "entry_id": "afdc5a21-af6c-3d14-b40a-8de7f6d79d63",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021e3748-24bc-482e-9c56-b446199d8230",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Honzas kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4c676b11-798d-455b-81fd-e27540ac5e47",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Frau Honza ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "58d3cad2-639a-4480-a806-eb1c9a158891",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Herr Honza wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e87916c7-0a8a-4773-bfce-9a2cfb9da180",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Die Honzas fahren heute nach Dresden."
                            },
                            {
                                "example_id": "92a069a2-d3c4-4981-b86a-0d3bc161cf80",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Der Honza trägt nie die Pullover, die die Honza ihm strickt."
                            },
                            {
                                "example_id": "2ba81fcc-49d9-4ede-97db-a45d9fd3edc4",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Honza kommt, geht der Herr Honza.“"
                            },
                            {
                                "example_id": "8a917ea8-2b81-4fd2-88f3-849a1f9f27ce",
                                "sense_id": "29d2ada4-8423-3f8e-a450-c9aec2ec73da",
                                "text": "Honza kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
