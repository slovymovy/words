                "senses": [
                    {
                        "sense_id": "d406043f-839b-33e4-b421-d6782cc11d06",
                        "entry_id": "8963a120-766c-3a3c-9460-827b8b85b7d8",
                        "glosses": [
                            "Affecter d’un coefficient, dans le sens de nombre qui fixe la valeur relative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d918c8de-d8c5-4f7f-b1c6-3f61ab65204c",
                                "sense_id": "d406043f-839b-33e4-b421-d6782cc11d06",
                                "text": "Plutôt que de donner une prime totale aux médailles d’or ça serait mieux de coefficienter les médailles. Exemple: 1 médaille d’or 6 pts, 1 médaille d’argent 3pts et 1 médaille de bronze 1pts."
                            },
                            {
                                "example_id": "94e2c132-d0be-4992-9134-2a5a012f2cbc",
                                "sense_id": "d406043f-839b-33e4-b421-d6782cc11d06",
                                "text": "Elle nous montre un esprit ingénieux en train de coefficienter sa représentation totalitaire imagée."
                            }
                        ]
                    }
