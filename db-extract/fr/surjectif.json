                ],
                "senses": [
                    {
                        "sense_id": "d985d763-7caa-3884-ac3e-e2ec7b211df0",
                        "entry_id": "2148907d-0bdf-389c-9de8-aa25019291b5",
                        "glosses": [
                            "Se dit d'une fonction ou d'une application qui est une surjection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb72e27-da8b-47c6-adba-14c4ba6945df",
                                "sense_id": "d985d763-7caa-3884-ac3e-e2ec7b211df0",
                                "text": "La fonction puissance au carré n'est pas surjective sur l'ensemble des nombres réels, car les nombres négatifs ne possèdent pas d'antécédent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8707a1ec-ae71-4296-aaac-bf5ff50e13a5",
                        "source_entry_id": "2148907d-0bdf-389c-9de8-aa25019291b5",
                        "source_sense_id": "d985d763-7caa-3884-ac3e-e2ec7b211df0",
                        "target_lang_word": "surjektiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surjektiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb71676c-0f80-3b1f-bd56-dc5c6449ea22",
                                        "entry_id": "c9a3dbc6-f76a-3011-a76d-25a97bafe1a1",
                                        "glosses": [
                                            "so, dass alle Elemente der Zielmenge als Werte vorkommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577481e4-c35a-46f3-b523-da830c7aa62c",
                                                "sense_id": "eb71676c-0f80-3b1f-bd56-dc5c6449ea22",
                                                "text": "Eine Abbildung ordnet jedem Element ihrer sogenannten Urbildmenge genau ein Element ihrer Zielmenge zu. Die Menge dieser zugeordneten Elemente in der Zielmenge nennt man das Bild / die Bildmenge der Abbildung. Die Abbildung heißt surjektiv dann und nur dann, wenn diese Bildmenge die gesamte Zielmenge umfasst."
                                            },
                                            {
                                                "example_id": "5eb5a42a-dd38-4ca3-8b2e-35203eb0a5df",
                                                "sense_id": "eb71676c-0f80-3b1f-bd56-dc5c6449ea22",
                                                "text": "Eine konstante Abbildung — also eine Abbildung, die jedem Element ihrer Urbildmenge ein und dasselbe Element der Zielmenge zuordnet — kann nicht surjektiv sein, sobald nur diese Zielmenge mehr als ein Element hat. Ähnlich kann keine Abbildung surjektiv sein, deren Zielmenge größer (genauer gesagt: mächtiger) als ihre Urbildmenge ist."
                                            },
                                            {
                                                "example_id": "ac5ee353-36ba-41ec-9825-ea7066cd4fed",
                                                "sense_id": "eb71676c-0f80-3b1f-bd56-dc5c6449ea22",
                                                "text": "Die Abbildung von den natürlichen Zahlen in die natürlichen Zahlen, die jeder Zahl die nachfolgende zuordnet, ist nicht surjektiv, weil die kleinste natürliche Zahl keinen Vorgängerin besitzt. Jedoch ist die entsprechende Abbildung von den ganzen Zahlen in die ganzen Zahlen surjektiv, weil hier wirklich jede Zahl eine Vorgängerin hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0820349d-f070-4df3-b93f-1390fc41cb9e",
                        "source_entry_id": "2148907d-0bdf-389c-9de8-aa25019291b5",
                        "source_sense_id": "d985d763-7caa-3884-ac3e-e2ec7b211df0",
