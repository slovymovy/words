                                "target_senses": [
                                    {
                                        "sense_id": "4a32b49c-1253-3b5c-ae7b-19a73e74f716",
                                        "entry_id": "ea04aeca-b776-3a5b-8daf-38054b6fae5f",
                                        "glosses": [
                                            "The fans of a sport, activity, work, person etc., taken as a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5215e06-4456-4a24-a716-61da4344ebb0",
                                                "sense_id": "4a32b49c-1253-3b5c-ae7b-19a73e74f716",
                                                "text": "\"'Who is this Swain?' is the question that is being bowled about in local fandom.\""
                                            },
                                            {
                                                "example_id": "ef46c530-f7d4-4cf5-b037-50e81bf2998e",
                                                "sense_id": "4a32b49c-1253-3b5c-ae7b-19a73e74f716",
                                                "text": "So I was like, ‘When this comes out, fans are going to lose their s–t!’ And I was half-right. I’ve watched fandoms get mad at creators before like Rian Johnson on ‘The Last Jedi.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8cd360-3c42-345d-bef6-754547d09bf3",
                                        "entry_id": "ea04aeca-b776-3a5b-8daf-38054b6fae5f",
                                        "glosses": [
                                            "The subculture of fans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7d4a7ab-d947-3359-8344-4756aceab2f1",
                                        "entry_id": "ea04aeca-b776-3a5b-8daf-38054b6fae5f",
                                        "glosses": [
                                            "The state, quality, or condition of being a fan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bccb32-defe-4806-95ba-dc60afab00d6",
                                                "sense_id": "e7d4a7ab-d947-3359-8344-4756aceab2f1",
                                                "text": "Despite personal schisms and differences in spiritual experience, there is a very coherent theology of Snape shared between the wives. To examine this manifestation of religious fandom, I will first discuss the canon scepticism and anti-Rowling sentiment that helps to contextualise the wider belief in Snape as a character who extends beyond book and film."
                                            }
                                        ]
                                    }
                                ]
                            }
