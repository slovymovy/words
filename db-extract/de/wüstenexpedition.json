                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f1ff5d-bd32-4b6a-a8a3-150d47a2d9c9",
                                "sense_id": "0f5631ca-0be3-3cbf-a01d-584c2ab67a18",
                                "text": "„Europäische Wüstenexpeditionen und Chartertouristen, alle landen sie früher oder später in Tam, und alle verlaufen sie sich in den Korridoren des Hotel Tahat.“"
                            },
                            {
                                "example_id": "a5ebc30d-a1ca-4e1a-b53b-1cfa417fc18c",
                                "sense_id": "0f5631ca-0be3-3cbf-a01d-584c2ab67a18",
                                "text": "„Wenngleich überaus hässlich, waren diese Geschöpfe doch zahm und gefügig und wie geschaffen für Wüstenexpeditionen, da sie bei Bedarf monatelang ohne Wasser auskamen.“"
                            }
                        ],
