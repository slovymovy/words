                ],
                "senses": [
                    {
                        "sense_id": "7b53eb67-9994-3415-abcb-496478772dea",
                        "entry_id": "8bc0fbc6-1bb2-3b75-b0ed-b8bdc7ff0d3e",
                        "glosses": [
                            "Ort, an den selige Menschen nach dem Tod kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3d6f79-8a8f-4414-afc6-e0926814d221",
                                "sense_id": "7b53eb67-9994-3415-abcb-496478772dea",
                                "text": "„So vertraut die Szene war, fehlten ihr einige Elemente. Es gab keine teuflische Schlange, und Bäume und Sträucher des Paradiesgartens waren zwar hell vom Morgenlicht beschienen, doch gab es keine verbotene Frucht, und Evas Hand war anderweitig beschäftigt.“"
                            },
                            {
                                "example_id": "3f9af80e-3597-4397-ada7-914b9946f398",
                                "sense_id": "7b53eb67-9994-3415-abcb-496478772dea",
                                "text": "„Zugleich konnte man in dem Paradiesgarten sogar eine Allegorie der Kirche sehen.“"
                            },
                            {
                                "example_id": "8bbed886-0ee9-4499-8294-1d039f8cdcd6",
                                "sense_id": "7b53eb67-9994-3415-abcb-496478772dea",
                                "text": "„Sein Beispiel ist Adam, der glücklich und zufrieden im Paradiesgarten lebt, bis Gott ihm den Baum der Erkenntnis zeigt und sagt: ›Davon darfst du nicht essen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
