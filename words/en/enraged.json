                            {
                                "target_lang_word": "woedend maakte",
                                "target_lang_sense_clarification": "verleden tijd"
                            },
                            {
                                "target_lang_word": "woedend gemaakt",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            },
                            {
                                "target_lang_word": "vertoornde",
                                "target_lang_sense_clarification": "formeel/archaïsch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
