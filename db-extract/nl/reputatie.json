                        ],
                        "form": "reputatietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "glosses": [
                            "de manier waarop iemand bekend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d6e634-56c8-4e6f-b0c8-69d0e4e296b7",
                                "sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                                "text": "Ik moet mijn reputatie beschermen."
                            },
                            {
                                "example_id": "2f82f3cf-4946-4c17-a6c0-afce8d647a09",
                                "sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                                "text": "'Hij heeft een kunstwerk verkocht en werkt aan de reputatie van een veelbelovende jonge kunstenaar' 'Die niet bestaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cf7bf45-876e-3bff-9534-aaf4f2d17d67",
                        "entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "glosses": [
                            "de manier waarop iets bekend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fc1c37-9e16-4e12-8a33-1f84aa190716",
                                "sense_id": "3cf7bf45-876e-3bff-9534-aaf4f2d17d67",
                                "text": "Het lijkt erop dat vrijwel alle Griekse steden hun eigen festivals met sportwedstrijden hadden, waarvan de reputatie en aantrekkingskracht varieerde."
                            },
                            {
                                "example_id": "492d015c-3d50-4659-a3b2-d1979fada09e",
                                "sense_id": "3cf7bf45-876e-3bff-9534-aaf4f2d17d67",
                                "text": "La Planche heeft niet de mythische uitstraling van de Mont Ventoux, de Tourmalet of de Alpe d’Huez, maar aan de reputatie wordt gewerkt. De vorige aankomsten waren vol betekenis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "453ec792-490d-4353-a5fb-83a585ff7016",
                        "source_entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "source_sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "source_sense_description": "de manier waarop iemand bekend is",
                        "target_lang_word": "Ruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "ein Laut, der an jemanden adressiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de727445-15f9-479e-89f3-acb37c35f892",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "Der Ruf „Feuer!“ hallte durch das Haus."
                                            },
                                            {
                                                "example_id": "de28b105-4b56-4125-a955-53d7bddc665a",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "„Die üppigen Ansprüche vieler Konzernchefs heizen den allgemeinen Unmut und die Rufe nach staatlicher Deckelung weiter an.“"
                                            },
                                            {
                                                "example_id": "43ac3858-c429-427b-8745-e02e5b170e69",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "„Die Donau belebte sich jetzt, eine Menge Barkassen und Kaiks manövrierten dort, begleitet von vielstimmigen Rufen, vom Knarren der Taue und Winden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "das Ansehen, das jemand bei anderen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc4c67d-d33b-4eca-8631-4f46e1f1fc37",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "Weil er gerade hier versagte, litt sein Ruf erheblich."
                                            },
                                            {
                                                "example_id": "106423c1-bc6b-45a8-ae40-8e766abd2653",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„Die europäische Politik ist besser als ihr Ruf. Viele Bürger ahnen das. Selbst in Großbritannien ist die Zustimmung zur EU zuletzt gewachsen.“"
                                            },
                                            {
                                                "example_id": "133378cb-d8e2-4afc-b241-d477decaded3",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„Gerade Romney, derzeit Gouverneur von Massachusetts, hat sich im Olympiabusiness als Krisenmanager einen ausgezeichneten Ruf erworben.“"
                                            },
                                            {
                                                "example_id": "be751a21-503c-4a74-b04f-9eb1a89d2f5f",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„In Privatgesprächen erwog man die Rückkehr Einsteins nach Zürich, diesmal an die Eidgenössische Technische Hochschule, die einen besseren wissenschaftlichen Ruf genoß als die Universität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "eine Aufforderung, beispielsweise einen Platz oder eine Position (an einer Universität) einzunehmen oder etwas zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a967f05-2a5b-4285-8e7f-6db029099f8f",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "Er erhielt einen Ruf auf den Lehrstuhl für xy an der Universität Bonn."
                                            },
                                            {
                                                "example_id": "debf1a66-9195-44a6-bc7c-ca0e078ddeb2",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "„1911 erhält der Vater einen Ruf auf einen für ihn eingerichteten Lehrstuhl an der Universität Berlin.“"
                                            },
                                            {
                                                "example_id": "0183cfed-8357-460e-97c4-9d8c717ed7ee",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "„Am Ende stand der Ruf an die Universität von Erfurt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e630817-467b-40f5-89a3-338d983819e5",
                        "source_entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "source_sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "source_sense_description": "de manier waarop iemand bekend is",
                        "target_lang_word": "Leumund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leumund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                        "entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                                        "glosses": [
                                            "Ruf, den jemand hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b21fc5-ebd8-43a3-9351-9ae731311739",
                                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                                "text": "Ihrer Schwiegertochter kann man einen einwandfreien Leumund bescheinigen."
                                            },
                                            {
                                                "example_id": "cf18093f-b4fa-4788-9b8a-6f9ee3dc649f",
                                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                                "text": "„Der Leumund war freilich ein Nachruf.“"
                                            },
                                            {
                                                "example_id": "74c0015b-b793-439a-bf9a-4b03deda4f7f",
                                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                                "text": "„Auch Wieland beruft man als den berühmten Schriftsteller, der er ist, ungeachtet der fehlenden akademischen Qualifikation. Das sorgt bei den eingesessenen Professoren für Maulerei, zumal Wieland den Leumund eines Freigeistes hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a35e31e6-b828-4020-b9ea-70da487128f7",
                        "source_entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "source_sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "source_sense_description": "de manier waarop iemand bekend is",
                        "target_lang_word": "reputation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reputation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                        "entry_id": "677ba6cc-1d8a-37e7-87dd-a6752e847ae7",
                                        "glosses": [
                                            "What somebody or something is known for."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30c9bc7-e4b7-4d66-bcdb-f4b79d6e9f40",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "And Balaam (or as the trueth of the hebrewe hath Bileam) doth signifie the people of no reputation\n or the vayne people or they that are not counted for people."
                                            },
                                            {
                                                "example_id": "37799a24-5d7b-408f-8f43-6da3c8600868",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "Sometimes a man makes a reputation, deserved or otherwise, by a single action."
                                            },
                                            {
                                                "example_id": "b7e4e278-c361-4fc8-870b-7a14d2fc5bb0",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "The reputations of our universities and our research base are already under threat because of the fallout from the EU referendum result, which is making the UK an unfriendlier place for overseas scholars and students, as well as cutting off access to an important stream of research funding and to a vibrant and well-developed ecosystem for collaborative work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08bfd029-4eb8-4a19-a06f-7674f82453d8",
                        "source_entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "source_sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "source_sense_description": "de manier waarop iemand bekend is",
                        "target_lang_word": "réputation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réputation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Opinion bonne ou mauvaise au sujet d'une personne ou d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193f7fb5-6697-4448-a9eb-82ad855feb04",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Sa bravoure lui valait une haute réputation militaire que rien ne démentait, parce qu'il n'avait jamais commandé en chef."
                                            },
                                            {
                                                "example_id": "f9b77cee-0985-4017-8f38-186415f279aa",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Au village, sans prétention,\n J'ai mauvaise réputation […]."
                                            },
                                            {
                                                "example_id": "071d92b7-21f1-4b2b-9979-dcc12e3851ec",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "La réputation de sagacité et de prudence de notre frère n’est pas moindre parmi nous que celle que lui ont value sa valeur et son savoir ; […]."
                                            },
                                            {
                                                "example_id": "7202aa03-96d0-4f3f-8c58-909f3034142f",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Et puis encore, Balzac avait mauvaise réputation. Il n'administrait pas son nom et son œuvre en bon père de famille. Ce n'était même pas un bohème – et l'on sait qu'un bohème est inacadémisable –, c'était quelque chose de bien pis."
                                            },
                                            {
                                                "example_id": "62ed1e24-8896-4775-9190-ed882d8c6b21",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Sur leur trente et un et la cigarette aux lèvres, les jeunes gens partirent pour le lieu du rendez-vous, […], tous deux donnant l’exemple de la façon dont une indomptable crânerie peut triompher d’une réputation d’insolvabilité."
                                            },
                                            {
                                                "example_id": "1dd5269a-db7c-4565-b86a-577b59090a98",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "D’autre part, cette mansuétude et cette bonté vraiment chrétiennes lui avaient assis, parmi les ouailles, une solide réputation de brave et d’honnête homme, […]."
                                            },
                                            {
                                                "example_id": "bf462f5c-2aa8-49d1-8aee-d6576a9e9937",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Il se fabriquait une étrange réputation, personnage de légende qui voyait à travers le brouillard, savait se rendre invisible aux gabelous, capable de tout !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Honorabilité ; renommée de bonne moralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b22d36-f0d1-4770-885b-45592dde57ca",
                                                "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                                "text": "Or, des outrages par paroles, des actes ou des gestes contumélieux, non accompagnés de voies de fait, peuvent produire ce résultat, autant et plus même que les violences physiques. Les atteintes dirigées contre l'honneur et la réputation sont parfois autrement graves que ne le seraient des attaques corporelles; l'indignation qu'elles soulèvent est aussi plus vive et plus profonde."
                                            },
                                            {
                                                "example_id": "7ac5717c-53b7-436e-b66b-78779590bd95",
                                                "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                                "text": "Selon un sondage Ifop pour l’Observatoire de la réputation, 58,5% des Français n’étaient pas au courant de l’affaire avant que le président du CSA n’en parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Notoriété ; renom ; renommée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e74e74-9570-4d7f-b4f1-7cd617617673",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "Ce ne fut que sur l’observation que je lui fis que ce costume donnerait une haute idée de son talent et le mettrait en réputation à Paris, qu’il consentit à s’en dessaisir."
                                            },
                                            {
                                                "example_id": "461d76c4-30f7-4674-9999-095c1cc35394",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "La réputation de ce grand homme reposait principalement sur l’autorité avec laquelle il démontrait que l’éternument était une prévoyance de la nature, au moyen de laquelle les penseurs trop profonds pouvaient chasser par le nez le superflu de leurs idées ; […]."
                                            },
                                            {
                                                "example_id": "4f1e3294-e5c1-4b35-bd80-a2b8b3c61b44",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "La ville avait la réputation d'être imprenable ; son château s'élevait à l'est et la ceinture de murailles qui entourait la cité venait s'y attacher; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0183fabd-27d1-4414-b497-f786814876dd",
                        "source_entry_id": "07d30bc5-58bd-3114-9aed-3642bdd45041",
                        "source_sense_id": "168fc2eb-9554-3f8a-8135-411642e17cae",
                        "source_sense_description": "de manier waarop iemand bekend is",
                        "target_lang_word": "renommée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renommée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9446ef8f-5fac-38c6-82c0-85faf7a3e590",
                                        "entry_id": "0e7c9015-e14e-3d9c-a67f-91b75d89fcec",
                                        "glosses": [
                                            "Renom, réputation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f64e2aa-bf24-4c7c-9384-6912b31ae1e3",
                                                "sense_id": "9446ef8f-5fac-38c6-82c0-85faf7a3e590",
                                                "text": "L'anthroponymie, la renommée, le corps et son action sont exprimés de manière comparable au sein d'un même rang social. Tous les milieux utilisent les mêmes outils pour s'identifier, le nom, la fonction, la renommée, mais chacun en usent avec leurs propres champs lexicaux."
                                            },
                                            {
                                                "example_id": "f925b4a0-8543-46b7-a099-e642f838ff3b",
                                                "sense_id": "9446ef8f-5fac-38c6-82c0-85faf7a3e590",
                                                "text": "Le nom illustre que je porte, et auquel j’ai su donner le plus grand éclat, devient un titre de honte et de reproche ; je perds ma renommée, mon honneur et même la perspective d’une grandeur que les empereurs ont peine à atteindre."
                                            },
                                            {
                                                "example_id": "0c08fa08-97c2-408e-85de-1389c5ec5c1d",
                                                "sense_id": "9446ef8f-5fac-38c6-82c0-85faf7a3e590",
                                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l’importance et à la renommée d’un individu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91027fb-b07c-392d-9331-755e56df0f5c",
                                        "entry_id": "0e7c9015-e14e-3d9c-a67f-91b75d89fcec",
                                        "glosses": [
                                            "Le personnage qui jouit de cette renommée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7085e0e-91cd-4b88-bfd6-a0ac712c4f1d",
                                                "sense_id": "b91027fb-b07c-392d-9331-755e56df0f5c",
                                                "text": "S’il est glorieux d’épouser une grande renommée, on s’aperçoit bientôt qu’un homme supérieur est, en tant qu’homme, semblable aux autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e3e12b4-6292-3628-84c1-8ca4f8cf2e01",
                                        "entry_id": "0e7c9015-e14e-3d9c-a67f-91b75d89fcec",
                                        "glosses": [
                                            "Voix publique qui annonce quelque action, quelque évènement remarquable, qui répand l’éloge ou le blâme sur quelque personnage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5eaed0-b8a7-47a3-b738-cddf5aed6781",
                                                "sense_id": "0e3e12b4-6292-3628-84c1-8ca4f8cf2e01",
                                                "text": "J’ai appris cette action, ce grand évènement par la renommée."
                                            },
                                            {
                                                "example_id": "5e415835-1e1d-4ea1-9498-fd3a29d02019",
                                                "sense_id": "0e3e12b4-6292-3628-84c1-8ca4f8cf2e01",
                                                "text": "Je n’en fus instruit que par la renommée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9407e98-3401-3067-96d0-3743926a027d",
                                        "entry_id": "0e7c9015-e14e-3d9c-a67f-91b75d89fcec",
                                        "glosses": [
                                            "Être mythologique et allégorique, représenté sous les traits d’une déesse embouchant la trompette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2846cf4e-f798-4a6a-ba40-8b7b7565d6bd",
                                                "sense_id": "f9407e98-3401-3067-96d0-3743926a027d",
                                                "text": "Grasset n'est pas de ceux qui ont fait retentir avec toute la puissance et tout l'éclat de leur aimable médiocrité le pavillon des cuivres engorgés de la Renommée ; la Déesse aux cent bouches polluées par toutes les irrumations littéraires et artistiques n'est s'est pas plus souciée de sa gloire, que lui ne s'est préoccupé des complaisantes fanfares et sonneries de cette vieille buccinatrice."
                                            }
                                        ]
                                    }
                                ]
                            },
