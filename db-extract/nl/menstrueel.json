                                "target_senses": [
                                    {
                                        "sense_id": "1853275b-16f0-38bc-8fd9-4f7fc6892337",
                                        "entry_id": "a0681ca4-7937-373a-ad0a-ae6662ddfffb",
                                        "glosses": [
                                            "A menstrual period."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34656287-06e4-4197-a3f0-6d4ff7b28a88",
                                                "sense_id": "1853275b-16f0-38bc-8fd9-4f7fc6892337",
                                                "text": "“All that drama for what” I thought. All she had to do was tell me that I was having my menstrual. So much for band aids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91cb4ad3-be8f-444d-b0d0-d29aa922337c",
                        "source_entry_id": "62c91c3d-a1f4-375b-85a6-11ab7d883aae",
                        "source_sense_id": "ed8fca26-7afb-3d78-a839-f44422e20a6f",
                        "target_lang_word": "menstruel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menstruel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dddbc6f-aa9e-397f-95e7-ec3a623ef861",
                                        "entry_id": "dd8456b7-b2f8-36ab-baa5-e5a1f14070d1",
                                        "glosses": [
                                            "Qui arrive tous les mois, qui a rapport à la menstruation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64bf3a1-1ff5-4aba-a362-91416e09abce",
                                                "sense_id": "9dddbc6f-aa9e-397f-95e7-ec3a623ef861",
                                                "text": "Il est d'usage courant que les pensionnaires travaillent même en période menstruelle ; la tenancière use de savants maquillages pour laisser ignorer au client l'état de sa partenaire."
                                            },
                                            {
                                                "example_id": "8935701e-71f0-4e53-8ead-92615122c40e",
                                                "sense_id": "9dddbc6f-aa9e-397f-95e7-ec3a623ef861",
                                                "text": "On ne prend les mots qu'avec des gants : à menstruel on préfère périodique, et l'on va répétant qu'il est des termes médicaux qui ne doivent pas sortir des laboratoires ou du Codex."
                                            },
                                            {
                                                "example_id": "42e9c096-e9f7-4374-84b7-af35b2103b90",
                                                "sense_id": "9dddbc6f-aa9e-397f-95e7-ec3a623ef861",
                                                "text": "Les femelles de certaines espèces [de chauves-souris] font partie des très rares mammifères présentant des écoulements menstruels."
                                            },
                                            {
                                                "example_id": "ceaa8a2c-8c27-4908-9de2-f59cc17d564b",
                                                "sense_id": "9dddbc6f-aa9e-397f-95e7-ec3a623ef861",
                                                "text": "Une grossesse n’est jamais le fruit d’un hasard céleste : sauf cas particulier (PMA), elle résulte d’un rapport sexuel pénétratif avec un individu doté d’un pénis durant la brève période de fécondité du cycle menstruel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
