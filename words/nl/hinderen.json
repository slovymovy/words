                            },
                            {
                                "target_lang_word": "impede",
                                "target_lang_sense_clarification": "to delay or block the movement or progress of something"
                            },
                            {
                                "target_lang_word": "obstruct",
                                "target_lang_sense_clarification": "to block a path or progress"
                            },
                            {
                                "target_lang_word": "hamper",
                                "target_lang_sense_clarification": "to restrict movement or efficiency"
                            }
                        ],
                        "fr": [
                            {
