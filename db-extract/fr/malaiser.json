                "senses": [
                    {
                        "sense_id": "60716eae-e34c-3117-b563-715bd43f2123",
                        "entry_id": "bd72da54-29f9-3d3a-b9be-11ab5d1be54a",
                        "glosses": [
                            "Mettre mal à l’aise."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "be125fb3-c897-430d-9792-e6649cf91130",
                                "sense_id": "60716eae-e34c-3117-b563-715bd43f2123",
                                "text": "Petit conseil pour Gautier, le nouveau « responsable » pas besoin d’être agressif et de malaiser les gens comme ça au micro !!"
                            },
                            {
                                "example_id": "46a224d5-3769-43a6-a741-231dd39ad611",
                                "sense_id": "60716eae-e34c-3117-b563-715bd43f2123",
                                "text": "passion : malaiser les hétéros…"
                            },
                            {
                                "example_id": "2c456ee0-b69c-4b80-ae31-8c6f720e0cab",
                                "sense_id": "60716eae-e34c-3117-b563-715bd43f2123",
                                "text": "On me préconisait le contact avec des plus jeunes. Les petits m'aimaient bien, mais les voisins se sont vite passés de mes services. Un je-ne-sais-quoi chez moi qui malaisait les parents."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f08b9e2-7d67-3c01-9f24-1b5154bdf234",
                        "entry_id": "bd72da54-29f9-3d3a-b9be-11ab5d1be54a",
                        "glosses": [
                            "Être mal à l’aise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6246119-1f69-424a-bdc8-bac2e024ae6c",
                                "sense_id": "3f08b9e2-7d67-3c01-9f24-1b5154bdf234",
                                "text": "Essayer de ne pas rire, malaiser et quitter la vidéo"
                            },
                            {
                                "example_id": "e3c72438-85e2-4adf-bbd1-ea3c3bf74f6e",
                                "sense_id": "3f08b9e2-7d67-3c01-9f24-1b5154bdf234",
                                "text": "ça vous arrive de malaiser pendant la branlette?"
                            }
                        ]
                    }
