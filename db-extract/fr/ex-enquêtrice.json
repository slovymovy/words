                            {
                                "example_id": "3ddd2647-0e5f-4d0a-b2be-c3c88dbf8403",
                                "sense_id": "a46b5e00-f23a-3602-88e6-89d26c2286d9",
                                "text": "« C’était une course contre la montre », se rappelle Raphaëlle, une ex-enquêtrice de la Sdat, qui a vu le long métrage."
                            },
                            {
                                "example_id": "9aaa868a-9205-4707-b1d9-28abb30b12ae",
                                "sense_id": "a46b5e00-f23a-3602-88e6-89d26c2286d9",
                                "text": "Le cas de Caroline Hunt-Matthes, l’ex-enquêtrice en procès avec les Nations unies depuis treize ans, l’illustre : mis à l’écart, les lanceurs d'alerte se retrouvent souvent acculés."
                            },
                            {
                                "example_id": "4643d9ac-b2a7-4d1c-a429-8be031fbc83a",
                                "sense_id": "a46b5e00-f23a-3602-88e6-89d26c2286d9",
                                "text": "Light obtient finalement le vrai nom de l’ex-enquêtrice et décrit son suicide sur une feuille volante du carnet, prétextant simplement de prendre des notes."
                            }
                        ]
