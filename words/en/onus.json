    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cb01516-8067-3138-ba69-892d7105cb7a",
                    "sense_definition": "A responsibility or duty to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>onus</w> is on the company to ensure that all safety regulations are strictly followed."
                        },
                        {
                            "text": "It is unfair to place the entire <w>onus</w> of the project's success on one single employee."
                        }
                    ],
                    "synonyms": [
                        "burden",
                        "responsibility",
                        "duty",
                        "obligation"
                    ],
                    "common_phrases": [
                        "onus is on"
                    ]
                },
                {
                    "sense_id": "90fd76cb-4c4d-332b-bfdf-fe52a6a2b439",
                    "sense_definition": "A specific legal obligation or requirement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>onus</w> rests with the landlord to maintain the property in a habitable condition."
                        },
                        {
                            "text": "Under the new contract, the <w>onus</w> is on the supplier to deliver goods by the deadline."
                        }
                    ],
                    "synonyms": [
                        "liability",
                        "obligation"
                    ]
                },
                {
                    "sense_id": "1b74b950-7295-3a71-84f0-5659ca5140d8",
                    "sense_definition": "The burden of proving a claim or assertion in a legal or formal context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a criminal trial, the <w>onus</w> of proof lies with the prosecution to prove guilt beyond a reasonable doubt."
                        },
                        {
                            "text": "The <w>onus</w> of proof remains with the party making the allegation throughout the entire proceeding."
                        }
                    ],
                    "synonyms": [
                        "burden of proof"
                    ],
                    "common_phrases": [
                        "onus of proof"
                    ]
                },
                {
                    "sense_id": "85cdf57f-1eba-35fb-a0a1-7fc653e654e8",
                    "sense_definition": "The state of being held responsible or blamed for something negative.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "blame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both sides tried to shift the <w>onus</w> for the failure of the negotiations onto each other."
                        },
                        {
                            "text": "He refused to accept the <w>onus</w> for the mistake that led to the project delay."
                        }
                    ],
                    "synonyms": [
                        "blame",
                        "fault"
                    ]
                },
                {
                    "sense_id": "1e10b25a-8130-32bf-85c4-9df2c701b63e",
                    "sense_definition": "A feeling of shame or social disapproval associated with a particular condition or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to escape the <w>onus</w> of her family's controversial past in the small town."
                        },
                        {
                            "text": "The public figure tried to distance himself from the <w>onus</w> of the scandal that ruined his reputation."
                        }
                    ],
                    "synonyms": [
                        "stigma",
                        "disgrace"
                    ]
                }
            ]
        }
    ]
}