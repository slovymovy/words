                            {
                                "example_id": "e1335252-3ae7-4dcf-954f-916cdd8148b3",
                                "sense_id": "c8bc9e37-d77c-3a71-a251-88ab547aaba9",
                                "text": "Die Handelshochschule Leipzig bietet einen »Master of Science in Management (MSc)« an mit Spezialisierungsmöglichkeiten in Finance, Accounting, Marketing, Logistics & Supply Chain Management, Strategy und Entrepreneurship."
                            },
                            {
                                "example_id": "3cdd3af6-a3d5-49be-b74d-16c7ea841c3c",
                                "sense_id": "c8bc9e37-d77c-3a71-a251-88ab547aaba9",
                                "text": "Sofern sie einen wirtschaftswissenschaftlichen Bachelor-Abschluss haben, können sie dort den Master of Science in International Management mit Schwerpunkt Sourcing & Logistics (MSc Logistics) erwerben."
                            },
                            {
                                "example_id": "acdb11c0-c67e-4862-9ac2-8fe328730e4c",
                                "sense_id": "c8bc9e37-d77c-3a71-a251-88ab547aaba9",
                                "text": "In Österreich ist der Titel MSc nach dem Zunamen zu schreiben."
                            }
                        ],
