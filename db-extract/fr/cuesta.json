                        "sense_id": "c22a7010-395d-3ae3-82f7-98fbbcc6c589",
                        "entry_id": "7e432fe1-8d0f-3c1e-9b0d-3401cf88510b",
                        "glosses": [
                            "Forme du relief dissymétrique constituée d’un coté par un talus à profil concave en pente raide, et de l’autre, par un plateau doucement incliné en sens inverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f295ef-c3f8-4183-9bb3-e18e6c0252fa",
                                "sense_id": "c22a7010-395d-3ae3-82f7-98fbbcc6c589",
                                "text": "Les cuestas sont à trouver aux bordures des bassins sédimentaires peu déformés."
                            },
                            {
                                "example_id": "e0e9ab8b-c3c3-4c7c-996f-789d1867be2b",
                                "sense_id": "c22a7010-395d-3ae3-82f7-98fbbcc6c589",
                                "text": "Si, au contraire, la différence de dureté entre la couche dure et la couche tendre est peu accentuée, aucune corniche ne se dessine ; la cuesta présente un profil convexe en haut, concave en bas, et se marque peu dans le paysage."
                            }
                        ]
                    }
                ],
