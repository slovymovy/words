                    {
                        "sense_id": "9655c234-510e-38e2-81de-4a12e52b2764",
                        "entry_id": "19ea3266-bab1-3f9b-a56c-4e8ad991ffdc",
                        "glosses": [
                            "in geordende, kalme opeenvolging van het een op het ander overgaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8610d9a9-bd28-46f0-950d-4126e1a29000",
                                "sense_id": "9655c234-510e-38e2-81de-4a12e52b2764",
                                "text": "De dekolonisatie is voor sommige landen veel geleidelijker geweest dan voor andere."
                            },
                            {
                                "example_id": "61691822-e02d-4f8a-b723-12798a2003ac",
                                "sense_id": "9655c234-510e-38e2-81de-4a12e52b2764",
                                "text": "Het was even wennen om helemaal alleen door de uitgestorven woestijn te lopen, maar toch raakte ik geleidelijk in een ritme."
                            }
                        ]
                    }
                ],
                "translations": [
