                    {
                        "sense_id": "c3944503-db1c-3ea1-9465-4b4eb520ccaf",
                        "entry_id": "57bb26e5-b1d9-30b6-aee7-56cc263bf212",
                        "glosses": [
                            "Having two rows of branches, lobes, leaflets, or veins arranged on each side of a common axis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4453f6e8-d72f-43e9-b667-7f83fd4d350d",
                                "sense_id": "c3944503-db1c-3ea1-9465-4b4eb520ccaf",
                                "text": "Mimosa is a tree with pinnate leaves."
                            },
                            {
                                "example_id": "e83a4f16-468c-4d17-9a6b-aa2971c27d62",
                                "sense_id": "c3944503-db1c-3ea1-9465-4b4eb520ccaf",
                                "text": "The trunk is unbranched, often much shortened, and bears a crown of feathery or pinnate fronds."
                            }
                        ]
                    },
                    {
                        "sense_id": "13643d1f-54b8-3cee-ba0d-face33902469",
                        "entry_id": "57bb26e5-b1d9-30b6-aee7-56cc263bf212",
                        "glosses": [
                            "Having a winglike tuft of long feathers on each side of the neck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d0dc8c-5b71-461b-849d-8a2016810353",
                                "sense_id": "13643d1f-54b8-3cee-ba0d-face33902469",
                                "text": "the pinnate grouse, or prairie chicken"
                            }
                        ]
                    },
