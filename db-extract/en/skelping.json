                                "example_id": "9b03bd47-1991-44dd-8130-8a99e5ee0371",
                                "sense_id": "1a5749e5-da8b-388f-9e4b-f1828ddd8936",
                                "text": "The word was old Scots for a good spanking, particularly in relation to the punishment of a miscreant child, and the Scots, after centuries of skelpings at the hands of the English themselves, absolutely loved it."
                            },
                            {
                                "example_id": "8c881a64-e1b2-4f44-b4e5-b0032280074f",
                                "sense_id": "1a5749e5-da8b-388f-9e4b-f1828ddd8936",
                                "text": "Jonty's instinctive awestruck expression had been curtailed by repeated skelpings across the head by his father, Henry."
                            }
                        ]
                    }
