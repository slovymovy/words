                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd603c0-f862-4773-8b89-08ebd11a496e",
                        "source_entry_id": "1291997f-4250-3e80-aa05-2dc839e750b4",
                        "source_sense_description": "machine that produces cold air",
                        "target_lang_word": "Kühlschrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kühlschrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                        "entry_id": "87bcb7d3-6ad2-3218-a1a9-2a78773afb45",
                                        "glosses": [
                                            "kastenförmiges, einem Schrank ähnliches, gegen Wärme isoliertes und mit einem Kühlsystem ausgestattetes Behältnis, in dem leicht verderbliche Lebensmittel kühl aufbewahrt werden, um sie frischzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122f98cf-fb9b-4797-b96c-c414d863a75b",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "Immer wenn man die Tür des Kühlschrankes öffnet, brennt darin Licht."
                                            },
                                            {
                                                "example_id": "93011afa-1705-462e-816c-05cadbc9e99c",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "Die Flasche Wein steht im Kühlschrank."
                                            },
                                            {
                                                "example_id": "2055fd3b-a49e-4160-9f6f-7d9eed089340",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Die Wohnung beginnt mit einem winzigen Flur, dessen linke Seite eine Küche in der Wand hat und mit dem wuchtigen Kühlschrank endet.“"
                                            },
                                            {
                                                "example_id": "19cbf25b-ab0d-42c1-a109-8ecb19b1b099",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Sie ißt wenig und im Stehen, vor dem Kühlschrank oder auf dem Balkon.“"
                                            },
                                            {
                                                "example_id": "b174888c-7310-4daf-8d7c-bfed06fb42d8",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Ich muss etwas Salziges essen, aber der Kühlschrank ist leer.“"
                                            },
                                            {
                                                "example_id": "315b3ef6-0b71-4d4a-bf91-16bd18e34d3a",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "«Im Kühlschrank fand sich eine angebrochene Packung Milch.»"
                                            },
                                            {
                                                "example_id": "b57fd55f-b642-40cc-9b35-d04854929774",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„In der Teeküche nahm er eine Limonade aus dem Kühlschrank.“"
                                            },
                                            {
                                                "example_id": "690993e5-a7a1-4dbd-8c80-748c9d2876ed",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Aus der Küche höre ich das Geräusch des zuschnappenden Kühlschranks.“"
                                            },
                                            {
                                                "example_id": "41e0f217-b84a-46d3-aa10-06dadaef4d84",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Sie hatte den Haustürschlüssel auf den Kühlschrank gelegt.“"
                                            },
                                            {
                                                "example_id": "64949fe1-c8df-4943-95f2-a944f44d596a",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Den Kühlschrank haben wir schon ausgeräumt, die Küchenregale ebenfalls.“"
                                            },
                                            {
                                                "example_id": "3588e124-7375-490c-b6a7-3f9e0cb81751",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Die wenigen Lebensmittel im Kühlschrank stelle ich im verzweifelten Versuch, so etwas wie ein Frühstück zu kuratieren, auf den Esstisch.“"
                                            },
                                            {
                                                "example_id": "3b5d0c86-e65f-49b0-8cca-1f76a271a28d",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Eier sollten Sie am besten im Kühlschrank lagern.“"
                                            },
                                            {
                                                "example_id": "1652467b-93e2-4cae-bf2f-e70dc6d7f8cb",
                                                "sense_id": "724f0cb6-dbb3-3ba6-8056-405cafca7932",
                                                "text": "„Eier in der Schale sind bis zu sechs Wochen im Kühlschrank haltbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
