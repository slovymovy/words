                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4933243a-aaac-400d-9ee5-8e7c6cd8887e",
                        "source_entry_id": "31d75ca3-187c-3636-bf7c-a2831938bd66",
                        "source_sense_id": "c2acb690-07d3-3d0e-8c1f-3f30c6f82875",
                        "target_lang_word": "Abolitionist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abolitionist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30790980-0108-3cd6-95b3-8e9109f65777",
                                        "entry_id": "e42a3798-f60e-37a2-a617-c63cba8f9fff",
                                        "glosses": [
                                            "Person, die sich für die Abschaffung der Sklaverei einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80930a0f-4761-434a-af42-5087599cae25",
                                                "sense_id": "30790980-0108-3cd6-95b3-8e9109f65777",
                                                "text": "„Was aus den wenigen Berichten über die Mittelpassage hervorgeht, von denen etliche von Kommandanten von Sklavenschiffen, die den Handel mit den Schwarzen zu rechtfertigen versuchten, oder von Abolitionisten, welche die Öffentlichkeit gegen diese Art von Geschäften aufbringen wollten, verfasst wurden, ist, dass allgemeines Einvernehmen dahingehend herrschte, wie Sklaven idealerweise behandelt werden müssten, damit man sie lebend in der Neuen Welt abliefern könnte“"
                                            },
                                            {
                                                "example_id": "affe0421-02c4-456c-b44e-9146b63e4b9d",
                                                "sense_id": "30790980-0108-3cd6-95b3-8e9109f65777",
                                                "text": "„Die Kaufleute von Ouidah allerdings schreckt der Kampf der Abolitionisten zunächst nicht ab.“"
                                            },
                                            {
                                                "example_id": "f4c32500-cae1-4052-acf4-3b31a1e5b1fb",
                                                "sense_id": "30790980-0108-3cd6-95b3-8e9109f65777",
                                                "text": "„Dieser tapfere Bursche war ein Neger, der als Sohn versklavter Eltern auf einer Besitzung des Ingenieurs geboren worden war und von Smith, einem eingefleischten Abolitionisten, auf freien Fuß gesetzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eceb875-ec37-4c02-a2b0-eaeb33ea4ffd",
                        "source_entry_id": "31d75ca3-187c-3636-bf7c-a2831938bd66",
                        "source_sense_id": "c2acb690-07d3-3d0e-8c1f-3f30c6f82875",
                        "target_lang_word": "аболиционист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аболиционист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f49bc541-b98f-3c64-bfed-dfd731df9de0",
                                        "entry_id": "dff10723-cbac-3a90-bc0b-261876e2a475",
                                        "glosses": [
                                            "полит. приверженец аболиционизма; сторонник движения за отмену какого-либо закона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a5e23b-e5b3-4193-be80-57198a686cfb",
                                                "sense_id": "f49bc541-b98f-3c64-bfed-dfd731df9de0",
                                                "text": "Думаю, словом, что практически я — столько же аболиционист, не принимая на себя этой клички, сколько и мой оппонент. Теоретическая же разница между нашими взглядами та, что г. Зеньковский оптимистически верит: — Спасая и охраняя падших женщин аболиционисты уничтожают проституцию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fb04fa-b43f-3ba1-adec-3bc2990d192c",
                                        "entry_id": "dff10723-cbac-3a90-bc0b-261876e2a475",
                                        "glosses": [
                                            "истор. участник движения за отмену рабовладения, сторонник аболиционизма (во 2-м значении)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9139ab53-12a3-49c1-8418-8efcca382aba",
                                                "sense_id": "89fb04fa-b43f-3ba1-adec-3bc2990d192c",
                                                "text": "В 1775 году, с целью добиться отмены невольничества, в Филадельфии образовалось общество аболиционистов под председательством Франклина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7748e8-0346-3f4b-9c10-b4b60c85c89f",
                                        "entry_id": "dff10723-cbac-3a90-bc0b-261876e2a475",
                                        "glosses": [
                                            "истор. сторонник отмены крепостного права в России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab9f917-135b-4d63-9659-c56169956dd1",
                                                "sense_id": "df7748e8-0346-3f4b-9c10-b4b60c85c89f",
                                                "text": "Княгиня слыхала и про Журавского и про «самоучного мещанина Семенова», которые оба впоследствии получили у нас оригинальную известность: первый как сотрудник Сперанского по изданию законов и потом искреннейший аболиционист, а второй как самоучка-астроном."
                                            },
                                            {
                                                "example_id": "8b401219-e978-45bb-ad91-24b3984ebd9a",
                                                "sense_id": "df7748e8-0346-3f4b-9c10-b4b60c85c89f",
                                                "text": "Заманчивые обещания либеральных аболиционистов относительно будущего дворянства как фермеров-коммерсантов для большинства оказались неосуществимыми."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
