                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dae9015-620b-398c-8f5e-ee454b0e6faa",
                        "entry_id": "a03ec28e-4fc3-382f-8cf8-bfb2fe7b7034",
                        "glosses": [
                            "Petit renardcaractérisé par ses très grandes oreilles et qui vit essentiellement dans les zones désertiques de l’Afrique du Nord."
                        ],
                        "tags": [
                            "Vulpes zerda"
                        ],
                        "examples": [
                            {
                                "example_id": "64ac5f98-afac-4825-9c13-7a878daf30c6",
                                "sense_id": "9dae9015-620b-398c-8f5e-ee454b0e6faa",
                                "text": "Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d’un fennec, souriait."
                            },
                            {
                                "example_id": "8c24a79a-ade5-49a1-9916-821ed378f391",
                                "sense_id": "9dae9015-620b-398c-8f5e-ee454b0e6faa",
                                "text": "Le fennec symbolise la ruse dans les contes arabes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99b9faa9-04f4-4888-9d19-588afe835292",
                        "source_entry_id": "a03ec28e-4fc3-382f-8cf8-bfb2fe7b7034",
                        "source_sense_id": "9dae9015-620b-398c-8f5e-ee454b0e6faa",
                        "target_lang_word": "Fennek",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
