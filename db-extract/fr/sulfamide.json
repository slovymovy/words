                "forms": [
                    {
                        "form_id": "a3bec6ab-d6bd-40bb-8d91-b71a12c8bd9e",
                        "entry_id": "0c584142-8ae8-3064-b311-c365a61ec169",
                        "tags": [
                            "plural"
                        ],
                        "form": "sulfamides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e85289e-4d2f-3604-9d22-55f2aebce70d",
                        "entry_id": "0c584142-8ae8-3064-b311-c365a61ec169",
                        "glosses": [
                            "Amide de l'acide sulfonique découvert par Henri Rose en 1847."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab021bb-4b0b-4e14-b676-421a316322d8",
                                "sense_id": "9e85289e-4d2f-3604-9d22-55f2aebce70d",
                                "text": "On y arrive en sulfonant une plus grande quantité de cette dernière portion, et en préparant la sulfamide, à partir du sel de sodium de l'acide sulfonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cf2a1c9-7a1b-38fd-9499-7fe0c8fc0775",
                        "entry_id": "0c584142-8ae8-3064-b311-c365a61ec169",
                        "glosses": [
                            "Classe d'antibiotiques bactériostatiques découverte en 1932 par Gerhard Domagk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2744ac0d-22a1-46c4-bdc7-a1f6ade8195c",
                                "sense_id": "6cf2a1c9-7a1b-38fd-9499-7fe0c8fc0775",
                                "text": "Ah ! La voilà, dans l’armoire à pharmacie, derrière les boîtes de sulfamides."
                            },
                            {
                                "example_id": "4e18ac3c-d5f7-44f8-a0df-80a84674849d",
                                "sense_id": "6cf2a1c9-7a1b-38fd-9499-7fe0c8fc0775",
                                "text": "Les nourritures douteuses provoquaient des troubles dans notre organisme et favorisaient les éruptions de furoncles. Pour les combattre, un remède miracle : les sulfamides, qui, en tuant les microbes, démolissaient l’estomac."
                            },
                            {
                                "example_id": "e162382c-84c0-49cf-a558-74b3eb440194",
                                "sense_id": "6cf2a1c9-7a1b-38fd-9499-7fe0c8fc0775",
                                "text": "Un effet secondaire potentiellement grave des sulfamides consiste en lésions cérébrales, tel l’ictère nucléaire, une maladie neurologique pouvant laisser de lourdes séquelles..."
                            },
                            {
                                "example_id": "35811326-1bb8-4381-9455-d8dcc4fe20aa",
                                "sense_id": "6cf2a1c9-7a1b-38fd-9499-7fe0c8fc0775",
                                "text": "Madame Babin, c’est Titine ! Vous la connaissez pas mais c’est un drôle de personnage : sans la découverte des sulfamides, elle vérolait toute la Charente !"
                            }
                        ]
                    },
                    {
                        "sense_id": "950d3c8e-5b5d-3040-bf6d-a746f397eab2",
                        "entry_id": "0c584142-8ae8-3064-b311-c365a61ec169",
                        "glosses": [
                            "Classe de médicaments hypoglycémiants découvert en 1942 par Marcel Janbon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e792f3b-2f70-49e0-b421-c80bcd185448",
                                "sense_id": "950d3c8e-5b5d-3040-bf6d-a746f397eab2",
                                "text": "Les sulfamides, utilisés depuis les années 1950, et les glinides, déclenchent la production d'insuline: on dit qu'ils ont une action hypoglycémiante.."
                            }
                        ]
                    }
                ],
