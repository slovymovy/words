                        "cross_references": [
                            {
                                "target_word": "prostration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6be37ede-b195-32ca-8bb2-26d6cd57a724",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The act or condition of prostrating oneself (lying face-down), as a sign of humility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5e07f15-b0f4-3315-bc02-6e1b8299f435",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "A part of the ordination of Catholic and Orthodox priests, in which the ordinand lies prostrate in a gesture of submission to the will of God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f358b6e-f5e7-41b6-99a2-84c5b0960c97",
                                                "sense_id": "e5e07f15-b0f4-3315-bc02-6e1b8299f435",
                                                "text": "The ordination ceremony includes a variety of rituals, rich in meaning and history, e.g., the prostration, laying on of hands, anointing of hands, giving of the chalice and paten, and sign of peace. — Diocese of Rochester, NY"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7fdcabb-f412-32ef-b3a6-a411e58edb7a",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The state of lying face down (prone)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdf429d2-043d-3c7a-a737-a604b93f7bde",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "The condition of being prostrated, as from heat; complete loss of strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "debce5ad-4056-46b4-bac9-714b4b274053",
                                                "sense_id": "cdf429d2-043d-3c7a-a737-a604b93f7bde",
                                                "text": "I slept after the prostration of the day, with a stringent and profound slumber which not even the nightmares that wrung me could avail to break."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4def3d91-de74-3407-8cbb-3523e98c945e",
                                        "entry_id": "8e1d6963-e867-31d0-98d1-ea7679d76498",
                                        "glosses": [
                                            "A reverential bow performed in Middle Eastern cultures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce91f26-6583-4363-8dd3-d244332b6136",
                                                "sense_id": "4def3d91-de74-3407-8cbb-3523e98c945e",
                                                "text": "Their faith can be seen in their mannerisms on the pitch – cupping hands in silent pre-kick-off prayer or prostration after hitting the back of the net."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dab1d12a-2a49-4264-96a4-c339673b2a03",
                        "source_entry_id": "f426db05-0708-3f88-8440-8355e41a6f92",
                        "source_sense_id": "1087a0a3-5179-3a60-94c3-5ec2b7c119de",
                        "target_lang_word": "Erschöpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erschöpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Zustand aufgebrauchter Reserven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c0146c-747b-4b41-baed-86e0815ba621",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "Die Erschöpfung der Mine brachte über 1000 Bergleute um ihren Arbeitsplatz."
                                            },
                                            {
                                                "example_id": "19390d89-8f36-4048-9083-1616fa197a2e",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "„In St. Joachimsthal begannen nach der Erschöpfung der reichsten Lagerstättenpartien die Ausbeuten aus den Silbergruben von der Mitte des 16. Jahrhunderts an bedenklich zu sinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Schwäche, Kraftlosigkeit und sehr starke Ermüdung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b101c5ff-1983-4017-99bf-7b7214d5b17c",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "Er rannte bis zur völligen Erschöpfung."
                                            },
                                            {
                                                "example_id": "ef931d32-e67c-4fcb-9e56-d2cc03f22ecd",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Doch auch wenn es zu allen Zeiten vom Leben ermattete Menschen gab - die Erschöpfung als Massenleiden ist wohl wirklich ein Phänomen unserer Zeit.“"
                                            },
                                            {
                                                "example_id": "58660a59-3839-4c01-bb03-5c42d0e08017",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Trotz ihrer Erschöpfung gingen sie noch hundert Yards weiter.“"
                                            },
                                            {
                                                "example_id": "3d594bcc-580f-4a5d-ae19-a17636324195",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Melanie sah ihm die Erschöpfung an.“"
                                            },
                                            {
                                                "example_id": "4d02e06a-10fc-4372-acf4-9249fd2f6dfa",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Blutverlust und frühere Erschöpfung hatten die Kräfte des jungen Menschen so ganz aufgerieben, daß sie ihn kaum mit Anstrengung aller ihrer Kräfte aufrecht erhalten konnten.“"
                                            },
                                            {
                                                "example_id": "2105a317-323b-4cf7-891f-71401f1b8bc3",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Überflüssige Anstrengung bedeutete Erschöpfung, und Erschöpfung bedeutete unweigerllich den Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
