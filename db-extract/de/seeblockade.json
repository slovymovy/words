                ],
                "senses": [
                    {
                        "sense_id": "33b9538f-043a-3630-b4a3-cf172bbf61c3",
                        "entry_id": "8ea5a5a8-79c1-3def-a1bc-12bbc85ce981",
                        "glosses": [
                            "Be-/Verhinderung der freien Nutzung von Seewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212471b1-da65-41cb-86c8-8d1a461af1ea",
                                "sense_id": "33b9538f-043a-3630-b4a3-cf172bbf61c3",
                                "text": "„Mit dem Hilfskreuzer S.M.S. »Seeadler«, zwei Geschütze an Bord, durchstieß er die britische Seeblockade und begab sich auf eine kühne Kaperfahrt quer über die Weltmeere.“"
                            },
                            {
                                "example_id": "3fb6a131-c85c-4271-ba4c-39bc6f450966",
                                "sense_id": "33b9538f-043a-3630-b4a3-cf172bbf61c3",
                                "text": "„Als die Nachricht von der britischen Seeblockade Nantes erreichte, kamen die Vorbereitungen zur Ausrüstung von Sklavenschiffen beinahe zum Stillstand.“"
                            },
                            {
                                "example_id": "8b83cd90-8a93-436b-8e6e-818fb6d3bbe4",
                                "sense_id": "33b9538f-043a-3630-b4a3-cf172bbf61c3",
                                "text": "„Gleich nach Kriegsbeginn richtet die britische Marine eine Seeblockade zwischen den Shetland-Inseln und Südnorwegen sowie im Ärmelkanal bei Dover ein.“"
                            },
                            {
                                "example_id": "6c428cd0-bae0-4758-9bee-94be148f9c5a",
                                "sense_id": "33b9538f-043a-3630-b4a3-cf172bbf61c3",
                                "text": "„Der Grund war die britische Seeblockade im Ärmelkanal bei Dover und weit im Norden der Nordsee, zwischen den Shetlandinseln und Südnorwegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
