                                            {
                                                "example_id": "ac37c060-1db6-44c8-8d3c-a2b2f4b53e6b",
                                                "sense_id": "0448666f-a3b6-31ad-b71e-1e0d7dabf2a9",
                                                "text": "The distilled spirits are bottled and sold at a handsome profit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43d2b71-9ac2-33ec-8217-5a7547d6f233",
                                        "entry_id": "3b5557e9-0602-36b6-b5b3-434888de98ec",
                                        "glosses": [
                                            "Having been subjected to distillation."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "483eb9cf-b08d-4103-942e-cc9eef58189e",
                                                "sense_id": "f43d2b71-9ac2-33ec-8217-5a7547d6f233",
                                                "text": "Once the spirits have been removed, the distilled mash is a waste product, although it is salable if a buyer can be found who can put it to some other productive use."
                                            }
                                        ]
                                    }
                                ]
