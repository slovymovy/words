{
    "word_family": [
        "busily",
        "business",
        "busyness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e54e7fc-fd63-3412-839a-2ce99120b7da",
                    "sense_definition": "Actively engaged in an activity or work; not free.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occupied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director cannot see you now because he is <w>busy</w>.",
                            "target_lang_translations": {
                                "ru": "Директор не может вас сейчас принять, потому что он <w>занят</w>."
                            }
                        },
                        {
                            "text": "He is <w>busy</w> with piano practice and cannot come to the phone.",
                            "target_lang_translations": {
                                "ru": "Он <w>занят</w> игрой на пианино и не может подойти к телефону."
                            }
                        }
                    ],
                    "antonyms": [
                        "free",
                        "idle"
                    ],
                    "common_phrases": [
                        "busy with",
                        "busy getting ready"
                    ],
                    "target_lang_definitions": {
                        "ru": "Активно занятый какой-либо деятельностью или работой; не свободный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занят",
                                "target_lang_sense_clarification": "в данный момент"
                            },
                            {
                                "target_lang_word": "занятый",
                                "target_lang_sense_clarification": "делами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc1b92a-19f2-3577-82f6-ed9447fc5cd3",
                    "sense_definition": "Full of activity, people, or movement; crowded.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "active_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when you are crossing that <w>busy</w> street.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, когда переходите эту <w>оживленную</w> улицу."
                            }
                        },
                        {
                            "text": "The city center is a <w>busy</w> scene during the morning rush hour.",
                            "target_lang_translations": {
                                "ru": "Центр города представляет собой <w>оживленное</w> зрелище в утренний час пик."
                            }
                        }
                    ],
                    "antonyms": [
                        "quiet",
                        "empty"
                    ],
                    "common_phrases": [
                        "busy street",
                        "busy scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный активностью, людьми или движением; оживленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживленный",
                                "target_lang_sense_clarification": "об улице или месте"
                            },
                            {
                                "target_lang_word": "многолюдный",
                                "target_lang_sense_clarification": "о месте"
                            },
                            {
                                "target_lang_word": "оживленная",
                                "target_lang_sense_clarification": "о сцене или обстановке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9326e54b-334b-3b71-8f2b-81dd5dd6b6dc",
                    "sense_definition": "Having a lot of work or many things to do.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occupied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>busy</w> day tomorrow with many meetings scheduled.",
                            "target_lang_translations": {
                                "ru": "У меня завтра <w>загруженный</w> день, запланировано много встреч."
                            }
                        },
                        {
                            "text": "It is hard to find time for exercise in our ordinary <w>busy</w> lives.",
                            "target_lang_translations": {
                                "ru": "Трудно найти время для упражнений в нашей обычной <w>насыщенной</w> жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "swamped"
                    ],
                    "common_phrases": [
                        "busy day",
                        "busy life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий много работы или дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занятой",
                                "target_lang_sense_clarification": "о человеке или периоде времени"
                            },
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "о графике или дне"
                            },
                            {
                                "target_lang_word": "деятельный",
                                "target_lang_sense_clarification": "о жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd6657e-3e18-397c-9cfe-f295bea9f280",
                    "sense_definition": "Containing too many details or colors; cluttered or overly complicated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Flowers, stripes, and checks in the same fabric make for a <w>busy</w> pattern.",
                            "target_lang_translations": {
                                "ru": "Цветы, полоски и клетка на одной ткани создают слишком <w>пестрый</w> узор."
                            }
                        },
                        {
                            "text": "The website design is too <w>busy</w> and makes it hard to find information.",
                            "target_lang_translations": {
                                "ru": "Дизайн сайта слишком <w>перегружен</w>, из-за чего трудно найти информацию."
                            }
                        }
                    ],
                    "antonyms": [
                        "simple",
                        "plain"
                    ],
                    "common_phrases": [
                        "busy pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий слишком много деталей или цветов; перегруженный или излишне сложный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегруженный",
                                "target_lang_sense_clarification": "о дизайне или узоре"
                            },
                            {
                                "target_lang_word": "пестрый",
                                "target_lang_sense_clarification": "об узоре"
                            },
                            {
                                "target_lang_word": "навязчивый",
                                "target_lang_sense_clarification": "о визуальном стиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aabc001a-8299-394f-b9e5-ad50aea4c0bf",
                    "sense_definition": "Inclined to meddle in the affairs of others; intrusive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>busy</w> neighbor was always asking personal questions about our finances.",
                            "target_lang_translations": {
                                "ru": "<w>Назойливый</w> сосед всегда задавал личные вопросы о наших финансах."
                            }
                        },
                        {
                            "text": "He was known as a <w>busy</w> and insinuating rogue who loved to gossip.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>вмешивающийся</w> во все дела и вкрадчивый жулик, который обожал сплетничать."
                            }
                        }
                    ],
                    "synonyms": [
                        "swamped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный вмешиваться в дела других; назойливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назойливый",
                                "target_lang_sense_clarification": "вмешивающийся"
                            },
                            {
                                "target_lang_word": "бесцеремонный",
                                "target_lang_sense_clarification": "любопытный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ef1bacf-115e-350a-85f6-b5e0302826d5",
                    "sense_definition": "To keep oneself or someone else occupied with a task.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occupy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On my vacation I will <w>busy</w> myself with gardening.",
                            "target_lang_translations": {
                                "ru": "В отпуске я <w>займусь</w> садоводством."
                            }
                        },
                        {
                            "text": "They <w>busied</w> themselves with the tea while waiting for the guests.",
                            "target_lang_translations": {
                                "ru": "Они <w>занялись</w> приготовлением чая в ожидании гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "busy oneself with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать себя или кого-то другого какой-либо задачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "себя делом"
                            },
                            {
                                "target_lang_word": "заниматься",
                                "target_lang_sense_clarification": "чем-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27240f12-844b-3bb1-bbc6-e4c19e7fc07e",
                    "sense_definition": "A slang term for a police officer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got into trouble with the <w>busies</w> for pinching a bottle of milk.",
                            "target_lang_translations": {
                                "ru": "У меня были неприятности с <w>легавыми</w> из-за кражи бутылки молока."
                            }
                        },
                        {
                            "text": "The local <w>busies</w> were patrolling the neighborhood after the incident.",
                            "target_lang_translations": {
                                "ru": "Местные <w>фараоны</w> патрулировали район после инцидента."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British slang"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Liverpool"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название полицейского."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легавый",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "фараон",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}