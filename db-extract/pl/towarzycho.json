                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "67f635de-5198-479b-8d14-4a49e3b56bdf",
                                "sense_id": "94c1422a-a84f-380a-80e0-48f7d5746ad5",
                                "text": "Oni już odpadli, niczym bombka z choinki spadli\nW kiepskie klimaty popadli\nI obce towarzycho, a wszycho, było zajebicho\nKażdy bujał się z ucieszoną michą",
                                "translation": "They have already fallen off, like a bauble from a Christmas tree they have fallen off\nInto a bad company they got\nAnd strange company, and all, was awesome\nEveryone was going with a happy face",
                                "english": "They have already fallen off, like a bauble from a Christmas tree they have fallen off\nInto a bad company they got\nAnd strange company, and all, was awesome\nEveryone was going with a happy face"
                            }
                        ]
