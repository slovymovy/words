{
    "word_family": [
        "pracownik",
        "praca",
        "pracowity",
        "pracownia",
        "pracowitość",
        "współpracować",
        "wypracować",
        "opracować",
        "przepracować"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a02d160-0b17-31a5-ab10-6127010bc779",
                    "sense_definition": "wykonywać jakąś pracę zarobkową; być zatrudnionym",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zatrudnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat <w>pracuje</w> jako menadżer w dużej firmie.",
                            "target_lang_translations": {
                                "ru": "Мой брат <w>работает</w> менеджером в крупной компании.",
                                "en": "My brother <w>works</w> as a manager in a large company."
                            }
                        },
                        {
                            "text": "Chcę <w>pracować</w> w biurze od poniedziałku do piątku.",
                            "target_lang_translations": {
                                "ru": "Я хочу <w>работать</w> в офисе с понедельника по пятницу.",
                                "en": "I want to <w>work</w> in an office from Monday to Friday."
                            }
                        }
                    ],
                    "synonyms": [
                        "robić",
                        "zarabiać"
                    ],
                    "antonyms": [
                        "lenić się"
                    ],
                    "common_phrases": [
                        "pracować w biurze",
                        "pracować jako menadżer"
                    ],
                    "target_lang_definitions": {
                        "ru": "выполнять какую-либо оплачиваемую работу; быть трудоустроенным",
                        "en": "To perform paid work; to be employed."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "быть трудоустроенным, иметь работу"
                            },
                            {
                                "target_lang_word": "трудиться",
                                "target_lang_sense_clarification": "заниматься профессиональной деятельностью"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "to be employed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "731fdf52-6e64-3db4-a72a-7b88d22e4ca1",
                    "sense_definition": "wykonywać określone zadanie, wysiłek fizyczny lub umysłowy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wysiłek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik <w>pracuje</w> ciężko na polu od samego rana.",
                            "target_lang_translations": {
                                "ru": "Фермер тяжело <w>трудится</w> в поле с самого утра.",
                                "en": "The farmer <w>works</w> hard in the field from early morning."
                            }
                        },
                        {
                            "text": "Musimy pilnie <w>pracować</w> nad tym projektem, aby zdążyć na czas.",
                            "target_lang_translations": {
                                "ru": "Нам нужно срочно <w>работать</w> над этим проектом, чтобы успеть вовремя.",
                                "en": "We must <w>work</w> urgently on this project to make it on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "robić"
                    ],
                    "antonyms": [
                        "lenić się"
                    ],
                    "common_phrases": [
                        "ciężko pracować",
                        "pracować nad projektem"
                    ],
                    "target_lang_definitions": {
                        "ru": "выполнять определенную задачу, прилагать физические или умственные усилия",
                        "en": "To perform a specific task, physical or mental effort."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "прилагать усилия над задачей, проектом"
                            },
                            {
                                "target_lang_word": "трудиться",
                                "target_lang_sense_clarification": "усердно заниматься делом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "to exert effort on a task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89875c2b-db36-3aa8-81c5-07c85f9ae485",
                    "sense_definition": "działać, funkcjonować (o urządzeniach, maszynach lub narządach)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "funkcjonowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten stary silnik wciąż <w>pracuje</w> bardzo cicho.",
                            "target_lang_translations": {
                                "ru": "Этот старый двигатель всё ещё <w>работает</w> очень тихо.",
                                "en": "This old engine still <w>runs</w> very quietly."
                            }
                        },
                        {
                            "text": "Serce zdrowego człowieka <w>pracuje</w> bez przerwy przez całe życie.",
                            "target_lang_translations": {
                                "ru": "Сердце здорового человека <w>работает</w> без перерыва всю жизнь.",
                                "en": "A healthy person's heart <w>beats</w> without a break throughout their entire life."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silnik pracuje",
                        "serce pracuje"
                    ],
                    "target_lang_definitions": {
                        "ru": "действовать, функционировать (об устройствах, машинах или органах)",
                        "en": "To operate or function (of devices, machines, or organs)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "функционировать (о механизмах, органах)"
                            },
                            {
                                "target_lang_word": "функционировать",
                                "target_lang_sense_clarification": "действовать, находиться в рабочем состоянии"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "to function or operate"
                            },
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "of an engine or machine"
                            },
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "of a heart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4b9cc8-9012-3b07-be58-ca0ddddac22b",
                    "sense_definition": "ulegać procesowi fermentacji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "procesy_chemiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młode wino szybko <w>pracuje</w> w ciemnej piwnicy.",
                            "target_lang_translations": {
                                "ru": "Молодое вино быстро <w>бродит</w> в тёмном подвале.",
                                "en": "Young wine <w>ferments</w> quickly in a dark cellar."
                            }
                        },
                        {
                            "text": "Trzeba uważać, bo ciasto drożdżowe intensywnie <w>pracuje</w> w ciepłym miejscu.",
                            "target_lang_translations": {
                                "ru": "Нужно быть осторожным, так как дрожжевое тесто интенсивно <w>подходит</w> в тёплом месте.",
                                "en": "You have to be careful because yeast dough <w>rises</w> intensely in a warm place."
                            }
                        }
                    ],
                    "synonyms": [
                        "fermentować"
                    ],
                    "common_phrases": [
                        "wino pracuje",
                        "ciasto pracuje"
                    ],
                    "target_lang_definitions": {
                        "ru": "подвергаться процессу брожения, ферментации",
                        "en": "To undergo the process of fermentation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "о вине, тесте"
                            },
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "о вине в процессе брожения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ferment",
                                "target_lang_sense_clarification": "to undergo fermentation"
                            },
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "to ferment (of wine or dough)"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "of yeast dough"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "265f3085-de93-379c-8d86-7474248b68f7",
                    "sense_definition": "zmieniać kształt lub rozmiar pod wpływem czynników zewnętrznych (np. o drewnie)",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fizyka_materialow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz zostawić szparę między deskami a ścianą, by drewno mogło swobodnie <w>pracować</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно оставить зазор между досками и стеной, чтобы дерево могло свободно <w>гулять</w>.",
                                "en": "You need to leave a gap between the boards and the wall so the wood can <w>warp</w> freely."
                            }
                        },
                        {
                            "text": "Pod wpływem wilgoci te stare drzwi zaczęły mocno <w>pracować</w> i teraz się nie domykają.",
                            "target_lang_translations": {
                                "ru": "Под воздействием влаги эта старая дверь начала сильно <w>деформироваться</w>, и теперь она не закрывается.",
                                "en": "Under the influence of moisture, those old doors started to <w>warp</w> heavily and now they won't shut properly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drewno pracuje"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменять форму или размер под воздействием внешних факторов (например, о дереве)",
                        "en": "To change shape or size under the influence of external factors (e.g., of wood)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гулять",
                                "target_lang_sense_clarification": "изменять размеры от влажности (о дереве)"
                            },
                            {
                                "target_lang_word": "дышать",
                                "target_lang_sense_clarification": "расширяться и сужаться под влиянием среды (о материалах)"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "деформироваться, изменять форму под нагрузкой или влажностью"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "of wood, to warp or expand/contract"
                            },
                            {
                                "target_lang_word": "warp",
                                "target_lang_sense_clarification": "to bend or twist out of shape"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}