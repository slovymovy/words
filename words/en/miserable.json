{
    "word_family": [
        "misery",
        "miser",
        "miserably",
        "miserly",
        "miserliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bcd85be-ea9e-3f0a-b92e-05b1db0ea516",
                    "sense_definition": "In a state of deep unhappiness, discomfort, or suffering.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unhappiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started to feel <w>miserable</w> after hearing the bad news about her job application.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала себя <w>несчастной</w> после того, как услышала плохие новости по поводу её заявления на работу.",
                                "zh": "她听到求职申请的坏消息后，开始觉得很<w>难受</w>。"
                            }
                        },
                        {
                            "text": "The flu made him feel weak and <w>miserable</w> for the entire week.",
                            "target_lang_translations": {
                                "ru": "Из-за гриппа он чувствовал себя слабым и <w>разбитым</w> всю неделю.",
                                "zh": "流感让他整整一周都感到虚弱又<w>难受</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unhappy",
                        "sad",
                        "depressed",
                        "dejected",
                        "wretched",
                        "gloomy",
                        "downcast",
                        "sorrowful",
                        "despondent",
                        "heartbroken",
                        "distressed"
                    ],
                    "antonyms": [
                        "happy",
                        "cheerful",
                        "joyful",
                        "content"
                    ],
                    "common_phrases": [
                        "feel miserable",
                        "look miserable",
                        "make someone miserable",
                        "miserable life"
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии глубокого несчастья, дискомфорта или страдания.",
                        "zh": "处于深深的不快乐、不适或痛苦之中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный",
                                "target_lang_sense_clarification": "испытывающий горе или страдание"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "вызывающий жалость своим видом или состоянием"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "в значении 'несчастный', вызывающий сочувствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难受",
                                "target_lang_sense_clarification": "侧重身体或精神上不好受"
                            },
                            {
                                "target_lang_word": "痛苦",
                                "target_lang_sense_clarification": "侧重强烈的身心痛苦"
                            },
                            {
                                "target_lang_word": "凄惨",
                                "target_lang_sense_clarification": "处境悲惨、让人难过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "130f47aa-061a-31c7-a8d0-3a7303b900c8",
                    "sense_definition": "Of the weather, extremely unpleasant due to being cold, wet, or overcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to cancel the picnic because of the cold and <w>miserable</w> weather.",
                            "target_lang_translations": {
                                "ru": "Мы решили отменить пикник из-за холодной и <w>скверной</w> погоды.",
                                "zh": "因为天气又冷又<w>糟糕</w>，我们决定取消野餐。"
                            }
                        },
                        {
                            "text": "It was a <w>miserable</w> day with heavy rain and strong winds blowing constantly.",
                            "target_lang_translations": {
                                "ru": "Это был <w>мерзкий</w> день с проливным дождём и постоянно дующим сильным ветром.",
                                "zh": "那是个<w>阴冷</w>的日子，大雨倾盆，狂风不停地刮着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "dreary",
                        "bleak",
                        "dismal",
                        "gray",
                        "wet",
                        "inclement",
                        "nasty",
                        "foul"
                    ],
                    "antonyms": [
                        "sunny",
                        "pleasant",
                        "bright",
                        "fine"
                    ],
                    "common_phrases": [
                        "miserable weather",
                        "miserable day",
                        "miserable rain",
                        "miserable morning"
                    ],
                    "target_lang_definitions": {
                        "ru": "О погоде: крайне неприятная из-за холода, сырости или облачности.",
                        "zh": "形容天气因寒冷、潮湿或阴沉而让人非常难受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "плохой, неприятный (о погоде)"
                            },
                            {
                                "target_lang_word": "ненастный",
                                "target_lang_sense_clarification": "дождливый, пасмурный"
                            },
                            {
                                "target_lang_word": "мерзкий",
                                "target_lang_sense_clarification": "разг. отвратительный, очень неприятный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴冷",
                                "target_lang_sense_clarification": "天气阴沉而寒冷"
                            },
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "天气很差，让人不舒服"
                            },
                            {
                                "target_lang_word": "恶劣",
                                "target_lang_sense_clarification": "天气条件很差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fd0d5eb-939f-3f1d-80e4-263e648ff757",
                    "sense_definition": "Very bad, unskilled, or of extremely poor quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His first attempt at baking a birthday cake was a <w>miserable</w> failure.",
                            "target_lang_translations": {
                                "ru": "Его первая попытка испечь торт на день рождения обернулась <w>жалким</w> провалом.",
                                "zh": "他第一次尝试烤生日蛋糕，结果相当<w>糟糕</w>。"
                            }
                        },
                        {
                            "text": "I am absolutely <w>miserable</w> at remembering names when I meet new people.",
                            "target_lang_translations": {
                                "ru": "Я совершенно <w>никудышный</w> в запоминании имён, когда знакомлюсь с новыми людьми.",
                                "zh": "我认识新朋友时，记名字这件事简直<w>差劲</w>极了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "incompetent",
                        "inept",
                        "poor",
                        "pathetic",
                        "hopeless",
                        "worthless"
                    ],
                    "antonyms": [
                        "excellent",
                        "superb",
                        "skilled",
                        "great"
                    ],
                    "common_phrases": [
                        "miserable failure",
                        "miserable attempt",
                        "miserable performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой, неумелый или крайне низкого качества.",
                        "zh": "非常差、很不在行，或质量极其低劣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "ничтожный, неудачный (о попытке или результате)"
                            },
                            {
                                "target_lang_word": "никудышный",
                                "target_lang_sense_clarification": "неумелый, негодный"
                            },
                            {
                                "target_lang_word": "неумелый",
                                "target_lang_sense_clarification": "не обладающий навыками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "很差、很不好"
                            },
                            {
                                "target_lang_word": "差劲",
                                "target_lang_sense_clarification": "能力或表现很差"
                            },
                            {
                                "target_lang_word": "拙劣",
                                "target_lang_sense_clarification": "技巧差，不熟练"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe2164c-5630-36b6-803c-61a08a1eb548",
                    "sense_definition": "Deserving contempt; wretched or shamefully small in amount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees were forced to live a <w>miserable</w> existence in the crowded camp.",
                            "target_lang_translations": {
                                "ru": "Беженцы были вынуждены влачить <w>жалкое</w> существование в переполненном лагере.",
                                "zh": "难民们被迫在拥挤的营地里过着<w>悲惨</w>的生活。"
                            }
                        },
                        {
                            "text": "He complained that his <w>miserable</w> pay was not enough to support his family.",
                            "target_lang_translations": {
                                "ru": "Он жаловался, что его <w>мизерной</w> зарплаты не хватает на содержание семьи.",
                                "zh": "他抱怨自己那点<w>微薄</w>的工资不够养家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contemptible",
                        "despicable",
                        "paltry",
                        "meager",
                        "wretched",
                        "pitiful",
                        "shabby"
                    ],
                    "antonyms": [
                        "generous",
                        "substantial",
                        "honorable",
                        "admirable"
                    ],
                    "common_phrases": [
                        "miserable existence",
                        "miserable sinner",
                        "miserable pay",
                        "miserable wage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий презрения; убогий или постыдно малый по количеству.",
                        "zh": "令人鄙视；或者少得可怜、寒酸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мизерный",
                                "target_lang_sense_clarification": "ничтожно малый (о деньгах, количестве)"
                            },
                            {
                                "target_lang_word": "убогий",
                                "target_lang_sense_clarification": "крайне бедный, жалкий (об условиях жизни)"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "презренный, ничтожный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微薄",
                                "target_lang_sense_clarification": "数量少得可怜，常用于工资或收入"
                            },
                            {
                                "target_lang_word": "悲惨",
                                "target_lang_sense_clarification": "处境极差、令人同情"
                            },
                            {
                                "target_lang_word": "可怜",
                                "target_lang_sense_clarification": "寒酸或少得不值一提"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfa0f050-02ab-3872-8fc5-83f15640ffcd",
                    "sense_definition": "Unwilling to spend money; stingy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>miserable</w> old man never spent a penny on gifts for his grandchildren.",
                            "target_lang_translations": {
                                "ru": "Этот <w>скупой</w> старик никогда не тратил ни пенни на подарки внукам.",
                                "zh": "那个<w>吝啬</w>的老头从不给孙子孙女买礼物。"
                            }
                        },
                        {
                            "text": "Don't be so <w>miserable</w> with your money when we are on holiday.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>жадным</w> до денег, когда мы в отпуске.",
                                "zh": "我们度假时，你花钱别这么<w>小气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stingy",
                        "miserly",
                        "mean",
                        "tight-fisted",
                        "parsimonious",
                        "niggardly"
                    ],
                    "antonyms": [
                        "generous",
                        "charitable",
                        "lavish"
                    ],
                    "common_phrases": [
                        "miserable old man"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly replaced by 'miserly' or 'stingy' in this specific sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не желающий тратить деньги; скупой.",
                        "zh": "不愿意花钱；很抠门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скупой",
                                "target_lang_sense_clarification": "чрезмерно бережливый"
                            },
                            {
                                "target_lang_word": "жадный",
                                "target_lang_sense_clarification": "корыстолюбивый, не желающий делиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吝啬",
                                "target_lang_sense_clarification": "不愿花钱或与人分享钱财"
                            },
                            {
                                "target_lang_word": "小气",
                                "target_lang_sense_clarification": "口语，舍不得花钱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66f1d275-7b43-3fdf-9886-5174cac2f6f0",
                    "sense_definition": "A wretched or unhappy person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unhappiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poor <w>miserables</w> waited in line for hours to get a bowl of soup.",
                            "target_lang_translations": {
                                "ru": "Бедные <w>несчастные</w> часами ждали в очереди, чтобы получить миску супа.",
                                "zh": "那些<w>可怜人</w>排了几个小时的队，只为领到一碗汤。"
                            }
                        },
                        {
                            "text": "He looked down at the <w>miserables</w> in the street with a mix of pity and disgust.",
                            "target_lang_translations": {
                                "ru": "Он смотрел сверху вниз на <w>бедолаг</w> на улице со смесью жалости и отвращения.",
                                "zh": "他带着怜悯和厌恶交杂的神情，俯视街上的那些<w>苦命人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wretch",
                        "unfortunate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалкий или несчастный человек.",
                        "zh": "可怜或不幸的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несчастный",
                                "target_lang_sense_clarification": "человек, испытывающий страдания"
                            },
                            {
                                "target_lang_word": "бедолага",
                                "target_lang_sense_clarification": "разг. человек, попавший в беду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可怜人",
                                "target_lang_sense_clarification": "可怜或处境悲惨的人"
                            },
                            {
                                "target_lang_word": "苦命人",
                                "target_lang_sense_clarification": "命运不好、生活艰难的人"
                            },
                            {
                                "target_lang_word": "不幸的人",
                                "target_lang_sense_clarification": "遭遇不幸的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "875bd803-04fd-3d30-83c4-dfa1f5dc1bf8",
                    "sense_definition": "A state of misery or melancholy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unhappiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing the game, the whole team had a case of the <w>miserables</w>.",
                            "target_lang_translations": {
                                "ru": "После проигрыша на всю команду напала <w>хандра</w>.",
                                "zh": "输掉比赛后，整个队都陷入了<w>低落情绪</w>。"
                            }
                        },
                        {
                            "text": "The constant rain gave me the <w>miserables</w> and I didn't want to go out.",
                            "target_lang_translations": {
                                "ru": "Постоянный дождь нагнал на меня <w>тоску</w>, и я не хотел выходить на улицу.",
                                "zh": "连绵不断的雨让我心里一阵<w>郁闷</w>，我都不想出门了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blues",
                        "depression",
                        "melancholy"
                    ],
                    "common_phrases": [
                        "case of the miserables"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние тоски или меланхолии.",
                        "zh": "一种忧郁或愁闷的情绪状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хандра",
                                "target_lang_sense_clarification": "уныние, скука"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "душевная тревога, грусть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "郁闷",
                                "target_lang_sense_clarification": "口语，心情闷、提不起劲"
                            },
                            {
                                "target_lang_word": "忧郁",
                                "target_lang_sense_clarification": "较正式，忧伤消沉的状态"
                            },
                            {
                                "target_lang_word": "低落情绪",
                                "target_lang_sense_clarification": "情绪低沉、不振作的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}