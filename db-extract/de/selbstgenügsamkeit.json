                "senses": [
                    {
                        "sense_id": "3128c63a-0fd3-34c2-bf1d-6e3a9977caf3",
                        "entry_id": "86ee3858-bffe-340b-9a2c-6cb5eb008cf4",
                        "glosses": [
                            "Eigenschaft, mit sich selbst und seinen Verhältnissen zufrieden zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705c797c-a8b5-475a-b550-91891ce758b0",
                                "sense_id": "3128c63a-0fd3-34c2-bf1d-6e3a9977caf3",
                                "text": "„Es genügte zunächst die Wucht der Einsicht, dass das routinierte Leben in seiner alltäglichen Selbstgenügsamkeit nicht alles ist.“"
                            },
                            {
                                "example_id": "2ebd4892-991c-42a3-944b-bb0aec9ceb0b",
                                "sense_id": "3128c63a-0fd3-34c2-bf1d-6e3a9977caf3",
                                "text": "„Die Selbstgenügsamkeit muss gelernt werden, nicht durch Verzicht, durch Geschmack und ruhiges Blut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
