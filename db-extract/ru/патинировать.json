                    {
                        "translation_id": "c1ad467e-9bb3-4599-a72f-62711466d218",
                        "source_entry_id": "14b23049-8ebe-3cd1-ad13-cf77d48075eb",
                        "source_sense_id": "9bfd848f-ca27-3960-8c9e-df2716f44a87",
                        "target_lang_word": "patiner",
