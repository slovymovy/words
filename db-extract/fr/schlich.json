                        "glosses": [
                            "Minerai écrasé, lavé et préparé pour la fusion dans un fourneau."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "990642b2-bf0b-407b-a881-36c6c1cb7e27",
                                "sense_id": "3532c982-599f-34fd-9054-1b3d400bc016",
                                "text": "Ce fourneau se charge par en haut avec du schlich et du charbon mouillé, afin que le vent des soufflets n’enlève pas le minerai, qui est très léger."
                            },
                            {
                                "example_id": "8e8cbd30-430c-4fd1-afc6-51e83e765023",
                                "sense_id": "3532c982-599f-34fd-9054-1b3d400bc016",
                                "text": "Dans les minerais rebelles, on doit évidemment comprendre les pyrites aurifères provenant des résidus de l’amalgamation ou les schlichs obtenus par la préparation mécanique directe."
                            }
                        ]
                    }
