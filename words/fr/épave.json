                    "frequency": "Low",
                    "semantic_group_id": "naufrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La marée haute a déposé plusieurs <w>épaves</w> de bois sur le sable mouillé."
                        },
                        {
                            "text": "Les promeneurs ramassent souvent des <w>épaves</w> apportées par le ressac après l'orage."
                        }
                    ],
                    "common_phrases": [
