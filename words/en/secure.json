{
    "word_family": [
        "security",
        "securely",
        "insecurity",
        "securities"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a85fc731-d1a6-3959-afb0-41f46255dfcc",
                    "sense_definition": "Protected from danger, harm, or attack.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "safety_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children feel <w>secure</w> when their parents are nearby.",
                            "target_lang_translations": {
                                "ru": "Дети чувствуют себя <w>в безопасности</w>, когда их родители рядом.",
                                "tr": "Ebeveynleri yanlarında olduğunda çocuklar kendilerini <w>güvende</w> hissederler.",
                                "zh": "当父母在身边时，孩子们会感到<w>安全</w>。"
                            }
                        },
                        {
                            "text": "We need to find a <w>secure</w> place to hide the money.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>надёжное</w> место, чтобы спрятать деньги.",
                                "tr": "Parayı saklamak için <w>güvenli</w> bir yer bulmamız gerekiyor.",
                                "zh": "我们需要找一个<w>稳妥</w>的地方把钱藏起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "safe",
                        "protected"
                    ],
                    "antonyms": [
                        "insecure"
                    ],
                    "common_phrases": [
                        "feel secure",
                        "secure place",
                        "secure environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищённый от опасности или вреда.",
                        "tr": "Tehlike, zarar veya saldırıdan korunmuş.",
                        "zh": "受到保护，免受危险、伤害或攻击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "не представляющий угрозы"
                            },
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "внушающий доверие, защищённый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güvenli",
                                "target_lang_sense_clarification": "tehlikesiz, emniyetli"
                            },
                            {
                                "target_lang_word": "güvende",
                                "target_lang_sense_clarification": "tehlikeden uzak"
                            },
                            {
                                "target_lang_word": "emniyetli",
                                "target_lang_sense_clarification": "korunaklı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安全",
                                "target_lang_sense_clarification": "没有危险，不受威胁"
                            },
                            {
                                "target_lang_word": "稳妥",
                                "target_lang_sense_clarification": "可靠，没有风险"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb101314-c0f5-3be7-86e4-e159a146252f",
                    "sense_definition": "Firmly attached or fixed so that it will not move or fall.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stability_fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the ladder is <w>secure</w> before you try to climb it.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что лестница <w>устойчива</w>, прежде чем пытаться залезть на неё.",
                                "tr": "Tırmanmaya çalışmadan önce merdivenin <w>sağlam</w> olduğundan emin olun.",
                                "zh": "在爬梯子之前，请确保它已经<w>固定</w>好了。"
                            }
                        },
                        {
                            "text": "The knot was not <w>secure</w>, so the boat drifted away from the dock.",
                            "target_lang_translations": {
                                "ru": "Узел был <w>ненадёжным</w>, поэтому лодка отплыла от причала.",
                                "tr": "Düğüm <w>sağlam</w> değildi, bu yüzden tekne iskeleden sürüklenip gitti.",
                                "zh": "绳结没系<w>牢固</w>，所以船从码头漂走了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stable",
                        "fixed",
                        "firm",
                        "fastened",
                        "steady"
                    ],
                    "antonyms": [
                        "insecure"
                    ],
                    "common_phrases": [
                        "secure connection",
                        "secure footing",
                        "secure grip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно прикреплённый или зафиксированный, устойчивый.",
                        "tr": "Hareket etmeyecek veya düşmeyecek şekilde sıkıca bağlanmış veya sabitlenmiş.",
                        "zh": "牢固地连接或固定，使其不会移动或掉落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "прочный, хорошо закреплённый"
                            },
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "стабильный, не шаткий"
                            },
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "крепкий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sağlam",
                                "target_lang_sense_clarification": "sabit, dayanıklı"
                            },
                            {
                                "target_lang_word": "sabit",
                                "target_lang_sense_clarification": "oynamayan, sıkıca tutturulmuş"
                            },
                            {
                                "target_lang_word": "güvenli",
                                "target_lang_sense_clarification": "düşme riski olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牢固",
                                "target_lang_sense_clarification": "结实，不容易松动"
                            },
                            {
                                "target_lang_word": "稳固",
                                "target_lang_sense_clarification": "固定得很好，不会晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3302f551-eaf9-3fda-b6a4-d6d95a45060b",
                    "sense_definition": "Protected against unauthorized access or theft, especially regarding information or technology.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "safety_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure you are using a <w>secure</w> connection when checking your bank account.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вы используете <w>безопасное</w> соединение при проверке банковского счёта.",
                                "tr": "Banka hesabınızı kontrol ederken lütfen <w>güvenli</w> bir bağlantı kullandığınızdan emin olun.",
                                "zh": "查询银行账户时，请确保您使用的是<w>安全</w>连接。"
                            }
                        },
                        {
                            "text": "The confidential documents are kept in a highly <w>secure</w> database.",
                            "target_lang_translations": {
                                "ru": "Конфиденциальные документы хранятся в хорошо <w>защищённой</w> базе данных.",
                                "tr": "Gizli belgeler oldukça <w>güvenli</w> bir veri tabanında saklanmaktadır.",
                                "zh": "机密文件保存在一个高度<w>受保护</w>的数据库中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encrypted",
                        "private",
                        "protected",
                        "safe"
                    ],
                    "antonyms": [
                        "insecure"
                    ],
                    "common_phrases": [
                        "secure network",
                        "secure website",
                        "secure line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищённый от несанкционированного доступа (особенно в информационных технологиях).",
                        "tr": "Özellikle bilgi veya teknoloji alanında yetkisiz erişime veya hırsızlığa karşı korunan.",
                        "zh": "防止未经授权的访问或盗窃，尤指信息或技术方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защищённый",
                                "target_lang_sense_clarification": "о канале связи или данных"
                            },
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "не несущий угрозы утечки информации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güvenli",
                                "target_lang_sense_clarification": "şifrelenmiş veya yetkisiz erişime kapalı"
                            },
                            {
                                "target_lang_word": "korumalı",
                                "target_lang_sense_clarification": "siber tehditlere karşı korunan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安全",
                                "target_lang_sense_clarification": "指网络或数据连接"
                            },
                            {
                                "target_lang_word": "受保护",
                                "target_lang_sense_clarification": "有加密或防御措施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3be7fc20-fcbf-32b8-8640-d0584ad97a1e",
                    "sense_definition": "Feeling confident and free from fear, anxiety, or doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She finally felt <w>secure</w> enough to speak in front of the large crowd.",
                            "target_lang_translations": {
                                "ru": "Она наконец почувствовала себя достаточно <w>уверенной</w>, чтобы выступить перед большой толпой.",
                                "tr": "Kalabalık topluluğun önünde konuşacak kadar nihayet kendini <w>emin</w> hissetti.",
                                "zh": "她终于感到足够<w>自信</w>，可以在大庭广众之下发言了。"
                            }
                        },
                        {
                            "text": "A loving family helps a child grow up feeling emotionally <w>secure</w>.",
                            "target_lang_translations": {
                                "ru": "Любящая семья помогает ребёнку расти эмоционально <w>защищённым</w>.",
                                "tr": "Sevgi dolu bir aile, çocuğun duygusal olarak kendini <w>güvende</w> hissederek büyümesine yardımcı olur.",
                                "zh": "充满爱的家庭有助于孩子在成长过程中感到情感上的<w>安心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confident",
                        "assured"
                    ],
                    "antonyms": [
                        "insecure"
                    ],
                    "common_phrases": [
                        "feel secure",
                        "emotionally secure",
                        "secure future"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий уверенность, спокойствие и отсутствие страха.",
                        "tr": "Korku, kaygı veya şüpheden uzak, kendine güvenen.",
                        "zh": "感到自信，没有恐惧、焦虑或怀疑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "в себе или в будущем"
                            },
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "не испытывающий тревоги"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güvende",
                                "target_lang_sense_clarification": "huzurlu, endişesiz"
                            },
                            {
                                "target_lang_word": "emin",
                                "target_lang_sense_clarification": "kendine veya geleceğe güvenen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自信",
                                "target_lang_sense_clarification": "对自己有信心"
                            },
                            {
                                "target_lang_word": "安心",
                                "target_lang_sense_clarification": "心情平静，没有忧虑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92e06a0b-14fb-35a1-b34e-cca7828b1fc5",
                    "sense_definition": "Certain to happen or be achieved; guaranteed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With such a large lead in the polls, their victory seemed <w>secure</w>.",
                            "target_lang_translations": {
                                "ru": "С таким большим отрывом в опросах их победа казалась <w>обеспеченной</w>.",
                                "tr": "Anketlerdeki bu kadar büyük bir farkla, zaferleri <w>garanti</w> görünüyordu.",
                                "zh": "在民调中领先优势如此之大，他们的胜利看起来已<w>稳操胜券</w>。"
                            }
                        },
                        {
                            "text": "His place in history is <w>secure</w> thanks to his amazing discoveries.",
                            "target_lang_translations": {
                                "ru": "Его место в истории <w>гарантировано</w> благодаря его удивительным открытиям.",
                                "tr": "Muhteşem keşifleri sayesinde tarihteki yeri <w>garantidedir</w>.",
                                "zh": "多亏了他惊人的发现，他在历史上的地位已<w>有保障</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certain",
                        "assured",
                        "guaranteed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несомненный, гарантированный, который обязательно произойдёт.",
                        "tr": "Gerçekleşmesi veya elde edilmesi kesin; garanti edilmiş.",
                        "zh": "确定会发生或实现；有保证的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарантированный",
                                "target_lang_sense_clarification": "обеспеченный"
                            },
                            {
                                "target_lang_word": "несомненный",
                                "target_lang_sense_clarification": "верный, бесспорный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "garanti",
                                "target_lang_sense_clarification": "kesinleşmiş"
                            },
                            {
                                "target_lang_word": "sağlama alınmış",
                                "target_lang_sense_clarification": "kesin"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稳操胜券",
                                "target_lang_sense_clarification": "指成功有把握"
                            },
                            {
                                "target_lang_word": "有保障",
                                "target_lang_sense_clarification": "确定可以得到"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b9b99b8-6951-3c75-bfb9-e2022c70cfc9",
                    "sense_definition": "To succeed in getting something, especially after a lot of effort.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>secure</w> a major contract with the government.",
                            "target_lang_translations": {
                                "ru": "Компании удалось <w>получить</w> крупный контракт с правительством.",
                                "tr": "Şirket, hükümetle büyük bir sözleşme <w>sağlamayı</w> başardı.",
                                "zh": "该公司成功<w>获得</w>了一份政府大合同。"
                            }
                        },
                        {
                            "text": "He worked very hard to <w>secure</w> a place at a top university.",
                            "target_lang_translations": {
                                "ru": "Он очень много работал, чтобы <w>добиться</w> места в престижном университете.",
                                "tr": "Üst düzey bir üniversitede yer <w>elde etmek</w> için çok çalıştı.",
                                "zh": "他非常努力地<w>争取到</w>了顶尖大学的一个名额。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obtain",
                        "acquire",
                        "gain"
                    ],
                    "common_phrases": [
                        "secure a deal",
                        "secure funding",
                        "secure a job"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить или достичь чего-либо, приложив усилия.",
                        "tr": "Özellikle büyük bir çabayla bir şeyi elde etmeyi başarmak.",
                        "zh": "成功获得某物，尤指经过很大努力后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добиться",
                                "target_lang_sense_clarification": "достичь цели усилиями"
                            },
                            {
                                "target_lang_word": "получить",
                                "target_lang_sense_clarification": "приобрести, стать обладателем"
                            },
                            {
                                "target_lang_word": "обеспечить",
                                "target_lang_sense_clarification": "гарантировать получение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sağlamak",
                                "target_lang_sense_clarification": "elde etmek, temin etmek"
                            },
                            {
                                "target_lang_word": "garantiye almak",
                                "target_lang_sense_clarification": "kesinleştirmek"
                            },
                            {
                                "target_lang_word": "elde etmek",
                                "target_lang_sense_clarification": "çabayla kazanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "取得某项成果"
                            },
                            {
                                "target_lang_word": "争取到",
                                "target_lang_sense_clarification": "通过努力得到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7904af0-faf0-3545-aec8-af614f00d59a",
                    "sense_definition": "To fasten something firmly or lock it to prevent it from moving or being opened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability_fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>secure</w> all doors and windows before leaving the house.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>заприте</w> все двери и окна перед выходом из дома.",
                                "tr": "Lütfen evden çıkmadan önce tüm kapı ve pencereleri <w>emniyete alın</w>.",
                                "zh": "离家前请把所有的门窗都<w>锁好</w>。"
                            }
                        },
                        {
                            "text": "The heavy cargo was <w>secured</w> to the deck of the ship with ropes.",
                            "target_lang_translations": {
                                "ru": "Тяжёлый груз был <w>закреплён</w> на палубе корабля верёвками.",
                                "tr": "Ağır yük halatlarla geminin güvertesine <w>sabitlendi</w>.",
                                "zh": "沉重的货物用绳子<w>固定</w>在甲板上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "lock",
                        "fix"
                    ],
                    "common_phrases": [
                        "secure the door",
                        "secure the area",
                        "secure the rope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно закрепить что-либо или запереть на замок.",
                        "tr": "Bir şeyi hareket etmesini veya açılmasını önlemek için sıkıca bağlamak veya kilitlemek.",
                        "zh": "将某物牢固地固定或锁住，以防止其移动或被打开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрепить",
                                "target_lang_sense_clarification": "зафиксировать неподвижно"
                            },
                            {
                                "target_lang_word": "запереть",
                                "target_lang_sense_clarification": "закрыть на замок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıkı sıkı bağlamak",
                                "target_lang_sense_clarification": "sabitlemek"
                            },
                            {
                                "target_lang_word": "sabitlemek",
                                "target_lang_sense_clarification": "bağlamak veya oturtmak"
                            },
                            {
                                "target_lang_word": "güvenceye almak",
                                "target_lang_sense_clarification": "kilitlemek veya bağlamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "使物体保持不动"
                            },
                            {
                                "target_lang_word": "锁好",
                                "target_lang_sense_clarification": "关上并锁住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed34cb6c-0d90-3f4c-87e3-82fdde586b4d",
                    "sense_definition": "To protect something from harm or danger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "safety_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soldiers were sent to <w>secure</w> the border against potential threats.",
