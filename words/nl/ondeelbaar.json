{
    "word_family": [
        "deelbaar",
        "delen",
        "deelbaarheid",
        "ondeelbaarheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fbf6203f-8620-39ff-a8ac-28533ede61fc",
                    "sense_definition": "Wat niet in kleinere delen te splitsen of op te delen is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indivisible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>ondeelbare</w> atoom bleek in de moderne natuurkunde wel degelijk deelbaar te zijn.",
                            "target_lang_translations": {
                                "en": "The <w>indivisible</w> atom turned out to be quite divisible in modern physics."
                            }
                        },
                        {
                            "text": "In deze theorie beschouwen we de ziel als een <w>ondeelbaar</w> geheel.",
                            "target_lang_translations": {
                                "en": "In this theory, we consider the soul as an <w>indivisible</w> whole."
                            }
                        }
                    ],
                    "synonyms": [
                        "onsplitsbaar"
                    ],
                    "antonyms": [
                        "deelbaar"
                    ],
                    "common_phrases": [
                        "een ondeelbaar geheel"
                    ],
                    "target_lang_definitions": {
                        "en": "That which cannot be split or divided into smaller parts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indivisible",
                                "target_lang_sense_clarification": "cannot be divided or separated"
                            },
                            {
                                "target_lang_word": "inseparable",
                                "target_lang_sense_clarification": "cannot be separated"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "046c053a-705c-3935-8a38-821d84c258ef",
                    "sense_definition": "Niet zonder rest te delen door een ander getal (in de wiskunde).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indivisible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een priemgetal is een getal dat alleen <w>ondeelbaar</w> is door andere getallen dan één en zichzelf.",
                            "target_lang_translations": {
                                "en": "A prime number is a number that is only <w>indivisible</w> by numbers other than one and itself."
                            }
                        },
                        {
                            "text": "Sommige wiskundige eenheden zijn volledig <w>ondeelbaar</w> binnen dit specifieke systeem.",
                            "target_lang_translations": {
                                "en": "Some mathematical units are completely <w>indivisible</w> within this specific system."
                            }
                        }
                    ],
                    "antonyms": [
                        "deelbaar"
                    ],
                    "common_phrases": [
                        "een ondeelbaar getal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not divisible by another number without leaving a remainder (in mathematics)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indivisible",
                                "target_lang_sense_clarification": "in mathematics, not divisible without a remainder"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}