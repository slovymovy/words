                        "form": "die Gasthöfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                        "entry_id": "9c9c5e9a-443c-3ce0-8ea5-9b1c93cdb93f",
                        "glosses": [
                            "Gasthaus (meist auf dem Lande), das neben Restaurantbetrieb in kleinerem Umfang auch Schlafgelegenheiten bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c1276d-f89f-40ca-a584-62a57dae0eb1",
                                "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                                "text": "Nach ihrer Wanderung suchten sie vergeblich nach einem Gasthof."
                            },
                            {
                                "example_id": "3b8ea9ce-94eb-498c-9fba-9008d3b70654",
                                "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                                "text": "„Der Gasthof ist noch nicht in Betrieb.“"
                            },
                            {
                                "example_id": "fa55623f-77b0-42be-a97a-b21f8f6e104b",
                                "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                                "text": "„Als wir den Gasthof erreichten, war es bereits dunkel.“"
                            },
                            {
                                "example_id": "81d429cd-b174-40b2-80c7-63765cf7bc19",
                                "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                                "text": "„Am 25. Februar traf ich bei Einbruch der Nacht im besten Gasthof Anconas ein.“"
                            },
                            {
                                "example_id": "9e77f69e-d59c-4804-a7bb-e290675ade89",
                                "sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                                "text": "„Er fand keinen anderen Ausweg, als einen Pferdestall oder einen Heuboden in irgendeinem Gasthof als Unterkunft zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d51d4ee2-f7ef-4d5e-8fd7-bb7483d32509",
                        "source_entry_id": "9c9c5e9a-443c-3ce0-8ea5-9b1c93cdb93f",
                        "source_sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                        "target_lang_word": "inn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "Any establishment where travellers can procure lodging, food, and drink."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b96b4f2-5f76-43df-be38-b18986df7c9c",
                                                "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                                "text": "[H]ow much more agreeable to himself to get into snug quarters in a chateau, [...] rather than take up with the miserable lodgement, and miserable fare of a country inn."
                                            },
                                            {
                                                "example_id": "8545ad6f-dd7d-4ade-95fd-b337a469a6ec",
                                                "sense_id": "d124a016-d958-311d-a1d2-97a2cc8161d8",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de4379e6-cd85-3f03-ad7b-d6570b1a6c07",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "A tavern."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01b30690-7198-3eb2-abff-74e52ce9ad23",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "One of the colleges (societies or buildings) in London, for students of the law barristers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b23a729-6b07-41bd-985c-277a4095b131",
                                                "sense_id": "01b30690-7198-3eb2-abff-74e52ce9ad23",
                                                "text": "the Inns of Court    the Inns of Chancery    Serjeants’ Inns"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8c859c-87a6-3a8f-a183-5b1be811b3e4",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "The town residence of a nobleman or distinguished person."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d13f574-3188-4268-b4d5-6938f0e849ff",
                                                "sense_id": "1e8c859c-87a6-3a8f-a183-5b1be811b3e4",
                                                "text": "Leicester Inn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                        "entry_id": "ffbb4107-df4a-3f0d-b202-6ba7d36846ae",
                                        "glosses": [
                                            "A place of shelter; hence, dwelling, residence, abode."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00d8e17-3ed5-456f-8453-1835d7d52cf3",
                                                "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                                "text": "But nowe ſadde Winter welked hath the day, / And Phœbus weary of his yerely taſ-ke: / Yſtabled hath his ſteedes in lowlye laye / And taken vp his ynne in Fiſhes haſ-ke."
                                            },
                                            {
                                                "example_id": "664a30bf-a948-4f75-918a-851d5049110b",
                                                "sense_id": "07beccfe-94c8-35c1-bd52-fdc6e050f546",
                                                "text": "Therefore with me ye may take vp your In / For this ſame night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                        "entry_id": "e7384850-63b7-3f5a-bda7-dcd0cf01b8d2",
                                        "glosses": [
                                            "To take lodging; to lodge or house oneself."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594e9201-2c66-4008-82d9-7d9e8cd454a7",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "But where do you intend to inn to-night?"
                                            },
                                            {
                                                "example_id": "16b0042b-5424-4dda-a23d-d1934d2d7bdd",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "We inned at the signe of the Swan."
                                            },
                                            {
                                                "example_id": "a4376afb-8265-43e1-8ea1-f205748581ef",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "I never innd in the Towne but once."
                                            },
                                            {
                                                "example_id": "3a2db932-abc2-45be-b540-0bb1c2fce781",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "John Welch, Cornish Carrier, who formerly Inn'd at the Mermaid in Exon, is now removed to the Bear-Inn."
                                            },
                                            {
                                                "example_id": "51932b44-7ade-4d5b-b055-9408c15dafbb",
                                                "sense_id": "a5ef5de7-b6e7-3bde-8b1b-549152885edc",
                                                "text": "I inned at the best house, the Star and Garter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                        "entry_id": "e7384850-63b7-3f5a-bda7-dcd0cf01b8d2",
                                        "glosses": [
                                            "To lodge or house (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c201cc-3c2d-4061-a84f-5304d130de24",
                                                "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                                "text": "I have but Inn'd my horse since, master Cockstone."
                                            },
                                            {
                                                "example_id": "52788e95-914b-4be8-9829-9f961fc6d09b",
                                                "sense_id": "ec2e2c45-f3f2-3855-80c4-afa23817eae7",
                                                "text": "These Inn'd themselves all Night in Knights-bridge Fields."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c058826d-920d-4f14-8aac-fa4a8622cc19",
                        "source_entry_id": "9c9c5e9a-443c-3ce0-8ea5-9b1c93cdb93f",
                        "source_sense_id": "2843061d-aa4c-3cbe-8ad4-994c72574651",
                        "target_lang_word": "auberge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auberge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d70d0bef-0a63-37b6-8e2b-0a1bacca986c",
                                        "entry_id": "da34e17e-5122-351f-a579-0d32330e3eba",
                                        "glosses": [
                                            "Maison où on trouve un repas et un lit pour dormir en payant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76fbb24-5109-47d2-baa0-0e18fb72c5dd",
                                                "sense_id": "d70d0bef-0a63-37b6-8e2b-0a1bacca986c",
                                                "text": "Ou bien, j’aborde dans un des petits ports de la côte, à Meschers, à Talmont, à Saint-Seurin, et je vais m’attabler au fond d’une auberge, devant un quignon de pain, un morceau de fromage et une bouteille de l’honnête vin blanc du pays."
                                            },
                                            {
                                                "example_id": "7768337c-fa79-430b-86b8-4afff178c882",
                                                "sense_id": "d70d0bef-0a63-37b6-8e2b-0a1bacca986c",
                                                "text": "[…], puis sous prétexte de prendre conseil, se dirigea vers l’auberge où il fit venir une première chopine suivie de plusieurs autres."
                                            },
                                            {
                                                "example_id": "6ff84550-5828-41e6-8357-72d2b0e8bd65",
                                                "sense_id": "d70d0bef-0a63-37b6-8e2b-0a1bacca986c",
                                                "text": "Voilà, se dit le gentilhomme, une auberge qui s’annonce bien, et l’hôte qui la tient doit être, sur mon âme, un ingénieux compère."
                                            },
                                            {
                                                "example_id": "db4aa35a-ee44-41e2-beed-9567ce9de01f",
                                                "sense_id": "d70d0bef-0a63-37b6-8e2b-0a1bacca986c",
                                                "text": "Il n’est point pressé de conquérir les sommets. Si le temps menace, il n’attend pas l’averse, il redescend à l’auberge où il se met à la chotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d801ed38-38ea-308f-a456-1d635ce97a44",
                                        "entry_id": "da34e17e-5122-351f-a579-0d32330e3eba",
                                        "glosses": [
                                            "Prison (car on y est nourri et logé)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
