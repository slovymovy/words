                "senses": [
                    {
                        "sense_id": "3bc03dc8-b749-3b88-8ab6-c0fde101345b",
                        "entry_id": "389d93b7-8d4d-3fb2-be39-fcf8897d315c",
                        "glosses": [
                            "Sprinter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d3a7e32-039f-40aa-9b34-841266768cda",
                                "sense_id": "3bc03dc8-b749-3b88-8ab6-c0fde101345b",
                                "text": "Sa stratégie consiste à sprinter très vite dès le début pour que je ne puisse pas le dépasser et par la suite ralentir et y aller relaxe et de resprinter dès que je m’approche de lui."
                            },
                            {
                                "example_id": "2e6ad8c5-be7b-455b-8d61-272bedae0fd6",
                                "sense_id": "3bc03dc8-b749-3b88-8ab6-c0fde101345b",
                                "text": "Tu peux le mesurer la distance qui vous sépare, piquer un sprint, remesurer, resprinter,... mais c'est tout..."
                            },
                            {
                                "example_id": "dc94ae12-f510-4524-8742-5928d4f3440a",
                                "sense_id": "3bc03dc8-b749-3b88-8ab6-c0fde101345b",
                                "text": "L'équipier devait jaillir de la voiture à peine arrêtée, sprinter jusqu'à la table du contrôleur, faire pointer son carnet et resprinter jusqu’à sa voiture où, premier rapport engagé, le pilote l’attendait prêt à bondir avant même que la portière soit refermée."
                            }
                        ]
                    }
