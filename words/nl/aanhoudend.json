{
    "word_family": [
        "aanhouden",
        "aanhouder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f38cafd3-9699-3643-b577-db24f8369e83",
                    "sense_definition": "Zonder onderbreking of pauze doorgaand.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "continuing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>aanhoudende</w> regen zorgde voor veel water op de weg.",
                            "target_lang_translations": {
                                "fr": "La pluie <w>persistante</w> a causé beaucoup d'eau sur la route."
                            }
                        },
                        {
                            "text": "Door de <w>aanhoudende</w> kou bevroren de leidingen in het huis.",
                            "target_lang_translations": {
                                "fr": "À cause du froid <w>persistant</w>, les canalisations de la maison ont gelé."
                            }
                        }
                    ],
                    "synonyms": [
                        "chronisch",
                        "langdurig"
                    ],
                    "common_phrases": [
                        "aanhoudende regen",
                        "aanhoudende kou"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui se poursuit sans interruption ou pause."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "persistant",
                                "target_lang_sense_clarification": "utilisé pour des phénomènes qui durent dans le temps"
                            },
                            {
                                "target_lang_word": "continu",
                                "target_lang_sense_clarification": "qui ne s'arrête pas"
                            },
                            {
                                "target_lang_word": "incessant",
                                "target_lang_sense_clarification": "qui se répète sans cesse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "37c17e4d-8cbc-3efe-9166-d269e52ed5b0",
                    "sense_definition": "Op een voortdurende wijze.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "continuing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind bleef <w>aanhoudend</w> waaien gedurende de hele nacht.",
                            "target_lang_translations": {
                                "fr": "Le vent a continué à souffler <w>continuellement</w> pendant toute la nuit."
                            }
                        },
                        {
                            "text": "Hij bleef <w>aanhoudend</w> vragen stellen over het nieuwe project.",
                            "target_lang_translations": {
                                "fr": "Il a continué à poser des questions <w>sans cesse</w> sur le nouveau projet."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "De manière continue ou répétée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "continuellement",
                                "target_lang_sense_clarification": "de façon ininterrompue"
                            },
                            {
                                "target_lang_word": "sans cesse",
                                "target_lang_sense_clarification": "de manière répétée et constante"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7a6afe3-bfb0-3f85-a706-03cfabe08c01",
                    "sense_definition": "Het onvoltooid deelwoord van <w>aanhouden</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie was bezig met het <w>aanhoudend</w> van de verdachte.",
                            "target_lang_translations": {
                                "fr": "La police était occupée avec l'<w>arrestation</w> du suspect."
                            }
                        },
                        {
                            "text": "Het <w>aanhoudend</w> van de auto was noodzakelijk voor de controle.",
                            "target_lang_translations": {
                                "fr": "L'<w>interpellation</w> de la voiture était nécessaire pour le contrôle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb aanhouden."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme verbale indiquant l'action d'arrêter ou de maintenir quelqu'un ou quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "arrestation",
                                "target_lang_sense_clarification": "action d'arrêter une personne"
                            },
                            {
                                "target_lang_word": "interpellation",
                                "target_lang_sense_clarification": "action d'arrêter ou de questionner quelqu'un"
                            }
                        ]
                    }
                }
            ]
        }
    ]
