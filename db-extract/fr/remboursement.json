        "fr-extract.jsonl": [
            {
                "entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
                "word": "remboursement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "480f8805-0ad8-4d29-8132-6c5f056a3a2e",
                        "entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
                        "tags": [
                            "plural"
                        ],
                        "form": "remboursements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                        "entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
                        "glosses": [
                            "Action de rembourser, paiement qui se fait pour rendre une somme que l’on doit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0efc3c-55d9-414c-b6ce-6c53ea03af44",
                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                "text": "Vainement avaient-ils stipulé qu'on ne pourrait les rembourser qu'en écus ; il n'en fallait pas moins qu'ils reçussent leur remboursement en assignats."
                            },
                            {
                                "example_id": "8315440a-0b8d-47ab-8ccb-5218c8f9372b",
                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                "text": "Vers 1932, les banquiers commencèrent à redouter l'insolvabilité permanente des fermiers. Prenant peur, ils exigèrent le remboursement ou la saisie des gages."
                            },
                            {
                                "example_id": "9278b2d4-c0f3-4f87-94e3-1f0311143cf6",
                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                "text": "Des créanciers qui réclament le remboursement de leurs dettes excitent toujours les rancœurs de leurs débiteurs."
                            },
                            {
                                "example_id": "9b0a47bc-2484-4687-82ab-640e2a815450",
                                "sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                                "text": "Le coulage consiste à faire faire des travaux qui ne sont pas urgents ou nécessaires, à dégalonner et regalonner les troupes, à commander des vaisseaux sans s’inquiéter s’il y a du bois et de payer alors le bois trop cher, à se préparer à la guerre sans la faire, à payer les dettes d’un État sans lui en demander le remboursement ou des garanties, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3428fb1-ff0d-4724-985c-71c1d544b2f9",
                        "source_entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
                        "source_sense_id": "4cc14851-e3a0-3bf0-8947-c0f0d44ab21b",
                        "target_lang_word": "Rückzahlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückzahlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                        "entry_id": "bb6bec62-4225-3a69-b778-703826992f83",
                                        "glosses": [
                                            "Erstattung geliehenen oder zu Unrecht erhaltenen Geldes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7a081b-cf15-4554-86dc-a072a433a4d8",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "Die Rückzahlung ist für den nächsten Ersten vereinbart."
                                            },
                                            {
                                                "example_id": "352c8273-86e7-4429-bdf5-6ea9eaef04c4",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Im schlimmsten Fall drohen dem Staatskonzern Rückzahlungen in Höhe von mehreren hundert Millionen Euro.“"
                                            },
                                            {
                                                "example_id": "e4fdcfba-c4c8-40a2-96fe-df0f7093fd71",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Diese Ueberzeugung dass in ihm so fest, dass sie sich auch den anderen Menschen mitteilte und sie ihm weder diese überragende Stellung in der Gesellschaft noch die Geldsummen vorenthalten konnte, die er sich immer vom ersten besten geben liess, ohne je an Rückzahlung zu denken.“"
                                            },
                                            {
                                                "example_id": "86d4d754-7020-478a-80f9-4e8718129680",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Zehn Minuten später brachte er mir ein Blatt Papier, auf dem er seine Schuld anerkannte und sich zur Rückzahlung innerhalb einer bestimmten Frist verpflichtete.“"
                                            },
                                            {
                                                "example_id": "62ee6abe-ccaa-4dc6-9d8b-48b3ebb9a7e3",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Sie kam gerade so über die Runden, aber von einer Rückzahlung an ihre Mutter war sie noch meilenweit entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0da58ad-438a-4b78-a35e-2eecfadcf3d9",
                        "source_entry_id": "b03a0f3c-7aad-3ab9-8e92-ff925c0ef23a",
