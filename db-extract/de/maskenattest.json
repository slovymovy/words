                "senses": [
                    {
                        "sense_id": "aa7fe31c-1629-3246-b81e-e153cb210e63",
                        "entry_id": "bee8fe47-1341-34d0-b71c-5cc19afa0219",
                        "glosses": [
                            "ärztliche Bescheinigung, die jemanden vom verpflichtenden Tragen eines Mund-Nasen-Schutzes befreit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ba5eefd-724a-4ebe-b6d8-870531d2b74a",
                                "sense_id": "aa7fe31c-1629-3246-b81e-e153cb210e63",
                                "text": "„Aus Thüringen sind aktuell zwei berufsrechtliche Ermittlungsverfahren bekannt, parallel läuft dort auch noch ein strafrechtliches Verfahren wegen der Ausstellung mutmaßlich falscher Maskenatteste.“"
                            },
                            {
                                "example_id": "f0e02fc5-05a9-42c6-9f2b-a9404618940e",
                                "sense_id": "aa7fe31c-1629-3246-b81e-e153cb210e63",
                                "text": "„Die AfD wollte ihren Präsenzparteitag auf dem Gelände des Vergnügungsparks Wunderland als politisches Symbol durchdrücken. Auch wenn das bedeutete, an Einzeltischen zu sitzen, Maskenpflicht auf dem gesamten Gelände einzuhalten sowie ein Team von Ordnungsamt und Polizei im Rücken zu haben, das alle 51 eingereichten Maskenatteste auf Echtheit prüfte.“"
                            },
                            {
                                "example_id": "cb95974b-d931-4b14-853a-d59fb0db56e7",
                                "sense_id": "aa7fe31c-1629-3246-b81e-e153cb210e63",
                                "text": "„Der Export-Hit ‚Querdenken‘ kommt aus Stuttgart, die Protestprominenz aus der Region: der ‚Querdenken‘-Gründer Michael Ballweg, der HNO-Arzt Bodo Schiffmann, gegen den wegen falscher Maskenatteste ermittelt wird, der Virusleugner Stefan Lanka, der ‚Corona-Anwalt‘ Markus Haintz, der Laienprediger Samuel Eckert, dem auf Telegram mehr Leute folgen als Attila Hildmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
