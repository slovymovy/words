                                        "entry_id": "f503ffeb-2adb-396f-a603-8f6d8a0e622a",
                                        "glosses": [
                                            "Existencia verídica de algo en el pasado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2a4e25-90c5-406b-bec5-30ee581188dd",
                                                "sense_id": "98a3ef85-edda-3123-a8b3-6a6e2f57c74a",
                                                "text": "En las últimas décadas, los estudiosos se han dividido entre los que afirman la historicidad sustancial de los acontecimientos del Éxodo, y los que la ponen en duda."
                                            }
