                {
                    "sense_id": "47031c51-5916-3b88-9109-5247179b6fed",
                    "sense_definition": "Prendre ou chercher à prendre du poisson ou d'autres animaux aquatiques.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pecher_capturer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père adore <w>pêcher</w> au bord de la rivière le dimanche matin."
                        },
                        {
                            "text": "Ils ont passé toute l'après-midi à <w>pêcher</w> à la ligne sans rien attraper."
                        }
                    ],
                    "common_phrases": [
                        "pêcher à la ligne",
                        "pêcher au filet"
                    ]
                },
                {
                    "sense_id": "3b2c2377-ef5e-359b-8d6d-6918f25416d8",
                    "sense_definition": "Tirer ou extraire quelque chose hors de l'eau.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "pecher_extraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les plongeurs continuent de <w>pêcher</w> des perles le long de cette côte rocheuse."
                        },
                        {
                            "text": "Il a réussi à <w>pêcher</w> ses clés tombées par mégarde au fond du bassin."
                        }
                    ],
                    "synonyms": [
                        "repêcher"
                    ],
                    "common_phrases": [
