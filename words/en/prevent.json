{
    "word_family": [
        "prevention",
        "preventive",
        "preventable",
        "preventative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                    "sense_definition": "To stop something from happening or to keep someone from doing something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I brush my teeth regularly to <w>prevent</w> tooth decay.",
                            "target_lang_translations": {
                                "ru": "Я регулярно чищу зубы, чтобы <w>предотвратить</w> кариес.",
                                "tr": "Diş çürümesini <w>önlemek</w> için dişlerimi düzenli olarak fırçalarım.",
                                "zh": "我定期刷牙以<w>防止</w>蛀牙。"
                            }
                        },
                        {
                            "text": "The new security measures are designed to <w>prevent</w> accidents in the workplace.",
                            "target_lang_translations": {
                                "ru": "Новые меры безопасности призваны <w>предотвращать</w> несчастные случаи на рабочем месте.",
                                "tr": "Yeni güvenlik önlemleri iş yerindeki kazaları <w>engellemek</w> amacıyla tasarlanmıştır.",
                                "zh": "新的安全措施旨在<w>防止</w>工作场所发生事故。"
                            }
                        },
                        {
                            "text": "Heavy rain might <w>prevent</w> us from going to the park today.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь может <w>помешать</w> нам пойти в парк сегодня.",
                                "tr": "Şiddetli yağmur bugün parka gitmemize <w>engel olabilir</w>.",
                                "zh": "大雨可能会<w>阻碍</w>我们今天去公园。"
                            }
                        }
                    ],
                    "antonyms": [
                        "allow",
                        "permit",
                        "cause"
                    ],
                    "common_phrases": [
                        "prevent accidents",
                        "prevent from happening",
                        "prevent further damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить что-либо от совершения или помешать кому-либо сделать что-либо.",
                        "tr": "Bir şeyin olmasını engellemek veya birinin bir şey yapmasını önlemek.",
                        "zh": "阻止某事发生，或阻碍某人做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвращать",
                                "target_lang_sense_clarification": "не давать чему-то случиться"
                            },
                            {
                                "target_lang_word": "помешать",
                                "target_lang_sense_clarification": "создать препятствие для действия"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "önlemek",
                                "target_lang_sense_clarification": "bir şeyin olmasını engellemek"
                            },
                            {
                                "target_lang_word": "engellemek",
                                "target_lang_sense_clarification": "bir eylemin gerçekleşmesine mani olmak"
                            },
                            {
                                "target_lang_word": "mani olmak",
                                "target_lang_sense_clarification": "birinin bir şey yapmasını durdurmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "防止",
                                "target_lang_sense_clarification": "采取措施不让坏事发生"
                            },
                            {
                                "target_lang_word": "阻止",
                                "target_lang_sense_clarification": "使某事停止或不发生"
                            },
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "使某人难以进行某项活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                    "sense_definition": "To take proactive measures or act in a way that stops a problem before it starts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is always better to <w>prevent</w> than to cure a disease.",
                            "target_lang_translations": {
                                "ru": "Болезнь всегда лучше <w>предупредить</w>, чем лечить.",
                                "tr": "Bir hastalığı <w>önlemek</w>, onu tedavi etmekten her zaman daha iyidir.",
                                "zh": "治病总不如<w>预防</w>疾病。"
                            }
                        },
                        {
                            "text": "The doctor advised me on how to <w>prevent</w> illness during the winter months.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал мне, как <w>предотвратить</w> болезнь в зимние месяцы.",
                                "tr": "Doktor kış aylarında hastalanmayı nasıl <w>önleyebileceğim</w> konusunda bana tavsiyede bulundu.",
                                "zh": "医生建议我如何在冬季<w>预防</w>疾病。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "better to prevent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать упреждающие меры, чтобы остановить проблему до ее возникновения.",
                        "tr": "Bir sorunu ortaya çıkmadan önce durdurmak için önceden önlem almak.",
                        "zh": "采取预防措施，在问题发生前将其制止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвратить",
                                "target_lang_sense_clarification": "заблаговременно не допустить"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "принимать меры заранее"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "önlemek",
                                "target_lang_sense_clarification": "sorun ortaya çıkmadan tedbir almak"
                            },
                            {
                                "target_lang_word": "önüne geçmek",
                                "target_lang_sense_clarification": "olumsuz bir durumu başlamadan engellemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预防",
                                "target_lang_sense_clarification": "事先做好准备以防患于未然"
                            },
                            {
                                "target_lang_word": "防范",
                                "target_lang_sense_clarification": "戒备，预先防止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                    "sense_definition": "To be beforehand with or to <w>anticipate</w> someone's actions or needs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their ready guilt was <w>preventing</w> the king's commands before they were even spoken.",
                            "target_lang_translations": {
                                "ru": "Их готовность признать вину <w>предвосхищала</w> приказы короля еще до того, как они были произнесены.",
                                "tr": "Suçluluk duyguları, kralın emirleri daha dile getirilmeden önce onları <w>öngörüyordu</w>.",
                                "zh": "他们准备认罪的态度，在国王下令之前就<w>预见</w>了他的旨意。"
                            }
                        },
                        {
                            "text": "She sought to <w>prevent</w> his every wish by acting before he could ask.",
                            "target_lang_translations": {
                                "ru": "Она стремилась <w>опережать</w> каждое его желание, действуя прежде, чем он успевал попросить.",
                                "tr": "O daha istemeden harekete geçerek her arzusunu <w>önceden tahmin edip gerçekleştirmeye</w> çalıştı.",
                                "zh": "她试图在他开口之前就行动，从而<w>抢先</w>满足他的每一个愿望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean anticipate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать на опережение или предвосхищать чьи-либо действия или нужды.",
                        "tr": "Birinin eylemlerini veya ihtiyaçlarını önceden sezip ona göre davranmak.",
                        "zh": "预先采取行动以满足某人的需求或意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвосхищать",
                                "target_lang_sense_clarification": "архаичное: делать что-то заранее"
                            },
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "действовать раньше другого"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "öngörmek",
                                "target_lang_sense_clarification": "eskimiş: önceden sezip davranmak"
                            },
                            {
                                "target_lang_word": "önceden davranmak",
                                "target_lang_sense_clarification": "başkası yapmadan önce eyleme geçmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预见",
                                "target_lang_sense_clarification": "预先料到"
                            },
                            {
                                "target_lang_word": "抢先",
                                "target_lang_sense_clarification": "在别人之前行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                    "sense_definition": "To come before in time or order; to precede.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "precedence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pray that thy grace may always <w>prevent</w> and follow us throughout our lives.",
                            "target_lang_translations": {
                                "ru": "Мы молимся, чтобы твоя благодать всегда <w>предшествовала</w> нам и сопутствовала нам на протяжении всей нашей жизни.",
                                "tr": "Lütfunun hayatımız boyunca her zaman bize <w>öncülük etmesi</w> ve bizi takip etmesi için dua ediyoruz.",
                                "zh": "我们祈祷你的恩典能始终<w>先行</w>并伴随我们的一生。"
                            }
                        },
                        {
                            "text": "In the old text, the herald was said to <w>prevent</w> the arrival of the queen.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте говорилось, что глашатай <w>предшествовал</w> прибытию королевы.",
                                "tr": "Eski metinde, habercinin kraliçenin gelişinden <w>önce geldiği</w> söyleniyordu.",
                                "zh": "在古文中，据说传令官是<w>先于</w>女王到达的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "follow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage meaning to go before"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предшествовать во времени или порядке.",
                        "tr": "Zaman veya sıra olarak önce gelmek; öncülük etmek.",
                        "zh": "在时间或顺序上先于某事发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предшествовать",
                                "target_lang_sense_clarification": "идти перед чем-то"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "önce gelmek",
                                "target_lang_sense_clarification": "zaman veya sıra bakımından önde olmak"
                            },
                            {
                                "target_lang_word": "öncülük etmek",
                                "target_lang_sense_clarification": "önünden gitmek, öncülü olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先于",
                                "target_lang_sense_clarification": "在时间上排在前面"
                            },
                            {
                                "target_lang_word": "先行",
                                "target_lang_sense_clarification": "走在前面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                    "sense_definition": "To outdo or surpass in speed or excellence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surpass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight rode with such force, <w>preventing</w> the very speed of a flying arrow.",
                            "target_lang_translations": {
                                "ru": "Рыцарь скакал с такой силой, <w>превосходя</w> саму скорость летящей стрелы.",
                                "tr": "Şövalye atını öyle bir güçle sürüyordu ki fırlatılan bir okun hızını bile <w>aşıyordu</w>.",
                                "zh": "骑士骑马疾驰，其速度甚至<w>超越</w>了飞箭。"
                            }
                        },
                        {
                            "text": "His skill in battle would <w>prevent</w> all others who challenged him.",
                            "target_lang_translations": {
                                "ru": "Его мастерство в бою <w>превосходило</w> всех остальных, кто бросал ему вызов.",
                                "tr": "Savaştaki becerisi, kendisine meydan okuyan diğer herkesi <w>gölgede bırakırdı</w>.",
                                "zh": "他在战斗中的技巧<w>胜过</w>所有向他挑战的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходить в скорости или мастерстве.",
                        "tr": "Hız veya üstünlük konusunda başkasını geçmek, geride bırakmak.",
                        "zh": "在速度或卓越程度上超越他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть лучше или быстрее"
                            },
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "быть впереди по качеству"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gölgede bırakmak",
                                "target_lang_sense_clarification": "hız veya beceride üstün gelmek"
                            },
                            {
                                "target_lang_word": "aşmak",
                                "target_lang_sense_clarification": "geride bırakmak, üstün olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超越",
                                "target_lang_sense_clarification": "超过，胜过"
                            },
                            {
                                "target_lang_word": "胜过",
                                "target_lang_sense_clarification": "在某方面优于他人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}