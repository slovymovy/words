                "senses": [
                    {
                        "sense_id": "48f6a341-e771-3c67-b7d7-f6cd9709a6c5",
                        "entry_id": "6ad92dc3-f4bc-3c3d-bfa5-08ce78f71b84",
                        "glosses": [
                            "Refroidir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b90ff7d2-f379-4237-b421-cd176004bc71",
                                "sense_id": "48f6a341-e771-3c67-b7d7-f6cd9709a6c5",
                                "text": "C'est elle seule qui peut rafroidir cette ardeur excessive, arrêter la fermentation, & fixer l’activité des esprits."
                            },
                            {
                                "example_id": "8e70d65d-ca96-4937-8bf3-62029fd4dd09",
                                "sense_id": "48f6a341-e771-3c67-b7d7-f6cd9709a6c5",
                                "text": "On peut concevoir un corps actuellement froid sans qu’il puisse rafroidir les autres."
                            }
                        ]
                    }
