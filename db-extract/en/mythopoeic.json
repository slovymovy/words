                        "sense_id": "0ffff4cd-195c-37dc-b8e7-94c0c5b37f9f",
                        "entry_id": "3028fc8e-8325-3483-a684-238287bee04c",
                        "glosses": [
                            "Giving rise to myths; pertaining to the creation of myth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd212abd-6c9c-4423-aee2-f9f93af75930",
                                "sense_id": "0ffff4cd-195c-37dc-b8e7-94c0c5b37f9f",
                                "text": "No other fully historical hero has furnished such a perfect opportunity for the mythopoeic faculty."
                            },
                            {
                                "example_id": "280070c6-a082-4f7c-8460-7e107e421d6c",
                                "sense_id": "0ffff4cd-195c-37dc-b8e7-94c0c5b37f9f",
                                "text": "If we study myth in a scientific way, we miss the experience of moving into a mythopoeic mode of consciousness."
                            },
                            {
                                "example_id": "0daa5e7d-69ff-4335-a128-2c023e050770",
                                "sense_id": "0ffff4cd-195c-37dc-b8e7-94c0c5b37f9f",
                                "text": "Suppose a serious literary critic were to write about Hollywood autobiographies: “Niven experiences life as an imprisoning reality of personal experience, plus mythopoeic elements, a vast sottisier in the tradition of Jessel's This way, Miss.[…]"
                            }
                        ]
                    }
