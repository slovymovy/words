                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce1cd68f-c427-3767-9a56-be3cf76b2171",
                        "entry_id": "dde99b40-d72f-3ac8-b3c8-db5fedc9a631",
                        "glosses": [
                            "Opinion négative de la société à propos d'une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81449454-48b9-45c0-8c8a-cc3529c693c3",
                                "sense_id": "ce1cd68f-c427-3767-9a56-be3cf76b2171",
                                "text": "Une complète déconsidération fut le châtiment de sa mauvaise conduite."
                            },
                            {
                                "example_id": "fcd721ba-d574-4b98-9f00-e9c0a2c4689c",
                                "sense_id": "ce1cd68f-c427-3767-9a56-be3cf76b2171",
                                "text": "La considération s’accorde à ceux qui confondent le plus leur intérêt privé avec l’intérêt social et la déconsidération à ceux qui comprennent étroitement l’un et l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc54e2f9-b621-3c38-88d1-2048691f14f8",
                        "entry_id": "dde99b40-d72f-3ac8-b3c8-db5fedc9a631",
                        "glosses": [
                            "Dévalorisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104fd88d-61b1-48b3-929b-f8c83057d6a9",
                                "sense_id": "bc54e2f9-b621-3c38-88d1-2048691f14f8",
                                "text": "Ces effacements juridiques et physiologiques du corps fertile de la femme racontent le paradoxe de sa nécessité et de sa déconsidération dans nos sociétés modernes."
                            },
                            {
                                "example_id": "00202f6b-78f2-4338-be00-69c7ba2a15b3",
                                "sense_id": "bc54e2f9-b621-3c38-88d1-2048691f14f8",
                                "text": "Donc, ce héros qui avait sauvé plus de mille vies humaines, ce fin diplomate, ce chanteur de nô, cet homme d’une culture effarante, se tenait pour un zéro pointé et m’attribuait la même note. D’où pouvait venir pareille déconsidération ?"
                            }
                        ]
                    }
                ],
