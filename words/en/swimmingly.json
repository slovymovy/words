    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2a441f8f-d94b-3c8e-814f-4cb34bc62225",
                    "sense_definition": "in a very favorable manner, without difficulty, or successfully",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The negotiations are going <w>swimmingly</w> and we expect to sign the contract by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Переговоры идут <w>как по маслу</w>, и мы рассчитываем подписать контракт до конца недели."
                            }
                        },
                        {
                            "text": "If everything goes <w>swimmingly</w>, the new project will be finished ahead of schedule.",
                            "target_lang_translations": {
                                "ru": "Если всё пойдёт <w>гладко</w>, новый проект будет завершён раньше срока."
                            }
                        }
                    ],
                    "synonyms": [
                        "like clockwork",
                        "smoothly",
                        "without a hitch"
                    ],
                    "antonyms": [
                        "badly",
                        "unsuccessfully"
                    ],
                    "common_phrases": [
                        "goes swimmingly",
                        "getting along swimmingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень благоприятным образом, без затруднений или успешно"
                    },
                    "translations": {
