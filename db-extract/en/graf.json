                    {
                        "sense_id": "b1e271ca-4e2a-32aa-bc51-f3b31ad069f4",
                        "entry_id": "2c114eb8-9989-36ae-80cf-5843898f9b60",
                        "glosses": [
                            "Alternative spelling of graff (“graffiti”)."
                        ],
                        "tags": [
                            "alt-of",
