                "translations": [
                    {
                        "translation_id": "c762e173-8714-4502-9dc7-2a9a5392042c",
                        "source_entry_id": "ca7fce9b-db92-3ad4-aeb9-3f5b3d0c0b6e",
                        "source_sense_id": "d2b8d418-ea6e-349a-af93-61b4f90d279c",
