                "senses": [
                    {
                        "sense_id": "80378aea-dc91-3557-9865-1aa745e4eaf0",
                        "entry_id": "77cd1d18-e416-35f5-9029-82c916d18c87",
                        "glosses": [
                            "rzecz. odczas. od wydzielać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a60ca78-ba0f-4637-86b3-6763c68df766",
                                "sense_id": "80378aea-dc91-3557-9865-1aa745e4eaf0",
                                "text": "Siarka wchodzi w skład aminokwasów stanowiących składniki budulcowe, pomaga przy zwalczaniu infekcji, wspomaga prawidłową gospodarkę tlenową, wspomaga wydzielanie żółci."
                            },
                            {
                                "example_id": "72da38db-7694-40e7-89b4-2da1eab857d8",
                                "sense_id": "80378aea-dc91-3557-9865-1aa745e4eaf0",
                                "text": "Nadmierne wydzielanie aldosteronu przez nadnercza zmniejsza nerkowe wydalanie Na⁺, zwiększa natomiast wydalanie z moczem K⁺, Mg₂⁺ i NH₄⁺."
                            },
                            {
                                "example_id": "75ab70de-b8af-4256-889e-7fac36cf4558",
                                "sense_id": "80378aea-dc91-3557-9865-1aa745e4eaf0",
                                "text": "Uważa się, że wziewnie podawane steroidy nie powodują powikłań ogólnych i nie tłumią wydzielania kortykotropiny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
