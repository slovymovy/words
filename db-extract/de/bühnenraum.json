                ],
                "senses": [
                    {
                        "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                        "entry_id": "46c22fe3-66b0-3802-9879-8e102a13509c",
                        "glosses": [
                            "der Raum auf dem (meist erhöhten) Podest für Aufführungen (= Bühne)"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "a1d1c735-d5a6-4ee6-b979-4ea6218ea76c",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Theater Frankfurt – Das Theater im Schuppen e. V. gründete sich im Jahr 1990. Seit 1995 bewirtschaftete es ein eigenes Haus, welches aus einem Bühnenraum, einem Foyer und zahlreichen Trainings- und Probenräumen besteht“ […]."
                            },
                            {
                                "example_id": "253f6d4c-7730-4436-9636-082bfb7d5828",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "[Hebbel-Theater/Berlin:] „Der zweite Rang ist dabei nicht komplett bis an den Bühnenraum herangeführt, um allen Zuschauern beste Sichtverhältnisse zu ermöglichen und eine verzerrte Schrägsicht auf die Bühne zu verhindern.“"
                            },
                            {
                                "example_id": "a16fb2b4-517a-4873-bf81-5223dd57b0ee",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Das römische Amphitheater aus dem 3. Jahrhundert n. Chr. ist 140 m lang und 119 m breit. Der Bühnenraum ließ sich mit Wasser füllen, so dass hier auch Seeschlachten nachgestellt werden konnten.“"
                            },
                            {
                                "example_id": "60c35698-5f17-49fe-94c3-a6cc4164a363",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Die Bühnendarbietung ist gleichfalls vom Film inspiriert. Präsentiert werden die Geschichten auf der Bühne und auf halbkreisförmig um den Bühnenraum angebrachten Leinwänden.“"
                            },
                            {
                                "example_id": "26564ece-5135-42ef-808c-71c6ae747e4c",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "[Coronapandemie 2020:] „Gegen die Einsamkeit streamt seit Tagen der Pianist Igor Levit an. Seine kostenlosen Hauskonzerte kommen mal aus einem Münchner Bühnenraum, mal aus seinem Wohnzimmer“ […]."
                            },
                            {
                                "example_id": "ac1153b9-094e-4fef-9725-e267adc26ffb",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Hinten im Bühnenraum geben zwei Fenster den Blick auf Landschaften frei.“"
                            },
                            {
                                "example_id": "c9ee3066-20db-43ac-b4cd-a0c8b758cc86",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Helles weißes Licht, Atemgeräusche. Ein Herz pumpt. Riesig, projiziert auf ein weißes Objekt, das beinahe den gesamten Bühnenraum des Utopia (ehemals Reithalle) einnimmt.“"
                            },
                            {
                                "example_id": "1c073c66-0042-48eb-8f0f-416b5f2e2782",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "[Josef Bierbichler:] „Er ist ein Urgestein der Schauspielkunst, mächtig, impulsiv, polternd, zerbrechlich, brutal und zärtlich. Einer, der im Bühnenraum die Atmosphäre verändert, dessen leiser, lyrischer Tenor einen mitten ins Herz trifft.“"
                            },
                            {
                                "example_id": "eb87f3b2-9e19-4619-a323-87b3a2c5e539",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "„Drei Assistenten sind bei dieser Probe im Dienst, etwa 40 Mikros werden es sein, die sie bis zur Aufführung im Bühnenraum und im Orchestergraben platzieren.“"
                            },
                            {
                                "example_id": "c4240cfd-ce6e-4a19-885f-7a04fbdd0de4",
                                "sense_id": "4fe9091e-6b52-3010-a004-f68a5d0e3417",
                                "text": "[Das Metropol-Theater im Norden Münchens] „besteht seit 1998 und hat im ehemaligen „Alten Kino Freimann“ seine Spielstätte, in original 50er-Jahre-Ästhetik, mit 140 Plätzen und großem Bühnenraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
