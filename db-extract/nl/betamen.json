                                        "entry_id": "c279628c-09b1-3196-9b7c-d6787f4f0577",
                                        "glosses": [
                                            "Ser de un mismo parecer y dictamen; llegar a un acuerdo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8c813c-c00d-4198-8fff-21323b2ff31f",
                                                "sense_id": "04250358-9b24-33a0-88cc-334f1c3b0d88",
                                                "text": "Al final de la comida hemos convenido que mi suegra vendrá con nosotros al campo."
                                            }
