                "senses": [
                    {
                        "sense_id": "d666d3c7-1725-363c-b030-d03201811754",
                        "entry_id": "7255fe82-4f47-3d53-86ed-2bedc3cce310",
                        "glosses": [
                            "een lied of gedicht dat na het hoofdwerk komt als afsluiting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb68f04-083c-4f4e-80a7-96284e4b65f9",
                                "sense_id": "d666d3c7-1725-363c-b030-d03201811754",
                                "text": "Slapen bij een warme man is de vierde stap in een poëtische ontwikkeling die langzaamaan dwingend aandacht vraagt. Versteegen is een ‘maker’. De bundel omvat zevenentwintig gedichten in een nauwgezet verband van drie afdelingen. Er is een gezamenlijke voorzang, elke reeks heeft een nazang, en er is een slotzang voor de hele bundel."
                            },
                            {
                                "example_id": "c013842d-230a-4cf3-817f-d612ab5590ac",
                                "sense_id": "d666d3c7-1725-363c-b030-d03201811754",
                                "text": "In een ‘nazang’ legt Márai ten overvloede uit wat hij met deze ‘Telegonie’ heeft bedoeld."
                            },
                            {
                                "example_id": "a7f4d6e1-a701-4116-93f7-4ff83ab78820",
                                "sense_id": "d666d3c7-1725-363c-b030-d03201811754",
                                "text": "De nieuwe versie is rijk aan muzikale vormen: korte zangvormen, canons, éénregelige acclamaties, voorzang, nazang, liederen waarbij de gemeente een refrein zingt waar een voorzanger overheen zingt.” Winter was bereid tot compromissen. Al is hij geen liefhebber van Abba, Vader, hij schreef er wel een betere begeleiding voor."
                            }
                        ]
                    }
