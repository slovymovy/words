                    {
                        "sense_id": "36ff9c02-0d8b-30c6-9688-2e456a75ace7",
                        "entry_id": "ab062806-4ef0-3063-b4bd-24bcded03f3c",
                        "glosses": [
                            "The act of obtaining or acquiring; acquisition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4637490-3465-4dd0-b8d4-15746314e908",
                                "sense_id": "36ff9c02-0d8b-30c6-9688-2e456a75ace7",
                                "text": "With all thy getting, get understanding."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0d054c2-9b9c-3fd7-992f-02651a0e57ff",
                        "entry_id": "ab062806-4ef0-3063-b4bd-24bcded03f3c",
                        "glosses": [
                            "That which is got or obtained; gain; profit."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee7600b2-80d1-4c6b-a4f8-16b99483f261",
                                "sense_id": "d0d054c2-9b9c-3fd7-992f-02651a0e57ff",
                                "text": "She was always considering how to increase her \"gettings,\" but she never gave a thought as to how she might save them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82d561d2-7449-4434-95a7-5396fa418646",
