                    "frequency": "Low",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new company hopes to <w>emulate</w> the market dominance of its main competitor."
                        },
                        {
                            "text": "Many small businesses try to <w>emulate</w> the growth of global corporations."
                        }
                    ],
                    "synonyms": [
