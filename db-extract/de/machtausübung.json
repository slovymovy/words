                ],
                "senses": [
                    {
                        "sense_id": "f975c1c4-0bc7-307b-b799-45ffe7d33086",
                        "entry_id": "74efb8ad-30df-3e40-b7de-631117f2a78d",
                        "glosses": [
                            "Einflussnahme der herrschenden, regierenden, bemächtigten Person oder Personengruppe auf andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946a78cb-7d77-4341-9007-aa82da4351f3",
                                "sense_id": "f975c1c4-0bc7-307b-b799-45ffe7d33086",
                                "text": "„Infantile Appelle geben Auskunft über die Charakterzüge von Viktor Orbáns Machtausübung: Nirgendwo in Europa werden die Begriffe Freiheit und Souveränität so systematisch sinnentleert wie in Ungarn.“"
                            },
                            {
                                "example_id": "87ba513d-cc14-4076-bba5-ec89ff3fe58a",
                                "sense_id": "f975c1c4-0bc7-307b-b799-45ffe7d33086",
                                "text": "„Der vorliegende Entwurf sieht nicht nur vor, die Verfassung der Türkei der tatsächlichen Lage, die in der alleinigen Machtausübung Erdogans besteht, nachträglich anzupassen, sondern geht darüber hinaus.“"
                            },
                            {
                                "example_id": "6c29f1af-4cc7-4820-894c-96cb040dc4bc",
                                "sense_id": "f975c1c4-0bc7-307b-b799-45ffe7d33086",
                                "text": "„Ein Großteil der von AFP entlarvten ‚Fake News‘ dreht sich um die mutmaßlich gegen die Verfassung verstoßende Machtausübung des Präsidenten.“"
                            },
                            {
                                "example_id": "27d46f32-6b70-4880-a96e-d7a676cf9503",
                                "sense_id": "f975c1c4-0bc7-307b-b799-45ffe7d33086",
                                "text": "„Das Pikante an dem Vorgang ist nämlich, dass Gegenstand des ZDF-Films die Methoden der Machtausübung des russischen Staatspräsidenten Wladimir Putin waren - inklusive der Propaganda der von ihm beherrschten staatlichen Medien, denen es bisweilen schon reicht, gezielt Zweifel zu säen, um kritische Berichterstattung zu durchlöchern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
