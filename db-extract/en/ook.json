                    {
                        "sense_id": "bea0039a-3b8c-3b1c-a22f-6fcca945bbe8",
                        "entry_id": "67136224-48a0-37e5-a457-373feae25f1b",
                        "glosses": [
                            "Used to represent the sound of the cry of an ape or monkey."
                        ],
                        "tags": [
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "013614c1-b3b7-4528-85a2-a2e61837fe32",
                                "sense_id": "bea0039a-3b8c-3b1c-a22f-6fcca945bbe8",
                                "text": "He tapped the Librarian on the shoulder. \"Excuse me —\" \"Ook?\" \"Those guys just called you a monkey,\" said Glod."
                            },
                            {
                                "example_id": "5fe821c2-fc09-495d-87fa-3ae240d24c4c",
                                "sense_id": "bea0039a-3b8c-3b1c-a22f-6fcca945bbe8",
                                "text": "The irate ape cries, \"Ook ook! Ai ai ai!\" He springs off the edge of the stone basin, clawing Cantare across the face and bursting through the door."
                            },
                            {
                                "example_id": "e6b307ec-ae06-4156-84ef-ecab348c27c7",
                                "sense_id": "bea0039a-3b8c-3b1c-a22f-6fcca945bbe8",
                                "text": "Fingers pinched my eyelashes and lifted one eyelid. I looked straight into a big, leathery black face surrounded by brown fur. “Ook?” asked the monkey."
                            }
                        ]
                    }
                ],
