            "senses": [
                {
                    "sense_id": "5bf66435-83df-3f8b-8f15-cb7b01a59b6a",
                    "sense_definition": "een gevoel van onrust of angst ervarend, vaak voor een belangrijke gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "onrustig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben altijd een beetje <w>nerveus</w> voordat ik een presentatie moet geven.",
                            "target_lang_translations": {
                                "en": "I am always a bit <w>nervous</w> before I have to give a presentation.",
                                "de": "Ich bin immer etwas <w>nervös</w>, bevor ich eine Präsentation halten muss."
                            }
                        },
                        {
                            "text": "Hij maakt een <w>nerveuze</w> indruk omdat hij op de uitslag van het examen wacht.",
                            "target_lang_translations": {
                                "en": "He makes a <w>nervous</w> impression because he is waiting for the exam results.",
                                "de": "Er macht einen <w>nervösen</w> Eindruck, weil er auf die Prüfungsergebnisse wartet."
                            }
                        }
                    ],
                    "synonyms": [
                        "zenuwachtig",
                        "gespannen"
                    ],
                    "antonyms": [
                        "kalm",
                        "rustig",
                        "ontspannen"
                    ],
                    "common_phrases": [
                        "een nerveuze indruk",
                        "nerveus voor het examen"
                    ],
                    "target_lang_definitions": {
                        "en": "experiencing a feeling of unrest or anxiety, often before an important event",
                        "de": "ein Gefühl von Unruhe oder Ängstlichkeit verspürend, oft vor einem wichtigen Ereignis"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nervous",
                                "target_lang_sense_clarification": "feeling worried or anxious"
                            },
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "worried about what may happen"
                            },
                            {
                                "target_lang_word": "tense",
                                "target_lang_sense_clarification": "unable to relax because of nervousness"
                            },
                            {
                                "target_lang_word": "edgy",
                                "target_lang_sense_clarification": "irritable and nervous"
                            }
                        ],
                        "de": [
                            {
