                        "glosses": [
                            "Ort oder Gebäude zur Aufbewahrung von Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a776845-0fb3-4527-b2e0-6442b4eedc84",
                                "sense_id": "9e825e05-b061-3e65-ac12-6a3fbc2bee9c",
                                "text": "„Die Diebe brachen der Polizei zufolge in der Nacht zum Freitag in das Weindepot des \"Schwarzen Adler\" in Vogtsburg-Oberbergen bei Freiburg ein und nahmen mehr als einhundert \"hochpreisige Weinflaschen\" mit.“"
                            },
                            {
                                "example_id": "01b357b7-3730-4119-9fc0-6ab8ee252426",
                                "sense_id": "9e825e05-b061-3e65-ac12-6a3fbc2bee9c",
                                "text": "„Seit den 1970er-Jahren besitzt die EU ihr eigenes Weindepot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
