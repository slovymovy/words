                                "zh": "和弦正确的<w>记谱</w>方式取决于乐曲的调性。"
                            }
                        },
                        {
                            "text": "Enharmonic <w>spelling</w> allows the same pitch to be written in different ways.",
                            "target_lang_translations": {
                                "ru": "Энгармоническое <w>написание</w> позволяет записывать одну и ту же высоту звука по-разному.",
                                "zh": "等音<w>记谱</w>法允许将相同的音高以不同的方式写出来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбор конкретного названия ноты в музыкальной нотации.",
                        "zh": "在乐谱中，在等音高之间选择特定的音名。"
                    },
                    "translations": {
                        "ru": [
