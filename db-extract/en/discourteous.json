                                    {
                                        "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                                        "entry_id": "daa6ac90-0ef9-3a2e-a275-69aa19b262e7",
                                        "glosses": [
                                            "Qui n’est pas courtois, pas aimable, pas très poli, pas très respectueux…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a799e7f-616b-4e5f-8f2c-328e1b324c09",
                                                "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                                                "text": "Les Prussiens décampèrent à huit heures du matin, laissant leurs crottes, quelques maisons incendiées et brûlant encore, quelques habitants discourtois estropiés ou massacrés, soixante-dix-sept femmes ou filles excessivement violées, et l’annonce délicieuse d’une seconde multitude qui n’attendait que leur départ pour les remplacer."
                                            },
                                            {
                                                "example_id": "26c099eb-d8ce-44d3-9ffe-7eaa9d08006f",
                                                "sense_id": "875a4fb5-632a-3474-a80a-1802d7fbeeea",
                                                "text": "…rien ne suscita l’intérêt de notre auguste et discourtois interlocuteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39026104-608c-48d5-9807-3cc7a160c6cf",
                        "source_entry_id": "0535657f-d204-3992-99d9-93fb3cb98231",
