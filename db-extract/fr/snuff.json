                                            {
                                                "example_id": "5141dd9b-89f7-4560-a3a0-9a666b06bb51",
                                                "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                                                "text": "If you like snuff stories, Mr. Witomski's computer will send you information about the Gladiator newsletter. And if you happen to prefer killing sexual partners of the opposite sex — no problem, the computer will alter the pronouns."
                                            },
                                            {
                                                "example_id": "ae432f01-f614-4df8-b860-743fb31dd839",
                                                "sense_id": "12dc3596-105c-3531-9976-a87ab5e378d4",
                                                "text": "insane woman voice: no i’m not into snuff or gore I just like when pretty femmes get their heads chopped off"
                                            }
