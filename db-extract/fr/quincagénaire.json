                        "glosses": [
                            "Variante orthographique de quinquagénaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a103259-ed8a-4438-8ea5-4496a534d337",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "Dans la pièce où l’on s’installe pour l’interview, le quincagénaire s’assoit, subjugué, face à la fenêtre, pour admirer la tour Eiffel au loin."
                            },
                            {
                                "example_id": "46b0ee71-5d83-4436-b7fb-cbf265e664e6",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "Le chauffeur, un quincagénaire d’origine tchèque, est parvenu à s’extraire seul du fourgon."
                            },
                            {
                                "example_id": "485b9bed-15c3-403f-a154-a89e3b1c69f9",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "Il a été identifié par des proches de cette quincagénaire qui ont reconnu les effets personnels qui se trouvaient sur le cadavre selon Le Figaro."
                            },
                            {
                                "example_id": "ea50b432-a3d9-4c4a-858f-69385d0eef2a",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "Le conducteur roulait sur la rue Grenet en direction nord lorsqu’il a tourné a gauche sur Gouin et happé la quincagénaire qui traversait le boulevard."
                            },
                            {
                                "example_id": "3332c04a-2b03-4d98-9b5d-6483f089359a",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "Un quincagénaire avait été très violemment agressé et était resté sous très haute surveillance médicale longtemps."
                            },
                            {
                                "example_id": "5d6b3992-fe60-4ae4-be9c-db893a2a4ee4",
                                "sense_id": "aff2d3a0-4d21-3e94-8380-55924a05d67b",
                                "text": "L’autre, le cheveu très ras sur son crâne de quincagénaire, plisse ses yeux très bleu d’un air de connaisseur de tribunaux."
                            }
                        ]
                    }
