                ],
                "senses": [
                    {
                        "sense_id": "f749e884-3712-385f-b95a-6008bbc28e82",
                        "entry_id": "84c2faea-c2fc-3ecf-aa0b-4d179a36fb20",
                        "glosses": [
                            "die ganze Höhe einer Wand einnehmend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2cf585-19dd-47ba-aef7-1797ca0ccddc",
                                "sense_id": "f749e884-3712-385f-b95a-6008bbc28e82",
                                "text": "„Sein Arbeitszimmer in einem Pankower Altbau ist eine romantische Gelehrtenstube mit Büchern wandhoch, Karten, Collagen und Stapeln von Material für Projekte.“"
                            },
                            {
                                "example_id": "0645dc79-3cf8-437b-9358-b778d531797d",
                                "sense_id": "f749e884-3712-385f-b95a-6008bbc28e82",
                                "text": "„Er blieb kurz vor einem der wandhohen Spiegel stehen.“"
                            },
                            {
                                "example_id": "749f8a39-ab47-4f91-82b1-858d756f83ca",
                                "sense_id": "f749e884-3712-385f-b95a-6008bbc28e82",
                                "text": "„Eine wandhohe Karte zeigt, welche maximale Ausdehnung die römische Provinz Raetien um 160 nach Christus hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
