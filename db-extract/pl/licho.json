        "pl-extract.jsonl": [
            {
                "entry_id": "eaebec5d-b8c9-3f42-aad5-9231c6331c00",
                "word": "licho",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c685f41c-ef33-33fb-8be8-37e80c133959",
                        "entry_id": "eaebec5d-b8c9-3f42-aad5-9231c6331c00",
                        "glosses": [
                            "źle, marnie, biednie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7a084f-7a8a-413a-b31e-289461b3720d",
                                "sense_id": "c685f41c-ef33-33fb-8be8-37e80c133959",
                                "text": "— Żeby nie jedno licho, które w sercu jako cierń siedzi, tobym się był pewnie w waćpannie na umor rozkochał."
                            },
                            {
                                "example_id": "1babf812-3bde-450b-a78b-899594185886",
                                "sense_id": "c685f41c-ef33-33fb-8be8-37e80c133959",
                                "text": "Anusia pomyślała sobie, że niemasz takiej drzazgi, którejby nie można przy cierpliwości igiełką wydłubać, lecz że i bała się trochę tego Babinicza, więc nie rzekła nic — westchnęła cicho i odjechała."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
