                    {
                        "translation_id": "a1b4b828-c275-4a97-8fcc-b2b925b4dfce",
                        "source_entry_id": "e1f2dacd-75a6-32b1-826d-d9718915286c",
                        "source_sense_id": "9ecf75b8-a73d-3c7d-9fd2-05f84c450536",
                        "target_lang_word": "Gabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73d15203-faed-34ae-8f8d-fd155170141c",
                                        "entry_id": "884352f9-6a53-3667-be39-bce406bdcc42",
                                        "glosses": [
                                            "Begabung/Talent, wie zum Beispiel Genialität oder Sportlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0a3b9e-d175-40c9-9ebc-3db661c8e535",
                                                "sense_id": "73d15203-faed-34ae-8f8d-fd155170141c",
                                                "text": "Mozart hatte eine besondere Gabe für Musik."
                                            },
                                            {
                                                "example_id": "365fd5ff-2161-46fc-acdd-77a40a7b69d3",
                                                "sense_id": "73d15203-faed-34ae-8f8d-fd155170141c",
                                                "text": "„Man definiert ihn als ein beonderes Unterscheidungsvermögen, als eine schnelle Urteilsfähigkeit, als die Gabe, gewisse Zusammenhänge gesondert zu betrachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1416bb12-ebce-3b1b-b76d-6a8c8b5e4dd7",
                                        "entry_id": "884352f9-6a53-3667-be39-bce406bdcc42",
                                        "glosses": [
                                            "Geschenk oder Spende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818745c3-2809-4fef-a10b-2264092da7af",
                                                "sense_id": "1416bb12-ebce-3b1b-b76d-6a8c8b5e4dd7",
                                                "text": "Eine milde Gabe für die Armen wird hier immer gerne gesehen."
                                            },
                                            {
                                                "example_id": "884d4ff8-06c9-4ed4-baf1-11cc9f68b192",
                                                "sense_id": "1416bb12-ebce-3b1b-b76d-6a8c8b5e4dd7",
                                                "text": "„Vor zwei Jahren hatte sich Rapper West ebenfalls nicht lumpen lassen: Da schenkte er seiner Frau satte 150 Gaben, darunter einen Pelzmantel in Regenbogenfarben und einen Jumpsuit von Prada.“"
                                            },
                                            {
                                                "example_id": "5a9225b4-6d3e-4f45-b310-c90a1f54f7d0",
                                                "sense_id": "1416bb12-ebce-3b1b-b76d-6a8c8b5e4dd7",
                                                "text": "„Oft fertigten die Beschwörer Figürchen der Dämonen an und stellten ihnen Gaben und Speisen hin, damit sie davon äßen und sich – nachdem ihr Hunger gestillt war – nicht mehr an dem Menschen vergriffen.“"
                                            },
                                            {
                                                "example_id": "bbbddbc2-6965-43df-91f4-187bab9eed94",
                                                "sense_id": "1416bb12-ebce-3b1b-b76d-6a8c8b5e4dd7",
                                                "text": "„Am wahrscheinlichsten ist eine Funktion im Rahmen des Grabkultes: Vielleicht wurden hier bei den Feierlichkeiten zur Bestattung Gaben für den Verstorbenen oder für die Götter niedergelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aaea3479-49e0-36d0-bbcf-6a14515e0a2d",
                                        "entry_id": "884352f9-6a53-3667-be39-bce406bdcc42",
                                        "glosses": [
                                            "das Geben eines Medikaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8278a620-101d-425b-b220-42e736fd3101",
                                                "sense_id": "aaea3479-49e0-36d0-bbcf-6a14515e0a2d",
                                                "text": "Die Gabe von Morphinen kann hier durchaus vertreten werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
