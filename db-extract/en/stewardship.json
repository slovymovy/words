                    {
                        "sense_id": "1233da44-6e68-38a2-af75-1a42763d49e2",
                        "entry_id": "f02b94ee-6185-3f4f-8835-4e0d8595fd7e",
                        "glosses": [
                            "The act of caring for or improving with time."
                        ],
                        "tags": [
