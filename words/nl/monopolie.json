{
    "word_family": [
        "monopoliseren",
        "monopolist",
        "monopolistisch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "798fa157-cb11-3831-b1b1-7ef6b7729ef5",
                    "sense_definition": "De situatie waarin een partij de volledige controle of het alleenrecht heeft over de handel in een bepaald product of een bepaalde dienst.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marktpositie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het spoorwegbedrijf heeft een <w>monopolie</w> op het treinverkeer in dit land.",
                            "target_lang_translations": {
                                "en": "The railway company has a <w>monopoly</w> on train traffic in this country."
                            }
                        },
                        {
                            "text": "De overheid probeert een <w>monopolie</w> op de energiemarkt te voorkomen.",
                            "target_lang_translations": {
                                "en": "The government is trying to prevent a <w>monopoly</w> on the energy market."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleenrecht"
                    ],
                    "common_phrases": [
                        "een monopolie hebben",
                        "monopolie op de markt"
                    ],
                    "target_lang_definitions": {
                        "en": "The situation in which one party has complete control or exclusive rights over the trade of a specific product or service."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monopoly",
                                "target_lang_sense_clarification": "exclusive control of a market"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d2b53241-6302-312e-9ac4-f62592275d12",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>monopoliën</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>monopolie</w> het gesprek niet met opzet, ik ben gewoon enthousiast.",
                            "target_lang_translations": {
                                "en": "I do not intentionally <w>monopolize</w> the conversation, I am just enthusiastic."
                            }
                        },
                        {
                            "text": "Als ik de markt <w>monopolie</w>, kan ik zelf de prijzen bepalen.",
                            "target_lang_translations": {
                                "en": "If I <w>monopolize</w> the market, I can set the prices myself."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'monopoliën' (to monopolize)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "monopolize",
                                "target_lang_sense_clarification": "first-person singular present form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30eba9c0-c3a5-38fa-a619-07604945cb98",
                    "sense_definition": "Gebiedende wijs van <w>monopoliën</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Monopolie</w> niet de hele markt, geef anderen ook een kans!",
                            "target_lang_translations": {
                                "en": "Do not <w>monopolize</w> the entire market, give others a chance too!"
                            }
                        },
                        {
                            "text": "<w>Monopolie</w> die sector en zorg dat we de grootste worden.",
                            "target_lang_translations": {
                                "en": "<w>Monopolize</w> that sector and make sure we become the biggest."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
