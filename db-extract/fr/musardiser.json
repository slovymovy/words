                "senses": [
                    {
                        "sense_id": "09cee93c-a73d-3bc3-981c-809692f4fef3",
                        "entry_id": "8cab767c-98f1-3d8e-992d-fde90f039db6",
                        "glosses": [
                            "Faire preuve de musardise, musarder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36450d97-19aa-45ea-9771-819548e9ccb0",
                                "sense_id": "09cee93c-a73d-3bc3-981c-809692f4fef3",
                                "text": "Ainsi j’ai musardé, musardisé, musé, Sans croire qu’aux lauriers pour moi fussent des branches, Et sans être aussi sûr que Monseigneur d’Avranches Qu’un mot comme musard vînt de Musa, Musse."
                            },
                            {
                                "example_id": "e5c22e5c-2298-43eb-9c0d-b2cbe8a52a6a",
                                "sense_id": "09cee93c-a73d-3bc3-981c-809692f4fef3",
                                "text": "Mais, chaque fois que je le peux, je musardise."
                            }
                        ]
                    }
