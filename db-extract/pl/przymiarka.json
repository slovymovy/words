                                        "sense_id": "6a07e2d4-8087-3bfb-b28c-113c37704053",
                                        "entry_id": "98101082-1aee-3625-826d-3af673ec7d65",
                                        "glosses": [
                                            "present participle and gerund of fit"
                                        ],
                                        "tags": [
                                            "form-of",
