                        "source_sense_description": "politics: second or further round of an indecisive election",
                        "target_lang_word": "ballottage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballottage",
