                "senses": [
                    {
                        "sense_id": "7f63ee64-581c-3040-ab29-9e2150a9e3ee",
                        "entry_id": "e4567099-28b3-3f4b-b8b5-98caf6c8a5a8",
                        "glosses": [
                            "Personne qui copréside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45410e97-8045-4f84-b399-65ffadf4efbc",
                                "sense_id": "7f63ee64-581c-3040-ab29-9e2150a9e3ee",
                                "text": "M. Fons Margot a été par la suite coprésident de la Conférence européenne des Commissions Justice et Paix, ainsi que président du Conseil économique et social de l’Union européenne."
                            },
                            {
                                "example_id": "0c53b6d0-c325-44cc-a5f0-b9419b68fe5d",
                                "sense_id": "7f63ee64-581c-3040-ab29-9e2150a9e3ee",
                                "text": "Le chef d’entreprise de Varaize a longtemps veillé aux destinées du RACA avant de devenir coprésident de l’Union Cognac Saing-Jean-d’Angély (fruit du mariage entre le RACA et l’Union Sportive de Cognac)."
                            },
                            {
                                "example_id": "9c72ea29-80ab-42af-93af-fec60cf14c38",
                                "sense_id": "7f63ee64-581c-3040-ab29-9e2150a9e3ee",
                                "text": "« Ce terrain, ce n’est pas un caprice, c’est vital pour notre club », appuie Yvon Bescond, ancien coprésident, citant toutes les communes alentour déjà équipées."
                            }
                        ]
                    }
                ],
