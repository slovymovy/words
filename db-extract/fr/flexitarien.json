                "senses": [
                    {
                        "sense_id": "4d8a3add-ef76-332a-ade7-f68f23d1a485",
                        "entry_id": "7c02089c-3df6-3e09-9fb4-c850e2682094",
                        "glosses": [
                            "Végétarien qui mange de la viande occasionnellement."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c4da9e26-48ce-4952-9f24-220e0c72071d",
                                "sense_id": "4d8a3add-ef76-332a-ade7-f68f23d1a485",
                                "text": "Selon les circonstances, un flexitarien peut manger végétarien ou végétalien ou bien choisir de consommer des plats comportant de la chair animale en certaines occasions (au restaurant, lors de repas familiaux ou chez des amis)."
                            },
                            {
                                "example_id": "a6c488a8-46ba-4fd4-a840-46be81916e1e",
                                "sense_id": "4d8a3add-ef76-332a-ade7-f68f23d1a485",
                                "text": "Plutôt que d’être un végétarien frustré, on peut devenir un flexitarien assumé."
                            },
                            {
                                "example_id": "0367593e-55a7-4043-8572-32ad86e25cd2",
                                "sense_id": "4d8a3add-ef76-332a-ade7-f68f23d1a485",
                                "text": "« Flexitarien ». Ce nouveau buzzword à trois sous – formé à partir des mots « flexible » et « végétarien » – désigne une pratique alimentaire semi-végétarienne."
                            }
                        ]
                    }
                ],
