                "senses": [
                    {
                        "sense_id": "fcc276ff-87be-333d-979a-c29371f97180",
                        "entry_id": "3ae34a13-220b-3338-a283-99e93bae5d29",
                        "glosses": [
                            "Comportement instinctif qui assure la survie d’un individu, d’une espèce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb21d12-5fac-4779-903a-7100b00aaa35",
                                "sense_id": "fcc276ff-87be-333d-979a-c29371f97180",
                                "text": "On distingue deux catégories de pulsions, celles qui relèvent de l’autoconservation et celles d’ordre sexuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "6719e806-4137-38e5-9a06-8341ae21b0ff",
                        "entry_id": "3ae34a13-220b-3338-a283-99e93bae5d29",
                        "glosses": [
                            "Conservation par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba64737-f214-43a5-8e17-571c74b78ef1",
                                "sense_id": "6719e806-4137-38e5-9a06-8341ae21b0ff",
                                "text": "En outre, afin qu’ils puissent plus tard recourir personnellement à une PMA, l’autoconservation des gamètes en dehors de tout motif médical devient possible pour les femmes et les hommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c391b967-a159-348a-94b6-277a331f4190",
                        "entry_id": "3ae34a13-220b-3338-a283-99e93bae5d29",
                        "glosses": [
                            "Conservation génétique liée l'individu, par un tiers public et/ou privé"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be69e252-810f-445b-a9fb-4b4eaf4a57ca",
                                "sense_id": "c391b967-a159-348a-94b6-277a331f4190",
                                "text": "Pour réduire les délais d'attente pour accéder à une PMA - actuellement 16 à 24 mois -, Emmanuel Macron a l'intention d'«ouvrir aux centres privés l’autoconservation ovocytaire» qui était «jusqu'ici réservée aux établissements hospitaliers»."
                            }
                        ]
                    }
                ],
