                        "cross_references": [
                            {
                                "target_word": "metastasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f13e2341-fa0f-3467-bc85-0418184ae89e",
                                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                                        "glosses": [
                                            "A change in nature, form, or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee6ed08a-2de2-35b6-b176-6b0660ac0710",
                                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                                        "glosses": [
                                            "The transference of a bodily function or disease to another part of the body, specifically the development of a secondary area of disease remote from the original site, as with some cancers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1284ca6-0e1b-47ac-ab81-5b97dd12e905",
                                                "sense_id": "ee6ed08a-2de2-35b6-b176-6b0660ac0710",
                                                "text": "Stayed in her own house, searched her body each morning and examined her conscience each night for progressive symptoms of the metastasis she feared was in her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09c091b-12cf-36bb-a90b-c1638dd2c871",
                                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                                        "glosses": [
                                            "The spread of something harmful to another location, like the metastasis of a cancer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "413b416f-ba9f-3acf-8fc1-6d0151b46fa3",
                                        "entry_id": "26c5b124-e8f6-3e00-8e1f-ef6b378bf717",
                                        "glosses": [
                                            "Denying adversaries' arguments and turning the arguments back on them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d4569f-0111-43ed-b960-1a8b346d7068",
                        "source_entry_id": "fb306905-573f-3b31-b3fa-bf0ef74e7f4b",
                        "source_sense_id": "1600cd41-f6fd-39ad-9268-7a90ec107925",
                        "target_lang_word": "métastase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métastase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                        "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                                        "glosses": [
                                            "Croissance d’un organisme pathogène ou d’une cellule tumorale à distance du site initialement atteint."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55fbcea-6ec1-4045-b3e6-37ac1583889b",
                                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                                "text": "L’urographie intraveineuse montrait, de son côté, une dilatation de l’uretère, le non-fonctionnement du rein droit cependant que la radiographie du thorax révélait des métastases circutuelles…"
                                            },
                                            {
                                                "example_id": "9f4a6025-edd6-436e-be11-851709e38bd1",
                                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                                "text": "L’opération s’était bien passée, bien qu’il ait fallu lui enlever deux côtes, sur lesquelles des métastases s’étaient développées."
                                            },
                                            {
                                                "example_id": "3c0ba7f6-987d-4f6b-9338-f1821272a94a",
                                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                                "text": "Un an plus tôt, elle a été opérée pour un cancer du sein. Aucune métastase n'a été trouvée."
                                            },
                                            {
                                                "example_id": "478704d9-6976-485c-be62-a967ebf05775",
                                                "sense_id": "62585587-9938-30b1-96c8-c34e75b450d7",
                                                "text": "Cette tumeur primitive libère ensuite d’autres cellules cancéreuses, qui se déplacent dans la circulation sanguine (ou lymphatique) jusqu'à un tissu ou un organe éloigné pour y former des tumeurs secondaires appelées métastases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe97fd64-504c-3434-a334-96ae5f3f54fb",
                                        "entry_id": "b9c29db8-bdac-363c-81f7-2137784f48da",
                                        "glosses": [
                                            "Figure de rhétorique qui consiste dans son discours à rejeter sur d'autre des fautes, des erreurs que l'on a commises et que l'on est forcé d'admettre."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
