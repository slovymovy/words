                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "f4a3ef15-668f-4597-9786-ab065a84233a",
                                "sense_id": "5f510e08-e892-335a-82e1-af87b26a6ca7",
                                "text": "“[…] he had land and living, kept himself close from wadsetters and money-lenders, paid each man his due, and lived on his own.”"
                            },
                            {
                                "example_id": "b3c303bd-c3b0-4d9f-8cfb-fc37bcc59c90",
                                "sense_id": "5f510e08-e892-335a-82e1-af87b26a6ca7",
                                "text": "The wadsetter was frequently a younger brother or near relative of the chief of the clan, who had made money abroad, or in some calling at home. He lent money to the chief, and in return he was secured by deed in the annual rents of certain specified lands."
                            }
                        ]
