                        "glosses": [
                            "Faire devenir enclitique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f972e22-35d2-4b3a-9318-65fa0cd84b31",
                                "sense_id": "f0005ca2-e34b-3749-b1af-69f02e360764",
                                "text": "Refuséles = refusez les ; cette façon d’enclitiser le pronom les à l’impératif du pluriel est étrange et je n’en ai pas d’autre exemple."
                            },
                            {
                                "example_id": "661a175a-8730-43f4-aa3d-3db49847f84b",
                                "sense_id": "f0005ca2-e34b-3749-b1af-69f02e360764",
                                "text": "En second lieu, on a déjà noté que le roumain dispose d’un clitique datif qui peut s’enclitiser sur une préposition, du moins dans un style poétique."
