                        ]
                    },
                    {
                        "translation_id": "b4392752-9586-43b8-ac0a-c48fe87c8725",
                        "source_entry_id": "72ab74c0-f416-34c1-a4af-a452e9cc19eb",
                        "source_sense_id": "962bd0a2-8145-331d-9621-a0eadd6c9aeb",
                        "source_sense_description": "so, dass man darüber nachdenken sollte",
                        "target_lang_word": "in question",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in question",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc8b51ce-95f2-3795-bb4b-9d34fda8b2ed",
                                        "entry_id": "7acbded7-df2f-3bdd-b269-a5e364d24355",
                                        "glosses": [
                                            "Under consideration, under discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a9f98a-f197-4f80-b543-e683057e9435",
                                                "sense_id": "cc8b51ce-95f2-3795-bb4b-9d34fda8b2ed",
                                                "text": "The man in question just walked in."
                                            },
                                            {
                                                "example_id": "9ed86c2f-354b-46be-997d-6f81e69a995d",
                                                "sense_id": "cc8b51ce-95f2-3795-bb4b-9d34fda8b2ed",
                                                "text": "The topic in question is not something that can be easily addressed due to its sensitivity."
                                            },
                                            {
                                                "example_id": "8b83381f-c68b-4562-b335-2ca2d35967a7",
                                                "sense_id": "cc8b51ce-95f2-3795-bb4b-9d34fda8b2ed",
                                                "text": "The police officer told me the suspect in question was last seen on Swanston St."
                                            },
                                            {
                                                "example_id": "694f2dcc-77f0-4e35-aa70-6b95af881564",
                                                "sense_id": "cc8b51ce-95f2-3795-bb4b-9d34fda8b2ed",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fed07c4-9937-30c4-a5ee-761b0fe10774",
                                        "entry_id": "7acbded7-df2f-3bdd-b269-a5e364d24355",
                                        "glosses": [
                                            "In doubt, under dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be68f18-70e1-446c-a28c-3f816ac17591",
                                                "sense_id": "7fed07c4-9937-30c4-a5ee-761b0fe10774",
                                                "text": "The whole project is now in question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e71cfc49-4ac7-4b83-b905-b90073d67b9f",
                        "source_entry_id": "72ab74c0-f416-34c1-a4af-a452e9cc19eb",
                        "source_sense_id": "962bd0a2-8145-331d-9621-a0eadd6c9aeb",
                        "source_sense_description": "so, dass man darüber nachdenken sollte",
                        "target_lang_word": "en question",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en question",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "693e18ee-f24a-3cf3-b33e-1f3c4dbc0158",
                                        "entry_id": "d7aed7b5-b9a2-358d-a6c9-ac9183566fc3",
                                        "glosses": [
                                            "Dont il s’agit dans la discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9fce203-b688-415f-90d2-7ca9857401c9",
                                                "sense_id": "693e18ee-f24a-3cf3-b33e-1f3c4dbc0158",
                                                "text": "Les pouillés donnent, aux environs du XIVᵉ siècle, et pour les quinze diocèses en question, un nombre de paroisses compris entre 5 931 (chiffre minimum) et 6 694 (chiffre maximum)."
                                            },
                                            {
                                                "example_id": "fe2ae27c-0f1d-467b-aeca-d06bce17d83a",
                                                "sense_id": "693e18ee-f24a-3cf3-b33e-1f3c4dbc0158",
                                                "text": "À peine deux minutes plus tard, le Paulo en question se présentait devant eux, en sueur. Remontant ses braies en souriant, il dévisagea Gabriel…"
                                            },
                                            {
                                                "example_id": "d745d5f2-9fa4-45ba-9688-574d0c26ba0d",
                                                "sense_id": "693e18ee-f24a-3cf3-b33e-1f3c4dbc0158",
                                                "text": "L’astuce en question est la suivante : une fois que les élèves ont rendu leur devoir fait à la maison, Lucas Markarian leur demande de sortir une feuille de papier et de répondre aux mêmes questions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
