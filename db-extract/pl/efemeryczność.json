                    {
                        "sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "glosses": [
                            "cecha tego, co jest efemerycze, krótkotrwałe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e984f002-cc61-435c-b115-5b66db0e9399",
                                "sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                                "text": "Bezpośrednie doświadczenie przemijających doznań udowadnia nam efemeryczność naszej natury. Każda cząsteczka ciała, każdy umysłowy proces jest w stanie nieustannego przepływu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "905249c5-0514-4ae1-9c39-f59f44043262",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "ephemerality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ephemerality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71b20d85-40d3-3bd9-bf7c-34296d8515ad",
                                        "entry_id": "d97efad2-006e-3333-b1a0-174fe2085d00",
                                        "glosses": [
                                            "The state or condition of being ephemeral; transience."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e558b906-bf21-482a-8a6d-753ff3537575",
                                                "sense_id": "71b20d85-40d3-3bd9-bf7c-34296d8515ad",
                                                "text": "But in that quest, we sometimes lose sight of a central tenet: Nature’s ephemerality makes it all the more enchanting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211210a4-6e82-3585-988c-3869caf89e11",
                                        "entry_id": "d97efad2-006e-3333-b1a0-174fe2085d00",
                                        "glosses": [
                                            "Something that is ephemeral."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6097b81-e857-42cf-bb97-2a3b724dbbe2",
                                                "sense_id": "211210a4-6e82-3585-988c-3869caf89e11",
                                                "text": "So, too, the multiplication of bathrooms and the over-expenditure on broadly paved motor roads, and above all, the massive collective concentration on glib ephemeralities of all kinds, performed with supreme technical audacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1699809c-fc90-4ef2-b191-dfa9dcbc0967",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
