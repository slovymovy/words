                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "81664dfe-fca7-3de7-a712-fd3fe55fede9",
                                        "entry_id": "54b1aa65-377e-3a2d-9ed4-0b05987a2f72",
                                        "glosses": [
                                            "in korte tijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e77a87-6edf-4b1c-978e-70766e7a5603",
                                                "sense_id": "81664dfe-fca7-3de7-a712-fd3fe55fede9",
                                                "text": "Surfers gebruiken muien juist om snel ver de zee in te komen."
                                            },
                                            {
                                                "example_id": "79c8d541-c186-4511-b26b-c724b35c8e36",
                                                "sense_id": "81664dfe-fca7-3de7-a712-fd3fe55fede9",
                                                "text": "Helaas was er geen tijd om te genieten van het prachtige uitzicht want we moesten zo snel mogelijk de berg af zien te komen: het weer zou zo weer kunnen omslaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "826f7784-b538-32d7-b243-2cac80332b73",
                                        "entry_id": "54b1aa65-377e-3a2d-9ed4-0b05987a2f72",
                                        "glosses": [
                                            "een hoge snelheid hebbend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd2cb01-ed26-44b4-af27-4ecaf5284e8a",
                                                "sense_id": "826f7784-b538-32d7-b243-2cac80332b73",
                                                "text": "Beren zijn immers een stuk sneller dan mensen."
                                            },
                                            {
                                                "example_id": "8e584ca5-50d1-42bf-9571-d5a7565d7dd6",
                                                "sense_id": "826f7784-b538-32d7-b243-2cac80332b73",
                                                "text": "Slechts twee jaar later zeilde hij het mooiste en snelste jacht dat er toen was naar de overwinning in de Kielregatta en zat aan de tafel van de Kaiser bij het afsluitende banket, net verloofd met Ingeborg."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snel",
                                "target_lang_code": "nl",
                                "target_senses": [
