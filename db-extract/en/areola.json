                ],
                "senses": [
                    {
                        "sense_id": "0158108a-629b-355c-9cfb-9aefac0538aa",
                        "entry_id": "a962c388-f94d-3316-bec6-d31f1dfc9624",
                        "glosses": [
                            "The circular, darkly pigmented area surrounding a nipple; the areola mammae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f631f580-f685-4acd-8863-b883e632afad",
                                "sense_id": "0158108a-629b-355c-9cfb-9aefac0538aa",
                                "text": "Working with the Personal Genome Project, she has collected measurements and images of the areolas of 150 people so far. One initial finding is that the diameter of the areola seems unrelated to the number of areola glands — the small bumps in the skin surrounding the nipple."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e9089d2-46d0-3313-b968-a4310f72e0f4",
                        "entry_id": "a962c388-f94d-3316-bec6-d31f1dfc9624",
                        "glosses": [
                            "Any small circular area that is different from its immediate environment, such as the colored ring around the pupil of the eye (iris) or an inflamed region surrounding a pimple."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9da2a744-2ede-3bb6-9a59-3f445bb8c71b",
                        "entry_id": "a962c388-f94d-3316-bec6-d31f1dfc9624",
                        "glosses": [
                            "Any of the small spaces throughout areolar connective tissue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe3077f-b31e-48f2-a269-24fe8c6ca55d",
                                "sense_id": "9da2a744-2ede-3bb6-9a59-3f445bb8c71b",
                                "text": "The tubes or elongated spaces of which we have spoken, are not distended with any fluid, but are merely moistened in the same way as the areolas of ordinary areolar tissue."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4db47b0-597f-3262-bfa0-b371c3fd0ed7",
                        "entry_id": "a962c388-f94d-3316-bec6-d31f1dfc9624",
                        "glosses": [
                            "Any of the small spaces between fibres of the tissues of certain lichens."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4070fb74-e3ac-33c9-b72a-7df76d842c6a",
                        "entry_id": "a962c388-f94d-3316-bec6-d31f1dfc9624",
                        "glosses": [
                            "Small patches, bearing the spines and glochids characteristic of the stems of cacti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2443c86d-fabd-435e-81c6-12cd87a56a65",
                                "sense_id": "4070fb74-e3ac-33c9-b72a-7df76d842c6a",
                                "text": "Every pulvillus or areola is studded with from six to eight spines... From these pulvilli, also called spiniferous areola, or very close to it, burst the young bud or flower. If the latter, it is then called the floriferous areola, and the point where the epidermis bursts is of a deep pink tinge."
                            }
                        ]
                    }
                ],
