                            {
                                "target_lang_word": "atutowy walet",
                                "target_lang_sense_clarification": "najwyższy atut w grze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42cbb0be-040a-3063-aba3-f2f0b7fe4b47",
                    "sense_definition": "Iemand die niet in Volendam geboren en getogen is.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regional_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat dorp wordt een buitenstaander vaak een <w>jas</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In that village, an outsider is often called a <w>jas</w>.",
                                "ru": "В этой деревне постороннего часто называют <w>чужаком</w>.",
                                "zh": "在那个村子里，外来者常被称为<w>外地人</w>。",
                                "pl": "W tej wiosce przyjezdnego często nazywa się <w>obcym</w>."
                            }
                        },
                        {
                            "text": "Hoewel hij er al jaren woont, beschouwen ze hem nog steeds als een <w>jas</w>.",
                            "target_lang_translations": {
                                "en": "Although he has lived there for years, they still consider him an <w>outsider</w>.",
                                "ru": "Хотя он живет там уже много лет, они все еще считают его <w>чужаком</w>.",
                                "zh": "尽管他已经在那里住了多年，他们仍把他视为<w>外地人</w>。",
                                "pl": "Mimo że mieszka tam od lat, wciąż uważają go za <w>obcego</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Volendam"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who was not born and raised in Volendam.",
                        "ru": "Человек, который не родился и не вырос в Волендаме (региональный сленг).",
                        "zh": "指并非在福伦丹出生和长大的人。",
                        "pl": "Osoba, która nie urodziła się i nie wychowała w Volendam (slang regionalny)."
                    },
