                "senses": [
                    {
                        "sense_id": "81215b77-a9ac-3b15-b6a9-3c0d93fe1cda",
                        "entry_id": "b6198760-6f9f-3859-946f-ebcd3b97c2ab",
                        "glosses": [
                            "Münze im Wert von einem Vierteldollar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc8399b-ed5b-4f17-bcc8-3521c7060e30",
                                "sense_id": "81215b77-a9ac-3b15-b6a9-3c0d93fe1cda",
                                "text": "„Windschutzscheibe und Blech waren mit Blut und etwas anderem verschmiert, und er ging zu einem Wechselautomaten, wo er sich Vierteldollarmünzen holte, kam zurück, steckte sie in den Schlitz, nahm den Schlauch von der Halterung, wusch den Wagen, spülte ihn ab, stieg wieder ein und fuhr in Richtung Westen auf den Highway hinaus.“"
                            },
                            {
                                "example_id": "431026bc-89f5-4060-815c-b666c7d505ce",
                                "sense_id": "81215b77-a9ac-3b15-b6a9-3c0d93fe1cda",
                                "text": "„Worthy warf zwei Vierteldollarmünzen hinein, fluchte, als er sah, dass es kein Wechselgeld gab, und griff nach zwei Pappbechern.“"
                            },
                            {
                                "example_id": "7999a68b-477f-46e1-8d37-bf214d5d2de2",
                                "sense_id": "81215b77-a9ac-3b15-b6a9-3c0d93fe1cda",
                                "text": "„Eine LED von der Größe einer Vierteldollarmünze in der Mitte des Kunststoffgehäuses des Geräts blinkte rot und anklagend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
