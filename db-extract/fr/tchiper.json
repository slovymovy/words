                ],
                "senses": [
                    {
                        "sense_id": "738e02b2-4f7d-3d0c-b8f1-4b17bad3dfab",
                        "entry_id": "298d52ab-9498-32c5-80c4-d8a4f6f2b473",
                        "glosses": [
                            "Exprimer sa désapprobation envers quelqu’un en émettant un son avec la bouche, son qui implique un mouvement de succion tout en mettant la langue en arrière."
                        ],
                        "tags": [
                            "Afrique",
                            "Antilles",
                            "etc."
                        ],
                        "examples": [
                            {
                                "example_id": "816fd7c9-700e-4817-ae7e-4061a99aab83",
                                "sense_id": "738e02b2-4f7d-3d0c-b8f1-4b17bad3dfab",
                                "text": "Savez-vous \"tchiper\" ? Yaotcha d’Almeida, mi-togolaise, mi-guadeloupéenne, nous familiarise avec ce mode d’expression africain."
                            },
                            {
                                "example_id": "5012e2d4-6101-4180-873e-5103766e7a4d",
                                "sense_id": "738e02b2-4f7d-3d0c-b8f1-4b17bad3dfab",
                                "text": "Au moment où vous vous apprêtez à descendre du wagon, vous bousculez un jeune homme, qui en l’espace de trois secondes vous lance un regard méprisant et vous tchipe. Aucun mot. Et pourtant son agacement n’échappe à personne."
                            },
                            {
                                "example_id": "7debd533-3151-4827-ac98-928f96eaa727",
                                "sense_id": "738e02b2-4f7d-3d0c-b8f1-4b17bad3dfab",
                                "text": "Elle était contrariée et ne faisait que tchiper en marmonnant."
                            }
                        ]
                    }
                ],
