                                                "example_id": "04736829-f5ed-4926-aebd-2557723fc186",
                                                "sense_id": "911cf635-0a3e-3cdc-82d2-af63551f03a6",
                                                "text": "Triggered by the AG collection of dolls, books, and accessories, this cultural phenomenon is changing the way girls conceptualize America and themselves"
                                            },
                                            {
                                                "example_id": "e68c3098-b8b0-48bf-9de1-5c2d82d92b09",
                                                "sense_id": "911cf635-0a3e-3cdc-82d2-af63551f03a6",
                                                "text": "There are more than eighty thousand different kinds of American Girl Doll videos on YouTube. A smattering are just AG enthusiasts showing off their collections."
                                            },
                                            {
                                                "example_id": "96697aca-d358-438b-921d-851b89d546ee",
                                                "sense_id": "911cf635-0a3e-3cdc-82d2-af63551f03a6",
                                                "text": "When it comes down to everything, I really think AG does not represent the Black community, and they do not represent the queer community."
                                            }
                                        ]
                                    }
                                ]
                            },
