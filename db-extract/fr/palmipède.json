                    {
                        "sense_id": "ca2af0ef-c282-3a82-88cf-97fd5a605d38",
                        "entry_id": "56963593-6acc-328b-a291-1d9fa20c5e98",
                        "glosses": [
                            "Qui a les pieds palmés ; dont les doigts sont unis par une membrane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4cbf80e-e07c-4b5d-864b-88cb1f786be9",
                                "sense_id": "ca2af0ef-c282-3a82-88cf-97fd5a605d38",
                                "text": "L’albatros est le plus gros des oiseaux palmipèdes ; il est reconnoissable à sa corporance massive qui lui a fait donner le nom de mouton du Cap , en le comparant à ce quadrupède pour sa grosseur ; […]."
                            },
                            {
                                "example_id": "207668c5-2cea-4b40-94d0-ad94c97f9caf",
                                "sense_id": "ca2af0ef-c282-3a82-88cf-97fd5a605d38",
                                "text": "Le castor est un mammifère palmipède."
                            }
                        ]
                    }
                ],
