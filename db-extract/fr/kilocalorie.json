                "senses": [
                    {
                        "sense_id": "cc7d3b5f-916a-3d10-895d-d9965f409c1e",
                        "entry_id": "5e50ef8c-dfee-3cc2-be5d-4a8a31769a8c",
                        "glosses": [
                            "Unité d’énergie, de symbole kcal, correspondant à mille petites calories, soit entre 4,2045 et 4,1819 kilojoules selon la variante, et surtout employée en diététique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ea8fa3-61f0-48f4-b1a3-86829a6685e9",
                                "sense_id": "cc7d3b5f-916a-3d10-895d-d9965f409c1e",
                                "text": "La kilocalorie thermochimique vaut exactement 4184 joules."
                            },
                            {
                                "example_id": "cd435906-433a-452e-981c-9e9032c53cf9",
                                "sense_id": "cc7d3b5f-916a-3d10-895d-d9965f409c1e",
                                "text": "Énergie calorique (chaleur) de 1 g d’eau; cette unité étant beaucoup trop petite on utilise en physiologie humaine la kilocalorie (grande calorie ou Calorie) égale à 1 000 calories)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e1b8557-a3f3-4d47-ad67-15dfaf019f91",
                        "source_entry_id": "5e50ef8c-dfee-3cc2-be5d-4a8a31769a8c",
                        "source_sense_id": "cc7d3b5f-916a-3d10-895d-d9965f409c1e",
                        "target_lang_word": "kilocalorie",
                        "target_lang_code": "en",
