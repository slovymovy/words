                "senses": [
                    {
                        "sense_id": "144f627b-c069-32a3-81ae-b2843e6e8d85",
                        "entry_id": "bbe8e8e4-aa7e-379a-a2bd-659ed74a04a1",
                        "glosses": [
                            "Classe dont les instances sont des classes."
                        ],
                        "tags": [
                            "Programmation orientée objet"
                        ],
                        "examples": [
                            {
                                "example_id": "1aa19501-4d10-413c-83ee-22039566e6c3",
                                "sense_id": "144f627b-c069-32a3-81ae-b2843e6e8d85",
                                "text": "L’abstraction la plus poussée que nous abordons dans cet ouvrage est la notion de métaclasse, une classe qui hérite de type."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78b9d925-7ad6-49d0-8d1c-86da24ba1306",
                        "source_entry_id": "bbe8e8e4-aa7e-379a-a2bd-659ed74a04a1",
                        "source_sense_id": "144f627b-c069-32a3-81ae-b2843e6e8d85",
                        "target_lang_word": "metaclass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaclass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a54bafa-1a67-3dd1-bfba-df6158366e5e",
                                        "entry_id": "93cc11d7-db49-3c9e-b594-9c30da4810a4",
                                        "glosses": [
                                            "A class that serves as a template for other classes rather than objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47bc15d0-cb5e-431e-81e9-9093e3143887",
                                                "sense_id": "9a54bafa-1a67-3dd1-bfba-df6158366e5e",
                                                "text": "That is, all metaclasses (such as Collection class, Object class and Set class) are instances of the class Metaclass. This is because all metaclasses have the same behavior. They define the structure, definition and behavior of a class."
                                            },
                                            {
                                                "example_id": "43b94655-0e45-4e2b-9018-67d060d0bc88",
                                                "sense_id": "9a54bafa-1a67-3dd1-bfba-df6158366e5e",
                                                "text": "First, the class can explicitly specify its metaclass by either setting a __metaclass__ class variable (Python 2), or supplying the metaclass keyword argument in the tuple of base classes (Python 3)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
