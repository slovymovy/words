                "senses": [
                    {
                        "sense_id": "12ad6918-ee0c-36c3-a769-03e6f8c18168",
                        "entry_id": "d52777cb-cc50-3d38-b85b-13e6fb4d1eb3",
                        "glosses": [
                            "eine dichte Ansammlung von Häusern über ein großes Gebiet oder in einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df84831-5cbc-4009-90db-3394afdb0a4e",
                                "sense_id": "12ad6918-ee0c-36c3-a769-03e6f8c18168",
                                "text": "Groß und gewaltig, höher als alle Paläste und Minarette ragt die Hassan-Moschee über das Häusermeer von Kairo empor."
                            },
                            {
                                "example_id": "bf1e1177-a314-4a83-8f8b-1941a40ae32c",
                                "sense_id": "12ad6918-ee0c-36c3-a769-03e6f8c18168",
                                "text": "TV-Geräte sind zwar Luxusware in Soweto, aber irgendwo im Häusermeer findet sich immer eins - zum Beispiel im Kliptown Youth Program."
                            },
                            {
                                "example_id": "a36812ce-636d-41b2-bfeb-3c2892a71791",
                                "sense_id": "12ad6918-ee0c-36c3-a769-03e6f8c18168",
                                "text": "„Sie standen in dem Häusermeer und reckten ihre Türme zum Himmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
