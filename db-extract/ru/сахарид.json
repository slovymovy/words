                ],
                "senses": [
                    {
                        "sense_id": "5645d636-e039-32db-b8ad-fc497c8cddad",
                        "entry_id": "61b51155-ac39-3ca9-b002-047695a92a92",
                        "glosses": [
                            "органическое вещество, содержащие карбонильную группу и несколько гидроксильных групп"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8097db48-b922-4d41-8859-1bd10ae9ff0b",
                                "sense_id": "5645d636-e039-32db-b8ad-fc497c8cddad",
                                "text": "Эти различные простые углеводы — различные сахариды — являются для полисахаридов как бы кирпичами или структурными элементами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17e17fae-a07f-4319-b7e2-78c71694e67e",
                        "source_entry_id": "61b51155-ac39-3ca9-b002-047695a92a92",
                        "source_sense_id": "5645d636-e039-32db-b8ad-fc497c8cddad",
                        "target_lang_word": "saccharide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saccharide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                        "entry_id": "b468bc10-5f75-34b3-8fcb-60e6d7132c88",
                                        "glosses": [
                                            "The unit structure of carbohydrates, of general formula CₙH₂ₙOₙ. Either the simple sugars or polymers such as starch and cellulose. The saccharides exist in either a ring or short chain conformation, and typically contain five or six carbon atoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f87a93d-f605-472f-b770-1cccc14a238d",
                                                "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                                "text": "Holonyms: monosaccharide, oligosaccharide, polysaccharide"
                                            },
                                            {
                                                "example_id": "5b49a14f-f701-44ef-92ce-db04a3d08c42",
                                                "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                                "text": "The saccharides include such substances as dextrose and levulose, which are typical examples of the two classes into which these bodies are divisible, viz. the Aldoses and Ketoses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94dd3a74-4525-4b8b-b020-4e3b7dede04a",
                        "source_entry_id": "61b51155-ac39-3ca9-b002-047695a92a92",
                        "source_sense_id": "5645d636-e039-32db-b8ad-fc497c8cddad",
                        "target_lang_word": "saccharide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saccharide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf60318-6ca8-3ee7-abb2-261c13d4c6d9",
                                        "entry_id": "df8fe69e-26f6-3f07-9de3-f36cd17ee452",
                                        "glosses": [
                                            "Synonyme ancien de glucide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "306cb94e-b661-4fa7-9531-a59648b15846",
                                                "sense_id": "bcf60318-6ca8-3ee7-abb2-261c13d4c6d9",
                                                "text": "Un  saccharide incomplètement méthylé introduirait de ce fait des groupements alcooliques non masqués initialement."
                                            },
                                            {
                                                "example_id": "e8fa7e31-2127-4e9f-8692-5813aae336dd",
                                                "sense_id": "bcf60318-6ca8-3ee7-abb2-261c13d4c6d9",
                                                "text": "L'U.D.P.G. joue un rôle de précurseur dans la synthèse de nombreux glycosides et saccharides."
                                            },
                                            {
                                                "example_id": "f1576052-deeb-4061-b09c-b6a25325f135",
                                                "sense_id": "bcf60318-6ca8-3ee7-abb2-261c13d4c6d9",
                                                "text": "Les agaves, qui supportent le froid et la sécheresse, ont une sève riche en saccharides, de sorte qu’ils ont dû contribuer à l'alimentation humaine dès l’époque préhispanique."
                                            },
                                            {
                                                "example_id": "a1e327d5-185a-4f2a-8b13-3dbebc2cccb0",
                                                "sense_id": "bcf60318-6ca8-3ee7-abb2-261c13d4c6d9",
                                                "text": "Contenus dans le cytoplasme de la cellule végétale, ces organites sont surtout connus pour être les principaux sites de fixation du carbone - qu'ils transforment en trois saccharides, dont le glucose et le maltose - et de la photosynthèse chez les plantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
