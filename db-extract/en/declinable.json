                        "sense_id": "4ff36157-e1a2-352b-9445-626f2e531c8a",
                        "entry_id": "4c7ec7d3-5564-3eb5-92eb-cb36bddf1bf0",
                        "glosses": [
                            "Capable of being declined; of a word, having inflections."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd6d404-3f16-441f-bc60-f8fca11e45a7",
                                "sense_id": "4ff36157-e1a2-352b-9445-626f2e531c8a",
                                "text": "It is obvious that the system in present-day English is radically different, and that the notion of case (i.e. a form or modification of a declinable word) is now of very little significance."
                            }
                        ]
                    }
                ],
