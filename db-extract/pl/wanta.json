                        "source_entry_id": "8394d3da-d0c8-3308-808b-51e38e438964",
                        "source_sense_id": "693d1140-f0e0-3725-a27c-1163a7979afa",
                        "target_lang_word": "Want",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
