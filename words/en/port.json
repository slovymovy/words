                            "target_lang_translations": {
                                "ru": "Круизный лайнер <w>зайдет в порт</w> Майами на два дня, прежде чем продолжить путешествие.",
                                "zh": "游轮将在迈阿密<w>靠港</w>两天，然后再继续航行。"
                            }
