                        "target_lang_word": "poignet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poignet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e1148d-3701-3383-9903-0a4fda3c020b",
                                        "entry_id": "a131d8ab-0190-3319-866c-a94af38696f5",
                                        "glosses": [
                                            "Articulation par laquelle l’avant-bras se joint à la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c125b7a-fef5-44e9-972f-dc17c2431360",
                                                "sense_id": "a3e1148d-3701-3383-9903-0a4fda3c020b",
                                                "text": "Je te tendrai mon poignet où s’est gravée la douceur de ta bouche, et tu prendras ma ceinture pour l’attacher au tien."
                                            },
                                            {
                                                "example_id": "f5e7aa16-975f-40d9-984f-fdf74827a5d5",
                                                "sense_id": "a3e1148d-3701-3383-9903-0a4fda3c020b",
                                                "text": "À Armenonville, à une table voisine de la nôtre, un sous-lieutenant de dragons enlace de son bras le buste de sa trop bruyante compagne et laisse voir ainsi au poignet un tatouage d’escarpe…"
                                            },
                                            {
                                                "example_id": "a4ba5271-5e65-4628-b163-44bbc3baf250",
                                                "sense_id": "a3e1148d-3701-3383-9903-0a4fda3c020b",
                                                "text": "Lo...., aidé d'un autre, m'attacha par les poignets et les chevilles avec des lanières de cuir fixées au bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2915bb9-4808-309e-9026-7c4335ed05c3",
                                        "entry_id": "a131d8ab-0190-3319-866c-a94af38696f5",
                                        "glosses": [
                                            "Petite pièce d’étoffe taillée transversalement et qui termine la manche d’une chemise, d’un corsage, d’une robe."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "240ef31f-21e9-40c4-91ef-8831a6581990",
                                                "sense_id": "f2915bb9-4808-309e-9026-7c4335ed05c3",
                                                "text": "La jeannette est une petite planche qui permet un repassage minutieux des emmanchures, des manches et des poignets."
                                            },
                                            {
                                                "example_id": "ecf73859-a979-42b8-94af-cc464ec97008",
                                                "sense_id": "f2915bb9-4808-309e-9026-7c4335ed05c3",
                                                "text": "Les poignets de cette chemise sont trop étroits."
                                            },
                                            {
                                                "example_id": "b6920af2-9152-4783-a59a-10c13d07bf87",
                                                "sense_id": "f2915bb9-4808-309e-9026-7c4335ed05c3",
                                                "text": "Il avait des boutons de nacre aux poignets de sa chemise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2d972aa-c518-437e-9176-69f4e5b6b5ca",
                        "source_entry_id": "b112147f-9397-3813-827a-f983b6c29598",
                        "source_sense_description": "anatomie: 1. gewricht",
                        "target_lang_word": "Handgelenk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handgelenk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                        "entry_id": "f399976e-7db8-34ae-be82-995e7b363309",
                                        "glosses": [
                                            "dasjenige Gelenk, das Hand und Unterarm verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ada363-eaeb-4b6a-a553-cba32aa88be7",
                                                "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                                "text": "Ich habe mir das Handgelenk verstaucht."
                                            },
                                            {
                                                "example_id": "f021dd2d-7ac3-427d-a19c-3c0a112c679e",
                                                "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                                "text": "„Sie packte mein Handgelenk und versuchte es wegzudrehen.“"
                                            },
                                            {
                                                "example_id": "f300098f-9306-4261-9962-4179456a2614",
                                                "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                                "text": "„Obgleich ich durch die Ketten an meinen Handgelenken behindert war, war ich im Nu oben und beugte mich hinunter, um Ben nachzuholen.“"
                                            },
                                            {
                                                "example_id": "18642de4-55c8-4a69-aecd-77dc0ba6a881",
                                                "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                                "text": "„Schließlich greift sie selbst nach seiner Hand, um mit eigenem Ohr und geschlossenen Augen an seinem Handgelenk zu lauschen und läßt die Hand auch nachher noch lange nicht los, sondern drückt sie an ihre Wange.“"
                                            },
                                            {
                                                "example_id": "fe50a5e6-fbe6-457b-a048-f24219b6c264",
                                                "sense_id": "519ee23d-9cea-377f-8b5f-ff8b7271d180",
                                                "text": "„Das Handgelenk unterm Gips tat mir weh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
