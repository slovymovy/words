                    },
                    {
                        "form_id": "3f0aef78-0a18-4f57-b4ab-58e7a824dfc6",
                        "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "photoshopped"
                    },
                    {
                        "form_id": "bd4495a4-6ac5-4406-a5d4-856114e0a382",
                        "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "tags": [
                            "past"
                        ],
                        "form": "photoshopped"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                        "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "glosses": [
                            "To digitally edit or alter (a picture or photograph)."
                        ],
                        "tags": [
                            "transitive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "71356195-6898-4caa-a340-d038e24c8332",
                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                "text": "She charged that the prosecutor had photoshopped the image to incriminate her."
                            },
                            {
                                "example_id": "64acf611-317f-4809-9b8b-df5c7e0b920d",
                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                "text": "Photographs can be manipulated, too; while a \"Photoshopped\" image may look beautiful, it might not give a correct impression of a place (this is a whole other column)."
                            },
                            {
                                "example_id": "7c62f6a4-bd52-41a7-bc95-766601116e26",
                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                "text": "Ned Shaw, a former illustrator for PC Magazine, has gathered a huge collection of classic examples from such artists and illustrators as Maxfield Parish and Edmund Dulac. He then Photoshopped it (a new verb; you heard it first here) and produced two volumes of fantastic art. The cool part is that the product comes in two resolutions."
                            },
                            {
                                "example_id": "f3acaa98-4ed7-4896-913b-acc852637679",
                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                "text": "The feisty brunette star of The Mummy [sc. Rachel Weisz] boasts: \"I really did hold that snake. People thought it was Photoshopped in, but it was the real thing. I had to stay relaxed.\" What about the snake?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b4f019c-e5f6-460a-a112-9b247f0ebc2f",
                        "source_entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "source_sense_id": "7858f787-43d9-3205-be86-96321d539646",
                        "source_sense_description": "to digitally edit a picture",
                        "target_lang_word": "fotoshoppen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fotoshoppen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3e149917-fa79-3791-b9a2-fd22f9f3625c",
                                        "entry_id": "9b5059e5-de79-30f0-bdd0-219e01a5dbf4",
                                        "glosses": [
                                            "bewerken van foto's en ander digitaal beeldmateriaal via de computer"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebd2a49-7605-4646-84ef-f62bd1765932",
                                                "sense_id": "3e149917-fa79-3791-b9a2-fd22f9f3625c",
                                                "text": "De spectaculaire foto's op die website zijn ongetwijfeld gefotoshopt."
                                            },
                                            {
                                                "example_id": "9a20f555-f9be-4cac-8a05-a99ebb414f2e",
                                                "sense_id": "3e149917-fa79-3791-b9a2-fd22f9f3625c",
                                                "text": "Julia Roberts is natuurlijk altijd knap, ook zonder make-up. Maar Oprah Winfrey? Van haar vermoedde uw sterrenkijker dat zij permanent gefotoshopt door het leven ging, en er alleen daarom nog kunnend uitzag. Dat er altijd een kleine dienaar naast haar liep om haar gezicht op te verven en haar nephaar bij te föhnen, omdat haar uiterlijk anders een verschrikking was. Maar ook Oprah blijkt er reuzeleuk uit te zien zonder driedubbele laag make-up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "493a06cc-b0f3-4a46-823f-fd817bc95cab",
                        "source_entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "source_sense_id": "7858f787-43d9-3205-be86-96321d539646",
                        "source_sense_description": "to digitally edit a picture",
                        "target_lang_word": "photoshoper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photoshoper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3911ee16-837b-366a-8044-a74169290cb4",
                                        "entry_id": "247e4313-d98c-31d7-905d-f77097f30243",
                                        "glosses": [
                                            "Retoucher une image grâce à Photoshop ou un quelconque logiciel de traitement d’image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390dc1f7-5c1c-4470-a7aa-070bb4c6c0f9",
                                                "sense_id": "3911ee16-837b-366a-8044-a74169290cb4",
                                                "text": "Et elle a ajouté, toujours le sourire aux lèvres, que finalement, ce que je cherchais, c’était ni plus ni moins le type qui l’avait photoshopée…"
                                            },
                                            {
                                                "example_id": "8898d433-9e09-4b55-b2bd-6a3671fde591",
                                                "sense_id": "3911ee16-837b-366a-8044-a74169290cb4",
                                                "text": "Son maître a alors photoshopé une image de son chat jaune, ajoutant les détails orange et noirs, pour le faire ressembler au célèbre Pokémon."
                                            },
                                            {
                                                "example_id": "2049fee8-b71c-4e54-8fd6-adf36c0e2b76",
                                                "sense_id": "3911ee16-837b-366a-8044-a74169290cb4",
                                                "text": "Je rêve d’un monde où AdopteUnMec serait devenu obsolète, leurs créateurs ruinés, car on n’y perdrait plus son temps à photoshoper pour choper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0969c39-f3ee-4c44-adb0-c349a055060b",
                        "source_entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "source_sense_id": "7858f787-43d9-3205-be86-96321d539646",
