                                    {
                                        "sense_id": "f5be89ab-1bad-3516-9d20-32ccd0c90c2c",
                                        "entry_id": "5897bdb9-d269-3234-b051-3ee8ebbb1b94",
                                        "glosses": [
                                            "Nom vernaculaire de deux espèces d’arbres de la famille des sapotacées : le grand natte ou natte à grandes feuilles, et le petit natte."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94a625f-d32a-4389-9c4f-e5a26aadd7f9",
                                                "sense_id": "f5be89ab-1bad-3516-9d20-32ccd0c90c2c",
                                                "text": "Les nattes, notamment le petit natte et le grand natte, sont des espèces d’arbres de la famille des Sapotaceae, de bois rouge-brun très recherchés par les ébénistes."
                                            }
                                        ]
                                    }
                                ]
                            },
