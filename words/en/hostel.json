{
    "word_family": [
        "hosteller",
        "hostelling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c0d4dd2-037a-347e-861f-4cf7e4ef36e0",
                    "sense_definition": "An inexpensive commercial lodging place with shared rooms and facilities, often used by young travelers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to stay in a cheap <w>hostel</w> to save money for our sightseeing tours.",
                            "target_lang_translations": {
                                "ru": "Мы решили остановиться в дешевом <w>хостеле</w>, чтобы сэкономить деньги на экскурсии."
                            }
                        },
                        {
                            "text": "The youth <w>hostel</w> was very clean and had a large kitchen for all the guests to use.",
                            "target_lang_translations": {
                                "ru": "Молодежный <w>хостел</w> был очень чистым, и в нем была большая кухня для всех гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "youth hostel",
                        "inn",
                        "backpackers"
                    ],
                    "antonyms": [
                        "hotel",
                        "resort"
                    ],
                    "common_phrases": [
                        "youth hostel",
                        "cheap hostel",
                        "hostel room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недорогое место временного проживания с общими комнатами и удобствами, часто используемое молодыми путешественниками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хостел",
                                "target_lang_sense_clarification": "дешёвый отель для туристов"
                            },
                            {
                                "target_lang_word": "турбаза",
                                "target_lang_sense_clarification": "база отдыха для туристов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8446bfac-1afc-38e3-a8dc-b5e5475921f6",
                    "sense_definition": "A building providing accommodation for students at a university or school.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>hostel</w> is located just a five-minute walk from the main library.",
                            "target_lang_translations": {
                                "ru": "Университетское <w>общежитие</w> расположено всего в пяти минутах ходьбы от главной библиотеки."
                            }
                        },
                        {
                            "text": "Living in a student <w>hostel</w> is a great way to make new friends during your first year.",
                            "target_lang_translations": {
                                "ru": "Жизнь в студенческом <w>общежитии</w> — отличный способ завести новых друзей на первом курсе."
                            }
                        }
                    ],
                    "synonyms": [
                        "dormitory",
                        "dorm",
                        "residence hall"
                    ],
                    "common_phrases": [
                        "student hostel",
                        "university hostel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, предоставляющее жилье для студентов университета или школы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общежитие",
                                "target_lang_sense_clarification": "для студентов или сотрудников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dc75da6-d8b1-3bbb-a322-4fe31c272b91",
                    "sense_definition": "A place providing temporary shelter and sometimes food for people who have no home.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local charity opened a new <w>hostel</w> for the homeless during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Местная благотворительная организация открыла новый <w>приют</w> для бездомных в холодные зимние месяцы."
                            }
                        },
                        {
                            "text": "He spent several weeks living in a homeless <w>hostel</w> before finding a permanent apartment.",
                            "target_lang_translations": {
                                "ru": "Он провел несколько недель в <w>ночлежке</w> для бездомных, прежде чем нашел постоянную квартиру."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelter",
                        "refuge"
                    ],
                    "common_phrases": [
                        "homeless hostel",
                        "emergency hostel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, предоставляющее временный приют и иногда еду для бездомных людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приют",
                                "target_lang_sense_clarification": "благотворительное учреждение"
                            },
                            {
                                "target_lang_word": "ночлежка",
                                "target_lang_sense_clarification": "место для ночлега бездомных"
                            },
                            {
                                "target_lang_word": "ночлежный дом",
                                "target_lang_sense_clarification": "социальное учреждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "128696aa-02eb-3d82-a80b-39284e559109",
                    "sense_definition": "A small, unendowed college or hall of residence at Oxford or Cambridge University.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical records mention several small <w>hostels</w> that existed before the major colleges were established.",
                            "target_lang_translations": {
                                "ru": "Исторические записи упоминают несколько небольших <w>общежитий</w>, которые существовали до основания основных колледжей."
                            }
                        },
                        {
                            "text": "The ancient <w>hostel</w> provided a quiet place for scholars to live and study together.",
                            "target_lang_translations": {
                                "ru": "Старинное <w>общежитие</w> служило тихим местом для совместной жизни и учебы ученых."
                            }
                        }
                    ],
                    "synonyms": [
                        "hall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specifically referring to historical university structures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой колледж или общежитие в Оксфордском или Кембриджском университете (историческое значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холл",
                                "target_lang_sense_clarification": "университетское здание"
                            },
                            {
                                "target_lang_word": "общежитие",
                                "target_lang_sense_clarification": "историческое жилье для ученых"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8a7595c-31db-3781-ba6e-8a42904b51d8",
                    "sense_definition": "To travel while staying in hostels.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire summer <w>hostelling</w> across Europe with nothing but their backpacks.",
                            "target_lang_translations": {
                                "ru": "Они провели все лето, <w>путешествуя по хостелам</w> Европы налегке с одними рюкзаками."
                            }
                        },
                        {
                            "text": "If you want to see the country on a budget, you should consider <w>hostelling</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите бюджетно посмотреть страну, вам стоит рассмотреть <w>вариант с хостелами</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go hostelling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать, останавливаясь в хостелах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествовать с остановками в хостелах",
                                "target_lang_sense_clarification": "бюджетный туризм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41c2cb40-cf11-39c7-bc4f-dd3858362c29",
                    "sense_definition": "To provide someone with lodging in a hostel.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization aims to <w>hostel</w> visiting students in safe and affordable environments.",
                            "target_lang_translations": {
                                "ru": "Организация стремится <w>размещать</w> приезжих студентов в безопасных и доступных условиях."
                            }
                        },
                        {
                            "text": "During the festival, many residents offered to <w>hostel</w> performers in local dormitories.",
                            "target_lang_translations": {
                                "ru": "Во время фестиваля многие жители предлагали <w>поселить</w> артистов в местных общежитиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodge",
                        "house",
                        "accommodate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо жилье в хостеле или общежитии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "в хостеле или общежитии"
                            },
                            {
                                "target_lang_word": "селить",
                                "target_lang_sense_clarification": "в бюджетном жилье"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}