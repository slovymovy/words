                "senses": [
                    {
                        "sense_id": "2dea2d97-2c92-340e-956e-49dea3fb8ffe",
                        "entry_id": "5793645b-aef1-3edb-a86a-9bc928727217",
                        "glosses": [
                            "ein ursprünglich aus Kleinasien stammendes Rosengewächs, das bei uns häufig als Hecke gepflanzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "481b06a4-98ab-43e7-a223-55a664ebddec",
                                "sense_id": "2dea2d97-2c92-340e-956e-49dea3fb8ffe",
                                "text": "Der Kirschlorbeer hat vom Aussehen große Ähnlichkeit mit dem Lorbeerbaum, obwohl er mit diesem nicht näher verwandt ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5e717ae-5bca-4a44-bcee-06b040d7a6a2",
                        "source_entry_id": "5793645b-aef1-3edb-a86a-9bc928727217",
                        "source_sense_id": "2dea2d97-2c92-340e-956e-49dea3fb8ffe",
                        "target_lang_word": "лавровишня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лавровишня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                        "entry_id": "b3f093dc-b32c-3a80-957a-c0eba5998d6f",
                                        "glosses": [
                                            "ботан. южное вечнозелёное растение (дерево или кустарник) рода сливы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e725c5-9676-49dc-803a-b0e343e400a2",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": "Несколько кипарисов, лавровишня, древесная акация, самшит .. и другие растения, привезённые из Константинополя, растут здесь на диво…"
                                            },
                                            {
                                                "example_id": "3807a8bf-b155-4c73-bd0a-6dff26df6a70",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": ".. леса поражают красотой и изобилием пород: самшит .., рододендрум, лавровишня, каштан, граб, дуб, разные клёны, орехи, черешни .."
                                            },
                                            {
                                                "example_id": "ed1d2d22-2d11-4616-a37f-9eb70b4116de",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": "Из-за зимнего времени много деревьев в парках было без листвы, но туйи, разные сосны, кипарисы, кедры, вечнозелёные мирты и лавровишни украшали склоны гор."
                                            },
                                            {
                                                "example_id": "eabb101c-6fcc-48f8-9672-89538ac5e96b",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": "Целые улицы засажены лавровишнями .."
                                            },
                                            {
                                                "example_id": "1fb76599-c027-4c74-8eaa-398e16abfba9",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": ".. лавровишня .. растёт в виде довольно крупного куста и обильно плодоносит чёрными ягодами. В них содержится синильная кислота и есть их не следует .."
                                            },
                                            {
                                                "example_id": "4dda858b-ea46-4d47-8fb2-e6f16e853c26",
                                                "sense_id": "41c38a82-dc1f-3570-b8ae-8ddab9590be2",
                                                "text": "Непосредственно перед домом, вдоль стены, полосой расположены стриженые кустарники. Здесь преобладают вечнозелёные — самшит, лавровишня, бересклет, различные хвойные, много пышно цветущих азалий и рододендронов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
