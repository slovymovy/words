{
    "word_family": [
        "attraction",
        "attractive",
        "attractiveness",
        "unattractive",
        "attractor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f3a3b86-a4f3-384e-91a3-04825d071464",
                    "sense_definition": "To cause someone to have a liking for or interest in something; to draw attention or allure someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Advertising is designed to <w>attract</w> customers to the new store.",
                            "target_lang_translations": {
                                "ru": "Реклама создана, чтобы <w>привлекать</w> покупателей в новый магазин.",
                                "zh": "广告旨在<w>吸引</w>顾客光顾新店。",
                                "pl": "Reklama ma na celu <w>przyciągnięcie</w> klientów do nowego sklepu."
                            }
                        },
                        {
                            "text": "She waved her hand to <w>attract</w> the waiter's attention.",
                            "target_lang_translations": {
                                "ru": "Она помахала рукой, чтобы <w>привлечь</w> внимание официанта.",
                                "zh": "她挥手以<w>吸引</w>服务员的注意。",
                                "pl": "Pomachała ręką, aby <w>przyciągnąć</w> uwagę kelnera."
                            }
                        }
                    ],
                    "synonyms": [
                        "allure",
                        "draw",
                        "interest",
                        "appeal to"
                    ],
                    "antonyms": [
                        "repel"
                    ],
                    "common_phrases": [
                        "attract attention",
                        "attract customers",
                        "attract interest",
                        "attract tourists"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать интерес, симпатию или обращать на себя внимание.",
                        "zh": "使某人产生好感或兴趣；吸引注意力或诱惑某人。",
                        "pl": "Powodować, że ktoś czuje zainteresowanie lub sympatię; przyciągać uwagę lub kogoś wabić."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привлекать",
                                "target_lang_sense_clarification": "вызывать интерес или внимание"
                            },
                            {
                                "target_lang_word": "притягивать",
                                "target_lang_sense_clarification": "манить, располагать к себе"
                            },
                            {
                                "target_lang_word": "заинтересовывать",
                                "target_lang_sense_clarification": "пробуждать любопытство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "引起兴趣或注意力"
                            },
                            {
                                "target_lang_word": "招引",
                                "target_lang_sense_clarification": "招来或引来"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przyciągać",
                                "target_lang_sense_clarification": "wzbudzać zainteresowanie lub uwagę"
                            },
                            {
                                "target_lang_word": "pociągać",
                                "target_lang_sense_clarification": "być dla kogoś interesującym lub atrakcyjnym"
                            },
                            {
                                "target_lang_word": "wabić",
                                "target_lang_sense_clarification": "przyciągać kogoś lub coś w określone miejsce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4098d053-b61e-3487-a19e-8d096d71df5f",
                    "sense_definition": "To pull something towards itself by a physical force like gravity or magnetism without touching it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A strong magnet <w>attracts</w> iron filings instantly.",
                            "target_lang_translations": {
                                "ru": "Сильный магнит мгновенно <w>притягивает</w> железные опилки.",
                                "zh": "强磁铁能瞬间<w>吸引</w>铁屑。",
                                "pl": "Silny magnes natychmiast <w>przyciąga</w> opiłki żelaza."
                            }
                        },
                        {
                            "text": "The gravity of the earth <w>attracts</w> the moon and keeps it in orbit.",
                            "target_lang_translations": {
                                "ru": "Гравитация Земли <w>притягивает</w> Луну и удерживает её на орбите.",
                                "zh": "地球的引力<w>吸引</w>着月球，使其保持在轨道上运行。",
                                "pl": "Grawitacja Ziemi <w>przyciąga</w> Księżyc i utrzymuje go na orbicie."
                            }
                        }
                    ],
                    "synonyms": [
                        "draw"
                    ],
                    "antonyms": [
                        "repel"
                    ],
                    "common_phrases": [
                        "attract iron",
                        "attract particles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тянуть к себе физической силой (например, гравитацией или магнетизмом).",
                        "zh": "通过重力或磁力等物理作用力，在不接触的情况下将某物拉向自身。",
                        "pl": "Przyciągać coś do siebie za pomocą siły fizycznej, takiej jak grawitacja lub magnetyzm, bez bezpośredniego kontaktu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притягивать",
                                "target_lang_sense_clarification": "физически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "物理上的引力作用"
                            },
                            {
                                "target_lang_word": "吸附",
                                "target_lang_sense_clarification": "指磁力或静电吸住物体"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przyciągać",
                                "target_lang_sense_clarification": "działanie siły fizycznej, np. magnesu lub grawitacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b97954c-eb15-393a-baa0-9db1b7c7cbab",
                    "sense_definition": "To cause a reaction or consequence, often a negative one such as criticism or a fee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using the minibar in a hotel room usually <w>attracts</w> additional charges.",
                            "target_lang_translations": {
                                "ru": "Использование мини-бара в номере отеля обычно <w>влечет</w> за собой дополнительные расходы.",
                                "zh": "使用酒店房间的迷你吧通常会<w>招致</w>额外费用。",
                                "pl": "Korzystanie z minibaru w pokoju hotelowym zazwyczaj <w>pociąga za sobą</w> dodatkowe opłaty."
                            }
                        },
                        {
                            "text": "The controversial decision <w>attracted</w> severe criticism from the public.",
                            "target_lang_translations": {
                                "ru": "Это спорное решение <w>вызвало</w> суровую критику со стороны общественности.",
                                "zh": "这一争议性决定<w>招致</w>了公众的严厉批评。",
                                "pl": "Kontrowersyjna decyzja <w>wywołała</w> ostrą krytykę ze strony opinii publicznej."
                            }
                        }
                    ],
                    "synonyms": [
                        "draw"
                    ],
                    "common_phrases": [
                        "attract criticism",
                        "attract charges",
                        "attract publicity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать реакцию или приводить к последствиям (часто негативным).",
                        "zh": "导致某种反应或后果，通常指批评或费用等负面事物。",
                        "pl": "Powodować wystąpienie reakcji lub konsekwencji, często negatywnych, takich jak krytyka lub opłaty."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "провоцировать реакцию"
                            },
                            {
                                "target_lang_word": "навлекать",
                                "target_lang_sense_clarification": "неприятности или критику"
                            },
                            {
                                "target_lang_word": "влечь",
                                "target_lang_sense_clarification": "иметь следствием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "招致",
                                "target_lang_sense_clarification": "引起（不好的后果）"
                            },
                            {
                                "target_lang_word": "引起",
                                "target_lang_sense_clarification": "导致某种反应"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pociągać za sobą",
                                "target_lang_sense_clarification": "mieć określone konsekwencje lub skutki"
                            },
                            {
                                "target_lang_word": "wywoływać",
                                "target_lang_sense_clarification": "powodować reakcję, np. krytykę"
                            },
                            {
                                "target_lang_word": "narażać na",
                                "target_lang_sense_clarification": "sprawiać, że ktoś musi ponieść koszty lub krytykę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}