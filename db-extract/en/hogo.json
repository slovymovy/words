                        "glosses": [
                            "A strong, unpleasant smell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e589822-9a96-4add-8fa5-f8587de498f0",
                                "sense_id": "630552b6-8584-3dde-9fb3-1e49985f5e94",
                                "text": "In short, he lookt extremely natty, / And even contrived—to his own great wonder— / By dint of sundry scents from Gattie, / To keep the sulphurous hogo under."
                            },
                            {
                                "example_id": "0d510561-c06b-4ba5-b12f-8027b046b3c5",
                                "sense_id": "630552b6-8584-3dde-9fb3-1e49985f5e94",
                                "text": "Some women for instance warn you off when they have their period. Come near. Then get a hogo you could hang your hat on. Like what? Potted herrings gone stale or. Boof! Please keep off the grass."
                            },
                            {
                                "example_id": "f4bc0357-d58e-4ac2-9ed9-aa9f4bde82a8",
                                "sense_id": "630552b6-8584-3dde-9fb3-1e49985f5e94",
                                "text": "He opened and let out a hogo of medicinal rum and beer. The bad tooth was a premolar."
                            }
                        ]
                    }
