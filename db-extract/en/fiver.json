                                                "sense_id": "0cd64953-ad0c-3777-ac4d-40d0308351d3",
                                                "text": "Der Fünfer fährt in die Innenstadt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8339d9c5-150d-3548-b0f1-37badde35215",
                                        "entry_id": "e4568b6e-a615-3489-9c95-0c8273f17b92",
                                        "glosses": [
                                            "Banknote oder Münze mit dem Wert von 5 Währungseinheiten"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb351850-9d02-43c6-9f05-9df486c2f793",
                                                "sense_id": "8339d9c5-150d-3548-b0f1-37badde35215",
                                                "text": "Kannst du mir einen Fünfer leihen?"
                                            },
                                            {
                                                "example_id": "d4673589-f603-4572-a176-1e60007ede6b",
                                                "sense_id": "8339d9c5-150d-3548-b0f1-37badde35215",
                                                "text": "„Ich ging zu Tohil und zog ihm die Brieftasche raus. Ein Fünfziger war drin, zwei Zwanziger, ein Fünfer und ein einzelner.“"
                                            },
                                            {
                                                "example_id": "ff566b5f-ba86-411a-842e-7a74f2369aa5",
                                                "sense_id": "8339d9c5-150d-3548-b0f1-37badde35215",
                                                "text": "„Ein Groschen wäre schon gut, ein Groschen und ein Fünfer besser, am besten aber drei Münzen: ein Groschen, ein Fünfer und ein Zweipfennigstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "83703b46-6fbe-3a1a-99a1-17925d2f4751",
                                        "entry_id": "e4568b6e-a615-3489-9c95-0c8273f17b92",
                                        "glosses": [
                                            "die Schulnote in „nicht genügend“ beziehungsweise in „mangelhaft“ (5); in der die Schulnote „gut“"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Germany",
                                            "Swiss Standard German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed0f8dc6-6ab4-4172-ada7-db66044494e7",
                                                "sense_id": "83703b46-6fbe-3a1a-99a1-17925d2f4751",
                                                "text": "„Zentralmatura: Mathe-Schulversuch bringt weniger Fünfer“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "de039cc4-74bb-3737-94b1-a79ba118ccb8",
                                        "entry_id": "e4568b6e-a615-3489-9c95-0c8273f17b92",
                                        "glosses": [
                                            "fünf richtig getippte Zahlen im Lotto"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157f8fce-6b2a-47ac-8c9c-0bfc717fd485",
                                                "sense_id": "de039cc4-74bb-3737-94b1-a79ba118ccb8",
                                                "text": "Ich habe einen Fünfer getippt und dreitausend Euro gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a2e39073-8eee-35fc-9036-db1da7fb3203",
                                        "entry_id": "e4568b6e-a615-3489-9c95-0c8273f17b92",
                                        "glosses": [
