                                        "examples": [
                                            {
                                                "example_id": "cae8841c-a7a6-4ddb-9521-94314d300480",
                                                "sense_id": "5140b5e5-75c2-369f-b817-ca98c1aa1ed9",
                                                "text": "\"Todo pranto é um comentário. Um comentário que amargamente condena os motivos dados.\""
                                            },
                                            {
                                                "example_id": "1de94f53-679b-4ba9-a5f1-2fc495369686",
                                                "sense_id": "5140b5e5-75c2-369f-b817-ca98c1aa1ed9",
                                                "text": "\"Pede-se aos senhores a aplicação da justiça. Justiça que outra coisa não é senão a razão do Direito.\""
                                            },
                                            {
                                                "example_id": "21b02e72-aa28-43ff-93fc-479e86ec6bfc",
                                                "sense_id": "5140b5e5-75c2-369f-b817-ca98c1aa1ed9",
                                                "text": "\"Só depois de me fazer isto é que chorei. Chorei todas as lágrimas que tinha em mim.\""
                                            }
                                        ]
                                    }
