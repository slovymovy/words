                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f562eeb8-6ccb-35fc-8068-51a449863789",
                                        "entry_id": "98b970c1-4b27-3d95-b731-ce869af3fac8",
                                        "glosses": [
                                            "niet op een bepaald tijdstip en plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0745f50b-84d9-4cad-af87-d0902b76fa92",
                                                "sense_id": "f562eeb8-6ccb-35fc-8068-51a449863789",
                                                "text": "Hij was afwezig op de vergadering, want hij was ergens anders."
                                            },
                                            {
                                                "example_id": "c6f18f3f-5e02-40e1-b9d2-7f687ed98120",
                                                "sense_id": "f562eeb8-6ccb-35fc-8068-51a449863789",
                                                "text": "Daar moesten allerlei visums voor worden verstrekt, ellenlange rijen in de brandende zon en in de stortende regen, om weer weggestuurd te worden omdat deze of die stempel niet op het document stond, omdat die of gene ambtenaar op die dag afwezig is - kortom, een waarlijk vernederend en ellendig proces waarin je eigenlijk al weet dat je daarginds, waar het ook is dat je naartoe gaat, niet welkom bent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31a2e4ed-410a-35ac-8a47-76ec4499d81d",
                                        "entry_id": "98b970c1-4b27-3d95-b731-ce869af3fac8",
                                        "glosses": [
                                            "geestelijk afgeleid, verstrooid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3795f7-91de-4fcb-adf9-596de4607219",
                                                "sense_id": "31a2e4ed-410a-35ac-8a47-76ec4499d81d",
                                                "text": "Hij was afwezig op de vergadering, want je zag hem indutten."
                                            },
                                            {
                                                "example_id": "cf4edfc4-b56a-4aac-bfaa-251c18eab143",
                                                "sense_id": "31a2e4ed-410a-35ac-8a47-76ec4499d81d",
                                                "text": "Het is prachtig om lekker zen boven op de berg mooie voornemens te maken, maar hoe voer je die in het dagelijkse leven uit? Thuis probeerde ik bijvoorbeeld minder afwezig en met mijn gedachten bij mijn werk te zijn."
                                            },
                                            {
                                                "example_id": "1f1cbf90-4e63-4b64-ac72-8f520e8aa3ee",
                                                "sense_id": "31a2e4ed-410a-35ac-8a47-76ec4499d81d",
                                                "text": "In de ongemakkelijke stilte die er in de kamer hing, keken zij beiden met afwezige blik naar de rug van Jeroen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
