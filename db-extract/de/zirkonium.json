                                                "example_id": "d16f7a3d-4cbd-4e11-b475-2d97ecc2214d",
                                                "sense_id": "429091b2-2fa8-379d-bf36-a00dfbd29921",
                                                "text": "Do you like how I dance? / I've got zirconium pants / Consequential enough / To slip you into a trance"
