                                    {
                                        "sense_id": "025fa516-02aa-3590-be9e-f8aa7a0c309b",
                                        "entry_id": "1cf344e4-2fb0-3462-a6f5-4aa911748c3a",
                                        "glosses": [
                                            "A female spirit, usually taking the form of a woman whose mournful wailing warns of an impending death."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837f3361-36b9-4c64-a137-d478223761e4",
                                                "sense_id": "025fa516-02aa-3590-be9e-f8aa7a0c309b",
                                                "text": "Late had he heard, in prophet's dream, / The fatal Ben-Shie's boding scream […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db4a03c-53dd-3564-9fa1-95a4384b2534",
                                        "entry_id": "1cf344e4-2fb0-3462-a6f5-4aa911748c3a",
                                        "glosses": [
                                            "A noisy or ill-tempered woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beef0ff3-f4e1-4f89-af5f-b29ef906a65e",
                                                "sense_id": "6db4a03c-53dd-3564-9fa1-95a4384b2534",
                                                "text": "Where's this old banshee that runs the place?"
                                            }
                                        ]
                                    }
                                ]
                            }
