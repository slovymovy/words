                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c95df67-423f-4ce6-a2ff-fb44cf66acab",
                        "source_entry_id": "109b3409-48ff-3aed-8b55-458da72777b0",
                        "source_sense_id": "e9e24e73-b908-320a-9daa-cbb0bcd1a4e6",
                        "target_lang_word": "гладь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гладь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cb306d4e-fd29-30b4-a506-fde876be1785",
                                        "entry_id": "8dafe53b-12a4-3639-953e-3e6429816139",
                                        "glosses": [
                                            "ровная гладкая поверхность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c9e5ff-4c16-4b0e-b286-0c0355074c8c",
                                                "sense_id": "cb306d4e-fd29-30b4-a506-fde876be1785",
                                                "text": "Здесь торопливо скользит по глади вод судно, боясь штилей, а с ними и жажды, и голода."
                                            },
                                            {
                                                "example_id": "145d4b1b-645f-4b11-adb0-715543fee240",
                                                "sense_id": "cb306d4e-fd29-30b4-a506-fde876be1785",
                                                "text": "Мы отъехали очень немного от Петербурга, и уже характер местности совсем изменился, — не та гладь и ширь, к которым привык в Петербурге, время от времени появляются лощинки, станции на пригорке и проч."
                                            },
                                            {
                                                "example_id": "eded082c-f892-497c-9fbe-311e03db4010",
                                                "sense_id": "cb306d4e-fd29-30b4-a506-fde876be1785",
                                                "text": "Бег оленьих райд, болота, кочки // И озёр нетронутую гладь // Срифмовать бы в песенные строчки // И потом с любовью распевать!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75ef6180-ad3a-3fba-9ef1-437ff42d17ba",
                                        "entry_id": "8dafe53b-12a4-3639-953e-3e6429816139",
                                        "glosses": [
                                            "перен. полное спокойствие, мир"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4987c637-0d07-4fca-9f19-48ce6af1496e",
                                                "sense_id": "75ef6180-ad3a-3fba-9ef1-437ff42d17ba",
                                                "text": "Всё бы мы стояли там, где сытно да весело; всё бы ходили, когда в небе тишь, а на земле гладь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6907d8-6a40-30af-89ed-7ddf7b7da68d",
                                        "entry_id": "8dafe53b-12a4-3639-953e-3e6429816139",
                                        "glosses": [
                                            "швейн., худ. пр. вышивка плотно прилегающими друг к другу стежками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1836c0b-c475-4702-b1d4-8769c32ab332",
                                                "sense_id": "7d6907d8-6a40-30af-89ed-7ddf7b7da68d",
                                                "text": "Для весенних платьев назначаются материи: шерстяная кисея, затканные кашемиры и мериносы; отделку этих платьев составлять будут оборки, вышитыя гладью несученым шёлком."
                                            }
                                        ]
                                    }
                                ]
                            },
