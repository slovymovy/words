                "translations": [
                    {
                        "translation_id": "6ea14561-f21d-4968-a77c-f2b1df4dcbdf",
                        "source_entry_id": "adefb916-75f3-349e-8cac-3d88cc107cd3",
                        "source_sense_id": "bbaae366-555b-37eb-afad-ab5fca409ad6",
                        "source_sense_description": "jemandem schmeicheln, lobhudeln",
                        "target_lang_word": "schmeicheln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmeicheln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                        "entry_id": "69805829-be78-38cd-9b22-67f55ffe514d",
                                        "glosses": [
                                            "versuchen, jemandem zu gefallen oder jemanden zu beeinflussen, indem man Dinge sagt, die der Andere gern hört, die aber nicht unbedingt der eigenen Meinung entsprechen."
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9bdd820-2cb6-4ba9-943f-6c022e88216b",
                                                "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                                "text": "Sie schmeichelte ihr und bestach sie mit Geschenken; dann wieder war sie verschlossen und kalt. (Wasserman - Olivia oder Die unsichtbare Lampe)"
                                            },
                                            {
                                                "example_id": "272104f3-7c71-46f1-b9c2-2ca99353d617",
                                                "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                                "text": "Das neue Kleid schmeichelt Ullas Figur sehr."
                                            },
                                            {
                                                "example_id": "1cd66dce-670a-4881-953f-8d8e4e2337b8",
                                                "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                                "text": "„Denn Kaschmir ist unendlich weich, leicht, schmeichelt der Haut und ist wie eine sanfte Umarmung, weswegen manche Frauen Kaschmirschals bei Abwesenheit des Liebsten auch gerne als Streichelersatz nutzen.“"
                                            },
                                            {
                                                "example_id": "3d9a280a-bc87-4ca4-948d-c92a65742250",
                                                "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                                "text": "Wir sind ein bisschen spät dran? Das ist noch geschmeichelt würde ich mal sagen. Wir habe satte drei Stunden verloren!"
                                            },
                                            {
                                                "example_id": "af28bc90-0d62-4d22-a2ad-5604ed508ea2",
                                                "sense_id": "7f8d7490-8d8a-3b1d-813e-ba020172c34d",
                                                "text": "Der Fürst fühlte sich durch die vielen Beileidsbezeugungen geschmeichelt.",
                                                "translation": "„Das Licht im Patio war sorgfältig arrangiert, damit es den Damen schmeichelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd1d9470-ca96-4e19-96f0-b1a1706c129b",
                        "source_entry_id": "adefb916-75f3-349e-8cac-3d88cc107cd3",
                        "source_sense_id": "bbaae366-555b-37eb-afad-ab5fca409ad6",
