                    },
                    {
                        "translation_id": "3c6303ea-7940-46d1-b70a-fd852c15845c",
                        "source_entry_id": "c4202e7b-cefb-3380-b196-3a8a0d83c22c",
                        "source_sense_id": "32dfaecc-e717-3d9e-a8a0-836d83518d82",
