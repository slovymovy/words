                ],
                "senses": [
                    {
                        "sense_id": "08261579-86ea-3c2b-b887-221f9eee0d1b",
                        "entry_id": "1f22a1b0-7d69-3c32-b76f-fa3d9aa66a90",
                        "glosses": [
                            "der soziale Vater eines Kindes, der in dem falschen Glauben ist, auch der biologische Vater dieses Kindes zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908ea1c2-cb73-4eba-8e9e-ce3622dedcda",
                                "sense_id": "08261579-86ea-3c2b-b887-221f9eee0d1b",
                                "text": "„Die Anfechtungsfrist beträgt für den Scheinvater zwei Jahre seit Kenntnis der Umstände; die Frist beginnt frühestens mit der Geburt zu laufen […].“"
                            },
                            {
                                "example_id": "5dcfe93f-89ee-4fc5-8ce4-92aa97edd3a0",
                                "sense_id": "08261579-86ea-3c2b-b887-221f9eee0d1b",
                                "text": "„Das Anfechtungsrecht des Kindes ist damit nach dem Willen des Gesetzgebers praktisch auf den Fall beschränkt, daß die Ehe seiner Mutter mit dem Scheinvater nicht mehr besteht oder gescheitert ist (§ 1596 Abs. l Nr. 2 BGB).“"
                            },
                            {
                                "example_id": "54619b43-63f4-403c-8820-e0b04c7bd783",
                                "sense_id": "08261579-86ea-3c2b-b887-221f9eee0d1b",
                                "text": "„Für einen Mann, der unzutreffend seine Vaterschaft anerkannt hat (Scheinvater), eröffnet sich damit die Möglichkeit, später seine Nichtvaterschaft zu ermitteln und damit auch unberechtigte Unterhaltsansprüche abzuwehren. […] Das Ergebnis einer heimlichen DNA-Analyse, die ohne Zustimmung vom Scheinvater veranlasst wurde, darf im Prozeß als Beweismittel nicht zugelassen werden.“"
                            },
                            {
                                "example_id": "29315997-544d-4ff8-82c0-ea6a276c563d",
                                "sense_id": "08261579-86ea-3c2b-b887-221f9eee0d1b",
                                "text": "„Nach einer heftig umstrittenen Entscheidung des BGH sollte der Scheinvater die Ehelichkeit auch dann anfechten können, wenn er sich mit der heterologen Insemination seiner Ehefrau einverstanden erklärt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
