                "senses": [
                    {
                        "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                        "entry_id": "b08bd13c-fa05-3fea-b82f-2da8348bc32c",
                        "glosses": [
                            "das sich aufdringlich Anbiedern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14a14be-e286-4be3-ae45-4c1cf1291d47",
                                "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                                "text": "„Und langsam wird den Jungen klar: Das ganze Herangewanze hat einen tiefen Grund.“"
                            },
                            {
                                "example_id": "197fbf4b-3e59-405a-b107-4bb734dbde0c",
                                "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                                "text": "„Kurzum: Wer sich beim Wahlkampfteam des US-Präsidenten registrieren lässt, bekommt das volle Programm: von selbstmitleidigen Hilferufen, über aufdringliches Herangewanze bis zu aggressive [sic!] Bettelei.“"
                            },
                            {
                                "example_id": "d35dc4b5-bb9d-46b0-855f-eceed35198fe",
                                "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                                "text": "„Das war es, was sie ihren Auftraggebern übermitteln würden, nicht Heinrichs verlogenes Herangewanze.“"
                            },
                            {
                                "example_id": "e1b09afe-efa3-4c4d-839b-02174037a3ce",
                                "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                                "text": "„Witze einer Politikerin auf Kosten einer Minderheit sind daher billig und nichts anders als ein Herangewanze an das angeblich einfache Volk.“"
                            },
                            {
                                "example_id": "a4313eba-caea-44cf-8a88-66a80dd29972",
                                "sense_id": "06df0c5a-cbea-3b76-ab65-b17e0f7c8190",
                                "text": "„Nicht, dass der Verein die Sache nicht so betreiben dürfte, jeder ist seines Glückes Schmied, zur Zielerreichung ja bekanntlich jedes Mittel recht, solange es den Zweck heiligt. Genauso kann man aber das würdelose Herangewanze vieler Herrschaften an den Verein rundweg als schäbig ablehnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
