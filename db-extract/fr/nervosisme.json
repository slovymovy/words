                "entry_id": "a9abb1e4-9b93-3c41-a9cb-c6c5b706efcb",
                "word": "nervosisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86ef5918-5070-4bbe-90e1-2f4d544dd78d",
                        "entry_id": "a9abb1e4-9b93-3c41-a9cb-c6c5b706efcb",
                        "tags": [
                            "plural"
                        ],
                        "form": "nervosismes"
