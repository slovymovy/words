                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0621f43-8033-3afe-89f4-bf0feddcad5b",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "The luggage storage compartment of a sedan/saloon style car."
                                        ],
                                        "tags": [
                                            "South-Asia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8550cdf-6731-4323-a68f-226d43e007e7",
                                                "sense_id": "e0621f43-8033-3afe-89f4-bf0feddcad5b",
                                                "text": "Can you open the dicky for me?"
                                            },
                                            {
                                                "example_id": "028824e7-dcdc-4226-aebc-3c6315ab2bc2",
                                                "sense_id": "e0621f43-8033-3afe-89f4-bf0feddcad5b",
                                                "text": "Back and forth, back and forth, go our mothers on their secret missions, carrying their sinister freight in the dicky of our Morris Minor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c09a69-97a8-3e04-9e39-440acd4fcaf0",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "A leather apron for a gig, etc."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "779d7670-e4a5-3ae2-ab9a-7945b242bf14",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "A small bird; a dicky-bird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d1e2fac-4908-34f9-943a-0fe50127b8bc",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "An insignificant sound or thing; dicky-bird."
                                        ],
                                        "tags": [
                                            "UK",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a563c1de-b219-4875-bf8a-688c33f8aa38",
                                                "sense_id": "7d1e2fac-4908-34f9-943a-0fe50127b8bc",
                                                "text": "Oh, she landed at Heathrow all right, like you said, but since then your Miss Ranelagh seems to have vanished as effectively as my overdue promotion. Not used her credit card, her Internet account, her mobile phone. Nothing. Not a dicky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf90380c-629f-3943-9863-04a59ed50a90",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "A pilot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a9bc265-8e81-320a-91ad-86eeb26a3a0f",
                                        "entry_id": "a259d3e9-b800-3176-9eda-5a36f2c7c27d",
                                        "glosses": [
                                            "A hedge sparrow."
                                        ],
