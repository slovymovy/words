                "senses": [
                    {
                        "sense_id": "a77fb7ff-eac2-3620-9363-c2dae51abb04",
                        "entry_id": "6fb89b04-fa45-3795-b415-b25eba1f3d8c",
                        "glosses": [
                            "falsche, verdrehte Darstellung, Auslegung von Tatsachen (übertrieben positiv oder auch verharmlosend), um jemanden zu täuschen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "7b5fe148-ebcb-4404-9939-fb9962a25d78",
                                "sense_id": "a77fb7ff-eac2-3620-9363-c2dae51abb04",
                                "text": "„An Schmidts Seite stellte sich Ulrike Krischke (Bürgervereinigung): Sie glaube nicht, dass es bei der Bewertung, was unter Ökostrom zu verstehen ist, um Augenauswischerei gehe, sondern um die grundsätzliche Frage: ‚Welche Marktanteile gestehe ich welchem Unternehmen zu.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89a2574d-02d4-4d0e-bf97-97c83dc995b1",
                        "source_entry_id": "6fb89b04-fa45-3795-b415-b25eba1f3d8c",
                        "source_sense_id": "a77fb7ff-eac2-3620-9363-c2dae51abb04",
                        "source_sense_description": "falsche, verdrehte Darstellung, Auslegung von Tatsachen, um jemanden zu täuschen",
                        "target_lang_word": "poudre aux yeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poudre aux yeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                        "entry_id": "920a48ac-980c-38a1-9e59-b853b81b4cee",
                                        "glosses": [
                                            "Apparence flatteuse, mais toujours trompeuse, que l’on donne volontairement pour en cacher une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a20728-73b1-4f00-8ebb-b49a37dc55f2",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "Nous n’en avons qu’une seule à adopter, mon cher monsieur ; c’est de contre-examiner les témoins, de nous fier à l’éloquence de Snubbin, de jeter de la poudre aux yeux des juges, et de nous en rapporter au jury."
                                            },
                                            {
                                                "example_id": "27808929-5a10-49db-9b53-8a1cf4b75bfb",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "Mon vieil instinct d’individualiste me tient lieu de morale. Assez de blagues, de conventions, de poudre aux yeux. L’homme se dresse, les poings serrés."
                                            },
                                            {
                                                "example_id": "31b8f0a2-5b13-4991-8ed0-e8f82e2ce358",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "C’est de nous dire, dans les mots les plus simples et les plus clairs possible, ce qu’il en est. Sans poudre aux yeux ni bullshit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
