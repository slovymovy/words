                        "examples": [
                            {
                                "example_id": "91b69547-bdfa-491e-8f28-b4523b7941cd",
                                "sense_id": "4f787c2e-fe84-3ea8-b10d-0be0ce0ed1fc",
                                "text": "— Кто ты по крови?\n— Я точно не знаю, — живо ответил арестованный, — я не помню моих родителей. Мне говорили, что мой отец был сириец…",
                                "translation": "‘Who are you by blood?’\n‘I don’t know exactly,’ the arrested man replied animatedly, ‘I don’t remember my parents. I was told that my father was a Syrian...’",
                                "english": "‘Who are you by blood?’\n‘I don’t know exactly,’ the arrested man replied animatedly, ‘I don’t remember my parents. I was told that my father was a Syrian...’"
                            }
                        ]
