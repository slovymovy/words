    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                "word": "devilment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d84a5f6f-8ad7-4581-b05f-45f66fb486a7",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "tags": [
                            "plural"
                        ],
                        "form": "devilments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d24d93cb-bbb8-36f4-8bd9-8baca1261cb1",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "glosses": [
                            "Devilish action or conduct; wickedness; (more generally) troublemaking behaviour; mischief; (countable) an instance of this."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "56a2f936-7673-41e2-bcd2-4e3829b1f035",
                                "sense_id": "d24d93cb-bbb8-36f4-8bd9-8baca1261cb1",
                                "text": "He lived so long, and in his worldly matters prospered so much, there was so little sign of devilment in the accomplishment of his wishes, and the increase of his prosperity, that Simon, at the end of six years, began to doubt whether he had made any such bargain at all, as that which we have described at the commencement of this history."
                            },
                            {
                                "example_id": "d2bff7be-2046-4276-b303-e7ff85a8f718",
                                "sense_id": "d24d93cb-bbb8-36f4-8bd9-8baca1261cb1",
                                "text": "It was just so with my Joe—always full of his devilment, and up to every kind of mischief, but he was just as unselfish and kind as he could be—and laws bless me, to think I went and whipped him for taking that cream, never once recollecting that I throwed it out myself because it was sour, and I never to see him again in this world, never, never, never, poor abused boy!"
                            },
                            {
                                "example_id": "6bda19dd-72da-4d82-a1bc-b83fc7b50d6e",
                                "sense_id": "d24d93cb-bbb8-36f4-8bd9-8baca1261cb1",
                                "text": "The stupid fellow hurriedly kissed the portrait, whipped out his knife, quick as lightning removed the miniatures, and substituted two photographs. Closing the case he deposited it carefully on a shelf containing a lot of girls' books and nicknacks. In a moment he was out of the room. Now what did all that mean? Some devilment, I'll be bound, for there was a wicked expression on the scoundrel's face all the while."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f25fa9a-bb51-3dd9-8bb9-a6b3c5718f95",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "glosses": [
                            "A devilish, mischievous, or reckless nature; mischievousness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "032695cf-1e65-35e0-8f4a-24baa3cce610",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "glosses": [
                            "Something cruel or evil; also, something which causes distress or suffering."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3742db8a-dd3c-4896-a105-d1520c1a7216",
                                "sense_id": "032695cf-1e65-35e0-8f4a-24baa3cce610",
                                "text": "Ah, why the divil, Puddock, do you keep them ould women's charrums and divilments, about you—you'll be the death of some one yet, so you will."
                            }
                        ]
                    },
                    {
                        "sense_id": "58e8989d-6241-3b52-ac1e-66b42485c853",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "glosses": [
                            "Something cleverly constructed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea7bf9c1-24e9-329b-80f8-6994f37ab837",
                        "entry_id": "f16900ec-aa8a-3390-83a8-93c65901e89b",
                        "glosses": [
                            "A dish which is devilled (“made piquant or spicy”); a devil; also, the elements of the dish which make it spicy, or the piquancy or spiciness of the dish."
