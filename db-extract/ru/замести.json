                    },
                    {
                        "form_id": "88bee520-2027-4882-a7ee-cab2c06481f5",
                        "entry_id": "22165ab2-e052-35b2-a4db-9fb84eaa97f6",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "заме́тши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b35619eb-0c9f-31fd-ab4c-b0a5ae47fa49",
                        "entry_id": "22165ab2-e052-35b2-a4db-9fb84eaa97f6",
                        "glosses": [
                            "подметая, собрать в одно какое-либо место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf179b9a-9a25-43e1-a04f-049b44acf051",
                                "sense_id": "b35619eb-0c9f-31fd-ab4c-b0a5ae47fa49",
                                "text": "Это откудова это к нам такого красивого дяденьку замело?"
                            }
                        ]
                    },
                    {
                        "sense_id": "40255532-ba5a-39e1-a86a-cd0517721f54",
                        "entry_id": "22165ab2-e052-35b2-a4db-9fb84eaa97f6",
                        "glosses": [
                            "(часто — в безл. предложениях) засы́пать, занести, завалить (снегом, песком и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54fad5d-f7f5-4f30-aeb5-b7f7591d7b88",
                                "sense_id": "40255532-ba5a-39e1-a86a-cd0517721f54",
                                "text": "Поле всё снегом занесло, все проезжие дороги замело: никто не пройдёт, не проедет."
                            },
                            {
                                "example_id": "49ea507f-de56-42bf-97bf-9f80db5f323c",
                                "sense_id": "40255532-ba5a-39e1-a86a-cd0517721f54",
                                "text": "Замела седая вьюга // Поле снежным полотном, // По дороженькам ухабы, // И сугробы под окном."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b6414db-a592-3700-a755-5d1f4b3b654e",
                        "entry_id": "22165ab2-e052-35b2-a4db-9fb84eaa97f6",
                        "glosses": [
                            "жарг. задержать, арестовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732dd77e-51d5-4074-a166-5d9cbabc8673",
                                "sense_id": "7b6414db-a592-3700-a755-5d1f4b3b654e",
                                "text": "А тем временем старушка, узнавшая от соседей, что её кота замели, кинулась бежать в отделение и поспела вовремя."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
