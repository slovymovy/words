                "senses": [
                    {
                        "sense_id": "86612957-a186-3232-bfae-8ce642cb4f18",
                        "entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "glosses": [
                            "abwertend, scherzhaft:"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                        "entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "glosses": [
                            "eiförmiger Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8198ed9-4103-4704-b740-36bb3a0b433c",
                                "sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                                "text": "Ist euch schon mal aufgefallen, dass Paul einen Eierkopf hat?"
                            },
                            {
                                "example_id": "59aa4e00-908a-4744-9eeb-7a9b2f995c20",
                                "sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                                "text": "Stell den Eierkopf vom Platz!"
                            },
                            {
                                "example_id": "20635829-7d18-4216-bc52-22cc9cc2d228",
                                "sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                                "text": "„Der Eierkopf schwieg eine Weile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e3c331d-b9ed-3e7d-b3ca-0d47d135ae11",
                        "entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "glosses": [
                            "Akademiker, Wissenschaftler, Intellektueller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56031862-8dce-419b-8407-77027c283713",
                                "sense_id": "3e3c331d-b9ed-3e7d-b3ca-0d47d135ae11",
                                "text": "„Statt kichernder Mädchen brachte der gelbe Bus Gruppen von ältlichen Eierköpfen aus dem Tal herauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa400d8c-24d0-497c-9a83-222f98da71f8",
                        "source_entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "source_sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                        "source_sense_description": "eiförmiger Kopf",
                        "target_lang_word": "egghead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egghead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b12b3d08-51b7-3a60-8f62-181575a8770b",
                                        "entry_id": "4ff6f973-474d-3dff-ba0f-ff311cfd1f00",
                                        "glosses": [
                                            "A bald person, especially a man."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c0f15fe-6684-4013-86d7-c2eff06f9aea",
                                                "sense_id": "b12b3d08-51b7-3a60-8f62-181575a8770b",
                                                "text": "Then no one will know whether you are a genuine egghead or not. Besides, completely bald men are more sensual."
                                            },
                                            {
                                                "example_id": "d9dc640f-b583-45a5-bd97-c4391e9b1b4c",
                                                "sense_id": "b12b3d08-51b7-3a60-8f62-181575a8770b",
                                                "text": "His own image as a bald man - egghead - with glasses aids this perception."
                                            },
                                            {
                                                "example_id": "0bf2de53-29c9-418a-8617-05c3842ac690",
                                                "sense_id": "b12b3d08-51b7-3a60-8f62-181575a8770b",
                                                "text": "Contemporaries remembered him, for instance, as an egghead, bald as a billiard ball, and an “obese Napoleon.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f67b71-98ab-35c8-bbab-993f08d33ecd",
                                        "entry_id": "4ff6f973-474d-3dff-ba0f-ff311cfd1f00",
                                        "glosses": [
                                            "A bald head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a6f294-4c8a-49ac-963a-9bfb309ec6bc",
                                                "sense_id": "49f67b71-98ab-35c8-bbab-993f08d33ecd",
                                                "text": "But at the top of the \"egghead\", the blood vessels become pinched and the flow is blocked."
                                            },
                                            {
                                                "example_id": "4bce79a7-9bfc-4e3c-95c3-84a1b7e39d25",
                                                "sense_id": "49f67b71-98ab-35c8-bbab-993f08d33ecd",
                                                "text": "At one point he even lifts his cap to reveal an egghead bald-cap atop white hair and spectacles."
                                            },
                                            {
                                                "example_id": "14eb35d2-dbda-435e-9ee5-2729d4bd2853",
                                                "sense_id": "49f67b71-98ab-35c8-bbab-993f08d33ecd",
                                                "text": "Many shave their entire head at the first sign of hair loss, believing that chicks prefer an egghead to a comb-over."
                                            },
                                            {
                                                "example_id": "4ee5eb5e-0603-4ba1-9083-b84877471f87",
                                                "sense_id": "49f67b71-98ab-35c8-bbab-993f08d33ecd",
                                                "text": "His shoulders were so misshapen they almost met over his sunken chest and they were topped by a pointy egghead, bald but for a few short sproutings of hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca76a202-6d84-37a4-abde-44d3c59545ee",
                                        "entry_id": "4ff6f973-474d-3dff-ba0f-ff311cfd1f00",
                                        "glosses": [
                                            "An intellectual, especially one who is insensitive, pedantic, or out of touch."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad646782-8d6f-43aa-871a-2106933373e3",
                                                "sense_id": "ca76a202-6d84-37a4-abde-44d3c59545ee",
                                                "text": "Just because some of you eggheads spend half your life in college don't mean you've got any monopoly on good common sense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb139d7-03ce-41c9-abf0-d424ab4540f6",
                        "source_entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "source_sense_id": "84e66a63-6ebe-3734-96bf-595e1ea82f94",
                        "source_sense_description": "eiförmiger Kopf",
                        "target_lang_word": "tête en forme d’œuf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a9a6d2f8-e4ba-43cf-952c-5dca86f81167",
                        "source_entry_id": "ca9ad07a-9fd9-3097-bbf9-77922dfd47ea",
                        "source_sense_id": "3e3c331d-b9ed-3e7d-b3ca-0d47d135ae11",
                        "source_sense_description": "Akademiker, Wissenschaftler, Intellektueller",
                        "target_lang_word": "intello",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intello",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efb87890-ab95-3316-9a02-c3a151877f47",
                                        "entry_id": "2cb0bc6b-1e85-3c0e-b63d-6e7c3a620cfc",
                                        "glosses": [
                                            "Qui appartient à l’intellect, aux activités de l’esprit, par opposition à matériel ou manuel."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edfbde3d-50b4-4d7d-82f8-e34a08f8d2d6",
                                                "sense_id": "efb87890-ab95-3316-9a02-c3a151877f47",
                                                "text": "L’idée de concept est importante chez les New-Yorkais. Rollins, Monk, Roach, Bud : modernes et classiques en même temps, plus intellos que gros déconneurs."
                                            },
                                            {
                                                "example_id": "292bf573-71ab-4593-babc-4b35b03e038f",
                                                "sense_id": "efb87890-ab95-3316-9a02-c3a151877f47",
                                                "text": "Et puis, je te dis, elle est fascinée par ton côté très intello. Ça se voit que c'est une fille très « bourge », de bonne famille, d'aristocrate qui n'a de passion que pour les bouquins, la comédie, l'opéra et la vie de châteaux."
                                            },
                                            {
                                                "example_id": "524ec26b-304b-4716-897e-32bdc0fc1500",
                                                "sense_id": "efb87890-ab95-3316-9a02-c3a151877f47",
                                                "text": "Et c'est quoi tous ces bouquins ? C'est ton côté intello ? Remarque, pour faire le boulot que tu fais, faut être un brin intello, ou maso... ou simplement voyeur."
                                            },
                                            {
                                                "example_id": "c462e1ab-ecbf-4d63-af10-b86b18243d5c",
                                                "sense_id": "efb87890-ab95-3316-9a02-c3a151877f47",
                                                "text": "Elle avait pris l'habitude de m'inviter aux avant-premières de films d'action, de polar ou d'autres trucs qui pouvaient me plaire. Elle savait que les films intello où les acteurs se pignolent pendant deux heures sans que le spectateur comprenne rien, c'était pas mon truc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intello",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                        "entry_id": "8aac23a8-1bbe-30f1-93d8-3844e17ff694",
                                        "glosses": [
                                            "Personne qui s’adonne, professionnellement ou par goût, aux activités intellectuelles."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc53e0b-bc5d-4442-a65c-89621d4a07e5",
                                                "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                                "text": "Et quand ils venaient le vendredi ou le samedi soir, il empilait ses livres de politique sur le bureau et faisait semblant de travailler. Il voulait avoir l’air d’un intello, pas d’un laissé-pour-compte."
                                            },
                                            {
                                                "example_id": "6bf33bd3-ec1c-4f65-9d4d-d4a633f7624e",
                                                "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                                "text": "Archie en a vu, tout au long de sa vie, des nénettes comme ci et des nénettes comme ça, des artistes, des intellos, des philosophes, des politiques, des syndicalistes, des sculpteures, des actrices, des écrivaines […]."
                                            },
                                            {
                                                "example_id": "251f8505-ce9f-4530-ac2a-17f570e70b42",
                                                "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                                "text": "Il fait partie des intellos, mais il est tellement coincé que même la bande des intellos préfère ne pas être vue en sa compagnie."
                                            },
                                            {
                                                "example_id": "cac6457b-925a-4e64-8df6-1e90c92c9816",
                                                "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                                "text": "Çà et là quelques intellos tombés de leur lit parcouraient la presse pour intellos du weekend."
                                            },
                                            {
                                                "example_id": "54bf27db-de54-4017-b351-ce78635eb2a2",
                                                "sense_id": "fe2fcee1-a590-3d9e-9226-fa8c39b7d66a",
                                                "text": "Prenons cette scène prodigieuse des Femmes savantes. Elle met en scène deux littérateurs, deux intellos bas de gamme : Vadius et Trissotin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
