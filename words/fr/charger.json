                        "être chargé de"
                    ]
                },
                {
                    "sense_id": "bf9ee472-6462-3e15-8923-f6107f8d3a68",
                    "sense_definition": "Prendre la responsabilité d'une tâche, s'occuper de quelque chose ou de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour les réservations, je m'en <w>charge</w> tout de suite."
                        },
                        {
                            "text": "Elle s'est <w>chargée</w> de préparer le dîner pour tous les invités."
                        }
                    ],
                    "synonyms": [
                        "assumer",
                        "s'occuper de"
                    ],
                    "antonyms": [
                        "déléguer"
                    ],
                    "common_phrases": [
