                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec9c5fa-3be3-4ffc-ad4c-5ebd9398b59f",
                                                "sense_id": "e9a38f6c-ccd8-398e-85ea-d833e81babb9",
                                                "text": "Wir können ja den alten Wagenheber entfremden und hier fest einbauen, um die Spannung justieren zu können."
                                            },
