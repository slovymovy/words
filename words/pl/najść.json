{
    "word_family": [
        "nachodzić",
        "najście",
        "nachodzenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "599dfa0c-425c-3948-ad4d-3135112e5168",
                    "sense_definition": "wtargnąć na czyjeś terytorium lub do czyjegoś domu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wrogie wojska <w>najdą</w> na nasze granice jeszcze przed świtem.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска <w>вторгнутся</w> к нашим границам ещё до рассвета."
                            }
                        },
                        {
                            "text": "Nieproszony gość <w>najdzie</w> na prywatną posesję bez żadnego ostrzeżenia.",
                            "target_lang_translations": {
                                "ru": "Незваный гость <w>вторгнется</w> на частную территорию безо всякого предупреждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "najechać",
                        "napaść"
                    ],
                    "common_phrases": [
                        "najść na teren"
                    ],
                    "target_lang_definitions": {
                        "ru": "вторгнуться на чью-либо территорию или в чей-либо дом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторгнуться",
                                "target_lang_sense_clarification": "о вторжении на территорию, в дом, во владения"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "о нападении или вражеском вторжении"
                            },
                            {
                                "target_lang_word": "захватить",
                                "target_lang_sense_clarification": "о военном или силовом заходе на чужую территорию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10435c22-61df-3959-86a3-d9b5f995a3e1",
                    "sense_definition": "pojawić się niespodziewanie w czyimś miejscu, zakłócając spokój",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiedzi <w>najdą</w> nas w domu, jeśli nie zamkniemy drzwi na klucz.",
                            "target_lang_translations": {
                                "ru": "Соседи <w>нагрянут</w> к нам домой, если мы не запрём дверь на ключ."
                            }
                        },
                        {
                            "text": "Nie chcę, żeby ktoś <w>najdzie</w> mnie w trakcie pracy.",
                            "target_lang_translations": {
                                "ru": "Я не хочу, чтобы кто-нибудь <w>нагрянул</w> ко мне во время работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "nawiedzić"
                    ],
                    "common_phrases": [
                        "najść kogoś"
                    ],
                    "target_lang_definitions": {
                        "ru": "неожиданно появиться у кого-либо, нарушая покой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагрянуть",
                                "target_lang_sense_clarification": "неожиданно прийти к кому-то, нарушив покой"
                            },
                            {
                                "target_lang_word": "заявиться",
                                "target_lang_sense_clarification": "внезапно явиться к кому-то"
                            },
                            {
                                "target_lang_word": "явиться",
                                "target_lang_sense_clarification": "непрошено прийти, нарушая чужое уединение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea72f5f8-4bd9-3437-a250-78024972eb8d",
                    "sense_definition": "często odwiedzać kogoś w sposób uciążliwy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Komornik <w>najdzie</w> dłużnika, dopóki ten nie spłaci wszystkich zaległości.",
                            "target_lang_translations": {
                                "ru": "Судебный пристав будет <w>донимать</w> должника, пока тот не погасит всю задолженность."
                            }
                        },
                        {
                            "text": "Dziennikarze <w>najdą</w> celebrytę, szukając sensacyjnych informacji.",
                            "target_lang_translations": {
                                "ru": "Журналисты будут <w>донимать</w> знаменитость в поисках сенсационной информации."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "часто навещать кого-либо назойливым, тягостным образом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "часто и назойливо посещать или преследовать визитами"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "надоедать постоянными посещениями"
                            },
                            {
                                "target_lang_word": "осаждать",
                                "target_lang_sense_clarification": "преследовать, не давать покоя частыми визитами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e634935-b19a-3082-92cc-67d5374f24ee",
                    "sense_definition": "zebrać się w jednym miejscu w dużej liczbie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tłumy ludzi <w>najdą</w> na główny plac miasta podczas święta.",
                            "target_lang_translations": {
                                "ru": "Во время праздника толпы людей <w>соберутся</w> на главной городской площади."
                            }
                        },
                        {
                            "text": "Wszyscy goście <w>najdą</w> się w sali balowej przed rozpoczęciem koncertu.",
                            "target_lang_translations": {
                                "ru": "Все гости <w>соберутся</w> в бальном зале перед началом концерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "zebrać się",
                        "zgromadzić się"
                    ],
                    "common_phrases": [
                        "najść się tłumnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "собраться в одном месте в большом количестве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собраться",
                                "target_lang_sense_clarification": "о множестве людей: собраться в одном месте"
                            },
                            {
                                "target_lang_word": "стечься",
                                "target_lang_sense_clarification": "скопиться, сойтись в большом количестве"
                            },
                            {
                                "target_lang_word": "сгрудиться",
                                "target_lang_sense_clarification": "образовать большое скопление в одном месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "350f21de-77b1-3016-8bc5-81d74b6cfb4d",
                    "sense_definition": "aspekt dokonany od czasownika <w>nachodzić</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To jest forma dokonana, która oznacza, że czynność <w>najść</w> została zakończona.",
                            "target_lang_translations": {
                                "ru": "Это совершенная форма, которая означает, что действие <w>завершилось</w>."
                            }
                        },
                        {
                            "text": "W języku polskim <w>najść</w> to odpowiednik dokonany dla czasownika niedokonanego.",
                            "target_lang_translations": {
                                "ru": "В польском языке <w>najść</w> — это совершенный коррелят несовершенного глагола."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола «nachodzić»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенный вид",
                                "target_lang_sense_clarification": "грамматически: совершенный вид к глаголу nachodzić"
                            },
                            {
                                "target_lang_word": "перфектив",
                                "target_lang_sense_clarification": "видовая пара в польском языке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fcd0fb4-3d33-3351-a9d9-357ed5035c96",
                    "sense_definition": "aspekt dokonany od czasownika <w>nachodzić</w> się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czasownik <w>najść</w> się jest formą dokonaną od czasownika zwrotnego.",
                            "target_lang_translations": {
                                "ru": "Глагол <w>найтись</w> здесь является совершенной формой возвратного глагола."
                            }
                        },
                        {
                            "text": "Używamy <w>najść</w> się, gdy chcemy podkreślić zakończenie procesu gromadzenia się.",
                            "target_lang_translations": {
                                "ru": "Мы употребляем форму <w>собраться</w>, когда хотим подчеркнуть завершение процесса собирания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола «nachodzić się»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенный вид",
                                "target_lang_sense_clarification": "грамматически: совершенный вид возвратного глагола nachodzić się"
                            },
                            {
                                "target_lang_word": "перфектив",
                                "target_lang_sense_clarification": "видовая форма возвратного глагола"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}