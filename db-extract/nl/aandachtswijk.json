                        "sense_id": "d0e3d26f-705b-393c-a695-31dfbbbf54d8",
                        "entry_id": "5e14952f-5fd8-34dc-aee2-dbb1f8c8bbfd",
                        "glosses": [
                            "deel van een stad waar veel mensen met sociale, psychische en financiële problemen wonen"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "c50a71ab-1a4b-4843-aa74-09f1872c264f",
                                "sense_id": "d0e3d26f-705b-393c-a695-31dfbbbf54d8",
                                "text": "De wijk Schreurserve (die onder Ribbelt/Stokhorst valt) is een aandachtswijk waar kinderen weinig perpectief hebben."
                            },
                            {
                                "example_id": "cf74c36a-0528-4133-afe5-4232b1d26bb5",
                                "sense_id": "d0e3d26f-705b-393c-a695-31dfbbbf54d8",
                                "text": "De Sport Mobiel was onderdeel van het project Buurt, Onderwijs Sport (BOS) dat de afgelopen vier jaren in de Ossenkoppelerhoek/ Nieuwstraatkwartier heeft gedraaid. Dat inmiddels beëindigde project, grotendeels gefinancierd door het ministerie van Volksgezondheid, Welzijn en Sport en uitgevoerd door verschillende instanties, was bedoeld om kinderen in de genoemde Almelose aandachtswijk tot meer bewegen en meer gezond eten aan te zetten."
                            },
                            {
                                "example_id": "0fa21c3d-eec9-4c2a-b6b9-1105c661f557",
                                "sense_id": "d0e3d26f-705b-393c-a695-31dfbbbf54d8",
                                "text": "Het gaat inmiddels zo goed met de wijk Kruiskamp in Amersfoort dat die niet langer het etiket aandachtswijk nodig heeft. Dat maakte minister Liesbeth Spies (Binnenlandse Zaken) vandaag bekend."
                            }
                        ]
                    }
