                "senses": [
                    {
                        "sense_id": "d18a1042-6850-309d-a0b4-0d2aec2230d5",
                        "entry_id": "96e1503c-3483-3b91-8b63-680dce55014c",
                        "glosses": [
                            "Torte mit Sahnefüllung und einer äußeren Sahnebeschichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be81c0c3-012b-4791-b949-367d0d9fa037",
                                "sense_id": "d18a1042-6850-309d-a0b4-0d2aec2230d5",
                                "text": "„Kanther winkte ihm zu, während er ein Stück Sahnetorte in sich hineinstopfte.“"
                            },
                            {
                                "example_id": "5ebe0be8-e011-432a-948f-dfc63f95f3b4",
                                "sense_id": "d18a1042-6850-309d-a0b4-0d2aec2230d5",
                                "text": "„In Deutschland gilt Unterhaltungskultur immer noch als etwas Schmuddelig-Billiges, von dem alle annehmen, das drehe sich mit einer Blondine, einer Banane und einer Sahnetorte praktisch von selbst.“"
                            },
                            {
                                "example_id": "208edcef-85ed-42ab-a1da-dcbc32c230c3",
                                "sense_id": "d18a1042-6850-309d-a0b4-0d2aec2230d5",
                                "text": "„Therese kam mit dem iPad in die Küche, sie hatte große Kopfhörer auf, öffnete die Kühlschranktür und nahm einen Rest Sahnetorte heraus, lud ihn auf einen Teller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea3f2bc3-698e-4a58-8302-4ff1b9abd329",
                        "source_entry_id": "96e1503c-3483-3b91-8b63-680dce55014c",
                        "source_sense_id": "d18a1042-6850-309d-a0b4-0d2aec2230d5",
                        "source_sense_description": "Torte mit Sahnefüllung und einer äußeren Sahnebeschichtung",
                        "target_lang_word": "tarte à la crème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarte à la crème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71f6bae5-cb3c-3ce9-a504-e9beae204bb8",
                                        "entry_id": "44ad8c9f-068c-3297-90a3-020c466b71a4",
                                        "glosses": [
                                            "Tarte garnie de crème fouettée ou de crème pâtissière servant, outre à régaler les gourmands, à entarter de grands noms médiatiques avides de notoriété."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0061dc-b3ab-4106-a11d-c7c2223acd1e",
                                                "sense_id": "71f6bae5-cb3c-3ce9-a504-e9beae204bb8",
                                                "text": "La tarte à la crème de Pithiviers."
                                            },
                                            {
                                                "example_id": "3df2f3eb-8899-46e9-b550-ff6a6230b49e",
                                                "sense_id": "71f6bae5-cb3c-3ce9-a504-e9beae204bb8",
                                                "text": ": leur goût savoureux n’[a] besoin d’aucune démonstration, car suivant le proverbe anglais [M. Lénine cite un proverbe que je ne connais pas'\"The proof of the pudding is in the eating\"'] : « La meilleure preuve que les tartes à la crème sont bonnes, c’est que tout le monde les mange ... » Tous les peuples mangent et mangeront, de plus en plus, la tarte socialiste…"
                                            },
                                            {
                                                "example_id": "353bfbe8-315e-47a3-8097-9330665e2c0c",
                                                "sense_id": "71f6bae5-cb3c-3ce9-a504-e9beae204bb8",
                                                "text": "On sait depuis l’entartage de Royal et Sarkozy que la tarte à la crème est devenue une arme par destination. (Blogue)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32322b82-7c0c-3bc0-a29b-4cdd491e1e33",
                                        "entry_id": "44ad8c9f-068c-3297-90a3-020c466b71a4",
                                        "glosses": [
                                            "Réponse de Molière aux critiques qui lui reprochaient le prosaïsme de sa comédie L’École des femmes, en faisant répéter par le spectateur difficile de La Critique (1663) la niaiserie d’Arnolphe, dans le but de mettre les rieurs de son côté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f055afc-6395-411f-b915-20df87565a3c",
                                                "sense_id": "32322b82-7c0c-3bc0-a29b-4cdd491e1e33",
                                                "text": "Et, s’il faut qu’avec elle on joue au corbillon,\nEt qu’on vienne à lui dire à son tour, qu’y met-on ?\nJe veux qu’elle réponde : « une tarte à la crème »."
                                            },
                                            {
                                                "example_id": "97b68d52-0a2d-486c-9e58-3ac84f21d89c",
                                                "sense_id": "32322b82-7c0c-3bc0-a29b-4cdd491e1e33",
                                                "text": "Le Marquis\nAh ! ma foi oui, tarte à la crème ! Voilà ce que j’avais remarqué tantôt ; tarte à la crème ! Que je vous suis obligé, madame, de m’avoir fait souvenir de tarte à la crème ! Y a-t-il assez de pommes en Normandie pour tarte à la crème ? Tarte à la crème, morbleu ! tarte à la crème."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                        "entry_id": "44ad8c9f-068c-3297-90a3-020c466b71a4",
                                        "glosses": [
                                            "(Sens courant) Cliché, idée reçue. Thème rebattu, sujet ramené sur le tapis de façon fatigante ; poncif, marronnier, thème martelé par les médias, inlassablement répété par les journalistes et leurs invités, sans jamais rien apporter de nouveau."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9842b95-9ae3-4c46-a732-1a4d0d804c61",
                                                "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                                "text": "26 décembre 1940 – L’après-midi se traîne : les petits jouent un morceau au piano ou disent un compliment qui est une ignoble tarte à la crème sur le cœur des mères qu’il ne faut pas briser."
                                            },
                                            {
                                                "example_id": "dfdb759d-c3e9-4cb2-85e6-45c210771fdf",
                                                "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                                "text": "Les souvenirs sont des tartes à la crème, certes, mais celles d’Havrecourt fleurent la frangipane et sont réellement d’énormes disques de pâte où la tante dessinait des fleurs à l’aide de fruits découpés."
                                            },
                                            {
                                                "example_id": "830dfd36-a8b4-4302-a386-0ffadb1939d7",
                                                "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                                "text": "Si l’on insiste ici sur les mérites d’un homme politique honteusement méconnu dans son propre pays — mais non pas à l’étranger —, c’est qu’il fut le véritable père fondateur d’une Europe devenue entre-temps la tarte à la crème de tous les discours."
                                            },
                                            {
                                                "example_id": "3e180104-6eaf-4e8f-9f5b-afe6bbf22a39",
                                                "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                                "text": "« Au niveau » est certes déjà une vieille connaissance, et même une vieille tarte à la crème, puisque l’expression fit irruption dans l’univers branchouillard voilà une bonne vingtaine d’années."
                                            },
                                            {
                                                "example_id": "a1ef7a08-6cc9-4b77-8534-e7b14a833a6d",
                                                "sense_id": "ba3f66da-8be1-3422-8762-df627f424507",
                                                "text": "Ces reportages, c’est toujours la même chose : des soldats, des curés et l’homme de la rue, ce fameux homme de la rue, serpent de mer et tarte à la crème des journalistes en mal de copie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tarte à la crème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70d1de13-beca-3737-9347-4a85695d1ea4",
                                        "entry_id": "853d5a8d-6c1c-3669-a81b-ae3d18fb0c80",
                                        "glosses": [
                                            "Banal, commun, cliché, éculé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4703312-35e3-47cd-b99c-0fb8f587147e",
                                                "sense_id": "70d1de13-beca-3737-9347-4a85695d1ea4",
                                                "text": "L’abus médiatique du thème tarte à la crème du réchauffement global…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
