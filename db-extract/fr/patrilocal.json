                                        "entry_id": "8f08313a-c81c-3437-8622-8aa83e608cc4",
                                        "glosses": [
                                            "In which newly married couples live with the husband's family."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d60617f-1662-42ee-bcbf-9a0dedba82e3",
                                                "sense_id": "c2411242-63ae-395a-b599-91eeed184235",
                                                "text": "In barring the way, he is enacting a ritual which demands that the new way of patrilocal marriage pay its respect to the more ancient way of matrilocal marriage."
                                            }
                                        ]
                                    }
