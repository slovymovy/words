                "translations": [
                    {
                        "translation_id": "f52e4039-7a22-453c-b1fa-5c92cf74cee8",
                        "source_entry_id": "584faed5-f685-3f25-a777-b47e7f5524b8",
                        "source_sense_id": "9d1f137e-839e-39ac-b09d-e08ec12f90e7",
                        "target_lang_word": "Transkription",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transkription",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96491518-4bfe-319b-a5e6-3ebb48ae5cbf",
                                        "entry_id": "f875753f-306f-3aed-bfc9-2057216f9006",
                                        "glosses": [
                                            "Wiedergabe der Aussprache sprachlicher Einheiten mit phonetischen oder phonologischen Schriftzeichen; der Begriff wird oft nur im Sinne von phonetische Transkription aufgefasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f5dae4-8480-48f6-8359-e5e7084b2734",
                                                "sense_id": "96491518-4bfe-319b-a5e6-3ebb48ae5cbf",
                                                "text": "Die phonetische Transkription des Satzes \"Die Schule ist gelb angemalt\" sieht so aus: [diː ˈʃuːlə ʔɪst gɛlp ˈʔangəmaːlt]."
                                            },
                                            {
                                                "example_id": "d7b4541f-ae12-44ac-a6fc-0a56d77bf146",
                                                "sense_id": "96491518-4bfe-319b-a5e6-3ebb48ae5cbf",
                                                "text": "„Ein Vergleich der Überschrift und der Transkription der ersten beiden Sätze mit dem Schriftbild macht schlagartig klar, welche Vielzahl von Ausspracheproblemen sich beim Erlernen des Dänischen durch Deutsche einstellen werden (…).“"
                                            },
                                            {
                                                "example_id": "5e67d851-ad8d-422a-be8d-367f114edd02",
                                                "sense_id": "96491518-4bfe-319b-a5e6-3ebb48ae5cbf",
                                                "text": "„Mittels Transkription, Kartierung und Vergleich der einzelnen Sprachproben konnten bis jetzt umfassende Ergebnisse gewonnen werden – auch wenn der Abschluss des Projektes erst für 2021 geplant ist.“"
                                            },
                                            {
                                                "example_id": "070c0808-e8e5-42a7-881d-73bc91e27505",
                                                "sense_id": "96491518-4bfe-319b-a5e6-3ebb48ae5cbf",
                                                "text": "„Natürlich brauchen wir die Phonetik trotzdem, denn sie kann uns nicht nur einen Überblick über die von Menschen produzierbaren Laute geben, sondern phonetische Transkriptionen liefern uns gewöhnlich auch den besten Zugang zu einer unbekannten Sprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cae9aff-3c1c-3385-9a3d-a6e2fb97ad85",
                                        "entry_id": "f875753f-306f-3aed-bfc9-2057216f9006",
                                        "glosses": [
                                            "Wiedergabe eines Textes, der in einer anderen Schrift verfasst ist, in lateinischer Schrift oder umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f95171e2-6b94-4391-b0fc-c13c7ac95948",
                                                "sense_id": "7cae9aff-3c1c-3385-9a3d-a6e2fb97ad85",
                                                "text": "Die Wiedergabe z. B. eines griechischen oder russischen Wortes (oder Textes) in lateinischer Schrift (oder umgekehrt) wird ebenfalls oft als Transkription bezeichnet. Wenn diese Umschrift in beiden Richtungen eindeutig ist, spricht man von Transliteration."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82f5124c-ab1f-33be-8921-e8bd43a961e9",
                                        "entry_id": "f875753f-306f-3aed-bfc9-2057216f9006",
                                        "glosses": [
                                            "das Umschreiben eines Gens der DNA (Desoxyribonukleinsäure) in eine RNA (Ribonukleinsäure)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee6503c-3c6b-4cbb-b55a-ced6f8200443",
                                                "sense_id": "82f5124c-ab1f-33be-8921-e8bd43a961e9",
                                                "text": "Die Transkription der DNA findet im Zellkern statt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "265a37ad-421d-4b19-8798-16ea72e75f19",
                        "source_entry_id": "584faed5-f685-3f25-a777-b47e7f5524b8",
