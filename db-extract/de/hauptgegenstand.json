                "senses": [
                    {
                        "sense_id": "6f5e650c-4fdf-37bc-b608-fbbc16a572da",
                        "entry_id": "8705a453-0dac-3a72-bdc6-9d68ad72beb0",
                        "glosses": [
                            "zentrales Thema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ca8e5e-01b7-4c59-a67a-775f2a15b895",
                                "sense_id": "6f5e650c-4fdf-37bc-b608-fbbc16a572da",
                                "text": "„Die Lohnforderung der Gewerkschaften war nach Angaben aus Verhandlungskreisen noch nicht Hauptgegenstand der Gespräche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c77eb1dd-c39b-3c74-b9e7-4c4c2ea6597b",
                        "entry_id": "8705a453-0dac-3a72-bdc6-9d68ad72beb0",
                        "glosses": [
                            "als wichtig angesehenes Schulfach"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "1a9f1cc3-6a7d-420c-ae55-dd61e1e5db8d",
                                "sense_id": "c77eb1dd-c39b-3c74-b9e7-4c4c2ea6597b",
                                "text": "„Hauptgegenstände waren außerdem Religion, Rhetorik und Poetik, wogegen Geschichte, Geographie, Naturkunde, Mathematik und andere als Nebengegenstände bezeichnet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
