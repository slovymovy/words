                    {
                        "sense_id": "12dddad3-cb0f-3161-9171-2f5a8422ab77",
                        "entry_id": "84bec20f-2120-3b0f-993b-dc0efe88aaa1",
                        "glosses": [
                            "een bak waarin men afval kan doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a37ce1-a259-4d01-af02-4040003c4006",
                                "sense_id": "12dddad3-cb0f-3161-9171-2f5a8422ab77",
                                "text": "Later, na het opbaren, zouden de eigenaars van die handen hun latex handschoenen afstropen en in een met een hemelsblauwe vuilniszak beklede afvalemmer werpen, zoals een hoer zich op de afwerkplek van gebruikte condooms ontdoet."
                            },
                            {
                                "example_id": "3bec9e41-0f86-4e8a-b5e6-79bc1e097fb7",
                                "sense_id": "12dddad3-cb0f-3161-9171-2f5a8422ab77",
                                "text": "Plastic handschoenen mogen niet in de afvalemmer voor plastic"
                            }
                        ]
                    }
                ],
