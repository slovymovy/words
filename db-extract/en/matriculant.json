                "senses": [
                    {
                        "sense_id": "78c8caac-9196-32c3-8ad8-3ea3d0278710",
                        "entry_id": "152f0544-b3e6-3075-a777-8408db60460d",
                        "glosses": [
                            "A person who has matriculated or been registered on a list or roll, usually at a school."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "874dfded-b5ae-4f1d-a852-6452a3ed7e28",
                                "sense_id": "78c8caac-9196-32c3-8ad8-3ea3d0278710",
                                "text": "There were herds of leather sofas and enough computers to ensure that no prospective matriculant or visiting parent could enter a room and not see at least one available keyboard, not even in the dining hall or field house."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec660b05-42eb-4dfc-9d7a-2a656e561a37",
                        "source_entry_id": "152f0544-b3e6-3075-a777-8408db60460d",
                        "source_sense_id": "78c8caac-9196-32c3-8ad8-3ea3d0278710",
                        "source_sense_description": "one who has matriculated or been registered on a list or roll",
                        "target_lang_word": "Abiturient",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiturient",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                        "entry_id": "b331c586-4178-391a-be9a-d8e40a617c56",
                                        "glosses": [
                                            "ein Schüler, der das Abitur absolviert oder bereits absolviert hat"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8fedb3-fbf8-459d-b7ce-9b170027f099",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "Viele Abiturienten entschließen sich, ihre Ausbildung mit einem Studium fortzusetzen."
                                            },
                                            {
                                                "example_id": "6cff8622-a38b-4216-9aa5-919a2b67c6e4",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Der Abiturient kann's nicht mehr hören.“"
                                            },
                                            {
                                                "example_id": "3733dec8-2ca1-47f7-a77b-8efeab030fb6",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Jedes Jahr, wenn die Arbeiter ihren 1. Mai feiern, feiern auch die Abiturienten wieder ihren Schulabschluss.“"
                                            },
                                            {
                                                "example_id": "6dc66fbe-ac0c-43f4-9819-d65c823afb6a",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Für Abiturienten gilt meistens noch die Sonderregelung, daß sie bis zum sechsten Semester neben den üblichen Praktika eine sechswöchige fachpraktische Ausbildung nachweisen müssen.“"
                                            },
                                            {
                                                "example_id": "4725cb27-1cfd-4afa-9e6b-7f864582959b",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Je älter und selbständiger der Abiturient wird, desto mehr kann er am öffentlichen Lebens Frankfurts teilnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c615bc1d-8288-4496-abeb-d8d123a40595",
                        "source_entry_id": "152f0544-b3e6-3075-a777-8408db60460d",
                        "source_sense_id": "78c8caac-9196-32c3-8ad8-3ea3d0278710",
                        "source_sense_description": "one who has matriculated or been registered on a list or roll",
                        "target_lang_word": "Abiturientin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiturientin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                        "entry_id": "ba4d48cd-0702-398f-9147-e424495a1b2f",
                                        "glosses": [
                                            "Schülerin, die ihr Abitur ablegt oder bereits abgelegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8021543f-5ce7-477d-902b-2a51ab5d0540",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Uns fehlen auch Frauen in den technischen Studiengängen und Berufen. Das liegt unter anderem daran, dass den Abiturientinnen Vorbilder fehlen, die sie für einen solchen Weg begeistern.“"
                                            },
                                            {
                                                "example_id": "5ccb45e1-993c-41dd-90b2-898c52facc34",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Eine Abiturientin aus Lyck hat ihre bitteren Erlebnisse auf der Flucht beschrieben, das Leid, den Hunger, die Entbehrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adf7b10f-cb0d-46a7-8b0d-5e3447fae98d",
                        "source_entry_id": "152f0544-b3e6-3075-a777-8408db60460d",
                        "source_sense_id": "78c8caac-9196-32c3-8ad8-3ea3d0278710",
                        "source_sense_description": "one who has matriculated or been registered on a list or roll",
