                        "glosses": [
                            "Que l’on peut investir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e6c7f8-26fd-4362-97f6-0fecfe5619ad",
                                "sense_id": "a70c0136-b357-3ca9-9c7c-f2181eb44e06",
                                "text": "Or, la relation entre le niveau du salaire industriel et le niveau du surplus investissable n’est pas aussi figée que ne l’entend Lewis."
                            },
                            {
                                "example_id": "3418d6e2-6552-4647-b92e-a9b52ae4d103",
                                "sense_id": "a70c0136-b357-3ca9-9c7c-f2181eb44e06",
                                "text": "Le psychotique est confronté à l’impossibilité de constituer et d’investir des idéaux parce qu’il ne peut investir aucune potentialité dans son Je actuel qui l’assurerait d’un futur possible et investissable."
                            },
                            {
                                "example_id": "1db016d6-a59f-4917-8617-218386962d76",
                                "sense_id": "a70c0136-b357-3ca9-9c7c-f2181eb44e06",
                                "text": "Sont considérés comme des particuliers fortunés dans le rapport de Capgemini les personnes qui possèdent « au moins 1 million de dollars d’actifs investissables, hors résidence principale, objets de collection, consommables et biens de consommation durable »."
                            }
                        ]
                    },
                    {
