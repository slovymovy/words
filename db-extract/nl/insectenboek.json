                        "examples": [
                            {
                                "example_id": "415a62af-6295-4132-acc9-00680a814bb7",
                                "sense_id": "809f0248-2e86-31fc-b35c-92ed3a46a614",
                                "text": "Exemplaren van het ruim 300 jaar oude insectenboek komen zelden op de markt. \"De afgelopen 50 jaar zijn slechts twee vergelijkbare exemplaren te koop geweest\", aldus conservator Alex Alsemgeest van het Rijksmuseum in het NOS Radio 1 Journaal."
                            },
                            {
                                "example_id": "00e8c44c-4f62-40e4-9825-0b52403752c2",
                                "sense_id": "809f0248-2e86-31fc-b35c-92ed3a46a614",
                                "text": "Op de haarscherpe afbeelding staan immense vruchten, bloemen en insecten. De kunstenaars lieten zich inspireren door Erik en het kleine insectenboek van Godfried Bomans. Sommigen noemen het de Sixtijnse Kapel van Rotterdam."
                            }
                        ]
