                "senses": [
                    {
                        "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                        "entry_id": "4b5a9d3c-48d2-3a6c-85f0-1e0cdd224016",
                        "glosses": [
                            "Linguistik, speziell Phonetik: Dauer (zeitliche Länge) eines Lautes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35de927-6f5b-4b9e-bf19-d1dfa52696b2",
                                "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                                "text": "„Vergleicht man die Aussprache der englischen Wörter ‚nitrate‘ (deutsch ‚Nitrat‘) und ‚nightrate‘ (deutsch ‚Nachttarif‘), so kann man beim Übergang von /t/ zu /r/ gewisse Unterschiede ausmachen, die den Grad der Aspiration, also der Behauchung, und der Lautdauer betreffen.“"
                            },
                            {
                                "example_id": "bcc44c73-a00e-4ec9-bed1-f3dd18efa6bd",
                                "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                                "text": "„Untersuchungen zur Lautdauer haben in der Linguistik eine lange Tradition, die bis ins 19. Jahrhundert zurückreicht.“"
                            },
                            {
                                "example_id": "d23dca58-9e33-4e3e-91f7-95e58f055298",
                                "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                                "text": "„Dieses größere Heraustreten hängt ab von der Lautdauer, von Tonhöhenverlauf, von der Lautqualität und von der Lautstärke.“"
                            },
                            {
                                "example_id": "e8858a33-dd04-4ad2-9338-bb239cb88d13",
                                "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                                "text": "„Auch hier nimmt die Lautdauer ab bei länger werdendem Wort.“"
                            },
                            {
                                "example_id": "f527f231-323c-4e13-9e34-f4e31b97f2d6",
                                "sense_id": "ee7f741a-5e58-34ce-a5d3-239c8dffe0ba",
                                "text": "„Dies Verfahren macht die Beurteilung der Lautdauer von der jeweiligen Sprechgeschwindigkeit unabhängig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
