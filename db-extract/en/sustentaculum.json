                        "glosses": [
                            "A supporting structure, a body part that supports one or more other parts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3655e065-9853-4b3e-8730-c441593c443a",
                                "sense_id": "4bd2c529-c644-3b26-94b7-75aef19b8dce",
                                "text": "The ligamentum talocalcaneum mediale lies obliquely on the medial side of the joint, and consists of fibres which extend from the medial posterior tubercle of the talus to the posterior roughened border of the sustentaculum tali."
                            },
                            {
                                "example_id": "596ec91e-c667-45a0-8c9b-895ac3afcda7",
                                "sense_id": "4bd2c529-c644-3b26-94b7-75aef19b8dce",
                                "text": "While of only moderate size, the sustentaculum is very thick and prominent; its astragalar facet is of irregularly oval shape and nearly plane."
                            }
                        ]
                    }
