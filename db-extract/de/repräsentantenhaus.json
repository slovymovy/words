                                "example_id": "345cbae5-eb6e-469d-a232-08440c8608be",
                                "sense_id": "34bc472a-9428-3d4f-ba4a-d661ab6d281a",
                                "text": "„Lange war es der Sprecher des Repräsentantenhauses Paul Ryan, der auf Distanz zu dem Immobilienmogul ging.“"
                            }
