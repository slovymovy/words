                                                "example_id": "cd0db622-7e86-4714-8187-62b257587187",
                                                "sense_id": "637135be-9fb3-3396-82a3-4670f74a484a",
                                                "text": "Er war an eine Quacksalberin geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b7ed3f9-6ed0-4546-9999-5a5d7441358f",
                        "source_entry_id": "66d50def-4b5b-3e32-8fc7-60dd3d7316b5",
                        "source_sense_id": "532332c9-3b38-3710-9fb3-afd2e5ef02f2",
                        "target_lang_word": "Kurpfuscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurpfuscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                        "entry_id": "4f60ac28-d623-3099-ba81-aa508b500469",
                                        "glosses": [
                                            "jemand, der ohne entsprechende Qualifikation und ohne Zulassung medizinisch tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95337cb4-f41e-4506-886b-66b95aa530b2",
                                                "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                                "text": "„»Ja, ich habe mein Diplom. Sie können mir viel vorwerfen, aber nicht, daß ich ein Kurpfuscher bin. Sie können sich darüber Gewißheit verschaffen -- in meinem Sprechzimmer finden Sie alle Papiere.«“"
                                            },
                                            {
                                                "example_id": "edfafd0e-4db8-4280-8b8e-050a2c288398",
                                                "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                        "entry_id": "4f60ac28-d623-3099-ba81-aa508b500469",
                                        "glosses": [
                                            "Arzt mit unzureichenden medizinischen Kenntnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2066bcbe-f923-44e9-8095-254fe797fbcb",
                                                "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            },
                                            {
                                                "example_id": "5472b368-5b3c-4e78-90d3-8efbcb431ed8",
                                                "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                                "text": "„Schiffsärzte wurden gemeinhin als Kurpfuscher und Säufer hingestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61eb9476-89ee-4d10-bd92-56658386aaf2",
                        "source_entry_id": "66d50def-4b5b-3e32-8fc7-60dd3d7316b5",
                        "source_sense_id": "532332c9-3b38-3710-9fb3-afd2e5ef02f2",
                        "target_lang_word": "Kurpfuscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurpfuscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5163243-cc81-3352-b0c0-71a4a1191412",
                                        "entry_id": "ca573d39-e8b1-30f2-a538-0468d9abc4fe",
                                        "glosses": [
                                            "weibliche Person, die ohne entsprechende Qualifikation und ohne Zulassung medizinisch tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98a08d36-e6f6-414f-b1e3-a74443707ed2",
                                                "sense_id": "e5163243-cc81-3352-b0c0-71a4a1191412",
                                                "text": "Als sie sicher war, dass sie schon wieder schwanger war, wollte sie doch lieber wieder zu der Kurpfuscherin nebenan gehen, als zu einer Fremden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d88c56ae-6eeb-3c83-82a3-4f698544b413",
                                        "entry_id": "ca573d39-e8b1-30f2-a538-0468d9abc4fe",
                                        "glosses": [
                                            "Ärztin mit unzureichenden medizinischen Kenntnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1789a7f-068f-4a20-8591-0313280c8477",
                                                "sense_id": "d88c56ae-6eeb-3c83-82a3-4f698544b413",
                                                "text": "Diese Kurpfuscherin hat mein Knie versaut! Sie hätte nie so schnell operieren dürfen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "214b5665-8886-495d-9f07-ed94e1bd1c97",
                        "source_entry_id": "66d50def-4b5b-3e32-8fc7-60dd3d7316b5",
                        "source_sense_id": "532332c9-3b38-3710-9fb3-afd2e5ef02f2",
                        "target_lang_word": "medicaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medicaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ff0cb0-a74b-334d-b74c-c02f9db65ac6",
                                        "entry_id": "87a5eabc-a00f-3ce9-9ab7-fd025d7d4af9",
                                        "glosses": [
                                            "A quack doctor; someone who pretends to have medical knowledge."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3216c1c-c33e-4a79-b870-5853ff82aa66",
                                                "sense_id": "16ff0cb0-a74b-334d-b74c-c02f9db65ac6",
                                                "text": "But these innovating Medicaſters have introduced a Practice not only very precarious, but in many Reſpects extremely dangerous, and quite devoid of any one of the Qualities which conſtitute a good Remedy, viz. to cure the Patient, as the Axiom has it, cito, tuto, & jucunde, i.e. ſpeedily, ſafely, and pleaſantly."
                                            },
                                            {
                                                "example_id": "7fdb786c-9faf-4fa4-90bf-5cfe64f67006",
                                                "sense_id": "16ff0cb0-a74b-334d-b74c-c02f9db65ac6",
                                                "text": "The most idiotic medicaster, when he had named, or, as they term it, diagnosticated a typhoid fever, found himself upon a level with the medical celebrities of the epoch. […] If the patient died, that was perfectly simple: he had a typhoid fever to which he was inevitably doomed to succumb! If he recovered, what a noble triumph for the medicaster, even when he had perhaps arbitrarily imposed the name of typhoid upon a simple and benignant fever, as is constantly done!"
                                            },
                                            {
                                                "example_id": "025d708d-e05e-4032-9f5e-da9b6b9b4706",
                                                "sense_id": "16ff0cb0-a74b-334d-b74c-c02f9db65ac6",
                                                "text": "[I]t [opium] is a double-edged sword, a divine gift in the hands of a master, a poison in those of a mere routinist—a medicaster—a demi-physician."
                                            },
                                            {
                                                "example_id": "f1173caf-7862-4556-a86d-d52ca66432d4",
                                                "sense_id": "16ff0cb0-a74b-334d-b74c-c02f9db65ac6",
                                                "text": "[I]f pushed, I would judge that many of those ‘medicasters’ and ‘charlatans’ commonly arraigned as tricksters were less cheats than zealots: if we are to speak of delusion, it is primarily self-delusion[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff3a1337-5a95-4b81-8529-1e8cde2c0c65",
                        "source_entry_id": "66d50def-4b5b-3e32-8fc7-60dd3d7316b5",
                        "source_sense_id": "532332c9-3b38-3710-9fb3-afd2e5ef02f2",
