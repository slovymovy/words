        "nl-extract.jsonl": [
            {
                "entry_id": "ebcc3670-46e4-3ae2-a29a-2192e24f353e",
                "word": "zeventig",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ed42ed6-2298-3b9e-97d1-96500feba294",
                        "entry_id": "ebcc3670-46e4-3ae2-a29a-2192e24f353e",
                        "glosses": [
                            "dat wat in een (rang)ordening met 70 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3916ab4f-bc04-4cb0-945e-38702eabb46a",
                                "sense_id": "7ed42ed6-2298-3b9e-97d1-96500feba294",
                                "text": "Het is weer de zeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "081db27b-3399-4b06-90bc-877db7118097",
                                "sense_id": "7ed42ed6-2298-3b9e-97d1-96500feba294",
                                "text": "Haar eenenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "995ca874-f742-3215-83e4-63810e2f442a",
                        "entry_id": "ebcc3670-46e4-3ae2-a29a-2192e24f353e",
                        "glosses": [
                            "groep van 70 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac42f97-1803-435e-84c4-609681e2d147",
                                "sense_id": "995ca874-f742-3215-83e4-63810e2f442a",
                                "text": "De zeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
