                "senses": [
                    {
                        "sense_id": "e79d8470-b4a8-3f7f-9215-d33d9eaa602c",
                        "entry_id": "e6e72a84-79aa-3c82-a33e-19d204b5676f",
                        "glosses": [
                            "Langue parlée par une tribu amérindienne vivant dans le nord-ouest des États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16fd1c3-6ea7-41d7-be50-3fcdf443e89c",
                                "sense_id": "e79d8470-b4a8-3f7f-9215-d33d9eaa602c",
                                "text": "Les tribus parlant le chinook étaient situées dans la partie inférieure de la Columbia River, riche en saumons qui constituaient la base de leur alimentation, et une denrée commerciale recherchée."
                            }
                        ]
                    },
                    {
                        "sense_id": "496aa246-cf4c-3bb6-9064-54766eec02dc",
                        "entry_id": "e6e72a84-79aa-3c82-a33e-19d204b5676f",
                        "glosses": [
                            "Pidgin parlé en Colombie-Britannique, au Canada et dans les États américains de l’Alaska, de Washington et de l’Oregon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "447fa808-fccf-3cc9-b299-74b15187671a",
                        "entry_id": "e6e72a84-79aa-3c82-a33e-19d204b5676f",
                        "glosses": [
                            "Vent de föhn du côté est des montagnes Rocheuses en Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36bbe47e-13b4-4103-82e2-40d21b1f3a08",
                                "sense_id": "447fa808-fccf-3cc9-b299-74b15187671a",
                                "text": "Le chinook véhicule de l’air pacifique par-dessus la Cordillère et redescend sur les Prairies comme un vent violent, chaud et sec."
                            }
                        ]
                    }
                ],
