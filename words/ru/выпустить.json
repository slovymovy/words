            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7745610-60da-3f2f-9b2a-528c154fa2b2",
                    "sense_definition": "Дать возможность или разрешение выйти из помещения или ограниченного пространства; освободить.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "release_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хозяин решил <выпустить> собаку погулять в сад.",
                            "target_lang_translations": {
                                "en": "The owner decided to <let out> the dog for a walk in the garden.",
                                "tr": "Sahibi köpeği bahçede gezinmesi için <dışarı salmaya> karar verdi."
                            }
                        },
                        {
                            "text": "Охранник согласился <выпустить> нас через запасной выход.",
                            "target_lang_translations": {
                                "en": "The guard agreed to <let> us <out> through the emergency exit.",
                                "tr": "Güvenlik görevlisi bizi acil çıkış kapısından <dışarı çıkarmayı> kabul etti."
                            }
                        },
                        {
                            "text": "Птицу нужно <выпустить> на волю, она не может жить в клетке.",
                            "target_lang_translations": {
                                "en": "The bird needs to be <released> into the wild; it cannot live in a cage.",
                                "tr": "Kuşu doğaya <salmak> gerekir, kafeste yaşayamaz."
                            }
                        }
                    ],
                    "synonyms": [
                        "освободить",
                        "отпустить"
                    ],
                    "antonyms": [
                        "впустить"
                    ],
                    "common_phrases": [
                        "выпустить на волю",
                        "выпустить из клетки",
                        "выпустить на улицу",
                        "выпустить из тюрьмы"
                    ],
                    "target_lang_definitions": {
                        "en": "To give the opportunity or permission to leave a room or confined space; to set free.",
                        "tr": "Bir odadan veya kapalı bir alandan çıkmaya izin vermek veya imkan sağlamak; serbest bırakmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let out",
                                "target_lang_sense_clarification": "person or animal"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "from confinement"
                            },
                            {
                                "target_lang_word": "set free",
                                "target_lang_sense_clarification": "liberate"
                            }
                        ],
                        "tr": [
