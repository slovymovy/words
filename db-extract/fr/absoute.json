                "forms": [],
                "senses": [
                    {
                        "sense_id": "73f32218-d8ae-3248-8f59-cbd8b425c33b",
                        "entry_id": "763e7183-3f7f-3a5a-872c-adb1358ebb99",
                        "glosses": [
                            "Participe passé féminin singulier du verbe absoudre."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "68b7061e-ede4-4eab-921f-b13d58ee6354",
                                "sense_id": "73f32218-d8ae-3248-8f59-cbd8b425c33b",
                                "text": "Le mariage serait un crime irrémissible de la part d’un templier ; mais les petites folies que je puis commettre seront vite absoutes à la prochaine assemblée de notre ordre."
                            },
                            {
                                "example_id": "78e72cd7-6cb3-4a35-90b2-d89c20b682cd",
                                "sense_id": "73f32218-d8ae-3248-8f59-cbd8b425c33b",
                                "text": "Penchée vers moi comme une infidèle pressée d’être absoute, maintenant elle m’expliquait son silence pendant tant d’années."
                            }
                        ]
                    }
