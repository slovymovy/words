                                            {
                                                "example_id": "61aafe4d-3408-4461-b5d2-e5f0ea695c62",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Heute wird die Wasseruhr abgelesen."
                                            },
                                            {
                                                "example_id": "f207bc22-a19c-464d-a178-75d9e3695d48",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Mit Hilfe der Wasseruhr ermittelt der Versorger den Verbrauch und kann danach eine Rechnung stellen."
