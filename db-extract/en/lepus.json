                    {
                        "translation_id": "327b4b4f-b251-4ac5-802d-00d4e1456668",
                        "source_entry_id": "39cb7e38-9242-3733-9cd0-4fddfae5ed7d",
                        "source_sense_id": "01de09ba-d696-332f-a489-fdc2c69f8b7d",
