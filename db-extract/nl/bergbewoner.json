                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b72e56-7ca0-446a-a59d-9c3174a84566",
                                "sense_id": "7935e7e3-2db4-3553-ae8d-d57e8b173a81",
                                "text": "De bergbewoner was een simplistisch mens en propageerde dat iedereen moest reageren zoals hij."
                            },
                            {
                                "example_id": "6ac21435-f7d9-4113-b964-75e4fd9f1dce",
                                "sense_id": "7935e7e3-2db4-3553-ae8d-d57e8b173a81",
                                "text": "Daarna zag hij Otto Grundtz de bergbewoner naar de galg geleiden, en toen de grote, ononderworpen man op het krukje stond, hoorde Szymon hem brullen: `Steek de hele rotzooi in brand!' en nog dagenlang klonk het geroep in zijn oren na."
                            }
                        ]
                    }
