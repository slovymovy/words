    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e54d8e9c-789b-3537-964c-f96a471a2012",
                    "sense_definition": "met een zekere regelmaat; op herhaalde tijdstippen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaat <w>geregeld</w> naar de sportschool om fit te blijven.",
                            "target_lang_translations": {
                                "en": "He goes to the gym <w>regularly</w> to stay fit."
                            }
                        },
                        {
                            "text": "Zij schuift <w>geregeld</w> aan bij talkshows om over haar nieuwe boek te praten.",
                            "target_lang_translations": {
                                "en": "She <w>frequently</w> joins talk shows to talk about her new book."
                            }
                        }
                    ],
                    "synonyms": [
                        "regelmatig",
                        "dikwijls",
                        "vaak"
                    ],
                    "common_phrases": [
                        "geregeld aan schuiven",
                        "geregeld voor komen"
                    ],
                    "target_lang_definitions": {
                        "en": "with a certain regularity; at repeated times"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regularly",
                                "target_lang_sense_clarification": "at fixed intervals"
                            },
                            {
                                "target_lang_word": "frequently",
                                "target_lang_sense_clarification": "happening often"
                            },
                            {
                                "target_lang_word": "often",
                                "target_lang_sense_clarification": "many times"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d08c6479-b53d-3602-92c6-8779924d33ed",
                    "sense_definition": "volgens vaste regels of afspraken functionerend; ordelijk en gestructureerd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De opstandige boeren waren geen partij voor de <w>geregelde</w> troepen van de regering.",
                            "target_lang_translations": {
                                "en": "The rebellious farmers were no match for the government's <w>regular</w> troops."
                            }
                        },
                        {
                            "text": "Hij leidt een zeer <w>geregeld</w> leven met vaste tijden voor werk en rust.",
                            "target_lang_translations": {
                                "en": "He leads a very <w>orderly</w> life with fixed times for work and rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "geordend",
                        "systematisch",
                        "ordelijk"
                    ],
                    "antonyms": [
                        "ongeregeld"
                    ],
                    "common_phrases": [
                        "geregelde troepen",
                        "geregeld leven"
                    ],
                    "target_lang_definitions": {
                        "en": "functioning according to fixed rules or agreements; orderly and structured"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regular",
                                "target_lang_sense_clarification": "orderly or professional (e.g., troops)"
                            },
                            {
                                "target_lang_word": "orderly",
                                "target_lang_sense_clarification": "well-organized and controlled"
                            },
                            {
                                "target_lang_word": "structured",
                                "target_lang_sense_clarification": "following a clear pattern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df7eb31-a85c-3a3c-8eb7-e034fe098b2e",
                    "sense_definition": "waarvoor de nodige voorbereidingen al zijn getroffen; in orde gemaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorbereiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>geregelde</w> stoelen voor het evenement waren helaas nog niet geleverd.",
                            "target_lang_translations": {
                                "en": "The <w>arranged</w> chairs for the event had unfortunately not been delivered yet."
                            }
                        },
                        {
                            "text": "Met alle <w>geregelde</w> zaken konden we eindelijk rustig op vakantie vertrekken.",
                            "target_lang_translations": {
                                "en": "With all matters <w>settled</w>, we could finally leave for vacation in peace."
                            }
                        }
                    ],
                    "synonyms": [
                        "afgesproken",
                        "georganiseerd"
                    ],
                    "common_phrases": [
                        "geregelde zaken"
                    ],
                    "target_lang_definitions": {
                        "en": "for which the necessary preparations have already been made; put in order"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arranged",
                                "target_lang_sense_clarification": "organized or prepared in advance"
                            },
                            {
                                "target_lang_word": "settled",
                                "target_lang_sense_clarification": "resolved or finalized"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
