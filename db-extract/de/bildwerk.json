                "senses": [
                    {
                        "sense_id": "85b5912e-0d7d-3d24-a66a-a6eb04553fac",
                        "entry_id": "e0d876bf-69e8-3d82-8c84-8476518a131c",
                        "glosses": [
                            "plastisches Kunstwerk"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "74227162-6551-4448-9a37-fadcc0dddcdf",
                                "sense_id": "85b5912e-0d7d-3d24-a66a-a6eb04553fac",
                                "text": "„Unter dem Kreuz ist in einer Nische ein Bildwerk des Christus in der Rast aufgestellt.“"
                            },
                            {
                                "example_id": "73ecab0a-4c6a-4239-88a7-ee967ae96e3c",
                                "sense_id": "85b5912e-0d7d-3d24-a66a-a6eb04553fac",
                                "text": "„Die Bildwerke kamen in der Palmsonntagsprozession zum Einsatz, wo sie an den Einzug Christi in Jerusalem erinnerten.“"
                            },
                            {
                                "example_id": "a6eec885-d268-4549-8337-d754a38d25a0",
                                "sense_id": "85b5912e-0d7d-3d24-a66a-a6eb04553fac",
                                "text": "„Er lebte fast nur in dieser Werkstatt oder nebenan in dem großen Raum, in dem die fertigen Bildwerke aufgestellt und ausgefeilt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f153c339-9847-4642-9681-888da43b7e8c",
                        "source_entry_id": "e0d876bf-69e8-3d82-8c84-8476518a131c",
                        "source_sense_id": "85b5912e-0d7d-3d24-a66a-a6eb04553fac",
