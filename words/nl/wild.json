                    "sense_definition": "het vlees van dieren waarop gejaagd is, bedoeld voor consumptie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst serveren veel restaurants gerechten met vers <w>wild</w>.",
                            "target_lang_translations": {
                                "en": "In the autumn, many restaurants serve dishes with fresh <w>game</w>."
                            }
                        },
                        {
                            "text": "Zij houdt erg van de smaak van <w>wild</w> zoals hert of konijn.",
                            "target_lang_translations": {
                                "en": "She really likes the taste of <w>game</w> such as deer or rabbit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild eten",
                        "wild op de kaart"
                    ],
                    "target_lang_definitions": {
                        "en": "the meat of hunted animals intended for consumption"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "game",
                                "target_lang_sense_clarification": "hunted animals used for food"
                            },
                            {
                                "target_lang_word": "venison",
                                "target_lang_sense_clarification": "specifically deer meat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "090631ee-5420-3bc4-8f66-dabc7d7596e5",
                    "sense_definition": "de toestand van de vrije natuur, buiten de menselijke bebouwing of controle",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We kampeerden in het <w>wild</w> langs beken en zagen zelden andere mensen.",
                            "target_lang_translations": {
                                "en": "We camped in <w>the wild</w> along streams and rarely saw other people."
                            }
                        },
                        {
                            "text": "Het is verboden om in het <w>wild</w> je afval achter te laten.",
                            "target_lang_translations": {
                                "en": "It is forbidden to leave your trash behind in <w>nature</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wildernis",
                        "natuur"
                    ],
                    "common_phrases": [
                        "in het wild"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of nature, outside of human development or control"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the wild",
                                "target_lang_sense_clarification": "undomesticated state or wilderness"
                            },
                            {
                                "target_lang_word": "nature",
                                "target_lang_sense_clarification": "the physical world including plants and animals"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c363d57d-29ea-34f3-a379-3613a8c1ac01",
                    "sense_definition": "dieren die in de vrije natuur leven en niet door mensen worden beheerd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boswachter houdt de stand van het <w>wild</w> in dit gebied nauwkeurig bij.",
                            "target_lang_translations": {
                                "en": "The forest ranger keeps a close eye on the <w>wildlife</w> population in this area."
                            }
                        },
                        {
                            "text": "Tijdens de safari zagen we veel groot <w>wild</w> zoals olifanten en leeuwen.",
                            "target_lang_translations": {
                                "en": "During the safari, we saw a lot of big <w>game</w> such as elephants and lions."
                            }
                        }
                    ],
                    "synonyms": [
                        "wildlife",
                        "fauna"
                    ],
                    "common_phrases": [
                        "groot wild",
                        "klein wild"
                    ],
                    "target_lang_definitions": {
                        "en": "animals living in the wild that are not managed by humans"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wildlife",
                                "target_lang_sense_clarification": "wild animals collectively"
                            },
                            {
                                "target_lang_word": "game",
                                "target_lang_sense_clarification": "animals hunted for sport or food"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d0e41018-6c46-3190-bcd2-c4596d6e74db",
                    "sense_definition": "op een onbeheerste, heftige of onstuimige manier",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij werd aangevallen, sloeg hij <w>wild</w> om zich heen.",
                            "target_lang_translations": {
                                "en": "When he was attacked, he struck out <w>wildly</w> around him."
                            }
                        },
                        {
                            "text": "Haar hart bonsde <w>wild</w> in haar keel na de lange sprint.",
                            "target_lang_translations": {
                                "en": "Her heart pounded <w>wildly</w> in her throat after the long sprint."
                            }
                        }
                    ],
                    "synonyms": [
                        "onstuimig",
                        "woest"
                    ],
                    "common_phrases": [
                        "wild om zich heen slaan",
                        "wild gebaren"
                    ],
                    "target_lang_definitions": {
                        "en": "in an uncontrolled, violent, or impetuous manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wildly",
                                "target_lang_sense_clarification": "in an uncontrolled way"
                            },
                            {
                                "target_lang_word": "frantically",
                                "target_lang_sense_clarification": "in a hurried, excited, or disorganized manner"
                            }
                        ]
                    }
                }
            ]
        }
