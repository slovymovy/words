                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fauteuil ancien du salon est recouvert d'une <w>peluche</w> douce et brillante."
                        },
                        {
                            "text": "Ce manteau d'hiver est doublé d'une épaisse <w>peluche</w> qui tient bien chaud."
