                        "examples": [
                            {
                                "example_id": "c945d238-8f80-48d5-ac9c-8fb8cefb6391",
                                "sense_id": "d75d767f-9fdd-35e8-a47f-e65da5720c59",
                                "text": "ChristenUnie-leider Gert-Jan Segers heeft in een extra ingelast NOS-journaal zojuist nogmaals bevestigd geen deel te zullen uitmaken van een eventueel kabinet Rutte-IV."
                            },
                            {
                                "example_id": "c006a490-06c2-464a-a068-fd17709b4241",
                                "sense_id": "d75d767f-9fdd-35e8-a47f-e65da5720c59",
                                "text": "Op 28 juli, twee dagen voor het bod van Wolters afloopt, verklaarde drs L. van Zwol, bestuurder van Nationale Nederlanden (grootaandeelhouder in Kluwer en vertegenwoordigd in de raad van commissarissen), in de kranten het bod van Wolters beter te vinden. Hij stuurde zijn tweede man drs. A. G. Jacobs zelfs naar het NOS-journaal om dat nog eens aan heel Nederland te melden."
                            }
