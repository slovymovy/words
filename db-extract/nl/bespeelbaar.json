                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3da59a0-3775-4fbf-82f0-65fdfd139102",
                                "sense_id": "0ac70c8e-1bd5-3b71-baf6-aba588a2fc78",
                                "text": "Het voetbalveld was weer bespeelbaar nadat alle rotzooi was opgeruimd, de lijnen waren gekalkt, en het gras was gemaaid."
                            }
                        ]
                    }
