                "senses": [
                    {
                        "sense_id": "a93bcc92-c8e8-3f5c-b44b-1e0e2452fd9c",
                        "entry_id": "bfe891ce-f5f6-3368-beb0-9c5f6ef57a5c",
                        "glosses": [
                            "im Blut vorhandene Zelle, die Krankheitserreger vernichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b393f8-246d-458f-a87c-fadf9238dc02",
                                "sense_id": "a93bcc92-c8e8-3f5c-b44b-1e0e2452fd9c",
                                "text": "„Makrophagen sind Fresszellen, die in jedem menschlichen Organismus zu finden sind. Die Fresszellen sind weiße Blutkörperchen (Leukozyten), die zum ältesten entwicklungsgeschichtlichen angeborenen Immunsystem gehören.“"
                            },
                            {
                                "example_id": "29cd9de2-f14a-4ee1-81d2-3230b3da5529",
                                "sense_id": "a93bcc92-c8e8-3f5c-b44b-1e0e2452fd9c",
                                "text": "„Sobald Krankheitserreger in den Körper gelangen, werden sie durch diese Fresszellen vernichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1183275-bca0-4f9a-aa60-6619b535265f",
                        "source_entry_id": "bfe891ce-f5f6-3368-beb0-9c5f6ef57a5c",
                        "source_sense_id": "a93bcc92-c8e8-3f5c-b44b-1e0e2452fd9c",
                        "source_sense_description": "Zoologie, Medizin: im Blut vorhandene Zelle, die Krankheitserreger vernichtet",
                        "target_lang_word": "phagocyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phagocyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                        "entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                                        "glosses": [
                                            "Cellule possédant le pouvoir d’absorber et souvent aussi de digérer des particules étrangères, inorganiques ou organiques (microorganismes notamment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3de553-e9c5-4466-a820-3b1e05e69a0a",
                                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                                "text": "Le macrophage activé dans sa nouvelle fonction se nomme « phagocyte », c’est-à-dire « cellule mangeuse », et va opérer la phagocytose (« action de manger les cellules » étrangères à l’organisme)."
                                            },
                                            {
                                                "example_id": "f50cabca-95da-41db-ab00-3feb61dea541",
                                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                                "text": "C'est le signe d'une réaction de l'organisme : le tissu lymphoïde fabrique des phagocytes en abondance pour pouvoir lutter contre l'invasion parasitaire, qui se produit au niveau de la muqueuse intestinale."
                                            }
                                        ]
                                    }
                                ]
