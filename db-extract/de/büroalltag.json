                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb5cc46-6be2-4976-826b-1030416add2b",
                                "sense_id": "1427eb7e-75a6-3668-9147-1c5f08e85793",
                                "text": "„Sie stand sehr schmal und fragil vor der leuchtenden Lichtwand der Wolkenkratzer, in denen die tausend Scheuerfrauen den Schmutz eines Büroalltags wegspülten und dabei den Himmel mit Magie füllten.“"
                            },
                            {
                                "example_id": "dbdb27ce-ce9f-4c9a-814c-1833c334b30a",
                                "sense_id": "1427eb7e-75a6-3668-9147-1c5f08e85793",
                                "text": "„Hin und wieder wurde der triste Büroalltag von einer verschlüsselten Mail seines besten Freundes aus Farm-Zeiten aufgehellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
