                "senses": [
                    {
                        "sense_id": "b6a613d4-f48e-366c-9bf0-51f43d6bbabc",
                        "entry_id": "bdfaff30-bf7f-34d0-9644-41ec469ae0e3",
                        "glosses": [
                            "Dessécher un produit en le surgelant puis en retirant son eau par sublimation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f658a7c-da61-448c-b105-854765ea7cde",
                                "sense_id": "b6a613d4-f48e-366c-9bf0-51f43d6bbabc",
                                "text": "On peut par exemple les stériliser par filtration sur un filtre retenant les bactéries, par incorporation d'agents stérilisants dans les compositions ou par irradiation. On peut également les préparer sous forme de compositions solides stériles, par exemple en les cryodesséchant, qui peuvent être dissoutes dans de l’eau stérile ou un autre diluant stérile pour injection immédiatement avant utilisation."
                            }
                        ]
                    }
