                "senses": [
                    {
                        "sense_id": "1b3e7a1e-16ed-3dfc-8ecf-3dcf0ec5317a",
                        "entry_id": "780107cb-def9-3e8a-a2eb-cac2c22dc237",
                        "glosses": [
                            "Relatif à l’anthropophagie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa121d3-5f7e-4cc8-b4fb-468deaca1419",
                                "sense_id": "1b3e7a1e-16ed-3dfc-8ecf-3dcf0ec5317a",
                                "text": "Ce qui donna au poète l’idée d’un déjeuner anthropophagique, auquel il convia ses amis, et dont le menu portait entr’autres mentions : Veuf à l’huile, Gâteux de Savoie."
                            },
                            {
                                "example_id": "cd4d01db-fdd8-47e0-8c74-b529dfab070b",
                                "sense_id": "1b3e7a1e-16ed-3dfc-8ecf-3dcf0ec5317a",
                                "text": "La question anthropophagique est la marotte du docteur Bérillon. Il veut faire de nous des mangeurs de chair humaine."
                            },
                            {
                                "example_id": "5e5488c3-7419-4ab0-adc4-2bf585a8a866",
                                "sense_id": "1b3e7a1e-16ed-3dfc-8ecf-3dcf0ec5317a",
                                "text": "Si l’auteur de Gulliver avait assisté à ces gracieux passe-temps, nul doute qu'il n'eût ajouté un chapitre au pamphlet anthropophagique où il conseillait aux Anglais de manger les Irlandais en guise de roastbeef, railleries swift generis…"
                            }
                        ]
                    }
                ],
