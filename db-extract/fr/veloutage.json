                "senses": [
                    {
                        "sense_id": "86c726b7-30db-349d-bc07-8d264d0305f9",
                        "entry_id": "83e06fa4-e305-3fe7-8cc2-eee98ccfb3eb",
                        "glosses": [
                            "Opération qui consiste à donner un aspect velouté à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7e3b6b-956e-471c-9cc3-8241bbe86018",
                                "sense_id": "86c726b7-30db-349d-bc07-8d264d0305f9",
                                "text": "Il ne reste plus alors qu'à modifier l'aspect extérieur du chapeau : coupage des bords et de l'intérieur, ponçage général, veloutage ou rasage."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f1ce88-3c12-308a-a080-69c3fc285a22",
                        "entry_id": "83e06fa4-e305-3fe7-8cc2-eee98ccfb3eb",
                        "glosses": [
                            "Opération qui consiste à pratiquer un ponçage ou un meulage très modéré sur les peaux (coté fleur ou coté croute) pour leur donner un aspect velouté (cuir velours, nubuck, daim, suède, etc.)."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "ce22e047-7fe1-4f3b-8a5b-2450b1d85d70",
                                "sense_id": "30f1ce88-3c12-308a-a080-69c3fc285a22",
                                "text": "Brevet d'invention de 15 ans dont la demande a été déposée le 3 Mai 1862 au secrétariat de la préfecture de la Seine, par le sieur Digeon (Louis-Marcel), teinturier en peaux, représenté par le sieur Ricordeau, à Paris, boulevard de Strasbourg, n ° 23, pour un procédé de bronzage et de veloutage des cuirs et peaux tannées, corroyées, mégissées, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a425201-23d4-332a-b830-2b7068b39fb7",
                        "entry_id": "83e06fa4-e305-3fe7-8cc2-eee98ccfb3eb",
                        "glosses": [
                            "Opération qui consiste à donner un aspect velouté au papier, parfois en incluant ou en collant sur une des faces des fibres broyées (coton, laine, etc.)."
                        ],
                        "tags": [
                            "Papeterie"
                        ],
                        "examples": [
                            {
                                "example_id": "a6dabc70-143a-4102-b3c5-4f84f8c298f1",
                                "sense_id": "9a425201-23d4-332a-b830-2b7068b39fb7",
                                "text": "Parmi les papiers de luxe, je citerai notamment les papiers veloutés, les papiers gaufrés. Le veloutage s'obtient en fixant , par des mouvements de trépidation, de la tontisse de laine sur une couche d'huile cuite."
                            }
                        ]
                    },
                    {
                        "sense_id": "27422db0-fd29-3656-82b3-284cf03d5dec",
                        "entry_id": "83e06fa4-e305-3fe7-8cc2-eee98ccfb3eb",
                        "glosses": [
                            "Sorte de glaçage mat à base de beurre de cacao, ayant plus ou moins l'aspect du velours."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f3bd48f2-ec91-3d6f-826c-f20b0837b670",
