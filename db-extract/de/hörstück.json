                ],
                "senses": [
                    {
                        "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                        "entry_id": "e957198b-d4ea-3c6a-8968-4a16865f7575",
                        "glosses": [
                            "Aufnahme eines beispielsweise für Radio oder einen Podcast geschriebenen Werkes, oft mit Unterstützung von Musik oder Geräuschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8190258b-1f6e-42a1-b5a5-4bed8bf8839e",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Neben seiner Forschungs- und Lehrtätigkeit produziert er auch Klanginstallationen und Hörstücke.“"
                            },
                            {
                                "example_id": "122ea4d7-e648-4d76-ab2d-656f6e1a3410",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Produziert wurden die Hörstücke in Kabul.“"
                            },
                            {
                                "example_id": "96d73cb4-89fa-4c91-9ab8-fa2a07f6d63a",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Das Hörstück wird in einem alten Berliner Kino präsentiert, als Hörbuch ist es auch im Handel erhältlich.“"
                            },
                            {
                                "example_id": "3ad04ca6-7ba5-46e9-9786-f1b5b1a4753e",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„In Zusammenarbeit mit dem Audio-Künstler Hans Peter Kuhn, später mit dem Musiker Johannes Schmoelling, entstanden diverse experimentelle Hörstücke, die als Hörspiele firmierten, aber vor allem die Übergangszone von Geräusch, Musik und Sprache explorierten.“"
                            },
                            {
                                "example_id": "3c028b5a-4efc-4cd7-9d9e-7567fb144b41",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Drei Stunden dauert das dokumentarische Hörstück, das sich auf mehreren Ebenen der Biografie des Nazi-Kriegsverbrechers Klaus Barbie nähert.“"
                            },
                            {
                                "example_id": "3b999270-a5c9-4d2b-a51d-42dadb109b5f",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Ohr liest mit ist ein Konzept zur Lese- und Hörförderung des Börsenvereins des Deutschen Buchhandels, in dem sich Kinder und Jugendliche über einen längeren Zeitraum kreativ mit Literatur beschäftigen und daraus kurze Hörstücke produzieren können.“"
                            },
                            {
                                "example_id": "d9867636-dd52-484e-b886-afc37873ef39",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Als nächstes werden aus Lautsprechern Hörstücke ertönen mit Originaltexten aus der Zeit des Landesstreiks.“"
                            },
                            {
                                "example_id": "bfd4b29c-a3e3-4389-9ae2-bd018a0a7683",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Der ausgetrocknete Salzsee „Lop Nor“ wurde von der chinesischen Zentralregierung in den 1950er Jahren zum Testgebiet für Atomwaffen erklärt. Echo Ho und Ulrike Janssen komponieren ein Hörstück über einen weitgehend vergessenen Ort.“"
                            },
                            {
                                "example_id": "539600d7-5c19-4bdf-be1c-8a431a070c24",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Echo Ho und Ulrike Janssen folgen in ihrem Hörstück den Phasen einer Atomexplosion.“"
                            },
                            {
                                "example_id": "82688bf8-f463-46e0-b633-0ac4bb36e25a",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Seine alten Hörstücke schlummern in digitalen Hörfunkarchiven und werden in diesem Dreierpack wieder zum Leben erweckt.“"
                            },
                            {
                                "example_id": "7a4470e5-e2c7-4c8c-b8d9-11fd529a91dd",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Schick’ uns dein Hörstück! Zu gewinnen ist ein Preisgeld, die Teilnahme an dem Festival „ARD-Hörspieltage“ und eine Sendung im Deutschlandfunk Kultur.“"
                            },
                            {
                                "example_id": "4faf7b1c-0052-47bc-8008-b2eca6dc2dbc",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Der Autor Jan Jelinek hat den diesjährigen Karl-Sczuka-Preis für sein Hörstück „Überwachung – in drei Episoden“ erhalten.“"
                            },
                            {
                                "example_id": "88ae0d38-b1b0-4d84-87b9-86ea5ab586d5",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„Heiner Goebbels vertonte 1985 den Prosatext von Heiner Müller aus dessen Theaterstück Zement in seinem Hörstück Die Befreiung des Prometheus.“"
                            },
                            {
                                "example_id": "af6374c0-4bb6-416a-8c0f-37b1ae70c211",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„2008 wurde ihr Hörstück „Haus aus Stimmen“ nach dem Libretto von Silke Scheuermann mit dem Deutschen Kritikerpreis in der Kategorie Radio 2009 prämiert,“ […]."
                            },
                            {
                                "example_id": "b75ed9b2-4f91-4dd9-a601-62ce442a214f",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "„2016 bekam sie den renommierten Hörspielpreis der Kriegsblinden für ihr Hörstück \"Und jetzt: Die Welt!\", ein furioses wildes, atemloses Stück voll ätzender Komik, wie die Jury urteilte.“"
                            },
                            {
                                "example_id": "2560080c-0538-41d7-b65d-e8f30828f5ae",
                                "sense_id": "93d7483e-8128-3ca3-bd28-343a02df15f0",
                                "text": "[Eric Facon:] „Der SRF-Kulturredaktor hat zusammen mit dem Tontechniker Darren Hayne das Hörstück «D'Rosmarie und mir» realisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7443f681-c107-3e1c-bda2-17258fdef64f",
                        "entry_id": "e957198b-d4ea-3c6a-8968-4a16865f7575",
                        "glosses": [
                            "(am Ohr sitzendes) Bestandteil eines Hörgerätes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4fe507-7cc2-47b9-b39d-ed4b13dda27e",
                                "sense_id": "7443f681-c107-3e1c-bda2-17258fdef64f",
                                "text": "Vaters Hörstück muss demnächst angepasst werden."
                            }
