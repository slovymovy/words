                                "target_lang_sense_clarification": "expressionless"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking liveliness"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stumpf",
                                "target_lang_sense_clarification": "ausdruckslos, teilnahmslos"
                            },
                            {
                                "target_lang_word": "stumpfsinnig",
                                "target_lang_sense_clarification": "teilnahmslos dreinblickend"
                            },
                            {
                                "target_lang_word": "leer",
                                "target_lang_sense_clarification": "ohne Ausdruck"
