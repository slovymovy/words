                    },
                    {
                        "form_id": "416a6818-694c-43ef-8511-f091e47fec8f",
                        "entry_id": "d70ab045-a215-3fc5-b1ad-84237b2e192c",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "ско̀роморозильны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "490ade3c-3cf7-3903-9650-4e89c7d42844",
                        "entry_id": "d70ab045-a215-3fc5-b1ad-84237b2e192c",
                        "glosses": [
                            "техн. осуществляющий быстрое замораживание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066a3a5e-6bb7-4ad1-a22c-3420db4ffad8",
                                "sense_id": "490ade3c-3cf7-3903-9650-4e89c7d42844",
                                "text": "После этого пачки по конвейеру идут в камеру, которая называется скороморозильной."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71e8da3e-6ecf-4316-b4cc-2e31bcf4181e",
                        "source_entry_id": "d70ab045-a215-3fc5-b1ad-84237b2e192c",
                        "source_sense_id": "490ade3c-3cf7-3903-9650-4e89c7d42844",
                        "target_lang_word": "quick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e04c1c4-fdc8-3b68-af9a-2a2c119487e1",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Moving with speed, rapidity or swiftness, or capable of doing so; rapid; fast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109a0007-2971-4e5c-ac87-b418515e910f",
                                                "sense_id": "2e04c1c4-fdc8-3b68-af9a-2a2c119487e1",
                                                "text": "I ran to the station – but I wasn't quick enough."
                                            },
                                            {
                                                "example_id": "e078b0d3-7c7f-4e9e-96cf-e46a7989f6fa",
                                                "sense_id": "2e04c1c4-fdc8-3b68-af9a-2a2c119487e1",
                                                "text": "He's a quick runner."
                                            },
                                            {
                                                "example_id": "d11ffcc2-662d-4029-aea1-65d84a76cc16",
                                                "sense_id": "2e04c1c4-fdc8-3b68-af9a-2a2c119487e1",
                                                "text": "The quickest and nimblest were probably the oxycones, throwing themselves through the water like discuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90299d5-1503-3c5a-9cfc-778a003412c7",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Occurring in a short time; happening or done rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4548e46-2dba-49f5-b17d-680e2d2f6ecb",
                                                "sense_id": "d90299d5-1503-3c5a-9cfc-778a003412c7",
                                                "text": "That was a quick meal."
                                            },
                                            {
                                                "example_id": "c80df79b-6973-4c5e-b36b-9d4dd37dfa32",
                                                "sense_id": "d90299d5-1503-3c5a-9cfc-778a003412c7",
                                                "text": "Veronica Ripley, 32, often speaks to friends about the role that video games played in her trans awakening: “I would try to explain it away, saying that I was playing the girl character because she had a smaller hitbox or quicker kill animations,” she said, referring to in-game advantages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b51f4a43-71cc-3345-abd8-6398cda77c89",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Lively, fast-thinking, witty, intelligent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675b9e5f-aa8a-4688-a7f8-330b9d609f4c",
                                                "sense_id": "b51f4a43-71cc-3345-abd8-6398cda77c89",
                                                "text": "You have to be very quick to be able to compete in ad-lib theatrics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3232bd6-9b9c-33b8-ae0b-d6f84de3044e",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Mentally agile, alert, perceptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03cae43d-a543-4b07-a949-c999fd27dbe0",
                                                "sense_id": "e3232bd6-9b9c-33b8-ae0b-d6f84de3044e",
                                                "text": "My father is old but he still has a quick wit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3722caf1-6fd0-34a4-8253-07a74331cf69",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Easily aroused to anger; quick-tempered."
                                        ],
                                        "tags": [
                                            "of people or tempers"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cb40ee9-d4ab-45b5-bb32-0adaebbdfd14",
                                                "sense_id": "3722caf1-6fd0-34a4-8253-07a74331cf69",
                                                "text": "She has a very quick temper."
                                            },
                                            {
                                                "example_id": "3683e92b-6856-41c3-a1ec-52c4fdbafc18",
                                                "sense_id": "3722caf1-6fd0-34a4-8253-07a74331cf69",
                                                "text": "He is wont to be rather quick of temper when tired."
                                            },
                                            {
                                                "example_id": "dcdb29c6-2481-4555-a897-049eb1a2cf62",
                                                "sense_id": "3722caf1-6fd0-34a4-8253-07a74331cf69",
                                                "text": "The bishop was somewhat quick with them, and signified that he was much offended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0cedb74-5931-30d7-81fc-3ba637025599",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Alive, living."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2cc0ff8-c99d-4b82-a108-efb7950fed9b",
                                                "sense_id": "a0cedb74-5931-30d7-81fc-3ba637025599",
                                                "text": "I charge thee therefore before God, and the Lord Ieſus Chriſt, who ſhall iudge the quicke and the dead at his appearing, and his kingdome:"
                                            },
                                            {
                                                "example_id": "bf5471b8-3593-438d-8599-c6240b2cecfa",
                                                "sense_id": "a0cedb74-5931-30d7-81fc-3ba637025599",
                                                "text": "Man is no star, but a quick coal / Of mortal fire."
                                            },
                                            {
                                                "example_id": "86c6521f-2230-4e89-aad7-042ec56945cb",
                                                "sense_id": "a0cedb74-5931-30d7-81fc-3ba637025599",
                                                "text": "The inmost oratory of my soul,\nWherein thou ever dwellest quick or dead,\nIs black with grief eternal for thy sake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6da648de-9ff3-3ffe-a6ec-72f3f80b99c0",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "At the stage where it can be felt to move in the uterus."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "359d0fcb-feb9-4dfa-b818-cdafd6782233",
                                                "sense_id": "6da648de-9ff3-3ffe-a6ec-72f3f80b99c0",
                                                "text": "Whoever does any act under such circumstances that if he thereby caused death he would be guilty of culpable homicide, and does by such act cause the death of a quick unborn child, shall be punished with imprisonment for a term which may extend to 10 years, and shall also be liable to fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eed171fe-d8cb-3146-9844-8bd401bc3942",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Pregnant, especially at the stage where the foetus's movements can be felt; figuratively, alive with some emotion or feeling."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264f2ac1-140b-48c5-89b9-91abbec811c7",
                                                "sense_id": "eed171fe-d8cb-3146-9844-8bd401bc3942",
                                                "text": "she's quick; the child brags in her belly already: tis yours"
                                            },
                                            {
                                                "example_id": "7ff3ea8b-7b64-44ec-8b3b-b93cbe8e2b77",
                                                "sense_id": "eed171fe-d8cb-3146-9844-8bd401bc3942",
                                                "text": "Invention sleeps within a skull\nNo longer quick with light,\nThe hive that hummed in every cell\nIs now sealed honey-tight."
                                            },
                                            {
                                                "example_id": "c2261366-b42d-4f53-a684-611590c9ae52",
                                                "sense_id": "eed171fe-d8cb-3146-9844-8bd401bc3942",
                                                "text": "When sentenced she sought to avoid hanging by declaring herself with child – ironically, given her favourite deception – but a ‘jury of Matrons’ found her not quick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60bdf4e8-4761-3904-969a-74cbbd5cf364",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Flowing, not stagnant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b69e69a-9ebd-301c-b124-5f8a8142acdf",
                                        "entry_id": "aa77a35e-651d-3d9c-b01a-a3cf780c4bed",
                                        "glosses": [
                                            "Burning, flammable, fiery."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6e11d7-a7d2-4216-b555-294604a83793",
                                                "sense_id": "3b69e69a-9ebd-301c-b124-5f8a8142acdf",
                                                "text": "And it seemed to me that the dream smote the roof above my bed, and the roof opened and disclosed the outer dark, and in the dark travelled a bearded star, and the night was quick with fiery signs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae856f90-4ae6-3a0b-ba78-0ab70197a085",
