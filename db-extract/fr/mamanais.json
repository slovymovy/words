                                        "glosses": [
                                            "The form of speech used by adults in talking to very young children."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c83b00d-aa02-4e3e-b9b0-57e9133a6871",
                                                "sense_id": "9b77c5d2-7178-3688-9ac3-c5660ff8ba6b",
                                                "text": "Meronym: babble word"
                                            },
                                            {
                                                "example_id": "a66228d3-67ac-48aa-9316-f30210f00e73",
                                                "sense_id": "9b77c5d2-7178-3688-9ac3-c5660ff8ba6b",
                                                "text": "[...] while not a super-goof like some of the female goofs I'd met, she was quite goofy enough to be going on with. Her whole aspect was that of a girl who at the drop of a hat would start talking baby talk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e5a9319-ac6d-3dd2-8ed1-246abf2153a2",
