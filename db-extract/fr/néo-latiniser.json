                "senses": [
                    {
                        "sense_id": "0621439a-e0db-3f37-b2a5-d30080279c19",
                        "entry_id": "00deb737-40e1-3668-b3e9-1db3d6c21d2b",
                        "glosses": [
                            "Donner un caractère néo-latin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3199ee17-a27c-43f0-8649-3aeb03b2a191",
                                "sense_id": "0621439a-e0db-3f37-b2a5-d30080279c19",
                                "text": "Néo-latinisé puis francisé et anglicisé, à l'origine, le mot ethnie désigne les autres, les païens par opposition aux chrétiens dans le langage ecclésiastique."
                            },
                            {
                                "example_id": "6ef99532-73df-4f9d-b7ad-b776c4bc9482",
                                "sense_id": "0621439a-e0db-3f37-b2a5-d30080279c19",
                                "text": "Je suis très heureux de voir que vous ne considérez pas le cigano comme du calô, qui (ce dernier), quoique très néo-latinisé, n'en est pas moins un dialecte indien."
                            }
                        ]
                    }
