                "senses": [
                    {
                        "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                        "entry_id": "3a151c5a-758b-3500-bea3-7741e1141dff",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06c9e6b-a315-484c-9478-bdbec1b92d35",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Frau Reichele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4bfd1428-91fb-4dab-8269-305a595a361d",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Herr Reichele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9df8b87b-45bf-4b0f-8abb-7534c732b063",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Die Reicheles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "04af87c8-0a58-45c3-aedc-2ff53712b605",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Der Reichele trägt nie die Schals, die die Reichele ihm strickt."
                            },
                            {
                                "example_id": "92268e7e-e759-4fa7-9bf7-e67e4762e233",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reichele kommt, geht der Herr Reichele.“"
                            },
                            {
                                "example_id": "1cec70c8-1d9c-4957-988d-6871d9603413",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Reichele kommt und geht."
                            },
                            {
                                "example_id": "ea3eef96-19f3-4d46-b634-a2afcfa0a799",
                                "sense_id": "ffa80977-ba55-3ff1-8966-254899d251eb",
                                "text": "Reicheles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
