                "senses": [
                    {
                        "sense_id": "80653c84-85aa-3698-a51a-bc67ff416d22",
                        "entry_id": "d8321197-46a4-37d5-8e76-adfd0afa3162",
                        "glosses": [
                            "gecamoufleerde kuil om mensen of dieren in te vangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505748d1-cd6c-4969-8796-711602bedf11",
                                "sense_id": "80653c84-85aa-3698-a51a-bc67ff416d22",
                                "text": "Kort nadat hij mij in Rangkas Betung had afgezet, is hij met zijn auto in een valkuil gereden. Normaal zitten de heren je daar op te wachten om je af te slachten, maar ditmaal waren ze het wachten moe geweest en naar huis gegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "247a48a5-90e4-3daa-8a94-c6fec541e622",
                        "entry_id": "d8321197-46a4-37d5-8e76-adfd0afa3162",
                        "glosses": [
                            "wat iemand tot fouten kan verleiden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "82bafb4e-ed3f-4c90-866d-9334c054b324",
                                "sense_id": "247a48a5-90e4-3daa-8a94-c6fec541e622",
                                "text": "Engels in een groep van verschillende nationaliteiten is inderdaad een valkuil voor versprekingen en je wordt genoodzaakt je te bedienen van een beperkte woordenschat."
                            }
                        ]
                    }
