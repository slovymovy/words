                                        "entry_id": "e2117f45-ddd3-3ff0-b4cc-94460d82d3ea",
                                        "glosses": [
                                            "Namensteil verschiedener Arten der Ohrenrobben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c366ec71-e5d9-4552-99f6-9c0c2c4d8392",
                                                "sense_id": "40885cb4-df59-3bf1-8e7a-54933f1def0f",
                                                "text": "Viele Seebären leben in der Nähe der Antarktis."
                                            },
                                            {
                                                "example_id": "bd255bbb-3912-4095-ab8f-9095c6139850",
                                                "sense_id": "40885cb4-df59-3bf1-8e7a-54933f1def0f",
                                                "text": "„Die große Population von Pelzrobben (Seebären) lockte in den 1820er Jahren britische Robbenjäger auf die Inseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eced0a60-f6b9-31cc-a85f-724743f09f96",
                                        "entry_id": "e2117f45-ddd3-3ff0-b4cc-94460d82d3ea",
                                        "glosses": [
                                            "robuster, erfahrener Seemann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ccbbe5f-c813-493d-8213-b22f5dac04cc",
                                                "sense_id": "eced0a60-f6b9-31cc-a85f-724743f09f96",
                                                "text": "Unser Kapitän war ein alter Seebär."
                                            },
                                            {
                                                "example_id": "f0148f75-8cfd-4be7-b33a-4592eafbac31",
                                                "sense_id": "eced0a60-f6b9-31cc-a85f-724743f09f96",
                                                "text": "„Der alte Seebär wiegte den Kopf hin und her und schob seinen Priem in die andere Backe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
