{
    "word_family": [
        "doggedness",
        "doggedly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b8759e7-3f72-3989-9e78-6454ab56ba07",
                    "sense_definition": "simple past and past participle of <w>dog</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "past_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective <w>dogged</w> his every move throughout the city.",
                            "target_lang_translations": {
                                "ru": "Детектив <w>выслеживал</w> каждый его шаг по всему городу.",
                                "pl": "Detektyw <w>śledził</w> każdy jego ruch w całym mieście."
                            }
                        },
                        {
                            "text": "The project was <w>dogged</w> by bad luck from the very beginning.",
                            "target_lang_translations": {
                                "ru": "Проект с самого начала <w>преследовало</w> невезение.",
                                "pl": "Projekt od samego początku był <w>nękany</w> pechem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма прошедшего времени и причастие прошедшего времени от глагола dog (преследовать, выслеживать)",
                        "pl": "forma czasu przeszłego i imiesłów bierny od czasownika 'dog' (śledzić, prześladować, nękać)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовал",
                                "target_lang_sense_clarification": "в значении идти по пятам"
                            },
                            {
                                "target_lang_word": "преследуемый",
                                "target_lang_sense_clarification": "в значении сопровождаемый чем-то неприятным"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "śledził",
                                "target_lang_sense_clarification": "w znaczeniu podążania za kimś krok w krok"
                            },
                            {
                                "target_lang_word": "nękany",
                                "target_lang_sense_clarification": "w znaczeniu bycia prześladowanym przez coś negatywnego"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08b0faf8-2e9c-3ed8-8787-3b549c2c18ce",
                    "sense_definition": "showing great determination and not giving up easily",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>dogged</w> determination eventually led her to win the championship.",
                            "target_lang_translations": {
                                "ru": "Ее <w>упорная</w> решимость в конечном итоге привела ее к победе в чемпионате.",
                                "pl": "Jej <w>wytrwała</w> determinacja ostatecznie doprowadziła ją do wygrania mistrzostw."
                            }
                        },
                        {
                            "text": "Despite many failures, he continued his <w>dogged</w> pursuit of the truth.",
                            "target_lang_translations": {
                                "ru": "Несмотря на многочисленные неудачи, он продолжал свое <w>неотступное</w> стремление к истине.",
                                "pl": "Pomimo wielu porażek, kontynuował swoje <w>nieustępliwe</w> dążenie do prawdy."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "tenacious",
                        "determined",
                        "resolute",
                        "steadfast"
                    ],
                    "antonyms": [
                        "irresolute",
                        "yielding",
                        "half-hearted"
                    ],
                    "common_phrases": [
                        "dogged determination",
                        "dogged pursuit",
                        "dogged persistence"
                    ],
                    "target_lang_definitions": {
                        "ru": "проявляющий большую решимость и не сдающийся легко; упорный",
                        "pl": "wykazujący wielką determinację i niepoddający się łatwo; wytrwały, uparty"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорный",
                                "target_lang_sense_clarification": "настойчивый в достижении цели"
                            },
                            {
                                "target_lang_word": "настырный",
                                "target_lang_sense_clarification": "чрезвычайно настойчивый, иногда до навязчивости"
                            },
                            {
                                "target_lang_word": "упёртый",
                                "target_lang_sense_clarification": "разговорное, о человеке, который твердо стоит на своем"
                            },
                            {
                                "target_lang_word": "неотступный",
                                "target_lang_sense_clarification": "о преследовании или поиске"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wytrwały",
                                "target_lang_sense_clarification": "cierpliwie dążący do celu"
                            },
                            {
                                "target_lang_word": "uparty",
                                "target_lang_sense_clarification": "trwający przy swoim, nieustępliwy"
                            },
                            {
                                "target_lang_word": "zawzięty",
                                "target_lang_sense_clarification": "skłonny do forsującego dążenia do celu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "38be9b13-e374-3c93-b7c2-ce660e3e2b75",
                    "sense_definition": "to a very great degree",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking all day, I became <w>dogged</w> tired and needed to rest.",
                            "target_lang_translations": {
                                "ru": "После целого дня ходьбы я <w>чертовски</w> устал, и мне нужно было отдохнуть.",
                                "pl": "Po całodniowym chodzeniu byłem <w>potwornie</w> zmęczony i musiałem odpocząć."
                            }
                        },
                        {
                            "text": "He was <w>dogged</w> hungry after missing both breakfast and lunch.",
                            "target_lang_translations": {
                                "ru": "Он был <w>ужасно</w> голоден, пропустив и завтрак, и обед.",
                                "pl": "Był <w>strasznie</w> głodny po pominięciu śniadania i obiadu."
                            }
                        }
                    ],
                    "synonyms": [
                        "very",
                        "extremely"
                    ],
                    "common_phrases": [
                        "dogged hungry",
                        "dogged tired"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly dialectal"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "в очень сильной степени; крайне (диалектное или разговорное)",
                        "pl": "w bardzo dużym stopniu; skrajnie (użycie potoczne lub dialektalne)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "разговорный усилитель"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "в значении очень сильно"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "potwornie",
                                "target_lang_sense_clarification": "w znaczeniu bardzo, skrajnie"
                            },
                            {
                                "target_lang_word": "strasznie",
                                "target_lang_sense_clarification": "potoczny wzmacniacz znaczenia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
