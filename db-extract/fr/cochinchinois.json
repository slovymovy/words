                        "entry_id": "c7b8fed4-eea3-344f-8c80-3ebd89e2dc50",
                        "glosses": [
                            "Qui a un rapport avec la Cochinchine ou ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0cd923-d321-465e-a65b-0deab79846b1",
                                "sense_id": "c768d8d6-6b75-3220-80c3-21c25ccdb415",
                                "text": "Le capitaine, ayant fait l’abandon de son navire, faute d’avoir obtenu des secours du gouvernement cochinchinois pour le réparer, le vendit pour compte des assureurs."
                            },
                            {
                                "example_id": "06296b44-af9e-4783-a60b-106ddfd2d642",
                                "sense_id": "c768d8d6-6b75-3220-80c3-21c25ccdb415",
                                "text": "mais le fleuve, se heurtant vers l’Ouest aux coulées du Haut-Chhlong, fait un coude brusque vers le Sud-Ouest, en direction de la plaine cochinchinoise."
                            }
                        ]
                    }
                ],
