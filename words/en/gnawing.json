{
    "word_family": [
        "gnaw"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8a72e67-1113-3015-a310-057faafaae39",
                    "sense_definition": "present participle and gerund of <w>gnaw</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>gnawing</w> on a large bone in the backyard.",
                            "target_lang_translations": {
                                "cs": "Pes na dvoře <w>ohlodával</w> velkou kost."
                            }
                        },
                        {
                            "text": "Constant <w>gnawing</w> at the wood caused the chair to break.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>hlodání</w> do dřeva způsobilo, že se židle rozbila."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gnawing on bone",
                        "gnawing at wood"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa hlodat nebo ohlodávat"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlodající",
                                "target_lang_sense_clarification": "vyjadřuje probíhající činnost hlodání"
                            },
                            {
                                "target_lang_word": "ohlodávání",
                                "target_lang_sense_clarification": "podstatné jméno slovesné označující proces"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c79f00bb-12c7-3580-9b73-3a1a7db2b32f",
                    "sense_definition": "severe or intense",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>gnawing</w> anxiety about the upcoming exam.",
                            "target_lang_translations": {
                                "cs": "Cítila <w>hlodavou</w> úzkost z nadcházející zkoušky."
                            }
                        },
                        {
                            "text": "The prisoner suffered from a <w>gnawing</w> hunger during the long winter.",
                            "target_lang_translations": {
                                "cs": "Vězeň během dlouhé zimy trpěl <w>žíravým</w> hladem."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "tormenting",
                        "unrelenting"
                    ],
                    "common_phrases": [
                        "gnawing hunger",
                        "gnawing anxiety",
                        "gnawing doubt"
                    ],
                    "target_lang_definitions": {
                        "cs": "intenzivní, trýznivý nebo neustupující pocit"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žíravý",
                                "target_lang_sense_clarification": "přenesený význam pro intenzivní, nepříjemný pocit"
                            },
                            {
                                "target_lang_word": "trýznivý",
                                "target_lang_sense_clarification": "vyjadřuje intenzivní psychickou nebo fyzickou bolest"
                            },
                            {
                                "target_lang_word": "hlodavý",
                                "target_lang_sense_clarification": "používá se pro pocity, které člověka vnitřně sužují"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a8e63dd-8238-3fb4-8ada-22045ac373a1",
                    "sense_definition": "a persistent, uncomfortable sensation or feeling",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not ignore the <w>gnawings</w> of his conscience after the argument.",
                            "target_lang_translations": {
                                "cs": "Po té hádce nemohl ignorovat <w>výčitky</w> svého svědomí."
                            }
                        },
                        {
                            "text": "The <w>gnawings</w> of starvation made it impossible for them to sleep.",
                            "target_lang_translations": {
                                "cs": "Kvůli <w>svírání</w> hladem nemohli spát."
                            }
                        }
                    ],
                    "synonyms": [
                        "pang",
                        "ache",
                        "twinge"
                    ],
                    "common_phrases": [
                        "gnawings of conscience",
                        "gnawings of hunger"
                    ],
                    "target_lang_definitions": {
                        "cs": "přetrvávající, nepříjemný vnitřní pocit nebo nutkání"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výčitky",
                                "target_lang_sense_clarification": "ve spojení s vědomím (svědomím)"
                            },
                            {
                                "target_lang_word": "svírání",
                                "target_lang_sense_clarification": "fyzický pocit úzkosti nebo hladu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b776b21-e715-3ca2-baaa-a75d1553a9b8",
                    "sense_definition": "the physical process of biting or chewing something repeatedly",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gnawings</w> of the mice left holes in the wooden floorboards.",
                            "target_lang_translations": {
                                "cs": "Po <w>hlodání</w> myší zůstaly v dřevěných podlahových prknech díry."
                            }
                        },
                        {
                            "text": "Constant <w>gnawings</w> by the beaver eventually brought the tree down.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>okusování</w> bobrem nakonec strom porazilo."
                            }
                        }
                    ],
                    "synonyms": [
                        "chewing",
                        "nibbling"
                    ],
                    "common_phrases": [
                        "gnawings of mice"
                    ],
                    "target_lang_definitions": {
                        "cs": "fyzický proces opakovaného kousání nebo okusování"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlodání",
                                "target_lang_sense_clarification": "obecný proces kousání zuby"
                            },
                            {
                                "target_lang_word": "okusování",
                                "target_lang_sense_clarification": "postupné ukusování malých kousků"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}