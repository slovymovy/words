                "senses": [
                    {
                        "sense_id": "563b957e-b9d2-3e1c-9a5d-e25b86c1e8f1",
                        "entry_id": "1694daa4-509e-3fc8-8447-4fd0a69afbfd",
                        "glosses": [
                            "To change something's properties by means of alchemy or as if by magic."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e7ba1e7-3d1a-4fc8-afcc-b3f5dbe80348",
                                "sense_id": "563b957e-b9d2-3e1c-9a5d-e25b86c1e8f1",
                                "text": "Their dearest wish was to alchemise iron into gold."
                            },
                            {
                                "example_id": "1c8651c6-4b3a-48f6-9da5-67ec41f44dda",
                                "sense_id": "563b957e-b9d2-3e1c-9a5d-e25b86c1e8f1",
                                "text": "Something about this gutsy, heartfelt drama from screenwriter Robert D Siegel and director Darren Aronofsky alchemises Rourke’s conceit into a terrifically engaging, likable and even vulnerable performance."
                            },
                            {
                                "example_id": "245142ea-5918-492c-97d8-0f211cdd8f12",
                                "sense_id": "563b957e-b9d2-3e1c-9a5d-e25b86c1e8f1",
                                "text": "In tonight's opener, Kevin McCloud revisits the programme's longest-running saga – the five-year (and counting) epic of Stefan Lepkowsky and Annia Shabowska, who have been attempting to alchemise a cutting-edge contemporary home from the unpromising base metal of a derelict mill cottage in Northamptonshire."
                            },
                            {
                                "example_id": "073af77a-8adc-4228-be2d-456b6fb3d7f6",
                                "sense_id": "563b957e-b9d2-3e1c-9a5d-e25b86c1e8f1",
                                "text": "Art should alchemise poetry from unexpected ingredients."
                            }
                        ]
                    }
                ],
