                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "steigerung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heute ist das Wetter <w>noch</w> besser als gestern."
                        },
                        {
                            "text": "Sein neues Auto ist schnell, aber deines fährt <w>noch</w> schneller."
