                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange event was quickly <w>newsed</w> about the small village.",
                            "target_lang_translations": {
                                "ru": "Весть о странном событии быстро <w>разнеслась</w> по маленькой деревне.",
                                "zh": "那件怪事很快在小村庄里<w>传开</w>了。"
                            }
                        },
                        {
                            "text": "They <w>newsed</w> the arrival of the foreign diplomat to all the local officials.",
                            "target_lang_translations": {
                                "ru": "Они <w>раструбили</w> о прибытии иностранного дипломата всем местным чиновникам.",
                                "zh": "他们向所有当地官员<w>通报</w>了外国外交官抵达的消息。"
                            }
                        }
                    ],
                    "synonyms": [
