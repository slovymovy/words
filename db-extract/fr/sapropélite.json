                "senses": [
                    {
                        "sense_id": "e8dcfd92-6919-3fcd-a3ad-ccc012bfa856",
                        "entry_id": "c64a2299-56db-34b5-b465-c3fe03665da1",
                        "glosses": [
                            "Roche carbonée constituée en milieu aquatique, marin ou lacustre, à partir de matériaux d’origine algale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e40ef55-c807-4f20-848d-c9919ee24e8c",
                                "sense_id": "e8dcfd92-6919-3fcd-a3ad-ccc012bfa856",
                                "text": "Elle importe en revanche les parures de sapropélite, de bronze et de verre [Salač 2012]."
                            },
                            {
                                "example_id": "24b780bf-c58a-4e5b-803d-4de0e1ebaa92",
                                "sense_id": "e8dcfd92-6919-3fcd-a3ad-ccc012bfa856",
                                "text": "Le vase en sapropélite de Saint-Gatien-des-Bois (La Tène D1, Calvados, Basse-Normandie) témoin d’échange entre la Bretagne insulaire et la Gaule. In M. Tuffreau-Libre, A. Jacques (dir.)."
                            },
                            {
                                "example_id": "79fd846e-772c-4572-9d82-8e14b218cf2b",
                                "sense_id": "e8dcfd92-6919-3fcd-a3ad-ccc012bfa856",
                                "text": "Un tel cas a été constaté, par exemple, en Bohême centrale dans une zone située à une trentaine de kilomètres au nord de l’oppidum de Stradonice, où on voit se développer la sidérurgie, associée au iiiᵉ siècle à la fabrication de bracelets en sapropélite, matière locale d’origine organique confondue souvent avec le lignite."
                            }
                        ]
                    }
