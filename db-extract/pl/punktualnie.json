                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d57401d3-6889-34db-890f-324abe7ebada",
                                        "entry_id": "364882bd-4d5f-3c1f-9d56-c0095079c25a",
                                        "glosses": [
                                            "zur vereinbarten Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5504874-c9a7-4c15-960c-cf7e7e34ce42",
                                                "sense_id": "d57401d3-6889-34db-890f-324abe7ebada",
                                                "text": "Du musst unbedingt pünktlich kommen, sonst verpasse ich den Höhepunkt!"
                                            },
                                            {
                                                "example_id": "88925c83-a16e-4d4b-8915-a724aae4d789",
                                                "sense_id": "d57401d3-6889-34db-890f-324abe7ebada",
                                                "text": "„Mit einem Wort, wir sandten ihr fünftausend Pfund in guten Wechseln, und sie erhielt sie sehr pünktlich.“"
                                            },
                                            {
                                                "example_id": "f1ec47f9-becc-4d7f-a471-45756ffd431a",
                                                "sense_id": "d57401d3-6889-34db-890f-324abe7ebada",
                                                "text": "[Japanische Züge:] „»Es ist doch eine Selbstverständlichkeit, dass die Bahn pünktlich ist. Die Mitarbeiterinnen und Mitarbeiter arbeiten professionell, deshalb ist sie auch so pünktlich. Selbst wenn der Zug nur eine Minute verspätet ist, dann entschuldigt man sich dafür, das ist normal hier.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79543105-9d15-3fb7-a06c-bb25e9859627",
                                        "entry_id": "364882bd-4d5f-3c1f-9d56-c0095079c25a",
                                        "glosses": [
                                            "genau befolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7699a0b-6806-4c36-8af0-2d4ff84316cc",
                                                "sense_id": "79543105-9d15-3fb7-a06c-bb25e9859627",
                                                "text": "Was auch immer [nach dem Brexit] passiert: [Der Leiter der Logistik] ist dafür verantwortlich, dass dann weiterhin Autoteile pünktlich ins Werk nach Oxford geliefert werden, […]"
                                            },
                                            {
                                                "example_id": "2fff79c4-a259-4462-a90f-e37252573b7f",
                                                "sense_id": "79543105-9d15-3fb7-a06c-bb25e9859627",
                                                "text": "Ich erwarte mir eine pünktliche Befolgung meiner Anweisungen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
