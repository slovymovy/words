                        ],
                        "form": "paléolithiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4b8d6f3-93f0-3bb1-9f15-fd2b22a657f4",
                        "entry_id": "0dcd74cf-6c56-3aac-8058-61aa5dd6b364",
                        "glosses": [
                            "Qui se rapporte à l’âge de la pierre éclatée ou taillée."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "4e67e720-e5c6-404d-ab63-72549ea118a0",
                                "sense_id": "a4b8d6f3-93f0-3bb1-9f15-fd2b22a657f4",
                                "text": "Le cours de cette année a poursuivi l'étude des moyens d’expression de l'espace dans l’art paléolithique et, par confrontation, dans différents arts rupestres postérieurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b71a76d3-2864-4df0-8fba-ac20aa44a737",
                        "source_entry_id": "0dcd74cf-6c56-3aac-8058-61aa5dd6b364",
                        "source_sense_id": "a4b8d6f3-93f0-3bb1-9f15-fd2b22a657f4",
                        "target_lang_word": "paläolithisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paläolithisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa49d93-d412-3bcc-a9e9-f68a621f8fa8",
                                        "entry_id": "dafc014a-4dde-3962-b26c-b91174d1bbbf",
                                        "glosses": [
                                            "das Paläolithikum betreffend, zu ihm gehörend, in/während der Altsteinzeit"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e4435f-80e9-43a2-bc36-1123b6950cad",
                                                "sense_id": "4aa49d93-d412-3bcc-a9e9-f68a621f8fa8",
                                                "text": "„Die paläolithische Ernährung besteht überwiegend aus naturbelassenen pflanzlichen Lebensmitteln, Eiern und magerem Fleisch und verzichtet völlig auf Getreide und Milchprodukte.“"
                                            },
                                            {
                                                "example_id": "48187c54-3303-4d87-bb64-d11b8aa88061",
                                                "sense_id": "4aa49d93-d412-3bcc-a9e9-f68a621f8fa8",
                                                "text": "„Aber der erste Blick täuscht: die Großskultptur ist paläolithisch und weist ein Alter von sicherlich mehreren Jahrzehntausenden auf.“"
                                            },
                                            {
                                                "example_id": "6a6bc3f2-7299-4ab0-9187-398472ec1fc6",
                                                "sense_id": "4aa49d93-d412-3bcc-a9e9-f68a621f8fa8",
                                                "text": "„1956 entdeckten Speleologen einen menschlichen Schädel, dessen Alter als paläolithisch eingestuft wurde, und einige weitere Menschen- und Braunbärenknochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a91fdd5-a200-418e-892d-4ce438f4d43b",
                        "source_entry_id": "0dcd74cf-6c56-3aac-8058-61aa5dd6b364",
                        "source_sense_id": "a4b8d6f3-93f0-3bb1-9f15-fd2b22a657f4",
                        "target_lang_word": "altsteinzeitlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altsteinzeitlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71a2f136-239f-3f06-9b2c-fe55b7ee65d3",
                                        "entry_id": "d802bd03-69c2-3d3d-a555-2e30a2ed65fd",
                                        "glosses": [
                                            "die Altsteinzeit betreffend, zu ihr gehörend, in/während der Altsteinzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6b53dc-5236-4d9b-89ac-a53fa479978f",
                                                "sense_id": "71a2f136-239f-3f06-9b2c-fe55b7ee65d3",
                                                "text": "„Die Lebensweise des altsteinzeitlichen Menschen war die des Jägers und Sammlers.“"
                                            },
                                            {
                                                "example_id": "db730b47-1719-48f0-a9dc-655252954a8d",
                                                "sense_id": "71a2f136-239f-3f06-9b2c-fe55b7ee65d3",
                                                "text": "„Schon die altsteinzeitlichen Jäger und Sammler waren im Grunde ‚biologisch fertige‘, moderne Menschen – mit allen Universalien, die auch heutige Menschen charakterisieren.“"
                                            },
                                            {
                                                "example_id": "b5710c19-f06b-4724-8e65-c89c39726927",
                                                "sense_id": "71a2f136-239f-3f06-9b2c-fe55b7ee65d3",
                                                "text": "„Die erste Erforschung des generellen Vorkommens natürlich auftretender Klänge in den altsteinzeitlich ausgemalten Höhlen in Frankreich und Spanien verdanken wir der belgischen Archäologin Lya Dams (Dams 1985).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54beddff-702e-442d-b5a2-35c4358114fd",
                        "source_entry_id": "0dcd74cf-6c56-3aac-8058-61aa5dd6b364",
