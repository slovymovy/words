                    {
                        "sense_id": "75511be4-d5dc-37f6-b38c-7e994a522a70",
                        "entry_id": "86ab74f0-7203-3d0a-ad3b-3b40499f2ea2",
                        "glosses": [
                            "Quatre-vingt-trois plus un, adjectif numéral cardinal correspondant au nombre 84."
                        ],
                        "tags": [
                            "Antéposé"
                        ],
                        "examples": [
                            {
                                "example_id": "0ccc34f7-5644-41f4-aba1-01738dc580e8",
                                "sense_id": "75511be4-d5dc-37f6-b38c-7e994a522a70",
                                "text": "À quatre-vingt-quatre ans, que peut-on bien encore attendre de la vie ?"
                            },
                            {
                                "example_id": "00d86d95-b150-4428-8683-cef87fda9ca3",
                                "sense_id": "75511be4-d5dc-37f6-b38c-7e994a522a70",
                                "text": "Lorsque Dave Gallaher, l’un des quatre sélectionneurs des All Blacks, arrive sous la pluie diluvienne de Wellington le 15 mai 1910, ses trois partenaires co-sélectionneurs, Meredith de Wellington, Wilson de Christchurch et Harris de Dunedin, ont déjà sous les yeux une liste de quatre-vingt-quatre gars qui sont proposés par les seize associations de rugby affiliées à la fédération pour représenter la prestigieuse sélection."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb91b5a5-9eba-39a7-9954-b894187253ae",
                        "entry_id": "86ab74f0-7203-3d0a-ad3b-3b40499f2ea2",
                        "glosses": [
                            "Quatre-vingt-quatrième, 84ᵉ."
                        ],
                        "tags": [
                            "Postposé"
                        ],
