                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "292d0675-3dd9-4102-a6bc-bad2ba0fb3a9",
                                "sense_id": "37f08782-b2fd-37fb-b03c-556973fff9ce",
                                "text": "Hij voer enige tijd met hen mee."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ad5b5c2-17fd-32cf-aa5b-5356bede5eea",
                        "entry_id": "5b195986-c742-32f5-ba4c-45635a43ee86",
                        "glosses": [
                            "prepositioneel deel van een voornaamwoordelijk bijwoord van het voorzetsel met"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa84a0e8-0d02-4b89-9989-0aaaf725ba02",
                                "sense_id": "6ad5b5c2-17fd-32cf-aa5b-5356bede5eea",
                                "text": "Hij heeft er weinig mee weten te bereiken."
                            },
                            {
                                "example_id": "18f3407b-3702-4618-8b80-48597fcee81b",
                                "sense_id": "6ad5b5c2-17fd-32cf-aa5b-5356bede5eea",
                                "text": "In een interview in 2009 met Mare zei Buikhuisen dat hij nog altijd last had van de affaire. Hij zei nog elke keer te hopen op een verontschuldiging als hij post kreeg van de universiteit. \"Dat ze gewoon een beetje erkennen: we zijn toch wel tekortgeschoten. Ik zou daar heel blij mee zijn.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
