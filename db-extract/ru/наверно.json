        "ru-extract.jsonl": [
            {
                "entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                "word": "наверно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ae362d3b-91c9-3f64-a056-fb1909d2dcab",
                        "entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                        "glosses": [
                            "устар. точно, несомненно, определённо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ed5470-8bcd-4d0d-837e-6d829c7b8b04",
                                "sense_id": "ae362d3b-91c9-3f64-a056-fb1909d2dcab",
                                "text": "— Я ничего и не боюсь, Марго, — вдруг ответил ей мастер и поднял голову и показался ей таким, каким был, когда сочинял то, чего никогда не видел, но о чём наверно знал, что оно было."
                            }
                        ]
                    },
                    {
                        "sense_id": "48dca366-1e6d-3b25-bf45-1d8bee72d765",
                        "entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                        "glosses": [
                            "вводн. сл., : предположительно, по всей вероятности"
                        ],
                        "tags": [
                            "на письме выдел. запятыми"
                        ],
                        "examples": [
                            {
                                "example_id": "b0c0a8be-f5cc-477b-af51-609044b6f114",
                                "sense_id": "48dca366-1e6d-3b25-bf45-1d8bee72d765",
                                "text": "Пожалуй, тем следовало спасаться, подумал кригсман, но тут же и усомнился в своей, наверно, не очень военной мысли."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9e05060-3783-42d1-b9b3-e61c78ac85c3",
                        "source_entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                        "source_sense_description": "несомненно",
                        "target_lang_word": "for sure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for sure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                        "entry_id": "3791d9ef-d657-3a4f-a976-f366e36a8db5",
                                        "glosses": [
                                            "Definitely, positively, without a doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3baf880-b75f-467e-9fbb-91a72d0298eb",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "I would buy one of those for sure."
                                            },
                                            {
                                                "example_id": "fb139a2d-6e3d-4c53-aac8-3c296ca1d7cb",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "Did you enjoy the concert? —For sure."
                                            },
                                            {
                                                "example_id": "014b2d15-e2dc-4523-b672-bf4ae1f6f4d8",
                                                "sense_id": "9145809d-1989-3581-9834-f38e00775dab",
                                                "text": "Yet strictly we should all be teapot agnostics: we cannot prove, for sure, that there is no celestial teapot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed9eff4a-bbc8-4e79-943a-3bcc6ae6e6d0",
                        "source_entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                        "source_sense_description": "несомненно",
                        "target_lang_word": "certainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "In a way which is certain; with certainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d57d5d-7e5a-4160-9e91-43ef23e26163",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "he verily thought he had young live frogs in his belly, qui vivebant ex alimento suo, that lived by his nourishment, and was so certainly persuaded of it, that for many years following he could not be rectified in his conceit."
                                            },
                                            {
                                                "example_id": "acad7d4d-3217-4638-bf27-04d0a5664d95",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "The torque was \"built up\" in the special back axle and the car crawled tankwise but very certainly over the obstacles without a jar or hesitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "Without doubt, surely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f5edfd-a190-46a3-b3d7-c40fc07f1c6f",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "The accident was certainly caused by human error."
                                            },
                                            {
                                                "example_id": "c6e95e92-978c-49ae-9844-6e3da1e1bab4",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "That was certainly sweet of him."
                                            },
                                            {
                                                "example_id": "72e8830c-37fa-428a-a001-0713feed9d07",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "'I'm all grown up now' -'You certainly have (grown)!'"
                                            },
                                            {
                                                "example_id": "d45ba451-4f5d-428c-9d74-ab88e2d6ec73",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "b27e5847-2b91-4193-81d0-5d87b301fe6d",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "An emphatic affirmative answer; of course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f25142-62b5-44da-806f-561c4542c5e9",
                                                "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                                "text": "Would you like it with ice?  Certainly, and with lemon please."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e7d05b-6199-4104-a68f-c4db12d26978",
                        "source_entry_id": "efa05d30-75e7-3e6b-b762-9ea40f70630e",
                        "source_sense_description": "вероятно",
                        "target_lang_word": "probably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                        "entry_id": "9bf83edc-da60-354a-a451-2e5a06dcde06",
                                        "glosses": [
                                            "In all likelihood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0771d08f-2890-4085-91bd-2db9514ceacc",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He probably will arrive tomorrow."
                                            },
                                            {
                                                "example_id": "a8f6ab86-a241-4e97-a094-9f79f409cd5e",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably he'll arrive tomorrow."
                                            },
                                            {
                                                "example_id": "c64c27a4-3184-4fcf-befb-c946c4605a67",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It is probably too late for amends."
                                            },
                                            {
                                                "example_id": "4dcfb15c-72e1-442f-a97d-d7ef680beedd",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It probably is too late for amends."
                                            },
                                            {
                                                "example_id": "f19817ff-0a76-493f-8ca5-5737e843fc2a",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She probably has arrived by now."
                                            },
                                            {
                                                "example_id": "8018e839-ce26-418c-8b1b-b20d909e3c46",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She has probably arrived by now."
                                            },
                                            {
                                                "example_id": "dd514415-8f91-4104-b79e-37b1bf925ff1",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably she has arrived by now."
                                            },
                                            {
                                                "example_id": "36c31054-dc7f-464a-be9d-298b0be2fd9d",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He'll probably arrive tomorrow."
                                            },
                                            {
                                                "example_id": "549698ed-29d3-43bd-8710-acfb4ef08179",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably it is too late for amends."
                                            },
                                            {
                                                "example_id": "39796ad0-3c6a-440f-844a-39326eaa5e02",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "90162654-b440-4543-9e91-ed126046e67b",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
