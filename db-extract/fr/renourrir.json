                                        "sense_id": "869b551c-4728-3aaf-a459-2e8ea965703a",
                                        "entry_id": "7d563d3d-83da-3b9e-8aa7-0a17547317ce",
                                        "glosses": [
                                            "To feed (a person or organism) again, especially after a period of starvation or malnourishment."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c253105-b27c-4315-8926-4bdebbe2973a",
                                                "sense_id": "869b551c-4728-3aaf-a459-2e8ea965703a",
                                                "text": "The group of volunteers who received a relatively small increment in calories during refeeding (400 calories more than during semistarvation) had no rise in BMR for the first 3 weeks."
                                            },
                                            {
                                                "example_id": "77309029-1341-42b6-87e1-ac9360c62ec7",
                                                "sense_id": "869b551c-4728-3aaf-a459-2e8ea965703a",
                                                "text": "It's natural if you are coming out of a dieted state to see a rapid surge in appetite as you begin refeeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0667d7c-9719-32ac-9293-422d0a35a473",
                                        "entry_id": "7d563d3d-83da-3b9e-8aa7-0a17547317ce",
                                        "glosses": [
                                            "To feed (material) back into a machine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
