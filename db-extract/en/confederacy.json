    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                "word": "Confederacy",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cac88f95-68b1-4f9a-b23c-b539a5e65551",
                        "entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                        "tags": [
                            "canonical"
                        ],
                        "form": "the Confederacy"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                        "entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                        "glosses": [
                            "The Confederate States of America, the collection of American states that seceded from the United States in 1860–61, and fought against the Union in the American Civil War."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "af768a76-a798-4213-ab73-5a86f8b18fda",
                                "sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                                "text": "Christmas of 1862 had been a happy one for Atlanta, for the whole South. The Confederacy had scored a smashing victory at Fredericksburg and the Yankee dead and wounded were counted in the thousands."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54693dc0-93b5-4b9c-b1f2-7508dba19cee",
                        "source_entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                        "source_sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                        "source_sense_description": "Confederate States of America",
                        "target_lang_word": "Confédération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Confédération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebc90fe7-7d27-3475-a279-3fec3423b39b",
                                        "entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                                        "glosses": [
                                            "Coalition d'États du sud des États-Unis ayant cherché à se séparer du reste du pays lors de la guerre de Sécession (1861-1865)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0bc943-8400-4e1c-8893-9503c4379ef4",
                                                "sense_id": "ebc90fe7-7d27-3475-a279-3fec3423b39b",
                                                "text": "Aux États-Unis, il faut attendre la défaite des forces de la Confédération au cours de la guerre de Sécession pour que les dispositions anti-esclavagistes de la constitution de 1791 ne s'étendent à l'ensemble du territoire désormais unifié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac8cb7a-619a-3c94-99cf-acbb867c6fa6",
                                        "entry_id": "6138254f-e3d8-3dc3-b94c-44993e7c0293",
                                        "glosses": [
                                            "Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3a090a-77eb-41f2-92c4-c77fb78b3f95",
                                                "sense_id": "5ac8cb7a-619a-3c94-99cf-acbb867c6fa6",
                                                "text": "L’emploi de la croix suisse est interdit lorsqu’il est propre à faire croire à de prétendus rapports avec la Confédération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b4369fa-a5e4-4e33-b1eb-11209dc472c8",
                        "source_entry_id": "e89441f9-65c8-3109-bb0d-b1af51610efc",
                        "source_sense_id": "7a400a6d-09a7-363d-86d5-36c8b2463049",
                        "source_sense_description": "Confederate States of America",
                        "target_lang_word": "Konföderation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konföderation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0939abe-12fd-3b71-8e5c-1e7fb10eb53b",
                                        "entry_id": "5117b03f-9804-3314-8a99-b8f1c512ca76",
                                        "glosses": [
                                            "Zusammenschluss selbständiger politischer Gebietseinheiten, vor allem von Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385890fe-2d96-4e4b-b11a-eba9d7d0f129",
                                                "sense_id": "a0939abe-12fd-3b71-8e5c-1e7fb10eb53b",
                                                "text": "„Kasavubu macht sich für seine Heimatregion stark, den Bas-Congo, ein Gebiet im Westen des Riesenlandes, er will allenfalls eine Konföderation der Stammesgebiete, orientiert an den einzelnen Ethnien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                "word": "confederacy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d0eb2826-7aaa-4bba-8c74-7fdae790dc1b",
                        "entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                        "tags": [
                            "plural"
                        ],
                        "form": "confederacies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dffe4446-0566-38ae-9728-680091887524",
                        "entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                        "glosses": [
                            "An alliance."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5564e137-e0e5-322a-9f38-e09115fca844",
                        "entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                        "glosses": [
                            "A state where the sovereign constituent units delegate their authority to the centre. As opposed to a federation, where the central and regional governments are each equal and sovereign in their own sphere."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7632996b-8d3a-3acf-932b-1a91b7cc5513",
                        "entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                        "glosses": [
                            "Specifically, an instance of a decentralized governing structure among the indigenous peoples of North America."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92aff21a-d48a-4bff-8357-568c072a8a28",
                                "sense_id": "7632996b-8d3a-3acf-932b-1a91b7cc5513",
                                "text": "The Blackfoot, Iroquois, and Sioux peoples all were governed as confederacies. There were also multi-ethnic confederacies, such as the Iron Confederacy made up of the Plains Cree, Assiniboine, Stoney, and Saulteaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7bfaac5-da99-47df-a212-023e5cfc2ca1",
                        "source_entry_id": "1da0696a-7dfb-396e-830d-b441ac027a0e",
                        "source_sense_description": "an alliance",
                        "target_lang_word": "confédération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confédération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Union entre divers États, ou provinces d’un État, qui s’associent sans créer un État fédéral et qui maintiennent leur autonomie (procédure d’unanimité ou véto)."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43523500-36bf-41d6-a43f-137674541193",
                                                "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                                "text": "De tous les États qui forment la vaste confédération mexicaine, l’État de Sonora est le seul qui, […], ait conservé une physionomie à part."
                                            },
                                            {
                                                "example_id": "45bb52bc-7977-4cfb-8aed-e7ba92b529fb",
                                                "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                                "text": "Dans une confédération, les États gardent leur souveraineté et sont reconnus comme tels. Dans une fédération, même si les États demeurent autonomes dans leur sphère de juridiction, seul l’État central jouit de cette reconnaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Regroupement flexible de différentes entités politiques, parfois de manière temporaire pour faire face à une menace commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd5a1f8-8987-4822-a9c1-2fc4b4ae6ffe",
                                                "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                                "text": "Le département du Doubs était occupé, pendant la période celtique, par les Séquanes, qui formaient une des plus puissantes confédérations de la Gaule et qui prirent part aux expéditions des Gaulois en Italie et dans la vallée du Danube."
                                            },
                                            {
                                                "example_id": "c8e4f616-ee58-4453-b99b-9dd812127185",
                                                "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                                "text": "La confédération béotienne, à l’inverse des ligues péloponnésiennes ou athéniennes, ne semble pas avoir d’abord été une symmachie, mais bien plutôt se rattacher à ces Koina qui rassemblaient autour d’un sanctuaire les cités d’un même ethnos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Groupe constitué en vue de la défense d’intérêts communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6da8e4-b3f3-42c2-8fd0-44d2f8ea1a33",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération générale du Travail."
                                            },
                                            {
                                                "example_id": "5eb14056-b190-4833-8ba7-0e4afc0ab982",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération luxembourgeoise du Commerce."
                                            },
                                            {
                                                "example_id": "7f7b7227-024e-4630-ac35-20d46621baff",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération des provinces et territoires du Canada (1867)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
