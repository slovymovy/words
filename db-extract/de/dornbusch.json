                ],
                "senses": [
                    {
                        "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                        "entry_id": "610221ed-465e-3791-a688-f2f7fa21b238",
                        "glosses": [
                            "ein Busch oder ein Strauch mit Dornen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ef43b0c-c113-46ce-ae1a-095b832af4e0",
                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                "text": "„Beiras bewohnen in kleinen Rudeln trockenes, steiniges Berg- u. Hügelland mit niedrigen Dornbüschen in Somalia (Afrika).“"
                            },
                            {
                                "example_id": "3555454b-3453-4b5e-a872-4a16c10e5275",
                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                "text": "„Durch teils bergiges Gelände, mit Dornbüschen bewachsene Steppen und bewaldetes Gebiet dringt er nun immer weiter nach Westen vor.“"
                            },
                            {
                                "example_id": "583911ef-eef1-486f-8543-fd0e0678ec84",
                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                "text": "„Er fand die Stiefel zwischen Plunder und versteckte sie unter einem Dornbusch vierzehn Tage lang, ehe er weglief.“"
                            },
                            {
                                "example_id": "11ec3e83-7619-45a3-b63a-7a0aec74807e",
                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                "text": "„Ein blühender Dornbusch breitete seine rosa Rispen aus, und schwer hingen die Fliederdolden herab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
