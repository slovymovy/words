                    "sense_definition": "Verschillende stoffen of dingen door elkaar doen zodat ze één geheel worden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de boter en de suiker goed <w>mengen</w>.",
                            "target_lang_translations": {
                                "en": "You must <w>mix</w> the butter and the sugar well.",
                                "ru": "Нужно хорошо <w>смешать</w> масло с сахаром.",
                                "pl": "Musisz dobrze <w>wymieszać</w> masło i cukier.",
                                "de": "Du musst die Butter und den Zucker gut <w>verrühren</w>.",
                                "fr": "Il faut bien <w>mélanger</w> le beurre et le sucre.",
                                "it": "Devi <w>mescolare</w> bene il burro e lo zucchero.",
                                "cs": "Musíš máslo a cukr dobře <w>promíchat</w>.",
                                "tr": "Tereyağı ve şekeri iyi <w>karıştırmalısın</w>.",
                                "es": "Debes <w>mezclar</w> bien la mantequilla y el azúcar."
                            }
                        },
                        {
                            "text": "De schilder <w>mengde</w> rood en wit om roze te krijgen.",
                            "target_lang_translations": {
                                "en": "The painter <w>mixed</w> red and white to get pink.",
                                "ru": "Художник <w>смешал</w> красный и белый, чтобы получить розовый.",
                                "pl": "Malarz <w>zmieszał</w> czerwony i biały, aby uzyskać różowy.",
                                "de": "Der Maler <w>mischte</w> Rot und Weiß, um Rosa zu erhalten.",
                                "fr": "Le peintre a <w>mélangé</w> le rouge et le blanc pour obtenir du rose.",
                                "it": "Il pittore <w>ha mischiato</w> il rosso e il bianco per ottenere il rosa.",
                                "cs": "Malíř <w>smíchal</w> červenou a bílou, aby získal růžovou.",
                                "tr": "Ressam, pembe elde etmek için kırmızı ve beyazı <w>karıştırdı</w>.",
                                "es": "El pintor <w>mezcló</w> rojo y blanco para obtener rosa."
                            }
                        }
                    ],
