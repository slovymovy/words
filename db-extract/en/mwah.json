                                        "entry_id": "49b611ec-269d-31c5-ae1d-db60233193b3",
                                        "glosses": [
                                            "한국에서 시집을 간 여자가 머리카락을 뒤로 빗은 다음 둥글게 말아 올려 비녀를 꽂은 것."
                                        ],
