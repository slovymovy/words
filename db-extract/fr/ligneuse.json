                        "glosses": [
                            "Celle qui, sur les vaisseaux moruyers, pêche avec des lignes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0d330f-e674-4dc1-9752-f3e3d83c1d05",
                                "sense_id": "3e140afa-1a34-3b0f-85c0-d4781eabc8b7",
                                "text": "Anne-Marie est une ligneuse. A bord de son petit bateau de moins de 12 mètres, elle pêche le merlu à la palangre, cette longue ligne garnie de centaines d'hameçons traînée par le palangrier."
                            },
                            {
                                "example_id": "04736927-1cc0-4b1c-9a00-bba48837fb9f",
                                "sense_id": "3e140afa-1a34-3b0f-85c0-d4781eabc8b7",
                                "text": "« En tout cas, tu consta­teras qu’on ne fait pas trop de mal à la ressource pour l’instant », plaisante la ligneuse en retirant les étoiles de mer qui squattent ses hameçons…"
                            }
                        ]
                    }
