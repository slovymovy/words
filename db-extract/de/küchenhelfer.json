                ],
                "senses": [
                    {
                        "sense_id": "cf0bbe8d-648a-38dc-8d2c-eb872b17f810",
                        "entry_id": "50d66cba-c076-38b2-a0ef-526ea509cdf7",
                        "glosses": [
                            "Person, die beruflich in einer Küche hilft und dem Koch zuarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7c0a84-7a34-4246-b952-861fba58b81d",
                                "sense_id": "cf0bbe8d-648a-38dc-8d2c-eb872b17f810",
                                "text": "„Die Küchenhelfer stellen Schüsseln voll Fleisch auf den Tisch.“"
                            },
                            {
                                "example_id": "fc75007d-c0d2-4314-a6ae-cd1acc78b315",
                                "sense_id": "cf0bbe8d-648a-38dc-8d2c-eb872b17f810",
                                "text": "„Auch er war Küchenhelfer im Waisenhaus – bis auch er, wie schon deine Mutter, der Somorra-Droge Somorin verfiel und sich vor ein paar Tagen eine Überdosis setzte.“"
                            },
                            {
                                "example_id": "5a811794-f801-4573-9fa4-25dd3e39ac80",
                                "sense_id": "cf0bbe8d-648a-38dc-8d2c-eb872b17f810",
                                "text": "„Ein Küchenhelfer schneidet die Zutaten für einen Gemüseeintopf, während eine junge Frau Löffel und Schüsseln zusammensucht und zählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5f1ce0d-6e76-3445-abe0-2b16a1d1c955",
                        "entry_id": "50d66cba-c076-38b2-a0ef-526ea509cdf7",
                        "glosses": [
                            "in der Küche verwendetes Werkzeug zum Zubereiten von Speisen oder Getränken"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c978076d-627c-4cd9-84db-cf104381fe90",
                                "sense_id": "c5f1ce0d-6e76-3445-abe0-2b16a1d1c955",
                                "text": "„Diese Küchenhelfer werden aus Kunststoff oder Edelstahl angeboten.“"
                            },
                            {
                                "example_id": "28f5c630-2b1c-4c55-97e3-18bd361f50e2",
                                "sense_id": "c5f1ce0d-6e76-3445-abe0-2b16a1d1c955",
                                "text": "„Die wichtigsten Lebensmittel sollten immer in Reichweite sein, genauso wie die Küchenhelfer, die du häufig benutzt.“"
                            },
                            {
                                "example_id": "19c73303-7fe1-42ec-81a6-7e74f5d8c813",
                                "sense_id": "c5f1ce0d-6e76-3445-abe0-2b16a1d1c955",
                                "text": "„Sämtliche Küchenhelfer wie die Schaumkelle müssen absolut frei von Wasserrückständen sein, sonst gibt es heftige explosionsartige Verbrennungen!“"
                            },
                            {
                                "example_id": "6d2d7156-2723-4855-a765-74a497399d92",
                                "sense_id": "c5f1ce0d-6e76-3445-abe0-2b16a1d1c955",
                                "text": "„Jedes Kaufhaus führt auch Küchenhelfer aus Glas, Holz und Metall, mit denen Sie nach und nach Ihre Plastikprodukte ersetzen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
