                "senses": [
                    {
                        "sense_id": "c55d56b9-813c-379e-af05-f75bf97dc018",
                        "entry_id": "3eb97870-ec9d-3310-83e9-69aa657b28d6",
                        "glosses": [
                            "Produire une copie avec un Photostat ou appareil à Photostat, système de reprographie développé dans les années 1900."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7bce1388-60d9-41cf-8c64-89f0c00b7262",
                                "sense_id": "c55d56b9-813c-379e-af05-f75bf97dc018",
                                "text": "Falk poussait une porte qu’il ne refermait pas derrière lui et on découvrait une pièce étroite, une ancienne cuisine ou une ancienne salle de bains où, sur une table de bois blanc, se trouvait un appareil à photostater."
                            },
                            {
                                "example_id": "c9b40b67-cbf6-43a8-9a02-d3090968a22b",
                                "sense_id": "c55d56b9-813c-379e-af05-f75bf97dc018",
                                "text": "L’A. a « photostaté » des moments de vie, des caractères, des gestes, des facettes de la société, des qualités et des défauts de personnages sans nom à qui le tourbillon de la vie enlève le loisir de réfléchir ou inculque le sens de la ferveur."
                            }
                        ]
                    }
