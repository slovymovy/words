                "senses": [
                    {
                        "sense_id": "cbba977d-972a-396f-9f78-99a2068b3452",
                        "entry_id": "4cbec399-85df-3b0b-b8b9-4812cf5105bc",
                        "glosses": [
                            "weibliche Person, die einen Hund zur Haustierhaltung besitzt, die sich einen Hund hält"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "def9deea-62c0-4a41-99f2-f83a48cd44bb",
                                "sense_id": "cbba977d-972a-396f-9f78-99a2068b3452",
                                "text": "«Die meisten sind passionierte Hündelerinnen, die, angefangen mit der Welpenspielgruppe, einen Erziehungskurs nach dem andern absolviert haben.»"
                            },
                            {
                                "example_id": "0cb0567d-3ce5-47de-9c43-e9f3bf8d5839",
                                "sense_id": "cbba977d-972a-396f-9f78-99a2068b3452",
                                "text": "«Es kam zur verbalen Auseinandersetzung: Die Biker nervten sich offenbar über die intolerante Hündelerin, und Knecht echauffierte sich darüber, dass die Biker Spaziergängern den letzten freien Raum rauben.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
