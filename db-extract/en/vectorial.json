                                            },
                                            {
                                                "example_id": "565c009e-41f9-4983-a1c7-18b0960b6cc6",
                                                "sense_id": "8eec5e0f-1ccf-3f63-9418-e8aeea508adf",
                                                "text": "La démonstration du théorème de la médiane fournit l’occasion de travailler le calcul vectoriel en lien avec le produit scalaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea0739d-fb1d-32f2-8134-997ed07d59eb",
                                        "entry_id": "584a1abf-8198-3b8e-bace-cfa3e24d4a10",
                                        "glosses": [
                                            "Qui n’est pas défini par des pixels, mais par une liste de points reliés entre eux par des droites."
                                        ],
