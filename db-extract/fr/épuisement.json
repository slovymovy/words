        "fr-extract.jsonl": [
            {
                "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                "word": "épuisement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ca03c26-bf57-461b-b1b5-62983a6cc256",
                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                        "tags": [
                            "plural"
                        ],
                        "form": "épuisements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da936678-7527-3612-8636-1400d278819e",
                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                        "glosses": [
                            "Action d’épuiser, en tout ou en partie, les eaux amassées en un endroit ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7c2cd5-c3d6-4127-bbdf-fbe2f5cc62db",
                                "sense_id": "da936678-7527-3612-8636-1400d278819e",
                                "text": "On travaille depuis plusieurs jours à l’épuisement des eaux de la mine."
                            },
                            {
                                "example_id": "b0831033-2947-427a-ad02-14ce9df4b96f",
                                "sense_id": "da936678-7527-3612-8636-1400d278819e",
                                "text": "Au bout du canal se dressait la tour d’un moulin à épuisement, dont les ailes au repos ressemblaient, avec leurs nervures noires, à des ailes de libellule grossies plusieurs milliers de fois par le microscope solaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                        "glosses": [
                            "Perte considérable de telle ou telle partie des forces de l’organisme et en général dissipation de forces."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "21963b82-0114-4d46-8232-383220f4e1fd",
                                "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                                "text": "Les soins des deux femmes ne tardèrent pas à ranimer entièrement la jeune Esquimaude, dont l’extrême épuisement provenait non seulement de la fatigue, mais aussi de la faim."
                            },
                            {
                                "example_id": "f62aa569-253e-44a2-8947-b8fed3bcf35b",
                                "sense_id": "13b0c812-8a5c-3cb4-94d1-c506d1cde8d0",
                                "text": "En plus du mal de mer, les rescapés souffraient de déshydratation, d'épuisement, de sérieux coups de soleil et portaient également les séquelles d’un stress psychologiques grave lié à la peur de périr en mer pendant quatre jours et quatre nuits."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7c443d0-fb44-3ee9-9094-e1a9c954dd43",
                        "entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                        "glosses": [
                            "Résultat de dépenses excessives, bien supérieures aux recettes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ea71dbe-95a1-4371-805a-c33b45c9bfb9",
                                "sense_id": "d7c443d0-fb44-3ee9-9094-e1a9c954dd43",
                                "text": "L’épuisement du Trésor contraignit de recourir à des moyens extraordinaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "342bb180-fb13-40b5-b5ef-eb0ea0b86630",
                        "source_entry_id": "0d240b47-7662-362a-887b-c9766fe1889a",
                        "target_lang_word": "exhaustion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhaustion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The point of complete depletion, of the state of being used up."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768b21e8-36e2-46ab-b010-cc7a95c40aa5",
                                                "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                                "text": "We worked the mine to exhaustion, there's nothing left to extract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "Supreme tiredness; having exhausted energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6fa4f0-c62c-4a02-8ad3-1a5a261e094a",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "I ran in the marathon to exhaustion, then I collapsed and had to be carried away."
                                            },
                                            {
                                                "example_id": "99900432-3d94-419a-8db7-cb3871848968",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bfcc54a-22b5-3a62-afa7-44028aa37c60",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal (by percolation etc) of an active medicinal constituent from plant material."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1acd3017-1c85-371e-8501-31544a8c3141",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal of all air from a vessel (the creation of a vacuum)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de9cc18b-7a27-3c62-a5c7-68139ca81829",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "An exhaustive procedure"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
