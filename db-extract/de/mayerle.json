                ],
                "senses": [
                    {
                        "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                        "entry_id": "aded387a-5d4f-3e37-8e0d-452e14ff100a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd08c954-6f91-4f1d-b175-14c8ad400013",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Frau Mayerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2057cc40-1c70-4fde-b08a-48f1ac111fe9",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Herr Mayerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b6c11d4-1d47-4269-8590-0e011ab421fe",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Die Mayerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "25548789-872b-4980-9caa-2a859bc68b91",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Der Mayerle trägt nie die Pullover, die die Mayerle ihm strickt."
                            },
                            {
                                "example_id": "01ae727a-b421-493d-bc79-3db58c655d6d",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mayerle kommt, geht der Herr Mayerle.“"
                            },
                            {
                                "example_id": "7733ea8a-95c7-4fa9-9b8a-2460a2724f16",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Mayerle kommt und geht."
                            },
                            {
                                "example_id": "f82ab165-fbf7-4b47-a9a8-31c48b96bbca",
                                "sense_id": "fa4df230-05c6-3401-b863-224c4f1d3ccd",
                                "text": "Mayerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
