                    "frequency": "VeryLow",
                    "semantic_group_id": "traces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur expérimenté suivait chaque <w>vestige</w> laissé par le cerf dans la terre meuble."
