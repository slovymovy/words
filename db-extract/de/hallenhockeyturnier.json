                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505ae0ff-287d-4ba4-afe6-674d81151230",
                                "sense_id": "7286af1f-caab-34c0-94e4-c86bc0fb7668",
                                "text": "„Nach einer improvisierten Meisterschaft 1945 und einem Hallenhockeyturnier im Messepalast (11. Februar 1951) begann am 2. März 1953 der Bau eines Hockeystadions (Eröffnung 1963; das Stadion steht an der Stelle des seinerzeit dritten Kaffeehauses); seit 1958 werden jährlich Hallenmeisterschaften abgehalten.“"
                            },
                            {
                                "example_id": "2f738a25-1edc-4a63-8a72-bb482d877883",
                                "sense_id": "7286af1f-caab-34c0-94e4-c86bc0fb7668",
                                "text": "„Zum Jubiläum wird im Oktober das 6. Internationale Hallenhockeyturnier für Damen- und Herrenmannschaften ausgerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
