{
    "word_family": [
        "veel",
        "eerder"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c52f4511-c6cd-3282-8461-578a19544229",
                    "sense_definition": "geeft aan dat een bepaalde bewering of mogelijkheid juister of waarschijnlijker is dan een andere",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorkeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was geen aanval op zijn karakter maar <w>veeleer</w> een uiting van bezorgdheid. ",
                            "target_lang_translations": {
                                "en": "It was not an attack on his character but <w>rather</w> an expression of concern."
                            }
                        },
                        {
                            "text": "Zijn succes was niet te danken aan geluk maar <w>veeleer</w> aan hard werken.",
                            "target_lang_translations": {
                                "en": "His success was not due to luck but <w>rather</w> to hard work."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerder",
                        "liever",
                        "juister"
                    ],
                    "common_phrases": [
                        "niet zozeer maar veeleer"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates that a certain statement or possibility is more accurate or likely than another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rather",
                                "target_lang_sense_clarification": "used to introduce a contradiction or correction"
                            },
                            {
                                "target_lang_word": "instead",
                                "target_lang_sense_clarification": "used to indicate a preferred alternative"
                            },
                            {
                                "target_lang_word": "more accurately",
                                "target_lang_sense_clarification": "used to provide a more precise description"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf17627-c0b7-3e4f-91cf-b0e1366b893e",
                    "sense_definition": "in grotere mate of met meer recht zo te noemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voorkeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men zou hem <w>veeleer</w> een filosoof dan een wetenschapper kunnen noemen.",
                            "target_lang_translations": {
                                "en": "One could <w>sooner</w> call him a philosopher than a scientist."
                            }
                        },
                        {
                            "text": "Deze maatregel is <w>veeleer</w> een symbolische stap dan een praktische oplossing.",
                            "target_lang_translations": {
                                "en": "This measure is <w>more</w> of a symbolic step than a practical solution."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerder",
                        "meer"
                    ],
                    "target_lang_definitions": {
                        "en": "to a greater extent or with more justification to be called such"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rather",
                                "target_lang_sense_clarification": "more precisely or to a greater degree"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "more likely to be described as"
                            },
                            {
                                "target_lang_word": "more",
                                "target_lang_sense_clarification": "to a larger extent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}