            "pos": "noun",
            "senses": [
                {
                    "sense_id": "006f99a5-fedb-3636-b042-02e63e725759",
                    "sense_definition": "A technique used to bring an opponent to the ground from a standing position, especially in wrestling or martial arts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler scored two points with a quick <w>takedown</w> in the first round.",
                            "target_lang_translations": {
                                "ru": "Борец заработал два очка благодаря быстрому <w>тейкдауну</w> в первом раунде."
                            }
                        },
                        {
                            "text": "He practiced his defense against a double-leg <w>takedown</w> during training.",
                            "target_lang_translations": {
                                "ru": "На тренировке он отрабатывал защиту от <w>прохода в две ноги</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "score a takedown",
                        "attempt a takedown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием в борьбе или боевых искусствах, позволяющий повалить соперника из стойки на ковер или землю; тейкдаун."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тейкдаун",
                                "target_lang_sense_clarification": "в единоборствах"
                            },
                            {
                                "target_lang_word": "перевод в партер",
                                "target_lang_sense_clarification": "в борьбе"
                            },
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "сваливание соперника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0895fb3c-b095-39a4-ad12-6b1a023e243e",
                    "sense_definition": "The forceful capture or arrest of a suspect or criminal, often by law enforcement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dramatic <w>takedown</w> of the armed suspect was captured on video.",
                            "target_lang_translations": {
                                "ru": "Эффектное <w>задержание</w> вооруженного подозреваемого попало на видео."
                            }
                        },
                        {
                            "text": "Federal agents coordinated a massive <w>takedown</w> of the international drug ring.",
                            "target_lang_translations": {
                                "ru": "Федеральные агенты скоординировали масштабную операцию по <w>ликвидации</w> международной сети наркоторговцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrest",
                        "capture"
                    ],
                    "common_phrases": [
                        "dramatic takedown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Силовой захват, задержание или обезвреживание подозреваемого, преступника или преступной группировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержание",
                                "target_lang_sense_clarification": "силовой захват преступника"
                            },
                            {
                                "target_lang_word": "обезвреживание",
                                "target_lang_sense_clarification": "пресечение деятельности или нейтрализация"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "силовая операция"
                            },
                            {
                                "target_lang_word": "ликвидация",
                                "target_lang_sense_clarification": "преступной сети или группировки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58c9c997-6e7d-3e18-9099-802c7f64096f",
                    "sense_definition": "The act of removing content from a website or online platform, typically following a legal order or copyright complaint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist issued a <w>takedown</w> request after discovering her music was used without permission.",
                            "target_lang_translations": {
                                "ru": "Артистка подала запрос на <w>удаление</w>, обнаружив, что ее музыка использовалась без разрешения."
                            }
                        },
                        {
                            "text": "The platform complied with the <w>takedown</w> notice to avoid facing legal penalties.",
                            "target_lang_translations": {
                                "ru": "Платформа выполнила требование об <w>удалении контента</w>, чтобы избежать юридической ответственности."
                            }
                        }
                    ],
                    "synonyms": [
                        "removal"
                    ],
                    "common_phrases": [
                        "takedown notice",
                        "takedown request"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаление или блокировка контента в интернете по требованию правообладателя или закону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удаление",
                                "target_lang_sense_clarification": "контента из сети"
                            },
                            {
                                "target_lang_word": "снятие с публикации",
                                "target_lang_sense_clarification": "материалов"
                            },
                            {
                                "target_lang_word": "блокировка",
                                "target_lang_sense_clarification": "доступа к контенту"
                            }
                        ]
                    }
                }
            ]
        }
