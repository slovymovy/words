                                        "entry_id": "40ecb2c1-ec4a-356a-9f73-58ecf776524d",
                                        "glosses": [
                                            "Haine des Allemands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7f6de9-f730-42a8-a12a-e479096ce8ad",
                                                "sense_id": "0c325775-7ff6-39ef-83ee-856fa040b047",
                                                "text": "Alors que le patriotisme et la germanophobie, qui vont souvent de pair, peuvent se parer d’apolitisme, l’antifascisme se veut au contraire fondamentalement politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb7353ac-b836-492a-a33c-cc958800bef9",
                        "source_entry_id": "3c32066a-dab9-3183-b339-83e7edd80036",
                        "source_sense_description": "hatred or fear of Germany or anything German",
                        "target_lang_word": "antigermanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
