                        "glosses": [
                            "Favorable à l’Occident, aux idées occidentales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49511c1-fd5e-4acc-bec3-e8714cd92507",
                                "sense_id": "c7dbb903-9d9a-3776-864d-cfd3f253b931",
                                "text": "Un an plus tard, la révolution Orange balaie le candidat pro-russe Viktor Ianoukovitch au profit du réformateur pro-occidental Viktor Iouchtchenko."
                            },
                            {
                                "example_id": "8e5e66a4-e043-436c-b4c5-07694154215d",
                                "sense_id": "c7dbb903-9d9a-3776-864d-cfd3f253b931",
                                "text": "Pourtant, les promesses de Bourguiba en ce qui concerne l’orientation pro-occidentale de sa politique étrangère se graveront dans la réalité."
                            },
                            {
                                "example_id": "ad0a6562-90fa-46ee-a739-a7e25eea788e",
                                "sense_id": "c7dbb903-9d9a-3776-864d-cfd3f253b931",
                                "text": "Ainsi la démocratie n’est plus une affaire intérieure et les interventions « prodémocratiques », c’est-à-dire « pro-occidentales » seraient légitimes."
                            }
                        ]
