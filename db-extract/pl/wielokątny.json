                "translations": [
                    {
                        "translation_id": "51982e8c-50d0-4044-8daa-a95c8256b864",
                        "source_entry_id": "02de1c9c-e072-3dd5-8745-90b2006bd234",
                        "source_sense_id": "5e2cf90c-c677-3391-ac6e-3a62f56a35c1",
                        "target_lang_word": "polygonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d50c27-ded6-3083-838c-4c9a23cbf6e8",
                                        "entry_id": "0ff5304f-78bf-3620-95cb-0c04d8e56fd8",
                                        "glosses": [
                                            "Having many angles; hence characteristic of a polygon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98999a50-7b3e-4d9a-a3ff-5c01a4a7caca",
                                                "sense_id": "b6d50c27-ded6-3083-838c-4c9a23cbf6e8",
                                                "text": "Various forms of conductors have been invented, such as wooden and iron pipes, of a round, square, and polygonal section; but at present, scarcely any other than sheet or cast iron pipes are employed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923d04c2-6ce9-3420-b712-4f8c9ed766d2",
                                        "entry_id": "0ff5304f-78bf-3620-95cb-0c04d8e56fd8",
                                        "glosses": [
                                            "Comprised of polygons."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac042e0b-d731-4fdc-8be9-8748a6c39778",
                                                "sense_id": "923d04c2-6ce9-3420-b712-4f8c9ed766d2",
                                                "text": "The old path paved with polygonal masonry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dd3d4c3-0819-459a-b235-c2839dbe1c99",
                        "source_entry_id": "02de1c9c-e072-3dd5-8745-90b2006bd234",
                        "source_sense_id": "5e2cf90c-c677-3391-ac6e-3a62f56a35c1",
                        "target_lang_word": "multangular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multangular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26f5e993-61a9-3d3d-a936-dc2866c4565a",
                                        "entry_id": "456dc84b-33bf-3e0e-a90a-3e97fbcb6ca7",
                                        "glosses": [
                                            "Having many angles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "multangular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                        "entry_id": "e08a8e55-c691-3cb3-96ed-4f5d636bdd76",
                                        "glosses": [
                                            "Either of two bones in the wrist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa349155-9ec0-4cdb-8344-a4ebe8814a60",
                                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                                "text": "The roentgenograms showed local loss of density of the navicular, the multangulars, and the cuboid."
                                            },
                                            {
                                                "example_id": "9ee410a7-b9e7-4678-b3a1-af2d9da35724",
                                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                                "text": "The distal fragment in contact with the multangulars now has a porosity not seen in the preceding figures."
                                            },
                                            {
                                                "example_id": "fd761ac0-9131-49bb-910d-e793493f2abc",
                                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                                "text": "Very strong ligaments secure the distal half of the scaphoid to the multangulars and capitate. Similarly the proximal half has a strong attachment to the lunate."
                                            },
                                            {
                                                "example_id": "946bb08d-934b-4b2d-b04f-d7b6ab60719f",
                                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                                "text": "There is now narrowing of some of the carpal joint spaces, particularly that between the navicular and the multangulars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "481e6849-2d51-39a7-991c-c122cf9c4b31",
                                        "entry_id": "e08a8e55-c691-3cb3-96ed-4f5d636bdd76",
                                        "glosses": [
                                            "Either of two bones in the wrist:",
                                            "The trapezoid bone (lesser multangular)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "178fcc7d-b1eb-3706-b700-eabbe551b812",
                                        "entry_id": "e08a8e55-c691-3cb3-96ed-4f5d636bdd76",
                                        "glosses": [
                                            "Either of two bones in the wrist:",
                                            "The trapezium bone (greater multangular)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
