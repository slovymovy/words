                {
                    "sense_id": "1895aeeb-5d8e-3334-8ff7-a8b633fd0365",
                    "sense_definition": "Dough made from wheat and water, sometimes mixed with egg, formed into various shapes, and typically boiled for eating.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are having <w>pasta</w> with tomato sauce for dinner.",
                            "target_lang_translations": {
                                "ru": "На ужин у нас <w>макароны</w> с томатным соусом.",
                                "nl": "We eten vanavond <w>pasta</w> met tomatensaus.",
                                "pl": "Na obiad jemy <w>makaron</w> z sosem pomidorowym.",
                                "de": "Wir essen heute Abend <w>Nudeln</w> mit Tomatensoße.",
                                "fr": "Nous mangeons des <w>pâtes</w> à la sauce tomate pour le dîner.",
                                "it": "Stasera a cena mangiamo la <w>pasta</w> al sugo di pomodoro.",
                                "cs": "K večeři máme <w>těstoviny</w> s rajčatovou omáčkou.",
                                "tr": "Akşam yemeğinde domates soslu <w>makarna</w> yiyoruz.",
                                "es": "Vamos a cenar <w>pasta</w> con salsa de tomate."
                            }
                        },
                        {
                            "text": "You should cook the <w>pasta</w> in boiling salted water.",
                            "target_lang_translations": {
                                "ru": "<w>Макароны</w> нужно варить в кипящей подсоленной воде.",
                                "nl": "Je moet de <w>pasta</w> in kokend water met zout koken.",
                                "pl": "Powinieneś ugotować <w>makaron</w> we wrzącej, osolonej wodzie.",
                                "de": "Du solltest die <w>Pasta</w> in kochendem Salzwasser garen.",
                                "fr": "Vous devriez faire cuire les <w>pâtes</w> dans de l'eau bouillante salée.",
                                "it": "Dovresti cuocere la <w>pasta</w> in acqua bollente salata.",
                                "cs": "Měli byste vařit <w>těstoviny</w> ve vroucí osolené vodě.",
                                "tr": "<w>Makarnayı</w> kaynayan tuzlu suda pişirmelisiniz.",
                                "es": "Debes cocinar la <w>pasta</w> en agua hirviendo con sal."
                            }
                        }
                    ],
                    "synonyms": [
                        "noodle"
                    ],
                    "common_phrases": [
                        "fresh pasta",
                        "dried pasta",
                        "pasta sauce",
                        "pasta salad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесто из пшеничной муки и воды, иногда с добавлением яиц, которому придают различную форму и обычно отваривают для еды.",
                        "nl": "Deeg gemaakt van tarwe en water, soms gemengd met ei, gevormd in verschillende vormen en meestal gekookt om te eten.",
                        "pl": "Ciasto z mąki pszennej i wody, czasem z dodatkiem jajka, formowane w różne kształty i zazwyczaj gotowane przed spożyciem.",
                        "de": "Teig aus Weizen und Wasser, manchmal mit Ei gemischt, der in verschiedene Formen gebracht und typischerweise zum Verzehr gekocht wird.",
                        "fr": "Pâte faite de blé et d'eau, parfois mélangée à de l'œuf, façonnée en diverses formes et généralement bouillie pour être consommée.",
                        "it": "Impasto di farina di grano e acqua, talvolta con uova, modellato in varie forme e solitamente bollito per essere consumato.",
                        "cs": "Těsto z pšenice a vody, někdy smíchané s vejcem, tvarované do různých podob a obvykle vařené k jídlu.",
                        "tr": "Buğday unu ve sudan yapılan, bazen yumurta ile karıştırılan, çeşitli şekiller verilen ve genellikle haşlanarak yenen hamur.",
                        "es": "Masa hecha de trigo y agua, a veces mezclada con huevo, a la que se le da varias formas y que generalmente se hierve para comer."
                    },
