                                        "sense_id": "530dae56-83fc-3c84-8f72-fcda7ef1cc72",
                                        "entry_id": "03d1aec6-97fb-320d-ad1b-cae3ed46b2a2",
                                        "glosses": [
                                            "The hair of the head."
                                        ],
