                    {
                        "translation_id": "8d67abd9-a82d-4e39-8f49-2e34b37b1f47",
                        "source_entry_id": "709fe5a6-50ae-3af2-a846-92a34dcdb62d",
                        "source_sense_id": "4b193e99-ed63-382c-8187-8f89e2b8b212",
                        "source_sense_description": "langharige, middelgrote hond met pluimstaart",
                        "target_lang_word": "Pomeranian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pomeranian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d938dfbb-3185-3b4c-a46e-abe3ae086bfe",
                                        "entry_id": "15caa4db-5981-3fb1-8b63-2a8c01fd3810",
                                        "glosses": [
                                            "Of, from or relating to Pomerania, a historic region split between the German states of Mecklenburg-Vorpommern and Brandenburg and the Pomeranian Voivodeship, West Pomeranian Voivodeship and Kuyavian-Pomeranian Voivodeship of Poland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d34f7584-3279-37ef-a601-2a539c174354",
                                        "entry_id": "15caa4db-5981-3fb1-8b63-2a8c01fd3810",
                                        "glosses": [
                                            "Of or relating to Pomerania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f0934f-5cc0-40ac-a28e-b0c583e06d99",
                                                "sense_id": "d34f7584-3279-37ef-a601-2a539c174354",
                                                "text": "In my 2002 research project I focused on the documentation of the Pomeranian Low German as spoken in the state of Wisconsin."
                                            },
                                            {
                                                "example_id": "bc1aca5c-b592-4317-8e3f-20b28e72facb",
                                                "sense_id": "d34f7584-3279-37ef-a601-2a539c174354",
                                                "text": "This was expressed by a Pomeranian Low German speaker born in 1903 in Hamburg, Marathon County:\n…"
                                            },
                                            {
                                                "example_id": "4bb40400-20fb-4517-bcc3-f3a90aef1569",
                                                "sense_id": "d34f7584-3279-37ef-a601-2a539c174354",
                                                "text": "Runge's version, published by Arnim in 1808, is in Pomeranian (low German) dialect, and …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pomeranian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de9f739d-19a5-329a-9964-47a15b8c598f",
                                        "entry_id": "e715008f-f884-322b-bd9c-4f6c5bd0511d",
                                        "glosses": [
                                            "A native or inhabitant of Pomerania."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c19b2d64-ac0d-3e0e-898c-2e1736e1d678",
                                        "entry_id": "e715008f-f884-322b-bd9c-4f6c5bd0511d",
                                        "glosses": [
                                            "A breed of small, fluffy, energetic toy dogs in the canine family of spitzes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pomeranian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4279f84-5de5-391e-b5f4-a9006f72308f",
                                        "entry_id": "38f75c38-207d-35aa-b43d-3a85b81185cb",
                                        "glosses": [
                                            "Pomeranian Low German."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3e81f5-c9fe-4628-9b97-1180741421e3",
                                                "sense_id": "e4279f84-5de5-391e-b5f4-a9006f72308f",
                                                "text": "Among their dialects the Rhine Franconian and Moselle-Franconian varieties prevailed, but other dialects were present as well, such as Upper German Swabian, Low German Westphalian, Pomeranian, and the Mennonite varieties, and even Volga German."
                                            },
                                            {
                                                "example_id": "8a5e23ad-8023-41aa-aa49-afb473062353",
                                                "sense_id": "e4279f84-5de5-391e-b5f4-a9006f72308f",
                                                "text": "… the language of everyday use is characterized by a wide panorama of local dialectal variation, ranging from Low German dialects in the north (e.g. Low Saxon, Westphalian, Pomeranian), through Central German dialects (e.g. Hessian, Thuringian, Silesian) to the High German dialects of the south (e.g. Bavarian, High Alemannic, Alsatian and Franconian) …"
                                            },
                                            {
                                                "example_id": "c26932e7-69f3-4800-b1b5-35c22be7cecf",
                                                "sense_id": "e4279f84-5de5-391e-b5f4-a9006f72308f",
                                                "text": "A second important isogloss that separates Pomeranian from the other Low German variants, … These strong morphemes are absent in the North Sea Germanic area, as well as in Pomeranian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "894b907f-875f-3a6c-8a2b-0b0f0fab3e21",
                                        "entry_id": "38f75c38-207d-35aa-b43d-3a85b81185cb",
                                        "glosses": [
                                            "The Kashubian language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c646be11-23f5-4832-9516-58ec7605c984",
                        "source_entry_id": "709fe5a6-50ae-3af2-a846-92a34dcdb62d",
                        "source_sense_id": "4b193e99-ed63-382c-8187-8f89e2b8b212",
                        "source_sense_description": "langharige, middelgrote hond met pluimstaart",
                        "target_lang_word": "loulou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loulou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0c2f22-ce8d-32c3-ae5e-d47907bc92a4",
                                        "entry_id": "6cf6639e-f3a4-32ef-836d-38b0c886dcfd",
                                        "glosses": [
                                            "Petit chien à longs poils, au museau pointu et à la queue recourbée sur le dos."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca78c73-d93a-41b5-acac-d5e70007d2e7",
                                                "sense_id": "bf0c2f22-ce8d-32c3-ae5e-d47907bc92a4",
                                                "text": "En m'approchant, j'ai vu qu'il s'agissait d'un tout jeune chiot, un loulou qui ne devait pas mesurer plus de douze centimètres. Six autres piaillaient en se tortillant dans le panier, et tous étaient à vendre."
                                            },
                                            {
                                                "example_id": "4405ba37-8e8e-4c09-b8a5-03cc345a4bb6",
                                                "sense_id": "bf0c2f22-ce8d-32c3-ae5e-d47907bc92a4",
                                                "text": "Patricia qui nous appelle de Welkenraedt, possède 2 chiens et aurait souhaité avoir un congé rémunéré pour l'accueil de ses loulous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loulou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b2ec35c-fcd2-3aea-a336-d3ead2a51ea2",
                                        "entry_id": "3c375dfb-6ab5-309d-8929-328e6d098e03",
                                        "glosses": [
                                            "Petit loup, mot tendre, souvent adressé aux enfants ou à un animal familier."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3f1b114-3c7f-474d-88bc-dcbbdb135961",
                                                "sense_id": "3b2ec35c-fcd2-3aea-a336-d3ead2a51ea2",
                                                "text": "— Dodo, Spy, dodo, mon petit loulou !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acb42dc5-c692-3735-9e79-d691781ed5a1",
                                        "entry_id": "3c375dfb-6ab5-309d-8929-328e6d098e03",
                                        "glosses": [
                                            "Enfant, jeune homme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4795b8be-65ea-4ecd-a1ea-0f852332ac9b",
                                                "sense_id": "acb42dc5-c692-3735-9e79-d691781ed5a1",
                                                "text": "Que font les loulous, on ne les entend plus ?"
                                            },
                                            {
                                                "example_id": "fdffa00a-cfe5-4285-8789-d564bc8f22c9",
                                                "sense_id": "acb42dc5-c692-3735-9e79-d691781ed5a1",
                                                "text": "Oh les gars, vous avez vu la louloute là-bas ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26fd920b-5e2b-3ddc-805c-7a5d961eabf0",
                                        "entry_id": "3c375dfb-6ab5-309d-8929-328e6d098e03",
                                        "glosses": [
                                            "Homme, type, mec."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db03d5b-d5d8-439c-9cb6-a365ef80d66e",
                                                "sense_id": "26fd920b-5e2b-3ddc-805c-7a5d961eabf0",
                                                "text": "Ce loulou est toujours pendu au téléphone !…"
                                            },
                                            {
                                                "example_id": "81fb1347-3dd4-4785-8763-d539fbccb72b",
                                                "sense_id": "26fd920b-5e2b-3ddc-805c-7a5d961eabf0",
                                                "text": "Dis donc, c’est un drôle de loulou ton copain, il est parti avec la caisse !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae98e636-8cc1-3eda-b832-c9cc3ae0ff52",
                                        "entry_id": "3c375dfb-6ab5-309d-8929-328e6d098e03",
                                        "glosses": [
                                            "(Par antiphrase) Loubard ou voyou qui agit souvent en bande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a956fa-d635-4f5d-9633-9da4b5ddc049",
                                                "sense_id": "ae98e636-8cc1-3eda-b832-c9cc3ae0ff52",
                                                "text": "Pourtant ces mômes ne sont pas des terreurs. Il suffit de voir le mal qu'ils se donnent pour en avoir l'air… À quoi reconnaît-on un loulou ? À son allure, à la fois arrogante et fuyante ; à sa gueule plus ou moins cassée, dents de devant ébréchées par les coups ; et à ses tatouages…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae725b2-cc91-328b-a4a8-a86831e9fce8",
                                        "entry_id": "3c375dfb-6ab5-309d-8929-328e6d098e03",
                                        "glosses": [
                                            "Amas de poussière, s’accumulant dans les endroits délicats d’accès (mot originaire du patois vendéen, XVIIIᵉ siècle)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c322ba1-0653-4ca7-b4d0-ca89470224e8",
                                                "sense_id": "7ae725b2-cc91-328b-a4a8-a86831e9fce8",
                                                "text": "Nettoie tous ces loulous sous ton lit !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
