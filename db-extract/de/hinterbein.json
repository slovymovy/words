                "senses": [
                    {
                        "sense_id": "3f59ec22-959f-3b94-ae7e-682e31abc299",
                        "entry_id": "efd54218-ff7b-3dbd-a4a8-9a3d6484892e",
                        "glosses": [
                            "bei Tieren mit vier oder mehr Beinen eine der hinteren Gliedmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac3daca-6b97-4f5d-91f6-f8afea744e62",
                                "sense_id": "3f59ec22-959f-3b94-ae7e-682e31abc299",
                                "text": "Der Hund hat eine Verletzung am Hinterbein."
                            },
                            {
                                "example_id": "75676028-92bc-4bf3-81a4-f748aa6d4489",
                                "sense_id": "3f59ec22-959f-3b94-ae7e-682e31abc299",
                                "text": "„Der alte Karai hatte den Kopf umgewandt und schnappte auf der Suche nach einem Floh ärgerlich an seinen Hinterbeinen herum, dass die gefletschten gelben Zähne knackten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0753d4cb-e2de-4fa7-bc3f-50dc7412ef29",
                        "source_entry_id": "efd54218-ff7b-3dbd-a4a8-9a3d6484892e",
                        "source_sense_id": "3f59ec22-959f-3b94-ae7e-682e31abc299",
