                ],
                "senses": [
                    {
                        "sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                        "entry_id": "c525daa5-2b62-3117-a3c2-2df79e48d0cd",
                        "glosses": [
                            "jemand, der bei einer illegalen oder fragwürdigen Tat mitwirkt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "fb129579-1519-487a-8941-1d7927c16892",
                                "sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                                "text": "„Dies entkräftet freilich nicht das Argument, ohne die ausländischen Helfershelfer hätten Zigtausende, vielleicht sogar Millionen von den ungefähr sechs Millionen ermordeten Juden überlebt.“"
                            },
                            {
                                "example_id": "b81edb4b-8033-4d4d-9acd-4b0fe9edadba",
                                "sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                                "text": "Da ward sie mit ihrem Helfershelfer in ein durchlöchertes Schiff gesetzt, und hinaus ins Meer getrieben, wo sie bald in den Wellen versanken."
                            },
                            {
                                "example_id": "f4b538f6-d809-442e-84df-077a07789f9f",
                                "sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                                "text": "„Cook sollte indessen versuchen, mit des Doktors Hilfe den Neger wieder ins Leben zurückzurufen und ihm, da er ja schon gegenwärtig genug für seine Sünden litt, völlige Straflosigkeit zusichern, wenn er gestehen wollte, wo besonders einzelne bei Little Rock geraubte wertvolle Gegenstände verborgen seien und wer seine bis dahin noch unentdeckten Helfershelfer wären.“"
                            },
                            {
                                "example_id": "8b0dd04a-a58e-469c-9190-2259c2726704",
                                "sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                                "text": "„Der Ex-Boxmeister McMurdo war inzwischen, wie ich feststellte, als Helfershelfer eingestuft und verhaftet worden, und er und Mr. Sholto waren zur Polizeistation abgeführt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e266382-6fed-4585-8664-003ee8200404",
                        "source_entry_id": "c525daa5-2b62-3117-a3c2-2df79e48d0cd",
                        "source_sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                        "source_sense_description": "abwertend: jemand, der bei einer illegalen oder fragwürdigen Tat mitwirkt",
                        "target_lang_word": "accessory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Having a secondary, supplementary or subordinate function by accompanying as a subordinate; aiding in a secondary way; being additional; contributing or being contributory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1f839e-e925-4c86-b950-eb7273dfb4e2",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "accessory garments"
                                            },
                                            {
                                                "example_id": "dab61d60-8305-43a7-b73c-dce172ea510b",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Surprise parties succeed with the help of accessory neighbors or colleagues."
                                            },
                                            {
                                                "example_id": "0d35c4b1-30c9-4ded-a242-fe7ee3408cb8",
                                                "sense_id": "1693cb44-c1c0-3fdd-9ae9-6d7cb1d86302",
                                                "text": "Amongst many secondary, and accessory causes that support Monarchy, these are not of least reckning, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Assisting a crime without actually participating in committing the crime itself; being connected as an incident or subordinate to a principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d696f1-8780-4309-a54a-3f9c7aed4de0",
                                                "sense_id": "21ef40c6-9c50-31f5-9e59-9b6f9a3e0ea1",
                                                "text": "Her actions were clearly accessory because they helped him commit and probably also conceal the crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                        "entry_id": "fbc99f96-e25a-35d2-a2fa-8b063bee97c1",
                                        "glosses": [
                                            "Present in a minor amount, and not essential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c5781af-adb8-46f5-a7a6-16ee6e0ee9b2",
                                                "sense_id": "30dd0a98-f3bb-3a40-8c19-7c51dc73e202",
                                                "text": "accessory mineral"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accessory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something that belongs to part of another main thing; something additional and subordinate, an attachment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698af3dc-9d57-4e3e-a920-3adcf937f3c8",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the accessories of a mobile phone"
                                            },
                                            {
                                                "example_id": "ba125a51-b0e4-4586-b69c-c922b241eb75",
                                                "sense_id": "4f0bae53-24ef-3914-95de-23d7a801a2de",
                                                "text": "the aspect and accessories of a den of banditti"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "An article that completes one's basic outfit, such as a scarf or gloves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b902d524-a6d8-446a-921f-aebd95425b1e",
                                                "sense_id": "658bb524-9276-3bf5-a260-eaccc5e701a2",
                                                "text": "One of the first of a wave of American women contemporary designers who emerged in the 1990s, she [Kate Spade] built a brand on the appeal of clothes and accessories that made shoppers smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "A person who is not present at a crime, but contributes to it as an assistant or instigator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ec0155-db11-46d7-bc71-61d212d30454",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "She was an accessory to the murder because she helped him commit and probably also conceal the crime."
                                            },
                                            {
                                                "example_id": "15044880-7a6f-495e-ba17-e3f6e3a66009",
                                                "sense_id": "d5a8177a-c8d6-3a5c-bd0a-ebb98a215d91",
                                                "text": "“You can be an accessory before the fact, or an accessory after the fact. It doesnʼt matter if itʼs before or after; either way youʼd be in for it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc1751cc-c7e2-35d4-9104-1ade255b7699",
                                        "entry_id": "b603bee8-12e2-3b29-8af4-50ebb0ce3c71",
                                        "glosses": [
                                            "Something in a work of art without being indispensably necessary, for example solely ornamental parts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e7cf2bd-2706-4168-95f1-8e3cbaf5d109",
                        "source_entry_id": "c525daa5-2b62-3117-a3c2-2df79e48d0cd",
                        "source_sense_id": "035a597c-65b0-3bd3-9a9f-2a19eddecb95",
                        "source_sense_description": "abwertend: jemand, der bei einer illegalen oder fragwürdigen Tat mitwirkt",
                        "target_lang_word": "complice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3339e54-6573-36ed-8aaa-40d628a451b2",
                                        "entry_id": "dcd947ab-735c-34ea-a4eb-4a6873730ef3",
                                        "glosses": [
                                            "Qui participe au délit ou au crime commis par un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4105fe1a-7f00-4932-b0ba-13821534cbe1",
                                                "sense_id": "b3339e54-6573-36ed-8aaa-40d628a451b2",
                                                "text": "Par ailleurs, ces hommes n'avaient pas tué de leurs mains, ils étaient complices. Aux yeux de la loi allemande, ils étaient coupables d'un crime de droit commun, pas d'un crime contre l'humanité, comme cela aurait été le cas en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc401e26-e637-3deb-b952-dae96d35fcb2",
                                        "entry_id": "dcd947ab-735c-34ea-a4eb-4a6873730ef3",
                                        "glosses": [
                                            "Qui participe, qui prend part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8bab69-2e69-4a6a-a5a5-5d796cb848a4",
                                                "sense_id": "cc401e26-e637-3deb-b952-dae96d35fcb2",
                                                "text": "Au sein de chaque groupe, tous les participants étaient complices avec l’expérimentateur, sauf un, dénommé le sujet. L'expérience visait à observer comment ce dernier allait réagir au comportement des autres."
                                            },
                                            {
                                                "example_id": "9ec8baa1-e058-4377-ae8c-d704cd7bd036",
                                                "sense_id": "cc401e26-e637-3deb-b952-dae96d35fcb2",
                                                "text": "Cette mainmise du groupe en Côte d’Ivoire fut imposée sans lésiner sur les moyens : les sociétés de transport bolloréennes rançonnent les producteurs ivoiriens tandis que les banques françaises et internationales complices les asphyxient financièrement…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "complice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                                        "entry_id": "dac3ca0b-bc99-3729-91a7-b57815798e68",
                                        "glosses": [
                                            "Acolyte ; comparse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60800479-b30d-475a-8b58-959f50d1aea0",
                                                "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                                                "text": "Babœuf avait, du fond d'une de ses retraites, fait parvenir au représentant Drouet, son complice, une note énergique qui devait lui servir de texte à un discours à prononcer devant le Conseil des Anciens pour la conservation des Sociétés populaires."
                                            },
                                            {
                                                "example_id": "bc3e0d5d-8b61-45c1-9ab9-1f4e444bf6b5",
                                                "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                                                "text": "Ce prochain départ avait décidé Latournelle à proposer à son ami Dumay son fils pour complice de l’importante conspiration que cet ordre peut faire entrevoir."
                                            },
                                            {
                                                "example_id": "409d3133-893c-432d-a82d-20975fd54dc9",
                                                "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                                                "text": "Nous nous regardons dans les yeux, férocement, ainsi que deux complices prêts à se déchirer et à s’entr’égorger sur leur butin."
                                            },
                                            {
                                                "example_id": "3ec4466d-6223-4eac-9738-d7fc209c1895",
                                                "sense_id": "07b871f1-bcd7-3946-b53c-297d3aa8a714",
                                                "text": "Cette union, que cimente jusqu'à la mort un crime entre complices […] Jim tout à coup s'apercevait qu'elle existait, qu'elle formait l'élément primordial de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
