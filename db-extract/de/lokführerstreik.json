                "senses": [
                    {
                        "sense_id": "1331c7e2-c8e5-3e75-9ef5-9959682bd141",
                        "entry_id": "3c3dfbb8-2ac2-3de2-81fb-ae6bbfe55b42",
                        "glosses": [
                            "Ereignis, bei dem Personen, die Lokomotiven fahren, ihre Arbeit niederlegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622bca0d-e1b4-4033-afb2-20e09fcc938f",
                                "sense_id": "1331c7e2-c8e5-3e75-9ef5-9959682bd141",
                                "text": "Ein Lokführerstreik ist für die Deutsche Bahn und deren Kunden ärgerlich."
                            },
                            {
                                "example_id": "a966305d-c43c-4ae5-9516-b63e6573a2cc",
                                "sense_id": "1331c7e2-c8e5-3e75-9ef5-9959682bd141",
                                "text": "„Die Deutsche Bahn ist am Freitag erneut mit dem Versuch gescheitert, den Lokführerstreik mit juristischen Mitteln zu stoppen.“"
                            },
                            {
                                "example_id": "ce644642-6f8c-472b-a101-04964e532297",
                                "sense_id": "1331c7e2-c8e5-3e75-9ef5-9959682bd141",
                                "text": "„Die Deutsche Bahn hat die Ersatzfahrpläne für den angekündigten Lokführerstreik am Donnerstag und Freitag ins Internet gestellt.“"
                            }
                        ],
