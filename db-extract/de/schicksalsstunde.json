                "senses": [
                    {
                        "sense_id": "a4d577a6-e9d1-33eb-9d14-ff5a505ea0e9",
                        "entry_id": "477329d5-e8fd-308c-8e5f-5954c8fe893c",
                        "glosses": [
                            "Zeitpunkt/Moment, der sich maßgebend auf die Zukunft von jemandem oder etwas auswirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec42a90f-527c-490b-b637-b94581c44cef",
                                "sense_id": "a4d577a6-e9d1-33eb-9d14-ff5a505ea0e9",
                                "text": "„Terra stand dort, er stammelte: »Ich konnte unmöglich fern bleiben in solcher Schicksalsstunde.«“"
                            },
                            {
                                "example_id": "959897e8-519e-48a9-a592-3a3f22ac2284",
                                "sense_id": "a4d577a6-e9d1-33eb-9d14-ff5a505ea0e9",
                                "text": "„Dann kam jene Schicksalsstunde, die mein Leben vernichtete, und mich zu dem gemacht hat, was ich bin.“"
                            },
                            {
                                "example_id": "8ea23693-e842-40bd-a483-2db734a20a76",
                                "sense_id": "a4d577a6-e9d1-33eb-9d14-ff5a505ea0e9",
                                "text": "„Die drei Portugiesen, Magellan und die Gebrüder Faleiro, waren sich beim Aufbruch sicherlich bewusst, dass sie einer Schicksalsstunde entgegengingen.“"
                            },
                            {
                                "example_id": "c80b22fc-916f-446c-8454-411bec68e173",
                                "sense_id": "a4d577a6-e9d1-33eb-9d14-ff5a505ea0e9",
                                "text": "„Des Hinscheiden Goethes gedenken wir in der gewaltigsten Schicksalsstunde, die je für die Menschheit geschlagen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
