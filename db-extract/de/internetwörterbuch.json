                "senses": [
                    {
                        "sense_id": "28b89482-e3e0-398c-b873-f81f6364ebdb",
                        "entry_id": "51d8d17c-ff55-351e-8447-fb67ae41c3dc",
                        "glosses": [
                            "Wörterbuch, das online im Internet zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "659ab88a-933a-4363-81ce-d15b5a510d2c",
                                "sense_id": "28b89482-e3e0-398c-b873-f81f6364ebdb",
                                "text": "„Eine Nutzung ist im Grunde nur bei Internetwörterbüchern durch Auswertung von Logfiles nachzuweisen.“"
                            },
                            {
                                "example_id": "11ed092d-d307-4dfc-b995-d52b18f20205",
                                "sense_id": "28b89482-e3e0-398c-b873-f81f6364ebdb",
                                "text": "„Es werden im Rahmen des Wörterbuchportals OWID und des Internetwörterbuchs elexiko neue Formen der Präsentation und Integration von lexikalischen Informationen entwickelt.“"
                            },
                            {
                                "example_id": "c5c36ac7-3dcd-4493-978c-91250af4c8e6",
                                "sense_id": "28b89482-e3e0-398c-b873-f81f6364ebdb",
                                "text": "„Im Rahmen des Jubiläums zum 50-jährigen Bestehen diplomatischer Beziehungen zwischen Israel und Deutschland stellt das Institut für Deutsche Sprache in Mannheim (IDS) ab heute ein neues Internetwörterbuch zu deutschen Lehnwörtern im modernen Hebräisch online.“"
                            }
                        ],
