                "senses": [
                    {
                        "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                        "entry_id": "f272b2b1-e3a8-30f4-811d-3df7834ad811",
                        "glosses": [
                            "definierte Systematik einer Lüftung; Einsatz deren Art und Weise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ae0d38-bcd8-4808-b811-a7e52579bcfe",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "Zu den Lüftungsarten zählen zum Beispiel die Verdrängungslüftung, die Verdünnungslüftung oder gar die Querlüftung."
                            },
                            {
                                "example_id": "d30ddc6d-08e6-44fa-85da-85005f8d3fee",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "„Grundsätzlich lassen sich zwei Lüftungsarten unterscheiden, die vom Aufbau, von der Wirkungsweise und daher auch vom Einsatzbereich her sehr unterschiedlich sind.“"
                            },
                            {
                                "example_id": "0dc6f095-73d4-4d47-b67f-1b25a842b6a0",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "„Wenn die Fenster sich dabei gegenüber stehen oder gar diagonal, ist diese Lüftungsart besonders schnell und erfrischend wirkungsvoll.“"
                            },
                            {
                                "example_id": "a1462bb6-f671-486f-a318-856311ef444e",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "„Nach DIN 1946 Teil 6 und DIN 18017 Teil 3 werden die jeweils für die „Lüftungstechnische Einheit“ (abgeschlossene Wohnungseinheit, bzw. Einfamilienhaus) gemäß Lüftungsart in Ansatz zu bringenden Volumenströme über die ALD berechnet.“"
                            },
                            {
                                "example_id": "05c94b37-93be-477c-92e6-0710209879e5",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "„Bei dieser Lüftungsart wird die Frischluft von außen über das Lüftungsrohr in das Stallinnere geführt und optimal verteilt.“"
                            },
                            {
                                "example_id": "5e55ce06-db2d-4418-972d-344478e26143",
                                "sense_id": "abf3522a-a448-311c-b798-95af4008e32a",
                                "text": "„Fehlt der Software zum Ausführen einer Lüftungsart ein Messsensor, wird der Nutzer durch ein Info-Fenster darauf hingewiesen und stattdessen das Programm „Grundlüftung“ gestartet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
