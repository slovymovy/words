                        "glosses": [
                            "Traverse de la roue à potier, sur laquelle l’ouvrier appuie ses pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a7eadc-f5dd-4cdc-bf6b-591d2d88508d",
                                "sense_id": "15bd6c25-da10-3862-9afe-a86be3253cff",
                                "text": "Les deux pièces de bois des côtés qu’en termes de l’art on appelle les payens sont très fortes, et ont des coches de distance en distance [pour arrêter les pieds de l’ouvrier]."
                            }
