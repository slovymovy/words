                        "entry_id": "b2eaf9bd-2d02-3845-95a8-541dadb908a0",
                        "glosses": [
                            "rodzaj elektrycznie pobudliwej komórki zdolnej do przetwarzania i przewodzenia informacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa73caf-8aff-465b-b35f-547150a03bca",
                                "sense_id": "7a62ba15-a74a-31a3-9b60-fbdfe6e0c2a1",
                                "text": "Muszka owocowa posiada około 100 000 neuronów."
                            }
