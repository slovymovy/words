                ],
                "senses": [
                    {
                        "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                        "entry_id": "5f170c41-bf8d-32cd-9b7f-b81afa3c698a",
                        "glosses": [
                            "zähflüssige Masse, die eine Röhre verschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953cb7ad-6be6-4776-b1ff-8727e8a69bca",
                                "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                                "text": "„Am Samstagmorgen jedoch fanden Tierpfleger den Schleimpfropfen, der im Vorfeld der Geburt ausgestossen wird.“"
                            },
                            {
                                "example_id": "68218e23-e0a2-4610-b499-a2da67186030",
                                "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                                "text": "„Ein erfahrener Narkose-Oberarzt habe ihm seinerzeit von dem Eingriff abgeraten. Bei dieser Einschätzung blieb es auch, als Jonte T. im Laufe der Nacht akute Atemnot bekam und einen Schleimpfropfen auswürgte.“"
                            },
                            {
                                "example_id": "b14e995b-6467-49fd-a59e-70009491ef9a",
                                "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                                "text": "„Genau dieses Phänomen wurde in Halle beobachtet, wo auch in penibel sauberen Haushalten, meist mit sanierten Leitungen, solche mysteriösen Schleimpfropfen aus dem Hahn plumpsten.“"
                            },
                            {
                                "example_id": "3eb63c05-9476-427b-92d6-78ff0a83c6bb",
                                "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                                "text": "„Ein zusätzlicher Schleimpfropfen zu diesem Zeitpunkt kann zu einer schlagartigen Ateminsuffizienz führen, und man sollte sich deshalb der Gefährlichkeit dieser Erkrankung immer bewusst sein.“"
                            },
                            {
                                "example_id": "2601d853-bf4f-4339-b08f-b3adedbfe602",
                                "sense_id": "1b96258a-e839-3f75-afed-328fc5d9cb2a",
                                "text": "„Diagnostisch wichtig sind die nichtembryonierten Eier im Stuhl von 36–45 x 21 µm Größe mit bipolarem Schleimpfropfen, ähnlich wie beim Peitschenwurm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
