                                        "entry_id": "8b616bb5-f5f2-3e9c-8a0a-d762decd6846",
                                        "glosses": [
                                            "Espèce de psittaciforme endémique de Nouvelle-Zélande, de la famille des nestoridés, qui vit exclusivement dans les montagnes où elle se nourrit entre autres de nectar et des fruits d’agathis, un arbre de la famille des araucariacées, dont la forme de son bec est particulièrement bien adaptée à l'extraction des graines, et qui est d'un naturel inquisiteur auprès des humains (espèce Nestor notabilis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0ac579-e7e3-48f2-ba78-bd5decc3bf3e",
                                                "sense_id": "f760d7b0-118f-3c12-b2b1-3bafa3f68c63",
                                                "text": "Ce drôle de perroquet, le nestor kéa, vit habituellement entre 1300 et 2000 mètres d’altitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
