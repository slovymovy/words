                                            {
                                                "example_id": "8ebc2549-278b-4c7a-8e9c-d443f8a0e7de",
                                                "sense_id": "bc6788c3-6d6e-39f8-84dd-47dbc0293f21",
                                                "text": "Светлый праздник."
                                            },
                                            {
                                                "example_id": "568dfba9-350e-4663-b11c-b493de9d57a3",
