                                            {
                                                "example_id": "7629752b-819c-49bd-9c83-801f67a2a09e",
                                                "sense_id": "789c609b-8464-3104-a0f1-230149f6164d",
                                                "text": "Waarschijnlijk is de lange vinger ontstaan in de vijftiende eeuw, in het Franse hertogdom Savoye. Daar werden ze biscuits à la cuillère (lepelkoekjes) genoemd."
                                            }
