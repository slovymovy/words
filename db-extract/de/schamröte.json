                ],
                "senses": [
                    {
                        "sense_id": "34690cc4-73fd-3634-bd54-4d2b81fc5051",
                        "entry_id": "625d1819-d837-3402-b1d9-624600f81c02",
                        "glosses": [
                            "Röte im Gesicht, hervorgerufen von Scham"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4041aa2d-d0a1-4951-affc-d9d3119113b1",
                                "sense_id": "34690cc4-73fd-3634-bd54-4d2b81fc5051",
                                "text": "„Eine so schlagfertige Antwort trieb mir die Schamröte ins Gesicht.“"
                            },
                            {
                                "example_id": "72ec833a-8167-40a9-b0b5-579dab62a786",
                                "sense_id": "34690cc4-73fd-3634-bd54-4d2b81fc5051",
                                "text": "„Und während ich mit tapsigen Händen all das viele Geld in den Koffer pfropfe, glühend im Gesicht und stumm, und die Schamröte mir über den ganzen Leib flattert, sehe ich verblüfft, daß er die schönsten Blumen abschneidet und zu einem Strauß zusammenlegt!“"
                            },
                            {
                                "example_id": "157b3a54-ba2c-4706-a1e2-30fd683fda96",
                                "sense_id": "34690cc4-73fd-3634-bd54-4d2b81fc5051",
                                "text": "„Und also stürzte der kleine Major mitten hinein in ein Abenteuer, das ihm die Schamröte in die ehrlichen Pausbacken treiben sollte, ein skandalöses, ein richtig pariserisches Abenteuer.“"
                            },
                            {
                                "example_id": "a4842d27-e7f8-43ba-8ecc-405bb11c1534",
                                "sense_id": "34690cc4-73fd-3634-bd54-4d2b81fc5051",
                                "text": "„Sie müssen verantworten, was ihnen jetzt möglicherweise die Schamröte ins Gesicht treibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
