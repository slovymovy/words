                ],
                "senses": [
                    {
                        "sense_id": "63660387-ba9c-35b0-a4cf-9f12ca227dd2",
                        "entry_id": "578df39b-ff00-3ac2-8d46-f6c9a0d3052f",
                        "glosses": [
                            "Fouler aux pieds, terrasser, anéantir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f23271aa-bfb7-4984-91c4-57877d507949",
                                "sense_id": "63660387-ba9c-35b0-a4cf-9f12ca227dd2",
                                "text": "Il leva le poing vers le plafond obscur, à défaut de voûte céleste, et frappa violemment le plancher, ne pouvant conculquer plus directement la face de la marâtre Cybèle."
                            },
                            {
                                "example_id": "ed19faeb-de0b-4cac-9f47-6ed7dedef0ad",
                                "sense_id": "63660387-ba9c-35b0-a4cf-9f12ca227dd2",
                                "text": "Faux ménages, doubles ménages en ville, dissimulations, tromperies, trahisons qui sont menue monnaie dans le courant de nos belles existences matrimoniales, il conculque à ses pieds tout cela."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28ebaf38-1b4f-411e-bdc8-13bd7ec884f2",
                        "source_entry_id": "578df39b-ff00-3ac2-8d46-f6c9a0d3052f",
                        "source_sense_id": "63660387-ba9c-35b0-a4cf-9f12ca227dd2",
                        "target_lang_word": "conculcare",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conculcare",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2470a5-fc81-32de-9c4b-a0d90c4cbd09",
                                        "entry_id": "8131f199-7c99-3f94-b830-47cc8fea7a07",
                                        "glosses": [
                                            "pestare con i piedi (qualcosa), con violenza"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f7e9ce-e9b1-45a7-b6a9-3ba7d0cba7dd",
                                                "sense_id": "8c2470a5-fc81-32de-9c4b-a0d90c4cbd09",
                                                "text": "i vagheggiati fasci orgogliosi e le tremende scuri co’l piè conculca"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684002ff-4f4d-3c1a-b7c2-d51367a3ddf7",
                                        "entry_id": "8131f199-7c99-3f94-b830-47cc8fea7a07",
                                        "glosses": [
                                            "mostrare sommo sprezzo verso qualcuno o qualcosa, e in particolare, di leggi, violarle senza ritegno"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9112688c-d9af-48ae-b1fc-0675032db20e",
                                                "sense_id": "684002ff-4f4d-3c1a-b7c2-d51367a3ddf7",
                                                "text": "se tiranno è detto chi le leggi rinnova, io son tiranno; ma se, a ragion, chi le conculca tale si appella, io tal non sono"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca18b0c-3eb7-332f-82f9-84ed9aeb7f13",
                                        "entry_id": "8131f199-7c99-3f94-b830-47cc8fea7a07",
                                        "glosses": [
                                            "usare violenza verso qualcuno, rendere qualcuno oggetto di oppressione, schiavitù eccetera"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b4b46d-7da6-47f6-9262-0bb311ce39c7",
                                                "sense_id": "fca18b0c-3eb7-332f-82f9-84ed9aeb7f13",
                                                "text": "[un] tiranno che (...) distrusse chiese, accecò Vescovi, conculcò popoli"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
