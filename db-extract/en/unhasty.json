                        "sense_id": "cde3a0bc-3541-3699-8c3b-678769e68e97",
                        "entry_id": "fe33521d-ba0c-3074-a6c6-f12b55bbe142",
                        "glosses": [
                            "Not hasty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9a338c-f2fb-49ac-ac3b-76d0c1cdc303",
                                "sense_id": "cde3a0bc-3541-3699-8c3b-678769e68e97",
                                "text": "One day nigh wearie of the yrkesome way,\nFrom her vnhastie beast she did alight,"
                            },
                            {
                                "example_id": "b8931914-dfb6-4667-b807-78e974b37c87",
                                "sense_id": "cde3a0bc-3541-3699-8c3b-678769e68e97",
                                "text": "A double file of camels with sumptuous housings moved with dignified and unhasty tread after the litters."
                            },
                            {
                                "example_id": "b587afec-08b0-4230-b269-cfbca7906dad",
                                "sense_id": "cde3a0bc-3541-3699-8c3b-678769e68e97",
                                "text": "The quiet, unhasty, resolved manner in which the Chaplains to the Forces in France are moving is in striking contrast to the hasty proposals and hasty actions threatening on the less prepared soil at home."
                            },
                            {
                                "example_id": "4205de46-2e93-407c-a017-9ad920b0821c",
                                "sense_id": "cde3a0bc-3541-3699-8c3b-678769e68e97",
                                "text": "After a long time (and the chant showed no signs of slackening) he found himself wondering, since Entish was such an ‘unhasty’ language, whether they had yet got further than Good Morning; and if Treebeard was to call the roll, how many days it would take to sing all their names."
                            }
                        ]
                    }
