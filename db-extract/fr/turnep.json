                            {
                                "example_id": "386f9d27-e517-4519-becc-e57d4421c4a4",
                                "sense_id": "588e23c8-d2b7-36aa-9654-e4d2b8a25daa",
                                "text": "Ici, dit le comte, je sème mes turneps. Le turnep est la base de ma culture quadriennale."
                            }
