{
    "word_family": [
        "skimmer",
        "skimming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ddf1409-67a7-31ba-bb17-21d27bca347a",
                    "sense_definition": "to read something quickly, skipping details to get the main points",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not have time to read the whole report, so I decided to <w>skim</w> through the pages.",
                            "target_lang_translations": {
                                "ru": "У меня не было времени читать весь отчет, поэтому я решил <w>пролистать</w> страницы."
                            }
                        },
                        {
                            "text": "She would <w>skim</w> the newspaper every morning while drinking her coffee.",
                            "target_lang_translations": {
                                "ru": "Каждое утро за кофе она <w>пробегала глазами</w> газету."
                            }
                        }
                    ],
                    "synonyms": [
                        "scan"
                    ],
                    "antonyms": [
                        "scrutinize",
                        "study"
                    ],
                    "common_phrases": [
                        "skim through",
                        "skim the newspaper"
                    ],
                    "target_lang_definitions": {
                        "ru": "бегло прочитывать что-либо, пропуская детали, чтобы уловить суть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегло прочитывать",
                                "target_lang_sense_clarification": "читать быстро"
                            },
                            {
                                "target_lang_word": "пролистывать",
                                "target_lang_sense_clarification": "просматривать страницы"
                            },
                            {
                                "target_lang_word": "пробегать глазами",
                                "target_lang_sense_clarification": "быстро ознакомиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44d4d425-a330-316b-a3ff-65383779a33f",
                    "sense_definition": "to move or glide quickly and lightly over a surface",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat began to <w>skim</w> across the surface of the lake.",
                            "target_lang_translations": {
                                "ru": " Маленькая лодка начала <w>скользить</w> по поверхности озера."
                            }
                        },
                        {
                            "text": "We watched the birds <w>skim</w> the water looking for fish.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как птицы <w>проносятся</w> над самой водой в поисках рыбы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skim the surface",
                        "skim across"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро и легко скользить над поверхностью"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "над поверхностью"
                            },
                            {
                                "target_lang_word": "проноситься",
                                "target_lang_sense_clarification": "быстро двигаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be95c40-3b8b-3ed4-a893-1d14d11016ff",
                    "sense_definition": "to remove a substance from the surface of a liquid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>skim</w> the fat off the top of the soup before serving it.",
                            "target_lang_translations": {
                                "ru": "Перед подачей супа следует <w>снять</w> жир с его поверхности."
                            }
                        },
                        {
                            "text": "The chef used a spoon to <w>skim</w> the foam from the boiling liquid.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар ложкой <w>снимал</w> пену с кипящей жидкости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skim the fat",
                        "skim the cream"
                    ],
                    "target_lang_definitions": {
                        "ru": "удалять вещество с поверхности жидкости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "пенку или жир"
                            },
                            {
                                "target_lang_word": "снимать накипь",
                                "target_lang_sense_clarification": "с поверхности жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dda4bf35-a7cb-3080-81d2-daefac10c9ab",
                    "sense_definition": "to throw a flat stone across water so that it bounces",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children spent the afternoon trying to <w>skim</w> stones across the river.",
                            "target_lang_translations": {
                                "ru": "Дети провели весь день, пытаясь <w>пускать блинчики</w> по реке."
                            }
                        },
                        {
                            "text": "He managed to <w>skim</w> the rock five times before it sank.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>запустить</w> камень так, что он подпрыгнул пять раз, прежде чем утонуть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skim stones"
                    ],
                    "target_lang_definitions": {
                        "ru": "бросать плоский камень по воде так, чтобы он подпрыгивал"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускать блинчики",
                                "target_lang_sense_clarification": "камнем по воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a306796-0ef3-3654-b235-59cd7bcc5c13",
                    "sense_definition": "to steal small amounts of money over time from a business before it is recorded",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant was caught trying to <w>skim</w> profits from the company's daily earnings.",
                            "target_lang_translations": {
                                "ru": "Бухгалтера поймали на попытке <w>утаить</w> часть прибыли из ежедневной выручки компании."
                            }
                        },
                        {
                            "text": "They had a sophisticated plan to <w>skim</w> money from the cash registers.",
                            "target_lang_translations": {
                                "ru": "У них был сложный план по <w>присвоению</w> денег из кассовых аппаратов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skim profits",
                        "skim money"
                    ],
                    "target_lang_definitions": {
                        "ru": "незаконно присваивать небольшие суммы денег из выручки до их учета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утаивать",
                                "target_lang_sense_clarification": "часть прибыли"
                            },
                            {
                                "target_lang_word": "присваивать",
                                "target_lang_sense_clarification": "неучтенные деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7f40dc7-9126-3444-9a92-8e5672db8e74",
                    "sense_definition": "to illegally scan a credit or debit card to steal personal information",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Criminals can use hidden devices at gas stations to <w>skim</w> your credit card data.",
                            "target_lang_translations": {
                                "ru": "Преступники могут использовать скрытые устройства на заправках, чтобы <w>считывать</w> данные вашей кредитной карты."
                            }
                        },
                        {
                            "text": "He was arrested for attempting to <w>skim</w> cards at the local ATM.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за попытку <w>скимминга</w> карт в местном банкомате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skim a card"
                    ],
                    "target_lang_definitions": {
                        "ru": "незаконно считывать данные банковской карты для кражи личной информации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скиммить",
                                "target_lang_sense_clarification": "считывать данные карт"
                            },
                            {
                                "target_lang_word": "копировать данные",
                                "target_lang_sense_clarification": "с магнитной полосы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b5df8c0-a66b-3ad8-a813-b1783c0dcb25",
                    "sense_definition": "an act of reading something very quickly to get the general idea",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>skim</w> of the document should be enough to understand the main points.",
                            "target_lang_translations": {
                                "ru": "Беглого <w>просмотра</w> документа должно быть достаточно, чтобы понять основные моменты."
                            }
                        },
                        {
                            "text": "After a brief <w>skim</w> through the book, I decided it wasn't what I was looking for.",
                            "target_lang_translations": {
                                "ru": "После краткого <w>ознакомления</w> с книгой я решил, что это не то, что я искал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick skim",
                        "brief skim"
                    ],
                    "target_lang_definitions": {
                        "ru": "акт очень быстрого чтения для получения общего представления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беглый просмотр",
                                "target_lang_sense_clarification": "текста"
                            },
                            {
                                "target_lang_word": "ознакомление",
                                "target_lang_sense_clarification": "в общих чертах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5060867c-b05d-3c97-b0d6-0f27993a5243",
                    "sense_definition": "milk that has had the cream removed",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to drink <w>skim</w> because it has fewer calories than whole milk.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю пить <w>обезжиренное</w>, потому что в нем меньше калорий, чем в цельном молоке."
                            }
                        },
                        {
                            "text": "She asked for a splash of <w>skim</w> in her morning tea.",
                            "target_lang_translations": {
                                "ru": "Она попросила добавить немного <w>обезжиренного молока</w> в свой утренний чай."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a shorthand for skim milk"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "молоко, из которого удалены сливки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезжиренное молоко",
                                "target_lang_sense_clarification": "без жира"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1615af3-fd88-3dd6-8efe-24a5cc6677d1",
                    "sense_definition": "the illegal practice of taking money from a business before it is officially recorded",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities discovered a massive <w>skim</w> operating within the casino's counting room.",
                            "target_lang_translations": {
                                "ru": "Власти обнаружили масштабную схему <w>утаивания выручки</w> в счетной комнате казино."
                            }
                        },
                        {
                            "text": "He was involved in a <w>skim</w> that cost the company thousands of dollars.",
                            "target_lang_translations": {
                                "ru": "Он был замешан в <w>махинации</w>, которая стоила компании тысячи долларов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "незаконная практика изъятия денег из бизнеса до их официальной регистрации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утаивание выручки",
                                "target_lang_sense_clarification": "до учета"
                            },
                            {
                                "target_lang_word": "скимминг",
                                "target_lang_sense_clarification": "финансовое мошенничество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d6eae1f-63cf-3516-9a6e-5d822fe8b02c",
                    "sense_definition": "describing milk that has had the fat or cream removed",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always buy <w>skim</w> milk because I am trying to eat a low-fat diet.",
                            "target_lang_translations": {
                                "ru": "Я всегда покупаю <w>обезжиренное</w> молоко, так как стараюсь придерживаться диеты с низким содержанием жиров."
                            }
                        },
                        {
                            "text": "The recipe calls for one cup of <w>skim</w> milk and two eggs.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется одна чашка <w>снятого</w> молока и два яйца."
                            }
                        }
                    ],
                    "antonyms": [
                        "whole"
                    ],
                    "common_phrases": [
                        "skim milk"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к молоку, из которого удален жир или сливки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезжиренный",
                                "target_lang_sense_clarification": "о молоке"
                            },
                            {
                                "target_lang_word": "снятой",
                                "target_lang_sense_clarification": "о молоке со снятыми сливками"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}