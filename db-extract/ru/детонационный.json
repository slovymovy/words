                "senses": [
                    {
                        "sense_id": "6e003192-1de6-3601-8244-abcdc3b38b9a",
                        "entry_id": "3b16feea-354e-32da-b3ff-2052ec82ec27",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным детонация"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47abfa0-b973-4747-9ff1-c79c8b7e5d3b",
                                "sense_id": "6e003192-1de6-3601-8244-abcdc3b38b9a",
                                "text": "При накоплении горючих газов в шахте, любая случайная искра или зажжённая спичка может иметь детонационный эффект."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfffb1e7-bfce-3bc1-ab0b-36267be12853",
                        "entry_id": "3b16feea-354e-32da-b3ff-2052ec82ec27",
                        "glosses": [
                            "взрывоопасный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7378f45-a803-4225-b5e4-ccaa0f46a099",
                                "sense_id": "dfffb1e7-bfce-3bc1-ab0b-36267be12853",
                                "text": "Концентрация метана в шахте приближалась к детонационному пределу."
                            }
                        ]
                    }
