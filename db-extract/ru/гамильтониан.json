                ],
                "senses": [
                    {
                        "sense_id": "18fc38a5-2776-331b-b441-aa26ed282592",
                        "entry_id": "d8d27e59-42b8-394d-9839-c450a78b4a99",
                        "glosses": [
                            "физ. функция, описывающая динамику механической системы и зависящая от обобщённых координат, импульсов и, возможно, времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda60f1e-b0cf-4e06-8cfa-6ee25190d82f",
                                "sense_id": "18fc38a5-2776-331b-b441-aa26ed282592",
                                "text": "Гамильтониан ― функция Гамильтона, введена Гамильтоном в 1834 г. для описания движения механических систем; под гамильтонианом понимают квантово-механический оператор, соответствующий функции Гамильтона в классической физике и определяющий эволюцию квантовой системы."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e253b96-6b55-3aa6-8cc9-698b1f4d92c6",
                        "entry_id": "d8d27e59-42b8-394d-9839-c450a78b4a99",
                        "glosses": [
                            "физ. в квантовой теории — оператор, определяющий полную энергию какой-либо системы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76d1c382-cf8f-46a3-a226-15fcec5a7bf5",
                        "source_entry_id": "d8d27e59-42b8-394d-9839-c450a78b4a99",
                        "source_sense_description": "функция Гамильтона",
                        "target_lang_word": "Hamiltonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamiltonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a88235ab-30aa-3bb9-ae22-c1e2701403ee",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Of, attributed to or inspired by the Irish mathematician, astronomer and physicist William Rowan Hamilton (1805–1865)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd97393a-da9a-3bcb-a317-efef0ab8c7c0",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "That visits each vertex exactly once."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4309c08-0176-3e11-854b-ba610703b696",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Containing a Hamiltonian cycle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a288ca1b-69c1-4e06-8b54-f30f195783dc",
                                                "sense_id": "c4309c08-0176-3e11-854b-ba610703b696",
                                                "text": "Using the correction of a vector field to characterize isochronicity and explicit computations of this quantity for polynomial vector fields, wa are able to describe a very large class of nonisochronous Hamiltonian system of even degree of degree arbitrary large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df268a9d-9a78-33ee-a270-b4b72a48d550",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Advocated by American politician Alexander Hamilton (1755–1804)."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88403cda-0a5d-3366-98d8-6467c235e8e9",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Relating to James Hamilton (1769–1831), or his method of teaching languages without grammar, by a literal interlinear word-for-word translation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2879c299-f121-37db-93ab-169bba2618f9",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Of, relating to, or in the literary style of Edmond Hamilton (1904–1977), American science fiction writer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "562ce6ec-4f83-362d-860c-9dc3f5d2f992",
                                        "entry_id": "8342665e-88e5-3066-9787-d0231abb5530",
                                        "glosses": [
                                            "Relating to Sir William Hamilton, 9th Baronet (1788–1856), Scottish metaphysician."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Hamiltonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5096b7d0-5ffc-3d3b-aa4e-36e0268f2e06",
                                        "entry_id": "a790f4bb-2591-3b0f-8c39-4e487aa1412a",
                                        "glosses": [
                                            "A function (of time), denoted H, that corresponds to the total energy of the system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79acced-b23f-4ac8-88a5-a1af7a499a19",
                                                "sense_id": "5096b7d0-5ffc-3d3b-aa4e-36e0268f2e06",
                                                "text": "We contrast this with the case of sampling from the output of a quantum computer running the Quantum Adiabatic Algorithm (QADI) with the restriction that the Hamiltonian that governs the evolution is gapped and stoquastic."
                                            },
                                            {
                                                "example_id": "c2d59914-a08b-48b3-b6fc-a309ff3bbabb",
                                                "sense_id": "5096b7d0-5ffc-3d3b-aa4e-36e0268f2e06",
                                                "text": "As stoquastic problems we use frustrated Ising Hamiltonians, having random local X and Z ﬁelds, and random σ_zσ_z couplings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff33c9c-90bf-3b7a-873b-06d46633acd3",
                                        "entry_id": "a790f4bb-2591-3b0f-8c39-4e487aa1412a",
                                        "glosses": [
                                            "The observable, denoted H, that corresponds to the total energy of the system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5998880f-d932-3e6d-9fea-4e4b42f9c7f7",
                                        "entry_id": "a790f4bb-2591-3b0f-8c39-4e487aa1412a",
                                        "glosses": [
                                            "A member of the faction of the US government in the George Washington administration led by Alexander Hamilton."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
