                    {
                        "form_id": "df0718f3-a5ec-48f0-8c6e-9222afbdf766",
                        "entry_id": "fb830c27-4b7a-3843-9bf3-d87b35cee4a3",
                        "tags": [
                            "une femelle"
                        ],
                        "form": "bourricote"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b693b35-5361-3bd5-acf9-2f3e4200fd33",
                        "entry_id": "fb830c27-4b7a-3843-9bf3-d87b35cee4a3",
                        "glosses": [
                            "Petit âne."
                        ],
                        "tags": [],
                        "note": "Se dit surtout des ânes d’Afrique",
                        "examples": [
                            {
                                "example_id": "e69a5fd0-54b6-4204-a5ff-e3f2a8a6a57e",
                                "sense_id": "4b693b35-5361-3bd5-acf9-2f3e4200fd33",
                                "text": "J’avais souvent rencontré dans ma vie, et sous des cieux divers, des nomades en marche. Mais les plus déshérités et les plus humbles avaient toujours un bagage, si pauvre et primitif qu’il fût, et porté par des animaux de bât, au moins quelques bourricots exténués."
                            }
                        ]
                    },
                    {
                        "sense_id": "593609ef-ab9d-3c40-8a3e-e920fa2c0bbc",
                        "entry_id": "fb830c27-4b7a-3843-9bf3-d87b35cee4a3",
                        "glosses": [
                            "Dénonciateur, bourrique, bourdille."
                        ],
                        "tags": [
                            "dated",
                            "offensive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cf15d16e-96f8-41b6-91fc-1d1da5d81fbd",
                                "sense_id": "593609ef-ab9d-3c40-8a3e-e920fa2c0bbc",
                                "text": "Le mot bourricot est surtout employé dans les camps de travaux publics en Algérie, on nomme ainsi celui qui, pour n’importe quel fait, se plaint au sergent ou à l’adjudant chargé de la garde des détenus."
                            }
                        ]
                    }
                ],
