                        "sense_id": "c78a0d70-f2f5-384a-a37a-709422275ebc",
                        "entry_id": "d3e88cf7-6750-3c08-b60c-4ff9da6461e4",
                        "glosses": [
                            "Programm für Mobiltelefone, Abspielgeräte und Kleincomputer, das dem Zweck dient, die Verbreitung des Coronavirus zu minimieren, indem es zum Beispiel über Kontakte mit einer infizierten Person informiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda0a15d-1499-4b1e-86e8-f053b70acff4",
                                "sense_id": "c78a0d70-f2f5-384a-a37a-709422275ebc",
                                "text": "„Der CCC veröffentlichte auch zehn Prüfsteine, anhand derer die technische Umsetzung einer Corona-App fürs Contact Tracing überprüft werden müsse. Von Apps, die diese Anforderungen nicht erfüllten, rate man ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
