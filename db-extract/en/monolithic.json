                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b38615e5-4c82-4f11-a055-45dae6d0f0ca",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more monolithic"
                    },
                    {
                        "form_id": "8f90e3db-b751-4edc-ae7f-e0b182bdc30d",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most monolithic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86bada19-e03f-3f4b-9c17-8dfbd4647ad4",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "glosses": [
                            "Of or resembling a monolith."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "79d07b1d-6026-36c7-895a-f4809bbdc311",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "glosses": [
                            "Consisting of a single piece of homogeneous material as opposed to a composite material or an assembly of multiple parts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2d3aae-e705-42ff-a2a7-f4aa5d514225",
                                "sense_id": "79d07b1d-6026-36c7-895a-f4809bbdc311",
                                "text": "A monolithic chunk of titanium with facets for cutting, wrenching, and prying."
                            }
                        ]
                    },
                    {
                        "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "glosses": [
                            "Having a massive, unchanging structure that does not permit individual variation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "67f8954d-c286-4368-96cf-a3a1b2c0e203",
                                "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                                "text": "Mainstream culture is hardly the monolithic block that its caricaturization often implies."
                            },
                            {
                                "example_id": "c44c951e-8fc8-4a6f-b903-ed7f6217e59b",
                                "sense_id": "c84d6d59-959e-3af5-b948-6098f42d9e96",
                                "text": "Farming today is industrial, and dominated by monolithic corporations who control almost all the food we eat."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f278fca-90f9-3b02-8bad-87029a4cbcb7",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "glosses": [
                            "Of a single structure, a singular component; instead of an assembly."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "183e1682-b010-4f5d-b1ff-1e6b7601248c",
                                "sense_id": "6f278fca-90f9-3b02-8bad-87029a4cbcb7",
                                "text": "Monolithic space stations only have a single station module."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                        "entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "glosses": [
                            "Consisting of a single program or codebase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a61103-45c6-4c90-90eb-a42dd552e73d",
                                "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                                "text": "Monolithic kernels perform all operating system duties in kernel space."
                            },
                            {
                                "example_id": "797c5327-06af-4d0a-a542-40eee93a1367",
                                "sense_id": "fdf91027-1a2e-3f49-9b0a-446f33573c94",
                                "text": "In the monolithic architecture software system is deployed as a single solution, in which functionally distinguishable aspects are all interwoven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027b36a7-de14-4ec4-a049-99f92df77ced",
                        "source_entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "source_sense_description": "of or resembling a monolith",
                        "target_lang_word": "monolithisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolithisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "733484b0-51dc-325f-9efc-c6cf3c5f61de",
                                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                                        "glosses": [
                                            "gevormd uit één stuk steen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                                        "glosses": [
                                            "van iets dat het kolossaal groot is en uit één massief brok bestaat, één geheel vormend, geïntegreerd, homogeen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae36bdeb-dbc9-48c9-8a73-b9a49e5f96df",
                                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                                "text": "Van de nog niet jarige meester zelf klonk …miserere…. Daarin laat Andriessen, knipogend naar Gregorio Allegri’s beroemde psalmzetting, barokkerige tweestemmigheid ontaarden in monolithische tutti’s en een prachtig geharmoniseerde slotsectie. Jammer dat de vioolaanzetten aanvankelijk wat glibberig waren."
                                            },
                                            {
                                                "example_id": "17055bde-be9f-4661-ab44-990d637c4d3d",
                                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                                "text": "“We zijn hetzelfde bedrijf. We hebben niet opeens drieduizend mensen aangenomen. We zijn geen grote monolithisch rijk waar beslissingen worden genomen in een torentje. We werken nog steeds graag samen met andere partijen. We hebben nog steeds hetzelfde respect en waardering voor talent als we altijd al deden.”"
                                            },
                                            {
                                                "example_id": "2d92b9cb-fde4-4f07-9072-ee233455e231",
                                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                                "text": "Een ander groot complex dat in aanmerking komt voor verplaatsing is De Nederlandsche Bank op het Frederiksplein. Moet dit monstrum er niet met zachte dwang toe worden gebracht zich ten langen leste te voegen bij zijn monolithische vrienden op de Zuidas? Op deze plek kan het glorieuze Paleis voor Volksvlijt worden herbouwd of een ander toegankelijk centrum dat de druk op de overbelaste binnenstad zal verminderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06bf9e55-19f8-3f89-b1f2-453859a689a6",
                                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                                        "glosses": [
                                            "opererend onder één merknaam"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c99fc3a5-bd93-4aa0-a7b4-2b2286d291e2",
                        "source_entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "source_sense_description": "of or resembling a monolith",
                        "target_lang_word": "monolithique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef731249-d61c-3445-8a8a-682068f2c5e2",
                                        "entry_id": "4fe3ca19-2c1c-3963-9515-b70ea7fdf9e6",
                                        "glosses": [
                                            "Qui est d’un seul bloc de pierre, monolithe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502b9fcd-018d-4bd2-a5c1-770448a94a44",
                                                "sense_id": "ef731249-d61c-3445-8a8a-682068f2c5e2",
                                                "text": "Abraham élabora un plan sommaire. Ou plutôt l’ébauche d’un plan sommaire. Mais c’était déjà un début. Un sacré bon début. Il ne manquait qu’un détail pour le mettre à exécution. Quand soudain, au détour du chemin, il débusqua un kopje monolithique, haut comme quatre hommes environ, et qui jouxtait la piste."
                                            },
                                            {
                                                "example_id": "44f73e87-eba8-4d38-ad04-8092ec06ed2f",
                                                "sense_id": "ef731249-d61c-3445-8a8a-682068f2c5e2",
                                                "text": "Un obélisque monolithique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148b10a9-3520-3a06-89c0-68c06ce86c37",
                                        "entry_id": "4fe3ca19-2c1c-3963-9515-b70ea7fdf9e6",
                                        "glosses": [
                                            "Qui forme un bloc, un ensemble rigide, homogène, impénétrable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33703cce-6afd-40a5-a729-94b2d05250b3",
                                                "sense_id": "148b10a9-3520-3a06-89c0-68c06ce86c37",
                                                "text": "La production urbaine d’après-guerre en France a souvent tendance à être abordée de façon monolithique car associée à la période économique des Trente Glorieuses et à la réalisation des grands ensembles."
                                            },
                                            {
                                                "example_id": "c5b678a4-3de8-4ac6-9f6a-7c4124c0e3d4",
                                                "sense_id": "148b10a9-3520-3a06-89c0-68c06ce86c37",
                                                "text": "C’est un parti monolithique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0bfc36-8b5a-366b-b1a0-3644276a2a4c",
                                        "entry_id": "4fe3ca19-2c1c-3963-9515-b70ea7fdf9e6",
                                        "glosses": [
                                            "Qui forme un bloc, un ensemble rigide, homogène, impénétrable.",
                                            "En parlant du noyau d’un système d’exploitation, qui consiste en un seul programme résidant dans un seul espace d’adressage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99df28b5-fd9b-369c-8b1f-eea71a644d1c",
                                        "entry_id": "4fe3ca19-2c1c-3963-9515-b70ea7fdf9e6",
                                        "glosses": [
                                            "Qui forme un bloc, un ensemble rigide, homogène, impénétrable.",
                                            "En parlant d’un programme, qui n'est pas scindé en plusieurs couches, modules ou services."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae39f1f-1565-4940-a18e-6b56ebce0626",
                                                "sense_id": "99df28b5-fd9b-369c-8b1f-eea71a644d1c",
                                                "text": "Procéder ainsi est plus simple, plus rapide et plus sûr que de multiplier les blocs d’instructions similaires dans un corps de programme monolithique, de plus en plus volumineux et de moins en moins compréhensible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9dbb184-c8ea-4a48-80ad-db679e543966",
                        "source_entry_id": "0ad518ce-f414-36df-9f44-dea9bc333598",
                        "source_sense_description": "of or resembling a monolith",
                        "target_lang_word": "monolithisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monolithisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4066fc5f-963c-3af0-a774-3956adb86b7f",
                                        "entry_id": "29c409e1-e0ac-3b2f-a9e9-c499779d4ce7",
                                        "glosses": [
                                            "aus einer einheitlichen, nicht trennbaren Einheit bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f813d7-032d-4a17-9ee7-64b6975efbc8",
                                                "sense_id": "4066fc5f-963c-3af0-a774-3956adb86b7f",
                                                "text": "„Ihr Glaube an die Kraft der Argumente und die Dynamik einer demokratischen Streitkultur trotzte bis zuletzt einer monolithisch erscheinenden konservativ-liberalen Mehrheit in der Bundesversammlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
