                                        "glosses": [
                                            "odnoszący się do Kairu, związany z Kairem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "234a7656-1883-4cd3-8556-95180048dbaa",
                                                "sense_id": "75826450-8b2f-3eb9-b1ab-0e7772189b66",
                                                "text": "Ogromne lotnisko kairskie, jeden z największych punktów przelotowych świata, dudniło nie milknącym hukiem motorów"
                                            },
                                            {
                                                "example_id": "baec4e4c-401a-416f-bb44-0e25abe7f074",
                                                "sense_id": "75826450-8b2f-3eb9-b1ab-0e7772189b66",
                                                "text": "Postanowiliśmy, że to ja dokonam próby odczytania tego osobliwego przekazu, korzystając z pracowni naukowych Muzeum Kairskiego, a następnie wrócę do Anglii i będę kontynuował badania w British Museum"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
