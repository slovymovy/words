                "senses": [
                    {
                        "sense_id": "bc21cf24-4dc0-3bc1-8292-38ccb3b09a71",
                        "entry_id": "bca82b00-2210-320b-a3b1-01fc292c34fe",
                        "glosses": [
                            "het begin van een brand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5a641b-ed6f-4bc1-9363-b470b7bdbccb",
                                "sense_id": "bc21cf24-4dc0-3bc1-8292-38ccb3b09a71",
                                "text": "Een ooggetuige vertelde tegen de politie dat er vlammen uit de koelkast waren gekomen. In de buurt van het apparaat werden duidelijke sporen van brand aangetroffen, wat erop kan wijzen dat het toestel inderdaad de vuurhaard was."
                            },
                            {
                                "example_id": "53b5af40-ba40-4f9f-971e-016189dc581c",
                                "sense_id": "bc21cf24-4dc0-3bc1-8292-38ccb3b09a71",
                                "text": "Een enorme brand heeft in de nacht van dinsdag op woensdag een bedrijfspand in Wateringen volledig verwoest. Het vuur brak uit in de hal van Verkade klimaat op een bedrijventerrein aan de Turfschipper en groeide al snel uit tot een enorme vuurhaard. De rookwolken die daarbij vrijkwamen waren tot ver in de regio te zien. Het pand kan als verloren worden beschouwd."
                            }
                        ]
                    },
                    {
                        "sense_id": "7984cd4e-060d-3066-8c47-bd311abbce46",
                        "entry_id": "bca82b00-2210-320b-a3b1-01fc292c34fe",
                        "glosses": [
                            "kachel met open vuur in een woonhuis; open haard"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6d14be3-dde7-4e2f-bad4-bd78ca81dfde",
                        "source_entry_id": "bca82b00-2210-320b-a3b1-01fc292c34fe",
                        "source_sense_id": "bc21cf24-4dc0-3bc1-8292-38ccb3b09a71",
                        "source_sense_description": "begin van een brand",
                        "target_lang_word": "inferno",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inferno",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f17d87-51e0-3f14-a8d4-328aa0757fe1",
                                        "entry_id": "5e07e9ed-a6a7-306c-89d5-0ee6fecd60c7",
                                        "glosses": [
                                            "A place or situation resembling Hell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa36a8e9-e2b3-4432-9894-e987b4792090",
                                                "sense_id": "29f17d87-51e0-3f14-a8d4-328aa0757fe1",
                                                "text": "At each sudden explosion in the inferno below they sprang back from the brink [of the volcanic crater]."
                                            },
                                            {
                                                "example_id": "a1622d31-e9bc-4763-9155-b39c14d0cd5e",
                                                "sense_id": "29f17d87-51e0-3f14-a8d4-328aa0757fe1",
                                                "text": "When Jurgis had first inspected the packing plants with Szedvilas, he […] found that each one of these lesser industries was a separate little inferno, in its way as horrible as the killing beds, the source and fountain of them all[, and t]he workers in each of them had their own peculiar diseases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b785192c-32c2-3086-b915-587e5077df41",
                                        "entry_id": "5e07e9ed-a6a7-306c-89d5-0ee6fecd60c7",
                                        "glosses": [
                                            "A large fire; a conflagration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f999ae5a-ec7c-45f5-943f-d751e053509f",
                                                "sense_id": "b785192c-32c2-3086-b915-587e5077df41",
                                                "text": "The inferno ripped through the forest, destroying anything in its path."
                                            },
                                            {
                                                "example_id": "5e484a87-b76a-4d4e-b40e-c7704b984f98",
                                                "sense_id": "b785192c-32c2-3086-b915-587e5077df41",
                                                "text": "Blast after blast, fiery outbreak after fiery outbreak, like a flaming barrage from within,[…]most of Edison's grounds soon became an inferno. As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            },
                                            {
                                                "example_id": "cc171d4c-538f-4f0c-b743-0d486af829e7",
                                                "sense_id": "b785192c-32c2-3086-b915-587e5077df41",
                                                "text": "Unfortunately for Admiral Kurita, this is where the good news ends. The fire started by New Jerseys hit amidships has spread, and there is now a towering inferno' that occupies the middle third of the Japanese battleship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fb0638a-8854-452e-af57-debbabb5e32e",
                        "source_entry_id": "bca82b00-2210-320b-a3b1-01fc292c34fe",
                        "source_sense_id": "bc21cf24-4dc0-3bc1-8292-38ccb3b09a71",
