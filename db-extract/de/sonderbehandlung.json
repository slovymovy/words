                ],
                "senses": [
                    {
                        "sense_id": "79cf9437-2459-33fe-9ffe-f999d5258b51",
                        "entry_id": "06a06aff-8a39-3564-8976-60f1ffb0093a",
                        "glosses": [
                            "besondere, meist bevorzugende Behandlung einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6ea59e-d314-4002-a6cc-23329dfd750a",
                                "sense_id": "79cf9437-2459-33fe-9ffe-f999d5258b51",
                                "text": "„Jérémy Chardy kritisiert die Sonderbehandlung der Top-3-Spielerinnen und -Spieler bei den Australian Open.“"
                            },
                            {
                                "example_id": "f70257dc-c76c-4c4c-97de-c8e81d8f4329",
                                "sense_id": "79cf9437-2459-33fe-9ffe-f999d5258b51",
                                "text": "„Auf der einen Seite war mein Körper sehr empfindlich, schreckhaft und verletzlich, was jede Sonderbehandlung absolut notwendig machte.“"
                            },
                            {
                                "example_id": "2b6131fb-11f4-40dd-9c74-ce99c100453f",
                                "sense_id": "79cf9437-2459-33fe-9ffe-f999d5258b51",
                                "text": "„Nur weil Sie königlichen Geblüts sind, haben Sie keinen Anspruch auf Sonderbehandlung.“"
                            },
                            {
                                "example_id": "014e87db-a8d7-4ea3-a18f-b115a72ac9f9",
                                "sense_id": "79cf9437-2459-33fe-9ffe-f999d5258b51",
                                "text": "„Die Sonderbehandlung ermöglicht zugleich eine schärfere Abgrenzung der wirklich strafwürdigen Fälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa965380-a881-3694-905d-da077dbe4b88",
                        "entry_id": "06a06aff-8a39-3564-8976-60f1ffb0093a",
                        "glosses": [
                            "Tarnbezeichnung in der NS-Sprache für die Ermordung von Menschen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bc4e84dc-4237-44c3-b93e-3998d56161d7",
                                "sense_id": "fa965380-a881-3694-905d-da077dbe4b88",
                                "text": "„Die Sonderbehandlung(3) erfolgt durch Strang.“"
                            },
                            {
                                "example_id": "731763b1-66b4-41ff-a3d7-b4fdc237658e",
                                "sense_id": "fa965380-a881-3694-905d-da077dbe4b88",
                                "text": "„Dementsprechend wird in der Regel nur mit harten Maßnahmen, d. h. Einweisung in ein Konzentrationslager oder Sonderbehandlung, vorzugehen sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
