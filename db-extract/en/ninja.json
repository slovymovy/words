            {
                "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                "word": "ninja",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "be6db944-f801-4e6f-a3d3-9f302763b41c",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "tags": [
                            "plural"
                        ],
                        "form": "ninja"
                    },
                    {
                        "form_id": "eceffad8-06fe-4326-818d-508418b4e2f7",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "tags": [
                            "plural"
                        ],
                        "form": "ninjas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "A person trained in ninjutsu, especially (historical) one used for espionage, assassination, and other tasks requiring stealth during Japan's shogunate period."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7785d4-eb12-459c-9619-86d0bef3b89f",
                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                "text": "He used to work in the Japanese agency as a ninja."
                            },
                            {
                                "example_id": "c566e5ce-2634-4498-9dcd-909a6749ab92",
                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                "text": "The men... are now learning to be ninja or ‘stealers-in’."
                            },
                            {
                                "example_id": "67f8449c-9cbf-4402-b9d9-f115749ec433",
                                "sense_id": "b02d96f5-f96a-3348-8815-88b5dfa90672",
                                "text": "Spies prowled Japan from the seventh century, but the secretive ninja left few written records."
                            }
                        ]
                    },
                    {
                        "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "A person considered similarly skillful to the historical ninja, especially in covert or stealthy operation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9c0eb568-0234-4486-a3d2-e9df06f3355b",
                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                "text": "Young banking and securities firms executives (nicknamed the ninja...) are especially assigned to cultivate relations with the finance ministry. Only verbal instructions are ever given to the ninja."
                            },
                            {
                                "example_id": "3363f06c-52cf-46fc-9be3-2464868cb03b",
                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                "text": "A JavaScript ninja should write lots of code and build things!"
                            },
                            {
                                "example_id": "afc5e731-be1a-4b58-abec-c0e5232dc5c8",
                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                "text": "For months the Japanese spoke of national-security adviser Henry Kissinger as a ninja—the magician of Japanese legends who performs supernatural acts and practices sorcery."
                            },
                            {
                                "example_id": "0c0421c8-d573-4d3c-bffa-2daac3e84403",
                                "sense_id": "792dc79f-a329-318a-9653-81e3f1f488ca",
                                "text": "Other bankers are dubbing themselves ninja, modern-day descendants of the superspies of 17th century samurai houses."
                            }
                        ]
                    },
                    {
                        "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "A person considered similarly skillful to the historical ninja, especially in covert or stealthy operation.",
                            "A notional draconian arm of a corporation (originally Nintendo), tasked with dealing with individuals that infringe on its rights or do not comply with its regulations."
                        ],
                        "tags": [
                            "figuratively",
                            "in-plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7ef24056-159a-437b-8d3e-e199273b92b6",
                                "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                                "text": "I had TOTK running on my pc 2 weeks before it released on the switch and I'm still here. They can send the ninjas, I'm waiting."
                            },
                            {
                                "example_id": "0a5d4bae-a10b-4842-b40a-2f6f4f358d88",
                                "sense_id": "3475efa3-1b1a-3165-9f8e-61c98effb617",
                                "text": "Nintendo ninjas were inside the discord, watching. Now all the Yuzu devs have turned over all electronic devices, websites, logs..."
                            }
                        ]
                    },
                    {
                        "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "A person considered to look like the historical ninja in some way, including (historical slang) an amateur private miner in Mongolia."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6e9b374d-363d-4255-92f1-fab19894fac3",
                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                "text": "He immediately suspected they were ninjas because, he said, they were dressed in black and wore masks, trademarks of the mysterious assassins who have been sowing terror across East Java in recent months."
                            },
                            {
                                "example_id": "e91db1ac-b5e1-4939-bb6a-6ba10b50df79",
                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                "text": "Yen buyers were more subdued... fearing the Bank of Japan's new strategy of covert intervention to buy U.S. dollars through agent banks—described by some as the central bank's ninjas or secret agents."
                            },
                            {
                                "example_id": "0ec2722c-ef95-4843-9746-840134ff7f1b",
                                "sense_id": "aafc6ace-db32-3935-8606-7b4018016f72",
                                "text": "Many were former nomads, but as the gold rush gathered pace, students, vets and taxi drivers from Ulan Bator joined the ninjas, not just in Ogoomor but in other gold towns across the country."
                            }
                        ]
                    },
                    {
                        "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "Synonym of nigga as a friendly term of address."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "6d4cee6d-839e-4a57-a98a-faf15e5b81c5",
                                "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                                "text": "What's up, ninjas?"
                            },
                            {
                                "example_id": "5931c33c-3c58-4383-9a0d-4c8017f050aa",
                                "sense_id": "e29fbe25-9e58-3578-8b5e-50963b02c266",
                                "text": "I'm thicker than a Snicker, I'm thicker than your ninja!"
                            }
                        ]
                    },
                    {
                        "sense_id": "09842b73-4642-386d-9a55-6ce67d33fcfa",
                        "entry_id": "52275a73-9ef3-3bc9-8e9e-a30ab3ba627d",
                        "glosses": [
                            "Synonym of nigga as a friendly term of address.",
                            "Synonym of man as a friendly term of address."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "84ffd302-5969-477a-ac9e-1b32fc816eb7",
                                "sense_id": "09842b73-4642-386d-9a55-6ce67d33fcfa",
                                "text": "What up, my ninja!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2e61835-5769-3d3f-a660-580e3daa5c98",
