    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b389e529-836c-34c8-9438-eeeaabf6671b",
                    "sense_definition": "Не поддающийся сжатию, изменению формы при нажатии; плотный, крепкий на ощупь.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот старый хлеб стал слишком <w>твёрдым</w>, поэтому его невозможно разрезать ножом.",
                            "target_lang_translations": {
                                "en": "This stale bread has become too <w>hard</w>, so it is impossible to cut with a knife."
                            }
                        },
                        {
                            "text": "Мы шли по лесной тропинке, где была сухая и <w>твёрдая</w> земля под ногами.",
                            "target_lang_translations": {
                                "en": "We were walking along a forest path where there was dry and <w>hard</w> ground under our feet."
                            }
                        }
                    ],
                    "synonyms": [
                        "жёсткий",
                        "прочный"
                    ],
                    "antonyms": [
                        "мягкий",
                        "податливый"
                    ],
                    "common_phrases": [
                        "твёрдый сыр",
                        "твёрдая поверхность",
                        "твёрдый переплёт"
                    ],
                    "target_lang_definitions": {
                        "en": "Resistant to pressure, not easily compressed or penetrated; firm, solid, or stiff to the touch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "resistant to pressure; firm to the touch"
                            },
                            {
                                "target_lang_word": "firm",
                                "target_lang_sense_clarification": "solid and compact; not soft"
                            },
                            {
                                "target_lang_word": "solid",
                                "target_lang_sense_clarification": "substantial and hard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f68eb04-a600-3553-881f-b3d5cd520ee4",
                    "sense_definition": "Находящийся в состоянии вещества, сохраняющего форму и объём в отличие от жидкого и газообразного.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При сильном морозе вода быстро превращается в <w>твёрдое</w> вещество — лёд.",
                            "target_lang_translations": {
                                "en": "In severe frost, water quickly turns into a <w>solid</w> substance—ice."
                            }
                        },
                        {
                            "text": "На уроке физики ученики изучали свойства различных <w>твёрдых</w> тел.",
                            "target_lang_translations": {
                                "en": "In physics class, the students studied the properties of various <w>solids</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "застывший"
                    ],
                    "antonyms": [
                        "газообразный",
                        "жидкий"
                    ],
                    "common_phrases": [
                        "твёрдое тело",
                        "твёрдое состояние",
                        "твёрдое топливо"
                    ],
                    "target_lang_definitions": {
                        "en": "Existing in a state of matter that retains its shape and density, rather than liquid or gas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solid",
                                "target_lang_sense_clarification": "state of matter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e040a1b4-1cd2-3733-804a-3092983905d8",
                    "sense_definition": "Непоколебимый, уверенный, не поддающийся сомнениям или постороннему влиянию.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "firmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор высказал своё решение спокойным и очень <w>твёрдым</w> голосом.",
                            "target_lang_translations": {
                                "en": "The director stated his decision in a calm and very <w>firm</w> voice."
                            }
                        },
                        {
                            "text": "У этого молодого человека есть <w>твёрдые</w> жизненные принципы, которым он всегда следует.",
                            "target_lang_translations": {
                                "en": "This young man has <w>firm</w> principles in life that he always follows."
                            }
                        }
                    ],
                    "synonyms": [
                        "непоколебимый",
                        "устойчивый",
                        "неколебимый"
                    ],
                    "antonyms": [
                        "изменчивый",
                        "непостоянный"
                    ],
                    "common_phrases": [
                        "твёрдая воля",
                        "твёрдая уверенность",
                        "твёрдый шаг"
                    ],
                    "target_lang_definitions": {
                        "en": "Steadfast, confident, and resolute; not yielding to doubts, hesitations, or outside influence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "firm",
                                "target_lang_sense_clarification": "resolute, unwavering, steady"
                            },
                            {
                                "target_lang_word": "steadfast",
                                "target_lang_sense_clarification": "dutifully firm and unwavering"
                            },
                            {
                                "target_lang_word": "resolute",
                                "target_lang_sense_clarification": "determined and unwavering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c582840c-0ebe-39b7-a421-225746e220a9",
                    "sense_definition": "Строго установленный, постоянный, не подлежащий изменению или колебаниям.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "firmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государство ввело <w>твёрдые</w> цены на основные продукты питания первой необходимости.",
                            "target_lang_translations": {
                                "en": "The state introduced <w>fixed</w> prices for staple foodstuffs."
                            }
                        },
                        {
                            "text": "Для успешной реализации проекта нам нужен <w>твёрдый</w> график выполнения всех работ.",
                            "target_lang_translations": {
                                "en": "For the project to succeed, we need a <w>fixed</w> schedule for carrying out all the work."
                            }
                        }
                    ],
                    "synonyms": [
                        "устойчивый"
                    ],
                    "antonyms": [
                        "непостоянный",
                        "изменчивый"
                    ],
                    "common_phrases": [
                        "твёрдые цены",
                        "твёрдый оклад",
                        "твёрдая валюта"
                    ],
                    "target_lang_definitions": {
                        "en": "Strictly established, fixed, and not subject to changes or fluctuations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fixed",
                                "target_lang_sense_clarification": "predetermined and unchanging"
                            },
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "firm and unyielding (e.g. hard currency, hard deadline)"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "fixed and invariable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb5f0e2-f370-38e0-9332-143b69746e1f",
                    "sense_definition": "Основательный, прочный, надежный и хорошо усвоенный (о знаниях, навыках).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "soundness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для поступления в этот престижный университет нужны глубокие и <w>твёрдые</w> знания грамматики.",
                            "target_lang_translations": {
                                "en": "Admission to this prestigious university requires deep and <w>solid</w> knowledge of grammar."
                            }
                        },
                        {
                            "text": "Студент получил на экзамене заслуженную и вполне <w>твёрдую</w> четвёрку.",
                            "target_lang_translations": {
                                "en": "The student received a well-deserved and very <w>solid</w> B on the exam."
                            }
                        }
                    ],
                    "synonyms": [
                        "прочный"
                    ],
                    "common_phrases": [
                        "твёрдые знания",
                        "твёрдая четвёрка",
                        "твёрдая память"
                    ],
                    "target_lang_definitions": {
                        "en": "Thorough, reliable, robust, and well-mastered (of knowledge, skills, or grades)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solid",
                                "target_lang_sense_clarification": "thorough and well-grounded (knowledge, grade)"
                            },
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "reliable and deep (knowledge)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41dd94a-62de-336e-89bc-1718747c87d8",
                    "sense_definition": "Произносимый без смягчения, без подъёма средней части спинки языка к нёбу (о согласных звуках).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В русском алфавите есть <w>твёрдый</w> знак, который не обозначает отдельного звука.",
                            "target_lang_translations": {
                                "en": "In the Russian alphabet, there is the <w>hard</w> sign, which does not represent a separate sound."
                            }
                        },
                        {
                            "text": "Иностранным студентам бывает трудно различить на слух мягкие и <w>твёрдые</w> согласные.",
                            "target_lang_translations": {
                                "en": "Foreign students often find it difficult to distinguish soft and <w>hard</w> consonants by ear."
                            }
                        }
                    ],
                    "antonyms": [
                        "мягкий"
                    ],
                    "common_phrases": [
                        "твёрдый знак",
                        "твёрдый согласный"
                    ],
                    "target_lang_definitions": {
                        "en": "Pronounced without palatalization, non-palatalized (of consonant sounds)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "non-palatalized, plain consonant"
                            },
                            {
                                "target_lang_word": "non-palatalized",
                                "target_lang_sense_clarification": "phonetic term for hard consonants"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}