                "senses": [
                    {
                        "sense_id": "8d1fe34b-cc31-35fd-a350-16b79d5be9a8",
                        "entry_id": "0258d3d9-347d-3373-8fc7-f43a0eb2a007",
                        "glosses": [
                            "von einer Institution/Organisation entsandte Abordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f7fca1a-acfe-40e2-ad63-e777ef4b1222",
                                "sense_id": "8d1fe34b-cc31-35fd-a350-16b79d5be9a8",
                                "text": "„Dort stieg er vom Pferd, wanderte an einer Mauer auf und ab und wartete auf die Deputation der Stadt, die ihn mit Schlüssel sowie Brot und Salz empfangen sollte, wie es üblich war in den Kriegen.“"
                            },
                            {
                                "example_id": "2c58cdde-68f7-4c12-9d40-8f43efa7edd4",
                                "sense_id": "8d1fe34b-cc31-35fd-a350-16b79d5be9a8",
                                "text": "„Napoleon frühstückte und stand dann wieder auf der Stelle von vorhin, oben auf dem Poklonnaja-Berge, in Erwartung der Deputation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
