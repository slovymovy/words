                        "translation_id": "e5e7aca4-fc74-41b1-9b5d-57aed8ea82a6",
                        "source_entry_id": "f1f20108-f42e-3e58-930a-86803dc3a1dd",
                        "source_sense_description": "act of deforming, or state of being deformed",
                        "target_lang_word": "vervorming",
