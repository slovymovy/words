{
    "word_family": [
        "strike",
        "striker",
        "striking",
        "strikingness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bcc2d99d-27ea-35e8-8843-2e1da345c264",
                    "sense_definition": "To a remarkable, highly noticeable, or extreme degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remarkable_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sisters look <w>strikingly</w> similar, often confusing their own teachers.",
                            "target_lang_translations": {
                                "ru": "Две сестры <w>поразительно</w> похожи друг на друга, часто сбивая с толку собственных учителей."
                            }
                        },
                        {
                            "text": "The new model is <w>strikingly</w> different from its predecessor in terms of design.",
                            "target_lang_translations": {
                                "ru": "Новая модель <w>разительно</w> отличается от своей предшественницы с точки зрения дизайна."
                            }
                        }
                    ],
                    "synonyms": [
                        "remarkably",
                        "noticeably",
                        "conspicuously",
                        "outstandingly"
                    ],
                    "antonyms": [
                        "unremarkably",
                        "slightly"
                    ],
                    "common_phrases": [
                        "strikingly different",
                        "strikingly similar",
                        "strikingly handsome"
                    ],
                    "target_lang_definitions": {
                        "ru": "В замечательной, крайне заметной или исключительной степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поразительно",
                                "target_lang_sense_clarification": "в высшей степени, вызывая удивление"
                            },
                            {
                                "target_lang_word": "удивительно",
                                "target_lang_sense_clarification": "необычайно, в значительной степени"
                            },
                            {
                                "target_lang_word": "заметно",
                                "target_lang_sense_clarification": "явно, очевидно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9adc859-94b5-3702-b72a-fc6fe4bf8247",
                    "sense_definition": "Used to introduce a statement that is surprising or remarkable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentence_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Strikingly</w>, none of the participants reported any side effects during the trial.",
                            "target_lang_translations": {
                                "ru": "<w>Что поразительно</w>, никто из участников не сообщил о каких-либо побочных эффектах во время испытания."
                            }
                        },
                        {
                            "text": "The company managed to double its profits and, <w>strikingly</w> enough, did so without raising prices.",
                            "target_lang_translations": {
                                "ru": "Компании удалось удвоить свою прибыль и, <w>как ни удивительно</w>, сделать это без повышения цен."
                            }
                        }
                    ],
                    "synonyms": [
                        "surprisingly",
                        "remarkably",
                        "astonishingly"
                    ],
                    "antonyms": [
                        "predictably",
                        "unsurprisingly"
                    ],
                    "common_phrases": [
                        "strikingly enough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения утверждения, которое является удивительным или примечательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поразительно",
                                "target_lang_sense_clarification": "удивительно то, что"
                            },
                            {
                                "target_lang_word": "что поразительно",
                                "target_lang_sense_clarification": "вводное выражение"
                            },
                            {
                                "target_lang_word": "удивительно",
                                "target_lang_sense_clarification": "как ни странно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b90566f4-a443-3ed2-97c1-7af705128aee",
                    "sense_definition": "In a manner that attracts attention or makes a strong visual impression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>strikingly</w> dressed in a bright red gown that stood out in the crowd.",
                            "target_lang_translations": {
                                "ru": "Она была <w>эффектно</w> одета в ярко-красное платье, которое выделялось в толпе."
                            }
                        },
                        {
                            "text": "The gallery was <w>strikingly</w> decorated with modern sculptures and colorful paintings.",
                            "target_lang_translations": {
                                "ru": "Галерея была <w>броско</w> украшена современными скульптурами и красочными картинами."
                            }
                        }
                    ],
                    "synonyms": [
                        "impressively",
                        "dramatically",
                        "showily"
                    ],
                    "antonyms": [
                        "plainly",
                        "drably"
                    ],
                    "common_phrases": [
                        "strikingly dressed",
                        "strikingly decorated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что это привлекает внимание или производит сильное визуальное впечатление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эффектно",
                                "target_lang_sense_clarification": "производя сильное внешнее впечатление"
                            },
                            {
                                "target_lang_word": "броско",
                                "target_lang_sense_clarification": "привлекая внимание внешним видом"
                            },
                            {
                                "target_lang_word": "поразительно",
                                "target_lang_sense_clarification": "необычайно красиво или выразительно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}