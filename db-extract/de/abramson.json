                "senses": [
                    {
                        "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                        "entry_id": "98eb04b2-352f-3c75-a49e-cb6bd556d68e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11aa5ca1-8b80-4e09-aa48-e12be1b2e812",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Frau Abramson ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9b853792-6ad3-4b63-bfd6-421560ea92ca",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Herr Abramson wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "770114ca-b97d-4e86-a65b-c0f138b57735",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Die Abramsons fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "56855f4a-5660-4b3d-827e-32d2385b8856",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Der Abramson trägt nie die Schals, die die Abramson ihm strickt."
                            },
                            {
                                "example_id": "04a6fad4-05c6-4107-8bf1-008f3c0dd5b5",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Abramson kommt, geht der Herr Abramson.“"
                            },
                            {
                                "example_id": "2c485c8b-a682-4e18-bd1a-d0d681766a55",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Abramson kommt und geht."
                            },
                            {
                                "example_id": "8eef5709-fe7f-40a9-b19e-d33a82ce764b",
                                "sense_id": "ca0072f4-bdac-3bd0-bc61-f47d4ec70b8a",
                                "text": "Abramsons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
