                                                "example_id": "698594e3-2ebf-43fd-8f92-c1b423c26d95",
                                                "sense_id": "fba088f2-9955-3dad-bb82-da4a42eafcc7",
                                                "text": "Les artiodactyles sont plus nombreux que les périssodactyles."
                                            },
                                            {
                                                "example_id": "198a926f-ed68-4456-951d-d484d5ba5a80",
                                                "sense_id": "fba088f2-9955-3dad-bb82-da4a42eafcc7",
                                                "text": "Espérons juste que cet enfant ne soit pas un artiodactyle, un bovidé, un capriné."
                                            }
