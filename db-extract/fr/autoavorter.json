                        "entry_id": "fe5f8dad-4492-3242-aa40-28827321c9f0",
                        "glosses": [
                            "Avorter par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bdaa7a6-41a6-49c3-a577-0e150fb639d7",
                                "sense_id": "5e20a6d0-e35f-3e23-8c18-847502b91af6",
                                "text": "Si votre corps a décidé que vous deviez autoavorter parce que l’embryon que vous portez est malformé ou pour tout autre raison, cela vous arrivera que vous fassiez l’amour ou non."
                            },
                            {
                                "example_id": "82a7cdd4-23cb-4a8f-9063-14059de0cfc4",
                                "sense_id": "5e20a6d0-e35f-3e23-8c18-847502b91af6",
                                "text": "En revanche, l’article supprimant toute incrimination pénale à l’encontre de la femme s’étant autoavortée a été validé."
                            }
                        ]
