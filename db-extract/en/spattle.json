                    {
                        "sense_id": "263ca147-32dd-3555-9ecd-f57924db8e16",
                        "entry_id": "23833f28-8c4e-3df6-b938-bf3f175ffc30",
                        "glosses": [
                            "To spit."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "820589ac-dd4a-4d73-8782-9dea0f936066",
                                "sense_id": "263ca147-32dd-3555-9ecd-f57924db8e16",
                                "text": "I can worke wyles in battle, If I do ones but spattle"
                            },
                            {
                                "example_id": "e0f3033e-6d50-4f03-abc5-5046b25c90a0",
                                "sense_id": "263ca147-32dd-3555-9ecd-f57924db8e16",
                                "text": "I would I had a fountain of spittle to spattle on them : I would my spittle might be of so great virtue against them as the words of St Paul[…]"
                            },
                            {
                                "example_id": "2c79b749-1651-4695-a2b1-7d6bc09d3596",
                                "sense_id": "263ca147-32dd-3555-9ecd-f57924db8e16",
                                "text": "He spattled. \"It's brand new,\" said Hector Grimthorpe, indicating his Corvair."
                            }
                        ]
                    }
                ],
