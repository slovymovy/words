                                    {
                                        "sense_id": "82b35840-9eaf-35a9-b2d9-b7a17bcbb284",
                                        "entry_id": "89038115-1d4b-368c-a568-bd5559838756",
                                        "glosses": [
                                            "An instance of colliding."
