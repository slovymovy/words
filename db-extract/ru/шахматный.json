                            {
                                "example_id": "cb29631f-32d1-4420-ad4c-6e2a66c49ea1",
                                "sense_id": "2f1bc7eb-1c7b-3bef-b95e-04872f92b366",
                                "text": "ша́хматная доска́",
                                "translation": "chessboard",
                                "english": "chessboard"
                            },
                            {
                                "example_id": "e6bb1af5-0154-49db-af08-e32bb73ce39a",
                                "sense_id": "2f1bc7eb-1c7b-3bef-b95e-04872f92b366",
                                "text": "в ша́хматном поря́дке",
                                "translation": "in a checkerboard pattern",
                                "english": "in a checkerboard pattern"
                            },
                            {
                                "example_id": "1534d64f-bb8e-46de-a6ee-337ff3dd9e45",
                                "sense_id": "2f1bc7eb-1c7b-3bef-b95e-04872f92b366",
                                "text": "Они́ зна́ли, что покупа́телю и торго́вцу не сле́дует меша́ть, они́ де́лали вид, что ничего́ не слы́шат и не ви́дят, что они́ погружены́ в ша́хматную игру́.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
