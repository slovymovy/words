                        ],
                        "form": "het buitenland"
                    },
                    {
                        "form_id": "eb43d054-21f1-49fd-b8d1-eff59e7e973a",
                        "entry_id": "46c22b91-9d9e-3ac3-be32-3114c5433238",
                        "tags": [
                            "singular"
                        ],
                        "form": "de buitenlanden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77e7e177-0f7e-3c76-bd55-dce8a0c7c285",
                        "entry_id": "46c22b91-9d9e-3ac3-be32-3114c5433238",
                        "glosses": [
                            "Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e32a5a-8741-4527-b31b-7b20ae622142",
                                "sense_id": "77e7e177-0f7e-3c76-bd55-dce8a0c7c285",
                                "text": "Veel mensen gaan in het buitenland op vakantie.",
                                "translation": "Viele Menschen gehen im Ausland auf Urlaub."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafd9284-61e5-4d19-9060-1a7317867de9",
                        "source_entry_id": "46c22b91-9d9e-3ac3-be32-3114c5433238",
                        "source_sense_id": "77e7e177-0f7e-3c76-bd55-dce8a0c7c285",
                        "source_sense_description": "Ausland",
                        "target_lang_word": "Ausland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea990b5a-e62e-32fa-bf81-97da444e878a",
                                        "entry_id": "e4f62540-445f-3880-be2a-54901150c2bb",
                                        "glosses": [
                                            "Land oder Länder außerhalb des eigenen Staatsgebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0607a112-7e45-4c98-828f-c03f5888741e",
                                                "sense_id": "ea990b5a-e62e-32fa-bf81-97da444e878a",
                                                "text": "Wir machen unseren nächsten Urlaub im Ausland."
                                            },
                                            {
                                                "example_id": "cb2478c4-f87c-44ee-9b32-9f2ccd670c2f",
                                                "sense_id": "ea990b5a-e62e-32fa-bf81-97da444e878a",
                                                "text": "„Wenn man im Ausland lebt, selbst wenn dieses Exil freiwillig ist, selbst wenn das neue Land dem alten kulturell nahesteht, sitzt man immer zwischen zwei Stühlen, und das ist nicht sehr bequem.“"
                                            },
                                            {
                                                "example_id": "54c7053f-b5ba-485a-9ebe-9168f8a4b565",
                                                "sense_id": "ea990b5a-e62e-32fa-bf81-97da444e878a",
                                                "text": "„Sie erzählte von den Schmeicheleien, die er ihr gesagt hatte; dann habe er geäussert, er wolle ins Ausland reisen, und sie gefragt, wo die Familie Rostow ihren Sommer verbringen würde, und sich dann nach Boris bei ihr erkundigt.“"
                                            },
                                            {
                                                "example_id": "c3469d14-62df-4347-ba7a-b9a805bb83af",
                                                "sense_id": "ea990b5a-e62e-32fa-bf81-97da444e878a",
                                                "text": "„In einer Firma wurden vier einheimische Mitarbeiter gegen vier billigere Arbeitskräfte aus dem Ausland eingetauscht, aber niemand wusste, dass es sich bei ihnen um Kannibalen handelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26b39edf-3892-3b77-b8d6-17f3c70af595",
                                        "entry_id": "e4f62540-445f-3880-be2a-54901150c2bb",
                                        "glosses": [
                                            "dessen oder deren Bewohner oder Regierungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "060c39b4-6dc5-4ac3-aed6-fe1cffdccdb7",
                                                "sense_id": "26b39edf-3892-3b77-b8d6-17f3c70af595",
                                                "text": "Das westliche Ausland reagierte geschlossen."
                                            },
                                            {
                                                "example_id": "beab2b7d-aa67-4408-8076-08318fddcdf0",
                                                "sense_id": "26b39edf-3892-3b77-b8d6-17f3c70af595",
                                                "text": "„Dank des Engagements aus dem Ausland ist es nun stolz auf seine Sprache, seine mündliche Überlieferung, eine wachsende Sammlung von Geschichten und einen Ort, an dem man zusammenkommen und Pläne schmieden kann.“"
                                            },
                                            {
                                                "example_id": "23f5a3c1-c548-4667-a192-e367b0736cd1",
                                                "sense_id": "26b39edf-3892-3b77-b8d6-17f3c70af595",
                                                "text": "„Er wettert gegen die Politik, gegen die Finanzwirtschaft, gegen das Ausland, gegen Büssel, gegen Sackgassen im Allgemeinen, und all das nur, weil er nicht zugeben kann, dass er sich nicht traut zu wenden, und sich dafür schämt.“"
                                            },
                                            {
                                                "example_id": "5304f59f-e305-431b-b57a-a1e83851606f",
                                                "sense_id": "26b39edf-3892-3b77-b8d6-17f3c70af595",
                                                "text": "„Im Ausland kommt Falladas Vorwort ganz schlecht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
