                                                "example_id": "8b8a5b44-9d54-4cc2-a73a-d943a5811fbf",
                                                "sense_id": "e67494f2-3976-3b52-a440-406f15480b58",
                                                "text": "\"These plumbata make marching difficult,\" he complained to Claudius, who was marching beside him."
                                            }
