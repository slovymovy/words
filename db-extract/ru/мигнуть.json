                                "sense_id": "37f682bd-29e9-3de9-85e2-0ad150d6f7f3",
                                "text": "не успе́ть (гла́зом) мигну́ть",
                                "translation": "before one could bat an eye/eyelid",
                                "english": "before one could bat an eye/eyelid"
                            },
                            {
                                "example_id": "4080ed70-6056-4cb1-9aa2-14a44750c187",
                                "sense_id": "37f682bd-29e9-3de9-85e2-0ad150d6f7f3",
                                "text": "сто́ит то́лько мигну́ть",
