                        "entry_id": "ca1c3665-9575-34d0-8446-f3c47e182f3a",
                        "glosses": [
                            "Personne qui possède, qui habite une roulotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbdba24-4855-4d6a-bfad-f44b6796829f",
                                "sense_id": "9a9dfdb1-313a-3a59-a45c-f7eb6b32b535",
                                "text": "La voiture, dans laquelle le roulottier vit et dort, est suffisante pour constituer un domicile certain dans le sens de l'article 270."
                            }
                        ]
                    }
