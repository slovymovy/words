                "forms": [
                    {
                        "form_id": "cb4b037a-bef3-40e9-866e-d9a116cdea7f",
                        "entry_id": "283dee64-56b0-3f25-a163-200fe35ec400",
                        "tags": [
                            "plural",
                            "masculine",
