                                        "glosses": [
                                            "Säugetier, welches der Gattung der Streifenhörnchen angehört"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f715041-6dad-32ac-a784-338cd109214a",
                                        "entry_id": "5dbec042-72be-39aa-89ee-4194d5fe06a4",
                                        "glosses": [
                                            "eine längliche, gebogene Backware, die mit einer gestreiften Glasur versehen wird oder deren Teig mit Schokoladenstreifen durchsetzt ist"
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c1e7da-1ff5-48d2-8ade-8dff1dc14055",
                                                "sense_id": "8f715041-6dad-32ac-a784-338cd109214a",
                                                "text": "Sie lud mich auf eine Tasse Kaffee und selbstgebackene Streifenhörnchen zu sich ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
