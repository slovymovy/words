                                        "entry_id": "5253f137-5848-3313-ae08-eb04af55a46c",
                                        "glosses": [
                                            "Généralisation des polygones et des polyèdres à un espace euclidien de dimension quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e7f851-d55a-45b0-883f-9ba3d9ba5e26",
                                                "sense_id": "d5f51f27-36f6-398a-ba3b-9529e2034ad2",
                                                "text": "En corollaire, tout polytope est l’enveloppe convexe d’un ensemble fini."
                                            }
                                        ]
                                    }
                                ]
                            }
