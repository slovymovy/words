                    {
                        "sense_id": "307cee6c-708c-364e-9352-243084249989",
                        "entry_id": "f7077ef3-b42f-3ff1-9b86-13f31d4e81be",
                        "glosses": [
                            "een vaak prachtig violet gekleurde vorm van kristallijn kwarts, die kleine hoeveelheden titaan en ijzer bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6675df90-7d30-4755-a197-0b2e3de6c56e",
                                "sense_id": "307cee6c-708c-364e-9352-243084249989",
                                "text": "De omlijsting van de spiegel was bedekt met chalcedoon, roze kwarts, amethist en lazuursteen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82bb3687-9155-4bd3-aa66-39c115bf3827",
                        "source_entry_id": "f7077ef3-b42f-3ff1-9b86-13f31d4e81be",
                        "source_sense_id": "307cee6c-708c-364e-9352-243084249989",
                        "source_sense_description": "een vaak prachtig violet gekleurde vorm van kristallijn kwarts, die kleine hoeveelheden titaan en ijzer bevat",
                        "target_lang_word": "amethyst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amethyst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d4dcfe4-613a-39f8-ac33-fb6edc73ee88",
                                        "entry_id": "7973aa7e-7812-3d07-972a-2dde9a8c75d0",
                                        "glosses": [
                                            "A transparent purple to violet variety of quartz with traces of manganese, used as a gemstone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2d72273-bad0-42fa-b5f1-8b180fbb8fac",
                                                "sense_id": "7d4dcfe4-613a-39f8-ac33-fb6edc73ee88",
                                                "text": "The burning evening sun lighted with mellow gold the coats of the fierce little tiger-kittens — orange silk with stripes of black velvet — the broken amethysts and ruined emeralds of the poor bird's train cruelly scattered over the trampled grass"
                                            },
                                            {
                                                "example_id": "51ddfbe5-1a3f-44cb-b2e4-397ba6ff802e",
                                                "sense_id": "7d4dcfe4-613a-39f8-ac33-fb6edc73ee88",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1cfb428-72a4-3466-8c32-3d9a1dd60a6d",
                                        "entry_id": "7973aa7e-7812-3d07-972a-2dde9a8c75d0",
                                        "glosses": [
                                            "A purple colour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be00f570-0619-3f7a-b330-fb8802fd053a",
                                        "entry_id": "7973aa7e-7812-3d07-972a-2dde9a8c75d0",
                                        "glosses": [
                                            "The tincture purpure, when blazoning by precious stones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00314e5d-a1c3-4049-bb2d-3af35cbeb680",
                                                "sense_id": "be00f570-0619-3f7a-b330-fb8802fd053a",
                                                "text": "The Field is Topaz, a Lion rampant Amethyst [...]"
                                            },
                                            {
                                                "example_id": "fe92a217-44ce-4f99-84ef-27a4d7ecebef",
                                                "sense_id": "be00f570-0619-3f7a-b330-fb8802fd053a",
                                                "text": "Purple, on the arms of princes Mercury, of peers amethyst, and of commoners purpure, [is represented] by diagonal lines from the sinister chief to the dexter base."
                                            },
                                            {
                                                "example_id": "a9832cc8-936a-4ced-b3bc-ea86653d5373",
                                                "sense_id": "be00f570-0619-3f7a-b330-fb8802fd053a",
                                                "text": "1st & 4th grand Quarter alike viz. Field Pearl, on a bend Sapphire 3 Buckheads, coup'd topaz for Stanley. The 2d Quarter, Field Sapphire with an inverted Chief, amethyst. The 3d, A Checque topaz & Amethyst, this seems prior to Bosworth field, to have belong'd to Sr Robt Goushill whose Dr a Stanley married …"
                                            }
                                        ]
                                    }
                                ]
                            },
