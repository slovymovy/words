                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e4ac55d-6711-38c4-9b7d-bfb1b1dd7764",
                        "entry_id": "4d671cab-6644-3ad8-84e9-531851b383df",
                        "glosses": [
                            "D’une manière criminelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1acb9b0-a051-4679-8025-c9b780df045e",
                                "sense_id": "0e4ac55d-6711-38c4-9b7d-bfb1b1dd7764",
                                "text": "Agir criminellement."
                            }
                        ]
                    },
                    {
                        "sense_id": "25fb4016-be8f-3bf1-894f-a18be3a55299",
                        "entry_id": "4d671cab-6644-3ad8-84e9-531851b383df",
                        "glosses": [
                            "Par-devant la juridiction criminelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e703a3-2de6-427b-bfab-299e3a64e6e4",
                                "sense_id": "25fb4016-be8f-3bf1-894f-a18be3a55299",
                                "text": "Protagoras, un des plus illustres sophistes de son temps, ayant commencé un de ses ouvrages par ces mots : Je ne sais s'il y a des dieux ou s'il n'y en a point, fut poursuivi criminellement et prit la fuite."
                            },
                            {
                                "example_id": "07c27a0b-f08b-42f2-a2a6-697b6e100924",
                                "sense_id": "25fb4016-be8f-3bf1-894f-a18be3a55299",
                                "text": "Le chef des Achéens [Philopœmen, après sa mort] fut poursuivi criminellement devant le proconsul Mummius."
                            }
                        ]
                    },
                    {
                        "sense_id": "2adf235e-69a7-3a9b-afa4-9141d33800da",
                        "entry_id": "4d671cab-6644-3ad8-84e9-531851b383df",
                        "glosses": [
                            "de mauvaise part."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a01bc4bb-090f-4f1b-94c8-2d7f8b9b9afa",
                                "sense_id": "2adf235e-69a7-3a9b-afa4-9141d33800da",
                                "text": "Expliquer criminellement une chose, en juger criminellement"
                            }
                        ]
                    }
                ],
