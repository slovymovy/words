                                                "sense_id": "f37a012a-04bb-35b6-9dda-d229d878dc2b",
                                                "text": "„Zwei Schulleiterinnen sind für den operativen Bereich der Schule zuständig.“"
                                            },
                                            {
                                                "example_id": "440600c8-2adc-4cf1-bdfc-ea52768e62ff",
                                                "sense_id": "f37a012a-04bb-35b6-9dda-d229d878dc2b",
                                                "text": "„Sie traf auf die Schulleiterin, die Katjas Kindern erneut den Schulbesuch verweigerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
