                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a41d92f-0683-3280-9e2b-e75d409e8b33",
                                        "entry_id": "4af38ba2-cc48-3dc0-ae54-d5d719a0b63b",
                                        "glosses": [
                                            "Personne dont la mâchoire inférieure est proéminente."
