                ],
                "senses": [
                    {
                        "sense_id": "35ea15fc-d9e1-3911-831d-0a458616420f",
                        "entry_id": "0a16f302-dee1-36e3-9a20-dd8a665eacb0",
                        "glosses": [
                            "die Größe eines Tellers habend, so groß wie ein Teller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2300c30-fa66-4c2b-9d93-855bf549873a",
                                "sense_id": "35ea15fc-d9e1-3911-831d-0a458616420f",
                                "text": "„Eine tellergroße Astwucherung schob sich in ihr Blickfeld, als sie den Klettergurt gerade etwas tiefer platzieren wollte.“"
                            },
                            {
                                "example_id": "17032469-35be-45bb-b50e-5017cad8c1c1",
                                "sense_id": "35ea15fc-d9e1-3911-831d-0a458616420f",
                                "text": "„Er dachte, dass es dort draußen noch Totenschiffe geben könnte, die mit herabhängenden Segelfetzen dahintrieben. Oder Leben in der Tiefe. Große Tintenfische, die sich in der kalten Dunkelheit über den Meeresboden fortbewegten. Hin- und herjagten wie Züge, mit tellergroßen Augen.“"
                            },
                            {
                                "example_id": "eb06d8b1-20ac-4c61-8bc4-e6bad1125fb8",
                                "sense_id": "35ea15fc-d9e1-3911-831d-0a458616420f",
                                "text": "„Court starrte es an, die Augen tellergroß geweitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
