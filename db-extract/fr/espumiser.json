                    {
                        "sense_id": "511cd850-1b0e-3b8b-885b-c35f140a6fbf",
                        "entry_id": "44e2469b-bce2-3ebe-8223-8e8981302961",
                        "glosses": [
                            "Ajouter une espuma à (une préparation culinaire)."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3b610cf4-4a3a-4e7f-87c3-1798c33e139e",
                                "sense_id": "511cd850-1b0e-3b8b-885b-c35f140a6fbf",
                                "text": "D'après ce que j'ai lu, dans l'imaginaire des gens, lorsqu'on évoque un cuisinier on va l'imaginer masculin, en train de couper menu, sabrer, sabler, de mariner, balsamiser, brumiser et même espumiser."
                            },
                            {
                                "example_id": "eeb46662-3722-489f-b7c0-f54d27fee383",
                                "sense_id": "511cd850-1b0e-3b8b-885b-c35f140a6fbf",
                                "text": "Mais au moment d'espumiser mes verrines, rien ne sortait du siphon !"
                            }
                        ]
                    }
