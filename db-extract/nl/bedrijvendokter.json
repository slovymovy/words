                            {
                                "example_id": "a92f89e0-2559-4447-ae8c-84ed6dce40f6",
                                "sense_id": "9aa1e0de-3119-3673-920d-bb16b6938f08",
                                "text": "In Rotterdam is de rechtszaak tegen Joep van den Nieuwenhuyzen begonnen. De voormalige 'bedrijvendokter' staat terecht voor omkoping, meineed, valsheid in geschrifte en faillissementsfraude. De zakenman zegt dat hij zich jaren op deze zaak heeft voorbereid."
                            },
                            {
                                "example_id": "4333ebfd-454b-4eb1-81b6-42d3886017e3",
                                "sense_id": "9aa1e0de-3119-3673-920d-bb16b6938f08",
                                "text": "Het Openbaar Ministerie heeft 5,5 jaar gevangenisstraf geëist tegen 'bedrijvendokter' Joep van den Nieuwenhuijzen wegens omkoping, valsheid in geschrifte, faillissementsfraude en het bezit van een vals paspoort."
                            }
                        ]
