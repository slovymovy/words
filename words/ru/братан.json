    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93fa043b-2f71-3530-9e39-f1b0a9b097f1",
                    "sense_definition": "Фамильярное или дружеское обращение к мужчине или юноше.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Слушай, <w>братан</w>, помоги мне донести эти тяжелые сумки до машины.",
                            "target_lang_translations": {
                                "en": "Listen, <w>dude</w>, help me carry these heavy bags to the car."
                            }
                        },
                        {
                            "text": "Привет, <w>братан</w>, как у тебя дела на новой работе?",
                            "target_lang_translations": {
                                "en": "Hey, <w>bro</w>, how are things at your new job?"
                            }
                        }
                    ],
                    "synonyms": [
                        "чувак",
                        "мужик"
                    ],
                    "common_phrases": [
                        "здорово братан",
                        "слушай братан"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное, фамильярное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial or friendly term of address for a man or young man."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dude",
                                "target_lang_sense_clarification": "Informal term of address for a man."
                            },
                            {
                                "target_lang_word": "mate",
                                "target_lang_sense_clarification": "Friendly term of address, common in British/Australian English."
                            },
                            {
                                "target_lang_word": "bro",
                                "target_lang_sense_clarification": "Short for brother, used as a friendly address."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dd48276-7eca-3ae3-968a-241ae8b7e23d",
                    "sense_definition": "Разговорное обозначение брата.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <w>братан</w> сегодня уезжает в другой город на учебу.",
                            "target_lang_translations": {
                                "en": "My <w>bro</w> is leaving for another city today for his studies."
                            }
                        },
                        {
                            "text": "Я вчера встретил своего <w>братана</w> в парке, мы давно не виделись.",
                            "target_lang_translations": {
                                "en": "I met my <w>brother</w> in the park yesterday; we haven't seen each other in a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "брат"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial term for a brother."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bro",
                                "target_lang_sense_clarification": "Informal term for a brother."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df5af1bb-e160-37d1-8134-4b911ae119e1",
                    "sense_definition": "Разговорное обозначение старшего брата.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <w>братан</w> всегда защищал меня в детстве от хулиганов.",
                            "target_lang_translations": {
                                "en": "My <w>big brother</w> always protected me from bullies when I was a child."
                            }
                        },
                        {
                            "text": "Старший <w>братан</w> научил меня кататься на велосипеде.",
                            "target_lang_translations": {
                                "en": "My <w>older brother</w> taught me how to ride a bike."
                            }
                        }
                    ],
                    "synonyms": [
                        "старший брат"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial term for an older brother."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "big brother",
                                "target_lang_sense_clarification": "Older male sibling."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c994de5-91ee-3ed4-bf96-bfd5e767b7d9",
                    "sense_definition": "Разговорное обозначение двоюродного брата.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы с <w>братаном</w> часто проводили лето у бабушки в деревне.",
                            "target_lang_translations": {
                                "en": "My <w>cousin</w> and I often spent the summer at our grandmother's in the village."
                            }
                        },
                        {
                            "text": "Мой двоюродный <w>братан</w> работает инженером в крупной компании.",
                            "target_lang_translations": {
                                "en": "My <w>cousin</w> works as an engineer at a large company."
                            }
                        }
                    ],
                    "synonyms": [
                        "кузен",
                        "двоюродный брат"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial term for a cousin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cousin",
                                "target_lang_sense_clarification": "General term for a cousin."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b907a647-4c5c-3f8f-8862-cc62f922ae08",
                    "sense_definition": "Тот, с кем объединяют общие интересы или условия жизни; единомышленник.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все мы здесь <w>братаны</w> по несчастью, оказавшиеся в этой сложной ситуации.",
                            "target_lang_translations": {
                                "en": "We are all <w>brothers in misfortune</w> here, finding ourselves in this difficult situation."
                            }
                        },
                        {
                            "text": "Он нашел себе <w>братана</w> по духу среди местных художников.",
                            "target_lang_translations": {
                                "en": "He found a <w>kindred spirit</w> among the local artists."
                            }
                        }
                    ],
                    "synonyms": [
                        "единомышленник",
                        "собрат"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное, переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone with whom one shares common interests or life conditions; a like-minded person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brother in arms",
                                "target_lang_sense_clarification": "Someone sharing a struggle or common cause."
                            },
                            {
                                "target_lang_word": "kindred spirit",
                                "target_lang_sense_clarification": "Someone with similar interests or values."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77f54bb-78e2-34c0-aea6-9dcde5c556ac",
                    "sense_definition": "Член преступной группировки.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Местные <w>братаны</w> контролировали все рынки в этом районе города.",
                            "target_lang_translations": {
                                "en": "The local <w>gangsters</w> controlled all the markets in this part of the city."
                            }
                        },
                        {
                            "text": "В девяностые годы каждый <w>братан</w> носил кожаную куртку.",
                            "target_lang_translations": {
                                "en": "In the nineties, every <w>thug</w> wore a leather jacket."
                            }
                        }
                    ],
                    "synonyms": [
                        "брато́к"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A member of a criminal gang."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gangster",
                                "target_lang_sense_clarification": "Member of a criminal organization."
                            },
                            {
                                "target_lang_word": "thug",
                                "target_lang_sense_clarification": "Violent criminal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "975d5171-94a6-3e0c-9670-6420274a07bd",
                    "sense_definition": "Побратим, человек, ставший братом по обряду или клятве.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они стали <w>братанами</w> после того, как вместе прошли через тяжелые испытания.",
                            "target_lang_translations": {
                                "en": "They became <w>blood brothers</w> after going through hard trials together."
                            }
                        },
                        {
                            "text": "Старинный обычай делает из друзей настоящих <w>братанов</w> на всю жизнь.",
                            "target_lang_translations": {
                                "en": "An ancient custom makes friends into true <w>sworn brothers</w> for life."
                            }
                        }
                    ],
                    "synonyms": [
                        "побратим"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "региональное или устаревающее"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sworn brother; someone who has become a brother through a ritual or oath."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blood brother",
                                "target_lang_sense_clarification": "A person bound to another by a ritual of blood."
                            },
                            {
                                "target_lang_word": "sworn brother",
                                "target_lang_sense_clarification": "A person bound to another by a solemn oath."
                            }
                        ]
                    }
                }
            ]
        }
