        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5d10f92c-3a3e-3e8e-9af3-8dbc16597966",
                "word": "champian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                        "entry_id": "5d10f92c-3a3e-3e8e-9af3-8dbc16597966",
                        "glosses": [
                            "Synonym of champaign."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e70cc1e4-6ecb-4800-ab80-c1a4cf58476c",
                                "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                                "text": "An hundred horeſmen of my companie\nScowting abroad vpon theſe champion plaines,\nHaue view’d the army of the Scythians,\nWhich make report it far exceeds the Kings."
                            },
                            {
                                "example_id": "dc16a22f-6bc6-46d0-a485-cf310aac2c86",
                                "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                                "text": "Him selfe out of the forest he did wynd, / And by good fortune the plaine champion wonne […]."
                            },
                            {
                                "example_id": "9093eeea-50b2-4a22-9b58-4dab9c1c5aeb",
                                "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                                "text": "The countrey above, is champian and not barren,- but rarely inhabited."
                            },
                            {
                                "example_id": "00582d6c-db88-45d1-a9f6-aebac3bf14eb",
                                "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                                "text": "The lower, which contained the Tribes of Zcbulon and Iffachar, because it was Champian, was called the Great Field"
                            },
                            {
                                "example_id": "01f50337-1fc0-48b0-8b95-710be051ba42",
                                "sense_id": "7a71bff9-f0d7-34f1-92f3-dd584b5543b6",
                                "text": "The Couutry in general is Champian, and low, but sometimes rises into pleasant Hills"
                            }
                        ]
                    }
                ],
