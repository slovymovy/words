    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ab006ca-d70a-3d1a-8139-61d5fb2b8d6b",
                    "sense_definition": "Пытаться найти местонахождение чего-либо потерянного или спрятанного.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "поиск",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>ищу</w> свои ключи уже полчаса.",
                            "target_lang_translations": {
                                "en": "I have been <w>looking for</w> my keys for half an hour."
                            }
                        },
                        {
                            "text": "Дети любят <w>искать</w> спрятанные подарки на день рождения.",
                            "target_lang_translations": {
                                "en": "Children love to <w>search for</w> hidden birthday presents."
                            }
                        }
                    ],
                    "common_phrases": [
                        "искать ключи",
                        "искать дорогу"
                    ],
                    "target_lang_definitions": {
                        "en": "To try to find the location of something lost or hidden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look for",
                                "target_lang_sense_clarification": "To seek or try to find something."
                            },
                            {
                                "target_lang_word": "search for",
                                "target_lang_sense_clarification": "To look thoroughly for something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e971520-f46e-37bd-9bae-e67e78d7a54a",
                    "sense_definition": "Стараться получить что-либо, добиваться чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "поиск",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После окончания университета он начал <w>искать</w> работу по специальности.",
                            "target_lang_translations": {
                                "en": "After graduating from university, he started <w>looking for</w> a job in his field."
                            }
                        },
                        {
                            "text": "Люди часто <w>ищут</w> правду в сложных жизненных ситуациях.",
                            "target_lang_translations": {
                                "en": "People often <w>seek</w> the truth in difficult life situations."
                            }
                        }
                    ],
                    "common_phrases": [
                        "искать работу",
                        "искать правду"
                    ],
                    "target_lang_definitions": {
                        "en": "To try to obtain or achieve something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seek",
                                "target_lang_sense_clarification": "To try to acquire or gain something."
                            },
                            {
                                "target_lang_word": "look for",
                                "target_lang_sense_clarification": "To seek an opportunity or goal."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44781b1-d094-318c-80a9-b1e5db7fb054",
                    "sense_definition": "Стремиться к чему-либо новому или более совершенному.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "поиск",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художники всегда <w>ищут</w> новые способы самовыражения.",
                            "target_lang_translations": {
                                "en": "Artists are always <w>seeking</w> new ways of self-expression."
                            }
                        },
                        {
                            "text": "Ученые <w>ищут</w> лучшие решения для глобальных проблем.",
                            "target_lang_translations": {
                                "en": "Scientists are <w>seeking</w> better solutions for global problems."
                            }
                        }
                    ],
                    "common_phrases": [
                        "искать решения"
                    ],
                    "target_lang_definitions": {
                        "en": "To strive for something new or more perfect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seek",
                                "target_lang_sense_clarification": "To strive after or aim at something."
                            },
                            {
                                "target_lang_word": "look for",
                                "target_lang_sense_clarification": "To search for new possibilities or solutions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93cd5342-3da1-354e-957e-fd2272250924",
                    "sense_definition": "Обращаться в суд с иском против кого-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания решила <w>искать</w> справедливости в суде из-за нарушения контракта.",
                            "target_lang_translations": {
                                "en": "The company decided to <w>seek</w> justice in court due to a breach of contract."
                            }
                        },
                        {
                            "text": "Он решил <w>искать</w> защиты своих прав через адвокатов.",
                            "target_lang_translations": {
                                "en": "He decided to <w>seek</w> protection of his rights through lawyers."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take legal action against someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seek",
                                "target_lang_sense_clarification": "To solicit or pursue a legal outcome."
                            }
                        ]
                    }
                }
            ]
        }
