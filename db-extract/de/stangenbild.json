                "senses": [
                    {
                        "sense_id": "fdce7761-5f85-3123-9e22-0d14ba0a3302",
                        "entry_id": "73d48c36-bd7b-3c56-9e6f-546e60fd0cb1",
                        "glosses": [
                            "schlanke Holzstange, die oberhalb ein Bild oder einen Bildkasten trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70713b1-afe4-47f8-bdb9-7a9312a3f125",
                                "sense_id": "fdce7761-5f85-3123-9e22-0d14ba0a3302",
                                "text": "„Heute sind neben dem Kreuz und dem Baumbild \"Die 14 heiligen Nothelfer\" nur mehr als Stangenbild mit der Darstellung der hl. Dreifaltigkeit erhalten.“"
                            },
                            {
                                "example_id": "7cf35e05-92d2-4b59-be16-7a646f4a74fb",
                                "sense_id": "fdce7761-5f85-3123-9e22-0d14ba0a3302",
                                "text": "„Stangenbilder: Das Bild (Bildkasten) ist an einer schlanken Holzstange montiert; selten in NÖ“"
                            },
                            {
                                "example_id": "a1b080af-9f12-4a45-9452-8c8a6761875f",
                                "sense_id": "fdce7761-5f85-3123-9e22-0d14ba0a3302",
                                "text": "Wanderfreunde.at „Pirser Stangenbild “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54d9ab9c-d5ad-34fe-893d-7ede666ba0e1",
                        "entry_id": "73d48c36-bd7b-3c56-9e6f-546e60fd0cb1",
                        "glosses": [
                            "aufgelegte Hindernisstangen"
                        ],
                        "tags": [
                            "Reiten"
                        ],
                        "examples": [
                            {
                                "example_id": "2361adab-9e57-4c87-a487-0415a408409f",
                                "sense_id": "54d9ab9c-d5ad-34fe-893d-7ede666ba0e1",
                                "text": "„Es ist etwas schwerer und Risse gehören zum Stangenbild.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8fa216f4-e80e-3c5f-aa72-584d35acee70",
                        "entry_id": "73d48c36-bd7b-3c56-9e6f-546e60fd0cb1",
                        "glosses": [
                            "Zeichnung für Wegetrassen, aus der auch die Richtung und die Stangenlänge ersichtlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00304dc-44d4-462d-9079-3c66eaa8af3b",
                                "sense_id": "8fa216f4-e80e-3c5f-aa72-584d35acee70",
                                "text": "Alois musste gestehen, dass er noch nie was von Stangenbildern gehört hatte. Er wurde darüber unterrichtet, dass dies Aufzeichnungen über die Verläufe der Leitungen, und die Position der dazugehörigen Stangen wären."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
