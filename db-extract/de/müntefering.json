                        "examples": [
                            {
                                "example_id": "dc27e5f4-67aa-497a-9cd7-2d6706ce869f",
                                "sense_id": "e064b748-a9c3-3de3-81c2-9072cb531517",
                                "text": "Es gibt nicht so viele junge, frische Gesichter in der SPD: Michelle Müntefering, 32, auch \"schöne Michelle\" genannt, seit vier Jahren Ehefrau vom Franz, der bekanntlich viel älter ist (schöne vier Jahrzehnte älter)."
                            },
                            {
                                "example_id": "8a813dd3-f3d7-48db-b61c-015eda352186",
                                "sense_id": "e064b748-a9c3-3de3-81c2-9072cb531517",
                                "text": "Müntefering hatte sich 2007 eine Zeit aus der Politik zurückgezogen, um seiner krebskranken Frau beizustehen, die 2008 starb."
                            }
                        ],
