                                ]
                            },
                            {
                                "target_word": "half-blood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b054f4af-7532-31f1-b096-a8c5270a1036",
                                        "entry_id": "d28b8b5b-8eb2-300a-94b6-68aca84e7a73",
                                        "glosses": [
                                            "Alternative form of half blood."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d38e9ba-6cf1-46d9-9304-3aed01ac1956",
                                                "sense_id": "b054f4af-7532-31f1-b096-a8c5270a1036",
                                                "text": "It was just at sundown when we cast anchor in a most beautiful land-locked gulf, and were immediately surrounded by shore boats full of Negroes and Mexican Indians and half-bloods selling fruits and vegetables and offering to dive for bits of money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e73143ff-4c6b-4ae6-83fa-deb3c721f1c4",
                        "source_entry_id": "9ba4e0a3-7e55-3ead-85df-065f1cae8c90",
                        "target_lang_word": "half-breed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-breed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa637ba-0f10-3ecf-af14-21cfc47d14f7",
                                        "entry_id": "07e76728-c22d-3b30-b1e3-357f9c30aaae",
                                        "glosses": [
                                            "A person of mixed racial parentage or ancestry, especially one of mixed white and American Indian parentage (metis, métis, Metis, Métis; mestizo)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77d323f0-7304-46ed-8df9-648f998cf101",
                                                "sense_id": "7fa637ba-0f10-3ecf-af14-21cfc47d14f7",
                                                "text": "It was at Para also that we engaged Gomez and Manuel, two half-breeds from up the river, just come down with a cargo of redwood."
                                            },
                                            {
                                                "example_id": "88dcfd74-84b0-4ad9-a88a-b771583034ba",
                                                "sense_id": "7fa637ba-0f10-3ecf-af14-21cfc47d14f7",
                                                "text": "The half-breeds or Metis along the Saskatchewan River asked that they be given a legal title to the land which they occupied. […] The half-breeds found that constitutional agitation was hopeless and began open hostilities."
                                            },
                                            {
                                                "example_id": "df32e11a-bc1f-4c0c-b274-349ca8ec93b1",
                                                "sense_id": "7fa637ba-0f10-3ecf-af14-21cfc47d14f7",
                                                "text": "Some oppose A.I.M. leaders as outsiders; some resent the leadership of Mr. Wilson; full‐blooded Indians resent halfbreeds; the have‐nots resent those with relative wealth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67b9eade-c763-39c9-ac57-cd947fd28b12",
                                        "entry_id": "07e76728-c22d-3b30-b1e3-357f9c30aaae",
                                        "glosses": [
                                            "A hybrid animal or plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "half-breed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90b090c5-757d-3ddd-9339-aa7ecc406816",
                                        "entry_id": "3f130a10-43df-3dec-904b-f22fa8b30089",
                                        "glosses": [
                                            "having dual heritage; having mixed racial parentage or ancestry"
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
