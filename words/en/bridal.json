                    "sense_definition": "A wedding ceremony or the feast and festival associated with it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village gathered to celebrate the <w>bridal</w> with music and dancing until dawn.",
                            "target_lang_translations": {
