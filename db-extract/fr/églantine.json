                        "examples": [
                            {
                                "example_id": "3392e596-2995-4a98-a3ed-52e4a674cc10",
                                "sense_id": "eafefc2b-e16b-33b9-8f15-cd901c2844eb",
                                "text": "Églantine avait vingt-quatre ans, elle suivait des études de médecine et était la fille unique d’un couple de professeurs de français."
                            }
                        ]
                    }
                ],
                "translations": [],
