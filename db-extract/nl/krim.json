                                            "ellipsis",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2665325-6cd3-3f1d-b942-e8e03410c1b1",
                                        "entry_id": "0d3268e2-f151-306c-b459-7a0dd8b475ce",
