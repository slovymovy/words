{
    "word_family": [
        "mythic",
        "mythical",
        "mythology",
        "mythological",
        "mythologize",
        "mythos",
        "mythmaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a32f2c6-bf19-3b8c-9565-6c6ed140d90a",
                    "sense_definition": "A widely held but false belief or misconception.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "falsehood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a common <w>myth</w> that humans only use ten percent of their brains.",
                            "target_lang_translations": {
                                "ru": "Распространенный <w>миф</w> гласит, что люди используют свой мозг лишь на десять процентов.",
                                "zh": "人类只使用了大脑的百分之十，这是一种常见的<w>迷思</w>。"
                            }
                        },
                        {
                            "text": "The documentary aims to debunk the <w>myth</w> that all sharks are dangerous to people.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм направлен на то, чтобы развенчать <w>миф</w> о том, что все акулы опасны для людей.",
                                "zh": "这部纪录片旨在打破所有鲨鱼都对人类有害的<w>误解</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misconception"
                    ],
                    "common_phrases": [
                        "debunk the myth",
                        "common myth",
                        "popular myth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко распространенное, но ложное убеждение или заблуждение.",
                        "zh": "一种被广泛相信但实际上是错误的观点或误解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миф",
                                "target_lang_sense_clarification": "ложное представление"
                            },
                            {
                                "target_lang_word": "заблуждение",
                                "target_lang_sense_clarification": "ошибочное мнение"
                            },
                            {
                                "target_lang_word": "вымысел",
                                "target_lang_sense_clarification": "то, что не соответствует действительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误解",
                                "target_lang_sense_clarification": "对事实的错误理解"
                            },
                            {
                                "target_lang_word": "迷思",
                                "target_lang_sense_clarification": "广泛流传但缺乏根据的观念"
                            },
                            {
                                "target_lang_word": "谬论",
                                "target_lang_sense_clarification": "错误的理论或说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1d3057-12a5-3497-97ab-7073cd894734",
                    "sense_definition": "A traditional story, especially one concerning the early history of a people or explaining some natural or social phenomenon, and typically involving supernatural beings or events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "folklore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Greek <w>myth</w>, Prometheus stole fire from the gods to give it to humanity.",
                            "target_lang_translations": {
                                "ru": "В древнегреческом <w>мифе</w> Прометей украл огонь у богов, чтобы отдать его человечеству.",
                                "zh": "在古希腊<w>神话</w>中，普罗米修斯从众神那里偷取火种并将其带给人类。"
                            }
                        },
                        {
                            "text": "The creation <w>myth</w> of this culture explains how the islands were formed by a giant bird.",
                            "target_lang_translations": {
                                "ru": "<w>Миф</w> о сотворении мира в этой культуре объясняет, как острова были созданы гигантской птицей.",
                                "zh": "该文化的创世<w>神话</w>解释了这些岛屿是如何由一只巨鸟形成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "creation myth",
                        "ancient myth",
                        "greek myth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное сказание, повествующее о богах, героях или происхождении мира.",
                        "zh": "一种传统故事，通常涉及超自然存在或事件，用以解释自然现象、社会习俗或民族起源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миф",
                                "target_lang_sense_clarification": "древнее сказание"
                            },
                            {
                                "target_lang_word": "предание",
                                "target_lang_sense_clarification": "переходящий из уст в уста рассказ"
                            },
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "поэтическое сказание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神话",
                                "target_lang_sense_clarification": "关于神灵或超自然力量的传统故事"
                            },
                            {
                                "target_lang_word": "传说",
                                "target_lang_sense_clarification": "民间流传的叙事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e32e33a-d879-34aa-9ae7-729b6f74725c",
                    "sense_definition": "A person or thing that is imaginary or whose existence cannot be verified.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imaginary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people believe the Loch Ness monster is real, while others say it is just a <w>myth</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые верят, что Лох-несское чудовище реально, в то время как другие говорят, что это всего лишь <w>миф</w>.",
                                "zh": "有些人相信尼斯湖水怪是真实存在的，而另一些人则认为那不过是<w>虚构</w>。"
                            }
                        },
                        {
                            "text": "The legendary city of gold turned out to be a <w>myth</w> created by explorers.",
                            "target_lang_translations": {
                                "ru": "Легендарный золотой город оказался <w>вымыслом</w>, созданным исследователями.",
                                "zh": "那座传说中的黄金之城最终被证实只是探险家们编造的<w>无稽之谈</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "taken for a myth",
                        "pure myth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воображаемый человек или предмет, существование которого невозможно подтвердить.",
                        "zh": "虚构的、不存在的或无法证实其存在的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миф",
                                "target_lang_sense_clarification": "несуществующий объект"
                            },
                            {
                                "target_lang_word": "выдумка",
                                "target_lang_sense_clarification": "плод воображения"
                            },
                            {
                                "target_lang_word": "небылица",
                                "target_lang_sense_clarification": "выдуманная история"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚构",
                                "target_lang_sense_clarification": "凭空捏造的事物"
                            },
                            {
                                "target_lang_word": "无稽之谈",
                                "target_lang_sense_clarification": "毫无根据的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a826f4-4ae8-3138-9f3f-d8e46576c5e7",
                    "sense_definition": "A person or thing held in excessive or quasi-religious awe based on popular legend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legendary_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retired athlete had become an American <w>myth</w>, admired by millions across the country.",
                            "target_lang_translations": {
                                "ru": "Ушедший из спорта атлет стал американской <w>легендой</w>, которой восхищались миллионы людей по всей стране.",
                                "zh": "这位退役运动员已经成为了美国的<w>传奇</w>，受到全国数百万人的敬仰。"
                            }
                        },
                        {
                            "text": "By the end of his career, the founder of the company was more of a <w>myth</w> than a man.",
                            "target_lang_translations": {
                                "ru": "К концу своей карьеры основатель компании был скорее <w>мифом</w>, чем человеком.",
                                "zh": "到职业生涯末期，这位公司创始人与其说是一个人，不如说是一个<w>传奇</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "american myth",
                        "living myth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или явление, вызывающее благоговейный трепет и ставшее легендарным.",
                        "zh": "因广受崇拜或具有传奇色彩而成为偶像化的人物或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "прославленная личность"
                            },
                            {
                                "target_lang_word": "миф",
                                "target_lang_sense_clarification": "культовая фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传奇",
                                "target_lang_sense_clarification": "具有非凡成就或影响力的杰出人物"
                            },
                            {
                                "target_lang_word": "偶像",
                                "target_lang_sense_clarification": "被崇拜的对象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}