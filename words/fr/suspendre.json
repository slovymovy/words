{
    "word_family": [
        "suspension",
        "suspens",
        "suspense",
        "suspensif",
        "suspente"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bd16ba7-4a39-3010-8c0b-8a6bb75ff292",
                    "sense_definition": "Accrocher un objet en hauteur de manière qu'il ne repose sur rien.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a décidé de <w>suspendre</w> une lampe moderne au centre du salon."
                        },
                        {
                            "text": "Nous allons <w>suspendre</w> ces tableaux dès que la peinture sera sèche."
                        }
                    ],
                    "synonyms": [
                        "accrocher",
                        "pendre"
                    ],
                    "antonyms": [
                        "décrocher",
                        "poser"
                    ],
                    "common_phrases": [
                        "suspendre au plafond",
                        "suspendre au mur"
                    ]
                },
                {
                    "sense_id": "dc59df51-3b31-3fd7-a1b9-96361cdb0819",
                    "sense_definition": "Interrompre temporairement une action, une séance ou une activité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a choisi de <w>suspendre</w> la séance pendant une heure."
                        },
                        {
                            "text": "L'entreprise a dû <w>suspendre</w> ses activités à cause de la tempête."
                        }
                    ],
                    "synonyms": [
                        "interrompre",
                        "ajourner",
                        "différer"
                    ],
                    "antonyms": [
                        "continuer",
                        "poursuivre",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "suspendre la séance",
                        "suspendre les hostilités",
                        "suspendre les paiements"
                    ]
                },
                {
                    "sense_id": "cbc787f8-2b44-3bdd-b102-1845edd8f000",
                    "sense_definition": "Retirer provisoirement à quelqu'un l'exercice de ses fonctions, de ses droits ou de son statut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a menacé de <w>suspendre</w> tout employé qui ne respecterait pas le règlement."
                        },
                        {
                            "text": "Après l'incident, le conseil a voté pour <w>suspendre</w> le magistrat de ses fonctions."
                        }
                    ],
                    "synonyms": [
                        "exclure",
                        "écarter"
                    ],
                    "antonyms": [
                        "réintégrer",
                        "rétablir"
                    ],
                    "common_phrases": [
                        "suspendre de ses fonctions",
                        "suspendre à titre conservatoire"
                    ]
                },
                {
                    "sense_id": "4d7c84f7-1996-3f50-9750-5a7e8b14bc72",
                    "sense_definition": "Rendre inopérante l'application d'une loi, d'une règle ou d'une garantie pour un temps donné.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement d'urgence a pris la décision de <w>suspendre</w> plusieurs libertés civiles."
                        },
                        {
                            "text": "En période de crise majeure, les autorités peuvent <w>suspendre</w> la constitution."
                        }
                    ],
                    "synonyms": [
                        "neutraliser"
                    ],
                    "antonyms": [
                        "appliquer",
                        "faire respecter"
                    ],
                    "common_phrases": [
                        "suspendre la constitution",
                        "suspendre une loi"
                    ]
                },
                {
                    "sense_id": "62fd72e1-3d5f-3243-8679-fc2bb3cc26ab",
                    "sense_definition": "Attendre et différer son avis en vue d'obtenir plus d'éclaircissements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à ces révélations contradictoires, il est sage de <w>suspendre</w> son jugement."
                        },
                        {
                            "text": "Les critiques préfèrent <w>suspendre</w> leur appréciation jusqu'à la fin de la représentation."
                        }
                    ],
                    "synonyms": [
                        "réserver"
                    ],
                    "antonyms": [
                        "trancher",
                        "juger"
                    ],
                    "common_phrases": [
                        "suspendre son jugement"
                    ]
                }
            ]
        }
    ]
}