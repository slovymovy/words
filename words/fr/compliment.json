{
    "word_family": [
        "complimenter",
        "complimenteur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1718038-a332-3c38-ba76-2a530eb5bec1",
                    "sense_definition": "Parole flatteuse ou louange adressée à quelqu'un pour exprimer de l'admiration ou de l'approbation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "louange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a souri avec timidité après avoir reçu un sincère <w>compliment</w> sur sa tenue."
                        },
                        {
                            "text": "Il aime toujours faire un délicat <w>compliment</w> à ses amis pour leur faire plaisir."
                        }
                    ],
                    "synonyms": [
                        "éloge",
                        "flatterie"
                    ],
                    "common_phrases": [
                        "faire un compliment",
                        "recevoir un compliment",
                        "merci pour le compliment"
                    ]
                },
                {
                    "sense_id": "0db4b841-b842-30ee-bc17-5cf2f821d1ad",
                    "sense_definition": "Formule de politesse et de civilité employée pour transmettre son souvenir ou ses salutations amicales.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de transmettre mes chaleureux <w>compliments</w> à toute votre famille."
                        },
                        {
                            "text": "Avant de partir, il a tenu à faire mille <w>compliments</w> à la maîtresse de maison."
                        }
                    ],
                    "common_phrases": [
                        "faire mille compliments",
                        "mes compliments"
                    ]
                },
                {
                    "sense_id": "df50efaf-70c4-3ac9-8eee-c3e9857274da",
                    "sense_definition": "Paroles de félicitation ou témoignage formel d'estime et de considération adressé à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "louange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les collègues sont tous venus faire leurs <w>compliments</w> au nouveau promu."
                        },
                        {
                            "text": "Le jury a tenu à lui adresser de vifs <w>compliments</w> pour sa remarquable prestation."
                        }
                    ],
                    "synonyms": [
                        "félicitation"
                    ],
                    "common_phrases": [
                        "faire ses compliments",
                        "adresser des compliments"
                    ]
                },
                {
                    "sense_id": "e9221836-9ddd-3df3-abc9-1f121bcf0579",
                    "sense_definition": "Court discours solennel, souvent en vers, qu'un enfant récite pour souhaiter une bonne fête ou la nouvelle année à ses proches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est avancé timidement pour réciter un petit <w>compliment</w> à sa grand-mère."
                        },
                        {
                            "text": "Pour le Nouvel An, les élèves devaient autrefois mémoriser un <w>compliment</w> traditionnel."
                        }
                    ],
                    "common_phrases": [
                        "réciter un compliment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "coutume ancienne"
                        }
                    ]
                },
                {
                    "sense_id": "9924057b-a016-3c2f-815c-50d319a42f5c",
                    "sense_definition": "Remarque désobligeante, reproche ou propos désagréable formulé par ironie ou antiphrase.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En découvrant les erreurs du rapport, le patron lui a fait un fâcheux <w>compliment</w>."
                        },
                        {
                            "text": "Souligner ainsi mes maladresses en public est vraiment un bien mauvais <w>compliment</w>."
                        }
                    ],
                    "common_phrases": [
                        "mauvais compliment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage ironique ou vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "57e56c25-7fac-3a00-aca6-7e8124d49c83",
                    "sense_definition": "Pure politesse formelle qui ne s'accompagne d'aucune intention réelle ni d'aucun effet concret.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne croyez pas à toutes ses belles promesses, ce n'était que du <w>compliment</w>."
                        },
                        {
                            "text": "Leurs généreuses propositions d'entraide se sont finalement passées en simples <w>compliments</w>."
                        }
                    ],
                    "common_phrases": [
                        "passer en compliments"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage vieilli"
                        }
                    ]
                }
            ]
        }
    ]
