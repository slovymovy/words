                ],
                "senses": [
                    {
                        "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                        "entry_id": "cb36ea99-cd0a-329c-875d-46e04cbadd04",
                        "glosses": [
                            "Bemühen einer männlichen Person, sich (auch in sexueller Hinsicht) zu beherrschen oder (bedingungslos) zu gehorchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18ac673-379e-45a2-806a-017aa1b0c2e3",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Das Gegenbild […] schildert die Enthaltsamkeit Scipios, der nach der Eroberung von Neucarthago das ihm angebotene Mädchen ausschlug, um ein Beispiel der Manneszucht zu geben und es ihrem Verlobten Aluceius unberührt wieder zurücksandte, ja sogar das Lösegeld als Heiratsgut bestimmte.“"
                            },
                            {
                                "example_id": "96641373-adbd-4981-a45d-0130d8a7f9a9",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Mühsal, Entbehrung und strenge Manneszucht waren die Schule, in der die unendliche Weisheit Luther für seine außerordentliche Lebensaufgabe vorbereitete.“"
                            },
                            {
                                "example_id": "cbb03bf0-0a34-499f-97b2-dc730fb6b57c",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Sie sind die Tugenden der Manneszucht, der sittlichen Sauberkeit, der inneren Freiheit, der entscheidungsklaren Reife, der Würde und der Ehre.“"
                            },
                            {
                                "example_id": "845a7aff-36b2-41ae-bfb5-658a03ffc4ef",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Um in die geworbene Mannschaft Manneszucht hineinzubringen, übertrug die Direktion einem ihrer Mitglieder, dem General Witherington, unbeschränkte Vollmacht.“"
                            },
                            {
                                "example_id": "86dffead-e807-4109-9ec2-53c3f5f17027",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Sie waren das auserwählte Corps, das sich durch gute Sitten, Manneszucht und Tapferkeit ausgezeichnet und in manchen Schlachten den Sieg errungen hat.“"
                            },
                            {
                                "example_id": "eee91daa-0d62-47f3-974c-dd640c36dd5b",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„[Deserteuren] wurde außerdem jedwede Form der ›Manneszucht‹ und damit der Männlichkeit abgesprochen.“"
                            },
                            {
                                "example_id": "33a7bac5-bdcd-40a9-b44c-94a454edf8e6",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Die zentrale Bedeutung, die der ‚Aufrechterhaltung der Manneszucht‘ sowohl im wehrrechtswissenschaftlichen Schrifttum nach 1933 als auch in Hitlers Richtlinien für das Delikt der Fahnenflucht zukam, zeigte sich auch in den ausgewerteten Urteilen.“"
                            },
                            {
                                "example_id": "efb0b275-d9b3-4116-8bbc-84cfea6e4222",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Ludwig Baumanns Fluchtgrund 1941 war Mangel an ‚Manneszucht‘: Er wollte und konnte nicht töten.“"
                            },
                            {
                                "example_id": "13c5faa8-7a0b-4459-bfed-a1b5e13df69f",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Gleichzeitig sorgte ungezügelter und ungeregelter Kontakt der deutschen Männer zu den Frauen ihrer Feinde nicht nur für soziale Komplikationen, er widersprach auch dem soldatischen Ideal der ‚Manneszucht‘.“"
                            },
                            {
                                "example_id": "f9ab436f-bf77-4f67-99aa-a822c270981b",
                                "sense_id": "80cad30a-3c8e-33d0-9ec4-4e9919930837",
                                "text": "„Nach der Rechtsgutlehre war dabei das zentrale Kriterium die Aufrechterhaltung der »Manneszucht«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
