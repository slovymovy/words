                "senses": [
                    {
                        "sense_id": "1638b328-85b2-3807-88d0-1055c1e4c57a",
                        "entry_id": "de64495d-9a21-3ed3-9e97-c7fc5fac9171",
                        "glosses": [
                            "Fonctionnaire publique chargée d’administrer un arrondissement, sous la direction immédiate du préfet ou de la préfète."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "72f90d30-98d5-4d9c-9d9b-056529030769",
                                "sense_id": "1638b328-85b2-3807-88d0-1055c1e4c57a",
                                "text": "Les zadistes sont regonflés à bloc et gonflés tout court : ils l’ont prouvé fin janvier en montrant leurs fesses à la sous-préfète en visite sur le terrain."
                            },
                            {
                                "example_id": "2a29633a-b982-4aab-a293-c6ab6a79a7d9",
                                "sense_id": "1638b328-85b2-3807-88d0-1055c1e4c57a",
                                "text": "Pour cette cérémonie de nombreuses personnalités avaient fait le déplacement, dont Mᵐᵉ Merckx, sous-préfète d’Ussel, et M. Grandcoing, écrivain et parrain de la promotion 2023."
                            },
                            {
                                "example_id": "e98d94aa-15cf-435d-9ab2-b43975f3e758",
                                "sense_id": "1638b328-85b2-3807-88d0-1055c1e4c57a",
                                "text": "Le dispositif a fait l’objet de la visite de la sous-préfète, Véronique Schaaf, mercredi 28 juin, en présence du maire, Alain Margat, et de l’agent en charge des procédures, Alicia Gourdin."
                            }
                        ]
                    },
                    {
                        "sense_id": "369ed210-cff9-3318-89f8-737c75c456a1",
                        "entry_id": "de64495d-9a21-3ed3-9e97-c7fc5fac9171",
                        "glosses": [
                            "Épouse d’un sous-préfet."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "95db9bb4-67ac-49e1-8baf-6307e59281fa",
                                "sense_id": "369ed210-cff9-3318-89f8-737c75c456a1",
                                "text": "C’était la marquise. Julien lui trouva l’air impertinent, un peu comme madame de Maugiron, la sous-préfète de l’arrondissement de Verrières, quand elle assistait au dîner de la Saint-Charles."
                            },
                            {
                                "example_id": "87866c70-4ffd-43c7-b60f-a27dc039df91",
                                "sense_id": "369ed210-cff9-3318-89f8-737c75c456a1",
                                "text": "Libre au sous-préfet du Monde où l’on s’ennuie de se moquer du Maharahavatâ, comme à la sous-préfète de citer en riant M. de Tocqueville, ces savants trop ignorés sont dignes du respect et de la reconnaissance des passionnés de l’érudition."
                            }
                        ]
                    }
