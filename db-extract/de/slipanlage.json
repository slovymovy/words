                "senses": [
                    {
                        "sense_id": "3502ca68-0e7d-3d65-9c78-cf0d9fbaf35d",
                        "entry_id": "63313923-9cbf-30f2-827b-4e13aabcdc34",
                        "glosses": [
                            "bauliche Schräge, um Boote aus dem Wasser zu bringen bzw. in das Wasser zu lassen"
                        ],
                        "tags": [
                            "Bauwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "3f71ee64-00d4-4cbd-a6c8-164f41f17967",
                                "sense_id": "3502ca68-0e7d-3d65-9c78-cf0d9fbaf35d",
                                "text": "Über die angelegte Slipanlage, eine befestigte Schräge bis ins Wasser, lassen sich Boote von einem Bootshänger aus zu Wasser lassen und umgekehrt auch hieven."
                            },
                            {
                                "example_id": "35c251b1-0bb2-40ee-a88c-f69a4ebeb1e5",
                                "sense_id": "3502ca68-0e7d-3d65-9c78-cf0d9fbaf35d",
                                "text": "„Die Stadt unterhält eine Slipanlage an der Havelpromenade.“"
                            },
                            {
                                "example_id": "a27d13a9-89fc-44b4-ad33-bf36f01baf21",
                                "sense_id": "3502ca68-0e7d-3d65-9c78-cf0d9fbaf35d",
                                "text": "„Die Slipanlage befindet sich an der Heukaje, direkt unterhalb der Touristinformation in Brake.“"
                            },
                            {
                                "example_id": "b78c947f-05e2-4bde-ae25-c5bd6e09b108",
                                "sense_id": "3502ca68-0e7d-3d65-9c78-cf0d9fbaf35d",
                                "text": "„Klicken Sie auf die blauen oder grünen (kostenlose Slipanlagen) Marker, um direkt zur entsprechenden Slipanlage zu gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4103793-0995-3dbb-8d1c-7cc7cdb4b13c",
                        "entry_id": "63313923-9cbf-30f2-827b-4e13aabcdc34",
                        "glosses": [
                            "technische Einrichtungen zu [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d0a714-f610-4581-9353-c7e2182f39b2",
                                "sense_id": "d4103793-0995-3dbb-8d1c-7cc7cdb4b13c",
                                "text": "Die maschinelle Slipanlage hebt und senkt größere Boot in/aus dem Wasser um diese im Trockendock zu händeln."
                            },
                            {
                                "example_id": "33ec1fa7-d8f1-44c2-afb3-9d3a5c20a7b4",
                                "sense_id": "d4103793-0995-3dbb-8d1c-7cc7cdb4b13c",
                                "text": "„Weiterhin stehen hier eine Slipanlage und Kran zur Verfügung.“"
                            },
                            {
                                "example_id": "1c397dcd-5292-409b-833a-a7ffa7c7e905",
                                "sense_id": "d4103793-0995-3dbb-8d1c-7cc7cdb4b13c",
                                "text": "„Klicken Sie auf die blauen oder grünen (kostenlose Slipanlagen) Marker, um direkt zur entsprechenden Slipanlage zu gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
