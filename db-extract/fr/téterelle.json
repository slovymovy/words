                "senses": [
                    {
                        "sense_id": "e346f9ee-0c63-3eeb-abcb-b1c40a5b262a",
                        "entry_id": "8ed4e2a7-22b8-375f-8a7f-ca59eecb44ca",
                        "glosses": [
                            "Petit appareil employé pour prélever le lait maternel, l’allaitement artificiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c5e8960-dd8b-42a0-a1df-e3ff5f2af87f",
                                "sense_id": "e346f9ee-0c63-3eeb-abcb-b1c40a5b262a",
                                "text": "S’assurer que la téterelle soit adaptée à la forme du mamelon, elle ne doit pas laisser passer l'air."
                            }
                        ]
                    },
                    {
                        "sense_id": "fae1a9b9-9ee2-3a8a-8658-ecf52bd14215",
                        "entry_id": "8ed4e2a7-22b8-375f-8a7f-ca59eecb44ca",
                        "glosses": [
                            "Partie souple de la tétine qui rentre dans la bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15469ef6-9f29-4b80-81b5-cc7a0b68d5b9",
                                "sense_id": "fae1a9b9-9ee2-3a8a-8658-ecf52bd14215",
                                "text": "Une tétine est composée d’une téterelle en matériau souple et d’une collerette empêchant le bébé d’avaler la tétine."
                            },
                            {
                                "example_id": "7fe8742a-b2c4-473c-aa83-40918d53e4f0",
                                "sense_id": "fae1a9b9-9ee2-3a8a-8658-ecf52bd14215",
                                "text": "La téterelle de la sucette est munie de picots qui massent les gencives de bébé."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e8e93e0-99da-3fe5-8ef1-6120d10551ed",
                        "entry_id": "8ed4e2a7-22b8-375f-8a7f-ca59eecb44ca",
                        "glosses": [
                            "Autre nom du bout de sein."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790b0ee4-2849-4c24-840f-45b823c5661a",
                                "sense_id": "5e8e93e0-99da-3fe5-8ef1-6120d10551ed",
                                "text": "Téterelle : c'est un « bout de sein », un embout moulé en caoutchouc ou en silicone qui se pose sur le bout des seins. Il en existe plusieurs tailles pour que la téterelle s'adapte bien au mamelon."
                            }
                        ]
                    }
