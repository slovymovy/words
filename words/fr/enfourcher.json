    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96903441-fe23-3ff8-9a62-fda363cd6c26",
                    "sense_definition": "Monter sur une bête de selle, un vélo ou une moto en se plaçant à califourchon.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "monter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, il <w>enfourche</w> son vélo pour se rendre à son lieu de travail."
                        },
                        {
                            "text": "Le cavalier pressé a vite <w>enfourché</w> son cheval avant de partir au grand galop."
                        }
                    ],
                    "synonyms": [
                        "chevaucher",
                        "monter"
                    ],
                    "antonyms": [
                        "descendre"
                    ],
                    "common_phrases": [
                        "enfourcher son vélo",
                        "enfourcher une moto",
                        "enfourcher sa monture"
                    ]
                },
                {
                    "sense_id": "68f722ea-2f27-3695-bbf1-21b93b4cb670",
                    "sense_definition": "Prendre, soulever ou remuer du foin, de la paille à l'aide d'une fourche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier a passé la journée à <w>enfourcher</w> de lourdes bottes de foin sec."
                        },
                        {
                            "text": "Il aidait son grand-père en <w>enfourchant</w> la paille fraîchement moissonnée pour la grange."
                        }
                    ],
                    "common_phrases": [
                        "enfourcher du foin",
                        "enfourcher de la paille"
                    ]
                },
                {
                    "sense_id": "b87040f7-181d-3b84-82c7-85acb501607e",
                    "sense_definition": "Revenir avec insistance sur un sujet favori, une obsession ou embrasser avec passion une cause.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dada",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'on aborde l'économie, il ne peut s'empêcher d'<w>enfourcher</w> son dada favori."
                        },
                        {
                            "text": "Ce politicien a décidé d'<w>enfourcher</w> un nouveau combat pour convaincre les électeurs hésitants."
                        }
                    ],
                    "common_phrases": [
                        "enfourcher son dada",
                        "enfourcher un cheval de bataille"
                    ]
                },
                {
                    "sense_id": "46454d53-dbf6-336c-b486-49b3f23b73f2",
                    "sense_definition": "En ski alpin, commettre la faute de passer une porte en mettant un ski de chaque côté du piquet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ski",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En pleine course de slalom, la skieuse a malheureusement <w>enfourché</w> dans la dernière section."
                        },
                        {
                            "text": "S'il <w>enfourche</w> à cette vitesse, il sera immédiatement disqualifié par les juges de piste."
                        }
                    ],
                    "common_phrases": [
                        "enfourcher un piquet"
                    ]
                }
            ]
        }
    ]
