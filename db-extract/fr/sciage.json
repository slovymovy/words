                                "target_senses": [
                                    {
                                        "sense_id": "8c7dbbbd-d83b-3baa-aa96-047eb6cd74e8",
                                        "entry_id": "0999920b-e23e-3be6-a2f2-29cffe1af90b",
                                        "glosses": [
                                            "The act by which something is sawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aefd1516-e751-4b1f-9f45-2116bef19eea",
                                                "sense_id": "8c7dbbbd-d83b-3baa-aa96-047eb6cd74e8",
                                                "text": "As said, these investigations generally do not pay attention to saw kerf width and green size of sawn timber. These studies have mainly been made by practical test sawings and subsequently checked by geometric calculations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62436e92-bca1-31e6-b302-6d31622de752",
                                        "entry_id": "0999920b-e23e-3be6-a2f2-29cffe1af90b",
                                        "glosses": [
                                            "A shaving or fragment of sawn material."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d28f844-ac56-4ce9-b412-29e0a691fc71",
                                                "sense_id": "62436e92-bca1-31e6-b302-6d31622de752",
                                                "text": "We find that from a sample of sawings of the usual size a button or small bar fairly representing the sample can be cast from about 2,000 grains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
