                "word": "Rabelaisian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ca5b8b5b-d7c6-4225-a93e-cab6afb3eee3",
                        "entry_id": "bc0ceb81-f4c1-340d-8b65-9b71ee7271f3",
