    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9666df5-a46e-3b60-994a-69b9d6bdccb2",
                    "sense_definition": "iemand of iets ontrouw worden door informatie aan een vijand te geven of een belofte te breken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ontrouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze voelde zich diep <w>verraden</w> door haar beste vriend nadat hij haar geheim vertelde.",
                            "target_lang_translations": {
                                "en": "She felt deeply <w>betrayed</w> by her best friend after he told her secret."
                            }
                        },
                        {
                            "text": "De spion besloot zijn land te <w>verraden</w> voor een grote som geld.",
                            "target_lang_translations": {
                                "en": "The spy decided to <w>betray</w> his country for a large sum of money."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedriegen",
                        "belazeren",
                        "verklikken"
                    ],
                    "antonyms": [
                        "steunen",
                        "beschermen"
                    ],
                    "common_phrases": [
                        "iemand verraden",
                        "je land verraden"
                    ],
                    "target_lang_definitions": {
                        "en": "to be unfaithful to someone or something by giving information to an enemy or breaking a promise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "betray",
                                "target_lang_sense_clarification": "to be disloyal to a person or cause"
                            },
                            {
                                "target_lang_word": "sell out",
                                "target_lang_sense_clarification": "to betray for personal gain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b989e76-02bf-3f61-b46e-d99be95a944f",
                    "sense_definition": "onbedoeld informatie prijsgeven waardoor iets duidelijk wordt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onthullen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn nerveuze blik <w>verried</w> zijn ware intenties tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "His nervous look <w>betrayed</w> his true intentions during the conversation."
                            }
                        },
                        {
                            "text": "Hij wilde het verrassingsfeest niet <w>verraden</w> door te vroeg te lachen.",
                            "target_lang_translations": {
                                "en": "He didn't want to <w>give away</w> the surprise party by laughing too early."
                            }
                        }
                    ],
                    "synonyms": [
                        "verklappen",
                        "onthullen",
                        "prijsgeven"
                    ],
                    "antonyms": [
                        "verbergen",
                        "verhullen"
                    ],
                    "common_phrases": [
                        "een geheim verraden",
                        "jezelf verraden"
                    ],
                    "target_lang_definitions": {
                        "en": "to unintentionally reveal information that makes something clear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "betray",
                                "target_lang_sense_clarification": "to reveal something unintentionally"
                            },
                            {
                                "target_lang_word": "give away",
                                "target_lang_sense_clarification": "to reveal a secret or hidden fact"
                            },
                            {
                                "target_lang_word": "reveal",
                                "target_lang_sense_clarification": "to make something known"
                            }
                        ]
                    }
                }
            ]
        },
