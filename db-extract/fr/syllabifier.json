                "senses": [
                    {
                        "sense_id": "9f3b048a-8eea-3fc3-9657-269530ca065f",
                        "entry_id": "963e0079-53ed-3519-bd77-199f962ea2a0",
                        "glosses": [
                            "Mettre en syllabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e0ad40-86db-47ca-b790-d44388414581",
                                "sense_id": "9f3b048a-8eea-3fc3-9657-269530ca065f",
                                "text": "Ce jeu de mots me paraît fort admissible, malgré sa prononciation vicieuse, pour l’époque, et je dirai plus, il semblait avoir reçu alors la consécration d’un usage ancien, car, sur des incunables de 1400, on trouve déjà de ces jeux d’esprit qui seraient intraduisibles si on voulait en syllabifier les mots comme on les prononçait alors."
                            },
                            {
                                "example_id": "ed2d34e8-7cf2-452d-b8e1-ea9e277b8e16",
                                "sense_id": "9f3b048a-8eea-3fc3-9657-269530ca065f",
                                "text": "La consonne en question ne peut donc se syllabifier qu’en position de coda."
                            }
                        ]
                    }
