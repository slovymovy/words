                        "glosses": [
                            "Substance qui prévient l'écoulement du sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef338b99-1a94-4c83-96bd-3cc412e66f99",
                                "sense_id": "92d1eebe-c605-3492-a60b-d3f4e291564d",
                                "text": "Tous les styptiques portent leur action sur la contractilité organique des vaisseaux sanguins et lymphatiques de la partie qui en reçoit l'application."
