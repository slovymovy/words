                "senses": [
                    {
                        "sense_id": "104aa858-9d0f-3db3-b366-73e5fe5b5198",
                        "entry_id": "e6172b03-e3fa-3834-89af-49510b61405b",
                        "glosses": [
                            "een persoon of zaak die uitmunt door schoonheid, voortreffelijkheid o.i.d"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c99c885-d4ca-4464-b05e-d53f29be7645",
                                "sense_id": "104aa858-9d0f-3db3-b366-73e5fe5b5198",
                                "text": "Het pronkstuk van de avond liet een mooie herinerring achter."
                            },
                            {
                                "example_id": "484767fd-a50b-431b-93d1-2040b16c2089",
                                "sense_id": "104aa858-9d0f-3db3-b366-73e5fe5b5198",
                                "text": "Die versneller moet de opvolger worden van de Large Hadron Collider (LHC), die na aanpassingen overigens nog tot 2040 metingen kan verrichten. De LHC is het pronkstuk van de huidige deeltjesfysica, de natuurkundetak die het tot zijn missie maakt om de allerkleinste bouwsteentjes te vinden waarvan alles om ons heen is gemaakt."
                            },
                            {
                                "example_id": "a3f59b06-9c00-4371-9415-83233192e659",
                                "sense_id": "104aa858-9d0f-3db3-b366-73e5fe5b5198",
                                "text": "De centrale hal was voorzien van een sensationele kroonluchter, die amechtig antiek hing te zijn. `Een van onze pronkstukken,' zei de majordomus, die alles merkte, dus ook dat de lamp mij was opgevallen. 'Alleen erg lastig in het onderhoud."
                            }
                        ]
                    }
