                                    {
                                        "sense_id": "8d386430-a03f-390c-9fa9-3f0cefe2419b",
                                        "entry_id": "819e87a2-0d1e-3f04-847e-9034bc0845b5",
                                        "glosses": [
                                            "The region of the Earth centred on the equator and lying between the Tropic of Cancer and the Tropic of Capricorn and characterized by a hot climate."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cbf19ad-e3e0-4535-b0de-be0b26dbe063",
                                                "sense_id": "8d386430-a03f-390c-9fa9-3f0cefe2419b",
                                                "text": "The day was ending; night comes on very quickly in the tropics, and as yet there was no moon visible."
                                            },
                                            {
                                                "example_id": "01903160-0a7e-447b-9879-cc2d9adc3eee",
                                                "sense_id": "8d386430-a03f-390c-9fa9-3f0cefe2419b",
                                                "text": "‘In the tropics one must before everything keep calm.’...He lifted a warning forefinger...‘Du calme, du calme.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
