                "senses": [
                    {
                        "sense_id": "b1b629e0-097e-32fa-a801-c50482323d95",
                        "entry_id": "602c1ebd-bbf9-32e0-acd6-fac3f16ed471",
                        "glosses": [
                            "Supplier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffe69e44-2486-497e-b96e-c1ada65caf52",
                                "sense_id": "b1b629e0-097e-32fa-a801-c50482323d95",
                                "text": "Nous venons incognito à Bale; l'agitation redouble à Versailles et les télégrammes nous pleuvent (13 dans la même nuit) pour nous resupplier de venir à Versailles, que le vote de la prorogation est tout ce qu'il y a de plus incertain, que le maréchal veut donner sa démission, et que, si l'on n'est pas sur les lieux, on peut laisser passer la demi-heure qu'on ne retrouvera peut-être jamais et dans laquelle tout peut se décider."
                            },
                            {
                                "example_id": "b6c0e787-5df5-4c1e-bae0-790bd63f606e",
                                "sense_id": "b1b629e0-097e-32fa-a801-c50482323d95",
                                "text": "Non on va resupplier Yami ou Ash XD Bienvenu sinon."
                            },
                            {
                                "example_id": "892eb596-249b-42a1-883f-f03b8b421c4a",
                                "sense_id": "b1b629e0-097e-32fa-a801-c50482323d95",
                                "text": "Cela m'évitera aussi d'avoir à resupplier mon cousin pour le prendre quand quand les filles viendront pendant les vacances."
                            }
                        ]
                    }
                ],
