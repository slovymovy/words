                                        "sense_id": "3ddc05dc-fed9-3ba0-a300-f7fa4b5d3a39",
                                        "entry_id": "a346afbc-500b-34bb-9cde-7c374429a44e",
                                        "glosses": [
                                            "One who composes; an author.",
                                            "Especially, one who composes music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37dfe8a4-6c37-3981-a041-d83730a3d3dd",
                                        "entry_id": "a346afbc-500b-34bb-9cde-7c374429a44e",
                                        "glosses": [
                                            "One who, or that which, quiets or calms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20889063-9236-4092-b6bf-95ca80116768",
                                                "sense_id": "37dfe8a4-6c37-3981-a041-d83730a3d3dd",
                                                "text": "The exertion necessary to soothe and subdue Lucy's passionate sorrow was the best composer to Francesca's own agitation."
                                            },
                                            {
                                                "example_id": "12b4377e-d498-4e2f-a960-c8f3c540631b",
                                                "sense_id": "37dfe8a4-6c37-3981-a041-d83730a3d3dd",
                                                "text": "Where, mighty Anna, will thy Glories end.\nThou Great Composer of distracted states."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c15faf14-82da-4d7b-b66b-b409f4309863",
                        "source_entry_id": "ca726c7c-2c9f-3da1-8590-a4dcc2c417ed",
                        "source_sense_id": "f1e80fbd-fca3-3e04-a90f-22fe07dbd84b",
                        "target_lang_word": "compositeur",
