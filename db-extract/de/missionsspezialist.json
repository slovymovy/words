                "senses": [
                    {
                        "sense_id": "80dc2b01-40da-3dda-aa22-f9973d95da14",
                        "entry_id": "cb3b2f5a-224a-394e-8c4c-ef0d3fe574bd",
                        "glosses": [
                            "eine berufliche Funktion eines Astronauten bei einem Space-Shuttle-Flug."
                        ],
                        "tags": [
                            "NASA"
                        ],
                        "examples": [
                            {
                                "example_id": "30b50295-fc60-4809-9d97-dee7801c835f",
                                "sense_id": "80dc2b01-40da-3dda-aa22-f9973d95da14",
                                "text": "„Bei einem seiner vier Ausstiege in den freien Raum riss sich Missionsspezialist Dave Williams auch ein Loch in den Handschuh seines Raumanzuges und musste vorzeitig in die ISS zurückkehren.“"
                            },
                            {
                                "example_id": "75fd8556-b43d-4fc0-b69d-f7729bc902cd",
                                "sense_id": "80dc2b01-40da-3dda-aa22-f9973d95da14",
                                "text": "„Bei ihrer Arbeit wurden die Astronauten aus dem Inneren der ISS tatkräftig von „Discovery“-Kommandant Rick Sturckow und Missionsspezialist Patrick Forrester unterstützt.“"
                            }
                        ],
