                                        "examples": [
                                            {
                                                "example_id": "31590359-89b2-4335-9cbe-fb46064d7188",
                                                "sense_id": "09aa06b2-27e1-3f86-9bc7-df665edf6917",
                                                "text": "Sie vermischte das Gesagte."
                                            },
                                            {
                                                "example_id": "c3e3013e-fe67-4002-ba0f-5f9562484aab",
                                                "sense_id": "09aa06b2-27e1-3f86-9bc7-df665edf6917",
                                                "text": "Bei der Vernehmung vermischte die Zeugin tatsächlich Geschehenes mit Erdachtem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecc76bbe-a411-3823-ba80-ca8de03396bd",
                                        "entry_id": "2df2b41f-1567-366a-a5dc-d61db6bd9288",
