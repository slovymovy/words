                ],
                "senses": [
                    {
                        "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                        "entry_id": "bc7716cf-222f-3ea9-be99-822e62742b90",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fec6452-608a-4cf7-91c8-fb89810bbc7e",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Frau Anschel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c4ec287a-bf53-4272-9f60-b1a7a7bfe0fa",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Herr Anschel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b7b975b4-8572-46e5-94bb-d4e7250a1720",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Die Anschels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f701dae5-ac3a-465f-814e-70b5bae7f5c6",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Der Anschel trägt nie die Schals, die die Anschel ihm strickt."
                            },
                            {
                                "example_id": "0eee6ac2-cef8-45ee-a2c4-1051f715d6dd",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Anschel kommt, geht der Herr Anschel.“"
                            },
                            {
                                "example_id": "5d50f823-759b-4507-af12-ead828de827d",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Anschel kommt und geht."
                            },
                            {
                                "example_id": "f857a561-7166-4c3f-9353-4d5ff343bdf6",
                                "sense_id": "fe1e0e8d-cad8-3703-aa11-f5a941dbe3ee",
                                "text": "Anschels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
