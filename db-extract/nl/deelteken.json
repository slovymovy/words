                    },
                    {
                        "sense_id": "25dac710-7725-3bd6-9244-ba594d85f8f0",
                        "entry_id": "aad6efff-a5fb-3d63-8a4b-8c787c36ead7",
                        "glosses": [
                            "diaresis"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "878864b1-4a79-49bd-b2dc-ce5163217e6f",
                                "sense_id": "25dac710-7725-3bd6-9244-ba594d85f8f0",
                                "text": "Verder heeft de uitgever voor de letters die sijfers voorstellen, als .l. (50) door Romeinse sijfers vervangen en voor 't gemak, waar 't nodig was, het deelteken op de e (ë) aangebracht."
                            },
                            {
                                "example_id": "c9431eb1-e46e-418e-afde-dc4dfc8e1eac",
                                "sense_id": "25dac710-7725-3bd6-9244-ba594d85f8f0",
                                "text": "1964, Jr. van der Meulen, Spellinginstructie en woordverklaring. Het betwijfelde teken. Instructieboek voor spelling, buiging, interpunctie en woordbegrip voor voortgezet onderwijs en zelfstudie, Wolters (publ.), page 11.\nIndien twee opeenvolgende a's tot twee afzonderlijke lettergrepen behoren, krijgt de tweede een deelteken of trema.",
                                "translation": "If two subsequent as belong to two separate syllables, the second one receives a diaeresis or trema.",
                                "english": "If two subsequent as belong to two separate syllables, the second one receives a diaeresis or trema."
                            },
                            {
                                "example_id": "90e763ca-8f25-4a17-b1f6-cc9b8472fc72",
                                "sense_id": "25dac710-7725-3bd6-9244-ba594d85f8f0",
                                "text": "1995, Abraham Adolf de Boer, Spreken is zilver, schrijven is goud. Spelling(s)perikelen en andere taalproblemen, Sdu (publ.), page 36.\nEr rest nog een belangrijke vraag, namelijk waarom men bij het weglaten van de n in samenstellingen waarbij twee klinkers op elkaar stoten, zoals kippenei, gekozen heeft voor een deelteken op de e.",
                                "translation": "An important question remains, namely why it was chosen to use a diaeresis when a n is omitted in compounds where two vowels occur successively, such as kippenei.",
                                "english": "An important question remains, namely why it was chosen to use a diaeresis when a n is omitted in compounds where two vowels occur successively, such as kippenei."
                            },
                            {
                                "example_id": "90a76b80-41a0-4deb-82f1-63eae8095a25",
                                "sense_id": "25dac710-7725-3bd6-9244-ba594d85f8f0",
                                "text": "[…]; het gebruik van het trema of deelteken […]",
                                "translation": "[…] ; the use of the trema or diaeresis […]",
                                "english": "[…] ; the use of the trema or diaeresis […]"
                            }
                        ]
                    }
