                        "glosses": [
                            "A person or a thing which brings something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efc4105-fbec-489c-8934-cf5e8f291650",
                                "sense_id": "6e4766f7-f6ef-3cd5-9136-ee967a908699",
                                "text": "Yet the first bringer of unwelcome news / Hath but a losing office."
                            },
                            {
                                "example_id": "29b9ef8c-eee5-4a4a-82db-b3c945a7e5fc",
                                "sense_id": "6e4766f7-f6ef-3cd5-9136-ee967a908699",
                                "text": "And he that was over the house, and he that was over the city, the elders also, and the bringers up of the children, sent to Jehu, saying, We are thy servants, and will do all that thou shalt bid us; we will not make any king: do thou that which is good in thine eyes."
                            }
                        ]
                    },
                    {
                        "sense_id": "3111217b-ef69-3208-a7b7-ea52deba9db4",
                        "entry_id": "2252523e-d1c8-3bfe-96bb-0b9f1ffdd887",
                        "glosses": [
                            "Someone who supplies or identifies potential recruits for the military in exchange for payment."
                        ],
                        "tags": [
                            "historical",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "444e6a97-9526-497f-9742-31cdf8ceb8b8",
                                "sense_id": "3111217b-ef69-3208-a7b7-ea52deba9db4",
                                "text": "Hancox's recruitment would have gone something like this. In Conventry, where he may have been selling food or livestock at the town's market, he would have been intrigued by the recruiting party, especially the 'bringer', usually a sergeant, no doubt a tall man in scarlet with gold stripes on his sleeve."
                            }
                        ]
                    }
