                        "glosses": [
                            "A bow used to play the fiddle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "931ccc01-bea7-4b40-a05c-920efc4a741f",
                                "sense_id": "38d9f690-a7a0-3447-bf1a-07122aa858f2",
                                "text": "Some day some Gnome will steal his fiddlebow, / Or crack the stretched strings of his violin, / And hang him with them from thy windowed leaves / For all thy Flowers to gape at."
                            },
                            {
                                "example_id": "c6011734-5b68-4742-87b4-046858b23dae",
                                "sense_id": "38d9f690-a7a0-3447-bf1a-07122aa858f2",
                                "text": "Twice they have fought with harps, fiddlebows, and chair legs."
                            },
                            {
                                "example_id": "fb044f82-9d49-467f-bd6c-b1dabe942deb",
                                "sense_id": "38d9f690-a7a0-3447-bf1a-07122aa858f2",
                                "text": "The crowd boiled up with shouts. Rufus had ’em going, for sure. But he held them down with a wave of his fiddlebow. He pointed the fiddlebow right at Carlos B. Reddy and sounded off: […]"
                            }
                        ]
                    }
