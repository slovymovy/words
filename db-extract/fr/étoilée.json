                            {
                                "example_id": "714e7dcf-daec-4eea-8b0d-5a4a08d90e03",
                                "sense_id": "f95c182f-21e1-3797-82a5-562ff80788ff",
                                "text": "Le gerfaut plane, la montagne est abrupte et déchirée.\nAux flancs de ses plus hauts rochers, l’océan qui la couvrit de ses ondes amères a laissé la trace étoilée des coquilles, comme, sur le sable des grèves, se marquent les pas sautillants des oiseaux."
                            },
                            {
                                "example_id": "80f8da40-2a49-43e0-b776-5930376600d3",
                                "sense_id": "f95c182f-21e1-3797-82a5-562ff80788ff",
                                "text": "Julia Sedefdjian, la plus jeune cheffe étoilée de France, a investi, mardi, le restaurant universitaire du campus de Paris-8 à Saint-Denis (93) afin de proposer un repas au prix de 3,30 € et à 1 € pour les boursiers."
                            }
                        ]
                    }
