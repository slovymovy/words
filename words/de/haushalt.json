                {
                    "sense_id": "fcf145dd-682f-319d-a715-64edd37784d1",
                    "sense_definition": "Gesamtheit der anfallenden praktischen Arbeiten zur Pflege und Ordnung einer Wohnung oder eines Hauses",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Wohnung_Familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine Frau und ich teilen uns die Aufgaben und machen den <w>Haushalt</w> gemeinsam."
                        },
                        {
                            "text": "Am Wochenende muss er putzen und den ganzen <w>Haushalt</w> in Ordnung bringen."
                        }
                    ],
                    "synonyms": [
                        "Hausarbeit",
                        "Haushaltsarbeit"
                    ],
                    "common_phrases": [
                        "den Haushalt machen",
                        "den Haushalt führen"
                    ]
                },
                {
                    "sense_id": "c6fad4e3-1a2e-3def-ba11-ba466b25f50a",
                    "sense_definition": "Gemeinschaft von Personen, die zusammen in einer Wohnung leben und gemeinsam wirtschaften",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "Wohnung_Familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In unserem <w>Haushalt</w> leben vier Personen und zwei Katzen."
                        },
                        {
                            "text": "Viele junge Menschen gründen nach der Ausbildung ihren ersten eigenen <w>Haushalt</w>."
                        }
                    ],
                    "synonyms": [
                        "Hausstand"
                    ],
                    "common_phrases": [
                        "ein eigener Haushalt",
                        "im Haushalt leben"
                    ]
                },
                {
                    "sense_id": "67848e9c-619b-3fb9-80e2-9c75a1fdba3e",
                    "sense_definition": "Planmäßiges Gesamtverzeichnis der voraussichtlichen Einnahmen und Ausgaben einer öffentlichen Körperschaft oder Institution",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Parlament berät heute über den neuen <w>Haushalt</w> für das kommende Jahr."
                        },
                        {
                            "text": "Wegen der sinkenden Steuereinnahmen muss die Stadt ihren <w>Haushalt</w> stark kürzen."
                        }
                    ],
                    "synonyms": [
                        "Budget",
                        "Etat"
                    ],
                    "common_phrases": [
                        "den Haushalt verabschieden",
