                "senses": [
                    {
                        "sense_id": "d7d8e21d-6870-37c9-8749-c5743dd7d865",
                        "entry_id": "38bba2c4-988c-3ff2-924d-fa8bcaf4125c",
                        "glosses": [
                            "мастер, специалистка по шитью одежды; портниха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51682730-47a3-42d2-84ba-ac945dbd208a",
                                "sense_id": "d7d8e21d-6870-37c9-8749-c5743dd7d865",
                                "text": "В Москве на оброке жила в швеях и оброк платила исправно, сто восемьдесят два рубля с полтиной в год…"
                            },
                            {
                                "example_id": "d7f0c5e6-d730-4447-91c2-c19039a070ed",
                                "sense_id": "d7d8e21d-6870-37c9-8749-c5743dd7d865",
                                "text": "Я буду жить в Петербурге, а здесь своя швея только лишняя тяжесть."
                            },
                            {
                                "example_id": "e5a7de8a-11f9-483d-81c1-5b14a88588a0",
                                "sense_id": "d7d8e21d-6870-37c9-8749-c5743dd7d865",
                                "text": "Слышно было, как наверху, во втором этаже, с кем-то спорила Варя и как в детской стучала ножницами наёмная швея."
                            }
                        ]
                    },
                    {
                        "sense_id": "e490ec39-47d8-3b09-bc29-c0d21808cd65",
                        "entry_id": "38bba2c4-988c-3ff2-924d-fa8bcaf4125c",
                        "glosses": [
                            "работница швейного производства, занимающаяся только шитьём"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2365543d-9275-44a1-8a60-ed6d0767a6c4",
                                "sense_id": "e490ec39-47d8-3b09-bc29-c0d21808cd65",
                                "text": "На рынке труда не хватает токарей, сварщиков и швей, но выпускники по-прежнему идут учиться на юристов."
                            }
                        ]
                    }
                ],
