                    },
                    {
                        "form_id": "5d13778a-b4da-47ec-b5b0-bc2fb5cfe4f8",
                        "entry_id": "bd323631-8a3b-343e-8084-e4b2ebe5842b",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "шара́хавши"
                    },
                    {
                        "form_id": "0541918b-6683-4976-9ef9-d95a551ca0af",
                        "entry_id": "bd323631-8a3b-343e-8084-e4b2ebe5842b",
