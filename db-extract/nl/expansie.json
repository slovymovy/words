                                                "sense_id": "7cdf5e28-8baa-3e8b-9983-43612b40753f",
                                                "text": "My new office is in the expansion behind the main building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca1ad2f-5296-3bec-8cc4-dde25504a5f4",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "A product to be used with a previous product."
