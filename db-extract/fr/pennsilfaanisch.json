                                        "glosses": [
                                            "Sprachvariante des Pfälzischen, die in Nordamerika gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44f5b42-a7d3-4756-8d83-d2bb02e9a60d",
                                                "sense_id": "10f5509e-dd5e-3ac0-9760-089cf264337f",
                                                "text": "Rund eine Viertelmillion Sprecher hat Pennsylvaniadeutsch vor allem in den US-Bundesstaaten Pennsylvania, Ohio und Indiana und im kanadischen Ontario."
                                            },
                                            {
                                                "example_id": "064c0819-057b-4f69-9e65-ac0bb6aa4ee1",
                                                "sense_id": "10f5509e-dd5e-3ac0-9760-089cf264337f",
                                                "text": "„Da diese Zahlen sich durch hohe Geburtsraten und niedrige Verluste alle zwanzig Jahre verdoppeln, scheint die Zukunft des Pennsylvaniadeutschen gesichert.“"
                                            },
                                            {
                                                "example_id": "1806d6f0-bff1-42f6-8fbc-dea05f48090d",
                                                "sense_id": "10f5509e-dd5e-3ac0-9760-089cf264337f",
                                                "text": "„Das Pennsylvaniadeutsch ist heutzutage stark im Rückgang und wird sich voraussichtlich nicht mehr lange halten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
