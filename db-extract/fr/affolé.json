                                "target_senses": [
                                    {
                                        "sense_id": "a163c601-6cc3-3253-b621-53c20848fefc",
                                        "entry_id": "5357945c-1adc-337b-a468-d2ba1576f946",
                                        "glosses": [
                                            "Deeply hurt, saddened, or worried; incapacitated by distress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b356bf13-1431-48a2-973d-87fcc34df559",
                                                "sense_id": "a163c601-6cc3-3253-b621-53c20848fefc",
                                                "text": "His distraught widow cried for days, feeling very alone."
                                            },
                                            {
                                                "example_id": "ef88ec6c-8ce3-4be8-9746-61b1d3bb0385",
                                                "sense_id": "a163c601-6cc3-3253-b621-53c20848fefc",
                                                "text": "[…]Karius was a danger to his own team, responsible for Madrid’s two other goals and last seen wandering aimlessly around the pitch – alone, distraught and clearly traumatised – to ask forgiveness, hands clasped, from the thousands of Liverpool supporters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f20fb6-ca48-3c32-be25-469e6ae36c98",
                                        "entry_id": "5357945c-1adc-337b-a468-d2ba1576f946",
                                        "glosses": [
                                            "Mad; insane."
                                        ],
