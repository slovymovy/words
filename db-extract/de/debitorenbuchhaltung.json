                "senses": [
                    {
                        "sense_id": "918ac82c-3c15-360d-9a4c-4001ae0d4250",
                        "entry_id": "71f0fd73-181d-38a5-8ef6-c97071612766",
                        "glosses": [
                            "verarbeitet die Forderungen an Kunden."
                        ],
                        "tags": [
                            "Rechnungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e185ed-3f26-4f3c-a91b-0e788e173b17",
                                "sense_id": "918ac82c-3c15-360d-9a4c-4001ae0d4250",
                                "text": "\"Debitorenbuchhaltung wird ein Teilbereich der Finanzbuchhaltung von Unternehmen genannt. Dieser befasst sich mit der Erfassung und Verwaltung der Forderungen und Gutschriften sowie der Realisierung der offenen Posten aus den Lieferungen und sonstigen Leistungen dieses Unternehmens. Dieser Teil der Finanzbuchhaltung bearbeitet also die laufenden Geschäftsvorfälle, welche die Kunden betreffen.",
                                "translation": "Die Debitorenbuchhaltung beinhaltet auch die Durchführung der Lastschriften und das Mahnwesen. In diesem Zusammenhang wird auch vom Forderungsmanagement gesprochen.“"
                            },
                            {
                                "example_id": "a6bbcc92-1635-404f-a843-6760c6bd0173",
                                "sense_id": "918ac82c-3c15-360d-9a4c-4001ae0d4250",
                                "text": "Schon vor Jahren hat mein Großvater die Debitorenbuchhaltung erlernt."
                            },
                            {
                                "example_id": "16563cdc-b14a-410a-9df9-ab879d07fa39",
                                "sense_id": "918ac82c-3c15-360d-9a4c-4001ae0d4250",
                                "text": "„Besonders Kleinunternehmen leiden häufig unter der schlechten Zahlungsmoral einiger Kunden. Dabei sind pünktliche Zahlungen gerade für Kleinunternehmen mit geringer Liquidität sehr wichtig, um teure Zwischenfinanzierungen zu vermeiden. Ein Ausweg ist der Ausbau eines professionellen Forderungsmanagements. Grundlage dafür ist eine funktionierende Debitorenbuchhaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "260e9717-cc44-399e-8a8a-405fb3bf4ea4",
                        "entry_id": "71f0fd73-181d-38a5-8ef6-c97071612766",
                        "glosses": [
                            "Abteilung, die sich mit [1] befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
