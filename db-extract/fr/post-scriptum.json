                    },
                    {
                        "form_id": "df6a3676-ca37-4294-91cf-96aae093f9e0",
                        "entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "tags": [],
                        "form": "postscriptum"
                    },
                    {
                        "form_id": "31949b8d-4194-4fdf-886a-4a7c37512dbe",
                        "entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "tags": [],
                        "form": "post scriptum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                        "entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "glosses": [
                            "Ce qu’on ajoute à une lettre après la signature et qu’on marque ordinairement par ces deux lettres : P.-S. ou P.S."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d61ef5c-82db-4f82-b243-85b5a95dcf0e",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "Guillaume reconnut enfin Claudie, et se rappela qu’on lui avait annoncé son admission au château dans un de ces post-scriptum de lettres intimes où l’on entasse en masse les détails de la vie domestique."
                            },
                            {
                                "example_id": "7e7c1933-879c-48d1-9d2e-0ebe38efd290",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "« Dame ! fit-il, jugez-en vous-même, le post-scriptum est précis. [»]"
                            },
                            {
                                "example_id": "c552d316-bdbb-4663-8076-c6586104b1b2",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "Je lui ai tendu ensuite un assez long post-scriptum détaché, qui est une liste des errata relevés par lui dans mon livre."
                            },
                            {
                                "example_id": "d458a49e-3510-45a0-9eb1-89301e1f4d04",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "J’ajoutai vivement un post-scriptum : « Peut-être vas-tu me trouver ridicule mais je me mépriserais de n’oser l’être jamais. »"
                            },
                            {
                                "example_id": "22a0697d-9608-42bc-965d-ce50849528d0",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "Il met des post-scriptum à toutes ses lettres."
                            },
                            {
                                "example_id": "7e8bd45b-dc0e-4da5-9c4f-9b0d3ef9a539",
                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                "text": "les post-scriptum de vos dépêches antérieures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f2eb35f-32c8-4ba1-b03e-29abe86d6cc9",
                        "source_entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "source_sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                        "target_lang_word": "Postskriptum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postskriptum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32f11931-7657-3df7-83f2-129a5c04860e",
                                        "entry_id": "359fcc35-1256-3a58-a3b9-989c6304d138",
                                        "glosses": [
                                            "angefügte Ergänzung bei einem Text als Ergänzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6659508b-7db5-4f3c-84e4-ee226d697f90",
                                                "sense_id": "32f11931-7657-3df7-83f2-129a5c04860e",
                                                "text": "Im Postskriptum fragte sie dann doch noch kurz nach der Gesundheit der Eltern."
                                            },
                                            {
                                                "example_id": "a138c330-e7cb-4352-9482-24626d0bd253",
                                                "sense_id": "32f11931-7657-3df7-83f2-129a5c04860e",
                                                "text": "„In seinem Postskriptum gestand Larsoneur, er habe Lust, diese Schale kennenzulernen, was sich in Bälde machen ließe, wenn er seine Reise in die Bretagne anträte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4e50c41-cab7-4c2d-8be4-37a9d99318bf",
                        "source_entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "source_sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                        "target_lang_word": "Nachtrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5728d90-b283-3c5d-9be2-466c78180d31",
                                        "entry_id": "c7eceacc-5a5e-3eba-99f5-fab04af3b962",
                                        "glosses": [
                                            "Ergänzung zu einem an sich bereits abgeschlossenen Text"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0530e7-0959-45e1-b9ea-7e47a444fa95",
                                                "sense_id": "b5728d90-b283-3c5d-9be2-466c78180d31",
                                                "text": "Viele Briefe – oder auch andere Texte – enthalten einen Nachtrag, um zuvor Vergessenes zu ergänzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                        "entry_id": "c7eceacc-5a5e-3eba-99f5-fab04af3b962",
                                        "glosses": [
                                            "Wortgruppe, die aus der Satzklammer ausgegliedert und gestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca752d10-9111-482b-99eb-e0318dbaf6e1",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Die korrekte Abfolge der Satzglieder eines Satzes wie „Ich habe dich gestern beim Mathelernen in der Uni beobachtet“ kann so verändert werden, dass „beim Mathelernen“ im Nachfeld als Nachtrag steht: „Ich habe dich gestern in der Uni beobachtet beim Mathelernen.“"
                                            },
                                            {
                                                "example_id": "f0318f3e-80f1-4a43-b289-65c52acc4ad2",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Der Nachtrag kommt dadurch zustande, dass eine Wortgruppe aus der Satzklammer ausgeklammert und hinter die Satzklammer verschoben wird."
                                            },
                                            {
                                                "example_id": "6a4df0aa-591c-41be-8b85-8eb3226b7f86",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Der Nachtrag kann eine besondere Hervorhebung oder einfach eine Entlastung komplexer Wortgruppen innerhalb der Satzklammer bezwecken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f0b787d-806b-4552-abf9-434355495dd9",
                        "source_entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                        "source_sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                        "target_lang_word": "postscript",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ff7f18-fb81-309f-9f1d-7bfa604a8e4a",
                                        "entry_id": "afb199ed-036e-3aae-9407-e83c41854715",
                                        "glosses": [
                                            "An addendum to a letter, added after the author's signature."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911500a1-f3d9-4f4c-a7ed-49c56b5b4ca1",
                                                "sense_id": "96ff7f18-fb81-309f-9f1d-7bfa604a8e4a",
                                                "text": "As a rule Julian dictated to secretaries, and so fast that Libanius says the \"tachygraphers\" were unable to keep pace with him, but certain postscripts are marked \"with his own hand.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff3cc26-fe60-36d9-b812-2bc4ac08615c",
                                        "entry_id": "afb199ed-036e-3aae-9407-e83c41854715",
                                        "glosses": [
                                            "An addition to a story, play, etc. after its completion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfaf1402-3110-4dc1-87be-a781665da972",
                                                "sense_id": "7ff3cc26-fe60-36d9-b812-2bc4ac08615c",
                                                "text": "In a moving post-script to the novel, Forster tells the reader that the book was inspired by a visit to the home of Edward Carpenter."
                                            },
                                            {
                                                "example_id": "74fd84ad-9e0e-43e5-aef9-4aca26805c21",
                                                "sense_id": "7ff3cc26-fe60-36d9-b812-2bc4ac08615c",
                                                "text": "And then a curious postscript: I share your dislike of the shortening of names but I must say that I'm not sure 'Alexandra' is entirely suitable for you. It seems to me that you require a name with rather more brio. I see you as a 'Lexie'. What do you think?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "postscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58a91281-7c0f-3f73-8b4b-d1001921ce2b",
