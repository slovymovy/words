                        "sense_id": "ecd86fe8-4213-3b49-a378-b21770230189",
                        "entry_id": "d5faa490-328a-3bcc-814e-77936c074a24",
                        "glosses": [
                            "van een persoon dat deze misschien een vuurwapen heeft en bereid is dat te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d6e5d7-bac3-4722-94c0-92d583f80ef9",
                                "sense_id": "ecd86fe8-4213-3b49-a378-b21770230189",
                                "text": "De Rotterdammer wordt volgens het ministerie niet gezien als vuurwapengevaarlijk."
                            },
                            {
                                "example_id": "20acd3c4-10d8-490b-a9f7-e799ef258c37",
                                "sense_id": "ecd86fe8-4213-3b49-a378-b21770230189",
                                "text": "De generatie criminelen van nu zijn nietsontziend en vuurwapengevaarlijk. Ze zijn al jong uitgegroeid van lastpakken tot zware misdadigers. In zijn boek 'Doorgeschoten', dat vandaag verschijnt, beschrijft Parool-journalist Paul Vugts aan de hand van elf misdaadzaken hoe het mis is gegaan de afgelopen jaren. En stelt hij de vraag, hoe nu verder?"
                            }
                        ]
                    }
