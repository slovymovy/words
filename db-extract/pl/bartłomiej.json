                "senses": [
                    {
                        "sense_id": "3ccc4dcc-7efd-3e43-81df-18f5fcdb2952",
                        "entry_id": "c668d981-0ce0-35c7-bb39-79d70062bcce",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2f7791-7735-41b9-86cb-9b1e4633141a",
                                "sense_id": "3ccc4dcc-7efd-3e43-81df-18f5fcdb2952",
                                "text": "Mam na imię Bartłomiej i jestem bibliotekarzem z Krakowa."
                            },
                            {
                                "example_id": "cf34c68a-5553-410a-81a3-07c7e3da3ead",
                                "sense_id": "3ccc4dcc-7efd-3e43-81df-18f5fcdb2952",
                                "text": "Kiedy Bartłomiej obchodzi imieniny? Na 30 kwietnia, 5 lipca, 3 września i 11 listopada przypadają imieniny Bartłomieja oraz Bartosza."
                            },
                            {
                                "example_id": "04b4a1be-e1c1-4dd9-aa3b-0b357786c759",
                                "sense_id": "3ccc4dcc-7efd-3e43-81df-18f5fcdb2952",
                                "text": "Na stoku widzieliśmy szusującego Bartłomieja."
                            },
                            {
                                "example_id": "7cde9749-200e-4f90-ab51-d1d7c3c2d8df",
                                "sense_id": "3ccc4dcc-7efd-3e43-81df-18f5fcdb2952",
                                "text": "Panie Bartłomieju, proszę nas jutro odwiedzić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
