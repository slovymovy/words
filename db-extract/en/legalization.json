                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b879d9f0-82a2-38d9-937a-bee68df66aab",
                                        "entry_id": "54b5f6d6-16f3-37f8-a6d4-0c9515cfe28b",
                                        "glosses": [
                                            "Action de légaliser, certification de l’authenticité d’une ou de plusieurs signatures apposées au bas d’un acte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9685a635-9b09-428d-9a7b-6175eef9a6e5",
                                                "sense_id": "b879d9f0-82a2-38d9-937a-bee68df66aab",
                                                "text": "J’ai fait procéder à la légalisation de ma signature en mairie."
                                            },
                                            {
                                                "example_id": "10d84edd-0862-4ba3-a4c6-7e6f4145833b",
                                                "sense_id": "b879d9f0-82a2-38d9-937a-bee68df66aab",
                                                "text": "La respectable Mᵐᵉ de La Chanterie vint prier Adeline de joindre la légalisation des mariages naturels aux bonnes œuvres dont elle était l'intermédiaire . (Balzac)"
                                            },
                                            {
                                                "example_id": "dc56d14d-253d-464f-a816-86a503d06ff8",
                                                "sense_id": "b879d9f0-82a2-38d9-937a-bee68df66aab",
                                                "text": "— Avez-vous des papiers qui prouvent ce que vous êtes ?...\n— Oui, monsieur le baron, ils sont en langue russe et en langue allemande, mais sans légalisation..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "001dbda3-ddbe-4d3e-b653-bf7ca6fd4e15",
                        "source_entry_id": "69acd0a5-0b96-3937-ad75-561c8b3e15af",
                        "source_sense_id": "a95acd1a-25bb-318d-81c2-8976afc553c1",
