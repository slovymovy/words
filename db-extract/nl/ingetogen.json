                ],
                "senses": [
                    {
                        "sense_id": "78082385-447c-3673-9fcc-ebc161c115a1",
                        "entry_id": "1dda81d2-c2a1-3f8c-8805-7d67fc71bcfd",
                        "glosses": [
                            "bescheiden, rustig, stemmig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a578c7f5-a96d-4642-9ae3-a32d1c95e687",
                                "sense_id": "78082385-447c-3673-9fcc-ebc161c115a1",
                                "text": "Tijdens de begrafenis moet je iets ingetogeners aan hebben dan de kleurrijke kleding die je nu draagt."
                            },
                            {
                                "example_id": "a36f5ce4-d22a-4f5c-87bd-41a86a0238ac",
                                "sense_id": "78082385-447c-3673-9fcc-ebc161c115a1",
                                "text": "Niemand sprak Martina tegen en het vervolg van de discussie werd zowel ingetogener als ingewikkelder, zoals toen ze de verschillen begonnen uit te spitten tussen objectieve en subjectieve redenen voor een Sovjetpoging om de hervormingspolitiek met geweld te stoppen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "209238cb-db8c-442a-a9bb-35337c14dd4f",
                        "source_entry_id": "1dda81d2-c2a1-3f8c-8805-7d67fc71bcfd",
                        "source_sense_id": "78082385-447c-3673-9fcc-ebc161c115a1",
                        "source_sense_description": "bescheiden, rustig, stemmig",
                        "target_lang_word": "andächtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "andächtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5047e820-b3bb-3a8a-8c2b-311c608ca7bf",
                                        "entry_id": "44d31b6c-37f5-3f0a-a9c1-53fdcc5fc04e",
                                        "glosses": [
                                            "in Andacht versunken, am Gebet/Gottesdienst/einem spirituellen Inhalt innerlich beteiligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "035ae8d2-617d-435b-9dfc-30c12cfa385f",
                                                "sense_id": "5047e820-b3bb-3a8a-8c2b-311c608ca7bf",
                                                "text": "Sie kniete andächtig betend vor dem Altar."
                                            },
                                            {
                                                "example_id": "1119fa63-0022-4267-b30d-d14fdc647f94",
                                                "sense_id": "5047e820-b3bb-3a8a-8c2b-311c608ca7bf",
                                                "text": "„Die andächtigste Aufmerksamkeit ist auf allen Gesichtern eingeprägt. Christus nimmt die Einsetzung gerade so vor, wie das Evangelium sie erzählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c60b81a-fbbc-3e1b-b25a-691fbf33c863",
                                        "entry_id": "44d31b6c-37f5-3f0a-a9c1-53fdcc5fc04e",
                                        "glosses": [
                                            "voller innerlicher Hingabe, Anteilnahme; stark innerlich beteiligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ecedbd-0755-414b-a62f-6e7f24e9ee03",
                                                "sense_id": "7c60b81a-fbbc-3e1b-b25a-691fbf33c863",
                                                "text": "Andächtig lauschten die Kinder dem Märchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
