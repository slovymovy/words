                ],
                "senses": [
                    {
                        "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                        "entry_id": "52d0c82b-d7d3-3281-81e1-c100ea2c79aa",
                        "glosses": [
                            "Rauchschutzsystem zur gezielten Ableitung aus oder Verdünnung von Rauch in einem Brandabschnitt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "eb50f462-2fd2-43d4-9ff1-5710d4412f58",
                                "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                                "text": "„Zur Projektierung von maschinellen Entrauchungsanlagen, die auf dem Schichtströmungsprinzip basieren, liegen die Regelwerke DIN 18232 -5 und VDI 6019 vor.“"
                            },
                            {
                                "example_id": "18a7323f-2423-4950-a9ab-cc2b9b0901e4",
                                "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                                "text": "„Die Entrauchungsanlage war entgegen behördlicher Auflage gebaut worden, woran auch die Beauftragung renommierter Firmen wie Bosch, Siemens und Imtech nichts änderte.“"
                            },
                            {
                                "example_id": "0a19f785-bf86-4787-881c-d35720b7c50c",
                                "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                                "text": "„Das Betriebsbuch für Entrauchungsanlagen in Treppenräumen (EAT) dient dazu, sowohl den Zustand einer Anlage als auch alle Ereignisse über den gesamten Zeitraum ihres Betriebes hinweg zu dokumentieren. “"
                            },
                            {
                                "example_id": "1bd5c2b0-dcb7-44f2-bdab-2c3488b65e83",
                                "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                                "text": "„So, wie sie gebaut war, hätte die Entrauchungsanlage nie funktioniert.“"
                            },
                            {
                                "example_id": "ff734cb5-06ed-4a6d-b1f2-52235add6dee",
                                "sense_id": "c0b3098c-c7c5-36a8-ba87-6c2c978e4b4c",
                                "text": "„Auf Veranlassung des Eigentümers der Entrauchungsanlage muss die Überprüfung der Funktion der Entrauchungsklappe unter Berücksichtigung der Grundmaßnahmen zur Instandhaltung nach EN 13306 in Verbindung mit DIN 31051 mindestens in halbjährlichem Abstand erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
