{
    "word_family": [
        "subsistence",
        "subsistent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "009356ba-e290-37e4-abca-3d4aa3bbd6b4",
                    "sense_definition": "To survive or maintain life on a very small amount of food or resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "survival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families in the region struggle to <w>subsist</w> on their meager daily wages.",
                            "target_lang_translations": {
                                "de": "Viele Familien in der Region kämpfen darum, von ihrem kargen Tageslohn <w>ihr Dasein zu fristen</w>."
                            }
                        },
                        {
                            "text": "The refugees had to <w>subsist</w> on minimal rations during the harsh winter months.",
                            "target_lang_translations": {
                                "de": "Die Geflüchteten mussten während der harten Wintermonate von minimalen Rationen <w>überleben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "survive",
                        "live"
                    ],
                    "common_phrases": [
                        "subsist on"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit sehr wenig Nahrung, Geld oder sonstigen Mitteln das eigene Überleben sichern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sein Dasein fristen",
                                "target_lang_sense_clarification": "unter kargen oder schwierigen Umständen leben"
                            },
                            {
                                "target_lang_word": "sich ernähren",
                                "target_lang_sense_clarification": "von etwas leben"
                            },
                            {
                                "target_lang_word": "überleben",
                                "target_lang_sense_clarification": "mit knappen Mitteln durchkommen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "693cad17-e89b-3f78-bdd9-7e2172494c79",
                    "sense_definition": "To continue to exist or remain in a particular state or condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deep tensions <w>subsist</w> between the two nations despite the recent peace treaty.",
                            "target_lang_translations": {
                                "de": "Trotz des jüngsten Friedensvertrags <w>bestehen</w> tiefe Spannungen zwischen den beiden Nationen <w>fort</w>."
                            }
                        },
                        {
                            "text": "A strong sense of mutual respect <w>subsisted</w> between the colleagues throughout the project.",
                            "target_lang_translations": {
                                "de": "Während des gesamten Projekts <w>bestand</w> ein starkes Gefühl des gegenseitigen Respekts zwischen den Kollegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "persist",
                        "remain",
                        "continue"
                    ],
                    "target_lang_definitions": {
                        "de": "Weiterhin vorhanden sein oder in einem bestimmten Zustand fortbestehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fortbestehen",
                                "target_lang_sense_clarification": "weiterhin andauern oder existieren"
                            },
                            {
                                "target_lang_word": "bestehen",
                                "target_lang_sense_clarification": "vorhanden sein"
                            },
                            {
                                "target_lang_word": "andauern",
                                "target_lang_sense_clarification": "in der Zeit anhalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "262873a2-2e7c-33f6-949f-7a91f075a235",
                    "sense_definition": "To have actual existence or ontological reality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Legal rights <w>subsist</w> in the creator from the moment the work is fixed in a tangible form.",
                            "target_lang_translations": {
                                "de": "Gesetzliche Rechte <w>stehen</w> dem Urheber ab dem Moment zu, in dem das Werk in greifbarer Form fixiert ist."
                            }
                        },
                        {
                            "text": "Philosophers often debate whether abstract concepts <w>subsist</w> independently of human thought.",
                            "target_lang_translations": {
                                "de": "Philosophen debattieren oft darüber, ob abstrakte Konzepte unabhängig vom menschlichen Denken <w>subsistieren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exist"
                    ],
                    "target_lang_definitions": {
                        "de": "Tatsächliche Existenz, Gültigkeit oder ontologische Realität besitzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "subsistieren",
                                "target_lang_sense_clarification": "philosophischer Fachbegriff für eigenständig existieren"
                            },
                            {
                                "target_lang_word": "existieren",
                                "target_lang_sense_clarification": "vorhanden sein oder Gültigkeit haben"
                            },
                            {
                                "target_lang_word": "innehaben",
                                "target_lang_sense_clarification": "in Bezug auf rechtliche Gültigkeit oder Rechte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6eb1086c-45ae-3e13-9482-530ee9c62708",
                    "sense_definition": "To provide the necessary food or resources for someone or something to live.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "survival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small garden was intended to <w>subsist</w> the entire family through the lean harvest season.",
                            "target_lang_translations": {
                                "de": "Der kleine Garten sollte die gesamte Familie durch die magere Erntezeit <w>durchbringen</w>."
                            }
                        },
                        {
                            "text": "The local wildlife relies on the forest to <w>subsist</w> their young during the spring.",
                            "target_lang_translations": {
                                "de": "Die einheimische Tierwelt ist auf den Wald angewiesen, um ihre Jungen im Frühling zu <w>ernähren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sustain",
                        "support"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This transitive usage is now rare."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas mit lebensnotwendigen Mitteln oder Nahrung versorgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ernähren",
                                "target_lang_sense_clarification": "mit Nahrung versorgen"
                            },
                            {
                                "target_lang_word": "durchbringen",
                                "target_lang_sense_clarification": "über eine karge Zeit versorgen"
                            },
                            {
                                "target_lang_word": "versorgen",
                                "target_lang_sense_clarification": "den Lebensunterhalt sicherstellen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}