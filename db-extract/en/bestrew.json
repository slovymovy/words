                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "покрывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9e370ee4-6de4-35b6-b09a-a38336ed9743",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "помещать, накладывать что-либо на объект"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b222bc06-fd02-428c-80cb-09a2b70cd9da",
                                                "sense_id": "9e370ee4-6de4-35b6-b09a-a38336ed9743",
                                                "text": "Стояла суровая зима 1860 года, Уаза замерзла, и глубокий снег покрывал равнины Нижней Пикардии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3def3cbf-3dc2-3617-837b-176b7439406c",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "перен., о звуке то же, что заглушать; быть громче других звуков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcf9b05-cdea-4af2-91b3-45de65d98499",
                                                "sense_id": "3def3cbf-3dc2-3617-837b-176b7439406c",
                                                "text": "Его голос легко покрывал все шумы улицы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e61996c-2f27-3e64-92d7-81617fef1281",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "перен. возмещать, оплачивать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3b231e-0d82-4356-a70f-41345995eb60",
                                                "sense_id": "4e61996c-2f27-3e64-92d7-81617fef1281",
                                                "text": "Эта сумма покрывает все расходы."
                                            },
                                            {
                                                "example_id": "65e41301-3076-49d0-8ea5-b66cf2deb0b4",
                                                "sense_id": "4e61996c-2f27-3e64-92d7-81617fef1281",
                                                "text": "Ему надо покрывать долги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b7b971-b811-388c-abc6-2e64a1248c93",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "перен. помогать спрятаться, уйти от опасности, возмездия или ответственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ecdd43-227b-4369-b293-d0ab9a4b8744",
                                                "sense_id": "59b7b971-b811-388c-abc6-2e64a1248c93",
                                                "text": "Он не хотел покрывать преступника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9616b4ac-3c27-33ef-a3cc-20bdaae71727",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "передвигаясь, преодолевать определённое расстояние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ab656c-ca24-4f7c-be19-ba20cc63583e",
                                                "sense_id": "9616b4ac-3c27-33ef-a3cc-20bdaae71727",
                                                "text": "За день он покрывает 500 километров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68f3f365-dc86-3331-b402-9647acdd998e",
                                        "entry_id": "c7bf75c6-4908-3d21-aba0-a8a5849d67f1",
                                        "glosses": [
                                            "с.-х. то же, что осеменять"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6c7814-9842-48e9-b0e8-24a6c9b31f71",
                                                "sense_id": "68f3f365-dc86-3331-b402-9647acdd998e",
                                                "text": "— И что с того, никто же не отворачивается, когда этим занимаются собаки, или когда бык покрывает корову, — говорила Герти Клариссе. — Какая разница?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
