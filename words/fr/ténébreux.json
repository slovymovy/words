                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce film d'aventure, l'acteur principal incarne à la perfection le beau <w>ténébreux</w>."
