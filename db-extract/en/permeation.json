                "translations": [
                    {
                        "translation_id": "c812e1b0-3dc3-444a-b2cb-041c4d96e004",
                        "source_entry_id": "5f904a5f-c5b8-3f0b-9f2a-70e482765928",
                        "source_sense_id": "a0f4924a-e8cc-363a-8232-2229cbaca889",
                        "source_sense_description": "Durchdringung, Eindringen",
                        "target_lang_word": "Durchdringung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchdringung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "577d41f1-905e-3937-b814-ee309fe4ec53",
                                        "entry_id": "b11c0028-57c7-372f-b876-6c9e1e3a683f",
                                        "glosses": [
                                            "vollständiges Eindringen in etwas; Sättigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f5f281-cfd1-40e1-8380-116e96f1ef16",
                                                "sense_id": "577d41f1-905e-3937-b814-ee309fe4ec53",
                                                "text": "Nach der Ablösung von Muskel- durch Maschinenkraft beginnt die Durchdringung der industriellen Fertigung durch Digitalisierung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de1575dd-9511-33f3-94a4-51e06f4ff71e",
                                        "entry_id": "b11c0028-57c7-372f-b876-6c9e1e3a683f",
                                        "glosses": [
                                            "geistige Erfassung, Aneignung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3043187a-20d6-4cd8-a8ee-18e9b184b71b",
                                                "sense_id": "de1575dd-9511-33f3-94a4-51e06f4ff71e",
                                                "text": "„Es sei, zwecks besserer Durchdringung des Problems, noch erwähnt, dass Kant sich unter anderem von zwei Entwicklungstendenzen Unterstützung für sein Programm erhofft hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7236ffa3-289d-3b5d-9eae-d333c17f0b3c",
                                        "entry_id": "b11c0028-57c7-372f-b876-6c9e1e3a683f",
                                        "glosses": [
                                            "Volumensbereich, der von mehreren Körpern geteilt wird"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9bc669e-1572-43d3-ac88-b826fee4df9e",
                                                "sense_id": "7236ffa3-289d-3b5d-9eae-d333c17f0b3c",
                                                "text": "Werden zwei oder mehrere Körper so miteinander kombiniert, dass sie gemeinsame Volumenbereiche besitzen, so entstehen sogenannte Durchdringungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "464f72fc-d362-407b-80bc-a10910f1b99e",
                        "source_entry_id": "5f904a5f-c5b8-3f0b-9f2a-70e482765928",
                        "source_sense_id": "a0f4924a-e8cc-363a-8232-2229cbaca889",
                        "source_sense_description": "Durchdringung, Eindringen",
                        "target_lang_word": "Eindringen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eindringen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                        "entry_id": "11a7f14b-8dc1-32bb-af34-92a34cf424e9",
                                        "glosses": [
                                            "Vorgang/Ereignis, bei der etwas in etwas eintritt/hineingelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec513104-7f91-4242-b575-01a564a333f8",
                                                "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                                "text": "Durch das Eindringen des Wassers wurde die gesamte Wohnung durchnässt."
                                            },
                                            {
                                                "example_id": "f3b2c03e-759e-406b-bb7b-931060bf1182",
                                                "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                                "text": "„Beim Eindringen artfremden Eiweißes (Antigene) in das Blut werden in Plasmazellen des Knochenmarks und im lymphatischen Gewebe hochspezifische Abwehrstoffe (Antitoxine, Antikörper) gebildet und in das Blut abgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0965af1-a2cd-4aeb-b279-8ee46a53a7bd",
                        "source_entry_id": "5f904a5f-c5b8-3f0b-9f2a-70e482765928",
