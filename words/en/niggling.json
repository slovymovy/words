{
    "word_family": [
        "niggle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cb42beb8-b562-3a9b-bc35-a76d7aa5252c",
                    "sense_definition": "Causing slight but persistent annoyance or worry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>niggling</w> doubt that she had forgotten to lock the front door.",
                            "target_lang_translations": {
                                "cs": "Měla <w>hlodavou</w> pochybnost, že zapomněla zamknout vchodové dveře."
                            }
                        },
                        {
                            "text": "The <w>niggling</w> fear that something was wrong kept him awake all night.",
                            "target_lang_translations": {
                                "cs": "<w>Hlodavý</w> strach, že je něco v nepořádku, ho celou noc nenechal spát."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "bothersome",
                        "troublesome"
                    ],
                    "common_phrases": [
                        "niggling doubt",
                        "niggling fear"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobující mírné, ale přetrvávající obtěžování nebo obavy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlodavý",
                                "target_lang_sense_clarification": "používá se pro pocity, které člověka nenechají v klidu"
                            },
                            {
                                "target_lang_word": "obtěžující",
                                "target_lang_sense_clarification": "obecný výraz pro něco, co vyvolává nepříjemné pocity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0a61a34-e1b3-32b8-8dec-27d9b4d3f4af",
                    "sense_definition": "Relating to small, trivial, or unimportant details.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "triviality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent hours on <w>niggling</w> tasks that did not really matter to the project.",
                            "target_lang_translations": {
                                "cs": "Strávil hodiny <w>malichernými</w> úkoly, které pro projekt nebyly skutečně důležité."
                            }
                        },
                        {
                            "text": "The manager was known for his <w>niggling</w> attention to minor office rules.",
                            "target_lang_translations": {
                                "cs": "Manažer byl známý svou <w>puntičkářskou</w> pozorností k drobným kancelářským pravidlům."
                            }
                        }
                    ],
                    "synonyms": [
                        "petty",
                        "trivial",
                        "fussy"
                    ],
                    "common_phrases": [
                        "niggling detail",
                        "niggling task"
                    ],
                    "target_lang_definitions": {
                        "cs": "Týkající se malých, nepodstatných nebo nedůležitých detailů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "malicherný",
                                "target_lang_sense_clarification": "zaměřený na nedůležité detaily"
                            },
                            {
                                "target_lang_word": "puntičkářský",
                                "target_lang_sense_clarification": "přílišné soustředění na drobnosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba41308f-6fa0-3ed7-bea2-9a82db6b4f81",
                    "sense_definition": "A small, persistent, or irritating sensation or feeling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt small <w>nigglings</w> of guilt whenever she thought about the argument.",
                            "target_lang_translations": {
                                "cs": "Kdykoliv pomyslela na tu hádku, cítila malé <w>záchvěvy</w> viny."
                            }
                        },
                        {
                            "text": "Despite the success, there were still <w>nigglings</w> of doubt in his mind.",
                            "target_lang_translations": {
                                "cs": "Navzdory úspěchu v něm stále přetrvávaly <w>pocity</w> pochybností."
                            }
                        }
                    ],
                    "synonyms": [
                        "twinge",
                        "prickle"
                    ],
                    "common_phrases": [
                        "nigglings of doubt"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý, přetrvávající nebo dráždivý pocit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pocity",
                                "target_lang_sense_clarification": "v kontextu vnitřního neklidu nebo pochybností"
                            },
                            {
                                "target_lang_word": "záchvěvy",
                                "target_lang_sense_clarification": "krátké, ale citelné pocity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8e84bd3-901e-367d-9acb-0ddc2a047300",
                    "sense_definition": "The present participle and gerund of <w>niggle</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>niggling</w> over the minor details of the contract for hours.",
                            "target_lang_translations": {
                                "cs": "Hodiny se <w>rýpal</w> v drobných detailech smlouvy."
                            }
                        },
                        {
                            "text": "Stop <w>niggling</w> about the price and just buy the item.",
                            "target_lang_translations": {
                                "cs": "Přestaň se <w>dohadovat</w> o ceně a prostě tu věc kup."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa niggle (rýpat se v něčem)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rýpání se",
                                "target_lang_sense_clarification": "zabývání se nepodstatnými detaily"
                            },
                            {
                                "target_lang_word": "dohadování se",
                                "target_lang_sense_clarification": "pře o malichernosti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}