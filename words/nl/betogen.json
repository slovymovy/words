    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07186ed0-bfb4-3a71-b0d4-e6f071c6f532",
                    "sense_definition": "deelnemen aan een publieke actie of demonstratie om een mening of protest kenbaar te maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demonstreren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Duizenden mensen gingen de straat op en <w>betoogden</w> tegen de nieuwe wetgeving.",
                            "target_lang_translations": {
                                "en": "Thousands of people took to the streets and <w>demonstrated</w> against the new legislation."
                            }
                        },
                        {
                            "text": "Zij wilden vreedzaam <w>betogen</w> voor een beter klimaatbeleid in hun stad.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>protest</w> peacefully for a better climate policy in their city."
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstreren"
                    ],
                    "common_phrases": [
                        "vreedzaam betogen",
                        "tegen de plannen betogen"
                    ],
                    "target_lang_definitions": {
                        "en": "To participate in a public action or demonstration to express an opinion or protest."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demonstrate",
                                "target_lang_sense_clarification": "to participate in a public protest"
                            },
                            {
                                "target_lang_word": "protest",
                                "target_lang_sense_clarification": "to express objection publicly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56c636fb-69f8-3fdc-be52-26c2d222707d",
                    "sense_definition": "met argumenten proberen aan te tonen dat een bepaalde stelling of mening juist is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argumenteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In haar boek <w>betoogt</w> zij dat we gezonder moeten gaan eten.",
                            "target_lang_translations": {
                                "en": "In her book, she <w>argues</w> that we should start eating more healthily."
                            }
                        },
                        {
                            "text": "De advocaat <w>betoogde</w> met overtuiging de onschuld van de verdachte tijdens de rechtszaak.",
                            "target_lang_translations": {
                                "en": "The lawyer <w>pleaded</w> the defendant's innocence with conviction during the trial."
                            }
                        }
                    ],
                    "synonyms": [
                        "bepleiten",
                        "argumenteren",
                        "stellen"
                    ],
                    "common_phrases": [
                        "met overtuiging betogen",
                        "in een artikel betogen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in een formele of academische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To attempt to show through arguments that a certain proposition or opinion is correct."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "argue",
                                "target_lang_sense_clarification": "to present reasons for a viewpoint"
                            },
                            {
                                "target_lang_word": "maintain",
                                "target_lang_sense_clarification": "to assert or state as a fact"
                            },
                            {
                                "target_lang_word": "contend",
                                "target_lang_sense_clarification": "to assert something as a position in an argument"
                            },
                            {
                                "target_lang_word": "plead",
                                "target_lang_sense_clarification": "to make an emotional or logical appeal, often in court"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3958fc65-8942-3a5e-b54c-3ef8ee37ea38",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>betoog</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verschillende <w>betogen</w> van de studenten waren allemaal erg indrukwekkend.",
                            "target_lang_translations": {
                                "en": "The students' various <w>arguments</w> were all very impressive."
                            }
                        },
                        {
                            "text": "Na het horen van beide <w>betogen</w> kon de jury eindelijk een beslissing nemen.",
                            "target_lang_translations": {
                                "en": "After hearing both <w>pleas</w>, the jury was finally able to make a decision."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'betoog' (argument, plea, or discourse)."
                    },
                    "translations": {
