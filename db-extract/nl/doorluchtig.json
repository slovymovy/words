                "translations": [
                    {
                        "translation_id": "2484c142-47e8-4de1-a8cd-d964994f2502",
                        "source_entry_id": "7fed71cc-40ef-3144-95c0-6b1fbfa82df6",
                        "target_lang_word": "illustrious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustrious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f3f0f8-17c5-33ca-8b0e-6b1a2c3837b4",
                                        "entry_id": "d369c018-d548-3fef-b2af-dacafbe12801",
                                        "glosses": [
                                            "Admired, distinguished, respected, or well-known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69154ba4-d21c-45c3-a1ce-ddf8df652faa",
                                                "sense_id": "c2f3f0f8-17c5-33ca-8b0e-6b1a2c3837b4",
                                                "text": "A solid and substantial greatness of soul looks down, with a generous neglect, on the censures and applauses of the multitude, and places a man beyond the little noise and strife of tongues. Accordingly we find in ourselves a secret awe and veneration for the character of one who moves above us, in a regular and illustrious course of virtue, without any regard to our own good or ill opinions of him, to our reproaches or commendations."
                                            },
                                            {
                                                "example_id": "c798689d-6f43-455f-b697-a817b2f7eea6",
                                                "sense_id": "c2f3f0f8-17c5-33ca-8b0e-6b1a2c3837b4",
                                                "text": "Really, for a man who had been out of practice for so many years, it was a splendid laugh, a most illustrious laugh. The father of a long, long line of brilliant laughs!"
                                            },
                                            {
                                                "example_id": "25a869c0-f13a-4a18-8733-90b59b1dfd10",
                                                "sense_id": "c2f3f0f8-17c5-33ca-8b0e-6b1a2c3837b4",
                                                "text": "The ant has made himself illustrious / Through constant industry industrious. / So what? / Would you be calm and placid / If you were full of formic acid?"
                                            },
                                            {
                                                "example_id": "78a22570-cfca-4b2c-aaf1-3b7c47e0a913",
                                                "sense_id": "c2f3f0f8-17c5-33ca-8b0e-6b1a2c3837b4",
                                                "text": "[Marcus] Rashford showed the fearless streak [Gareth] Southgate so admires with his constant willingness to run at Brazil's defence with pace, even demonstrating on occasion footwork that would not have been out of place from members of England's illustrious opposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
