                        "endormir une jambe"
                    ]
                },
                {
                    "sense_id": "cebff667-6711-3abe-826f-6d39283bcf38",
                    "sense_definition": "Tromper la vigilance ou la méfiance de quelqu'un pour le manipuler ou l'empêcher de réagir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'escroc a utilisé de belles promesses pour <w>endormir</w> la vigilance de ses victimes."
                        },
                        {
                            "text": "Le négociateur a su habilement <w>endormir</w> la méfiance de ses adversaires."
                        }
                    ],
                    "synonyms": [
                        "berner",
                        "tromper"
                    ],
                    "common_phrases": [
                        "endormir la vigilance",
                        "endormir la méfiance"
                    ]
                },
                {
                    "sense_id": "69d490a7-c479-3378-91b0-11bd6a3b47cc",
                    "sense_definition": "Euthanasier un animal sans cruauté afin d'abréger ses souffrances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "euthanasie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vétérinaire a dû <w>endormir</w> ce vieux chat atteint d'une maladie incurable."
                        },
                        {
                            "text": "Face aux souffrances intolérables de leur chien, les propriétaires ont décidé de le faire <w>endormir</w>."
