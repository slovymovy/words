                "senses": [
                    {
                        "sense_id": "108fc53e-a192-32f2-a54c-c7f7d6fd2feb",
                        "entry_id": "2b9738c8-4f90-302f-bbb8-9da462e1588d",
                        "glosses": [
                            "zeitliche Erstreckung eines Lüftungsvorgang für einen Tank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55202f9a-2c64-4046-8dee-5710f0007a1d",
                                "sense_id": "108fc53e-a192-32f2-a54c-c7f7d6fd2feb",
                                "text": "„Für Tankreinigungsarbeiten im Keller stellt die Tanklüftung im Mittel eine Verbesserung der Luftbelastung am Mannloch dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                        "entry_id": "2b9738c8-4f90-302f-bbb8-9da462e1588d",
                        "glosses": [
                            "permanenter Lüftungsvorgang von einem Tank im Dauerbetrieb; Lüftungsstutzen oder Lüftungsventil am Tank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c7f9a9-1e15-4aff-8d85-52f7a1c7eb5b",
                                "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                                "text": "„Der Kraftstoff dehne sich bei hohen Temperaturen aus, könne über die Tanklüftung entweichen und sich im schlimmsten Fall entzünden, warnt der Autoclub ACE in Stuttgart.“"
                            },
                            {
                                "example_id": "b87a0cb0-9a4c-4910-8c89-4e6211288ca6",
                                "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                                "text": "„Bei Fahrzeugen mit Allradantrieb ist zudem eine Kontrolle der Tanklüftung notwendig.“"
                            },
                            {
                                "example_id": "57c02cb5-ebfb-4381-b135-a4c96c699bd8",
                                "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                                "text": "„Der Kraftstoff kann über die Tanklüftung entweichen und sich im schlimmsten Fall entzünden.“"
                            },
                            {
                                "example_id": "71ed7b18-5601-40ee-af5a-09eab8729d51",
                                "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                                "text": "„Einsatzleiter Michael Mund: „Beim Umpumpen können Dämpfe über die Tanklüftung entweichen.“"
                            },
                            {
                                "example_id": "f18915ab-b4c1-4ec5-b643-32399c968ea8",
                                "sense_id": "523f116b-963f-39b9-a3f3-87d57ac48f6c",
                                "text": "„Wegen eines zugefallenen Schnellschlussventils am Steuerbordtank war Dieselkraftstoff durch die Tanklüftung ausgetreten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
