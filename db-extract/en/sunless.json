                    {
                        "sense_id": "b80bc4bf-afa2-3c29-b1c5-b21aa2f23c44",
                        "entry_id": "bb25c156-be15-3578-87fa-79bd3b7cef50",
                        "glosses": [
                            "Without the sun or sunshine; shaded; shadowed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11679487-6684-4a97-8a2b-78fdd4dbcc10",
                                "sense_id": "b80bc4bf-afa2-3c29-b1c5-b21aa2f23c44",
                                "text": "In Xanadu did Kubla Khan / A stately pleasure-dome decree: / Where Alph, the sacred river, ran / Through caverns measureless to man / Down to a sunless sea."
                            }
                        ]
                    },
                    {
                        "sense_id": "59b368a7-6327-3c10-a87c-e20d13e343d6",
                        "entry_id": "bb25c156-be15-3578-87fa-79bd3b7cef50",
                        "glosses": [
                            "Dreary, cheerless."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bd58cefc-ce06-4918-869e-a62d47c835ce",
                                "sense_id": "59b368a7-6327-3c10-a87c-e20d13e343d6",
                                "text": "When I first saw her, her countenance was sunless, her complexion colourless; she looked like one who had no source of enjoyment, no store of bliss anywhere in the world."
                            }
                        ]
                    }
                ],
                "translations": [
