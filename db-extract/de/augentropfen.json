                "senses": [
                    {
                        "sense_id": "fd925878-7665-310a-9cdf-7143bdbb339f",
                        "entry_id": "cc9b42bf-91b8-3b77-90cd-53fa59339994",
                        "glosses": [
                            "eine flüssige Darreichungsform von Arzneimitteln zum Tropfen in das Auge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ea51e0-b9af-41d1-9b45-5dca81b045ab",
                                "sense_id": "fd925878-7665-310a-9cdf-7143bdbb339f",
                                "text": "Bei entzündeten Augen helfen manchmal Augentropfen."
                            },
                            {
                                "example_id": "c0af1644-559b-4a67-96a6-0fff80305de1",
                                "sense_id": "fd925878-7665-310a-9cdf-7143bdbb339f",
                                "text": "„Wenn sich die Leute vom Stamm der Matis vor der Jagd selbstgefertigte drogenartige Augentropfen verabreichen, um besser zu sehen und mit dem Urwald eins zu sein, und dann einer mit Blasrohr und Giftpfeil einen kleinen Affen, der 30 Meter über ihm im Gehölz turnt, herunterholt, ist klar, warum man \"Universum\" sieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da8c801c-6791-48a3-bcbe-3fff86b08b11",
