        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a0af571-aa6c-3bb8-a781-ee05b77948a8",
                    "sense_definition": "The complete vocabulary of a language.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocabulary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New technology has introduced hundreds of fresh terms into the English <w>lexicon</w>."
                        },
                        {
                            "text": "Linguists study how words enter the <w>lexicon</w> and change meaning over centuries."
                        }
                    ],
                    "synonyms": [
                        "word-stock"
                    ],
                    "common_phrases": [
                        "enter the lexicon",
                        "the English lexicon"
                    ]
                },
                {
                    "sense_id": "21053525-23d2-3925-b1b5-0cdd33a2a02f",
                    "sense_definition": "The specialized vocabulary associated with a particular subject, profession, or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocabulary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medical jargon forms a specialized <w>lexicon</w> that outsiders often struggle to understand."
                        },
                        {
                            "text": "Turns and jumps make up the expressive <w>lexicon</w> of classical ballet."
                        }
                    ]
                },
                {
                    "sense_id": "48080a75-22d3-3234-8706-82d24dda6019",
                    "sense_definition": "The vocabulary known to or used by an individual person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocabulary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reading challenging books regularly will expand your personal mental <w>lexicon</w>."
                        },
                        {
                            "text": "That obscure slang term is definitely not part of my active <w>lexicon</w>."
                        }
                    ],
                    "synonyms": [
                        "word-hoard"
                    ],
                    "common_phrases": [
                        "mental lexicon"
                    ]
                },
                {
                    "sense_id": "27474126-6c62-3e86-be9c-03b7de3a517f",
                    "sense_definition": "A reference book containing words and their meanings, especially one focusing on an ancient or classical language; a dictionary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dictionary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar consulted a Greek <w>lexicon</w> to translate the ancient manuscript."
                        },
                        {
                            "text": "Students of classical Hebrew keep a comprehensive <w>lexicon</w> on their desks."
                        }
                    ],
                    "synonyms": [
                        "glossary",
                        "wordbook"
                    ],
                    "common_phrases": [
                        "Greek lexicon"
                    ]
                },
                {
                    "sense_id": "944696c4-5aca-3784-b37a-d2ebb7f8dd9c",
                    "sense_definition": "The lexical structure or set of valid tokens used in a programming language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler checks every statement against the strict <w>lexicon</w> of the programming language."
                        },
                        {
                            "text": "Adding new operators would significantly alter the <w>lexicon</w> of this scripting tool."
                        }
                    ],
                    "traits": [
