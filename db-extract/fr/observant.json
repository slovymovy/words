                        "glosses": [
                            "Personne qui est fidèle à l’observance religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d42276-228a-4df4-a734-b2c302a36752",
                                "sense_id": "32e106e2-4d6f-309c-9542-ffedc6a6c3dd",
                                "text": "Les observants assidus, qui assistent à la messe chaque dimanche, se confessent et communient à Pâques."
                            }
                        ]
                    },
                    {
                        "sense_id": "081b8912-c29a-3e61-a200-4098d646d8e1",
                        "entry_id": "01ea9475-860b-34bb-8d7c-ddc5722df638",
                        "glosses": [
                            "Franciscain de l’étroite observance de saint François."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b948b1d6-26ca-4681-981f-32753023da57",
                                "sense_id": "081b8912-c29a-3e61-a200-4098d646d8e1",
                                "text": "Les Observants ont été unifiés par Léon XIII en 1897 sous le nom de Frères Mineurs sans autre qualificatif."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
