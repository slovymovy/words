{
    "word_family": [
        "imagination",
        "imaginaire",
        "imaginable",
        "inimaginable",
        "imaginatif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7a95f8b-2181-3cd6-b5da-d3107f030ffc",
                    "sense_definition": "Se représenter mentalement une personne, une chose ou une situation dans son esprit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "representation_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est très difficile d'<w>imaginer</w> notre quotidien sans électricité ou sans téléphone."
                        },
                        {
                            "text": "Nous pouvons facilement <w>imaginer</w> la joie des enfants lors de cette fête."
                        }
                    ],
                    "common_phrases": [
                        "difficile à imaginer",
                        "facile à imaginer"
                    ]
                },
                {
                    "sense_id": "ee040edf-c408-3205-889c-614270d5a1d6",
                    "sense_definition": "Concevoir, inventer ou créer quelque chose grâce à ses facultés créatrices.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "invention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte doit <w>imaginer</w> une solution moderne pour rénover ce vieux bâtiment."
                        },
                        {
                            "text": "Pour ce projet, les élèves ont <w>imaginé</w> un nouveau jeu interactif."
                        }
                    ],
                    "common_phrases": [
                        "imaginer une solution",
                        "imaginer un stratagème"
                    ]
                },
                {
                    "sense_id": "2f4f18a2-b875-34bd-90d7-f75caf2f6a52",
                    "sense_definition": "Croire à tort ou supposer une chose sans fondement réel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne va pas t'<w>imaginer</w> des choses désagréables avant de lui avoir parlé."
                        },
                        {
                            "text": "Elle s'<w>imagine</w> que tout le monde la critique alors que c'est faux."
                        }
                    ],
                    "common_phrases": [
                        "s'imaginer des choses",
                        "aller s'imaginer"
                    ]
                }
            ]
        }
    ]
}