                        "glosses": [
                            "D'un commerce désagréable ; impoli."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6d24a4a8-ce8b-4c3d-8b14-a9f5fbce4610",
                                "sense_id": "e8467d83-2cf7-33c7-b1b4-80b632064399",
                                "text": "Compagnie aérienne à la ramasse, personnel navigant malaimable, nourriture infecte. Et la classe affaire n'y avait rien changé."
                            },
                            {
                                "example_id": "593a0ebe-f1b1-4ca9-9bab-81dfc1862aa4",
                                "sense_id": "e8467d83-2cf7-33c7-b1b4-80b632064399",
                                "text": "Seul un vieux serviteur malaimable l'accueillit qui lui montra sa chambre. Elle se coucha dans le grand lit et s'endormit aussitôt."
                            },
                            {
                                "example_id": "0c1879e3-7128-4369-8bd8-23a48126336b",
                                "sense_id": "e8467d83-2cf7-33c7-b1b4-80b632064399",
                                "text": "Les réponses étaient variées, parfois malaimables et parfois sympathiques, mais, en résumé, elle n'avait jamais obtenu le moindre renseignement exploitable."
                            }
                        ]
                    }
