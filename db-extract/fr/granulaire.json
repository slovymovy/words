                ],
                "senses": [
                    {
                        "sense_id": "ddfc9add-a420-3605-8621-4d686658b974",
                        "entry_id": "f5581f98-37db-3ea0-b882-fa4243ec5f1a",
                        "glosses": [
                            "Qui se compose de, qui apparait sous forme de petits grains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa49260-e8e5-4920-925c-c84b897581c1",
                                "sense_id": "ddfc9add-a420-3605-8621-4d686658b974",
                                "text": "Le rayonnement fossile est visible sur cette image sous la forme de structures granulaires rougeâtres, principalement visibles au haut et en bas de l'image, où l'émission de notre Galaxie est très faible."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b30d1a5-9a5b-3c66-a5f7-c7b20428ed34",
                        "entry_id": "f5581f98-37db-3ea0-b882-fa4243ec5f1a",
                        "glosses": [
                            "Qui se compose de petits éléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf1528b-15a0-4c15-92a0-a1c048aa702e",
                                "sense_id": "5b30d1a5-9a5b-3c66-a5f7-c7b20428ed34",
                                "text": "Les valeurs limites de lixiviation fixées ci-dessous s'appliquent aux déchets granulaires admissibles dans les décharges pour déchets dangereux; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b12da01-ca2a-3a14-9159-71051c9d1711",
                        "entry_id": "f5581f98-37db-3ea0-b882-fa4243ec5f1a",
                        "glosses": [
                            "Qui est formé de granulats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78267194-a2fb-4072-9d85-50cee2178b97",
                                "sense_id": "1b12da01-ca2a-3a14-9159-71051c9d1711",
                                "text": "L'association entre les pâtes optimisées et un squelette granulaire dont la demande en eau a été définie permet la formulation de bétons autoplaçants."
                            },
                            {
                                "example_id": "567a2a18-53f8-4786-b4da-857b4c10985f",
                                "sense_id": "1b12da01-ca2a-3a14-9159-71051c9d1711",
                                "text": "L'enduit monocouche à double gravillonnage, qui comporte une couche de liant et deux couches de granulats, la seconde étant de classe granulaire inférieure à celle de la première."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cfdd1fb-cb42-3066-adea-95030f30823d",
                        "entry_id": "f5581f98-37db-3ea0-b882-fa4243ec5f1a",
                        "glosses": [
                            "Qui se comporte comme un tas de grains (comme un tas de sable)."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "dd333932-dc89-4906-a6ca-7147fad2f46a",
                                "sense_id": "0cfdd1fb-cb42-3066-adea-95030f30823d",
                                "text": "Système granulaire."
                            }
                        ]
                    }
                ],
