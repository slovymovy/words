                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3a07bab-9908-33d2-81a0-ff759f94601d",
                        "entry_id": "c0c3d099-61ff-3f00-8d91-5fa1470bccca",
                        "glosses": [
                            "positief, enthousiast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e991265-d75d-43dd-8ae9-f2f2bd28ce10",
                                "sense_id": "a3a07bab-9908-33d2-81a0-ff759f94601d",
                                "text": "De show stelen. Niet alleen voetballers doen het, mascottes kunnen er ook wat van. Toen tijdens de Champions League-hymne voor het duel Barcelona-Manchester City de camera passeerde, deed een jongetje voor de neus van Samuel Umtiti een heuse 'dab'. Het leverde op Twitter een stroom aan vooral bewonderende reacties op."
                            },
                            {
                                "example_id": "1c9732fa-530c-49d8-a841-c5cedecc0f64",
                                "sense_id": "a3a07bab-9908-33d2-81a0-ff759f94601d",
                                "text": "Enkele tientallen Bornenaren ontvangen de 3,5 meter hoge mammoet van kunststof met bewonderende blikken. Heel even mogen ze het kunstwerk dat Patrick Jossos heeft gemaakt van Bornes oudste ‘inwoner’ bewonderen."
                            },
                            {
                                "example_id": "e7503b87-fac4-4e88-ad5f-11dcd2f0b17c",
                                "sense_id": "a3a07bab-9908-33d2-81a0-ff759f94601d",
                                "text": "Haar blik bleef gericht op beide gezichten van haar kinderen, waarop een bewonderende blik lag. 'Kijk, een echte leeuw! ' zei Dennis vol ontzag."
                            },
                            {
                                "example_id": "4fdc6eea-dc5b-44af-a229-f7ed7761f50a",
                                "sense_id": "a3a07bab-9908-33d2-81a0-ff759f94601d",
                                "text": "Ó'zei ze bewonderend toen ze terugkeerde met alleen haar hemd aan en zonder onderbroek, ík ben een beetje bang, ik ben het zo ontwend, het is zo lang geleden."
                            }
                        ]
                    }
