                                "target_senses": [
                                    {
                                        "sense_id": "0f994da4-f0ff-37d7-991f-5d7fbdb85535",
                                        "entry_id": "cf78a443-276c-3111-84b5-579a250dc37b",
                                        "glosses": [
                                            "Langue sud-sémitique, parlée en Éthiopie jusqu’au XIVᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0f01ba-ac94-46b2-a3c4-62609a225149",
                                                "sense_id": "0f994da4-f0ff-37d7-991f-5d7fbdb85535",
                                                "text": "Dans un coin, un vieux moine chante d’une voix de plus en plus somnolente et languissante un psaume en guèze, une langue morte aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guèze",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6db989e-e346-3dda-92bc-c9e4d9c6a127",
                                        "entry_id": "79f5bed5-2b52-3fd1-865d-23c83c80ea44",
                                        "glosses": [
                                            "Content."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2dcceca-2134-49fc-9bb5-5636ef3f94e6",
                                                "sense_id": "b6db989e-e346-3dda-92bc-c9e4d9c6a127",
                                                "text": "Sois guèze te remets pas de haine dans l'cœur sinon c'est la gamberge grise\nAppelle plutôt une girl moi j'suis guèze quand un frère sert\nguèze quand il s'en sort guez quand il censure les haineux\nParce que le bien l'escorte et que l'espoir le porte j'suis guèze"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76874396-e4d1-3d90-8fe9-fc969ff0d4cf",
                                        "entry_id": "79f5bed5-2b52-3fd1-865d-23c83c80ea44",
                                        "glosses": [
                                            "Nul, minable."
                                        ],
                                        "tags": [],
                                        "examples": [
