                    "sense_id": "6481153b-18a9-3c8a-8c1b-1beb38b0f64d",
                    "sense_definition": "Отправлять кому-либо сообщение или материальный объект.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "отправка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Друзья часто <w>шлют</w> друг другу открытки из путешествий."
                        },
                        {
                            "text": "Нам нужно <w>слать</w> документы по электронной почте."
                        }
                    ],
                    "synonyms": [
