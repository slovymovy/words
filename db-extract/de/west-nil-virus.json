                "senses": [
                    {
                        "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                        "entry_id": "440115a1-ebc6-3232-b55a-54ad3023ac57",
                        "glosses": [
                            "Art eines Krankheitserregers, der bei mit ihm infizierten Menschen oder Tieren das West-Nil-Fieber hervorrufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f82053d-312c-4785-bb8b-47d163549974",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Das West-Nil-Virus (WNV) ist ein behülltes, ikosaedrisches, einsträngiges RNA-Virus des Genus Flavivirus der Familie Flaviviridae.“"
                            },
                            {
                                "example_id": "ed6f7140-becb-4ae9-b3e8-12f17977f5c7",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Das West-Nil-Virus wird durch Mücken übertragen und ruft bei Menschen die Hirnentzündung Enzephalitis hervor.“"
                            },
                            {
                                "example_id": "2b783833-5c47-422c-b97c-3ede32a1651d",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Die als Überträger des für Menschen gefährlichen West-Nil-Virus bekannte Asiatische Buschmücke wurde erstmals im Jahr 2012 in einer größeren Population in Nordrhein-Westfalen und Rheinland-Pfalz nachgewiesen.“"
                            },
                            {
                                "example_id": "bd0dce9a-b28a-4b62-b3f1-4ff3a0ac3370",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Das aus Uganda stammende und vermutlich 1999 in die USA eingeschleppte West-Nil-Virus lässt sich auf dem nordamerikanischen Kontinent offenbar nicht aufhalten.“"
                            },
                            {
                                "example_id": "6edd3eee-593b-47c6-90bf-e81b428ba507",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Das West-Nil-Virus wurde erstmalig 1937 aus einer Frau im West-Nil-Distrikt in Uganda isoliert, die an einer fieberhaften Erkrankung litt.“"
                            },
                            {
                                "example_id": "d1fb5b3c-8b5b-4120-be78-74b2b5b71654",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Das Team um Roy Hall an der Universität von Queensland injizierte Mäusen DNA der harmloseren Kunjin-Viren, die einen ähnlichen genetischen Aufbau wie West-Nil-Viren aufweisen.“"
                            },
                            {
                                "example_id": "4a009ca4-56d2-48c6-a39f-85337f4f36aa",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„»In einem einzigen Mückenbeinchen kann man 100000 West-Nil-Viren finden«, sagt Georg Pauli, Leiter des Zentrums für biologische Sicherheit am Robert Koch-Institut in Berlin.“"
                            },
                            {
                                "example_id": "36a7da99-96cb-4c6d-9170-3967e57b9c12",
                                "sense_id": "33394e43-0940-3973-bf75-e909abc1f406",
                                "text": "„Beim Geflügel besitzt ein Flavivirus als Erreger der Meningo-Enzephalitis der Puten besondere Bedeutung. Auch West-Nil-Viren und das Wesselsbron-Virus kommen gelegentlich vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
