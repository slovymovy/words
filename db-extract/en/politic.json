    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                "word": "politic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f5d26427-82fb-4886-b04b-e25086894047",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more politic"
                    },
                    {
                        "form_id": "86ddd71c-8b04-4845-ac5b-2945e4956964",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most politic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3f9bde5-7408-3760-a444-4e2ae3acd38c",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Of or relating to polity, or civil government; political."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "dfeb603f-3cca-46ee-a472-47ec4505ab2c",
                                "sense_id": "c3f9bde5-7408-3760-a444-4e2ae3acd38c",
                                "text": "the body politic"
                            },
                            {
                                "example_id": "c9fb126d-1ec7-424f-9c45-1e0c5cb02583",
                                "sense_id": "c3f9bde5-7408-3760-a444-4e2ae3acd38c",
                                "text": "[H]e with his people made all but one politic body whereof himself was the head",
                                "translation": "The New Arcadia",
                                "english": "The New Arcadia"
                            }
                        ]
                    },
                    {
                        "sense_id": "491de999-d466-343b-a2bd-3c931b03113e",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Relating to, or promoting, a policy, especially a national policy; well-devised; adapted to its end, whether right or wrong."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "51cc9dd1-b8f0-4483-93c9-04d7d24fcb59",
                                "sense_id": "491de999-d466-343b-a2bd-3c931b03113e",
                                "text": "a politic treaty"
                            },
                            {
                                "example_id": "c9eba140-c603-4501-ae1d-6a8d0fe85f72",
                                "sense_id": "491de999-d466-343b-a2bd-3c931b03113e",
                                "text": "For then this land was famously enrich'd / With politic grave counsel"
                            }
                        ]
                    },
                    {
                        "sense_id": "cb9dd802-be26-37d7-aa27-65164d9eb2e9",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Sagacious in promoting a policy; ingenious in devising and advancing a system of management; devoted to a scheme or system rather than to a principle; hence, in a good sense, wise; prudent; sagacious"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2a383a14-b2dc-4fc3-89f8-f0a0c7a14388",
                                "sense_id": "cb9dd802-be26-37d7-aa27-65164d9eb2e9",
                                "text": "I have been politic with my friend, smooth with mine enemy"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f960c3a-74cc-3ccc-bc63-b0132b12081b",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Shrewd, prudent and expedient; showing policy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257d662c-dda4-47a9-bbe6-49bb814d3640",
                                "sense_id": "5f960c3a-74cc-3ccc-bc63-b0132b12081b",
                                "text": "But as he headed for the front of the line one of his minders whispered that it might be politic to go to the back."
                            },
                            {
                                "example_id": "287fd124-534d-4ed0-ab88-5f08d4274245",
                                "sense_id": "5f960c3a-74cc-3ccc-bc63-b0132b12081b",
                                "text": "But campaigners in Florida accused him of turning a blind eye to the real issues with his \"politic\" appearance before the commission."
                            },
                            {
                                "example_id": "293c05a1-5760-49fa-9a31-86f146ff559c",
                                "sense_id": "5f960c3a-74cc-3ccc-bc63-b0132b12081b",
                                "text": "What a politician likes to do for fun (or judges it politic to pretend he does) is seen as a clue to their personality, or even their politics."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8d483e2-43c1-3a48-bc66-e12980199182",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Discreet and diplomatic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d392b03-d7e9-42ea-82f1-11005ffcb8ef",
                                "sense_id": "d8d483e2-43c1-3a48-bc66-e12980199182",
                                "text": "A unanimous exclamation called upon Evelyn himself to speak; and, after a minute's politic pause, he went on to state his plan."
                            },
                            {
                                "example_id": "f5ff3350-5a75-45cf-9cd6-f04f3a36a0ad",
                                "sense_id": "d8d483e2-43c1-3a48-bc66-e12980199182",
                                "text": "Deferential, glad to be of use, / Politic, cautious, and meticulous; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f343bdb4-b79f-36d4-946d-e40e6f0c91c1",
                        "entry_id": "b2c647fb-c412-352c-9567-a9df22e67c16",
                        "glosses": [
                            "Artful, crafty or cunning."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
