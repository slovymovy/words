                                        "sense_id": "1fbe360a-e026-3d5b-b0f4-bea514153532",
                                        "entry_id": "44f6db27-ace1-3845-b58f-85c929dc0328",
                                        "glosses": [
                                            "Subsequent questioning of a witness after cross-examination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef1927a7-5250-3437-af8c-a3494291a00b",
                                        "entry_id": "44f6db27-ace1-3845-b58f-85c929dc0328",
                                        "glosses": [
