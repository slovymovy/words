                        ],
                        "examples": [
                            {
                                "example_id": "d737e0ff-e17a-4083-afaf-575b86b6159e",
                                "sense_id": "9b63820c-a03d-3f10-8d59-265cc41e9ed9",
                                "text": "Musaron ! réveille-toi, veillaque, ou par le sang précieux de Saint-Jacques, comme disent les Espagnols, tu n'arriveras pas à Coïmbre avec ma valise, soit que tu la perdes en route, soit que les larrons te la volent."
                            },
                            {
                                "example_id": "e2006198-bac4-4dee-bbf6-0549c203e65d",
                                "sense_id": "9b63820c-a03d-3f10-8d59-265cc41e9ed9",
                                "text": "Quant à elle, jamais elle ne souffrirait que sa maîtresse devînt la femme de ce veillaque, de ce visage à nasardes, de cet épouvantail à mettre dans les vignes."
                            }
                        ]
                    }
