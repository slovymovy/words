                        "sense_id": "1650f8eb-3dd6-37ec-a504-ff7018ee9548",
                        "entry_id": "6d31402d-5269-3491-a32e-5c1e962be1c8",
                        "glosses": [
                            "Science qui étudie les climats passés, présents et futurs, leur classification, leur répartition géographique, leurs variations et leurs causes, ainsi que leurs effets sur les milieux naturels et les sociétés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c997e480-86df-45ce-a4cb-11e18f52bf7e",
                                "sense_id": "1650f8eb-3dd6-37ec-a504-ff7018ee9548",
                                "text": "Une préoccupation importante de la climatologie consiste à identifier, à classifier, à décrire et à expliquer les climats actuels ou passés."
                            }
                        ]
                    }
                ],
                "translations": [
