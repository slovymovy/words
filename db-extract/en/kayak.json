                    {
                        "translation_id": "8063f451-0920-401f-9c0c-cd969c0010af",
                        "source_entry_id": "655daa00-9c72-3ecd-9d78-1508f8c824c9",
                        "source_sense_id": "88278991-246e-39a9-a59f-f1256dfcc607",
