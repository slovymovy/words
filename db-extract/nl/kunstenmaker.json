                        "glosses": [
                            "iemand die acrobatische toeren uitvoert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43b7efa-fa71-4f1d-bf06-94f37ac31df0",
                                "sense_id": "a6307f04-065c-3610-9436-1a2ee0e8d1ee",
                                "text": "De oudste van de kunstenmakers veegde zijn voorhoofd met achterover wuivend haar af, lei zijn zakdoek op een honderdponder, bij vierkante gewichten met hengsels, bij slingerkoord, bij rooie en bij koopren ballen, bij een matte stoel en een korfje met eieren."
                            }
                        ]
                    },
