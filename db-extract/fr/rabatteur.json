                                        "entry_id": "cf956fe4-436f-340a-9f3e-5702bda15e8c",
                                        "glosses": [
                                            "iemand die probeert anderen te lokken voor het plegen van onrechtmatige en gewelddadige handelingen"
                                        ],
                                        "tags": [
