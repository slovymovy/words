                ],
                "senses": [
                    {
                        "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                        "entry_id": "df7754a6-c1a6-37c0-959e-758f15cc45a9",
                        "glosses": [
                            "Teil einer Straßenlaterne; der lange, stabile Pfosten, an dessen oberem Ende die Lampe montiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29333052-9cde-40aa-a791-cad7982601b4",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Noch während er der hübschen Frau hinterherpfiff, rannte er gegen den Laternenpfahl und holte sich eine dicke Beule am Kopf."
                            },
                            {
                                "example_id": "055fcc8a-e1d5-4357-808d-af660ce22ef1",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Sie wickelte ihr neues Auto gleich am ersten Tag um einen Laternenpfahl."
                            },
                            {
                                "example_id": "dd44644b-64dc-4acd-bae0-228f4369d7ca",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Der Hund hinterließ am Laternenpfahl seine Duftmarke."
                            },
                            {
                                "example_id": "c5bd3dbd-c091-4dcb-bd66-0a69a504cbe4",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Dass sie den Katalog des Reisebüros auf dem Tisch hat liegen lassen, ist wohl ein Wink mit dem Laternenpfahl."
                            },
                            {
                                "example_id": "96aa688d-fc08-485e-9196-15651d28afdf",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Du musst Urlaub machen, dich erholen und essen - du kannst dich ja hinter einem Laternenpfahl ausziehen."
                            },
                            {
                                "example_id": "beab45ec-af8b-4101-a8a3-e228037e68ea",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Kind, nun iss mal richtig, du kannst dich ja hinter einem Laternenpfahl verstecken."
                            },
                            {
                                "example_id": "7e585f81-f06a-42f2-971e-a300fc817196",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Er hatte ordentlich getankt an diesem Abend und musste sich doch auf dem Weg nach Hause am Laternenpfahl festhalten."
                            },
                            {
                                "example_id": "0ec67f5b-6c1d-438a-87b1-23449d29f4e0",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "Dieses Ungeheuer sollten sie am nächsten Laternenpfahl aufknüpfen."
                            },
                            {
                                "example_id": "ce6b46d7-0cb0-448b-b97f-d6f4c78e6c2b",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "„Ein verbogener Laternenpfahl trug das Schild.“"
                            },
                            {
                                "example_id": "ccf96798-7512-44aa-a79f-ff74678e3d7f",
                                "sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                                "text": "„An den Laternenpfählen hingen Kugeln orangefarbenen Lichts“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ed592af-ce88-4cb1-867d-492f14274c12",
                        "source_entry_id": "df7754a6-c1a6-37c0-959e-758f15cc45a9",
                        "source_sense_id": "67872bdd-d0a1-343b-8218-3b022d9637ea",
                        "source_sense_description": "Teil einer Straßenlaterne; der lange, stabile Pfosten, an dessen oberem Ende die Lampe montiert ist",
                        "target_lang_word": "lamppost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamppost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                        "entry_id": "4936345e-9ca9-3aff-ae95-878c70c6350c",
                                        "glosses": [
                                            "The pole that holds up a light so it can illuminate a wide area, such as holds up a streetlight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f65421b-75e1-41f2-9e43-a1ae03d486f5",
                                                "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                                "text": "Visit the Jurassic Coast World Heritage Site in the UK, and ammonite road signs greet you at every town and city and even the lampposts on the seafront feature a familiar coiled shell."
                                            },
                                            {
                                                "example_id": "960f87f9-9f95-46e0-a14f-7358fb67c88a",
                                                "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                                "text": "\"What is really good is they haven't just painted the station building, they've done all the lampposts to match as well, right down to the end of the platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d28152-7744-37cb-8984-96b301013371",
                                        "entry_id": "4936345e-9ca9-3aff-ae95-878c70c6350c",
                                        "glosses": [
                                            "A tall, thin person."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4c2dab-8b19-4647-8b88-a3cbd1196fb8",
                                                "sense_id": "f9d28152-7744-37cb-8984-96b301013371",
                                                "text": "You big skinny lamppost. And you're going grey!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
