                "senses": [
                    {
                        "sense_id": "512bea01-263a-33d4-aed5-2293ddce754c",
                        "entry_id": "bfee2729-9ee4-3474-ad4c-743c1f5892d8",
                        "glosses": [
                            "Brancher, connecter (un appareil électrique)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2d87a551-f68c-41da-a9fd-79d890bef9d8",
                                "sense_id": "512bea01-263a-33d4-aed5-2293ddce754c",
                                "text": "J'aurais besoin de quelques informations pour « ploguer » mon terratrip 303 plus."
                            },
                            {
                                "example_id": "85d0cc0f-783a-471b-9805-9427bd029256",
                                "sense_id": "512bea01-263a-33d4-aed5-2293ddce754c",
                                "text": "bonjour je voudrais ploguer mon ordinateur sur ma télé"
                            }
                        ]
                    },
                    {
                        "sense_id": "9745dce6-0e16-3361-a0f3-37f16750a7a6",
                        "entry_id": "bfee2729-9ee4-3474-ad4c-743c1f5892d8",
                        "glosses": [
                            "Placer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "be6343e0-b55f-4798-a619-7da6d547134e",
                                "sense_id": "9745dce6-0e16-3361-a0f3-37f16750a7a6",
                                "text": "Je cherchais à ploguer ce détail dans un de mes textes depuis le début de la semaine et je n'y arrivais pas."
                            },
                            {
                                "example_id": "0fb4f34e-81e5-4e28-8205-70058bcacfe5",
                                "sense_id": "9745dce6-0e16-3361-a0f3-37f16750a7a6",
                                "text": "Votre livre touche un sujet fort complexe, c’est très dense, et on ne croit pas que seulement sept minutes pour le ploguer soit suffisant."
                            },
                            {
                                "example_id": "6b9d0d44-f727-44dc-9119-3ef51d2ca9ac",
                                "sense_id": "9745dce6-0e16-3361-a0f3-37f16750a7a6",
                                "text": "Revue 2010: les mots qu'il fallait ploguer dans une conférence techno"
                            }
                        ]
                    },
                    {
                        "sense_id": "2881675f-fcd4-3cf8-8199-050b24859016",
                        "entry_id": "bfee2729-9ee4-3474-ad4c-743c1f5892d8",
                        "glosses": [
                            "Faire valoir un produit commercial (souvent culturel) en profitant d'une tribune qui n'est normalement pas de nature publicitaire."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5c821e5e-0d4c-4812-a119-158aa524a3eb",
                                "sense_id": "2881675f-fcd4-3cf8-8199-050b24859016",
                                "text": "L’empire Quebecor plogue les animateurs-vedettes du réseau TVA (empire Quebecor) dans tous les journaux et dans tous les magazines appartenant à l’empire Quebecor."
                            }
                        ]
                    }
