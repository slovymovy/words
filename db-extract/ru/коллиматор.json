                "senses": [
                    {
                        "sense_id": "591c06b3-cd6e-331a-bb40-3cf5e9cfd5d8",
                        "entry_id": "3ad08eb1-caf6-3d08-ad5d-66f36ea4e53e",
                        "glosses": [
                            "спец. устройство для получения пучков параллельных лучей или частиц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4dc2ba-57a9-463e-ad4e-0dda7fbfa3cc",
                                "sense_id": "591c06b3-cd6e-331a-bb40-3cf5e9cfd5d8",
                                "text": "Коллиматор для линейных источников жесткого рентгеновского излучения на основе многослойных рентгеновских зеркал."
                            },
                            {
                                "example_id": "7d068532-24e3-4391-9a9d-8045c9e6863f",
                                "sense_id": "591c06b3-cd6e-331a-bb40-3cf5e9cfd5d8",
                                "text": "Многолистовой коллиматор."
                            },
                            {
                                "example_id": "018b16bf-8e15-431c-b4bf-9ca3b26efae9",
                                "sense_id": "591c06b3-cd6e-331a-bb40-3cf5e9cfd5d8",
                                "text": "Нейтронный коллиматор."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc383121-45ff-3642-a817-0b1e970554ae",
                        "entry_id": "3ad08eb1-caf6-3d08-ad5d-66f36ea4e53e",
                        "glosses": [
                            "воен. оптическое устройство, используемое для визирования и наводки артиллерийского орудия по цели при стрельбе прямой наводкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5d2cf1-3145-444a-a46a-d72d317f1a15",
                                "sense_id": "dc383121-45ff-3642-a817-0b1e970554ae",
                                "text": "При разворотах прицела и коллиматора прицельный знак и коллимационная точка также смещаются относительно друг друга."
                            }
                        ]
                    }
