{
    "word_family": [
        "réjoui",
        "réjouissance",
        "réjouissant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f76ab87-aecd-3300-8fbb-4bbe223bb762",
                    "sense_definition": "Attendre un événement futur avec bonheur et impatience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "joie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>réjouis</w> de passer tout le week-end avec mes amis à la campagne."
                        },
                        {
                            "text": "Toute la classe se <w>réjouit</w> d'avance à l'idée de ce voyage scolaire."
                        }
                    ],
                    "common_phrases": [
                        "se réjouir d'avance"
                    ]
                },
                {
                    "sense_id": "8e319cf8-9592-34fe-b456-d4a0a9cfcc94",
                    "sense_definition": "Rendre joyeux, procurer un sentiment de vive joie ou de plaisir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "joie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette merveilleuse nouvelle est venue <w>réjouir</w> toute la famille réunie pour le dîner."
                        },
                        {
                            "text": "Le retour du soleil printanier <w>réjouit</w> le cœur des habitants après un hiver rigoureux."
                        }
                    ],
                    "synonyms": [
                        "égayer",
                        "enchanter"
                    ],
                    "antonyms": [
                        "attrister"
                    ],
                    "common_phrases": [
                        "réjouir le cœur"
                    ]
                },
                {
                    "sense_id": "63a4dd24-e1b4-31eb-b30e-6753f3c9341f",
                    "sense_definition": "Éprouver une vive satisfaction face à une situation ou un résultat heureux, s'en féliciter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "joie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction se <w>réjouit</w> du succès remarquable obtenu par la nouvelle campagne publicitaire."
                        },
                        {
                            "text": "Nous pouvons nous <w>réjouir</w> que tous les randonneurs soient arrivés sains et saufs."
                        }
                    ],
                    "synonyms": [
                        "se féliciter"
                    ],
                    "common_phrases": [
                        "se réjouir du succès"
                    ]
                },
                {
                    "sense_id": "448c92bb-f014-30f2-92fb-6846ee261e7e",
                    "sense_definition": "Passer un moment agréable et festif en compagnie d'autres personnes, faire la fête.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fête",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois se sont rassemblés sur la place pour se <w>réjouir</w> ensemble jusqu'à l'aube."
                        },
                        {
                            "text": "Après une longue semaine de travail, ils aiment se <w>réjouir</w> autour d'un grand festin."
                        }
                    ],
                    "synonyms": [
                        "s'amuser",
                        "se divertir"
                    ]
                }
            ]
        }
    ]
}