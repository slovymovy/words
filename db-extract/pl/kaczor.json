                        "entry_id": "9fbe76b3-24a6-35e5-ac8d-21dd4a30fbbb",
                        "glosses": [
                            "samiec kaczki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57afa4a0-1cb9-47ed-bbae-177a279d5b64",
                                "sense_id": "41a94b0e-5375-3514-a373-a5e2bcd976ff",
                                "text": "Kaczor podpłynął i wyłowił z wody kawałki chleba, które mu rzuciłem."
                            },
                            {
                                "example_id": "770f26fc-f12f-45fd-a6c1-f1837b449aab",
                                "sense_id": "41a94b0e-5375-3514-a373-a5e2bcd976ff",
                                "text": "Samiec, zwany kaczorem, w szacie godowej ma zielono opalizującą głowę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
