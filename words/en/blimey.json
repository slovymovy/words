            "senses": [
                {
                    "sense_id": "fe6bc438-eea7-37ef-902d-eb83f5c1e454",
                    "sense_definition": "Used to express surprise, excitement, or shock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation of surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Blimey</w>! I didn’t see you standing there in the dark.",
                            "target_lang_translations": {
                                "ru": "<w>Вот это да</w>! Я и не заметил, что ты стоишь здесь в темноте.",
                                "nl": "<w>Jeetje</w>! Ik had niet gezien dat je daar in het donker stond.",
                                "pl": "<w>O rany</w>! Nie zauważyłem, że stoisz tam w ciemności.",
                                "de": "<w>Meine Güte</w>! Ich habe dich da im Dunkeln gar nicht stehen sehen.",
                                "fr": "<w>Mince</w> ! Je ne t'avais pas vu là dans le noir.",
                                "it": "<w>Urca</w>! Non ti avevo visto lì in piedi al buio.",
                                "cs": "<w>Teda</w>! Neviděl jsem tě tam ve tmě stát.",
                                "tr": "<w>Vay be</w>! Karanlıkta orada durduğunu görmemişim.",
                                "es": "¡<w>Caramba</w>! No te había visto ahí parado en la oscuridad.",
                                "zh": "<w>天哪</w>！我没看见你站在那儿，黑灯瞎火的。"
                            }
                        },
                        {
                            "text": "Well <w>blimey</w>, I never expected to see you in this part of town!",
                            "target_lang_translations": {
                                "ru": "Ну и <w>ничего себе</w>, никак не ожидал встретить тебя в этой части города!",
                                "nl": "Nou <w>amai</w>, ik had nooit verwacht jou in dit deel van de stad tegen te komen!",
                                "pl": "No <w>ładne klocki</w>, nigdy bym się nie spodziewał, że zobaczę cię w tej części miasta!",
                                "de": "Na, <w>Mensch</w>, ich hätte nie erwartet, dich in dieser Gegend der Stadt zu treffen!",
                                "fr": "Eh bien <w>ça alors</w>, je ne m'attendais pas du tout à te voir dans ce quartier !",
                                "it": "Beh, <w>perbacco</w>, non mi sarei mai aspettato di vederti in questa zona della città!",
                                "cs": "No <w>páni</w>, vůbec jsem nečekal, že tě potkám v téhle části města!",
                                "tr": "Bak sen <w>şu işe</w>, seni şehrin bu tarafında göreceğimi hiç ummazdım!",
                                "es": "¡Vaya, <w>caray</w>! ¡Nunca esperé verte por esta parte de la ciudad!",
                                "zh": "哎呀<w>我的天</w>，我真没想到会在城里这一带见到你！"
                            }
                        }
                    ],
                    "synonyms": [
                        "cor blimey",
                        "crikey",
                        "wow",
                        "my word",
                        "good heavens"
                    ],
                    "common_phrases": [
                        "well blimey"
