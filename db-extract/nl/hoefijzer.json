                ],
                "senses": [
                    {
                        "sense_id": "b2977d61-356a-3054-a707-faa2eadec2ee",
                        "entry_id": "7011fe13-a81e-3350-ae23-d7e19240dd20",
                        "glosses": [
                            "gebogen ijzeren reep, in de vorm van de hoef, waarmee een paard door de hoefsmid beslagen wordt om het afslijten van de hoeven tegen te gaan"
                        ],
                        "tags": [
                            "paardrijden"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd11bed-7a97-4a27-ac37-c7b62604b5a4",
                                "sense_id": "b2977d61-356a-3054-a707-faa2eadec2ee",
                                "text": "Voor Genie had ik een ouderwetse, kanten blouse gekocht, recht uit Little house on the prairie. En voor Goldie een ijzeren hoefijzer, omdat hij een glans van geluk over zich had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56dc2bb-c1f0-4453-a48e-a6dabf5fd2b9",
                        "source_entry_id": "7011fe13-a81e-3350-ae23-d7e19240dd20",
                        "source_sense_id": "b2977d61-356a-3054-a707-faa2eadec2ee",
                        "target_lang_word": "Hufeisen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hufeisen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                        "entry_id": "865351d0-110b-3e3d-a51d-07dbfb8b7318",
                                        "glosses": [
                                            "in U-Form gebogenes Eisen, das zum Schutz auf die Hufe von Pferden aufgenagelt wird und als Glücksbringer gilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8834f3-be2c-420a-ab4f-5d19abafec05",
                                                "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                                "text": "Bekommt dein Pferd bald wieder neue Hufeisen?"
                                            },
                                            {
                                                "example_id": "83aba32d-2976-488e-a6e8-62287a84f69e",
                                                "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                                "text": "„Über dem Hofe steht eine alte Eiche, an die Dutzende von zum Teil ganz altmodischen Hufeisen genagelt sind, von denen viele schon sehr tief eingewachsen sind.“"
                                            },
                                            {
                                                "example_id": "49e62f97-8f94-446f-a553-5119a95ab5f1",
                                                "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                                "text": "„Er nahm meine Ermahnungen nicht zur Kenntnis, und als ich abstieg, um mit meiner Laterne nachzuschauen, ob irgendetwas im Weg lag, sah ich, dass er ein Hufeisen verloren hatte und dass sein Fuß blutete.“"
                                            },
                                            {
                                                "example_id": "203dadbe-49c4-4d19-99c4-0deb9427a8dc",
                                                "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                                "text": "„Der Mittelweg hatte die Form eines länglichen Hufeisens.“"
                                            },
                                            {
                                                "example_id": "97fe3b17-ea1c-4d69-9f65-d1d6b6c00b31",
                                                "sense_id": "d1fea249-8fbf-314c-926a-7677f66deb17",
                                                "text": "„Dagegen reitet ein Mann auf einem Pferd mit Hufeisen auf ihn zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39500c8c-8b6d-401b-b0a3-bf8e3f51bcb6",
                        "source_entry_id": "7011fe13-a81e-3350-ae23-d7e19240dd20",
                        "source_sense_id": "b2977d61-356a-3054-a707-faa2eadec2ee",
                        "target_lang_word": "horseshoe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horseshoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c07f9f-8fce-3d03-a3a1-bb401323dae1",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "The U-shaped shoe of a horse, now typically made of metal; by extension, a representation of this used to play the game horseshoes, hung as a luck charm, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5f6f7e-0000-4063-ace5-690ee8848ea2",
                                                "sense_id": "d7c07f9f-8fce-3d03-a3a1-bb401323dae1",
                                                "text": "And what has been thus affirmed of other leading commodities; the blacksmith, for example, no longer making, but buying his horseshoes, nails, nuts, and bolts;"
                                            },
                                            {
                                                "example_id": "d7dcf475-3598-4f30-83dc-ec2c394b1e7e",
                                                "sense_id": "d7c07f9f-8fce-3d03-a3a1-bb401323dae1",
                                                "text": "The ancient Romans [...] used leather horseshoes; the Chinese made straw sandals for their mounts; and American Indians used leather moccasins, which they tied around their horses ' ankles. In days of old, people took their horses to the smithy to be shod."
                                            },
                                            {
                                                "example_id": "dd561393-66c9-45ca-8388-8b39f7186b52",
                                                "sense_id": "d7c07f9f-8fce-3d03-a3a1-bb401323dae1",
                                                "text": "Each player has a turn at tossing his horseshoes, one at a time, at the stob opposite him. His opponent then throws his horseshoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603e51b7-48a8-346d-9421-fda6918ec417",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "The U shape of a horseshoe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901434c5-82f4-4abf-9601-15cb4b85d30a",
                                                "sense_id": "603e51b7-48a8-346d-9421-fda6918ec417",
                                                "text": "If there are no missing teeth and tooth alignment is good, two opposing well-defined horseshoes are seen. If, however, your denitition is mal-aligned or is missing anterior teeth, this pattern too should be reflected in the bite mark."
                                            },
                                            {
                                                "example_id": "8e66ee31-2878-4f3f-bba0-18424f929393",
                                                "sense_id": "603e51b7-48a8-346d-9421-fda6918ec417",
                                                "text": "Whereas the railway heads inland to take the easier but much longer horseshoe-shaped route around the firth, the A9 directly crosses it from north to south on a bridge built in 1991."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8579392-62b0-3d8c-9660-1741b48ab72c",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "A well-developed set of triceps brachii muscles."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c7cf6a6-a645-47f2-b77c-3859cca08753",
                                                "sense_id": "c8579392-62b0-3d8c-9660-1741b48ab72c",
                                                "text": "The lateral head of your triceps forms the outside of the horseshoe, the long head forms the inside, the medial head lies beneath the long head, and the tendon occupies the flat space in the middle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06799979-1fc0-3706-9a4e-20b455a90183",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "The symbol ⊃."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "125024f5-d223-3254-93a2-9710db57aa11",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "An open-faced sandwich originating from Springfield, Illinois, consisting of thick-sliced toasted bread, often Texas toast, a hamburger patty, French fries, and a cheese sauce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0b1dd56-b310-355a-8ecd-22168552c5fc",
                                        "entry_id": "a4edb216-17aa-35a3-b05d-6da010fe4ff2",
                                        "glosses": [
                                            "A U-shaped life buoy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "horseshoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "063406a0-e3a1-3435-b385-e6ce454d4a3a",
