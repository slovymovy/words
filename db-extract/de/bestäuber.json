                "senses": [
                    {
                        "sense_id": "06111aee-2108-303f-9530-574985b115ee",
                        "entry_id": "8606dee1-57a2-3587-97af-cf44eed651fc",
                        "glosses": [
                            "Tier, das die Blüten einer Pflanze befruchtet, bestäubt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2945cafc-a5a6-4716-8008-0cce5121412a",
                                "sense_id": "06111aee-2108-303f-9530-574985b115ee",
                                "text": "„Bestäuber verbreiten die Pollen der Pflanzen und helfen ihnen so bei der Fortpflanzung und somit der Vermehrung.“"
                            },
                            {
                                "example_id": "a5e4d38f-ea80-4a30-a16c-1e049e219cd9",
                                "sense_id": "06111aee-2108-303f-9530-574985b115ee",
                                "text": "„Bestäuber tragen wesentlich zu unserer Ernährungssicherheit und zur Agrarwirtschaft bei.“"
                            },
                            {
                                "example_id": "b94d17cf-060e-42b7-b3d6-f0d0310c8ac7",
                                "sense_id": "06111aee-2108-303f-9530-574985b115ee",
                                "text": "„Blütenpflanzen wollen nicht uns gefallen, sondern in erster Linie den Tieren, die ihnen einen Vorteil bringen – den Bestäubern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
