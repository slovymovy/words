                        "examples": [
                            {
                                "example_id": "9986fe6a-d138-4fbc-85a4-379e3ad4f6ac",
                                "sense_id": "a5f2292b-8fcd-3e21-8017-7585e65f07d4",
                                "text": "„Am 11. September 1858 lief im Rahmen großer Festlichkeiten … der erste Zug ein. … An diesem Festtag nahm auch Prinzessins Augusta mit ihrem Onkel, Herzog Bernhard von Sachsen, teil. Sie bestieg im provisorischen Bahnhof am Ende der Weißergasse den Fürstenwagen und fuhr bis Weißenthurm mit. Die Ehrengäste fuhren mit dem Sonderzug bis Rolandseck, wo die Hauptfeier stattfand […].“"
                            }
