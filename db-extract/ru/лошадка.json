                "senses": [
                    {
                        "sense_id": "bf230525-7c5e-3c7a-be03-af3ece176e6a",
                        "entry_id": "b5e73783-d4ef-35e1-afc4-5a37b173d791",
                        "glosses": [
                            "уменьш. от лошадь (животное или игрушка)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3150abf6-8b56-4f18-9312-183c1036673d",
                                "sense_id": "bf230525-7c5e-3c7a-be03-af3ece176e6a",
                                "text": "Нестроевики, брошенные на конюшню, не справлялись с работой, поили лошадей из ручья раз в день, а со временем перевели лошадок на самообслуживание ― выгоняли их в чистое поле."
                            }
                        ]
                    },
                    {
                        "sense_id": "e930fe6c-6ca8-3151-8504-bb3381b09233",
                        "entry_id": "b5e73783-d4ef-35e1-afc4-5a37b173d791",
                        "glosses": [
                            "разг. человек, обладающий какими-либо качествами, указанными в определении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6cf425-a99a-4f69-b969-8c646fb8d1ba",
                                "sense_id": "e930fe6c-6ca8-3151-8504-bb3381b09233",
                                "text": "Тёмная лошадка."
                            },
                            {
                                "example_id": "8d6635fb-a666-4e98-a414-746efaf6a897",
                                "sense_id": "e930fe6c-6ca8-3151-8504-bb3381b09233",
                                "text": "Рабочая лошадка."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ed79623-dea1-348c-a568-1790c2d5cd06",
                        "entry_id": "b5e73783-d4ef-35e1-afc4-5a37b173d791",
                        "glosses": [
                            "комп. жарг. то же, что троянский конь; вредоносная программа, маскирующаяся под безобидную"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d883930-083a-4d82-bf30-b49e6561aaea",
                                "sense_id": "6ed79623-dea1-348c-a568-1790c2d5cd06",
                                "text": "Зашёл на порносайт, подхватил лошадку."
                            }
                        ]
                    }
