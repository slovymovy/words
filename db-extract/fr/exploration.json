        "fr-extract.jsonl": [
            {
                "entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                "word": "exploration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "26685496-9bec-4ae3-84ec-6e2bb9f35b5c",
                        "entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "explorations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8d7599b-ddad-3079-b386-533b285acd5a",
                        "entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                        "glosses": [
                            "Action d’explorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "177138a9-7c55-40fa-b7d8-dc3660749d4a",
                                "sense_id": "d8d7599b-ddad-3079-b386-533b285acd5a",
                                "text": "A Balboa fit escale le navire hydrographique américain Arcturus, qui revenait d'une exploration aux îles Galapagos."
                            },
                            {
                                "example_id": "e313e9af-e079-43bf-9f06-6a77556fb59c",
                                "sense_id": "d8d7599b-ddad-3079-b386-533b285acd5a",
                                "text": "Mais dans les univers courbés du second système einsteinien, des boucles temporelles pourraient autoriser une certaine exploration du passé, sans condition de vitesse, le principe de causalité étant dans ce cas invalidé."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3b808fa-64c6-3389-b724-c6bdb3927f1c",
                        "entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                        "glosses": [
                            "Examen des parties intérieures du corps, malades ou suspectes, à l’aide d’instruments ou de procédés spéciaux."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "589cb8b2-1f80-4322-a023-c58c6e748eb6",
                        "source_entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                        "target_lang_word": "Erforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                        "entry_id": "e913a381-89a5-3441-90da-4f9aa52e513e",
                                        "glosses": [
                                            "das Forschen in einer bestimmten Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6e65e0-70ed-4739-bc09-bc20801c5c3e",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "\"Ein neueres Feld, das auch immer mehr Beachtung findet, ist die Erforschung der Psyche älterer Menschen.\""
                                            },
                                            {
                                                "example_id": "2c2bcecd-2447-48c8-a21c-abd62df74274",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "„Die Archäologen arbeiteten bei der Erforschung und Interpretation der Funde mit zahlreichen Kollegen aus Nachbardisziplinen zusammen.“"
                                            },
                                            {
                                                "example_id": "f4a01e3c-3ef0-4c05-a1ec-6090b8d307a1",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "„In der wissenschaftlichen Erforschung dieser Zeit fehlte die afrikanische Sichtweise jahrzehntelang weitgehend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                        "entry_id": "e913a381-89a5-3441-90da-4f9aa52e513e",
                                        "glosses": [
                                            "das Erkunden eines Ortes oder Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afde52f6-11af-4c95-bd0e-b25ba7edadca",
                                                "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                                "text": "\"Die russischen Unternehmen werden sich zunächst an der Erforschung der Ölvorkommen im Orinoko-Becken beteiligen.\""
                                            },
                                            {
                                                "example_id": "9b72c0d5-99fc-49c0-96c7-cbf160b5cc1a",
                                                "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                                "text": "\"Der Gletscher Perito Moreno, 2800 Kilometer südlich der Hauptstadt Buenos Aires, dehnt sich auf 275 Quadratkilometern aus - sein Name erinnert an einen der Pioniere bei der Erforschung Patagoniens.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cee2fe1-b91e-44bc-b148-89b7944cc5c9",
                        "source_entry_id": "dc66e3e0-b94a-3d80-842d-b1abef3cc0f1",
                        "target_lang_word": "exploration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exploration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72d191a4-c3ca-3fed-b87b-3a86deba1e87",
                                        "entry_id": "9abfa31a-19c9-3049-9432-a588466e3ac6",
                                        "glosses": [
                                            "The process of exploring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "509ee36c-f44c-47fe-996d-4cec7ffe173c",
                                                "sense_id": "72d191a4-c3ca-3fed-b87b-3a86deba1e87",
                                                "text": "By this time, largely inspired by The Railway Magazine, I had begun to spread my wings, and had started on a long career of railway exploration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad337cc-683b-3d3a-9a29-a57a576a29cc",
                                        "entry_id": "9abfa31a-19c9-3049-9432-a588466e3ac6",
                                        "glosses": [
                                            "The process of penetrating, or ranging over for purposes of (especially geographical) discovery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc99769-e7cd-4ea4-96ff-ac94fcb24997",
                                                "sense_id": "1ad337cc-683b-3d3a-9a29-a57a576a29cc",
                                                "text": "The exploration of unknown areas was often the precursor to colonization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeedb53c-f49d-3394-ad6e-0245740cc37c",
                                        "entry_id": "9abfa31a-19c9-3049-9432-a588466e3ac6",
                                        "glosses": [
                                            "The (pre-)mining process of finding and determining commercially viable ore deposits (after prospecting), also called mineral exploration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
