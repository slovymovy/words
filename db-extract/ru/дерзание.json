                ],
                "senses": [
                    {
                        "sense_id": "c146cd88-a08a-369d-bfa4-512863b5a0b9",
                        "entry_id": "56ac38d2-aab3-3495-ace5-aa7e2f86ffd2",
                        "glosses": [
                            "действие по значению гл. дерзать; проявление дерзновения, т. е. смелого, решительного, дерзкого устремления к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b32bde-5f50-4a73-9aa4-3ac5356bcf2c",
                                "sense_id": "c146cd88-a08a-369d-bfa4-512863b5a0b9",
                                "text": "Огромное дерзание; новые большие проблемы поставлены: но что будет при исполнении?"
                            },
                            {
                                "example_id": "054389a1-5904-44f6-9a0c-2aaf1dbc3dab",
                                "sense_id": "c146cd88-a08a-369d-bfa4-512863b5a0b9",
                                "text": "Самые отважные дерзания Рембо ― ребяческий лепет по сравнению с тем, что делает Хлебников, взрывая тысячелетние языковые напластования и бесстрашно погружаясь в артикуляционные бездны первозданного слова."
                            },
                            {
                                "example_id": "252988a0-a789-467c-84e1-294fe3ff1174",
                                "sense_id": "c146cd88-a08a-369d-bfa4-512863b5a0b9",
                                "text": "У Штирнера мы находим бесконечно большую смелость мысли и силу дерзания, он несравненно глубже и последовательнее Прудона, он истинный и бесстрашный анархист."
                            },
                            {
                                "example_id": "d2726574-f758-46d3-8234-56bca00001f8",
                                "sense_id": "c146cd88-a08a-369d-bfa4-512863b5a0b9",
                                "text": "Сызмальства почти, от молодых ногтей, любимым словом моим было «дерзание»."
                            }
                        ]
                    }
                ],
