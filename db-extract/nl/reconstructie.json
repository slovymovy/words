                ],
                "senses": [
                    {
                        "sense_id": "92c7667a-1a12-3ee8-8b98-eb3203a0c373",
                        "entry_id": "ad404df0-f23d-307c-96d0-82f74e4a7b7f",
                        "glosses": [
                            "herstel in de oorspronkelijke gedaante (tevens resultaat van deze samenvoeging), wederopbouw"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10903329-32f2-323a-87f1-d9afbdbec26a",
                        "entry_id": "ad404df0-f23d-307c-96d0-82f74e4a7b7f",
                        "glosses": [
                            "voorstelling waardoor men feiten of handelingen uit het verleden weer tot leven tracht te wekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34c1015-c28c-42f5-9768-8bfc952183d6",
                                "sense_id": "10903329-32f2-323a-87f1-d9afbdbec26a",
                                "text": "Zoals de vervulling van mijn opdracht was begonnen met mijn aankomst in Grand Hotel Europa, zo zou ik mijn reconstructie beginnen bij mijn aankomst in Venetië. Ik zag de zinkende stad voor me, voelde het verleden deinen en viel in een diepe slaap."
                            },
                            {
                                "example_id": "25b88a4e-c6a9-4014-bb07-8a211fc932c8",
                                "sense_id": "10903329-32f2-323a-87f1-d9afbdbec26a",
                                "text": "Maar wat antwoordde mama op de vraag over Stalin? Nu, vijftien jaar later, wordt de herinnering, de hoogst onbetrouwbare herinnering, aangevuld met veronderstellingen, een soort reconstructie van wat mama geantwoord moest hebben omdat ze was wie ze was, net als wij allemaal in de familie Lauritzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e677024-fd42-349c-925f-9c2993fc6028",
                        "entry_id": "ad404df0-f23d-307c-96d0-82f74e4a7b7f",
                        "glosses": [
                            "reorganisatie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a277987-0c99-4ab4-b9d2-0ff8bf1c99cb",
                        "source_entry_id": "ad404df0-f23d-307c-96d0-82f74e4a7b7f",
                        "target_lang_word": "reconstruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconstruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3be25d5d-8d3e-3688-908c-6c1be7cf7d72",
                                        "entry_id": "52aead3d-ced3-33ac-8067-a65802b8b403",
                                        "glosses": [
                                            "A thing that has been reconstructed or restored to an earlier state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d305de1c-b1ac-4fd6-8bf4-2e10e8383034",
                                                "sense_id": "3be25d5d-8d3e-3688-908c-6c1be7cf7d72",
                                                "text": "Sunderland station has undergone several reconstructions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca5c547-da26-3594-bd2a-809bea15d2bf",
                                        "entry_id": "52aead3d-ced3-33ac-8067-a65802b8b403",
                                        "glosses": [
                                            "The act of restoring something to an earlier state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54362fdd-a210-458c-a6be-b5a926f8430c",
                                                "sense_id": "dca5c547-da26-3594-bd2a-809bea15d2bf",
                                                "text": "The reconstruction of the medieval bridge began last year."
                                            },
                                            {
                                                "example_id": "627edf6b-6be4-43a8-9ff3-7fb1e56f8e6a",
                                                "sense_id": "dca5c547-da26-3594-bd2a-809bea15d2bf",
                                                "text": "By a remarkable piece of railway reconstruction work on the part of the Allied Forces—mainly South African railway construction troops—mines laid along the track by the retreating enemy were removed by sappers, and the German damage made good, within 7 days."
                                            },
                                            {
                                                "example_id": "bb907842-dabb-412a-97f9-c182a48c0da0",
                                                "sense_id": "dca5c547-da26-3594-bd2a-809bea15d2bf",
                                                "text": "A striking example comes to mind, in which a scheme to improve the existing buildings finished up as virtually a complete reconstruction, owing to the unsound condition of the original structure!"
                                            },
                                            {
                                                "example_id": "944c090b-3d73-4482-acd5-3c8708e1699b",
                                                "sense_id": "dca5c547-da26-3594-bd2a-809bea15d2bf",
                                                "text": "“The decision of the cassation court establishes that the Roman salute is not a crime unless there is a concrete danger of the reconstruction of the fascist party, as provided by Article 5 of the Scelba law, or there are concrete aims of racial discrimination and violence, as provided by the Mancino law,” a lawyer for two of the defendants Domenico Di Tullio told CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47260ea-3405-3e79-986a-5c58c35a7b2f",
                                        "entry_id": "52aead3d-ced3-33ac-8067-a65802b8b403",
                                        "glosses": [
                                            "The recreation or retelling of the (purported) events leading up to a certain outcome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1bbe697-1cd0-42dc-9e7e-fe4a5ef5deb9",
                                                "sense_id": "c47260ea-3405-3e79-986a-5c58c35a7b2f",
                                                "text": "The detective's reconstruction of what happened that night is dubious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23df1f3d-9d8c-3faf-bb89-95c3c1488a0a",
                                        "entry_id": "52aead3d-ced3-33ac-8067-a65802b8b403",
                                        "glosses": [
                                            "A result of linguistic reconstruction; a model representing an unattested linguistic unit: a phoneme, a morpheme or a word."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a221158-5680-4230-9f1c-7d298888c437",
                                                "sense_id": "23df1f3d-9d8c-3faf-bb89-95c3c1488a0a",
                                                "text": "It should also be noted that while Dempwolff reconstructed at only one level (Uraustronesisch), many of his reconstructions are confined to languages of western Indonesia"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87974737-fd92-4f24-aa95-59e260f1e678",
                        "source_entry_id": "ad404df0-f23d-307c-96d0-82f74e4a7b7f",
                        "target_lang_word": "reconstruction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconstruction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb0af46-4157-3474-98c8-50d946d499d3",
                                        "entry_id": "ccbbcd39-aa22-32ad-9ae0-ac59504e8d7c",
                                        "glosses": [
                                            "Action de reconstruire un bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1d54eb-a578-4edd-bc63-f24ff31e583a",
                                                "sense_id": "4cb0af46-4157-3474-98c8-50d946d499d3",
                                                "text": "Les habitants de Bessancourt demandent qu'ils ne soient plus chargés de payer la reconstruction et les grosses réparations de l'église, du presbytère, du vicariat et des maisons du maître et de la maîtresse d'école, […]."
                                            },
                                            {
                                                "example_id": "018279a2-5b93-47cc-bd6b-64a15e94dc97",
                                                "sense_id": "4cb0af46-4157-3474-98c8-50d946d499d3",
                                                "text": "[En 1194,] l'ensemble de la population de Chartres s'est mobilisé pour financer la reconstruction de la cathédrale, ravagée par un incendie."
                                            },
                                            {
                                                "example_id": "e2c16b87-8821-4856-97c3-7e70562ab402",
                                                "sense_id": "4cb0af46-4157-3474-98c8-50d946d499d3",
                                                "text": "Comme nous l’annoncions le 16 juillet 2021, la fin de la reconstruction de l’hôpital psychiatrique de Bohars est prévue en 2028."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                                        "entry_id": "ccbbcd39-aa22-32ad-9ae0-ac59504e8d7c",
                                        "glosses": [
                                            "Action de reconstituer un tissu social, un lien de confiance, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21d23fd8-ca62-41eb-aa20-7fe580ae2cda",
                                                "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                                                "text": "Des gestes réels de reconstruction sont requis pour sortir de cette crise, mais ils sont nécessaires à partir de la base jusqu'au sommet de la pyramide."
                                            },
                                            {
                                                "example_id": "98c29e74-2e0e-4dcc-9c68-d2e19c9e25d3",
                                                "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                                                "text": "La Russie demeurait par force une puissance pacifique, divisée au-dedans, déchirée entre les révolutionnaires et les réactionnaires également incapables de reconstruction sociale, et elle s’enlisait dans un désordre tragique de vendetta politique à retours chroniques."
                                            },
                                            {
                                                "example_id": "8d877c40-c1a5-4f53-8929-5b58ad22a54a",
                                                "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                                                "text": "Entendant le sens et la portée de la désignation dont il fut l'objet, comprenant que ce que l'opinion républicaine attendait de lui ce n'était pas un badigeonnage, un récrépissage du vieil édifice militaire, c'était une reconstruction, il se résolut à la tâche."
                                            },
                                            {
                                                "example_id": "eeea6beb-184d-46a9-a8f5-93694f5e723a",
                                                "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                                                "text": "Les auteurs ont procédé à un réétalonnage et à une reconstruction partielle de l’échelle de 1911, en y intégrant de nouveaux items."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385d0d0d-d364-35e1-8678-521ca6d53b09",
                                        "entry_id": "ccbbcd39-aa22-32ad-9ae0-ac59504e8d7c",
                                        "glosses": [
                                            "Reconstitution chirurgicale d’une ou de plusieurs parties du corps ayant subi de graves dommages, par maladie ou accident, ou bien une ablation totale ou partielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aea18e6-4c87-4106-8fb7-e1e41da45b58",
                                                "sense_id": "385d0d0d-d364-35e1-8678-521ca6d53b09",
                                                "text": "La chirurgie de reconstruction mammaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db910167-6f75-3677-b0df-c1ba31893644",
                                        "entry_id": "ccbbcd39-aa22-32ad-9ae0-ac59504e8d7c",
                                        "glosses": [
                                            "Processus de restauration de la structure et de l’intégrité psychiques qui ont été sévèrement entamées, voire détruites, par un psychotrauma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1b7390-c093-40bd-9c7c-4476e933b3d1",
                                                "sense_id": "db910167-6f75-3677-b0df-c1ba31893644",
                                                "text": "Le travail de reconstruction après un trauma est certes individuel, mais il doit passer par le relationnel comme base de sécurité et de partage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
