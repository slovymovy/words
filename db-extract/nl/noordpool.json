                "forms": [
                    {
                        "form_id": "9099a71d-d6f7-4dee-a062-2f3b6a26d06a",
                        "entry_id": "681d548f-fee6-3f97-b036-ef3075a2474c",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Noordpools"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca529bda-9e14-3bf9-93bf-a15ce2993ab2",
                        "entry_id": "681d548f-fee6-3f97-b036-ef3075a2474c",
                        "glosses": [
                            "gebied tussen 66,5 en 90 graden noorderbreedte, Noordpoolgebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d3a7f3-3912-4162-8f91-466c99cfdf29",
                                "sense_id": "ca529bda-9e14-3bf9-93bf-a15ce2993ab2",
                                "text": "De Noordpool is een met ijs bedekte zee."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d271180-f205-3fe7-91b2-c31fb0f0f089",
                        "entry_id": "681d548f-fee6-3f97-b036-ef3075a2474c",
                        "glosses": [
                            "meest noordelijke punt op aarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea365954-8145-474b-89de-f6eb8b1df571",
                                "sense_id": "6d271180-f205-3fe7-91b2-c31fb0f0f089",
                                "text": "De lange tocht door het poolgebied was zo uitputtend dat hij moest terugkeren voordat hij de Noordpool had bereikt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe7ce800-e710-4ff5-9bca-4e33fa5f012a",
                        "source_entry_id": "681d548f-fee6-3f97-b036-ef3075a2474c",
                        "source_sense_id": "ca529bda-9e14-3bf9-93bf-a15ce2993ab2",
                        "source_sense_description": "Noordpool",
                        "target_lang_word": "Nordpol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordpol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0063f54-74d9-3904-afee-44e60a9c72d2",
                                        "entry_id": "49bf96b1-1813-388e-bc4d-e103318e5587",
                                        "glosses": [
                                            "Punkt der Erde, der am weitesten im Norden liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a603efe-3395-4af9-9447-406075aff2b6",
                                                "sense_id": "c0063f54-74d9-3904-afee-44e60a9c72d2",
                                                "text": "Der Nordpol der Erde liegt inmitten des Arktischen Ozeans."
                                            },
                                            {
                                                "example_id": "174b0666-e440-44b0-9127-9d4f6f4b8ebc",
                                                "sense_id": "c0063f54-74d9-3904-afee-44e60a9c72d2",
                                                "text": "„Der Nordpol ist kein Festland, ist nicht mit dem Nordkap zu verwechseln und, anders als der Südpol, nicht von Bergen umgeben.“"
                                            },
                                            {
                                                "example_id": "4e071367-e47c-4b91-9221-6014a6faed6c",
                                                "sense_id": "c0063f54-74d9-3904-afee-44e60a9c72d2",
                                                "text": "„Sein Südpol ist weit stärker mit Festland bedeckt als der Nordpol, der nur aus einem kleinen Landkäppchen besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e3e5db6-8fc2-313b-9387-9db441a1c444",
                                        "entry_id": "49bf96b1-1813-388e-bc4d-e103318e5587",
                                        "glosses": [
                                            "Punkt eines Magneten, an dem die Feldlinien nach gängiger Definition austreten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c4d0f1-1ebd-43cb-aa17-97ee91313ff3",
                                                "sense_id": "7e3e5db6-8fc2-313b-9387-9db441a1c444",
                                                "text": "Bei vielen Magneten ist der Nordpol rot markiert."
                                            },
                                            {
                                                "example_id": "77703f18-1fca-49d5-8d7e-48eba32e87e7",
                                                "sense_id": "7e3e5db6-8fc2-313b-9387-9db441a1c444",
                                                "text": "„Wurde diese Spirale mit einem Ende, das wir A nennen wollen, dem Nordpole eines Magnetes genähert, so entstand in ihr ein Strom von der Richtung, die er gehabt hätte, wenn man mit dem Nordpole in die Spirale, und zwar an eben diesem Ende A, hineingefahren wäre, wobei es gleichgültig war, ob die Spirale in der Verlängerung des Magnetschenkels oder wie immer lothrecht auf denselben sich befand, oder aber über die beiden Schenkel des Magnetes so gelegt wurde, dass das Ende A den Nordpol berührte. […] Schon bei dem ersten Versuche, als der Cylinder in der Richtung der Verlängerung des Nordpoles an diesen angelegt wurde, erhielt ich einen sehr schwachen Strom, jedoch von der früheren Richtung, woraus gefolgert werden konnte, dass der um die Spirale entstandene Magnetismus des Cylinders die directe Wirkung des Nordpoles auf die Spirale grössentheils aufgehoben habe, weil es sich gerade so nehmen lässt, als wenn man einen Nordpol in die Spirale und einen zweiten in derselben Richtung um die Spirale geschoben hätte.“ (1854)"
                                            },
                                            {
                                                "example_id": "c5a9c3d7-4d05-4288-9e95-5b26fde6e2e2",
                                                "sense_id": "7e3e5db6-8fc2-313b-9387-9db441a1c444",
                                                "text": "„Bei der Erdaxe ist die Richtung nach dem Nordpole zu verstanden, und das negative Zeichen des entsprechenden Moments zeigt an, dass die magnetische Axe einen stumpfen Winkel mit jener macht, d. i. dass ihr magnetischer Nordpol nach Süden gekehrt ist.“ (1867)"
                                            },
                                            {
                                                "example_id": "5465ccb3-e191-48a4-8a5a-6e2ce42f2bc5",
                                                "sense_id": "7e3e5db6-8fc2-313b-9387-9db441a1c444",
                                                "text": "„In Europa war die Abweichung des Nordpoles der Magnetnadel vom astronomischen Meridian im sechzehnten Jahrhundert östlich; die Nadel näherte sich von da an fortwährend der Mittagslinie, und die Abweichung ging sodann in eine westliche über, die bis zu einem Maximum zunahm, hierauf aber wieder abnahm.“ (1842)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
