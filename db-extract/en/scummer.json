                        "entry_id": "281b1be4-78cc-3b2b-86f0-78c5561128a2",
                        "glosses": [
                            "A scummy person? One who scums i.e. skims?"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7c2f38b2-373f-4b48-9aed-94f10150d79c",
                                "sense_id": "b071bf1c-9c8d-31bd-acd2-816844fe5ad5",
                                "text": "'[…] fucking scummer like him having precedence over me? That's unheard of.'"
                            },
                            {
                                "example_id": "a5cc7f25-4e03-4394-bf18-0f6df9fada71",
                                "sense_id": "b071bf1c-9c8d-31bd-acd2-816844fe5ad5",
                                "text": "\"As it was , three years was all I could do without committin' a crime on him.\" His face showed his disgust. \"He was some kind of scummer. I'd see him hangin' round them guns, takin' the tips an' me knowin' I'd not see any of it, an' us strugglin' like we were.\""
                            },
                            {
                                "example_id": "03ca241c-5b56-457f-b2d2-8795f221330f",
                                "sense_id": "b071bf1c-9c8d-31bd-acd2-816844fe5ad5",
                                "text": "'You heard me you fucking scummer. Go on, piss off back where you came from!'"
                            }
                        ]
                    }
