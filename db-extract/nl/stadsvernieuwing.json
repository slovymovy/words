                        "entry_id": "d834ad16-424f-3cbe-81de-22ad753d55ce",
                        "glosses": [
                            "verbetering van verpauperde stadswijken door renovatie of sloop en nieuwbouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9087fbd6-84b6-4f83-b834-915c51c03f78",
                                "sense_id": "77dea34f-19be-36fe-8af4-ded8750f4df4",
                                "text": "Er heeft laatst een grote stadsvernieuwing plaatsgevonden."
                            },
                            {
                                "example_id": "ff42a462-252b-4a6e-96d2-c1831374a12a",
                                "sense_id": "77dea34f-19be-36fe-8af4-ded8750f4df4",
                                "text": "Op het oorspronkelijke Nieuw Guineaplein verscheen in 1993 een 4-lagen[sic!] hoog woongebouw. Aan de oostzijde van het nieuwe plein verscheen in 1998 de nieuwe Jan Gijzenschool, gecombineerd met bovenwoningen (ontwerp: Wiek Röling). Dit zijn twee belangrijke nieuwe elementen die verband en richting geven aan de stadsvernieuwing met de overige vrij stereotype rijtjeswoningen van twee lagen met een kap."
                            }
                        ]
                    }
