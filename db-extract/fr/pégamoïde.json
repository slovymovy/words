                        "glosses": [
                            "Sorte de similicuir à base de coton, d’acide sulfurique et d’acide citrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52b0589-edc0-4a87-958b-5ac77c6779b8",
                                "sense_id": "d63cfea8-7e38-3149-bfaf-fc2a6f60508e",
                                "text": "Alors on commence la discussion quotidienne au sujet du chien qui devient sourd, de la chatte qui est voleuse, au sujet de la cuisine au gaz, de la politique socialiste, de la composition du celluloïde ou du pégamoïde."
                            },
                            {
                                "example_id": "409f5973-11a5-496e-9a62-68c9ed90bbba",
                                "sense_id": "d63cfea8-7e38-3149-bfaf-fc2a6f60508e",
                                "text": "Ce nécessaire à pique-nique, dans un étui rigide recouvert de pégamoïde (brun à l’extérieur et rouge à l’intérieur), marqué de trois étoiles, doit dater du début du XXe siècle."
                            }
                        ]
