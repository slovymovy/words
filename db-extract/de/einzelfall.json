                                "target_senses": [
                                    {
                                        "sense_id": "375ff06b-24ac-3f25-895a-6a2e9803a193",
                                        "entry_id": "2112f649-9d4c-3d70-8d9e-d8e193044cad",
                                        "glosses": [
                                            "Cas exceptionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b584641-dc73-416e-b31b-a47bd853b599",
                                                "sense_id": "375ff06b-24ac-3f25-895a-6a2e9803a193",
                                                "text": "L'état de l'aveugle, dit-on, est un cas particulier qui ne tire point à conséquence pour le reste des hommes."
                                            },
                                            {
                                                "example_id": "738540d9-fa79-4f03-9836-530030e73bf9",
                                                "sense_id": "375ff06b-24ac-3f25-895a-6a2e9803a193",
                                                "text": "L'induction savante consiste à conclure que « ce qui est vrai dans un cas particulier sera trouvé vrai dans tous les cas qui ressemblent au premier »."
                                            },
                                            {
                                                "example_id": "0b678be9-fd98-4cfa-9ea7-16ef9adbf6d1",
                                                "sense_id": "375ff06b-24ac-3f25-895a-6a2e9803a193",
                                                "text": "Ce sont peut-être ces coupures ainsi que l’avertissement visant à « désexemplariser » les cas particuliers des personnages qui permettent au film de Bertrand Blier d’échapper à l’interdiction totale, à deux voix près, mais pas à l’interdiction aux moins de 18 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20e6cd0-dc1f-368f-b976-7b82e4e42c91",
                                        "entry_id": "2112f649-9d4c-3d70-8d9e-d8e193044cad",
                                        "glosses": [
                                            "Élément répondant aux critères généraux d’un ensemble, mais possédant des spécificités significatives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff977c4c-5af3-4968-9594-7c432a755588",
                                                "sense_id": "c20e6cd0-dc1f-368f-b976-7b82e4e42c91",
                                                "text": "L’ensemble « chômage » regroupe tous les « chômeurs ». Les « chômeurs handicapés » forment un cas particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f161e4-8857-3da7-925a-ddc9dd4e51b4",
                                        "entry_id": "2112f649-9d4c-3d70-8d9e-d8e193044cad",
                                        "glosses": [
                                            "Situation où la règle générale ne s’applique pas ou s’applique différemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356be775-5fcb-408e-89c7-246466f14d2d",
                                                "sense_id": "d5f161e4-8857-3da7-925a-ddc9dd4e51b4",
                                                "text": "Au moment du départ d’une location, le délai de préavis pour le locataire est de trois mois, sauf cas particuliers où il est ramené à un mois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
