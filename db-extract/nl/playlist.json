                "senses": [
                    {
                        "sense_id": "02b3bf9e-ba9c-36b7-8253-643a7ff340e1",
                        "entry_id": "b2730ed2-68b8-3c2e-a684-dd6885206cc0",
                        "glosses": [
                            "een lijst met muzieknummers die men wil afspelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1cdd38b-533c-4c6b-8fef-9c41b62b9c2d",
                                "sense_id": "02b3bf9e-ba9c-36b7-8253-643a7ff340e1",
                                "text": "Die muziek? De playlist van een van de kinderen."
                            },
                            {
                                "example_id": "13ad251b-f4c4-476e-abef-2027330f023e",
                                "sense_id": "02b3bf9e-ba9c-36b7-8253-643a7ff340e1",
                                "text": "De playlist van Terpstra: van Jebroer tot Raymond van het Groenewoud"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e08250-45a9-4e4b-bdfb-f84f18ae287a",
                        "source_entry_id": "b2730ed2-68b8-3c2e-a684-dd6885206cc0",
                        "source_sense_id": "02b3bf9e-ba9c-36b7-8253-643a7ff340e1",
                        "source_sense_description": "een lijst met muzieknummers die men wil afspelen",
                        "target_lang_word": "playlist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playlist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8eaf271-dcee-390f-8a7a-4b7aa3afe0ed",
                                        "entry_id": "a42aa9ef-bd59-3011-85e1-516d6bd1a8d5",
                                        "glosses": [
                                            "A list of recorded songs scheduled to be played on a radio station."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                        "entry_id": "a42aa9ef-bd59-3011-85e1-516d6bd1a8d5",
                                        "glosses": [
                                            "A list of tracks or videos to be played in a particular sequence, as from an audio CD or a streaming service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380231e8-544a-43c7-b63e-44bb741370b0",
                                                "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                                "text": "When you collect a group of MIDIs into an album, you can play them much like a CD, with repeat mode, random mode, and a programmed playlist."
                                            },
                                            {
                                                "example_id": "6ba15aac-ab03-4a07-b013-eba217d319ad",
                                                "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                                "text": "Strangers constructed playlists that pulled from artists and albums you’d never heard of, but without the performative high/low-ness that afflicts so much online music talk."
                                            },
                                            {
                                                "example_id": "a6853297-cf38-492a-92a1-d831851163bb",
                                                "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                                "text": "I hadn't spoken to her in a year, but she could still see my listens on the music platform we both used. I still went to those playlists for solace. A sense of collective understanding. We had stockpiled our youth."
                                            },
                                            {
                                                "example_id": "03c3cbef-499b-4a9e-9fe8-03f78ee692d3",
                                                "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                                "text": "No past, just traces / Nowhere to play, just playlists"
                                            },
                                            {
                                                "example_id": "1595cfaf-0312-445a-b089-65b099a8c310",
                                                "sense_id": "cf492bc4-1c97-3359-b06f-9a6ab9e324fb",
                                                "text": "When users would select the most immediately visible “dinner playlist” or ”workout mix,” they might have unknowingly clicked through to a list owned and operated by a major label."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d5d4833-c5eb-3f5c-bbd1-50b8498819be",
                                        "entry_id": "a42aa9ef-bd59-3011-85e1-516d6bd1a8d5",
                                        "glosses": [
                                            "A list of songs, prepared for a band or musical artist, to be performed during a concert; a setlist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "playlist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3da51e5-e335-35c1-ab6e-49774a5876ce",
                                        "entry_id": "b10cbfe3-0d97-37f9-b884-b8780b6da153",
                                        "glosses": [
                                            "To include (a track) on a playlist."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d42593-6cec-4243-acb3-e14d848364b6",
                                                "sense_id": "a3da51e5-e335-35c1-ab6e-49774a5876ce",
                                                "text": "She achieved success when her first single was playlisted on national radio."
                                            },
                                            {
                                                "example_id": "0667d543-48d8-4217-8530-2ec7ca0efb45",
                                                "sense_id": "a3da51e5-e335-35c1-ab6e-49774a5876ce",
                                                "text": "Suddenly they got a single playlisted at Radio 1 and the album went gold."
                                            },
                                            {
                                                "example_id": "442be418-66de-4d0d-999d-dc8d3ef4b76c",
                                                "sense_id": "a3da51e5-e335-35c1-ab6e-49774a5876ce",
                                                "text": "And it's the story of how those problems then played out over the span of many years, as music became personalized, playlisted, autoplayed, and algorithmic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
