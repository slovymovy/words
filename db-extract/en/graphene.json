                                    {
                                        "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                        "entry_id": "524121c7-91b8-38d7-aea8-905b8478e3e8",
                                        "glosses": [
                                            "Cristal bidimensionnel qui se présente sous la forme d’un feuillet constitué d’un pavage hexagonal régulier d’atomes de carbone et dont l’empilement constitue le graphite."
                                        ],
                                        "tags": [
                                            "Chimie des matériaux",
                                            "Physique des matériaux"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aebd917-9a45-4abf-983c-78446136af98",
                                                "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                                "text": "Un nanotube de carbone, c'est aussi une usine. Des chercheurs finlandais (université Aalto) ont synthétisé des nanorubans de graphène - autre variété de carbone - à l'intérieur de nanotubes."
                                            },
                                            {
                                                "example_id": "e9772015-4685-463c-9975-ab1fcfa21e38",
                                                "sense_id": "0d1592b2-823e-301e-a949-7b001c24c6a4",
                                                "text": "Les masques FFP2 contenant du graphène, un matériau synthétique, doivent être évités par précaution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
