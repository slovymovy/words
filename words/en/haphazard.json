{
    "word_family": [
        "haphazardly",
        "haphazardness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aae39a82-cd57-3995-bcb0-954f9927c8b1",
                    "sense_definition": "Lacking any obvious principle of organization; random or chaotic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "randomness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The books were stacked in a <w>haphazard</w> manner on the floor without any order.",
                            "target_lang_translations": {
                                "ru": "Книги были сложены на полу в <w>беспорядочном</w> виде, без всякого порядка.",
                                "zh": "书本在地上堆得<w>杂乱无章</w>，毫无秩序。",
                                "es": "Los libros estaban apilados de forma <w>desordenada</w> en el suelo, sin ningún tipo de orden."
                            }
                        },
                        {
                            "text": "Do not make such <w>haphazard</w> changes to the settings; instead, adjust the knobs carefully.",
                            "target_lang_translations": {
                                "ru": "Не вносите такие <w>хаотичные</w> изменения в настройки; вместо этого аккуратно отрегулируйте ручки.",
                                "zh": "不要对设置进行如此<w>随意</w>的更改；相反，请仔细调节旋钮。",
                                "es": "No hagas cambios tan <w>aleatorios</w> en los ajustes; en su lugar, ajusta los mandos con cuidado."
                            }
                        }
                    ],
                    "synonyms": [
                        "random",
                        "chaotic"
                    ],
                    "antonyms": [
                        "systematic"
                    ],
                    "common_phrases": [
                        "haphazard manner",
                        "haphazard fashion",
                        "haphazard collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный какой-либо очевидной организации; случайный или хаотичный.",
                        "zh": "缺乏明显的组织原则；随机的或混乱的。",
                        "es": "Que carece de un principio evidente de organización; desordenado, aleatorio o caótico."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядочный",
                                "target_lang_sense_clarification": "лишенный системы или порядка"
                            },
                            {
                                "target_lang_word": "хаотичный",
                                "target_lang_sense_clarification": "находящийся в состоянии хаоса"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "происходящий без определенного плана"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂乱无章",
                                "target_lang_sense_clarification": "形容没有条理，非常混乱"
                            },
                            {
                                "target_lang_word": "随意",
                                "target_lang_sense_clarification": "指没有经过深思熟虑或缺乏计划"
                            },
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指缺乏秩序的状态"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desordenado",
                                "target_lang_sense_clarification": "que carece de orden o estructura"
                            },
                            {
                                "target_lang_word": "caótico",
                                "target_lang_sense_clarification": "en estado de confusión o desorganización"
                            },
                            {
                                "target_lang_word": "aleatorio",
                                "target_lang_sense_clarification": "hecho al azar, sin un plan definido"
                            },
                            {
                                "target_lang_word": "fortuito",
                                "target_lang_sense_clarification": "que ocurre por casualidad o azar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "13887724-b5a6-3ff5-a4df-562f652f1219",
                    "sense_definition": "In a manner that lacks organization; <w>haphazardly</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "randomness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tools were scattered <w>haphazard</w> across the workbench after the project was finished.",
                            "target_lang_translations": {
                                "ru": "Инструменты были <w>беспорядочно</w> разбросаны по верстаку после завершения проекта.",
                                "zh": "项目完成后，工具被<w>杂乱地</w>散落在工作台上。",
                                "es": "Las herramientas estaban esparcidas <w>desordenadamente</w> sobre el banco de trabajo después de terminar el proyecto."
                            }
                        },
                        {
                            "text": "I suspect that it mostly happens <w>haphazard</w>, though afterwards various noble reasons are invented.",
                            "target_lang_translations": {
                                "ru": "Я подозреваю, что в основном это происходит <w>случайно</w>, хотя впоследствии придумываются различные благородные причины.",
                                "zh": "我怀疑这大多是<w>偶然</w>发生的，尽管事后人们会编造各种冠冕堂皇的理由。",
                                "es": "Sospecho que en su mayoría ocurre <w>al azar</w>, aunque después se inventan varias razones nobles."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scattered haphazard"
                    ],
                    "target_lang_definitions": {
                        "ru": "В манере, лишенной организации; беспорядочно.",
                        "zh": "以缺乏组织的方式；杂乱地。",
                        "es": "De manera desorganizada o sin plan; al azar o desordenadamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядочно",
                                "target_lang_sense_clarification": "без системы или плана"
                            },
                            {
                                "target_lang_word": "кое-как",
                                "target_lang_sense_clarification": "небрежно и хаотично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂乱地",
                                "target_lang_sense_clarification": "指没有秩序地分布或放置"
                            },
                            {
                                "target_lang_word": "随意地",
                                "target_lang_sense_clarification": "指不加考虑或没有计划地进行"
                            },
                            {
                                "target_lang_word": "乱七八糟地",
                                "target_lang_sense_clarification": "形容非常混乱、没有条理"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "al azar",
                                "target_lang_sense_clarification": "sin orden ni concierto"
                            },
                            {
                                "target_lang_word": "sin ton ni son",
                                "target_lang_sense_clarification": "sin motivo, orden ni planificación"
                            },
                            {
                                "target_lang_word": "desordenadamente",
                                "target_lang_sense_clarification": "de forma desorganizada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d695bf90-82b4-36b5-81bc-646817c18024",
                    "sense_definition": "A random accident or simple chance; luck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On such <w>haphazards</w> hang men's destinies sometimes, changing their lives forever.",
                            "target_lang_translations": {
                                "ru": "От таких <w>случайностей</w> иногда зависят судьбы людей, меняя их жизни навсевокда.",
                                "zh": "人类的命运有时就系于这样的<w>偶然</w>，从而永远改变了他们的人生。",
                                "es": "De tales <w>casualidades</w> penden a veces los destinos de los hombres, cambiando sus vidas para siempre."
                            }
                        },
                        {
                            "text": "The <w>haphazards</w> of progress often lead to unexpected discoveries in the scientific field.",
                            "target_lang_translations": {
                                "ru": "<w>Превратности</w> прогресса часто приводят к неожиданным открытиям в научной области.",
                                "zh": "科学进步中的<w>机缘</w>往往会带来意想不到的发现。",
                                "es": "Los <w>azares</w> del progreso a menudo conducen a descubrimientos inesperados en el campo científico."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "The noun form is less common in modern usage than the adjective."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайное происшествие или простая случайность; удача.",
                        "zh": "随机的意外或单纯的偶然；运气。",
                        "es": "Accidente fortuito o mera casualidad; suerte o azar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "непредвиденное событие"
                            },
                            {
                                "target_lang_word": "воля случая",
                                "target_lang_sense_clarification": "стечение обстоятельств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偶然",
                                "target_lang_sense_clarification": "指意外发生的事件"
                            },
                            {
                                "target_lang_word": "机缘",
                                "target_lang_sense_clarification": "指偶然的机会或巧合"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "casualidad",
                                "target_lang_sense_clarification": "suceso imprevisto o accidental"
                            },
                            {
                                "target_lang_word": "azar",
                                "target_lang_sense_clarification": "circunstancia imprevista o casual"
                            },
                            {
                                "target_lang_word": "vicisitud",
                                "target_lang_sense_clarification": "suceso o acontecimiento imprevisto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}