                                    {
                                        "sense_id": "e4156aaf-0e33-3280-97e6-a3492b4436c7",
                                        "entry_id": "3d8e0202-7e27-3758-b3eb-45fe4fb51867",
                                        "glosses": [
                                            "To chase (an animal or person) up a tree."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5705b2f-a6e3-43c2-8011-aebf0d57b0b9",
                                                "sense_id": "e4156aaf-0e33-3280-97e6-a3492b4436c7",
                                                "text": "The dog treed the cat."
                                            },
                                            {
                                                "example_id": "968aefc5-06fd-4ce7-90a9-327402aed1df",
                                                "sense_id": "e4156aaf-0e33-3280-97e6-a3492b4436c7",
                                                "text": "When hunted it [the jaguar] takes refuge in trees, and this habit is well known to hunters, who pursue it with dogs and pot it when treed."
                                            },
                                            {
                                                "example_id": "8e9c7d79-afc5-4340-b995-4d27f2706cad",
                                                "sense_id": "e4156aaf-0e33-3280-97e6-a3492b4436c7",
                                                "text": "\"And our dogs used to tree the cats on our property here, and we'd dispatch them.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1271929a-9c01-39e2-9a67-490845590fdc",
                                        "entry_id": "3d8e0202-7e27-3758-b3eb-45fe4fb51867",
                                        "glosses": [
                                            "To place in a tree."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ebdde54-c2b0-46b9-8e8c-9caca1574155",
                                                "sense_id": "1271929a-9c01-39e2-9a67-490845590fdc",
                                                "text": "Black bears can tree their cubs for protection, but grizzly bears cannot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4ff51b-0577-3d25-9126-9d9c54d0bd38",
