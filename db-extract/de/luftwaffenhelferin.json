                "senses": [
                    {
                        "sense_id": "be80b488-25e8-3a73-9748-c03e87e45b6c",
                        "entry_id": "4f05c2e9-6d7c-3388-8a79-3e82908f8f9f",
                        "glosses": [
                            "meist 15- bis 17-jährige Schülerin, die im Rahmen des Kriegshilfsdienstes ab 1943 bei der Luftwaffe eingesetzt wurde, wobei ihr Dienst vorrangig das Nachrichtenwesen (zum Beispiel Funk- und Fernmeldedienst), Verwaltungsaufgaben sowie technische Unterstützung umfasste"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fcc3a3ca-3c32-4159-bb0a-70d093fe3f1f",
                                "sense_id": "be80b488-25e8-3a73-9748-c03e87e45b6c",
                                "text": "„Im Zweiten Weltkrieg als Luftwaffenhelferin eingezogen, absolvierte sie erst 1950 die »Externistenmatura«, arbeitete aber schon seit 1946 als Englischlehrerin an Wiener Hauptschulen.“"
                            },
                            {
                                "example_id": "3e1b6793-48bf-46ad-a1e8-05ddd41ea799",
                                "sense_id": "be80b488-25e8-3a73-9748-c03e87e45b6c",
                                "text": "„Das Gebäude diente als Ausbildungsstätte für Luftwaffenhelferinnen und auch als Lazarett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
