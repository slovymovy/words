                        ],
                        "examples": [
                            {
                                "example_id": "e256329d-2371-4bbb-920a-48cfc236a761",
                                "sense_id": "0ff57952-f46f-3cb1-b1b1-4c5cf1d37ee7",
                                "text": "Po szczepionkach ludzie głupieją, można zapaść na autyzm, alzheimera, astmę, katar sienny – przekonują antyszczepionkowcy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bf82881-1111-40f8-97a8-4c71a76270bb",
                        "source_entry_id": "dc9c1b24-58d9-326c-8c4e-b51d79cefe56",
                        "source_sense_id": "0ff57952-f46f-3cb1-b1b1-4c5cf1d37ee7",
                        "target_lang_word": "alzhéimer",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alzhéimer",
