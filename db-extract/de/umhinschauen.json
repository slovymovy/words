                                        "sense_id": "89354222-8938-3a5d-9341-ab5d0ac35a5a",
                                        "entry_id": "cf70fa64-09c6-3b7a-b29b-7acf11364306",
                                        "glosses": [
                                            "jemanden aufsuchen, um mit ihm eine Weile zusammen sein zu können"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bd63e88-c260-4144-b73d-b0241c9ac83e",
                                                "sense_id": "89354222-8938-3a5d-9341-ab5d0ac35a5a",
                                                "text": "Gestern haben wir unsere Verwandten besucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af739bbc-d98b-3f16-b16f-80fc080119d3",
                                        "entry_id": "cf70fa64-09c6-3b7a-b29b-7acf11364306",
                                        "glosses": [
                                            "zu einem Ort gehen, um dort jemanden zu treffen oder etwas zu erledigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd830f28-f6a4-486d-96d1-330506c0d2a8",
                                                "sense_id": "af739bbc-d98b-3f16-b16f-80fc080119d3",
                                                "text": "Wollen wir nicht mal die neue Ausstellung im Museum besuchen?"
                                            },
                                            {
                                                "example_id": "48eba35b-65fa-4adb-848e-9b382339ce3b",
                                                "sense_id": "af739bbc-d98b-3f16-b16f-80fc080119d3",
                                                "text": "Heute besucht uns der Vertreter der Versicherung."
                                            },
                                            {
                                                "example_id": "6308cd44-878e-4d38-82f2-97a94d46751f",
                                                "sense_id": "af739bbc-d98b-3f16-b16f-80fc080119d3",
                                                "text": "„Ein deutscher Rucksacktourist zeltete 1994 im Palastgarten, ein nackter Gleitschirmflieger besuchte die Königin, ein verwirrter Mann hielt sie für seine Mutter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a1ecd25a-5aa8-3a15-b5af-d2646cbc08af",
                                        "entry_id": "cf70fa64-09c6-3b7a-b29b-7acf11364306",
                                        "glosses": [
                                            "etwas für eine gewisse Zeit regelmäßig aufsuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ecf6192-3f5c-4b76-a36d-d51b4e1106cd",
                                                "sense_id": "a1ecd25a-5aa8-3a15-b5af-d2646cbc08af",
                                                "text": "Ich besuche noch die Schule."
                                            },
                                            {
                                                "example_id": "1ed8bee7-0323-49ba-a2e7-e7277020b22b",
                                                "sense_id": "a1ecd25a-5aa8-3a15-b5af-d2646cbc08af",
                                                "text": "„In der Elementarschule, die Wilhelm Ostwald gemeinsam mit russischen und lettischen Kindern besuchte, erreichte er gute Leistungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
