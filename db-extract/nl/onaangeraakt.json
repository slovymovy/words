                                            {
                                                "example_id": "8ed74e44-bda0-48f5-9f2a-a8075352ddb2",
                                                "sense_id": "e266dcc8-dfa9-3fe0-b33f-4f7f88bae19c",
                                                "text": "“I’ll try, but it was a very ungentlemanly thing to do, I didn’t think you could be so sly and malicious, Laurie,” replied Meg, trying to hide her maidenly confusion under a gravely reproachful air."
                                            }
                                        ]
