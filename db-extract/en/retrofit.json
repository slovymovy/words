                                "target_senses": [
                                    {
                                        "sense_id": "6da29c90-c5a4-334b-95cb-207d169bbd68",
                                        "entry_id": "82189162-de53-3476-973b-19b808b87393",
                                        "glosses": [
                                            "zusätzliche Bestandteile nach Fertigstellung und Verwendung zur Verbesserung der Funktionalität einbauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba78acad-55f2-42dd-a560-6125beed1f6c",
                                                "sense_id": "6da29c90-c5a4-334b-95cb-207d169bbd68",
                                                "text": "„Wie das Nachrichtenmagazin ‚Spiegel‘ (Freitag) meldete, gibt es Überlegungen, zumindest einen Teil der Dieselflotte mit sogenannten SCR-Katalysatoren nachrüsten zu lassen.“"
                                            },
                                            {
                                                "example_id": "73a58670-b84a-4a40-90c7-864604a2536e",
                                                "sense_id": "6da29c90-c5a4-334b-95cb-207d169bbd68",
                                                "text": "„Ob sich im Altbau eine Wärmepumpe nachrüsten lässt, dafür gibt es einen einfachen Test: An einem sehr kalten Tag im Winter die Vorlauftemperatur begrenzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df604522-341d-302a-b420-2d9112e17426",
                                        "entry_id": "82189162-de53-3476-973b-19b808b87393",
                                        "glosses": [
                                            "die militärische Schlagkraft durch Anschaffung von Material erhöhen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3943053-6927-425f-bc4e-00a05993d09e",
                                                "sense_id": "df604522-341d-302a-b420-2d9112e17426",
                                                "text": "„[…] der Kleinbus [soll] noch mit einer Standheizung und einer Klimaanlage nachgerüstet werden.“"
                                            },
                                            {
                                                "example_id": "49008eee-5cd6-4a97-856a-629c72ca8196",
                                                "sense_id": "df604522-341d-302a-b420-2d9112e17426",
                                                "text": "„Der SPD-Mann wollte die Bundesrepublik mit modernen Pershing-II- und Cruise-Missile-Raketen nachrüsten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ae21197-31cb-4cc1-840d-2ac3b6a04590",
                        "source_entry_id": "046c7392-9ad8-3292-83c7-35848ab355a5",
