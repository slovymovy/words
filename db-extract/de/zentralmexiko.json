                "senses": [
                    {
                        "sense_id": "0cd3ccb1-b5fc-3356-9f09-c53c09cd1b81",
                        "entry_id": "2be6def6-b758-3595-a8d0-95ad99d8c98d",
                        "glosses": [
                            "zentraler, mittig gelegener Teil Mexikos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2422bb42-729b-4fbd-9738-bbd48da319c1",
                                "sense_id": "0cd3ccb1-b5fc-3356-9f09-c53c09cd1b81",
                                "text": "„Der Begriff wurde ab dem 18. Jahrhundert von Wissenschaftlern verwendet, um das Volk zu benennen, das zur Zeit der Ankunft der Spanier Zentralmexiko beherrschte.“"
                            },
                            {
                                "example_id": "68d1a96b-9afe-4e71-99a3-361e6871697f",
                                "sense_id": "0cd3ccb1-b5fc-3356-9f09-c53c09cd1b81",
                                "text": "„Weiter südlich, in West- und Zentralmexiko, erhebt sich die Kordillere zu gewaltigen Gipfeln von über 5000 Metern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
