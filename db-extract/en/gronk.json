                ],
                "senses": [
                    {
                        "sense_id": "5a34739e-21c4-3ac8-99c0-39c874b75d25",
                        "entry_id": "0ce04211-e450-314d-930d-d90461fc0c8a",
                        "glosses": [
                            "To make a gronking sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5f46c21-6391-4c23-9598-ac5ce6c75eb2",
                                "sense_id": "5a34739e-21c4-3ac8-99c0-39c874b75d25",
                                "text": "A raven gronked along the timber-covered ridge line, and a cool breeze swept down from the snow-covered peaks."
                            },
                            {
                                "example_id": "8006a990-a105-4c52-b8f8-a08ec365fa03",
                                "sense_id": "5a34739e-21c4-3ac8-99c0-39c874b75d25",
                                "text": "Juan Bautista handed the raven off to a perch—it gronked and protested—and took a seat on his couch."
                            },
                            {
                                "example_id": "4f16615d-654b-4694-87b4-385f05f6fcf4",
                                "sense_id": "5a34739e-21c4-3ac8-99c0-39c874b75d25",
                                "text": "The rush of water behind me, the soft drip from the trees, ravens gronking far off—these were the only sounds I heard."
                            }
                        ]
                    }
                ],
