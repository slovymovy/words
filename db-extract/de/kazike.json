                        "examples": [
                            {
                                "example_id": "c2406326-38c0-43cd-a317-58b4dc81e7a8",
                                "sense_id": "8b505871-0052-3042-9501-1da0d9abf828",
                                "text": "Staunend und verächtlich sieht der Kazike das Toben: Es ist das ewige Staunen aller Naturkinder an allen Enden der Erde über die Kulturmenschen, denen eine Handvoll gelbes Metall kostbarer erscheint als alle geistigen und technischen Errungenschaften ihrer Kultur.",
                                "translation": "The cacique watches their rage with astonishment and contempt: it is the eternal amazement of nature's children all over the earth, wondering why a fistful of yellow metal is more precious to civilized man than all the spiritual and technical achievements of his culture.",
                                "english": "The cacique watches their rage with astonishment and contempt: it is the eternal amazement of nature's children all over the earth, wondering why a fistful of yellow metal is more precious to civilized man than all the spiritual and technical achievements of his culture."
                            }
                        ]
