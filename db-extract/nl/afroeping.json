                        "glosses": [
                            "het vragen aan iemand of hij ergens weg wil gaan omdat hij ergens anders nodig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "401cfd36-72d0-4800-831c-101f32618e90",
                                "sense_id": "adacdbe2-753e-3b65-bcd6-ed354b8c74eb",
                                "text": "Omtrent de aanleiding tot Thorbecke's plotseling vertrek uit Göttingen in het najaar van 1824 zijn wij onvoldoende ingelicht. ‘Mijne afroeping,’ noemt hij het in den oudst bewaarden brief aan Groen. Wie hem dan geroepen had? Van Lennep? Falck? zijn vader misschien ook, wegens familieomstandigheden? Wij verkeeren in het onzekere."
                            }
                        ]
                    },
                    {
                        "sense_id": "b92d476d-8f6c-3b81-886e-d83b24cdd325",
                        "entry_id": "01319319-1665-37bf-981d-99f1fd4a722d",
