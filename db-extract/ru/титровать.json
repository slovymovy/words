                                        "tags": [
                                            "analytische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25573a-6fe5-4d7e-9e98-8ca4b6131cc0",
                                                "sense_id": "8feaf823-85ff-3294-8ed1-c243e1609933",
                                                "text": "Die Base wurde mit der Maßlösung bis zum Farbumschlag des Indikators titriert."
                                            },
                                            {
                                                "example_id": "442ba002-78ba-4f0e-bf48-aab004b45e70",
                                                "sense_id": "8feaf823-85ff-3294-8ed1-c243e1609933",
                                                "text": "„Titrieren heißt, die unbekannte Menge eines gelösten Stoffes dadurch ermitteln, daß man ihn quantitativ von einem chemisch wohl definierten Anfangszustand in einen ebensogut bestimmten Endzustand überführt, und zwar durch Zugabe einer geeigneten Reagenslösung, deren chemischer Wirkungswert bekannt ist, und deren Volumen genau gemessen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
