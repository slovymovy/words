                ],
                "senses": [
                    {
                        "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                        "entry_id": "76b27bfb-0280-3b78-938c-abcf61e37c8a",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, der aus einer technischen Anlage oder Einrichtung stammt; Zuordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e5e8b4-2d4a-4d1c-8d6e-cd53a4391b47",
                                "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                                "text": "„Die Ergebnisse der Studie von SUCKER ET Al. zeigen, dass es auf der Basis der Polaritätenprofile von EYFERTH (VDI 3882 Bl. 2, Seite 7) möglich ist, eine hedonisch eindeutige Klassifikation von Anlagengerüchen vorzunehmen.“"
                            },
                            {
                                "example_id": "bcbf4873-f0f7-45e3-85d2-0011fb4302ee",
                                "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                                "text": "„In der Geruchsimmissionsrichtlinie wird für Wohngebiete eine Geruchsbelastung durch Anlagengeruch bis 10 % der Jahresstunden als noch zumutbar festgelegt.“"
                            },
                            {
                                "example_id": "2daebb41-a6bb-4f51-baa2-7ce742b4b67a",
                                "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                                "text": "„Um die Beurteilung des Anlagengeruchs zu vereinheitlichen, wurde bei jeder Betriebsbesichtigung der typische Anlagengeruch mit Hilfe der Intensitäts- und Hedonikskala (VDI 3882 Bl. 1 und Bl. 2) bewertet.“"
                            },
                            {
                                "example_id": "25380e6a-e6dc-49ef-9b65-4f8273440bcd",
                                "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                                "text": "„Es ergab sich ein deutlicher Unterschied in der Belästigungswirkung zwischen \"angenehmen\" Anlagengerüchen einerseits sowie den \"unangenehmen\" und \"neutralen\" Anlagengerüchen andererseits. “"
                            },
                            {
                                "example_id": "120094bb-aa5a-40c8-b46e-9cea415366c0",
                                "sense_id": "d989e303-72c8-343e-93e1-89a6d35f062e",
                                "text": "„Zur Feststellung eindeutig angenehmer Anlagengerüche ist die Methode zur hedonischen Klassifikation von Anlagengerüchen — Methode der Polaritätenprofile — anzuwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
