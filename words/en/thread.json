                                "target_lang_sense_clarification": "технический термин для крепежа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62dec016-d81e-3a59-94e3-3e032667e0fc",
                    "sense_definition": "A unit of execution within a computer process that can be managed independently by a scheduler.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application uses a separate <w>background</w> <w>thread</w> to handle file downloads.",
                            "target_lang_translations": {
                                "ru": "Приложение использует отдельный <w>фоновый</w> <w>поток</w> для обработки загрузок файлов."
                            }
                        },
                        {
                            "text": "Modern processors are designed to handle multiple <w>execution</w> <w>threads</w> simultaneously.",
                            "target_lang_translations": {
                                "ru": "Современные процессоры предназначены для одновременной обработки нескольких <w>потоков</w> <w>выполнения</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "execution thread",
                        "background thread",
                        "main thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Минимальная единица обработки в операционной системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "стандартный IT-термин"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "реже используемый синоним в программировании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72e380ef-e853-33fc-a756-32bad5d52478",
                    "sense_definition": "To pass a thread through the eye of a needle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sewing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>thread</w> <w>a</w> <w>needle</w> when the light is so dim.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вдеть</w> <w>нитку</w> <w>в</w> <w>иголку</w> при таком тусклом свете."
                            }
                        },
                        {
                            "text": "She carefully tried to <w>thread</w> the needle before starting her embroidery project.",
                            "target_lang_translations": {
                                "ru": "Она старательно пыталась <w>вдеть</w> нитку в иголку перед началом вышивания."
