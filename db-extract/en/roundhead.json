                "senses": [
                    {
                        "sense_id": "bd33d778-e072-3922-8ecf-9bc9ef86e17d",
                        "entry_id": "ad51e801-bf1e-3a35-a481-eb5f224b8c55",
                        "glosses": [
                            "Having a dome-shaped head."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7e25ea-51b2-49b5-8f7c-bcd76260c9ab",
                                "sense_id": "bd33d778-e072-3922-8ecf-9bc9ef86e17d",
                                "text": "The roundhead screw and its fraternal twins, the button head and pan head screws, have a head that is flat on the bottom and hemispherical on top."
                            },
                            {
                                "example_id": "4b8e5bfa-27f6-479e-bbeb-e7da36601919",
                                "sense_id": "bd33d778-e072-3922-8ecf-9bc9ef86e17d",
                                "text": "You can use flat-head screws and plug the holes, or you can use roundhead blue screws and let the heads project."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
