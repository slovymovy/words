                        "entry_id": "9b8d4db8-c32e-32f1-a906-bfdd1c06c8e4",
                        "glosses": [
                            "Qui campe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0049843a-90dc-4646-9fa1-d9aa42a9ca8d",
                                "sense_id": "d905164f-a3fe-3d2a-935e-157e64d68dac",
                                "text": "Bientôt, les grands anthropoïdes campants et pique-niquants pourraient déambuler dans les campagnes avec leurs images chantantes et gigotantes."
                            },
                            {
                                "example_id": "f0133626-c77a-4c2b-aac9-97fd1fd85e96",
                                "sense_id": "d905164f-a3fe-3d2a-935e-157e64d68dac",
                                "text": "Le premier inventeur & la premiere invention en grand, à qui Dieu & Moise paroissent donner la préférence, comme la primauté, fut Jabel, & la vie champêtre & errante sous des tentes, vie pastorale ou simplement campante ou campagnarde : Genuitque Adam Jabel, qui fuit Pater habitantium in tentoriis, atque Pastorum."
                            }
                        ]
                    }
