                        "glosses": [
                            "anlässlich eines Geburtstags durchgeführte kurze Reise, Fahrt, Wanderung oder dergleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b02f31-6783-42b1-906a-14f473d59402",
                                "sense_id": "48f0fa05-0314-3ef9-a064-3ab25e69b74e",
                                "text": "„Auf einem Geburtstagsausflug mit ihren Töchtern ist eine Frau in Österreich von einer Kuhherde angegriffen und tödlich verletzt worden.“"
                            },
                            {
                                "example_id": "0df02756-d3fa-4e5e-8869-24898ef39770",
                                "sense_id": "48f0fa05-0314-3ef9-a064-3ab25e69b74e",
                                "text": "„Und nun warten sie mit den Leinen in den Händen im schaukelnden Boot, freuen sich über diesen Tag, das Tonband spielt die Musik, die Halldór für diesen Geburtstagsausflug zusammengestellt hat.“"
                            }
                        ],
