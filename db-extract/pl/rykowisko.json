                    },
                    {
                        "translation_id": "87a6ff4c-9393-40ce-ae90-017c8d175389",
                        "source_entry_id": "d30e4bb6-8bff-35ab-8875-89fc178bce62",
                        "source_sense_id": "79de2b06-cff3-30af-b794-06d252695c1c",
                        "target_lang_word": "Brunft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brunft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1f9ec9-32dd-30a9-99dc-131b39fdd2a7",
                                        "entry_id": "97d779f2-1e27-3a53-bab2-c1d894625091",
                                        "glosses": [
                                            "Paarungszeit insbesondere des Schalenwilds"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d88e85ef-05d8-4926-83eb-bdaf34a6c0f4",
                                                "sense_id": "3d1f9ec9-32dd-30a9-99dc-131b39fdd2a7",
                                                "text": "„Individuell tritt die Brunft nach dem Verhältnisse des Alters früher oder später ein, und dauert länger oder kürzer, womit auch die Heftigkeit des Begattungstriebes und alle dabei hervortretenden Erscheinungen in Verbindung und Zusammenhang stehen.“"
                                            },
                                            {
                                                "example_id": "14d3f0af-d401-4693-ad9b-44bfaba213fc",
                                                "sense_id": "3d1f9ec9-32dd-30a9-99dc-131b39fdd2a7",
                                                "text": "In den letzten Jahren verliefen die Brünfte immer ohne nennenswerte Vorkommnisse."
                                            },
                                            {
                                                "example_id": "5145bdbf-5c1a-4dde-b3f7-e918dcf3d963",
                                                "sense_id": "3d1f9ec9-32dd-30a9-99dc-131b39fdd2a7",
                                                "text": "Der Hirsch ist in die Brunft getreten."
                                            },
                                            {
                                                "example_id": "9957211f-2e18-4ea9-8ccf-7debe232a395",
                                                "sense_id": "3d1f9ec9-32dd-30a9-99dc-131b39fdd2a7",
                                                "text": "„Zu Anfang der Brunft schreien die Damhirsche gar nicht, oder selten; gegen das Ende der Brunft aber, bis wohin ihnen der Hals sehr anschwillt, schreien sie öfters, und zuweilen selbst um Mittag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
