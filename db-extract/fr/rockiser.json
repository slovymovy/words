                        "entry_id": "348dc3cc-8a7a-3704-9416-c26973ebcfca",
                        "glosses": [
                            "Donner un caractère rock à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104bf7b3-35d9-4f39-ab2e-42f20248ef91",
                                "sense_id": "a3254a5d-8f86-3560-8c4f-83792d12e817",
                                "text": "Il ne cherchait pas à croiser, métisser, relire, mâtiner, machiner, rockiser ou relooker le flamenco, il cherchait ce qu’il avait dans le ventre."
                            },
                            {
                                "example_id": "5c989322-f270-49ae-86e6-706227c7bb5a",
                                "sense_id": "a3254a5d-8f86-3560-8c4f-83792d12e817",
                                "text": "Certains spectateurs commencent déjà à s’en aller alors que le chant socialiste « rockisé » par Cui Jian Nanniwan clôt le spectacle."
                            }
                        ]
                    }
