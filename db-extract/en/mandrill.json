                    {
                        "translation_id": "8a67d4de-a897-462d-9f30-0b8e0335b473",
                        "source_entry_id": "fca3530a-9ece-36dc-ac79-5a5a445c3194",
                        "source_sense_id": "04029319-eaf5-396f-8ed5-b7ff3b0365a3",
                        "source_sense_description": "Mandrillus sphinx",
                        "target_lang_word": "мандри́л",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мандри́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6111e7-8719-387a-9d9f-5ad2838e8ef6",
                                        "entry_id": "2fef44b7-4887-3284-93bb-712586d26007",
                                        "glosses": [
                                            "зоол. род и вид приматов из семейства мартышковых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac75d232-975b-466e-9ed7-96dde60556fa",
                                                "sense_id": "1c6111e7-8719-387a-9d9f-5ad2838e8ef6",
                                                "text": "Давно интерес возрастает к ещё не исследованным видам странных животных, которые населяют центральную Африку; .. французы в истекшем столетии открывают на западе неизученных антилоп; варварийский олень, саблерогая антилопа впервые являются взорам учёных; ряды разнородных незнаемых обезьян (павианов, мандрилов и дриллов) являются нам .."
                                            },
                                            {
                                                "example_id": "cb8eec64-5ae4-4c71-9b12-cf2e6a3210a4",
                                                "sense_id": "1c6111e7-8719-387a-9d9f-5ad2838e8ef6",
                                                "text": "Мандрил — это крупная обезьяна из семейства мартышковых. Рост самца может достигать 80 сантиметров, а вес — 25–50 килограммов. Окрас мандрилов очень яркий: борозды вдоль ярко-красного носа окрашены в голубой или синий цвет, борода состоит из белых, жёлтых и оранжевых волос, шерсть на туловище может быть от бурой до тёмно-коричневой. Обитают мандрилы в Западной Африке и населяют влажные тропические леса."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
