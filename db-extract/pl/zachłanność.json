                "senses": [
                    {
                        "sense_id": "1da080f6-a527-3153-971d-cb1dd46e7e9b",
                        "entry_id": "fe43e613-d50c-3c2e-b124-60ca385ba1a1",
                        "glosses": [
                            "nienasycenie w pożądaniu czegoś, żądza posiadania lub doznawania czegoś ponad rzeczywiste potrzeby"
                        ],
                        "tags": [],
