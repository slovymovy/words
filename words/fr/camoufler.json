{
    "word_family": [
        "camouflage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ada1c0ce-42b5-309c-85a6-0f0082864f54",
                    "sense_definition": "Déguiser ou modifier l'apparence de quelqu'un ou de quelque chose afin de le rendre méconnaissable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien utilise du maquillage pour <w>camoufler</w> son visage et surprendre le public."
                        },
                        {
                            "text": "Elle a trouvé une astuce ingénieuse pour <w>camoufler</w> une vilaine tache sur le mur du salon."
                        }
                    ],
                    "synonyms": [
                        "déguiser",
                        "maquiller"
                    ],
                    "antonyms": [
                        "démasquer",
                        "exposer"
                    ],
                    "common_phrases": [
                        "camoufler son visage",
                        "camoufler une cicatrice"
                    ]
                },
                {
                    "sense_id": "8579b583-5b70-31f5-ab49-787050706a97",
                    "sense_definition": "Masquer adroitement une réalité, un défaut ou des intentions afin de tromper autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a tenté de <w>camoufler</w> la vérité lors de sa dernière conférence de presse."
                        },
                        {
                            "text": "Ils ont essayé de <w>camoufler</w> leurs erreurs comptables avant l'audit annuel de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "dissimuler",
                        "masquer"
                    ],
                    "antonyms": [
                        "dévoiler",
                        "révéler"
                    ],
                    "common_phrases": [
                        "camoufler la vérité",
                        "camoufler ses erreurs"
                    ]
                },
                {
                    "sense_id": "99d522d2-2332-3686-a15b-ab402a95c89b",
                    "sense_definition": "Soustraire aux regards de l'ennemi du matériel militaire ou des positions au moyen d'un décor approprié.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dissimulation militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont utilisé des branchages pour <w>camoufler</w> les véhicules blindés dans la forêt."
                        },
                        {
                            "text": "Avant la tombée de la nuit, le régiment a dû <w>camoufler</w> toutes ses positions de tir."
                        }
                    ],
                    "synonyms": [
                        "abriter",
                        "dissimuler"
                    ],
                    "antonyms": [
                        "exposer"
                    ],
                    "common_phrases": [
                        "camoufler un campement",
                        "camoufler des véhicules"
                    ]
                }
            ]
        }
    ]
}