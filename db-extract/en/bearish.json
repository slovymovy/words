                    {
                        "translation_id": "1320e3c2-0a46-48d2-b6e5-3c2553c7d524",
                        "source_entry_id": "2faaebd4-b0d2-3e5e-b676-855f3054cfb3",
                        "source_sense_description": "characterized by the falling price of a financial instrument",
                        "target_lang_word": "baissier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baissier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca87cb68-65c5-30b4-84fe-a8667e2cb3d5",
                                        "entry_id": "40d23b7b-e47d-3725-8c48-1902643a6bb3",
                                        "glosses": [
                                            "Qui concerne un marché boursier à la baisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcac5a6-2319-4179-b4d0-0cb5656af920",
                                                "sense_id": "ca87cb68-65c5-30b4-84fe-a8667e2cb3d5",
                                                "text": "L'indice est entraîné à la baisse par les spéculateurs baissiers, qui ont les mains libres pour manipuler le marché étant donné que personne ne veut se mettre en face pour acheter."
                                            },
                                            {
                                                "example_id": "eba4f585-e1ae-4da3-9140-f8ceb84265e9",
                                                "sense_id": "ca87cb68-65c5-30b4-84fe-a8667e2cb3d5",
                                                "text": "Si la Chine se débarrassait massivement de ses bons du Trésor, cela ferait monter les taux d’intérêt, entravant la croissance économique américaine avec des effets baissiers significatifs sur l’économie chinoise."
                                            },
                                            {
                                                "example_id": "1f7df356-db62-4aac-a5f5-a8068431c067",
                                                "sense_id": "ca87cb68-65c5-30b4-84fe-a8667e2cb3d5",
                                                "text": "Le marché est baissier ces jours-ci. La tendance baissière continue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9a7048-8b9e-330a-af9f-fcd8db6ce120",
                                        "entry_id": "40d23b7b-e47d-3725-8c48-1902643a6bb3",
                                        "glosses": [
                                            "Qui concerne une grandeur numérique décroissante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eded1a6-140d-4fde-a063-2ea712b71049",
                                                "sense_id": "5a9a7048-8b9e-330a-af9f-fcd8db6ce120",
                                                "text": "Parodoxalement, ce sont dans les régions connaissant l’évolution la plus baissière où le délai moyen d’enregistrement a été plus élevé."
                                            },
                                            {
                                                "example_id": "a6d8b42f-2f67-4b25-a14c-0c880f25b704",
                                                "sense_id": "5a9a7048-8b9e-330a-af9f-fcd8db6ce120",
                                                "text": "Si jamais, ils observent une tendance baissière des appuis de Trump dans la course, ils pourront alors en profiter pour commencer à fourbir leurs armes contre ce dernier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baissier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31cf3e5e-c732-39e4-ba12-38cdf6f0033b",
                                        "entry_id": "9ff7c332-27a0-37d3-a087-a7e951bb86d2",
                                        "glosses": [
                                            "Celui qui joue à la baisse en matière de spéculation boursière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00800495-7048-432e-8e71-49890ec5e322",
                                                "sense_id": "31cf3e5e-c732-39e4-ba12-38cdf6f0033b",
                                                "text": "En réalité, pour la première fois, les baissiers l’emportaient, touchaient enfin des différences, eux qui en payaient depuis des mois, et, la situation se retournant, lui dut se faire reporter chez Mazaud, lequel se trouva dès lors fortement engagé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
