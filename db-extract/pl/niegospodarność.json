                    {
                        "sense_id": "798c7720-e970-373f-a347-832a3fbbde5e",
                        "entry_id": "141c6d84-773e-34c8-8ce4-0580f713bd10",
                        "glosses": [
                            "zarządzanie czymś w sposób przynoszący straty przez nieuczciwość lub nieumiejętność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0402c4-61d6-4b85-afa5-c1f0882a7472",
                                "sense_id": "798c7720-e970-373f-a347-832a3fbbde5e",
                                "text": "Likwidatorzy państwowych firm wykazali się także wyjątkową niegospodarnością w wydatkach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f2c8dec-2b5a-4837-8fd7-05eed8450be5",
                        "source_entry_id": "141c6d84-773e-34c8-8ce4-0580f713bd10",
                        "source_sense_id": "798c7720-e970-373f-a347-832a3fbbde5e",
                        "target_lang_word": "mismanagement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mismanagement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28b051fd-e169-3ff9-8fa9-39995b7a5820",
                                        "entry_id": "d21ed638-3e0d-3942-b125-7abe027479b7",
                                        "glosses": [
                                            "The process or practice of managing ineptly, incompetently, or dishonestly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed5a032-fb46-4992-bb7e-44841e60f1b4",
                                                "sense_id": "28b051fd-e169-3ff9-8fa9-39995b7a5820",
                                                "text": "The value of the firm's stock fell precipitously when word leaked out that officers of the company were under investigation for gross mismanagement."
                                            },
                                            {
                                                "example_id": "6bdb8660-e937-4f5e-9030-8edde5e9cc13",
                                                "sense_id": "28b051fd-e169-3ff9-8fa9-39995b7a5820",
                                                "text": "But, alas! for the mismanagement of fate—he was quite out of his place in the Cortez of Spain: he dilated on religious toleration to those in whose ears it sounded like blasphemy—on the blessing of knowledge, to those with whom intellect and anarchy were synonymous—and on the rights of the people, to Hidalgos, who were preux chevaliers in loyalty to their king."
                                            },
                                            {
                                                "example_id": "e0f876f7-cd1e-4695-b470-631aea1408e4",
                                                "sense_id": "28b051fd-e169-3ff9-8fa9-39995b7a5820",
                                                "text": "[...] it also charged the Newmarket Railway £600 a year for the management or rather—as the Chairman of the Newmarket Railway did not scruple to call it—the mismanagement of the line."
                                            },
                                            {
                                                "example_id": "5c235bea-8e45-4460-ac6f-714c8fa14815",
                                                "sense_id": "28b051fd-e169-3ff9-8fa9-39995b7a5820",
                                                "text": "After decades of the type of mismanagement that proliferated across all the nationalised industries, the government was already aware that British Railways was in deep trouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb9c0cb2-8042-47b3-9401-8095d504174e",
                        "source_entry_id": "141c6d84-773e-34c8-8ce4-0580f713bd10",
                        "source_sense_id": "798c7720-e970-373f-a347-832a3fbbde5e",
                        "target_lang_word": "Missmanagement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missmanagement",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d195f450-6ae8-3fb8-805f-2afa7b149082",
                                        "entry_id": "c444826b-5df2-3426-8550-f99cd4983720",
                                        "glosses": [
                                            "(von Instanzen ausgehendes) nicht funktionierendes Zusammenspiel von Planung, Umsetzung und Kontrolle (Management) bei bestimmten (Geschäfts-)Prozessen"
                                        ],
                                        "tags": [
                                            "oft in Bezug auf ein Unternehmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46f1699-245a-46d2-8e9d-0471f3fba416",
                                                "sense_id": "d195f450-6ae8-3fb8-805f-2afa7b149082",
                                                "text": "„Den Umfang der vom Staat durch Missmanagement verschleuderten Summen nennt der Steuerzahlerbund nach Zweifeln seit einiger Zeit nicht mehr.“"
                                            },
                                            {
                                                "example_id": "1d56ff16-b4ae-43fc-be48-562994a74020",
                                                "sense_id": "d195f450-6ae8-3fb8-805f-2afa7b149082",
                                                "text": "„Der Zuwachs an Intelligenz musste immer mit dem Anwachsen von Missmanagement mithalten, sonst hätte man das unglaubliche Missmanagement schon lange bemerkt.“"
                                            },
                                            {
                                                "example_id": "2998f3bd-cf5b-4227-80c7-43ecfdbcf72e",
                                                "sense_id": "d195f450-6ae8-3fb8-805f-2afa7b149082",
                                                "text": "„Zugleich nimmt das Missmanagement der Kolonie groteske Züge an.“"
                                            },
                                            {
                                                "example_id": "daf83370-ad4b-4a80-b21d-c1ab5dc28045",
                                                "sense_id": "d195f450-6ae8-3fb8-805f-2afa7b149082",
                                                "text": "„Wie bei den Staatsstreichen zuvor begründete auch Musharraf seinen Putsch mit politischem Missmanagement und der Verletzung der Autorität des Militärs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
