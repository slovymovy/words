                {
                    "sense_id": "d096ec7c-32ea-3c26-884b-46095096c3bd",
                    "sense_definition": "A famous person who is widely recognized by the general public for their success or accomplishments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor became a huge <w>celebrity</w> after his first major movie.",
                            "target_lang_translations": {
                                "ru": "После своего первого крупного фильма актер стал настоящей <w>знаменитостью</w>.",
                                "zh": "那位演员在出演第一部大片后，成了一位大<w>名人</w>。",
                                "nl": "De acteur werd een grote <w>beroemdheid</w> na zijn eerste grote film.",
                                "pl": "Aktor stał się wielką <w>gwiazdą</w> po swoim pierwszym dużym filmie.",
                                "de": "Der Schauspieler wurde nach seinem ersten großen Film zu einem riesigen <w>Star</w>.",
                                "fr": "L'acteur est devenu une immense <w>célébrité</w> après son premier grand film.",
                                "it": "L'attore è diventato una grande <w>celebrità</w> dopo il suo primo film importante.",
                                "cs": "Z herce se po jeho prvním velkém filmu stala obrovská <w>celebrita</w>.",
                                "tr": "Oyuncu, ilk büyük filminden sonra dev bir <w>ünlü</w> haline geldi.",
                                "es": "El actor se convirtió en una gran <w>celebridad</w> después de su primera película importante."
                            }
                        },
                        {
                            "text": "She enjoys being a <w>celebrity</w> and signing autographs for her fans.",
                            "target_lang_translations": {
                                "ru": "Ей нравится быть <w>знаменитостью</w> и раздавать автографы своим поклонникам.",
                                "zh": "她很享受作为<w>名人</w>的生活，并乐于为粉丝签名。",
                                "nl": "Ze geniet ervan om een <w>beroemdheid</w> te zijn en handtekeningen uit te delen aan haar fans.",
                                "pl": "Lubi być <w>celebrytką</w> i rozdawać autografy swoim fanom.",
                                "de": "Sie genießt es, ein <w>Promi</w> zu sein und ihren Fans Autogramme zu geben.",
                                "fr": "Elle aime être une <w>célébrité</w> et signer des autographes pour ses fans.",
                                "it": "Le piace essere una <w>celebrità</w> e firmare autografi per i suoi fan.",
                                "cs": "Užívá si, že je <w>celebritou</w>, a podepisuje se svým fanouškům.",
                                "tr": "Bir <w>ünlü</w> olmaktan ve hayranlarına imza dağıtmaktan keyif alıyor.",
                                "es": "Ella disfruta ser una <w>celebridad</w> y firmar autógrafos para sus fans."
                            }
                        }
                    ],
