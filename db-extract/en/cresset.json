                    {
                        "sense_id": "8843e77b-5363-3027-8183-9e3504af955b",
                        "entry_id": "92657b5f-823c-3132-80d9-e7a6fece1c70",
                        "glosses": [
                            "A metal cage, basket or cup with fire in it, used for various purposes:",
                            "A metal cup, suspended from or attached to the top of a pole and filled with burning pitch etc., used as portable illumination."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6c5d826b-5e3f-4bf4-b07c-2c560b6881e7",
                                "sense_id": "8843e77b-5363-3027-8183-9e3504af955b",
                                "text": "Starry lamps and blazing cressets, fed / With naphtha and asphaltus."
                            },
                            {
                                "example_id": "270e3412-0653-4e35-9cd5-2ccfce205a3a",
                                "sense_id": "8843e77b-5363-3027-8183-9e3504af955b",
                                "text": "As a cresset true that darts its length / Of beamy lustre from a tower of strength."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e741253-f832-3d71-bd5c-62f6de35c224",
