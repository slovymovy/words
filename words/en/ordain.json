{
    "word_family": [
        "ordination",
        "preordain",
        "foreordain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1675e65d-d349-3462-92d2-92ccca371c43",
                    "sense_definition": "To officially invest someone with ministerial or priestly authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was recently <w>ordained</w> as a minister in the local church after years of study.",
                            "target_lang_translations": {
                                "ru": "После многих лет учёбы её недавно <w>рукоположили</w> в пасторы местной церкви."
                            }
                        },
                        {
                            "text": "The bishop will <w>ordain</w> three new priests at the cathedral this Sunday.",
                            "target_lang_translations": {
                                "ru": "В это воскресенье епископ <w>рукоположит</w> трёх новых священников в соборе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ordained as a priest",
                        "ordained minister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально возводить в сан, наделять духовным саном или полномочиями священнослужителя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукополагать",
                                "target_lang_sense_clarification": "несовершенный вид, посвящать в духовный сан"
                            },
                            {
                                "target_lang_word": "рукоположить",
                                "target_lang_sense_clarification": "совершенный вид, посвятить в священный сан"
                            },
                            {
                                "target_lang_word": "посвящать в духовный сан",
                                "target_lang_sense_clarification": "общее религиозное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5507163d-a4ae-3f7b-9c7d-ed24711ac7ab",
                    "sense_definition": "To officially order, decree, or enact something by law or authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constitution <w>ordains</w> that all citizens have an equal right to justice.",
                            "target_lang_translations": {
                                "ru": "Конституция <w>предписывает</w>, что все граждане имеют равное право на правосудие."
                            }
                        },
                        {
                            "text": "The king had <w>ordained</w> a new period of national mourning throughout the realm.",
                            "target_lang_translations": {
                                "ru": "Король <w>объявил</w> новый общенациональный траур по всему королевству."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально предписывать, постановлять или устанавливать законом либо властным распоряжением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "устанавливать правилом, законом"
                            },
                            {
                                "target_lang_word": "постановлять",
                                "target_lang_sense_clarification": "принимать официальное решение или закон"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "вводить действие нормы или правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "282b6f75-0ab4-351f-a56e-92e359c80eb4",
                    "sense_definition": "To decide, decree, or prearrange fate or destiny, as by God or supernatural force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They firmly believed that fate had <w>ordained</w> their meeting on that quiet evening.",
                            "target_lang_translations": {
                                "ru": "Они свято верили, что судьба <w>предопределила</w> их встречу в тот тихий вечер."
                            }
                        },
                        {
                            "text": "Whatever the gods <w>ordain</w>, human beings must eventually accept.",
                            "target_lang_translations": {
                                "ru": "Что бы ни <w>уготовили</w> боги, людям в конечном счёте приходится с этим смириться."
                            }
                        }
                    ],
                    "synonyms": [
                        "foresay"
                    ],
                    "common_phrases": [
                        "fate ordains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять, предназначать судьбой или высшими силами; предопределять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "заранее определять судьбу"
                            },
                            {
                                "target_lang_word": "уготавливать",
                                "target_lang_sense_clarification": "готовить кому-либо судьбой"
                            },
                            {
                                "target_lang_word": "судить",
                                "target_lang_sense_clarification": "быть сужденным свыше"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}