                "forms": [
                    {
                        "form_id": "67270c8b-3e2e-4628-88ce-11403e8d6849",
                        "entry_id": "895ece0e-19ba-35d1-b862-a0bcaebdd0b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "gravettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "132daa02-66f3-35cb-b8c5-8e35a933eb72",
                        "entry_id": "895ece0e-19ba-35d1-b862-a0bcaebdd0b2",
                        "glosses": [
                            "Granulat utilisé pour le béton, le revêtement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17ce053d-7e93-4323-b63b-26587e9ba8d4",
                                "sense_id": "132daa02-66f3-35cb-b8c5-8e35a933eb72",
                                "text": "Amarrées à la rive d’en face, d’autres péniches somnolaient, lourdes, chargées de broyures, de gravettes et de gravats."
                            },
                            {
                                "example_id": "31486624-1b37-4436-ada7-8c24e8a0a79b",
                                "sense_id": "132daa02-66f3-35cb-b8c5-8e35a933eb72",
                                "text": "Vous y trouverez des matériaux de construction (sable à bâtir, sable à béton, 0/20 concassé, gravette roulée, gravillon concassé, sable filtrant, tout venant pour chemin d’accès, castine calcaire …)"
                            },
                            {
                                "example_id": "2bf3ac0f-47d2-4f99-b821-c57b8b60e24f",
                                "sense_id": "132daa02-66f3-35cb-b8c5-8e35a933eb72",
                                "text": "Surpris dans une épingle particulièrement vicelarde car couverte de gravette roulante, j'enroule en 3 et la TeuMeu dérive gentiment."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7d8110f-457a-30ec-92d0-86f791f63f8d",
                        "entry_id": "895ece0e-19ba-35d1-b862-a0bcaebdd0b2",
                        "glosses": [
                            "Huitre sauvage, non parquée, du bassin d’Arcachon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce5d0b4-4559-4ec2-adc9-cf819f3b3f27",
                                "sense_id": "c7d8110f-457a-30ec-92d0-86f791f63f8d",
                                "text": "Une bonne partie [des huîtres] a été livrée à la consommation dans des conditions peu favorables à la vieille réputation des gravettes d’Arcachon."
                            },
                            {
                                "example_id": "ddf5aa1c-a3ce-4dea-bece-47fa17188d5f",
                                "sense_id": "c7d8110f-457a-30ec-92d0-86f791f63f8d",
                                "text": "A l’origine, les huîtres du bassin d’Arcachon étaient plates. On les appelait les gravettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0d1170c-332f-31c7-9ca6-c7404d24f4cf",
                        "entry_id": "895ece0e-19ba-35d1-b862-a0bcaebdd0b2",
                        "glosses": [
                            "Ver polychète marin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db250e91-bd8a-4a92-a43b-e549979acb4d",
                                "sense_id": "b0d1170c-332f-31c7-9ca6-c7404d24f4cf",
                                "text": "Un pêcheur qui vous donne une gravette vous adresse un vrai signe d’amitié. Il faudra lui rendre la pareille un jour. C’est un peu comme s’il vous offrait le poisson qui va manger cette gravette, et que vous mangerez."
                            },
                            {
                                "example_id": "26531aaa-8208-43eb-93b7-768ddbbd02bb",
                                "sense_id": "b0d1170c-332f-31c7-9ca6-c7404d24f4cf",
                                "text": "De la gravette ! Rassure-toi, ce n’est pas une nouvelle variété de drogue, mais des vers pour la pêche."
                            },
                            {
                                "example_id": "c4e68087-46a6-4779-a192-0d7cac693aba",
                                "sense_id": "b0d1170c-332f-31c7-9ca6-c7404d24f4cf",
                                "text": "Traitement du Covid 19 : la « gravette » bretonne sauvera la planète ?… la recherche continue"
                            }
                        ]
                    }
                ],
