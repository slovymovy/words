                    }
                ],
                "senses": [
                    {
                        "sense_id": "385e577e-357f-3129-8087-08c07409a11b",
                        "entry_id": "62682788-c673-3ccc-84dc-98ae560f0603",
                        "glosses": [
                            "op grotere schaal met de hand vervaardigen van producten door meer vakmensen in één werkplaats\\nDeze productiewijze vormt een overgang tussen ambachtelijke en industriële productie als het gaat om arbeidsdeling, schaalvergroting en mechanisatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b58f5b-7ad5-4c3d-b052-2988bf0821e2",
                                "sense_id": "385e577e-357f-3129-8087-08c07409a11b",
                                "text": "Ik zou ze willen vergelijken met de grondbezittende adel rond het Franse hof van het ancien regime, die zich officieel verre van handel en manufactuur hield maar in feite op allerlei manieren betrokken was bij niet-agrarische activiteiten."
                            },
                            {
                                "example_id": "a9cb052f-73ed-4408-8670-c516391409e2",
                                "sense_id": "385e577e-357f-3129-8087-08c07409a11b",
                                "text": "⧖ De manufactuur is een vorm van produktie waarbij de produkten in fabriekslokalen worden vervaardigd met de hand, met behulp van gereedschappen en eenvoudige werktuigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bb03694-6035-36b0-8828-1edad4e4951b",
                        "entry_id": "62682788-c673-3ccc-84dc-98ae560f0603",
                        "glosses": [
                            "onderneming waar meerdere vakmensen samen met de hand producten vervaardigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d3463d-fa8d-40a2-b64b-9358655df0c9",
                                "sense_id": "8bb03694-6035-36b0-8828-1edad4e4951b",
                                "text": "Ruim duizend gulden voor drieëntwintig delen is naar moderne maatstaven nog niet veel. Duur is pas Meissner porselein, waarvan eenzelfde combinatie meer dan tienduizend gulden kost. Of Herend uit Hongarije, een oude manufactuur die het communisme heeft doorstaan en sinds de bevrijding jaarlijks duurder wordt. Herend heeft uitsluitend handgeschilderde, traditionele decors, en er hangt nog steeds een waas van exclusiviteit omheen."
                            },
                            {
                                "example_id": "4cc4716d-885f-42d9-899b-6512e4bbcde8",
                                "sense_id": "8bb03694-6035-36b0-8828-1edad4e4951b",
                                "text": "De kleine manufactuur beschikte over dertien weefgetouwen, waarvan er tien werkelijk stonden opgesteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9181801-93cf-3afb-b520-9a4100bb502a",
                        "entry_id": "62682788-c673-3ccc-84dc-98ae560f0603",
                        "glosses": [
                            "horlogefabrikant die complete uurwerken zelf kan ontworpen en vervaardigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c409c93d-9e8f-4f59-a88d-8c6202f87934",
                                "sense_id": "a9181801-93cf-3afb-b520-9a4100bb502a",
                                "text": "De term manufactuur is de aanduiding voor uurwerkbedrijven die hun eigen uurwerken ontwerpen en fabriceren."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
