                ],
                "senses": [
                    {
                        "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                        "entry_id": "9d662be2-b1d1-32fc-9fae-c476acde6894",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2810ec0f-e919-45a4-b5bd-8d33e0efeab0",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Frau Bürgel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eca1422b-c7e3-425f-8e93-b84f3f117a1f",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Herr Bürgel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d1e8653-bd3e-44c9-aa07-7d0c004f7fb7",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Die Bürgels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "3bd87d2b-2567-4610-8d04-80b5e38dddce",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Der Bürgel trägt nie die Pullover, die die Bürgel ihm strickt."
                            },
                            {
                                "example_id": "2efcf6fc-470a-4500-941c-63047e59d5dd",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bürgel kommt, geht der Herr Bürgel.“"
                            },
                            {
                                "example_id": "5d508086-8a6c-471f-9836-6c853c4e50af",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Bürgel kommt und geht."
                            },
                            {
                                "example_id": "d6db9043-049d-4ae4-9d96-7e5b25572ad5",
                                "sense_id": "ecb3af19-7b5d-3416-8278-fb551d5690f3",
                                "text": "Bürgels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
