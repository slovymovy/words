                                    },
                                    {
                                        "sense_id": "7b89e245-afaa-3b7c-a45b-663baaa7cf8f",
                                        "entry_id": "de183618-3fac-32b7-ad12-20cecfb577c8",
                                        "glosses": [
                                            "nepravidelně ohraničená oblast na povrchu předmětu s odlišnou barvou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7229ff-e31e-438f-b740-80cfd59b315f",
                                                "sense_id": "7b89e245-afaa-3b7c-a45b-663baaa7cf8f",
                                                "text": "V atmosféře Jupiteru ze pozorovat velkou rudou skvrnu, což je atmosférická bouře o velikosti planety Země."
                                            }
                                        ]
                                    }
