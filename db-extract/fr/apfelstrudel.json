                "senses": [
                    {
                        "sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                        "entry_id": "db1d0ee1-9a37-3ef0-9f1e-1ed6a6a3ff56",
                        "glosses": [
                            "Gâteau aux pommes traditionnel autrichien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c264ee1c-ac04-49e6-acdf-76a80961ecbf",
                                "sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                                "text": "Le cuisinier de Rock est lui aussi rompu au grand jeu : il a mitonné un festival de cuisine viennoise, tafelspitz et apfelstrudel compris."
                            },
                            {
                                "example_id": "3af662ef-67ae-4d05-9807-ccdfd8c4c1b3",
                                "sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                                "text": "Il s’enquit avec une sollicitude ironique de la qualité et de la cuisson du cheeseburger quand celui-ci arriva, et mit un point d’honneur à demander au serveur une longue liste de desserts américains – du cheesecake new-yorkais, un sundae, de la tarte aux myrtilles – pour le compte du malheureux acteur, alors même que monsieur Pacino insistait tout à fait catégoriquement sur son envie de goûter l’Apfelstrudel."
                            },
                            {
                                "example_id": "2f963082-7510-48da-8ed8-749b16a8baa1",
                                "sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                                "text": "Par éviscération abdominale, le légiste (aidé d’une brigade de mitrons) dénombra par ordre d’entrée en scène : 18 tartelettes amandines, 26 pets-de-nonne, 13 paris-brest, 8 polonaises, 3 apfelstrudels, 1 demi saint-honoré, 5 poires Bourdaloue, 6 religieuses, 34 profiteroles, 3 quarts de kugelhopf, 1 brioche à la parisienne, 1 cake à l’ancienne, 3 babas au rhum et 137 éclairs au chocolat et 2 au café."
                            },
                            {
                                "example_id": "1064ac4a-d75d-46ef-894b-f71cd19aa895",
                                "sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                                "text": "Je me fais servir un thé noir et un apfelstrudel dans une vraie vaisselle en céramique, avec de vrais couverts en métal et une vraie serviette en tissu, par un chef de bord qui n’aurait pas dépareillé sur la montagne magique en 1907."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b18a252-9bb8-4627-8e1e-d1fda56a9c39",
                        "source_entry_id": "db1d0ee1-9a37-3ef0-9f1e-1ed6a6a3ff56",
                        "source_sense_id": "f1ca0b49-125f-3354-85c1-60d17c86e354",
                        "target_lang_word": "Apfelstrudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelstrudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                        "entry_id": "93415145-ef1a-3587-b753-5465d7a21b46",
                                        "glosses": [
                                            "Süßspeise aus Strudelteig, der mit kleingeschnittenen Äpfeln gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50acb4cb-31b3-4779-b7f5-43415c12a244",
                                                "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                                "text": "Heute gibt es Apfelstrudel als Nachspeise."
                                            },
                                            {
                                                "example_id": "f4d4e4c1-b2ba-40bf-be1c-8dde8243a488",
                                                "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                                "text": "Und wenn wir brav die Bundeshymne gesungen haben, gibt’s Tafelspitz und Apfelstrudel mit Vanillesauce."
                                            },
                                            {
                                                "example_id": "70146d6a-564d-482a-8b01-a42d63e95de1",
                                                "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                                "text": "„Der warme Apfelstrudel kam.“"
                                            },
                                            {
                                                "example_id": "a750bbd3-739b-46c1-bd37-9ba90a2e4426",
                                                "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                                "text": "„Da wurden Honigkuchen gebacken und Apfelstrudel, süße Rosinen- und Mandelfladen und allerlei Leckerbissen.“"
                                            },
                                            {
                                                "example_id": "f8b4b54b-0171-4c80-b10b-6a2ef95a843a",
                                                "sense_id": "54e3090f-b089-34d7-b7fb-3577dd5dac9f",
                                                "text": "„Schulz spricht so schnell und so viel, dass er seinen Apfelstrudel kaum anrührt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
