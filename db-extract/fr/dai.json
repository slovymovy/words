                        "glosses": [
                            "Personne appartenant au groupe ethnique asiatique des Dai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9fa74b-6cbf-43f4-a6e4-499f9d441ccf",
                                "sense_id": "710fecb9-fead-36eb-9c53-5c4d36ff75eb",
                                "text": "Peuple du sud-ouest de la Chine et d’Asie du Sud-Est, les Dai sont comptés au nombre des cinquante-cinq « minorités nationales » ou « groupes ethniques »."
                            },
                            {
                                "example_id": "8edb2141-245e-4ff0-8424-f2ed5733a9cf",
                                "sense_id": "710fecb9-fead-36eb-9c53-5c4d36ff75eb",
                                "text": "Les frontières restèrent identiques lors de l’intégration de ce petit royaume à l’intérieur des frontières de la Chine communiste et le peuple fut nommé « minorité Dai »."
                            }
                        ]
                    }
