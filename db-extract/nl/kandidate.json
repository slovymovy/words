                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e136daf-0d6f-3312-966f-fbb61e5780ad",
                                        "entry_id": "e754979a-bc04-31b0-a3db-d9ba24166300",
                                        "glosses": [
                                            "A participant in an examination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf6848d-db2b-4145-a690-fd1c6253ba0f",
                                                "sense_id": "0e136daf-0d6f-3312-966f-fbb61e5780ad",
                                                "text": "Candidates must remain silent for the entirety of the exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1f4511f-a210-3e17-b283-b8593b241bbe",
                                        "entry_id": "e754979a-bc04-31b0-a3db-d9ba24166300",
                                        "glosses": [
                                            "Someone or something likely or suited to undergo or be chosen for a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af148a21-83f7-4962-b36d-e2eeece97eca",
                                                "sense_id": "f1f4511f-a210-3e17-b283-b8593b241bbe",
                                                "text": "After being presented with various suitors, she decided none of the candidates were the kind of man she was looking for."
                                            },
                                            {
                                                "example_id": "e4c46bb6-919e-4b16-8c71-6396012a5cca",
                                                "sense_id": "f1f4511f-a210-3e17-b283-b8593b241bbe",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643e03ee-5c9f-3b6d-9de6-9c2e5700cab5",
