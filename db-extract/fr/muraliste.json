                "senses": [
                    {
                        "sense_id": "19f14ae1-537c-3da0-97d5-554b13d315a8",
                        "entry_id": "fb8ce76b-c8cf-35b3-bffc-e3732c8d1a31",
                        "glosses": [
                            "Artiste peintre spécialiste dans les fresques murales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9287172f-2eef-4d25-a932-dfdb25784558",
                                "sense_id": "19f14ae1-537c-3da0-97d5-554b13d315a8",
                                "text": "Selon Orozco, il n’existe aucune faille mentale entre l’ingénieur agronome, le dessinateur architecte, l’étudiant en mathématiques et le muraliste."
                            },
                            {
                                "example_id": "0e47896a-8b2c-4d0d-b6b5-e61267fb62cd",
                                "sense_id": "19f14ae1-537c-3da0-97d5-554b13d315a8",
                                "text": "Les muralistes mexicains nous ont laissé des témoignages précieux de cette nouvelle vision du monde et donnent un visage, une assise à cet homme nouveau, métis, en l’inscrivant dans l’histoire."
                            },
                            {
                                "example_id": "e748888c-8920-4891-8f3f-699c3d2b2710",
                                "sense_id": "19f14ae1-537c-3da0-97d5-554b13d315a8",
                                "text": "C'est à Siqueiros que le muralisme mexicain doit d'avoir été un exemple d’avant-garde d'art monumental, national et révolutionnaire. C'est de son exemple et de sa conception du muralisme que vont largement s'inspirer les muralistes chicanos."
                            }
                        ]
                    }
                ],
