                ],
                "senses": [
                    {
                        "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                        "entry_id": "fce2ed0f-3dbc-37de-99b6-c96eca59fef4",
                        "glosses": [
                            "äußere Fußbekleidung, die die Zehen einzeln umschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00627595-8b73-4e28-befb-a8c59a04f1ab",
                                "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                                "text": "„Muss ja nicht jeder sehen, wie ich versuche, in meine Zehenschuhe zu schlüpfen.“"
                            },
                            {
                                "example_id": "f0d48a64-ee6e-468d-b69f-e33fa78c2feb",
                                "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                                "text": "„Heute trägt Bredack lockere Kleidung, seine Füße stecken in sohlenfreundlichen Zehenschuhen – auch an Tagen, an denen er sich zum Gespräch mit der Journalistin aus Stuttgart aus einem Investorentreffen davonschleicht.“"
                            },
                            {
                                "example_id": "b9983146-0bfe-409c-8ceb-78a09085fa64",
                                "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                                "text": "„Zehenschuhe sind zu eng und drücken so die Mittelfußknochen zusammen, weshalb die Muskeln von Unterschenkel und Fußsohle zu hart arbeiten müssen.“"
                            },
                            {
                                "example_id": "a6d8329f-689c-482f-a2ea-25092bb4ad56",
                                "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                                "text": "„Auch die Zehenschuhe beeinflussen die natürliche Fußbewegung kaum.“"
                            },
                            {
                                "example_id": "cad7fc27-d537-4bda-a366-f835add6d57e",
                                "sense_id": "9df728d6-ff86-34a9-b527-a7552277b04c",
                                "text": "„Micha erzählt ihnen vom Pilgern, von seinen Zehenschuhen und von den Tagen, die er noch vor sich hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
