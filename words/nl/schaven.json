{
    "word_family": [
        "schaaf",
        "schaafsel",
        "geschaafd",
        "bijschaven",
        "afschaven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32adfa8f-29a5-38a1-b71c-f93a18a86c28",
                    "sense_definition": "De huid beschadigen of verwonden door langs een ruw oppervlak te wrijven.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "huid_beschadigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de val op het asfalt <w>schaafde</w> hij zijn knie flink.",
                            "target_lang_translations": {
                                "en": "During the fall on the asphalt, he badly <w>scraped</w> his knee."
                            }
                        },
                        {
                            "text": "Ik viel van mijn fiets en <w>schaafde</w> me gisteren aan mijn arm.",
                            "target_lang_translations": {
                                "en": "I fell off my bike and <w>grazed</w> my arm yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrammen",
                        "schuren"
                    ],
                    "common_phrases": [
                        "je knie schaven",
                        "de huid schaven"
                    ],
                    "target_lang_definitions": {
                        "en": "To damage or injure the skin by rubbing against a rough surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "graze",
                                "target_lang_sense_clarification": "to scrape or scratch the skin"
                            },
                            {
                                "target_lang_word": "scrape",
                                "target_lang_sense_clarification": "to damage skin by rubbing against something rough"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b846b0f5-033e-3559-9373-f74b33259939",
                    "sense_definition": "Hout of een ander materiaal glad of vlak maken met behulp van een schaaf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewerken_met_schaaf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman moet de onderkant van de deur een beetje <w>schaven</w> zodat hij weer goed sluit.",
                            "target_lang_translations": {
                                "en": "The carpenter needs to <w>plane</w> the bottom of the door a bit so that it closes properly again."
                            }
                        },
                        {
                            "text": "Kun je die ruwe plank even voor mij <w>schaven</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>plane</w> that rough board for me?"
                            }
                        }
                    ],
                    "synonyms": [
                        "gladmaken",
                        "vlakken"
                    ],
                    "common_phrases": [
                        "een plank schaven",
                        "hout glad schaven"
                    ],
                    "target_lang_definitions": {
                        "en": "To make wood or another material smooth or flat using a plane."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plane",
                                "target_lang_sense_clarification": "to smooth wood with a tool"
                            },
                            {
                                "target_lang_word": "shave",
                                "target_lang_sense_clarification": "to remove thin layers from wood or material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d39fd7-a0e4-3b87-8a95-5316d03fea6a",
                    "sense_definition": "Voedsel (zoals kaas of kool) in dunne plakjes of sliertjes snijden met een schaaf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewerken_met_schaaf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij helpt in de keuken door de komkommer in dunne plakjes te <w>schaven</w>.",
                            "target_lang_translations": {
                                "en": "She helps in the kitchen by <w>slicing</w> the cucumber into thin slices."
                            }
                        },
                        {
                            "text": "Hij kon de kaas erg goed <w>schaven</w> met de nieuwe kaasschaaf.",
                            "target_lang_translations": {
                                "en": "He was able to <w>slice</w> the cheese very well with the new cheese slicer."
                            }
                        }
                    ],
                    "synonyms": [
                        "raspen",
                        "snijden"
                    ],
                    "common_phrases": [
                        "kaas schaven",
                        "kool schaven"
                    ],
                    "target_lang_definitions": {
                        "en": "To cut food (such as cheese or cabbage) into thin slices or shreds using a slicer or grater."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shave",
                                "target_lang_sense_clarification": "to slice food into very thin pieces"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "to shred food into small pieces"
                            },
                            {
                                "target_lang_word": "slice",
                                "target_lang_sense_clarification": "to cut food into thin slices"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f997ac9-46d8-392f-bd18-01653bf25548",
                    "sense_definition": "Iets figuurlijk verbeteren, verfijnen of eleganter maken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verfijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schrijver bleef urenlang aan zijn tekst <w>schaven</w> om de stijl te verbeteren.",
                            "target_lang_translations": {
                                "en": "The writer kept <w>polishing</w> his text for hours to improve the style."
                            }
                        },
                        {
                            "text": "We moeten nog flink aan dit voorstel <w>schaven</w> voor we het presenteren.",
                            "target_lang_translations": {
                                "en": "We still need to <w>fine-tune</w> this proposal significantly before we present it."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijschaven",
                        "verfijnen",
                        "polijsten",
                        "verbeteren"
                    ],
                    "common_phrases": [
                        "aan een tekst schaven",
                        "een plan schaven"
                    ],
                    "target_lang_definitions": {
                        "en": "To figuratively improve, refine, or make something more elegant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refine",
                                "target_lang_sense_clarification": "to make improvements to a text or plan"
                            },
                            {
                                "target_lang_word": "polish",
                                "target_lang_sense_clarification": "to improve or elegantize a piece of work"
                            },
                            {
                                "target_lang_word": "fine-tune",
                                "target_lang_sense_clarification": "to make small adjustments to improve something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ffe1c17-019f-3393-b6b4-71cf9cf07dda",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>schaaf</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de werkplaats liggen verschillende <w>schaven</w> op de werkbank.",
                            "target_lang_translations": {
                                "en": "There are several <w>planes</w> lying on the workbench in the workshop."
                            }
                        },
                        {
                            "text": "De timmerman gebruikt deze <w>schaven</w> om het hout perfect glad te maken.",
                            "target_lang_translations": {
                                "en": "The carpenter uses these <w>planes</w> to make the wood perfectly smooth."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'schaaf' (plane/scraper)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "planes",
                                "target_lang_sense_clarification": "woodworking hand tools"
                            },
                            {
                                "target_lang_word": "scrapers",
                                "target_lang_sense_clarification": "tools used for scraping"
                            }
                        ]
                    }
                }
            ]
        }
    ]
