                        "sense_id": "05976259-6815-34d3-ab07-ee449cf3669c",
                        "entry_id": "a1dcfdfc-c4bf-3a35-8650-18add1710b8d",
                        "glosses": [
                            "Standardisierte Schnittstelle zum Anschluss peripherer Geräte, wie Drucker, Tastatur, Maus, Massenspeicher usw., an einen Computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b3ea842-f5ac-46e7-983a-8c709950360e",
                                "sense_id": "05976259-6815-34d3-ab07-ee449cf3669c",
                                "text": "„Über USB können heute zahlreiche Gerätetypen angeschlossen werden, die vor der USB-Einführung über eine größere Zahl verschiedener Schnittstellentypen angebunden wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7830768d-f395-4d1c-a9ea-9d9e17a25f0d",
                        "source_entry_id": "a1dcfdfc-c4bf-3a35-8650-18add1710b8d",
                        "source_sense_id": "05976259-6815-34d3-ab07-ee449cf3669c",
                        "source_sense_description": "Standardisierte Schnittstelle zum Anschluss peripherer Geräte an einen Computer",
                        "target_lang_word": "USB",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "USB",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                                        "entry_id": "3bb18ea6-6e45-3533-ad3f-9ea4b59bdb91",
                                        "glosses": [
                                            "Initialism of Universal Serial Bus; a serial bus standard for connecting devices."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "364ac67e-a113-42fa-8a16-0b3b938e44cd",
                                                "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                                                "text": "New signage is being installed to enhance wayfinding and USB sockets are being added in the main concourse area and Platform 8's waiting area."
                                            },
                                            {
                                                "example_id": "4c79cfdc-733e-428f-a748-db9701d4dc13",
                                                "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                                                "text": "USB-C isn’t just how many PC laptops are charged; it’s also how the Chromecast With Google TV draws power. It’s also the only USB port in any modern MacBook, and it’s used for charging and data transfer in many Samsung Galaxy phones (dating back to 2016’s infamous Galaxy Note 7)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a40d09-e198-37da-a494-49697342e66b",
                                        "entry_id": "3bb18ea6-6e45-3533-ad3f-9ea4b59bdb91",
                                        "glosses": [
                                            "Initialism of US Bancorp."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a4236c5-e44c-4f6c-9d27-3635287432f1",
                                                "sense_id": "d2a40d09-e198-37da-a494-49697342e66b",
                                                "text": "Squeri also said during a conference call with analysts Friday morning that AmEx is holding up well despite increased competition from technology companies like Square (SQ) and Venmo owner PayPal (PYPL) as well as traditional card issuers such as Capital One (COF) and US Bancorp (USB)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "USB",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78962ce3-8596-3e47-8722-abff9952630d",
                                        "entry_id": "bc560113-0b37-3c24-a33a-8d0028afa0ce",
                                        "glosses": [
                                            "A USB flash drive."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ec8de4-cba1-4f54-817f-1c8ad354d5ce",
                                                "sense_id": "78962ce3-8596-3e47-8722-abff9952630d",
                                                "text": "Helps you to keep your desk clear from small things like pens, rulers, mobile phone and USBs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b9e6cd-c231-3e54-b7eb-5354e0962adf",
                                        "entry_id": "bc560113-0b37-3c24-a33a-8d0028afa0ce",
                                        "glosses": [
                                            "Initialism of unified S-band (a communication system used for the Apollo program)."
                                        ],
