                        "glosses": [
                            "media op een andere website dan de oorspronkelijke toegankelijk maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b00524-2eba-46ea-a94a-87f95db6e468",
                                "sense_id": "c964b795-d816-3295-a1a9-6983f35bfb22",
                                "text": "Wire combineert allerlei elementen van apps als WhatsApp en Skype. Je kan ermee bellen, elkaar berichten sturen, en muziek, foto's en video delen. Diensten als SoundCloud en YouTube kan je embedden in je gesprekken."
                            },
                            {
                                "example_id": "c0ddc95f-fe2c-434b-919d-c7fef78ad0e8",
                                "sense_id": "c964b795-d816-3295-a1a9-6983f35bfb22",
                                "text": "Het is vanaf nu mogelijk om video's die op Facebook staan te embedden op andere websites. De optie om posts over te nemen bestaat al langer, maar losse video's niet. Met deze zet wordt Facebook in één keer een belangrijke concurrent voor YouTube."
                            },
                            {
                                "example_id": "57fdf19d-2396-4b85-9af4-d80199e67d3b",
                                "sense_id": "c964b795-d816-3295-a1a9-6983f35bfb22",
                                "text": "Net als YouTube is SoundCloud te embedden, wat betekent dat je in dit geval een audiobestand op een andere website kunt zetten en zo makkelijk afluisterbaar maakt."
                            }
                        ]
                    }
