                                    },
                                    {
                                        "sense_id": "c51393a5-9281-34e4-bf48-c64723166f00",
                                        "entry_id": "ec800f21-e551-3216-a0f6-382135f2ff4d",
                                        "glosses": [
                                            "Doctrina ética que se opone al egoísmo"
                                        ],
