                                        "entry_id": "49540fd1-8b91-3a68-935d-4f25a33ded5c",
                                        "glosses": [
                                            "на самом деле, в действительности"
                                        ],
                                        "tags": [
                                            "наречие"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e08bc3b6-a902-4106-893f-d87fc60c01d8",
                                                "sense_id": "d1c49554-0233-3e88-a69f-ea4f23d65b17",
                                                "text": "Он действительно там был."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6281c1a-a399-38aa-8882-32fc37159583",
                                        "entry_id": "49540fd1-8b91-3a68-935d-4f25a33ded5c",
                                        "glosses": [
                                            "разг. употребляется при уверенном подтверждении чьих-либо слов или при выражении согласия с чьим-либо высказыванием, соответствуя по значению словам: да, так, верно, точно"
                                        ],
                                        "tags": [
                                            "част."
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "893ce5b2-8f82-3c1f-bd14-aac08f6851e2",
                                        "entry_id": "49540fd1-8b91-3a68-935d-4f25a33ded5c",
                                        "glosses": [
                                            "употребляется как вводное слово, выражающее подтверждение и соответствующее по значению словам: на самом деле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e9f2dea-5332-4e43-bbf7-fd790915fbf4",
                                                "sense_id": "893ce5b2-8f82-3c1f-bd14-aac08f6851e2",
                                                "text": "Действительно, мы никогда этого не не забудем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
