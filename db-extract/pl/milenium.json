                        ]
                    },
                    {
                        "translation_id": "73476765-7b82-4265-944c-7e86eb1cfe3c",
                        "source_entry_id": "3674298a-a547-39ba-b4b7-ffd28c9e81a5",
                        "source_sense_id": "7ed09ed0-419f-3385-b6e9-12fef8abe4d5",
                        "target_lang_word": "Jahrtausend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jahrtausend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                        "entry_id": "4fc08d86-8174-3ecc-8a4f-0d34267252af",
                                        "glosses": [
                                            "die Zeitspanne von 1000 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94592d15-029f-47fd-8c94-77fc38a89a45",
                                                "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                                "text": "„Der Baum war riesenhaft und wohl Jahrtausende alt.“"
                                            },
                                            {
                                                "example_id": "c2b959db-57fd-4181-9b8e-4d814ef39b3d",
                                                "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                                "text": "„Seit Jahrtausenden nutzen Menschen die Wirkung von Enzymen: Ohne sie gäbe es keinen Joghurt, keinen Wein, kein Bier.“"
                                            },
                                            {
                                                "example_id": "d9f5f2b0-e2d9-47a5-b08b-2a68069bdbf9",
                                                "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                                "text": "„Nicht nur Audi, die gesamte Autowelt hat sich seit Beginn des Jahrtausends verändert.“"
                                            },
                                            {
                                                "example_id": "87f7227b-6988-421e-8329-585df480486a",
                                                "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                                "text": "„Seit Jahrtausenden nutzten die Menschen eine Vielzahl von Energiequellen: Sie verbrannten organische Materialien wie Holz und machten Naturgewalten wie Wind- und Wasserkraft nutzbar.“"
                                            },
                                            {
                                                "example_id": "e7b45da1-0db9-4430-aae3-ad2b61606009",
                                                "sense_id": "15d45da1-ff95-350d-8359-5b54bd468892",
                                                "text": "„Seit einem halben Jahrtausend sind die vier »apokalyptischen Reiter« im kulturellen Bildgedächtnis gegenwärtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
