                "senses": [
                    {
                        "sense_id": "98934cdf-d254-36c3-887e-2ea1684fdc88",
                        "entry_id": "8e392f76-9d21-3038-9d67-cd9a9012a087",
                        "glosses": [
                            "Schiff, das speziell dafür eingerichtet ist, Kranke und Verletzte medizinisch zu versorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "823e69c0-5792-4824-917a-1dfb60b78e1c",
                                "sense_id": "98934cdf-d254-36c3-887e-2ea1684fdc88",
                                "text": "„So erklärten die Soldaten, daß die Ocean Vigour, das erste der Transportschiffe, ein Lazarettschiff mit Milch für Mütter und Kinder sei.“"
                            },
                            {
                                "example_id": "ca9a1ee4-45ee-4e1f-9fc0-76a91d5b9baa",
                                "sense_id": "98934cdf-d254-36c3-887e-2ea1684fdc88",
                                "text": "„Das Lazarettschiff Stuttgart brannte aus.“"
                            },
                            {
                                "example_id": "9b1e9913-2e8b-49d8-9e6d-3bae8ce67ada",
                                "sense_id": "98934cdf-d254-36c3-887e-2ea1684fdc88",
                                "text": "„Erich von Lhomond, der vor Saragossa verwundet und dann auf einem italienischen Lazarettschiff behandelt worden war, wartete am Bahnhofsbüfett von Pisa auf den Zug nach Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
