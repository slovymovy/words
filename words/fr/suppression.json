                        "suppression d'un fichier"
                    ]
                },
                {
                    "sense_id": "a1902458-1023-3b8e-9bb2-6cc43a7479a4",
                    "sense_definition": "Élimination ou abolition de postes de travail au sein d'une organisation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abolition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande entreprise en restructuration a annoncé la <w>suppression</w> de deux cents emplois."
                        },
                        {
                            "text": "Les syndicats se mobilisent massivement pour contester la <w>suppression</w> de ces postes."
                        }
                    ],
                    "antonyms": [
