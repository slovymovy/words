                        "entry_id": "e35b7c69-1851-382f-b24e-b807d2f6a881",
                        "glosses": [
                            "зоол. жук подсемейства Scolytinae (семейство Scolytidae)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d5ca69ff-0255-3bf6-b3b2-5297289ae01d",
                        "entry_id": "e35b7c69-1851-382f-b24e-b807d2f6a881",
                        "glosses": [
                            "разг., шутл. ребёнок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aabf90dc-8aca-4eb7-80b4-d723a6c9c09d",
                                "sense_id": "d5ca69ff-0255-3bf6-b3b2-5297289ae01d",
                                "text": "Уже в армии отслужил и техникум закончил / сейчас в шахте работает / ну и последний короед у меня / во второй класс перешёл."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e421445-3ac3-4661-96d0-7232985079fa",
                        "source_entry_id": "e35b7c69-1851-382f-b24e-b807d2f6a881",
                        "source_sense_description": "жук подсемейства Scolytinae (семейство Scolytidae)",
                        "target_lang_word": "bark beetle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bark beetle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d4a133-9876-3357-b571-048550459922",
                                        "entry_id": "383da521-f9dc-3f2f-878c-00b91562cccf",
                                        "glosses": [
                                            "Any of various beetles, of the subfamily Scolytinae, many of which reproduce in the inner bark of trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52aab352-c226-487b-b662-e08b0f3bd043",
                                                "sense_id": "c8d4a133-9876-3357-b571-048550459922",
                                                "text": "Naval stores production is based upon exploiting the terpene chemical defense system of the pine tree, which protects against wood-decaying fungi and insect pests such as bark beetles (Dendroctonus Ips sp.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29d06d8b-6e00-4342-921d-c8193e038e97",
                        "source_entry_id": "e35b7c69-1851-382f-b24e-b807d2f6a881",
                        "source_sense_description": "жук подсемейства Scolytinae (семейство Scolytidae)",
                        "target_lang_word": "Borkenkäfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Borkenkäfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                        "entry_id": "85965ba9-a5fd-326a-9bc0-2248707c14a9",
                                        "glosses": [
                                            "ein Käfer, der unter der Borke oder im Holz eines Baumes lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f7cf682-7806-421e-98c4-5f3a34561cef",
                                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                                "text": "Der Borkenkäfer mag es warm und trocken."
                                            },
                                            {
                                                "example_id": "1fbd3283-0226-4f91-8db5-a65f580ecc8b",
                                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                                "text": "Borkenkäfer fliegen ab dem Frühjahr auf geschwächt stehende Bäume."
                                            },
                                            {
                                                "example_id": "f1f08623-104f-4ffc-a5e3-2765fcee4130",
                                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                                "text": "Borkenkäfer richten in der Forstwirtschaft große wirtschaftliche Schäden an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af4eae40-ca93-401d-9a85-c35bbf37d17f",
                        "source_entry_id": "e35b7c69-1851-382f-b24e-b807d2f6a881",
                        "source_sense_description": "жук подсемейства Scolytinae (семейство Scolytidae)",
                        "target_lang_word": "bostryche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bostryche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62c43477-97da-3dd9-81eb-631a4b897137",
                                        "entry_id": "df8cdff4-9355-3960-80a9-c7f8c9657e3d",
                                        "glosses": [
                                            "Nom vernaculaire de l’Ips typographus, dont la larve se développant dans le liber des épicéas cause de grands ravages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a06cdbb-b6fe-42a0-8944-5484f2283e0e",
                                                "sense_id": "62c43477-97da-3dd9-81eb-631a4b897137",
                                                "text": "On nous gronda, on nous fit asseoir sur les prie-Dieu en bois, tout pleins de trous de bostryches (chez nous, c'est le bostryche qui fait des trous dans le bois)."
                                            },
                                            {
                                                "example_id": "51a687d0-2954-46d0-af03-ac5e86a588bb",
                                                "sense_id": "62c43477-97da-3dd9-81eb-631a4b897137",
                                                "text": "Les forêts françaises ne sont pas les seules à souffrir de l’épidémie de bostryche qui touche également le Nord de l’Europe, la Belgique, la Tchéquie et l’Allemagne, principalement en Forêt Noire et dans la région de Düsseldorf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
