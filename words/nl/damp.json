{
    "word_family": [
        "dampen",
        "verdampen",
        "dampig",
        "verdamping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8db7515f-df68-3e36-9630-cfa7294ceb5a",
                    "sense_definition": "De gasvormige toestand van een stof die bij kamertemperatuur vloeibaar of vast is, ontstaan door verdamping.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gasvormige_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met de <w>damp</w> die vrijkomt moeten nog proeven worden gedaan.",
                            "target_lang_translations": {
                                "en": "Tests still need to be conducted with the <w>vapour</w> that is released."
                            }
                        },
                        {
                            "text": "De hete soep verspreidde een dichte <w>damp</w> in de koude keuken.",
                            "target_lang_translations": {
                                "en": "The hot soup spread a thick <w>steam</w> in the cold kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "wasem",
                        "dampkring"
                    ],
                    "common_phrases": [
                        "warme damp",
                        "giftige damp"
                    ],
                    "target_lang_definitions": {
                        "en": "The gaseous state of a substance that is liquid or solid at room temperature, produced by evaporation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vapour",
                                "target_lang_sense_clarification": "gaseous state of a substance"
                            },
                            {
                                "target_lang_word": "vapor",
                                "target_lang_sense_clarification": "gaseous state of a substance (US spelling)"
                            },
                            {
                                "target_lang_word": "steam",
                                "target_lang_sense_clarification": "hot water vapor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63731aab-7d68-390f-a299-86058b28d662",
                    "sense_definition": "Een wolk van kleine gecondenseerde waterdruppeltjes in de lucht.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gasvormige_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "'s Ochtends op de fiets rij je steeds door die koude <w>damp</w> heen.",
                            "target_lang_translations": {
                                "en": "In the morning on your bike, you keep riding through that cold <w>mist</w>."
                            }
                        },
                        {
                            "text": "Er hing een dikke <w>damp</w> boven de weilanden na de zware regenval.",
                            "target_lang_translations": {
                                "en": "A thick <w>mist</w> hung over the meadows after the heavy rainfall."
                            }
                        }
                    ],
                    "synonyms": [
                        "mist",
                        "nevel"
                    ],
                    "common_phrases": [
                        "dichte damp",
                        "opstijgende damp"
                    ],
                    "target_lang_definitions": {
                        "en": "A cloud of tiny condensed water droplets in the air."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mist",
                                "target_lang_sense_clarification": "thin fog or condensation in the air"
                            },
                            {
                                "target_lang_word": "haze",
                                "target_lang_sense_clarification": "slight obscuration of the lower atmosphere"
                            },
                            {
                                "target_lang_word": "fog",
                                "target_lang_sense_clarification": "thick cloud of water droplets near the ground"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32630130-c2c4-322b-9fe4-562949e88b74",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>dampen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>damp</w> van het zweet na die intensieve hardloopsessie in het bos.",
                            "target_lang_translations": {
                                "en": "I am <w>steaming</w> with sweat after that intensive running session in the forest."
                            }
                        },
                        {
                            "text": "Als ik buiten in de kou sta, <w>damp</w> ik helemaal door de lichaamswarmte.",
                            "target_lang_translations": {
                                "en": "When I stand outside in the cold, I <w>steam</w> all over due to body heat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'dampen' (to steam, reek, or emit vapor)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steam",
                                "target_lang_sense_clarification": "to emit steam or vapor"
                            },
                            {
                                "target_lang_word": "reek",
                                "target_lang_sense_clarification": "to steam or smoke"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4797f6b7-f18b-38f0-b3e4-2c8c70b40636",
                    "sense_definition": "Gebiedende wijs van <w>dampen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Damp</w> eerst maar eens goed uit voordat je weer naar binnen gaat.",
                            "target_lang_translations": {
                                "en": "Just <w>cool down</w> and let the steam off properly before you go back inside."
                            }
                        },
                        {
                            "text": "Laat die warme soep daar staan en <w>damp</w> rustig af.",
                            "target_lang_translations": {
                                "en": "Leave that hot soup there and let it <w>cool down</w> and stop steaming."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'dampen' (to steam, reek, or emit vapor)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steam",
                                "target_lang_sense_clarification": "to emit steam or vapor (imperative)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f3f3f2-ecfc-34cf-b524-0e223605d3b6",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>dampen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>damp</w> je zo erg als je net uit de douche komt?",
                            "target_lang_translations": {
                                "en": "Why are you <w>steaming</w> so much when you just got out of the shower?"
                            }
                        },
                        {
                            "text": "Als je zo hard rent, <w>damp</w> je vanzelf in deze koude lucht.",
                            "target_lang_translations": {
                                "en": "If you run that fast, you will naturally <w>steam</w> in this cold air."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense of 'dampen' (to steam, reek, or emit vapor)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steam",
                                "target_lang_sense_clarification": "to emit steam or vapor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
