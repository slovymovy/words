                "senses": [
                    {
                        "sense_id": "adfcf25c-d7d4-37c9-a138-66fafb28db6a",
                        "entry_id": "1a25f4d1-81f8-3c29-af40-09132534ef72",
                        "glosses": [
                            "Eigenschaft, in deutlichem Maße unbeständig (unstabil) zu sein, zum Beispiel keine kontinuierliche Verlässlichkeit zu zeigen oder keine dauerhafte Robustheit oder keine haltbare Struktur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec9434c-6612-4394-a0a0-4b3cd17bf2d5",
                                "sense_id": "adfcf25c-d7d4-37c9-a138-66fafb28db6a",
                                "text": "„Aber es gibt Grundnervositäten, die ihre Ursache in geahnten Unstabilitäten der sozialen Verhältnisse haben und die in der Beschäftigung mit Ereignissen, die damit gar nichts zu tun haben, ihren Ausdruck finden.“"
                            }
                        ],
