                "senses": [
                    {
                        "sense_id": "1e6402f4-99f9-355c-83a2-06cdf22f21b0",
                        "entry_id": "05e59bfe-3f0e-3efe-9372-a6db9c50207f",
                        "glosses": [
                            "Rendre milliardaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1982bcee-d36d-4a65-87d8-2c0461cdb855",
                                "sense_id": "1e6402f4-99f9-355c-83a2-06cdf22f21b0",
                                "text": "Ne dit-on pas que l’ANDI a été créée pour milliardairiser le coquin, le gredin et le pendard."
                            },
                            {
                                "example_id": "1b7adede-7065-42bd-8c64-ea805b0d57a8",
                                "sense_id": "1e6402f4-99f9-355c-83a2-06cdf22f21b0",
                                "text": "moi, président, je ferai payer les conneries des financiers et des politiques par les pauvres, tout en continuant de milliardairiser les riches."
                            },
                            {
                                "example_id": "fa617eda-d1a3-4a09-9e02-2c84d12ed1de",
                                "sense_id": "1e6402f4-99f9-355c-83a2-06cdf22f21b0",
                                "text": "Je n’aime pas leurs régimes pourris et cruels, comme vous j'ai autant de colère contre les voyous et parmi eux des noirs et les Africains d’origine ici, mais pour autant j'ai de la compassion et amitié pour les pauvres gens de ces Peuples souvent exploités par leurs dirigeants et abandonnés de leurs diasporas venues se gauberger voire se \"milliardairiser\" égoistement en France et ailleurs en Occident au lieu d’aider les leurs à se développer dans leurs pays d’origine."
                            }
                        ]
                    }
                ],
