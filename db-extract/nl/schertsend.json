        "nl-extract.jsonl": [
            {
                "entry_id": "6603c34c-abbe-39f2-997e-6171b26b6461",
                "word": "schertsend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98cafcbd-afb9-33d2-b6cc-cb22e8d2acee",
                        "entry_id": "6603c34c-abbe-39f2-997e-6171b26b6461",
                        "glosses": [
                            "op een grappige manier spottend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50df66b0-e376-4169-886a-743fce55dd5f",
                                "sense_id": "98cafcbd-afb9-33d2-b6cc-cb22e8d2acee",
                                "text": "De collega-journalist in kwestie die de Pahmos-dame opvoert en de wekker zet – om op schertsende wijze aan te geven dat hij voor dag en dauw opstaat omdat hij niet kan wachten op die ochtendkrant met dat verpletterende artikel over de gemeenteraadsvergadering – relativeert het nieuws en de achtergronden uit bestuurlijke hoek daarmee op ironische wijze."
                            },
                            {
                                "example_id": "4b3ed1bf-5552-4514-93c2-cf7976281c94",
                                "sense_id": "98cafcbd-afb9-33d2-b6cc-cb22e8d2acee",
                                "text": "In 1997 werd hij voorlichter van de CDA-fractie en, na een korte onderbreking in 2001, groeide hij door tot persoonlijk adviseur van Jan Peter Balkenende. Met slim, slagvaardig en succesvol optreden verwierf hij status in het perskorps, al kon dat niet voorkomen dat hij de schertsende bijnaam ‘Jack het Lek’ kreeg opgeplakt, verwijzend naar zijn gewoonte om kranten en tv-programma’s te voorzien van ‘informatie uit betrouwbare bron’. HP de Tijd 21/05"
                            },
                            {
                                "example_id": "4b35b17c-ab6e-4a44-98b4-30c83f49c55c",
                                "sense_id": "98cafcbd-afb9-33d2-b6cc-cb22e8d2acee",
                                "text": "Gelukkig heeft een van de populairste aanbieders van gratis pornografie, PornHub, een eigen onderzoeksbureau dat zo nu en dan schertsende onderzoekjes publiceert over pornoconsumptie in Noord-Korea en tijdens het WK Voetbal. HP de Tijd 01/10"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efc84d3c-0e22-4c2a-add0-218a11c6b131",
                        "source_entry_id": "6603c34c-abbe-39f2-997e-6171b26b6461",
                        "source_sense_id": "98cafcbd-afb9-33d2-b6cc-cb22e8d2acee",
                        "source_sense_description": "op een grappige manier spottend",
                        "target_lang_word": "facetious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facetious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2b0493-b207-3932-a6ce-4c61cff85e40",
                                        "entry_id": "f8f5b4de-4761-3401-86eb-55a545b7c93d",
                                        "glosses": [
                                            "Treating serious issues with (often deliberately) inappropriate humour; flippant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af07602c-24ea-4547-85a6-d076d794656c",
                                                "sense_id": "ca2b0493-b207-3932-a6ce-4c61cff85e40",
                                                "text": "Robbie's joke about Heather's appearance was just him being facetious."
                                            },
                                            {
                                                "example_id": "3f50f979-6710-481d-a4fc-f1b09914ddc7",
                                                "sense_id": "ca2b0493-b207-3932-a6ce-4c61cff85e40",
                                                "text": "Troutbeck is a tiny village midway between Penrith and Keswick in a very sparsely populated part of Cumberland, and it used to be said by facetious travellers that the reason why it ever had a station at all was to give the engine a rest after it had struggled up the long and trying incline from Threlkeld."
                                            },
                                            {
                                                "example_id": "6ff4adc2-164e-4755-9937-a259e3ef5a79",
                                                "sense_id": "ca2b0493-b207-3932-a6ce-4c61cff85e40",
                                                "text": "Glamour for its own sake is not something I have ever been particularly interested in,” Stella McCartney said backstage after her catwalk show. Which could sound like a facetious statement from a fashion designer who was, at that moment, standing among the marble-slabbed floors, elaborately frescoed ceilings and giant chandeliers of the Palais Garnier opera house, where the show was staged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6485f7e8-1342-37d1-a49d-9312f533470e",
                                        "entry_id": "f8f5b4de-4761-3401-86eb-55a545b7c93d",
                                        "glosses": [
                                            "Pleasantly humorous; jocular."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d39eb55d-deba-35a1-ba53-547210508fbc",
                                        "entry_id": "f8f5b4de-4761-3401-86eb-55a545b7c93d",
                                        "glosses": [
                                            "humorously silly or counterproductive for the purpose of sarcastically advocating the opposite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
