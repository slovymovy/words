            {
                "entry_id": "f5f99632-68e8-3584-83de-36f97c9747b0",
                "word": "moorish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6c9e18ae-1753-471c-83bb-585b8646eef6",
                        "entry_id": "f5f99632-68e8-3584-83de-36f97c9747b0",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more moorish"
                    },
                    {
                        "form_id": "2e48abb4-71a7-4f17-bad2-44c0ee59c7e0",
                        "entry_id": "f5f99632-68e8-3584-83de-36f97c9747b0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most moorish"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9792332-52c8-3e27-bd6a-975e688a7070",
                        "entry_id": "f5f99632-68e8-3584-83de-36f97c9747b0",
                        "glosses": [
                            "Of ground, soil etc: boggy, marshy."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d89d9769-216b-49c8-b73d-c800a531daba",
                                "sense_id": "d9792332-52c8-3e27-bd6a-975e688a7070",
                                "text": "Make heauen to frowne and euery fixed ſtarre\nTo ſucke vp poiſon from the Mooriſh Fens,\nAnd poure it in this glorious Tyrants throat."
                            },
                            {
                                "example_id": "ad326d11-875d-4a8a-bffa-f37db472a391",
                                "sense_id": "d9792332-52c8-3e27-bd6a-975e688a7070",
                                "text": "[G]low-worms, fire-drakes, meteors, ignis fatuus […] with many such that appear in moorish grounds, about churchyards, moist valleys, or where battles have been fought […] ."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b41a78b-5dcd-30d7-8ece-9b14785db4c8",
                        "entry_id": "f5f99632-68e8-3584-83de-36f97c9747b0",
                        "glosses": [
                            "Resembling or characteristic of a moor; abounding in moorland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5993ea34-6332-42a5-ae0b-0aace48500ee",
                                "sense_id": "3b41a78b-5dcd-30d7-8ece-9b14785db4c8",
                                "text": "He recommended to me to plant a considerable part of a large moorish farm which I had purchased, and he made several calculations of the expence and profit: for he delighted in exercising his mind on the science of numbers."
                            },
                            {
                                "example_id": "32e085e5-6252-47f1-b30d-e886fd9d80c6",
                                "sense_id": "3b41a78b-5dcd-30d7-8ece-9b14785db4c8",
                                "text": "The Lent term had pulled me down, a week of modest enjoyment thereafter in town had finished the work; and I drank in the sharp moorish air like a thirsty man who has been forwandered among deserts."
                            }
                        ]
                    }
                ],
