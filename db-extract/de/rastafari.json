                        "sense_id": "af3901b6-ff80-303d-a2aa-234feab86272",
                        "entry_id": "645a2d8b-cd31-33a5-8fb1-7732073f7343",
                        "glosses": [
                            "Eine zu Beginn des 20. Jahrhunderts in Jamaika entstandene religiöse Bewegung, die Haile Selassie als Gott verehrt."
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3fad2b02-95a3-3e85-b0a7-28705ca20f8b",
                        "entry_id": "645a2d8b-cd31-33a5-8fb1-7732073f7343",
                        "glosses": [
                            "Anhänger von [1]."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d39e3c-a900-4f63-b046-7d03d7d8b4bc",
                                "sense_id": "3fad2b02-95a3-3e85-b0a7-28705ca20f8b",
                                "text": "„Da die verfilzten Locken der Rastafari dem Schönheitsideal der Weißen nun so gar nicht entsprachen, wurden sie von Außenstehenden als bedrohlich oder abstoßend empfunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
