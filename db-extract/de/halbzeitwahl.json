                    {
                        "sense_id": "82aca892-132e-3d21-ac04-42ce7b46f9cb",
                        "entry_id": "1540dcdf-b73b-3888-86cd-636528995d65",
                        "glosses": [
                            "Wahl von etwa einem Drittel der Senatoren und dem gesamten Repräsentantenhaus in den Vereinigten Staaten von Amerika, die nach der Hälfte der Amtszeit des US-Präsidenten durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2f5172-f609-406d-89f0-9dc51404dc31",
                                "sense_id": "82aca892-132e-3d21-ac04-42ce7b46f9cb",
                                "text": "„In Washington drohen die nach der Halbzeitwahl erstarkten Republikaner die Ratifizierung des Start-Abrüstungsvertrages zu blockieren.“"
                            },
                            {
                                "example_id": "ca478588-1d6d-4b6b-9301-698a2bd23fec",
                                "sense_id": "82aca892-132e-3d21-ac04-42ce7b46f9cb",
                                "text": "„Noch nie ist ein Präsident zu einer Halbzeitwahl mit derartig geringer Zustimmung angetreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
