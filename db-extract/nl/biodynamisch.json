                        "sense_id": "955881a4-6f80-3f6d-bda3-1018630535a9",
                        "entry_id": "16a3e50f-6535-3877-94a5-6199b6d4eaa4",
                        "glosses": [
                            "volgens de leer van de antroposofie"
