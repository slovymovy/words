                ],
                "senses": [
                    {
                        "sense_id": "91448476-31cd-3cdf-ae6a-288ddbf0e3d1",
                        "entry_id": "02cdd9ae-670f-3c17-a5b7-54000075a6ca",
                        "glosses": [
                            "Spaziergang im Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d838494c-7c9d-4f78-a19d-b4be6ecaac42",
                                "sense_id": "91448476-31cd-3cdf-ae6a-288ddbf0e3d1",
                                "text": "Wir genossen unseren ruhigen Herbstspaziergang im Wäldchen."
                            },
                            {
                                "example_id": "447c8a6a-f96e-4e57-836a-7ea4e3e927f3",
                                "sense_id": "91448476-31cd-3cdf-ae6a-288ddbf0e3d1",
                                "text": "„Komm, lass uns noch einen kurzen Herbstspaziergang machen, bevor es dunkel wird.“"
                            },
                            {
                                "example_id": "3e0a0168-7613-46c5-8e50-db29c2559852",
                                "sense_id": "91448476-31cd-3cdf-ae6a-288ddbf0e3d1",
                                "text": "„Ach, was könnte man jetzt für schöne Herbstspaziergänge machen und abends nach Geschäftsschluss miteinander durch den herbstlichen Abend heimwandern Hand in Hand.“"
                            },
                            {
                                "example_id": "cc2dda89-6e91-45f1-b5c0-8de968c5bcde",
                                "sense_id": "91448476-31cd-3cdf-ae6a-288ddbf0e3d1",
                                "text": "„Bei mir war es zum Beispiel ein Kaffee, der mir einfach mal so ausgegeben wurde, ein Smiley in einem Brotlaib, der mir beim Abendessen entgegengrinste, ein eingeritztes Herz auf einem Baumstamm, das ich während eines Herbstspaziergangs entdeckte […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
