                "senses": [
                    {
                        "sense_id": "343ba45f-de11-3287-97c6-375934fe5e5c",
                        "entry_id": "53ea2905-dc7d-35d7-8df1-33c7e02ab9b8",
                        "glosses": [
                            "Préparer l’incubation de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d59dbbb-a8dd-4868-a8fb-95f877c290fd",
                                "sense_id": "343ba45f-de11-3287-97c6-375934fe5e5c",
                                "text": "Epitech Experience sert à pré-incuber les projets de nos étudiants, pour qu’à la fin de leur scolarité, ils aient le choix entre devenir des collaborateurs d’entreprise ou des entrepreneurs."
                            },
                            {
                                "example_id": "dbbba275-a235-4c07-96f4-f2a8326f8c30",
                                "sense_id": "343ba45f-de11-3287-97c6-375934fe5e5c",
                                "text": "Je me demandais, lors de la purification de l'ADN, pourquoi est-il nécessaire de pré-incuber la RNase à 85°C pendant 15 min?"
                            },
                            {
                                "example_id": "e34a93d4-2d0d-49cb-98da-1ceef66e1046",
                                "sense_id": "343ba45f-de11-3287-97c6-375934fe5e5c",
                                "text": "Pré-incuber ces tubes quelques minutes à 20°C."
                            },
                            {
                                "example_id": "8c453198-0458-44d6-ad99-2838f6aff14a",
                                "sense_id": "343ba45f-de11-3287-97c6-375934fe5e5c",
                                "text": "Pré-incuber ou préchauffer les œufs."
                            }
                        ]
                    }
