                ],
                "senses": [
                    {
                        "sense_id": "3530d4eb-5d5a-324b-8371-8033288ef9a7",
                        "entry_id": "4d14ba4e-18b3-3a80-8aa1-5366b1b1c749",
                        "glosses": [
                            "derjenige zweite Fluss (Strom) von Stoffen/Energie/Wasser, der im Verhältnis zu einem ersten existierenden Fluss, in die entgegengesetzte Richtung fließt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "5392a36b-a93f-499b-be3f-5f070c3ae4d1",
                                "sense_id": "3530d4eb-5d5a-324b-8371-8033288ef9a7",
                                "text": "„Bekanntermaßen erzeugt jegliche Strömung auch einen Gegenstrom, den sogenannten Neerstrom. Kanuten wissen das – und wissen deshalb auch das kleinste „Kehrwasser“ zu nützen.“"
                            },
                            {
                                "example_id": "0f7e084d-c035-42c9-958e-972f6677ee6f",
                                "sense_id": "3530d4eb-5d5a-324b-8371-8033288ef9a7",
                                "text": "„Sobald nun der Gegenstrom die Oberhand gewinnt, wird sich die Richtung des Stromes umkehren. Dies hat aber zur Folge, daß auch die Magnete von einem Strom entgegengesetzter Richtung umflossen und ihre Pole umgekehrt werden.“"
                            },
                            {
                                "example_id": "2862249e-5cea-449e-ab1a-88bcab8de9e6",
                                "sense_id": "3530d4eb-5d5a-324b-8371-8033288ef9a7",
                                "text": "„In industriellen Anlagen wird zu einem großen Teil der Wärme- und Stoffaustausch zwischen zwei Phasen im Gegenstrom bewirkt wie beispielsweise bei der Rektifikation zwischen Dampf und Flüssigkeit.“"
                            },
                            {
                                "example_id": "101b52df-9823-433a-b23b-3b6028886e59",
                                "sense_id": "3530d4eb-5d5a-324b-8371-8033288ef9a7",
                                "text": "„In einer ökonomischen Betrachtungsweise können unter dem ›Eigenwert‹ alle (meist immateriellen) Gegenströme zusammengefaßt werden, die einem Individuum aufgrund seiner Arbeitsleistung zufließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
