                    {
                        "translation_id": "b8206688-ca4e-4cf0-9f78-b0042d27d6d3",
                        "source_entry_id": "facce4c9-c5c6-3fbb-b323-ca76f88fc0ba",
                        "source_sense_id": "e8ba356c-e03f-318b-a3e7-3ecb58770a9d",
