                ],
                "senses": [
                    {
                        "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                        "entry_id": "14419e73-35ca-3a06-8d98-118eacb07205",
                        "glosses": [
                            "besondere Sprachform, charakteristische Sprachverwendung einer durch soziale Eigenschaften wie zum Beispiel Einkommen, Geschlecht, Schichtzugehörigkeit definierten Menge von Mitgliedern einer Sprachgemeinschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7093944-3fcb-4bd8-9cc4-75e7fcb62d26",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "Soziolekte sind z.B. die Gruppensprachen von Mitgliedern der Mittel- oder der Oberschicht, der jungen und der alten Menschen, etc."
                            },
                            {
                                "example_id": "2b00a1ce-a8d2-4e85-a5ab-99c8d492b9d2",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "„Während der Terminus Dialekt die Sprache einer bestimmten Region bezeichnet, ist Gruppensprache ein Sammelbegriff für die Sprachvarietäten von bestimmten ethnischen und religiösen, Alters- und Berufsgruppen sowie sozialen Schichten.“"
                            },
                            {
                                "example_id": "956607ad-bd90-457b-bc24-938c929de334",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "„So kann ein Dialekt auch auf eine soziale Gruppe begrenzt und so eine Gruppensprache sein… “"
                            },
                            {
                                "example_id": "cb0aa3c5-a21e-4137-acbd-f8ed837d5261",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "„Zu Sondersprachen gehören Sondergemeinschaften, die mit Hilfe von Gruppensprachen eine Gruppenidentität schaffen und sich von anderen Gruppen abgrenzen wollen.“"
                            },
                            {
                                "example_id": "e0d75dde-43c1-458a-bdb0-e68d4968b503",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "„Es bildete sich eine chassidische Gruppensprache heraus, die das moderne Jiddisch beeinflusste.“"
                            },
                            {
                                "example_id": "51737de4-b091-457a-8b9a-12dcbcb0c524",
                                "sense_id": "04c8299a-4b7f-356d-a484-2af67837c8e2",
                                "text": "„Die Juden aus Spanien hatten ihr altes Spanisch des 15. Jahrhunderts mitgebracht, das seit der Vertreibung von 1492 ihre Gruppensprache geblieben war, in ihrem Gottesdienst wurde Hebräisch gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
