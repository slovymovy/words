                                "target_lang_sense_clarification": "A viscous preparation, usually containing medication, used as a treatment."
                            },
                            {
                                "target_lang_word": "cream",
                                "target_lang_sense_clarification": "A viscous aqueous oil or fat emulsion with a medicament added."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ae625c2-5d85-3167-9e81-a817f4607c74",
