        "fr-extract.jsonl": [
            {
                "entry_id": "d6322316-592e-39e6-b203-f6c8d9404d3c",
                "word": "houppelande",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b274538-b4af-447f-9415-70c0e0d6a9f9",
                        "entry_id": "d6322316-592e-39e6-b203-f6c8d9404d3c",
                        "tags": [
                            "plural"
                        ],
                        "form": "houppelandes"
                    },
                    {
                        "form_id": "cada1cf3-363a-4907-a03a-88d49158f842",
                        "entry_id": "d6322316-592e-39e6-b203-f6c8d9404d3c",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\u.p(ə).lɑ̃d\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                        "entry_id": "d6322316-592e-39e6-b203-f6c8d9404d3c",
                        "glosses": [
                            "Pardessus, long manteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d641bb4-de9e-4256-8f09-d10ff6b7a0a6",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Le chevalier de la paix attrapa sur le col de sa houppelande je ne sais quel insecte, qu'il écrasa sur son ongle à la lueur d'un réverbère."
                            },
                            {
                                "example_id": "1067ec76-a1b0-4303-b1fd-47019ba29b49",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Nous étions en hiver, et Mongenod n’avait point de manteau, car quelques larges gouttes de neige fondue et tombées des toits, le long desquels il avait dû marché, jaspaient le collet de sa houppelande."
                            },
                            {
                                "example_id": "5ea5328e-d2cd-44c2-923b-f1b0f1bcb9a3",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Deux ceintures d'or de broderie qui sont assises sur l'espaulle senestre de deux houppelandes."
                            },
                            {
                                "example_id": "fc76eafb-d560-4b5c-a61b-5a9704ea3518",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Cependant il est un agent de la Compagnie, qui ne doit pas quitter son poste, c’est Popof, – Popof, notre chef de train, un vrai Russe, l’air militaire avec sa houppelande plissée et sa casquette moscovite, très chevelu et très barbu."
                            },
                            {
                                "example_id": "07419b23-d328-4e34-81e0-247e67540821",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Mais du moins des provisions et une grande houppelande lui furent-elles laissées pour son confort."
                            },
                            {
                                "example_id": "5d55ea1f-4822-419e-94b0-97062fb38166",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Un jour, il me trouva dans une allée du parc, assis sur un banc de pierre ; je me rappelle que je lisais le traité de Clarke sur l’Existence de Dieu. Selon mon habitude, j’étais enveloppé dans une épaisse houppelande. « Oh ! le cher petit trésor, dit-il en s’approchant. Mon Dieu, qu’il est donc joli là, si bien empaqueté ! Oh ! ne le dérangez pas. Voilà comme il sera toujours... Il étudiera, étudiera sans cesse ; mais, quand le soin des pauvres âmes le réclamera, il étudiera encore. Bien fourré dans sa houppelande, il dira à ceux qui viendront le trouver : « Oh ! Laissez-moi, laissez-moi. » Il s’aperçut que le trait avait porté juste."
                            },
                            {
                                "example_id": "291a8ba3-456d-4d51-8131-fa912a37c964",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "Qu’elle était jolie avec ses yeux doux, sa barbiche de sous-officier, ses sabots noirs et luisants, ses cornes zébrées et ses longs poils blancs qui lui faisaient une houppelande !"
                            },
                            {
                                "example_id": "88f35c33-349b-4e51-b238-3d9fc1b2340a",
                                "sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                                "text": "— Je crois que neuf heures viennent de tinter à la cathédrale. Ma bonne sœur, voici le moment de partir…\n— Vous avez raison. Je monte chercher nos houppelandes…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0659f9ab-8c12-4401-b097-6430dd9def9d",
                        "source_entry_id": "d6322316-592e-39e6-b203-f6c8d9404d3c",
                        "source_sense_id": "6a5f7bca-8015-3bd3-a096-32af5e7dc79a",
                        "target_lang_word": "cloak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cabc68b-6245-3f8f-8789-9643c5e2a8f5",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A long outer garment worn over the shoulders covering the back; a cape, often with a hood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfa46e5-a800-4357-81c6-b38d36314e9c",
                                                "sense_id": "0cabc68b-6245-3f8f-8789-9643c5e2a8f5",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee674815-cc29-3cd8-9388-cee1cb65bdf8",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A blanket-like covering, often metaphorical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ec2a16-688c-4d6a-b6df-0c3a82736334",
                                                "sense_id": "ee674815-cc29-3cd8-9388-cee1cb65bdf8",
                                                "text": "Night hid her movements with its cloak of darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "That which conceals; a disguise or pretext."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd80a29f-0d66-459a-934f-8b332a6a0140",
                                                "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                                "text": "For neither at any time vſed wee flattering wordes, as yee knowe, nor a cloke of couetouſneſſe, God is witneſſe: […]"
                                            },
                                            {
                                                "example_id": "c47a3532-53ac-48ed-b14b-6927d9636933",
                                                "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                                                "text": "And no Man is eſteemed any ways conſiderable for Policy, who wears Religion otherwiſe than as a Cloak; that is, as ſuch a Garment as may both cover and keep him warm, and yet hang looſe upon him too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652d8ab2-0582-3c7d-b585-2764f1026349",
                                        "entry_id": "2b4fc76a-cb0f-313c-a753-69d96f895b81",
                                        "glosses": [
                                            "A text replacement for an IRC user's hostname or IP address, making the user less identifiable."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cloak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f13fa39c-052b-3da3-acc1-d02df7bcdfdb",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To cover as with or like a cloak."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34d6adb-8512-45b9-beb0-698cd2b15d9c",
                                                "sense_id": "f13fa39c-052b-3da3-acc1-d02df7bcdfdb",
                                                "text": "He would hold her, just hold her, while his hands soothed the bare skin of her arms and the delicate fabric that cloaked her shoulders and her back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f9bf25-d8f8-3314-88b3-5f52bff26e95",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To cover up, hide or conceal."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f1c414-0b2b-4fae-bef0-a43a1db9b24e",
                                                "sense_id": "e2f9bf25-d8f8-3314-88b3-5f52bff26e95",
                                                "text": "It’s possible that some microbes don’t just take up residence in tumors but help them grow. They may cloak the tumor from the immune system, neutralize drugs or help tumors spread through the body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1ec633-9034-33eb-96bb-2305f3ffe407",
                                        "entry_id": "5fc90756-6985-38c1-88b3-88fb75f8dce7",
                                        "glosses": [
                                            "To render or become invisible via futuristic technology."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d02b98-c051-483e-aedd-dd6e45e5a92b",
                                                "sense_id": "5c1ec633-9034-33eb-96bb-2305f3ffe407",
                                                "text": "The ship cloaked before entering the enemy sector of space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
