                "senses": [
                    {
                        "sense_id": "e9282a7b-567f-3ea8-af76-8f11a5744a00",
                        "entry_id": "9de141a8-84c9-3373-9bdf-274af1ba86d7",
                        "glosses": [
                            "zonder enige terughoudendheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0d9ce1-7711-48eb-9975-4300c08f9eca",
                                "sense_id": "e9282a7b-567f-3ea8-af76-8f11a5744a00",
                                "text": "\"Aan politieke correctheid heeft De Winter een broertje dood, unverfroren gaat hij de discussie aan over een veelheid van onderwerpen,\" staat in het juryrapport. \"Hij durft over precaire onderwerpen als het antisemitisme onder moslims te schrijven.\""
                            },
                            {
                                "example_id": "5c4ebb52-f7ff-4319-95a9-a57ed3df3aa2",
                                "sense_id": "e9282a7b-567f-3ea8-af76-8f11a5744a00",
                                "text": "Anderen grijpen de gelegenheid aan om nog eens unverfroren de vervangingstheologie voor het voetlicht te halen. Na het afwijzen van de Messias mag volgens hen de benaming Israël alleen nog maar in geestelijke zin voor Gods volk worden gebruikt."
                            },
                            {
                                "example_id": "6cb913d9-7514-44a0-a1b8-74cae9e76960",
                                "sense_id": "e9282a7b-567f-3ea8-af76-8f11a5744a00",
                                "text": "Ten Broeke kon het niet begrijpen dat het CDA, dat niets moet hebben van referenda en dat een warm voorstander is van de representatieve democratie, nu zo unverfroren pleit voor een onvoorwaardelijk uitvoeren van de nee-stem bij het Oekraïnereferendum."
                            }
                        ]
                    }
