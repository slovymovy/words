                "senses": [
                    {
                        "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                        "entry_id": "e845b474-d0fb-3938-b957-c5feb72b42aa",
                        "glosses": [
                            "Aktivierung des angeborenen Immunsystems, Versuch der Aktivierung des angeborenen Immunsystems mit dem Effekt, dass die geimpfte Person anfälliger für die Krankheit wird, statt immun dagegen"
                        ],
                        "tags": [
                            "Impfstoff",
                            "meist aber über die unerwünschte Wirkung/Nebenwirkung einer Impfung"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6d1e38-83cc-47c0-9a28-6523969a50cd",
                                "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                                "text": "„Experten sprechen von einer ‚Immunverstärkung‘. Es wäre ein Albtraumszenario für eine klinische Studie, vor allem wenn diese in einer Region wie Seattle durchgeführt wird, in der das Virus zirkuliert. ‚Wenn wir eine solche Immunverstärkung in einem Tierversuch sehen, ist das ein starkes Zeichen, nicht voranzugehen‘, sagt der Mikrobiologe Peter Hotez vom Texas Children’s Hospital, der federführend einen Sars-Impfstoff mitentwickelt hat, dem SPIEGEL.“"
                            },
                            {
                                "example_id": "3a1c4e3c-1207-4c31-99ef-e7991450d712",
                                "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                                "text": "„Das ist deswegen eine Überlegung, dass man sich fragt, also ein einfacher Totimpfstoff, den könnte man in rauen Mengen in vielen Ländern der Welt gleichzeitig herstellen. Es gibt aber auch viele Einwände dagegen - aus schlechten Erfahrungen, die man gemacht hat, gerade auch mit Coronavirus-Totimpfstoffen, wegen dieser Immunverstärkung der Krankheit.“"
                            },
                            {
                                "example_id": "3ebc6721-5579-47f6-90ab-1fc17069aa7e",
                                "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                                "text": "„Zirkulierendes humorales IgG kann jedoch eine Verstärkung der Krankheit, die so genannte ‚Antikörper-abhängige Immunverstärkung‘ (antibodydependent enhancement, ADE) verursachen.“"
                            },
                            {
                                "example_id": "0e2065ea-163b-4f70-96be-d0f3683c9ecc",
                                "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                                "text": "„Die in Princeton ansässige BBI, ein internationales Spezialpharmazeutika-Unternehmen, wird auch am präklinischen Forschungs- und Produktentwicklungsprogramm von Baylor zur Förderung neuartiger Ansätze für Impfstoffe mit nachgewiesener Wirksamkeit und ohne Immunverstärkung gegen MERS und SARS teilnehmen.“"
                            },
                            {
                                "example_id": "e548b6cc-b0ca-4a8b-abda-491c8604d482",
                                "sense_id": "b37638c3-b45c-3d67-b28e-db1688b0b144",
                                "text": "im Sinne von Aktivierung/Stärkung: „In der Onkologie wird IL-2 (neben Interferon-α) schon seit Jahren zur Immunverstärkung verwendet und Ciclosporin A zu seiner Hemmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
