                            {
                                "example_id": "f42408b6-aa04-480d-b727-9f1f0c04310c",
                                "sense_id": "19d3f8f4-a247-36f7-ad31-d00b19f72c38",
                                "text": "Ondanks de schade aan zijn gestel en de Italiaanse hitte zette Matthews dapper door. De traditioneel hectische finale moet hem een stevige adrenalinestoot hebben gegeven, want Bling bleek uiteindelijk sterk genoeg om zijn 22 concurrenten te verslaan in de spurt."
                            },
                            {
                                "example_id": "14eb5c2a-d523-48db-a501-ffd7c6ed8e26",
                                "sense_id": "19d3f8f4-a247-36f7-ad31-d00b19f72c38",
                                "text": "Hier wordt de laatste grote adrenalinestoot voor de wedstrijd genoten. Op naar Madrid straks, voor de finale? Zeker weten, klinkt het weer vol bravoure."
                            }
                        ]
                    }
