                "senses": [
                    {
                        "sense_id": "fbf6afa8-b95d-3950-8c6f-9a1814473bc1",
                        "entry_id": "be4ce15c-333a-37f5-ad28-6f1cf85b4f6b",
                        "glosses": [
                            "Annuler (un arbitrage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d01b70-cca3-407f-a174-6b22bd6eb3ef",
                                "sense_id": "fbf6afa8-b95d-3950-8c6f-9a1814473bc1",
                                "text": "A force d’entendre des arguments de 3, 4 ou 5 élus dans cet hémicycle, on a un peu désarbitré la chose, pas totalement, mais on a repris des études et pensé différemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3bbce60-b6a1-3fa4-8f96-d542f71a84fa",
                        "entry_id": "be4ce15c-333a-37f5-ad28-6f1cf85b4f6b",
                        "glosses": [
                            "Arbitrer d'une façon non conforme au rôle normal d’un arbitre."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b602e6c6-a68d-4357-90aa-0832f8f40013",
                                "sense_id": "a3bbce60-b6a1-3fa4-8f96-d542f71a84fa",
                                "text": "Il peut arriver à un arbitre de céder à la pression voire de \"désarbitrer\" - comme certains joueurs déjouent quand ils sont trahis par leurs nerfs - et de passer à côté de son match, la faiblesse individuelle existe chez les arbitres, les limites physiques ou psychologiques aussi."
                            }
                        ]
                    }
