                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "d737565d-4219-48a6-ac91-359551046c69",
                                "sense_id": "f947b508-6c29-35ad-a0f3-02f101c891dd",
                                "text": "Kochaniutki, weź ten pięciotomowy słowniczek i odłóż mi go na górną półeczkę."
                            },
                            {
                                "example_id": "84373565-3742-453d-b057-8ce7dbdead63",
                                "sense_id": "f947b508-6c29-35ad-a0f3-02f101c891dd",
                                "text": "Oj ubożuchny masz słowniczek kibolku, ubożuchny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "709a2f60-bccc-39d7-bb02-07b4466e671b",
                        "entry_id": "bbda344e-01fa-3821-8ddc-1d31468ca51e",
                        "glosses": [
                            "mały dwujęzyczny słownik, w kieszonkowym wydaniu, zawierający podstawowe słownictwo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca6fcba-6cf1-437d-90a0-4d1c4aed295a",
                                "sense_id": "709a2f60-bccc-39d7-bb02-07b4466e671b",
                                "text": "Jak jedziesz do Niemiec do roboty, weź ze sobą słowniczek i rozmówki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c789d849-90c3-3b99-8f71-5d8e8bcbefeb",
                        "entry_id": "bbda344e-01fa-3821-8ddc-1d31468ca51e",
                        "glosses": [
                            "zeszyt, notatki służące do gromadzenia słówek w trakcie nauki języka obcego"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ee7f48ff-4260-4bf1-9bf6-86b403549d2f",
                                "sense_id": "c789d849-90c3-3b99-8f71-5d8e8bcbefeb",
                                "text": "Nasza anglistka ma hopla na punkcie systematyczności i na każdej lekcji sprawdza słowniczki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
