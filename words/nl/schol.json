                },
                {
                    "sense_id": "6ad90e27-e7d8-3d43-89c5-326a53146def",
                    "sense_definition": "Een los stuk aarde of grond, vaak met begroeiing.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer sneed een <w>schol</w> aarde uit het veld voor de tuin.",
                            "target_lang_translations": {
                                "en": "The farmer cut a <w>sod</w> of earth from the field for the garden."
                            }
                        },
                        {
                            "text": "Door de hevige regen gleed een <w>schol</w> grond van de heuvel naar beneden.",
                            "target_lang_translations": {
                                "en": "Due to the heavy rain, a <w>clod</w> of soil slid down the hill."
                            }
                        }
                    ],
                    "target_lang_definitions": {
