        "fr-extract.jsonl": [
            {
                "entry_id": "4eae205e-9814-3783-80d7-d9808d5bcb1d",
                "word": "antiféministe",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "221b01db-842e-4284-8f72-5f150c1351e6",
                        "entry_id": "4eae205e-9814-3783-80d7-d9808d5bcb1d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "antiféministes"
                    },
                    {
                        "form_id": "a1472f09-e1c0-4369-ae10-623393e6ef18",
                        "entry_id": "4eae205e-9814-3783-80d7-d9808d5bcb1d",
                        "tags": [],
                        "form": "anti-féministe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                        "entry_id": "4eae205e-9814-3783-80d7-d9808d5bcb1d",
                        "glosses": [
                            "Contre le mouvement féministe, opposé au féminisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0544f63-f0f1-4387-a790-7b30c19df53c",
                                "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                                "text": "Le vote des femmes et la thèse antiféministe"
                            },
                            {
                                "example_id": "f9dd22f2-a07e-4471-aa84-b8453f1147da",
                                "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                                "text": "Leurs conclusions démontraient que le soi-disant backlash antiféministe diagnostiqué par les médias, à la suite de l’éditorial de Lise Bissonnette dans Le Devoir, n’était nullement appuyé par les reportages, quelques articles d’opinions et la majorité des lettres d’opinions de lecteurs et de lectrices."
                            },
                            {
                                "example_id": "d9a8cd95-794d-4788-8dd6-d13042423163",
                                "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                                "text": "Les talibans, par exemple, ont constamment fait appel à une politique antiféministe pour se rallier les populations tribales et rurales."
                            },
                            {
                                "example_id": "aa1bb1ed-70e5-4d82-b907-9597cfbf2f87",
                                "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                                "text": "Ce remaniement du gouvernement français représente un virage politique antiféministe."
                            },
                            {
                                "example_id": "069ee33e-30e3-420f-9d48-e8183f254e89",
                                "sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                                "text": "L’opposition entre un soutien a priori affiché à la cause et une dénonciation de l’extrémisme supposé de ses manifestations concrètes, qui viendrait la desservir et même la dénaturer, est un double discours récurrent des stratégies de disqualification des revendications féministes. Idem pour les accusations d’« inquisition », de « lynchage », de « vengeance » et de « dictature », qu’on retrouve aussi bien dans les discours antiféministes mainstream que dans les discours masculinistes explicitement misogynes et violents de la droite extrême et des incels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90a7e459-d806-4d0a-9995-8e069053ab64",
                        "source_entry_id": "4eae205e-9814-3783-80d7-d9808d5bcb1d",
                        "source_sense_id": "1eb64c7a-a33d-3ca1-9841-b265747991ed",
                        "target_lang_word": "antifeminist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifeminist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f073276e-50c9-330b-899a-17004566246b",
                                        "entry_id": "d9e756de-3d5b-3f0b-b4b7-2420b3966115",
                                        "glosses": [
                                            "Antagonistic to feminism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a401f199-c2a3-4de2-aaa7-b57cc6451c1a",
                                                "sense_id": "f073276e-50c9-330b-899a-17004566246b",
                                                "text": "He evolved to connect the antifeminist ridicule of the New Woman to the growing backlash against male homosexuals, the Somdomites and inverts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3563ef1a-61a0-3ff7-9adf-3c321a3433d3",
                                        "entry_id": "d9e756de-3d5b-3f0b-b4b7-2420b3966115",
                                        "glosses": [
                                            "Advocating antifeminism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "antifeminist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d020199-10c8-3053-9c9c-42b36e129f3a",
                                        "entry_id": "8090fe84-4861-3fc8-b26a-115ba9f0faf4",
                                        "glosses": [
                                            "A person who is antagonistic to feminism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a2c86b-46e2-46ec-ab31-ba2371cacdef",
                                                "sense_id": "6d020199-10c8-3053-9c9c-42b36e129f3a",
                                                "text": "This means, then, that many, if not most, male feminists and male womanists exist, literally, in a \"no-man's land,\" where they receive the cold shoulder from feminists and womanists, and are shamelessly shunned by male antifeminists and antiwomanists and the supersexist men who rule the male supremacist world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "215d4990-5b40-34cb-920a-8dff9507a08d",
                                        "entry_id": "8090fe84-4861-3fc8-b26a-115ba9f0faf4",
                                        "glosses": [
                                            "An advocate of antifeminism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
