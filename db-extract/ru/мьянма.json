                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Myanmar ist ein Vielvölkerstaat mit etwa 48 Millionen Einwohnern verteilt auf 135 verschiedene Ethnien."
                                            },
                                            {
                                                "example_id": "ac6fc658-6d7e-46b7-93c9-ccdd3af2f32f",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Naypyidaw ist die Hauptstadt von Myanmar."
                                            },
                                            {
                                                "example_id": "8ccf57ac-95dc-450e-abe3-b9aeaab5b0c5",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Der Irrawaddy ist der wichtigste Fluss Myanmars."
                                            },
                                            {
                                                "example_id": "f8348c6c-ead6-47cb-9983-0f48ad934577",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                                            },
                                            {
                                                "example_id": "4cb44c2e-25f5-4a71-8488-06f849c0a38c",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "„Myanmar muss sein Image als Reformland verteidigen, sonst wird es zumindest im Westen alle Sympathien verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
