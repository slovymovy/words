                                "example_id": "eb290972-5387-4c30-b134-044f270d84ec",
                                "sense_id": "118012a8-dcfc-3572-ad8f-d44a5588e4ce",
                                "text": "2 juni 2017: VS trekt zich definitief terug uit klimaatakkoord Parijs"
                            }
                        ]
