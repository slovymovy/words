                ],
                "senses": [
                    {
                        "sense_id": "631ceced-f2db-3d34-8275-13bb2ebbce7d",
                        "entry_id": "f6bf2196-3cfe-3e66-b114-358efe29a055",
                        "glosses": [
                            "das genaue Suchen nach etwas in einem bestimmten Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15f16d6-59f3-499f-812b-1483ce5772f2",
                                "sense_id": "631ceced-f2db-3d34-8275-13bb2ebbce7d",
                                "text": "„Auch bei den Absuchen vor Baumaßnahmen finden die Verantwortlichen oft Granaten oder auch kleinere und größere Bomben.“"
                            },
                            {
                                "example_id": "a4d0dfac-86c8-4f05-a56a-52f18e3e782a",
                                "sense_id": "631ceced-f2db-3d34-8275-13bb2ebbce7d",
                                "text": "„Anschließend erfolgt die Absuche mit einer Tiefensonde.“"
                            },
                            {
                                "example_id": "87b9598c-37c1-484b-bbff-21a2f8efd996",
                                "sense_id": "631ceced-f2db-3d34-8275-13bb2ebbce7d",
                                "text": "„Nach einem Großeinsatz in Nord-Berlin hat die Polizei am Nachmittag Entwarnung gegeben. Um kurz vor 15 Uhr teilte sie via Twitter mit, dass die Absuche der Schule am Park in Wittenau ergebnislos verlaufen sei.“"
                            },
                            {
                                "example_id": "a8876ebf-166e-4140-b3f8-2b271d22a86c",
                                "sense_id": "631ceced-f2db-3d34-8275-13bb2ebbce7d",
                                "text": "„Der Gedenkort Klinkerwerk ist von der Absuche ausgenommen, dieser Bereich wurde bereits vor seiner Errichtung nach Kampfmitteln abgesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
