                "senses": [
                    {
                        "sense_id": "3f0a61d1-2fc8-3710-8393-c77cc146275b",
                        "entry_id": "d4f6b9c9-5d2a-3239-8ba7-913cfd131020",
                        "glosses": [
                            "Qui peut ou doit être liquidé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8167d3da-3ba6-42bc-a4d0-cdfb3028e796",
                                "sense_id": "3f0a61d1-2fc8-3710-8393-c77cc146275b",
                                "text": "D’après notre législation, la République se libère envers ses créanciers de la dette ancienne liquidable, en délivrant des titres à la fois productibles de rentes, et applicables à l’acquisition d’immeubles réels nationaux."
                            },
                            {
                                "example_id": "9f5d1661-36a1-4dc3-a7b1-1cb434f70822",
                                "sense_id": "3f0a61d1-2fc8-3710-8393-c77cc146275b",
                                "text": "Si elle est antérieure au 1ᵉʳ janvier 1810, l’indemnité n’est liquidable qu’en rentes."
                            },
                            {
                                "example_id": "2b660919-f9e4-405e-bec1-0ddd4a08c4c1",
                                "sense_id": "3f0a61d1-2fc8-3710-8393-c77cc146275b",
                                "text": "Ce constat doit toutefois être amendé pour tenir compte du fait que l’assiette du salaire liquidable est en général inférieure dans les régimes spéciaux à ce qu’elle est dans le régime général et les régimes complémentaires."
                            }
                        ]
                    }
                ],
