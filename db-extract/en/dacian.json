                                        "glosses": [
                                            "weibliche Angehörige des antiken Volkes der Daker, das westlich des Schwarzen Meeres siedelte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d43e16a-d8e3-4261-8223-a9c1878f06ba",
                                                "sense_id": "b13bcfe5-e63f-3ed7-9b7d-086058905ecd",
                                                "text": "„Trajan stieg zu der schönen Dakerin hinauf, stellte sich vor und hielt um ihre Hand an. Sie aber, wiewohl vom Aussehen und von der schönen Freiersrede Trajans zutiefst beeindruckt, wollte ihrem Vorsatz treu bleiben und ergriff deshalb die Flucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
