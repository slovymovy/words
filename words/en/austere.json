{
    "word_family": [
        "austerity",
        "austerely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41fcaef3-f0d6-3ac3-b061-b282777f261d",
                    "sense_definition": "Lacking decoration or luxury; simple and plain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk lived in an <w>austere</w> room with only a bed and a desk.",
                            "target_lang_translations": {
                                "nl": "De monnik woonde in een <w>sobere</w> kamer met alleen een bed en een bureau."
                            }
                        },
                        {
                            "text": "The building has an <w>austere</w> design that lacks any colorful decorations.",
                            "target_lang_translations": {
                                "nl": "Het gebouw heeft een <w>sober</w> ontwerp zonder enige kleurrijke versieringen."
                            }
                        }
                    ],
                    "synonyms": [
                        "simple",
                        "plain",
                        "spartan",
                        "unadorned"
                    ],
                    "antonyms": [
                        "overwrought",
                        "flamboyant",
                        "extravagant",
                        "gaudy",
                        "flashy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zonder versiering of luxe; eenvoudig en sober."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sober",
                                "target_lang_sense_clarification": "Eenvoudig, niet overdadig of luxueus."
                            },
                            {
                                "target_lang_word": "karig",
                                "target_lang_sense_clarification": "Gering, armoedig of zeer eenvoudig."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "346a6a76-bb62-37dc-ac51-98d10674c74f",
                    "sense_definition": "Having a strict, serious, or unfriendly manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had an <w>austere</w> expression that made the students nervous.",
                            "target_lang_translations": {
                                "nl": "De leraar had een <w>strenge</w> uitdrukking waar de leerlingen zenuwachtig van werden."
                            }
                        },
                        {
                            "text": "Despite his <w>austere</w> appearance, he was actually a very kind person.",
                            "target_lang_translations": {
                                "nl": "Ondanks zijn <w>strenge</w> uiterlijk was hij eigenlijk een heel vriendelijk persoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "stern",
                        "strict",
                        "severe",
                        "grim"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een strenge, serieuze of onvriendelijke houding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "streng",
                                "target_lang_sense_clarification": "Zonder ruimte voor tegenspraak, serieus."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e07dba6-11cb-3d78-86d9-8cded56d7691",
                    "sense_definition": "Relating to strict economic policies that reduce government spending.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced <w>austere</w> measures to reduce the national debt.",
                            "target_lang_translations": {
                                "nl": "De overheid introduceerde <w>strenge bezuinigingsmaatregelen</w> om de staatsschuld te verminderen."
                            }
                        },
                        {
                            "text": "Many citizens protested against the <w>austere</w> budget cuts.",
                            "target_lang_translations": {
                                "nl": "Veel burgers protesteerden tegen de <w>strenge</w> bezuinigingen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rigorous"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op strikt economisch beleid dat overheidsuitgaven vermindert."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bezuinigings-",
                                "target_lang_sense_clarification": "Gerelateerd aan maatregelen om kosten te drukken."
                            },
                            {
                                "target_lang_word": "streng",
                                "target_lang_sense_clarification": "Rigoureus in de context van beleid."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "599456ac-cb82-3b13-aaa1-64213d307dc0",
                    "sense_definition": "Having a harsh, sharp, or bitter taste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wine had an <w>austere</w> quality that was not pleasant to drink.",
                            "target_lang_translations": {
                                "nl": "De wijn had een <w>droge</w> kwaliteit die niet prettig was om te drinken."
                            }
                        },
                        {
                            "text": "The fruit had a dry and <w>austere</w> flavor.",
                            "target_lang_translations": {
                                "nl": "Het fruit had een droge en <w>scherpe</w> smaak."
                            }
                        }
                    ],
                    "synonyms": [
                        "harsh"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een harde, scherpe of bittere smaak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "droog",
                                "target_lang_sense_clarification": "Niet zoet van smaak, vaak gebruikt voor wijn."
                            },
                            {
                                "target_lang_word": "scherp",
                                "target_lang_sense_clarification": "Een prikkelende of bittere smaak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}