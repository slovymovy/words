                "senses": [
                    {
                        "sense_id": "98750845-1dba-347c-8d84-cc856ffde306",
                        "entry_id": "ab249744-d11f-3818-9d53-9f067073846d",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительным красногвардеец; связанный с Красной гвардией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb05c5b-22d9-455a-a062-c5689153af97",
                                "sense_id": "98750845-1dba-347c-8d84-cc856ffde306",
                                "text": "Через сотню саженей — чёрной могильной трещиной — впереди зазмеился красногвардейский окоп с обречённо заметавшимися над бруствером головами."
                            },
                            {
                                "example_id": "06a18cf9-8ae6-4771-bccc-1ff2bbfd06de",
                                "sense_id": "98750845-1dba-347c-8d84-cc856ffde306",
                                "text": "Сергей и Мария записались в красногвардейский отряд."
                            }
                        ]
                    }
