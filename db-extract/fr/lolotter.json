                "senses": [
                    {
                        "sense_id": "f4759067-039d-3d78-93fb-2bc7a438b00e",
                        "entry_id": "698ab62c-5db0-3778-afd3-eea40253c2e9",
                        "glosses": [
                            "Faire une lolotte, mouvement qui consiste à se placer de profil, la jambe la plus près du rocher étant repliée et la jambe opposée tendue."
                        ],
                        "tags": [
                            "Escalade"
                        ],
                        "examples": [
                            {
                                "example_id": "d6e9d723-ba60-447d-a157-b4eab9febbe8",
                                "sense_id": "f4759067-039d-3d78-93fb-2bc7a438b00e",
                                "text": "Faut donc savoir coincer ses pieds, crocheter, lolotter et tout le toutim sous peine de fumer les bras en 2 secondes !"
                            },
                            {
                                "example_id": "6f34344a-f144-4020-af43-48486ea9d60d",
                                "sense_id": "f4759067-039d-3d78-93fb-2bc7a438b00e",
                                "text": "Mais gachée par une douleur au dos handicapante(impossible de lolotter ou de talonner)."
                            },
                            {
                                "example_id": "07835876-c6aa-4795-a342-335ca5f950d6",
                                "sense_id": "f4759067-039d-3d78-93fb-2bc7a438b00e",
                                "text": "Une noire, également dans le dièdre de la dalle, qui vous fera arquer et lolotter, juste ce qu’il faut (Ouvreur : Daffyduck)"
                            }
                        ]
                    }
