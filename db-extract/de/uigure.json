                "senses": [
                    {
                        "sense_id": "e58c24e9-93e8-34fa-8920-ada2444c2c4d",
                        "entry_id": "980027b8-40f0-3b9c-8b3c-3403931bd795",
                        "glosses": [
                            "Uygur"
                        ],
                        "tags": [
                            "milletler"
                        ],
                        "examples": [
                            {
                                "example_id": "d92fc1d2-850f-40b1-a9da-40cd52e32798",
                                "sense_id": "e58c24e9-93e8-34fa-8920-ada2444c2c4d",
                                "text": "Uiguren werden in China unterdrückt.",
                                "translation": "Uygurlar Çin'de baskı görüyor."
                            },
                            {
                                "example_id": "e9ef3b88-797c-4413-b3d3-528ec604d0de",
                                "sense_id": "e58c24e9-93e8-34fa-8920-ada2444c2c4d",
                                "text": "Der Technologie-Konzern Huawei testet offenbar eine Software, mit der Uiguren erkannt werden können – Angehörige einer in China unterdrückten Minderheit.",
                                "translation": "Görünüşe göre Huawei teknoloji grubu, Çin'de ezilen bir azınlığın üyeleri olan Uygurları takip etmek için kullanılabilecek bir yazılımı test ediyor."
                            },
                            {
                                "example_id": "7f34a503-67c9-4b02-a5e1-6bbff6813e11",
                                "sense_id": "e58c24e9-93e8-34fa-8920-ada2444c2c4d",
                                "text": "Die Außenminister der 27 Mitgliedstaaten beschlossen in Brüssel Strafmaßnahmen gegen Verantwortliche für die Unterdrückung der muslimischen Minderheit der Uiguren in der Region Xinjiang.",
                                "translation": "Brüksel'de 27 üye devletin dışişleri bakanları, Sincan bölgesindeki Müslüman azınlık olan Uygurlara yönelik baskıdan mesul olanlara karşı cezaî tedbirler alınmasına karar verdi."
                            },
                            {
                                "example_id": "35927fee-39e8-4489-9d71-c3feb34a9631",
                                "sense_id": "e58c24e9-93e8-34fa-8920-ada2444c2c4d",
                                "text": "„In der Region kommt es immer wieder zu blutigen Konflikten zwischen der Zentralmacht und muslimischen Uiguren.“",
                                "translation": "Bölgede merkezî idare ile Müslüman Uygurlar arasında defalarca kanlı çatışmalar yaşanıyor."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
