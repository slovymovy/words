                    "sense_id": "8069d071-4433-32ba-9e29-ae96aee6a310",
                    "sense_definition": "wzbudzić w kimś strach, wywołać w kimś przerażenie lub obawę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Głośny huk <w>przestraszył</w> małe dziecko, które zaczęło płakać.",
                            "target_lang_translations": {
                                "en": "The loud bang <w>scared</w> the little child, who started to cry.",
                                "ru": "Громкий грохот <w>напугал</w> маленького ребёнка, и тот заплакал.",
                                "nl": "De harde knal <w>liet</w> het kleine kind <w>schrikken</w>, waarna het begon te huilen.",
                                "de": "Der laute Knall <w>erschreckte</w> das kleine Kind, das zu weinen begann.",
                                "fr": "Le bruit sourd a <w>effrayé</w> le petit enfant, qui a commencé à pleurer.",
                                "it": "Il forte boato ha <w>spaventato</w> il bambino piccolo, che ha iniziato a piangere.",
                                "cs": "Hlasitá rána <w>vyděsila</w> malé dítě, které začalo plakat.",
                                "tr": "Yüksek patlama sesi küçük çocuğu <w>korkuttu</w> ve çocuk ağlamaya başladı.",
                                "es": "El fuerte estruendo <w>asustó</w> al niño pequeño, que se puso a llorar.",
                                "zh": "巨大的声响<w>吓</w>到了那个小孩，孩子开始哭了起来。"
                            }
                        },
                        {
                            "text": "Nie chciałem cię <w>przestraszyć</w>, po prostu wszedłem cicho do pokoju.",
                            "target_lang_translations": {
                                "en": "I didn't mean to <w>frighten</w> you, I just walked quietly into the room.",
                                "ru": "Я не хотел тебя <w>испугать</w>, просто тихо зашёл в комнату.",
                                "nl": "Ik wilde je niet <w>laten schrikken</w>, ik liep gewoon stilletjes de kamer binnen.",
                                "de": "Ich wollte dich nicht <w>erschrecken</w>, ich bin einfach leise ins Zimmer gekommen.",
                                "fr": "Je ne voulais pas te <w>faire peur</w>, je suis juste entré doucement dans la pièce.",
                                "it": "Non volevo <w>spaventarti</w>, sono solo entrato in silenzio nella stanza.",
                                "cs": "Nechtěl jsem tě <w>vylekat</w>, prostě jsem jen potichu vešel do pokoje.",
                                "tr": "Seni <w>korkutmak</w> istemedim, sadece odaya sessizce girdim.",
                                "es": "No quería <w>asustarte</w>, simplemente entré despacio en la habitación.",
                                "zh": "我不是故意要<w>吓</w>你的，我只是悄悄地走进了房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "przerazić",
                        "zaniepokoić"
                    ],
                    "common_phrases": [
                        "przestraszyć kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause someone to feel fear, terror, or apprehension",
                        "ru": "вызвать у кого-либо страх, испуг или тревогу",
                        "nl": "iemand angst, schrik of vrees aanjagen",
                        "de": "in jemandem Angst, Furcht oder Bestürzung hervorrufen",
                        "fr": "Provoquer de la peur, de l'effroi ou de l'inquiétude chez quelqu'un.",
                        "it": "far provare paura, terrore o timore a qualcuno",
                        "cs": "vyvolat v někom strach, polekat nebo vyděsit",
                        "tr": "birinde korku, dehşet veya endişe uyandırmak",
                        "es": "provocar miedo, temor o sobresalto en alguien",
                        "zh": "使某人感到恐惧、惊吓或担忧"
