                "senses": [
                    {
                        "sense_id": "9016dea4-578f-35cd-a41a-f6c7ae94aadd",
                        "entry_id": "05464abb-08b3-3ffb-aa0e-f194859e4b0c",
                        "glosses": [
                            "iets wat heel slecht en heel onkundig is gemaakt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bf5ca36f-522e-4948-b655-de113d4af671",
                                "sense_id": "9016dea4-578f-35cd-a41a-f6c7ae94aadd",
                                "text": "Ze had de broddellap van het nog ongevulde sierkussentje op schoot en zat er zwijgend in te pikken."
                            },
                            {
                                "example_id": "7b26dad1-9d08-4ac9-ba46-0e2f6eeb1288",
                                "sense_id": "9016dea4-578f-35cd-a41a-f6c7ae94aadd",
                                "text": "Taalkundig gezien in ieder geval weinig goeds, vindt Arjan Peters, literair criticus van de Volkskrant. ‘Broddelwerk’ noemt hij het juryrapport, ‘een broddellap vol taalfouten, contradicties en dodelijke complimenten.’ Maar duiden op een mogelijke winnaar doet het niet."
                            }
                        ]
                    },
                    {
                        "sense_id": "d917c53a-54c6-3cc7-9b78-d8779e0f344d",
                        "entry_id": "05464abb-08b3-3ffb-aa0e-f194859e4b0c",
                        "glosses": [
                            "een oefenlap waarop men verschillende borduurtechnieken probeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04571b68-c363-470c-9b3c-37084d57251c",
                                "sense_id": "d917c53a-54c6-3cc7-9b78-d8779e0f344d",
                                "text": "Naast die „zonde en geniep” is ook het wereldbeeld dat in het boek naar voren komt weinig verheffend. Heeft Adèle al het gevoel dat haar leven alleen maar „borduren aan een broddellap ellende” inhoudt, haar broer Arthur brengt de zinloosheid van het bestaan filosofisch onder woorden."
                            }
                        ]
                    }
