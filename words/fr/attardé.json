    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "93ff0a7b-60f1-3d52-a6eb-cc9aa3b83a34",
                    "sense_definition": "Qui est en retard ou qui se trouve dehors tard dans la nuit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dernier train a ramené quelques voyageurs <w>attardés</w> dans la gare déserte."
                        },
                        {
                            "text": "Un promeneur <w>attardé</w> marchait encore seul le long des quais silencieux."
                        }
                    ],
                    "common_phrases": [
                        "voyageur attardé",
                        "promeneur attardé"
                    ]
                },
                {
                    "sense_id": "bdf76b28-c73a-328c-bfd7-c718120609e7",
                    "sense_definition": "Dont le développement intellectuel ou mental est ralenti ou incomplet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cette époque, la médecine qualifiait parfois d'<w>attardé</w> tout enfant ayant des difficultés scolaires."
                        },
                        {
                            "text": "Cette ancienne méthode cherchait à aider les élèves <w>attardés</w> à rattraper leur niveau."
                        }
                    ],
                    "synonyms": [
                        "débile"
                    ],
                    "common_phrases": [
                        "attardé mental"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme médical ancien, souvent péjoratif aujourd'hui"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acb12e76-3e7f-33c1-af0f-33ce8e7900b4",
                    "sense_definition": "Personne en retard ou qui se trouve encore dehors tard dans la soirée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le veilleur de nuit a ouvert la porte pour faire entrer les derniers <w>attardés</w>."
                        },
                        {
                            "text": "Le dernier autobus de minuit recueille souvent quelques <w>attardés</w> fatigués de leur soirée."
                        }
                    ],
                    "common_phrases": [
                        "les derniers attardés"
                    ]
                },
                {
                    "sense_id": "97ec26ce-4939-30bc-91d6-29ac29a0f11a",
                    "sense_definition": "Personne ayant un retard de développement intellectuel, ou insulte visant l'intelligence de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un moment de colère, il a insulté son adversaire en le traitant d'<w>attardé</w>."
                        },
                        {
                            "text": "Cette insulte dégradante réduit une personne en difficulté au rang d'<w>attardé</w>."
                        }
                    ],
                    "synonyms": [
                        "débile mental",
                        "demeuré"
                    ],
                    "common_phrases": [
                        "traiter d'attardé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "terme injurieux ou péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "376c7fdc-8065-3824-9730-9517c79c1d33",
                    "sense_definition": "Personne en retard sur son époque, attachée à des idées dépassées.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En rejetant les outils numériques, il passe pour un <w>attardé</w> auprès de ses jeunes collègues."
                        },
                        {
                            "text": "Certains observateurs considèrent ces hommes politiques comme des <w>attardés</w> d'un autre siècle."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "785f5705-b947-3bd9-88cb-cf6208791f2c",
