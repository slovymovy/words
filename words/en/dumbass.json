                            {
                                "target_lang_word": "blbec",
                                "target_lang_sense_clarification": "obecně používaný hanlivý výraz pro hloupého člověka"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "silnější výraz pro někoho, kdo se chová velmi hloupě"
