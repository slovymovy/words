    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68dd7c83-b68f-39ac-8e8c-002a10fe967a",
                    "sense_definition": "The simple past tense of <w>go</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>went</w> to the library to return her books.",
                            "target_lang_translations": {
                                "ru": "Она <w>пошла</w> в библиотеку, чтобы вернуть книги.",
                                "zh": "她<w>去</w>了图书馆还书。"
                            }
                        },
                        {
                            "text": "We <w>went</w> out for dinner to celebrate his birthday.",
                            "target_lang_translations": {
                                "ru": "Мы <w>пошли</w> поужинать, чтобы отпраздновать его день рождения.",
                                "zh": "我们<w>去</w>外面吃晚饭，为他庆祝生日。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "went out",
                        "went away",
                        "went home",
                        "went on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола \"идти\" или \"ехать\".",
                        "zh": "动词 go 的一般过去时形式，表示去、走或离开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошёл",
                                "target_lang_sense_clarification": "начал движение куда-либо"
                            },
                            {
                                "target_lang_word": "ходил",
                                "target_lang_sense_clarification": "совершал движение (туда и обратно)"
                            },
                            {
                                "target_lang_word": "ездил",
                                "target_lang_sense_clarification": "перемещался на транспорте"
                            },
                            {
                                "target_lang_word": "ушёл",
                                "target_lang_sense_clarification": "покинул место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "去",
                                "target_lang_sense_clarification": "前往某处"
                            },
                            {
                                "target_lang_word": "走",
                                "target_lang_sense_clarification": "步行或离开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd02e31e-7807-3c92-af82-85d72c252d65",
                    "sense_definition": "The past participle of <w>go</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I should have <w>went</w> to the doctor when I first felt sick.",
                            "target_lang_translations": {
                                "ru": "Мне следовало <w>пойти</w> к врачу, когда я впервые почувствовал недомогание.",
                                "zh": "刚开始觉得不舒服时，我真该<w>去</w>看医生的。"
                            }
                        },
                        {
                            "text": "They have <w>went</w> home already, so you missed them.",
                            "target_lang_translations": {
                                "ru": "Они уже <w>ушли</w> домой, так что вы их пропустили.",
                                "zh": "他们已经<w>走</w>回家了，所以你错过了他们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gone"
                    ],
                    "common_phrases": [
                        "have went",
                        "should have went"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in non-standard or dialectal speech instead of 'gone'."
