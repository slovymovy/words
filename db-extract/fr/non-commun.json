                "senses": [
                    {
                        "sense_id": "9babe9ce-f4d8-328d-b464-15bcbdfcffb9",
                        "entry_id": "74cb54a2-dcce-3548-8036-7742e05f45fa",
                        "glosses": [
                            "Ce qui n’est pas commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2334c087-9bc5-4502-a138-288d0967851f",
                                "sense_id": "9babe9ce-f4d8-328d-b464-15bcbdfcffb9",
                                "text": "Le nœud de la mésentente, celui de l’entente non-entente, oppose bien deux traitements de l’entente, deux sens du partage où les uns affirment qu’il y a de l’entente dans la supposée non-entente, du commun dans le non-commun, quand l’autre le dénie."
                            },
                            {
                                "example_id": "7deea97c-ae2c-4f34-8595-08cf9dba2026",
                                "sense_id": "9babe9ce-f4d8-328d-b464-15bcbdfcffb9",
                                "text": "Ce qui implique qu’à côté du commun demeure du non-commun."
                            },
                            {
                                "example_id": "340e0171-1a11-448b-b009-4e9a03fe09df",
                                "sense_id": "9babe9ce-f4d8-328d-b464-15bcbdfcffb9",
                                "text": "Donc, pour atteindre le non-commun, l’insensé, l’inconnu, il faut s’exposer au danger de la contradiction."
                            }
                        ]
                    }
                ],
