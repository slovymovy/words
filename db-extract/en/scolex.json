                                                "example_id": "0db095b0-4988-470c-bc07-f90e7b0de324",
                                                "sense_id": "dfdb8d16-417d-3234-815d-534bc655a5c7",
                                                "text": "O trzynastej pięć minęliśmy jachtem główki portu prawym halsem."
                                            }
