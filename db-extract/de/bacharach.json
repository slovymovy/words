                        "examples": [
                            {
                                "example_id": "0a42cec3-7bdf-419c-9f10-34c227e3e034",
                                "sense_id": "f71cc53e-4335-3851-8e44-103265377712",
                                "text": "Bacharach ist ein sehr schöne linksrheinische Kleinstadt nördlich von Bingen."
                            },
                            {
                                "example_id": "9149cae0-b499-4475-bd05-2fdcffc6bf87",
                                "sense_id": "f71cc53e-4335-3851-8e44-103265377712",
                                "text": "Bacharach ist in der Literatur durch Heinrich Heines „Der Rabbi von Bacharach“ bekannt."
                            },
                            {
                                "example_id": "9be3fa32-eeee-4801-835b-eadbe70fa148",
                                "sense_id": "f71cc53e-4335-3851-8e44-103265377712",
                                "text": "„Es war der größte Philosoph des 19. Jahrhunderts, der das sagte, als wir, sechs Mann hoch, zu Bacharach am Rheine in grüner Laube saßen und Rheinwein tranken, soviel wir bezahlen konnten und noch mehr.“"
                            }
                        ],
