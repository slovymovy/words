                    {
                        "sense_id": "ca719434-ac1a-3db2-aba0-03383816d614",
                        "entry_id": "23a17832-57c9-399e-b876-9d584e21d91a",
                        "glosses": [
                            "apparaat om lading te laden of te lossen in of uit een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3fe08c9-3f2e-46b1-b162-47a048915d14",
                                "sense_id": "ca719434-ac1a-3db2-aba0-03383816d614",
                                "text": "Een deel van de activisten is in de laadkranen geklommen bij de kolenoverslag OBA, die de Hemwegcentrale van brandstof voorziet. Ze zijn van plan er de hele dag te blijven zitten en vreedzaam actie te voeren, zegt een woordvoerder."
                            },
                            {
                                "example_id": "c70a5317-ed15-4444-a584-1d40a4bc83ad",
                                "sense_id": "ca719434-ac1a-3db2-aba0-03383816d614",
                                "text": "Een vrachtautobestuurder die op het moment van het ongeval passeerde, zette zijn laadkraan in om de auto niet verder in de modder te laten zakken."
                            },
                            {
                                "example_id": "6a2b6a70-e25c-4fec-bc02-56a684eefd60",
                                "sense_id": "ca719434-ac1a-3db2-aba0-03383816d614",
                                "text": "Dit Amerikaanse bouw-, mijnbouw- en bosbouwbedrijf maakt onder meer groot bouwmaterieel, zoals laadkranen en asfalteermachines. Voor de fabrieken van Caterpillar bij het Duitse Kiel (boven Hamburg) regelt Imtech het energiemanagement: energie, stoom, gas, water en perslucht. Het contract, met een waarde van 130 miljoen euro, loopt nog tot 2019."
                            }
                        ]
                    }
