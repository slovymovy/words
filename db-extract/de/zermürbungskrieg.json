                    },
                    {
                        "form_id": "ec0f715d-9bda-4893-be86-6e93cc82db07",
                        "entry_id": "004afb0f-e047-35ef-994f-ac2eb640283e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zermürbungskriege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dedf170c-f255-3ea4-be71-68bfccefb6a6",
                        "entry_id": "004afb0f-e047-35ef-994f-ac2eb640283e",
                        "glosses": [
                            "durch lang anhaltende, zermürbende Kampfhandlungen gekennzeichneter Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34be6829-fc63-433e-af57-808d39e516c0",
                                "sense_id": "dedf170c-f255-3ea4-be71-68bfccefb6a6",
                                "text": "„Die Taliban setzten ihren Zermürbungskrieg fort, bis sie von den Amerikanern, die Afghanistan nunmehr unbedingt verlassen wollten, zu Gesprächen über die Beendigung des Krieges überredet wurden, um den Abzug der US-Truppen zu ermöglichen.“"
                            },
                            {
                                "example_id": "371de0b3-06b3-4eda-95df-9646d7ce5bee",
                                "sense_id": "dedf170c-f255-3ea4-be71-68bfccefb6a6",
                                "text": "„Doche mache man sich bezüglich der Fähigkeiten der eigenen Mudschahedin keine Illusionen. Deshalb müssten, um die Israelis zu zwingen, sich aus dem Südlibanon zurückzuziehen, die unkonventionellen Kampfmethoden eines Zermürbungskriegs angewendet werden - wie bei dem israelischen Teilabzug aus dem Südlibanon 1985 bereits geschehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cb5b71e-02c1-4a70-96de-b82743f58248",
                        "source_entry_id": "004afb0f-e047-35ef-994f-ac2eb640283e",
                        "source_sense_id": "dedf170c-f255-3ea4-be71-68bfccefb6a6",
                        "source_sense_description": "zermürbender Krieg",
                        "target_lang_word": "war of attrition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war of attrition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75a7938f-02bd-3c8d-8724-5f1007ba4678",
                                        "entry_id": "45458768-b7a5-37a0-84d1-8e2d6c24888e",
                                        "glosses": [
                                            "A prolonged war in which the warring sides try to defeat their opponents by wearing them out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d5b79c-1278-4606-b813-2eb88d63148e",
                                                "sense_id": "75a7938f-02bd-3c8d-8724-5f1007ba4678",
                                                "text": "A bullet for your war of attrition\nAnd your exploitation of the human condition"
                                            },
                                            {
                                                "example_id": "c2b0228d-8421-47e0-886e-4ecbd179a57b",
                                                "sense_id": "75a7938f-02bd-3c8d-8724-5f1007ba4678",
                                                "text": "So far, soldiers on the front lines said they had seen little evidence of escalation beyond this largely slow-moving war of attrition."
                                            },
                                            {
                                                "example_id": "047e18d6-32c8-47b8-add2-bc96d7287549",
                                                "sense_id": "75a7938f-02bd-3c8d-8724-5f1007ba4678",
                                                "text": "The Site Director was expected to initiate DISCIDIUM Protocol should the situation become untenable; so far as remote observation of the remains of Ipperwash Park above can show, this was not done. Transmissions are occasionally intercepted from the Site, and after memetic 'washing' by RAISA have been determined to originate from uncompromised personnel conducting a war of attrition against the above-mentioned entities. It is from their reports that the majority of this information, save for that regarding SCP-001-A, has been derived. As an understanding of each entity may aid in the defeat of SCP-001-A, no action has been taken to remove Site-43 from operational effectiveness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8037f770-d208-3af3-8fb9-27e9ade34eaf",
                                        "entry_id": "45458768-b7a5-37a0-84d1-8e2d6c24888e",
                                        "glosses": [
                                            "A situation in which opponents try to overcome each other by wearing them out."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
