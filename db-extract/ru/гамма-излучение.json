                                            {
                                                "example_id": "a9746ed5-dba0-41c9-8ee5-b67ea780d53f",
                                                "sense_id": "cf158952-a2f9-3b23-9674-9ea856070432",
                                                "text": "Punished with UV and gamma radiation from the Class F Star it orbits, Utha is no one's first choice for a planet to land on."
                                            }
