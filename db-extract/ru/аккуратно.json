        "ru-extract.jsonl": [
            {
                "entry_id": "568f770b-1966-373d-809b-39559d420bca",
                "word": "аккуратно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                        "entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "glosses": [
                            "наречие к аккуратный; тщательно, прилежно и точно, с соблюдением норм и правил"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "14bfddc6-1ccb-42a9-9bef-4dacce3f9bf5",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Аккуратно сделать что-нибудь"
                            },
                            {
                                "example_id": "dcdea4a6-18bd-4bed-a798-aef8b2659248",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Аккуратно вычистить."
                            },
                            {
                                "example_id": "b39e2db1-2f40-4f06-9a03-a21fbc239035",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Задания надо выполнять аккуратно."
                            },
                            {
                                "example_id": "a3b76630-66bc-4e2e-8733-f037485fee24",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Позади них кузов был аккуратно заполнен свёрнутыми постелями, палаткой, посудой, продовольствием и прочими вещами, необходимыми в дороге."
                            },
                            {
                                "example_id": "328553b9-5437-4efc-86c8-3a1cedd8c0e6",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Она повела его в свою комнату, где на изящном письменном столике лежала аккуратно переписанная, тщательно сшитая тетрадка с широкими полями."
                            },
                            {
                                "example_id": "fd22e03c-f664-4866-8a0e-07a9d6d0ead0",
                                "sense_id": "c61de034-ade1-390f-93f1-5b50e51641f5",
                                "text": "Тут же валялась фуражка российского военного образца, аккуратно пробитая пулей."
                            }
                        ]
                    },
                    {
                        "sense_id": "db0a43ef-44de-3ec2-b7bd-ef69a83fc008",
                        "entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "glosses": [
                            "разг. осторожно, бережно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8296c4-0453-413b-824e-0b0d41a7cb1f",
                                "sense_id": "db0a43ef-44de-3ec2-b7bd-ef69a83fc008",
                                "text": "Он очень аккуратно взял рукопись двумя пальцами."
                            },
                            {
                                "example_id": "786dda9f-ef1a-421e-b052-b0abed2378e7",
                                "sense_id": "db0a43ef-44de-3ec2-b7bd-ef69a83fc008",
                                "text": "Несите аккуратно, чтобы не разбить."
                            },
                            {
                                "example_id": "08e88f33-ea46-4e63-a5a7-05cea1b164bc",
                                "sense_id": "db0a43ef-44de-3ec2-b7bd-ef69a83fc008",
                                "text": "Приказчик поднялся, аккуратно сложил таблички в портфельчик, обернув их предварительно чистыми тряпицами."
                            },
                            {
                                "example_id": "deef2de1-d1df-488d-92f6-2e8862adee3a",
                                "sense_id": "db0a43ef-44de-3ec2-b7bd-ef69a83fc008",
                                "text": "В карманах было пусто, с левой штанины были аккуратно срезаны все золотые бляшки, а с пояса исчез кинжал."
                            }
                        ]
                    },
                    {
                        "sense_id": "659b407e-b181-3d00-b2cb-6eea96a1ebf8",
                        "entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "glosses": [
                            "разг. постоянно, не пропуская"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9017b5d8-ea54-49aa-84f7-6c48e4200169",
                                "sense_id": "659b407e-b181-3d00-b2cb-6eea96a1ebf8",
                                "text": "Он аккуратно заходит к нам по выходным дням."
                            },
                            {
                                "example_id": "17472e16-6674-400a-9ab3-41782c4997f7",
                                "sense_id": "659b407e-b181-3d00-b2cb-6eea96a1ebf8",
                                "text": "Нам газету доставляют аккуратно."
                            },
                            {
                                "example_id": "197d16e1-2b50-48bc-9528-4e4316c17c7b",
                                "sense_id": "659b407e-b181-3d00-b2cb-6eea96a1ebf8",
                                "text": "Первый взнос по ссуде, данной под бизнес раба, купленного у господина Хаммаку, был выплачен аккуратно и в срок."
                            },
                            {
                                "example_id": "682915b6-34be-49bc-bda9-4ec48342e2ad",
                                "sense_id": "659b407e-b181-3d00-b2cb-6eea96a1ebf8",
                                "text": "Аккуратно получать жалованье ты не можешь не только теперь, но даже и при наступлении социализма."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdad955e-81a1-417a-8047-b578c15dee26",
                        "source_entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "source_sense_description": "прилежно",
                        "target_lang_word": "neatly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neatly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                                        "entry_id": "54bd1aa9-30d8-3d00-b235-b473fc8c0e60",
                                        "glosses": [
                                            "In a neat manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea2c2358-3a91-4640-8bdf-7a4a75fec481",
                                                "sense_id": "2b6c948a-2f32-3236-bc71-07f898b07b0f",
                                                "text": "I was delighted to see A Woman's Place take a stand against censorship. But I noted with some cynicism that the exhibit failed to include any of the numerous publications suppressed by institutions of the feminist community. It thus neatly avoided acknowledging the role being played by the women's movement as a force for censorship (and the rather sordid past of A Woman's Place itself)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a58e12b3-e280-457d-bcf7-5b4575faa952",
                        "source_entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "source_sense_description": "прилежно",
                        "target_lang_word": "smartly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smartly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc2569dc-06ed-3bbb-9fa1-c2615a89764e",
                                        "entry_id": "f0dfe8f9-0be4-3e51-8cab-fcfbc30ec11d",
                                        "glosses": [
                                            "In a smart manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d716270f-dfb9-496d-a960-fa34b2c8914e",
                                                "sense_id": "dc2569dc-06ed-3bbb-9fa1-c2615a89764e",
                                                "text": "smartly dressed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e9626d-2d5e-342d-aeea-30274aada52e",
                                        "entry_id": "f0dfe8f9-0be4-3e51-8cab-fcfbc30ec11d",
                                        "glosses": [
                                            "Quickly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6041fa92-7e10-434e-bc0d-9f495d5d8f3f",
                                                "sense_id": "94e9626d-2d5e-342d-aeea-30274aada52e",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e325377-6d0d-3552-b7f9-b0d6cdb16eb3",
                                        "entry_id": "f0dfe8f9-0be4-3e51-8cab-fcfbc30ec11d",
                                        "glosses": [
                                            "Intelligently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22ff8ec0-001e-4269-9dff-9a6302353f4a",
                        "source_entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "source_sense_description": "осторожно",
                        "target_lang_word": "cautiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cautiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
                                        "entry_id": "6842ea92-fd0e-3179-b1e0-1205029ca1c8",
                                        "glosses": [
                                            "In a cautious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba7991e-9e6b-4b5c-8560-aa06cb982b74",
                                                "sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
                                                "text": "He said cautiously, \"I do not think it right, Imperator.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7e595db-1e0d-43d8-80a4-cad85eb29c14",
                        "source_entry_id": "568f770b-1966-373d-809b-39559d420bca",
                        "source_sense_description": "осторожно",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
