                    {
                        "form_id": "0ea7221e-db7b-4c56-92ee-2972224a9d15",
                        "entry_id": "f085e7c3-5731-3c8a-a6a9-e3f71e9a3175",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Jugendsprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                        "entry_id": "f085e7c3-5731-3c8a-a6a9-e3f71e9a3175",
                        "glosses": [
                            "die Umgangssprache der Jugend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c8beea-d9c6-41dc-9938-32648a8a2a94",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "In der Jugendsprache werden Ausdrücke benutzt, die die Erwachsenen provozieren sollen und der Gruppenidentität dienen."
                            },
                            {
                                "example_id": "f86c339c-fefc-4b57-b1fa-f709df607319",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "„Jugendsprache statt Standardsprache ist Jargon: die jugendsprachliche Präsentation außerhalb der Gruppe und situationell und kommunikativ unangemessen - also jugendsprachliche Inszenierung um jeden Preis.“"
                            },
                            {
                                "example_id": "e6ccf8fd-1129-465d-83eb-dac0caaadf3c",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "„Dennoch scheinen sich auf Grund der bisherigen Ansätze vier Stufen alterstypischer Sprachmerkmale abzuzeichnen: die Kindersprache im Vorschulalter vom ersten Sprechen bis zum Beginn der Schulzeit, die Schüler- und Jugendsprache bis zum Ende der beruflichen Ausbildung, die Erwachsenensprache während der Zeit der Berufsausübung oder (bei Frauen) der Zeit der Kindererziehung und schließlich die Alters- oder ‚Senioren‘-Sprache in der Zeit nach der Berufsausübung.“"
                            },
                            {
                                "example_id": "598e675f-74c3-4dd3-a8d2-196cae861555",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "„Das Wort Zahn für Mädchen entstand um 1950 in der Umgangssprache der Halbwüchsigen; und Erwachsene halten es heute noch für einen der charakteristischsten Ausdrücke der Jugendsprache.“"
                            },
                            {
                                "example_id": "f607cacc-5dfb-41dc-877d-ae0af9cf7b47",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "„Doch ob Punks, Skins und Pennäler dieselbe Jugendsprache sprechen, das darf bezweifelt werden.“"
                            },
                            {
                                "example_id": "38b958f4-59cc-4658-97d3-f0d5afce8cdf",
                                "sense_id": "ff9e7369-505b-367e-9d94-fc48b7fcc627",
                                "text": "„Es könnte sein, dass das Einfallstor für jiddische Ausdrücke damals die Jugendsprache war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
