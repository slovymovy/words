    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85e399d0-cfa6-3132-b0a3-adf7f0de116a",
                    "sense_definition": "przedmiot imitujący wygląd innego przedmiotu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imitacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W wielu sklepach wystawia się tylko <w>atrapy</w> telefonów z powodu kradzieży.",
                            "target_lang_translations": {
                                "ru": "Во многих магазинах из-за краж выставляют только <w>муляжи</w> телефонов."
                            }
                        },
                        {
                            "text": "Na wystawie sklepowej ustawiono plastikowe <w>atrapy</w> drogich zegarków.",
                            "target_lang_translations": {
                                "ru": "На витрине магазина выставили пластиковые <w>муляжи</w> дорогих часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "imitacja"
                    ],
                    "common_phrases": [
                        "atrapa telefonu",
                        "atrapa broni"
                    ],
                    "target_lang_definitions": {
                        "ru": "предмет, имитирующий внешний вид другого предмета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "муляж",
                                "target_lang_sense_clarification": "предмет, точно имитирующий оригинал (часто в витринах или для обучения)"
                            },
                            {
                                "target_lang_word": "макет",
                                "target_lang_sense_clarification": "модель, воспроизводящая внешний вид объекта"
                            },
                            {
                                "target_lang_word": "бутафория",
                                "target_lang_sense_clarification": "предметы, имитирующие настоящие вещи (часто в витринах или театре)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e6d577b-bdf0-31a1-afcf-c430296f4466",
                    "sense_definition": "coś, co sprawia pozór wartości, będąc w rzeczywistości bezwartościowym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "imitacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To całe porozumienie okazało się tylko polityczną <w>atrapą</w> bez realnego znaczenia.",
                            "target_lang_translations": {
                                "ru": "Всё это соглашение оказалось лишь политической <w>имитацией</w>, не имеющей реального значения."
                            }
                        },
                        {
                            "text": "Demokracja w tym kraju jest tylko <w>atrapą</w> prawdziwych rządów prawa.",
                            "target_lang_translations": {
                                "ru": "Демократия в этой стране — лишь <w>имитация</w> настоящего верховенства права."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нечто, создающее видимость ценности, будучи на самом деле бесполезным или фальшивым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имитация",
                                "target_lang_sense_clarification": "подделка, не имеющая реальной сути"
                            },
                            {
                                "target_lang_word": "бутафория",
                                "target_lang_sense_clarification": "переносное значение: нечто показное, обманчивое"
                            },
                            {
                                "target_lang_word": "фальшивка",
                                "target_lang_sense_clarification": "нечто, выдаваемое за настоящее, но не являющееся таковым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbbf87f1-3f69-3adf-b978-152312856391",
                    "sense_definition": "osłona chłodnicy w samochodzie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "część samochodu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy model samochodu ma chromowaną <w>atrapę</w> chłodnicy z przodu.",
                            "target_lang_translations": {
                                "ru": "У новой модели автомобиля спереди хромированная <w>решетка радиатора</w>."
                            }
                        },
                        {
                            "text": "Po stłuczce trzeba było wymienić zderzak oraz <w>atrapę</w>.",
                            "target_lang_translations": {
                                "ru": "После аварии пришлось менять бампер и <w>решетку радиатора</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grill"
                    ],
                    "common_phrases": [
                        "atrapa chłodnicy"
                    ],
                    "target_lang_definitions": {
                        "ru": "декоративная решетка на передней части автомобиля"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решетка радиатора",
                                "target_lang_sense_clarification": "техническое название детали автомобиля"
                            },
                            {
                                "target_lang_word": "фальшрадиаторная решетка",
                                "target_lang_sense_clarification": "декоративная панель, имитирующая решетку радиатора"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}