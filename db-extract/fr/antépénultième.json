                                        "entry_id": "a8838677-ed59-3754-b2b6-0a6ff622e1a9",
                                        "glosses": [
                                            "Two before the last, i.e., the one immediately before the penultimate, in a series."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
