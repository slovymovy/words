                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d19fb9d-ae85-4cfd-9fc0-89b6b3280d19",
                                "sense_id": "aa92fd0a-56f9-3449-a696-ab7fb8ad31fb",
                                "text": "В нижней части воронки, над краном, помещается тугая амиантовая пробка, замедляющая приток даже и в том случае, если бы кран на мгновение был открыт слишком много."
                            }
