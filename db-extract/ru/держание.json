                "senses": [
                    {
                        "sense_id": "8bd6b69f-9b62-3543-9a3b-b2f16700228b",
                        "entry_id": "0b6ebc22-41ba-333d-99b7-94b97c47258a",
                        "glosses": [
                            "действие по значению гл. держать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a69000-ebbc-45a9-854e-0904e979c8ee",
                                "sense_id": "8bd6b69f-9b62-3543-9a3b-b2f16700228b",
                                "text": "Грунт там песчаный, самый лучший для держания якорей, и глубина не более 15 и 17 саженъ."
                            },
                            {
                                "example_id": "d0ea80e9-d7e0-4028-8c2a-e30b2683b7aa",
                                "sense_id": "8bd6b69f-9b62-3543-9a3b-b2f16700228b",
                                "text": "Вот она остановилась, закурила — короткие и толстые Gitanes, как и всегда, — без всякого манерничанья, без элегантного держания сигареты наотлет — напротив, угловато, неряшливо даже, по-мужски…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebf4da01-6784-45bf-91a0-0bf5f3b90649",
                        "source_entry_id": "0b6ebc22-41ba-333d-99b7-94b97c47258a",
                        "source_sense_id": "8bd6b69f-9b62-3543-9a3b-b2f16700228b",
                        "target_lang_word": "holding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "Something that one owns, especially stocks and bonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12a3f88-5b35-4f6d-9cc2-cd72a0c2bade",
                                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                                "text": "Although this survey lists only a small number of representative materials in the Hoover Library's Baltic Collection, a comprehensive view of the library's holdings can be gained from the Hoover Institution's card catalog or its printed equivalent"
                                            },
                                            {
                                                "example_id": "adedc33d-51e9-4431-bfb4-3ddeff8b781b",
                                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                                "text": "Italy's right-wing prime minister was about to cure his biggest headache by selling the state's holding in a troubled airline, Alitalia."
                                            },
                                            {
                                                "example_id": "071245d6-a060-416c-9f34-8a6e7f4ebe8d",
                                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                                "text": "The defender at third position is supposed to keep the partner informed of his holdings in that suit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e51ec0e1-5e69-3d99-b500-2525fe427db6",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "A determination of law made by a court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb1f0086-d965-3ad4-bdf2-1f48b5da9cfd",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "A tenure; a farm or other estate held of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2215f754-ddec-4594-83ac-1ebc47aaa835",
                                                "sense_id": "bb1f0086-d965-3ad4-bdf2-1f48b5da9cfd",
                                                "text": "Take again\nFrom this my hand, as holding of the Pope\nYour sovereign greatness and authority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9169b69e-0218-34d2-9e5a-fe27be6512e5",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "Logic; consistency."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abc7368-bc30-46ff-9525-f869e8503b78",
                                                "sense_id": "9169b69e-0218-34d2-9e5a-fe27be6512e5",
                                                "text": "This has no holding,\nTo swear by him whom I protest to love\nThat I will work against him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de43fdd5-f53c-3857-b2dd-443ad0971f7d",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "A foul consisting of impermissibly restricting the movement of an opposing player with the hands or stick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "731321bd-602d-3088-9dfd-ef49b1ddc032",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "The burden or chorus of a song."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0660d45-1284-4d38-b696-4cc1f1089e0f",
                                                "sense_id": "731321bd-602d-3088-9dfd-ef49b1ddc032",
                                                "text": "Make battery to our ears with the loud music;\nThe while I'll place you; then the boy shall sing.\nThe holding every man shall beat as loud\nAs his strong sides can volley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47221ec9-471a-352e-8006-f148a87a4d33",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "That which holds, binds, or influences; hold; influence; power."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63843b90-30af-4089-98cd-668ce23a4466",
                                                "sense_id": "47221ec9-471a-352e-8006-f148a87a4d33",
                                                "text": "This is one of the principal holdings of that destructive system, which has endeavoured to unhinge all the virtuous, honourable, and useful connexions in the kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789efa73-f731-341f-af87-e10b7089c0f7",
                                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                                        "glosses": [
                                            "A holding company, or other kind of company (by back-translation from Russian холдинг (xolding))."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "holding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02229cc1-33f4-3892-856a-1e388b81a3f0",
                                        "entry_id": "0245d1ef-c690-3014-84fd-f4624c7096fc",
                                        "glosses": [
                                            "present participle and gerund of hold"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c0e66c-75ee-4503-a797-2056da26e07d",
                                                "sense_id": "02229cc1-33f4-3892-856a-1e388b81a3f0",
                                                "text": "They were caught holding hands in the dark."
                                            },
                                            {
                                                "example_id": "a2314c67-c05d-47ac-90c2-05312ee760d3",
                                                "sense_id": "02229cc1-33f4-3892-856a-1e388b81a3f0",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a381cf52-ed1d-4f8c-8a52-f8b2b53709b6",
                        "source_entry_id": "0b6ebc22-41ba-333d-99b7-94b97c47258a",
                        "source_sense_id": "8bd6b69f-9b62-3543-9a3b-b2f16700228b",
                        "target_lang_word": "keeping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keeping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cabb9c-4a57-3127-be0b-81e5cbd469bf",
                                        "entry_id": "59255d96-2686-33d3-9bed-cd9c44c5580b",
                                        "glosses": [
                                            "Conformity or harmony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3fdf0f-38be-4382-8488-71d74bba1bbb",
                                                "sense_id": "c1cabb9c-4a57-3127-be0b-81e5cbd469bf",
                                                "text": "The songs are new but in keeping with tradition."
                                            },
                                            {
                                                "example_id": "ab57bdcc-a031-48e7-8dd8-24038db09ab8",
                                                "sense_id": "c1cabb9c-4a57-3127-be0b-81e5cbd469bf",
                                                "text": "The foreground of this painting is not in keeping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a379dd-f8da-37e1-8db6-d1642ac2332f",
                                        "entry_id": "59255d96-2686-33d3-9bed-cd9c44c5580b",
                                        "glosses": [
                                            "Charge or care."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e34eae9-54a4-4650-b337-4e7c8872e978",
                                                "sense_id": "61a379dd-f8da-37e1-8db6-d1642ac2332f",
                                                "text": "His happiness is in his own keeping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18c2f0f3-230d-301d-b71f-140ffb29f38c",
                                        "entry_id": "59255d96-2686-33d3-9bed-cd9c44c5580b",
                                        "glosses": [
                                            "Maintenance; support; provision; feed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4dbf928-2483-4ded-8d08-429cf1ff6180",
                                                "sense_id": "18c2f0f3-230d-301d-b71f-140ffb29f38c",
                                                "text": "The cattle have good keeping."
                                            },
                                            {
                                                "example_id": "6e9d51af-67c8-4e52-976b-784349a30a72",
                                                "sense_id": "18c2f0f3-230d-301d-b71f-140ffb29f38c",
                                                "text": "The work of many hands, which earns my keeping"
                                            }
                                        ]
                                    }
                                ]
