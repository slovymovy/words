                    },
                    {
                        "translation_id": "38f9ca98-297d-4419-b600-0805be30b266",
                        "source_entry_id": "b58af5ea-6759-3c1b-b297-57aa02e7d379",
                        "source_sense_id": "7183288e-e97c-358a-8c2e-897b3dda98a2",
                        "source_sense_description": "reverse operation of mount",
                        "target_lang_word": "aushängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aushängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                        "entry_id": "aa4b94b5-32da-3159-b428-a174c3c3e667",
                                        "glosses": [
                                            "etwas (beispielsweise eine Tür, ein Fenster) aus seiner Aufhängung/von seinem Haken lösen"
                                        ],
                                        "tags": [
                                            "Handwerk",
                                            "Bergsteigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b315c9d5-50bc-4217-8645-06c39526d721",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "Bevor die Tür neu gestrichen werden kann, muss sie erst ausgehängt werden."
                                            },
                                            {
                                                "example_id": "99b4a066-95b2-40fc-8f64-8a602ffc6887",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "Die Reparatur eines Fahradschlauchs erfordert, dass das Rad ausgebaut werden muss. Dazu wird zuerst der Bowdenzug der Felgenbremse ausgehängt."
                                            },
                                            {
                                                "example_id": "25ecb79e-b086-4ce0-9f29-d40f8b442c01",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "„Anita Goßler, geb. Erler, wird 1953 im Alter von 20 Jahren [… in] der DDR zu fünf Jahren Strafvollzug verurteilt. […] Noch heute darf keiner hinter ihr stehen, in ihrer Wohnung sind alle Türen ausgehängt.“"
                                            },
                                            {
                                                "example_id": "be1a064c-486d-43ca-ab89-dec6ebb92dc2",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "„Zwei Jahre wurde die Aktion vorbereitet, am Montag wurden im Husumer Sperrwerk (Kreis Nordfriesland) die riesigen Sperrwerks-Tore ausgehängt.“"
                                            },
                                            {
                                                "example_id": "bdf1dd47-ac48-4e46-b6ca-0c342847c7ba",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "[Reparartur von Sonnenschirmen:] „Dazu wird einfach die Krone gelöst, die meistens festgenagelt oder geschraubt ist. Anschließend können die einzelnen Speichen ausgehängt und der gesamte Stoff abgezogen werden.“"
                                            },
                                            {
                                                "example_id": "ab60c333-4dd5-4dfd-8e0e-0a42cc312157",
                                                "sense_id": "b25b36bb-2a99-3545-8990-8f549a6f5d6a",
                                                "text": "„Wichtig ist, dass der Kletterer in jeder Phase des Umbauens oder -fädelns am Seil gesichert bleibt. Zwar fixiert sich der Kletterer am Umlenker mit einer oder zwei Expressen. Solange er diese unter Spannung hält, können sie sich nicht aushängen. Entlastet er sie jedoch, besteht die Gefahr, dass sie sich verdrehen und beim Wiederbelasten selbst aushängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                        "entry_id": "aa4b94b5-32da-3159-b428-a174c3c3e667",
                                        "glosses": [
                                            "etwas (meist durch einen Aushang) öffentlich bekannt machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e7dd70-5af2-4da4-82e3-c9a72df7b254",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "Die Regattaleitung hat die Starterliste an der Tür des Regattabüros ausgehängt."
                                            },
                                            {
                                                "example_id": "3894a508-e6fc-471a-bbf3-8dd11ea5bc25",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "Die Gemeindeverwaltung hängte die Bekanntmachungen der Gemeinde in drei Schaukästen im Dorf aus."
                                            },
                                            {
                                                "example_id": "dba5e3ce-0ab9-4101-8109-bc2537874a36",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "[Maó/Menorca/Spanien:] „Am Busbahnhof befindet sich ein Aufenthalts- und Informationszentrum, wo auch alle Busfahrpläne aushängen.“"
                                            },
                                            {
                                                "example_id": "0d4adb57-ff42-43b1-a54d-21888ab8ab07",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "[Engadin/Schweiz:] „Im Winter sind Lawinen eine grosse Gefahr. Bei den Ski- und Sesselliften in den Skigebieten sind täglich aktuelle Lawinenbulletins ausgehängt.“"
                                            },
                                            {
                                                "example_id": "ee8ef60e-44f6-48cc-bad8-31f5f37b07b8",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "„Wenn die Parteien ihre Plakate aushängen, ist der Wahlkampf endgültig allgegenwärtig.“"
                                            },
                                            {
                                                "example_id": "7b65e707-b7c7-41e9-a7d0-f7a3e9d53a0a",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "„Irma Pince, die Bibliothekarin der Hogwarts-Schule für Hexerei und Zauberei aus den Harry-Potter-Romanen, hatte einen unmissverständlichen Warnhinweis ausgehängt: \"Wer Bücher zerreißt, zerfetzt, zerschnipselt, verbiegt, faltet, verunstaltet, entstellt, beschmiert, bekleckst, durch die Gegend wirft, fallen lässt oder auf andere Weise beschädigt, misshandelt oder mit mangelndem Respekt behandelt, dem jage ich die schlimmsten Strafen auf den Hals, derer ich fähig bin.\"“"
                                            },
                                            {
                                                "example_id": "0e95fd28-8c9d-4f6b-bb33-129001f01e99",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "[Camping während der Coronapandemie 2020:] Denken Sie aber bitte an Ihre Mund-Nasen-Bedeckung und die Abstandsregelungen. Hygiene- und Abstandsvorgaben sind an den Campingplätzen ausgehängt."
                                            },
                                            {
                                                "example_id": "8573fdf5-ebe9-4351-9375-6b6ae22102af",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "[Coronapandemie 2021:] „11.3.2021, 7:20 Uhr – Die Stadt Stuttgart startet eine Kampagne, damit sich mehr pflegerische und medizinische Fachkräfte impfen lassen. Ein Bestandteil sind Plakate, die in Pflegeheimen und Krankenhäusern ausgehängt werden, teilte die Stadt mit.“"
                                            },
                                            {
                                                "example_id": "fa270491-f5a9-481b-913c-9d725b2a220b",
                                                "sense_id": "28f78e3f-aba2-3a2e-a7bf-f6e6e29942a7",
                                                "text": "[Coronapandemie 2021:] „Bei einer mehrtägigen Inzidenz über 300 an fünf aufeinanderfolgenden Tagen sind Versammlungen generell auf zehn Teilnehmende begrenzt. Welche Teilnehmerzahl gilt, wird tagesaktuell an der Verkündungstafel des Bürgeramtes ausgehängt und auf der Internetseite der Stadt Erfurt veröffentlicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68917074-ff18-327c-b9da-ca43a62a5371",
                                        "entry_id": "aa4b94b5-32da-3159-b428-a174c3c3e667",
                                        "glosses": [
                                            "etwas (beispielsweise Tücher, eine Fahne) aus dem Fenster hängen"
                                        ],
