                                "sense_id": "8b39d43a-9ecd-3b8f-960c-0440459682cd",
                                "text": "Exemples : je (pronom), un (déterminant), trop (adverbe), dans (préposition)"
                            },
                            {
                                "example_id": "ee2627e0-d5c7-4aba-89e3-eb44195f82f2",
                                "sense_id": "8b39d43a-9ecd-3b8f-960c-0440459682cd",
                                "text": "L’aspect qui est le produit de la co-occurrence du lexème et du grammème est plus complexe que celui du lexème."
                            }
                        ]
                    }
