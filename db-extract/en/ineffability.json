                                        "glosses": [
                                            "Eigenschaft einer sprachlichen Formulierung, für jemanden nicht korrekt aussprechbar (artikulierbar) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d57f608-a05b-4dd5-a78f-424efbe86d38",
                                                "sense_id": "bb68b6cd-dfb4-325b-b643-4cd66b3b2725",
                                                "text": "„Ich glaube nicht, dass es an der Unaussprechlichkeit der polnischen Variante lag.“"
                                            }
