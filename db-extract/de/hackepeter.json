                                        "sense_id": "95b58f71-a0e3-398b-948c-b05c7c594c9a",
                                        "entry_id": "579bdba4-4d7d-367d-b06c-4865593fe01d",
                                        "glosses": [
                                            "To lessen; to diminish; to diminish in speaking; to speak of lightly or slightingly; to minimise."
                                        ],
