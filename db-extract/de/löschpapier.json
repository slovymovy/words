                                                "text": "Na koniec, po godzinie pisania podniósł twarz znad bibuły, spojrzał na szyby zalane deszczem i końcem długiego, kościstego palca powiódł po brzegu zaczerwienionej powieki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "cdbd1e62-1701-3c55-950f-ff46fc21e826",
                                        "entry_id": "c1688e08-04b7-3c6b-b7ed-968f800a6725",
                                        "glosses": [
                                            "kolorowy papier do wyrobu ozdób"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715572db-1429-4e16-a656-91386d36a516",
                                                "sense_id": "cdbd1e62-1701-3c55-950f-ff46fc21e826",
                                                "text": "U pani Karoliny stał wazon z kwiatami z bibuły wykonanymi przez jej wnuki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "539f30ac-5470-376b-85c7-61afc39386eb",
                                        "entry_id": "c1688e08-04b7-3c6b-b7ed-968f800a6725",
                                        "glosses": [
                                            "wydawnictwo konspiracyjne"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c3fb94b-22ed-4450-a4ff-433bd150dc8f",
                                                "sense_id": "539f30ac-5470-376b-85c7-61afc39386eb",
                                                "text": "W Internecie istnieje witryna z bibułą z okresu stanu wojennego."
                                            },
                                            {
                                                "example_id": "382e01ef-f9d7-478b-9d88-f5c725da4cbb",
                                                "sense_id": "539f30ac-5470-376b-85c7-61afc39386eb",
                                                "text": "Edka złapali z walizą bibuły, jak nic odsiedzi ze trzy lata."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "8843c5f8-8fd1-34a1-8019-06c7353256a6",
                                        "entry_id": "c1688e08-04b7-3c6b-b7ed-968f800a6725",
                                        "glosses": [
                                            "materiały drukowane"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [],
