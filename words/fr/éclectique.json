{
    "word_family": [
        "éclectisme",
        "éclectiquement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                    "sense_definition": "Qui a des goûts variés, qui s'intéresse à des domaines ou des styles très divers sans s'enfermer dans un cadre unique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variete_et_ouverture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a des goûts musicaux très <w>éclectiques</w>, passant sans hésiter du jazz ancien au rock contemporain."
                        },
                        {
                            "text": "Cet auteur <w>éclectique</w> s'intéresse aussi bien à la science-fiction moderne qu'au roman historique."
                        }
                    ],
                    "synonyms": [
                        "ouvert",
                        "polyvalent",
                        "varié"
                    ],
                    "antonyms": [
                        "borné",
                        "exclusif",
                        "sectaire"
                    ],
                    "common_phrases": [
                        "goûts éclectiques",
                        "esprit éclectique"
                    ]
                },
                {
                    "sense_id": "ca2f9cf6-e486-3bd0-a966-ebe1bdd370ce",
                    "sense_definition": "Qui est composé d'éléments d'origines, de styles ou d'époques très variés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variete_et_ouverture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le festival d'été propose une programmation particulièrement <w>éclectique</w> pour séduire tous les publics."
                        },
                        {
                            "text": "L'appartement est décoré dans un style <w>éclectique</w> associant des meubles anciens et des objets modernes."
                        }
                    ],
                    "synonyms": [
                        "composite",
                        "diversifié",
                        "hétéroclite"
                    ],
                    "antonyms": [
                        "homogène",
                        "uniforme"
                    ],
                    "common_phrases": [
                        "style éclectique",
                        "collection éclectique",
                        "programmation éclectique"
                    ]
                },
                {
                    "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                    "sense_definition": "Qui n'adopte pas une doctrine exclusive mais choisit dans divers systèmes les thèses jugées les plus justes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La méthode <w>éclectique</w> refuse de s'assujettir aux préceptes rigides d'une école de pensée unique."
                        },
                        {
                            "text": "Ce penseur <w>éclectique</w> tente de concilier la métaphysique classique avec les principes de l'empirisme."
                        }
                    ],
                    "synonyms": [
                        "syncrétique"
                    ],
                    "antonyms": [
                        "dogmatique",
                        "sectaire"
                    ],
                    "common_phrases": [
                        "philosophie éclectique",
                        "méthode éclectique"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                    "sense_definition": "Personne qui refuse d'adhérer à un système unique et choisit ce qui lui paraît bon dans différentes doctrines ou tendances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En matière d'art, cet amateur se définit volontiers comme un <w>éclectique</w> affranchi de toute influence doctrinale."
                        },
                        {
                            "text": "Les <w>éclectiques</w> de ce siècle cherchaient à réunir le meilleur des traditions intellectuelles du passé."
                        }
                    ],
                    "synonyms": [
                        "syncrétiste"
                    ],
                    "antonyms": [
                        "dogmatique",
                        "sectaire"
                    ]
                }
            ]
        }
    ]
}