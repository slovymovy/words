                    {
                        "sense_id": "51b72454-a96b-3ca9-8512-7b9eec95a700",
                        "entry_id": "251a90de-b644-3ecf-b09e-f60850dcbd57",
                        "glosses": [
                            "Destruction de l’état de carburation d’une substance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0899c798-e15b-4d6b-8c02-4ef6e5323c69",
                                "sense_id": "51b72454-a96b-3ca9-8512-7b9eec95a700",
                                "text": "La décarburation de la fonte de fer se fait par une opération appelée le mazéage."
                            },
                            {
                                "example_id": "648677e2-621b-4eb9-ada9-5b8cb0b9f53f",
                                "sense_id": "51b72454-a96b-3ca9-8512-7b9eec95a700",
                                "text": "« En politique, voyez, parmi les Dilatés, Danton, Mirabeau Gambetta, Jaurès. Dans le commerce, Siemens, l’inventeur du four pour la décarburation de l’acier à foyer ouvert, et Boucicault, fondateur des grands magasins du Bon Marché. »"
                            },
                            {
                                "example_id": "e977ed3f-4612-45e3-b4c8-7c384eec9138",
                                "sense_id": "51b72454-a96b-3ca9-8512-7b9eec95a700",
                                "text": "L’attaque par l’hydrogène à chaud peut prendre deux formes, la décarburation de surface et la décarburation interne."
                            }
                        ]
                    }
                ],
