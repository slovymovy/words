{
    "word_family": [
        "гасить",
        "гаснущий",
        "погашение",
        "угасание"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b6dc990-f890-31de-8caf-29fe3980db71",
                    "sense_definition": "Перестать гореть (об огне, свече, лампе).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате внезапно <w>погас</w> свет.",
                            "target_lang_translations": {
                                "en": "The light suddenly <w>went out</w> in the room."
                            }
                        },
                        {
                            "text": "Свеча <w>погаснет</w> скоро, если её не защитить от ветра.",
                            "target_lang_translations": {
                                "en": "The candle will <w>go out</w> soon if it is not protected from the wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "потухнуть"
                    ],
                    "antonyms": [
                        "загореться"
                    ],
                    "common_phrases": [
                        "свет погас",
                        "свеча погасла"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop burning (of a fire, candle, or lamp)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go out",
                                "target_lang_sense_clarification": "To stop burning or to be extinguished."
                            },
                            {
                                "target_lang_word": "extinguish",
                                "target_lang_sense_clarification": "To cause a fire or light to stop burning."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e98e64d-cce8-3877-9aa9-537e33c33e50",
                    "sense_definition": "Утратить блеск, живость или выразительность (о глазах, взгляде).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От сильной усталости его глаза <w>погасли</w>.",
                            "target_lang_translations": {
                                "en": "His eyes <w>faded</w> from extreme fatigue."
                            }
                        },
                        {
                            "text": "Взгляд старика <w>погас</w> после печальных новостей.",
                            "target_lang_translations": {
                                "en": "The old man's gaze <w>faded</w> after the sad news."
                            }
                        }
                    ],
                    "common_phrases": [
                        "глаза погасли"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose shine, liveliness, or expressiveness (of eyes or a gaze)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "To lose brightness or intensity."
                            },
                            {
                                "target_lang_word": "go dull",
                                "target_lang_sense_clarification": "To lose sparkle or life."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7102fe14-70c8-3483-97e6-09367b1272d9",
                    "sense_definition": "Утихнуть, ослабеть или прекратиться (о чувствах, мыслях, явлениях).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Со временем интерес к этому проекту <w>погас</w>.",
                            "target_lang_translations": {
                                "en": "Over time, interest in this project <w>faded</w>."
                            }
                        },
                        {
                            "text": "Любовь в их сердцах <w>погасла</w> спустя много лет.",
                            "target_lang_translations": {
                                "en": "Love in their hearts <w>faded</w> after many years."
                            }
                        }
                    ],
                    "synonyms": [
                        "угаснуть"
                    ],
                    "common_phrases": [
                        "интерес погас"
                    ],
                    "target_lang_definitions": {
                        "en": "To subside, weaken, or cease (of feelings, thoughts, or phenomena)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fade away",
                                "target_lang_sense_clarification": "To gradually disappear or weaken."
                            },
                            {
                                "target_lang_word": "die out",
                                "target_lang_sense_clarification": "To gradually cease to exist or be felt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10abe51a-b24d-33f4-96a3-a106b1942eac",
                    "sense_definition": "Умереть (о человеке).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Великий поэт <w>погас</w> в расцвете своих сил.",
                            "target_lang_translations": {
                                "en": "The great poet <w>passed away</w> in the prime of his life."
                            }
                        },
                        {
                            "text": "Он тихо <w>погас</w> во сне в глубокой старости.",
                            "target_lang_translations": {
                                "en": "He <w>passed away</w> quietly in his sleep at a ripe old age."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Используется в возвышенном или устаревшем стиле."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To die (of a person)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass away",
                                "target_lang_sense_clarification": "A gentle or euphemistic way to say someone has died."
                            },
                            {
                                "target_lang_word": "fade away",
                                "target_lang_sense_clarification": "To die slowly or peacefully, often used in a literary sense."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}