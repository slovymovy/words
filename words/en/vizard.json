{
    "word_family": [
        "visor",
        "envisage",
        "vision"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05a7fe88-d485-34c8-96ee-23be940ed4f3",
                    "sense_definition": "A mask used for disguise or protection, especially one covering the face.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "masking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor adjusted his black <w>vizard</w> before stepping onto the stage to play the mysterious villain.",
                            "target_lang_translations": {
                                "ru": "Актер поправил свою черную <w>маску</w>, прежде чем выйти на сцену в роли таинственного злодея."
                            }
                        },
                        {
                            "text": "In the old play, a single performer could play many roles simply by changing a <w>vizard</w>.",
                            "target_lang_translations": {
                                "ru": "В старинной пьесе один исполнитель мог играть множество ролей, просто меняя <w>личину</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mask",
                        "disguise"
                    ],
                    "common_phrases": [
                        "black vizard mask"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now largely replaced by the word mask"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маска, используемая для маскировки или защиты, особенно закрывающая лицо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "для лица"
                            },
                            {
                                "target_lang_word": "личина",
                                "target_lang_sense_clarification": "устаревшее название маски"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19144334-4f77-335a-a340-0b5be31c60c3",
                    "sense_definition": "The movable part of a helmet that covers the face; a <w>visor</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight lowered the <w>vizard</w> of his helmet as he prepared to charge into the tournament.",
                            "target_lang_translations": {
                                "ru": "Рыцарь опустил <w>забрало</w> своего шлема, готовясь ринуться в бой на турнире."
                            }
                        },
                        {
                            "text": "Through the narrow slit in his <w>vizard</w>, the soldier could barely see the approaching enemy.",
                            "target_lang_translations": {
                                "ru": "Через узкую щель в своем <w>забрале</w> солдат едва видел приближающегося врага."
                            }
                        }
                    ],
                    "synonyms": [
                        "visor"
                    ],
                    "common_phrases": [
                        "helmet vizard"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for armor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная часть шлема, закрывающая лицо; забрало."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забрало",
                                "target_lang_sense_clarification": "часть шлема"
                            },
                            {
                                "target_lang_word": "визор",
                                "target_lang_sense_clarification": "защитный щиток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d49994-b9e2-3752-9334-3e43a73e12de",
                    "sense_definition": "An outward appearance or pretense used to hide one's true nature or intentions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "masking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hid his cruel intentions under a <w>vizard</w> of friendship and kindness.",
                            "target_lang_translations": {
                                "ru": "Он скрывал свои жестокие намерения под <w>личиной</w> дружбы и доброты."
                            }
                        },
                        {
                            "text": "The politician used a <w>vizard</w> of virtue to deceive the public about his financial dealings.",
                            "target_lang_translations": {
                                "ru": "Политик использовал <w>маску</w> добродетели, чтобы обмануть общественность относительно своих финансовых дел."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretense",
                        "guise",
                        "facade"
                    ],
                    "common_phrases": [
                        "virtuous vizard"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний вид или притворство, используемые для сокрытия своей истинной природы или намерений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личина",
                                "target_lang_sense_clarification": "притворство"
                            },
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "скрывающая истинные намерения"
                            },
                            {
                                "target_lang_word": "прикрытие",
                                "target_lang_sense_clarification": "видимость чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f74b5066-3551-3b49-8cb4-33a281f4936d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local records mention a man named Thomas <w>Vizard</w> who lived in the village during the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "В местных записях упоминается человек по имени Томас <w>Визард</w>, живший в деревне в восемнадцатом веке."
                            }
                        },
                        {
                            "text": "We are researching the genealogy of the <w>Vizard</w> family in this region.",
                            "target_lang_translations": {
                                "ru": "Мы исследуем генеалогию семьи <w>Визард</w> в этом регионе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Визард",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}