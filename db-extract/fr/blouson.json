                ],
                "senses": [
                    {
                        "sense_id": "e6ad4339-2c79-3e5b-af09-e090ae69d63d",
                        "entry_id": "dff2ad06-c90c-3f39-8604-a04522d1c1b2",
                        "glosses": [
                            "Manteau court pris à la taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09553e38-d684-4537-add9-94b35b3b72db",
                                "sense_id": "e6ad4339-2c79-3e5b-af09-e090ae69d63d",
                                "text": "Tu as pourtant l'air d'un gars costaud, un gars à qui on ne la fait pas, avec ton blouson, tes santiags et ta banane. Un vrai rocker..."
                            },
                            {
                                "example_id": "a2694e8d-783d-40fe-8daa-6d5a3bc64c41",
                                "sense_id": "e6ad4339-2c79-3e5b-af09-e090ae69d63d",
                                "text": "Le blouson en jean, devenu un basique de la garde-robe féminine comme masculine, est le blouson le plus porté aujourd'hui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ff0b42f-8894-4398-8c38-890823fab751",
                        "source_entry_id": "dff2ad06-c90c-3f39-8604-a04522d1c1b2",
                        "source_sense_id": "e6ad4339-2c79-3e5b-af09-e090ae69d63d",
                        "target_lang_word": "Jacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                        "entry_id": "a0230f66-884b-3850-9f1a-38262a7e57b3",
                                        "glosses": [
                                            "ein Bekleidungsstück für Männer und Frauen, welches zum Bedecken des Oberkörpers vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ddb63c-eb95-4dbf-a551-58b43c0ece2c",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "Ziehe dir eine Jacke über, es ist Herbst!"
                                            },
                                            {
                                                "example_id": "183fdd4f-44af-46c8-b930-8066d3b34c76",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zieht die Jacke aus.“"
                                            },
                                            {
                                                "example_id": "11dd9b12-096e-49c1-b4ff-cdc16afc161a",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„In Kopenhagen vor einem Haustor von vornehmem Aussehen steht ein Soldat in einer ziemlich neuen Jacke und Stulpenstiefeln, mit Gürtel um den Leib und einem schwarzen Kriegerhut, jedoch ohne Waffen.“"
                                            },
                                            {
                                                "example_id": "a5566e23-d7bd-4edd-a7cf-f8d8e4dbcb15",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zog den Reißverschluss der Jacke höher, setzte die Kapuze auf und beeilte sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cd0af29-e56a-4cf2-b957-665f0f7faac9",
                        "source_entry_id": "dff2ad06-c90c-3f39-8604-a04522d1c1b2",
                        "source_sense_id": "e6ad4339-2c79-3e5b-af09-e090ae69d63d",
                        "target_lang_word": "jacket",
