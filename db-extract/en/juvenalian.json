                        "glosses": [
                            "Of or pertaining to the Roman poet Juvenal or to his (satirical) works or style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b58582-a725-48a9-8fc2-cb51dfee47ed",
                                "sense_id": "bea86f3f-626c-39fb-a2e4-535c80dc19c7",
                                "text": "The satire here is more heavy-handed and the tone more Juvenalian than in any passage in the first volume."
                            },
                            {
                                "example_id": "810c1915-6171-4611-9b42-a025157ba8bc",
                                "sense_id": "bea86f3f-626c-39fb-a2e4-535c80dc19c7",
                                "text": "The satiric voice, as Gadeken (2002) argues, is more Juvenalian in tone, but is confined almost exclusively to the narrator."
                            },
                            {
                                "example_id": "3b1e2676-0ddf-46d6-9e62-596a9dc5615e",
                                "sense_id": "bea86f3f-626c-39fb-a2e4-535c80dc19c7",
                                "text": "2019, Ronald Paulson, The Fictions of Satire, Johns Hopkins University Press, Open access edition, unnumbered page,\nAt its most Juvenalian, it follows from Horace's Venusian ancestors, who guarded the Roman border against barbarians, as Horace does figuratively now."
                            }
                        ]
                    }
