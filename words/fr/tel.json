                        "d'une telle ampleur"
                    ]
                },
                {
                    "sense_id": "e52ebdbc-41c5-39d8-be4b-5e40f7edb28f",
                    "sense_definition": "Se place en tête de phrase pour qualifier ou résumer ce qui vient d'être énoncé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Telle</w> est la situation économique actuelle de notre pays après ces réformes."
                        },
                        {
                            "text": "<w>Tel</w> fut le résultat définitif de cette longue et difficile négociation."
                        }
                    ],
                    "common_phrases": [
