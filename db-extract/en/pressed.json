                ],
                "senses": [
                    {
                        "sense_id": "65cff2a5-2eb7-3d4e-9a74-918da4d6f12b",
                        "entry_id": "8158b90f-482c-35c9-b711-06f8bd0e9cae",
                        "glosses": [
                            "Under strain or deprivation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96479f5b-6842-453d-9a67-afd710923100",
                                "sense_id": "65cff2a5-2eb7-3d4e-9a74-918da4d6f12b",
                                "text": "The staff was even more pressed for useful intelligence about the enemy's intentions than it was about the enemy's capabilities."
                            },
                            {
                                "example_id": "4d3c7eea-11a7-4866-8367-f9c9b0ba4d44",
                                "sense_id": "65cff2a5-2eb7-3d4e-9a74-918da4d6f12b",
                                "text": "He found himself hard pressed."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aa98de1-fc9f-3063-b32b-76d28731a520",
                        "entry_id": "8158b90f-482c-35c9-b711-06f8bd0e9cae",
                        "glosses": [
                            "Upset, bothered."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "f64d384a-75f9-46fd-b691-e40ea269d833",
                                "sense_id": "8aa98de1-fc9f-3063-b32b-76d28731a520",
                                "text": "Cardi B hater’s are pressed because she won a Grammy for best album of the year"
                            },
                            {
                                "example_id": "174faa5a-4b99-41fb-a5e7-b690d372c2b5",
                                "sense_id": "8aa98de1-fc9f-3063-b32b-76d28731a520",
                                "text": "She did what she always does: laid out a trap, and the well-intended took the bait. Like clockwork. Why do we stay so pressed instead of just ignoring her?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9db7e6e7-e9dc-350c-8a68-c046ace2c280",
                        "entry_id": "8158b90f-482c-35c9-b711-06f8bd0e9cae",
                        "glosses": [
                            "Recruited by a press gang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db098ed-e2da-47c9-9b92-1914953fcfd8",
                                "sense_id": "9db7e6e7-e9dc-350c-8a68-c046ace2c280",
                                "text": "The most obvious source for tracking pressed men is the muster books of the individual ships, for these encompass those impressed both afloat and ashore. Yet the muster books are notoriously uneven in quality as an historical source."
                            }
                        ]
                    }
                ],
