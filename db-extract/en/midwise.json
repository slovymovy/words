                                "sense_id": "956592bc-9c7b-38f9-9ec5-63942f6a8327",
                                "text": "The joints formed by the abutting ends of the sections of the even numbered strands and those of the odd numbered strands are placed midwise or staggered of each other."
                            },
                            {
                                "example_id": "daa42992-f8a2-440f-87db-5b9a9bf1e355",
                                "sense_id": "956592bc-9c7b-38f9-9ec5-63942f6a8327",
                                "text": "Turning off midwise of the great corridor, Bearface guided his comrade to the right along a passage at the end of which was a small anteroom and a door that supplied legends for all of Italy."
                            }
                        ]
