                            }
                        ]
                    },
                    {
                        "translation_id": "75567d00-95cc-4bce-98e4-5b6415e00a53",
                        "source_entry_id": "08feaa62-67d3-30a0-8428-510cb3c6dfa1",
                        "target_lang_word": "anticipate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticipate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d47f616-b4db-3c53-bc4c-b3ea794ce511",
                                        "entry_id": "0705bdd6-7f7c-3988-a9b5-4603cbeb558d",
                                        "glosses": [
                                            "To act before (someone), especially to prevent an action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60c9215-c134-4af5-b6c2-bb0f233b9a0e",
                                                "sense_id": "2d47f616-b4db-3c53-bc4c-b3ea794ce511",
                                                "text": "c. 1824 (written, published in 1891) Robert Hall, Fragment on Popery\nWhen two parties, each formidable for their numbers, and the weight of their influence and property, are animated by an equal degree of zeal, it is natural to anticipate the final success of that which possesses the most inherent strength."
                                            },
                                            {
                                                "example_id": "8b8c7d49-8bf7-4912-9ac3-554f334fd498",
                                                "sense_id": "2d47f616-b4db-3c53-bc4c-b3ea794ce511",
                                                "text": "He would probably have died by the hand of the executioner, if indeed the executioner had not been anticipated by the populace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0772c5bb-cc21-3c89-bfe2-a08ff11c3c8d",
                                        "entry_id": "0705bdd6-7f7c-3988-a9b5-4603cbeb558d",
                                        "glosses": [
                                            "To take up or introduce (something) prematurely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2b0e44-37c0-4f9a-8865-5f21a2fdad85",
                                                "sense_id": "0772c5bb-cc21-3c89-bfe2-a08ff11c3c8d",
                                                "text": "The advocate plans to anticipate a part of her argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                        "entry_id": "0705bdd6-7f7c-3988-a9b5-4603cbeb558d",
                                        "glosses": [
                                            "To know of (something) before it happens; to expect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d34fced-919d-4fb6-8ba7-59de300bb7b8",
                                                "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                                "text": "to anticipate the evils of life"
                                            },
                                            {
                                                "example_id": "fe39a1c8-5c99-4500-b747-2d4b3a6fe80a",
                                                "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                                "text": "Please anticipate a journey of an hour from your house to the airport."
                                            },
                                            {
                                                "example_id": "16d3f9cb-9363-4f09-966d-3463f86cfb14",
                                                "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                                "text": "to anticipate the pleasures of a visit"
                                            },
                                            {
                                                "example_id": "7b9aa294-baca-40a1-89fa-2c9d711596ed",
                                                "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                                "text": "The task was more to Appleby's liking than the one he had anticipated, and it was necessary, since the smaller merchants in Cuba and also in parts of Peninsular Spain have no great confidence in bankers, and prefer a packet of golden onzas or a bag of pesetas to the best accredited cheque."
                                            },
                                            {
                                                "example_id": "459c9026-1d7d-4427-9ed7-53dfe450fe00",
                                                "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                                                "text": "But surely they did not anticipate the ease with which their team raced into an almost impregnable half-time lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ecf9d3-b048-358c-ba6d-3012b752efb3",
                                        "entry_id": "0705bdd6-7f7c-3988-a9b5-4603cbeb558d",
                                        "glosses": [
                                            "To eagerly wait for (something)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cfd5077-7e33-4794-b066-6227e90fff0c",
                                                "sense_id": "02ecf9d3-b048-358c-ba6d-3012b752efb3",
                                                "text": "Little Johnny started to anticipate the arrival of Santa Claus a week before Christmas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52e03c0-a731-4364-892f-7d03e790e932",
                        "source_entry_id": "08feaa62-67d3-30a0-8428-510cb3c6dfa1",
                        "target_lang_word": "prevent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prevent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To stop (an outcome); to keep from (doing something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e0ee6c-7298-4212-91d2-7ea858db3c8f",
                                                "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                                "text": "I brush my teeth regularly to prevent tooth decay."
                                            },
                                            {
                                                "example_id": "689737c4-e5a5-429c-b4cf-44bb08da66b5",
                                                "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                                                "text": "Scotland must now hope Georgia produce a huge upset and beat Argentina by at least eight points in Sunday's final Pool B match to prevent them failing to make the last eight for the first time in World Cup history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To take preventative measures."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84cf2369-7f27-49cc-b8f8-fbfcd22c50e1",
                                                "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                                                "text": "I think you must be mad, and she shall not have a glimpse of it while I'm here to prevent!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To come before; to precede."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a9c523-71c3-4649-b6e0-c2a728af737e",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "We pray thee that thy grace may always prevent and follow us."
                                            },
                                            {
                                                "example_id": "fc0a278c-ac32-413b-b8fc-cb120c8398b2",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "We which are alive and remain unto the coming of the Lord shall not prevent them which are asleep."
                                            },
                                            {
                                                "example_id": "b784e75f-3b37-4a33-8cd2-eb1ae754434c",
                                                "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                                                "text": "Then had I come, preventing Sheba's Queen, / To ſee the comelieſt of the Sons of Men; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To outdo, surpass."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cca6901d-82d1-4d94-818f-36f42e6dae2c",
                                                "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                                                "text": "With that he put his spurres vnto his steed, / With speare in rest, and toward him did fare, / Like shaft out of a bow preuenting speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                                        "entry_id": "6cb0ff99-f867-3ffd-9e3d-d49306af5d86",
                                        "glosses": [
                                            "To be beforehand with; to anticipate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981679c2-7154-48cc-b18d-e38c03303230",
                                                "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                                                "text": "their ready guilt preventing thy commands"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
