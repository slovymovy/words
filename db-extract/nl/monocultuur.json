                                "sense_id": "34f203f8-9b43-3193-9cdd-58d65628b914",
                                "text": "Op bananenplantages wordt vaak gewerkt met monoculturen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6273e2cc-2d87-3398-993a-0ee73aee7bad",
                        "entry_id": "630f537c-b2d0-3e65-8473-cfb878fe75e8",
                        "glosses": [
                            "eenzijdige samenstelling van mensen, producten of diensten binnen een samenleving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39db66b0-9456-4786-af60-74ffe8fbed33",
                                "sense_id": "6273e2cc-2d87-3398-993a-0ee73aee7bad",
                                "text": "Vele dictatoriale regimes maken gebruik van een monocultuur op het vlak van bepaalde diensten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69b24df5-65d5-4661-a80b-9026bbec253d",
                        "source_entry_id": "630f537c-b2d0-3e65-8473-cfb878fe75e8",
