                "senses": [
                    {
                        "sense_id": "f81de004-c971-3e40-8ada-7cd9d2a7678c",
                        "entry_id": "76f3f989-4e1f-3691-b7ea-ac0277cbde72",
                        "glosses": [
                            "Faire perdre son caractère d’avocat à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d2639d-c118-4401-ad9e-8b9e326c63ce",
                                "sense_id": "f81de004-c971-3e40-8ada-7cd9d2a7678c",
                                "text": "Dans dix minutes rentrez dans ce salon, — vous serez désavocassé, mon cher."
                            },
                            {
                                "example_id": "bdf15ecc-3fae-444b-8a4e-4269bd6a7e1e",
                                "sense_id": "f81de004-c971-3e40-8ada-7cd9d2a7678c",
                                "text": "À mesure qu’ils y pénètrent, et à chaque nœud nouveau de la spirale, on les voit se décicéroniser, se désavocasser, perdre la gale des rhétoriques et la rogne des philosophies mythologiques dont ils étaient paralysés."
                            }
                        ]
                    }
                ],
