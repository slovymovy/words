{
    "word_family": [
        "cheerful",
        "cheerless",
        "cheery",
        "cheerleader",
        "cheerfulness",
        "cheerily"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "90a43f3d-2dcc-3eeb-92dc-32ef10125d42",
                    "sense_definition": "A common toast used when drinking in company.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toast_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We raised our glasses high and shouted <w>cheers</w>.",
                            "target_lang_translations": {
                                "ru": "Мы высоко подняли бокалы и крикнули: «<w>За здоровье</w>!»",
                                "zh": "我们高举酒杯，大喊一声“<w>干杯</w>”。"
                            }
                        },
                        {
                            "text": "He smiled at his friends and said <w>cheers</w> before taking a sip.",
                            "target_lang_translations": {
                                "ru": "Он улыбнулся друзьям и сказал: «<w>Будем здоровы</w>», прежде чем сделать глоток.",
                                "zh": "他微笑着对朋友们说了声“<w>干杯</w>”，然后喝了一口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottoms up",
                        "chin-chin",
                        "here's to"
                    ],
                    "common_phrases": [
                        "cheers to us",
                        "three cheers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенный тост, произносимый во время выпивки в компании.",
                        "zh": "饮酒时常用的祝酒词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за здоро́вье",
                                "target_lang_sense_clarification": "общий тост"
                            },
                            {
                                "target_lang_word": "бу́дем здоро́вы",
                                "target_lang_sense_clarification": "разговорный вариант"
                            },
                            {
                                "target_lang_word": "ва́ше здоро́вье",
                                "target_lang_sense_clarification": "вежливая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干杯",
                                "target_lang_sense_clarification": "最常用的祝酒词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369e6d08-4543-3a6b-8c94-6a0221d1997b",
                    "sense_definition": "Used to express gratitude or thanks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cheers</w> for helping me carry these heavy boxes.",
                            "target_lang_translations": {
                                "ru": "<w>Спасибо</w>, что помог мне донести эти тяжелые коробки.",
                                "zh": "<w>谢谢</w>你帮我搬这些重箱子。"
                            }
                        },
                        {
                            "text": "Here is the book you asked for. — <w>Cheers</w>, mate.",
                            "target_lang_translations": {
                                "ru": "Вот книга, которую ты просил. — <w>Спасибо</w>, дружище.",
                                "zh": "这是你要的书。——<w>谢谢</w>啦，伙计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thanks",
                        "thank you",
                        "ta"
                    ],
                    "common_phrases": [
                        "cheers mate",
                        "cheers for that"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения благодарности.",
                        "zh": "用于表达感谢。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спаси́бо",
                                "target_lang_sense_clarification": "благодарность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢谢",
                                "target_lang_sense_clarification": "表达谢意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbb36339-9ae0-3796-bd0e-b27c7f8acc7c",
                    "sense_definition": "Used to say goodbye, especially as a sign-off in an email or conversation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "farewell_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to go home now, so <w>cheers</w>!",
                            "target_lang_translations": {
                                "ru": "Мне пора домой, так что <w>пока</w>!",
                                "zh": "我现在得回家了，<w>再见</w>！"
                            }
                        },
                        {
                            "text": "See you at the meeting tomorrow, <w>cheers</w>.",
                            "target_lang_translations": {
                                "ru": "Увидимся завтра на собрании, <w>счастливо</w>.",
                                "zh": "明天会上见，<w>再见</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bye",
                        "cheerio",
                        "so long",
                        "ta-ta",
                        "see ya",
                        "bye-bye"
                    ],
                    "common_phrases": [
                        "cheers for now",
                        "cheers mate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется при прощании, особенно в конце письма или разговора.",
                        "zh": "用于告别，常见于非正式场合或信件结尾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пока́",
                                "target_lang_sense_clarification": "неформальное прощание"
                            },
                            {
                                "target_lang_word": "счастли́во",
                                "target_lang_sense_clarification": "пожелание удачи при прощании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再见",
                                "target_lang_sense_clarification": "非正式告别"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6742c2d5-c404-353b-9532-93e2ca3f0285",
                    "sense_definition": "Plural of <w>cheer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd gave three loud <w>cheers</w> for the winning team.",
                            "target_lang_translations": {
                                "ru": "Толпа трижды громко прокричала «<w>ура</w>» в честь победившей команды.",
                                "zh": "人群为获胜的队伍发出了三声响亮的<w>欢呼</w>。"
                            }
                        },
                        {
                            "text": "He was greeted with <w>cheers</w> and applause when he walked on stage.",
                            "target_lang_translations": {
                                "ru": "Когда он вышел на сцену, его встретили <w>радостными возгласами</w> и аплодисментами.",
                                "zh": "他走上舞台时，迎接他的是<w>欢呼</w>和掌声。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова cheer (возглас одобрения, ура).",
                        "zh": "欢呼声或喝彩声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́достные во́згласы",
                                "target_lang_sense_clarification": "одобрение толпы"
                            },
                            {
                                "target_lang_word": "кри́ки «ура́»",
                                "target_lang_sense_clarification": "специфический возглас"
                            },
                            {
                                "target_lang_word": "ова́ции",
                                "target_lang_sense_clarification": "громкое одобрение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "表示赞同或喜悦的叫喊"
                            },
                            {
                                "target_lang_word": "喝彩",
                                "target_lang_sense_clarification": "对表演或成就的赞赏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f3ea636-6e8f-3098-a20c-242a4e643fdc",
                    "sense_definition": "Third-person singular simple present indicative of <w>cheer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always <w>cheers</w> for her favorite football player.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>болеет</w> за своего любимого футболиста.",
                                "zh": "她总是为她最喜欢的足球运动员<w>加油</w>。"
                            }
                        },
                        {
                            "text": "The audience <w>cheers</w> loudly whenever the band starts a new song.",
                            "target_lang_translations": {
                                "ru": "Публика громко <w>ликует</w>, когда группа начинает новую песню.",
                                "zh": "每当乐队开始演奏新歌时，观众都会大声<w>欢呼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа глагола cheer (поддерживать, болеть, аплодировать).",
                        "zh": "为某人或某事加油、喝彩或表示支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боле́ет",
                                "target_lang_sense_clarification": "за спортивную команду"
                            },
                            {
                                "target_lang_word": "лику́ет",
                                "target_lang_sense_clarification": "выражает радость"
                            },
                            {
                                "target_lang_word": "аплоди́рует",
                                "target_lang_sense_clarification": "хлопает"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加油",
                                "target_lang_sense_clarification": "为比赛或活动助威"
                            },
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "大声表示喜悦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e847563-0c69-32f8-b1e7-01377d1f7274",
                    "sense_definition": "To say \"cheers\" as a toast to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>cheersed</w> to the happy couple at the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Мы <w>подняли тост</w> за счастливую пару на свадебном приеме.",
                                "zh": "在婚宴上，我们为这对幸福的新人<w>碰杯</w>祝贺。"
                            }
                        },
                        {
                            "text": "They <w>cheersed</w> their glasses together before drinking the wine.",
                            "target_lang_translations": {
                                "ru": "Они <w>чокнулись</w> бокалами, прежде чем выпить вина.",
                                "zh": "他们在喝酒前先<w>碰杯</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "verb derived from interjection"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить тост или чокаться бокалами.",
                        "zh": "碰杯祝酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чо́каться",
                                "target_lang_sense_clarification": "соприкасаться бокалами"
                            },
                            {
                                "target_lang_word": "поднима́ть тост",
                                "target_lang_sense_clarification": "произносить речь перед выпивкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰杯",
                                "target_lang_sense_clarification": "饮酒时杯子相碰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
