{
    "word_family": [
        "praiseworthy",
        "praiser",
        "praisingly",
        "unpraised"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43e35a22-0ce0-3be7-a0df-857e8d91b60c",
                    "sense_definition": "An expression of approval, admiration, or commendation for someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave the student high <w>praise</w> for her excellent performance on the final exam.",
                            "target_lang_translations": {
                                "ru": "Учитель удостоил ученицу высокой <w>похвалы</w> за её отличные результаты на выпускном экзамене."
                            }
                        },
                        {
                            "text": "You deserve <w>praise</w> for the hard work you have done on this project recently.",
                            "target_lang_translations": {
                                "ru": "Вы заслуживаете <w>похвалы</w> за ту тяжелую работу, которую вы проделали над этим проектом в последнее время."
                            }
                        }
                    ],
                    "synonyms": [
                        "accolade",
                        "approval",
                        "compliment",
                        "commendation",
                        "encouragement"
                    ],
                    "antonyms": [
                        "blame",
                        "criticism",
                        "condemnation"
                    ],
                    "common_phrases": [
                        "high praise",
                        "deserve praise",
                        "receive praise",
                        "sing someone's praises"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение одобрения, восхищения или признания заслуг кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похвала",
                                "target_lang_sense_clarification": "одобрение или лестный отзыв"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "признание правильным или хорошим"
                            },
                            {
                                "target_lang_word": "комплимент",
                                "target_lang_sense_clarification": "любезные, приятные слова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44f364ff-697d-380c-9adb-5cd8b17d65e7",
                    "sense_definition": "The act of worshiping, glorifying, or showing adoration to a deity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "worship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The congregation gathered in the church to offer <w>praise</w> to God through song.",
                            "target_lang_translations": {
                                "ru": "Прихожане собрались в церкви, чтобы воздать <w>хвалу</w> Богу в песнопениях."
                            }
                        },
                        {
                            "text": "The ancient hymns were written as a form of <w>praise</w> and devotion.",
                            "target_lang_translations": {
                                "ru": "Древние гимны были написаны как форма <w>прославления</w> и преданности."
                            }
                        }
                    ],
                    "synonyms": [
                        "laudation"
                    ],
                    "common_phrases": [
                        "praise of God",
                        "songs of praise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт поклонения, прославления или выражения обожания божеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвала",
                                "target_lang_sense_clarification": "прославление или славословие"
                            },
                            {
                                "target_lang_word": "прославление",
                                "target_lang_sense_clarification": "возвеличивание в молитве или песне"
                            },
                            {
                                "target_lang_word": "восхваление",
                                "target_lang_sense_clarification": "выражение глубокого почтения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58ed98e7-a97d-36b5-8a9b-0afd6abce550",
                    "sense_definition": "To express warm approval or admiration of; to commend or worship.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be sure to <w>praise</w> the children for their excellent work at school this week.",
                            "target_lang_translations": {
                                "ru": "Обязательно <w>похвалите</w> детей за их отличную учебу в школе на этой неделе."
                            }
                        },
                        {
                            "text": "Many people <w>praised</w> the hero for his brave actions during the emergency.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>восхваляли</w> героя за его смелые действия во время чрезвычайной ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "salute",
                        "compliment"
                    ],
                    "antonyms": [
                        "blame",
                        "criticism"
                    ],
                    "common_phrases": [
                        "praise someone for",
                        "highly praised"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать теплое одобрение или восхищение; хвалить или поклоняться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалить",
                                "target_lang_sense_clarification": "высказывать одобрение"
                            },
                            {
                                "target_lang_word": "похвалить",
                                "target_lang_sense_clarification": "высказать одобрение (завершенное действие)"
                            },
                            {
                                "target_lang_word": "восхвалять",
                                "target_lang_sense_clarification": "высоко оценивать или прославлять"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "давать очень высокую оценку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
