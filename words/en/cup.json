                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура издательства Кембриджского университета (Cambridge University Press)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "CUP",
