                "senses": [
                    {
                        "sense_id": "a2e4f53f-a527-39e8-a4a8-ad0d70f709ae",
                        "entry_id": "6abc0637-da62-3411-986b-85cd833a5a08",
                        "glosses": [
                            "krótki wiersz o groteskowej treści i skodyfikowanej budowie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d999880d-7c57-4c36-8528-3961cb34fc2c",
                                "sense_id": "a2e4f53f-a527-39e8-a4a8-ad0d70f709ae",
                                "text": "Ułożyć kalambur to drobiazg, ale pobawić się w anagramy, a także zbudować poprawnie limeryk - to już sztuka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b010940d-b9f1-4516-818d-bc8fddb89571",
                        "source_entry_id": "6abc0637-da62-3411-986b-85cd833a5a08",
                        "source_sense_id": "a2e4f53f-a527-39e8-a4a8-ad0d70f709ae",
                        "target_lang_word": "limerick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limerick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                        "entry_id": "9c43ee59-db35-3a1b-818a-c72a38723e17",
                                        "glosses": [
                                            "A humorous, often bawdy verse of five anapaestic lines, with the rhyme scheme aabba, and typically having an 8–8–5–5–8 cadence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8a02e9-5abb-42bb-8c0a-c688eb9e6aca",
                                                "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                                "text": "The limerick, it would appear,\nIs a verse form we owe Edward Lear;\nTwo long and two short\nLines rhymed, as was taught,\nAnd a fifth just to bring up the rear."
                                            },
                                            {
                                                "example_id": "52b698f9-4da9-4695-9d7a-2c32ffba3a7b",
                                                "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                                "text": "Take a look. That’s Buffy, Muffy, and Fluffy.\nDo they have anything in common other than names you could write a limerick around?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "102e5314-1792-4628-a1c4-cff93ed51997",
                        "source_entry_id": "6abc0637-da62-3411-986b-85cd833a5a08",
                        "source_sense_id": "a2e4f53f-a527-39e8-a4a8-ad0d70f709ae",
                        "target_lang_word": "ли́мерик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ли́мерик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0861515b-b727-34dd-8840-182ddf62a7ee",
                                        "entry_id": "1fd3c2aa-2b9d-3275-b407-b1e16553a234",
                                        "glosses": [
                                            "филол. форма короткого юмористического стихотворения, появившегося в Великобритании, основанного на обыгрывании бессмыслицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e7e5dd2-3a55-436f-94e0-742e1364f404",
                                                "sense_id": "0861515b-b727-34dd-8840-182ddf62a7ee",
                                                "text": "Есть люди, которые очень любят «городить чепуху». Да ещё в стихах! Такие стихи даже называются по-особенному — лимерики. В них всего пять строчек. Причём к первой строчке можно задать вопросы «кто?» и «откуда?»; ко второй строчке обычно подходит вопрос «какой? какая?»; к двум следующим — «что произошло?»; и, наконец, к последней строчке — «чем закончилось?»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
