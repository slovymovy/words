    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                "word": "gaijin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "508ac564-6304-4c05-b75f-eae68006fbe9",
                        "entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                        "tags": [
                            "plural"
                        ],
                        "form": "gaijin"
                    },
                    {
                        "form_id": "585482e1-4dc0-42b7-8e46-dfe831132e87",
                        "entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                        "tags": [
                            "plural"
                        ],
                        "form": "gaijins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                        "entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                        "glosses": [
                            "A non-Japanese person."
                        ],
                        "tags": [
                            "from the perspective of a Japanese person"
                        ],
                        "examples": [
                            {
                                "example_id": "b61b121e-34ad-4182-ad34-33a071e3c1fa",
                                "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                                "text": "The sarariman had been Japanese, but the Ninsei crowd was a gaijin crowd."
                            },
                            {
                                "example_id": "df277993-f69d-4248-836a-be1a64e35e9a",
                                "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                                "text": "For a while he began to speak Japanese, rather slangy, never having seemed to learn it — karoshi for death from overwork, yakitaori-ya for eatery, and gaijin for clumsy foreigner."
                            },
                            {
                                "example_id": "734c8540-6d85-4722-a732-db28eb526f09",
                                "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                                "text": "And I did not intend to live my life as a gaijin—not merely, like the expatriate, someone by definition permanently out of place but someone unwanted as well."
                            },
                            {
                                "example_id": "f7885e48-0a09-423d-8b30-22cd6c06f75f",
                                "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                                "text": "[...] I was placed in the gaijins' dormitory area up on the third floor."
                            },
                            {
                                "example_id": "04ef8c6c-6500-4925-b951-7bbb0a00c492",
                                "sense_id": "89c3e193-44d2-37ff-bd2d-30e343fdbf67",
                                "text": "Oh's pitchers later acknowledged that they were instructed—under penalty of a fine—to throw no strikes to the gaijin."
                            }
                        ]
                    },
                    {
                        "sense_id": "faba5a4b-7e5a-3660-a43c-f97d6dd2d166",
                        "entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                        "glosses": [
                            "A white person."
                        ],
                        "tags": [
                            "Hawaii"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "981a7db1-556c-45d5-8e3a-373c44ed6491",
                        "source_entry_id": "2de6c4ff-5b5d-313b-92ea-b22bb7b4cca8",
                        "source_sense_description": "(Japan) a non-Japanese person",
                        "target_lang_word": "外人",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "外人",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "a9f80d02-b80f-36b9-b99b-bacaa30600cd",
                                        "entry_id": "58fb6928-d895-3de0-92d7-7d22ef8545f3",
                                        "glosses": [
                                            "外国人。特に、日本に住んでいる外国人。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1ca7c1-d47e-461c-9bbe-7de7e08cb501",
                                                "sense_id": "a9f80d02-b80f-36b9-b99b-bacaa30600cd",
                                                "text": "「どこかに、スケートのくつが、ないもんかな。」と、思いだしたように、いいました。「なに、きみは、スケートができるのかい。」と、おじさんが、聞きました。「おけいこをしたいんだよ。」「そんなら、Ｓ町の夜店へいってごらん。あのへんには、外人の家族が、たくさんきているから、出ないともかぎらない。」(小川未明 『緑色の時計』）"
                                            },
                                            {
                                                "example_id": "7df4c66b-2cb8-4610-8a11-8a7c272bde2f",
                                                "sense_id": "a9f80d02-b80f-36b9-b99b-bacaa30600cd",
                                                "text": "軽井沢は松の木を誇る日本趣味の名所ではない。外人によって開拓された国際的避暑地として、今日の時世にも、まだ外人が我物顔に振舞っているのが目ざわりになることもあるが、それよりも、この地にうろうろしている青年男女の風俗や挙動が、外人のイミテーションとしか思えないのが、私には擽ったく思われることが多い。"
                                            },
                                            {
                                                "example_id": "fea76699-faaa-4f23-b1d5-042e66d5fbba",
                                                "sense_id": "a9f80d02-b80f-36b9-b99b-bacaa30600cd",
                                                "text": "彼は料（はか）らぬ深き歎きに遭ひて、前後を顧みる遑なく、こゝに立ちて泣くにや。我が臆病なる心は憐憫の情に打ち勝たれて、余は覺えず側に倚り、「何故に泣き玉ふか。ところに繋累なき外人（よそひと）は、却りて力を借し易きこともあらん。」といひ掛けたるが、我ながらわが大膽なるに呆れたり。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "713dace1-780b-3320-a9a4-e06857968f61",
                                        "entry_id": "58fb6928-d895-3de0-92d7-7d22ef8545f3",
                                        "glosses": [
                                            "当人ではない他の人。"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a674a4a7-ee73-4bcb-9e40-2562f6bd10ca",
                                                "sense_id": "713dace1-780b-3320-a9a4-e06857968f61",
                                                "text": "外人之評有といへども先師の一言まじる物は此に記す(向井去来『去来抄』)",
                                                "translation": "（芭蕉ではない）他の人の評釈であっても、先師（芭蕉）の一言が混ざっているものはこれ（去来抄）に記載する。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f03c671-1968-33ce-8f7f-fc5e3bccdd2b",
                                        "entry_id": "58fb6928-d895-3de0-92d7-7d22ef8545f3",
                                        "glosses": [
                                            "部外者。疎遠な人。"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
