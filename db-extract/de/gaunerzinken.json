                        "examples": [
                            {
                                "example_id": "fcab3413-511d-4470-ab97-8891b1ef1c4b",
                                "sense_id": "8aa24332-8c93-3b98-8e60-0a055ca9dd95",
                                "text": "„Schon im 16. Jahrhundert erschien ein Buch, in dem mehrere hundert sogenannte Gaunerzinken und ihre Bedeutung verzeichnet waren: Bildsymbole, die in jener Zeit allgemein benutzt wurden, um geheime Nachrichten auszutauschen.“"
                            },
                            {
                                "example_id": "e3db4f7e-2d29-4775-a6b9-f2c6cce5bb77",
                                "sense_id": "8aa24332-8c93-3b98-8e60-0a055ca9dd95",
                                "text": "„Wir gingen zu dem Zigarettenautomaten und untersuchten den auf Gaunerzinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
