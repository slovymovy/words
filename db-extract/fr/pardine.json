                            {
                                "example_id": "27115f40-1b75-492e-a0a2-c5d97002e022",
                                "sense_id": "0186ba02-ee31-3f58-be92-9f3a77cce8fd",
                                "text": "Enfin, au bout de cinq minutes, il demanda :\n« Pardine! Bien sûr qu’il est en grand danger de périr, le royaume de France."
                            },
                            {
                                "example_id": "643d9f12-a39f-4b35-b0cb-afebcaeba729",
                                "sense_id": "0186ba02-ee31-3f58-be92-9f3a77cce8fd",
                                "text": "« — Hé bien ! ça te va-t-il ? »\nElle répondit avec une physionomie triste :\n« — Quoi, not’ maître ? »\nAlors lui, brusquement :\n« — Mais de m’épouser, pardine ! »"
                            },
                            {
                                "example_id": "6fd97c4b-96c6-4d50-90a0-09900f9f8b17",
                                "sense_id": "0186ba02-ee31-3f58-be92-9f3a77cce8fd",
                                "text": "— C’est la mère ?\n— Pardine !"
                            },
                            {
                                "example_id": "a898c6ea-c48f-418d-8612-d4dd217da301",
                                "sense_id": "0186ba02-ee31-3f58-be92-9f3a77cce8fd",
                                "text": "Vie de famille… choyé… Pardine ! Pain blanc le premier… P’tit gars…Eh ben ? eh ben ?…"
                            }
                        ]
                    }
