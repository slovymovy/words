                ],
                "senses": [
                    {
                        "sense_id": "84fc17c1-9024-3e8b-b3b7-22a0b9367eec",
                        "entry_id": "83b8d234-67bc-3de8-b828-83913a714cff",
                        "glosses": [
                            "in Bezug auf die Stimmung, den Gefühlszustand, das Gemüt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba30cce1-caa8-434d-9b47-ccd5e8618821",
                                "sense_id": "84fc17c1-9024-3e8b-b3b7-22a0b9367eec",
                                "text": "„Es war, als würde sie jeder neue Meter hinein in diesen Wald sie stimmungsmäßig weiter nach unten ziehen.“"
                            },
                            {
                                "example_id": "9ba9ab31-d34a-4629-b824-76e87df456eb",
                                "sense_id": "84fc17c1-9024-3e8b-b3b7-22a0b9367eec",
                                "text": "„Du wirst sicher feststellen, dass jeder Tag stimmungsmäßig anders ist, und du wirst dich fragen: Bin das wirklich ich?“"
                            },
                            {
                                "example_id": "34a27e08-93bc-407d-b6b7-22966cb5a307",
                                "sense_id": "84fc17c1-9024-3e8b-b3b7-22a0b9367eec",
                                "text": "„Die deklamatorisch gesungenen Passagen werden stimmungsmäßig vom Orchester ausgeleuchtet, wobei der Wechsel kurzer Motive Unruhe und Anspannung erzeugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
