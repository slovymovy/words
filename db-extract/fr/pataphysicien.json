                        "target_lang_word": "pataphysical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pataphysical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebcedb5-ce8a-3c64-8ffe-347ed7ef9d1f",
                                        "entry_id": "bc957460-2fe0-3dfe-b381-6fa6beeae11e",
                                        "glosses": [
                                            "Relating to pataphysics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a202b6f-14b7-4970-b508-226ff9cf899b",
                                                "sense_id": "5ebcedb5-ce8a-3c64-8ffe-347ed7ef9d1f",
                                                "text": "Joan was quizzical, studied pataphysical Science in the home"
                                            },
                                            {
                                                "example_id": "50b8db47-0997-471a-bb12-0015274f8e72",
                                                "sense_id": "5ebcedb5-ce8a-3c64-8ffe-347ed7ef9d1f",
                                                "text": "[Fargue] couples a bent for discovery with a flair for creating a style suited to these astonishing circumnavigations, with their uncertain, hilarious or deceptive endings, to these ambiguous \"dead ends cluttered with butterflies\" where we observe the pataphysical creation of imaginary memories."
                                            },
                                            {
                                                "example_id": "8bf3d3bf-6f96-4219-8380-dc242c63d797",
                                                "sense_id": "5ebcedb5-ce8a-3c64-8ffe-347ed7ef9d1f",
                                                "text": "I have argued that stories and narrative consciousness are specific, particular, effectively 'pataphysical' in their form and application."
                                            },
                                            {
                                                "example_id": "cadc4eef-7b41-41a8-ba48-b77631482706",
                                                "sense_id": "5ebcedb5-ce8a-3c64-8ffe-347ed7ef9d1f",
                                                "text": "This contrast between an earyl bpNichol who often used the liber the liberationist rhetoric of neo-Freudian psychotherapy to forumlate his poetics and Nichol who was part of The Four Horsemen and the creator of numerous pataphysical and conceptual texts contributes to a current tension within Nichol scholarship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
