                    {
                        "translation_id": "f24e227d-9eb3-4275-994d-845d860ef251",
                        "source_entry_id": "9e557393-45bd-3668-9b2c-d1aa5b474be2",
                        "source_sense_id": "3af25ec1-9f12-39a1-81d2-c8fc721df8ed",
                        "source_sense_description": "vrouwelijk paard",
                        "target_lang_word": "klisna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klisna",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "61acbf25-54e6-3488-bd84-bb63b9ff75bc",
                                        "entry_id": "0eb8e927-4a42-3ff2-a372-29ab16df1bbd",
                                        "glosses": [
                                            "samice koně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f0772b-6560-41c1-86af-ff2b5c818020",
                                                "sense_id": "61acbf25-54e6-3488-bd84-bb63b9ff75bc",
                                                "text": "„Prrr — malá —“ ozval se výkřik a Cimbura už držel klisnu za ohlav—jednou rukou za ohlav a druhou za hřívu — kůň se na bok převrátil — Cimbura se rozkročil, trhl rukama a postavil kobylu na přední už odřené nohy."
                                            },
                                            {
                                                "example_id": "942319b8-845c-47e2-a37e-6ba3480aaea1",
                                                "sense_id": "61acbf25-54e6-3488-bd84-bb63b9ff75bc",
                                                "text": "Z těch první byla klisna vyzáblá, zmořená tahem, stářím ochablá... I byl to pohled zvláštních půvabů, když siré děcko, vlezši do žlabu, objalo ručkou klisny hlavu sivou a pohrávalo s chudou její hřívou."
                                            },
                                            {
                                                "example_id": "5860aade-51ac-4e5e-9360-e86196a970db",
                                                "sense_id": "61acbf25-54e6-3488-bd84-bb63b9ff75bc",
                                                "text": "A zatím co takto manžela poučovala a napomínala, Gianello, jenž dnes ráno nebyl úplně ukojil svoji žádost pro příchod manželův, vida, že nemůže jak chce, snažil se učinit, jak mohl, a přistoupiv k ní, jež úplně zastírala otvor sudu, jako na širých pastviskách ohniví láskou rozpálení hřebci dorážejí na klisny v zemi Parthů, ukojil svůj mladistvý chtíč."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
