                                "sense_id": "b1f3da5e-49f4-3ed1-b811-c352f7cce721",
                                "text": "Widziałaś nowego gibona Gabryśki? Zaparkowała przed instytutem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
