                    {
                        "translation_id": "befb7cb1-4e3d-4324-a824-7a5337704275",
                        "source_entry_id": "cbc3ee70-204c-3ae2-88df-6d8fadba429c",
                        "source_sense_id": "a535bea3-c4f1-3ef6-b2d9-45824b507fd1",
                        "target_lang_word": "обрезок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обрезок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                        "entry_id": "bf123bc7-e091-338d-8906-47df5a715e11",
                                        "glosses": [
                                            "остаток от резки чего-либо, отрезанный кусок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128f719e-ba1c-4908-88c7-e9efe4c8c8a3",
                                                "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                                "text": "3ахрустели выметаемые стёкла, и женский голос кокетливо заметил: — Кра-ковской! Господи, да ему надо было купить на двугривенный в мясной обрезков. Краковскую колбасу я сама лучше съем."
                                            },
                                            {
                                                "example_id": "e9f1caf7-c392-4fce-9650-d9451188ff25",
                                                "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                                "text": "И было Петьке обидно и грустно — есть хотелось, и не было денег даже колбасных обрезков купить."
                                            },
                                            {
                                                "example_id": "748242cb-df59-4e44-8825-15e584e704bf",
                                                "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                                "text": "С 1737 г. рождественское дерево стали украшать обрезками бумаги и разнообразной мишурой, а в 1775 г. на лесную красавицу даже подвесили посеребренные и позолоченные картофелины!"
                                            },
                                            {
                                                "example_id": "4f76e3c1-b0d3-459f-824d-8c818709f1a7",
                                                "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                                "text": "— Или вот шаль — европейская деталь одежды, но я её шью традиционным лоскутным способом — квадратами, а все выпады (лоскутки, обрезки, остатки кроя) собираю по цвету."
                                            },
                                            {
                                                "example_id": "b9b06012-1e99-4aff-92e9-22791a0c571e",
                                                "sense_id": "6c938850-4fcc-37bf-81e6-1dd64f2cdeab",
                                                "text": "Стас Вовк: Когда-то в те годы только школу заканчивал, и всё не по-взрослому было — только цепь в кармане и обрезок арматуры в рукаве."
                                            }
                                        ]
                                    }
                                ]
