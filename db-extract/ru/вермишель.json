                "translations": [
                    {
                        "translation_id": "9df86b74-e5e9-4047-b67c-2b6a20ac947a",
                        "source_entry_id": "cbccc263-63c5-38b9-8385-27af3069b483",
                        "source_sense_description": "продукт",
                        "target_lang_word": "vermicelli",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermicelli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Long, slender pasta, similar to spaghetti, only thinner."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e50abb-878e-4a84-96d9-0b08e34a4e4b",
                                                "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                                "text": "They talked of the experiments of Dr. Darwin, (I speak not of what the Doctor really did, or said that he did, but, as more to my purpose, of what was then spoken of as having been done by him,) who preserved a piece of vermicelli in a glass case, till by some extraordinary means it began to move with voluntary motion."
                                            },
                                            {
                                                "example_id": "f9148a62-8a31-4e44-9507-614e1694f65a",
                                                "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                                "text": "A favourite old cookbook (and a pile of parsley to use up) inspire this simple salsa verde – parsley, anchovies, capers, olives – in a fairytale tangle of vermicelli[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5f3ff4-130c-3069-9285-fdb223d3e33b",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Any type of long, thin noodles, as in rice vermicelli."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e82afe-8f6e-493a-9a3a-183853a793ab",
                                                "sense_id": "fb5f3ff4-130c-3069-9285-fdb223d3e33b",
                                                "text": "Super-thin rice noodles, or vermicelli, are de rigueur here, but as with pad thai the secret is all in the preparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a10fbb-4ecf-3572-be11-367cc8b82454",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Chocolate sprinkles."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
