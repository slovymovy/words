                                "target_senses": [
                                    {
                                        "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                        "entry_id": "95ebb0df-93d4-34df-b012-bb9cccc1d303",
                                        "glosses": [
                                            "ein Sexspielzeug, das mittels Motor in mechanische Schwingungen versetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9ced85-4532-4d9f-97e7-6f90998e11b0",
                                                "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                                "text": "Der Vibrator ist angeblich von Kleopatra erfunden worden."
                                            },
                                            {
                                                "example_id": "bf9b03f2-f148-4564-8c43-ebae53e6fb53",
                                                "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                                "text": "Ausgerechnet im viktorianisch-prüden England entwickelte Mortimer Granville den weltweit ersten elektrischen Vibrator."
                                            },
                                            {
                                                "example_id": "27ca1aaf-8409-4b85-9aa6-b30940f47fe9",
                                                "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                                "text": "„Das abgebildete Exemplar übrigens sorgte für Verwirrung, meist wurde es als Vibrator überhaupt nicht erkannt!“"
                                            },
                                            {
                                                "example_id": "f5d958ab-619f-48f8-bd4f-59421efdaed0",
                                                "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                                "text": "„Nachdem Dora mich mehrmals aufgefordert hatte, mit ihr zu schlafen, und irgendwann begriffen hatte, dass ich zu nichts nutze war, öffnete sie die Schublade ihres Nachtkästchens, holte zwei Vibratoren heraus, schob den mächtigeren in ihre Scheide und legte den anderen auf ihre Klitoris.“"
                                            },
                                            {
                                                "example_id": "f59b77b4-2ed6-447f-bad8-68ba64f199d1",
                                                "sense_id": "0abfc15e-54fb-33e2-ad89-739380ac153c",
                                                "text": "„Bei Sarah Young hole ich mir einen Vibrator, der im Dunkeln leuchtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45a4956e-a6eb-33f4-b3d4-67d35bedc965",
