                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The report was published by <w>AID</w> to highlight global health issues.",
                            "target_lang_translations": {
                                "ru": "Отчет был опубликован <w>АМР</w>, чтобы осветить глобальные проблемы здравоохранения.",
                                "zh": "这份报告由<w>国际开发署</w>发布，旨在凸显全球卫生问题。"
                            }
                        },
                        {
                            "text": "Funding from <w>AID</w> helped build schools in the rural region.",
                            "target_lang_translations": {
                                "ru": "Финансирование от <w>АМР</w> помогло построить школы в сельском регионе.",
                                "zh": "来自<w>国际开发署</w>的资金帮助该农村地区建起了学校。"
