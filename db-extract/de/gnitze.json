                "senses": [
                    {
                        "sense_id": "53b4c356-2f48-3096-8d66-c50fc4fca1fe",
                        "entry_id": "3ad5259e-1c43-3926-aafe-2b2c4a8ebbd5",
                        "glosses": [
                            "Mücke aus der Familie der Gnitzen"
                        ],
                        "tags": [
                            "Zoologie, Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e1482cd7-50a3-44bc-8f11-36f8de443f0a",
                                "sense_id": "53b4c356-2f48-3096-8d66-c50fc4fca1fe",
                                "text": "Das Zelt war voller Gnitzen."
                            },
                            {
                                "example_id": "1b094bad-ad65-4044-b048-73cded3da32c",
                                "sense_id": "53b4c356-2f48-3096-8d66-c50fc4fca1fe",
                                "text": "„Gnitzen sind so winzig, dass man sie praktisch nicht sieht, aber wenn sie einen stechen, merkt man es.“"
                            },
                            {
                                "example_id": "d9200944-cb27-4f30-9543-ea1f33da1eea",
                                "sense_id": "53b4c356-2f48-3096-8d66-c50fc4fca1fe",
                                "text": "„Das Blauzungenvirus wird von Gnitzen, blutsaugenden Mücken, übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f917746-e253-31e9-9207-6af55764f674",
