                "senses": [
                    {
                        "sense_id": "e062b14f-4289-3d87-9846-b414d2795e2f",
                        "entry_id": "d0b8d7ae-4951-3ee1-b2ac-4421f7837b22",
                        "glosses": [
                            "État situé en Afrique centrale-sud-tropicale, entre le Mozambique, la Zambie et la Tanzanie. Sa capitale est Lilongwe."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "6651e529-1ee3-48f8-b9f4-c7f2314e1b25",
                                "sense_id": "e062b14f-4289-3d87-9846-b414d2795e2f",
                                "text": "Après avoir envisagé pendant quelques temps de m’enfuir dans ce qui s’appelait encore le Nyasaland, aujourd’hui le Malawi, ou en Chine, et de consacrer ma vie à évangéliser les païens, je décidai d’éviter le désagrément d’allonger la liste des martyrs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c743326e-5e34-431f-9617-6a4d37deeceb",
                        "source_entry_id": "d0b8d7ae-4951-3ee1-b2ac-4421f7837b22",
                        "source_sense_id": "e062b14f-4289-3d87-9846-b414d2795e2f",
                        "source_sense_description": "Pays d’Afrique",
                        "target_lang_word": "Malawi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Malawi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                        "entry_id": "c56371f4-c748-30d2-93d4-9f0f7116fe21",
                                        "glosses": [
                                            "ein Staat im Südosten Afrikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef60967f-9347-4cf8-87d6-d39e7d9477e6",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Lilongwe ist die Hauptstadt von Malawi."
                                            },
                                            {
                                                "example_id": "fa0b4575-4640-4043-b2e2-39decdef3195",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Rund 13 Millionen Menschen leben in Malawi."
                                            },
                                            {
                                                "example_id": "06fe73b8-87a9-4fb0-95d8-8cc066055106",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "Die Kapichira-Wasserfälle im afrikanischen Malawi sind vor allem in der Regenzeit spektakulär."
                                            },
                                            {
                                                "example_id": "e0e45ce8-cfe6-4f07-9cf7-16ca081850b0",
                                                "sense_id": "e69c69e9-0f2c-30b6-a0ae-eb12efb8f668",
                                                "text": "„Ich wurde Lehrer an einer kleinen Schule in Malawi und danach Dozent an der Universität Makere in Uganda.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
