                            {
                                "example_id": "f0da9c8b-fc91-4d76-a682-b30607da2d54",
                                "sense_id": "d37da032-86a7-3c8d-b8da-cb6afd91be91",
                                "text": "„Sogar Miss Runcible fühlte die Gespanntheit der Atmosphäre und griff zur Ablenkung nach der Morgenzeitung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "86fc3590-a958-343f-8934-e9e3ed00acc0",
                        "entry_id": "b01da31f-5704-3f08-8100-b41f548b2563",
                        "glosses": [
                            "Eigenschaft von Vokalen, die darin besteht, dass der betreffende Vokal im Vergleich mit anderen, ungespannten mit einer erhöhten Muskelanspannung erzeugt wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
