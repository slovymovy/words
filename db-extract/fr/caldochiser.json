                "senses": [
                    {
                        "sense_id": "0bea6afa-9728-3666-97ed-05cf492d69fb",
                        "entry_id": "5791c6bf-5e50-3c54-b24b-396b518a91f5",
                        "glosses": [
                            "Donner un caractère caldoche à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8041e6-73e0-4064-8eba-36926f43ca63",
                                "sense_id": "0bea6afa-9728-3666-97ed-05cf492d69fb",
                                "text": "Personne n'a envie d'être caldochisé, c'est pas compliqué à comprendre."
                            },
                            {
                                "example_id": "0dba8fb5-f7c3-4874-bf00-276e30ac3925",
                                "sense_id": "0bea6afa-9728-3666-97ed-05cf492d69fb",
                                "text": "Donc, s'il veut nous rendre service, il n'a qu'a se pencher sur ces sept chantiers qui accablent notre peuple, et qui constate avec rage qu'il est en train de se CALDOCHISER !"
                            },
                            {
                                "example_id": "2959cd3e-3b33-48d7-be75-d351ae7b1dc8",
                                "sense_id": "0bea6afa-9728-3666-97ed-05cf492d69fb",
                                "text": "Ca va aller très vite parce que la MARTINIQUE est en train de se caldochiser."
                            }
                        ]
                    }
