                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old mansion was <w>sometimes</w> the residence of the local governor.",
                            "target_lang_translations": {
                                "ru": "Этот старый особняк <w>когда-то</w> был резиденцией местного губернатора.",
                                "nl": "Het oude herenhuis was <w>weleer</w> de residentie van de lokale gouverneur.",
                                "pl": "Ten stary dwór był <w>niegdyś</w> rezydencją lokalnego gubernatora.",
                                "de": "Das alte Herrenhaus war <w>einst</w> die Residenz des örtlichen Gouverneurs.",
                                "fr": "Le vieux manoir était <w>autrefois</w> la résidence du gouverneur local.",
                                "it": "La vecchia dimora era <w>un tempo</w> la residenza del governatore locale.",
                                "cs": "Staré sídlo bylo <w>kdysi</w> rezidencí místního guvernéra.",
                                "tr": "Eski konak <w>bir zamanlar</w> yerel valinin konutuydu.",
                                "es": "La antigua mansión fue <w>en un tiempo</w> la residencia del gobernador local."
                            }
                        },
                        {
                            "text": "He spoke of his <w>sometimes</w> master with great respect and loyalty.",
                            "target_lang_translations": {
                                "ru": "Он говорил о своём <w>бывшем</w> хозяине с большим уважением и преданностью.",
                                "nl": "Hij sprak met veel respect en loyaliteit over zijn <w>voormalige</w> meester.",
                                "pl": "Mówił o swoim <w>byłym</w> panu z wielkim szacunkiem i lojalnością.",
                                "de": "Er sprach mit großem Respekt und Loyalität von seinem <w>ehemaligen</w> Herrn.",
                                "fr": "Il parlait de son <w>ancien</w> maître avec beaucoup de respect et de loyauté.",
                                "it": "Parlava del suo <w>allora</w> padrone con grande rispetto e lealtà.",
                                "cs": "O svém <w>bývalém</w> pánovi mluvil s velkou úctou a věrností.",
                                "tr": "<w>Eski</w> efendisinden büyük bir saygı ve sadakatle bahsetti.",
                                "es": "Hablaba de su <w>antiguo</w> maestro con gran respeto y lealtad."
                            }
