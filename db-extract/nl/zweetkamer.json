                        "examples": [
                            {
                                "example_id": "f09251eb-4fc6-4e19-9d4b-e70218d64261",
                                "sense_id": "276b0bba-3a4d-3575-8c12-e6a6500b953d",
                                "text": "De zweetkamer is een soort warme kamer die over het algemeen wordt aanbevolen om te gebruiken na de sauna."
