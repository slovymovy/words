            "senses": [
                {
                    "sense_id": "d68d0a74-ecf6-36df-aff8-fc3ada5a115e",
                    "sense_definition": "Remarquer la réalité d'un fait, observer quelque chose avec certitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En arrivant ce matin, le directeur a pu <w>constater</w> les dégâts causés par la tempête."
                        },
                        {
                            "text": "Nous <w>constatons</w> chaque jour que les habitudes de travail changent rapidement."
                        }
                    ],
                    "synonyms": [
                        "noter",
                        "observer",
                        "remarquer"
                    ],
                    "antonyms": [
                        "ignorer",
                        "méconnaître"
                    ],
                    "common_phrases": [
                        "constater les dégâts",
                        "constater une hausse",
                        "constater un changement"
                    ]
                },
                {
                    "sense_id": "5604d674-d11b-340b-a067-7a7456594c0a",
                    "sense_definition": "Établir officiellement et consigner un fait dans un acte authentique ou un rapport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin urgentiste est venu à domicile pour <w>constater</w> le décès du patient."
                        },
                        {
                            "text": "Les agents de police ont dressé un rapport pour <w>constater</w> une infraction au code de la route."
                        }
                    ],
                    "synonyms": [
                        "acter",
                        "certifier",
                        "consigner"
                    ],
                    "common_phrases": [
