                                "sense_id": "1362386a-90a4-3c21-af2b-331c449194ea",
                                "text": "Jol powoli przybijał do brzegu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1353f91-416a-4439-8e9c-75e245edca57",
