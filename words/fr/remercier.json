                                "ru": "Я хотел бы <w>поблагодарить</w> вас за вашу ценную помощь.",
                                "nl": "Ik wil u graag <w>bedanken</w> voor uw waardevolle hulp.",
                                "de": "Ich möchte mich bei Ihnen für Ihre wertvolle Hilfe <w>bedanken</w>.",
                                "pl": "Pragnę Państwu <w>podziękować</w> za cenną pomoc.",
                                "it": "Vorrei <w>ringraziarla</w> per il suo prezioso aiuto.",
                                "cs": "Chci vám <w>poděkovat</w> za vaši cennou pomoc.",
                                "tr": "Değerli yardımınız için size <w>teşekkür etmek</w> istiyorum.",
                                "es": "Quisiera <w>agradecerle</w> por su valiosa ayuda.",
                                "zh": "我想<w>感谢</w>您提供的宝贵帮助。"
                            }
                        },
                        {
                            "text": "Il a chaleureusement <w>remercié</w> ses amis après la fête.",
                            "target_lang_translations": {
                                "en": "He warmly <w>thanked</w> his friends after the party.",
                                "ru": "После праздника он тепло <w>поблагодарил</w> друзей.",
                                "nl": "Na het feest heeft hij zijn vrienden hartelijk <w>bedankt</w>.",
                                "de": "Nach der Feier hat er sich bei seinen Freunden herzlich <w>bedankt</w>.",
                                "pl": "Po przyjęciu serdecznie <w>podziękował</w> przyjaciołom.",
                                "it": "Dopo la festa ha calorosamente <w>ringraziato</w> i suoi amici.",
                                "cs": "Po oslavě svým přátelům srdečně <w>poděkoval</w>.",
                                "tr": "Partiden sonra arkadaşlarına içtenlikle <w>teşekkür etti</w>.",
                                "es": "Después de la fiesta, <w>agradeció</w> calurosamente a sus amigos.",
                                "zh": "聚会后，他热情地<w>感谢</w>了朋友们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "remercier chaleureusement",
                        "remercier de tout cœur"
                    ],
                    "target_lang_definitions": {
                        "en": "To express gratitude or appreciation to someone for a favour, service or kindness.",
                        "ru": "Выражать благодарность или признательность кому-либо за помощь, услугу или любезность.",
                        "nl": "Erkentelijkheid tonen aan iemand voor een gunst, dienst of attentie.",
                        "de": "Jemandem für eine Hilfe, einen Dienst oder eine Aufmerksamkeit seinen Dank oder seine Anerkennung aussprechen.",
