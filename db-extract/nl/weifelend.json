                    {
                        "translation_id": "2a0d6ee5-1911-4d60-91e9-5e9c583b212e",
                        "source_entry_id": "39d81711-cad5-39bb-8154-842e8aad594e",
                        "source_sense_id": "4aabbc61-6ffc-3307-b88b-9e2a92b07875",
                        "source_sense_description": "van een persoon dat deze aarzelt of twijfelt",
                        "target_lang_word": "slow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7ce8c9-2bb3-3615-95b8-99f55f2f9850",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Taking a long time to move or go a short distance, or to perform an action; not quick in motion; proceeding at a low speed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce9d779-7a85-4f73-a98c-99687b2a7baa",
                                                "sense_id": "ea7ce8c9-2bb3-3615-95b8-99f55f2f9850",
                                                "text": "a slow train; a slow computer"
                                            },
                                            {
                                                "example_id": "53528b9b-90b1-4227-aba5-13a6ffecba46",
                                                "sense_id": "ea7ce8c9-2bb3-3615-95b8-99f55f2f9850",
                                                "text": "Holding out her small olive hand before her captain, she said in mild and slowest Spanish, \"Senor, I buried him;\" then paused, struggled as against the writhed coilings of a snake, and cringing suddenly, leaped up, repeating in impassioned pain, \"I buried him, my life, my soul!\""
                                            },
                                            {
                                                "example_id": "11ed89fe-16da-4727-9ea1-b979cfb2af30",
                                                "sense_id": "ea7ce8c9-2bb3-3615-95b8-99f55f2f9850",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72f86a1-50c3-344e-b53f-6c058cba45e4",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Not happening in a short time; spread over a comparatively long time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad284334-b419-43cb-b123-03aea1a5b675",
                                                "sense_id": "b72f86a1-50c3-344e-b53f-6c058cba45e4",
                                                "text": "Theſe changes in the Heav’ns, though ſlow, produc’d / Like change on Sea and Land, ſideral blaſt, / Vapour, and Miſt, and Exhalation hot, / Corrupt and Peſtilent: […]"
                                            },
                                            {
                                                "example_id": "575d2b62-902b-4f9b-a710-2944c055f9ce",
                                                "sense_id": "b72f86a1-50c3-344e-b53f-6c058cba45e4",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            },
                                            {
                                                "example_id": "bd11ae7c-0581-413e-986b-fdda13590d09",
                                                "sense_id": "b72f86a1-50c3-344e-b53f-6c058cba45e4",
                                                "text": "As of the current patch, Luke’s crouching Medium Punch has been nerfed. It will now have a larger hurtbox, in addition to having a slower recovery when the attack misses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6562ac45-df2e-3c58-9b36-197efcc82ca9",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Of reduced intellectual capacity; not quick to comprehend."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19943b4-293d-4f41-b9cb-4b1110546665",
                                                "sense_id": "6562ac45-df2e-3c58-9b36-197efcc82ca9",
                                                "text": "Experienced classroom teachers are well acquainted with the attention-seeker, the shy girl, the aggressive boy, the poor concentrator, the slow student […]"
                                            },
                                            {
                                                "example_id": "296cee83-aa1c-4a35-a62a-3fd179e3faac",
                                                "sense_id": "6562ac45-df2e-3c58-9b36-197efcc82ca9",
                                                "text": "Hey, don't yell at Homer, just because he's a little slow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a80706-a4c9-3ceb-ac68-57a116490c11",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Not hasty; not tending to hurry; acting with deliberation or caution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47293897-1722-4fc1-a3ce-849f6af22b6c",
                                                "sense_id": "51a80706-a4c9-3ceb-ac68-57a116490c11",
                                                "text": "He that is slow to wrath is of great understanding."
                                            },
                                            {
                                                "example_id": "9636e8a9-6e63-48d3-9ab7-a675fdcaf7c4",
                                                "sense_id": "51a80706-a4c9-3ceb-ac68-57a116490c11",
                                                "text": "And even after the emotional cast comes off, we need to be slow about getting deeply involved in a relationship again"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd197cf5-5ce9-32ad-9ba3-fcc0b27852ab",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Behind in time; indicating a time earlier than the true time."
                                        ],
                                        "tags": [
                                            "of a clock or the like"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7119aeec-9223-4a6c-82c3-5acd1b1d3a15",
                                                "sense_id": "cd197cf5-5ce9-32ad-9ba3-fcc0b27852ab",
                                                "text": "That clock is slow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518c7464-519f-3247-861b-967dc9b4d398",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Lacking spirit; deficient in liveliness or briskness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a7955d1-de48-3e46-94d5-82e7edadeebd",
                                        "entry_id": "277e7cfc-80fb-3dbf-ae00-9766f4c4449f",
                                        "glosses": [
                                            "Not busy; lacking activity."
                                        ],
                                        "tags": [
                                            "of a period of time"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3051a28-8821-4612-a0d5-3603fcf1685c",
                                                "sense_id": "7a7955d1-de48-3e46-94d5-82e7edadeebd",
                                                "text": "It was a slow news day, so the editor asked us to make our articles wordier."
                                            },
                                            {
                                                "example_id": "8bfc1e3a-3a26-49ca-a5e7-bf687ec5552e",
                                                "sense_id": "7a7955d1-de48-3e46-94d5-82e7edadeebd",
                                                "text": "I'm just sitting here with a desk of cards, enjoying a slow afternoon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slow",
                                "target_lang_code": "en",
                                "target_senses": [
