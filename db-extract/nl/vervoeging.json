                    {
                        "translation_id": "6b18d6cd-6ccc-48f0-ab20-6a75d4f44239",
                        "source_entry_id": "360c094e-ad7f-3a02-8e29-418739494945",
                        "source_sense_id": "597d99a0-25e7-323b-85ca-5a6d3f37ed6a",
