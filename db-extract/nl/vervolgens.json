        "nl-extract.jsonl": [
            {
                "entry_id": "c2a69298-7288-374f-9910-456199482324",
                "word": "vervolgens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8cc6e22b-c8c4-3acf-a1ea-1a5bfc3e5294",
                        "entry_id": "c2a69298-7288-374f-9910-456199482324",
                        "glosses": [
                            "in de tijd na een eerdere gebeurtenis of handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b271ceb-9218-4ff2-abc8-d26aaea8cbb3",
                                "sense_id": "8cc6e22b-c8c4-3acf-a1ea-1a5bfc3e5294",
                                "text": "Hij klom onder luid applaus op de spreekstoel en vervolgens sprak hij een bewonderenswaardige rede uit."
                            },
                            {
                                "example_id": "e1f4fe8b-7506-42a3-9d18-e781d2230be0",
                                "sense_id": "8cc6e22b-c8c4-3acf-a1ea-1a5bfc3e5294",
                                "text": "Het lijkt misschien het makkelijkst om op aarde een kant-en-klare maanmodule te bouwen en die vervolgens naar de maan te sturen. Toch pleit Vermeulen om juist gebruik te maken van de grondstoffen van de maan zelf, om zo onafhankelijk te zijn van de aarde. Een efficiënte manier is om bijvoorbeeld gebruik te maken van de bewoonbare lavatunnels waar een vestiging in gebouwd kan worden. Op die manier biedt het oppervlak van de maan zelf voldoende bescherming"
                            },
                            {
                                "example_id": "45a30e1d-67dd-4084-806e-56efd80b605d",
                                "sense_id": "8cc6e22b-c8c4-3acf-a1ea-1a5bfc3e5294",
                                "text": "Vervolgens boog hij zich naar mij toe en zei mij op een fluistertoon dat hij er zeker geen gewoonte van wilde maken om zich te bemoeien met zaken die hem niet aangingen, maar dat hij het niet kon helpen dat het hem was opgevallen dat mijn linker manchetknoop niet goed was gesloten en dat hij het zichzelf nooit zou vergeven als ik hem zou verliezen ten gevolge van zijn discretie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75beb3f8-b44f-4090-9b10-d02b94b1b1c3",
                        "source_entry_id": "c2a69298-7288-374f-9910-456199482324",
                        "source_sense_id": "8cc6e22b-c8c4-3acf-a1ea-1a5bfc3e5294",
                        "target_lang_word": "subsequently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsequently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                        "entry_id": "21cb8174-e395-3990-b181-22b37018172b",
                                        "glosses": [
                                            "Following, afterwards in either time or place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b35cf6b-7386-47b2-970d-f7a0e45d8d8c",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "It will be recollected that the ill-fated Halloway...distinctly stated the voice of the individual who had approached his post...to have been that of a female, and that the language in which they subsequently conversed was that of the Ottawa Indians."
                                            },
                                            {
                                                "example_id": "6c45b930-05ac-4489-ab60-626e50a43df0",
                                                "sense_id": "3503f998-e574-3926-aca1-515a575f8661",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5065abe8-213b-3ca0-9efe-698508679f10",
