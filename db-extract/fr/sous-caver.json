                        "sense_id": "fe92acdd-9a72-3f02-9b60-0f5afc6d72d8",
                        "entry_id": "f4ba55c5-cf2f-379e-8615-0d70b03e353a",
                        "glosses": [
                            "Faire une excavation horizontale en-dessous de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389e9396-3462-4648-a2a7-5970e11f5587",
                                "sense_id": "fe92acdd-9a72-3f02-9b60-0f5afc6d72d8",
                                "text": "Sous-caver c'est creuser à l'horizontale (généralement dans la \"bonne\" couche pour ne pas se casser le dos à bouger les matériaux sans intérêt qui sont au-dessus) c'est à dire en faisant une amorce de galerie ou une longue saignée tout au long de la couche convoitée."
                            },
                            {
                                "example_id": "725992e4-4392-4936-aa85-fe08fa3dea3b",
                                "sense_id": "fe92acdd-9a72-3f02-9b60-0f5afc6d72d8",
                                "text": "Ne jamais sous-caver un talus élevé."
                            },
                            {
                                "example_id": "24e7bf0e-274e-4db9-9385-c2c150a7b5c6",
                                "sense_id": "fe92acdd-9a72-3f02-9b60-0f5afc6d72d8",
                                "text": "L'évaluation des cavités susceptibles de sous-caver les Routes Départementales dans le département de la Vienne."
                            }
                        ]
                    }
