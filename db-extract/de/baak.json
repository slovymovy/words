                "senses": [
                    {
                        "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                        "entry_id": "992a0249-c2b5-31da-b367-6a996464fbbd",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a27bb46-eb69-493d-b2ea-a1b1b4e104fe",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Frau Baak ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "51327d82-0dc2-4814-9e0c-cb89d66ac023",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Herr Baak wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aed1333b-3aaf-4e4d-8a58-0c33866fbd76",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Die Baaks fahren heute in den Frankenwald."
                            },
                            {
                                "example_id": "c2cd9e71-c30e-4eca-84a9-15100379cc1b",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Der Baak trägt nie die Schals, die die Baak ihm strickt."
                            },
                            {
                                "example_id": "2eac8fca-5234-4549-a9e4-b6402e26891b",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baak kommt, geht der Herr Baak.“"
                            },
                            {
                                "example_id": "47199540-b50b-496b-bbd1-7c35ada638fd",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Baak kommt und geht."
                            },
                            {
                                "example_id": "4a31c0ce-499a-426e-a1f1-21deaf6083b6",
                                "sense_id": "4447c748-a06f-32e0-a322-007bc33746fd",
                                "text": "Baaks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
