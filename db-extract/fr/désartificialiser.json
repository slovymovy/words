                                "example_id": "1eef9a1b-eac0-46bf-997e-cb4e55118d54",
                                "sense_id": "00f8bdaa-fe5d-3080-8013-8d753e3d0128",
                                "text": "Désartificialiser, décloisonner et reméandrer les cours d'eau canalisés"
