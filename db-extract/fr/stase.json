        "fr-extract.jsonl": [
            {
                "entry_id": "2d887c6b-2cec-34a7-b148-e543f3d120ae",
                "word": "stase",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee42848b-6b4a-483e-8a00-22c3a0efc984",
                        "entry_id": "2d887c6b-2cec-34a7-b148-e543f3d120ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "stases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93577eb7-066f-3e0e-a4b7-3f69feb57e84",
                        "entry_id": "2d887c6b-2cec-34a7-b148-e543f3d120ae",
                        "glosses": [
                            "Stabilité, constance dans le temps, immobilité, passivité ; absence de changement, de mouvement, d’activité (voir aussi l’adjectif statique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b2c0e3-0dc9-41c1-8909-9fa57520463e",
                                "sense_id": "93577eb7-066f-3e0e-a4b7-3f69feb57e84",
                                "text": "Une condition de stase existe dans tout le Proche-Orient, engendrée par le choc récurent entre tradition et modernité, et par le défi lancé à celle-ci par l’éthique musulmane indigène."
                            },
                            {
                                "example_id": "deb834a3-7b04-4bd9-bd50-e8c724f781b1",
                                "sense_id": "93577eb7-066f-3e0e-a4b7-3f69feb57e84",
                                "text": "Des textes courts, des espèces de stases associant chaque fois un lieu à un moment très précis, un regard angulaire, une lumière, des odeurs et des sensations démêlées au plus infime, des postures du corps pour accueillir, capter."
                            },
                            {
                                "example_id": "cf548841-595c-4585-abc1-8e113dffaf16",
                                "sense_id": "93577eb7-066f-3e0e-a4b7-3f69feb57e84",
                                "text": "Que l’espoir – kibo – se fasse rare au sein d’une population rapidement vieillissante, et dans un pays dont l’économie souffre depuis des décennies d’une stase déflationniste, ne surprendra pas ."
                            },
                            {
                                "example_id": "a6954877-b702-46b9-8fe2-d151fbdb5b07",
                                "sense_id": "93577eb7-066f-3e0e-a4b7-3f69feb57e84",
                                "text": "Puis, à la fin de chaque cuillerée, il avait une petite stase de repos, de fatigue et d’assentiment et enfin, à chaque fois, ces trois mots : « C’est bon. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "3413ca9d-55f7-36e0-8e8a-2ffe4153070b",
                        "entry_id": "2d887c6b-2cec-34a7-b148-e543f3d120ae",
                        "glosses": [
                            "Stagnation du sang ou des humeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b586dd66-50f4-492b-a038-dbc3918d5307",
                                "sense_id": "3413ca9d-55f7-36e0-8e8a-2ffe4153070b",
                                "text": "Il se tourna vers Alvare, la jeune femme qui l'accompagnait, responsable scientifique de la mission, spécialiste en exobiologie et terraformation. Une belle femme brune d'ailleurs, qui, les derniers temps du voyage, n'était jamais sortie de sa réserve glaciale, comme si son cerveau et son corps n'étaient pas parvenus à se remettre de la stase cryogénique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21062122-374a-4d8a-a951-4f671356f0a2",
                        "source_entry_id": "2d887c6b-2cec-34a7-b148-e543f3d120ae",
                        "target_lang_word": "stasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeae9453-261f-34d3-8400-a4e5ae62d467",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A slackening or arrest of the blood current, due not to a lessening of the heart’s beat, but to some abnormal resistance of the capillary walls."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "Inactivity; a freezing, or state of motionlessness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deed2da5-323b-4a0e-bfef-3e6b71fecfa9",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "His company was sized for growth, not stasis."
                                            },
                                            {
                                                "example_id": "d2f83f2b-05aa-4168-a170-d0e2174209ca",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Boredom is an instrument of social control. Power is the power to impose boredom, to command stasis, to combine this stasis with anguish."
                                            },
                                            {
                                                "example_id": "04d0915e-d89b-4741-9ace-1f640cc41124",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Or will Americans remain hunkered forever—as confused and anxious and paralyzed as we were before 2020—descend into digital feudalism, and retreat back into our cocoons of nostalgia and cultural stasis, providing the illusion that nothing much is changing or ever can change?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A technology allowing something to be artificially frozen in time, so that it does not age or change."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739ffee4-e248-4e73-b316-216baaa34cf4",
                                                "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                                "text": "I was in stasis for forty years before I woke up orbiting this poxy planet!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88955c6-3104-3e15-ab32-21bcab8c7a4f",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "One of the sections of a cathisma or portion of the psalter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
