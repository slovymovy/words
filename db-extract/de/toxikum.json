                                "target_senses": [
                                    {
                                        "sense_id": "ad8e6639-5a90-3c69-88b5-b2459d465d4c",
                                        "entry_id": "24fca7a1-a2b1-3725-a04b-df7bc0f7bb56",
                                        "glosses": [
                                            "Having a chemical nature that is harmful to health or lethal if consumed or otherwise entering into the body in sufficient quantities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d689d1ad-0f84-4662-849a-49ed2de95b2d",
                                                "sense_id": "ad8e6639-5a90-3c69-88b5-b2459d465d4c",
                                                "text": "Tobacco smoke contains many toxic substances."
                                            },
                                            {
                                                "example_id": "c1e032c5-f6ae-4262-98f3-366544be3c8b",
                                                "sense_id": "ad8e6639-5a90-3c69-88b5-b2459d465d4c",
                                                "text": "If some types of electronic waste aren’t incinerated at a high enough temperature, dioxins, which can cause cancer and developmental problems, infiltrate the food supply. Without proper safeguarding, toxic heavy metals seep into the soil and groundwater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935e42cb-ad63-38ef-bdd8-6e4e4333a309",
                                        "entry_id": "24fca7a1-a2b1-3725-a04b-df7bc0f7bb56",
                                        "glosses": [
                                            "Appearing grossly unwell; characterised by serious, potentially life-threatening compromise in the respiratory, circulatory or other body systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ba3b8c-ed73-45d6-aa80-44c24e227362",
                                                "sense_id": "935e42cb-ad63-38ef-bdd8-6e4e4333a309",
                                                "text": "The child appeared toxic on arrival at the hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296b8447-e8d2-3c93-ae48-b752d43b0bfb",
                                        "entry_id": "24fca7a1-a2b1-3725-a04b-df7bc0f7bb56",
                                        "glosses": [
                                            "Severely negative or harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0147381-5e6c-4eed-8284-fa5a43fa408c",
                                                "sense_id": "296b8447-e8d2-3c93-ae48-b752d43b0bfb",
                                                "text": "a toxic environment that promoted bullying"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6edcf36-ffc5-3094-a93c-f45b8dec61b7",
                                        "entry_id": "24fca7a1-a2b1-3725-a04b-df7bc0f7bb56",
                                        "glosses": [
                                            "Hateful or strongly antipathetic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbe6222-041e-4970-9183-6320b90a1890",
                                                "sense_id": "e6edcf36-ffc5-3094-a93c-f45b8dec61b7",
                                                "text": "It is not good to be around toxic people."
                                            },
                                            {
                                                "example_id": "34818915-4eee-411f-80e2-aa78a91bc860",
                                                "sense_id": "e6edcf36-ffc5-3094-a93c-f45b8dec61b7",
                                                "text": "Though Twitter is still overrun with toxic anger and fear-based nonsense (now more than ever), it is also, in one crucial way, beginning to play an important role in our response to the pandemic."
                                            },
                                            {
                                                "example_id": "45e60480-4afa-47e2-ae3d-2fa7a34d57fd",
                                                "sense_id": "e6edcf36-ffc5-3094-a93c-f45b8dec61b7",
                                                "text": "A veteran UN diplomat, Kaag, 62, said the environment for politicians in the Netherlands had become “toxic” as she and colleagues faced a continual barrage of “hate, intimidation and threats” and often needed tight police security."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e7ba203-26ee-44f1-ba0d-ebdfa18228cd",
                        "source_entry_id": "19bafe18-44a0-3614-b549-70250227632c",
                        "source_sense_id": "cf596420-229c-3eb6-bd64-55a93197f760",
                        "source_sense_description": "Medizin: giftige Substanz",
                        "target_lang_word": "toxique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toxique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f40edb6c-8247-3e00-841c-7347087b02ab",
                                        "entry_id": "a05f36a8-a0e0-35fc-b587-9a84df89a019",
                                        "glosses": [
                                            "Qui provoque des effets nocifs sur un organisme vivant, en perturbant ses fonctions biologiques ou en causant des lésions."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950f4eaf-e646-4aa5-91e5-cacbe5fa4b31",
                                                "sense_id": "f40edb6c-8247-3e00-841c-7347087b02ab",
                                                "text": "La phalloïde ne pardonne pas, la panthère non plus. Pour la fausse oronge, elle est toxique ; elle tue les mouches, dit-on ; pourtant dans les pays du nord, les gens en usent pour donner de beaux rêves."
                                            },
                                            {
                                                "example_id": "ea5ab158-a077-46cc-828e-01300b096641",
                                                "sense_id": "f40edb6c-8247-3e00-841c-7347087b02ab",
                                                "text": "Une étude portant sur plusieurs générations de rats a montré que le phosphamidon, administré à des doses toxiques pour la mère, influait sur la taille de la portée et sur la viabilité des jeunes rats."
                                            },
                                            {
                                                "example_id": "e069c5c9-2257-4d76-9af1-85b33074e253",
                                                "sense_id": "f40edb6c-8247-3e00-841c-7347087b02ab",
                                                "text": "Comment expliquer les effets toxiques constatés sur le rhizome après les applications foliaires d’amitrole ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bf0e90-d49a-36f9-a7bc-1c61775fe00b",
                                        "entry_id": "a05f36a8-a0e0-35fc-b587-9a84df89a019",
                                        "glosses": [
                                            "Qui nuit au bien-être psychologique ou émotionnel, en parlant d’une personne, d’un comportement, d’un environnement ou d’une relation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c506189-d70f-4929-b689-9571913112c1",
                                                "sense_id": "23bf0e90-d49a-36f9-a7bc-1c61775fe00b",
                                                "text": "Nous nous efforçons parfois de rester dans des situations toxiques pour nous parce que nous avons l’impression qu’en les quittant, nous serions dans la fuite."
                                            },
                                            {
                                                "example_id": "e947060d-6146-4f36-b56b-2c7fe7a37384",
                                                "sense_id": "23bf0e90-d49a-36f9-a7bc-1c61775fe00b",
                                                "text": "Pour celles et ceux qui ne sont pas familiers des memes sur le travail : les « Fabieng » sont les patrons ou managers toxiques, les « Corenting » les stagiaires exploités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81491ba9-8909-3ce3-bed2-c24556815dab",
                                        "entry_id": "a05f36a8-a0e0-35fc-b587-9a84df89a019",
                                        "glosses": [
                                            "(néosémie) (pour un emprunt) Qui se distingue par l’existence d’une formule de calcul du taux autre que la formule simple « taux variable + marge »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2215ed-7753-4165-84b5-d758db46b1bf",
                                                "sense_id": "81491ba9-8909-3ce3-bed2-c24556815dab",
                                                "text": "Un emprunt toxique, c’est un emprunt structuré qui a mal tourné. Car tous les emprunts toxiques sont des emprunts structurés MAIS tous les emprunts structurés ne sont pas toxiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toxique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09973843-38a5-3b55-a20f-d1037b04b5be",
                                        "entry_id": "3c336b0d-4d39-3027-b5cf-3a232db9806a",
                                        "glosses": [
                                            "Agent chimique ou biologique pouvant provoquer un effet nocif sur un organisme vivant."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae3b5b9-d291-437c-afd1-efd714a299f0",
                                                "sense_id": "09973843-38a5-3b55-a20f-d1037b04b5be",
                                                "text": "Dès lors, l'ennemi ne réagira plus que par son artillerie qui, dans la soirée et la nuit, bombarde très durement et surtout par toxiques nos lignes, le village de Gomont et les passages de l'Aisne."
                                            },
                                            {
                                                "example_id": "a2294713-d959-4558-8e3e-25f0017978e3",
                                                "sense_id": "09973843-38a5-3b55-a20f-d1037b04b5be",
                                                "text": "Beaucoup de toxiques, de l’héroïne, des médocs hyper-forts qu’elle avale n’importe comment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e209b7e-12ad-3ff2-b36e-f7e6ce64a567",
                                        "entry_id": "3c336b0d-4d39-3027-b5cf-3a232db9806a",
                                        "glosses": [
                                            "Ce à quoi une personne est attachée de façon nocive, comme à une dépendance affective ou psychologique."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c08035-cb3a-4981-ac9f-b9bc8e09911e",
                                                "sense_id": "2e209b7e-12ad-3ff2-b36e-f7e6ce64a567",
                                                "text": "Et regarde, regarde la grande idiote de fille, j’en étais sûre, elle pleure toutes les larmes de son corps. Mais oui, c’est logique : elle a perdu son bourreau, son tourment, le toxique quotidien dont la privation va peut-être la tuer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
