                "senses": [
                    {
                        "sense_id": "0f2a3369-2652-3138-b309-c5779b87b341",
                        "entry_id": "0c5eff00-d511-3c74-a9a6-47e41cbf7927",
                        "glosses": [
                            "Eigenschaft, aus genau zwei Silben zu bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6675e59b-86a3-4ab6-98ba-61b31441ac3f",
                                "sense_id": "0f2a3369-2652-3138-b309-c5779b87b341",
                                "text": "„Außer dem Merkmal der (alten⁵) Zweisilbigkeit gibt es keine erkennbare phonologische Regel, derzufolge ein zweisilbiges Wort einen musikalischen Akzent zu bekommen hat oder nicht.“"
                            },
                            {
                                "example_id": "114c1ca4-807d-4d61-9f6f-dcc3f9b8504a",
                                "sense_id": "0f2a3369-2652-3138-b309-c5779b87b341",
                                "text": "„Die Häufung nichtsyllabierbarer Konsonanten in Reduktionssilben hat gerade die Funktion, die Zweisilbigkeit der Form zu sichern, ohne daß die zweite Silbe eines vokalischen Kerns bedürfte.“"
                            },
                            {
                                "example_id": "43bfdf2a-08e6-4f8d-83f3-4c599ef2ba2f",
                                "sense_id": "0f2a3369-2652-3138-b309-c5779b87b341",
                                "text": "„Aufgrund der Zweisilbigkeit beider Namen – Cot-ta /Na-so – könnte jedoch die Verschmelzung zwischen Cotta und dem verlorenen Autor angenommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
