                                "example_id": "0f8b94f6-315a-427f-9698-3e38d4d451f3",
                                "sense_id": "9e9c448f-fa23-3649-8264-d2f0a40a1650",
                                "text": "Broad o'er my Head the verdant Cedar wave, / And high Palmetos lift their graceful Shade."
                            },
                            {
