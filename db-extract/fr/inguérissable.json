        "fr-extract.jsonl": [
            {
                "entry_id": "f358c09a-a186-3572-b94a-efaf5d88b592",
                "word": "inguérissable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "358eb173-1b31-4e7c-ab3e-72d305ca0f2f",
                        "entry_id": "f358c09a-a186-3572-b94a-efaf5d88b592",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inguérissables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                        "entry_id": "f358c09a-a186-3572-b94a-efaf5d88b592",
                        "glosses": [
                            "Qui n’est pas guérissable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d72e9f2-c5c9-40d9-881b-6d41f1af43e4",
                                "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                                "text": "[…] : cette folie furieuse et inguérissable de l’alcool qui, parfois, fait ressembler les marins à des brutes déchaînées."
                            },
                            {
                                "example_id": "2b6729e2-14df-4647-a26a-007034bf630a",
                                "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                                "text": "C’était pour satisfaire l’inguérissable soif du Prince, son attente épuisante ; […]."
                            },
                            {
                                "example_id": "6e72641c-1ce6-4efa-a467-cc4585a2d67e",
                                "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                                "text": "Peut-être Marie me haïssait-elle tout à coup pour tout ce qu’elle avait adoré en moi : cette faiblesse, cette enfance inguérissable."
                            },
                            {
                                "example_id": "4534d197-5762-40d7-be6d-a4ab85fdb922",
                                "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                                "text": "A l'époque où Duke composa ce que les critiques sont unanimes aujourd'hui à considérer comme un de ses petits chefs-d'œuvre, il venait de subir une perte très douloureuse en la personne de sa mère, depuis quelque temps atteinte d'un cancer inguérissable et qui s'éteignit le 27 mai 1935. Ce fut pour Duke un choc terrible."
                            },
                            {
                                "example_id": "eed3aa2f-4561-4722-ba03-0db1c6ed4e49",
                                "sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                                "text": "Nous avons vu la souffrance qui passe, la souffrance de l'enfant; nous avons vu l'amour qui passe, l'amour de l'adolescent; le poème se termine par la douleur inguérissable de l'homme quand, assis au chevet d'une mère, il la regarde agoniser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9eb88800-ca18-4020-81c4-617018b51caf",
                        "source_entry_id": "f358c09a-a186-3572-b94a-efaf5d88b592",
                        "source_sense_id": "a391a77d-199c-3e42-aaea-1a46263d18d6",
                        "target_lang_word": "incurable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "659c62c5-d254-31cf-a60c-e4d4890533b3",
                                        "entry_id": "433236b8-edd9-3b0f-a53c-c59d0a8cc155",
                                        "glosses": [
                                            "Of an illness, condition, etc, that is unable to be cured; healless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af43bffe-0fb9-4fe9-847c-351b29d2421d",
                                                "sense_id": "659c62c5-d254-31cf-a60c-e4d4890533b3",
                                                "text": "They were labouring under a profound, and, as it might have seemed, an almost incurable ignorance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379ec1f4-8fc2-3caa-b62f-eca6bd040873",
                                        "entry_id": "433236b8-edd9-3b0f-a53c-c59d0a8cc155",
                                        "glosses": [
                                            "Irremediable, incorrigible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0859dfe9-1d41-48bd-b3c3-dd9b4eb33861",
                                                "sense_id": "379ec1f4-8fc2-3caa-b62f-eca6bd040873",
                                                "text": "an incurable romantic"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "203c88f2-2eb3-3464-a668-7d7ff631af93",
                                        "entry_id": "125c40a9-a537-36d3-b120-71369f7145f9",
                                        "glosses": [
                                            "One who cannot be cured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b932a5b1-23cf-4886-8abd-debcca5fc6d8",
                                                "sense_id": "203c88f2-2eb3-3464-a668-7d7ff631af93",
                                                "text": "Heatherlegh, the Doctor, kept, in addition to his regular practice, a hospital on his private account — an arrangement of loose-boxes for Incurables, his friends called it — but it was really a sort of fitting-up shed for craft that had been damaged by stress of weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
