                    {
                        "translation_id": "bb267154-d20a-4f9d-bf59-6c50edf4a461",
                        "source_entry_id": "3ce46c0d-49a4-340f-bb69-389e010f1dfa",
                        "source_sense_id": "5f09d47d-2ef4-3e88-b641-f24a5878a621",
