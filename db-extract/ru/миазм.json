                                "sense_id": "79a7635d-cdb5-3a86-93b9-42a6508e7d8c",
                                "text": "Миазмы городских свалок."
                            },
                            {
                                "example_id": "d97f97fc-14bc-472d-bb0d-25f17f914348",
                                "sense_id": "79a7635d-cdb5-3a86-93b9-42a6508e7d8c",
                                "text": "Миазмы сточных вод."
                            }
                        ]
                    },
                    {
                        "sense_id": "c902174c-6ac1-367d-840f-39f20a22f069",
                        "entry_id": "38147688-b384-34b4-b4db-3ed77ea2785a",
                        "glosses": [
                            "перен. о проявлении чего-либо дурного, скверного, безобразного в моральном отношении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7e2ed4-b5ea-499e-9ed9-ef9998042e5b",
                                "sense_id": "c902174c-6ac1-367d-840f-39f20a22f069",
                                "text": "Миазмы преступного мира."
                            },
                            {
                                "example_id": "763f9b39-72e0-4f52-b369-089ae0f6f014",
                                "sense_id": "c902174c-6ac1-367d-840f-39f20a22f069",
                                "text": "Миазмы проституции."
                            }
                        ]
                    }
