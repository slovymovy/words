                        "glosses": [
                            "Mettre en vedette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7513ac22-a33b-4b13-a262-dc292d1f55a2",
                                "sense_id": "dc33b8c7-f4a1-39a4-b2ec-37363e3875ba",
                                "text": "Il importe de dramatiser les différences, de vedettiser les frontières pour assurer à la fois la fidélité au parti et la méfiance à l'égard des adversaires."
                            },
                            {
                                "example_id": "7adfe9f9-decb-428d-adf2-d96ad8d86cee",
                                "sense_id": "dc33b8c7-f4a1-39a4-b2ec-37363e3875ba",
                                "text": "Une autre question est celle de savoir s'il faut en quelque sorte vedettiser la vie publique pour « sauver » la politique."
                            }
                        ]
                    }
