                        "tellement"
                    ]
                },
                {
                    "sense_id": "2a4a7c14-292b-3088-998d-5729d2eb482b",
                    "sense_definition": "S'emploie pour indiquer qu'une action est préférable ou équivalente à une autre ; aussi bien.",
