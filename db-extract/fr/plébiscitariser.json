                        "glosses": [
                            "Donner un caractère plébiscitaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84a37c6-3888-42c4-b620-d7791937f9d7",
                                "sense_id": "833f28a1-9e0d-34c5-9a9b-4dfeedb9def3",
                                "text": "Rien ne lui interdit, d’abord, de « plébiscitariser » la campagne et proposer aux électeurs qu’un vote en sa faveur implique la défiance du président."
                            },
                            {
                                "example_id": "2bcd684e-d6df-4e5f-bcd8-078d6fc7af42",
                                "sense_id": "833f28a1-9e0d-34c5-9a9b-4dfeedb9def3",
                                "text": "Peut-on dire aujourd’hui que l’intuition du sociologue allemand était juste, autrement dit que les démocraties modernes se sont toutes plus ou moins « plébiscitarisées » ?"
                            }
                        ]
                    }
