    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6977c4f3-d0e3-340d-9eff-045df001f704",
                    "sense_definition": "een godsdienstige toespraak houden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "godsdienst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pastoor zal zondagochtend over vergeving <w>preken</w>.",
                            "target_lang_translations": {
                                "fr": "Le curé va <w>prêcher</w> sur le pardon dimanche matin."
                            }
                        },
                        {
                            "text": "In die oude kerk <w>preekt</w> de dominee elke week voor een volle zaal.",
                            "target_lang_translations": {
                                "fr": "Dans cette vieille église, le pasteur <w>prêche</w> chaque semaine devant une salle comble."
                            }
                        }
                    ],
                    "synonyms": [
                        "prediken"
                    ],
                    "common_phrases": [
                        "voor eigen parochie preken"
                    ],
                    "target_lang_definitions": {
                        "fr": "prononcer un discours religieux, faire un sermon"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "prêcher",
                                "target_lang_sense_clarification": "discours religieux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d87e2a6-4d84-33b2-9f9c-5b73fa42ee43",
                    "sense_definition": "op een belerende of vermanende manier toespreken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet zo tegen me <w>preken</w>, want ik weet zelf wel wat goed is.",
                            "target_lang_translations": {
                                "fr": "Tu ne devrais pas tant me <w>faire la morale</w>, car je sais très bien ce qui est bon pour moi."
                            }
                        },
                        {
                            "text": "Zijn ouders <w>preekten</w> voortdurend over het belang van sparen.",
                            "target_lang_translations": {
                                "fr": "Ses parents lui <w>faisaient constamment la morale</w> sur l'importance d'économiser."
                            }
                        }
                    ],
                    "synonyms": [
                        "moraliseren",
                        "leslezen"
                    ],
                    "target_lang_definitions": {
                        "fr": "s'adresser à quelqu'un sur un ton moralisateur ou faire la leçon"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "faire la morale",
                                "target_lang_sense_clarification": "moraliser, sermonner"
                            },
                            {
                                "target_lang_word": "moraliser",
                                "target_lang_sense_clarification": "faire des remontrances"
                            },
                            {
                                "target_lang_word": "sermonner",
                                "target_lang_sense_clarification": "réprimander en moralisant"
                            },
                            {
                                "target_lang_word": "prêcher",
                                "target_lang_sense_clarification": "au sens figuré"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f96244aa-b81c-3623-85ee-fa3393c13dac",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>preek</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gelovigen luisterden aandachtig naar de verschillende <w>preken</w>.",
                            "target_lang_translations": {
                                "fr": "Les fidèles écoutaient attentivement les différents <w>sermons</w>."
                            }
                        },
                        {
                            "text": "Zijn lange <w>preken</w> over gezond eten begonnen iedereen te vervelen.",
                            "target_lang_translations": {
                                "fr": "Ses longs <w>sermons</w> sur l'alimentation saine commençaient à ennuyer tout le monde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "forme plurielle du nom « preek » (sermon)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sermons",
                                "target_lang_sense_clarification": "pluriel de sermon"
                            },
                            {
                                "target_lang_word": "prêches",
                                "target_lang_sense_clarification": "pluriel de prêche"
                            }
                        ]
                    }
                }
            ]
