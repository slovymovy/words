                "senses": [
                    {
                        "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                        "entry_id": "474e1d41-aabb-395e-95d7-63537965d839",
                        "glosses": [
                            "wissenschaftliche Ermittlung von Eigenschaften und chemischen Zusammensetzungen im Zusammenhang mit Geruchsstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca1f879-1262-4779-bf82-9994b8f8050c",
                                "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                                "text": "„Die olfaktometrische Geruchsbestimmung erfolgte nach dem Konstanzverfahren (VDI 3888 Blatt 4) unmittelbar nach der Abluftbeprobung im mobilen Geruchslabor MEO5 des LUA durch jeweils 5 ausgewählte Versuchspersonen (Abbildung 3-5).“"
                            },
                            {
                                "example_id": "0d619287-e77a-4fb1-8053-88ea44ca5ebd",
                                "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                                "text": "„Es können auch schon mal Babyschweißfüße sein – eine wichtige Note bei der Geruchsbestimmung von Camembert.“ DIE"
                            },
                            {
                                "example_id": "ac3e1375-df74-472f-aca3-ea19c0792f44",
                                "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                                "text": "„Nach der Geruchsbestimmung wurden die Teilnehmer – immer noch im Scanner – gebeten, das Angstlevel einzuschätzen.“"
                            },
                            {
                                "example_id": "f7fbf73d-df49-4ef8-8036-e395ebc3ee50",
                                "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                                "text": "„Die Geruchsbestimmung muss aus naheliegenden Gründen in geruchsfreier Umgebung stattfinden.“"
                            },
                            {
                                "example_id": "4a001cd3-0585-4481-8e70-3dad1da102ec",
                                "sense_id": "601e2a7f-eebd-34f8-9f91-94c96c9ae55e",
                                "text": "„Deshalb wird die Geruchsbestimmung bei wichtigen Anlässen von mehreren Personen, sogenannten Panels, durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
