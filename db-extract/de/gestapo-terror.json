                "senses": [
                    {
                        "sense_id": "48ced7b5-45fc-3708-b935-da9645f64556",
                        "entry_id": "828eb11c-042d-3e64-acfe-e5a5684a7edb",
                        "glosses": [
                            "Terror, den die Gestapo ausübte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4dfbfa-6017-4349-aa9b-9fa779c24e4c",
                                "sense_id": "48ced7b5-45fc-3708-b935-da9645f64556",
                                "text": "„Vor dem Gestapo-Gebäude in der Bředovská-Straße protestierte eine riesige Menschenmenge gegen den Gestapo-Terror.“"
                            },
                            {
                                "example_id": "46960a33-d61b-45ec-914f-61cb08d27865",
                                "sense_id": "48ced7b5-45fc-3708-b935-da9645f64556",
                                "text": "„Eine Ausstellung, die vom 15. Februar bis zum 30. April 2017 in der Universitätsbibliothek zu sehen ist, gibt nun Einblick in einen besonders erschreckenden Aspekt dieser Periode: Unter dem Titel »Gestapo-Terror in Luxemburg – Verwaltung, Überwachung, Unterdrückung« macht sie deutlich, wie der Unterdrückungs- und Bespitzelungsapparat der Nationalsozialisten im annektierten Großherzogtum funktionierte.“"
                            },
                            {
                                "example_id": "12b828a2-b190-4f11-a8ce-fed08c21881a",
                                "sense_id": "48ced7b5-45fc-3708-b935-da9645f64556",
                                "text": "„Sie stellt die Auseinandersetzung des österreichisch-jüdischen Autors mit dem Gestapo-Terror in seiner Heimat sowie den Beschwerlichkeiten seines Exil-Lebens dar.“"
                            },
                            {
                                "example_id": "d3a61b0e-e6f2-408c-b880-1f5cb51d50b9",
                                "sense_id": "48ced7b5-45fc-3708-b935-da9645f64556",
                                "text": "„Der Gestapo-Terror - so Johnson - habe sich vor allen Dingen gegen klar definierte Gegner wie Juden und Kommunisten gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
