{
    "word_family": [
        "tosser",
        "tossing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ef71db7-e200-39d6-a8c0-f69357145126",
                    "sense_definition": "To throw something lightly, carelessly, or with a sudden upward motion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>toss</w> that pen over to me so I can sign this.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>кинь</w> мне ту ручку, чтобы я мог подписать это.",
                                "zh": "请把那支笔<w>扔</w>给我，好让我签个字。"
                            }
                        },
                        {
                            "text": "The children like to <w>toss</w> the ball back and forth in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети любят <w>перебрасывать</w> мяч друг другу в саду.",
                                "zh": "孩子们喜欢在花园里把球<w>抛</w>来抛去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "lob",
                        "pitch",
                        "chuck"
                    ],
                    "common_phrases": [
                        "toss a ball",
                        "toss aside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать что-либо легко, небрежно или резким движением вверх.",
                        "zh": "轻率地、随意地或突然向上抛掷某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "подбрасывать",
                                "target_lang_sense_clarification": "бросать вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔",
                                "target_lang_sense_clarification": "通用词"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "向上投掷"
                            },
                            {
                                "target_lang_word": "投",
                                "target_lang_sense_clarification": "投掷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8c91339-a6c9-3c01-a18d-47d3f9ab9505",
                    "sense_definition": "To get rid of something that is no longer needed or wanted.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "discard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>toss</w> those old magazines in the recycling bin.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>выбросить</w> эти старые журналы в мусорный бак для переработки.",
                                "zh": "你应该把那些旧杂志<w>扔掉</w>进回收箱里。"
                            }
                        },
                        {
                            "text": "I decided to <w>toss</w> the broken chair instead of trying to fix it.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>выкинуть</w> сломанный стул вместо того, чтобы пытаться его починить.",
                                "zh": "我决定把那把坏椅子<w>丢弃</w>，而不是试着去修它。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw out",
                        "toss out",
                        "dump",
                        "discard"
                    ],
                    "common_phrases": [
                        "toss in the trash",
                        "toss it out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавляться от чего-либо, что больше не нужно.",
                        "zh": "丢弃不再需要或不想要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться"
                            },
                            {
                                "target_lang_word": "выкидывать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扔掉",
                                "target_lang_sense_clarification": "丢弃"
                            },
                            {
                                "target_lang_word": "丢弃",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d4f64a2-d9ed-3454-9c52-803e9c7cea9d",
                    "sense_definition": "To mix ingredients, such as a salad or pasta, by gently lifting and dropping them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mix_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a large bowl to <w>toss</w> the salad with the olive oil dressing.",
                            "target_lang_translations": {
                                "ru": "Используйте большую миску, чтобы <w>перемешать</w> салат с заправкой из оливкового масла.",
                                "zh": "用一个大碗把沙拉和橄榄油调料<w>拌</w>匀。"
                            }
                        },
                        {
                            "text": "The chef began to <w>toss</w> the pasta in the sauce right before serving.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар начал <w>перемешивать</w> пасту в соусе прямо перед подачей.",
                                "zh": "厨师在装盘前开始把意面在酱汁里<w>搅拌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss a salad",
                        "tossed salad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемешивать ингредиенты (например, салат или пасту), аккуратно приподнимая и встряхивая их.",
                        "zh": "通过轻轻提起和翻动来混合食材，如沙拉或意面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "салат, ингредиенты"
                            },
                            {
                                "target_lang_word": "встряхивать",
                                "target_lang_sense_clarification": "смешивать встряхиванием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拌",
                                "target_lang_sense_clarification": "混合食材"
                            },
                            {
                                "target_lang_word": "搅拌",
                                "target_lang_sense_clarification": "混合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8362a68-af96-3a02-ab29-6fa784b4e82c",
                    "sense_definition": "To throw a coin into the air to decide a choice or winner based on which side lands facing up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coin_flip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can <w>toss</w> a coin to decide who gets to choose the movie.",
                            "target_lang_translations": {
                                "ru": "Мы можем <w>подбросить</w> монету, чтобы решить, кто будет выбирать фильм.",
                                "zh": "我们可以<w>掷</w>硬币来决定谁来选电影。"
                            }
                        },
                        {
                            "text": "The referee will <w>toss</w> for sides before the football match begins.",
                            "target_lang_translations": {
                                "ru": "Судья <w>проведет жеребьёвку</w> сторон перед началом футбольного матча.",
                                "zh": "足球赛开始前，裁判会通过<w>抛</w>硬币来决定场地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss a coin",
                        "toss for it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подбрасывать монету в воздух для принятия решения или определения победителя.",
                        "zh": "抛掷硬币以根据正反面决定选择或胜负。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбрасывать",
                                "target_lang_sense_clarification": "монету"
                            },
                            {
                                "target_lang_word": "кидать",
                                "target_lang_sense_clarification": "жребий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掷",
                                "target_lang_sense_clarification": "掷硬币"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "抛硬币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd8a359-3cb8-324e-8de1-4c4f43436924",
                    "sense_definition": "To move about restlessly from side to side, especially while lying in bed unable to sleep.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "restless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tend to <w>toss</w> and turn all night when I am stressed about work.",
                            "target_lang_translations": {
                                "ru": "Я обычно <w>ворочаюсь</w> всю ночь, когда переживаю из-за работы.",
                                "zh": "当我对工作感到压力时，我整晚都会<w>翻来覆去</w>。"
                            }
                        },
                        {
                            "text": "The fever made the poor child <w>toss</w> in his sleep for hours.",
                            "target_lang_translations": {
                                "ru": "Из-за жара бедный ребенок часами <w>метался</w> во сне.",
                                "zh": "发烧让那个可怜的孩子在睡梦中<w>翻来覆去</w>了好几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "welter"
                    ],
                    "common_phrases": [
                        "toss and turn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокойно двигаться из стороны в сторону, особенно лежа в постели при бессоннице.",
                        "zh": "不安地左右翻动，尤指在床上无法入睡时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворочаться",
                                "target_lang_sense_clarification": "в постели"
                            },
                            {
                                "target_lang_word": "метаться",
                                "target_lang_sense_clarification": "при лихорадке или беспокойстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻来覆去",
                                "target_lang_sense_clarification": "形容睡不着"
                            },
                            {
                                "target_lang_word": "辗转反侧",
                                "target_lang_sense_clarification": "书面语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb9a145-6236-3253-b90f-f3e3584b8818",
                    "sense_definition": "To move one's head suddenly upwards and backwards, often to show anger, impatience, or pride.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "head_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>tossed</w> her hair back and walked away without saying another word.",
                            "target_lang_translations": {
                                "ru": "Она <w>откинула</w> волосы назад и ушла, не сказав больше ни слова.",
                                "zh": "她<w>甩</w>了一下头发，一言不发地走开了。"
                            }
                        },
                        {
                            "text": "The horse began to <w>toss</w> its head in irritation at the flies.",
                            "target_lang_translations": {
                                "ru": "Лошадь начала раздраженно <w>вскидывать</w> голову из-за мух.",
                                "zh": "马因为苍蝇的叮咬而烦躁地<w>仰</w>头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss one's head",
                        "toss one's hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко вскидывать голову вверх и назад, часто выражая гнев, нетерпение или гордость.",
                        "zh": "突然向后仰头，常用于表达愤怒、不耐烦或骄傲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскидывать",
                                "target_lang_sense_clarification": "голову"
                            },
                            {
                                "target_lang_word": "откидывать",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "тряхнуть",
                                "target_lang_sense_clarification": "головой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甩",
                                "target_lang_sense_clarification": "甩头"
                            },
                            {
                                "target_lang_word": "仰",
                                "target_lang_sense_clarification": "仰头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b048274b-1a9f-3436-8f1e-16b063aae3cb",
                    "sense_definition": "To search a place thoroughly and often roughly, leaving it in disorder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had to <w>toss</w> the suspect's apartment looking for hidden evidence.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось <w>перерыть</w> квартиру подозреваемого в поисках спрятанных улик.",
                                "zh": "警察不得不把嫌疑人的公寓<w>翻乱</w>以寻找隐藏的证据。"
                            }
                        },
                        {
                            "text": "I watched them <w>toss</w> the room, pulling books off the shelves and emptying drawers.",
                            "target_lang_translations": {
                                "ru": "Я смотрел, как они <w>перерывали</w> комнату, сбрасывая книги с полок и опустошая ящики.",
                                "zh": "我看着他们把房间<w>翻乱</w>，把书从架子上扯下来，把抽屉清空。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss a room",
                        "toss a cell"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in police or criminal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и часто грубо обыскивать место, оставляя после себя беспорядок.",
                        "zh": "彻底且粗暴地搜查某处，通常会弄得一片狼藉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерывать",
                                "target_lang_sense_clarification": "искать, наводя беспорядок"
                            },
                            {
                                "target_lang_word": "обыскивать",
                                "target_lang_sense_clarification": "проводить обыск"
                            },
                            {
                                "target_lang_word": "шмонать",
                                "target_lang_sense_clarification": "жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻乱",
                                "target_lang_sense_clarification": "搜查并弄乱"
                            },
                            {
                                "target_lang_word": "搜查",
                                "target_lang_sense_clarification": "搜寻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a13f05b-05dc-3b74-97f3-491d437fb0ce",
                    "sense_definition": "To vomit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vomit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt sick after the roller coaster and thought he might <w>toss</w> his lunch.",
                            "target_lang_translations": {
                                "ru": "Его мутило после американских горок, и он думал, что может <w>сблевать</w> обед.",
                                "zh": "坐完过山车后他感到恶心，觉得可能会把午饭<w>吐</w>出来。"
                            }
                        },
                        {
                            "text": "If you eat that old meat, you are definitely going to <w>toss</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты съешь это старое мясо, тебя точно <w>вырвет</w>.",
                                "zh": "如果你吃了那块变质的肉，你肯定会<w>呕吐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vomit",
                        "throw up",
                        "puke",
                        "hurl",
                        "barf",
                        "upchuck"
                    ],
                    "common_phrases": [
                        "toss one's cookies"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тошнить, рвать.",
                        "zh": "呕吐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блевать",
                                "target_lang_sense_clarification": "грубое"
                            },
                            {
                                "target_lang_word": "рвать",
                                "target_lang_sense_clarification": "безличное (меня рвет)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呕吐",
                                "target_lang_sense_clarification": "正式"
                            },
                            {
                                "target_lang_word": "吐",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25528a95-626a-3b49-9862-3f49bb3ce8cd",
                    "sense_definition": "An act of throwing something, usually lightly or with an upward motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>toss</w> of the ball, the game finally started.",
                            "target_lang_translations": {
                                "ru": "С быстрым <w>броском</w> мяча игра наконец началась.",
                                "zh": "随着一个快速的<w>投掷</w>动作，比赛终于开始了。"
                            }
                        },
                        {
                            "text": "He won the carnival prize with a lucky <w>toss</w> of the ring.",
                            "target_lang_translations": {
                                "ru": "Он выиграл приз на карнавале удачным <w>броском</w> кольца.",
                                "zh": "他凭借幸运的一<w>抛</w>赢得了嘉年华的奖品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "lob",
                        "pitch",
                        "cast",
                        "fling"
                    ],
                    "common_phrases": [
                        "a quick toss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие бросания, обычно легкое или направленное вверх.",
                        "zh": "投掷某物的动作，通常是轻微的或向上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投掷",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec5aa91-374b-348d-9ed8-d5474ea58666",
                    "sense_definition": "The act of flipping a coin to decide a matter, such as who plays first in a game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coin_flip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team captain won the <w>toss</w> and chose to defend the goal.",
                            "target_lang_translations": {
                                "ru": "Капитан команды выиграл <w>жеребьёвку</w> и выбрал защищать ворота.",
                                "zh": "队长赢得了<w>掷硬币</w>，选择了防守球门。"
                            }
                        },
                        {
                            "text": "We decided the winner by a simple coin <w>toss</w>.",
                            "target_lang_translations": {
                                "ru": "Мы определили победителя простым <w>подбрасыванием</w> монеты.",
                                "zh": "我们通过简单的<w>抛硬币</w>决定了胜者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "win the toss",
                        "lose the toss",
                        "coin toss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подбрасывание монеты для решения спора или выбора.",
                        "zh": "通过抛硬币来决定某事，例如谁先开始游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жеребьёвка",
                                "target_lang_sense_clarification": "процедура"
                            },
                            {
                                "target_lang_word": "подбрасывание",
                                "target_lang_sense_clarification": "действие"
