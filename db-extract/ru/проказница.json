                "senses": [
                    {
                        "sense_id": "ddcf96f5-d6c2-3ee8-9616-528a0150dc62",
                        "entry_id": "d6ecc320-0eb6-3f0a-92dc-8f915182f3bb",
                        "glosses": [
                            "female equivalent of прока́зник (prokáznik): female prankster"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "35c68a3b-dee9-4148-9481-4c9e5694a6cd",
                                "sense_id": "ddcf96f5-d6c2-3ee8-9616-528a0150dc62",
                                "text": "— Прока́зница вы, ма́менька! пра́во, прока́зница! — шути́л и он в свою́ о́чередь; но, впро́чем, по своему́ обыкнове́нию, отнёсся к предме́ту семе́йного разгово́ра укло́нчиво.",
                                "translation": "‘Ah, Mother dear, what a one you are! You really are a mischief!’ he responded, jesting in turn; but, as was his wont, evading the real subject of the family conversation.",
                                "english": "‘Ah, Mother dear, what a one you are! You really are a mischief!’ he responded, jesting in turn; but, as was his wont, evading the real subject of the family conversation."
                            }
                        ]
                    }
