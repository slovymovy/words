                                "target_senses": [
                                    {
                                        "sense_id": "11213a4e-f7e6-355d-8e19-5ff60c8a0164",
                                        "entry_id": "e20de6c8-1b64-3b32-976b-6279442e02f3",
                                        "glosses": [
                                            "slecht verlicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96fc74aa-233b-43fa-92fe-cb7143c58ae2",
                                                "sense_id": "11213a4e-f7e6-355d-8e19-5ff60c8a0164",
                                                "text": "Filart riep samen met andere wijkbewoners afgelopen najaar een buurtwacht in het leven. Samen surveilleerden ze langs de tunnels, die inmiddels berucht zijn geworden door hun aantrekkingskracht op hangjongeren en criminelen. Verklaarbaar, want de tunnels zijn de droom van elke overvaller: het slachtoffer kan geen kant uit, het is er halfdonker en niemand hoort of ziet je. Voor veel wijkbewoners reden om de tunnels te vermijden."
                                            },
                                            {
                                                "example_id": "b7b672ab-2631-46c1-a085-f90d36b4fd3f",
                                                "sense_id": "11213a4e-f7e6-355d-8e19-5ff60c8a0164",
                                                "text": "De PH-GOV beschikt over satellietverbinding. Koning en kabinet kunnen daardoor tijdens de vlucht gewoon doorwerken. Of even gamen. In de cabine prijkt een kloek flatscreen. Desgewenst kan de bemanning het binnenvallende licht van het toestel naar wens regelen met een iPad. Licht-halfdonker-donker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halfdonker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "816d67f0-aed3-3648-ae75-1d054b459a1f",
                                        "entry_id": "3480407c-4438-3bba-b602-fd44ab9ee8f4",
                                        "glosses": [
                                            "schemer, schemering, deemster [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8efe309-f4e4-4c5d-a3b0-ba10dff0c09e",
                                                "sense_id": "816d67f0-aed3-3648-ae75-1d054b459a1f",
                                                "text": "Op de prent is een naakte vrouw te zien op een divan die in het halfdonker de krant leest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
