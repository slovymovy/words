                "senses": [
                    {
                        "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                        "entry_id": "d41acb1f-47bc-30c6-a984-075801d067c7",
                        "glosses": [
                            "Fitness-/Kraftübung, bei der ausschließlich das eigene Körpergewicht als Widerstand genutzt wird und auf den Einsatz von Hanteln oder anderen Trainingsgeräten verzichtet wird"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "40ddd40e-56a2-4148-877f-b6c7ece15a6d",
                                "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                                "text": "„Durch die perfekte Kombination aus Übungen mit freien Gewichten und Körpergewichtsübungen werden Sie Ihre Gesässmukulatur auf das nächste Level anheben – Nejc Hojc Personal Training Systems, Personal Trainer für Frauen in St. Gallen.“"
                            },
                            {
                                "example_id": "4e375856-c8b4-4050-8c2e-d4a0131f7d49",
                                "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                                "text": "„Yoga ist eine Form von Körpergewichtsübungen, die die Kraft steigern kann, insbesondere bei Personen, die neu im Widerstandstraining sind.“"
                            },
                            {
                                "example_id": "e5ef286d-86cd-4dc7-806d-277b63db75f6",
                                "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                                "text": "„Du kannst sie bei so gut wie jeder Art von Training verwenden, sei es beim Laufen, Fahrradfahren, Krafttraining oder beim Ausführen von Körpergewichtsübungen.“"
                            },
                            {
                                "example_id": "0582fa2d-5ddc-4b82-b98e-addaa45fe584",
                                "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                                "text": "„Dazu gehören Körpergewichtsübungen wie Dips und Liegestütze (insbesondere Diamant Liegestütze resp. Push Ups), aber auch Übungen mit Gewichten wie zB am EISENHORN mit Kabelzug, Griffbändern usw.“"
                            },
                            {
                                "example_id": "37a8f379-d1ff-4313-9e43-c0fbdd34b03c",
                                "sense_id": "f1f84e5c-5818-3b41-a99b-8e686384ec4b",
                                "text": "„CrossFit ist ein Kraft-, Konditions- und allgemeines Fitnessprogramm, das hauptsächlich aus einer Mischung aus aerobem Training, Calisthenics (Körpergewichtsübungen) und olympischem Gewichtheben besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
