                ],
                "senses": [
                    {
                        "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                        "entry_id": "dc792b49-9ccd-3dd2-8f5f-9e50c5584842",
                        "glosses": [
                            "lichtlose Wasserschicht des Meeres, die von 6000 Metern in Tiefseegräben bis zirka 11000 Metern reicht"
                        ],
                        "tags": [
                            "Biogeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "698fb938-9fde-45fc-bcf6-ec420a0925a8",
                                "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                                "text": "Im Hadopelagial herrscht aber ein Druck von bis zu 1100 bar."
                            },
                            {
                                "example_id": "44877dd9-e1cb-4a36-acaa-90e3f44c7645",
                                "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                                "text": "Sonnenlicht ist im Hadopelagial nicht mehr vorhanden und die Temperatur wie im Abyssopelagial nahe am Gefrierpunkt."
                            },
                            {
                                "example_id": "98ebb802-d165-4cfd-bd4f-4a1f0192cf6d",
                                "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                                "text": "»Das ist eigenartig. Dies sehen aus wie Tiefseegarnelen. Sie sind noch recht frisch, aber alle tot. Sie leben nur in sehr tiefem Wasser, bis zum Hadopelagial in sechstausend Metern Tiefe. …«"
                            },
                            {
                                "example_id": "f1084ff2-0d7d-416c-bf4f-034f78f1045a",
                                "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                                "text": "Der «Hadal Sanilfish» lebt im Hadopelagial, das ist die Tiefenzone zwischen 6000 und 11000 Metern."
                            },
                            {
                                "example_id": "c979d957-7e10-475f-91a0-7a61eb473b21",
                                "sense_id": "7b6f4958-0260-3035-88d9-a8460f3ac242",
                                "text": "Der Schweizer Wissenschaftler Jacques Piccard und der amerikanische Marineoffizier Don Walsh waren die einzigen Menschen, die am 23. Januar 1960 eine Tauchfahrt an Bord des Tauchbootes „Trieste“ in das Hadopelagial bis auf den Boden des Marianengrabens in 11000 Metern Tiefe wagten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
