            "senses": [
                {
                    "sense_id": "f06e965c-62a7-344e-8222-b5a8a63e3a08",
                    "sense_definition": "Causing strong feelings of disgust or being very unpleasant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disgusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a <w>gross</w> hair in my soup and immediately lost my appetite.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>противный</w> волос в супе и сразу потерял аппетит.",
                                "zh": "我在汤里发现了一根<w>恶心</w>的头发，立刻就没了胃口。"
                            }
                        },
                        {
                            "text": "The bathroom was totally <w>gross</w> because nobody had cleaned it for weeks.",
                            "target_lang_translations": {
                                "ru": "В ванной было совершенно <w>мерзко</w>, потому что ее никто не убирал неделями.",
                                "zh": "浴室简直<w>恶心</w>透了，因为几周都没人打扫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgusting",
                        "nasty",
                        "revolting",
                        "yucky"
                    ],
                    "common_phrases": [
                        "totally gross",
                        "really gross",
                        "so gross"
