                        ]
                    },
                    {
                        "translation_id": "ad74890d-53e9-409b-add0-80a63301ed5b",
                        "source_entry_id": "32a01be6-a489-3034-b847-616535a6cb07",
                        "source_sense_description": "process of approximating a continuous signal",
                        "target_lang_word": "Quantisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quantisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                                        "entry_id": "4f6f29fb-de42-3c34-a9f1-7aba555bc36e",
                                        "glosses": [
                                            "Zerteilung bestimmter Größen in kleine Teile; diese Größen können also nur diskrete Werte aus einem gestuften Wertvorrat annehmen, statt kontinuierlich veränderbar zu sein"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe2df2f-3bdf-4028-8a87-1bcf5c0bac3c",
                                                "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                                                "text": "„Die ersten Versuche einer Quantisierung des elektromagnetischen Feldes zielten darauf ab, die Emission von Photonen durch ein Atom beschreiben zu können.“"
                                            },
                                            {
                                                "example_id": "faad609f-9ab7-44a6-a411-564d35431310",
                                                "sense_id": "23a3de3d-9f7b-37ba-a0bf-027f8e2bf893",
                                                "text": "„Die dem Schalenmodell zugrundeliegenden Elektronenschalen ergeben sich durch die Quantisierung der Elektronenenergien im Kraftfeld des Atomkerns nach den Regeln der Quantenmechanik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55bb733e-df03-4092-9a8a-e9204b1af26e",
                        "source_entry_id": "32a01be6-a489-3034-b847-616535a6cb07",
                        "source_sense_description": "process of approximating a continuous signal",
                        "target_lang_word": "Quantelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quantelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                        "entry_id": "a4eb2970-3307-32ab-a388-2e812490387c",
                                        "glosses": [
                                            "Zerteilung bestimmter Größen in kleine Teile; diese Größen können also nur diskrete Werte aus einem gestuften Wertvorrat annehmen, statt kontinuierlich veränderbar zu sein"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df3d3a8b-972e-4c63-a7d8-abc2a99ce92b",
                                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                                "text": "„Bislang ist Quantelung bei den folgenden physikalischen Objekten und Größen bekannt: Materie, Licht, Energie, Ladung, Impuls, Drehimpuls, elektrischer Widerstand.“"
                                            },
                                            {
                                                "example_id": "c310fa08-b5a2-42a9-8299-f58c78da0f07",
                                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                                "text": "„Nach der Entdeckung der Quantelung des Lichts durch Albert Einstein bei der Untersuchung des Photoeffekts entstand das Dilemma, ob Licht als Welle oder als Teilchenstrom beschrieben werden soll.“"
                                            },
                                            {
                                                "example_id": "c536b231-2c22-44ea-9621-803ee2996893",
                                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                                "text": "„Quanten können immer nur in bestimmten Portionen dieser physikalischen Größe auftreten, sie sind mithin die Quantelung dieser Größen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
