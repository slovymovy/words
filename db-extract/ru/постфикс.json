                                    {
                                        "sense_id": "a7d063ee-b46b-3bee-a023-df0d56dcfd6c",
                                        "entry_id": "5c0aca86-8d95-33a9-a13b-f9d09be03157",
                                        "glosses": [
                                            "To suffix."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eda6258f-94f2-469c-b367-06865c277dc6",
                                                "sense_id": "a7d063ee-b46b-3bee-a023-df0d56dcfd6c",
                                                "text": "Verbs with י for the first radical, often drop it in the future, imperative, and infinitive of Kal, to which last they postfix ת (לקח to take, follows this form), and in Niph. and Hiph. they change י into ו."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313b790d-99ac-356d-b7d4-b8f97b301b6e",
                                        "entry_id": "5c0aca86-8d95-33a9-a13b-f9d09be03157",
                                        "glosses": [
                                            "To subject a sample to postfixation"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "postfix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847097ab-4be6-326a-8618-dfe24a883a52",
                                        "entry_id": "7aacd03d-1b3a-37fd-acf1-915f180be3de",
                                        "glosses": [
                                            "A suffix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54afa82b-397e-40e7-83ef-844417328657",
                                                "sense_id": "847097ab-4be6-326a-8618-dfe24a883a52",
                                                "text": "Two, or three at the very most, of the prefixes or postfixes are quite sufficient for one day's lesson."
                                            },
                                            {
                                                "example_id": "fbf9a924-d338-4255-b30a-24a68858f818",
                                                "sense_id": "847097ab-4be6-326a-8618-dfe24a883a52",
                                                "text": "An example of a postfix operator is the ++ notation used in the C programming language to increment the value of a variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5feb5a67-bb18-3754-8432-f555051106f3",
                                        "entry_id": "7aacd03d-1b3a-37fd-acf1-915f180be3de",
                                        "glosses": [
                                            "In the Czech language, a suffix that is placed after the ending."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
