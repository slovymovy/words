                "senses": [
                    {
                        "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                        "entry_id": "95cde711-78f2-3405-a378-081a26991b06",
                        "glosses": [
                            "to undergo, to be exposed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e115a8c-95f7-487c-bc47-04c0ee018008",
                                "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                                "text": "подверга́ться де́йствию чего́-либо.",
                                "translation": "to be subject/subjected to something, to experience something",
                                "english": "to be subject/subjected to something, to experience something"
                            },
                            {
                                "example_id": "4c100df9-b9ce-4cbb-bb26-faa487fea517",
                                "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                                "text": "подверга́ться ре́зкой кри́тике",
                                "translation": "to run the gauntlet",
                                "english": "to run the gauntlet"
                            },
                            {
                                "example_id": "7b1b9c9b-e82a-48d1-bff8-2fb11f760800",
                                "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                                "text": "подверга́ться опа́сности",
                                "translation": "to run the risk (of), to run the danger (of)",
                                "english": "to run the risk (of), to run the danger (of)"
                            },
                            {
                                "example_id": "d5bec015-cff2-4314-9ede-73ad9a7d8fcb",
                                "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                                "text": "подверга́ться изуче́нию",
                                "translation": "to receive the study",
                                "english": "to receive the study"
                            },
                            {
                                "example_id": "fc861e28-fafb-43e6-bb24-7a107db70e46",
                                "sense_id": "70b62ba5-b877-34b6-9fda-82a51fcc0116",
                                "text": "подверга́ться униже́ниям",
                                "translation": "to suffer indignity",
                                "english": "to suffer indignity"
                            }
                        ]
