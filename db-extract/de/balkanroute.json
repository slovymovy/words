                "senses": [
                    {
                        "sense_id": "f0945423-149d-397f-9eca-811e1356c963",
                        "entry_id": "0a1be4ab-f040-303b-b908-d14fd838c391",
                        "glosses": [
                            "von Süden nach Norden führende, in der Wegführung nicht festgelegte Passage durch die Balkanhalbinsel, früher oftmals im Zusammenhang mit Drogenschmuggel und seit 2015 meist mit Bezug auf Flüchtlinge verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4197bb50-4c9a-4e60-b2b5-22bc7ee9714d",
                                "sense_id": "f0945423-149d-397f-9eca-811e1356c963",
                                "text": "Vor allem aus Syrien, aber auch aus Afghanistan, aus dem Irak, dem Iran, aus Pakistan, aus verschiedenen afrikanischen Ländern erreichten täglich Tausende die EU. Sie suchten dabei nicht mehr nur, wie lange Jahre zuvor, den gefährlichen Weg über das Mittelmeer, sondern kamen nun hauptsächlich über die Türkei, Griechenland und die Balkanroute."
                            },
                            {
                                "example_id": "64e10f43-53d7-4200-9366-db5bf718a83f",
                                "sense_id": "f0945423-149d-397f-9eca-811e1356c963",
                                "text": "Zehntausende Menschen sind immer noch trotz des Winterwetters auf der sogenannten Balkanroute unterwegs."
                            },
                            {
                                "example_id": "df802ad1-6073-4d22-b642-f6617ffbdd93",
                                "sense_id": "f0945423-149d-397f-9eca-811e1356c963",
                                "text": "Es gibt vier dominierende Drogenrouten: 1. für Kokain mit Zielland Spanien oder Frankreich die Atlantikroute, für Heroin 2. die Balkanroute, 3. die Route Libanon-Frankreich und 4. die zentralasiatisch-russische Route."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
