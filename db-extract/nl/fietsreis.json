                    {
                        "sense_id": "821761be-dbf4-3199-b380-ce89f45d9e97",
                        "entry_id": "0e5bbce3-2f5b-3e14-97c1-f459bd38e256",
                        "glosses": [
                            "een vakantie waarbij fietsen de belangrijkste activiteit is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fef897-569e-4a00-9b68-5b1dc37142ac",
                                "sense_id": "821761be-dbf4-3199-b380-ce89f45d9e97",
                                "text": "Cardoen houdt zijn zitje in de raad van bestuur. ‘Ik ga me ook nog wat bezighouden met onze bedrijfsgebouwen. Heel veel minder ga ik niet werken’, zegt hij. ‘Ik ga ook wel wat meer tijd maken. Om te gaan reizen bijvoorbeeld. Naar Vietnam. Een fietsreis.’"
                            },
                            {
                                "example_id": "874be8d6-da58-4428-802b-8e9ded506213",
                                "sense_id": "821761be-dbf4-3199-b380-ce89f45d9e97",
                                "text": "Begin mei liet Ankone Oldenzaal achter zich om te beginnen aan een fietsreis van onbepaalde duur en met onbekende bestemming."
                            },
                            {
                                "example_id": "07ccace9-264e-4f9f-8b20-f3ee1927a31a",
                                "sense_id": "821761be-dbf4-3199-b380-ce89f45d9e97",
                                "text": "Ellen en Elmar van Drunen fietsen al tien jaar samen. Ze reden overal op de wereld. Door Alaska, Tsjechië, Shangri-La in China, en in de sneeuw op de Pamir Highway in Tadzjikistan, op een dieet van yakboterthee en geitenbotjes. Maar dat waren korte reizen. In september verlieten ze huis en haard voor een fietsreis van twee jaar door Zuid- en Noord-Amerika."
                            }
                        ]
                    }
