    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "019a2aa8-6da6-30f8-a7e7-d60b4c8d7478",
                    "sense_definition": "Qui hésite, qui manque d'assurance ou qui est incertain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a avancé d'un pas <w>hésitant</w> avant d'entrer dans la salle de classe.",
                            "target_lang_translations": {
                                "en": "He took a <w>hesitant</w> step before entering the classroom.",
                                "ru": "Он сделал <w>нерешительный</w> шаг вперёд, прежде чем войти в класс.",
                                "de": "Er machte einen <w>zögernden</w> Schritt nach vorn, bevor er das Klassenzimmer betrat.",
                                "es": "Avanzó un paso <w>vacilante</w> antes de entrar en el aula.",
                                "zh": "他迈着<w>犹豫</w>的步子，才走进教室。"
                            }
                        },
                        {
                            "text": "Elle a répondu d'une voix <w>hésitante</w> sans oser regarder son interlocuteur dans les yeux.",
                            "target_lang_translations": {
                                "en": "She answered in a <w>hesitant</w> voice, without daring to look the person she was speaking to in the eye.",
                                "ru": "Она ответила <w>неуверенным</w> голосом, не решаясь взглянуть собеседнику в глаза.",
                                "de": "Sie antwortete mit <w>unsicherer</w> Stimme, ohne sich zu trauen, ihrem Gesprächspartner in die Augen zu sehen.",
                                "es": "Respondió con voz <w>titubeante</w>, sin atreverse a mirar a los ojos a su interlocutor.",
                                "zh": "她用<w>迟疑</w>的声音回答，不敢直视对方的眼睛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indécis",
                        "incertain",
                        "irrésolu"
                    ],
                    "antonyms": [
                        "décidé",
                        "résolu",
                        "sûr"
                    ],
                    "common_phrases": [
                        "d'un pas hésitant",
                        "d'une voix hésitante"
                    ],
                    "target_lang_definitions": {
                        "en": "Unsure of oneself or of what to do; lacking confidence or certainty.",
                        "ru": "Неуверенный в себе, не решающийся действовать или сомневающийся в своих действиях.",
                        "de": "Ohne Selbstvertrauen oder Gewissheit, zögernd im Handeln oder Sprechen. Wirkt unentschlossen und zurückhaltend.",
                        "es": "Que duda o vacila al actuar o al hablar, por falta de seguridad o de decisión.",
                        "zh": "形容做事或说话时犹豫不决、缺乏自信或拿不准的样子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hesitant",
                                "target_lang_sense_clarification": "showing doubt before acting"
                            },
