                        "translation_id": "f9d4a594-4aac-4158-97ee-ee9ef262ed0b",
                        "source_entry_id": "d72ac73b-c0f5-38d6-b88d-2097cc5cf158",
                        "source_sense_id": "49974ddb-adcc-3f5d-8679-70c76e9b56a4",
