                "senses": [
                    {
                        "sense_id": "3be834f3-54f8-371e-9132-7243cc6ce912",
                        "entry_id": "093d7cb5-219b-3e25-b3e4-df49e34322a9",
                        "glosses": [
                            "(auf jemanden abgeschossene) große Menge dicht beieinander fliegender/niedergehender Pfeile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61149825-f07c-4670-97dd-875ecd21b7b0",
                                "sense_id": "3be834f3-54f8-371e-9132-7243cc6ce912",
                                "text": "„Jedes englische Schulkind lernt, wie die Schlachten von Agincourt und Crecy durch den Pfeilhagel der langen Bogen entschieden wurden.“"
                            },
                            {
                                "example_id": "054375b2-1113-4762-9b33-9144338134c3",
                                "sense_id": "3be834f3-54f8-371e-9132-7243cc6ce912",
                                "text": "„[Der Bielefelder Althistoriker Raimund Schulz] hält die Schilderung von Herodot, nach der die Griechen [in der Schlacht bei Marathon] die acht Stadien (1200 Meter) bis zur persischen Front im Laufschritt durchmessen haben sollen, im Kern für zutreffend. Ziel sei es gewesen, den gefürchteten Pfeilhagel des Gegners zu unterlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
