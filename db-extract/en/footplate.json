    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                "word": "footplate",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "95f58b75-7804-4acb-9f76-87be5fc395f9",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "tags": [
                            "plural"
                        ],
                        "form": "footplates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6892738b-d672-3864-9337-fa8339d13dda",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "The metal plate which forms the base platform of a steam locomotive and supports the boiler and the driver's cab, particularly in the United Kingdom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d3d602-3e74-4e6e-a3e9-f7399ebce8ef",
                                "sense_id": "6892738b-d672-3864-9337-fa8339d13dda",
                                "text": "Unlike the earlier standard designs, in which the whole of the footplate was on the engine, fall plates are re-introduced and these are hinged from the front of the tender to rest on the rearward extension of the cab floor."
                            },
                            {
                                "example_id": "bb61a94d-af95-4c04-90bc-310865466f81",
                                "sense_id": "6892738b-d672-3864-9337-fa8339d13dda",
                                "text": "All the same, nearly eight hours on the footplate covering a distance of 320 miles, with an ambient temperature of up to 103° for much of the time, proved an ordeal which I would not lightly undertake again."
                            },
                            {
                                "example_id": "d555e5b1-1715-4c4b-a129-53ef9ca64aa0",
                                "sense_id": "6892738b-d672-3864-9337-fa8339d13dda",
                                "text": "After a while we left the engine, but not before André had examined the 4-6-4 very carefully, with hammer and torch, both outside and underneath. And that was the end of my footplate work on this particular weekend."
                            },
                            {
                                "example_id": "666e1238-7242-46a7-86b5-f19bfa96b99b",
                                "sense_id": "6892738b-d672-3864-9337-fa8339d13dda",
                                "text": "This uncoupling done, Gimbert opened the regulator as Nightall climbed back onto the footplate, in order to pull the one burning wagon away from the rest of the bomb-laden train."
                            }
                        ]
                    },
                    {
                        "sense_id": "47205fd1-9ffd-351f-9c28-19cd822ebb3b",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "The engineer's cab in any kind of train."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e936e4c6-f438-432c-b946-54591d3387e2",
                                "sense_id": "47205fd1-9ffd-351f-9c28-19cd822ebb3b",
                                "text": "Kit had fallen into conversation with a footplate man who was deadheading back out to Samarkand, where he lived with his wife and children."
                            }
                        ]
                    },
                    {
                        "sense_id": "adc90686-0c49-3f0b-9b21-8e704d6028fd",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "The flat portion at the base of the stapes; pedicel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91fcfa67-568c-410d-b7b6-500799dd5579",
                                "sense_id": "adc90686-0c49-3f0b-9b21-8e704d6028fd",
                                "text": "The footplate of the stapes develops and ossifies in conjunction with the otic capsule and thus takes its origin from the otic placode in the embryo."
                            }
                        ]
                    },
                    {
                        "sense_id": "057c83c4-4df7-3c2d-aa90-e8d9be9db065",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "The part of a roller skate that attaches to the boot."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9ac48519-538f-3d19-b5c4-0586e239cc0e",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "A timber in a wood frame that distributes a concentrated load."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5dd11e19-fba1-3334-9927-00d44ee5186c",
                        "entry_id": "f07d396e-9e32-301c-a85c-47ac25e53109",
                        "glosses": [
                            "A platform on which the driver's foot rests but which, unlike a pedal, has no effect."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
