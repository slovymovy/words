                        "glosses": [
                            "Gris avec une nuance verte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50a2097-2ef6-4f28-ae56-634a6e9d7deb",
                                "sense_id": "a1f187d8-8613-3440-b90d-a9bd8075f97d",
                                "text": "L’humidité, qui recouvrait de mousse toute chose, encerclait les branches de plantes grimpantes, emplumait les crevasses et les fourches audessus de ma tête ; l’écorce tombant par plaques, hirsute sous le lichen, habillait les troncs comme du métal vert-de-grisé, emplissait le sousbois incliné d’une lumière théâtrale, gris-vert."
                            },
                            {
                                "example_id": "22a6ea7e-e2b0-4aae-9de5-b937faddb988",
                                "sense_id": "a1f187d8-8613-3440-b90d-a9bd8075f97d",
                                "text": "Je suis ensuite entré dans le dur du protocole médical, avec des doses lourdes pour pilonner la tumeur et ne lui laisser aucune chance, puis me suis retrouvé gris-vert, sans plus un poil sur le visage."
                            }
                        ]
                    }
