                        "glosses": [
                            "Parkplatz, der zu einem Restaurant gehört, von Kunden eines Restaurants genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1324def5-0dc4-4401-98e6-d9990886c4c2",
                                "sense_id": "63a3c817-aa71-3951-a44c-c5738a47f61d",
                                "text": "„Sie stellt den Wagen am hintersten Ende des Restaurantparkplatzes ab, wo Michael J. am unwahrscheinlichsten Aufmerksamkeit erregen wird, und Libby verspricht, ihm etwas Leckeres mitzubringen.“"
                            },
                            {
                                "example_id": "a2697ad5-58a9-4568-939c-e87c98801deb",
                                "sense_id": "63a3c817-aa71-3951-a44c-c5738a47f61d",
                                "text": "„Der alte Kauz von MGM mit dem autoklauenden Enkel, ein netter Junge, der Cabrios von Restaurantparkplätzen klaute, damit auf der Mulholland herumraste und stets seine Visitenkarte hinterließ - einen großen Haufen Scheiße auf dem Rücksitz.“"
                            }
                        ],
