                                "target_senses": [
                                    {
                                        "sense_id": "61d91794-e9cd-3bc7-ba15-033a745a5ae0",
                                        "entry_id": "e099ce6d-d0ed-3e4b-9c33-cf7dae8ef632",
                                        "glosses": [
