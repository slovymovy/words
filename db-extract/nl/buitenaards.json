                "senses": [
                    {
                        "sense_id": "38003dc4-95d2-3a4d-8b03-2e64a1fdaac7",
                        "entry_id": "0352d27b-7875-3dc7-81ab-2c73a26125e2",
                        "glosses": [
                            "zijn oorsprong buiten onze planeet hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c36f80b-58fb-4077-9c7b-dc767d44d42b",
                                "sense_id": "38003dc4-95d2-3a4d-8b03-2e64a1fdaac7",
                                "text": "Sommigen zien in de goden van de mythologie buitenaardse wezens die onze planeer bezocht hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "964b527d-055d-384b-8678-fa68d5f9e770",
                        "entry_id": "0352d27b-7875-3dc7-81ab-2c73a26125e2",
                        "glosses": [
                            "bovennatuurlijk, toverachtig, sprookjesachtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "087801c7-9bb8-4c1e-91d2-6c6213800d67",
                                "sense_id": "964b527d-055d-384b-8678-fa68d5f9e770",
                                "text": "Ik keek. De gestrenge gevels met de arcades stuurden de blik met majesteitelijk gezag in de richting van de basiliek van San Marco, die met haar koepels en ronde vormen een bubbelend en bijna buitenaards contrast vormde met het wereldse machtsvertoon van het plein."
                            }
                        ]
                    }
                ],
