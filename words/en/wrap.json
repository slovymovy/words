{
    "word_family": [
        "wrapper",
        "wrapping",
        "wraparound",
        "unwrap"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9f20e83-a59e-35f5-b867-a6420eb8cab4",
                    "sense_definition": "To enclose an object completely in any flexible, thin material such as fabric or paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>wrap</w> the birthday present in colorful paper.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>завернуть</w> подарок на день рождения в цветную бумагу.",
                                "zh": "她决定用彩纸把生日礼物<w>包</w>起来。"
                            }
                        },
                        {
                            "text": "Please <w>wrap</w> the leftover cheese in foil to keep it fresh.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>заверни</w> оставшийся сыр в фольгу, чтобы он оставался свежим.",
                                "zh": "请用锡纸把剩下的奶酪<w>包</w>好以保持新鲜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop",
                        "enfold",
                        "cover"
                    ],
                    "antonyms": [
                        "unwrap"
                    ],
                    "common_phrases": [
                        "wrap a gift",
                        "wrap in paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обернуть предмет полностью гибким материалом, например тканью или бумагой.",
                        "zh": "用柔软的材料（如纸或布）将物体完全包起来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заворачивать",
                                "target_lang_sense_clarification": "упаковывать во что-либо (несов. вид)"
                            },
                            {
                                "target_lang_word": "завернуть",
                                "target_lang_sense_clarification": "упаковать во что-либо (сов. вид)"
                            },
                            {
                                "target_lang_word": "упаковывать",
                                "target_lang_sense_clarification": "делать упаковку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包裹",
                                "target_lang_sense_clarification": "用纸或布等物包住"
                            },
                            {
                                "target_lang_word": "包装",
                                "target_lang_sense_clarification": "为商品或礼物进行包装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6010d85b-e803-395b-94e7-c639d4b7b6d0",
                    "sense_definition": "To enclose, wind, or coil something around an object or person.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake began to <w>wrap</w> itself tightly around the tree branch.",
                            "target_lang_translations": {
                                "ru": "Змея начала плотно <w>обвиваться</w> вокруг ветки дерева.",
                                "zh": "蛇开始紧紧地<w>缠绕</w>在树枝上。"
                            }
                        },
                        {
                            "text": "He had to <w>wrap</w> a thick scarf around his neck to stay warm.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>обмотать</w> толстый шарф вокруг шеи, чтобы согреться.",
                                "zh": "他不得不围上一条厚围巾来<w>裹</w>住脖子以保暖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wind",
                        "cover",
                        "enfold"
                    ],
                    "common_phrases": [
                        "wrap around",
                        "wrap arms around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обернуть, намотать или обвить что-либо вокруг объекта или человека.",
                        "zh": "将某物缠绕或盘绕在物体或人身上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обматывать",
                                "target_lang_sense_clarification": "наматывать вокруг чего-либо"
                            },
                            {
                                "target_lang_word": "обвивать",
                                "target_lang_sense_clarification": "окружать, виться вокруг"
                            },
                            {
                                "target_lang_word": "кутаться",
                                "target_lang_sense_clarification": "плотно оборачивать себя одеждой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缠绕",
                                "target_lang_sense_clarification": "盘绕在某物上"
                            },
                            {
                                "target_lang_word": "裹",
                                "target_lang_sense_clarification": "用衣物等包住身体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9293dfb-19a9-32ed-9eca-dbe4bd989fd4",
                    "sense_definition": "To finish filming a video, television show, or movie; to conclude an event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director shouted to <w>wrap</w> the scene so everyone could go to lunch.",
                            "target_lang_translations": {
                                "ru": "Режиссер крикнул <w>заканчивать</w> сцену, чтобы все могли пойти на обед.",
                                "zh": "导演喊了一声<w>收工</w>，大家便去吃午饭了。"
                            }
                        },
                        {
                            "text": "We need to <w>wrap</w> this meeting by five o'clock.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>завершить</w> это собрание к пяти часам.",
                                "zh": "我们需要在五点前<w>结束</w>这次会议。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrap up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the film industry or informal business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закончить съемку видео, телешоу или фильма; завершить мероприятие.",
                        "zh": "结束视频、电视节目或电影的拍摄；完成某项活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "доводить до конца"
                            },
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "оканчивать процесс"
                            },
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "разг. прекращать деятельность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "完成某项工作或活动"
                            },
                            {
                                "target_lang_word": "收工",
                                "target_lang_sense_clarification": "指拍摄工作结束"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "468c1eca-2728-36c4-993d-699b874f5049",
                    "sense_definition": "A type of food consisting of various ingredients rolled inside a tortilla or flatbread.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a spicy chicken <w>wrap</w> and a salad for lunch.",
                            "target_lang_translations": {
                                "ru": "Я заказал острый куриный <w>ролл</w> и салат на обед.",
                                "zh": "我午餐点了一个香辣鸡肉<w>卷饼</w>和一份沙拉。"
                            }
                        },
                        {
                            "text": "She prefers a veggie <w>wrap</w> because it is easier to eat on the go.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает овощной <w>ролл</w>, так как его удобнее есть на ходу.",
                                "zh": "她更喜欢蔬菜<w>卷饼</w>，因为这样在路上吃更方便。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chicken wrap",
                        "lettuce wrap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид еды, состоящий из различных ингредиентов, завернутых в тортилью или лаваш.",
                        "zh": "一种将各种配料卷在墨西哥薄饼或面饼里的食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ролл",
                                "target_lang_sense_clarification": "блюдо в лаваше"
                            },
                            {
                                "target_lang_word": "врап",
                                "target_lang_sense_clarification": "сэндвич-ролл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卷饼",
                                "target_lang_sense_clarification": "用面饼包裹馅料的食物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6718698a-68e3-33f5-8761-0a38b84eb026",
                    "sense_definition": "Paper or plastic sheeting used to cover, protect, or conceal something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remove the plastic <w>wrap</w> from the container before putting it in the microwave.",
                            "target_lang_translations": {
                                "ru": "Снимите пластиковую <w>пленку</w> с контейнера, прежде чем ставить его в микроволновку.",
                                "zh": "放入微波炉前，请先撕掉容器上的<w>保鲜膜</w>。"
                            }
                        },
                        {
                            "text": "We need to buy more bubble <w>wrap</w> to pack the fragile glasses.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить больше пузырчатой <w>пленки</w>, чтобы упаковать хрупкие бокалы.",
                                "zh": "我们需要买更多的气泡<w>包装纸</w>来打包易碎的玻璃杯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plastic wrap",
                        "bubble wrap",
                        "gift wrap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бумага или пластиковая пленка, используемая для покрытия, защиты или сокрытия чего-либо.",
                        "zh": "用于覆盖、保护或隐藏物体的纸张或塑料薄膜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пленка",
                                "target_lang_sense_clarification": "тонкое покрытие (пищевая, пузырчатая)"
                            },
                            {
                                "target_lang_word": "обертка",
                                "target_lang_sense_clarification": "упаковочный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保鲜膜",
                                "target_lang_sense_clarification": "用于包裹食物的塑料薄膜"
                            },
                            {
                                "target_lang_word": "包装纸",
                                "target_lang_sense_clarification": "用于包装礼物的纸张"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d892edc-0129-3a7c-a6ca-0bcf7536a0a5",
                    "sense_definition": "The completion or end of a performance, filming session, or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>wrap</w> for today, so everyone can go home now.",
                            "target_lang_translations": {
                                "ru": "На сегодня <w>всё</w>, так что все могут идти домой.",
                                "zh": "今天的工作就到这里<w>结束</w>了，大家现在可以回家了。"
                            }
                        },
                        {
                            "text": "After the <w>wrap</w>, the cast and crew went out to celebrate.",
                            "target_lang_translations": {
                                "ru": "После <w>окончания съемок</w> актеры и съемочная группа отправились праздновать.",
                                "zh": "拍摄<w>结束</w>后，演职人员一起出去庆祝了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "it's a wrap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in film/TV industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершение или конец выступления, съемочной сессии или мероприятия.",
                        "zh": "表演、拍摄过程或活动的结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "завершение процесса"
                            },
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "финал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "活动的终结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27a51bc2-3cfa-3138-a4bf-1f568b38a3a2",
                    "sense_definition": "A loose piece of clothing, such as a shawl or scarf, worn around the upper body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "coil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a silk <w>wrap</w> over her shoulders to keep the chill away.",
                            "target_lang_translations": {
                                "ru": "Она накинула на плечи шелковую <w>накидку</w>, чтобы защититься от холода.",
                                "zh": "她肩上披了一件丝绸<w>披肩</w>来抵御寒意。"
                            }
                        },
                        {
                            "text": "The elegant evening gown was paired with a matching velvet <w>wrap</w>.",
                            "target_lang_translations": {
                                "ru": "Элегантное вечернее платье дополняла подходящая бархатная <w>накидка</w>.",
                                "zh": "这件优雅的晚礼服搭配了一件相称的丝绒<w>披肩</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder wrap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный предмет одежды, такой как шаль или шарф, который носят на верхней части тела.",
                        "zh": "披在肩部或上身的宽松衣物，如披肩或围巾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накидка",
                                "target_lang_sense_clarification": "одежда на плечи"
                            },
                            {
                                "target_lang_word": "шаль",
                                "target_lang_sense_clarification": "большой платок"
                            },
                            {
                                "target_lang_word": "палантин",
                                "target_lang_sense_clarification": "широкий шарф"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "披肩",
                                "target_lang_sense_clarification": "披在肩上的装饰性衣物"
                            },
                            {
                                "target_lang_word": "围巾",
                                "target_lang_sense_clarification": "围在脖子上的保暖织物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}