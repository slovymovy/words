                                "example_id": "a48b8e91-5363-47f3-90a1-298a80c9dbc0",
                                "sense_id": "43f7cf2c-814f-36b2-b830-53825e31d1c5",
                                "text": "„‹Achaah›, sagte der General. Es war ein Urdu-Wort, das gleichermaßen Zustimmung oder Skepsis bedeuten konnte.“"
                            },
                            {
                                "example_id": "4daad41a-d488-4c47-a75b-5bf23ef7828e",
                                "sense_id": "43f7cf2c-814f-36b2-b830-53825e31d1c5",
                                "text": "„Er hatte jene mit Urdu-Wörtern durchsetzte Redeweise, die Sartaj im Lauf der Zeit einzuordnen gelernt hatte.“"
                            }
