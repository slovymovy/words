                "senses": [
                    {
                        "sense_id": "cc13d270-feb6-3805-9f7b-64d410983373",
                        "entry_id": "d60ded1b-e629-380e-8816-bf98355f9cab",
                        "glosses": [
                            "het honderdste deel van een euro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ed3231-c84f-4710-bd95-416919aa289b",
                                "sense_id": "cc13d270-feb6-3805-9f7b-64d410983373",
                                "text": "YouTube werpt tegen dat het met de meeste internationale auteursrechtenorganisaties deals heeft gesloten om een deel van de omzet af te dragen. Ook de Nederlandse auteursrechtenorganisatie Buma-Stemra sloot zo’n overeenkomst, maar heeft naar eigen zeggen een slechte onderhandelingspositie omdat YouTube wettelijk niet verplicht is één cent af te dragen voor de muziek die op het platform wordt geplaatst."
                            }
                        ]
                    },
                    {
                        "sense_id": "736bfd73-5cfa-32c8-8cdf-c2c46037d721",
                        "entry_id": "d60ded1b-e629-380e-8816-bf98355f9cab",
                        "glosses": [
                            "het honderdste deel van een gulden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f33ef3e4-a6d7-32e0-8df8-c3a0f64285cd",
                        "entry_id": "d60ded1b-e629-380e-8816-bf98355f9cab",
                        "glosses": [
                            "het honderdste deel van een dollar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6619963-3ab8-4b45-b433-f689965d9eb4",
                                "sense_id": "f33ef3e4-a6d7-32e0-8df8-c3a0f64285cd",
                                "text": "Zelfs een pakje noedels kon je kennelijk rauw eten, en hij wierp me een pak Indomie instant kipnoedels van 20 cent toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "f44b5046-cec9-3de0-81d1-5cf85a45034e",
                        "entry_id": "d60ded1b-e629-380e-8816-bf98355f9cab",
                        "glosses": [
                            "een duizendste logaritmisch deel van een octaaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ca5a51-481e-4fad-91d8-efe246e38469",
                                "sense_id": "f44b5046-cec9-3de0-81d1-5cf85a45034e",
                                "text": "Een gelijkzwevende kwint heeft een waarde van 700 cents en dat scheelt bijna twee cents met een natuurlijke reine kwint."
                            }
                        ]
                    }
                ],
