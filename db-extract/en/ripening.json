                    {
                        "translation_id": "1577e1cc-dff5-4f57-ac91-c5379d6b405e",
                        "source_entry_id": "cd5c44b6-01b5-3792-ae55-6562084c7e75",
                        "source_sense_id": "b4825824-f5bf-3c3b-a654-715b332b29e0",
