                ],
                "senses": [
                    {
                        "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                        "entry_id": "42a10ae7-25a6-3ee2-a66e-c66024638ccc",
                        "glosses": [
                            "Bedarf der Zufuhr von Wärme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20717c89-e646-494c-9b14-9f2dd1c9ade1",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "Wir müssen den Wärmebedarf von Häusern in Deutschland senken."
                            },
                            {
                                "example_id": "859c1eea-72d8-4728-989a-ae278e95cacd",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Der Anteil erneuerbare Energien zur Deckung des Wärmebedarfs in Deutschland steigt seit den 1990er Jahren fast kontinuierlich an“ […]."
                            },
                            {
                                "example_id": "a49d818c-d69b-4d98-a88d-6a405bc84cf0",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Wenn hohe solare Deckungsraten von 30 oder sogar 50 Prozent am Wärmebedarf erreicht werden sollen, muss die Solarwärme gespeichert werden.“"
                            },
                            {
                                "example_id": "e45afd78-0b91-4e30-9373-ca9c19add993",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "[Gebäude:] „Laut dem Energiekonzept der Bundesregierung von 2010 sollte der Wärmebedarf zwischen 2008 und 2020 um 20 % sinken. Er sank bis 2020 nur um 12 %.“"
                            },
                            {
                                "example_id": "41215bf5-3977-4424-a4a5-2c929e8807fc",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Bis 2050 können in Deutschland 65 Prozent des Stromverbrauchs und 50 Prozent des Wärmebedarfs aus erneuerbaren Energien bereitgestellt werden.“"
                            },
                            {
                                "example_id": "b3736085-0bdf-4a17-a174-4b228c734bcb",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Laut Studien könnte die Tiefengeothermie in Deutschland mit einer installierten Leistung von 70 GW rund 300 TWh/a Wärme erzeugen, das ist mehr als die Hälfte des zukünftigen Wärmebedarfs aller Gebäude.“"
                            },
                            {
                                "example_id": "c6f53bd6-ee04-4f6f-8bed-8fa9c127df1b",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Deutschland könnte bis zum Jahr 2045 seinen gesamten Wärmebedarf durch den Einsatz von Großwärmepumpen decken. So steht es in einer kürzlich veröffentlichten Studie vom Fraunhofer Institut für Energieinfrastrukturen und Geothermie.“"
                            },
                            {
                                "example_id": "c734e113-82bb-4be4-8965-b49c94d72ffd",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Je größer das Haus ist und je größer der Wärmebedarf, desto eher lohnt sich wirtschaftlich eine Erdwärmepumpe.“"
                            },
                            {
                                "example_id": "2ce619cc-b34d-43e0-a23a-b2f6566a2c2a",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "[Gebäudeheizung:] „Bei einem Wärmebedarf von 21.000 kWh pro Jahr braucht er rund 5000 kWh Strom für den Antrieb der Pumpe.“"
                            },
                            {
                                "example_id": "2aa64d76-8bc6-4fc7-82b9-3a9fc789528e",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "[Pelletheizungen:] „»Holz wird den Wärmebedarf in Deutschland bei weitem nicht decken können.«“"
                            },
                            {
                                "example_id": "a1442003-bada-419f-b3aa-38d5c31219fe",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Um den Wärmebedarf in Spitzenzeiten zu decken, wird nach wie vor rund 10 Prozent der Energie mit Gas produziert.“"
                            },
                            {
                                "example_id": "d8ee8179-80c3-42c4-9076-1c11fee9e321",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Die Studie hält fest, «dass das Potenzial des Vierwaldstättersees für Heizen deutlich über dem realistischen Wärmebedarf liegt.»“"
                            },
                            {
                                "example_id": "239b1943-0488-4bd7-8d62-038936b100e7",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Neu wird in der Anlage der Klärschlamm aus dem ganzen Kanton zentral verbrannt und daraus Energie gewonnen. So stammt der gesamte Wärmebedarf auf dem Areal aus der Anlage.“"
                            },
                            {
                                "example_id": "f535b5e8-1ce6-4204-9ef3-d65dc4ddeb17",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Aufgrund der Notwendigkeit der Einspeisung in ein Fernwärmenetz liegen Heizkraftwerke in der Nähe von städtischen Verdichtungsräumen oder Industrieanlagen mit hohem Wärmebedarf.“"
                            },
                            {
                                "example_id": "1b424582-10c1-4b9d-a37e-087efe6d9ab5",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "[Heizkurve:] „Die Steilheit hängt vom verwendeten Heizungssystem und dem Wärmebedarf der Räume ab.“"
                            },
                            {
                                "example_id": "69ddd1b7-9b13-442a-8a83-cc393cae0fc3",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Durch strengere Energiesparverordnungen ist in Zukunft im Gebäudebereich wegen besserer Wärmedämmaßnahmen [Anmerkung: korrekt wäre 'Wärmedämmmaßnahmen'] mir sinkenden Wärmebedarfen zu rechnen.“"
                            },
                            {
                                "example_id": "f3209e68-d930-4681-9463-fb6ab1875803",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Es werden 3 Basisszenarien (Öl-. Pellet- und Stückholzheizung) und 5 Brennstoffszenarien, siehe Tabelle 5.2, für 5 verschiedene Wärmebedarfe, siehe Tabelle 5.1, berechnet.“"
                            },
                            {
                                "example_id": "e7ad651c-2c51-4be0-b267-cded33a659e9",
                                "sense_id": "aa0de47a-cff5-364c-8bc7-e916ec1e6b25",
                                "text": "„Daunendecken sind besonders warm, kuschelig und leicht und damit besonders geeignet für Schläfer, die eher zum Frieren neigen und darum einen höheren Wärmebedarf haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
