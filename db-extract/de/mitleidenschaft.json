                        "entry_id": "920fbb85-b72a-3cc7-9fd6-aac90fd78a79",
                        "glosses": [
                            "Fähigkeit oder Vorgang, Anteil an einem Schaden, den jemand oder etwas erleidet, zu nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "677952b9-c6b2-4156-ad72-ad7e5d48476b",
                                "sense_id": "0f29373f-999a-30f7-9a2b-5512ec3cb3fb",
                                "text": "Das Feuer brach im Wohnzimmer aus und zog die gesamte Wohnung in Mitleidenschaft."
                            },
                            {
                                "example_id": "75430082-8da6-47ff-be4f-1925b1ce9daf",
                                "sense_id": "0f29373f-999a-30f7-9a2b-5512ec3cb3fb",
                                "text": "„Sie hat aber alles zu tun mit einer biblischen Mystik der Gerechtigkeit: Gottesleidenschaft als Mitleidenschaft, als praktische Mystik der Compassion.“"
                            }
                        ],
