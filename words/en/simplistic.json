{
    "word_family": [
        "simple",
        "simplicity",
        "simplify",
        "simplification",
        "simplistically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "232193d1-2d3a-31c3-95a5-2430a0587c7d",
                    "sense_definition": "Treating complex issues and problems as if they were much simpler than they really are, often by ignoring important details.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oversimplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician offered a <w>simplistic</w> solution to the economic crisis that failed to address the underlying causes.",
                            "target_lang_translations": {
                                "ru": "Политик предложил <w>упрощенное</w> решение экономического кризиса, которое не учитывало глубинные причины."
                            }
                        },
                        {
                            "text": "We must avoid <w>simplistic</w> answers and stick with the science when dealing with public health issues.",
                            "target_lang_translations": {
                                "ru": "Мы должны избегать <w>примитивных</w> ответов и придерживаться науки при решении вопросов общественного здравоохранения."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversimplified",
                        "reductive",
                        "shallow",
                        "superficial"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "complex",
                        "nuanced",
                        "detailed"
                    ],
                    "common_phrases": [
                        "simplistic solution",
                        "simplistic view",
                        "simplistic approach",
                        "simplistic explanation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассмотрение сложных вопросов и проблем так, будто они намного проще, чем есть на самом деле, часто за счет игнорирования важных деталей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрощенный",
                                "target_lang_sense_clarification": "слишком простой, не учитывающий детали"
                            },
                            {
                                "target_lang_word": "примитивный",
                                "target_lang_sense_clarification": "поверхностный и необоснованно простой"
                            },
                            {
                                "target_lang_word": "поверхностный",
                                "target_lang_sense_clarification": "не затрагивающий сути проблемы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ca65262-7522-300c-8860-517f9764ec66",
                    "sense_definition": "Characterized by extreme or excessive simplicity; lacking the necessary depth or sophistication.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "oversimplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics argued that the movie's plot was far too <w>simplistic</w> for such a serious historical subject.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что сюжет фильма был слишком <w>поверхностным</w> для такой серьезной исторической темы."
                            }
                        },
                        {
                            "text": "It is worth taking the <w>simplistic</w> claims of some health books with a pinch of salt.",
                            "target_lang_translations": {
                                "ru": "Стоит относиться к <w>наивным</w> утверждениям некоторых книг о здоровье с долей скептицизма."
                            }
                        }
                    ],
                    "synonyms": [
                        "naive",
                        "facile",
                        "jejune"
                    ],
                    "antonyms": [
                        "comprehensive",
                        "profound",
                        "intricate"
                    ],
                    "common_phrases": [
                        "simplistic claims",
                        "simplistic method",
                        "simplistic interpretation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся крайней или чрезмерной простотой; лишенный необходимой глубины или сложности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "чрезмерно простой и неопытный"
                            },
                            {
                                "target_lang_word": "упрощенческий",
                                "target_lang_sense_clarification": "склонный к излишнему упрощению"
                            },
                            {
                                "target_lang_word": "примитивный",
                                "target_lang_sense_clarification": "недостаточно глубокий или сложный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}