                        "entry_id": "c1b9c633-d1cc-30c3-87e5-4328b9064509",
                        "glosses": [
                            "The science of authenticating, dating, and interpreting old official documents."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "730614cc-5e58-497a-9bf5-36a6af58c9fb",
                                "sense_id": "f6b0577c-7ab9-39ef-a044-40c0d7410c60",
                                "text": "Paleography might teach men to read documents, diplomatics to date them and to test their authenticity; but the full significance of an ancient deed might easily escape the most exact paleographer and the most accomplished diplomatist, for the want of that finished sense for legal technicality which is the natural fruit of a conveyancing practice."
                            }
                        ]
                    }
