                                        "sense_id": "712c56ab-f0ef-3589-b456-98103db5669b",
                                        "entry_id": "44e8141c-a1bf-3ca1-a2f3-6fca9466ab1d",
                                        "glosses": [
                                            "Alternative letter-case form of valentine."
