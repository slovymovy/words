                ],
                "senses": [
                    {
                        "sense_id": "84033364-4726-3de4-a0e8-161dc85ab2ce",
                        "entry_id": "c6c27c93-0572-3f35-b4ec-149741f18d98",
                        "glosses": [
                            "pisarz, autor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d3e6a32-0f44-49eb-a2a5-b6b3ac670299",
                                "sense_id": "84033364-4726-3de4-a0e8-161dc85ab2ce",
                                "text": "Po pewnym czasie sekretarz propagandy Komitetu Wojewódzkiego wezwał mnie do siebie na dywanik i dał mi ostrą reprymendę, że po pierwsze – rozpowszechniam nielegalną literaturę, po drugie – zatruwam młode umysły początkujących literatów miazmatami wrogiego imperializmu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2ef7ce99-fcab-38ad-b78e-0a13f16e7925",
                        "entry_id": "c6c27c93-0572-3f35-b4ec-149741f18d98",
                        "glosses": [
                            "student wydziału filologicznego, studiujący historię literatury"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1f7b1807-d6f4-3839-bc91-9d19ffac2f63",
                        "entry_id": "c6c27c93-0572-3f35-b4ec-149741f18d98",
                        "glosses": [
                            "człowiek oczytany, uczony"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cdebfb0-108f-4e39-8266-48512ec95e68",
                        "source_entry_id": "c6c27c93-0572-3f35-b4ec-149741f18d98",
                        "source_sense_id": "84033364-4726-3de4-a0e8-161dc85ab2ce",
                        "target_lang_word": "литератор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "литератор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a14b4fa9-5ea1-3c0b-ac12-939fff55e583",
                                        "entry_id": "2a27f8b3-7813-360a-b4ae-e291a1afbe05",
                                        "glosses": [
                                            "писатель, человек профессионально занимающийся литературным трудом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8024a2a9-019b-4f50-ac68-542f14948564",
                                                "sense_id": "a14b4fa9-5ea1-3c0b-ac12-939fff55e583",
                                                "text": "Я — русский литератор и потому имею две рабские привычки: во-первых, писать иносказательно и, во-вторых, трепетать."
                                            },
                                            {
                                                "example_id": "7e6c7cac-683a-4f88-b57d-3ce9984ab50e",
                                                "sense_id": "a14b4fa9-5ea1-3c0b-ac12-939fff55e583",
                                                "text": "Мне сдаётся, что ты мог бы сделаться литератором, только я наверное знаю, что у тебя есть призвание лучше и выше литературы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
