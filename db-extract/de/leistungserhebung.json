                "senses": [
                    {
                        "sense_id": "25db54d4-c3fc-3094-9f5b-cedc793dc51a",
                        "entry_id": "f4369c0e-7fc1-3f85-a2bf-0956ad193b9f",
                        "glosses": [
                            "Feststellung der Leistungsfähigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f6a594-e7e0-41c3-970b-db2e49e6a0cb",
                                "sense_id": "25db54d4-c3fc-3094-9f5b-cedc793dc51a",
                                "text": "„Er habe daher eine neuerliche Leistungserhebung in der Sonderkrankenanstalt Z durch den Primarius Dr. W veranlasst.“"
                            },
                            {
                                "example_id": "b55759d2-817e-437e-82b9-5cb921adb19b",
                                "sense_id": "25db54d4-c3fc-3094-9f5b-cedc793dc51a",
                                "text": "„Zeugnisse und Prüfungen, die üblichen Formen der schulischen Leistungserhebung, gab es zwar auch am Ende des vergangenen Schuljahres.“"
                            },
                            {
                                "example_id": "5788d916-5182-4358-8bb0-459f8b60f943",
                                "sense_id": "25db54d4-c3fc-3094-9f5b-cedc793dc51a",
                                "text": "„So war es vor zehn Jahren geradezu ein Schock, als eine breite Leistungserhebung in acht Kantonen zeigte, dass es tatsächlich Kinder gibt, die bei Schuleintritt bereits lesen oder rechnen können, manchmal sogar beides, und die damit dem Schulstoff ein ganzes Jahr voraus sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
