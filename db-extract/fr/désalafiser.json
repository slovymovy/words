                        "glosses": [
                            "Faire perdre son caractère wahhabiste (à quelqu’un ou quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69307e3b-5dda-4547-8ce6-aed5bab16c54",
                                "sense_id": "2ff634ff-9b31-3efa-a78e-d20d843b3a0c",
                                "text": "Le célèbre et controversé imam de Brest retourne à l'université, en vue de se \"désalafiser\"."
                            },
                            {
                                "example_id": "7181f465-fa4d-450c-ac89-68e1735a9e01",
                                "sense_id": "2ff634ff-9b31-3efa-a78e-d20d843b3a0c",
                                "text": "Le Qatar veut se « désalafiser »."
                            },
                            {
                                "example_id": "9f03c250-20b9-4992-9ffb-b017c2c28c42",
                                "sense_id": "2ff634ff-9b31-3efa-a78e-d20d843b3a0c",
                                "text": "Désalafiser, déwahhabiser le monde comme autrefois la déstalinisation, la dénazification, etc., et traquer aussi les sympathisants et les avocats."
                            }
                        ]
                    }
