                        "glosses": [
                            "Hotel, das von einer Hotelkette betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596ba8e3-6550-49c6-b572-f2a439d1dc8b",
                                "sense_id": "ec7888ae-42c5-3496-a313-1c5c30b4787a",
                                "text": "„Die Idee, dass dieser märchenhaft reiche, in Paris groß gewordene Inbegriff eines weltmännischen Europäers ausgerechnet in einem Kettenhotel hinterm Hauptbahnhof sein Quartier aufschlagen sollte, ist natürlich lachhaft.“"
                            },
                            {
                                "example_id": "344a3b92-c447-48a5-954b-a7aa01b01047",
                                "sense_id": "ec7888ae-42c5-3496-a313-1c5c30b4787a",
                                "text": "„Nach dem Spaziergang sehnt man sich fast nach einer reinweißen Decke in einem etwas zu beigefarbenen Kettenhotel, nur zur Entspannung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
