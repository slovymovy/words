                                ]
                            },
                            {
                                "target_word": "scoff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8fbbba3-cbbe-3688-bcf8-234d0770a633",
                                        "entry_id": "ada9d929-c002-3600-8a1c-cc8e7ddccc0b",
                                        "glosses": [
                                            "To eat food quickly."
                                        ],
                                        "tags": [
