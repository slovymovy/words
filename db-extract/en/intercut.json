                        "entry_id": "f5e39827-ee8f-31ef-b984-ae8f8a5449aa",
                        "glosses": [
                            "To alternate between scenes from one sequence and scenes from another film sequence, often with the sequences to be perceived as simultaneous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67205318-91d3-48d6-9db5-0111c3544cd8",
                                "sense_id": "a3103ed3-c3bd-3aec-9c24-6d1c516915d7",
                                "text": "The film's plot revolves around Robert Adams […] whose older lover […] is in prison. He knows that he cannot send the love letters he wants to, so he writes and keeps them in a journal. Most of the film features voice-overs of his writing intercut with the memories of their life together."
                            }
                        ]
                    }
