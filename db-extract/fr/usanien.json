                                        "entry_id": "79f0b419-c2c0-32aa-b623-92ae2e47add3",
                                        "glosses": [
                                            "Of or pertaining to the United States of America."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c98d91f-b361-4965-b52a-11ce748947c7",
                                                "sense_id": "9eab19a1-c8a4-3f0d-afc7-1578f0966763",
                                                "text": "In addition to a detailed analysis of the growth of 5 USAnian cities of metropolitan proportians—Boston, New York, Philadelphia, Chicago and Los Angeles— […]"
                                            },
                                            {
                                                "example_id": "70bcb43c-5203-436d-b1e5-83a826723fdd",
                                                "sense_id": "9eab19a1-c8a4-3f0d-afc7-1578f0966763",
                                                "text": "The fundamental principle of this fundamental Usanian document is that the sovereign citizens of separate governments establish a federal government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Usanian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d23a1a2-5e96-3971-a4da-477b3ebb52e8",
                                        "entry_id": "baca4713-a677-337a-ad41-988651e8da1a",
                                        "glosses": [
                                            "An inhabitant or citizen of the United States of America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb7294d-097d-4a1d-a0e5-0b68a38c4101",
                                                "sense_id": "8d23a1a2-5e96-3971-a4da-477b3ebb52e8",
                                                "text": "I remember Juan Trippe arriving at Croydon from Paris in a Handley Page Hercules, at which that great pseudo-Usanian Cy Caldwell had thrown the jeer that it embodied “ built-in head winds.”"
                                            },
                                            {
                                                "example_id": "8fddf6e7-7eaf-490d-9da1-c69c0f1b173a",
                                                "sense_id": "8d23a1a2-5e96-3971-a4da-477b3ebb52e8",
                                                "text": "Like Usanians in the last half of the 20c, Japanese in the middle part of the Tokugawa Era often exhibited a smug sense of superiority vis-à-vis foreign countries"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
