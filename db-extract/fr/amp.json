                    {
                        "sense_id": "2995a782-f881-3080-b89a-59500ae88a43",
                        "entry_id": "dc26acf3-c645-3598-b7fd-d75716fbc7e0",
                        "glosses": [
                            "Abréviation d’aide médico-psychologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370c1852-e2d6-46fb-bf0f-482749a5a5e8",
                                "sense_id": "2995a782-f881-3080-b89a-59500ae88a43",
                                "text": "L’aide médico-psychologique (AMP) intervient auprès de personnes jeunes ou adultes ayant un handicap physique ou mental important."
                            },
                            {
                                "example_id": "798575dd-c0b4-4ac6-a4a4-766e39dc51c9",
                                "sense_id": "2995a782-f881-3080-b89a-59500ae88a43",
                                "text": "« Nous faisons le point sur les personnes dont nous nous occupons. La plupart du temps, nous sommes deux ou trois du réseau à se relayer sur une même personne », précise Florence Alquinet, une autre AMP."
                            }
                        ]
                    }
