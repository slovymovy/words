                                "example_id": "d254b20d-a386-4b7d-93dd-8bf38e8e3b03",
                                "sense_id": "26850ca4-c5e2-3c57-b28f-ab252ddffb51",
                                "text": "Le capitalisme se sert des autres rapports de domination pour péjorer le sien propre."
                            }
                        ]
