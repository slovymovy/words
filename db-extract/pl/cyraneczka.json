                    {
                        "translation_id": "24bf5866-2154-46df-ba43-adc3f1d553e6",
                        "source_entry_id": "1af06972-1d82-32f4-97e1-3d97f406c783",
                        "source_sense_id": "ecd5ad04-9902-3641-a2df-a438191a46ae",
                        "target_lang_word": "Krickente",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krickente",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                        "entry_id": "85a3092e-0879-3aed-a22c-51f2d24ffe2a",
                                        "glosses": [
                                            "kleine Wildente mit grau getüpfeltem Gefieder und braunem Kopf beim Erpel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa7cf3c-f7fa-471f-9f79-7f44ec128ea7",
                                                "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                                "text": "Bevorzugt sucht die Krickente an Uferzonen nach Futter."
                                            },
                                            {
                                                "example_id": "c1502cf6-2ff0-4122-9e17-2acb60d1e8f0",
                                                "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                                "text": "Die Krickente, einst die zweithäufigste Schwimmente in Österreich, ist mit weniger als 100 Brutpaaren stark gefährdet und wurde von Birdlife zum Vogel des Jahres 2025 ernannt."
                                            },
                                            {
                                                "example_id": "3665769f-a795-4e04-8db9-a052c567a6b1",
                                                "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                                "text": "Auch Auswirkungen des Klimawandels auf den Lebensraum der Krickente und dessen Qualität dürften zu einem Ausdünnen der Bestände am Südrand des Verbreitungsgebiets führen."
                                            },
                                            {
                                                "example_id": "a56ef9d3-93bb-47fc-8488-a9013b6976c8",
                                                "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                                "text": "Die Krickente mit ihrem auffällig hübschen Prachtkleid ist Europas kleinste Entenart."
                                            },
                                            {
                                                "example_id": "755476e3-a318-493d-b04f-83c10b8bbb69",
                                                "sense_id": "05be3ca4-b730-3857-bcbb-e33d9bd26c79",
                                                "text": "Krickenten wiegen zwischen 250 und 400 g, wobei die Männchen etwas schwerer als die Weibchen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
