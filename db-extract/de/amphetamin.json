                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60a8f81e-98b1-3e52-a9e7-8c0f231fbf34",
                                        "entry_id": "155dd3ed-c6cb-3907-939d-eeff69cc3021",
