                ],
                "senses": [
                    {
                        "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                        "entry_id": "d6ecb768-f0b9-3f42-99a5-582e189573ec",
                        "glosses": [
                            "vierfüßige Fortbewegungsart der Schimpansen und Gorillas, bei der die vorderen Gliedmaßen mit der Außenseite der mittleren Fingerglieder auf dem Boden aufsetzen"
                        ],
                        "tags": [
                            "Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "878b680e-61ea-414d-b83c-c349d69c8d4b",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Schimpansen hangeln in Bäumen akrobatisch von Ast zu Ast und laufen am Boden meist vierfüßig im Knöchelgang."
                            },
                            {
                                "example_id": "3467fdd5-485b-4025-ae52-77691a15de6b",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Der Knöchelgang der Schimpansen ist wohl erst jüngeren Datums."
                            },
                            {
                                "example_id": "9a6617e4-cff7-4627-b339-7c539562fd49",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Crompton und seine Kollegen folgern aus ihren Orang-Utan-Beobachtungen, dass der aufrechte Gang wesentlich älter ist als der sogenannte Knöchelgang von Gorillas und Schimpansen."
                            },
                            {
                                "example_id": "613b11f7-0221-4e6f-9288-190bcf2f37d7",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Bislang galt der Knöchelgang als Vorstufe zu unserem aufrechten Gang."
                            },
                            {
                                "example_id": "b989322c-0b5e-4398-abdf-87365c7b8362",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Nach Ansicht der Wissenschaftler deuten die grundsätzlichen Unterschiede nicht nur auf eine andere Lebensweise der heutigen Affen hin, sondern auch auf eine unabhängige Evolution der beiden Arten des Knöchelgangs."
                            },
                            {
                                "example_id": "ac9ba245-f768-4c50-a2db-26be7f1ef17f",
                                "sense_id": "717f438c-25e8-3f0a-8b8a-7007999e4da0",
                                "text": "Der „Knöchelgang“, wie er auch gerne genannt wird, ist deswegen auch kein echter Vierfüßergang, sondern vielmehr die Notfallvariante eines für die Fortbewegung am Boden zu groß geratenen Menschenaffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
