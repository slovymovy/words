                        "cross_references": [
                            {
                                "target_word": "ostfälisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9b0f58-d07a-3ba8-9391-981d26f95cdf",
                                        "entry_id": "330c576d-7236-3536-9259-e48ead53e8d3",
                                        "glosses": [
                                            "Ostfalen betreffend oder zugehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9163b709-fbcc-4b90-8f6f-c299608eb0e6",
                                                "sense_id": "7b9b0f58-d07a-3ba8-9391-981d26f95cdf",
                                                "text": "Ich habe ein ostfälisches Buch auf dem Speicher gefunden."
                                            },
                                            {
                                                "example_id": "0b3889fb-29be-4d15-9411-2bb9a1b3e888",
                                                "sense_id": "7b9b0f58-d07a-3ba8-9391-981d26f95cdf",
                                                "text": "„Die ostfälisch/nord[n]iederdeutsche Form ‚bringen‘ beruht auf altsächsisch ‚bringan‘ und geht mit dem Oberdeutschen zusammen.“"
                                            },
                                            {
                                                "example_id": "76c2a832-b353-4230-be26-c0d109157a13",
                                                "sense_id": "7b9b0f58-d07a-3ba8-9391-981d26f95cdf",
                                                "text": "„Die lübischen Rechtstexte waren jedenfalls bereits seit Ende des 13. Jh. sehr einheitlich […], stark nordniedersächsisch und ostfälisch geprägt.“"
                                            },
                                            {
                                                "example_id": "ee821314-d90b-40c0-a92b-673b34cf762c",
                                                "sense_id": "7b9b0f58-d07a-3ba8-9391-981d26f95cdf",
                                                "text": "„Der Querriegel Harz teilt den ostfälisch erdschweren Norden vom Mansfelder Land und dem Erfurter Becken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d20a33f-44ee-3cd1-994c-d50acb37e5d3",
                                        "entry_id": "330c576d-7236-3536-9259-e48ead53e8d3",
                                        "glosses": [
                                            "das Ostfälische betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c65746a-36ce-4610-8d52-cebb03435e4a",
                                                "sense_id": "5d20a33f-44ee-3cd1-994c-d50acb37e5d3",
                                                "text": "„Mitteldeutsche Einflüsse, vor allem aus dem südlich anschließenden Gebiet, haben seit Jahrhunderten ostfälische Elemente aus diesem und dem anschließenden Raum verdrängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
