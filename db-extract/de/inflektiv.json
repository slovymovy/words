                        "entry_id": "f415bfa0-f376-384e-909f-75f87d13428f",
                        "glosses": [
                            "A German verb form used to imitate a sound or to indicate that an action is occurring, formed from the verb stem without any personal ending."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "de9974c3-bfb9-4223-958d-157095a27427",
                                "sense_id": "6a1667b6-edfd-3b62-b552-b78878ef5614",
                                "text": "Es treten hier nur einfache Inflektive (*stotter*, *schock*), nicht Inflektivkonstruktionen auf (d. h. Verben in Kombination mit weiteren Satzgliedern wie bei aufderleitungsteh)."
                            }
                        ]
                    }
