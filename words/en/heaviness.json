{
    "word_family": [
        "heavy",
        "heavily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f7ce84f-b58c-3687-bbc5-a96e304708a8",
                    "sense_definition": "The state of having great weight or force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>heaviness</w> of the stone made it impossible for the child to lift.",
                            "target_lang_translations": {
                                "ru": "<w>Тяжесть</w> камня сделала невозможным для ребёнка поднять его."
                            }
                        },
                        {
                            "text": "Engineers calculated the <w>heaviness</w> of the steel beams to ensure the bridge was safe.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали <w>вес</w> стальных балок, чтобы убедиться в безопасности моста."
                            }
                        }
                    ],
                    "synonyms": [
                        "weight",
                        "weightiness"
                    ],
                    "antonyms": [
                        "lightness"
                    ],
                    "common_phrases": [
                        "excessive heaviness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние обладания большим весом или силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тя́жесть",
                                "target_lang_sense_clarification": "физический вес или свойство предмета быть тяжёлым"
                            },
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "мера тяжести объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                    "sense_definition": "A feeling of deep sadness or low spirits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>heaviness</w> in her heart after hearing the tragic news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапную <w>тяжесть на сердце</w> после того, как услышала трагические новости."
                            }
                        },
                        {
                            "text": "Despite the celebration, a lingering <w>heaviness</w> remained in his spirit.",
                            "target_lang_translations": {
                                "ru": "Несмотря на праздник, в его душе оставалась затяжная <w>тяжесть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sadness",
                        "dejection",
                        "gloom"
                    ],
                    "antonyms": [
                        "cheerfulness",
                        "joy"
                    ],
                    "common_phrases": [
                        "heaviness of heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокой печали или подавленного настроения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тя́жесть на се́рдце",
                                "target_lang_sense_clarification": "метафорическое описание гнетущего душевного состояния"
                            },
                            {
                                "target_lang_word": "тоска́",
                                "target_lang_sense_clarification": "чувство глубокой грусти или уныния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc32e0b5-3f74-3d5a-b4f2-088ec8a0b727",
                    "sense_definition": "The state of being sleepy or drowsy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>heaviness</w> in his eyelids made it difficult to stay awake during the lecture.",
                            "target_lang_translations": {
                                "ru": "<w>Сонливость</w> в веках мешала ему бодрствовать во время лекции."
                            }
                        },
                        {
                            "text": "A strange <w>heaviness</w> overcame her after the long and exhausting journey.",
                            "target_lang_translations": {
                                "ru": "Странная <w>сонливость</w> одолела её после долгого и утомительного путешествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "drowsiness",
                        "sleepiness"
                    ],
                    "antonyms": [
                        "alertness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is now largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сонливости или оцепенения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сонли́вость",
                                "target_lang_sense_clarification": "физическое состояние желания спать"
                            },
                            {
                                "target_lang_word": "оцепене́ние",
                                "target_lang_sense_clarification": "состояние потери бодрости и ясности сознания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}