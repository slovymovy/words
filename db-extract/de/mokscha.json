                ],
                "senses": [
                    {
                        "sense_id": "7a556de6-dd1f-37e5-bf49-50e44b6ce919",
                        "entry_id": "99789fce-5089-396f-b5ab-6b4d6fe25f9e",
                        "glosses": [
                            "Stamm der Mordwinen"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "158f0d0e-31ae-42b5-a621-045ceb73e97a",
                                "sense_id": "7a556de6-dd1f-37e5-bf49-50e44b6ce919",
                                "text": "„Die Menschen haben hier stets gejagt und das erlegte Wild landete dann auf den Tischen der Erzja und Mokscha.“"
                            },
                            {
                                "example_id": "2c2daf03-a702-49e2-81bb-08fd7c2c87ab",
                                "sense_id": "7a556de6-dd1f-37e5-bf49-50e44b6ce919",
                                "text": "„Die Mordwinen zerfallen in die vier Stämme: Ersa, Mokscha, Terjuchen und Karatajen, wobei die Sprachen der beiden Hauptgruppen Mokscha und Ersa gegenseitig nicht verständlich sind […].“"
                            },
                            {
                                "example_id": "28e1c9b3-efef-42e4-9b27-22456165a9b9",
                                "sense_id": "7a556de6-dd1f-37e5-bf49-50e44b6ce919",
                                "text": "„Ob jemand nun zu den Mokscha oder zu den Erza gezählt wird hängt eher davon ab, ob sich der Betreffende selbst für einen Erza oder für einen Mokscha hält!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8a125c5-9cb2-3009-afde-606f6eff8bbc",
                        "entry_id": "99789fce-5089-396f-b5ab-6b4d6fe25f9e",
                        "glosses": [
                            "einzelne Person vom Stamm der Mordwinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc05bba-c03a-45ea-a04c-8a9845fd5d4c",
                                "sense_id": "b8a125c5-9cb2-3009-afde-606f6eff8bbc",
                                "text": "„Ob jemand nun zu den Mokscha oder zu den Erza gezählt wird hängt eher davon ab, ob sich der Betreffende selbst für einen Erza oder für einen Mokscha hält!“"
                            },
                            {
                                "example_id": "b31d16c3-c313-4fcc-adf8-2cce64a6c0e4",
                                "sense_id": "b8a125c5-9cb2-3009-afde-606f6eff8bbc",
                                "text": "Er ist Mokscha."
                            },
                            {
                                "example_id": "0d3f7229-cf97-4320-bc4a-c52c91cac131",
                                "sense_id": "b8a125c5-9cb2-3009-afde-606f6eff8bbc",
                                "text": "„Der vornehmste Unterschied beider Stämme beruht in der Sprache: dieser ist so groſs, dass ein Ersa und ein Mokscha, von denen jeder die dem anderen Dialekt entfernteste Mundart des seinigen spricht, einander durchaus nicht verstehen und oft in russischer Sprache sich verständigen müssen.“"
                            },
                            {
                                "example_id": "f934e3f1-4964-4eeb-ad80-7ea0b0858a5a",
                                "sense_id": "b8a125c5-9cb2-3009-afde-606f6eff8bbc",
                                "text": "„Die Stube des Mokscha war ein Stadtzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
