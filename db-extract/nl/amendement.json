                        "glosses": [
                            "wijzigingsvoorstel van een volksvertegenwoordiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf81544-62ff-407e-8a94-611213f04ae0",
                                "sense_id": "1ac78ace-b61f-3951-8281-8dd4a4150d09",
                                "text": "Volgende vraag: ken je de stof voor het tentamen over het vierde amendement op vrijdag?' 'Grotendeels wel."
                            },
                            {
                                "example_id": "b46fe21d-e680-4f5c-8212-4359bbde47a2",
                                "sense_id": "1ac78ace-b61f-3951-8281-8dd4a4150d09",
                                "text": "Het amendement voorzag erin dat de ontginning van, en andere economische activiteiten betreffende natuurlijke hulpbronnen buiten de Kuipergordel moesten plaatsvinden onder auspiciën van de Verenigde Naties."
                            },
                            {
                                "example_id": "93762da5-8188-4f61-8f73-228a508c00f4",
                                "sense_id": "1ac78ace-b61f-3951-8281-8dd4a4150d09",
                                "text": "En hoewel Abraham Lincoln zelf op 15 april bij een moordaanslag om het leven kwam, bekrachtigde het Congres op 31 december 1865 zijn dertiende amendement."
                            },
                            {
                                "example_id": "b1e3d743-6f82-4eae-bb87-e4138d96f057",
                                "sense_id": "1ac78ace-b61f-3951-8281-8dd4a4150d09",
                                "text": "Aan een nieuwe veiligheidswet voegden rechtse politici een amendement toe dat hennep de facto gelijkstelt aan cannabis. De plant mag nog wel geteeld worden voor de vezels en de bladeren, maar de bloemen mogen niet meer verkocht worden. \"Economisch onhoudbaar\", noemt de Calabrese ondernemer Mattia Cusani dat."
                            }
                        ]
                    }
                ],
