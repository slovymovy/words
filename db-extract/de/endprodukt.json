                                "target_senses": [
                                    {
                                        "sense_id": "3c1fa3fb-6736-3464-a49d-34fe0ee2029b",
                                        "entry_id": "54138cc4-1a0a-393c-86cb-dc0020e50fcb",
                                        "glosses": [
                                            "A final product, especially one resulting from a series of stages or processes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce9057d-bdcb-4849-bb16-a56c11100bea",
                                                "sense_id": "3c1fa3fb-6736-3464-a49d-34fe0ee2029b",
                                                "text": "In the final reckoning, Spain paid the price for the Achilles heel that troubled them in the early stages of this competition, namely an inability to crown glorious passing and approach play with an end product."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22e5f423-d881-4f7a-9894-d3ab06be7124",
                        "source_entry_id": "d7347309-19df-3950-98e7-538c065e2ea4",
                        "source_sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
