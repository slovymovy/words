                "senses": [
                    {
                        "sense_id": "447d0bf5-1364-37d6-b380-1ccc1a1b10a7",
                        "entry_id": "745e3e39-d1e7-39b5-b7a8-cad7663c2ee3",
                        "glosses": [
                            "Zahl, von der geglaubt wird, dass sie Glück bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbbcd21-b9ba-4abf-8a76-b3523fb8fc91",
                                "sense_id": "447d0bf5-1364-37d6-b380-1ccc1a1b10a7",
                                "text": "„In der jüdischen Tradition ist die 13 eine Glückszahl und ein Symbol Gottes, weil sie über der Zwölf steht.“"
                            },
                            {
                                "example_id": "ab2eb77f-b671-4a8e-8ecd-cb56aae564f0",
                                "sense_id": "447d0bf5-1364-37d6-b380-1ccc1a1b10a7",
                                "text": "„Die neun Glückszahlen aber werden künftig montags im Stadtrat gezogen.“"
                            },
                            {
                                "example_id": "c1225c32-3c28-4973-8b6a-6b5d79006b73",
                                "sense_id": "447d0bf5-1364-37d6-b380-1ccc1a1b10a7",
                                "text": "„Vera und Thomas kriegen sich in dem Kapitel mit der Glückszahl und stellen nebenbei fest, wie gefährlich Alkohol am Steuer ist.“"
                            },
                            {
                                "example_id": "2295670f-19a9-4cfe-baa7-5d0127099580",
                                "sense_id": "447d0bf5-1364-37d6-b380-1ccc1a1b10a7",
                                "text": "„Drei ist meine Glückszahl, und in jedem Märchen gibt es drei Versuche, bevor etwas klappt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
