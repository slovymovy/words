                    {
                        "form_id": "a15d74a9-6b57-41fe-9525-216b6667490d",
                        "entry_id": "51490a42-f16e-3a69-aa4c-27130c4aaf8f",
                        "tags": [],
                        "form": "éolipile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cf21550-cc24-33e9-8560-39e8ac27f910",
                        "entry_id": "51490a42-f16e-3a69-aa4c-27130c4aaf8f",
                        "glosses": [
                            "Boule de métal creuse, qui, étant en partie remplie d’eau et chauffée, produit un jet continu de vapeur par un bec recourbé adapté à un point de sa surface."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "47bc37f7-0148-40c9-b27c-5e199c5681fa",
                                "sense_id": "5cf21550-cc24-33e9-8560-39e8ac27f910",
                                "text": "L’étranglement pratiqué à la partie supérieure de la chaudière forme une espèce d’éolipyle où les vapeurs ne peuvent passer qu’avec effort."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a70e957-63f8-3172-b010-ff8100726dd9",
                        "entry_id": "51490a42-f16e-3a69-aa4c-27130c4aaf8f",
                        "glosses": [
                            "Ancien modèle de lampe à souder."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b962b328-6df4-40f9-82a5-3848137c9416",
                                "sense_id": "7a70e957-63f8-3172-b010-ff8100726dd9",
                                "text": "Quant à moi, j'emploie la lampe dite éolipyle, dont les gaziers se servent, qui est très-favorable à ce genre de soudure."
                            },
                            {
                                "example_id": "423c661b-f9b1-4d21-b6d9-ad6bb87aa26c",
                                "sense_id": "7a70e957-63f8-3172-b010-ff8100726dd9",
                                "text": "Le goût décidera entr'eux. Quant à la lampe à souder, elle sera toujours la même, soit qu'on employe le soufflet, l'éolipyle ou le chalumeau."
                            }
                        ]
                    }
                ],
