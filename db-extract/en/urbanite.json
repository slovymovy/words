                                    {
                                        "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                        "entry_id": "c8f16c49-b3cf-388d-8270-43fb684f2b6b",
                                        "glosses": [
                                            "Celui qui habite une ville ou une zone urbaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eda4781-3fba-4440-ba68-13ada8695dda",
                                                "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                                "text": "[…] ô riche et chanceux Hérault, toi qui verses au cœur des citadins déprimés l'intarissable joie liquide de tes litres vendus par toi trente sous et revendus, par l'épicier ou sur le zinc, trois francs."
                                            },
                                            {
                                                "example_id": "eff90df8-3826-4d35-897b-314d1d5581ba",
                                                "sense_id": "b2428a7e-346c-35d1-af2f-b7018fade7e0",
                                                "text": "Pour le monde développé , le XIXᵉ siècle est le siècle par excellence de l’urbanisation. Pour l'Europe (sans la Russie), le nombre de citadins (critère des 2 mille habitants) passe de 31 millions en 1800 à 170 millions en 1910."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citadin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f052973f-b1e1-34ac-84cf-24aac72fea3d",
                                        "entry_id": "06c7ec26-66df-3ace-b060-3a53c75718e8",
                                        "glosses": [
                                            "Qui vit dans une ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd3bc55-0970-48aa-bf59-6cb083222840",
                                                "sense_id": "f052973f-b1e1-34ac-84cf-24aac72fea3d",
                                                "text": "Au moment des luttes politiques, les électeurs du Léon, encadrés par leurs prêtres, font, grâce à leur discipline, échec aux aspirations sociales des populations citadines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1501571-031c-4e89-858e-bbcfdf6c2859",
                        "source_entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                        "source_sense_description": "someone who lives in a city or similar urban area",
                        "target_lang_word": "Städter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Städter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                        "entry_id": "9838ccf7-fcf3-3f19-b2c6-68a898bce732",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4f59ad-0c26-46ad-a054-7c2d58237485",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "Mein Kollege hieß Stetter und war Städter."
                                            },
                                            {
                                                "example_id": "d83ba071-970e-4af0-ab37-5e41a820c0e1",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Die Städter ackerten und asteten, bis sie in der grimmigen Kälte völlig durchgeschwitzt waren.“"
                                            },
                                            {
                                                "example_id": "a6e2dcbc-f2a5-4dfe-94e7-7e106b492301",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Ich bin nicht auf Landarbeit versessen, ich bin durch und durch Städter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70c8ea40-8638-4d22-8707-e731302a9bfa",
                        "source_entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                        "source_sense_description": "someone who lives in a city or similar urban area",
                        "target_lang_word": "Stadtbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadtbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                        "entry_id": "5c778b3a-5204-3ffb-9747-851adce655fd",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53b3bda-f4e8-4bb7-9a74-d1fcd6b790de",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Die planmäßige Durchgrünung von überbauten Gebieten trägt zur Linderung der negativen Auswirkungen von Stadtökosystemen bei, z.B. durch geringere Schwülebelastung im Hochsommer, Frischluftzufuhr oder durch visuelle und psychische Erholung für Stadtbewohner.“"
                                            },
                                            {
                                                "example_id": "f4f4e009-6cac-4f32-8d47-d85e971871df",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Drei Viertel der afrikanischen Stadtbewohner leben in abstoßenden Slums und Squattersiedlungen.\""
                                            },
                                            {
                                                "example_id": "4e8ddb73-3853-4ac0-8315-c7e6f9d43a95",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„Britische Mediziner wollen sogar herausgefunden haben, dass Stadtbewohner ein deutlich höheres Risiko besitzen, an Psychosen zu erkranken.“"
                                            },
                                            {
                                                "example_id": "04832aa2-7431-4c66-a273-c72ccc2f8896",
                                                "sense_id": "1fe029ab-2059-3232-b612-b50a1890de92",
                                                "text": "„In der Tat hatte Robert, als er sich darauf besann, keinen der Stadtbewohner jemals rauchen sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c25929a2-15c1-48c2-a2a1-f05a3a51e2cf",
                        "source_entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
