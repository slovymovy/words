            "senses": [
                {
                    "sense_id": "bc8dddac-02da-3281-a258-f24836a7fe4e",
                    "sense_definition": "Провести некоторое время в ожидании кого-либо или чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <w>подождать</w> автобус на остановке.",
                            "target_lang_translations": {
                                "en": "We decided to <w>wait</w> for the bus at the bus stop.",
                                "nl": "We besloten op de bus te <w>wachten</w> bij de halte.",
                                "pl": "Zdecydowaliśmy się <w>poczekać</w> na autobus na przystanku.",
                                "de": "Wir haben beschlossen, an der Haltestelle auf den Bus zu <w>warten</w>.",
                                "fr": "Nous avons décidé d'<w>attendre</w> le bus à l'arrêt.",
                                "it": "Abbiamo deciso di <w>aspettare</w> l'autobus alla fermata.",
                                "cs": "Rozhodli jsme se <w>počkat</w> na autobus na zastávce.",
                                "tr": "Otobüsü durakta <w>beklemeye</w> karar verdik.",
                                "es": "Decidimos <w>esperar</w> el autobús en la parada.",
                                "zh": "我们决定在车站<w>等</w>公交车。"
                            }
                        },
                        {
                            "text": "Пожалуйста, <w>подождите</w> меня у входа в здание.",
                            "target_lang_translations": {
                                "en": "Please <w>wait</w> for me at the entrance to the building.",
                                "nl": "Wil je alsjeblieft bij de ingang van het gebouw op me <w>wachten</w>?",
                                "pl": "Proszę, <w>poczekajcie</w> na mnie przy wejściu do budynku.",
                                "de": "Bitte <w>warten</w> Sie am Gebäudeeingang auf mich.",
                                "fr": "S'il vous plaît, <w>attendez</w>-moi à l'entrée du bâtiment.",
                                "it": "Per favore, <w>aspettatemi</w> all'ingresso dell'edificio.",
                                "cs": "Prosím, <w>počkejte</w> na mě u vchodu do budovy.",
                                "tr": "Lütfen bina girişinde beni <w>bekleyin</w>.",
                                "es": "Por favor, <w>espérame</w> en la entrada del edificio.",
                                "zh": "请在建筑物入口处<w>等</w>我。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "подождать немного",
                        "подождать ответа",
                        "подождать минуту",
                        "подождать на улице"
                    ],
                    "target_lang_definitions": {
                        "en": "To stay in a place or delay action until something happens or someone arrives.",
                        "nl": "Een tijdje op een plek blijven of een handeling uitstellen totdat er iets gebeurt of iemand arriveert.",
                        "pl": "Spędzić pewien czas w oczekiwaniu na kogoś lub coś.",
                        "de": "An einem Ort bleiben oder eine Handlung hinauszögern, bis etwas geschieht oder jemand eintrifft.",
                        "fr": "Rester dans un lieu ou retarder une action jusqu'à ce que quelque chose se produise ou que quelqu'un arrive.",
                        "it": "Rimanere in un luogo o ritardare un'azione finché qualcosa non accade o qualcuno non arriva.",
                        "cs": "Zůstat na místě nebo odložit činnost, dokud se něco nestane nebo někdo nepřijde.",
                        "tr": "Birinin veya bir şeyin gelmesini veya bir olayın gerçekleşmesini beklemek için bir yerde kalmak veya eylemi ertelemek.",
                        "es": "Permanecer en un lugar o retrasar una acción hasta que algo suceda o alguien llegue.",
                        "zh": "在某处停留或推迟行动，直到某事发生或某人到达。"
                    },
