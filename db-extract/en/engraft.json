                                        "entry_id": "65b6eb55-d046-345b-915e-8374b77d0dff",
                                        "glosses": [
                                            "Obstbäume oder Weinreben durch ein Reis einer besseren Sorte veredeln"
                                        ],
                                        "tags": [
                                            "Pflanzenbau"
                                        ],
                                        "examples": [
