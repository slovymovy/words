                    {
                        "translation_id": "140e3dea-d8d8-4d86-bf51-5b62c2b02222",
                        "source_entry_id": "69247755-11fb-3ca6-8649-bdaf1ef4a09d",
                        "source_sense_id": "869572a4-49f0-3c77-bcb2-d7880712fece",
                        "source_sense_description": "act or instance of reproving; a rebuke",
                        "target_lang_word": "Vorwurf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorwurf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                        "entry_id": "06cfdb02-d5ca-32ce-85b8-b562b6a9f2e6",
                                        "glosses": [
                                            "Äußerung, die jemanden beschuldigt oder jemandem Vorhaltungen macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e00a201e-2e11-4fd8-92b9-b1b76a6eb2fb",
                                                "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                                "text": "Der Politiker wehrte sich gegen den Vorwurf, er sei bestechlich."
                                            },
                                            {
                                                "example_id": "f8783c81-e1e0-491f-bed4-53824edb4a05",
                                                "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                                "text": "„Hannibal, so lautet der häufig erhobene Vorwurf, hätte nach dem römischen Debakel den Krieg durch die Einnahme Roms beenden können.“"
                                            },
                                            {
                                                "example_id": "574fb136-0552-4356-88ed-1ca43d8af78a",
                                                "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                                "text": "„Gegen die Beichtväter der Fürsten richtet Pater Spee in seinem Gewissensbuch die schwersten Vorwürfe.“"
                                            },
                                            {
                                                "example_id": "043a3797-ff78-481d-9612-0fbf1b04a994",
                                                "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                                "text": "„Den gleichen Vorwurf konkretisieren gelegentlich auch Berner- oder Schwabenwitze.“"
                                            },
                                            {
                                                "example_id": "b343a80e-2391-4daf-9117-25396784101d",
                                                "sense_id": "c63f24b2-9b35-31ca-b998-29d9a2632d54",
                                                "text": "„Das Feuer begann in den Augen des verdorrten Indianers zu glühen, als er diesen beißenden Vorwurf hörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f46a1545-10df-30b5-ab0a-70221e9e91c2",
                                        "entry_id": "06cfdb02-d5ca-32ce-85b8-b562b6a9f2e6",
                                        "glosses": [
                                            "Ball, der sich aus unterschiedlichen Gründen regelwidrig in Richtung des gegnerischen Malfeldes bewegt"
                                        ],
                                        "tags": [
                                            "Rugby"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e91165-4578-4cf2-b3ca-7c3a2fed4bed",
                                                "sense_id": "f46a1545-10df-30b5-ab0a-70221e9e91c2",
                                                "text": "„Den Neuseeländern gelangen perfekte Spielzüge, auch wenn es ein, zweimal nach Vorwurf aussah - im Rugby darf der Ball nur nach hinten gepasst werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
