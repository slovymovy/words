                "senses": [
                    {
                        "sense_id": "1b40a010-1920-3cbc-8206-4b2be1a77101",
                        "entry_id": "d1836819-08fa-3af5-8361-e42c034cc37d",
                        "glosses": [
                            "En France une société de droit privé détenue par les producteurs et distributeurs pour prendre en charge, dans le cadre de la Responsabilité élargie du producteur (REP), la fin de vie des équipements qu’ils mettent sur le marché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efb1f68-2cb8-42f6-a6e8-ae677aaf8840",
                                "sense_id": "1b40a010-1920-3cbc-8206-4b2be1a77101",
                                "text": "Le gouvernement a renouvelé les agréments des écoorganismes qui doivent agir dans la collecte des déchets, outre-mer compris."
                            },
                            {
                                "example_id": "ab5ce9f6-e97e-4e1d-85de-5671b1328a91",
                                "sense_id": "1b40a010-1920-3cbc-8206-4b2be1a77101",
                                "text": "Les écoorganismes ne pouvant pas débuter la labellisation de réparateurs avant le feu vert officiel, cela reporterait vraisemblablement à 2023 l’effectivité du soutien pour les consommateurs."
                            },
                            {
                                "example_id": "f9634094-8d43-499d-a63b-75ade0371291",
                                "sense_id": "1b40a010-1920-3cbc-8206-4b2be1a77101",
                                "text": "Le ministre de l’Écologie avait alors demandé le renforcement du contrôle par l’État du fonctionnement de l’ensemble des écoorganismes."
                            }
                        ]
                    }
