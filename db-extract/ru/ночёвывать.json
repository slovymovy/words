                "senses": [
                    {
                        "sense_id": "26944d78-f413-323a-88b2-f7d3532fa43a",
                        "entry_id": "b4639d27-4130-322c-99ac-aecb4b22e0f4",
                        "glosses": [
                            "to spend the night, stay for the night, to stay overnight (repeatedly or frequently); iterative of ночева́ть (nočevátʹ)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741bdf30-0acc-400a-8903-251999a78e6e",
                                "sense_id": "26944d78-f413-323a-88b2-f7d3532fa43a",
                                "text": "Я отню́дь не могу́ и не сме́ю претендова́ть на и́мя «дру́га Че́хова», ко́их тепе́рь расплоди́лось неи́стовое коли́чество, и в душе́ у него́, коне́чно, не ночё́вывал, но мы зна́ли друг дру́га сли́шком 20 лет, всегда́ бы́ли в хоро́ших, ро́вных отноше́ниях, и у меня́ мно́го че́ховских пи́сем.",
                                "translation": "Alexander Amfiteatrov",
                                "english": "Alexander Amfiteatrov"
                            }
                        ]
                    }
                ],
