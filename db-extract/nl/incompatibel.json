                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompatible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0459672-cb1f-37f3-8c9d-45eddd703552",
                                        "entry_id": "d065308d-8f36-366f-be2d-5b9f8f60c42f",
                                        "glosses": [
                                            "Of two things: that cannot coexist; not congruous because of differences; unable to function together due to dissimilarities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee51663-caf4-4db2-8b04-aec411c8cd2d",
                                                "sense_id": "b0459672-cb1f-37f3-8c9d-45eddd703552",
                                                "text": "My phone is incompatible with the latest version of this app."
                                            },
                                            {
                                                "example_id": "ca15ef1b-dc05-4081-ba54-c4b906ed0a55",
                                                "sense_id": "b0459672-cb1f-37f3-8c9d-45eddd703552",
                                                "text": "Courts of equity are in many instances so nice and intricate, that they are incompatible with the genius of trials by jury."
                                            },
                                            {
                                                "example_id": "2e8e9c73-c8de-4bcc-89eb-36ac5a6bd311",
                                                "sense_id": "b0459672-cb1f-37f3-8c9d-45eddd703552",
                                                "text": "After the story was published, Hunter stated that the temple's executive committee informed him that such statements were incompatible with being a rabbi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fa6187c-5d38-3cd6-9fbd-8cb1a9f380ba",
                                        "entry_id": "d065308d-8f36-366f-be2d-5b9f8f60c42f",
                                        "glosses": [
                                            "Incapable of being together without mutual reaction or decomposition, as certain medicines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incompatible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f9da587-bd40-38d8-a9b7-f845989b0283",
                                        "entry_id": "3079d8fe-8650-3111-aaca-cfb4e03975ea",
                                        "glosses": [
                                            "An incompatible substance; one of a group of things that cannot be placed or used together because of a change of chemical composition or opposing medicinal qualities."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed811bcb-ac4f-40b6-a711-565643d2f44f",
                                                "sense_id": "3f9da587-bd40-38d8-a9b7-f845989b0283",
                                                "text": "the incompatibles of iron"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9f7184f-215f-370b-8321-3dc7e999a80e",
                                        "entry_id": "3079d8fe-8650-3111-aaca-cfb4e03975ea",
                                        "glosses": [
                                            "A consequent of a contrary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1298c9-a11b-4bf1-a676-a6be8642cea6",
                                                "sense_id": "d9f7184f-215f-370b-8321-3dc7e999a80e",
                                                "text": "Incompatibles are consequents of contraries. For example, sleeping and waking are contraries, and snoring is associated with sleepers. So snoring and waking are incompatibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17c5b0b8-7792-4d22-8d3d-6acf71458c4b",
                        "source_entry_id": "91887dab-01fe-3439-87a8-7aa6a6c05e6d",
                        "source_sense_id": "4257998a-8256-3fff-a2af-c4a30d578e34",
