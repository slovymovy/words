                        "entry_id": "fb0d7b46-f8a8-362a-adb6-3b559af283fd",
                        "glosses": [
                            "een touw dat bij wijze van want- of stagspanner, enkele malen door de ogen van een stag en putting is gehaald en vastgezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225abdb0-119e-4363-a8f0-9a44b0fb6a0a",
                                "sense_id": "a896dd02-50d6-3f7a-b6e7-df7f38eba1d8",
                                "text": "De wanttalie met talreep is een eenvoudige voorloper van de spanschroef."
