                                    {
                                        "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                                        "glosses": [
                                            "begeisternder, ansteckender Schwung; Besonderheit, durch die etwas interessant und aufregend wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fddbfb-a551-4b06-9168-4f2c900ab543",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "Das Musical war so fad, es hatte überhaupt keinen Pep."
                                            },
                                            {
                                                "example_id": "0a1a5655-c6f1-41f8-af7c-d1c82a93f5e0",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "„Wer 20000 Euro mit etwas mehr Pep anlegen will, kommt an der Börse nicht vorbei.“"
                                            },
                                            {
                                                "example_id": "5db9d3b6-0a19-44c6-b4ef-b8aa6324c566",
                                                "sense_id": "dfb46bd8-36fb-36d4-b8d6-33a2aed3392b",
                                                "text": "„Da gehört Pep in die Sache!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                                        "entry_id": "84470901-25bb-3c77-8a26-764ee8d4bc8a",
                                        "glosses": [
                                            "synthetisch hergestelltes Mittel, das das zentrale Nervensystem anregt und das als Droge verwendet wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db57a3bf-7a3d-4bf2-ba6a-294a01801692",
                                                "sense_id": "3adb7712-ffe5-3e40-96b1-b94ff181b00b",
                                                "text": "„Pep ist das neue Ecstasy.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
