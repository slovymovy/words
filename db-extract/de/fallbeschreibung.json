                "senses": [
                    {
                        "sense_id": "1c317741-5135-35d8-82f8-2ade47fc6746",
                        "entry_id": "7bcf18f4-968a-3942-909d-9e284f2fad0b",
                        "glosses": [
                            "Erläuterung der Einzelheiten eines Falles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713f0c30-5e0a-4b57-949d-7f6772c27cf9",
                                "sense_id": "1c317741-5135-35d8-82f8-2ade47fc6746",
                                "text": "„In der Fallbeschreibung geht es um einen 24-Jährigen, der 36 Stunden nach einer Achterbahnfahrt über starke Schmerzen im rechten Ohr klagte.“"
                            },
                            {
                                "example_id": "5564fa42-c9b1-4d43-8949-3609508f85cd",
                                "sense_id": "1c317741-5135-35d8-82f8-2ade47fc6746",
                                "text": "„Eine Fallmonographie ist von einer Fallbeschreibung zu unterscheiden. […] Fallbeschreibungen haben somit in der fallrekonstruktiven Forschung keine Bedeutung.“"
                            },
                            {
                                "example_id": "0482af2a-ae8f-4810-9454-2f5c5be874c8",
                                "sense_id": "1c317741-5135-35d8-82f8-2ade47fc6746",
                                "text": "„Die – nicht abergläubische – Aufmerksamkeit für wunderliche, oft spiegelbildliche Ereignisse im Leben, wie wir sie aus Sigmund Freuds Fallbeschreibungen, vornehmlich in der „Psychopathologie des Alltagslebens“, kennen, kann man aus Linnés „Nemesis Divina“ lernen – und damit bewußteres Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
