                "translations": [
                    {
                        "translation_id": "34d92471-8c14-45ac-9c00-b3d719b71935",
                        "source_entry_id": "3ee1fe1b-ff19-3104-9f93-c9dd2b7ac31f",
                        "source_sense_id": "c4b52727-976e-3453-b0b3-9dae36c48312",
                        "target_lang_word": "horoscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horoscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64d9cdbd-7470-3cf8-a483-ba8770fc0a8e",
                                        "entry_id": "4820845d-ad02-3c52-9360-aa6619d99b60",
                                        "glosses": [
                                            "The position of the planets and stars at the moment of someone's birth; a diagram of such positions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                        "entry_id": "4820845d-ad02-3c52-9360-aa6619d99b60",
                                        "glosses": [
                                            "An astrological forecast of a person's future based on such information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c08229b-8258-4f3d-b548-b13e2692d49e",
                                                "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                                "text": "We must talk of the force of circumstances, of imperative necessity, and find fault with the cruel horoscope which ordained such a fate."
                                            },
                                            {
                                                "example_id": "d79ac86d-ddbc-4d16-84bf-ef85683d8512",
                                                "sense_id": "cf90f262-8ae7-3ec3-b16d-d5e53cdd828e",
                                                "text": "\"Ah, min hart! And what day was it?\"\n\"How curious you are! Do you want to cast my horoscope?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "378d9182-10e0-47ab-b276-20084300026d",
                        "source_entry_id": "3ee1fe1b-ff19-3104-9f93-c9dd2b7ac31f",
                        "source_sense_id": "c4b52727-976e-3453-b0b3-9dae36c48312",
                        "target_lang_word": "horóscopo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horóscopo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0604421a-903a-3bf3-9f61-f0f4e6c30109",
                                        "entry_id": "832dcd88-d4e0-3e30-b817-a4cd934edf13",
                                        "glosses": [
                                            "Posición del los planetas y estrellas en el momento del nacimiento de una persona; Un diagrama de estas posiciones. Prónostico sobre el futuro de una persona basado en estas posiciones."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9de1611-6675-4d80-b34b-84a34824bd97",
                        "source_entry_id": "3ee1fe1b-ff19-3104-9f93-c9dd2b7ac31f",
                        "source_sense_id": "c4b52727-976e-3453-b0b3-9dae36c48312",
                        "target_lang_word": "Horoskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horoskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26a9ccca-b375-3786-bc96-d580c54ab5ed",
                                        "entry_id": "3c3df09e-d52d-35fc-ae9f-b4a31cb41ba8",
                                        "glosses": [
                                            "schematische Darstellung der Planetenkonstellation zu einem bestimmten Zeitpunkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416d69cd-9029-45e7-a435-a19a797eae40",
                                                "sense_id": "26a9ccca-b375-3786-bc96-d580c54ab5ed",
                                                "text": "Um sein eigenes Horoskop zu erstellen, kann man Vordrucke benutzen, in die die Konstellation zum Geburtstag eingezeichnet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                        "entry_id": "3c3df09e-d52d-35fc-ae9f-b4a31cb41ba8",
                                        "glosses": [
                                            "Voraussage über die Zukunft aufgrund von Sternenkonstellationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1132e48-f891-4816-be0c-ca03d85535a2",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "Manche befragen jeden Tag ihr Horoskop."
                                            },
                                            {
                                                "example_id": "9ea8ed5b-f9d1-4c63-b42c-356cf690b124",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Sie erstellte Horoskope, las die Karten und nahm ab und zu illegale Abtreibungen vor.“"
                                            },
                                            {
                                                "example_id": "6d9cf105-9029-43ea-b4e9-043665a8ce91",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Die Horoskope für einzelne Tage sind so unterschiedlich wie die Zeitschriften, in denen sie abgedruckt sind - und selten hat man in der Bild dieselben Aussichten wie in der Brigitte.“"
                                            },
                                            {
                                                "example_id": "94877be0-cdd4-4ca4-a8d2-b38769787840",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Und mit dem täglichen Horoskop beginnt mein Tag.“"
                                            },
                                            {
                                                "example_id": "3b9db22d-909c-4825-b789-86ffed446f90",
                                                "sense_id": "d441fe58-18e6-3254-a404-59e6356d2e74",
                                                "text": "„Er hatte in seinem Horoskop gelesen, daß er an einem solchen Tag ermordet werden sollte, und als kluger Mann mußte er daher unerreichbar bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
