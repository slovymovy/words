{
    "word_family": [
        "fiddle",
        "fiddler",
        "fiddling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "82e4b362-00df-3334-a46f-7c0517054d31",
                    "sense_definition": "Requiring a high degree of manual dexterity or careful handling to operate or adjust because of being small or complicated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult_to_handle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The buttons on the tiny mobile phone were too <w>fiddly</w> for him to use comfortably.",
                            "target_lang_translations": {
                                "ru": "Кнопки на крошечном мобильном телефоне были слишком <w>неудобными</w> и мелкими, чтобы он мог ими комфортно пользоваться."
                            }
                        },
                        {
                            "text": "Installing the software was a <w>fiddly</w> task because it required several <w>fiddly</w> plug-ins to work correctly.",
                            "target_lang_translations": {
                                "ru": "Установка программного обеспечения была <w>кропотливой</w> задачей, так как для корректной работы требовалось несколько <w>заковыристых</w> плагинов."
                            }
                        }
                    ],
                    "synonyms": [
                        "fussy",
                        "tricky",
                        "awkward"
                    ],
                    "antonyms": [
                        "straightforward",
                        "easy",
                        "user-friendly"
                    ],
                    "common_phrases": [
                        "fiddly-plug-ins",
                        "fiddly-job",
                        "fiddly-bits"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий высокой степени ловкости рук или осторожного обращения из-за малого размера или сложности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кропотливый",
                                "target_lang_sense_clarification": "требующий терпения и мелкой работы"
                            },
                            {
                                "target_lang_word": "неудобный",
                                "target_lang_sense_clarification": "в обращении из-за мелких деталей"
                            },
                            {
                                "target_lang_word": "муторный",
                                "target_lang_sense_clarification": "разговорное, о сложном и мелком процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b707cb3-ac02-3f91-a0fe-24647dfecf26",
                    "sense_definition": "Having many small, intricate parts, details, or embellishments that are difficult to deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult_to_handle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress was beautiful, but all those <w>fiddly</w> little buttons made it hard to put on.",
                            "target_lang_translations": {
                                "ru": "Платье было красивым, но из-за всех этих <w>мелких</w> пуговиц, с которыми столько возни, его было трудно надеть."
                            }
                        },
                        {
                            "text": "She spent hours arranging the <w>fiddly</w> bits of the model airplane.",
                            "target_lang_translations": {
                                "ru": "Она часами расставляла <w>мелкие</w> детали модели самолета."
                            }
                        }
                    ],
                    "synonyms": [
                        "intricate",
                        "elaborate",
                        "detailed"
                    ],
                    "antonyms": [
                        "simple",
                        "plain"
                    ],
                    "common_phrases": [
                        "fiddly-little-islands",
                        "fiddly-details"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий множество мелких, замысловатых деталей или украшений, с которыми трудно иметь дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "о деталях, требующих возни"
                            },
                            {
                                "target_lang_word": "заковыристый",
                                "target_lang_sense_clarification": "сложный из-за обилия деталей"
                            },
                            {
                                "target_lang_word": "филигранный",
                                "target_lang_sense_clarification": "очень мелкий и детальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6db19218-b71a-3bbd-911a-efe4cd3b9aea",
                    "sense_definition": "Relating to small, restless movements of the fingers or hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled with fine motor skills, especially small <w>fiddly</w> movements like tying shoelaces.",
                            "target_lang_translations": {
                                "ru": "Он испытывал трудности с мелкой моторикой, особенно с такими <w>мелкими</w> движениями, как завязывание шнурков."
                            }
                        },
                        {
                            "text": "Her <w>fiddly</w> habits with her jewelry showed how nervous she was during the interview.",
                            "target_lang_translations": {
                                "ru": "Ее <w>суетливое</w> перебирание украшений выдавало то, как сильно она нервничала во время интервью."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidgety",
                        "restless"
                    ],
                    "antonyms": [
                        "still",
                        "steady"
                    ],
                    "common_phrases": [
                        "fiddly-movements"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мелким, беспокойным движениям пальцев или рук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суетливый",
                                "target_lang_sense_clarification": "о движениях рук"
                            },
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "о моторике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "442130d1-d69f-3042-a528-5ae729f8c61b",
                    "sense_definition": "Relating to small-scale, informal, or unofficial work done while claiming unemployment benefits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people in the neighborhood took on <w>fiddly</w> jobs to make ends meet while on benefits.",
                            "target_lang_translations": {
                                "ru": "Многие в округе брались за <w>неофициальные</w> подработки, чтобы свести концы с концами, пока получали пособие."
                            }
                        },
                        {
                            "text": "The lack of safety regulations for <w>fiddly</w> workers meant they had no protection if they were injured.",
                            "target_lang_translations": {
                                "ru": "Отсутствие правил техники безопасности для <w>нелегально</w> работающих означало, что они не имели никакой защиты в случае травмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "under-the-table",
                        "informal"
                    ],
                    "antonyms": [
                        "official",
                        "formal"
                    ],
                    "common_phrases": [
                        "fiddly-work",
                        "fiddly-jobs"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to certain British socio-economic contexts"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Informal/slang term for under-the-table work"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мелкой, неофициальной подработке, выполняемой во время получения пособия по безработице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неофициальный",
                                "target_lang_sense_clarification": "о подработке без оформления"
                            },
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "сленг, о незаконном заработке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}