                                    },
                                    {
                                        "sense_id": "12ec4e37-b8c0-3a64-9f65-09c464fa0ee8",
                                        "entry_id": "ca694ec1-ce72-3dd4-90ef-59c10c9ea8ce",
                                        "glosses": [
                                            "Eigenschaft der Unfähigkeit, etwas sprachlich nachvollziehbar ausdrücken zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9811865b-62b6-4fd4-9099-75a15d584eda",
                                                "sense_id": "12ec4e37-b8c0-3a64-9f65-09c464fa0ee8",
                                                "text": "Viele teilen die Erfahrung der Unaussprechlichkeit von Gefühlen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "49938c9e-e49d-39a1-99ba-6245756ac0bc",
                                        "entry_id": "ca694ec1-ce72-3dd4-90ef-59c10c9ea8ce",
                                        "glosses": [
                                            "Verbot, etwas zu benennen"
