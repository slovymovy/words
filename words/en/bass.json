                                "target_lang_word": "морской окунь",
                                "target_lang_sense_clarification": "морская рыба"
                            },
                            {
                                "target_lang_word": "сибас",
                                "target_lang_sense_clarification": "кулинарное название"
                            }
                        ],
                        "zh": [
