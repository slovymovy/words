    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04e11223-e99c-35bb-9787-fdc4324437ec",
                    "sense_definition": "Faire une plaie, une fracture ou une lésion corporelle à quelqu'un ou à un animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat a été grièvement <w>blessé</w> lors de l'attaque sur la base."
                        },
                        {
                            "text": "Cette chute violente dans l'escalier a <w>blessé</w> plusieurs personnes âgées."
                        }
                    ],
                    "common_phrases": [
                        "blesser grièvement"
                    ]
                },
                {
                    "sense_id": "487a7cf0-144e-3e2f-b4b5-572cd0bd2069",
                    "sense_definition": "Se causer à soi-même une douleur corporelle ou une lésion par accident.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais très attention en faisant du sport pour ne pas te <w>blesser</w>."
                        },
                        {
                            "text": "Il s'est <w>blessé</w> en tombant de son vélo sur le trottoir."
                        }
                    ],
                    "common_phrases": [
                        "se blesser au genou",
                        "se blesser en tombant"
                    ]
                },
                {
                    "sense_id": "303a5141-d020-3462-af30-3db3ce5428b5",
                    "sense_definition": "Peiner vivement quelqu'un, choquer ou froisser ses sentiments ou son amour-propre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses remarques cruelles et injustes ont profondément <w>blessé</w> son amie."
                        },
                        {
                            "text": "Je ne voulais pas te <w>blesser</w> par cette plaisanterie maladroite."
                        }
                    ],
                    "synonyms": [
                        "navrer",
                        "offenser"
                    ],
                    "common_phrases": [
                        "blesser l'amour-propre",
                        "blesser les sentiments"
                    ]
                },
                {
                    "sense_id": "aa3e778e-5026-3f7d-b313-367485b3a1e3",
                    "sense_definition": "Causer une gêne, une irritation ou une douleur locale par frottement continu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces nouvelles chaussures en cuir rigide me <w>blessent</w> les pieds."
                        },
                        {
                            "text": "La lanière étroite de ce sac lourd finit par me <w>blesser</w> l'épaule."
