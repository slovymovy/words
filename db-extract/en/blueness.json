                    }
                ],
                "translations": [
                    {
                        "translation_id": "64627eda-94c0-4053-8d13-4269b5cb9d86",
                        "source_entry_id": "428b8ca1-0d41-309d-9c98-f769086c12da",
                        "source_sense_description": "quality or characteristic of being blue",
                        "target_lang_word": "blauwheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blauwheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7dd908-abe9-3c86-a50f-24ea6cf9355b",
                                        "entry_id": "a5bedb8c-7bb4-3eb9-88f1-f60e9da88236",
                                        "glosses": [
                                            "het blauw zijn; de mate waarin iets of iemand blauw is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a19b23e5-f84b-4a32-93e2-8d31de4a8f9d",
                                                "sense_id": "5f7dd908-abe9-3c86-a50f-24ea6cf9355b",
                                                "text": "De wilde blauwheid van de bosbes: Van de week werd ik even gecorrigeerd. Het was maar een klein standje, maar wel van de hoogste autoriteit. En het ergste is: hij had het me al eens uitgelegd. De berisping kwam terloops onderaan een email: „Oja, noem jij blauwe bessen bosbessen?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86079842-54bb-46a6-9e86-3658b004534e",
                        "source_entry_id": "428b8ca1-0d41-309d-9c98-f769086c12da",
                        "source_sense_description": "quality or characteristic of being blue",
                        "target_lang_word": "bleuité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleuité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e14483-5bad-378c-8cd7-af8c8759d8d5",
                                        "entry_id": "8a7deb93-0c1e-3399-8541-54748b401017",
                                        "glosses": [
                                            "État de ce qui est bleu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8263ba0f-3382-41af-aba0-5f6ca9dd20a3",
                                                "sense_id": "06e14483-5bad-378c-8cd7-af8c8759d8d5",
                                                "text": "Où, teignant tout à coup les bleuités, délires\nEt rythmes lents sous les rutilements du jour,\nPlus fortes que l’alcool, plus vastes que nos lyres,\nFermentent les rousseurs amères de l’amour."
                                            },
                                            {
                                                "example_id": "bfa4cfaf-f1ce-423f-a686-cce665033b28",
                                                "sense_id": "06e14483-5bad-378c-8cd7-af8c8759d8d5",
                                                "text": "Ce beau violine, je l’ai choisi de manière à rehausser l’humble fonction de tapis de sol : outre la nuance qu’elle apporte aux éléments bleutés de la pièce (qu’elle surclasse donc en bleuité profonde), cette couleur vient rédimer 1 tissu pédieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7be0491-c93c-4507-acce-8be80267869c",
                        "source_entry_id": "428b8ca1-0d41-309d-9c98-f769086c12da",
                        "source_sense_description": "quality or characteristic of being blue",
                        "target_lang_word": "Bläue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bläue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                        "entry_id": "a4a2cc86-50c4-33be-9767-5997c180286f",
                                        "glosses": [
                                            "die blaue Farbe von etwas, die Eigenschaft blau zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58f6073-8026-45da-a267-b1dca6c5469f",
                                                "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                                "text": "Die Bläue des Himmels erstrahlte über dem Grün der Wiesen."
                                            },
                                            {
                                                "example_id": "d6a2d808-fd65-44c9-91f8-e98d77f04ac2",
                                                "sense_id": "a7764992-f455-3db7-982e-84ed5ca83680",
                                                "text": "„Seineabwärts liegt im Talausschnitt ein breiter Streifen türkisfarbener Bläue, der sich in der nassen Straße spiegelt: Es hat zu regnen begonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e6f8261-3c82-37b1-a4a7-662cc911f14e",
                                        "entry_id": "a4a2cc86-50c4-33be-9767-5997c180286f",
                                        "glosses": [
                                            "durch Pilze verursachte Blaufärbung des Holzes"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ffcef7-e794-4ac7-b20d-03cc0bb9f485",
                                                "sense_id": "2e6f8261-3c82-37b1-a4a7-662cc911f14e",
                                                "text": "Die Stabilität des Holzes wird durch die Bläue nicht beeinträchtigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
