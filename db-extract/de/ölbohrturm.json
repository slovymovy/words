                "senses": [
                    {
                        "sense_id": "e2234ac7-1531-3c9a-98a5-29608e9cb3cb",
                        "entry_id": "4a572de9-c24b-30f4-9016-731df2803eec",
                        "glosses": [
                            "Bohrturm, mit dem Erdöl gefördert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7be8cb82-3e8e-4032-963d-2fa4f459b738",
                                "sense_id": "e2234ac7-1531-3c9a-98a5-29608e9cb3cb",
                                "text": "„Als der Eiffelturm es 1887 wagte, sich über Paris zu erheben, verurteilte der französische Kulturexperte Victor Hugo ihn als einen hässlichen Ölbohrturm, der das Antlitz der Stadt entstelle.“"
                            },
                            {
                                "example_id": "f203097d-4106-47f0-bc09-634e04ef73ae",
                                "sense_id": "e2234ac7-1531-3c9a-98a5-29608e9cb3cb",
                                "text": "„Das Meeresblau war hier und da zu sehen, jedoch verdorben von den Kränen im Hafen, zwei Ölbohrtürmen und Schiffsmasten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
