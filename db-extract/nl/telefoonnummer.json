                ],
                "senses": [
                    {
                        "sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
                        "entry_id": "6db22394-1acc-3975-8ff9-f6b3120afb63",
                        "glosses": [
                            "een uniek nummer toegewezen aan een telefoonaansluiting, waarmee naar deze aansluiting gebeld kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1015e555-b79d-4009-b327-28453376e16f",
                                "sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
                                "text": "Onder welk telefoonnummer bent u bereikbaar?."
                            },
                            {
                                "example_id": "2142503e-9b6e-444a-b6f5-320302f3a306",
                                "sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
                                "text": "Ik had geen idee wat zijn echte naam was en had ook geen telefoonnummer van hem, maar het voelde altijd vertrouwd om te weten dat hij ergens voor of achter me liep."
                            },
                            {
                                "example_id": "6cb9cead-7d80-490c-86c6-2c0ae044de4e",
                                "sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
                                "text": "Ik heb het telefoonnummer van meneer de baron nodig en dan ga ik naar de club om te bellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26f43b73-ba21-4a4c-8fe8-b955585dbfb7",
                        "source_entry_id": "6db22394-1acc-3975-8ff9-f6b3120afb63",
                        "source_sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
                        "source_sense_description": "een uniek nummer toegewezen aan een telefoonaansluiting",
                        "target_lang_word": "Telefonnummer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telefonnummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                        "entry_id": "7cc53a10-afa4-324d-b726-96ebb44e4721",
                                        "glosses": [
                                            "eine eindeutige Nummer in einem Vorwahlbereich, die einem Telefonanschluss zugeordnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0ac008-32c4-4d2c-96f1-54e03724041e",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "Gibst du mir deine Telefonnummer?"
                                            },
                                            {
                                                "example_id": "9d49400f-9e51-4012-baff-be34a50c2992",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "Wie lautet deine neue Telefonnummer?"
                                            },
                                            {
                                                "example_id": "0229a44e-3754-4d5d-8a36-5aab9c89b1c0",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "„Außerdem werde Frixe eine Telefonnummer mitgeteilt, über die er bei Störungen direkt Kontakt aufnehmen könne.“"
                                            },
                                            {
                                                "example_id": "01261d37-56d9-4095-96d9-824af746dfa3",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "„Adresse und Telefonnummer des Hauses Kuß, so vermutet Eos, werden jedoch verzeichnet gewesen sein, eine unmißverständliche Einladung, sich irgendwann und möglichst bald zu melden.“"
                                            },
                                            {
                                                "example_id": "54421b72-d9c2-40ed-af9b-dfe27c60f9a9",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "„Aber manchmal, glaube ich, hebt sie einfach nicht ab, wenn sie die Telefonnummer mit der österreichischen Vorwahl sieht.“"
                                            },
                                            {
                                                "example_id": "6d09f6ba-5033-4539-bb17-b0e2b010d0e8",
                                                "sense_id": "154fad25-8bc0-3c27-a4f4-1a2b59a713a3",
                                                "text": "„Internationale Telefon- und Faxnummern werden im Schriftsatz üblicherweise ohne Klammern gesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58e4e717-8889-49d4-b151-2891b9a2ce08",
                        "source_entry_id": "6db22394-1acc-3975-8ff9-f6b3120afb63",
                        "source_sense_id": "c7378376-9ee9-3c39-a130-9c3c4fa9d6ac",
