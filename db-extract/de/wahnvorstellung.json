                "senses": [
                    {
                        "sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                        "entry_id": "9ad1112b-8001-373d-a261-93d7ba1b8360",
                        "glosses": [
                            "krankhafte, wahnwitzige, nicht realisierbare Annahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54cf3adf-95c6-4094-b496-88536584cd1e",
                                "sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                                "text": "„Das Anheizen der Wut auf die Juden war in Hitlers Wahnvorstellungen eines der besten Verfahren, um den Zerfall des feindlichen Bündnisses zu beschleunigen.“"
                            },
                            {
                                "example_id": "f24818a4-aa7d-47ea-917b-ee965d9f5302",
                                "sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                                "text": "„Das Misstrauen des Komponisten gegenüber den Ärzten wuchs sich zu Wahnvorstellungen aus.“"
                            },
                            {
                                "example_id": "4c553837-d8bc-4170-ac95-e24236febcd6",
                                "sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                                "text": "„Die Wahnvorstellungen, die sie im Laufe ihrer Krankheit entwickelte, waren im Grunde ihre Wunschvorstellungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a57093d-a54e-4e43-b3a6-f8b470f9d37e",
                        "source_entry_id": "9ad1112b-8001-373d-a261-93d7ba1b8360",
                        "source_sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                        "source_sense_description": "krankhafte, wahnwitzige, nicht realisierbare Annahme",
                        "target_lang_word": "delusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65c5f67-0aad-3119-891c-416703c18f47",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A false belief that is resistant to confrontation with actual facts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "The state of being deluded or misled, or process of deluding somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb910c6-d85e-452e-a554-79315d527f0b",
                                                "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                                "text": "It is far better to grasp the universe as it really is than to persist in delusion, however satisfying and reassuring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "That which is falsely or delusively believed or propagated; false belief; error in belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc44280-25f4-4eed-9fff-eb781113fa77",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "Hess, always a muddled man though not so doltish as Rosenberg, flew on his own to Britain under the delusion that he could arrange a peace settlement."
                                            },
                                            {
                                                "example_id": "ba01b9b7-0d6d-43e4-9140-a86db0b3ecfd",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "“Project Greenlight,” however, bore down on the soft underbelly of the movie business, focusing on the delusions and colossal blunders of first-time directors, seemingly selected as much for their unlovability as their talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6f4064-0880-3ecd-b9f0-70cef3bffd97",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A fixed, false belief, that will not change, despite evidence to the contrary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "133669b8-d703-4c31-8e3f-33a7558137bd",
                        "source_entry_id": "9ad1112b-8001-373d-a261-93d7ba1b8360",
                        "source_sense_id": "8b1dc995-4e37-3c29-9479-c8cb5d6bdf9a",
                        "source_sense_description": "krankhafte, wahnwitzige, nicht realisierbare Annahme",
                        "target_lang_word": "hallucination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallucination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "A sensory perception of something that does not exist, often arising from disorder of the nervous system, as in delirium tremens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5286a4ee-12da-47d4-9e47-0e209439083c",
                                                "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                                "text": "Hallucinations are always evidence of cerebral derangement and are common phenomena of insanity."
                                            },
                                            {
                                                "example_id": "16b5d453-22b8-4160-b354-8f1d9628df76",
                                                "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                                "text": "The authorities said that the spinach had caused “possible food-related toxic reactions” with those affected experiencing symptoms including delirium, hallucinations, blurred vision, rapid heartbeat and fever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce743bb5-1ebd-33fb-b21b-0d44aa0f9057",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "The act of hallucinating; a wandering of the mind; an error, mistake or blunder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97150574-b486-4653-80c9-960417312674",
                                                "sense_id": "ce743bb5-1ebd-33fb-b21b-0d44aa0f9057",
                                                "text": "This must have been the hallucination of the transcriber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "A confident but incorrect response given by an artificial intelligence; a confabulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5683a0db-e1d1-404c-821a-f9352c7219a9",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "Chatbots even forget that they are a bot and experience \"hallucinations\", Meta's description for when a bot confidently says something that is not true."
                                            },
                                            {
                                                "example_id": "ba34fc7c-22e2-4022-a42f-fba0e9b7968f",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "Hallucinations are about adhering to the truth; when A.I. systems get confused, they have a bad habit of making things up rather than admitting their difficulties."
                                            },
                                            {
                                                "example_id": "6c9c668f-32b9-497d-8d6b-5781f42d7374",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "It may tell you that the official currency of Switzerland is the euro (it’s actually the Swiss franc) or that Mark Twain’s Celebrated Jumping Frog of Calaveras County could not only jump but talk. A.I. researchers call this generation of untruths “hallucination.”"
                                            },
                                            {
                                                "example_id": "a6ef38a1-e04a-42ef-bc54-4ef14535f104",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "The hallucinations common to AI also came under fire in the suit for potentially damaging the value of the Times' reputation, and possibly damaging human health as a side effect. “A GPT model completely fabricated that “The New York Times published an article on January 10, 2020, titled ‘Study Finds Possible Link between Orange Juice and Non-Hodgkin’s Lymphoma,’” the suit alleges. “The Times never published such an article.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
