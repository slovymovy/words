                "senses": [
                    {
                        "sense_id": "9235bf12-0772-39a9-9eda-6a2cfe513d6d",
                        "entry_id": "a8d8cfc6-6324-37b2-8de0-6c554b0fe704",
                        "glosses": [
                            "Mangel an ausreichenden Ressourcen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd64997-42df-469b-b09f-ed656a8d0bc7",
                                "sense_id": "9235bf12-0772-39a9-9eda-6a2cfe513d6d",
                                "text": "„Kokain ist die einzige Wertanlage, die weder Ressourcenknappheit noch Inflation befürchten muss.“"
                            },
                            {
                                "example_id": "8e468e58-0eb0-4d28-9598-7acdd75631af",
                                "sense_id": "9235bf12-0772-39a9-9eda-6a2cfe513d6d",
                                "text": "„Kriegerische Auseinandersetzungen oder Ressourcenknappheit führte dazu, dass Menschen in mindestens drei Wellen zu verschiedenen Zeiten über die Meerenge kamen.“"
                            },
                            {
                                "example_id": "1b27be29-a623-499a-893c-351cd8189ed1",
                                "sense_id": "9235bf12-0772-39a9-9eda-6a2cfe513d6d",
                                "text": "„›Ja, schon ... aber angesichts der herrschenden Ressourcenknappheit wird die Führung wohl kaum Mitgefühl zeigen.‹“"
                            }
                        ],
