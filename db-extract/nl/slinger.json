                "senses": [
                    {
                        "sense_id": "e0524660-7bcc-3437-8c30-c7311cedc949",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "het slingeren, de zwaai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56a5df2-f17a-4820-892e-0f02d5a62b01",
                                "sense_id": "e0524660-7bcc-3437-8c30-c7311cedc949",
                                "text": "Toen was het mijn beurt en ik bond een steen aan een lang stuk touw, hield de grote lussen in mijn linkerhand, gaf een harde slinger en liet los."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d3c8c52-23de-3d9f-839c-e7ed4f789f85",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "lang lint om opgehangen de feestvreugde te verhogen, guirlande"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92e10086-4dd0-3cf5-bce3-0f596271205c",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "slingerende lijn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "ouderwets hulpstuk (zwengel) waarmee de T-Ford in beweging werd gebracht (nu vervangen door de startmotor)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58cc8fd-ea8b-4b77-827a-e904edfb2e72",
                                "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                                "text": "De Olieman heeft een Fordje opgedaan,"
                            },
                            {
                                "example_id": "126c9185-b8e3-4601-a3cd-11aeccc0f77a",
                                "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                                "text": "Daar rijdt ie mee als een vorst door de Jordaan."
                            },
                            {
                                "example_id": "62157757-e6bc-410a-bf58-527f5a860d96",
                                "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                                "text": "Maar 's avonds om tien uren is het uit met de pret,"
                            },
                            {
                                "example_id": "010cbcb5-5b0a-4ec8-a60f-a42c05bbc908",
                                "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                                "text": "Want dan stopt zijn vrouw de slinger onder bed.(Louis Davids)"
                            }
                        ]
                    },
                    {
                        "sense_id": "0b631c5d-e911-3888-b236-940e18bdb3ef",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "wapen waarmee stenen weggeslingerd konden worden (nu vervangen door het machinegeweer)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "08b99c1b-eb9d-3120-bfde-0626a5447cb1",
                        "entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "glosses": [
                            "voorwerp dat regelmatig heen en weer gaat en waarvan de periodeduur praktisch onafhankelijk is van de amplitude, heel geschikt om een uurwerk van te bouwen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
