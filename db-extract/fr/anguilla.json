                                            {
                                                "example_id": "de7a20aa-0ab1-4e82-b542-25d65ada8f8d",
                                                "sense_id": "ea46dd05-2bac-3298-af85-533719a15b64",
                                                "text": "„Anguilla ist eine flache und niedrig gelegene Insel aus Korallen und Kalkstein.“"
                                            },
                                            {
                                                "example_id": "5404566c-be5f-4690-8834-2981a411923e",
                                                "sense_id": "ea46dd05-2bac-3298-af85-533719a15b64",
                                                "text": "Die Wirtschaft Anguillas hängt sehr vom Luxustourismus und Übersee-Bankgeschäften ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39e6faae-731d-4d0b-b2a1-17bd4ddb65f4",
