                        "examples": [
                            {
                                "example_id": "842d30c3-79a7-4085-8f60-202b2c0ebeb9",
                                "sense_id": "eb0d3911-e4eb-3c95-9505-c84255fdd8bd",
                                "text": "Совершать деяния, запрещенные Господом Богом, то есть совершать харам. Кто, знает, что избегать харам это его долг, однако, будучи рабом своих страстей, совершает харам, а затем мучается за это, тот не становится кяфиром."
                            }
                        ]
                    }
