                "senses": [
                    {
                        "sense_id": "f3d9aaa8-6a05-30e0-baa2-fd9cdb3855e3",
                        "entry_id": "e230e355-7925-300a-b66c-3076d00980ef",
                        "glosses": [
                            "podsumowanie danych z postępowania lekarskiego wraz z zaleceniami dalszego leczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a236e83-646d-4984-aa76-c7098d955cab",
                                "sense_id": "f3d9aaa8-6a05-30e0-baa2-fd9cdb3855e3",
                                "text": "Lekarz nie zawarł w epikryzie zaleceń do dalszego leczenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cae2af3-1d71-4cf6-abe1-1b6445dc3ee8",
                        "source_entry_id": "e230e355-7925-300a-b66c-3076d00980ef",
                        "source_sense_id": "f3d9aaa8-6a05-30e0-baa2-fd9cdb3855e3",
                        "target_lang_word": "epicrisis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicrisis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
                                        "glosses": [
                                            "A critical or analytical study, evaluation, or summing up, especially of a medical case history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d4c18b-b9a2-42f4-8828-54cc580978c7",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "It would be well if every practitioner would go over his list of patients from time to time and attempt an epicrisis in each one. He will often be surprised at what he finds, and his clinical judgment should be greatly improved..."
                                            },
                                            {
                                                "example_id": "181eff63-37ce-4588-a62d-6989788136ac",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "But what if I don't have time to discharge you tomorrow. The epicrisis has to be written, you know."
                                            },
                                            {
                                                "example_id": "1f564e71-152a-4048-b659-d80bf72947ba",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "Haberal’s epicrisis report, which was prepared on Oct. 16, 2009, was sent to the court nearly one year later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3af4bb6-ff84-39f9-abba-a4eb566d0723",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
                                        "glosses": [
                                            "A quotation followed by a commentary."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "956b653c-26f7-3ebb-adfb-8890e3e02fe1",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
                                        "glosses": [
                                            "A commentary or annotation of a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25deac1e-0e9a-39b7-90f7-09e0fb5c1ab5",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
