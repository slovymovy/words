                        "examples": [
                            {
                                "example_id": "399d256a-e378-4cd2-a207-cc3c0a7aa218",
                                "sense_id": "177e8f3b-c3b1-3589-a271-a8c5fc791a1a",
                                "text": "Het is weer de negenenzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "e6ddc42f-c39e-4261-a15e-151f22800e44",
                                "sense_id": "177e8f3b-c3b1-3589-a271-a8c5fc791a1a",
                                "text": "Haar tachtigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de negenenzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "44aa6d2f-b7fb-363a-a294-f37481901ead",
                        "entry_id": "6f1b2f57-be31-31fe-81a6-ddda8ddbdb3f",
                        "glosses": [
                            "groep van 79 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f1bd10-4531-4f73-9a25-c562dccbd045",
                                "sense_id": "44aa6d2f-b7fb-363a-a294-f37481901ead",
                                "text": "De negenenzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
