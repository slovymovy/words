                ],
                "senses": [
                    {
                        "sense_id": "1fa41b1c-992c-34d8-a67e-f0720a1dc2fd",
                        "entry_id": "81b579c2-45e4-310a-b1e0-7feda702c91c",
                        "glosses": [
                            "Celui qui nage, qui sait nager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d4018c-ced4-408b-bbc2-630826a4dd3d",
                                "sense_id": "1fa41b1c-992c-34d8-a67e-f0720a1dc2fd",
                                "text": "À Saint-Georges, un hôtel possédait une magnifique piscine, où je vis plusieurs fêtes nautiques. Il y avait de bons nageurs et nageuses et deux excellentes équipes de water-polo."
                            },
                            {
                                "example_id": "9a036e7c-2168-4c09-9d32-ff98f654ec26",
                                "sense_id": "1fa41b1c-992c-34d8-a67e-f0720a1dc2fd",
                                "text": "[…] il y a le nageur intrépide qui, sourd aux appels du maître baigneur, dépasse les limites du bain surveillé, gagne la pleine mer et est emporté par une lame de fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "abfb12a0-b582-35cc-98c9-9de50c72f9dd",
                        "entry_id": "81b579c2-45e4-310a-b1e0-7feda702c91c",
                        "glosses": [
                            "Batelier qui rame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f45bfb-cbba-489c-acbd-7a822229ff95",
                                "sense_id": "abfb12a0-b582-35cc-98c9-9de50c72f9dd",
                                "text": "Nous avions quatre nageurs sur notre canot. → voir gouvernail"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2a47a43-1bb7-4391-a9e3-41de390c2d88",
                        "source_entry_id": "81b579c2-45e4-310a-b1e0-7feda702c91c",
