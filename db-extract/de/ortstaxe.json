                "senses": [
                    {
                        "sense_id": "8c1ef615-1413-322e-908b-5aa5c8016772",
                        "entry_id": "418930d5-8368-3549-a738-e26cc079c920",
                        "glosses": [
                            "Gebühr, die von einer Gemeinde/Stadt pro Übernachtung (in einem Hotel, einer Ferienwohnung) bei Feriengästen erhoben wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "b24b239d-5ec3-457c-aee5-6bb6f39ef8b1",
                                "sense_id": "8c1ef615-1413-322e-908b-5aa5c8016772",
                                "text": "„Die Gesamteinnahmen aus der Ortstaxe betrugen für die Stadt mit 1. August 2016 rund 12.463.000 Euro und genau ein Jahr später 13.162.000 Euro (+ 5,6%).“"
                            },
                            {
                                "example_id": "205b2442-069e-4c10-bef8-0d4b57efd323",
                                "sense_id": "8c1ef615-1413-322e-908b-5aa5c8016772",
                                "text": "„Wien wird noch im heurigen Jahr ein Gesetz erlassen, das den Anbieter zwingen soll, Ortstaxen entweder zentral abzuführen oder aber alle Informationen über die Vermieter offenzulegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
