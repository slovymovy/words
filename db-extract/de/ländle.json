                    {
                        "form_id": "47151d91-89be-44fd-a9e2-f5e55ffeb5b6",
                        "entry_id": "702f80bd-997e-3aef-8527-e74987aa563a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Ländle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa8637ee-c70f-3a27-b3a7-7c9f9c94b27f",
                        "entry_id": "702f80bd-997e-3aef-8527-e74987aa563a",
                        "glosses": [
                            "das Bundesland Baden-Württemberg (die Landschaft Schwaben)"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "5a0c1583-1648-4e0a-a313-04a85dfb368f",
                                "sense_id": "fa8637ee-c70f-3a27-b3a7-7c9f9c94b27f",
                                "text": "„Am 27. November, neun Monate nach der Landtagswahl, hat der Bürger bei der ersten Volksabstimmung im Ländle die Dauerdiskussion um das Bahnprojekt Stuttgart 21 nun mit der ihm eigenen Souveränität für beendet erklärt.“"
                            },
                            {
                                "example_id": "ac691f51-958c-41b9-924a-ea7a8c94a2ee",
                                "sense_id": "fa8637ee-c70f-3a27-b3a7-7c9f9c94b27f",
                                "text": "„Bevor in Japan die Reaktoren schmolzen, bevor der Anti-Atom-Widerstand unvorstellbar angetrieben wurde, waren die Grünen im Ländle in Umfragen auf gerade einmal 15 Prozent abgesackt, trotz des Unmuts über Stuttgart 21 Ministerpräsident Stefan Mappus (CDU).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6c32320-1b85-315d-a890-f1ce7de417ee",
                        "entry_id": "702f80bd-997e-3aef-8527-e74987aa563a",
                        "glosses": [
                            "landschaftlich, das Bundesland Vorarlberg"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "7064de74-2bd5-443f-a74e-3d9386ab6d5e",
                                "sense_id": "c6c32320-1b85-315d-a890-f1ce7de417ee",
                                "text": "„Auch im Ländle schlug sich der Bundestrend im Wahlergebnis nieder: So stürzt die ÖVP auf einen historischen Tiefststand von 31 Prozent. Das bedeutet in Vorarlberg ein Minus von fast elf Prozentpunkten im Vergleich zu den Nationalratswahlen 2006.“"
                            },
                            {
                                "example_id": "0dad6bc3-3ad9-49d5-b471-0f54f7011c4d",
                                "sense_id": "c6c32320-1b85-315d-a890-f1ce7de417ee",
                                "text": "„Vorarlberg will weiter in jeder Gemeinde mindestens eine Volksschule beibehalten. Im kommenden Schuljahr 2009/10 gibt es im Ländle 64 Grundschulen mit jahrgangsübergreifenden Klassen, 22 davon sind einklassig geführte Kleinstschulen mit bis zu 20 Kindern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
