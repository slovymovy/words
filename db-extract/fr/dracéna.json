                            {
                                "example_id": "1a141dbe-a04a-450b-b614-c1a5fff5e318",
                                "sense_id": "f34cd75c-052b-3ae3-b9f1-a91481de8bb6",
                                "text": "Réputé pour son beau feuillage lancéolé et arqué, souvent panaché, le dracéna est un arbuste fréquemment utilisé comme plante d’intérieur."
                            },
                            {
                                "example_id": "b49d5bf8-81a3-46fe-b099-d592381b1b4f",
                                "sense_id": "f34cd75c-052b-3ae3-b9f1-a91481de8bb6",
                                "text": "Peu inspirée, elle regarde autour d’elle et avise la plante offerte par Tessa : un dracéna."
                            }
                        ]
                    },
