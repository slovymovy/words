                "senses": [
                    {
                        "sense_id": "f9fa8959-ee52-3612-9a85-acdb4970ba66",
                        "entry_id": "34678918-cea8-344b-b6bf-099d2db017df",
                        "glosses": [
                            "Décapsuleur, ouvre-bouteille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0279015e-ad7e-4ffe-8b3f-4e3ec4e2a01e",
                                "sense_id": "f9fa8959-ee52-3612-9a85-acdb4970ba66",
                                "text": "Gibst du mir bitte den Flaschenöffner?",
                                "translation": "Tu peux me passer le décapsuleur, s’il te plaît ?"
                            },
                            {
                                "example_id": "536a4bbe-05db-4d19-8fd4-bbe93fa88cc3",
                                "sense_id": "f9fa8959-ee52-3612-9a85-acdb4970ba66",
                                "text": "Ein weit verbreitetes Problem im Sommer: Man sitzt im Schwimmbad, will sich ein kühles Bier einschenken, aber leider findet sich weit und breit kein Flaschenöffner.",
                                "translation": "C’est un problème très répandu en été : on s’assied au bord de la piscine, on veut s’offrir une bière fraîche, mais on ne trouve nulle part un décapsuleur."
                            }
                        ]
                    }
                ],
