                                        "sense_id": "e2fccce0-6167-33ec-862d-4443d063d64c",
                                        "entry_id": "864549d3-87b8-3e0f-8015-6b84732763fd",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see cult, film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
