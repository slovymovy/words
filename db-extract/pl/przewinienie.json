                        ]
                    },
                    {
                        "translation_id": "77302ef3-96b2-4e9c-b0b9-2b378498e79a",
                        "source_entry_id": "dd5453fe-ffb7-347e-965d-b0edf3d6702a",
                        "source_sense_id": "c8919d5d-ca15-394b-b215-cf1443eb614c",
                        "target_lang_word": "demerit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demerit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80fab0ad-d01a-3f54-8906-f42f42fa323b",
                                        "entry_id": "025ff776-df35-3393-8a92-c9cdd5f9dbea",
                                        "glosses": [
                                            "A quality of being inadequate; a disadvantage, a fault."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106d6700-cce6-4616-b618-abd42ab7b512",
                                                "sense_id": "80fab0ad-d01a-3f54-8906-f42f42fa323b",
                                                "text": "[W]hatever they acquire by their Induſtry or Ingenuity […] ſhould be as much their Property, as any diviſions of Land or of Stock that are made to the Sons; and the Poſſeſſion as ſecure, unleſs forfeited by any demerit or offence againſt the cuſtoms of the Family, which grow with time to be the Orders of this little State."
                                            },
                                            {
                                                "example_id": "268e9c92-571b-4d5e-9826-a7bf031fa540",
                                                "sense_id": "80fab0ad-d01a-3f54-8906-f42f42fa323b",
                                                "text": "They see no merit or demerit in any man or any action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ed0d49-3da7-37a4-a680-7e2aae21b9be",
                                        "entry_id": "025ff776-df35-3393-8a92-c9cdd5f9dbea",
                                        "glosses": [
                                            "A mark given for bad conduct to a person attending an educational institution or serving in the army."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e8db22f-b6dc-4474-9b9a-0852b4cce7fe",
                                                "sense_id": "a0ed0d49-3da7-37a4-a680-7e2aae21b9be",
                                                "text": "A few of you have followed in the path of the perfect West Point graduate, Robert E. Lee, who never received a single demerit in four years. Some of you followed in the path of the imperfect graduate, Ulysses S. Grant, who had his fair share of demerits, and said the happiest day of his life was \"the day I left West Point.\" (Laughter.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfdba945-0b84-3380-b24d-f8769a08478d",
                                        "entry_id": "025ff776-df35-3393-8a92-c9cdd5f9dbea",
                                        "glosses": [
                                            "That which one merits or deserves, either of good or ill; desert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bfbc0ac-a4e6-411a-950d-4530ff237297",
                                                "sense_id": "dfdba945-0b84-3380-b24d-f8769a08478d",
                                                "text": "I fall to riſe, mount to thy maker, ſpirit, /. Leaue here thy body, death ha's her demerit."
                                            },
                                            {
                                                "example_id": "9b2afbc8-d6cf-4adf-86d3-87eaa7a78aea",
                                                "sense_id": "dfdba945-0b84-3380-b24d-f8769a08478d",
                                                "text": "But when firſt Cleobulus the tyrant of the Lindians, and then Periander the tyrant likewiſe of Corinth (who had neither of them any one jot of vertue or wiſdome) by the greatneſſe of their power, by the number of their friends, and by many benefits and demerits whereby they obliged their adherents, acquired forcibly this reputation, in deſpite of all uſurped the name of Sages; and to this purpoſe cauſed to be ſpred ſowen and divulged throughout all Greece certaine odde ſentences and notable ſayings, as well as thoſe of others, wherewith the former Sages, above named were diſcontented."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demerit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b86faf-ee94-39b6-9b04-87ef0f360dd6",
                                        "entry_id": "c1914654-e54e-39d3-a075-c9e325b62dd1",
                                        "glosses": [
                                            "To deserve."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10cd8ed1-f259-4a60-8b0a-231b3c58d933",
                                                "sense_id": "a4b86faf-ee94-39b6-9b04-87ef0f360dd6",
                                                "text": "You hold that every sin is an infinite evil, demeriting endless punishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec1add3-1c39-3993-af58-3bf5c1aa7b63",
                                        "entry_id": "c1914654-e54e-39d3-a075-c9e325b62dd1",
                                        "glosses": [
                                            "To depreciate or cry down."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c72110-97dc-408d-9c2b-719994d2c64d",
                                                "sense_id": "5ec1add3-1c39-3993-af58-3bf5c1aa7b63",
                                                "text": "Faith by her own dignity and worthiness doth not demerit justice and righteousness; but receiveth and embraceth the same offered unto us in the gospel […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
