                                        "examples": [
                                            {
                                                "example_id": "49625ebe-b1b4-4b8f-bc4e-2ca1de5dd89d",
                                                "sense_id": "090fe99e-7bd6-3f00-bd44-e5bc2c80c0e2",
                                                "text": "Die Integrationssoziologie betrachtet zentripetale Phänomene, die Segmente der Gesellschaft zusammenhalten."
                                            },
                                            {
                                                "example_id": "42ca0ff1-29fc-4ca7-8e7f-c1c7c2620114",
                                                "sense_id": "090fe99e-7bd6-3f00-bd44-e5bc2c80c0e2",
                                                "text": "„Die Leitidee für den Umbau Europas heißt also, dass die zentrifugalen Kräfte, die aus den fortbestehenden Souveränitätsansprüchen der Mitgliedstaaten sowie den sozio-ökonomischen und kulturellen Unterschieden der einzelnen Regionen erwachsen, nicht nur gebändigt, sondern in zentripetale Kräfte verwandelt werden.“"
                                            }
                                        ],
