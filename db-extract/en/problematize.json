                                        "sense_id": "9e3c4e6d-5cca-3a12-a952-8623de97cd97",
                                        "entry_id": "fce74a68-7dbe-3968-8e9c-f1284669200f",
                                        "glosses": [
                                            "etwas zur Diskussion stellen, etwas als Gesprächsgrundlage nehmen, auf eine Problematik hinweisen/eine Problematik erkennen und darüber diskutieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8afe820-85b9-4b98-b5da-92651dd8d885",
                                                "sense_id": "9e3c4e6d-5cca-3a12-a952-8623de97cd97",
                                                "text": "Endlich wurde auch die Gesamtschule problematisiert."
                                            },
                                            {
                                                "example_id": "1f134831-9f8f-40bd-b9ed-1bd4c5deaec1",
                                                "sense_id": "9e3c4e6d-5cca-3a12-a952-8623de97cd97",
                                                "text": "Zu Beginn der Falllösung war zunächst zu problematisieren, ob die zwei Freundinnen vor der Eintragung im Handelsregister schon wirksam eine KG gegründet hatten."
                                            },
                                            {
                                                "example_id": "e39c9c73-50af-4df0-a707-2d7956799e1a",
                                                "sense_id": "9e3c4e6d-5cca-3a12-a952-8623de97cd97",
                                                "text": "„Wenn ich Ihnen, geschätzte Leser*innen [sic], also »Desintegriert Euch!« zurufe, dann will ich damit auch jenen positiven deutschen Nationalismus problematisieren, der sich hinter Konzepten wie deutscher Leitkultur, jüdisch-christlichem Abendland oder der Gründung eines Heimatministeriums verbirgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd74439b-4cc1-36cc-b2a7-7ffb0c62defa",
                                        "entry_id": "fce74a68-7dbe-3968-8e9c-f1284669200f",
                                        "glosses": [
                                            "etwas zum (wissenschaftlichen) Problem erheben, etwas erschweren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c31f08f-8470-4c8a-8013-43222eb45285",
                                                "sense_id": "fd74439b-4cc1-36cc-b2a7-7ffb0c62defa",
                                                "text": "Mit deinen ganzen Bedenken problematisierst du den Umzug nur unnötig."
                                            },
                                            {
                                                "example_id": "dd636328-d337-4a3d-aefc-4a57279b00f0",
                                                "sense_id": "fd74439b-4cc1-36cc-b2a7-7ffb0c62defa",
                                                "text": "Wir sollten die Situation nicht noch mehr problematisieren, indem wir uns den Vorschlägen der anderen Abteilung nun kategorisch verweigern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
