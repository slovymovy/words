                "senses": [
                    {
                        "sense_id": "ebe83643-e767-3802-877d-9aa01bebd54b",
                        "entry_id": "b184b7a5-18e1-36e0-aef0-577270752353",
                        "glosses": [
                            "Ermittelung des Anteils der Isotopen eines Elements in einer Probe mittels Massenspektrometrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f7ede36-4bad-4195-9d09-c546ce957199",
                                "sense_id": "ebe83643-e767-3802-877d-9aa01bebd54b",
                                "text": "„Die Isotopenanalyse von Bleisärgen aus dem Rheinland hat ergeben, dass diese aus Blei aus der nahe gelegenen Eifel angefertigt worden sind.“"
                            },
                            {
                                "example_id": "f9710962-933a-4ce5-84b2-60588b3ecde9",
                                "sense_id": "ebe83643-e767-3802-877d-9aa01bebd54b",
                                "text": "„Bisher ist die Isotopenanalyse noch nicht als eine alltägliche forensische Standardmaßnahme in die kriminalpolizeilichen Ermittlungsmaßnahmen aufgenommen worden.“"
                            },
                            {
                                "example_id": "bb8fc10f-4308-4ecc-8aa5-856a5c8491af",
                                "sense_id": "ebe83643-e767-3802-877d-9aa01bebd54b",
                                "text": "„Indizien dafür haben Forscher bei der Isotopenanalyse der Knochen und Zähne von zwei Neandertalern aus französischen Höhlen gefunden.“"
                            },
                            {
                                "example_id": "e1c643b5-a382-4c6e-ac6b-b25ea971089b",
                                "sense_id": "ebe83643-e767-3802-877d-9aa01bebd54b",
                                "text": "„Eine Isotopenanalyse – mit ihr lässt sich die Region bestimmen, in der eine Pflanze aus dem Boden wuchs – zeigte, dass Maiskolben ebenso aus der Ferne zum Chaco Canyon herangeschafft wurden wie das Geschirr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
