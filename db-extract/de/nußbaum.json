                        "form": "die Nußbaum"
                    },
                    {
                        "form_id": "b4ebd68f-59ff-449a-bb2f-249f0a66ffe1",
                        "entry_id": "d265b119-e5a0-31c7-9967-eb0d79d04c39",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nußbaums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                        "entry_id": "d265b119-e5a0-31c7-9967-eb0d79d04c39",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c876520-79c0-48ff-bb4f-461677dd7749",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Frau Nußbaum ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "98f582ea-1645-41e3-9962-7d662e126b10",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Herr Nußbaum wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2166e3e4-f456-4d28-89a0-658d65fcf04b",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Die Nußbaums fahren heute nach Essen."
                            },
                            {
                                "example_id": "c6c390ae-c754-4182-a396-f24ee97e1b11",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Der Nußbaum trägt nie die Pullover, die die Nußbaum ihm strickt."
                            },
                            {
                                "example_id": "4832491a-f4b0-4e21-b649-3bbe692bfe0c",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nußbaum kommt, geht der Herr Nußbaum.“"
                            },
                            {
                                "example_id": "ecf7e5f2-6509-46d6-85b0-489dd82e6f60",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Nußbaum kommt und geht."
                            },
                            {
                                "example_id": "49427b32-bbbe-436c-8213-31acfac9b56e",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "Nußbaums kamen, sahen und siegten."
                            },
                            {
                                "example_id": "7fb401aa-ec1d-40a1-bbde-e5dd8e556eb1",
                                "sense_id": "93a306c8-1019-3aa8-91ae-c9cbe6a963d6",
                                "text": "„Das Bett war aus massivem Nußbaum – der verwirklichte Traum eines Drechslermeisters, mit Pfosten, die wie eine Kette blanker schwarzer Krocket-Kugeln aussahen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
