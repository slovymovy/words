                                "example_id": "8ca9a9a3-d0a8-4843-9f39-0d74c5b2ea9f",
                                "sense_id": "041aa295-bad8-3240-8d64-dd99cdf0141a",
                                "text": "„Weiter flussabwärts schlug er gegen ein Steilufer und vollführte einen Schwenk Richtung Süden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
