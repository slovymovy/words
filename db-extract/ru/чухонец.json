                        "examples": [
                            {
                                "example_id": "d36204bc-f3df-464c-92f7-6450c0bb2680",
                                "sense_id": "cc4f13fa-bfcc-3c79-9322-baff29962db8",
                                "text": "Из ру́сских чино́вников был оди́н бу́дочник, чухо́нец Ю́рко, уме́вший приобре́сти, несмотря́ на своё смире́нное зва́ние, осо́бенную благоскло́нность хозя́ина.",
                                "translation": "Among the Russian functionaries was a guard, Jyrko, a Finn who, despite his humble rank, had been able to acquire his master's special favor.",
                                "english": "Among the Russian functionaries was a guard, Jyrko, a Finn who, despite his humble rank, had been able to acquire his master's special favor."
                            }
                        ]
                    }
