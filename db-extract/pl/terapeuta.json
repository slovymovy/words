                    },
                    {
                        "translation_id": "b037f7b5-b729-481f-8f14-6602a9b1a5ec",
                        "source_entry_id": "4daa624a-a3f5-3044-863e-dca6cc0732cd",
                        "source_sense_id": "eac12b2c-c87d-325a-b233-a3be08f8291a",
                        "target_lang_word": "therapeut",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therapeut",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                                        "entry_id": "53091730-ab5a-3ba6-a2b9-2ac6ea5bb8f9",
                                        "glosses": [
                                            "iemand die een patiënt behandelt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a48553f-f5b0-4497-8986-8210279ef510",
                                                "sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                                                "text": "Ben je al naar de therapeut geweest?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca98cf65-2320-4061-b638-fc60293e8bd5",
                        "source_entry_id": "4daa624a-a3f5-3044-863e-dca6cc0732cd",
                        "source_sense_id": "eac12b2c-c87d-325a-b233-a3be08f8291a",
                        "target_lang_word": "Therapeut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Therapeut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                        "entry_id": "22d100a9-c5e2-3a06-89f9-6ad02bb2029f",
                                        "glosses": [
                                            "Person, die dazu ausgebildet ist, Therapien (Behandlungen) einzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d242366e-07cb-41fd-87ca-4e7676a00445",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "Zwischen Therapeut und Patient entwickelte sich ein Vertrauensverhältnis."
                                            },
                                            {
                                                "example_id": "3ccbcadb-1a21-4356-b1d2-fb7e7444a5f7",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "Mein Therapeut hat gesagt, ich soll mich nicht immer so schnell aufregen."
                                            },
                                            {
                                                "example_id": "df4022c9-4642-4589-ac5d-caa8927a08fd",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Die Abgrenzung gegen andere unkonventionelle Heilmethoden orientiert sich daran, ob Hilfsmittel eingesetzt werden. Die bloße Intention des Therapeuten reicht manchmal aus, um Krankheitsverläufe günstig zu beeinflussen\", glaubt Wiesendanger. Doch die Heiler agieren oft am Rande der Legalität.“"
                                            },
                                            {
                                                "example_id": "acb42836-31b1-44af-a541-f5c04c4f7fb0",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Man hat es auch mit Nebendarstellern wie Sven Hannawald versucht, dem RTL ein verlässlicher Therapeut geworden ist in den Tagen der Springerei.“"
                                            },
                                            {
                                                "example_id": "36ac9f21-62a3-4436-97ce-8d9a308a99b4",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Der Therapeut beobachtet den Patienten, sich selbst und die Szene und entwickelt daraus seine Beteiligungsweise, er hört zu, kommentiert und stellt gelegentlich, aber eher selten, eine Frage.“"
                                            },
                                            {
                                                "example_id": "741d48ce-5add-4b5f-ad77-bea00b0e7f5e",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Und Therapeuten wie Logopäden und andere kommen dann in die Kitas und arbeiten dort mit den Kindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2667c85c-8f38-4836-a503-d1a56c84d816",
                        "source_entry_id": "4daa624a-a3f5-3044-863e-dca6cc0732cd",
                        "source_sense_id": "eac12b2c-c87d-325a-b233-a3be08f8291a",
                        "target_lang_word": "терапевт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "терапевт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                        "entry_id": "e034ee74-1dde-36e6-84d1-5c9bfee9f047",
                                        "glosses": [
                                            "мед. врач, специалист по внутренним болезням"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8a2d91-c60b-4eb0-b730-ae63ed97a9de",
                                                "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                                "text": "Как здоровье Софьи Петровны? По-моему, ей необходимо побывать в Москве и показаться Щуровскому или другому какому-нибудь терапевту, имеющему большую практику."
                                            },
                                            {
                                                "example_id": "255016a2-4410-455e-b60e-076ba5ba9874",
                                                "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                                "text": ".. Сашу уже смотрел терапевт. — И что же? — Грипп, осложнившийся воспалением лёгких."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                        "entry_id": "e034ee74-1dde-36e6-84d1-5c9bfee9f047",
                                        "glosses": [
                                            "эвф. то же, что психотерапевт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e76d05-7f65-41b6-b82e-231bb9bf8f5f",
                                                "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                                "text": "Терапевт, несомненно, является носителем разочаровывающей реальности, особенно если он недостаточно нарциссичен для того, чтобы поддерживать идеализации жертвы. При поддержке и принятии терапевта жертва знакомится с тем, каким образом и почему она отвергает его человеческие черты и проявления — усталость, например, или равнодушие, или неготовность брать за нее ответственность и давать пошаговые рекомендации."
                                            },
                                            {
                                                "example_id": "30aa3a83-65ea-4ff6-814a-5da0b86b6e63",
                                                "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                                "text": "Если даже в рамках терапевтической сессии клиент будет удерживать взрослую позицию, сотрудничать с терапевтом, понимать, что мы делаем и зачем, то между сессиями он будет «сползать в детскую позицию», идентифицируясь с травмированной или выживающей частью личности. А, значит, будет меняться его отношение к себе, своим изменениям, терапевту и терапии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e285c8c5-c8f2-347c-b482-b1653610fc1e",
                                        "entry_id": "e034ee74-1dde-36e6-84d1-5c9bfee9f047",
                                        "glosses": [
                                            "истор. представитель еврейской секты в Александрии, представлявших одну из ветвей ессейского движения"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
