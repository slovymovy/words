                            }
                        },
                        {
                            "text": "To był bardzo piękny i wzruszający <w>ślub</w>.",
                            "target_lang_translations": {
                                "ru": "Это была очень красивая и трогательная <w>свадьба</w>.",
                                "en": "It was a very beautiful and touching <w>wedding</w>.",
                                "nl": "Het was een hele mooie en ontroerende <w>bruiloft</w>.",
