                                "target_senses": [
                                    {
                                        "sense_id": "92cab72e-321b-304b-92b5-35157d2b34d0",
                                        "entry_id": "13019b35-5b46-37fb-b666-ab27adc80107",
                                        "glosses": [
                                            "Insulting in manner or words, particularly in an arrogant or insubordinate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df0f74f-5ea9-4c64-8494-7e0e7ac1cf8c",
                                                "sense_id": "92cab72e-321b-304b-92b5-35157d2b34d0",
                                                "text": "Near-synonyms: arrogant, bold, cocky"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                        "entry_id": "13019b35-5b46-37fb-b666-ab27adc80107",
                                        "glosses": [
                                            "Rude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a83d47-d1f9-477b-87e5-221e1c2c9451",
                                                "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                                "text": "Near-synonyms: insubordinate, offensive"
                                            },
                                            {
                                                "example_id": "c5a8e209-c1d7-4286-b021-e2160a0eb32b",
                                                "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                                "text": "insolent behaviour"
                                            },
                                            {
                                                "example_id": "5455ab7d-5fa8-4d96-91ca-3f9d7ca8a2b3",
                                                "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                                "text": "insolent child"
                                            },
                                            {
                                                "example_id": "be84784a-148f-4b3d-9534-82ca7e09bce7",
                                                "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                                "text": "insolent remark"
                                            },
                                            {
                                                "example_id": "7801c77b-f474-4034-a39e-d1804ed7da54",
                                                "sense_id": "24e61333-aaa4-3f30-a3aa-d6062556351a",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers,[…]the chlorotic squatters on huge yachts, the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosus,[…]!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insolent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "596c9d20-dbeb-32a1-8cba-5ead684efda6",
                                        "entry_id": "aedbce0b-63fb-3c3b-b922-549ac97b3638",
                                        "glosses": [
                                            "A person who is insolent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c183748b-90af-44bf-bcbe-f08417dc0416",
                                                "sense_id": "596c9d20-dbeb-32a1-8cba-5ead684efda6",
                                                "text": "What a way do you put yourself in miss! said the insolent."
                                            },
                                            {
                                                "example_id": "2993c900-7e61-4e41-bd7f-abe7299b4add",
                                                "sense_id": "596c9d20-dbeb-32a1-8cba-5ead684efda6",
                                                "text": "Diogenes Laertius reports that Diogenes was apt to take the identification with the dog at face value, as when he lifted his leg and relieved himself on a group of young insolents who teased him with a dog's bone […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "263b306a-054e-4fe7-a0a8-6665c736aa11",
                        "source_entry_id": "82d8acb4-8d9f-3b75-a5ee-4a457d208eb2",
                        "source_sense_id": "ded7955a-4af8-3ecd-b42b-0d6255cd3fb7",
                        "source_sense_description": "onbeschaamd, grof, brutaal",
                        "target_lang_word": "insolent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insolent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "103454c4-7d5c-3f53-9fa6-1fece1a33cff",
                                        "entry_id": "d385bc27-f410-3960-b2ff-b7743dbae374",
                                        "glosses": [
                                            "Qui s'oppose à son supérieur, hiérarchique ou autre, de façon moqueuse ; qui perd le respect à force d’effronterie ou de hardiesse excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baea511a-265a-4a9f-a902-1eebcb525e87",
                                                "sense_id": "103454c4-7d5c-3f53-9fa6-1fece1a33cff",
                                                "text": "Un élève insolent."
                                            },
                                            {
                                                "example_id": "acf17337-c7b4-4809-9b79-4dd3582e41f9",
                                                "sense_id": "103454c4-7d5c-3f53-9fa6-1fece1a33cff",
                                                "text": "Pour la troisième fois, et sur un ton intolérablement agressif, il réitéra son insolente question. Un silence gros de danger suivit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff4c4e0-d67f-35aa-99b5-260c9d6975f9",
                                        "entry_id": "d385bc27-f410-3960-b2ff-b7743dbae374",
                                        "glosses": [
                                            "Celui qui offense la modestie, la pudeur, qui manque aux égards, aux convenances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fad24b-1c71-4231-8b81-d59ca3626d9c",
                                                "sense_id": "0ff4c4e0-d67f-35aa-99b5-260c9d6975f9",
                                                "text": "Il est insolent, fort insolent avec les femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                                        "entry_id": "d385bc27-f410-3960-b2ff-b7743dbae374",
                                        "glosses": [
                                            "Qui en use avec orgueil, avec dureté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4edc2b-7517-4a1d-9dba-ee2fb0479296",
                                                "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                                                "text": "Il ne faut pas être insolent dans la victoire, dans la bonne fortune."
                                            },
                                            {
                                                "example_id": "d4409b89-8f8b-4c0c-9a8f-80eb6485d9ae",
                                                "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                                                "text": "La prospérité l’a rendu insolent."
                                            },
                                            {
                                                "example_id": "916987f1-b03f-4a16-b5de-a525358468cb",
                                                "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                                                "text": "Les airs insolents, le ton insolent d’un parvenu."
                                            },
                                            {
                                                "example_id": "ddc48b29-f65f-4f64-824e-751cc6126058",
                                                "sense_id": "68dc39af-4cdd-38c3-84bc-0b9ab1aebb6d",
                                                "text": "Cet ordre insolent les irrita."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90670f0d-b68b-3345-8533-7dc6bfdbc989",
                                        "entry_id": "d385bc27-f410-3960-b2ff-b7743dbae374",
                                        "glosses": [
                                            "Insolite. On dit encore « bonheur insolent », « fortune insolente », « chance insolente », en parlant d’un bonheur, d’une fortune, d’une chance extraordinaire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8839e165-36ed-49a8-8163-1ef71e5242e4",
                                                "sense_id": "90670f0d-b68b-3345-8533-7dc6bfdbc989",
                                                "text": "Les Grangers avaient encore contre eux ceci qu’en un grand nombre de circonstances ils semblaient favorisés par une chance qui était au moins insolente pour les camarades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insolent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12370e8c-63c8-3580-81e9-166ac9749b58",
                                        "entry_id": "d0a7f93a-b635-3b95-a9ce-7ba93ad79246",
                                        "glosses": [
                                            "Celui qui est insolent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53eaa2e1-b61e-46f5-850c-a3a74815e314",
                                                "sense_id": "12370e8c-63c8-3580-81e9-166ac9749b58",
                                                "text": "C’est un insolent."
                                            },
