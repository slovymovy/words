                                "target_senses": [
                                    {
                                        "sense_id": "b7ce5200-7e99-3bfc-b524-ecd3088b201e",
                                        "entry_id": "8373b582-8a2b-370a-938c-e76b341a037e",
                                        "glosses": [
                                            "Qui peut être justifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94be223d-5ab9-4e6f-9c95-e1a1206c3bbb",
                                                "sense_id": "b7ce5200-7e99-3bfc-b524-ecd3088b201e",
                                                "text": "Sa violence parut justifiable."
                                            },
                                            {
                                                "example_id": "273b98b9-b3b1-447d-b0b1-0af7e99da5b0",
                                                "sense_id": "b7ce5200-7e99-3bfc-b524-ecd3088b201e",
                                                "text": "Ses procédés ne sont pas justifiables."
                                            }
