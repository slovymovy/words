{
    "word_family": [
        "конец",
        "концовка",
        "окончание",
        "закончить",
        "окончить",
        "прикончить",
        "бесконечный",
        "окончательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20576dc0-b4b7-31ba-a41f-5f78cf58b1f1",
                    "sense_definition": "Доводить дело, работу или действие до конца; завершать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "завершение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы обычно <w>кончаем</w> работу около шести часов вечера.",
                            "target_lang_translations": {
                                "de": "Wir <w>beenden</w> die Arbeit gewöhnlich gegen sechs Uhr abends."
                            }
                        },
                        {
                            "text": "Студенты уже <w>кончают</w> писать свои итоговые тесты.",
                            "target_lang_translations": {
                                "de": "Die Studenten <w>stellen</w> das Schreiben ihrer Abschlusstests schon <w>fertig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "заканчивать"
                    ],
                    "antonyms": [
                        "начинать"
                    ],
                    "common_phrases": [
                        "кончать работу",
                        "кончать с делами"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Arbeit, Tätigkeit oder Sache zu Ende führen; fertigstellen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beenden",
                                "target_lang_sense_clarification": "eine Tätigkeit zum Abschluss bringen"
                            },
                            {
                                "target_lang_word": "fertigstellen",
                                "target_lang_sense_clarification": "vollenden, ganz fertig machen"
                            },
                            {
                                "target_lang_word": "abschließen",
                                "target_lang_sense_clarification": "ein Vorhaben oder eine Arbeit zu Ende bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "949ad964-97e4-38aa-ab63-d46f6075f93c",
                    "sense_definition": "Прекращать какое-либо действие или состояние, переставать делать что-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "прекращение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>кончай</w> спорить и послушай мои аргументы.",
                            "target_lang_translations": {
                                "de": "Bitte <w>hör auf</w> zu streiten und hör dir meine Argumente an."
                            }
                        },
                        {
                            "text": "Нужно скорее <w>кончать</w> с этой пустой тратой времени.",
                            "target_lang_translations": {
                                "de": "Man muss mit dieser Zeitverschwendung schleunigst <w>Schluss machen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "кончать спорить",
                        "кончать болтать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто выражает требование или побуждение"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Mit einer Handlung oder einem Zustand aufhören; etwas einstellen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufhören",
                                "target_lang_sense_clarification": "mit etwas aufhören"
                            },
                            {
                                "target_lang_word": "Schluss machen",
                                "target_lang_sense_clarification": "eine Aktivität oder Diskussion beenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6a76d14-5e65-3b4b-a16a-4663b151e9d0",
                    "sense_definition": "Завершать обучение в учебном заведении; оканчивать курс, школу или университет.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "учёба",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой старший брат в этом году <w>кончает</w> университет.",
                            "target_lang_translations": {
                                "de": "Mein älterer Bruder <w>schließt</w> dieses Jahr die Universität <w>ab</w>."
                            }
                        },
                        {
                            "text": "Она <w>кончала</w> школу в небольшом провинциальном городке.",
                            "target_lang_translations": {
                                "de": "Sie hat die Schule in einer kleinen Provinzstadt <w>beendet</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "кончать школу",
                        "кончать университет",
                        "кончать курс"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в нейтральной речи чаще используется 'оканчивать'"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schulische oder akademische Ausbildung abschließen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abschließen",
                                "target_lang_sense_clarification": "Schule, Studium oder Ausbildung vollenden"
                            },
                            {
                                "target_lang_word": "beenden",
                                "target_lang_sense_clarification": "das Studium oder die Schulzeit zu Ende bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc9b10fc-c5c1-3400-b520-71a3564d6af6",
                    "sense_definition": "Испытывать сексуальный оргазм или эякулировать.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "физиология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он признался врачу, что слишком быстро <w>кончает</w> во время близости.",
                            "target_lang_translations": {
                                "de": "Er gestand dem Arzt, dass er bei der Intimität zu schnell <w>kommt</w>."
                            }
                        },
                        {
                            "text": "Партнёры старались не спешить и <w>кончать</w> одновременно.",
                            "target_lang_translations": {
                                "de": "Die Partner versuchten, sich Zeit zu lassen und gleichzeitig zu <w>kommen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорно-интимный регистр"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Orgasmus erleben oder ejakulieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kommen",
                                "target_lang_sense_clarification": "einen sexuellen Höhepunkt erreichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf66885-cc66-3051-aa96-86f880647d4f",
                    "sense_definition": "Лишать жизни; убивать, расправляться.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "убийство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бандиты сразу предупредили, что будут <w>кончать</w> свидетелей на месте.",
                            "target_lang_translations": {
                                "de": "Die Banditen warnten sofort, dass sie Zeugen an Ort und Stelle <w>kaltmachen</w> würden."
                            }
                        },
                        {
                            "text": "Преступники долго решали, как именно <w>кончать</w> предателя.",
                            "target_lang_translations": {
                                "de": "Die Verbrecher überlegten lange, wie genau sie den Verräter <w>erledigen</w> sollten."
                            }
                        }
                    ],
                    "synonyms": [
                        "приканчивать",
                        "мочить"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "уголовный жаргон и сниженная речь"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden umbringen, liquidieren; mit jemandem abrechnen (Jargon)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kaltmachen",
                                "target_lang_sense_clarification": "umbringen, ermorden (Jargon)"
                            },
                            {
                                "target_lang_word": "erledigen",
                                "target_lang_sense_clarification": "beseitigen, töten"
                            },
                            {
                                "target_lang_word": "umbringen",
                                "target_lang_sense_clarification": "töten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}