                "senses": [
                    {
                        "sense_id": "a6dbe53a-431a-3bd5-a20d-b312611004b1",
                        "entry_id": "a90c7e8a-c5e2-3883-ac8f-273a84f7583d",
                        "glosses": [
                            "Variante de Mélia (une océanide de la mythologie grecque)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf6c8c0-efde-485c-9cc5-24cf8bda6995",
                                "sense_id": "a6dbe53a-431a-3bd5-a20d-b312611004b1",
                                "text": "L’Amour brûla les fleuves mêmes.\nDe la nymphe Mélie Inachus, sauf erreur,\nSous la glace adora les charmes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2f82175f-3d23-3bcd-a4b3-fafcb42a25c3",
                "word": "Mélie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14067e60-28a0-34a8-bbcd-4c0adf7b274b",
                        "entry_id": "2f82175f-3d23-3bcd-a4b3-fafcb42a25c3",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3321451b-dc39-4e6a-8af0-77ff1cdd56b2",
                                "sense_id": "14067e60-28a0-34a8-bbcd-4c0adf7b274b",
                                "text": "Eh bien ! la délibération est close, viens embrasser ta Mélie, il est une heure…"
                            },
                            {
                                "example_id": "db431dc1-8ff9-4ea2-8025-c332e75732a0",
                                "sense_id": "14067e60-28a0-34a8-bbcd-4c0adf7b274b",
                                "text": "Nous avions à ce moment une servante qui s’appelait Amélie, nous disions « la Mélie » ; elle avait une figure d’homme, une large bouche et les dents cariées ; elle était laide et avait, depuis plusieurs années, coiffé sainte Catherine."
                            },
                            {
                                "example_id": "b9fe0314-7c09-4955-b0ab-a6149d9a5289",
                                "sense_id": "14067e60-28a0-34a8-bbcd-4c0adf7b274b",
                                "text": "Un petit quart-de-dieu subalterne, promu aux basses besognes de l’amour, a préservé Annie de ce que ma vieille Mélie appelait les « mauvaises maladies », il convient de l’en remercier."
                            },
                            {
                                "example_id": "a4b598ff-3674-408a-a5a8-ca2a66772042",
                                "sense_id": "14067e60-28a0-34a8-bbcd-4c0adf7b274b",
                                "text": "Mélie habite seule avec sa mère toujours fatiguée, loin de sa famille restée à l’autre bout du monde, et surtout loin de son papa dont elle ne sait rien."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
