                                "target_senses": [
                                    {
                                        "sense_id": "0e860e51-e9da-34a7-994b-385b7e5e1b76",
                                        "entry_id": "e4719a93-8b32-3f61-8ffa-c5b082cb6ab5",
                                        "glosses": [
                                            "Action d’élever ou maintenir la pression d’un lieu clos ou quasi-clos, peu importe la pression du milieu environnant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f1ddfc0-5d0a-4ddb-95cd-f3cb3b01276c",
                                                "sense_id": "0e860e51-e9da-34a7-994b-385b7e5e1b76",
                                                "text": "La pressurisation est largement utilisée dans l’aéronautique civile et militaire…"
                                            },
                                            {
                                                "example_id": "16a01327-37dd-4804-980e-a83e5e6c752b",
                                                "sense_id": "0e860e51-e9da-34a7-994b-385b7e5e1b76",
                                                "text": "Dans leur cockpit, pilote et copilote portaient en permanence un noir masque à oxygène : en cas d’accident de pressurisation dans la carlingue des passagers, eux, en tout cas, pouvaient, grâce à leur propre oxygène, rétablir la situation en chutant inhumainement jusqu’à une altitude humaine. Les accidents de pressurisation étaient fréquents dans les Tupolev et c’est sans doute ce qui avait induit les pilotes à se comporter avec une pareille sauvagerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
