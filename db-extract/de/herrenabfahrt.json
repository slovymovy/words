                    {
                        "sense_id": "61b2fe79-8341-3a33-b784-5453b0538fff",
                        "entry_id": "e08ab819-d23e-36ec-a1f7-3790691364c0",
                        "glosses": [
                            "Abfahrtslauf, an dem nur Männer teilnehmen dürfen"
                        ],
                        "tags": [
                            "Wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "a16549ee-3a3c-4795-a6db-e462bf4914d2",
                                "sense_id": "61b2fe79-8341-3a33-b784-5453b0538fff",
                                "text": "„Dass Österreich bei der Herrenabfahrt nun schon im fünften Großereignis hintereinander die Medaille verpasste, konnte man nur noch als Fiasko wahrnehmen.“"
                            },
                            {
                                "example_id": "14c6cfbd-743d-4533-a705-4346333c57ae",
                                "sense_id": "61b2fe79-8341-3a33-b784-5453b0538fff",
                                "text": "„Die größte Gefahr in Portillo kennzeichnete der Schweizer \"Sport\" schon 1963: \"Der oberste Teil der Herrenabfahrt, der Damenabfahrt und der beiden Riesenslaloms liegen im Bereich zünftiger Lawinenzüge.\" “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
