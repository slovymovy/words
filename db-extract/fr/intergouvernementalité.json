                "senses": [
                    {
                        "sense_id": "885fcb31-a4a5-3387-82a0-b8b0ed62d613",
                        "entry_id": "3414d96b-c6b3-3967-a037-c8c662a369cf",
                        "glosses": [
                            "Principe dans lequel plusieurs gouvernements d’État prennent des décisions ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106dff24-6428-494f-a90d-24d341031496",
                                "sense_id": "885fcb31-a4a5-3387-82a0-b8b0ed62d613",
                                "text": "En effet, l’intergouvernementalité implique des décisions prises à l’unanimité, alors que le supranationalisme peut recouvrir des décisions prises à la majorité."
                            },
                            {
                                "example_id": "8811b251-2b90-490d-a059-474f8ef28163",
                                "sense_id": "885fcb31-a4a5-3387-82a0-b8b0ed62d613",
                                "text": "L’approfondissement du processus intégrationniste du MERCOSUD, obéissant aux principes d’intergouvernementalité, s’inscrit dans l’esprit de la sauvegarde des souverainetés encore très chères aux pays latino-américains."
                            }
                        ]
                    }
