                                        "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                        "entry_id": "687d7e48-2385-3ddc-8c73-f5a0f3727d20",
                                        "glosses": [
                                            "A hair pomade, making the hair shine brilliantly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93aeca22-0334-4e69-9d84-2c349d81ae18",
                                                "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                                "text": "The hairdresser's shop was warm and glittering. It smelled of soap and burnt paper and wallflower brilliantine."
                                            },
                                            {
                                                "example_id": "a1715c29-67f4-4b36-8e6c-3bf25297191f",
                                                "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                                "text": "\"I wouldn't regret it,\" said Linda, \"if I took Eileen by the shoulders and shook her till I shook the rouge off her cheek, and the brilliantine off her hair, and a million mean little subterfuges out of her soul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93a8789-0cb7-3277-9062-5173f87d7d20",
                                        "entry_id": "687d7e48-2385-3ddc-8c73-f5a0f3727d20",
                                        "glosses": [
                                            "A smooth shiny, luxurious fabric, often of alpaca or vicuña."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae183d30-06c3-41c2-8b62-bb10a544a22c",
                                                "sense_id": "d93a8789-0cb7-3277-9062-5173f87d7d20",
                                                "text": "Bathing Suit of Brilliantine in Navy Blue and Black, trimmed with white mohair braid and buttons (no bloomers). Special 3.95"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
