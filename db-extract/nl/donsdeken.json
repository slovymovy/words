                                "target_senses": [
                                    {
                                        "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                        "entry_id": "0937ca85-14c4-3b29-94d5-a294b1b53421",
                                        "glosses": [
                                            "Bettdecke, die mit Federn gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7cc854f-03cc-4040-b5d5-359e470f4e49",
                                                "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                                "text": "„Menschen, die auf Milben allergisch reagieren, sollten sich im Schlafbereich für ein Federbett für Allergiker entscheiden, um damit ruhige Nächte zu haben.“"
                                            },
                                            {
                                                "example_id": "b730f627-50d2-48a6-a980-65dff3c794b4",
                                                "sense_id": "37f0743b-da56-3ac1-8671-9ade34c592a8",
                                                "text": "„Die Bäuerin bringt uns sogar Federbetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4294c1b9-fb26-41aa-9df5-5519bea70bba",
                        "source_entry_id": "77797d15-52a1-3f8a-8ab3-816b76b5a94b",
                        "source_sense_id": "9f8e80c4-10ec-3f36-88b2-cb9d66ae812f",
                        "target_lang_word": "comforter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comforter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b0e0b04-cb75-3416-9ba3-3ce109f939b8",
                                        "entry_id": "476b42eb-0795-364c-9477-fe02f3db3f3a",
                                        "glosses": [
                                            "A person who comforts someone who is suffering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706b1a4d-aeac-4adb-8993-5cab10a3bc9b",
                                                "sense_id": "5b0e0b04-cb75-3416-9ba3-3ce109f939b8",
                                                "text": "Let no comforter delight mine ear / But such a one whose wrongs do suit with mine."
                                            },
                                            {
                                                "example_id": "9525d849-8e1d-40ff-82e9-9be96010cd45",
                                                "sense_id": "5b0e0b04-cb75-3416-9ba3-3ce109f939b8",
                                                "text": "The comforters, relaxed in sarongs after the day's work, kicked off their sandals at the top of Syed Omar's steps and made their obeisances to the wives, to the elder children, and to the gloomy head of the house."
                                            },
                                            {
                                                "example_id": "22bf7057-830c-4668-b908-5cf16101f999",
                                                "sense_id": "5b0e0b04-cb75-3416-9ba3-3ce109f939b8",
                                                "text": "There are 157 men with AIDS/ARC in the small unit where I am housed. Many of us are abandoned by friends, family, lovers and spiritual comforters. And this is why I am reaching out to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f677b633-b62d-389e-b6f2-1a2d744ead19",
                                        "entry_id": "476b42eb-0795-364c-9477-fe02f3db3f3a",
                                        "glosses": [
                                            "A padded cover for a bed, duvet, continental quilt."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66c03fa-1f32-4d58-888c-dc82f500560a",
                                                "sense_id": "f677b633-b62d-389e-b6f2-1a2d744ead19",
                                                "text": "A vast quilt or comforter was heaped beside the bed, in a broad puddle of congealed blood, thick and shiny on the patterned rugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a991cbb1-931e-3da5-8159-94da8feb9fb5",
                                        "entry_id": "476b42eb-0795-364c-9477-fe02f3db3f3a",
                                        "glosses": [
                                            "A woollen scarf for winter."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c502cb-b0a2-4de1-8c77-d16c1792d970",
                                                "sense_id": "a991cbb1-931e-3da5-8159-94da8feb9fb5",
                                                "text": "[…] round his neck he wore a flaming red worsted comforter, whereof the straggling ends peeped out beneath his threadbare Newmarket coat, which was very tight and buttoned all the way up."
                                            },
                                            {
                                                "example_id": "2e2f3575-987f-4b0b-a6f2-bdd50ae36ff4",
                                                "sense_id": "a991cbb1-931e-3da5-8159-94da8feb9fb5",
                                                "text": "The American schoolboy takes off his comforter and unbuttons his jacket before going in for a snowball fight."
                                            },
                                            {
                                                "example_id": "6a69ff78-d20b-4857-ae6e-8efcd985d198",
                                                "sense_id": "a991cbb1-931e-3da5-8159-94da8feb9fb5",
                                                "text": "“[…] Captain Markam had been found lying half-insensible, gagged and bound, on the floor of the sitting-room, his hands and feet tightly pinioned, and a woollen comforter wound closely round his mouth and neck; whilst Mrs. Markham's jewel-case, containing valuable jewellery and the secret plans of Port Arthur, had disappeared. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2662c9f5-9e24-3ace-91d3-cccb2c0ac0f9",
                                        "entry_id": "476b42eb-0795-364c-9477-fe02f3db3f3a",
                                        "glosses": [
                                            "A pacifier."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
