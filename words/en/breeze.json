{
    "word_family": [
        "breezy",
        "breezily",
        "breeziness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8f02dca-22e8-33d8-b686-af8c46dd0242",
                    "sense_definition": "A light, gentle wind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cool <w>breeze</w> came through the open window.",
                            "target_lang_translations": {
                                "ru": "В открытое окно подул прохладный <w>ветерок</w>.",
                                "zh": "一阵凉爽的<w>微风</w>从打开的窗户吹了进来。"
                            }
                        },
                        {
                            "text": "We enjoyed the fresh sea <w>breeze</w> while walking on the beach.",
                            "target_lang_translations": {
                                "ru": "Гуляя по пляжу, мы наслаждались свежим морским <w>бризом</w>.",
                                "zh": "我们在海滩散步时，享受着清新的海<w>风</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gentle breeze",
                        "sea breeze",
                        "cool breeze",
                        "stiff breeze",
                        "light breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лёгкий, нежный ветер.",
                        "zh": "轻柔的微风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветерок",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное, общий термин"
                            },
                            {
                                "target_lang_word": "бриз",
                                "target_lang_sense_clarification": "обычно морской или береговой ветер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微风",
                                "target_lang_sense_clarification": "指轻微的风"
                            },
                            {
                                "target_lang_word": "清风",
                                "target_lang_sense_clarification": "指凉爽舒适的微风"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "492ab67d-c1f5-32e9-89f4-efb372b69c39",
                    "sense_definition": "Any activity that is easy, not testing or difficult.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_easy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After studying Latin for years, learning Spanish was a <w>breeze</w>.",
                            "target_lang_translations": {
                                "ru": "После многолетнего изучения латыни выучить испанский было сущим <w>пустяком</w>.",
                                "zh": "有了多年学习拉丁语的基础，学西班牙语简直是<w>小菜一碟</w>。"
                            }
                        },
                        {
                            "text": "The final exam was a <w>breeze</w> because I had prepared well.",
                            "target_lang_translations": {
                                "ru": "Финальный экзамен оказался <w>проще простого</w>, так как я хорошо подготовился.",
                                "zh": "因为准备充分，期末考试对我来说<w>轻而易举</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piece of cake",
                        "walk in the park",
                        "cinch",
                        "cakewalk",
                        "doddle"
                    ],
                    "common_phrases": [
                        "be a breeze"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe tasks that require little effort."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое занятие, которое дается легко, не требуя усилий.",
                        "zh": "指非常容易、不费吹灰之力就能完成的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "лёгкое дело, нечто незначительное"
                            },
                            {
                                "target_lang_word": "проще простого",
                                "target_lang_sense_clarification": "идиома, означающая очень лёгкую задачу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小菜一碟",
                                "target_lang_sense_clarification": "形容事情非常容易"
                            },
                            {
                                "target_lang_word": "轻而易举",
                                "target_lang_sense_clarification": "形容事情很容易做到"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be5427d2-7966-3183-9e4c-66a5bc687502",
                    "sense_definition": "To move casually, in a carefree manner; often used to describe entering a place confidently or completing a task easily.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_easy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>breezed</w> into the meeting room as if she were not late at all.",
                            "target_lang_translations": {
                                "ru": "Она <w>впорхнула</w> в переговорную, как будто совсем не опоздала.",
                                "zh": "她<w>轻松地走进</w>会议室，好像根本没迟到一样。"
                            }
                        },
                        {
                            "text": "He <w>breezed</w> through the security check at the airport without any issues.",
                            "target_lang_translations": {
                                "ru": "Он без проблем <w>проскочил</w> проверку безопасности в аэропорту.",
                                "zh": "他毫无阻碍地<w>顺利通过</w>了机场安检。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breeze in",
                        "breeze through",
                        "breeze past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться непринужденно, беззаботно; уверенно входить или легко справляться с делом.",
                        "zh": "指轻松、自信地进入某处或顺利地完成某项任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впорхнуть",
                                "target_lang_sense_clarification": "легко и быстро войти"
                            },
                            {
                                "target_lang_word": "проскочить",
                                "target_lang_sense_clarification": "быстро и легко пройти через что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻松进入",
                                "target_lang_sense_clarification": "形容自信地进入某地"
                            },
                            {
                                "target_lang_word": "顺利通过",
                                "target_lang_sense_clarification": "形容毫不费力地完成某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2042c2e-600b-3fc9-bde8-eb718dccb7c4",
                    "sense_definition": "To blow gently.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A soft wind <w>breezed</w> through the trees on the hillside.",
                            "target_lang_translations": {
                                "ru": "Мягкий ветер <w>веял</w> сквозь деревья на склоне холма.",
                                "zh": "柔和的微风在山坡的树林间<w>吹拂</w>。"
                            }
                        },
                        {
                            "text": "The cool air <w>breezed</w> gently against her face.",
                            "target_lang_translations": {
                                "ru": "Прохладный воздух нежно <w>обдувал</w> её лицо.",
                                "zh": "凉爽的空气轻轻地<w>吹拂</w>着她的脸庞。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабо дуть, веять.",
                        "zh": "指微风轻轻吹拂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веять",
                                "target_lang_sense_clarification": "о слабом ветре"
                            },
                            {
                                "target_lang_word": "обдувать",
                                "target_lang_sense_clarification": "касаться потоком воздуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吹拂",
                                "target_lang_sense_clarification": "指风轻轻掠过"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2b725286-77d9-3a5e-ab1b-03b21c17443d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Breeze</w> has lived in this neighborhood for over fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бриз</w> живет в этом районе уже более пятидесяти лет.",
                                "zh": "<w>布里斯</w>先生在这个社区已经住了五十多年了。"
                            }
                        },
                        {
                            "text": "I asked Sarah <w>Breeze</w> to join our project team next week.",
                            "target_lang_translations": {
                                "ru": "Я попросил Сару <w>Бриз</w> присоединиться к нашей проектной группе на следующей неделе.",
                                "zh": "我邀请了莎拉·<w>布里斯</w>下周加入我们的项目团队。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бриз",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布里斯",
                                "target_lang_sense_clarification": "姓氏的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}