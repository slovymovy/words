                        "glosses": [
                            "Donner un coup de boule."
                        ],
                        "tags": [
                            "Très rare",
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "25e33729-008f-497a-8fc5-e149c840288c",
                                "sense_id": "1dce5e38-6202-38f3-8301-111290bb13d0",
                                "text": "La manipulation des pièces n’est pas non plus très pratique, ce qui pourra vous faire coup-de-bouliser l’écran lorsqu’une seule pièce fera s’écrouler tout votre rang aimanté pour un petit frottement ridicule."
                            },
                            {
                                "example_id": "32f755fa-4750-4aff-b56d-7626585ad331",
                                "sense_id": "1dce5e38-6202-38f3-8301-111290bb13d0",
                                "text": "On ne va pas coup-de-bouliser les gens en cette fin de siècle."
                            },
                            {
                                "example_id": "e0bbbe79-6293-4b36-b551-2aa0b375f942",
                                "sense_id": "1dce5e38-6202-38f3-8301-111290bb13d0",
                                "text": "Ca vous a pas donné envie de coup-de-bouliser bien fort la ou les personnes que vous avez eu au bout du fil ?"
                            }
                        ]
                    }
