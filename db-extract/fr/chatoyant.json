                    {
                        "translation_id": "d2a46e33-10ed-4628-b12b-e4cc33f1efbb",
                        "source_entry_id": "ed5a829a-0e52-3464-9b0e-a88afe86e709",
                        "target_lang_word": "kleurrijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kleurrijk",
