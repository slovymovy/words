                "senses": [
                    {
                        "sense_id": "146d413f-fc6f-36c2-8369-b4f6196c6818",
                        "entry_id": "20f2ab6c-deab-3984-aa41-1ad9752c3e66",
                        "glosses": [
                            "zum mexikanischen Bundesstaat Quintana Roo gehörende, östlich von Yucatán gelegene Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a22f44d-ae22-494c-bb44-c27cd7f0b838",
                                "sense_id": "146d413f-fc6f-36c2-8369-b4f6196c6818",
                                "text": "„Weiter nach Osten entlang der Küste war die Insel Cozumel neben anderen eine weitere solch neutrale Zone.“"
                            },
                            {
                                "example_id": "da6aaea5-86a6-4871-bc26-9a6fa8edaf06",
                                "sense_id": "146d413f-fc6f-36c2-8369-b4f6196c6818",
                                "text": "„Beim Zwischenhalt auf der Insel Cozumel überprüfte Cortés - dem Chronisten und Konquistador Bernal Díaz zufolge - die Listen der Teilnehmer und ihrer mitgebrachten Pferde und Waffen: Es gab 32 Armbrust- und 13 Gewehrschützen, vier leichte Kanonen (Falkonette) und 16 Pferde.“"
                            },
                            {
                                "example_id": "f3992c0c-c282-4977-8d50-d159c3161c39",
                                "sense_id": "146d413f-fc6f-36c2-8369-b4f6196c6818",
                                "text": "„Die Flotte erreichte zunächst die Insel Cozumel, die am Feiertag des Heiligen Kreuzes am 3. Mai 1518 erstmals gesichtet wurde und die von nun an Santa Cruz heißen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
