                                    {
                                        "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Qui concerne la poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd8733b-7b29-4d07-8df7-c4cf85ddb3ef",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Style poétique."
                                            },
                                            {
                                                "example_id": "74d9b0d9-07d2-411e-a732-3e53b0a94ce9",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Génie Poétique."
                                            },
                                            {
                                                "example_id": "78e728e6-d99c-4318-9167-0905c0b951e3",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Imagination poétique."
                                            },
                                            {
                                                "example_id": "f2b45a10-7cc7-4adb-8128-837f219f9bab",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Enthousiasme poétique."
                                            },
                                            {
                                                "example_id": "e22e44fc-dffa-4927-acfb-94edfbe509f1",
                                                "sense_id": "45d0e48b-fae9-36e5-8f2e-47f47a51d027",
                                                "text": "Licence poétique se dit de certaines libertés que les poètes se donnent dans leurs vers, contre les règles ordinaires de la langue ou de la versification, et qui ne seraient pas reçues dans la prose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5968a283-e36e-3fad-9978-73d28601e0c7",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Qui concerne la poésie.",
                                            "Il se dit, par ironie, d’une altération de la vérité."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fa87a55-838b-4c86-afaf-f1cab98effa3",
                                                "sense_id": "5968a283-e36e-3fad-9978-73d28601e0c7",
                                                "text": "Il y a dans ce récit des licences poétiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                        "entry_id": "55883ec8-ddaf-34e8-8549-c745ce422750",
                                        "glosses": [
                                            "Ce qui est relatif aux qualités de la poésie, de ce qui en offre les caractères d’élévation, d’inspiration, d’images, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c68352-e9e5-49e3-9618-2dfe5ba578d6",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Le sentiment poétique."
                                            },
                                            {
                                                "example_id": "a001d353-da45-44c3-8cfb-bba7d9dfc4e8",
                                                "sense_id": "ef4a7228-99b7-317a-a9ee-99b5ae50efc6",
                                                "text": "Prose poétique."
                                            },
                                            {
