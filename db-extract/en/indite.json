                        "target_lang_word": "verfassen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verfassen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55b9e325-0d6e-35a4-9426-3eea04b88662",
                                        "entry_id": "4928c507-7c25-3a27-b08f-83b9e02a8c5b",
                                        "glosses": [
                                            "(einen Text) erstellen und schriftlich niederlegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc0dc26-8039-4eb9-aa88-45452088f6d4",
                                                "sense_id": "55b9e325-0d6e-35a4-9426-3eea04b88662",
                                                "text": "Wer hat dieses Pamphlet verfasst?"
                                            },
                                            {
                                                "example_id": "aa13df9e-857f-4e59-a13e-e398eec07938",
                                                "sense_id": "55b9e325-0d6e-35a4-9426-3eea04b88662",
                                                "text": "„Bereits im vorigen Herbst hatte Nordrhein-Westfalen eine Bundesratsinitiative verfasst.“"
                                            },
                                            {
                                                "example_id": "351835ff-6bf6-4b1d-9edf-d686d129b896",
                                                "sense_id": "55b9e325-0d6e-35a4-9426-3eea04b88662",
                                                "text": "„Die meisten Artikel [Anmerkung: in der Wikipedia] über Afrika oder die arabische Welt wurden von Europäern verfasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a1a7f5-d2ab-48db-abaf-2d2c733caddf",
                        "source_entry_id": "67d44fa7-1487-3709-b543-e60d015e3657",
                        "source_sense_description": "to compose",
                        "target_lang_word": "niederschreiben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niederschreiben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f9a426-1f02-3cb6-bb62-d1563ae2a0b9",
                                        "entry_id": "d99dfde9-3754-3507-ac80-a4b8d6f2b3fa",
                                        "glosses": [
                                            "etwas schriftlich verfassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfcfc28c-2a4b-43dc-b5f5-7f0fe837906f",
                                                "sense_id": "e2f9a426-1f02-3cb6-bb62-d1563ae2a0b9",
                                                "text": "„Die eigene Meinung bezüglich der Schulpflicht sollte für eine bestimmte Adressatin niedergeschrieben und begründet werden.“"
                                            },
                                            {
                                                "example_id": "6b2f4a1b-bafd-4795-926d-833d5b02e038",
                                                "sense_id": "e2f9a426-1f02-3cb6-bb62-d1563ae2a0b9",
                                                "text": "„Da mich Squire Trelawney, unser Gutsherr, Dr. Livesey und die übrigen Herren ersucht haben, alles über die Schatzinsel von Anfang bis Ende niederzuschreiben und nur die Lage der Insel zu verschweigen, allein aus dem Grunde, weil noch immer ungehobene Schätze dort liegen, so ergreife ich die Feder im Jahre des Herrn 17.. und versetze mich zurück in die Zeit, da mein Vater das Gasthaus zum ‚Admiral Benbow‘ besaß und der wettergebräunte alte Seemann mit der Säbelnarbe sich unter unserem Dach einquartierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
