                        "entry_id": "067baa74-bab6-3fda-9cdf-a45d3f29c3d6",
                        "glosses": [
                            "Alosa pseudoharengus, a species of small freshwater fish, also known as the alewife."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "be5e115a-cfab-49a9-b5d3-0bca1e6b3fc9",
                                "sense_id": "1096dbec-3e98-31a7-89b9-5c6fbca6307c",
                                "text": "Common names for the alewife are gaspereau, river herring, sawbelly, or kiack."
                            },
                            {
                                "example_id": "809ef63b-d45d-4b9c-ab43-d3e476392d7a",
                                "sense_id": "1096dbec-3e98-31a7-89b9-5c6fbca6307c",
                                "text": "Finally, I visited a group of kiack fishermen down in Argyle. This was a new fishery to me. The kiack (also called gaspereau and alewife in other areas) is fished with a dip net out of small brooks in the Tusket River area."
                            }
                        ]
