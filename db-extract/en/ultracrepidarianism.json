                                "target_senses": [
                                    {
                                        "sense_id": "e1df4e21-f252-34a7-a0e4-cc6ae17babef",
                                        "entry_id": "b2773fc3-e6a0-3df6-93df-feffa110881f",
                                        "glosses": [
                                            "Comportement qui consiste à donner son avis sur des sujets à propos desquels on n’a pas de compétence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87dac837-ebcc-44fa-a344-b4150b8dd65d",
                                                "sense_id": "e1df4e21-f252-34a7-a0e4-cc6ae17babef",
                                                "text": "Ainsi que le rappelait hier sur Twitter Marc Andreessen, cofondateur de Netscape et désormais capital-risqueur, l’ultracrepidarianisme est la pratique consistant à donner son avis sur des sujets à propos desquels on n’a aucune compétence."
                                            },
                                            {
                                                "example_id": "5eb72ddf-edcd-4e88-ae8f-d273bcd14f87",
                                                "sense_id": "e1df4e21-f252-34a7-a0e4-cc6ae17babef",
                                                "text": "On peut rapprocher l’effet Dunning-Kruger de l’ultracrépidarianisme, qui désigne le fait de donner son avis ou ses conseils sur des sujets à propos desquels on n’a très peu, voire aucune compétence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
