                                        "entry_id": "8cc99a8d-6465-3244-9e4a-7e77b44e4ec0",
                                        "glosses": [
                                            "toestand waarin je vastzit en je niet meer vrij kan bewegen, meestal doordat iets om je heen is gewikkeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9740a4e-a546-4876-8901-53cea0acb9c5",
                                                "sense_id": "ce177e18-a9ad-3184-a764-c1105193a4b6",
                                                "text": "Verstrikking is een serieus gevaar voor walvissen en dolfijnen. Bij een telling van bultruggen voor de kust van Alaska (Journal of Biogeography, 2007), droeg zeventig procent van de bultruggen littekens op mond of staart, veroorzaakt door netten, touwen en ander visgerei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee973e94-8b5d-354d-9857-94c0cebc115c",
                                        "entry_id": "8cc99a8d-6465-3244-9e4a-7e77b44e4ec0",
                                        "glosses": [
                                            "verwarring die het gevolg is van een ingewikkelde situatie of slimmigheden van een ander"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e692a1d2-b249-4df2-9bc1-90f7d88c4221",
                                                "sense_id": "ee973e94-8b5d-354d-9857-94c0cebc115c",
                                                "text": "Hij was een schrijver in spe met een uitgesproken besef van zijn uniciteit, maar zijn verstrikking leek op die van honderdduizenden andere Duitse soldaten."
                                            },
                                            {
                                                "example_id": "b6a42443-7458-436c-bbbe-a00f67f7d061",
                                                "sense_id": "ee973e94-8b5d-354d-9857-94c0cebc115c",
                                                "text": "En wat is een goede thriller? „Die laat verstrikkingen zien, in de hoop dat de lezer er iets van leert.”"
                                            }
                                        ]
                                    }
                                ]
                            }
