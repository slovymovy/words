                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ab24b57-5a28-31ed-bdd7-b6fcdbbe0cb1",
                                        "entry_id": "8f11215d-ffa3-3c32-aac6-22453bb8aa92",
                                        "glosses": [
                                            "Voiture hippomobile de louage conduite par un cocher, que l’on utilisait à la course ou à l’heure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019ced25-0888-4f3e-b567-3ded3c53c068",
                                                "sense_id": "8ab24b57-5a28-31ed-bdd7-b6fcdbbe0cb1",
                                                "text": "Un fiacre allait, trottinant, cahin, caha, hu, dia, hop là\nUn fiacre allait, trottinant, jaune, avec un cocher blanc"
                                            },
                                            {
                                                "example_id": "4cb097cc-2ea4-47bf-9a79-827dc344f904",
                                                "sense_id": "8ab24b57-5a28-31ed-bdd7-b6fcdbbe0cb1",
                                                "text": "Mon cœur battait la chamade, cependant que le fiacre s'approchait de l'église Notre-Dame à pas de tortue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79565657-dd0d-3c86-ad25-a9c67fec38e5",
                                        "entry_id": "8f11215d-ffa3-3c32-aac6-22453bb8aa92",
                                        "glosses": [
                                            "(Argot) Fesses, arrière-train, fessier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9e2ebb4-c241-4dcb-b5a1-2d6ee54cd3ba",
                        "source_entry_id": "721700b1-9cfa-3274-8f16-09e709fac313",
                        "source_sense_id": "71f71962-d628-357b-b0fd-3b1592fba111",
                        "source_sense_description": "small carriage for hire",
                        "target_lang_word": "Fiaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fiaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "Mietkutsche mit zwei Pferden"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33a391e-c996-47e2-9d84-56b57310abd0",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„Er eilte die Treppe hinab, setzte sich in den nächsten Fiaker und fuhr aufs Land.“"
                                            },
                                            {
                                                "example_id": "6dc484e6-4b85-4a84-915c-5c3bf140f07b",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„In den engen Gassen der historischen Altstadt war der Fiaker umgestürzt, was die Tiere aber nur weiter aufgestachelt hatte.“"
                                            },
                                            {
                                                "example_id": "1ffc4c23-7959-44f0-b3c2-a1fd587e3ce1",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "„Ich nahm den erstbesten Fiaker, den ich fand, und fuhr zu Patu, dem ich wutschnaubend mein Erlebnis erzählte.“"
                                            },
                                            {
                                                "example_id": "9f4c7be7-8391-42a1-a378-e3b9806d5295",
                                                "sense_id": "077a2db6-b3ec-3816-933e-777d9ade20e2",
                                                "text": "In Wien sind die Fiaker heute eine beliebte Touristenattraktion."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "Fahrer, Lenker eines Fiakers^([1])"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1091d879-c91e-41c0-ae98-4b5b93cadde0",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Die Fiaker vor dem Bahnhofe machten mir ihre komfortabelsten Gesichter, nannten mich »Herr Baron« und als mir das nicht zu genügen schien, »Herr Graf«; ich aber versetzte ohne allen Adelsstolz: »Nein, meine Herren, jetzt wird gegangen.«“"
                                            },
                                            {
                                                "example_id": "5cfa6acd-7388-493f-820d-bf4dae84fff3",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Und dem Fiaker müsse man nun auch ein übermäßiges Trinkgeld geben.“"
                                            },
                                            {
                                                "example_id": "def5110a-3173-4aaf-a137-096e3abfe8ef",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "„Unglaubwürdig laut, so als hätten die Fiaker verborgene Lautsprecher integriert, die den perfekten Hufsound verstärken, knallten die traurigen Gäule ihre Eisen aufs Pflaster.“"
                                            },
                                            {
                                                "example_id": "2049f17a-aed8-4db0-8d7f-5707c334feef",
                                                "sense_id": "14a875c6-6234-3a82-8a25-98cccb5cc040",
                                                "text": "In Wien sind die Fiaker heute eine beliebte Touristenattraktion."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0d9c2e1-cde1-3ac6-a276-661e52b7f20a",
                                        "entry_id": "aa6daf44-2cc0-3abc-b8d7-2b13602cb784",
                                        "glosses": [
                                            "großer Mokka im Glas mit viel Zucker und einem Stamperl Sliwowitz oder Rum"
                                        ],
                                        "tags": [
                                            "Wien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4b9eca-b381-42f6-803c-e752f9140291",
                                                "sense_id": "b0d9c2e1-cde1-3ac6-a276-661e52b7f20a",
                                                "text": "Einen Fiaker bitte, ein Glas Wasser, Zahnstocher und die Zeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
