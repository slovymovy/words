                                "target_senses": [
                                    {
                                        "sense_id": "3c5f3ed5-8a25-3187-8526-c04c72de4f4d",
                                        "entry_id": "dc4b2a0c-cfac-3d81-9741-923d24b82bff",
                                        "glosses": [
