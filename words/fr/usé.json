                    "sense_id": "c7f0ccc7-af77-3cc9-8744-7e840985ebef",
                    "sense_definition": "Détérioré ou abîmé par le temps, le frottement ou un long usage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deteriore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il porte un manteau <w>usé</w> qui ne le protège plus vraiment du froid d'hiver.",
                            "target_lang_translations": {
                                "en": "He wears a <w>worn</w> coat that no longer really protects him from the winter cold.",
                                "ru": "Он носит <w>поношенное</w> пальто, которое уже не защищает его по-настоящему от зимнего холода.",
                                "nl": "Hij draagt een <w>versleten</w> jas die hem niet meer echt beschermt tegen de winterkou.",
                                "pl": "Nosi <w>znoszony</w> płaszcz, który już naprawdę nie chroni go przed zimowym chłodem.",
                                "it": "Indossa un cappotto <w>logoro</w> che non lo protegge più davvero dal freddo invernale.",
                                "cs": "Nosí <w>obnošený</w> kabát, který ho už opravdu nechrání před zimním chladem.",
                                "tr": "Kışın soğuğundan onu artık pek koruyamayan <w>yıpranmış</w> bir palto giyiyor.",
                                "es": "Lleva un abrigo <w>gastado</w> que ya no lo protege de verdad del frío invernal.",
                                "zh": "他穿着一件<w>破旧</w>的大衣，已经挡不住冬天的严寒了。",
                                "de": "Er trägt einen <w>abgetragenen</w> Mantel, der ihn vor der Winterkälte nicht mehr richtig schützt."
                            }
                        },
                        {
                            "text": "Ces vieilles chaussures sont tellement <w>usées</w> que la semelle commence à se détacher.",
                            "target_lang_translations": {
                                "en": "These old shoes are so <w>worn</w> that the sole is starting to come off.",
                                "ru": "Эти старые туфли так <w>изношены</w>, что подошва начинает отходить.",
                                "nl": "Deze oude schoenen zijn zo <w>versleten</w> dat de zool begint los te komen.",
                                "pl": "Te stare buty są tak <w>zużyte</w>, że podeszwa zaczyna się odklejać.",
                                "it": "Queste vecchie scarpe sono così <w>logore</w> che la suola comincia a staccarsi.",
                                "cs": "Ty staré boty jsou tak <w>opotřebované</w>, že podrážka se začíná odlepovat.",
                                "tr": "Bu eski ayakkabılar o kadar <w>yıpranmış</w> ki tabanı sökülmeye başlıyor.",
                                "es": "Estos zapatos viejos están tan <w>gastados</w> que la suela empieza a despegarse.",
                                "zh": "这双旧鞋已经<w>破旧</w>不堪，鞋底开始脱落了。",
                                "de": "Diese alten Schuhe sind so <w>abgenutzt</w>, dass sich die Sohle zu lösen beginnt."
                            }
                        }
                    ],
