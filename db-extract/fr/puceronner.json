                "senses": [
                    {
                        "sense_id": "18a85020-dd6e-3bb0-bf46-3d5e281b2868",
                        "entry_id": "0378e7af-4ebf-3747-a64e-ff656d3c654d",
                        "glosses": [
                            "Consommer des pucerons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136215ec-63d4-480e-ae1d-289795dcd387",
                                "sense_id": "18a85020-dd6e-3bb0-bf46-3d5e281b2868",
                                "text": "Un couple de Nonnettes \"puceronnent\" sur un Cactus dans le jardin."
                            },
                            {
                                "example_id": "8e608a06-88b1-47db-a5af-443238e19f45",
                                "sense_id": "18a85020-dd6e-3bb0-bf46-3d5e281b2868",
                                "text": "avant que les animaux sauvages régulateurs s’implantent sur le terrain pour consommer les fourmis, ces dernières préfèreront puceronner sur les acacias, et sureau en priorité."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bce73e3-0ee6-3738-93a6-042ea9a3a535",
                        "entry_id": "0378e7af-4ebf-3747-a64e-ff656d3c654d",
                        "glosses": [
                            "Travailler en groupe comme des pucerons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb76ea2-ba14-4954-8909-ab13a1bc56df",
                                "sense_id": "2bce73e3-0ee6-3738-93a6-042ea9a3a535",
                                "text": "Tout s’étale en violence, les formes, les machines, le minium qui explose, le bleu qui hurle, les casques jaunes des ouvriers qui puceronnent sur les flancs d’un méthanier en construction."
                            },
                            {
                                "example_id": "d55aff56-4833-4629-96b1-f330b5f12184",
                                "sense_id": "2bce73e3-0ee6-3738-93a6-042ea9a3a535",
                                "text": "C’est dans sa tête que les cartes se jouent, que les dés roulent, que les neurones puceronnent."
                            }
                        ]
                    }
                ],
