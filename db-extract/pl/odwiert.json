                "senses": [
                    {
                        "sense_id": "789f0145-2d15-3ca1-8791-c937f6a09d6a",
                        "entry_id": "60b824da-ee45-3cc4-9436-8c4fc7019c9e",
                        "glosses": [
                            "wykonanie otworu w ziemi przy pomocy wprawianego w ruch obrotowy narzędzia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d258e4e-5180-4a39-a2db-e511bdc2c2e8",
                                "sense_id": "789f0145-2d15-3ca1-8791-c937f6a09d6a",
                                "text": "Policjanci przybyli na miejsce odwiertu znaleźli samochód ciężarowy marki Kamaz z naczepą przystosowaną do przewozu paliw."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "45ee7b04-5a70-341e-9c2f-bd58dac78690",
                        "entry_id": "60b824da-ee45-3cc4-9436-8c4fc7019c9e",
                        "glosses": [
                            "wąski, głęboki otwór wywiercony w ziemi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cbcb314-445b-45b7-868b-a54e4ac5c067",
                                "sense_id": "45ee7b04-5a70-341e-9c2f-bd58dac78690",
                                "text": "Docierające do nas informacje mówią o dziesiątkach podpalonych przez uciekających popleczników Husajna odwiertach i rafineriach ropy naftowej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
