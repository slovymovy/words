                {
                    "sense_id": "6d10bbdd-f4e8-3bd4-a08f-592a2e24d653",
                    "sense_definition": "Употребляется для выражения намерения или предпочтения совершить какое-либо действие.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я, <w>пожалуй</w>, пойду домой, так как уже поздно.",
                            "target_lang_translations": {
                                "en": "<w>I think I'll</w> go home, since it's already late.",
                                "nl": "<w>Ik denk dat ik</w> naar huis ga, aangezien het al laat is.",
                                "pl": "<w>Chyba pójdę</w> już do domu, bo jest późno.",
                                "de": "<w>Ich werde wohl</w> nach Hause gehen, da es schon spät ist.",
                                "fr": "<w>Je crois que je vais</w> rentrer, car il est déjà tard.",
                                "it": "<w>Quasi quasi vado</w> a casa, visto che è già tardi.",
                                "cs": "<w>Asi</w> půjdu domů, protože už je pozdě.",
                                "tr": "<w>En iyisi</w> eve gideyim, çünkü artık çok geç.",
                                "es": "<w>Creo que voy a</w> irme a casa, ya que es tarde.",
                                "zh": "天色已晚，我<w>还是</w>回家<w>吧</w>。"
                            }
                        },
                        {
                            "text": "Мы, <w>пожалуй</w>, откажемся от вашего предложения.",
                            "target_lang_translations": {
                                "en": "We <w>think we'll</w> decline your offer.",
                                "nl": "<w>Ik denk dat we</w> uw aanbod zullen afwijzen.",
                                "pl": "<w>Chyba jednak</w> odrzucimy waszą propozycję.",
                                "de": "<w>Wir werden wohl</w> Ihr Angebot ablehnen.",
                                "fr": "Nous <w>allons probablement</w> décliner votre offre.",
                                "it": "<w>Penso che rifiuteremo</w> la vostra offerta.",
                                "cs": "<w>Raději</w> vaši nabídku odmítneme.",
                                "tr": "<w>Sanırım</w> teklifinizi reddedeceğiz.",
                                "es": "<w>Creo que vamos a</w> rechazar su oferta.",
                                "zh": "我们<w>还是</w>拒绝你的提议<w>吧</w>。"
                            }
