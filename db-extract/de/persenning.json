                                "target_senses": [
                                    {
                                        "sense_id": "f9db6be7-f582-34f2-a003-5693a2c28d1c",
                                        "entry_id": "0477c15b-1833-3374-924c-edac8d2ad832",
                                        "glosses": [
                                            "A tarpaulin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f5d61f3-98b6-4dcb-80d6-8c3b9b5fc728",
                                                "sense_id": "f9db6be7-f582-34f2-a003-5693a2c28d1c",
                                                "text": "[Ignatz, under the rain:] It's a good thing I had this tarp handy. [...] / [Officer Pupp:] Gimme that canvas, it's much more important that I keep dry."
                                            },
                                            {
                                                "example_id": "44aad730-23db-4ffd-bcd7-22c4136192e6",
                                                "sense_id": "f9db6be7-f582-34f2-a003-5693a2c28d1c",
                                                "text": "{Gun pointing at head} Sorry, Quigley, but you had your chance to cooperate. / Bob, straighten the tarp, we don’t want the rug splattered."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tarp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8c43c2-6395-3412-ab58-a347d210ae55",
                                        "entry_id": "2662c01a-bd12-38bb-809b-771a36ecae48",
                                        "glosses": [
                                            "To cover something with a tarpaulin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef81c970-6732-4500-80c2-7489275217fe",
                                                "sense_id": "5d8c43c2-6395-3412-ab58-a347d210ae55",
                                                "text": "The load may be tarped for serious white water, but tarped or not, everything should be tied securely in case of capsize."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
