                "translations": [
                    {
                        "translation_id": "41f1eb46-1bdb-43e9-965b-5ce65de1fa9d",
                        "source_entry_id": "6def9de2-282f-30d7-b49f-dc0a7940b317",
                        "source_sense_id": "f9c0f1d6-8749-3408-9214-2b7d809e003c",
                        "source_sense_description": "op de geneeskunde betrekking hebbend",
                        "target_lang_word": "medizinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medizinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                        "entry_id": "14989a57-9607-3740-b168-b3689081171a",
                                        "glosses": [
                                            "die Medizin als Wissenschaft und Heilkunst betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84cd135-899a-44bb-9b81-8f956e81a471",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "Sie sollten sich medizinisch behandeln lassen."
                                            },
                                            {
                                                "example_id": "cd82231d-8da8-4c27-a32a-3b8de8c2151c",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Ob in Brennstoffzellen, zur medizinischen Diagnostik oder Produktion neuer Materialien und Energieträger — Katalysatoren haben ein enormes Einsatzpotenzial.“"
                                            },
                                            {
                                                "example_id": "b4845f60-2359-43b6-877e-31f63d8e20e0",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "742417d2-a904-4d4b-ad38-99359c620efd",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Wohl keine andere Stadt in Deutschland hat ein so breit gefächertes medizinisches Angebot wie Berlin.“"
                                            },
                                            {
                                                "example_id": "b865c55a-e477-45b7-abfa-5073b4bfe04a",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "Zwar hat jeder Mensch - mit oder ohne Aufenthaltsstatus - in akuten Notlagen Anspruch auf medizinische Versorgung. Doch in Deutschland verpflichtet das Ausländergesetz öffentliche Stellen wie Sozialämter oder Krankenhäuser dazu, Menschen ohne Papiere sofort der Ausländerbehörde zu melden - für illegale Einwanderer kann der Gang ins städtische Krankenhaus deshalb tatsächlich mit der Ausweisung enden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc968ab8-0016-3f03-a08d-c14859a0374a",
                                        "entry_id": "14989a57-9607-3740-b168-b3689081171a",
                                        "glosses": [
                                            "unter Berücksichtigung der Medizin hergestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e95438a-b4dc-41e5-9664-909cbaef5e51",
                                                "sense_id": "bc968ab8-0016-3f03-a08d-c14859a0374a",
                                                "text": "Offensichtlich wirkte sie durch ihre rote Farbe als medizinische Zahncreme unglaubwürdig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbf8ef7-f86e-4f5c-aa2d-227cc3b078d6",
                        "source_entry_id": "6def9de2-282f-30d7-b49f-dc0a7940b317",
