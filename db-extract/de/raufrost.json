                    {
                        "translation_id": "f4468c8a-468b-46bd-940f-8415d497bfef",
                        "source_entry_id": "2121d57f-7326-361a-8deb-399d16d09876",
                        "source_sense_id": "aa8806b4-4723-3e6a-a227-650d475a1183",
                        "source_sense_description": "durch gefrierende Nebelwassertröpfchen körnige, weiße, undurchsichtige Nebelfrostablagerung",
                        "target_lang_word": "givre dur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "givre dur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cff1936c-1286-3b90-948e-161c8f9f5588",
                                        "entry_id": "75bb55c5-5b3a-3ea6-96e9-7a408f01c904",
                                        "glosses": [
                                            "Dépôt de glace par congélation de brouillard givrant sur des surfaces, givre de densité élevée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524f3503-3d53-4581-8547-8bb7999a04af",
                                                "sense_id": "cff1936c-1286-3b90-948e-161c8f9f5588",
                                                "text": "Les nuages givrants, selon leur teneur en eau, la température et la vitesse de vent, ainsi que la distribution de la taille des gouttelettes dans le nuage, produisent du givre dur ou du givre mou."
                                            },
                                            {
                                                "example_id": "501c3a66-dee2-42c4-a35d-27ed2a18cf4c",
                                                "sense_id": "cff1936c-1286-3b90-948e-161c8f9f5588",
                                                "text": "Dépendamment de la teneur en eau liquide (LWC), de la taille et de la distribution des gouttelettes dans le nuage, de la température et de la vitesse du vent, le givre dur (lourd) ou le givre mou (léger) peut se produire (Figure 2-3)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374ccc4d-bf10-461d-b45e-51ce42fedde5",
                        "source_entry_id": "2121d57f-7326-361a-8deb-399d16d09876",
                        "source_sense_id": "aa8806b4-4723-3e6a-a227-650d475a1183",
