                        "glosses": [
                            "The condition of being omnisufficient."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "22875d1b-8903-4041-8c8c-8a90d02416f5",
                                "sense_id": "36d976b7-7fb1-388f-a286-162670018a31",
                                "text": "Beloved in him, whose kingdom, and Gospel you seek to advance, in this plantation, our Lord and Saviour Christ Jesus, if you seek to establish a temporal kingdom there, you are not rectified, if you seek to be kings in either acceptation of the word ; to be a king signifies liberty and independency, and supremacy, to be under no man, and to be a king signifies abundance, and Omnisufficiency to need no man."
                            },
                            {
                                "example_id": "09b97bcc-ef62-4088-b29c-ec5c3c32b956",
                                "sense_id": "36d976b7-7fb1-388f-a286-162670018a31",
                                "text": "In p. 20 seq. Harvey's words (connive wink), cosmologised and smirked (recreated), omnisufficiency, enthusiastical (rich), entelechy (capacity), are jeered at. In the Address to the Eeaders, pp. 25, 27, he has been \"two or three years\" at this book, ever since the hanging of Lopus (condemned 29th Feb. 1594)."
                            },
                            {
                                "example_id": "0a03e31b-96fa-44c8-b3be-30af0e63da7e",
                                "sense_id": "36d976b7-7fb1-388f-a286-162670018a31",
                                "text": "‘Agrippa was reputed ... a demi-god in omnisufficiency of knowledge ’."
                            }
                        ]
                    }
