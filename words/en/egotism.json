{
    "word_family": [
        "egotist",
        "egotistic",
        "egotistical",
        "egotistically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bdd2352-b47f-38c1-b628-f72d9281fde0",
                    "sense_definition": "An exaggerated sense of self-importance or feeling of superiority over others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-centeredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His overwhelming <w>egotism</w> made it impossible for him to accept constructive feedback."
                        },
                        {
                            "text": "The politician was widely criticized for her sheer <w>egotism</w> and disregard for others."
                        }
                    ],
                    "synonyms": [
                        "conceit",
                        "vanity",
                        "narcissism",
                        "pride"
                    ],
                    "antonyms": [
                        "humility",
                        "modesty"
                    ],
                    "common_phrases": [
                        "sheer egotism",
                        "blinded by egotism",
                        "rampant egotism"
                    ]
                },
                {
                    "sense_id": "96de3a84-1317-3d25-9eec-b501fb2954e0",
                    "sense_definition": "The practice or habit of talking excessively about oneself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "self-centeredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dinner with him was tedious because of his relentless <w>egotism</w> during every conversation."
                        },
                        {
                            "text": "Her letters were full of tiresome <w>egotism</w>, detailing only her own daily triumphs."
                        }
                    ],
                    "synonyms": [
                        "egocentrism"
                    ],
                    "common_phrases": [
                        "tiresome egotism",
                        "relentless egotism"
                    ]
                },
                {
                    "sense_id": "f2993185-9818-31d0-b930-22fd5caef433",
                    "sense_definition": "The philosophical tendency or ethical doctrine that treats self-interest as the foundation of morality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher distinguished between ethical altruism and individual <w>egotism</w>."
                        },
                        {
                            "text": "In this theoretical framework, human behavior is reduced to pure <w>egotism</w>."
                        }
                    ],
                    "synonyms": [
                        "egoism"
                    ],
                    "antonyms": [
                        "altruism"
                    ],
                    "common_phrases": [
                        "pure egotism",
                        "rational egotism"
                    ]
                },
                {
                    "sense_id": "8eafc599-dca0-3625-95e4-f28c7c2bebf9",
                    "sense_definition": "An act, manifestation, or expression of being self-centered or conceited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "self-centeredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Publishing a third memoir at age thirty struck many critics as an astonishing <w>egotism</w>."
                        },
                        {
                            "text": "His speech was marred by petty <w>egotisms</w> that annoyed the audience."
                        }
                    ],
                    "common_phrases": [
                        "petty egotisms"
                    ]
                }
            ]
        }
    ]
}