                    {
                        "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                        "entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                        "glosses": [
                            "Schmerzen des Ischiasnervs"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "fba495b6-9b03-4931-9711-c525d5c223d9",
                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                "text": "Herr Doktor, mein Ischias quält mich schon wieder."
                            },
                            {
                                "example_id": "e4da6f15-fe31-4cbe-8c81-484c02b8eddd",
                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                "text": "Ich kann mich gar nicht rühren mit meinem Ischias."
                            },
                            {
                                "example_id": "3d88bce7-8b56-47de-a858-d7db043d3891",
                                "sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                                "text": "„Wir fanden die Mutter im Bett, an das sie durch Ischias gefesselt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a2f6c88-7ad8-3472-927c-c64d7f3f5161",
                        "entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                        "glosses": [
                            "Nervus ischiadicus"
                        ],
                        "tags": [
                            "umgangssprachliche Kurzform für"
                        ],
                        "examples": [
                            {
                                "example_id": "8545af45-914c-44b6-9097-a1895c908f34",
                                "sense_id": "4a2f6c88-7ad8-3472-927c-c64d7f3f5161",
                                "text": "Der Ischias kann starke Schmerzen verursachen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca5db049-5fb0-4115-80f1-95e2e354ca70",
                        "source_entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                        "source_sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                        "source_sense_description": "Medizin, fachsprachlich, weibliches Genus: Schmerzen des Ischiasnervs",
                        "target_lang_word": "sciatica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sciatica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d568846b-89a8-3d36-9759-9a249ab585a4",
                                        "entry_id": "1e7b8e3d-db84-35f3-856c-4aee384d199c",
                                        "glosses": [
                                            "Neuralgia of the sciatic nerve, characterised by pain radiating down through the buttocks and the back of the thigh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571fb591-0fc7-4971-ab47-0cb497c8383b",
                                                "sense_id": "d568846b-89a8-3d36-9759-9a249ab585a4",
                                                "text": "He picked up his own phone, shunned limos and preferred to walk if possible (sciatica later caused him to use a wheelchair) – as, for example, on the day after his election when he slipped away on foot to collect his suitcase and settle the bill at the modest pensione where he had been booked in before the conclave began."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f46a4d7-6389-4d38-a36e-5ea720631e48",
                        "source_entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
                        "source_sense_id": "353e2ffc-97e9-3168-ab3b-e52457e7324a",
                        "source_sense_description": "Medizin, fachsprachlich, weibliches Genus: Schmerzen des Ischiasnervs",
                        "target_lang_word": "sciatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sciatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                        "entry_id": "619eb44e-a74e-3ca7-b14a-350d352ff9f5",
                                        "glosses": [
                                            "Qui a rapport à la hanche, à l’os ischion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f37e32e-4afe-4414-87f5-8113a85af59c",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Le sciatique est un nerf connu."
                                            },
                                            {
                                                "example_id": "220d1701-129e-4500-abd9-187328c0bf98",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                                            },
                                            {
                                                "example_id": "18eaa6aa-2963-4f58-b42f-b19a970771e8",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Artères, veines sciatiques."
                                            },
                                            {
                                                "example_id": "8f203af4-2fc6-4e1a-9069-c6cb070567c3",
                                                "sense_id": "c9ff060e-90d0-355d-b3f4-cb1fa8671037",
                                                "text": "Névralgie sciatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sciatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                        "entry_id": "07eb965c-f74b-38f9-aa2a-78c41b1d0809",
                                        "glosses": [
                                            "Douleur qui affecte le grand nerf sciatique et qui se fait sentir principalement à la hanche, à l’emboîture des cuisses."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1002d34e-8ecd-4625-924c-cd5e1c4dd4b2",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Les maladies articulaires sont nommées ainsi en fonction de leur localisation aux différentes articulations du corps : podagre, aux pieds ; chiragre, aux mains ; omagre, à l'épaule ; péchyagre, aux coudes ; gonagre, aux genoux ; rachisagre, à la colonne vertébrale, ischiagre, à la hanche, sciatique, à la cuisse et dysarthrite lorsque la goutte est irrégulière."
                                            },
                                            {
                                                "example_id": "65c9b256-9237-4703-aeb9-b4707811521f",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Julius sourit avec une accommodante condescendance et, pour changer de sujet, demande à son beau-frère des nouvelles de sa sciatique, qu’il appelle par erreur : son lumbago."
                                            },
                                            {
                                                "example_id": "47de86b5-e54e-4a06-87c9-ad30e5033c42",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                                            },
                                            {
                                                "example_id": "42547ae2-0e02-4cac-b121-6cc0dd46d6a2",
                                                "sense_id": "a1dca354-d29b-3236-a290-c5f02805cb99",
                                                "text": "[…] pour la sciatique, pour le rhumatisme, & pour semblables maladies, on fait froter la partie avec deux onces d’huile de Millepertuis & une once de bon esprit de vin ; ce meslange est fort resolutif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c151a5bc-07e4-446b-b532-a8a099317af5",
                        "source_entry_id": "be9f02ff-1a4a-3c9b-8e49-a8a0e70f4cab",
