                                        "sense_id": "1ac74a26-73ee-35b3-83ae-f226aa0f6aca",
                                        "entry_id": "3f96adf9-b0ed-394b-af4d-de44e628e2c7",
                                        "glosses": [
                                            "Brother (a comrade or friend; one who shares one’s ideals)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cce4bcf1-99a5-4a00-9417-bfd4e05a2b84",
                                                "sense_id": "1ac74a26-73ee-35b3-83ae-f226aa0f6aca",
                                                "text": "Bro, you good? You've been lookin' kinda out of it lately."
                                            },
                                            {
                                                "example_id": "9e214ae7-4104-4333-926d-0e5cc1f79392",
                                                "sense_id": "1ac74a26-73ee-35b3-83ae-f226aa0f6aca",
                                                "text": "Let’s not kid ourselves – there are plenty of men saying that Will has been emasculated by Jada, because hurr durr why would he hit a bro over a woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd70f8be-a137-34a5-9ac9-c721c90294c6",
                                        "entry_id": "3f96adf9-b0ed-394b-af4d-de44e628e2c7",
                                        "glosses": [
                                            "Brother, my man, good sir; a friendly term of address for typically men."
