                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad90fffa-0ac3-4635-b782-94cb98dd9845",
                        "source_entry_id": "2b0ffa99-66a7-3338-9783-fde863bbcf1b",
                        "source_sense_id": "67d8749f-f9a9-3329-b511-de1a58a80981",
                        "source_sense_description": "typewriter",
                        "target_lang_word": "ундерву́д",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ундерву́д",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17fcf9a3-3ed4-33c9-a20b-5e9323cbb4c5",
                                        "entry_id": "1d89b803-8070-37a4-9adf-6f6be2051705",
                                        "glosses": [
                                            "пишущая машинка американской фирмы «Ундервуд»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b4db25-257a-4b28-a4fc-665f75a6fb08",
                                                "sense_id": "17fcf9a3-3ed4-33c9-a20b-5e9323cbb4c5",
                                                "text": "Здесь только постукивали ундервуды, как молоточки в ушах в сыпнотифозном бреду, шелестели бумаги, бормотали в телефонные трубки хозяйственные голоса."
                                            },
                                            {
                                                "example_id": "6af4a442-cfb6-4480-b68d-5d35b95095ae",
                                                "sense_id": "17fcf9a3-3ed4-33c9-a20b-5e9323cbb4c5",
                                                "text": "Анна Ивановна расшифровала конспекты лекций и перепечатала стенограмму на своём старомодном ундервуде с большой кареткой. Ундервуд гремел, как товарный поезд. Таня сладко спала под грохот."
                                            },
                                            {
                                                "example_id": "aab4d4cf-3af8-4209-86b7-e552d92046ab",
                                                "sense_id": "17fcf9a3-3ed4-33c9-a20b-5e9323cbb4c5",
                                                "text": "Жизнь превращается действительно в соло на ундервуде, ибо рано или поздно человек в писателе впадает в зависимость от писателя в человеке, не от сюжета, но от стиля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
