                    },
                    {
                        "translation_id": "1b29f1c8-58d7-4451-8f11-cb8d8fcd2258",
                        "source_entry_id": "75129a54-6d3a-3a1a-91cc-acca2b79495e",
                        "source_sense_id": "02200478-f5ca-3e30-b7f4-e90bbc8f1d6d",
                        "source_sense_description": "without arms",
                        "target_lang_word": "manchot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manchot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "040162e5-289b-3551-bfef-ba0f62746c18",
                                        "entry_id": "27f1ac0c-a1de-3f1b-bf08-c73ebab2c03b",
                                        "glosses": [
                                            "Relatif au département de la Manche ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551b0097-4424-4160-a66d-c345a90b1b48",
                                                "sense_id": "040162e5-289b-3551-bfef-ba0f62746c18",
                                                "text": "En cette curieuse région du Cotentin, toute bruissante des verdoyantes ramées, où chaque chaumière se tapit mystérieusement au détour d’une cache, où chaque lopin s’embroussaille de genêt, de houx et d’épine, ou se clôt de murets de pierres sèches, symboles du droit de possession — et du goût du repli — les vieilles légendes s’étaient fidèlement transmises au coin de l’âtre, hiver après hiver. Les goubelins, ces farfadets manchots, l’y disputaient aux fées bénéfiques, comme celle du bois du Rabey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manchot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "134b3a43-81bb-37f7-8c03-82080ddbb70f",
                                        "entry_id": "9a3a31da-20c2-3b00-9925-d86ca5e72142",
                                        "glosses": [
                                            "Personne à qui il manque un ou les deux bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a775765-71be-4be5-96e4-cb8b6e7a7e4e",
                                                "sense_id": "134b3a43-81bb-37f7-8c03-82080ddbb70f",
                                                "text": "Le manchot, blessé de guerre, sortit sa carte de priorité de sa main valide pour s’asseoir dans le bus."
                                            },
                                            {
                                                "example_id": "20458af4-cc73-4374-8910-95e3215989be",
                                                "sense_id": "134b3a43-81bb-37f7-8c03-82080ddbb70f",
                                                "text": "Nous connaissons sur le pont de Stamboul toutes les échoppes, tous les passants, même tous les mendiants, la collection complète des estropiés, aveugles, manchots, becs-de-lièvre et culs-de-jatte."
                                            },
                                            {
                                                "example_id": "dca59308-891f-4b25-a812-debf1c66f9b9",
                                                "sense_id": "134b3a43-81bb-37f7-8c03-82080ddbb70f",
                                                "text": "Tout le monde me montre au doigt\nSauf les manchots, ça va de soi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be9ee59-9bae-3548-8c9d-89587ec3520c",
                                        "entry_id": "9a3a31da-20c2-3b00-9925-d86ca5e72142",
                                        "glosses": [
                                            "Nom donné par les amateurs de rugby aux footballeurs et aux supporters de football."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e073e6-341d-467b-8cde-dba4919ddfcc",
                                                "sense_id": "5be9ee59-9bae-3548-8c9d-89587ec3520c",
                                                "text": "J’ai beau avoir grandi dans la capitale de l’ovalie je suis un footeux pur et dur. Un manchot comme ils disent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manchot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                        "entry_id": "d1b12dc4-0646-34cd-b93d-09c781c56e5f",
                                        "glosses": [
                                            "Qui est estropié ou privé de la main ou du bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdea89c7-2b2e-4200-bee6-773e3da64358",
                                                "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                                "text": "Il est manchot de la main droite."
                                            },
                                            {
                                                "example_id": "81978d24-97d3-4291-a337-ff66f90c5d84",
                                                "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                                "text": "Qu’on me rende impotent,\nCul-de-jatte, goutteux, manchot, pourvu qu’en somme\nJe vive, c’est assez, je suis plus que content."
                                            },
                                            {
                                                "example_id": "ea366f7b-e4ef-41ba-85b3-e2048d444353",
                                                "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                                "text": "Marcelle. — Qu’est-ce que vous voulez ?… on ne peut pas demander à un manchot de jouer du violon."
                                            },
                                            {
                                                "example_id": "ae82b632-0853-4c10-8eef-950437497756",
                                                "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                                "text": "L’un des joueurs est manchot. Un instrument d’acier nickelé, qu’on devine fixé au moignon, mi-pince, mi-crochet, sort de la manche : il y tient ses cartes étalées en éventail. Les autres joueurs se renouvellent selon les heures de la journée. Mais le manchot est toujours là, assis sur la banquette, à la place d’angle. Il joue au tarot depuis l’ouverture du café jusqu’à sa fermeture, qui se fait parfois tard. C’est Bernard Busard, patron de l’établissement."
                                            },
                                            {
                                                "example_id": "07123f17-8c70-497a-b4ed-513aeffcf6df",
                                                "sense_id": "6181b63f-2e91-362c-a03c-11c235844258",
                                                "text": "Parfois, disait-elle j’ai l’impression que si je ne le regarde pas, mon bras n’existe plus, que je suis manchote. José, est-ce correct, au moins, manchote? Pas joli, évidemment. Je perds même mon français dans ce bled…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0532ef73-6336-3706-9a81-0ddacd3ab847",
                                        "entry_id": "d1b12dc4-0646-34cd-b93d-09c781c56e5f",
                                        "glosses": [
                                            "Se dit de quelqu’un qui est maladroit."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89b05478-bd61-453f-883d-77cc7d6f5230",
                                                "sense_id": "0532ef73-6336-3706-9a81-0ddacd3ab847",
                                                "text": "Cette année-là, il n’y avait pas encore de plaisanciers dans notre port. Les plaisanciers, ils allaient ailleurs. Ce n’est pas un port pour des marins d’occasion ; pour y entrer il vaut mieux en avoir envie ou besoin ; en plus, il ne faut pas être manchot[…]"
                                            },
                                            {
                                                "example_id": "88e2f44d-f8df-41bf-b43d-dee1da050614",
                                                "sense_id": "0532ef73-6336-3706-9a81-0ddacd3ab847",
                                                "text": "[…] pis ton André y doit pas être manchot, un gars capable de mener un avion y doit être capable de s’faire à souper ben manque !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manchot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff941ab-e770-3f0b-8adc-23a2e3872019",
                                        "entry_id": "8420dd36-9913-3588-8fad-4216ee5c7bf8",
                                        "glosses": [
                                            "Oiseau palmipède marin de l’hémisphère sud, notamment de l’Antarctique, très bon nageur, aux petites pattes et aux ailes atrophiées mais de forme hydrodynamique leur conférant les propriétés de nageoires puissantes, appartenant, avec les gorfous, à l'ordre des sphénisciformes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddea84ce-a51e-3d30-b035-aa65aeebc91f",
                                        "entry_id": "8420dd36-9913-3588-8fad-4216ee5c7bf8",
                                        "glosses": [
                                            "Pingouin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55b90fc-f519-4579-a8e9-fa8d4a8c46a7",
                                                "sense_id": "ddea84ce-a51e-3d30-b035-aa65aeebc91f",
                                                "text": "Les habitants passent souvent plusieurs mois sans recevoir aucune nouvelle de l'Islande […] Ils ont pour unique ressource la pêche et la chasse aux manchots ; ces singuliers palmipèdes nichent par myriades dans les fentes des rochers ; les insulaires troquent leurs plumes contre les objets de première nécessité , et ils se nourrissent de leur chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
