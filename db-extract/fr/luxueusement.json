                    {
                        "sense_id": "7ecfef53-1566-379c-a988-c31c49fb57f5",
                        "entry_id": "8e0b9c4e-2d08-3da5-b6bd-9348ff8ab512",
                        "glosses": [
                            "D’une manière luxueuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c0ee6a-88aa-4c55-a845-6d48c27ca3f2",
                                "sense_id": "7ecfef53-1566-379c-a988-c31c49fb57f5",
                                "text": "Nous avons devant les yeux [au Capitole, à Washington] une salle rectangulaire de médiocre grandeur, luxueusement ornée de tentures de soie jaune, avec trois rangs concentriques de bureaux et de fauteuils en acajou."
                            },
                            {
                                "example_id": "cbe029e8-1d61-4197-acfa-5512b7c5f428",
                                "sense_id": "7ecfef53-1566-379c-a988-c31c49fb57f5",
                                "text": "On voyait un petit Dunkerque assez bien garni, des jardinières en porcelaine chinoise luxueusement montées."
                            }
                        ]
                    }
                ],
