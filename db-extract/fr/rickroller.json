                ],
                "senses": [
                    {
                        "sense_id": "32198429-5afa-3582-b053-116cd3bc051a",
                        "entry_id": "3e5f8231-860a-3efc-bdea-5786606d2cfb",
                        "glosses": [
                            "Tromper (les lecteurs d'un site Internet) en utilisant un hyperlien sans rapport avec le sujet, en particulier un lien vers une vidéo du clip de la chanson « Never Gonna Give You Up » de Rick Astley."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "fe9670a3-8c65-41f0-aaa9-f22294ff6476",
                                "sense_id": "32198429-5afa-3582-b053-116cd3bc051a",
                                "text": "Les petits plaisantins ont donc pour plan de rickroller l’émission, c'est-à-dire de leur faire chanter le tube des années 80 de Rick Astley, «Never Gonna Give You Up»."
                            },
                            {
                                "example_id": "d5b096b2-d002-411b-a0db-46de0e0924ee",
                                "sense_id": "32198429-5afa-3582-b053-116cd3bc051a",
                                "text": "La personne qui a répondu a en fait « rickrollé » les internautes, c’est-à-dire qu'elle les a piégés en faisant croire avoir mis en ligne un lien en rapport avec le sujet : le plafond de la dette."
                            },
                            {
                                "example_id": "12791551-de62-4e71-81f0-c08afcc27491",
                                "sense_id": "32198429-5afa-3582-b053-116cd3bc051a",
                                "text": "La Maison Blanche s'amuse à rickroller ses followers sur Twitter."
                            },
                            {
                                "example_id": "468e92cd-c858-4c0d-874a-6ce5d13be216",
                                "sense_id": "32198429-5afa-3582-b053-116cd3bc051a",
                                "text": "Comment rickroller 4 millions de personnes d'un coup ?"
                            }
                        ]
                    }
                ],
