                        "learn the basics",
                        "cover the basics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элементарный компонент или фундаментальные знания.",
                        "tr": "Temel bir yapı taşı veya en temel bilgi unsuru.",
                        "zh": "基本的构成要素或基础知识。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осно́вы",
                                "target_lang_sense_clarification": "базовые принципы или знания"
