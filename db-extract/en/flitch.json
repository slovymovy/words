                "senses": [
                    {
                        "sense_id": "bd66f159-9133-3671-b7c1-8dfc11b7264b",
                        "entry_id": "310ab757-5d3e-3dce-a244-d99fac6a691d",
                        "glosses": [
                            "The flank or side of an animal, now almost exclusively a pig when cured and salted; a side of bacon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ccdfdb-5286-4f3a-848d-f62fdd2ef2c6",
                                "sense_id": "bd66f159-9133-3671-b7c1-8dfc11b7264b",
                                "text": "The following morning before Nicholas awoke, Mulvey walked all the way to the village of Letterfrack, returning with a basket of cabbages and a flitch of bacon, two loaves of fresh bread and a plump broiling chicken."
                            },
                            {
                                "example_id": "09769271-2452-411f-8816-b0ab2c5da6c1",
                                "sense_id": "bd66f159-9133-3671-b7c1-8dfc11b7264b",
                                "text": "The programme was loosely derived from a folk tradition, the Great Dunmow Flitch, in which the most happily married couple in the village were rewarded with a gift of a flitch of beef."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb00c739-6d2d-334d-afd6-db74a53e70d7",
                        "entry_id": "310ab757-5d3e-3dce-a244-d99fac6a691d",
                        "glosses": [
                            "A piece or strip cut off of something else, generally a piece of wood (timber)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9106608-7862-49bd-bb77-6362a45fefe6",
                                "sense_id": "cb00c739-6d2d-334d-afd6-db74a53e70d7",
                                "text": "The Measure of a shell or Flitch of Timber.\nIf a piece be taken out of the middle of a round piece of Timber from end to end; there will be left two pieces, which they call Shells or Flitches."
                            },
                            {
                                "example_id": "69bc58a5-cbbc-44ae-889e-f9104e321150",
                                "sense_id": "cb00c739-6d2d-334d-afd6-db74a53e70d7",
                                "text": "An edge chipper chips waney edges of a flitch of timber having parallel top and bottom sides, the flitch passing through feed roll pairs extends outward as a cantilever as it moves towards revolving chipper ..."
                            }
                        ]
                    }
                ],
                "translations": [
