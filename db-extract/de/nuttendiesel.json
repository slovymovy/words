                ],
                "senses": [
                    {
                        "sense_id": "f686d679-bc5b-3535-a5f1-f80db9a6c061",
                        "entry_id": "fe0af0c8-f6c5-353c-9f58-2317090d9f60",
                        "glosses": [
                            "sehr aufdringliches oder schlecht riechendes Parfum"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "824b58ac-b10d-4158-84c5-e8e76ed6e24e",
                                "sense_id": "f686d679-bc5b-3535-a5f1-f80db9a6c061",
                                "text": "„›Dafür riecht man jetzt deinen Nuttendiesel nicht mehr, den du seit Wochen draufhaust.‹ ›Nuttendiesel? Das Zeug ist arschteuer.‹“"
                            },
                            {
                                "example_id": "3c971aa2-633f-4b8e-891d-e7e1c03840fa",
                                "sense_id": "f686d679-bc5b-3535-a5f1-f80db9a6c061",
                                "text": "Ihre Haare hat sie hellblond gefärbt, auf der Nase sitzt eine dunkle Hornbrille. Das Parfüm riecht süßlich und billig – typisches Nuttendiesel."
                            },
                            {
                                "example_id": "bc0fab92-ac3d-4ab7-9cf6-f1638d39c180",
                                "sense_id": "f686d679-bc5b-3535-a5f1-f80db9a6c061",
                                "text": "Wer auf der Tankstelle zum Tanken das Auto verlässt, dem fällt zuerst der starke Geruch von Treibstoff wie Benzin oder Diesel auf. Nicht anders verhält es sich, wenn man hinter einer Trägerin von Nuttendiesel hergeht."
                            },
                            {
                                "example_id": "bd1289fb-f6d9-4069-8d34-ebd1d4b695a1",
                                "sense_id": "f686d679-bc5b-3535-a5f1-f80db9a6c061",
                                "text": "Der Chronist erlaubt sich, bei dieser Gelegenheit auch auf das Wort ‚Nuttendiesel‘ hinzuweisen, welches ein Parfum zweifelhafter Güte bezeichnet (‚sich eindieseln‘ gleich ‚sich parfümieren‘), aber auch als Synonym für die ‚Nuttenbrause‘ im Umlauf ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28611966-c180-37bf-bec1-2318b85a64bb",
                        "entry_id": "fe0af0c8-f6c5-353c-9f58-2317090d9f60",
                        "glosses": [
                            "Sekt oder Champagner"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c91f4252-50a9-4322-92ca-8d6cebc25977",
                                "sense_id": "28611966-c180-37bf-bec1-2318b85a64bb",
                                "text": "Der Chronist erlaubt sich, bei dieser Gelegenheit auch auf das Wort ‚Nuttendiesel‘ hinzuweisen, welches ein Parfum zweifelhafter Güte bezeichnet (‚sich eindieseln‘ gleich ‚sich parfümieren‘), aber auch als Synonym für die ‚Nuttenbrause‘ im Umlauf ist."
                            },
                            {
                                "example_id": "c5891008-2df0-4538-9620-f63e57d156dd",
                                "sense_id": "28611966-c180-37bf-bec1-2318b85a64bb",
                                "text": "Du warst doch dabei als wir diese Kiste Mädchenbrause leer gemacht hatten, Don Perpignan oder wie das Zeug hieß, echter Nuttendiesel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
