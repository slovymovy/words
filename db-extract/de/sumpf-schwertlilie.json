                        "target_lang_word": "iris des marais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iris des marais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0d1fb6-76c7-35f6-8f5a-cc850a484316",
                                        "entry_id": "28c70498-0725-344f-a0fd-37cc0b2b3537",
                                        "glosses": [
                                            "Espèce de plante herbacée vivace, de marais ou bord de l’eau, de la famille des iridacées, de nom scientifique Iris pseudacorus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb00a70-c10f-47ef-aeb8-a4ff8e6dfd62",
                                                "sense_id": "ee0d1fb6-76c7-35f6-8f5a-cc850a484316",
                                                "text": "L’iris des marais est une charmante fleur jaune originaire d’Europe, d’Afrique du Nord et d’Asie occidentale."
                                            },
                                            {
                                                "example_id": "053c0229-462f-4233-98ca-950da88a0bf7",
                                                "sense_id": "ee0d1fb6-76c7-35f6-8f5a-cc850a484316",
                                                "text": "L’iris des marais est une superbe vivace aux fleurs jaune qui aime les zones humides."
                                            },
                                            {
                                                "example_id": "25802db9-ecf7-4fdf-bef1-82f400a1f16d",
                                                "sense_id": "ee0d1fb6-76c7-35f6-8f5a-cc850a484316",
                                                "text": "Flore : Saule cendré, frêne à feuilles étroites, angélique sauvage, laîche à épis pendants, chanvre d’eau, renoncule rampante, gaillet croisette, prêle des champs, lathrée clandestine, valériane officinale, liseron des haies, reine-des-prés, iris des marais, salicaire commune, baldingère faux-roseau, grande consoude, orchidée abeille, orchidée pyramidale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8653b2d7-56ba-4a3a-b46f-d9686d4faeb3",
                        "source_entry_id": "59f58c88-8867-3fbe-899c-bcb7ee8cebdd",
                        "source_sense_id": "904a7f9f-f9fe-3d72-97e8-15fb3fee6062",
