                    },
                    {
                        "form_id": "13bfa920-0974-4ee8-87be-72cd8105a667",
                        "entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Smalltalk"
                    },
                    {
                        "form_id": "efe22dca-1182-4e15-a547-202ecc6d7f4b",
                        "entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Smalltalk"
                    },
                    {
                        "form_id": "281a4e3b-471f-45cb-99a8-52068e6ef3be",
                        "entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Smalltalks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                        "entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "glosses": [
                            "ein Gespräch über alltägliche, allgemeine und/oder unwichtige Dinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9ebc3a-158f-4666-84bb-be6020902826",
                                "sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                                "text": "„Smalltalk ist die Kunst zu reden, ohne zu denken.“"
                            },
                            {
                                "example_id": "b1051ce7-081f-4b72-8a82-412212eb8a10",
                                "sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                                "text": "„Bei den Mahlzeiten bemühte ich mich um Smalltalk mit den Deutschen, doch die Einzigen, die darauf eingingen, waren die über Fünfundsiebzigjährigen."
                            },
                            {
                                "example_id": "e273d217-6840-4c70-a195-23ad25fb5876",
                                "sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                                "text": "„Seine Frau stand neben ihm, außerdem hielt er gerade Smalltalk mit einem wichtigen Mandanten.“"
                            },
                            {
                                "example_id": "bd4c99b7-a4de-42c6-a0dd-fb104c9ff97f",
                                "sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                                "text": "„Ihr ging zu viel durch den Kopf, um Smalltalk mit einem Fremden führen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "62bd5771-07e2-3f2e-aaa2-3cc237fe07a6",
                        "entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "glosses": [
                            "Name einer der ersten objektorientierten Programmiersprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e41aea1-f677-4408-89fa-ba95e3d0fd8a",
                                "sense_id": "62bd5771-07e2-3f2e-aaa2-3cc237fe07a6",
                                "text": "„Smalltalk“ heißt eine untypisierte, dynamische und objektorientierte Programmiersprache mit einer reichen Entwicklungsumgebung, die in den 1970er Jahren am Xerox PARC Forschungszentrum entwickelt wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d48b51f-8996-4fe7-b37b-fb7c7e7331ac",
                        "source_entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "source_sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                        "source_sense_description": "ein Gespräch über alltägliche, allgemeine und/oder unwichtige Dinge",
                        "target_lang_word": "small talk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small talk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                        "entry_id": "21ec2825-c31c-3941-a699-df6c5ddfbe5a",
                                        "glosses": [
                                            "Idle conversation, typically regarding innocuous or unimportant subjects, usually engaged in at social gatherings out of politeness."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e367ed-1cef-4430-ac70-cbc1fe48dec9",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "[T]o the credit of the lady it may be added, that […] without any of the arts of flattery or the gaieties of small talk, he began to be agreeable to her."
                                            },
                                            {
                                                "example_id": "0bc37d08-bda6-4962-9121-48568124799f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "If he had a fault as a conversationalist, it was a certain tendency to monotony, a certain lack of sparkle and variety in his small-talk."
                                            },
                                            {
                                                "example_id": "e7b79413-0e0d-4661-8558-93728746015f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "Yet for so public a figure, Jackson was socially awkward, inept at small talk and terrified when the distant audience became an adoring mob."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb71a106-a746-413a-adb5-6b5db4e54851",
                        "source_entry_id": "5bc6bfe3-e8fd-3d2f-ac0f-e7722bcb6e30",
                        "source_sense_id": "9a6b0943-20c4-384d-bfba-d13a693c001d",
                        "source_sense_description": "ein Gespräch über alltägliche, allgemeine und/oder unwichtige Dinge",
                        "target_lang_word": "parler de la pluie et du beau temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parler de la pluie et du beau temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d22e615f-99f4-3acb-9bc0-223a4e2f8e3b",
                                        "entry_id": "d6eae492-706e-32ed-9c58-b3f1ba0b3d20",
                                        "glosses": [
                                            "Parler de tout et de rien avec quelqu’un, de choses diverses et souvent futiles."
                                        ],
                                        "tags": [
                                            "Proverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ba0d05-c25b-49bc-9847-57ebc6491d59",
                                                "sense_id": "d22e615f-99f4-3acb-9bc0-223a4e2f8e3b",
                                                "text": "La présence de leur fille avait nécessairement modifié les commérages des deux vieilles gens. Ils avaient supprimé les petits scandales de la ville. Littéralement, on ne parlait plus à cette table que de choses aussi intéressantes que la pluie et le beau temps."
                                            },
                                            {
                                                "example_id": "533ac3d5-948a-4492-b149-9043bd60b682",
                                                "sense_id": "d22e615f-99f4-3acb-9bc0-223a4e2f8e3b",
                                                "text": "Et les deux hommes, s’étant enquis cordialement de leur santé respective, parlèrent de la pluie et du beau temps, puis transportèrent la conversation sur divers autres sujets d’un intérêt tout aussi palpitant ; […]."
                                            },
                                            {
                                                "example_id": "72cd8bda-0684-45df-a1a1-729234974181",
                                                "sense_id": "d22e615f-99f4-3acb-9bc0-223a4e2f8e3b",
                                                "text": "Il parla de la pluie et du beau temps avec sa voix traînante et monotone, poli, mais distrait, plissant le yeux, larges dans son visage étroit aux longues joues creuses."
                                            },
                                            {
                                                "example_id": "8c6c4b1e-506f-460d-b4b7-9d4b2e80b0e7",
                                                "sense_id": "d22e615f-99f4-3acb-9bc0-223a4e2f8e3b",
                                                "text": "Elle m’introduisit dans le bureau où deux autres jeunes filles classaient des fiches. Devant plus d’une personne je n’ai jamais pu que parler de la pluie et du beau temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
