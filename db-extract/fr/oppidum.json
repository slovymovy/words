                    {
                        "form_id": "1f2ee0c4-337d-4985-88bf-f0aadb4fa370",
                        "entry_id": "f7174bf5-6ef5-3493-ba6b-fb7ff5ddb795",
                        "tags": [
                            "singular"
                        ],
                        "form": "oppida"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06cf7363-881b-3803-8d86-22d52eb63430",
                        "entry_id": "f7174bf5-6ef5-3493-ba6b-fb7ff5ddb795",
                        "glosses": [
                            "Centre préurbain surélevé (généralement situé sur une colline ou sur un plateau) dont les défenses naturelles ont été renforcées par l’être humain."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "89571fe3-5586-4008-9f04-30f68c49da85",
                                "sense_id": "06cf7363-881b-3803-8d86-22d52eb63430",
                                "text": "Les tombes plates et les tumulus de Pact, Voreppe, Rives, Vernas, Optevoz et Mépieu, le casque des Avenières, l’oppidum de Larina (Hières-sur-Amby) témoignent de cette pénétration."
                            },
                            {
                                "example_id": "26d17e09-2a0c-4813-834b-02b2655d2280",
                                "sense_id": "06cf7363-881b-3803-8d86-22d52eb63430",
                                "text": "En terminant, nous dirons un mot de ces bizarres constructions en pierre sèche, élevées sur des collines escarpées, et formant des enceintes cyclopéennes. Ce sont les lieux de refuge ou oppida."
                            },
                            {
                                "example_id": "7b7ef580-c33b-43a4-8b1d-1be5d0ae8885",
                                "sense_id": "06cf7363-881b-3803-8d86-22d52eb63430",
                                "text": "Dominant la vallée de l’Issoire, sur une colline ombragée, se dresse Coriobona, reconstitution grandeur nature d’un oppidum gaulois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31de17bb-b0ed-4405-88e2-735cda472d4a",
                        "source_entry_id": "f7174bf5-6ef5-3493-ba6b-fb7ff5ddb795",
                        "source_sense_id": "06cf7363-881b-3803-8d86-22d52eb63430",
