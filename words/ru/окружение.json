    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6305aa8e-4ada-3606-ba7b-ba0493b1052a",
                    "sense_definition": "Совокупность объектов, условий и обстановки, находящихся в непосредственной физической близости.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "env_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький домик стоял в живописном <w>окружении</w> высоких гор и лесов.",
                            "target_lang_translations": {
                                "en": "The little house stood in picturesque <w>surroundings</w> of high mountains and forests.",
                                "pl": "Mały domek stał w malowniczym <w>otoczeniu</w> wysokich gór i lasów."
                            }
                        },
                        {
                            "text": "Для продуктивной работы мне необходимо спокойное и тихое <w>окружение</w>.",
                            "target_lang_translations": {
                                "en": "For productive work, I need a calm and quiet <w>environment</w>.",
                                "pl": "Do produktywnej pracy potrzebuję spokojnego i cichego <w>otoczenia</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "антураж"
                    ],
                    "common_phrases": [
                        "в окружении лесов",
                        "естественное окружение",
                        "приятное окружение"
                    ],
                    "target_lang_definitions": {
                        "en": "The aggregate of objects, conditions, and atmosphere located in immediate physical proximity.",
                        "pl": "Ogół obiektów, warunków i atmosfery znajdujących się w bezpośrednim sąsiedztwie fizycznym."
                    },
                    "translations": {
