                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "welding_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De inspecteur keurde de <w>las</w> af omdat er scheurtjes in zaten.",
                            "target_lang_translations": {
                                "en": "The inspector rejected the <w>weld</w> because there were cracks in it.",
                                "ru": "Инспектор забраковал <w>сварной шов</w>, потому что в нем были трещины."
                            }
                        },
                        {
                            "text": "Een goede <w>las</w> is net zo sterk als het materiaal zelf.",
                            "target_lang_translations": {
                                "en": "A good <w>weld</w> is just as strong as the material itself.",
                                "ru": "Хорошая <w>спайка</w> такая же прочная, как и сам материал."
                            }
