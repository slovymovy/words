                        "glosses": [
                            "een reis met een slee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de070932-b155-4aea-b457-cf5a6a4bdc47",
                                "sense_id": "b984481b-8b23-3883-8d01-7483759c7585",
                                "text": "Verkleedpartij en sledetocht naar de buurvrouw, de weduwe Meljoekova en haar kinderen."
                            },
                            {
                                "example_id": "748b88d8-551c-44b0-9859-77a0a0580591",
                                "sense_id": "b984481b-8b23-3883-8d01-7483759c7585",
                                "text": "Een winter met zo veel sneeuw hebben ze in dit deel van Zweden in geen 20 jaar meegemaakt. Nies (78) en Hyls (78) Heeringa uit Enschede zitten al twee maanden ingesneeuwd, met hun veertien honden. Van een sledetocht is nog niets gekomen. Een Twents bericht uit Granberget."
                            }
                        ]
                    }
