                        "vredige sfeer"
                    ],
                    "target_lang_definitions": {
                        "en": "free from conflict, struggle, or unrest; characterized by peace and harmony",
                        "de": "frei von Streit, Konflikten oder Unruhe; geprägt von Ruhe und Harmonie"
                    },
                    "translations": {
