                "senses": [
                    {
                        "sense_id": "afaa283c-7757-336f-9578-27f319be6e98",
                        "entry_id": "206813cf-f6a9-3695-8130-2b8d95f43085",
                        "glosses": [
                            "Nichtaufnahme von Fällen in eine Statistik, weil sie (noch) nicht bekannt/entdeckt sind"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "d73d6d9a-6f6d-4772-bdbb-8663220a9c33",
                                "sense_id": "afaa283c-7757-336f-9578-27f319be6e98",
                                "text": "„In diesem Zusammenhang sind auch die ‚Untersuchungen zur Methode und Genauigkeit der Volkszählung 1970‘ von Interesse, in denen u. a. detailliert auf die Über- und Untererfassungen bei der Wohnbevölkerung eingegangen wird […].“"
                            },
                            {
                                "example_id": "4f835bf1-c6c4-4bae-86a8-c29bc18f55f6",
                                "sense_id": "afaa283c-7757-336f-9578-27f319be6e98",
                                "text": "„Zwar gilt keine Selbsttötungsstatistik der Welt als absolut vollständig, und auch bei der NVA ist, trotz strenger Meldeordnung, eine Untererfassung nicht auszuschließen.“"
                            },
                            {
                                "example_id": "a1aa5998-c994-4200-b882-a0d950dc794f",
                                "sense_id": "afaa283c-7757-336f-9578-27f319be6e98",
                                "text": "„Verglichen mit Nordamerika liegt die Untererfassung in Deutschland in den Jahren 1992–2001 bei etwa 13% für alle ZNS-Tumoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
