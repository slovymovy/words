                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4d91434c-c5a3-4854-8310-993a40c74033",
                        "entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
