                        ],
                        "examples": [
                            {
                                "example_id": "067fce9d-e184-4beb-865a-1000e4e58dab",
                                "sense_id": "eb4903ab-b9ff-381d-bf80-1a988936c606",
                                "text": "We agreed that the operation would have to be mounted under conditions of the strictest secrecy, so that the Grenadian forces and Cubans on Grenada would not have time to bring in reinforcements or to make a run for the American students at St. George's University Medical School."
                            },
                            {
                                "example_id": "ab3ba2e4-d5f3-4330-a6d4-43baadd116ff",
                                "sense_id": "eb4903ab-b9ff-381d-bf80-1a988936c606",
                                "text": "They invited him to Grenadian feasts in their house near the Oval."
                            }
                        ]
                    }
