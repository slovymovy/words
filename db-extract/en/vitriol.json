                        "entry_id": "7b9b75d2-3f81-3a74-9923-2e162a095dd9",
                        "glosses": [
                            "Bitterly abusive language."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1fcc2a8-0c8d-4893-8083-6092d4c1401f",
                                "sense_id": "2aa8935a-af3a-3bac-8d43-9a7c8f9b86fb",
                                "text": "For days, online forums sparked with outrage against politicians and race organizers, a tone that turned to vitriol against runners, even from some shaming other runners for being selfish."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d408bd-d01c-4fd9-9116-8865c86b9707",
                        "source_entry_id": "7b9b75d2-3f81-3a74-9923-2e162a095dd9",
