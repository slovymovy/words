                ],
                "senses": [
                    {
                        "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                        "entry_id": "08b3d057-8b12-3b1e-921f-84571eb31d17",
                        "glosses": [
                            "Petite flamme qui se détache d’une matière en combustion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1fa27c-36d8-47da-b8db-68153be1ebef",
                                "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                                "text": "Comme la flammèche qui jette le feu à un champ mûr, les larmes de Rosa et de ses compagnes gagnèrent en un instant toute la foule."
                            },
                            {
                                "example_id": "e8ba7395-a69d-4284-b8c4-557bf8462d85",
                                "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                                "text": "Une pluie de flammèches et de cendres tombait autour de moi et je m’aperçus bientôt que mes habits et mes mains en étaient noircis."
                            },
                            {
                                "example_id": "534e522a-fb5c-4001-8ab6-5df1ad344f09",
                                "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                                "text": "Ma tante m’avait appris à souffler sur les bûches dans la cheminée et à en faire jaillir des étincelles, et je croyais, sur sa parole, que toutes ces lumières dans le ciel n’étaient que les flammèches d’un feu que soufflait un personnage de nos voisins."
                            },
                            {
                                "example_id": "641757b8-211d-41b2-83ec-901b205ea340",
                                "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                                "text": "Ça risque de provoquer des flammèches, car autant des députés anglophones du Québec s’inquiètent, avec raison, au chapitre des droits linguistiques, autant des députés de l’Ouest canadien lorgnent avec intérêt cette nouvelle possibilité de changer la Constitution à leur façon."
                            },
                            {
                                "example_id": "c26ddb40-71ea-4a74-b22d-d3ee9d0381c4",
                                "sense_id": "ca0d86f0-b6c1-3ba1-9532-fffb0e693bca",
                                "text": "Il ne faut qu’une petite flammèche pour causer un grand embrasement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "498c1d9b-96b5-4c87-8b9c-b128c9488199",
