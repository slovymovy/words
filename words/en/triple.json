    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdb06116-c062-340a-895e-112fbfa6067e",
                    "sense_definition": "Made up of three related parts or elements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "composition_three",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The figure skater landed a perfect <w>triple</w> axel during the competition.",
                            "target_lang_translations": {
                                "ru": "Фигурист выполнил идеальный <w>тройной</w> аксель во время соревнований.",
                                "zh": "那名花样滑冰选手在比赛中完成了一个完美的<w>三周</w>阿克塞尔跳。"
                            }
                        },
                        {
                            "text": "This security system uses a <w>triple</w> lock mechanism for extra safety.",
                            "target_lang_translations": {
                                "ru": "Эта система безопасности использует <w>тройной</w> запорный механизм для дополнительной надежности.",
                                "zh": "这套安保系统采用了<w>三重</w>锁定机制，以提高安全性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "threefold",
                        "three-part"
                    ],
                    "antonyms": [
                        "single"
                    ],
                    "common_phrases": [
                        "triple jump",
                        "triple crown",
                        "triple threat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из трёх связанных частей или элементов.",
                        "zh": "由三个相互关联的部分或要素组成的。"
                    },
                    "translations": {
                        "ru": [
                            {
