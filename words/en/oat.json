{
    "word_family": [
        "oatmeal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59f582f9-8c5a-39a4-a747-364882077e20",
                    "sense_definition": "A widely cultivated cereal grass used as a food crop.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>oat</w> stalks are often used as straw for farm animals.",
                            "target_lang_translations": {
                                "pl": "Łodygi <w>owsa</w> są często używane jako słoma dla zwierząt gospodarskich."
                            }
                        },
                        {
                            "text": "Farmers grow <w>oat</w> crops in large fields during the summer.",
                            "target_lang_translations": {
                                "pl": "Rolnicy uprawiają <w>owies</w> na dużych polach latem."
                            }
                        }
                    ],
                    "synonyms": [
                        "cereal"
                    ],
                    "common_phrases": [
                        "oat crop",
                        "oat field"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powszechnie uprawiana roślina zbożowa wykorzystywana jako roślina uprawna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "owies",
                                "target_lang_sense_clarification": "roślina zbożowa z rodziny wiechlinowatych"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb9fe545-da0a-30be-bb2a-fc08a8cf1e71",
                    "sense_definition": "The edible seeds of the oat plant, used for human food or animal feed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people enjoy eating <w>oats</w> for breakfast with milk.",
                            "target_lang_translations": {
                                "pl": "Wiele osób lubi jeść <w>owies</w> na śniadanie z mlekiem."
                            }
                        },
                        {
                            "text": "The horse was fed a bucket of <w>oats</w> after the long ride.",
                            "target_lang_translations": {
                                "pl": "Koń dostał wiadro <w>owsa</w> po długiej przejażdżce."
                            }
                        }
                    ],
                    "synonyms": [
                        "grain"
                    ],
                    "common_phrases": [
                        "rolled oats",
                        "oats and milk"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jadalne ziarna owsa, używane jako pożywienie dla ludzi lub pasza dla zwierząt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "owies",
                                "target_lang_sense_clarification": "ziarno owsa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc2fb58c-ce3c-3df0-a737-2f9bfda7b287",
                    "sense_definition": "Any of the various species of grain plants belonging to the genus Avena.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Botanists study the wild <w>oat</w> to understand the history of modern agriculture.",
                            "target_lang_translations": {
                                "pl": "Botanicy badają dziki <w>owies</w>, aby zrozumieć historię współczesnego rolnictwa."
                            }
                        },
                        {
                            "text": "There are many different varieties of <w>oat</w> found in nature.",
                            "target_lang_translations": {
                                "pl": "W naturze występuje wiele różnych odmian <w>owsa</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Każdy z różnych gatunków roślin zbożowych należących do rodzaju Avena."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "owies",
                                "target_lang_sense_clarification": "rodzaj rośliny zbożowej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14ab9953-c49f-3967-8a04-30caddf5b3e3",
                    "sense_definition": "A very small amount of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not care an <w>oat</w> about the outcome of the argument.",
                            "target_lang_translations": {
                                "pl": "Nie obchodził go ani <w>jeden owies</w> (w znaczeniu: ani trochę) wynik kłótni."
                            }
                        },
                        {
                            "text": "She did not give an <w>oat</w> for his opinion on the matter.",
                            "target_lang_translations": {
                                "pl": "Nie przejmowała się ani <w>odrobinę</w> jego opinią w tej sprawie."
                            }
                        }
                    ],
                    "synonyms": [
                        "whit",
                        "jot",
                        "iota"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo mała ilość czegoś (użycie przestarzałe)."
                    },
                    "translations": {
                        "pl": []
                    }
                },
                {
                    "sense_id": "6cb577a7-ba5c-3291-945a-029363000cd0",
                    "sense_definition": "A simple musical pipe made from the straw of an oat plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd played a simple tune on his <w>oat</w> pipe.",
                            "target_lang_translations": {
                                "pl": "Pasterz grał prostą melodię na swojej <w>owsianej</w> piszczałce."
                            }
                        },
                        {
                            "text": "In ancient times, a rustic <w>oat</w> was often used by musicians.",
                            "target_lang_translations": {
                                "pl": "W starożytności prosta <w>owsiana</w> piszczałka była często używana przez muzyków."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prosta piszczałka muzyczna wykonana ze słomy owsianej (użycie historyczne)."
                    },
                    "translations": {
                        "pl": []
                    }
                }
            ]
        }
    ]
}