                "senses": [
                    {
                        "sense_id": "54c36adc-bac8-3459-9c7e-82bc9ed90e9b",
                        "entry_id": "4efb5d03-b1c4-3c66-8392-e12e9c8833d6",
                        "glosses": [
                            "Celui qui participe à un lynchage, une exécution sommaire commise par une foule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c6b7a8-3234-4e69-a008-45b928f547f2",
                                "sense_id": "54c36adc-bac8-3459-9c7e-82bc9ed90e9b",
                                "text": "C’était déjà une première victime ; mais ce sang qui coulait à flots n’avait pas encore apaisé la soif de vengeance des lyncheurs."
                            },
                            {
                                "example_id": "ff63fadb-004a-4096-9aed-aa9d23c5ff2f",
                                "sense_id": "54c36adc-bac8-3459-9c7e-82bc9ed90e9b",
                                "text": "En tout lecteur de roman policier comme en tout lecteur de roman d’aventure, il y a un lyncheur qui sommeille."
                            },
                            {
                                "example_id": "6d6c3bf9-99ba-41d6-87d3-25eb38b89b80",
                                "sense_id": "54c36adc-bac8-3459-9c7e-82bc9ed90e9b",
                                "text": "Ne pouvons-nous pas admirer l’héroïsme de l’homme qui ose se dresser dans une foule hurlante, en délire de lynchage, et qui ose dire « non », car sa conscience ne lui permet pas de rejoindre les lyncheurs, les assassins, et pourtant il sait que cette foule va le piétiner."
                            }
                        ]
                    }
                ],
