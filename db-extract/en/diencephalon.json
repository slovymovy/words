                                        "sense_id": "5cd43400-9d84-30a1-8553-22bff986a64c",
                                        "entry_id": "4caf8759-e4c3-308f-abd1-4a85407b6418",
                                        "glosses": [
                                            "En neuroanatomie des vertébrés, désigne des ensembles de substance grise, de forme ovoïde situés au milieu et à la base du cerveau, soit aussi une partie du tronc cérébral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa8f74b-0509-4edd-86c9-62e406a11d89",
                                                "sense_id": "5cd43400-9d84-30a1-8553-22bff986a64c",
                                                "text": "Mais sans doute toutes les glandes endocrines ne possèdent-elles pas au même point le pouvoir de faire décircuiter, par l’intermédiaire du diencéphale, le foie."
                                            },
                                            {
                                                "example_id": "4005c2ec-5aba-43b0-9bc9-c83917939e6f",
                                                "sense_id": "5cd43400-9d84-30a1-8553-22bff986a64c",
                                                "text": "Le diencéphale précède dans la série animale le développement du cortex, dont l’expansion le fait peu à peu passer au second plan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
