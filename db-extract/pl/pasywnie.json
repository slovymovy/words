                        "translation_id": "2c26d399-4f2f-4704-a486-59c1c60b4c3a",
                        "source_entry_id": "76ec1222-aa16-3169-9b40-6103f5482f7a",
                        "source_sense_id": "bb253c9d-a454-3091-b29c-46e182b9db1c",
                        "target_lang_word": "passively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baa6e30c-3677-3436-9552-6d270f4ebb89",
                                        "entry_id": "f7c8fcb4-ce0a-3a02-b343-1c6979da0e77",
                                        "glosses": [
                                            "In a passive manner; without conscious or self-directed action."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "284da06e-e18f-40a5-9c7e-698362b43632",
                                                "sense_id": "baa6e30c-3677-3436-9552-6d270f4ebb89",
                                                "text": "Water flowed passively between tanks via the siphon."
                                            },
                                            {
                                                "example_id": "e7c236bd-a3de-4152-946e-69adcd0a299b",
                                                "sense_id": "baa6e30c-3677-3436-9552-6d270f4ebb89",
                                                "text": "Due to this pressure aortic and pulmonary valves are opened passively and due to relaxation blood is sucked from the venae cavae into the atrium."
                                            },
                                            {
                                                "example_id": "d8b1391f-6da6-469b-b0b9-57d23ee8c541",
                                                "sense_id": "baa6e30c-3677-3436-9552-6d270f4ebb89",
                                                "text": "For most people, this sacrifice is made easily and instinctively. Not so for otroverts, who are neither willing nor able to passively adopt the social scripts that others do. To the otrovert, who is constantly engaged with the choices and consequences of their individual life, social norms follow a circular logic: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "effcbf8c-708f-37a5-abc9-fb911e3defff",
                                        "entry_id": "f7c8fcb4-ce0a-3a02-b343-1c6979da0e77",
                                        "glosses": [
                                            "In an acquiescent manner; resignedly or submissively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8035aa9-1902-407c-9d5b-c836a4542b98",
                                                "sense_id": "effcbf8c-708f-37a5-abc9-fb911e3defff",
                                                "text": "Paradoxically, the same faculty who complain about busyness are most likely to end up waiting passively. While they acquiescently wait to write, they busy themselves with other, often trivial, activities."
                                            },
                                            {
                                                "example_id": "8a6dd782-ceac-4b04-90a4-78d5ca6bb01c",
                                                "sense_id": "effcbf8c-708f-37a5-abc9-fb911e3defff",
                                                "text": "They were not waving at him but sat passively as if waiting to hear if what he had to say would be derogatory to their previous relationship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1670d3bb-0e8d-33ff-93b4-23f82292443d",
                                        "entry_id": "f7c8fcb4-ce0a-3a02-b343-1c6979da0e77",
                                        "glosses": [
                                            "In the passive voice; having a passive construction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0081c5d1-9723-44a6-8236-fd0baf719a77",
                                                "sense_id": "1670d3bb-0e8d-33ff-93b4-23f82292443d",
                                                "text": "Statements phrased in an active voice, with a few outcome-oriented goals, improve school performance more than those stated passively with either multiple goals or goals focused on processes or behaviors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
