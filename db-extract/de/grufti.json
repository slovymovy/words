                ],
                "senses": [
                    {
                        "sense_id": "1562fb4c-8737-398b-932d-9cf6accf0f42",
                        "entry_id": "b3bf9fce-94e2-3828-8bdb-5b5154f018ac",
                        "glosses": [
                            "alter Mensch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "984d98ad-fb33-45e3-b17f-a31d029bd8ad",
                                "sense_id": "1562fb4c-8737-398b-932d-9cf6accf0f42",
                                "text": "„Als junger Kerl wollte ich immer zur See fahren, und jetzt als Grufti ist es endlich soweit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "241e37fe-f11d-3fef-9c19-f261ae7cf8b7",
                        "entry_id": "b3bf9fce-94e2-3828-8bdb-5b5154f018ac",
                        "glosses": [
                            "alteingesessener, altmodischer Mensch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a9484ce8-16fd-48a6-aa92-5a7817a4255f",
                                "sense_id": "241e37fe-f11d-3fef-9c19-f261ae7cf8b7",
                                "text": "„In Neudeutsch wetterte er gegen Zehetmeier: ‚Der ist doch ein Komposti, ein Verwesi, eine Made im Speck.‘ Und ein Grufti sei er, befand Kiesl über den 55jährigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "99f56c63-bc85-3e8d-86ed-8baf15a7e600",
                        "entry_id": "b3bf9fce-94e2-3828-8bdb-5b5154f018ac",
                        "glosses": [
                            "Mitglied der Schwarzen Szene, Anhänger der Gothic-Kultur seit den 1980er Jahren"
                        ],
                        "tags": [
                            "Jugendkultur",
                            "Szene"
                        ],
                        "examples": [
                            {
                                "example_id": "71557e87-ae16-4ac0-a6bd-3c0461e13374",
                                "sense_id": "99f56c63-bc85-3e8d-86ed-8baf15a7e600",
                                "text": "„Wer sich mit Patschuli eindieselt, muss verknusen können, für einen Grufti gehalten zu werden.“"
                            },
                            {
                                "example_id": "d8c6a9e7-4552-4d38-85c0-641f4a0c016a",
                                "sense_id": "99f56c63-bc85-3e8d-86ed-8baf15a7e600",
                                "text": "„Dann durften auf Photos und in Artikeln eine Zeitlang keine Randgruppen erscheinen, weder Skins noch Gruftis.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82e39554-a116-4621-b7d4-59c3a2ad625a",
                        "source_entry_id": "b3bf9fce-94e2-3828-8bdb-5b5154f018ac",
                        "source_sense_id": "1562fb4c-8737-398b-932d-9cf6accf0f42",
                        "source_sense_description": "umgangssprachlich: alter Mensch",
                        "target_lang_word": "old fogey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "old fogey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "930c1c04-88bc-3127-b1ec-608d364e394b",
                                        "entry_id": "2a63bbc5-cb6e-3ef8-85e6-0a9ff9b22f5f",
                                        "glosses": [
                                            "An old and overly conservative person."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d05edc0a-c5f5-4b4d-94c9-093679d46b1a",
                                                "sense_id": "930c1c04-88bc-3127-b1ec-608d364e394b",
                                                "text": "\"No; the Athletic. Tell you: Course they're always asking me to join the Union, but I always say, 'No, sir! Nothing doing!' I don't mind the expense but I can't stand all the old fogies.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a79b5dd7-c7da-4e7a-a16b-e05fd44d394e",
                        "source_entry_id": "b3bf9fce-94e2-3828-8bdb-5b5154f018ac",
                        "source_sense_id": "99f56c63-bc85-3e8d-86ed-8baf15a7e600",
                        "source_sense_description": "Mitglied der Schwarzen Szene, Anhänger der Gothic-Kultur",
                        "target_lang_word": "goth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643184c9-531f-3b91-8f49-04355f2b9529",
                                        "entry_id": "0557d57f-d2b8-3648-8931-0b54a4aebc5d",
                                        "glosses": [
                                            "A punk-derived subculture of people who predominantly dress in black, associated with mournful music and attitudes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e82d4e9-5f74-4f61-8d00-1f547868fe19",
                                                "sense_id": "643184c9-531f-3b91-8f49-04355f2b9529",
                                                "text": "I think that goth could flower in nerdcore's embrace.\nI converted Edward Gorey's lettering into a typeface,\nbefriended vampires on LJ and MySpace,\neven put that spooky echo filter on the bass[…]"
                                            },
                                            {
                                                "example_id": "533fa19a-b43c-4956-95e6-5ed90823e24e",
                                                "sense_id": "643184c9-531f-3b91-8f49-04355f2b9529",
                                                "text": "Philip has been into goth for many years, haven't you dear?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7832a2a-0d7a-3297-8101-25f6e061297e",
                                        "entry_id": "0557d57f-d2b8-3648-8931-0b54a4aebc5d",
                                        "glosses": [
                                            "A style of punk rock influenced by glam rock; gothic rock."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c6f237d-05b0-3812-9f0d-32a88348e2c7",
                                        "entry_id": "0557d57f-d2b8-3648-8931-0b54a4aebc5d",
                                        "glosses": [
                                            "A person who is part of the goth subculture."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b304f7-cff7-463d-a8ed-b437a4123e7d",
                                                "sense_id": "4c6f237d-05b0-3812-9f0d-32a88348e2c7",
                                                "text": "And how come you never see goths driving cars?\nWe drive cars... We're just like you really, except that we listen to Cradle of Filth."
                                            },
                                            {
                                                "example_id": "5c0c5efe-41e8-4246-b351-53a5a3b27965",
                                                "sense_id": "4c6f237d-05b0-3812-9f0d-32a88348e2c7",
                                                "text": "We saw a solitary goth hanging out on a ledge by the train station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48b65a4-00e2-3653-87c5-b8aeb2b3b85f",
                                        "entry_id": "0557d57f-d2b8-3648-8931-0b54a4aebc5d",
                                        "glosses": [
                                            "Rare form of Goth."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e12db1-0293-4ed7-b78e-07f4041a742d",
                                                "sense_id": "c48b65a4-00e2-3653-87c5-b8aeb2b3b85f",
                                                "text": "At Madras we arriv’d in the height of confuſion, / A ſcene all occaſion’d by Hyder’s intruſion; / A goth-like invader! who doth us all keep / Penn’d up in a fort, like a ſcar’d flock of ſheep; […]"
                                            },
                                            {
                                                "example_id": "b1244213-0495-4df6-8e83-ed9874396910",
                                                "sense_id": "c48b65a4-00e2-3653-87c5-b8aeb2b3b85f",
                                                "text": "By much, they are a horde of all nations, a goth-like banditti, savage and wild, whose numbers bid defiance to all around; […]"
                                            },
                                            {
                                                "example_id": "796b7707-d80e-437b-96f8-b8affb39ab1a",
                                                "sense_id": "c48b65a4-00e2-3653-87c5-b8aeb2b3b85f",
                                                "text": "In 1843, in the course of agricultural improvements, Mr. Byrse committed a very goth-like deed, to wit, blasting with gunpowder two excellent specimens of clachchriothir, or rocking-stones—and building the remains into dikes!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c980f0b3-b92b-3222-a4f2-102dda87bf90",
                                        "entry_id": "269c713e-a717-3042-812b-863ef5d911bf",
                                        "glosses": [
                                            "Relating to goth music or people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52d2482-b54e-4955-a96a-65248b9057ae",
                                                "sense_id": "c980f0b3-b92b-3222-a4f2-102dda87bf90",
                                                "text": "With her black clothes and dyed hair, Melanie looked very goth compared to her classmates."
                                            },
