                "senses": [
                    {
                        "sense_id": "51a8b6f3-d664-32e0-bde1-50335810f4e1",
                        "entry_id": "46b064f2-95e9-309e-9aee-e8549ccc5093",
                        "glosses": [
                            "Vervielfachung eines einzelnen Chromosoms, die ohne eine Teilung der Zelle vollzogen wird"
                        ],
                        "tags": [
                            "Genetik",
                            "Zytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "876d0900-c911-4eda-817c-269fc023a70b",
                                "sense_id": "51a8b6f3-d664-32e0-bde1-50335810f4e1",
                                "text": "„Die Entspiralisierung von Chromosomen lässt sich am besten an den Riesenchromosomen der Fruchtfliege Drosophila untersuchen.“"
                            },
                            {
                                "example_id": "99757f71-d32f-4edc-a4ac-1685bfe440aa",
                                "sense_id": "51a8b6f3-d664-32e0-bde1-50335810f4e1",
                                "text": "„Messungen des DNA-Gehalts haben ergeben, dass die Vermehrung der DNA in den Riesenchromosomen mit dem Faktor 2n erfolgt.“"
                            },
                            {
                                "example_id": "475c16da-2b8e-404e-aa0e-2acc80b74188",
                                "sense_id": "51a8b6f3-d664-32e0-bde1-50335810f4e1",
                                "text": "„Dieser lineare Aufbau der Riesenchromosomen besteht nicht in einer Wiederholung gleichförmiger Abschnitte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
