                        ],
                        "form": "die Schleifmittel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                        "entry_id": "6046d2ff-c972-3342-8dc7-ab3cbb03b600",
                        "glosses": [
                            "harte, scharfe, feinkörnige Substanz zum Schleifen und Glätten von Gegenständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d293ff3-f1a9-4802-adf2-0f5da7ff9ad9",
                                "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                                "text": "„Zum Schleifen verwendet man die Schleifmittel in verschiedenen Formen: als Pulver, als Papier, als Leinen, als Steine und als Schleifräder.“"
                            },
                            {
                                "example_id": "67a59088-4456-47ad-b3a7-139161b73f90",
                                "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                                "text": "„Das gekörnte Schleifmittel wird durch Hanfleim auf dem Papier und den Geweben gehalten.“"
                            },
                            {
                                "example_id": "c2c4e78e-35cc-4a19-86e7-bc50164416d6",
                                "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                                "text": "„Meist ist das Schleifmittel aufgeleimt auf Holzscheiben, die noch mit Leder, Pappe oder Filz belegt sein können, oder auf Korkscheiben.“"
                            },
                            {
                                "example_id": "37b6f154-246f-4e42-a249-dd3449e52484",
                                "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                                "text": "„An Schleifmittel für Schleifscheiben werden hohe Anforderungen vor allem in bezug auf Härte, Wärmebeständigkeit und chemische Beständigkeit gestellt.“"
                            },
                            {
                                "example_id": "50f252bd-6de0-46a4-9193-4ca1d8c26f28",
                                "sense_id": "4a1d14fe-301d-39c4-8ae5-6849ebdf5721",
                                "text": "„Schleifmittel feinen Grades gefährden beim Trockenschleifen die Oberfläche des Werkstücks durch Überhitzen und verursachen Werfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
