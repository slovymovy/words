                "senses": [
                    {
                        "sense_id": "ba645ce0-62f1-3d42-9605-1d246e0671de",
                        "entry_id": "add8bfa3-2b4a-3f66-9067-0799756b5d53",
                        "glosses": [
                            "politische Gemeinde gemäß einer Kommunalverfassung, die in der Tradition des Römischen Reichs steht (so wie zum Beispiel in Italien, Spanien, Portugal, Rumänien und deren früheren Kolonien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb40eb7-e200-4a3f-8f2e-618cd36a8331",
                                "sense_id": "ba645ce0-62f1-3d42-9605-1d246e0671de",
                                "text": "„Das Munizip lieh nämlich den Indianergemeinschaften eine Viehherde so lange, bis diese sich reproduziert hatte. Dann gaben die Indianer dem Munizip dieselbe Kopfzahl an Rindern zurück.“"
                            },
                            {
                                "example_id": "eb3570e3-66ee-41b9-8b43-38bb676c5747",
                                "sense_id": "ba645ce0-62f1-3d42-9605-1d246e0671de",
                                "text": "„Auf diese Weise wurden die finanziellen Zuwendungen für das einwohnerstarke Munizip San Julián reduziert und damit die vom Gemeindehaushalt abhängigen OTBs („Organizaciones Territoriales de Base“) geschwächt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b775187f-8349-426b-b603-2586f25ab54d",
                        "source_entry_id": "add8bfa3-2b4a-3f66-9067-0799756b5d53",
