                        "entry_id": "5a9226d0-f5af-350b-acc7-69d3b49a3bff",
                        "glosses": [
                            "Hirsch mit in zwölf Enden auslaufendem Geweih beziehungsweise dieses selbst"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "2097b27d-64af-4bac-960e-ce32e87fdc9c",
                                "sense_id": "f2ae2205-03fd-3470-8ae0-118c7d95b8c7",
                                "text": "„[…] Du wirst sehen, diesmal werde ich den Zwölfender erlegen. Der entkommt mir nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
