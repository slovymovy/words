                        "sense_id": "1d0764e4-388a-34a7-912c-71458f7d7c83",
                        "entry_id": "fc2ad934-d173-315b-ad79-b14d5d7c81aa",
                        "glosses": [
                            "Sorte de fondation religieuse."
                        ],
                        "tags": [
