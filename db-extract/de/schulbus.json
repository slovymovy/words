                                        "glosses": [
                                            "Véhicule de transport en commun, fondamentalement conçu pour transporter des écoliers et étudiants entre leur lieu de résidence et un lieu d’enseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
