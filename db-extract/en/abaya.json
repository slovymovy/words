                    {
                        "translation_id": "b26293f4-c3d8-47ff-adca-d99f89489e0d",
                        "source_entry_id": "7082fefd-2ea4-309d-bb48-6d1036b84249",
                        "source_sense_id": "aadec118-ac44-3db3-831d-ef90e8b3107b",
                        "source_sense_description": "coarse, often striped, felted fabric from the Middle East, woven from goat or camel hair",
                        "target_lang_word": "abaya",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abaya",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efdbab3f-7a73-3593-ac2a-334c4ecd8f5d",
                                        "entry_id": "a2810b2c-3774-3b06-b58e-41c7a1239fde",
                                        "glosses": [
                                            "Longue robe couvrante portée par certaines femmes du Moyen-Orient et des pays du Maghreb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "339d7ec2-da64-4ca7-a0cd-e3962443b27b",
                                                "sense_id": "efdbab3f-7a73-3593-ac2a-334c4ecd8f5d",
                                                "text": "Ils nous font quoi avec l’abaya ?"
                                            },
                                            {
                                                "example_id": "c20bb6f1-4fd4-4ee4-bd3f-016497283d95",
                                                "sense_id": "efdbab3f-7a73-3593-ac2a-334c4ecd8f5d",
                                                "text": "Les femmes non qataries ne sont pas tenues de porter l’abaya, une longue robe noire qui couvre la silhouette presque de la tête aux pieds, mais les touristes doivent s’assurer que les hauts couvrent leur ventre et leurs épaules, tandis que les jupes, les robes et les pantalons doivent cacher les genoux."
                                            },
                                            {
                                                "example_id": "ff7596c1-42bc-4a18-a5c6-4e5932bd000a",
                                                "sense_id": "efdbab3f-7a73-3593-ac2a-334c4ecd8f5d",
                                                "text": "Baneen a soupiré. Elle m’a regardée d’un air méfiant, elle n’est pas idiote. Elle est allée enfiler son abaya avec le léger dandinement que la grossesse lui inflige."
                                            },
                                            {
                                                "example_id": "e6cb4799-36cc-474a-ab19-0d32b09bea9e",
                                                "sense_id": "efdbab3f-7a73-3593-ac2a-334c4ecd8f5d",
                                                "text": "Il y a des accommodements : le tissu de l’abaya peut s’éclaircir au poignet et révéler les bijoux en or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff51760f-d3e4-3137-b9ee-cff40fa20151",
                                        "entry_id": "a2810b2c-3774-3b06-b58e-41c7a1239fde",
                                        "glosses": [
                                            "Long vêtement porté par certains hommes, notamment au Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63117eda-fa52-4f63-951b-ad0eaca5c91a",
                                                "sense_id": "ff51760f-d3e4-3137-b9ee-cff40fa20151",
                                                "text": "C’était Saïd beyk, seigneur druze du village de Sahlaïn, vêtu d’une longue abaya aux rayures franches, qui tombait des épaules aux mollets, ajoutant à la majesté de son visage orné d’une moustache blonde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
