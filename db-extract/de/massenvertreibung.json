                "senses": [
                    {
                        "sense_id": "14fab5c6-99df-320b-ad5c-99d72490fe9a",
                        "entry_id": "3e7aa9ad-ae13-34b6-ad56-67a680ab7260",
                        "glosses": [
                            "Vertreibung einer großen Zahl von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bd980b-b70e-4605-a71c-55734674dfa9",
                                "sense_id": "14fab5c6-99df-320b-ad5c-99d72490fe9a",
                                "text": "„Organisierte Massenvertreibungen sind in der modernen Zeit ohne ausgedehnte Lagersysteme kaum denkbar.“"
                            },
                            {
                                "example_id": "642ca627-4c3d-4f04-aa1d-82952b07c08c",
                                "sense_id": "14fab5c6-99df-320b-ad5c-99d72490fe9a",
                                "text": "„Der war zwar niemals bereit, eine Massenvertreibung aller Deutschen zu akzeptieren, aber er machte allerhand Kompromisse.“"
                            },
                            {
                                "example_id": "c7d9478c-ef5e-4923-b042-b8cf7966a641",
                                "sense_id": "14fab5c6-99df-320b-ad5c-99d72490fe9a",
                                "text": "„Da sie bereits Erfahrungen in Massenvertreibungen besaßen, versuchten sie in Baysan eine zügige Räumung zu erzwingen, indem sie der Bevölkerung ein Ultimatum stellten, ihre Häuser innerhalb von zehn Stunden zu verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
