            {
                "entry_id": "c829aeef-c0a2-304a-8c6a-e182adebf150",
                "word": "Mazda",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "125d14e9-cef9-3010-b077-5a125ebfdd08",
                        "entry_id": "c829aeef-c0a2-304a-8c6a-e182adebf150",
                        "glosses": [
                            "Ormuzd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bcfbd30-d3be-47d7-ad61-0a73ca4a026c",
                                "sense_id": "125d14e9-cef9-3010-b077-5a125ebfdd08",
                                "text": "Adore-moi. Je suis aussi grand que ton maître.\nReconnais en nous deux les principes de l’Être.\nS’arrachant l’univers comme un maigre butin,\nAhriman et Mazda pétrissent le destin.\nNous sommes les jumeaux de l’éternel Abîme.\nLibrement j’ai choisi le mensonge et le crime,\nEt j’enveloppe tout de mes filets hideux ;\nMais le temps infini nous engendra tous deux.\nIl regarde, inactif et comme dans un rêve,\nAhriman et Mazda s’entrechoquer sans trêve."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "65746665-fc9c-3ae5-8475-451302dca865",
                "word": "Mazda",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
