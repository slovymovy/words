                        ],
                        "form": "geckos"
                    },
                    {
                        "form_id": "65021dfe-654c-4637-bd51-08671453cdfc",
                        "entry_id": "f63ad561-7b13-3597-b364-d7b11dc0c8db",
                        "tags": [],
                        "form": "gekko"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "289e5a17-a481-331a-960e-b6597464c8d6",
                        "entry_id": "f63ad561-7b13-3597-b364-d7b11dc0c8db",
                        "glosses": [
                            "Nom vernaculaire de nombreux lézards constituant l’infra-ordre des Gekkota."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cfb8af-167a-4e05-bd95-250a9321c919",
                                "sense_id": "289e5a17-a481-331a-960e-b6597464c8d6",
                                "text": "Elle s’amuse à traquer les geckos avec sa lampe de poche."
                            },
                            {
                                "example_id": "ec8abee8-eaa5-404d-8156-ded33269f6f2",
                                "sense_id": "289e5a17-a481-331a-960e-b6597464c8d6",
                                "text": "La tarente est un gecko nocturne très répandu dans le sud de la France et tout le pourtour méditerranéen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3d59236-a68f-430e-bd54-1ce7e42ac7f5",
                        "source_entry_id": "f63ad561-7b13-3597-b364-d7b11dc0c8db",
                        "source_sense_id": "289e5a17-a481-331a-960e-b6597464c8d6",
                        "target_lang_word": "Gecko",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gecko",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25477f12-f921-3b45-961b-cbc3dc6dd418",
                                        "entry_id": "9e61fa9a-b5b9-30d4-80b7-5435b18ce880",
                                        "glosses": [
                                            "eine Familie von kleinen bis mittelgroßen Kriechtieren aus der Unterordnung der Echsen, welche weltweit in den Tropen und Subtropen verbreitet ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd408029-154d-4411-b823-54d49b727aa6",
                                                "sense_id": "25477f12-f921-3b45-961b-cbc3dc6dd418",
                                                "text": "Der Gecko sitzt an einer Wand."
                                            },
                                            {
                                                "example_id": "49634e8c-bb25-46be-b173-f21acf58cae7",
                                                "sense_id": "25477f12-f921-3b45-961b-cbc3dc6dd418",
                                                "text": "Geckos können problemlos an Wänden und sogar an der Decke laufen."
                                            },
                                            {
                                                "example_id": "95fbd345-7489-4183-92b8-72e4e014d940",
                                                "sense_id": "25477f12-f921-3b45-961b-cbc3dc6dd418",
                                                "text": "Die meisten Geckonen sind ausgesprochen nachtaktiv."
                                            },
                                            {
                                                "example_id": "dcd914af-81f1-4a49-9f4a-f20ee7110b58",
                                                "sense_id": "25477f12-f921-3b45-961b-cbc3dc6dd418",
                                                "text": "„Geckos klebten überall an den Wänden und ließen ihre Zungen schnalzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ff83788-c022-46b5-9d10-491d8626f511",
                        "source_entry_id": "f63ad561-7b13-3597-b364-d7b11dc0c8db",
                        "source_sense_id": "289e5a17-a481-331a-960e-b6597464c8d6",
                        "target_lang_word": "gecko",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gecko",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc48030d-9deb-3c22-b83e-d3f9262fc374",
                                        "entry_id": "bc2ea17b-3580-352c-9396-811b2830f91e",
                                        "glosses": [
                                            "Any lizard in the infraorder Gekkota."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                        "entry_id": "bc2ea17b-3580-352c-9396-811b2830f91e",
                                        "glosses": [
                                            "Any lizard of the family Gekkonidae of small, carnivorous, mostly nocturnal animals with large eyes and adhesive toes enabling them to climb on vertical and upside-down surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784c1097-868c-4d3b-bcfa-57637e7d7f98",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "Order II. Sauria. […] The heart has two auricles. The body is covered with scales, and there are three or four feet. The lungs are large, and extend along the back. The mouth is armed with teeth, and the toes with claws. The tail is long, and often thick at the base. […] Geckotida—geco"
                                            },
                                            {
                                                "example_id": "bf7be059-9216-4dea-a383-2da895374419",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "Leishmania infantum in Experimental Animals.—Experiments were carried out with geckoes, white mice, field mice (Microtus güntheri) and hamsters (Cricetus auratus and Cricetulus griseus)."
                                            },
                                            {
                                                "example_id": "83a998f7-84ab-4ec1-b3b8-b9934c824f1e",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "GECKOES constitute a family of lizards remarkable for the large number of species it contains. They are also remarkable for a number of other features: for the readiness with which they have taken to living in houses, for their voices, the structure of their feet, the variation in the shape of the tail and for their eyes. […] As with the more familiar lizards, geckoes have the ability to cast the tail, and counts show that in some species two out of every five individuals have cast the tail and regenerated a new one."
                                            },
                                            {
                                                "example_id": "b5ee4ba8-10c5-4c15-a3cd-a6b36335ee97",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "Family Gekkonidae (gekkos). In gekkos the skull is short and flat; the upper temporal bone arch is missing; the post-orbital and lacrimal bones are absent; and the jugal bone is very reduced."
                                            },
                                            {
                                                "example_id": "69f3db37-a719-49f2-8757-d7c585325048",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "Many lizards, including the British common and sand lizards of the family Lacertidae, clamber over rocks with great agility; none matches the geckoes, some of which can run up, down, or across vertical glass as easily as most beasts run on the flat, and indeed can happily traverse ceilings."
                                            },
                                            {
                                                "example_id": "2c479baf-8a9e-4146-af5c-3cec3e5af190",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "Other reptiles found in the district are the chamaeleon, geco and monitor lizard, the last getting extinct due to netting and shooting. It is now protected by law."
                                            },
                                            {
                                                "example_id": "39949f52-ea93-4ecb-b315-8a54902ddcc1",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "The marvelous ability of geckos to run down trees, surefooted and head first, was first noted by Aristotle over two thousand years ago. However, Aristotle was not able to see the tiny hairs, called setae, that cover the toes of geckos and empower this feat. The setae are part of an adhesive system that allows geckos to maneuver on a wide variety of substrates, to run upside-down, and to arrest their falls. Geckos can run vertically at over 1 m/s and can carry over twice their body weight up smooth, vertical surfaces."
                                            },
                                            {
                                                "example_id": "b683e25d-cca6-4ab7-a251-0752df592604",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "The potential uses for gecko-inspired adhesive products are nearly endless. People have found possible uses for them from sports and robotics, to medicine and home improvement."
                                            },
                                            {
                                                "example_id": "cb5a4934-dc33-48b9-bcad-e1d3f444f318",
                                                "sense_id": "f32b75d4-9834-31f4-8e58-0ce00bd15a01",
                                                "text": "By day, Golden-tailed Geckoes rest under curls of bark, the underside of branches, or in tree hollows but they seem to be fond of heat so these geckoes may even be in a situation where the sun shines on their daytime retreat all day. The Golden-tailed Gecko is an invertebrate-eater and by night its adhesive toe pads allow it to prowl the branches of Brigalow trees with ease, looking for small insects and spiders to capture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gecko",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9502b586-29b9-3bcc-893f-ff1977ed9580",
                                        "entry_id": "3225895f-ca83-3723-a459-ca2ac6bf2577",
                                        "glosses": [
                                            "To move in the manner of a gecko; to attach to a vertical or upside-down surface."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e27526-1fbd-400d-8aab-3a3579f46c63",
                                                "sense_id": "9502b586-29b9-3bcc-893f-ff1977ed9580",
                                                "text": "An emergency handpad, geckoed to the expanding bulkhead, slid past to one side. Sarasti grabbed it and tapped commands."
                                            },
                                            {
                                                "example_id": "d78c8d7a-1d0d-4840-bcb8-376ece6d917a",
                                                "sense_id": "9502b586-29b9-3bcc-893f-ff1977ed9580",
                                                "text": "And as Dave geckoed his way along the walls, he began seeing more and more skid marks left behind by Damien's Sewer Cruiser."
                                            },
                                            {
                                                "example_id": "417ba573-f813-4326-b816-e019b093d0b9",
                                                "sense_id": "9502b586-29b9-3bcc-893f-ff1977ed9580",
                                                "text": "\"H-h-here, boss!\" Angelo called, and with that Dave kicked into gear, geckoing across the rest of the ceiling to the safety of the adjacent service room."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gecko",
                                "target_lang_code": "en",
                                "target_senses": [
