                                        "entry_id": "376eefce-0e10-3aac-ab94-7098f4691cf8",
                                        "glosses": [
                                            "Vorgang der Übertragung von Arbeit, die zuvor ein Mensch geleistet hat, auf Automaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51cf912-0b25-476b-963c-1563cfde2249",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "Die Autoindustrie setzt ganz auf die Automatisierung ihrer Produktion."
                                            },
                                            {
                                                "example_id": "89e08792-a67a-4b7c-ba53-6f173bc8cbd0",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "Im Jahr 1745 erfand der englische Schmied Edmund Lee eine frühe Vorrichtung zur Automatisierung, durch die sich Windmühlen selbstständig in den Wind drehen."
                                            },
                                            {
                                                "example_id": "8a5c1513-35ce-417e-97f8-edb354f0a81c",
                                                "sense_id": "a588d5a8-03c3-364f-9daa-340d0b8bd78e",
                                                "text": "„‚Auch die für die Euro-Produktion notwendigen Automatisierungen werden ja nicht wieder rückgängig gemacht, dafür waren sie zu teuer‘, so Kuhaupt.“"
                                            }
                                        ],
