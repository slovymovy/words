                    {
                        "form_id": "d60af411-2d5b-485d-a451-8d4a59fc9cc1",
                        "entry_id": "8c0e60a9-7a7b-366a-9d06-2b03990ac33b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hutzeln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a793459d-383e-3964-aea7-e794e2b769b0",
                        "entry_id": "8c0e60a9-7a7b-366a-9d06-2b03990ac33b",
                        "glosses": [
                            "gedörrte Frucht (besonders Birne, Zwetschge)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14619fb-52f6-4f21-a8ee-132ae2f17d56",
                                "sense_id": "a793459d-383e-3964-aea7-e794e2b769b0",
                                "text": "Spätsommer und Herbst waren einst Hutzel- und Dörrzeit."
                            },
                            {
                                "example_id": "75eb5c52-d212-4b09-bef7-0b98c2d0a9fd",
                                "sense_id": "a793459d-383e-3964-aea7-e794e2b769b0",
                                "text": "Die Hutzeln zu den Kartoffeln schütten und noch mal durchkochen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02d970d8-db2b-396e-b32f-e4646d5ca6ce",
                        "entry_id": "8c0e60a9-7a7b-366a-9d06-2b03990ac33b",
                        "glosses": [
                            "alte Frau mit runzliger Haut"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "e42ab5c3-d9da-4bdc-955d-5097dbadb3fc",
                                "sense_id": "02d970d8-db2b-396e-b32f-e4646d5ca6ce",
                                "text": "Ja, wenn ich eine Hutzel wäre, aber ich weiß, daß ich eine der schönsten Frauen innerhalb der Ringbahn bin, man hat es mir gesagt, sehr viele edle Herren."
                            },
                            {
                                "example_id": "8a0d9ce7-5f6c-4e67-8c12-c6b88f986be8",
                                "sense_id": "02d970d8-db2b-396e-b32f-e4646d5ca6ce",
                                "text": "Bald darauf standen auch die beiden Reisenden auf, die Gräfin trotz dem ärgerlichen Zwischenfall heiter aufgeregt und voll Scherz und Fröhlichkeit, der Graf in komischer Verdrossenheit, auf sein gerechtes Quartier verzichten und eine solche alte Hutzel bei seiner Frau in aller Bequemlichkeit lassen zu müssen, während er sich mit dem Heuboden getrösten sollte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a1094fb0-ceed-3240-af3c-f4ecfa617bed",
                        "entry_id": "8c0e60a9-7a7b-366a-9d06-2b03990ac33b",
                        "glosses": [
                            "Tannenzapfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e168fd77-2950-4af7-8677-9bd7923a1004",
                                "sense_id": "a1094fb0-ceed-3240-af3c-f4ecfa617bed",
                                "text": "Räume die Hutzeln und Äste weg, damit wir unser Zelt aufbauen können."
                            },
                            {
                                "example_id": "6b902e95-417d-4ad0-9ed9-5a32ab6a2e89",
                                "sense_id": "a1094fb0-ceed-3240-af3c-f4ecfa617bed",
                                "text": "Nach dem Kriege sammelten viele Menschen Hutzeln zum Heizen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
