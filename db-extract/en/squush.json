                "senses": [
                    {
                        "sense_id": "161a3979-ed98-3b07-8d50-7af0d2920323",
                        "entry_id": "a81f1712-cf04-3e59-8843-e6b64b113525",
                        "glosses": [
                            "A squashing or squishing sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab249a3b-e8fb-45f8-9a37-74b4d2d42b2d",
                                "sense_id": "161a3979-ed98-3b07-8d50-7af0d2920323",
                                "text": "Some men in the cellar were mixing mortar in trays with hoes. We watched them put sand and cement and lime and water together. Squush!"
                            },
                            {
                                "example_id": "6737a497-0476-432c-bfa8-9aac354b5d0c",
                                "sense_id": "161a3979-ed98-3b07-8d50-7af0d2920323",
                                "text": "They looked down at the ants and other bugs they saw and felt enormously big and powerful. They pretended the bugs were people. \"Got me a dozen!\" Squush."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
