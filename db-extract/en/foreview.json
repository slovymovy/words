                        "sense_id": "6bc1ce85-ac17-3960-a4f4-f6f21ac75b1a",
                        "entry_id": "7fec9725-3874-3c75-9c38-817fe4a8a6e7",
                        "glosses": [
                            "A forward view. Compare with rearview."
