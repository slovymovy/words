            {
                "entry_id": "429a2d00-5eec-36e6-8b2e-7ea377eda942",
                "word": "Ardennais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2aa3dcce-308e-426f-a09c-70463f0e6bab",
                        "entry_id": "429a2d00-5eec-36e6-8b2e-7ea377eda942",
                        "tags": [
                            "feminine"
