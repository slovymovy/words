                    {
                        "sense_id": "0d06f4be-41a4-37e1-852f-5387f2395166",
                        "entry_id": "747903c8-383d-3a29-991e-f985807e7533",
                        "glosses": [
                            "Ville de la région d’Émilie-Romagne en Italie, siège de la plus ancienne université du monde occidental puisqu’elle fut fondée en 1088."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7b22fd-c452-49f4-aea1-2e2a1fc6f16c",
                                "sense_id": "0d06f4be-41a4-37e1-852f-5387f2395166",
                                "text": "L’université de Bologne passe pour être la plus ancienne de toutes."
                            },
                            {
                                "example_id": "86fbffd5-73c0-47b2-b4a4-5d255a393125",
                                "sense_id": "0d06f4be-41a4-37e1-852f-5387f2395166",
                                "text": "Son père et sa mère décédés, Jacques resta à Bologne tant il se sentait attaché par tout son passé à la capitale de l’Émilie."
                            },
                            {
                                "example_id": "ecd3c92f-0601-467f-b23a-d121e4e63567",
                                "sense_id": "0d06f4be-41a4-37e1-852f-5387f2395166",
                                "text": "Les preuves ont encore été données ces derniers jours avec les arrivées d’Arthur Théate, contre 20 M€ (+ 2M € de bonus), en provenance de Bologne, et de Joe Rodon, prêté par Tottenham, avec une option d’achat du même tonneau."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e4803f8-02f1-359b-ab5d-a79fede0b241",
                        "entry_id": "747903c8-383d-3a29-991e-f985807e7533",
                        "glosses": [
                            "Province autour de cette ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1d4e29-9145-451f-807a-fe0e3ab89511",
                                "sense_id": "6e4803f8-02f1-359b-ab5d-a79fede0b241",
                                "text": "Province de Bologne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dc2381c-256c-4b22-9fa2-3ac5c8c2ba96",
