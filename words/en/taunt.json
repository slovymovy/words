{
    "word_family": [
        "taunter",
        "tauntingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca08d927-1c68-32f3-8003-42f65a817938",
                    "sense_definition": "To make fun of someone or goad them into responding in an aggressive manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullies would often <w>taunt</w> the younger students during recess.",
                            "target_lang_translations": {
                                "de": "Die Tyrannen würden die jüngeren Schüler in der Pause oft <w>verspotten</w>."
                            }
                        },
                        {
                            "text": "It is cruel to <w>taunt</w> someone about their personal failures.",
                            "target_lang_translations": {
                                "de": "Es ist grausam, jemanden wegen seiner persönlichen Misserfolge zu <w>hänseln</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock",
                        "tease",
                        "ridicule",
                        "jeer"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "common_phrases": [
                        "taunt someone"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich über jemanden lustig machen oder ihn provozieren, um eine aggressive Reaktion hervorzurufen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verspotten",
                                "target_lang_sense_clarification": "Sich boshaft über jemanden lustig machen."
                            },
                            {
                                "target_lang_word": "hänseln",
                                "target_lang_sense_clarification": "Jemanden necken oder verspotten, oft im schulischen oder sozialen Kontext."
                            },
                            {
                                "target_lang_word": "Spott treiben mit",
                                "target_lang_sense_clarification": "Eine Redewendung für das gezielte Verspotten einer Person."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e2ffaf3-fcd5-3ba7-863f-06f2e897daf6",
                    "sense_definition": "A scornful or mocking remark intended to provoke or insult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ignored the cruel <w>taunts</w> from the opposing team.",
                            "target_lang_translations": {
                                "de": "Er ignorierte die grausamen <w>Sticheleien</w> der gegnerischen Mannschaft."
                            }
                        },
                        {
                            "text": "The crowd shouted <w>taunts</w> at the referee after the controversial decision.",
                            "target_lang_translations": {
                                "de": "Die Menge rief nach der umstrittenen Entscheidung <w>Spott</w> in Richtung des Schiedsrichters."
                            }
                        }
                    ],
                    "synonyms": [
                        "insult",
                        "jeer",
                        "mockery",
                        "dig"
                    ],
                    "antonyms": [
                        "compliment",
                        "praise"
                    ],
                    "common_phrases": [
                        "cruel taunts",
                        "shout taunts"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine spöttische oder beleidigende Bemerkung, die darauf abzielt, jemanden zu provozieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spott",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für schadenfrohes Belustigen über jemanden."
                            },
                            {
                                "target_lang_word": "Stichelei",
                                "target_lang_sense_clarification": "Eine indirekte, oft wiederholte kritische oder spöttische Bemerkung."
                            },
                            {
                                "target_lang_word": "höhnische Bemerkung",
                                "target_lang_sense_clarification": "Eine besonders verächtliche oder spöttische Äußerung."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aeecb4e8-afb9-3326-bd64-e793796ff033",
                    "sense_definition": "Very high or tall, especially referring to a ship's mast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old vessel was known for its <w>taunt</w> masts that caught the wind easily.",
                            "target_lang_translations": {
                                "de": "Das alte Schiff war für seine <w>hoch aufragenden</w> Masten bekannt, die den Wind leicht einfingen."
                            }
                        },
                        {
                            "text": "Sailors preferred a <w>taunt</w> rig for better speed in open waters.",
                            "target_lang_translations": {
                                "de": "Segler bevorzugten eine <w>hohe</w> Takelage für bessere Geschwindigkeit auf offenem Wasser."
                            }
                        }
                    ],
                    "synonyms": [
                        "tall",
                        "lofty"
                    ],
                    "common_phrases": [
                        "taunt mast"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in nautical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sehr hoch oder lang, insbesondere in Bezug auf den Mast eines Schiffes."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hoch",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für große vertikale Ausdehnung."
                            },
                            {
                                "target_lang_word": "hoch aufragend",
                                "target_lang_sense_clarification": "Beschreibt etwas, das imposant in die Höhe ragt."
                            }
                        ]
                    }
                }
            ]
        },
        {
