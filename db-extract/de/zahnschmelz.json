                "senses": [
                    {
                        "sense_id": "58f588b3-6616-35e2-ac56-c2d43e19574a",
                        "entry_id": "b8f4f6f8-8fbf-3199-82a8-c7d40e9fdf7a",
                        "glosses": [
                            "Émail des dents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db49047-07ed-4557-87f8-a4a1bcbfe5da",
                                "sense_id": "58f588b3-6616-35e2-ac56-c2d43e19574a",
                                "text": "Steigt der Mageninhalt bis in den Mundraum hoch, sorgt das nicht nur für einen unangenehmen Geschmack im Mund. Es kann auf Dauer auch den Zahnschmelz angreifen.",
                                "translation": "Si le contenu de l’estomac remonte jusque dans la cavité buccale, cela ne provoque pas seulement un goût désagréable dans la bouche. À la longue, ceci peut avoir un effet nocif sur l’émail des dents."
                            },
                            {
                                "example_id": "1a61c0f2-7cf2-4319-975e-f1ccec89ab20",
                                "sense_id": "58f588b3-6616-35e2-ac56-c2d43e19574a",
                                "text": "Fluorid ist ein Stoff, der den Zahnschmelz stärkt und so vor Karies schützt.",
                                "translation": "La fluorure est une substance qui renforce l’émail des dents et les protège ainsi contre les caries."
                            }
                        ]
                    }
                ],
