                                "target_senses": [
                                    {
                                        "sense_id": "8b595f34-3ee3-330b-9a00-2710994fb766",
                                        "entry_id": "efae3ee5-296d-350d-b1e0-4c1cfa8f92fc",
                                        "glosses": [
                                            "w sposób tajemniczy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e9beb3-e66b-4f30-9e08-68301d1a73e1",
                                                "sense_id": "8b595f34-3ee3-330b-9a00-2710994fb766",
                                                "text": "Jednak łagodne i wdzięczne zakręty łąki zwężały się coraz, aż ustąpiły miejsca wąskiej rozpadlinie, a ścieżki w głąb parowu prowadzące zaczęły piąć się po stokach gór; to nagie, skaliste, ostrymi rozpęknięciami poprzerywane i kolczystą wikliną zjeżone, to zielone i tajemniczo pod sklepieniami liściastej zarośli przepadające."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1388a49-1052-49f7-81c4-854fb6eb9e8d",
                        "source_entry_id": "6024e577-24cc-3191-a88c-5a09a5d6591a",
                        "target_lang_word": "mystérieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystérieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54b2e527-81cb-3893-a948-5be6b83183a0",
                                        "entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                                        "glosses": [
                                            "Avec mystère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23557407-4bf7-48a9-844a-afe6c864c7d0",
                                                "sense_id": "54b2e527-81cb-3893-a948-5be6b83183a0",
                                                "text": "Les prophètes ont parlé mystérieusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                                        "entry_id": "f80ddb4f-514e-3513-bfaf-5000f9eb6646",
                                        "glosses": [
                                            "Avec secret, en se cachant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b85c959-b2dc-4041-b6f2-f0d9b2937f56",
                                                "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                                                "text": "[…] Julie lui avait serré mystérieusement la main, soit pour le remercier du petit service qu’il venait de lui rendre, soit pour lui dire : - Enfin je vais donc vous voir !"
                                            },
                                            {
                                                "example_id": "eb1501d2-ea50-4520-93ab-9a577e23b86e",
                                                "sense_id": "dd77e5ae-7f23-3345-ab03-799f80ba546e",
                                                "text": "Un matin, au milieu du mois de novembre, on vint dire à Louis Pasteur assez mystérieusement que quelqu'un le demandait. « La personne vous attend à quelques pas d'ici. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
