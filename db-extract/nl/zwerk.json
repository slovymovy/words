                    },
                    {
                        "form_id": "6c93d05c-2d41-41ef-bbbf-ebe5b460efc1",
                        "entry_id": "b8592519-018e-32de-a646-39210b65dc37",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "zwerkje"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9516099-5cd8-3f52-8197-b5d928b3760c",
                        "entry_id": "b8592519-018e-32de-a646-39210b65dc37",
                        "glosses": [
                            "geheel van grote drijvende wolken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a3d319-b356-40ce-8750-1528cf7f3320",
                                "sense_id": "d9516099-5cd8-3f52-8197-b5d928b3760c",
                                "text": "Het zwerk kwam naar onze richting."
                            },
                            {
                                "example_id": "266e865e-c824-41b2-a915-3dd0df34d35f",
                                "sense_id": "d9516099-5cd8-3f52-8197-b5d928b3760c",
                                "text": "Volgens sommige ooggetuigen doorkliefden bliksemschichten het zwerk toen Duitse en Russische pantsertroepen elkaar op 12 juli 1943 bij Prochorovka troffen voor wat bekend is geworden als de grootste tankslag aller tijden."
                            },
                            {
                                "example_id": "513892c2-9182-49b9-a31b-17a4d8cdc38f",
                                "sense_id": "d9516099-5cd8-3f52-8197-b5d928b3760c",
                                "text": "Topcameraman Goert Giltay filmde het onheilspellende zwerk als de wolkenluchten op een schilderij van Ruysdael en wisselde die beelden af met extreme close-ups van sprekende hoofden."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ea6cf09-fa12-33ea-85d1-dd6dfd68e77d",
                        "entry_id": "b8592519-018e-32de-a646-39210b65dc37",
                        "glosses": [
                            "geheel van wat zich hoog boven de aarde bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06874a2-af67-4bbc-bf43-0baa15ec4402",
                                "sense_id": "2ea6cf09-fa12-33ea-85d1-dd6dfd68e77d",
                                "text": "Vanaf de Eiffeltoren heeft men een goed uitzicht op het zwerk."
                            },
                            {
                                "example_id": "ab72799b-8296-4df8-9b62-9a7402027d5d",
                                "sense_id": "2ea6cf09-fa12-33ea-85d1-dd6dfd68e77d",
                                "text": "In mijn jongere jaren het gouden zweefvliegbrevet. Daarvoor heb ik veertien jaar lang het zwerk afgezweefd."
                            },
                            {
                                "example_id": "c60ac110-7a5d-45c8-97a8-82012d06bf84",
                                "sense_id": "2ea6cf09-fa12-33ea-85d1-dd6dfd68e77d",
                                "text": "Het oude Egypte kende een grote hoeveelheid goden. Boven aan de pyramide stonden titanen als Ra en Osiris. Die waren de hele dag druk met de beweging van de zon langs het zwerk of het ontvangen van zielen in het dodenrijk."
                            },
                            {
                                "example_id": "93a8c7fe-5534-4c0e-a31a-7543daf79336",
                                "sense_id": "2ea6cf09-fa12-33ea-85d1-dd6dfd68e77d",
                                "text": "De cilinder verdween in het zwerk, een lang wit spoor achterlatend, alsof het sneeuwlandschap een enorme kluwen garen was waaruit een reusachtige onzichtbare hand een draadje hemelwaarts had getrokken."
                            }
                        ]
                    }
