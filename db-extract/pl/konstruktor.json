                "senses": [
                    {
                        "sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                        "entry_id": "a6a84e7c-fa7a-3a45-9122-3edb1838d896",
                        "glosses": [
                            "ktoś zajmujący się konstruowaniem czegoś, np. inżynier projektujący budynki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96808d29-b666-4b48-8855-6c7f0300c5ce",
                                "sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                                "text": "Projektowaniem budynków zajmują się konstruktorzy, architekci oraz instalatorzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48034604-bd51-4785-a890-17e8da9117ed",
                        "source_entry_id": "a6a84e7c-fa7a-3a45-9122-3edb1838d896",
                        "source_sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                        "target_lang_word": "constructor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constructor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80cc419e-1e9b-3a39-a35c-18b541428173",
                                        "entry_id": "d708f28f-6828-3cf3-ab5a-28da5b2b059d",
                                        "glosses": [
                                            "A person who, or thing that, constructs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deed8b43-a0d2-4aef-bb43-7b24f7f5983b",
                                                "sense_id": "80cc419e-1e9b-3a39-a35c-18b541428173",
                                                "text": "All this time the great work over which South Australia was spending large sums of money, aided by unceasing efforts on the part of her telegraph constructors, was going on."
                                            },
                                            {
                                                "example_id": "e4f11800-fc0e-43ed-869c-673f78f01085",
                                                "sense_id": "80cc419e-1e9b-3a39-a35c-18b541428173",
                                                "text": "It's a big help in solving cryptograms if you know how a cryptogram is constructed. The constructor normally uses two alphabets, one for plaintext, one for the substitute cipher letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d1cc6e-fad9-3910-9c05-122f4295e5e3",
                                        "entry_id": "d708f28f-6828-3cf3-ab5a-28da5b2b059d",
                                        "glosses": [
                                            "A company which, or individual who, builds racing vehicles. In Formula One, constructor status is strictly defined by the rules, but in other motorsports the term is merely a descriptor. Depending on the racing rules, some constructors (e.g. Cosworth) may provide vehicles to racing teams who are not themselves constructors, while others are both teams and constructors (Ducati Corse, Scuderia Ferrari)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5bf750c-5013-348a-a74e-9b15cc7ee7a3",
                                        "entry_id": "d708f28f-6828-3cf3-ab5a-28da5b2b059d",
                                        "glosses": [
                                            "A class method that creates and initializes each instance of an object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "136387a6-34f3-3c25-8aac-083309786c30",
                                        "entry_id": "d708f28f-6828-3cf3-ab5a-28da5b2b059d",
                                        "glosses": [
                                            "A person who creates crossword puzzles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26fb9d65-f468-499f-8013-16d290f69b5f",
                        "source_entry_id": "a6a84e7c-fa7a-3a45-9122-3edb1838d896",
                        "source_sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                        "target_lang_word": "builder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "builder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f05f69e-736f-3711-9ca1-fb034cc5907f",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "One who builds or constructs things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7865ca8-e777-3293-a867-20ecf089d7a4",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Master artisan, who receives his instructions from the architect, and employs workers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Software that allows the user to create a certain kind of (often automated) output."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d267eb9-1e8f-439f-8eb3-b1fd556a5b25",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "To cut coding time and to insure maintainability of the algorithms, an \"algorithm builder tool\" was constructed."
                                            },
                                            {
                                                "example_id": "47571c3b-a2f4-4974-bafe-5751df544be8",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "A map builder uses map layers from several sources and adds data to make a custom map."
                                            },
                                            {
                                                "example_id": "8e858f5a-9124-4693-9d33-192843b7cd8d",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "Many users may find this easier to use as each field is clearly displayed and the user interface provides a formula builder and a Check formula function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Clipping of bodybuilder."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513f63e5-e3a6-410d-a092-2caa37268f9d",
                                                "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                                "text": "In the competitions, bodybuilders go through \"mandatories\"—a set of mandatory poses—in the morning, where the judges compare the body parts of the builders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93b27325-7afe-40a9-ad52-cdec21782b5d",
                        "source_entry_id": "a6a84e7c-fa7a-3a45-9122-3edb1838d896",
                        "source_sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                        "target_lang_word": "konstruktér",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1fef2b66-45f4-479e-a6ce-c1008881c392",
                        "source_entry_id": "a6a84e7c-fa7a-3a45-9122-3edb1838d896",
                        "source_sense_id": "9d8af99d-b9bd-38cd-a2c8-4273ba63ae0e",
                        "target_lang_word": "конструктор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конструктор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6730d628-97d2-368c-8470-3e921cf938cd",
                                        "entry_id": "cfe2af92-1ac7-373b-bc70-c6fab6609eaf",
                                        "glosses": [
                                            "детская игра, представляющая собою набор деталей, из которых можно собирать различные сооружения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b364a16e-3863-4c31-b7c9-48be033f3ea9",
                                                "sense_id": "6730d628-97d2-368c-8470-3e921cf938cd",
                                                "text": "Для перевозки скоропортящихся продуктов Совторгфлот выдал задание на постройку специализированных рефрижераторных судов, вошедших в историю под названием марсельских, а под растительное масло конструкторы приспособили несколько меньшие ёмкости в междудонном пространстве, предназначавшиеся ранее для закачки балласта."
                                            },
                                            {
                                                "example_id": "0849b429-c85f-46c7-a0ee-17e236c7a723",
                                                "sense_id": "6730d628-97d2-368c-8470-3e921cf938cd",
                                                "text": "И она повела его в «Детский мир», и он выбрал конструктор — точно такой, как у Игоря с соседней дачи…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ca56587-1a89-3747-b133-bb02be108d4c",
                                        "entry_id": "cfe2af92-1ac7-373b-bc70-c6fab6609eaf",
                                        "glosses": [
                                            "ирон. что-либо, поставляющееся не готовым к применению, требующее сборки или доработки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6737a43-14ce-4978-bcaa-537f34ba730c",
                                                "sense_id": "7ca56587-1a89-3747-b133-bb02be108d4c",
                                                "text": "Покупая отечественную машину — вы покупаете маш-набор, конструктор, так сказать, и не стоит об этом забывать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f39db356-3475-34c6-b3da-e1244ed06ed5",
                                        "entry_id": "cfe2af92-1ac7-373b-bc70-c6fab6609eaf",
                                        "glosses": [
                                            "комп. в программировании — метод (процедура), вызываемая для создания объектов определённого типа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565834f5-a235-44ff-9aa5-7d0730d0ccc5",
                                                "sense_id": "f39db356-3475-34c6-b3da-e1244ed06ed5",
                                                "text": "Если класс содержит виртуальные методы или подпрограммы, хотя бы один его метод должен быть определён как конструктор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256632e6-654c-3ac8-863d-67b695b11dbf",
                                        "entry_id": "cfe2af92-1ac7-373b-bc70-c6fab6609eaf",
                                        "glosses": [
                                            "неол., автомоб. жарг. автомобиль, привезённый в разобранном виде по частям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d831dcdd-8b23-4a73-a003-8fa17a2c8741",
                                                "sense_id": "256632e6-654c-3ac8-863d-67b695b11dbf",
                                                "text": "«Распилами» и «конструкторами» называются японские автомобили, которые ввезли на территорию России в качестве запчастей, а затем собрали и зарегистрировали в ГИБДД как транспортные средства. Они появились на дорогах Приморья в 2009 году, после принятия правительством заградительных пошлин на ввоз иномарок."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "конструктор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b5a9f6-2903-3633-8033-d1c0cd3452a1",
                                        "entry_id": "1d739a38-9df1-3cee-811b-e1ecefa8586f",
                                        "glosses": [
                                            "специалист, конструирующий что-либо, создающий конструкцию чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996e18ab-3fd9-4577-a861-cbdaa5ce9224",
                                                "sense_id": "f5b5a9f6-2903-3633-8033-d1c0cd3452a1",
                                                "text": "Известный конструктор поразил своим открытием."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
