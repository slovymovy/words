                    "frequency": "High",
                    "semantic_group_id": "null",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have very little <w>remaining</w> time to finish the project.",
                            "target_lang_translations": {
                                "ru": "У нас очень мало <w>оставшегося</w> времени на завершение проекта.",
                                "de": "Wir haben nur noch sehr wenig <w>verbleibende</w> Zeit, um das Projekt abzuschließen."
                            }
                        },
                        {
                            "text": "Please put the <w>remaining</w> cake in the refrigerator.",
