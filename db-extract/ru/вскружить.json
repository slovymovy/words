                "translations": [
                    {
                        "translation_id": "38ad7bfe-cbdf-446e-9a96-110481f88228",
                        "source_entry_id": "0af9c85c-007c-356b-ab0b-6be15a39ea44",
                        "source_sense_id": "46adc794-da6b-39f0-8d8a-98f152025378",
                        "target_lang_word": "tourner la tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "137b2ca8-7baf-4ce7-9e00-62aef868e984",
                        "source_entry_id": "0af9c85c-007c-356b-ab0b-6be15a39ea44",
                        "source_sense_id": "46adc794-da6b-39f0-8d8a-98f152025378",
                        "target_lang_word": "monter à la tête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monter à la tête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5acbb8e2-a1e1-37ac-adea-a9a7fa28ef29",
                                        "entry_id": "33ecd151-112e-39e4-8ce4-2fc6c288157a",
                                        "glosses": [
                                            "Souler, griser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07418a12-9143-404a-b341-465a581dc634",
                                                "sense_id": "5acbb8e2-a1e1-37ac-adea-a9a7fa28ef29",
                                                "text": "Oui, le vin pur monte à la tête."
                                            },
                                            {
                                                "example_id": "cb2896f3-ba82-4329-b2e5-91c5617c949b",
                                                "sense_id": "5acbb8e2-a1e1-37ac-adea-a9a7fa28ef29",
                                                "text": "Le sang, l’action, la colère leur montent tout de suite à la tête."
                                            },
                                            {
                                                "example_id": "90f869bf-d7f2-4da5-8013-084298b9cd1f",
                                                "sense_id": "5acbb8e2-a1e1-37ac-adea-a9a7fa28ef29",
                                                "text": "Avant le vin me montait à la tête et me rendait gai. Maintenant il me descend aux jambes et me rend vieux !"
                                            },
                                            {
                                                "example_id": "3b3c4abf-4c48-4f17-83a3-c61e148a01c2",
                                                "sense_id": "5acbb8e2-a1e1-37ac-adea-a9a7fa28ef29",
                                                "text": "J’oublie la bière, qui aurait toutes les peines du monde à monter à la tête d’un bébé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "125de658-3206-352a-b50f-f1e9fb353d10",
                                        "entry_id": "33ecd151-112e-39e4-8ce4-2fc6c288157a",
                                        "glosses": [
                                            "Troubler l’esprit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b18181d-c733-46ef-9238-b77d7a5eb409",
                                                "sense_id": "125de658-3206-352a-b50f-f1e9fb353d10",
                                                "text": "Les hauteurs de la hiérarchie te montent à la tête. Va falloir faire gaffe au vertige."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "141b87ee-47ea-4932-8e5c-a5815b912f7f",
                        "source_entry_id": "0af9c85c-007c-356b-ab0b-6be15a39ea44",
                        "source_sense_id": "46adc794-da6b-39f0-8d8a-98f152025378",
                        "target_lang_word": "griser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b133c63e-2e7f-3fcd-8a7c-fcdb13daf0c9",
                                        "entry_id": "2417bb4d-1d92-3f26-bdc4-70df82c3f394",
                                        "glosses": [
                                            "Rendre de couleur grise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beda0656-01ab-4735-8dc6-9a6f32c3d7a1",
                                                "sense_id": "b133c63e-2e7f-3fcd-8a7c-fcdb13daf0c9",
                                                "text": "Il était presque dix-huit heures trente, la rue se grisait lentement, un apaisement après l'agitation de la journée."
                                            },
                                            {
                                                "example_id": "79695b30-19e7-486d-9672-54299e790c93",
                                                "sense_id": "b133c63e-2e7f-3fcd-8a7c-fcdb13daf0c9",
                                                "text": "Comment griser les cellules d’un tableau ?"
                                            },
                                            {
                                                "example_id": "f8145c05-92a9-4251-8aab-fb38255935d3",
                                                "sense_id": "b133c63e-2e7f-3fcd-8a7c-fcdb13daf0c9",
                                                "text": "Les éléments grisés du menu sont inaccessibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                        "entry_id": "2417bb4d-1d92-3f26-bdc4-70df82c3f394",
                                        "glosses": [
                                            "Porter à la tête, étourdir en parlant de paroles, de liqueurs enivrantes, de la fumée du tabac, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3010d1c-91f1-4ce4-903c-aa1733ba738d",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "Ce voisinage le grisa tant qu’il dut parfois se vaincre pour accorder au film toute son attention."
                                            },
                                            {
                                                "example_id": "5fb1ea3d-b9da-4aa4-9a26-68314fc2e163",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "Un verre de vin suffit pour le griser."
                                            },
                                            {
                                                "example_id": "0d5345ef-d81f-4a25-95b6-29527919cd33",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "La fumée du tabac l’a grisé."
                                            },
                                            {
                                                "example_id": "e3dd33da-983e-4680-b329-6a1d4e3df39f",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "Les belles promesses le grisèrent."
                                            },
                                            {
                                                "example_id": "888683d8-25c0-40d5-ac4f-e88ea819577b",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "Des paroles qui grisent."
                                            },
                                            {
                                                "example_id": "96774763-dafe-414c-a499-32698096b295",
                                                "sense_id": "1142ef26-588f-3b40-81b0-2e5aeae7a200",
                                                "text": "Le candidat ne veut pas se laisser griser par les sondages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7eb3d2a-026b-38d4-b22f-f959935b916e",
                                        "entry_id": "2417bb4d-1d92-3f26-bdc4-70df82c3f394",
                                        "glosses": [
                                            "Faire boire quelqu’un, rendre gris, saouler."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167889fb-6a86-48bb-8ba0-b4288db48e4a",
                                                "sense_id": "a7eb3d2a-026b-38d4-b22f-f959935b916e",
                                                "text": "Si vous pouviez griser ce clerc, il dirait bien le fin mot là-dessus ; et, s’il ne se déboutonne pas à la seconde bouteille de vin de Champagne, ce sera toujours bien à la troisième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                        "entry_id": "2417bb4d-1d92-3f26-bdc4-70df82c3f394",
                                        "glosses": [
                                            "Boire à l’excès ; s’enivrer."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77bf389-c05b-4880-80bc-1400ee2e0f34",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "Pibrac y avait déjeuné aussi, quoi qu'il se fût abominablement grisé au Grand-Quinze, mais il ne paraissait pas encore très bien remis des excès de ce souper […]."
                                            },
                                            {
                                                "example_id": "1e60e16a-5c78-4c28-ac53-0a393678e06b",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "Frédéric se griserait sans doute, et quand il était gris, il assommait les gens pour un oui ou pour un non."
                                            },
                                            {
                                                "example_id": "319b2dfb-19b8-4908-8d01-80eba951bed7",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "Pour ne pas se griser, malgré les nombreuses libations inhérentes à des fêtes de ce genre, on garnissait de lierre, bouteilles, lampes et meubles !"
                                            },
                                            {
                                                "example_id": "1bb5c0cf-32f9-42c8-92dd-4d0f67939601",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "Jerome K. Jerome affirmait, dans la préface de son Trois hommes dans un bateau, qu’il avait connu un malade qui se grisait avec du bifteck. Tout dépend de la violence du choc."
                                            },
                                            {
                                                "example_id": "2a2c6858-fe12-4b5d-bfd2-96b6a5ed745d",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "La boutique du marchand de vin sentait le vin à la tireuse (on se grisait aux vapeurs et cet honnête commerçant était bourré sans boire), et l’épicerie, les épices. C’était avant la civilisation de l’emballage et du froid."
                                            },
                                            {
                                                "example_id": "1aa32d84-b7d4-47ac-91e7-6c7369695c1d",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "— Gasbieha se grisait de la vitesse, elle buvait des yeux le paysage, riait aux éclats."
                                            },
                                            {
                                                "example_id": "b4968be3-1136-402f-8f90-2f9249574129",
                                                "sense_id": "b6e2b8e7-bd1a-36ce-955f-b3630a8a1995",
                                                "text": "Je me grisais des promesses de l’avenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
