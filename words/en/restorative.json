{
    "word_family": [
        "restore",
        "restoration",
        "restorer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd2504a2-76c9-321c-94aa-5c24ddf89893",
                    "sense_definition": "Having the ability to make someone feel strong, healthy, or full of energy again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health_and_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day working in the fields, Clarence took comfort in a <w>restorative</w> pint of beer.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня в поле Кларенс утешился <w>восстанавливающей силы</w> пинтой пива."
                            }
                        },
                        {
                            "text": "Many people find that a <w>restorative</w> sleep is the best way to recover from a stressful week.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что <w>восстанавливающий</w> сон — лучший способ прийти в себя после напряженной недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejuvenating",
                        "revitalizing",
                        "invigorating",
                        "health-giving"
                    ],
                    "antonyms": [
                        "nonrestorative"
                    ],
                    "common_phrases": [
                        "restorative sleep",
                        "restorative powers",
                        "restorative effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью возвращать силы, здоровье или энергию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливающий",
                                "target_lang_sense_clarification": "силы или здоровье"
                            },
                            {
                                "target_lang_word": "укрепляющий",
                                "target_lang_sense_clarification": "организм"
                            },
                            {
                                "target_lang_word": "целительный",
                                "target_lang_sense_clarification": "оказывающий лечебное воздействие"
                            },
                            {
                                "target_lang_word": "живительный",
                                "target_lang_sense_clarification": "дающий жизнь и энергию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aeb65a4d-259d-308a-83d9-8b53ec81eb65",
                    "sense_definition": "A medicine, drink, or treatment that helps to bring back strength or health.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "health_and_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a natural <w>restorative</w> to help the patient regain his vigor after the surgery.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал натуральное <w>восстанавливающее средство</w>, чтобы помочь пациенту вернуть силы после операции."
                            }
                        },
                        {
                            "text": "In the past, a glass of fortified wine was often used as a <w>restorative</w> for those feeling faint.",
                            "target_lang_translations": {
                                "ru": "В прошлом бокал крепленого вина часто использовали как <w>укрепляющее средство</w> для тех, кто чувствовал слабость."
                            }
                        }
                    ],
                    "synonyms": [
                        "tonic",
                        "pick-me-up",
                        "remedy"
                    ],
                    "common_phrases": [
                        "powerful restorative",
                        "natural restorative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарство, напиток или процедура, помогающие восстановить силы или здоровье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливающее средство",
                                "target_lang_sense_clarification": "общее понятие"
                            },
                            {
                                "target_lang_word": "укрепляющее средство",
                                "target_lang_sense_clarification": "для поддержания организма"
                            },
                            {
                                "target_lang_word": "тоник",
                                "target_lang_sense_clarification": "в значении общеукрепляющего напитка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6650e15-4e7e-3265-b632-0d2f5a47b788",
                    "sense_definition": "An alcoholic drink taken with the intention of making one feel better or more alert.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long journey, he felt he was in need of a <w>restorative</w> before dinner.",
                            "target_lang_translations": {
                                "ru": "После долгого путешествия он почувствовал, что ему нужно что-нибудь <w>подкрепляющее</w> перед ужином."
                            }
                        },
                        {
                            "text": "The host offered a stiff <w>restorative</w> to the guests who had arrived cold and wet from the rain.",
                            "target_lang_translations": {
                                "ru": "Хозяин предложил крепкое <w>живительное средство</w> гостям, которые приехали промокшими и замерзшими под дождем."
                            }
                        }
                    ],
                    "synonyms": [
                        "stiff drink",
                        "nightcap"
                    ],
                    "common_phrases": [
                        "need a restorative",
                        "stiff restorative"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously or in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Алкогольный напиток, употребляемый с целью почувствовать себя лучше или бодрее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живительная влага",
                                "target_lang_sense_clarification": "иронично об алкоголе"
                            },
                            {
                                "target_lang_word": "стаканчик для бодрости",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "подкрепляющее",
                                "target_lang_sense_clarification": "о напитке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}