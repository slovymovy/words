                        "glosses": [
                            "Écrire à la manière d’Anna de Noailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9813c55-8e71-422f-abd1-f765430d88d7",
                                "sense_id": "5b033458-fd14-39fe-a858-6aef796c06c0",
                                "text": "Savez-vous exactement ce que vous faites ? lui chuchote-t-il à l’oreille, en le voyant noailliser."
                            },
                            {
                                "example_id": "876e99ce-9310-495e-b5b1-f9e383b826ee",
                                "sense_id": "5b033458-fd14-39fe-a858-6aef796c06c0",
                                "text": "Je n’ai pas davantage dit, hors de la présence de Mme de Noailles : « Bien malheureux qu’elle noaillise ! »"
                            }
                        ]
