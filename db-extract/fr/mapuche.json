                                        "sense_id": "c358a003-54b2-3cc1-a9c8-e531ad785d09",
                                        "entry_id": "7e3c66fc-3760-3e00-a604-208e62c7536f",
                                        "glosses": [
                                            "Que pertenece o concierne a una etnia nativa del sur de Sudamérica que ocupaba parte del actual territorio chileno en la época de la conquista, de organización tribal, avanzada agricultura e industria textil, y disposición belicosa que los llevó a resistir la ocupación inca y luego colonial durante siglos."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d88b422-ed1b-4b21-810b-e49d532adef0",
                                                "sense_id": "c358a003-54b2-3cc1-a9c8-e531ad785d09",
                                                "text": "Y en el transcurso de la discusión política decidimos que me fuera a vivir a la casa de un cacique mapuche, una cabaña enclavada al pie mismo de la selva."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mapuche",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3796bc7f-6d56-34af-afcb-2219001937b9",
                                        "entry_id": "2cad7dd8-2da3-3b74-9f7c-abac4639a8df",
                                        "glosses": [
                                            "Lengua polisintética, de origen incierto, hablada tradicionalmente por los mapuche₁ y hoy por unas 200.000 personas en el sur de Chile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9fe612-6483-494c-9c63-b63b9a3921a6",
                                                "sense_id": "3796bc7f-6d56-34af-afcb-2219001937b9",
                                                "text": "Las que han dejado más huellas en el habla hispanoamericana son el arahuaco, de las Antillas, hoy desaparecido; el caribe, del Sur de las Antillas, Venezuela y Guayanas; el náhuatl, principal lengua del imperio mejicano; el quechua, del Perú, extendido por los incas a lo largo de los Andes, desde el Ecuador hasta el Norte de Chile y Noroeste de Argentina; el araucano o mapuche, refugiado en el Sur de Chile, y el guaraní hablado en las cuencas del Paraná y Paraguay y en el Brasil."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
