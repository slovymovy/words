                        "translation_id": "680b4b2b-9ad5-4820-bdc8-4a5bcf506ff7",
                        "source_entry_id": "5829cbfe-4f2b-3947-a968-e52f2a8c89f1",
                        "source_sense_id": "99733d1d-a1b6-374e-9f92-2004589fd8f7",
                        "source_sense_description": "Cornwall",
                        "target_lang_word": "Cornwall",
