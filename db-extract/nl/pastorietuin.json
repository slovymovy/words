                        "examples": [
                            {
                                "example_id": "0aa596e0-ba6e-443f-8005-d02fe1be1f1c",
                                "sense_id": "7fd60f74-6270-3a2a-bf22-9255959cf8b2",
                                "text": "Ik verliet het huis en haastte me naar de kleine pastorie, zoals het piepkleine huisje achter in de pastorietuin genoemd werd."
                            },
                            {
                                "example_id": "10cf8b5c-9023-4c78-891c-7922ec694ab9",
                                "sense_id": "7fd60f74-6270-3a2a-bf22-9255959cf8b2",
                                "text": "De rechtbank Lelystad acht bewezen dat M. op 30 maart vorig jaar het schilderij Lentetuin, de pastorietuin te Nuenen in het voorjaar van Vincent van Gogh heeft gestolen uit het Singer Museum in Laren. In augustus vorig jaar heeft hij het doek Twee lachende jongens van Frans Hals gestolen uit museum het Hofje van Mevrouw van Aerden in Leerdam."
                            }
                        ]
