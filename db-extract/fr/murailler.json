            {
                "entry_id": "cfda58f5-2f61-3849-9485-679088eb150a",
                "word": "murailler",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6df84188-1fbd-4582-9ea8-3e9416b42c2e",
