                                    },
                                    {
                                        "sense_id": "265f6315-dc7b-3af2-9418-7faac08393a3",
                                        "entry_id": "58334498-86cf-32b9-9e1e-6b8d610de513",
                                        "glosses": [
                                            "Ruptura de fibras de celulosa de la pulpa de madera para fabricación de papel."
                                        ],
                                        "tags": [],
