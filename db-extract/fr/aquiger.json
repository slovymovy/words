                "senses": [
                    {
                        "sense_id": "996453d7-fb48-3f2a-a9b6-1aabb0ec803d",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
                            "Battre."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e29cea94-a294-4cb3-b17e-79d103a2f512",
                                "sense_id": "996453d7-fb48-3f2a-a9b6-1aabb0ec803d",
                                "text": "Depuis le reluit où j'ai gambillé avec tézigue et remouché tes châsses et ta frime d’altèque, le dardant a coque le rifle dans mon palpitant, qui n’aquige plus que pour tézigue."
                            }
                        ]
                    },
                    {
                        "sense_id": "5effb5bb-053a-3e18-80ba-9bf4e3e560eb",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
                            "Faire."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "61fd90db-7b83-421b-a8cc-5aefd59e57ae",
                                "sense_id": "5effb5bb-053a-3e18-80ba-9bf4e3e560eb",
                                "text": "Et comme la faim l’oppressoit et qu’il mouchailloit que sa cosne approchoit, il aquigea son testament, recommandant son ame entre les louches du Haure, et son corps à la dure."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad8ea21a-22a7-3c5b-a4c3-9614de4815a7",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
                            "Frapper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f5450173-8f92-4cf7-aad9-3f4b46c63fbf",
                                "sense_id": "ad8ea21a-22a7-3c5b-a4c3-9614de4815a7",
                                "text": "Que vozigand ne se prenne pas à l’huile d’un remouleur de buffet, de négociants de petit crochet, ni aux trucheux caïmans ou rafalés qui aquigent à votre lourde."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bee5d77-9d2d-30ed-917e-50e4a92fd1f4",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
                            ": handicaper"
                        ],
                        "tags": [
                            "Suisse",
                            "Parler gaga",
                            "Parler lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "b50aa994-d2b2-4b77-8234-a25f82d5a05e",
                                "sense_id": "7bee5d77-9d2d-30ed-917e-50e4a92fd1f4",
                                "text": "Depuis son accident, la pov' est bien aquigée."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d8bc36d-d098-376d-a3b2-f2d9e5e20836",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
                            ": exagérer, abuser"
                        ],
                        "tags": [
                            "Suisse",
                            "Parler gaga",
                            "Parler lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "4768fc22-da0a-4c80-837a-cf7adb87c565",
                                "sense_id": "2d8bc36d-d098-376d-a3b2-f2d9e5e20836",
                                "text": "Le père Grollon est trop cher, il aquige tout de même !"
                            }
                        ]
                    },
                    {
                        "sense_id": "283d911d-b5e4-3c77-877b-ed0fd6a1fb65",
                        "entry_id": "3474cadd-f8e1-34ab-9e27-95bd9aee4ed6",
                        "glosses": [
