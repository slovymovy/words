        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f59737e2-5898-3d4a-9aa4-bdc4db570586",
                    "sense_definition": "osoba, która nałogowo pali tytoń lub wyroby tytoniowe",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tyton",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszej firmie nie zatrudniamy <w>palaczy</w>, bo dyrektor kaszle od dymu papierosowego.",
                            "target_lang_translations": {
                                "ru": "В нашей компании не нанимают <w>курильщиков</w>, потому что директор кашляет от сигаретного дыма."
                            }
                        },
                        {
                            "text": "Mój sąsiad jest nałogowym <w>palaczem</w> i pali dwie paczki papierosów dziennie.",
                            "target_lang_translations": {
                                "ru": "Мой сосед — заядлый <w>курильщик</w> и выкуривает по две пачки сигарет в день."
                            }
                        }
                    ],
                    "synonyms": [
                        "palący"
                    ],
                    "antonyms": [
                        "niepalący"
                    ],
                    "common_phrases": [
                        "nałogowy palacz",
                        "bierny palacz"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который регулярно курит табак или табачные изделия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курильщик",
                                "target_lang_sense_clarification": "человек, имеющий привычку курить"
                            },
                            {
                                "target_lang_word": "курящий",
                                "target_lang_sense_clarification": "человек, который курит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7af5cb24-6a72-3097-8e20-0a3a7975a78a",
                    "sense_definition": "pracownik zajmujący się paleniem w piecu lub kotle grzewczym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zawod",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez kilka miesięcy pracowałem jako <w>palacz</w> w lokalnej kotłowni.",
                            "target_lang_translations": {
                                "ru": "Несколько месяцев я работал <w>кочегаром</w> в местной котельной."
                            }
                        },
                        {
                            "text": "Ciężka praca <w>palacza</w> na starym parowcu wymagała niezwykłej siły fizycznej.",
                            "target_lang_translations": {
                                "ru": "Тяжёлый труд <w>кочегара</w> на старом пароходе требовал недюжинной физической силы."
                            }
                        }
                    ],
                    "synonyms": [
                        "palarz"
                    ],
                    "common_phrases": [
                        "palacz kotłowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "работник, обслуживающий печь или отопительный котёл"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кочегар",
                                "target_lang_sense_clarification": "работник котельной или паровой топки"
                            },
                            {
                                "target_lang_word": "истопник",
                                "target_lang_sense_clarification": "человек, отапливающий печи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eda7cfa-68a8-3ca5-9f1d-2ccc7c32bf0c",
                    "sense_definition": "człowiek, który spala jakieś materiały lub przedmioty",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spalanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach miejski <w>palacz</w> odpowiadał za niszczenie niebezpiecznych odpadów.",
                            "target_lang_translations": {
                                "ru": "В прежние времена городской <w>сжигатель</w> отвечал за уничтожение опасных отходов."
                            }
                        },
                        {
                            "text": "Do ogrodu przyszedł <w>palacz</w> liści, aby uporządkować resztki po jesiennych porządkach.",
                            "target_lang_translations": {
                                "ru": "В сад пришёл <w>сжигатель</w> листьев, чтобы навести порядок после осенней уборки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, занимающийся сжиганием каких-либо материалов или предметов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжигатель",
                                "target_lang_sense_clarification": "тот, кто сжигает что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "becc3e2c-243d-30d7-9927-13c015dfc7e5",
                    "sense_definition": "osoba, która celowo wznieca pożar; podpalacz",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przestepstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja podejrzewa, że tajemniczy <w>palacz</w> odpowiada za serię ostatnich podpaleń w okolicy.",
                            "target_lang_translations": {
                                "ru": "Полиция подозревает, что таинственный <w>поджигатель</w> несёт ответственность за череду недавних поджогов в округе."
                            }
                        },
                        {
                            "text": "Mieszkańcy wsi szybko ujęli zuchwałego <w>palacza</w>, zanim ogień zdołał się rozprzestrzenić.",
                            "target_lang_translations": {
                                "ru": "Жители деревни быстро схватили дерзкого <w>поджигателя</w>, прежде чем огонь успел распространиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "palicz"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "przestarzałe określenie podpalacza"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, совершающий умышленный поджог; поджигатель"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поджигатель",
                                "target_lang_sense_clarification": "виновник пожара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fa46eb1-02d3-3a07-8fde-d7bae3bc6fa9",
                    "sense_definition": "kierowca pojazdu mechanicznego; automobilista",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motoryzacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na początku dwudziestego wieku każdy odważny <w>palacz</w> musiał doskonale znać budowę silnika.",
                            "target_lang_translations": {
                                "ru": "В начале двадцатого века каждый отважный <w>шофёр</w> должен был отлично знать устройство двигателя."
                            }
                        },
                        {
                            "text": "Dawne czasopisma motoryzacyjne często opisywały zmagania, z jakimi mierzył się początkujący <w>palacz</w>.",
                            "target_lang_translations": {
                                "ru": "Старые автомобильные журналы часто описывали трудности, с которыми сталкивался начинающий <w>автомобилист</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "automobilista"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "przestarzałe określenie kierowcy automobilu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшее обозначение водителя автомобиля или механического транспортного средства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шофёр",
                                "target_lang_sense_clarification": "водитель автомобиля (истор.)"
                            },
                            {
                                "target_lang_word": "автомобилист",
                                "target_lang_sense_clarification": "водитель автомобиля"
                            }
                        ]
                    }
                }
            ]
        },
        {
