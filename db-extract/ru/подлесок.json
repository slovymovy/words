                                            },
                                            {
                                                "example_id": "692ae67e-f26a-4d98-b2ad-6b1a7837d40a",
                                                "sense_id": "1f038d57-07f2-3c85-a2a9-af837d703100",
                                                "text": "The hikers pushed through thick undergrowth."
                                            },
                                            {
                                                "example_id": "82ea47ae-74a5-4e49-8f34-5c8f0a720879",
                                                "sense_id": "1f038d57-07f2-3c85-a2a9-af837d703100",
                                                "text": "The forest floor was covered with dense undergrowth."
                                            }
                                        ]
                                    }
                                ]
