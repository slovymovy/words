                        "rehausser le niveau"
                    ]
                },
                {
                    "sense_id": "681a78e0-fdc9-3852-abb6-5f220d0346b9",
                    "sense_definition": "Mettre en valeur, faire ressortir en donnant plus d'éclat, de goût ou de beauté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mise_en_valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette épice rare permet de <w>rehausser</w> la saveur délicate du plat traditionnel."
                        },
                        {
                            "text": "Une fine ceinture noire permet de <w>rehausser</w> l'éclat de cette robe blanche élégante."
                        }
                    ],
                    "synonyms": [
                        "valoriser",
                        "souligner",
                        "relever"
                    ],
                    "antonyms": [
                        "affadir",
                        "ternir"
                    ],
                    "common_phrases": [
                        "rehausser le goût",
                        "rehausser la saveur",
                        "rehausser l'éclat"
                    ]
                },
                {
                    "sense_id": "d90c4c72-1ba0-3c3f-a629-e453fe7f2860",
                    "sense_definition": "Augmenter ou porter à un niveau supérieur la valeur financière ou le prix.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque centrale a décidé de <w>rehausser</w> ses prévisions de croissance pour l'année prochaine."
                        },
                        {
                            "text": "La rénovation du quartier a permis de <w>rehausser</w> la valeur marchande des appartements."
