        "fr-extract.jsonl": [
            {
                "entry_id": "471c687e-07ea-3103-8d78-ec446bf88607",
                "word": "éclectisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e5c563be-b69b-47f4-8aae-23dbac151cef",
                        "entry_id": "471c687e-07ea-3103-8d78-ec446bf88607",
                        "tags": [
                            "plural"
                        ],
                        "form": "éclectismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0b3ef9b-4336-34e9-94e7-dd560147e15f",
                        "entry_id": "471c687e-07ea-3103-8d78-ec446bf88607",
                        "glosses": [
                            "Philosophie éclectique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c89fc42-4608-4513-a70c-d831241d976f",
                                "sense_id": "b0b3ef9b-4336-34e9-94e7-dd560147e15f",
                                "text": "L'orientation des esprits change à peine deux fois par siècle. La philosophie universitaire, par exemple, ayant secoué la tradition de l'éclectisme, explique depuis cela le catéchisme de Koenigsberg et récuse toute idée nouvelle."
                            },
                            {
                                "example_id": "0246376c-d7ef-4c94-9c97-586a1e31b300",
                                "sense_id": "b0b3ef9b-4336-34e9-94e7-dd560147e15f",
                                "text": "Or, ce qui manque à l’éclectisme, c'est justement une base scientifique et positive; et ses prétendus dogmes ne sont pas moins arbitraires et cérébrins que les dogmes des églises."
                            }
                        ]
                    },
                    {
                        "sense_id": "52e4a7d7-d9d4-343b-bf44-7d5e5c8f38cd",
                        "entry_id": "471c687e-07ea-3103-8d78-ec446bf88607",
                        "glosses": [
                            "Disposition d’esprit qui consiste à se garder de toute vue étroite et systématique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "509697ac-0e01-4d2d-ba44-24384d1a8196",
                                "sense_id": "52e4a7d7-d9d4-343b-bf44-7d5e5c8f38cd",
                                "text": "La rivalité entre les deux chaînes d’État, dont l’une ne diffuse que des émissions éducatives, et les cinq chaînes privées permet un grand éclectisme dans les programmes."
                            },
                            {
                                "example_id": "64ec13f8-d3e4-4bae-9121-8dccf1a105ba",
                                "sense_id": "52e4a7d7-d9d4-343b-bf44-7d5e5c8f38cd",
                                "text": "Un aimable éclectisme."
                            },
                            {
                                "example_id": "fdc8490f-8c9f-4648-95e5-d93e05052b33",
                                "sense_id": "52e4a7d7-d9d4-343b-bf44-7d5e5c8f38cd",
                                "text": "Éclectisme de l’homme du monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66b76e6c-5883-430c-9a75-e34110412aff",
                        "source_entry_id": "471c687e-07ea-3103-8d78-ec446bf88607",
                        "source_sense_description": "Philosophie éclectique",
                        "target_lang_word": "eclecticism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eclecticism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "The quality of being eclectic"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04adf62-32dc-47d8-89de-2d1381ea6962",
                                                "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                                "text": "In those days she had admired his pluralistic openness of mind, and struggled, in her kitchen, towards a parallel eclecticism, learning to cook the dosas and uttapams of South India as well as the soft meatballs of Kashmir."
                                            },
                                            {
                                                "example_id": "ff947766-6b35-4267-baf1-6307adc898cc",
                                                "sense_id": "edf5de69-5636-34fc-a2e5-97022cd49fe2",
                                                "text": "I am concerned that this encouraging but brief period of success will foster the opinion, already widely held, that the monetary pillar is superfluous, and lead monetary policy analysis back to the kind of muddled eclecticism that brought us the 1970s inflation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "987ec297-fadc-3e40-b80e-bcf44930232b",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "An approach to thought that draws upon multiple theories to gain complementary insights into phenomena"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "772e0e85-694a-3c84-a19a-dabc8bf9a1b0",
                                        "entry_id": "3ceed69a-9e64-3553-9be8-1a84c7ced64e",
                                        "glosses": [
                                            "Any form of art that borrows from multiple other styles"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
