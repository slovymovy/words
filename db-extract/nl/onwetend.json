                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                        "entry_id": "a2be528d-5132-3686-9d65-86bc12aa3b8c",
                        "glosses": [
                            "geen kennis hebbend van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dccff4ad-4861-4b28-be9e-06ff347940b6",
                                "sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                                "text": "Hij is onwetend over de vakantiebestemming van zijn vader en moeder."
                            },
                            {
                                "example_id": "9d4d1f39-5c1e-449b-8b86-19292337b306",
                                "sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                                "text": "Maar zijn gezicht betrok snel toen we alleen waren en ik probeerde te zeggen waar het over ging, dat ik me dom en onwetend voelde wat de massamoord op de joden betrof en dat het vreemd was dat dat verhaal geen onderdeel uitmaakte van ons onderwijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fc4a345-1b83-491b-bf83-e09f199e7c55",
                        "source_entry_id": "a2be528d-5132-3686-9d65-86bc12aa3b8c",
                        "source_sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                        "target_lang_word": "unwissend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwissend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57b384f5-f3e3-3ada-9dca-51e93a0c8ff9",
                                        "entry_id": "31a26a9c-e0fa-317c-96cc-e46f9321058d",
                                        "glosses": [
                                            "kein (hinreichendes) Wissen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35095dc4-7c4b-46e3-a20e-d8150a00be3c",
                                                "sense_id": "57b384f5-f3e3-3ada-9dca-51e93a0c8ff9",
                                                "text": "„Die deutsche Revolution fand ein unwissendes Volk, eine Führerschicht bürokratischer Biedermänner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fa8f97d-fabc-4bf3-9cf4-e0dee51162f0",
                        "source_entry_id": "a2be528d-5132-3686-9d65-86bc12aa3b8c",
                        "source_sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                        "target_lang_word": "ignorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Unknowledgeable or uneducated; characterized by ignorance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e15b07-c112-45ea-b5d3-55e60fc42e7d",
                                                "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                                "text": "That man that doth not know those things which are of use and necessity for him to know, is but an ignorant man, whatever he may know besides;"
                                            },
                                            {
                                                "example_id": "c57bae9d-c142-4a62-87f7-a55ec5e23ebd",
                                                "sense_id": "07baf7ca-f4b9-3350-b792-51726d277638",
                                                "text": "The ignorant peasant, without fault, is greater than the philosopher with many; for what is genius or courage without an heart?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Not knowing (a fact or facts), unaware (of something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8591adf1-71c5-4c31-84da-74ca0fd49942",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "Eve. Somewhat forbids me, which I cannot name;\nFor ignorant of guilt, I fear not shame:\nBut some restraining thought, I know not why,\nTells me, you long should beg, I long deny."
                                            },
                                            {
                                                "example_id": "8bfb10c2-649a-4853-bc78-182503cf2a6c",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "For we would not, brethren, have you ignorant of our trouble which came to us in Asia, that we were pressed out of measure, above strength, insomuch that we despaired even of life:"
                                            },
                                            {
                                                "example_id": "b7d41af4-53dd-414b-8145-dc37d4e275ec",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "1851, Walt Whitman, “Art and Artists” in Emory Holloway (editor), The Uncollected Poetry and Prose of Walt Whitman, Garden City, NY: Doubleday, Page & Co., 1921, Volume 1, p. 242,\n[…] perhaps it is sometimes the case that the greatest artists live and die, the world and themselves alike ignorant what they possess."
                                            },
                                            {
                                                "example_id": "5a68a2a4-8921-47e6-8fa2-aebde5aafc7d",
                                                "sense_id": "fafdd655-2014-3984-a4ed-0fa2fbf91ebc",
                                                "text": "That night he slept the sleep of happiness, blissfully ignorant that he had placed the letters in the wrong envelopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c8f8bf-563b-312d-8f45-99dd4f878fb0",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Ill-mannered, crude."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de6103e-253e-436a-8b3a-17175d311a17",
                                                "sense_id": "50c8f8bf-563b-312d-8f45-99dd4f878fb0",
                                                "text": "His manner was at best off-hand, at worst totally ignorant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "unknown; undiscovered"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e081742c-4304-430a-b312-a32b5655284a",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "Alas, what ignorant sin have I committed?"
                                            },
                                            {
                                                "example_id": "bf8845ac-1292-4a12-b329-6da580679c17",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "[…] I beseech you,\nIf you know aught which does behove my knowledge\nThereof to be inform’d, imprison't not\nIn ignorant concealment."
                                            },
                                            {
                                                "example_id": "c26d800f-dc59-4bcc-b094-5d21a2364e92",
                                                "sense_id": "a9a553d4-14be-3325-b742-05dfce2cf507",
                                                "text": "1845, Robert Browning, letter addressed to Elizabeth Barrett Browning, cited in Percy Lubbock, Elizabeth Barrett Browning in Her Letters, London: Smith, Elder & Co., 1906, Chapter 4, p. 106,\n[…] as to you, your goodness and understanding will always see to the bottom of involuntary or ignorant faults—always help me to correct them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                        "entry_id": "875a5084-116d-3717-b3fa-13e82d564305",
                                        "glosses": [
                                            "Resulting from ignorance; foolish; silly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c733db6b-a9a1-4466-bfa8-d21f926e4d8d",
                                                "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                                "text": "[…] his shipping—\nPoor ignorant baubles!— upon our terrible seas,\nLike eggshells moved upon their surges, crack’d\nAs easily ’gainst our rocks:"
                                            },
                                            {
                                                "example_id": "4a1ca63d-2279-43d2-b033-32cc70244539",
                                                "sense_id": "006837c4-a292-35ea-b18d-e1a10fe306c7",
                                                "text": "He had never felt a pain or a sorrow, and did not know what they were, in any really informing way. He had no knowledge of them except theoretically—that is to say, intellectually. And of course that is no good. One can never get any but a loose and ignorant notion of such things except by experience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "543b8f82-471b-30e0-9f66-30d53c385c94",
                                        "entry_id": "81330b89-0514-3b03-a859-f3f2ae1c3a60",
                                        "glosses": [
                                            "One who is ignorant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5c9d066-6860-4572-9b85-ddedf1080959",
                        "source_entry_id": "a2be528d-5132-3686-9d65-86bc12aa3b8c",
                        "source_sense_id": "0ecbe08a-ef4e-383c-ae1a-96a766c82f95",
                        "target_lang_word": "ignare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                        "entry_id": "dac60b49-b781-38d7-9507-1fc484893cf3",
                                        "glosses": [
                                            "Qui est d’une ignorance excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4855906-af5a-4841-84f0-81d07462c134",
                                                "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                                "text": "Car comme un coq qui treuve une perle perdue\nNe sçachant la valeur de la chose incognue:\nAinsi, ou peu s’en faut, l’homme ignare ne sçait\nQuel est entre les deux sexes le plus parfait."
                                            },
                                            {
                                                "example_id": "9a85ca6e-9f88-41f1-a8b1-add51c575d03",
                                                "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                                "text": "[…] bien qu’ils ne soient pas des perroquets, ses élèves valent ceux des autres collègues. Le psittacisme serait-il à ce point recommandable ? Puisqu’à l’examen du Certificat ses candidats ne se montrent nullement ignares."
                                            },
                                            {
                                                "example_id": "50284a6f-4c4d-444c-bff1-fa039e5932b7",
                                                "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                                "text": "Le yé-yé désigne un genre, l'ensemble des exhibitions de mineurs ignares, exhibitions vocales ou instrumentales, individuelles ou collectives, caractérisées par leur outrance sonore et leur indigence d’expression."
                                            },
                                            {
                                                "example_id": "689f8739-248e-4212-82ce-4405ea59fb70",
                                                "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                                "text": "Je me sentais d’autant plus ignare qu’ils me considéraient tous comme un grand orientaliste et un spécialiste des Robaïyat, appréciation fort exagérée, je dirais même outrancière, mais que je dus vite renoncer à démentir, dès lors que mes protestations apparaissaient comme une manifestation d’humilité qui est, chacun le sait, la marque des vrais savants."
                                            },
                                            {
                                                "example_id": "1c4443a1-96b3-4ba2-a2cf-01e740ab98c0",
                                                "sense_id": "406f4058-9f49-3def-aee9-2537ef36ea90",
                                                "text": "Pour que le téléspectateur ne soit pas totalement abruti par des talk-shows et leurs têtes à clashs ou des téléréalités avec des personnages ignares et exubérants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ignare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de6c0263-5a07-34ff-89e4-e6bf60e8881b",
                                        "entry_id": "0f650e19-4502-3183-b200-9653d07d28d5",
                                        "glosses": [
                                            "Personnage d’une ignorance excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e22f42-ec68-4bec-96cd-5fa40b4b2415",
                                                "sense_id": "de6c0263-5a07-34ff-89e4-e6bf60e8881b",
                                                "text": "L’on voit rarement pareil ignare."
                                            },
                                            {
                                                "example_id": "dd420b5c-ae47-4975-8ea7-8c034708f015",
                                                "sense_id": "de6c0263-5a07-34ff-89e4-e6bf60e8881b",
                                                "text": "Pour jouer au jeu du type qui sait tout et du type qui ne sait rien. Au jeu du malin et du crétin, du culte et de l’inculte, du gnare et de l’ignare."
                                            },
                                            {
                                                "example_id": "bcade0a8-35d1-4e82-bae0-90bfa6b7ebbc",
                                                "sense_id": "de6c0263-5a07-34ff-89e4-e6bf60e8881b",
                                                "text": "Avant, l’ignare avait honte et gardait le silence. Maintenant, l’ignorant est fier et brandit sa connerie comme une médaille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
