        "fr-extract.jsonl": [
            {
                "entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                "word": "bouffonnerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93e83f73-e792-43f9-ae04-7267c3585a8e",
                        "entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouffonneries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb99fd9a-4678-36f9-8b32-dea874003762",
                        "entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "glosses": [
                            "Jeu théâtral de bouffon."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d50b9e8e-135d-3987-b1b9-e0b0c0c095a2",
                        "entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "glosses": [
                            "Ce qu’on fait ou ce qu’on dit pour exciter le rire ; plaisanterie grossière."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "581d0399-03f5-460c-ab72-88c8d0b48234",
                                "sense_id": "d50b9e8e-135d-3987-b1b9-e0b0c0c095a2",
                                "text": "Les Lettres à l'Étrangère, […] malgré cette jactance énorme, qui le fait se gonfler jusqu'à la bouffonnerie, sont le plus émouvant, le plus angoissant martyrologe qui se puisse imaginer d'une vie d'artiste, […]."
                            },
                            {
                                "example_id": "f6f01c24-021a-4012-8cf8-e00d8c51624f",
                                "sense_id": "d50b9e8e-135d-3987-b1b9-e0b0c0c095a2",
                                "text": "[…] ; la théologie morale des socialistes sérieux n'est pas une des moindres bouffonneries de notre temps."
                            },
                            {
                                "example_id": "0a937d42-be1f-431c-bae4-a2ca07eb60bb",
                                "sense_id": "d50b9e8e-135d-3987-b1b9-e0b0c0c095a2",
                                "text": "Parodie de justice ou bien procès de bouffonnerie, comme il était écrit tout récemment dans un des plus grands journaux du monde ! Pourquoi cette mascarade dont je fus victime ?"
                            },
                            {
                                "example_id": "cdd67d33-c53c-40df-ba5e-9244b0126605",
                                "sense_id": "d50b9e8e-135d-3987-b1b9-e0b0c0c095a2",
                                "text": "Ce n'était rien de manier un tel homme, et je jouais très bien mon rôle dans la bouffonnerie militaire que je découvrais seulement maintenant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4182766b-daa1-42c6-bb2a-7684dd11af4c",
                        "source_entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "target_lang_word": "buffoonery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buffoonery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                        "entry_id": "d2fa18a7-0552-3457-bc0f-ae2a6fe66cbc",
                                        "glosses": [
                                            "The behaviour expected of a buffoon; foolishness, silliness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "807874c5-ddd9-40da-a384-56419b0e1cdd",
                                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                                "text": "Araminta, come I'll talk ſeriouſly to you now, could you but ſee vvith my Eyes the buffoonry of one Scene of Addreſs, a Lover, ſet out with all his Equipage and Appurtenances; […]"
                                            },
                                            {
                                                "example_id": "1a75a5c1-f6ff-4f41-8627-1af53cc52377",
                                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                                "text": "[W]e ſet him [the Devil] up like a Scare-Crovv to fright Children and old VVomen, to fill up old Stories, make Songs and Ballads, and in a VVord, carry on the lovv priz'd Buffoonry of the common People; […]"
                                            },
                                            {
                                                "example_id": "9724639e-5d59-4b17-ab03-49c9a859583c",
                                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                                "text": "[…] One could not expect any body to take such a part—Nothing but buffoonery from beginning to end."
                                            },
                                            {
                                                "example_id": "4178decf-c695-4351-b61d-fe42d03310bb",
                                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                                "text": "The Temperance Reform was too serious a matter for trifling jokes and buffooneries."
                                            },
                                            {
                                                "example_id": "ce8f726f-9d3d-4800-94ed-fe2b45471891",
                                                "sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                                                "text": "Preamble is a hard-boiled steel commuter built for comfort, durability, and buffoonery on pavement and gravel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "424bc223-f230-4131-a7cb-426ba4f77d24",
                        "source_entry_id": "dde1f985-b5b8-3774-8610-991af42fb947",
                        "target_lang_word": "clowning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clowning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da7fc0df-c92f-3eb6-bc16-48c737ce2d57",
                                        "entry_id": "b1d536cc-e057-3327-9dae-8b31b1352eae",
                                        "glosses": [
                                            "Clownish behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141d27f6-083f-483f-aff8-d7e0eb891ead",
                                                "sense_id": "da7fc0df-c92f-3eb6-bc16-48c737ce2d57",
                                                "text": "The press took seriously all Shaw's provocative ambiguities and clownings, and Lady Astor was identified with his most outrageous actions and statements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc688e2-a25f-3ac9-8236-13b30dc9e1c4",
                                        "entry_id": "b1d536cc-e057-3327-9dae-8b31b1352eae",
                                        "glosses": [
                                            "The practice and study thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffdc8c1f-b316-46af-866c-fba75daa06f0",
                                                "sense_id": "edc688e2-a25f-3ac9-8236-13b30dc9e1c4",
                                                "text": "But it’s also a sign of the ascendant state of clowning, which, not long ago, resided in the bargain basement of artistic respect, alongside ventriloquists, mimes and jugglers. No longer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clowning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6bf25d-053e-3f77-9a93-d2bc9b461f30",
                                        "entry_id": "ca417fe0-383d-393b-8ae1-aab0010bca32",
                                        "glosses": [
                                            "present participle and gerund of clown"
                                        ],
