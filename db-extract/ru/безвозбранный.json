                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2db00cd-6f22-4e50-97ad-964c1bbc5852",
                                "sense_id": "6a553970-09d2-33c9-b2dd-47fec88eb659",
                                "text": "Слобода огласилась беспорядочной ружейной трескотнёй ― юная красная армия в пылу воинственного увлечения принялась забавляться пальбой из заржавелых винтовок, неожиданно попавших в её полное и безвозбранное пользование… Офицерству пришлось бежать в соседнюю станицу."
                            }
                        ]
