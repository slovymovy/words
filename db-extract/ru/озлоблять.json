                ],
                "translations": [
                    {
                        "translation_id": "9dde2501-d26a-4087-843d-2c9e64bdcf61",
                        "source_entry_id": "1a5ff164-d9e7-3229-a94a-bead3cc3ce18",
                        "source_sense_id": "dbdc2bf5-3166-3e41-8b9d-ee4a78c6e326",
                        "target_lang_word": "embitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "224b882f-049c-3f44-bf19-27b6ff9a9321",
                                        "entry_id": "f7668bdb-7013-3f8c-83fd-6ffab4bbdb28",
                                        "glosses": [
                                            "To cause (something) to be or taste bitter; to bitter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                        "entry_id": "f7668bdb-7013-3f8c-83fd-6ffab4bbdb28",
                                        "glosses": [
                                            "To cause (a positive quality such as happiness, or a thing such as an activity or one's life) to become less good or pleasurable; also, to make (a negative quality, or thing such as a disagreement) worse or more unpleasant."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e6e1ff-b568-43fe-8e36-7f5191217c2b",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "He imbitters not a diſtaſtfull meſſage to a forrein Prince by his indiſcretion in delivering it."
                                            },
                                            {
                                                "example_id": "43d0c331-2dae-4515-874c-1454fe22f16d",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "[I]t is our fond conceits, our froward humors, our perverse behaviors, which do create the trouble, which seemeth adherent to any condition, and embittereth every state; which from any slight occasion doth create vexation, and turneth every event into disaster."
                                            },
                                            {
                                                "example_id": "0f4af9b6-7e95-44f5-9b9d-6682309b8dac",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "The Proſpect of Death is ſo gloomy and diſmal, that if it vvere conſtantly before our Eyes, it vvould imbitter all the Svveets of Life."
                                            },
                                            {
                                                "example_id": "db01f934-ed20-47a2-9ebd-a816f7315b4b",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "Their pleaſures, poor as they vvere, could not be preſerved pure, but vvere embittered by petty competitions and vvorthleſs emulation."
                                            },
                                            {
                                                "example_id": "a1959cd6-4ac3-42a5-b8cd-c20373ba0a86",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "A juſt, but melancholy reflection, embittered, hovvever, the nobleſt of human enjoyments."
                                            },
                                            {
                                                "example_id": "3f0e6449-991d-4981-8ebf-4b0f13b8efe5",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "[T]hat monſtrous fiction, vvhich, by inſpiring falſe ideas and vain expectations into men deſtined to travel in the obſcure vvalk of laborious life, ſerves only to aggravate and imbitter that real inequality, vvhich it never can remove; […]"
                                            },
                                            {
                                                "example_id": "7d4d81bf-1062-4a16-8b62-771682dfae4b",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "Thou offendest, thou injurest not God, indeed, when thou sinnest, o man, but thou offendest, thou injurest thyself; […] Thou embitterest to thyself the enjoyment of a thousand innocent pleasures, and bereavest thyself of the noblest, the purest joys."
                                            },
                                            {
                                                "example_id": "b7aad3e2-4c52-447e-b819-dfe2bbb93d5f",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "Two circumstances only had embittered their union, which was otherwise as happy as mutual affection could render it."
                                            },
                                            {
                                                "example_id": "03d9479a-b9ee-4fc1-b0f3-472aa08eb292",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "It is with extreme reluctance that I dwell upon the appalling scene which ensued; a scene which, with its minutest details, no after events have been able to efface in the slightest degree from my memory, and whose stern recollection will imbitter every future moment of my existence."
                                            },
                                            {
                                                "example_id": "414033b7-74df-4def-84bc-6deb59f2a1fd",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "But his prosperity was embittered by one insupportable recollection. He never regained his cheerfulness, and at length died by his own hand."
                                            },
                                            {
                                                "example_id": "67bbc4db-61e0-41e9-af04-0cb256fafa1b",
                                                "sense_id": "a5db8565-8394-3cb3-8ae5-dff7b4fbd0cc",
                                                "text": "But my joy on reaching the east coast was sadly embittered by the news that Commander MacLune, of H. M. brigantine \"Dart,\" on coming in to Kilimane to pick me up, had, with Lieutenant Woodruffe and five men, been lost on the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f66821-7601-3e59-afdc-fc6128831de2",
                                        "entry_id": "f7668bdb-7013-3f8c-83fd-6ffab4bbdb28",
                                        "glosses": [
                                            "To cause (someone or their feelings) to become more angry, resentful, or unfriendly; to envenom."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e766a345-18b2-4e4f-a492-1e423acef87c",
                                                "sense_id": "29f66821-7601-3e59-afdc-fc6128831de2",
                                                "text": "Sometimes it [pride] ſtirreth vp men, and imboldeneth them to offer vvrongs: ſometimes imbittereth men; and maketh them vvayvvard againſt the right: […]"
                                            },
                                            {
                                                "example_id": "69ad596c-f639-4df7-815d-8a99479dddc4",
                                                "sense_id": "29f66821-7601-3e59-afdc-fc6128831de2",
                                                "text": "And hovv farre the like cenſurings and deſpiſings have embittered the ſpirits, and vvhetted both the tongues and pens of learned men one againſt another in our ovvne Church; […]"
                                            },
                                            {
                                                "example_id": "f4d48fb9-6bbd-4c58-ae6a-ab162bd0511b",
                                                "sense_id": "29f66821-7601-3e59-afdc-fc6128831de2",
                                                "text": "But tvvo things occaſioned great Contentions in them; The one vvas, the VVealth and Dignity of ſome Sees; the other vvas, the Heats that had been raiſed by the Arrian Hereſy, by vvhich Peoples minds vvere embittered one againſt another."
                                            },
                                            {
                                                "example_id": "bd054197-7bac-4bba-a5f6-ebc0ccc215ff",
                                                "sense_id": "29f66821-7601-3e59-afdc-fc6128831de2",
                                                "text": "She was at once humiliated and embittered; but the warm heart, and the strong mind, must have an object; and her energies, equally with her affections, had concentrated themselves on her son."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69be82c8-92d1-4a4b-b1a3-7724ac37dab1",
