                ],
                "senses": [
                    {
                        "sense_id": "0549dc8c-ce8c-31fa-b362-a293ae4a32e3",
                        "entry_id": "19446efa-8cc5-35d9-bc8c-32b679052637",
                        "glosses": [
                            "Friedhof, der zu einem Dorf gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbcaeb5c-0d49-4b65-a5a0-2f0a1a194cbe",
                                "sense_id": "0549dc8c-ce8c-31fa-b362-a293ae4a32e3",
                                "text": "„Mitten im Dorf gab es eine alte Dorfkirche, und gleich daneben war der Dorffriedhof.“"
                            },
                            {
                                "example_id": "4f802f88-2407-4dfa-a011-70ff156d0c66",
                                "sense_id": "0549dc8c-ce8c-31fa-b362-a293ae4a32e3",
                                "text": "„In diesen Dolmen wurden aber keine Individuen bestattet, es handelte sich um Sippen- oder Gemeinschaftsgräber, also Dorffriedhöfe, oft mit Dutzenden Beisetzungen über lange Zeiträume.“"
                            },
                            {
                                "example_id": "832e7829-32d7-4a3f-8031-7fd43157fe98",
                                "sense_id": "0549dc8c-ce8c-31fa-b362-a293ae4a32e3",
                                "text": "„Dennoch war es ein langer Zug, der hinter dem Wagen zu dem Dorffriedhof von Ronco sopra Ascona hinaufstieg, zwischen den Mauern, die der Herbst gefärbt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
