                                        "examples": [
                                            {
                                                "example_id": "aa86140b-80c4-40ec-a19c-30af88b1d51b",
                                                "sense_id": "fb7002fd-e8cb-31ab-bc75-077806541c98",
                                                "text": "„Obgleich es nicht in Verbindung mit dem Ripper geschieht, werden in Crowleys Buch The World's Tragedy Briefe des Prinzen Eddy an den Sohn eines Süßwarenhändlers in der Cleveland Street erwähnt.“"
