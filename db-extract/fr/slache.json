        "de-extract.jsonl": [
            {
                "entry_id": "47b6cc52-8945-382a-83d6-d7bb26535ffe",
                "word": "slache",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "749cdecb-429d-37c7-87cd-8ff3b98dd09e",
                        "entry_id": "47b6cc52-8945-382a-83d6-d7bb26535ffe",
                        "glosses": [
                            "meist ausgetretener, weicher Hausschuh ohne Absatz und Schaft"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a5ddb4d-0eaf-4508-86ff-ce99b5fca4fa",
                                "sense_id": "749cdecb-429d-37c7-87cd-8ff3b98dd09e",
                                "text": "«L’homme n’avait aucun goût pour s’habiller. Il portait un costume gris vieillot et des ‹ slaches › râpées.»",
                                "translation": "„Der Mann hatte keinerlei Lust, sich anzuziehen. Er trug einen alten grauen Anzug und verschlissene ‚Schlappen‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8187c0e-2cbb-3c23-b4d7-e24ec8a7872f",
                        "entry_id": "47b6cc52-8945-382a-83d6-d7bb26535ffe",
                        "glosses": [
                            "besonders leichte Sandale, die außer einer Sohle nur noch einen Zehensteg mit V-förmigen Riemen hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d028fe5-c760-406b-b0a5-7ffa9978be83",
                        "source_entry_id": "47b6cc52-8945-382a-83d6-d7bb26535ffe",
                        "source_sense_id": "749cdecb-429d-37c7-87cd-8ff3b98dd09e",
                        "source_sense_description": "Belgien umgangssprachlich: meist ausgetretener, weicher Hausschuh ohne Absatz und Schaft",
                        "target_lang_word": "Schlappen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlappen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8bd81de-ec1a-30f4-9532-00829e4289db",
                                        "entry_id": "95f6458e-eb75-3706-a60e-08bd4ec8bdd7",
                                        "glosses": [
                                            "leicht abwertend: bequemer Hausschuh, ausgetretener Schuh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c0cbb9-ca0b-40e6-83db-79ed082ecf32",
                                                "sense_id": "b8bd81de-ec1a-30f4-9532-00829e4289db",
                                                "text": "„Er stieg aus dem Bett, zog Breeches an und Schlappen und rasierte sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                        "entry_id": "95f6458e-eb75-3706-a60e-08bd4ec8bdd7",
                                        "glosses": [
                                            "umgangssprachlich: Autoreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7c5872-b3a3-4075-a82c-a74328cd52f6",
                                                "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                                "text": "Nicht nur die Automodelle werden immer größer, auch die Reifen nehmen an Umfang zu. 30-Zoll-Schlappen sind keine Seltenheit mehr."
                                            },
                                            {
                                                "example_id": "d14eb3fe-46c9-4c4d-956c-fd47803c7ae4",
                                                "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                                "text": "Die Vorteile von Breitreifen: Sie führen zu einem stabileren Fahrverhalten, besonders in Kurven. Aber davon profitieren allenfalls Fahrer mit besonders rasantem Stil. Ansonsten ist der größte \"Nutzen\" der breiten Schlappen die Optik."
                                            },
                                            {
                                                "example_id": "37bffa1f-a6b7-4c2d-a520-d0afd914dd50",
                                                "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                                "text": "Selten standen bei den Fotografen die Räder so sehr im Fokus. Wenige Minuten später durfte Pic dann mit den riesen Schlappen die erste Installationsrunde in Silverstone absolvieren."
                                            },
                                            {
                                                "example_id": "a9ea9bac-5762-4adb-8429-15b916024833",
                                                "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                                "text": "Das weiß auch der koreanische Reifenhersteller Hankook und hat dem Mannschaftsbus von Borussia Dortmund, einem MAN Lions Coach L, nagelneue “Schlappen” für den Fernverkehr verpasst."
                                            },
                                            {
                                                "example_id": "ef72cb93-c97a-4536-a17f-9bc7210a8f2f",
                                                "sense_id": "2d0970d1-75b6-3fea-a7b4-2ef7d594ae46",
                                                "text": "Wie alt ein Schlappen ist, verrät die DOT-Nummer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
