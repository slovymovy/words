                        "examples": [
                            {
                                "example_id": "e0a0c7b5-25cb-472f-8f1d-8fbd744987d7",
                                "sense_id": "827e192f-f9a8-3303-99e7-4d43dbe26f16",
                                "text": "De stadionramp gebeurde tijdens de halve finale van de Engelse bekercompetitie tussen Liverpool en Nottingham Forest. De wedstrijd werd gespeeld op neutraal terrein, het Hillsborough-stadion in Sheffield."
                            },
                            {
                                "example_id": "2276ee2a-11b0-479d-97cf-59be0847ad3a",
                                "sense_id": "827e192f-f9a8-3303-99e7-4d43dbe26f16",
                                "text": "Eerder deze week werd Barendrecht al uit de bekercompetitie gehaald, omdat het een niet-speelgerechtigde speler liet opdraven in het bekerduel met FC Hilversum. Hilversum bekert nu verder en neemt het op tegen RKC Waalwijk."
                            }
