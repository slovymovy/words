            {
                "entry_id": "84c27f9b-2782-3d2d-90c7-8de24e241af7",
                "word": "vésicatoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ede14e2d-8ad7-4bd7-9c5d-b84fa6c3ad1f",
                        "entry_id": "84c27f9b-2782-3d2d-90c7-8de24e241af7",
                        "tags": [
                            "plural"
                        ],
                        "form": "vésicatoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                        "entry_id": "84c27f9b-2782-3d2d-90c7-8de24e241af7",
                        "glosses": [
                            "Substance, médicament, qui fait venir des ampoules, qui détermine le soulèvement de l’épiderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad100d6-7627-4f78-ade6-6a5ec8a5260c",
                                "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                                "text": "Il faut lui appliquer, lui mettre un vésicatoire, des vésicatoires."
                            },
                            {
                                "example_id": "f62ce302-188c-419d-998d-f2016e39d44c",
                                "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                                "text": "Le vésicatoire n’a pas pris."
                            },
                            {
                                "example_id": "8ac936fa-cf62-4a34-9e3f-846c05a73195",
                                "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                                "text": "Il engagea madame de Chasteller à souffrir un vésicatoire à la jambe et l’empêcha ainsi de marcher pendant un mois."
                            },
                            {
                                "example_id": "17ce3f59-624b-46b4-96b2-6848b798d886",
                                "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                                "text": "Maître Mouche me présentait Virginie Préfère comme une personne digne de respect, d’estime et de sympathie, pleine d’honneur, capable de dévouement, instruite, discrète, lisant bien à haute voix, pudique et sachant poser des vésicatoires."
                            },
                            {
                                "example_id": "206fce85-5f6a-48ca-a803-0be445c88610",
                                "sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                                "text": "Les médecins de Talleyrand, Bourdois, Lamoureux et Lasserre, sont venus pour diagnostiquer une esquinancie infectieuse. Ils se trompent, je me suis empressée de les remercier avant qu’ils ne me couvrent de vésicatoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "178be4ab-bfe0-4737-a12c-56ae842e2840",
                        "source_entry_id": "84c27f9b-2782-3d2d-90c7-8de24e241af7",
                        "source_sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                        "target_lang_word": "Vesikatorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a96eb22f-3be4-46a7-a414-3cdd8372ffa9",
                        "source_entry_id": "84c27f9b-2782-3d2d-90c7-8de24e241af7",
                        "source_sense_id": "d8472b1e-656f-3c88-a5ca-f54319d9c05b",
                        "target_lang_word": "Zugpflaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zugpflaster",
