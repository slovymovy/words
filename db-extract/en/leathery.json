                                "target_senses": [
                                    {
                                        "sense_id": "6f1d984b-758d-3787-b70f-3db2445a443b",
                                        "entry_id": "043a5864-5712-3149-aec7-e2cbfd1cfd0c",
                                        "glosses": [
                                            "aus Leder bestehend oder gemacht"
                                        ],
                                        "tags": [
                                            "attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d369d727-929c-41ec-a222-19347f89a35c",
                                                "sense_id": "6f1d984b-758d-3787-b70f-3db2445a443b",
                                                "text": "Vor Weihnachten kaufte ich eine lederne Damenhandtasche."
                                            },
                                            {
                                                "example_id": "c43e38bb-a71a-43e2-a7cf-c86bd62cb341",
                                                "sense_id": "6f1d984b-758d-3787-b70f-3db2445a443b",
                                                "text": "„Allein Ardan gab sich locker und gelöst, führte den Begleitern seine ledernen Gamaschen mit einem von ihm erdachten Schnellknöpfmechanismus vor, suchte sich eine Zigarre aus der Innentasche seines weiten Cordanzugs und steckte sie sich an, ohne daß ihm die Hand dabei zitterte.“"
                                            },
                                            {
                                                "example_id": "2e237068-e88e-408f-a8e0-e366c7e5176a",
                                                "sense_id": "6f1d984b-758d-3787-b70f-3db2445a443b",
                                                "text": "„Er ließ sich auf der hölzernen Kopfstütze nieder und hielt sich mit seinen ledernen Prothesen den Kopf.“"
                                            },
                                            {
                                                "example_id": "4be616f1-c6b5-4050-9cc8-1bf4fcbb6a40",
                                                "sense_id": "6f1d984b-758d-3787-b70f-3db2445a443b",
                                                "text": "„Und nachdem sie die Becher in einem Zug geleert hatten, reichte der Offizier der Bersaglieri Bota eine lederne Brieftasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f6bf2c8-1469-321d-bd15-3e7c13979ac0",
                                        "entry_id": "043a5864-5712-3149-aec7-e2cbfd1cfd0c",
                                        "glosses": [
                                            "ähnliche Beschaffenheit wie Leder habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb0b8e7a-8020-44fa-ac4b-ad0fe9c0f12e",
                                                "sense_id": "9f6bf2c8-1469-321d-bd15-3e7c13979ac0",
                                                "text": "Dieses Schnitzel schmeckt ledern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f2bcdcd3-aef9-3416-a16d-b8c2eea2a322",
                                        "entry_id": "043a5864-5712-3149-aec7-e2cbfd1cfd0c",
                                        "glosses": [
                                            "ohne Abwechslung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf554983-cc4d-4988-b802-27ef6498744c",
                                                "sense_id": "f2bcdcd3-aef9-3416-a16d-b8c2eea2a322",
                                                "text": "Dieser lederne Vortrag lädt zum Einschlafen ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
