                        "examples": [
                            {
                                "example_id": "9522428e-0717-46d2-a4b1-abd4c97cf5db",
                                "sense_id": "f470fea1-b2c8-3ba9-89d4-1fc1c93d7e04",
                                "text": "La tronche de l’enflure a cogné si fort dans les entrailles du tagazou qu’on a l’impression que le zinc s’est lâché une perlouze de gaz d’échappement dans l’empennage à s’en faire péter les membrures."
                            },
                            {
                                "example_id": "3f96fe20-7f1f-4b34-877e-fc0bf469c340",
                                "sense_id": "f470fea1-b2c8-3ba9-89d4-1fc1c93d7e04",
                                "text": "S’il dit : « Je lâche une perle » ou « Une perlouze a tombé », il veut dire qu’il a pété d’une certaine façon, très doucement, que le pet a coulé sans éclat."
                            }
                        ]
                    }
