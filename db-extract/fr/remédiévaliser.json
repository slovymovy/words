                "senses": [
                    {
                        "sense_id": "11e14e3c-aee9-32dd-a3c4-c5079a757cdf",
                        "entry_id": "b29917c8-659b-3180-9c73-7dbe025a4b1f",
                        "glosses": [
                            "Redonner un caractère médiéval à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3302d3-c975-4898-89c4-e9bb75a8d46a",
                                "sense_id": "11e14e3c-aee9-32dd-a3c4-c5079a757cdf",
                                "text": "A quoi bon « remédiévaliser » une forme qui n’a pas été modifiée de façon certaine par Abel ?"
                            },
                            {
                                "example_id": "cf8fc0e3-1c74-4dd4-899b-79a7ad6d8e7c",
                                "sense_id": "11e14e3c-aee9-32dd-a3c4-c5079a757cdf",
                                "text": "À Arles, par exemple, les édiles de 1826 ont voulu en partie remédiévaliser la ville en restaurant, de leur propre autorité, ou parfois même en créant des toponymes descriptifs du passé, de façon à constituer une mémoire consciente de la ville."
                            }
                        ]
                    }
