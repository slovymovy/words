                    {
                        "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                        "entry_id": "09a337fd-c457-3e04-9c7c-bd26eaf7d3c6",
                        "glosses": [
                            "Cylindre cannelé."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "99528884-5b9c-47fd-9ee5-547db018e7ce",
                                "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                                "text": "Le chariot c est un organe mobile, d’une longueur égale à celle du métier qui s’éloigne et se rapproche des cannelés."
                            },
                            {
                                "example_id": "5cd28b73-fc1e-4cc2-be0a-eced4496ba5b",
                                "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                                "text": "C’est-à-dire qu’il faut multiplier le numéro que l’on veut obtenir par le nombre de dents de la roue sur le cannelé de derrière, et diviser le produit par le numéro obtenu."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                        "entry_id": "09a337fd-c457-3e04-9c7c-bd26eaf7d3c6",
                        "glosses": [
                            "Petite pâtisserie au rhum, aux bords cannelés."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "5dcb6d14-01df-440a-97f7-ca1b83371e61",
                                "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                                "text": "Un moule à cannelé."
                            },
                            {
                                "example_id": "f6dd91cf-0c22-48a7-99ac-f03b6d5f08f1",
                                "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                                "text": "Des cannelés bordelais."
                            }
                        ]
                    },
