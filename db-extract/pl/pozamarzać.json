                        "sense_id": "6cc80ab1-ec0e-3f54-b844-f885d38d27a1",
                        "entry_id": "05c5d8aa-59be-33ea-b8ad-e2931a7c373e",
                        "glosses": [
                            "o wielu ludziach lub zwierzętach: umrzeć z powodu wychłodzenia organizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
