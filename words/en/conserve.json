{
    "word_family": [
        "conservation",
        "conservationist",
        "conservatism",
        "conservative",
        "conservatory",
        "conservator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2357f7f9-3ab3-3ce5-979b-a831e0eb2d41",
                    "sense_definition": "To protect and preserve something from damage, loss, or waste, especially the environment or historical sites.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community worked hard to <w>conserve</w> the historic building instead of letting it be demolished.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество усердно работало над тем, чтобы <w>сохранить</w> историческое здание, не дав его снести.",
                                "zh": "当地社区努力<w>保护</w>这座历史建筑，而不是任其被拆除。"
                            }
                        },
                        {
                            "text": "It is vital that we <w>conserve</w> wildlife habitats to prevent the extinction of rare species.",
                            "target_lang_translations": {
                                "ru": "Жизненно важно, чтобы мы <w>охраняли</w> места обитания диких животных для предотвращения вымирания редких видов.",
                                "zh": "我们必须<w>保护</w>野生动物栖息地，以防止稀有物种灭绝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve",
                        "protect",
                        "save"
                    ],
                    "antonyms": [
                        "destroy",
                        "neglect",
                        "waste"
                    ],
                    "common_phrases": [
                        "conserve wildlife habitats",
                        "conserve historic buildings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищать и сохранять что-либо от повреждения, утраты или разрушения, особенно окружающую среду или исторические объекты.",
                        "zh": "保护某物免受损坏、损失或浪费，尤指保护环境或历史遗迹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "оберегать от разрушения или исчезновения"
                            },
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "защищать природу или памятники"
                            },
                            {
                                "target_lang_word": "беречь",
                                "target_lang_sense_clarification": "относиться бережно, не давать пропасть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保护",
                                "target_lang_sense_clarification": "维护不受损害"
                            },
                            {
                                "target_lang_word": "保存",
                                "target_lang_sense_clarification": "使事物保持原样"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c62c3faa-3e1d-3b15-9fbc-8fb37256aef2",
                    "sense_definition": "To use something sparingly or carefully in order to prevent loss or depletion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "saving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the drought, residents were asked to <w>conserve</w> water by taking shorter showers.",
                            "target_lang_translations": {
                                "ru": "Во время засухи жителей просили <w>экономить</w> воду, принимая душ быстрее.",
                                "zh": "干旱期间，居民被要求通过缩短淋浴时间来<w>节约</w>用水。"
                            }
                        },
                        {
                            "text": "You should <w>conserve</w> energy by turning off the lights when you leave the room.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>сберегать</w> электроэнергию, выключая свет, когда вы выходите из комнаты.",
                                "zh": "离开房间时随手关灯，这样可以<w>节约</w>能源。"
                            }
                        }
                    ],
                    "synonyms": [
                        "economize",
                        "husband",
                        "save"
                    ],
                    "antonyms": [
                        "squander",
                        "waste",
                        "deplete"
                    ],
                    "common_phrases": [
                        "conserve energy",
                        "conserve water",
                        "conserve resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать что-либо экономно или осторожно, чтобы предотвратить потерю или истощение запасов.",
                        "zh": "节约或谨慎地使用某物，以防止浪费或耗尽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономить",
                                "target_lang_sense_clarification": "бережливо расходовать ресурсы"
                            },
                            {
                                "target_lang_word": "сберегать",
                                "target_lang_sense_clarification": "сохранять ресурсы, не тратя лишнего"
                            },
                            {
                                "target_lang_word": "рационально использовать",
                                "target_lang_sense_clarification": "использовать с умом, без потерь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节约",
                                "target_lang_sense_clarification": "节省资源"
                            },
                            {
                                "target_lang_word": "节省",
                                "target_lang_sense_clarification": "减少不必要的消耗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "368fff9c-2a2d-3ca1-8a80-5ff236fe1d8f",
                    "sense_definition": "To remain constant or unchanged in quantity during a physical or chemical process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a closed system, the total amount of energy is <w>conserved</w> even if it changes form.",
                            "target_lang_translations": {
                                "ru": "В замкнутой системе общее количество энергии <w>сохраняется</w>, даже если она меняет форму.",
                                "zh": "在一个封闭系统中，即使能量形式发生改变，其总量依然<w>守恒</w>。"
                            }
                        },
                        {
                            "text": "Physicists study how momentum is <w>conserved</w> during a collision between two objects.",
                            "target_lang_translations": {
                                "ru": "Физики изучают, как <w>сохраняется</w> импульс при столкновении двух объектов.",
                                "zh": "物理学家研究两个物体碰撞时动量是如何<w>守恒</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maintain",
                        "keep"
                    ],
                    "common_phrases": [
                        "conserve momentum",
                        "conserve mass"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться неизменным по количеству в ходе физического или химического процесса.",
                        "zh": "在物理或化学过程中，某量的数值保持不变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохраняться",
                                "target_lang_sense_clarification": "о физических величинах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "守恒",
                                "target_lang_sense_clarification": "物理学中总量保持不变"
                            },
                            {
                                "target_lang_word": "保持不变",
                                "target_lang_sense_clarification": "维持原有状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9625b810-bac8-317d-a415-55bddc7cd5ab",
                    "sense_definition": "A food preparation made by preserving whole or sliced fruit in sugar; a type of jam.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served a delicious apricot <w>conserve</w> with the fresh scones during tea.",
                            "target_lang_translations": {
                                "ru": "К чаю она подала вкусный абрикосовый <w>конфитюр</w> со свежими булочками.",
                                "zh": "喝茶时，她端上了美味的杏子<w>果酱</w>和新鲜的司康饼。"
                            }
                        },
                        {
                            "text": "This fruit <w>conserve</w> contains large chunks of berries and very little added pectin.",
                            "target_lang_translations": {
                                "ru": "Это фруктовое <w>варенье</w> содержит крупные кусочки ягод и очень мало добавленного пектина.",
                                "zh": "这种水果<w>果酱</w>含有大块浆果，且几乎没有添加果胶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jam",
                        "preserve",
                        "marmalade"
                    ],
                    "common_phrases": [
                        "fruit conserve",
                        "strawberry conserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пищевой продукт, приготовленный путем консервирования целых или нарезанных фруктов в сахаре; разновидность джема или варенья.",
                        "zh": "一种用糖腌制整块或切块水果制成的食品，类似于果酱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфитюр",
                                "target_lang_sense_clarification": "густое варенье с кусочками фруктов"
                            },
                            {
                                "target_lang_word": "варенье",
                                "target_lang_sense_clarification": "плоды, сваренные в сахаре"
                            },
                            {
                                "target_lang_word": "джем",
                                "target_lang_sense_clarification": "густая фруктовая масса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果酱",
                                "target_lang_sense_clarification": "水果制成的甜食"
                            },
                            {
                                "target_lang_word": "蜜饯",
                                "target_lang_sense_clarification": "糖渍水果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b53ee3-c791-32d6-9647-b30657f4d3a7",
                    "sense_definition": "An area of land kept in its natural state; a nature reserve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers spent the afternoon exploring the forest <w>conserve</w> near the edge of town.",
                            "target_lang_translations": {
                                "ru": "Туристы провели вторую половину дня, исследуя лесной <w>заповедник</w> на окраине города.",
                                "zh": "徒步旅行者下午在城郊的森林<w>保护区</w>里探险。"
                            }
                        },
                        {
                            "text": "No hunting is allowed within the boundaries of the nature <w>conserve</w>.",
                            "target_lang_translations": {
                                "ru": "В границах природного <w>заказника</w> охота запрещена.",
                                "zh": "在自然<w>保护区</w>范围内严禁狩猎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reserve",
                        "sanctuary",
                        "preserve"
                    ],
                    "common_phrases": [
                        "nature conserve",
                        "forest conserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, сохраняемый в естественном состоянии; заповедник.",
                        "zh": "保持自然状态的土地区域；自然保护区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заповедник",
                                "target_lang_sense_clarification": "охраняемая природная территория"
                            },
                            {
                                "target_lang_word": "заказник",
                                "target_lang_sense_clarification": "территория с особым режимом охраны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保护区",
                                "target_lang_sense_clarification": "受法律保护的自然区域"
                            },
                            {
                                "target_lang_word": "自然保护区",
                                "target_lang_sense_clarification": "专门保护动植物的区域"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}