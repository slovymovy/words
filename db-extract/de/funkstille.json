                "senses": [
                    {
                        "sense_id": "0b938a77-31b7-3674-b1f1-db1a909c5679",
                        "entry_id": "5a4b0aaa-cdde-3b8a-b443-20a3ea481148",
                        "glosses": [
                            "radio silence"
                        ],
