                        "examples": [
                            {
                                "example_id": "cfe0843c-42d5-416b-a8ea-9740fa6899d8",
                                "sense_id": "a6af9830-73bd-3e82-adc9-bbb759b04559",
                                "text": "Die film ademt een fascistoïde geest."
                            },
                            {
                                "example_id": "4296024c-d1c0-4f4d-acc3-e0f5552473ff",
                                "sense_id": "a6af9830-73bd-3e82-adc9-bbb759b04559",
                                "text": "Het is in feite een fascistoïde, gewelddadige staat die zijn gekleurde minderheden onderdrukt."
                            },
                            {
                                "example_id": "f9becaba-8c98-471b-8d90-d7ab593321e2",
                                "sense_id": "a6af9830-73bd-3e82-adc9-bbb759b04559",
                                "text": "Rusland was intussen een heel rechts land geworden, met fascistoïde trekken: een onaantastbare leider, en onvrije media."
                            }
                        ]
                    }
                ],
                "translations": [
