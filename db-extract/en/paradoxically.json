                "entry_id": "61c30fe1-b571-3c8a-ac76-a45b2b68669b",
                "word": "paradoxically",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b1a0f5ea-8dab-4b6f-a67a-fc2621fc3bdc",
                        "entry_id": "61c30fe1-b571-3c8a-ac76-a45b2b68669b",
