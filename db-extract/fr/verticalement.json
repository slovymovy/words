                                "target_senses": [
                                    {
                                        "sense_id": "6cbce515-879d-3e97-9629-6cd2995e31a0",
                                        "entry_id": "45aca0a3-95db-3fd5-b674-4fd5f8eee58b",
                                        "glosses": [
                                            "In a vertical direction or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a81e298-c4c0-44d1-a07a-1d6cdbb87355",
                                                "sense_id": "6cbce515-879d-3e97-9629-6cd2995e31a0",
                                                "text": "This story needs to be read vertically to be understood correctly."
                                            },
                                            {
                                                "example_id": "e3b5e7e5-c995-4a54-8025-51108c03dbfa",
                                                "sense_id": "6cbce515-879d-3e97-9629-6cd2995e31a0",
                                                "text": "The church stands in a churchyard so steep that it would seem that some of the inhabitants must have been buried vertically; there is an odd monument by the door, shaped like a coffin standing upon lion's feet."
                                            },
                                            {
                                                "example_id": "0477f912-046f-4824-883c-0a632af5a9c9",
                                                "sense_id": "6cbce515-879d-3e97-9629-6cd2995e31a0",
                                                "text": "Accumulation of the dye followed orthostichous patterns wherein the dye tended to accumulate in half of each leaf not vertically aligned with the inoculation leaf (leaves 1, 2, and 4), and in the whole of each leaf vertically aligned with the inoculation leaf (leaves 3 and 5)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
