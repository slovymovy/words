                "senses": [
                    {
                        "sense_id": "e72f6e05-1c26-3bcf-87e9-91d92d343c07",
                        "entry_id": "a0acf91b-4d82-3bcf-810b-c6a06cc9898b",
                        "glosses": [
                            "Donner un caractère astrologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71b4bf1-d0a9-48d9-824f-98102061845b",
                                "sense_id": "e72f6e05-1c26-3bcf-87e9-91d92d343c07",
                                "text": "C’est la sociologie (et de plus en plus l’ethnologie) qui a \"astrologisé\" ses compétences pour un plat de lentilles !"
                            },
                            {
                                "example_id": "a765377a-40a3-45c5-9c8f-e3a75a900a05",
                                "sense_id": "e72f6e05-1c26-3bcf-87e9-91d92d343c07",
                                "text": "Mais pour quelle raison tel ou tel savoir s'est-il ainsi astrologisé ?"
                            },
                            {
                                "example_id": "6d01b4d0-e140-42ac-a601-b7bd56674f5b",
                                "sense_id": "e72f6e05-1c26-3bcf-87e9-91d92d343c07",
                                "text": "Quelque chose ne peut être astrologisé que si le signal est simple et qu'il est en usage dans une société toute entière sur des générations."
                            }
                        ]
                    }
                ],
