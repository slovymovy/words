                "senses": [
                    {
                        "sense_id": "7bc79e42-39ea-32c1-9791-5acb13b46e7c",
                        "entry_id": "5f878ac8-b0ff-3257-bee5-8ea2b0335646",
                        "glosses": [
                            "weibliche Person, die Aktionen oder Abläufe vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "508ed6a6-ace0-40ed-915a-99bbd6cb8999",
                                "sense_id": "7bc79e42-39ea-32c1-9791-5acb13b46e7c",
                                "text": "„Großbauer habe sich daher \"entschieden und der neuen designierten Staatsoperndirektion mitgeteilt, dass der kommende Ball mein letzter als Organisatorin sein wird\".“"
                            },
                            {
                                "example_id": "990d76b4-3aeb-4280-b9ae-42b72c6ade5d",
                                "sense_id": "7bc79e42-39ea-32c1-9791-5acb13b46e7c",
                                "text": "„Doch während dieser Höllenfahrt mit den Sanitätern war plötzlich meine Tochter zur Organisatorin meiner Rettung geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
