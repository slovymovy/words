        "de-extract.jsonl": [
            {
                "entry_id": "4385a5dd-7b92-34bd-a13a-2fe81a240503",
                "word": "einhunderteins",
                "pos": "num",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                        "entry_id": "4385a5dd-7b92-34bd-a13a-2fe81a240503",
                        "glosses": [
                            "die Kardinalzahl zwischen 100 und 102; hundert und eins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5266dd32-14c6-4025-9f92-d5af802c0c3f",
                                "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                                "text": "„Einhunderteins Kanonenschüsse bei der Geburt waren für den Kronprinzen von geringem Nutzen, ein einziger Kuss von Mutter oder Vater hätte dem Kind mehr gebracht.“"
                            },
                            {
                                "example_id": "c9264442-3c65-4ace-a03a-4fdad7e5d9d1",
                                "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                                "text": "„Teilt man also die Zahlen in der Mitte und nimmt die zweite Gruppe in umgekehrter Reihenfolge, dann bekommt man fünfzig mal die Summe von einhunderteins.“"
                            },
                            {
                                "example_id": "caaed044-594d-46ed-a2db-12947678bf7f",
                                "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                                "text": "„Wissenschaftler haben eine Gruppe von Menschen im Alter von sechsundsechzig bis einhunderteins Jahren untersucht, die ihre Geschwister im Durchschnitt um sieben Jahre überlebt hatten.“"
                            },
                            {
                                "example_id": "1f1e718a-6b89-46c9-9615-623588252fcd",
                                "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                                "text": "„Möchten Sie beispielsweise in einer CObArray die Indizes l und 100 verwenden, müssen Sie Speicher für einhunderteins Elemente reservieren.“"
                            },
                            {
                                "example_id": "ff2e4ae8-550d-4f04-9d2d-b932fc42008a",
                                "sense_id": "27e88e16-2bfd-3d6b-b1ed-632f75cd6d4a",
                                "text": "„Der Einführung in die persische Paläographie dient die Herausgabe und Übersetzung von einhunderteins Urkunden in persischer Sprache, die jedoch in ihrer Mehrzahl dem 16. und 17. Jahrhundert angehören[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
