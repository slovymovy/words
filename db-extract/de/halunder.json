                "senses": [
                    {
                        "sense_id": "7b287833-cc19-30e2-8bf4-c24f21457c10",
                        "entry_id": "b7698761-7307-35ea-8a74-b61a5cfadfc3",
                        "glosses": [
                            "nordfriesischer Dialekt, der auf der Insel Helgoland gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730deaa5-7fda-45d5-973e-fd0d0f79555b",
                                "sense_id": "7b287833-cc19-30e2-8bf4-c24f21457c10",
                                "text": "Nur noch 150 Helgoländer sprechen das helgoländische Halunder - wegen der vielen Zuwanderer wird die Inselsprache durch das Plattdeutsche verdrängt."
                            },
                            {
                                "example_id": "2914be69-4033-40b8-b931-6bdcb07b6c57",
                                "sense_id": "7b287833-cc19-30e2-8bf4-c24f21457c10",
                                "text": "Selten hört man zwei auf der Straße Halunder reden."
                            },
                            {
                                "example_id": "a592e527-11fb-474d-bc55-2e421738ab42",
                                "sense_id": "7b287833-cc19-30e2-8bf4-c24f21457c10",
                                "text": "Das Halunder ist auf der Insel durch das Friesisch-Gesetz neben der standarddeutschen Amtssprache zum Amtsgebrauch zugelassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
