                                "sense_id": "ea2a0fe6-55ea-30d3-9511-339aa33721f8",
                                "text": "„Selbst in kleinen Städten und Dörfern sind diese Kultstätten schon von weitem zu sehen.“"
                            },
                            {
                                "example_id": "05d878f1-203f-4846-baf7-8e6279be9820",
                                "sense_id": "ea2a0fe6-55ea-30d3-9511-339aa33721f8",
                                "text": "„Viele Kultstätten wurden an der Nordgrenze des Imperiums am Rhein und an der Donau gefunden.“"
                            }
                        ],
