                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verloskunde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37b015b1-2ba0-361f-90d1-37aa36eaf940",
                                        "entry_id": "c7344cd4-7676-3585-b7f0-c71901821af9",
                                        "glosses": [
                                            "de studie van de zwangerschap en de bevalling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e8813a3-dbb5-47fd-a6a9-e3d4db5aa3c8",
                                                "sense_id": "37b015b1-2ba0-361f-90d1-37aa36eaf940",
                                                "text": "Het is zeer verkeerd om menschen die zonder geneeskundige vorming, alleen in het bezit zijn van eenige heelkundige kennis, tot de studie of tot het examen in de verloskunde toe te laten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf26cab-4637-3593-8c88-a6075e99ead7",
                                        "entry_id": "c7344cd4-7676-3585-b7f0-c71901821af9",
                                        "glosses": [
                                            "de beroepsmatige begeleiding tijdens iemands zwangerschap en de bevalling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca2cd99d-ce24-4937-b6ae-fa6187fcca51",
                                                "sense_id": "8cf26cab-4637-3593-8c88-a6075e99ead7",
                                                "text": "In de uitoefening vereischt de Verloskunde eene volledige opoffering van de gemakken des levens, en in sommige gevallen zelfs der gezondheid, en onbepaalde lust en bereidwilligheid tot hulp op ieder uur van den dag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31cda575-4624-471d-b984-d6eca4c5f2f3",
                        "source_entry_id": "92dac977-0003-3ead-8a0b-094853cdb88e",
                        "source_sense_id": "128f5c9f-9bb0-3338-8cc2-4a1c5edb3540",
                        "source_sense_description": "the practice and science of being a midwife",
                        "target_lang_word": "obstétrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstétrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e9c9fb7-1e3e-3b1c-aee0-7a4dee938e61",
                                        "entry_id": "b9c0c3a6-3ad0-34d3-815c-7b2629bfa93e",
                                        "glosses": [
                                            "Partie de la médecine relative aux accouchements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28c8a6c7-c851-4032-a176-6dbc926d4446",
                                                "sense_id": "3e9c9fb7-1e3e-3b1c-aee0-7a4dee938e61",
                                                "text": "L’obstétrique traditionnelle consiste à surveiller un phénomène physiologique en se tenant prêt à intervenir à tous les instants. L’obstétrique moderne consiste à perturber ledit phénomène de telle sorte que l’intervention devienne indispensable à l’heure exacte où le personnel est disponible. C’est beaucoup plus difficile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obstétrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2100e8c2-07e7-3c3e-84e4-42b2cd2e38d4",
                                        "entry_id": "a8762d81-9357-3699-b8d3-c0a2d738bdaf",
                                        "glosses": [
                                            "Qui a rapport avec la discipline médicale de l’obstétrique ou plus largement avec l’accouchement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c42d81c1-9fcd-420c-a88e-845f23c99081",
                                                "sense_id": "2100e8c2-07e7-3c3e-84e4-42b2cd2e38d4",
                                                "text": "En relation directe avec ce symbolisme sexuel, il nous faudra rappeler les multiples images du ventre de la Terre, de la mine assimilée à l’utérus et des minerais aux embryons — autant d’images qui confèrent une signification gynécologique et obstétrique aux rituels accompagnant les travaux des mines et de la métallurgie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cb5e119-db87-450f-9695-61f633c9d0d3",
                        "source_entry_id": "92dac977-0003-3ead-8a0b-094853cdb88e",
