                "senses": [
                    {
                        "sense_id": "cecb4a37-2c29-322b-981d-aac2bb9ccb27",
                        "entry_id": "4fa1939b-d4dc-3895-891b-eb73b04de0f7",
                        "glosses": [
                            "Lähmung des Musculus rectus lateralis, welcher das Auge in der Horizontalen nach außen dreht"
                        ],
                        "tags": [
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "45293245-8688-4448-a7e6-9d3eb2b0237e",
                                "sense_id": "cecb4a37-2c29-322b-981d-aac2bb9ccb27",
                                "text": "„Im klinischen Bilde tritt zwar die Abduzenslähmung auf, doch deutet sonst nichts auf eine Gr.'sche Erkrankung.“"
                            },
                            {
                                "example_id": "22f572be-7088-4adf-9501-beeb8a99ae6a",
                                "sense_id": "cecb4a37-2c29-322b-981d-aac2bb9ccb27",
                                "text": "„Die Aneurysmen des Karotissyphons erzeugen in der Regel gleichzeitige Hirnnervensymptome, vor allen Dingen Okulomotorius- und Abduzenslähmungen, aber auch Schmerzen und Ausfallserscheinungen im Trigeminusgebiet.“"
                            },
                            {
                                "example_id": "aecd78c3-96d4-4531-b36b-e9300075a956",
                                "sense_id": "cecb4a37-2c29-322b-981d-aac2bb9ccb27",
                                "text": "„Eine isolierte Abduzenslähmung kann nicht Folge einer Kernläsion sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
