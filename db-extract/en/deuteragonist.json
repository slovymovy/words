                                    {
                                        "sense_id": "30968535-e35c-366c-aeb9-2af03ed621b6",
                                        "entry_id": "f2dea0c8-0711-340b-ae31-41bcad664d75",
                                        "glosses": [
                                            "Dans le théâtre grec antique, acteur ayant le deuxième rôle le plus important après le protagoniste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d55c62-d6b0-4425-8885-179ae0002e83",
                                                "sense_id": "30968535-e35c-366c-aeb9-2af03ed621b6",
                                                "text": "Le tritagoniste, plus encore que le deutéragoniste, devait assumer une pluralité de rôles secondaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080a334b-ea13-3ff0-a60e-dc245b6e8e7a",
                                        "entry_id": "f2dea0c8-0711-340b-ae31-41bcad664d75",
