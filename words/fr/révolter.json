                    "frequency": "Middle",
                    "semantic_group_id": "indignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle injustice <w>révolte</w> profondément tous les citoyens de la ville."
                        },
                        {
                            "text": "Ce comportement inadmissible finit par <w>révolter</w> l'ensemble des professeurs du collège."
                        }
                    ],
                    "synonyms": [
                        "indigner",
                        "scandaliser",
                        "choquer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
