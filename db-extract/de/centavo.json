                "senses": [
                    {
                        "sense_id": "d0d090d7-07e5-352c-8fa9-b217aeb05d35",
                        "entry_id": "524ba553-8d3d-3e0b-af10-0accd597d1f0",
                        "glosses": [
                            "kleinste Währungseinheit in vielen spanisch- oder portugiesischsprachigen Ländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a12e79-dda4-4c7b-b339-d0004e12046c",
                                "sense_id": "d0d090d7-07e5-352c-8fa9-b217aeb05d35",
                                "text": "„Hygienischer sei es, den Körpern die Larven zu injizieren und sie so spurlos verschwinden zu lassen. Auch teurer. Der Bekannte, der sie mir besorge, habe große Ausgaben. Ledesma umarmt mich. Er flüstert mir zu, dass Mr. Allomby jeden Centavo bezahlen werde.“"
                            },
                            {
                                "example_id": "dfe32577-dc07-4f1d-86f7-9753e6f8334f",
                                "sense_id": "d0d090d7-07e5-352c-8fa9-b217aeb05d35",
                                "text": "„Nach dem, was du Toranaga heute gesagt hast, ist dein Leben keinen falschen Centavo mehr wert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
