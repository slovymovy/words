                "senses": [
                    {
                        "sense_id": "e24a1e5c-3e64-3f87-b2e3-870a8f57cf11",
                        "entry_id": "12a3ae9e-bcea-30ba-965a-701db66fe1e1",
                        "glosses": [
                            "Chanter en utilisant le karaoké."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f488fac-c8d8-4cd1-a856-eef6867e8d2e",
                                "sense_id": "e24a1e5c-3e64-3f87-b2e3-870a8f57cf11",
                                "text": "Derrière, les jeunes font pétarader leurs motos de trial, les filles karaokètent Céline Dion dans les granges, les gamins plongent en siclant dans des piscines portables."
                            },
                            {
                                "example_id": "d9b6e2cb-e4bd-46ce-9086-b8b6753ea829",
                                "sense_id": "e24a1e5c-3e64-3f87-b2e3-870a8f57cf11",
                                "text": "Ton dernier paragraphe prendra tout son sens pour moi dès lundi quand je vais devoir karaokéter, et à la base je suis juste super naze pour chanter."
                            },
                            {
                                "example_id": "4801bb3e-bd65-49dc-8f2e-12d071431d20",
                                "sense_id": "e24a1e5c-3e64-3f87-b2e3-870a8f57cf11",
                                "text": "J'utilise soundforge, lequel d'ailleurs possède la fonction inverse (certainement utile pour karaokéter, mais c'est pas le but !)."
                            }
                        ]
                    }
