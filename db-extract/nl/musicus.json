                    }
                ],
                "senses": [
                    {
                        "sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                        "entry_id": "7dc4c25f-5d95-3ce0-9a4c-ff06954d4e14",
                        "glosses": [
                            "iemand die muziek maakt en ten gehore brengt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "878d57fe-ad02-41da-9e5f-6378e7b656bb",
                                "sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                                "text": "De musici zwaaien naar de man en verlaten zijn kamer. Groot: „Deze meneer probeerde zijn ene hand bij de andere te krijgen. Misschien wilde hij voor ons klappen.” Een verpleegkundige begint even later een gesprekje met de patiënt over de gespeelde muziek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1ce67d7-7983-4ca6-bad7-e09fc9354781",
                        "source_entry_id": "7dc4c25f-5d95-3ce0-9a4c-ff06954d4e14",
                        "source_sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                        "source_sense_description": "iemand die muziek maakt en ten gehore brengt",
                        "target_lang_word": "Musikant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Musikant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0658043-35e6-33c1-aeed-ce28bd6f25e8",
                                        "entry_id": "0112eede-9e72-3e57-b394-c858832221da",
                                        "glosses": [
                                            "Person, die zu Tanz oder Unterhaltung Musik macht; heute auch mit negativem Unterton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d85a3ec-f9ba-4047-b052-da604b01d6f7",
                                                "sense_id": "a0658043-35e6-33c1-aeed-ce28bd6f25e8",
                                                "text": "„Die Kriegsabenteuer des Simplicius, dieses »seltsamen Vaganten«, der sich mal als Narr mit Eselsohren oder Musikant, mal als Soldat oder Räuber, mal als Händler oder Quacksalber durchschlägt - sie spiegeln von Anfang an eigene Erfahrungen des Autors, ohne deshalb komplett autobiographisch zu sein.“"
                                            },
                                            {
                                                "example_id": "66033066-07be-44c7-8503-b65df87fbae2",
                                                "sense_id": "a0658043-35e6-33c1-aeed-ce28bd6f25e8",
                                                "text": "„Schließlich beendeten die Musikanten ihr revolutionäres Potpouri und hielten inne.“"
                                            },
                                            {
                                                "example_id": "37989ca3-1a70-46e9-a84b-3c4b417bc1af",
                                                "sense_id": "a0658043-35e6-33c1-aeed-ce28bd6f25e8",
                                                "text": "„Gleich darauf setzte von der Treppe her das Spiel der Musikanten ein.“"
                                            },
                                            {
                                                "example_id": "02db8162-7060-466f-a147-657d823124d1",
                                                "sense_id": "a0658043-35e6-33c1-aeed-ce28bd6f25e8",
                                                "text": "„Während im Saal bei Rostows nach den Tönen der vor Müdigkeit bereits falsch spielenden Musikanten die sechste Anglaise getanzt wurde und die ermatteten Diener und Köche das Souper herrichteten, erlitt Graf Besuchow seinen sechsten Schlaganfall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4d69f61-8f74-48e4-ac6b-94f3e084c783",
                        "source_entry_id": "7dc4c25f-5d95-3ce0-9a4c-ff06954d4e14",
                        "source_sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                        "source_sense_description": "iemand die muziek maakt en ten gehore brengt",
                        "target_lang_word": "Musiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Musiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                        "entry_id": "baad8419-6b4e-3158-9671-268199dd8510",
                                        "glosses": [
                                            "jemand, der musiziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75b0b7ee-39de-4183-a8e2-7d6989b4ff96",
                                                "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                                "text": "Pablo spielt Klavier, aber er ist kein Musiker."
                                            },
                                            {
                                                "example_id": "d99d8bae-953c-408e-a390-14a5352f617a",
                                                "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                                "text": "„Zwei Musiker spielten Klezmer.“"
                                            },
                                            {
                                                "example_id": "3234e03f-ac2b-4947-844f-5912d2ea0b4b",
                                                "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                                "text": "„Bei der Bewerbung für Musikhochschulen (Konservatorien) müssen künftige Sänger und Musiker in der Eignungsprüfung durch Vorspielen oder -singen ihr Talent, Kenntnisse in Musiklehre und ein musikalisch geschultes Gehör unter Beweis stellen.“"
                                            },
                                            {
                                                "example_id": "7ddf6c6d-9ea7-4609-bbb8-7741b7368b29",
                                                "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                                "text": "„Die Musiker schienen ihn vom Konzert her zu kennen; offenbar hatte sein Gesang ihnen gefallen.“"
                                            },
                                            {
                                                "example_id": "3965e1ee-d897-42a1-a767-74c8e60bfc6d",
                                                "sense_id": "c3017fca-fcce-3eb9-954f-619b1a217904",
                                                "text": "„Um diese Zeit ist Hoffmann vor allem Musiker; er empfindet und bewältigt die Welt musikalisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dfbdcc0-acb9-4762-b090-c32ae5dbaec5",
                        "source_entry_id": "7dc4c25f-5d95-3ce0-9a4c-ff06954d4e14",
                        "source_sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                        "source_sense_description": "iemand die muziek maakt en ten gehore brengt",
                        "target_lang_word": "musician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                        "entry_id": "243dfd58-4743-3586-8166-5037c280ce63",
                                        "glosses": [
                                            "A composer, conductor, or performer of music; specifically, a person who sings and/or plays a musical instrument as a hobby, occupation, or profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2e5298-b16b-447e-8410-34852befdd2d",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "Jenny is a talented musician, playing the cello, saxophone, piano and guitar."
                                            },
                                            {
                                                "example_id": "8cfc3887-5d48-4c31-bc32-58286de699df",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "He joined Little Jewford and other musicians — all with outlandish stage names, like Wichita Culpepper and Sky Cap Adams — to form Kinky Friedman and the Texas Jewboys in 1973."
                                            },
                                            {
                                                "example_id": "8c2eaf6e-625c-4d91-b0d3-216ac4cb4121",
                                                "sense_id": "4baede47-1029-3dd6-8475-4f82afd6555f",
                                                "text": "Mr. Smith, a flesh-and-blood musician, produced A.I.-generated music and played it billions of times using bots he had programmed, according to the indictment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c6b9a6e-7043-4ec2-bd45-4ff4f4460143",
                        "source_entry_id": "7dc4c25f-5d95-3ce0-9a4c-ff06954d4e14",
                        "source_sense_id": "86ae14f0-9cec-33aa-8450-c849a92ba988",
                        "source_sense_description": "iemand die muziek maakt en ten gehore brengt",
                        "target_lang_word": "musicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc48225-f7f1-3be4-b886-c1144f58bbd1",
                                        "entry_id": "c08903ab-fada-3bb4-abb7-8b73ac2cd16a",
                                        "glosses": [
                                            "Personne qui joue ou compose de la musique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae80d27f-1124-3cba-8135-fa8b8039a985",
                                        "entry_id": "c08903ab-fada-3bb4-abb7-8b73ac2cd16a",
                                        "glosses": [
                                            "Personne qui fait profession de composer ou d’exécuter de la musique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a3fcc5b-7ac1-4d56-a5b7-f2932575a0e4",
                                                "sense_id": "ae80d27f-1124-3cba-8135-fa8b8039a985",
                                                "text": "La musique exprime les sentiments, mais elle serait bien empêchée de les définir, et, sans le commentaire des paroles, absent de la musique instrumentale, l’auditeur reste toujours dans un certain vague quant à la nature et à l’objet du sentiment dont s’est inspiré le musicien."
                                            },
                                            {
                                                "example_id": "c7b55ea7-75f2-4c50-8fae-cca0f551466f",
                                                "sense_id": "ae80d27f-1124-3cba-8135-fa8b8039a985",
                                                "text": "De leur balcon qu’on atteignait par une échelle, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
                                            },
                                            {
                                                "example_id": "eb3abccd-12cd-41a1-bff4-900fbdb31933",
                                                "sense_id": "ae80d27f-1124-3cba-8135-fa8b8039a985",
                                                "text": "La maison de production fournissait les choristes et les musiciens, suggérait fortement les chansons, déterminait les arrangements, et quelques choubidous plus tard, Françoise Deldick, Agnès Loti, Michèle et ses Wouaps sortaient de l’ombre."
                                            },
                                            {
                                                "example_id": "cb1af8da-70f2-4dd8-a61f-bd25b8e32f1c",
                                                "sense_id": "ae80d27f-1124-3cba-8135-fa8b8039a985",
                                                "text": "Jean-Pierre Marielle alias Monsieur de Sainte-Colombe — Je ne pense pas que je vais vous admettre parmi mes élèves.\nGuillaume Depardieu alias Marin Marais jeune — Dites-moi pourquoi ?\nMonsieur de Sainte-Colombe — Vous faites de la musique, monsieur, vous n’êtes pas musicien !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea1e3d7-4700-34c8-97af-f93d5b0fd989",
                                        "entry_id": "c08903ab-fada-3bb4-abb7-8b73ac2cd16a",
                                        "glosses": [
                                            "Maître-chanteur."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77c0409-5e4b-47e5-a704-fe089396b96a",
                                                "sense_id": "8ea1e3d7-4700-34c8-97af-f93d5b0fd989",
                                                "text": "Portalis commença par exercer ses petits talents de musicien. Il essaya d’abord de faire chanter Jules Ferry, pour une histoire d’enfants frauduleusement légitimés. L’affaire fit grand bruit. Puis il fit chanter le duc d’Aumale […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe891bd-fffe-3114-9b11-5a366f6bd1c8",
                                        "entry_id": "c08903ab-fada-3bb4-abb7-8b73ac2cd16a",
                                        "glosses": [
                                            "Haricot."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bbf281-a936-4a33-a258-1a1a01f947ff",
                                                "sense_id": "4fe891bd-fffe-3114-9b11-5a366f6bd1c8",
                                                "text": "Fleurant plaça une marmite au cul noir sur les braises et réactiva les flammes.\n– Une petite platée de « musiciens du soir » ? proposa-t-il sans qu’un autre choix ne parût possible.\n– De… ?\n– De fayots, mijotés à la sauce Michael…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3471c47-3a42-322e-9172-09cccab245ec",
                                        "entry_id": "c08903ab-fada-3bb4-abb7-8b73ac2cd16a",
                                        "glosses": [
                                            "Désignation du grade d’un membre du Governor General’s Foot Guards affecté à des fonctions de musicien détenant le grade de soldat"
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "musicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a741d3cc-41ee-3ea7-bb11-53a9db611917",
                                        "entry_id": "0bd84281-3447-3033-b070-98fd538b81a6",
                                        "glosses": [
                                            "Qui pratique la musique, produit de la musique, est sensible à la musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11af9ee5-37af-41bd-ba50-1bed9e26113c",
                                                "sense_id": "a741d3cc-41ee-3ea7-bb11-53a9db611917",
                                                "text": "On peut dire que, par un beau matin, notre Nation s’est avisée de vouloir figurer parmi les Nations Musiciennes."
                                            },
                                            {
                                                "example_id": "0a071ca2-6291-4c4b-bad3-2864406b8e59",
                                                "sense_id": "a741d3cc-41ee-3ea7-bb11-53a9db611917",
                                                "text": "Elles avaient une admirable intelligence et l’âme toute musicienne."
                                            },
                                            {
                                                "example_id": "cf5d956d-4cbb-4ab6-997d-62ec7aa2807f",
                                                "sense_id": "a741d3cc-41ee-3ea7-bb11-53a9db611917",
                                                "text": "Un curieux bruit de ferrailles musiciennes déclenché par l’ouverture de la porte salua son entrée dans la boutique."
                                            },
                                            {
                                                "example_id": "c3256cb3-50fe-4566-bb34-3df0e3c3ebc5",
                                                "sense_id": "a741d3cc-41ee-3ea7-bb11-53a9db611917",
                                                "text": "Quelques Alpini arrêtés dans leur promenade considéraient avec étonnement cette grosse femme et sa poussette musicienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
