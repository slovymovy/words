                "senses": [
                    {
                        "sense_id": "03121164-6f4b-30d6-b758-cae71275a084",
                        "entry_id": "c94d565c-f9f1-3477-9afe-f8bbc0263b36",
                        "glosses": [
                            "To affect as a canker; to eat away; to corrode; to consume."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "45d41e74-a77c-4d6d-a3f4-9eb4d2d82cce",
                                "sense_id": "03121164-6f4b-30d6-b758-cae71275a084",
                                "text": "Still onward winds the dreary way; / I with it; for I long to prove / No lapse of moons can canker Love, / Whatever fickle tongues may say."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e1ae18a-af45-38b0-bb90-fa41315296a8",
                        "entry_id": "c94d565c-f9f1-3477-9afe-f8bbc0263b36",
                        "glosses": [
                            "To infect or pollute; to corrupt."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "df532bcc-0961-3156-abe0-8322a28533d2",
                        "entry_id": "c94d565c-f9f1-3477-9afe-f8bbc0263b36",
                        "glosses": [
                            "To waste away, grow rusty, or be oxidized, as a mineral."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7393331c-4ed6-3750-a459-6b3269495dd8",
                        "entry_id": "c94d565c-f9f1-3477-9afe-f8bbc0263b36",
                        "glosses": [
                            "To be or become diseased, or as if diseased, with canker; to grow corrupt; to become venomous."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5d698eab-1425-4faa-843c-82698696fcfe",
                                "sense_id": "7393331c-4ed6-3750-a459-6b3269495dd8",
                                "text": "as with age his body uglier grows,\nSo his mind cankers."
                            },
                            {
                                "example_id": "4e14f486-d527-4271-9491-76fba807b5c8",
                                "sense_id": "7393331c-4ed6-3750-a459-6b3269495dd8",
                                "text": "[…] the road, always in bad condition, was edged with dog roses that scratched the paint. Blossom after blossom crept past them, draggled by the ungenial year: some had cankered, others would never unfold:"
                            }
                        ]
                    }
