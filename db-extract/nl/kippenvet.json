                "entry_id": "c5cc57e6-d0b2-365e-960d-ea4aff2f3cc6",
                "word": "kippenvet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e27e884-2528-3944-98ca-799e4303e6e9",
                        "entry_id": "c5cc57e6-d0b2-365e-960d-ea4aff2f3cc6",
                        "glosses": [
                            "vet van een kip, vet dat vrijkomt als men een kip braadt of grilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b4fae9e-0650-4fbb-8ddf-7f995b0ccc52",
                                "sense_id": "3e27e884-2528-3944-98ca-799e4303e6e9",
                                "text": "Himmelreich nam weliswaar vorig jaar afscheid bij ROC Amsterdam, maar hij duikt nog vaak op in diverse keukens om zijn enorme vakkennis te delen. Ik trof hem in de keuken van Bert van Buschbach (ook al een oud leerling) van restaurant De Compagnon in Amsterdam, waar hij een lans brak voor het gebruik van kippenvet om in te bakken. En passant leren we ook wat een chateau-aardappel is."
                            },
                            {
                                "example_id": "8502440f-3ea7-40e1-9dad-5dd03d3d96b8",
                                "sense_id": "3e27e884-2528-3944-98ca-799e4303e6e9",
                                "text": "Bak de uien in het kippenvet of de olie in een grote koekenpan met het deksel erop, tot ze gaar en lichtbruin zijn. Roer ze af en toe door. Laat ze afkoelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a66a2e9d-9a25-4841-a40a-dc94f263ac76",
                        "source_entry_id": "c5cc57e6-d0b2-365e-960d-ea4aff2f3cc6",
                        "source_sense_id": "3e27e884-2528-3944-98ca-799e4303e6e9",
                        "target_lang_word": "Hühnerfett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hühnerfett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e94442-2342-3978-ac7d-b08909ebe7ab",
                                        "entry_id": "98e9186a-2b3c-321e-9628-38069ad51737",
                                        "glosses": [
                                            "Fett, das von Hühnern stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d494ba44-b1cd-4409-99f8-9e9939a1ec3c",
                                                "sense_id": "b8e94442-2342-3978-ac7d-b08909ebe7ab",
                                                "text": "„\"Wir essen kein rotes Fleisch\", erklärt mir Tyler in dem Impala, und er kann kein Hühnerfett benutzen, weil die Seife sonst nicht hart wird.“"
                                            },
                                            {
                                                "example_id": "3c58d3ee-17af-4d29-81cb-110fbacb658b",
                                                "sense_id": "b8e94442-2342-3978-ac7d-b08909ebe7ab",
                                                "text": "„Meine Hände sind mit Hühnerfett überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
