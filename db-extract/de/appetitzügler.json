                    },
                    {
                        "translation_id": "279094a7-9591-4b6d-9ce8-0c4b91f93058",
                        "source_entry_id": "834d926d-82f2-33e3-a9b7-d40e1bacd809",
                        "source_sense_id": "37dc597c-02ab-324c-9b86-5872d6842831",
                        "source_sense_description": "Medikament, das den Appetit hemmt",
                        "target_lang_word": "coupe-faim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coupe-faim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc8cf08-bcc2-3ec7-9083-0e6e6a5d3e03",
                                        "entry_id": "dffcecb1-6033-3b2c-bd7f-a5461f7d659d",
                                        "glosses": [
                                            "Anorexigène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5c89b0-f650-4bc2-812d-40eb595a4e07",
                                                "sense_id": "7cc8cf08-bcc2-3ec7-9083-0e6e6a5d3e03",
                                                "text": "La noix de pin, souvent utilisée dans le pesto, pourrait aider à perdre du poids car il s’agit d’un coupe-faim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a44995-1956-4dad-a696-14a97f3cce0f",
                        "source_entry_id": "834d926d-82f2-33e3-a9b7-d40e1bacd809",
                        "source_sense_id": "37dc597c-02ab-324c-9b86-5872d6842831",
                        "source_sense_description": "Medikament, das den Appetit hemmt",
                        "target_lang_word": "anorexigène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorexigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                                        "entry_id": "50a21849-56ae-3b86-95d4-c838df921a32",
                                        "glosses": [
                                            "Se dit d'une substance ou d'une préparation qui est capable de réduire la sensation de faim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c3674f-bdf2-4ecb-9588-aff0a3e5f420",
                                                "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                                                "text": "L’action anorexigène de l’amphétamine chez l’homme fut démontrée dès 1939."
                                            },
                                            {
                                                "example_id": "6132bad9-d776-460f-abc8-04ceb7e8c4f5",
                                                "sense_id": "cfce9a47-7972-3ffd-8778-99e798c5b402",
                                                "text": "Elle possède en outre un effet anorexigène et thermogène et augmente le tonus sympathique et pourrait exercer, par l’action des protéines découplantes, une dissipation d’énergie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anorexigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                        "entry_id": "6080d51f-a0cb-3da7-a29c-26a976f6d944",
                                        "glosses": [
                                            "Produit qui provoque une perte de l’appétit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058df99e-0912-4d9a-b39c-a018f3786ade",
                                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                                "text": "Certains anorexigènes sont souvent utilisés comme produits dopants par les sportifs."
                                            },
                                            {
                                                "example_id": "2b320c81-de7d-4a51-9479-8d07f84609da",
                                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                                "text": "La plupart des anorexigènes appartiennent à la famille des amphétamines et sont apparentés aux stupéfiants. La plupart d’entre eux sont interdits dans de nombreux pays à cause d’effets secondaires graves."
                                            },
                                            {
                                                "example_id": "456aca8b-1313-4c90-81e8-2e873c9c50c6",
                                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                                "text": "Le principe actif de Médiator s’appelle « Benfluorex », c’est une molécule qui est très proche de l’amphétamine, l’amphétamine étant un psychostimulant, un hallucinogène et un anorexigène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
