                "senses": [
                    {
                        "sense_id": "ea5a95eb-e5d0-3711-ae21-adfe13046330",
                        "entry_id": "2c37cda5-4f3f-3096-9c2e-f2c35b622721",
                        "glosses": [
                            "Tag, an dem die Dividende an die Anteilseigner ausgezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a0e09c-f9c5-40c4-9b38-aa140a39cd19",
                                "sense_id": "ea5a95eb-e5d0-3711-ae21-adfe13046330",
                                "text": "„Dividendenzahltag ist der 25. Juli 2013, teilte das Unternehmen mit.“"
                            },
                            {
                                "example_id": "6de63a2f-c60d-40bd-85a9-fd82722c5ad9",
                                "sense_id": "ea5a95eb-e5d0-3711-ae21-adfe13046330",
                                "text": "„Für Aktionäre ist dies immer eine wichtige Zeit, nicht nur, weil es gelegentlich gilt, sich die schmackhaftesten Würstchen am Büffet zu sichern. Viel mehr ist meist Dividendenzahltag, der in Deutschland anders als in Amerika , eben nur einmal im Jahr ist.“"
                            },
                            {
                                "example_id": "9b96c59b-d58b-46be-96cd-d70356809f50",
                                "sense_id": "ea5a95eb-e5d0-3711-ae21-adfe13046330",
                                "text": "„Das Geschäftsmodell: Schwer durchschaubare Aktiengeschäfte rund um den Dividendenzahltag, um Gewinne zu machen mit mehrfachen Steuergutschriften deutscher Finanzämter. Gewinne per Griff in die Staatskasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
