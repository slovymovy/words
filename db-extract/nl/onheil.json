                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "50e29f31-87ca-4554-be24-5c28575769de",
                        "entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "tags": [
                            "plural"
                        ],
                        "form": "onheilen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "glosses": [
                            "grote tegenspoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518c0ed5-7786-4c95-b31e-2f9fac25143a",
                                "sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                                "text": "De jongen voelde dat er onheil in de lucht hing, en maakte zich uit de voeten."
                            },
                            {
                                "example_id": "45a975ad-7f01-4f30-a3ed-0d9254cc5b85",
                                "sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                                "text": "Maar als ik onzeker was, bijvoorbeeld tijdens onweer of bij steile afdalingen, probeerde ik anderen op te zoeken om het onheil niet alleen tegemoet te hoeven treden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f7ff6c1-0412-4b31-9880-cec6353d072f",
                        "source_entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "source_sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "source_sense_description": "groot ongeluk",
                        "target_lang_word": "Unheil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unheil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                        "entry_id": "3f73f2e6-7677-32e1-a684-c8f1195e0012",
                                        "glosses": [
                                            "ein furchtbares, schreckliches Geschehen, Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5edc8c4-19e7-482d-ab75-198c93fae190",
                                                "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                                "text": "Ohne große prophetische Gabe konnte man das Unheil kommen sehen."
                                            },
                                            {
                                                "example_id": "00291eee-fc70-4a52-a135-b09f0a8044f8",
                                                "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                                "text": "Ebenfalls im Volksglauben verwurzelt sind Unglücksbringer, die angeblich Unheil heraufbeschwören."
                                            },
                                            {
                                                "example_id": "3cc994a9-c5df-4ccb-bdc0-3f8889de8a9f",
                                                "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                                "text": "„795 bricht Unheil über Irland herein.“"
                                            },
                                            {
                                                "example_id": "291b507d-8ad9-45fd-99e5-eac7cec8baab",
                                                "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                                "text": "„Für die Indigenen bedeutete der Reichtum neues Unheil.“"
                                            },
                                            {
                                                "example_id": "9673fd11-17f9-4777-bab0-5f1a4de83cf7",
                                                "sense_id": "795743f7-c3ed-39ea-8f5e-21ff4c6da08c",
                                                "text": "„Er hatte ein Unheil heraufbeschworen, an dem ich ein Leben lang würde leiden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ecb574-668a-417a-8b89-f2d5e938f0e5",
                        "source_entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "source_sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "source_sense_description": "groot ongeluk",
                        "target_lang_word": "disaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5c7462-614d-3c44-abe8-a726818a241f",
                                        "entry_id": "2510a925-a060-3754-89f7-ee068208fc6d",
                                        "glosses": [
                                            "An unexpected natural or man-made catastrophe of substantial extent causing significant physical damage or destruction, loss of life or sometimes permanent change to the natural environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa32d88c-bff9-4f85-95ff-0c9d8bcd130d",
                                                "sense_id": "2c5c7462-614d-3c44-abe8-a726818a241f",
                                                "text": "People would suffer disasters when society's morality degenerates."
                                            },
                                            {
                                                "example_id": "013c86d3-c8ac-4d7e-a535-76349859d2e3",
                                                "sense_id": "2c5c7462-614d-3c44-abe8-a726818a241f",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0e2b15e-9c6f-3cdf-ae7b-94a190250e5a",
                                        "entry_id": "2510a925-a060-3754-89f7-ee068208fc6d",
                                        "glosses": [
                                            "An unforeseen event causing great loss, upset or unpleasantness of whatever kind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6d51276-ced2-4f6c-8424-86406725da34",
                                                "sense_id": "b0e2b15e-9c6f-3cdf-ae7b-94a190250e5a",
                                                "text": "And no use for anyone to tell Charles that this was because the Family was in mourning for Mr Granville Darracott […]: Charles might only have been second footman at Darracott Place for a couple of months when that disaster occurred, but no one could gammon him into thinking that my lord cared a spangle for his heir."
                                            },
                                            {
                                                "example_id": "3e7df706-6ea0-410b-822f-8d969f63821f",
                                                "sense_id": "b0e2b15e-9c6f-3cdf-ae7b-94a190250e5a",
                                                "text": "A nod means good, two nods; very good. And then there's the pursing of the lips: disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e7fd0e-ceb1-3494-ab41-77e5b281d77f",
                                        "entry_id": "2510a925-a060-3754-89f7-ee068208fc6d",
                                        "glosses": [
                                            "A skateboard trick involving a 180-degree ollie, landing on the center of the board with the front trucks facing towards the ramp and the back trucks over the lip. The skater then leans forwards to return in the ramp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9995b6fe-1d28-42f8-ba8d-feb9d0df4ef7",
                        "source_entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "source_sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "source_sense_description": "groot ongeluk",
                        "target_lang_word": "calamity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calamity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f7e964-5cbc-3ab6-8c93-e87b98e3cadc",
                                        "entry_id": "792d1901-eef2-3c88-a9c3-062c74f5517c",
                                        "glosses": [
                                            "An event resulting in great loss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c659c5-5dc9-457a-87c6-a5ebce3de0d5",
                                                "sense_id": "a7f7e964-5cbc-3ab6-8c93-e87b98e3cadc",
                                                "text": "Romeo come forth / Come forth thou fearfull man, / Affliction is enamor’d of thy parts: / And thou art wedded to calamitie."
                                            },
                                            {
                                                "example_id": "1f1a35ea-a97d-4fca-b7c8-d9a32f16bf90",
                                                "sense_id": "a7f7e964-5cbc-3ab6-8c93-e87b98e3cadc",
                                                "text": "Yet, at that moment, she felt as if the acquisition of these gems were a calamity. Their possession involved separation from her uncle, from every relic of home affections, and from all that yet lingered with her of her childhood."
                                            },
                                            {
                                                "example_id": "e3d69fc1-cb9e-4668-a95a-29777902e277",
                                                "sense_id": "a7f7e964-5cbc-3ab6-8c93-e87b98e3cadc",
                                                "text": "And the village was deserted, the huts gaped black, rotting, all askew within the fallen enclosures. A calamity had come to it, sure enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e381eb-90de-3a1a-b449-97290b525630",
                                        "entry_id": "792d1901-eef2-3c88-a9c3-062c74f5517c",
                                        "glosses": [
                                            "The distress that results from some disaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfb30d2-9398-4708-98ea-a47236c211ce",
                                                "sense_id": "01e381eb-90de-3a1a-b449-97290b525630",
                                                "text": "They were behind twice, first in the 11th minute when James Morrison scored a goal that was a personal calamity for Hart, and then four minutes into the second half when Kenny Miller eluded Gary Cahill to score with a splendid left-foot drive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "783ae3a3-ea45-49e6-b27e-6c954b0035a0",
                        "source_entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "source_sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "source_sense_description": "groot ongeluk",
                        "target_lang_word": "malheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                        "entry_id": "bde48fcc-1eaa-3ed3-9785-2dc5e39aa058",
                                        "glosses": [
                                            "Mauvaise fortune ; mauvaise destinée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fce382e-f530-4583-ad0d-3a23803293a6",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Quand on a eu le malheur de rencontrer le regard de cet œil malfaisant."
                                            },
                                            {
                                                "example_id": "203ea1ef-50eb-4870-ae9e-e293ae3523d8",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Il existe à la Liste civile un employé aux malheurs. Cet employé apprit un jour que la Palferine était dans une horrible détresse, il fit sans doute un rapport, et il apporta cinquante francs à l’héritier des Rusticoli."
                                            },
                                            {
                                                "example_id": "360bfac0-04e5-455e-927b-e45febc31cbb",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Le malheur et la mélancolie sont les interprètes les plus éloquents de l'amour, et correspondent entre deux êtres souffrants avec une incroyable rapidité."
                                            },
                                            {
                                                "example_id": "dcc47d44-b4a7-4cbe-a9a4-1a80eff8ae7b",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Malheur dieu pâle aux yeux d'ivoire\nTes prêtres fous t’ont-ils paré\nTes victimes en robe noire\nOnt-elles vainement pleuré\nMalheur dieu qu il ne faut pas croire."
                                            },
                                            {
                                                "example_id": "c7e1f27f-de3a-4e82-b148-58940df6601b",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Il aimait tant la mort, les poignards, les croix et les tombes, le poison, le vent dans les cheveux et ces manteaux qu’on drape d’un coup dans les tragédies romantiques, qu’il eût inventé le malheur plutôt que d’accepter l’idée de ne point en périr un jour."
                                            },
                                            {
                                                "example_id": "951f55c9-6e61-4cdb-92ee-c7e0852fad3b",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "Mais pourtant cette femme si ferme, si solide, le voit. Elle voit le malheur sur moi, comme elle voit « mes deux yeux sur ma figure ». Personne d’autre ici ne le sait, ils ont tous autre chose à faire. Mais elle qui m’observe, elle l’a reconnu, c’est bien lui : le malheur qui s’abat sur les enfants dans les livres dans Sans Famille, dans David Copperfield. Ce même malheur a fondu sur moi, il m’enserre, il me tient."
                                            },
                                            {
                                                "example_id": "b087eb5c-4f86-4463-8fa2-697ee03023b5",
                                                "sense_id": "f6474131-7067-3a47-8612-4ecf4e6f5f6f",
                                                "text": "1349, c'est la peste noire. Le malheur entraîne le malheur. La Grande Peste, Grande Tueuse... Les moines et les vieux qui survécurent en radotèrent longtemps l'épouvante. Une punition divine. Ils ont tous cru à une punition divine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21481f21-b44f-335e-a9a6-d921bca7e806",
                                        "entry_id": "bde48fcc-1eaa-3ed3-9785-2dc5e39aa058",
                                        "glosses": [
                                            "Accident fâcheux ; désastre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd23dd77-8665-442f-8e8a-32b810c46356",
                                                "sense_id": "21481f21-b44f-335e-a9a6-d921bca7e806",
                                                "text": "[…], mais ce n’est que le commencement de plus grands malheurs : ces Prussiens, ces Autrichiens, ces Russes, ces Espagnols, et tous ces peuples que nous avons pillés depuis 1804, vont profiter de notre misère pour tomber sur nous."
                                            },
                                            {
                                                "example_id": "9184ebbe-36f6-4a02-9e22-82f13ea8b8d4",
                                                "sense_id": "21481f21-b44f-335e-a9a6-d921bca7e806",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "6bbbf378-1edf-47a7-8f51-a204763e59d3",
                                                "sense_id": "21481f21-b44f-335e-a9a6-d921bca7e806",
                                                "text": "Le bruit, les allées et venues des gens m'alertèrent. J'accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c350ed-8d6f-3790-867f-8b071864b85c",
                                        "entry_id": "bde48fcc-1eaa-3ed3-9785-2dc5e39aa058",
                                        "glosses": [
                                            "Ce qui est regrettable dans une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420e0ffc-115e-4c57-a860-d550bbec449d",
                                                "sense_id": "81c350ed-8d6f-3790-867f-8b071864b85c",
                                                "text": "Le malheur c'est qu’il s'était engagé dans une aventure scabreuse, peut-être sans issue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea409b14-98e2-4ea5-9101-96e0a763c9e8",
                        "source_entry_id": "9313dccc-ff1e-3410-940e-39d05152bbe0",
                        "source_sense_id": "ca130631-a572-30da-bb87-830ca161f524",
                        "source_sense_description": "groot ongeluk",
                        "target_lang_word": "désastre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désastre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7eaef5-91bf-324b-8d8b-014621aaef1e",
                                        "entry_id": "05a0a1ef-55a3-382b-99b5-4c4e3ee54058",
                                        "glosses": [
                                            "Événement funeste ; grand malheur ; les effets qui en résultent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e602e3-b431-45a7-a2b1-dd5c78eacaa5",
                                                "sense_id": "fc7eaef5-91bf-324b-8d8b-014621aaef1e",
                                                "text": "Le désastre de Mohacz (1526) où mourut le roi Louis II ouvre pour la Hongrie et la Slovaquie la période de domination ottomane qui dure jusqu'au traité de Požarevac (1718)."
                                            },
                                            {
                                                "example_id": "3d0aaa0f-56a4-4119-bdf7-43e0667cb4c4",
                                                "sense_id": "fc7eaef5-91bf-324b-8d8b-014621aaef1e",
                                                "text": "Quoi qu’il en soit, on peut imaginer que le désastre phylloxérique mit subitement en présence des plus dures nécessités toute une population vigneronne qui avait jusque-là vécu insouciante sur ses coteaux."
                                            },
                                            {
                                                "example_id": "8135551c-d405-4b52-8a08-5154226648eb",
                                                "sense_id": "fc7eaef5-91bf-324b-8d8b-014621aaef1e",
                                                "text": "Mais cela aura des conséquences dans ses relations avec le très susceptible président brésilien, qui n’aime pas qu’on lui dise qu’il a les mains sales en raison du désastre écologique actuel en Amazonie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
