                        "glosses": [
                            "A craftsman who creates gold leaf by hammering gold bars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6876c307-cfaf-44df-b46c-56e049e64434",
                                "sense_id": "a14a5439-3ce7-3177-a21b-bfd57cad2a02",
                                "text": "Zebedee went to the goldbeaters shop, which smelled like lamb because the goldbeater ate a sandwich of lamb every day for lunch."
                            },
                            {
                                "example_id": "9215ca3c-c7b3-4759-8766-f24fb1e1d96f",
                                "sense_id": "a14a5439-3ce7-3177-a21b-bfd57cad2a02",
                                "text": "The membrane had been used, perhaps since antiquity, to make gold leaf, which goldbeaters produced by starting out with a small ingot of gold and beating it thinner, then sandwiching the leaves between sheets of cow intestines, ultimately creating a stack of alternating goldbeater's skins and gold leaf that could be more than 100 layers deep."
                            },
                            {
                                "example_id": "c0cfc6ee-8d82-47bf-a7d7-382e6699a95d",
                                "sense_id": "a14a5439-3ce7-3177-a21b-bfd57cad2a02",
                                "text": "In my mind's eye, I see Cristiano on the day he first arrived in my father's workshop, the old goldbeater's assistant now grown into a man."
                            }
                        ]
                    }
                ],
