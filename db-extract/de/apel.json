                ],
                "senses": [
                    {
                        "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                        "entry_id": "e19e4381-51bc-38db-9546-ab4692bc7a68",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975a4d15-f69a-4d9e-9b1b-f3025c8502be",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Frau Apel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "382e286d-e28e-41fc-a79f-6b67d953b514",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Herr Apel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "db08a12e-5749-4521-8d86-ecf3e8758b7f",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Die Apels kommen heute aus dem Siebengebirge."
                            },
                            {
                                "example_id": "36c3c74b-2e56-4cbe-b96c-7fd977ef5627",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Der Apel trägt nie die Schals, die die Apel ihm strickt."
                            },
                            {
                                "example_id": "69406904-f44c-4304-afb8-6651ea9812ec",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Apel kommt, geht der Herr Apel.“"
                            },
                            {
                                "example_id": "866af4e0-9e22-400e-b742-902a9d1db94a",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Apel kommt und geht."
                            },
                            {
                                "example_id": "d3c1439f-1a51-4fe2-a285-262a7b193eda",
                                "sense_id": "a617a8c2-e168-3ac5-abc5-b9d97e83cd87",
                                "text": "Apels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
