            "senses": [
                {
                    "sense_id": "d5b817ec-36c4-3882-b1be-54f6b20fb133",
                    "sense_definition": "One of five equal parts of a whole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fraction",
                    "name_type": "no",
                    "examples": [
                        {
