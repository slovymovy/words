                "senses": [
                    {
                        "sense_id": "a8673f15-dbed-304a-923c-5f61c3507ee4",
                        "entry_id": "00369ec8-6539-357e-bfc7-00503ca20d44",
                        "glosses": [
                            "женск. к сообщник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0535fc80-fbcd-41ed-8c9c-ac1df56e16e6",
                                "sense_id": "a8673f15-dbed-304a-923c-5f61c3507ee4",
                                "text": "― Израиль Ильич пытался говорить спокойно. ― Она сообщница! Они все подстроили!"
                            },
                            {
                                "example_id": "78e45a12-6d78-4e26-9c58-41aa4872c00b",
                                "sense_id": "a8673f15-dbed-304a-923c-5f61c3507ee4",
                                "text": "― Потому, что он назвал вас в качестве своей сообщницы, ― изменил тон майор. ― Я ― его сообщница? В чем?"
                            }
                        ]
                    }
                ],
