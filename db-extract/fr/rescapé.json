            {
                "entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                "word": "rescapé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c763685-a185-4b28-bd68-438d9ca3866f",
                        "entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "rescapés"
                    },
                    {
                        "form_id": "b378eb4a-48dd-48c5-9870-3ee3bcc7b5fe",
                        "entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                        "tags": [
                            "feminine"
                        ],
                        "form": "rescapée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                        "entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                        "glosses": [
                            "Personne qui a échappé à un accident ou à un péril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd5b83e9-60a9-4e89-9b57-5aa094c1d3af",
                                "sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                                "text": "Un rescapé de mille embuscades, de la mort, du désastre obscur, cet autre nom de la folie."
                            },
                            {
                                "example_id": "043b163a-39da-42f0-95d5-a5a4afaa3d1e",
                                "sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                                "text": "Mais il existe une autre dimension au projet critique de Jules Isaac contre le « bourrage de crâne » : témoigner parce qu'il fit partie de ces rescapés marqués d'un sceau indélébile et unis par le sentiment commun d'avoir appartenu à la sombre cohorte des « revenants »."
                            },
                            {
                                "example_id": "7d13c346-5b48-44a1-a07f-6639f54ef9fb",
                                "sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                                "text": "Philippe Detobel, bouveleur au burquin (puits intérieur) creusé à 1100 m, fait partie des sept rescapés remontés par le puits de retour d'air le matin du 8 août dès le déclenchement de l'incendie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf3aa7ce-1222-4f6b-8c95-adee42591dc8",
                        "source_entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                        "source_sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                        "target_lang_word": "survivor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "One who survives, especially one who survives a traumatic experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db8ebe5-2b85-4588-9d06-f21942e0be8c",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "From this moment on, I choose to live not as a victim, but as a survivor."
                                            },
                                            {
                                                "example_id": "2cb27de0-239c-4de8-878b-4651667d2acc",
                                                "sense_id": "54954f96-ed6d-3ee8-91da-d5d0551aa1df",
                                                "text": "Believing that requires trust, and trust is understandably a tough issue for those of us who are survivors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f41446-e2c7-3420-831f-edd6021be7ae",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "A person who is able to endure hardship."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58f2fb7-e29c-41c1-8883-6c69f9bef6ae",
                                                "sense_id": "35f41446-e2c7-3420-831f-edd6021be7ae",
                                                "text": "I'm a survivor. We're a dying breed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64407244-0a72-37b3-a4b7-b63249389a3a",
                                        "entry_id": "b7f3cf55-bc23-3832-aa1a-be514c6c5b9d",
                                        "glosses": [
                                            "One who knew a specific decedent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a16208b-8edd-4871-b2b3-b61a9533fe5d",
                                                "sense_id": "64407244-0a72-37b3-a4b7-b63249389a3a",
                                                "text": "She was from a large family and had many friends, so the funeral was crowded with mourning survivors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0427bd5-fe30-4222-8c9a-3868a89d6724",
                        "source_entry_id": "a571eb31-8e5d-3c3a-9df6-da82aeafc2c8",
                        "source_sense_id": "917b84de-ac1f-3696-b9d3-5a4f4bd0ae9d",
                        "target_lang_word": "sobreviviente",
                        "target_lang_code": "es",
