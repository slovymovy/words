                        "glosses": [
                            "особый способ обучения правописанию, состоящий в том, что ученику дают списывать с рукописи, намеренно испещрённой ошибками, и заставляя его при этом исправлять их"
                        ],
                        "tags": [],
                        "examples": [
                            {
