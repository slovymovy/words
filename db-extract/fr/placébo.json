                        "entry_id": "e99862a0-7772-399e-a9f7-f7db25d1a40f",
                        "glosses": [
                            "Imitation de médicament sans principe actif, utilisée pour les tests en double aveugle ou pour son effet sur le psychisme de certains patients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ce112b-5389-4595-9c33-1560b8e5d66d",
                                "sense_id": "ce64d201-0104-3a02-863d-a85eca791542",
                                "text": "Découverte au fond nullement étonnante pour qui a déjà un peu travaillé la question : plus un placébo est cher, mieux il marche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbb1d394-2e8f-4b57-bae4-2bbd8e1a55c2",
                        "source_entry_id": "e99862a0-7772-399e-a9f7-f7db25d1a40f",
                        "source_sense_id": "ce64d201-0104-3a02-863d-a85eca791542",
                        "target_lang_word": "placebo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
