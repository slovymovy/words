{
    "word_family": [
        "desperately",
        "desperation",
        "despair"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d426da8-efa8-32b8-8005-1c3cf0a4f8e0",
                    "sense_definition": "Having a strong need or desire for something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "need_desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, we were <w>desperate</w> for water.",
                            "target_lang_translations": {
                                "ru": "После долгого похода мы <w>умирали</w> от жажды.",
                                "zh": "长途跋涉后，我们<w>急需</w>喝水。"
                            }
                        },
                        {
                            "text": "She is <w>desperate</w> to find a job before her savings run out.",
                            "target_lang_translations": {
                                "ru": "Она <w>готова на всё</w>, чтобы найти работу, пока не закончились её сбережения.",
                                "zh": "她<w>极度渴望</w>在积蓄用完前找到一份工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eager",
                        "dying",
                        "urgent"
                    ],
                    "antonyms": [
                        "indifferent",
                        "satisfied"
                    ],
                    "common_phrases": [
                        "desperate for",
                        "desperate to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сильную потребность или желание чего-либо.",
                        "zh": "指极度需要或渴望某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайне нуждающийся",
                                "target_lang_sense_clarification": "испытывающий острую необходимость"
                            },
                            {
                                "target_lang_word": "страстно желающий",
                                "target_lang_sense_clarification": "сильно хотящий чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极度渴望的",
                                "target_lang_sense_clarification": "非常想要某物"
                            },
                            {
                                "target_lang_word": "急需的",
                                "target_lang_sense_clarification": "处于极度缺乏状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc522b31-3345-319a-a1ed-6f1afb58b6b9",
                    "sense_definition": "Feeling hopeless and ready to do anything to change a bad situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>desperate</w> and alone after losing his home.",
                            "target_lang_translations": {
                                "ru": "Потеряв дом, он чувствовал себя <w>отчаявшимся</w> и одиноким.",
                                "zh": "失去家园后，他感到<w>绝望</w>且孤独。"
                            }
                        },
                        {
                            "text": "The refugees are in a <w>desperate</w> state and need immediate help.",
                            "target_lang_translations": {
                                "ru": "Беженцы находятся в <w>отчаянном</w> положении и нуждаются в немедленной помощи.",
                                "zh": "难民们处于<w>绝望</w>的境地，需要立即援助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hopeless",
                        "despairing",
                        "anguished"
                    ],
                    "antonyms": [
                        "hopeful",
                        "confident",
                        "content"
                    ],
                    "common_phrases": [
                        "feel desperate",
                        "become desperate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий безнадежность и готовый на всё, чтобы изменить плохую ситуацию.",
                        "zh": "感到绝望并准备不惜一切代价改变糟糕的处境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отча́явшийся",
                                "target_lang_sense_clarification": "потерявший надежду"
                            },
                            {
                                "target_lang_word": "доведённый до отчаяния",
                                "target_lang_sense_clarification": "в состоянии крайней безысходности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝望的",
                                "target_lang_sense_clarification": "失去希望的"
                            },
                            {
                                "target_lang_word": "孤注一掷的",
                                "target_lang_sense_clarification": "处于绝境而准备冒险"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50fcecd7-b9e2-3b0e-9926-d5df6d3d06bb",
                    "sense_definition": "Done with little hope and as a last resort; involving extreme measures.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors made a <w>desperate</w> attempt to save the patient's life.",
                            "target_lang_translations": {
                                "ru": "Врачи предприняли <w>отчаянную</w> попытку спасти жизнь пациента.",
                                "zh": "医生们进行了<w>拼命的</w>尝试以挽救病人的生命。"
                            }
                        },
                        {
                            "text": "Desperate times call for <w>desperate</w> measures.",
                            "target_lang_translations": {
                                "ru": "Отчаянные времена требуют <w>отчаянных</w> мер.",
                                "zh": "时局危急，需用<w>非常</w>手段。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drastic",
                        "frantic",
                        "last-ditch"
                    ],
                    "antonyms": [
                        "cautious",
                        "planned"
                    ],
                    "common_phrases": [
                        "desperate attempt",
                        "desperate measure",
                        "desperate effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершаемый с малой надеждой на успех, как крайняя мера.",
                        "zh": "因走投无路而采取的极端措施，成功希望渺茫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отча́янный",
                                "target_lang_sense_clarification": "рискованный, совершаемый от безысходности"
                            },
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "обреченный на неудачу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拼命的",
                                "target_lang_sense_clarification": "不顾一切的"
                            },
                            {
                                "target_lang_word": "孤注一掷的",
                                "target_lang_sense_clarification": "作为最后手段的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de13e3ac-85d7-37c2-8e14-5fc434f21b30",
                    "sense_definition": "Extremely serious, dangerous, or bad.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country is facing a <w>desperate</w> shortage of food and medicine.",
                            "target_lang_translations": {
                                "ru": "Страна сталкивается с <w>острой</w> нехваткой продовольствия и медикаментов.",
                                "zh": "该国正面临粮食和药品的<w>极度</w>短缺。"
                            }
                        },
                        {
                            "text": "They found themselves in a <w>desperate</w> situation with no way out.",
                            "target_lang_translations": {
                                "ru": "Они оказались в <w>безвыходном</w> положении.",
                                "zh": "他们发现自己陷入了<w>绝望的</w>境地，无路可走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dire",
                        "critical",
                        "grave"
                    ],
                    "antonyms": [
                        "safe",
                        "secure",
                        "stable"
                    ],
                    "common_phrases": [
                        "desperate situation",
                        "desperate shortage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно серьезный, опасный или плохой (о ситуации).",
                        "zh": "形容情况极其严重、危险或糟糕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "о ситуации"
                            },
                            {
                                "target_lang_word": "безвы́ходный",
                                "target_lang_sense_clarification": "не имеющий решения"
                            },
                            {
                                "target_lang_word": "крити́ческий",
                                "target_lang_sense_clarification": "очень серьезный (о нехватке, положении)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "危急的",
                                "target_lang_sense_clarification": "情况非常严重"
                            },
                            {
                                "target_lang_word": "绝望的",
                                "target_lang_sense_clarification": "指处境无望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69035a2b-5f27-3f34-914c-d6bf0a3d2bb2",
                    "sense_definition": "Extremely bad, shocking, or intolerable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot read his notes because his handwriting is absolutely <w>desperate</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу прочитать его записи, потому что у него совершенно <w>ужасный</w> почерк.",
                                "zh": "我没法读他的笔记，因为他的字迹简直<w>糟糕透顶</w>。"
                            }
                        },
                        {
                            "text": "The service at that restaurant was <w>desperate</w> last night.",
                            "target_lang_translations": {
                                "ru": "Обслуживание в том ресторане вчера вечером было <w>отвратительным</w>.",
                                "zh": "昨晚那家餐厅的服务<w>恶劣</w>至极。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "awful",
                        "dreadful"
                    ],
                    "antonyms": [
                        "excellent",
                        "wonderful"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in Irish or British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, шокирующий или невыносимый (разговорное).",
                        "zh": "极其糟糕、令人震惊或无法忍受（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сный",
                                "target_lang_sense_clarification": "очень плохой"
                            },
                            {
                                "target_lang_word": "отврати́тельный",
                                "target_lang_sense_clarification": "неприятный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕透顶的",
                                "target_lang_sense_clarification": "非常差的"
                            },
                            {
                                "target_lang_word": "恶劣的",
                                "target_lang_sense_clarification": "令人无法忍受的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd249b7e-238c-304e-a6d1-a4ab1b3095dd",
                    "sense_definition": "A person who is in a desperate situation or state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelter provided food for the poor and the <w>desperates</w> of the city.",
                            "target_lang_translations": {
                                "ru": "Приют предоставлял еду беднякам и <w>отчаявшимся</w> жителям города.",
                                "zh": "收容所为城里的穷人和<w>绝望者</w>提供了食物。"
                            }
                        },
                        {
                            "text": "He lived among the <w>desperates</w> who had lost everything in the war.",
                            "target_lang_translations": {
                                "ru": "Он жил среди <w>обездоленных</w>, потерявших всё на войне.",
                                "zh": "他生活在那些在战争中失去了一切的<w>走投无路的人</w>中间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся в отчаянном положении.",
                        "zh": "处于绝望境地的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отча́явшийся",
                                "target_lang_sense_clarification": "человек без надежды"
                            },
                            {
                                "target_lang_word": "обездо́ленный",
                                "target_lang_sense_clarification": "лишенный средств к существованию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝望者",
                                "target_lang_sense_clarification": "失去希望的人"
                            },
                            {
                                "target_lang_word": "走投无路的人",
                                "target_lang_sense_clarification": "陷入困境的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ddd44acc-f27b-35b6-bed3-4af4dce7f03b",
                    "sense_definition": "In a desperate manner; desperately.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>desperate</w> cold outside last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером на улице было <w>ужасно</w> холодно.",
                                "zh": "昨晚外面<w>极其</w>寒冷。"
                            }
                        },
                        {
                            "text": "He wanted to win <w>desperate</w> bad.",
                            "target_lang_translations": {
                                "ru": "Он <w>страшно</w> хотел победить.",
                                "zh": "他<w>非常</w>想赢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "desperately"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "non-standard usage; 'desperately' is the standard adverb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В отчаянной манере; очень сильно (просторечие).",
                        "zh": "以绝望的方式；非常地（非标准用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сно",
                                "target_lang_sense_clarification": "очень сильно"
                            },
                            {
                                "target_lang_word": "стра́шно",
                                "target_lang_sense_clarification": "в высшей степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "程度非常深"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "用于加强语气"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}