                            "singular",
                            "prepositional"
                        ],
                        "form": "све́е"
                    },
                    {
                        "form_id": "5b12c2f1-d988-4c37-b738-cd98a1880bd6",
                        "entry_id": "78603fa5-b395-346d-9a2c-fb64ef8cf5b6",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "све́ях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8113864c-9120-36d5-a416-59577f5f945d",
                        "entry_id": "78603fa5-b395-346d-9a2c-fb64ef8cf5b6",
                        "glosses": [
                            "истор. представитель древнего германского племени, населявшего центральную часть Швеции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a602e15c-901c-4309-8cd3-b3950cbdad62",
                                "sense_id": "8113864c-9120-36d5-a416-59577f5f945d",
                                "text": "Даны действительно грабили берега Пруссии еще пять лет назад, пока их не вытеснили свеи из Балтийского моря."
                            },
                            {
                                "example_id": "737564fd-9836-45db-a881-6cc2657c761e",
                                "sense_id": "8113864c-9120-36d5-a416-59577f5f945d",
                                "text": "По легенде, параллели которой можно найти у многих народов, древние свеи в период, когда время было недобрым для них, даже принесли в жертву своего вождя."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2513232-f2cd-3013-88b4-e1b7aa02c3ea",
                        "entry_id": "78603fa5-b395-346d-9a2c-fb64ef8cf5b6",
                        "glosses": [
                            "устар. то же, что швед"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33422c21-4291-47c2-b4c1-d48d62259822",
                                "sense_id": "e2513232-f2cd-3013-88b4-e1b7aa02c3ea",
                                "text": "… дело же православным сыновом российским радостное, неприятелем же нашым свеям всякаго сетования исполненное"
                            },
                            {
                                "example_id": "3c3df2b1-f288-4040-8e8a-27856ac60968",
                                "sense_id": "e2513232-f2cd-3013-88b4-e1b7aa02c3ea",
                                "text": "Честное Града всего Место, прежде многих веков победою преславною Святаго Благовернаго Великаго Князя Александра, Обладателя российскаго над Невою, свеев победившаго, и отсюду «Невским» именованнаго"
                            }
                        ]
                    }
                ],
