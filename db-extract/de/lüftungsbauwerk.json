                "senses": [
                    {
                        "sense_id": "74775c79-9b73-3c84-84f9-d8c1c0cec83d",
                        "entry_id": "c7cdb066-be5d-326e-9574-6d2fcd844870",
                        "glosses": [
                            "von Menschen gebauter, ortsfester Gegenstand ,der der Be- und Entlüftung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb5cce7-d9ce-45c8-b690-c72eddec8b98",
                                "sense_id": "74775c79-9b73-3c84-84f9-d8c1c0cec83d",
                                "text": "„Die Lüftungsbauwerke Nord sollen neben weiteren Funktionen- wie Betriebslüftung, Brandrauchlüftung- zur Entlüftung als Umweltschutzlüftung dienen, die durch ihre Typologie- dem umweltverträglichen Ausstoß der Tunnelluft- als Schutz von Mensch und Umwelt vor unzulässigen Emissionen im Umfeld der Tunnelportale sicherstellt.“"
                            },
                            {
                                "example_id": "fbc6a144-881d-4515-869d-197e389e8619",
                                "sense_id": "74775c79-9b73-3c84-84f9-d8c1c0cec83d",
                                "text": "„Ein Lüftungsbauwerk, das der Brandrauchentlüftung einer U-Bahn dient, ist eine Eisenbahnanlage (iSd § 10 EisbG) und daher baurechtlich nicht bewilligungspflichtig.“"
                            },
                            {
                                "example_id": "e6ed3343-c92a-4764-a823-5b84625558fc",
                                "sense_id": "74775c79-9b73-3c84-84f9-d8c1c0cec83d",
                                "text": "„Das Lüftungsbauwerk versorgt die Tunnelbaustelle mit Frischluft und wird nach Inbetriebnahme der Koralmbahn ein wichtiger Bestandteil des Koralmtunnels sein, das bei Störungen bzw. Wartungsarbeiten laufen wird.“"
                            },
                            {
                                "example_id": "0b4df503-0341-412c-9ba5-cd38910dd946",
                                "sense_id": "74775c79-9b73-3c84-84f9-d8c1c0cec83d",
                                "text": "„Der Kamin des Lüftungsbauwerks Tierspital wird aus gestalterischen Gründen mit sechseckigem statt kreisrundem Grundriss ausgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
