                    {
                        "translation_id": "e5836081-2c3f-407f-993f-62b2dab9fad8",
                        "source_entry_id": "ec1fb819-b2b7-3d34-96c7-3f1603915020",
                        "source_sense_description": "Celui principalement chargé de pourvoir au logement",
                        "target_lang_word": "Furier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Furier",
                                "target_lang_code": "de",
