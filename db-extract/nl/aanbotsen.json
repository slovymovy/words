{
    "word": "aanbotsen",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "8367e3cf-12b5-3ab1-8405-7e3f5d2aa9a5",
                "word": "aanbotsen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "224d9e55-e375-33aa-b98b-23fd6cb754fe",
                        "entry_id": "8367e3cf-12b5-3ab1-8405-7e3f5d2aa9a5",
                        "glosses": [
                            "met zoveel kracht ergens tegenaan stoten dat er ook een terugkaatsing ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16a398f-62ce-46c3-8e97-7156e0318f9d",
                                "sense_id": "224d9e55-e375-33aa-b98b-23fd6cb754fe",
                                "text": "Zolang deze signalen tegen stilstaande dingen aanbotsen, merkt de ontvanger dat ze gelijk zijn en is er niks aan de hand. Maar als de straling iets bewegends tegenkomt, wordt deze niet gelijkmatig teruggekaatst. Zo weet de ontvanger dat er een bewegend 'iets' aan de andere kant van de muur staat. Door vervolgens te berekenen hoe lang het duurt voor het signaal terug naar de ontvanger komt, kan ook berekend worden hoe ver de persoon achter de muur staat."
                            },
                            {
                                "example_id": "f4f77fb1-4003-4ee5-831a-e79d4681a276",
                                "sense_id": "224d9e55-e375-33aa-b98b-23fd6cb754fe",
                                "text": "De pinguïns lopen bovendien het risico te verdrinken als het stromende water in hun buitenverblijf bevriest. Ze weten niet wat ze moeten doen als ze naar boven willen en tegen ijs aanbotsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f566444-2871-4e24-8fbc-3829c5e58886",
                        "source_entry_id": "8367e3cf-12b5-3ab1-8405-7e3f5d2aa9a5",
                        "source_sense_id": "224d9e55-e375-33aa-b98b-23fd6cb754fe",
                        "source_sense_description": "met zoveel kracht ergens tegenaan stoten dat er ook een terugkaatsing ontstaat",
                        "target_lang_word": "collide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9fcdc9-5ccb-3a44-81a3-fa0e418a9d01",
                                        "entry_id": "7d7df22d-b767-3f69-8541-4cb60511cce5",
                                        "glosses": [
                                            "To impact directly, especially if violent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab08edf2-e90f-454b-9114-ea0a53aa85fc",
                                                "sense_id": "bf9fcdc9-5ccb-3a44-81a3-fa0e418a9d01",
                                                "text": "When a body collides with another, then momentum is conserved."
                                            },
                                            {
                                                "example_id": "97139b25-fa07-404f-ac93-d4922bc6c32d",
                                                "sense_id": "bf9fcdc9-5ccb-3a44-81a3-fa0e418a9d01",
                                                "text": "Across this space the attraction urges them. They collide, they recoil, they oscillate."
                                            },
                                            {
                                                "example_id": "8b68bf8a-d5dc-4d04-b594-8ef954bce159",
                                                "sense_id": "bf9fcdc9-5ccb-3a44-81a3-fa0e418a9d01",
                                                "text": "No longer rocking and swaying, but clashing and colliding."
                                            },
                                            {
                                                "example_id": "4ef148b5-d4cc-4752-8e1a-edd48ab1a376",
                                                "sense_id": "bf9fcdc9-5ccb-3a44-81a3-fa0e418a9d01",
                                                "text": "And this friendly was not without its injury worries, with defender Gary Cahill substituted early on after a nasty, needless push by Dries Mertens that caused him to collide with goalkeeper Joe Hart, an incident that left the Chelsea defender requiring a precautionary X-ray at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ce696e-962d-362e-b60e-deb70bedd587",
                                        "entry_id": "7d7df22d-b767-3f69-8541-4cb60511cce5",
                                        "glosses": [
                                            "To come into conflict, or be incompatible."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9868aa1-d647-4df6-92a8-2213760f55ad",
                                                "sense_id": "39ce696e-962d-362e-b60e-deb70bedd587",
                                                "text": "China collided with the modern world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20302cb7-2f9d-35e8-8add-debff23be9ca",
                                        "entry_id": "7d7df22d-b767-3f69-8541-4cb60511cce5",
                                        "glosses": [
                                            "To meet; to come into contact."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267c6cb2-5c1b-4b8c-8086-a0ffb7244d1d",
                                                "sense_id": "20302cb7-2f9d-35e8-8add-debff23be9ca",
                                                "text": "Out of the doubts that fill my mind / I somehow find, you and I collide"
                                            },
                                            {
                                                "example_id": "1157b47e-df66-48aa-bdbd-01409ee27b4d",
                                                "sense_id": "20302cb7-2f9d-35e8-8add-debff23be9ca",
                                                "text": "I knew when we collided / you're the one I have decided who's one of my kind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86e83ca-5daf-3c0d-ae79-42436cdfe354",
                                        "entry_id": "7d7df22d-b767-3f69-8541-4cb60511cce5",
                                        "glosses": [
                                            "To cause to collide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
