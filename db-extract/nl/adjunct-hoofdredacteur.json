                        "examples": [
                            {
                                "example_id": "9a1b959f-6279-4e25-9bf1-d058d74cc788",
                                "sense_id": "b6444117-eed8-3cd9-8d3c-614b53026a56",
                                "text": "Deze zomer nam VI opnieuw afscheid van een aantal redactieleden: de adjunct-hoofdredacteur (stapte zelf op), twee eindredacteuren, twee videomedewerkers en een vormgever. De huidige hoofdredacteur Christiaan Ruesink, op 1 mei 2016 aangetreden, ligt al geruime tijd onder vuur. Vanuit de redactie zijn meerdere moties van wantrouwen tegen hem ingediend."
                            },
                            {
                                "example_id": "2a9a78d7-c80b-4aef-a675-443be22c0076",
                                "sense_id": "b6444117-eed8-3cd9-8d3c-614b53026a56",
                                "text": "Tatjana Felgenhauer, de adjunct-hoofdredacteur van het Russische radiostation Echo of Moskou, is door een onbekende aanvaller in haar nek gestoken op haar werkplek in de Russische hoofdstad."
                            }
                        ]
                    }
