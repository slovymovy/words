                    {
                        "sense_id": "0d6bb89f-77cc-3dbe-bf74-89cba90feedd",
                        "entry_id": "3547e0ba-08fa-30b8-a9eb-2510960e3453",
                        "glosses": [
                            "sich nicht von seiner Vorrangstellung verdrängen lassend; unschlagbar, unangefochten, sattelfest, unersetzlich"
                        ],
                        "tags": [
