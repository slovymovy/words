                "senses": [
                    {
                        "sense_id": "fc61470b-ac86-3b88-a6b2-a9bdc39009d3",
                        "entry_id": "1225c5ea-0781-3c55-a1c1-6ecb2644de67",
                        "glosses": [
                            "unsichtbare UV-A-Strahlung, durch die fluoreszierende Stoffe sichtbar werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0bd48c-c225-4df7-90de-a7ecd98a003c",
                                "sense_id": "fc61470b-ac86-3b88-a6b2-a9bdc39009d3",
                                "text": "„Die Markierung ist für das normale Auge nicht erkennbar, sondern wird nur unter Schwarzlicht sichtbar.“"
                            },
                            {
                                "example_id": "3da2707b-7831-450f-8bb2-8bb136646039",
                                "sense_id": "fc61470b-ac86-3b88-a6b2-a9bdc39009d3",
                                "text": "„Im Haus leuchtet Maaßen mit Schwarzlicht, um jüngere Farbschichten zu entdecken, forscht klopfend nach Hohlräumen oder fährt mit dem Hand-Detektor die Wände ab.“"
                            },
                            {
                                "example_id": "278994c1-d261-465d-8e92-0d42e2d64846",
                                "sense_id": "fc61470b-ac86-3b88-a6b2-a9bdc39009d3",
                                "text": "„Am Eingang bekommt sie einen Stempel auf das Handgelenk, der nur unter Schwarzlicht sichtbar wird.“"
                            },
                            {
                                "example_id": "891528b5-6568-4164-9575-613541c5bb27",
                                "sense_id": "fc61470b-ac86-3b88-a6b2-a9bdc39009d3",
                                "text": "„Schwarzlicht zum Beispiel ist im Großen und Ganzen eine prima Sache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
