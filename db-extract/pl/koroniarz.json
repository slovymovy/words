                "senses": [
                    {
                        "sense_id": "6ed645b1-d849-328e-bf43-d5bc8bf9e3cd",
                        "entry_id": "4b3fd355-a781-3ee4-bf77-a4d999847729",
                        "glosses": [
                            "mieszkaniec Korony w Rzeczypospolitej Obojga Narodów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e75aa9-1842-46b8-9198-5954c73ba386",
                                "sense_id": "6ed645b1-d849-328e-bf43-d5bc8bf9e3cd",
                                "text": "A wyście to, koroniarze, nie podrwili pod Ujściem, a pod Wolborzem, a pod Sulejowem, a w dziesięciu innych miejscach?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "455af9ef-7ccb-3d82-8c61-9398b4963a63",
                        "entry_id": "4b3fd355-a781-3ee4-bf77-a4d999847729",
                        "glosses": [
                            "rasy hodowlane gołębia skalnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04080399-e999-4a99-9cc7-02da1c2ec040",
                                "sense_id": "455af9ef-7ccb-3d82-8c61-9398b4963a63",
                                "text": "Mamy tu również rasy ginące, jak koroniarz końcaty (to krakowska rasa, wyhodowana w XVIII wieku) i koroniarz sercaty"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5541f5ca-3c3c-3666-b16b-8b8a40659d1a",
                        "entry_id": "4b3fd355-a781-3ee4-bf77-a4d999847729",
                        "glosses": [
                            "zawodnik lub kibic klubu sportowego o nazwie, bądź symbolu, związanym z koroną"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
