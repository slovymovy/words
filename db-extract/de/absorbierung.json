                        "glosses": [
                            "Vorgang oder Ergebnis, etwas aufzunehmen/unschädlich zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c4dfe6-5ac9-4113-95df-ab4a744f38aa",
                                "sense_id": "82cf5612-69d9-3510-8eff-0423a4941915",
                                "text": "„Wie wird die Absorbierung des Lichtes durch das Melanin erreicht?“"
                            },
                            {
                                "example_id": "9c63c4df-1e95-4814-a463-830382acdf6a",
                                "sense_id": "82cf5612-69d9-3510-8eff-0423a4941915",
                                "text": "„Die Immissionswerte sagen aber nur etwas über die thermale Wirkung von elektromagnetischer Strahlung aus, tatsächlich jedoch gibt es keine gesicherten Erkenntnisse über die Absorbierung dieser Strahlung durch den menschlichen Organismus, nur Thesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86498daa-3db5-367f-840a-65fcbed2debc",
                        "entry_id": "5f022de1-efd8-38d2-a2be-5dfa5ab66c50",
