                                        "sense_id": "d7cbac0e-ded9-39e5-b9e4-c0a39757c4f1",
                                        "entry_id": "93b91ee9-d47a-33e0-897c-769c95385ea6",
                                        "glosses": [
                                            "The sides of a bastion perpendicular to the wall from which the bastion projects."
