                            },
                            {
                                "target_lang_word": "необычный",
                                "target_lang_sense_clarification": "не такой, как все; странный"
                            },
                            {
                                "target_lang_word": "уникальный",
                                "target_lang_sense_clarification": "единственный в своем роде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4e4487a8-47ca-3c15-9a79-ab0e91866c82",
                    "sense_definition": "in zeer sterke mate; buitengewoon",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "graad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het weer was vandaag <w>bijzonder</w> mooi voor de tijd van het jaar.",
                            "target_lang_translations": {
                                "en": "The weather was <w>particularly</w> beautiful today for the time of year.",
                                "ru": "Погода сегодня была <w>особенно</w> хорошей для этого времени года."
                            }
                        },
                        {
                            "text": "Zij is een <w>bijzonder</w> vrome vrouw die elke dag naar de kerk gaat.",
                            "target_lang_translations": {
                                "en": "She is an <w>exceptionally</w> pious woman who goes to church every day.",
                                "ru": "Она <w>чрезвычайно</w> набожная женщина, которая каждый день ходит в церковь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bijzonder goed",
                        "bijzonder veel",
                        "bijzonder mooi"
                    ],
                    "target_lang_definitions": {
