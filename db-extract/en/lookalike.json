                    },
                    {
                        "translation_id": "999f323f-2261-4457-a443-fd50724acbff",
                        "source_entry_id": "416cee0e-f11e-31da-a8b2-f14754090af0",
                        "source_sense_description": "person physically resembling another person",
                        "target_lang_word": "sosie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sosie",
