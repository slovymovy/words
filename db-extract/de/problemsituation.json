                        "examples": [
                            {
                                "example_id": "7082b49f-c945-458d-bf2e-5ed5aae47431",
                                "sense_id": "0e1c22ab-1c22-39d2-a2d9-93b8b34ea591",
                                "text": "Die Problemsituation war komplex."
                            },
                            {
                                "example_id": "64b34d96-bca0-4544-b012-fad7d2aba8b1",
                                "sense_id": "0e1c22ab-1c22-39d2-a2d9-93b8b34ea591",
                                "text": "Er wusste nicht, wie er aus dieser Problemsituation wieder herauskommen sollte."
                            },
                            {
                                "example_id": "17af0c3c-d5f2-4812-ada9-de6efdaaceb5",
                                "sense_id": "0e1c22ab-1c22-39d2-a2d9-93b8b34ea591",
                                "text": "Die regierenden Parteien haben die politische Problemsituation gut bewältigt."
                            },
                            {
                                "example_id": "0b857803-acf0-4fd6-a60d-57385526c290",
                                "sense_id": "0e1c22ab-1c22-39d2-a2d9-93b8b34ea591",
                                "text": "„Gäste müssen mit allen nur erdenklichen Problemsituationen rechnen, nur selber rudern brauchen sie nicht.“"
                            }
                        ],
