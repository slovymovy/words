        "nl-extract.jsonl": [
            {
                "entry_id": "438b9422-5655-32bd-b9aa-b093cdfad3df",
                "word": "mildheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5afdf30-9f20-3600-ba02-920a75cc1067",
                        "entry_id": "438b9422-5655-32bd-b9aa-b093cdfad3df",
                        "glosses": [
                            "het heel aardig, goedgeefs en vergevingsgezind zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "411ae565-3013-4b33-b0c0-49292c49c309",
                                "sense_id": "a5afdf30-9f20-3600-ba02-920a75cc1067",
                                "text": "Han ten Broeke zei ‘onmeunig trots’ te zijn dat hij het eerste exemplaar van ‘deze twee iconen’ mocht ontvangen. Het VVD-kamerlid ziet in het werk van Schulten vooral ‘mildheid’. ”En in deze tijd is er niet veel mildheid.” Maar het allermooiste , vind hij als geboren Tukker, is dat je in de schilderijen van Schulten ‘je eigen thuis herkent’. In zijn Haagse werkkamer is ook niet toevallig een zeefdruk van Schulten te vinden."
                            },
                            {
                                "example_id": "c13cfcac-e914-492e-a598-54b67362117d",
                                "sense_id": "a5afdf30-9f20-3600-ba02-920a75cc1067",
                                "text": "De week is een catharsis voor haar, waarin ze boete kan doen voor haar jaloerse gedrag tegenover haar overspelige echtgenoot. Zoveel mildheid verwacht je niet van een gothic novel. De hoofdpersoon wordt nergens écht bang gemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa46681f-35ae-4be0-9630-dac0e1a0a138",
                        "source_entry_id": "438b9422-5655-32bd-b9aa-b093cdfad3df",
                        "source_sense_id": "a5afdf30-9f20-3600-ba02-920a75cc1067",
                        "target_lang_word": "consideration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consideration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "276e22ad-f02a-3372-9280-074ab7cfc5d3",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "The thought process of considering, of taking multiple or specified factors into account (with of being the main corresponding adposition)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380187e0-a0df-40e1-9207-8e9d54b04093",
                                                "sense_id": "276e22ad-f02a-3372-9280-074ab7cfc5d3",
                                                "text": "After much consideration, I have decided to stay."
                                            },
                                            {
                                                "example_id": "edb5f48a-35a1-4edd-b0e7-8e9144283e4f",
                                                "sense_id": "276e22ad-f02a-3372-9280-074ab7cfc5d3",
                                                "text": "Consideration of environmental effects is needed when choosing material."
                                            },
                                            {
                                                "example_id": "ea94d094-7116-4259-98b0-af1ce321b9bf",
                                                "sense_id": "276e22ad-f02a-3372-9280-074ab7cfc5d3",
                                                "text": "In consideration of the day and hour of my birth, it was declared by the nurse, and by some sage women in the neighbourhood who had taken a lively interest in me several months before there was any possibility of our becoming personally acquainted, first, that I was destined to be unlucky in life; and secondly, that I was privileged to see ghosts and spirits; both these gifts inevitably attaching, as they believed, to all unlucky infants of either gender, born towards the small hours on a Friday night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942ae5ad-f654-34d4-9eb0-98add7bc7c5f",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "Something considered as a reason or ground for a (possible) decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6263b5b1-4727-453f-a8c4-f002c540698c",
                                                "sense_id": "942ae5ad-f654-34d4-9eb0-98add7bc7c5f",
                                                "text": "Speculations about the possible entire reconstruction of society give the intellectual fare much more to his taste than the more practical and short-run considerations of those who aim at a piecemeal improvement of the existing order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430138f2-d5bf-3a9d-9fb0-35ee3a639fb8",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "The tendency to consider others and make allowances for their needs or desires."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e25415-ed54-43de-acaf-a5f25a2305ba",
                                                "sense_id": "430138f2-d5bf-3a9d-9fb0-35ee3a639fb8",
                                                "text": "You showed remarkable consideration in giving up your place for your friend."
                                            },
                                            {
                                                "example_id": "31824eb6-1931-4115-af9f-e77d0f890bb3",
                                                "sense_id": "430138f2-d5bf-3a9d-9fb0-35ee3a639fb8",
                                                "text": "Will you noisy children show some consideration and stop your infernal screaming? I'm trying to study!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05fd9bc1-0c5e-3330-890c-67994998cce7",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "A payment or other recompense for something done."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc26213-8cc1-45f8-a06e-1d6cfdbc3435",
                                                "sense_id": "05fd9bc1-0c5e-3330-890c-67994998cce7",
                                                "text": "Sure I'll move my car, but only for a consideration."
                                            },
                                            {
                                                "example_id": "531f3ac9-4847-4807-9b4c-163eb3def19d",
                                                "sense_id": "05fd9bc1-0c5e-3330-890c-67994998cce7",
                                                "text": "A Malay here is proving helpful — Syed Omar, who says he's descended from Mohammed — and he's going to take us around. For a consideration, of course, but what the hell!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e798fb-a1e2-3678-b8be-41033f476be0",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "A matter of inducement for something promised; something valuable given as recompense for a promise, which causes the promise to become binding as a contract."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3351bb77-873b-445e-9cc9-6bfae09a86f3",
                                                "sense_id": "08e798fb-a1e2-3678-b8be-41033f476be0",
                                                "text": "Consideration is an intention to create legal relations."
                                            },
                                            {
                                                "example_id": "e24c48b3-93c0-48b9-bbf1-a3215d2e2bbc",
                                                "sense_id": "08e798fb-a1e2-3678-b8be-41033f476be0",
                                                "text": "In consideration of the performance of B's obligations hereunder, A hereby grants to B's personal license."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158cbc25-7946-3236-a33f-093be8c81a96",
                                        "entry_id": "46399614-a416-3c0c-88c7-b092a7cd34be",
                                        "glosses": [
                                            "Importance or regard; a claim to notice or attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0de12152-ad4e-4d50-98ed-064666219b02",
                                                "sense_id": "158cbc25-7946-3236-a33f-093be8c81a96",
                                                "text": "[...] settled down on a small property he had near Quimper to live for the rest of his days in peace; but the failure of an attorney left him suddenly penniless, and neither he nor his wife was willing to live in penury where they had enjoyed consideration."
                                            },
                                            {
                                                "example_id": "adbe7825-d0fd-4a04-bf2a-29f51a8619c6",
                                                "sense_id": "158cbc25-7946-3236-a33f-093be8c81a96",
                                                "text": "Since his findings are without a foundation in data and a sound analysis thereof, they are nothing but wild and empty claims and do not deserve consideration as a contribution to linguistic and historical studies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6d6150c-e64e-4e79-b87c-a53b7136a5ed",
                        "source_entry_id": "438b9422-5655-32bd-b9aa-b093cdfad3df",
                        "source_sense_id": "a5afdf30-9f20-3600-ba02-920a75cc1067",
                        "target_lang_word": "indulgence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indulgence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "The act of indulging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee05d9a9-f984-4c1a-a8d8-a49ec84897cd",
                                                "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                                "text": "will all they that either through indulgence to others or fondness to any sin in themselves, substitute for repentance any thing that is less than a sincere, uniform resolution of new obedience"
                                            },
                                            {
                                                "example_id": "b14d8dee-a0d7-4081-8145-c8373f116e66",
                                                "sense_id": "b2af7c62-bda0-37ab-b71e-b7ed04683c6d",
                                                "text": "As indulgence in several wives depended mainly on the length of a man's purse, the poor naturally contented themselves with monogamy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7b681e8-86fc-3c31-acee-e8997e9c5cf3",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "Tolerance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89d3b46-0bc9-38d9-9ef8-97458048ffdb",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "The act of catering to someone's every desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a710e722-cb7c-3cac-a1e7-0e586a5523e4",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "A wish or whim satisfied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43093d6-1e33-4e50-be4e-22342fce7cd7",
                                                "sense_id": "a710e722-cb7c-3cac-a1e7-0e586a5523e4",
                                                "text": "\"In other words, the ONLY indulgences we'll be getting for a while is fixing your wardrobe. This means no new manga. No new games. Nothing. Get used to it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f22bedd-f277-38ac-9c14-6cc28751430a",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "Something in which someone indulges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8704547-99df-43e7-9719-6bc46673ff5a",
                                                "sense_id": "6f22bedd-f277-38ac-9c14-6cc28751430a",
                                                "text": "I made but one error—giving way to petulance in the earlier instance; that lost me the Prince of Conti. Temper is bourgeois indulgence, though I own to a predilection for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29cdf0d8-2125-3ce1-989f-1678d0d3e10e",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "An indulgent act; a favour granted; gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a89188-b5a7-48f9-b7f3-b6d5568afcf1",
                                                "sense_id": "29cdf0d8-2125-3ce1-989f-1678d0d3e10e",
                                                "text": "If all these gracious indulgences are without any effect on us, we must perish in our own folly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23177a1f-32af-30bd-84e0-bb4c74d19799",
                                        "entry_id": "5fc04c75-22ed-3dde-ba4a-6f92c97872df",
                                        "glosses": [
                                            "A pardon or release from the expectation of punishment in purgatory, after the sinner has been granted absolution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "237ec1c2-ae11-4ed7-a891-a5207bdb02b6",
                                                "sense_id": "23177a1f-32af-30bd-84e0-bb4c74d19799",
                                                "text": "To understand how indulgences were intended to work depends on linking together a number of assumptions about sin and the afterlife, each of which individually makes considerable sense."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indulgence",
                                "target_lang_code": "en",
                                "target_senses": [
