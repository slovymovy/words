                "senses": [
                    {
                        "sense_id": "bb4f4850-4fc9-3c34-995a-998c421ded19",
                        "entry_id": "08cbf5bd-13a3-3901-b3e9-4d5f70e1641a",
                        "glosses": [
                            "Désigne un élément chimique qui accepte trois liaisons chimiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4ac345-674a-49ee-8645-473d577a994c",
                                "sense_id": "bb4f4850-4fc9-3c34-995a-998c421ded19",
                                "text": "L’ion aluminium Al³⁺ est un cation trivalent."
                            },
                            {
                                "example_id": "0d5172f3-50ee-4e24-b927-aea0ff3b47c3",
                                "sense_id": "bb4f4850-4fc9-3c34-995a-998c421ded19",
                                "text": "Dans le cas d'impuretés trivalentes, c'est le contraire qui se produit : il manque un électron de liaison, autrement dit, il existe dans le réseau cristallin une place non occupée, un trou."
                            }
                        ]
                    },
                    {
                        "sense_id": "c03992c9-be26-3a7c-a43c-bc8daf1d8dd0",
                        "entry_id": "08cbf5bd-13a3-3901-b3e9-4d5f70e1641a",
                        "glosses": [
                            "Qui considère trois valeurs de vérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e2df9e-2305-4ae8-8b87-38f289fc0122",
                                "sense_id": "c03992c9-be26-3a7c-a43c-bc8daf1d8dd0",
                                "text": "Une logique trivalente."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac9d814b-4f2a-3349-81a9-237a2d51a7a4",
                        "entry_id": "08cbf5bd-13a3-3901-b3e9-4d5f70e1641a",
                        "glosses": [
                            "Désigne un verbe qui demande trois actants, exprimés ou sous-entendus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a96622-c29a-4d61-bdd9-5ca29a97959c",
                                "sense_id": "ac9d814b-4f2a-3349-81a9-237a2d51a7a4",
                                "text": "Ainsi la notion DONNER est « trivalente » car elle implique trois arguments (agent-donateur, patient-bénéficiaire, objet du don), la notion PORTER est « tétravalente », en impliquant quatre (agent, objet, lieu de départ, lieu d’arrivée)."
                            }
                        ]
                    },
                    {
                        "sense_id": "9da9f298-f3ef-3ddd-8a7d-3ad6f6ecef15",
                        "entry_id": "08cbf5bd-13a3-3901-b3e9-4d5f70e1641a",
                        "glosses": [
                            "Qui comprend trois sérotypes de l’agent infectieux, en parlant d’un vaccin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2729c03-3487-3a11-8e40-871ea3b673d9",
                        "entry_id": "08cbf5bd-13a3-3901-b3e9-4d5f70e1641a",
                        "glosses": [
                            "Se dit de chromosomes présents en trois copies. Désigne l’arrangement des trois homologues chromosomaux lors de leur appariement méiotique chez un triploïde ou trisomique."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": []
                    }
