                "senses": [
                    {
                        "sense_id": "bb092b3c-3b72-3912-a34d-db5bac8c3822",
                        "entry_id": "3525aa0e-732a-3430-87f6-8a2b0848680f",
                        "glosses": [
                            "To roar; to bellow."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "598ec124-4e09-45b7-8e47-d3f27d2f95ae",
                                "sense_id": "bb092b3c-3b72-3912-a34d-db5bac8c3822",
                                "text": "Great Whales ſhall rummiſh, rout and rair,\nWhoſe Sound redound ſhall in the Air,\nAll Fiſh and Monſters marvellous,\nShall cry with Sounds odious."
                            },
                            {
                                "example_id": "2c041254-9f51-4781-9dc5-46720724fd66",
                                "sense_id": "bb092b3c-3b72-3912-a34d-db5bac8c3822",
                                "text": "With brangle of lights doth bark, doth whiſle,\nAnd route doth euermore,\nMake murmuring, loudlie howle and bray,\nAnd rummiſh faſt and rore."
                            },
                            {
                                "example_id": "29f49888-5507-4dc8-87f5-8baace80cb1c",
                                "sense_id": "bb092b3c-3b72-3912-a34d-db5bac8c3822",
                                "text": "And therefore as a valiant Captaine, affraies no more being at the combat, nor ſtayes from his purpoſe for the rummiſhing ſhot of a Cannon, nor the ſmall clack of a Piſtolet : […]"
                            }
                        ]
                    }
