                "senses": [
                    {
                        "sense_id": "03422b9c-6451-3f59-ad5f-9b51f96da7d5",
                        "entry_id": "44cbd1c0-1c7d-3fe7-8c62-ec1ed378d62b",
                        "glosses": [
                            "die Theologie nach oder gemäß den Kirchenvätern, die sich meist direkt von der Bibel ableitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3083a280-54ce-47c3-843a-97603414c8a6",
                                "sense_id": "03422b9c-6451-3f59-ad5f-9b51f96da7d5",
                                "text": "„So ist in der Übergänglichkeit zwischen Person und Gemeinschaft […] schon das Ineinander von Maria und Kirche vorweggenommen, das sich dann in der Vätertheologie allmählich entwickelt“"
                            },
                            {
                                "example_id": "885038a1-7a25-40ea-9036-80d6b578c1c5",
                                "sense_id": "03422b9c-6451-3f59-ad5f-9b51f96da7d5",
                                "text": "\"Die Vätertheologie ist ganz generell nicht durch die Sorge um organischen Lehraufbau charakterisiert. Quelle der Vätertheologie ist die Schrift; der Großteil der Väterschriften besteht aus Schriftkommentaren … und Homilien … Daneben sind drei formale Methoden für die Vätertheologie typisch.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
