                {
                    "sense_id": "92af3156-816e-332f-a1cb-a1acb459483b",
                    "sense_definition": "Форма сравнительной степени наречия <w>коротко</w>; более кратко, с меньшими подробностями.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparative_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, пиши <w>короче</w>, у меня нет времени читать длинные письма.",
                            "target_lang_translations": {
                                "en": "Please write <w>more briefly</w>, I don't have time to read long letters.",
                                "es": "Por favor, escribe <w>más brevemente</w>, no tengo tiempo de leer cartas largas.",
                                "fr": "S'il te plaît, écris <w>plus brièvement</w>, je n'ai pas le temps de lire de longues lettres."
                            }
                        },
                        {
                            "text": "Парикмахер постриг меня слишком <w>короче</w>, чем я просил.",
                            "target_lang_translations": {
                                "en": "The hairdresser cut my hair much <w>shorter</w> than I asked.",
                                "es": "El peluquero me cortó el pelo mucho <w>más corto</w> de lo que pedí.",
                                "fr": "Le coiffeur m'a coupé les cheveux beaucoup <w>plus court</w> que ce que j'avais demandé."
                            }
                        }
                    ],
                    "synonyms": [
                        "более кратко"
                    ],
                    "common_phrases": [
                        "стричь короче",
                        "говорить короче"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative form of the adverb 'shortly'; more briefly, with fewer details.",
                        "es": "Forma comparativa del adverbio 'brevemente'; de manera más breve, con menos detalles.",
                        "fr": "Forme comparative de l'adverbe 'brièvement' ; plus brièvement, avec moins de détails."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more briefly",
                                "target_lang_sense_clarification": "speaking or writing"
                            },
                            {
                                "target_lang_word": "shorter",
                                "target_lang_sense_clarification": "colloquial adverb"
                            },
                            {
                                "target_lang_word": "more concisely",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "más brevemente",
                                "target_lang_sense_clarification": "hablar o escribir"
                            },
                            {
                                "target_lang_word": "más corto",
                                "target_lang_sense_clarification": "adverbio coloquial"
                            },
                            {
                                "target_lang_word": "más concisamente",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plus brièvement",
                                "target_lang_sense_clarification": "pour parler ou écrire"
                            },
                            {
                                "target_lang_word": "plus court",
                                "target_lang_sense_clarification": "usage adverbial familier"
                            }
                        ]
                    }
                }
