                                        "glosses": [
                                            "unstillbar hungrig, nicht satt zu bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415e706c-a46d-4ad2-921d-fd2c6e4a5785",
                                                "sense_id": "5ce70be2-a38f-312f-89b0-01180344366c",
                                                "text": "Die unersättlichen Hyänen hatten das Aas in kürzester Zeit verschlungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed5a70da-2102-37bc-8fff-5927a0cac6af",
