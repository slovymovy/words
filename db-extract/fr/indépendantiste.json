                ],
                "senses": [
                    {
                        "sense_id": "537e21c9-7595-3793-8781-481a8ff7d880",
                        "entry_id": "ab988a9f-0d2b-3bab-b65f-c91fd72433c8",
                        "glosses": [
                            "Partisan de l’indépendance politique d'un territoire rattaché à un pays ou à une confédération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1561dd5a-e497-458a-89e2-f32fc66beef7",
                                "sense_id": "537e21c9-7595-3793-8781-481a8ff7d880",
                                "text": "L'accord conclu sous l'égide d’Ahtisaari entre le gouvernement de Djakarta et les indépendantistes du Mouvement Aceh libre (GAM) a mis fin à un conflit fatal à plus de 15 000 personnes."
                            },
                            {
                                "example_id": "31ab8a7d-7a9f-4f34-9b50-d098ecacc84c",
                                "sense_id": "537e21c9-7595-3793-8781-481a8ff7d880",
                                "text": "Mais Oscar Temaru est-il autre chose qu’un indépendantiste de papier, dont Gaston Flosse s’est beaucoup servi ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "48d2d715-5402-3554-a4e6-427ae97f41c4",
                        "entry_id": "ab988a9f-0d2b-3bab-b65f-c91fd72433c8",
                        "glosses": [
                            "Partisan de l’indépendance politique du Québec par rapport à la fédération canadienne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "546a0184-3cea-4750-99c6-e76262596bd2",
                                "sense_id": "48d2d715-5402-3554-a4e6-427ae97f41c4",
                                "text": "Au demeurant, il incombe à chaque indépendantiste de faire son propre examen de conscience. Le plus important est-il la création du pays du Québec ou le parti et le chef qui nous y mèneront ?"
                            },
                            {
                                "example_id": "ef6323cb-b2c8-4000-85a9-a5a8fe202cd5",
                                "sense_id": "48d2d715-5402-3554-a4e6-427ae97f41c4",
                                "text": "Pour beaucoup, le pays réel l’est moins que le pays rêvé, celui que chantent les poètes et appellent de leurs vœux les indépendantistes."
                            }
                        ]
                    }
                ],
