                        "examples": [
                            {
                                "example_id": "21820a08-6380-47e4-b059-73141d91183b",
                                "sense_id": "6eb1af04-a6ad-3f33-b18c-b7cb092d1550",
                                "text": "La Luftwaffe dispose aussi avec les Focke-Wulf Fw 200 Condor d’excellents patrouilleurs-bombardiers à long rayon d'action."
                            },
                            {
                                "example_id": "20bc3860-3eab-4f0e-96e4-cb1173b7ec9f",
                                "sense_id": "6eb1af04-a6ad-3f33-b18c-b7cb092d1550",
                                "text": "Pas n’importe quel pilote d’avion : l’un des plus jeunes, par exemple, à être qualifié pour piloter l’un des derniers hydravions PBY Catalina opérationnels, un patrouilleur-bombardier vétéran de la Seconde Guerre mondiale."
                            },
                            {
                                "example_id": "ccfb99c7-cf4b-44f3-a468-7c177d1fb20c",
                                "sense_id": "6eb1af04-a6ad-3f33-b18c-b7cb092d1550",
                                "text": "En effet, le Lodestar était une évolution de l'avion de ligne léger Electra, qui servit également de base aux patrouilleurs-bombardiers Hudson."
                            }
                        ]
