                "forms": [],
                "senses": [
                    {
                        "sense_id": "aef1748d-9ed8-37ad-b1a3-91e3f20ef0f8",
                        "entry_id": "c40e34d9-6332-3ca4-a588-7bd7bc95918c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672fe61f-f009-446f-b305-f975c33d2b3a",
                                "sense_id": "aef1748d-9ed8-37ad-b1a3-91e3f20ef0f8",
                                "text": "Une dernière remarque : en cette année où les personnes âgées ont été humiliées, négligées, rabaissées et décimées, était-ce vraiment pertinent de faire un segment au complet avec France Castel, Micheline Lanctôt et Jacques Lheureux pour ridiculiser les aînés ?"
                            },
                            {
                                "example_id": "3b81a2d2-03ba-438b-bace-dbf506fea7fe",
                                "sense_id": "aef1748d-9ed8-37ad-b1a3-91e3f20ef0f8",
                                "text": "Quand est-ce qu’on va chez Castel ?"
                            },
                            {
                                "example_id": "f3fff158-557b-4ca6-a39b-5053b8b50623",
                                "sense_id": "aef1748d-9ed8-37ad-b1a3-91e3f20ef0f8",
                                "text": "En 1980, Yves-Pascal Castel citait le monument dans son Atlas des croix et calvaires du Finistère."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cb3038ca-b155-3399-b771-d2d22e8c3f23",
