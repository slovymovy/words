                        "examples": [
                            {
                                "example_id": "5b9501e6-0037-4244-9554-a17bace811a4",
                                "sense_id": "bb57a527-cba5-30dc-9be5-ba2b120ef996",
                                "text": "Gilze-Rijen is de helikopterbasis van de Koninklijke Luchtmacht. Er staan onder meer gevechts- en transporthelikopters gestationeerd."
                            },
                            {
                                "example_id": "d8d0516a-861a-4917-af15-21dce2d7a54c",
                                "sense_id": "bb57a527-cba5-30dc-9be5-ba2b120ef996",
                                "text": "Volgens Defensie zijn de extra oefeningen in het donker nodig. De kortgedingrechter zette daar vraagtekens bij, maar gaf de helikopterbasis het voordeel van de twijfel, waardoor de oefeningen kunnen doorgaan."
                            }
                        ]
