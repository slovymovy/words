                ],
                "senses": [
                    {
                        "sense_id": "5b006598-e412-329e-b614-e5a112da4ded",
                        "entry_id": "47f3a2f3-5194-36ce-ba7b-81af1be0bba0",
                        "glosses": [
                            "Tomber sous le vent de la côte ou du port que l'on se proposait d'atteindre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b13fe2b0-4e20-31ee-85f1-1e2c088a7b05",
                        "entry_id": "47f3a2f3-5194-36ce-ba7b-81af1be0bba0",
                        "glosses": [
                            "Dévier notablement un bateau de sa course, entravant ainsi partiellement ou totalement sa manœuvrabilité, en parlant de l'action du vent ou du courant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35573726-ef2f-4011-92a8-6a48937b5e37",
                                "sense_id": "b13fe2b0-4e20-31ee-85f1-1e2c088a7b05",
                                "text": "Se faire dépaler vers une côte."
                            },
                            {
                                "example_id": "1bb8881c-a6c6-418f-b8fc-0da7b00720bf",
                                "sense_id": "b13fe2b0-4e20-31ee-85f1-1e2c088a7b05",
                                "text": "Le vent nous dépalait fortement vers les rochers."
                            },
                            {
                                "example_id": "a7312f31-15ba-435a-9a7b-24e40b522665",
                                "sense_id": "b13fe2b0-4e20-31ee-85f1-1e2c088a7b05",
                                "text": "Depuis 24 heures qu’on voit à peine le gaillard, avec les courants, on a dû dépaler."
                            }
                        ]
                    }
