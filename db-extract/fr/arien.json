                ],
                "senses": [
                    {
                        "sense_id": "7bd644f7-d3c4-3018-a0d0-282c1e7b92a7",
                        "entry_id": "df7ccf29-5607-3506-9a0c-086882dbcecd",
                        "glosses": [
                            "Relatif à l’arianisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f52f51-59aa-440e-a338-7b119a1dbd2a",
                                "sense_id": "7bd644f7-d3c4-3018-a0d0-282c1e7b92a7",
                                "text": "Un prince, un évêque arien."
                            },
                            {
                                "example_id": "e3418780-02d6-4c17-acc8-77886d7606f3",
                                "sense_id": "7bd644f7-d3c4-3018-a0d0-282c1e7b92a7",
                                "text": "Il faut savoir aussi, et on l'a souvent souligné, que ce baptême de Clovis, roi franc au nom germanique, n'a pas seulement décidé de l'engagement de la Gaule, puis de la France, dans le camp de l'Église; mais il a marqué aussi la victoire définitive du catholicisme sur les cultes anciens de divinités païennes, ainsi que sur l'hérésie arienne dans l'Occident tout entier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc2c2e3a-6e50-43e4-8480-357448f26ddc",
                        "source_entry_id": "df7ccf29-5607-3506-9a0c-086882dbcecd",
                        "source_sense_id": "7bd644f7-d3c4-3018-a0d0-282c1e7b92a7",
                        "target_lang_word": "ariánský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ariánský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9cd600-688a-3c13-9ad8-b4bd803ac76b",
                                        "entry_id": "29141c88-5acf-30bf-b8a5-9a0149cc6c02",
                                        "glosses": [
                                            "vztahující se k Areiovi či ke křesťanskému teologickému směru jím založenému"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48df218f-e008-4077-8602-ab2fb35c11b3",
                                                "sense_id": "eb9cd600-688a-3c13-9ad8-b4bd803ac76b",
                                                "text": "Najprvé jakož píše mistr Euzebius a řka, že když jeden kacieř ariánského bludu dietě křtil a pravého řádu osob svaté trojice nejmenoval, než řekl: »Křtím tě ve jmě ducha svatého otce«, tehda inhed voda křtitedlná zmizala."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
