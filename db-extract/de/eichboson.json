                ],
                "senses": [
                    {
                        "sense_id": "b344c6fb-4c82-36fd-8fbf-37190d6b6078",
                        "entry_id": "9d65b8aa-b5c3-3c5a-ae8f-34f13b596184",
                        "glosses": [
                            "Elementarteilchen, das die Grundkräfte der Physik (fundamentale Wechselwirkungen) vermittelt, indem es von einem Teilchen ausgesandt und von einem anderen empfangen wird"
                        ],
                        "tags": [
                            "Teilchenphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "7696b321-c841-4325-b16a-c7663194a706",
                                "sense_id": "b344c6fb-4c82-36fd-8fbf-37190d6b6078",
                                "text": "„Im Standardmodell existieren zwölf Teilchen und zwölf Antiteilchen, welche in Leptonen und Quarks unterteilt werden. Die Kräfte, welche zwischen diesen Teilchen wirken, werden durch den Austausch von Eichbosonen vermittelt.“"
                            },
                            {
                                "example_id": "37771cbb-4a08-40a3-a271-4e53c8691ef4",
                                "sense_id": "b344c6fb-4c82-36fd-8fbf-37190d6b6078",
                                "text": "„In der Quantenelektrodynamik gehört das Photon als Vermittler der elektromagnetischen Wechselwirkung zu den Eichbosonen.“"
                            },
                            {
                                "example_id": "20a4e9dc-a7d9-4088-b647-f752efb7a7db",
                                "sense_id": "b344c6fb-4c82-36fd-8fbf-37190d6b6078",
                                "text": "„Dies hat für die Vakuumpolarisation eine wichtige Konsequenz: Das Eichboson der QCD, das Gluon, kann nicht nur in ein Quark und ein Antiquark dissoziieren, sondern auch in zwei Gluonen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
