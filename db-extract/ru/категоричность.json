                "senses": [
                    {
                        "sense_id": "d0b1eb8d-60c8-3416-b21f-af8d0d1eab52",
                        "entry_id": "95d37643-bd5c-337e-9142-06e214ddcf80",
                        "glosses": [
                            "свойство по значению прилагательного категоричный; решительность, уверенность (в высказывании, формулировке, суждении и т. п.), не допускающая возражений, иных толкований"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80825dd-dfeb-4cd3-b3fa-bf426997f3c1",
                                "sense_id": "d0b1eb8d-60c8-3416-b21f-af8d0d1eab52",
                                "text": "Категоричность телефонограммы напоминала мне ультиматум, с которым обращаются к коменданту вражеской крепости, требуя сдачи, иначе будет штурм и город отдадут на разграбление."
                            }
                        ]
                    }
                ],
