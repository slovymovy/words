                "senses": [
                    {
                        "sense_id": "a61ea072-3e2e-34d4-ba6a-812add27bf78",
                        "entry_id": "84826637-4cba-3abe-a5d3-c430cb775c6f",
                        "glosses": [
                            "Donner un caractère soudanais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3782a973-60cc-4a0f-ae1b-5f4f81c056d9",
                                "sense_id": "a61ea072-3e2e-34d4-ba6a-812add27bf78",
                                "text": "Qu'est-ce que fait croire aux Haïtiens qu'Haïti ne peut pas être rwandatisé, sierraléonisé, soudanisé, etc?"
                            },
                            {
                                "example_id": "de801c45-7431-482e-9194-e46cca8a6e9f",
                                "sense_id": "a61ea072-3e2e-34d4-ba6a-812add27bf78",
                                "text": "Après l’indépendance, la politique nationale s’est attachée à « soudaniser » le pays, ce qui sous-entendait une réduction de la multiplicité ethnique et linguistique."
                            },
                            {
                                "example_id": "66ab75db-8092-4877-8ff4-ac102d5b8639",
                                "sense_id": "a61ea072-3e2e-34d4-ba6a-812add27bf78",
                                "text": "Un comité mixte anglo-soudanais est mis en place pour « soudaniser » l’administration."
                            }
                        ]
                    }
