                    {
                        "form_id": "011ea505-e9f1-439b-971b-742ac8abfe1d",
                        "entry_id": "a80f1563-fbec-30aa-b1c8-dba3ec968e5b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Schlapphut"
                    },
                    {
                        "form_id": "fed6ec3e-4508-4b1c-82ef-ca3365339b7b",
                        "entry_id": "a80f1563-fbec-30aa-b1c8-dba3ec968e5b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schlapphüte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                        "entry_id": "a80f1563-fbec-30aa-b1c8-dba3ec968e5b",
                        "glosses": [
                            "Hut aus weichem Material mit unfestem Kopfteil und gewellter Krempe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a1dd36-b99c-4fa9-b4dd-863f72832548",
                                "sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                                "text": "„Val und Rosa zogen sich Schlapphüte über den Kopf, die einen Großteil ihrer Gesichter verbargen.“"
                            },
                            {
                                "example_id": "84290763-c79a-4b5f-b666-9d3a130ded05",
                                "sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                                "text": "„Die Kunstgeschichte hat ihn zwar (nicht ganz grundlos) mit Mißachtung gestraft, aber der damals 33jährige – mit großer Künstlerschleife und einem breiten Schlapphut als Bohemien durch die Stadt bummelnd – war für seine jugendlichen Bewunderer offenbar eine charismatische Persönlichkeit.“"
                            },
                            {
                                "example_id": "2d1db267-15b5-4fcf-984c-e6925669390d",
                                "sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                                "text": "„Ich schaue in sein munteres Gesicht, das rot und naß vom Regen unter dem Schlapphut leuchtet.“"
                            },
                            {
                                "example_id": "42841198-5940-4f95-a862-4f3c3c52cf82",
                                "sense_id": "c622b30b-07b5-35cf-bc77-5897b8a61376",
                                "text": "„‚Das behalte ich für mich‘, sagte Stiller und fügte hinzu: ‚Ein Schlapphut nimmt seinen Schlapphut nie ab‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc524b94-7ee2-316f-9c70-1224df44e4fc",
                        "entry_id": "a80f1563-fbec-30aa-b1c8-dba3ec968e5b",
                        "glosses": [
                            "Person, die sich mit [1] tarnt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "13e6b77d-1334-4ff7-8321-f595329eed34",
                                "sense_id": "fc524b94-7ee2-316f-9c70-1224df44e4fc",
                                "text": "„‚Das behalte ich für mich‘, sagte Stiller und fügte hinzu: ‚Ein Schlapphut nimmt seinen Schlapphut nie ab‘.“"
                            },
                            {
                                "example_id": "80455df3-8b56-423e-bd1f-da14e1f62aa3",
                                "sense_id": "fc524b94-7ee2-316f-9c70-1224df44e4fc",
                                "text": "„Die Agentenjäger des FBI hätten die Spur aufgenommen, nicht nur gewöhnliche Schlapphüte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
