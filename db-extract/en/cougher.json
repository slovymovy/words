                            "plural"
                        ],
                        "form": "coughers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
                        "entry_id": "9ffba827-9b36-326b-bddb-1fbc31480f52",
                        "glosses": [
                            "A person who coughs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620aad49-104e-4423-b887-3dbcd12c19a1",
                                "sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
                                "text": "A frequent cougher in a church sets nearly the whole congregation to coughing."
                            },
                            {
                                "example_id": "f2aaab08-776f-42e9-a727-e09a8010d870",
                                "sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
                                "text": "The widow turned her usually unemotional face to the cougher, and the concern on her countenance showed that the innuendo of the reverend alarmist had reached even her. But the organist's pretty eyes had forestalled her, and the glance she sent to the cougher said plainly: 'You want my care and attention.'"
                            },
                            {
                                "example_id": "0b091d7e-0bdb-4724-8ef8-d2178a37b2fe",
                                "sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
                                "text": "In New York and Chicago, laws were passed making it illegal to sneeze or cough in public without using a handkerchief. Police dutifully hauled sneezers and coughers to court, where they were given stiff fines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77dd0703-6c85-49bd-85a6-93f6cb781aa5",
                        "source_entry_id": "9ffba827-9b36-326b-bddb-1fbc31480f52",
                        "source_sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
                        "source_sense_description": "person who coughs",
                        "target_lang_word": "tousseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tousseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                        "entry_id": "d79fa0c0-adee-324c-bcbb-fb91c3eb4834",
                                        "glosses": [
                                            "Celui qui tousse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83aa8a9a-bd2f-4649-9f22-ae0d0d7033fc",
                                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                                "text": "Rien n’est aussi insupportable au théâtre que les tousseurs."
                                            },
                                            {
                                                "example_id": "1a4b9f6f-9a16-4dfd-8f13-2eb6eeaa9395",
                                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                                "text": "— Ferme la fenêtre ! crièrent dix élèves. On va crever. C’est dégueulasse… J’claque des dents…\nTandis que des tousseurs se déchaînaient."
                                            },
                                            {
                                                "example_id": "be0f3aff-3966-493f-835d-26db82855032",
                                                "sense_id": "df71b43b-2e53-3559-90a2-e679006a5fa5",
                                                "text": "C'était une famille de tousseurs. Le père, Jacques, toussait, et tous les enfants, avec des intensités variables, toussaient. Ils toussaient tous au moindre rhume, au moindre coup de froid. Au mieux de leur forme, ils toussaient aussi : avant le café, après une promenade, devant une salade de carottes. Tous les douze, treize, quatorze enfants toussaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81036cb9-03e1-4e97-894b-62b5ee8c48f0",
                        "source_entry_id": "9ffba827-9b36-326b-bddb-1fbc31480f52",
                        "source_sense_id": "9f42517c-2def-3b82-aba0-05541dfe2d64",
