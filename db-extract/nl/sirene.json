                ],
                "translations": [
                    {
                        "translation_id": "ffcb3e0c-4ba4-419d-8a72-6a171d651566",
                        "source_entry_id": "aab02822-2636-39ec-be4b-e9b16f2ab729",
                        "source_sense_id": "3c18294a-32fd-3899-826d-cd9c55cd6f93",
                        "source_sense_description": "een toestel om een akoestisch alarmsignaal weer te geven",
                        "target_lang_word": "Sirene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sirene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                                        "entry_id": "52c431bc-89d0-3708-8b1a-964efaa48996",
                                        "glosses": [
                                            "ein weibliches Fabelwesen, das mit seinem Gesang Seefahrer anlockt, um sie zu töten"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a95b16-737d-4482-a02d-9990aac25024",
                                                "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                                                "text": "Odysseus konnte den Sirenen entkommen."
                                            },
                                            {
                                                "example_id": "97e2dfbd-433e-49fe-b637-597946579d20",
                                                "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                                                "text": "„Zur gleichen Zeit gab es noch die Sirenen, Meerjungfrauen, die im Wasser lebten, mit süßer Stimme sangen und Matrosen dazu brachten, über Bord zu springen, ohne sich auszuziehen.“"
                                            },
                                            {
                                                "example_id": "ec3275d9-31c8-43eb-81bf-9557f55add3c",
                                                "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                                                "text": "„Die Sirenen erschienen Morgner wagemutiger als Odysseus, eine weibliche Trobadora sinnlicher als ihre männlichen Kollegen und Pandora menschlicher als der von ihr angebetete Prometheus.“"
                                            },
                                            {
                                                "example_id": "d4e0c796-d58a-4efd-8569-080e630b6d3c",
                                                "sense_id": "e1b8897c-fa80-3dd3-9d47-6203e836e3fe",
                                                "text": "„Genau wie er sah auch ich mich darauf beschränkt, mich mit dem Partner an meiner Seite abzufinden, um den Brand zu löschen, den die drei Sirenen entfachten, die wir bald im Wasser, bald außerhalb vor Augen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                        "entry_id": "52c431bc-89d0-3708-8b1a-964efaa48996",
                                        "glosses": [
                                            "ein Gerät, das einen Ton zur Alarmierung aussenden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5b1dd2-8b8f-4a90-af9b-1d736881d43a",
                                                "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                                "text": "Die Sirenen der Feuerwehr heulten gestern sehr oft."
                                            },
                                            {
                                                "example_id": "ccfe96c8-0cc6-4087-875a-025fdb0904f5",
                                                "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                                "text": "„Sobald die Sirenen heulten, sprangen wir aus den Betten.“"
                                            },
                                            {
                                                "example_id": "0a088e18-bcc7-4763-a1fa-caa4b2c59acd",
                                                "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                                "text": "„Während der Mittagspause gab die frisch installierte Sirene Probealarm.“"
                                            },
                                            {
                                                "example_id": "6fc2ee24-0ce9-4f3e-a011-9f9d9cd57a78",
                                                "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                                "text": "„Bis heute wird mir flau im Magen, wenn ich eine Sirene höre.“"
                                            },
                                            {
                                                "example_id": "0f19b36a-231d-4ec4-b4de-564c05852fc3",
                                                "sense_id": "f2b19693-33ef-397b-a64b-f70434bc4c2b",
                                                "text": "„An diesem Tag werden die Sirenen im ganzen Land gleichzeitig getestet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
