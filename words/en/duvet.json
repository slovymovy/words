{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95c2b901-a761-3b89-b8ae-8a6beddf1b58",
                    "sense_definition": "A large, soft bag filled with feathers or synthetic material, used as a warm cover on a bed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the thick <w>duvet</w> over his head to block out the morning light.",
                            "target_lang_translations": {
                                "ru": "Он натянул толстое <w>одеяло</w> на голову, чтобы не видеть утренний свет."
                            }
                        },
                        {
                            "text": "When the weather gets colder, we switch to a thicker <w>duvet</w> for the winter.",
                            "target_lang_translations": {
                                "ru": "Когда становится холоднее, мы переходим на более толстое <w>одеяло</w> на зиму."
                            }
                        }
                    ],
                    "synonyms": [
                        "comforter",
                        "doona",
                        "quilt",
                        "continental quilt"
                    ],
                    "common_phrases": [
                        "thick duvet",
                        "warm duvet",
                        "winter duvet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое мягкое одеяло, наполненное пухом или синтетическим материалом, используемое для тепла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуховое одеяло",
                                "target_lang_sense_clarification": "одеяло с наполнителем"
                            },
                            {
                                "target_lang_word": "одеяло",
                                "target_lang_sense_clarification": "общее название постельной принадлежности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc52df51-b0ea-3d24-8730-18a1388685d4",
                    "sense_definition": "A shortened term for a <w>duvet cover</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new <w>duvet</w> that matches the color of the curtains.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новый <w>пододеяльник</w>, который подходит по цвету к шторам."
                            }
                        },
                        {
                            "text": "She put the freshly washed <w>duvet</w> back on the bed before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Она надела свежевыстиранный <w>пододеяльник</w> обратно на одеяло до прихода гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wash the duvet",
                        "cotton duvet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a shorthand for the cover itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название чехла для одеяла (пододеяльника)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пододеяльник",
                                "target_lang_sense_clarification": "чехол для одеяла"
                            }
                        ]
                    }
                }
            ]
        }
    ]
