    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "423ce6ae-2d90-3479-99b1-6700b3517766",
                    "sense_definition": "mający miękkie, gęste i delikatne owłosienie, pióra lub futro",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dotyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz mały kot ma niezwykle <w>puszysty</w> ogon.",
                            "target_lang_translations": {
                                "ru": "У нашего котенка необыкновенно <w>пушистый</w> хвост."
                            }
                        },
                        {
                            "text": "Dziecko bawiło się z małym, <w>puszystym</w> króliczkiem w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Ребенок играл в саду с маленьким <w>пушистым</w> кроликом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puszysty ogon",
                        "puszysty kot"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий мягкую, густую и нежную шерсть, перья или мех"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушистый",
                                "target_lang_sense_clarification": "о шерсти, пере, хвосте или животном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5fd30e-e639-305b-91d7-6abe9dcd8f89",
                    "sense_definition": "miękki, lekki i delikatny w dotyku",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dotyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po kąpieli owinęła się w ciepły i <w>puszysty</w> ręcznik.",
                            "target_lang_translations": {
                                "ru": "После купания она завернулась в теплое и <w>пушистое</w> полотенце."
                            }
                        },
                        {
                            "text": "W zimowy poranek podziwialiśmy świeży, <w>puszysty</w> śnieg za oknem.",
                            "target_lang_translations": {
                                "ru": "Зимним утром мы любовались свежим, <w>пушистым</w> снегом за окном."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puszysty kocyk",
                        "puszysty śnieg",
                        "puszysty ręcznik"
                    ],
                    "target_lang_definitions": {
                        "ru": "мягкий, легкий и нежный на ощупь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушистый",
                                "target_lang_sense_clarification": "о снеге, полотенце, пледе"
                            },
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "объемный и мягкий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebff4fd0-01dc-3bed-a156-3874ce087501",
                    "sense_definition": "o wypiekach lub potrawach: dobrze wyrośnięty, lekki i porowaty",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Babcia upiekła wyjątkowo <w>puszysty</w> biszkopt z truskawkami.",
                            "target_lang_translations": {
                                "ru": "Бабушка испекла исключительно <w>пышный</w> бисквит с клубникой."
                            }
                        },
                        {
                            "text": "Na śniadanie przygotował pyszny, <w>puszysty</w> omlet z warzywami.",
                            "target_lang_translations": {
                                "ru": "На завтрак он приготовил вкусный, <w>воздушный</w> омлет с овощами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puszysty omlet",
                        "puszysty biszkopt",
                        "puszyste ciasto"
                    ],
                    "target_lang_definitions": {
                        "ru": "о выпечке или блюдах: хорошо поднявшийся, легкий и пористый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "о выпечке, бисквите, омлете"
                            },
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "о тесте или креме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6e41d36-f9fc-3272-8f0b-833298d9b4c8",
                    "sense_definition": "eufemistycznie o osobie: mający tuszę, tęgi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyglad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten sklep oferuje eleganckie ubrania dla osób o bardziej <w>puszystych</w> kształtach.",
                            "target_lang_translations": {
                                "ru": "Этот магазин предлагает элегантную одежду для людей с более <w>пышными</w> формами."
                            }
                        },
                        {
                            "text": "Projektant stworzył nową kolekcję sukienek dedykowaną dla <w>puszystych</w> pań.",
                            "target_lang_translations": {
                                "ru": "Дизайнер создал новую коллекцию платьев, предназначенную для <w>полных</w> дам."
                            }
                        }
                    ],
                    "synonyms": [
                        "tęgi",
                        "korpulentny",
                        "otyły"
                    ],
                    "antonyms": [
                        "szczupły",
                        "chudy"
                    ],
                    "common_phrases": [
                        "puszyste kształty",
                        "moda dla puszystych"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane eufemistycznie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "эвфемистически о человеке: полный, тучный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "о формах, фигуре"
                            },
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о человеке или комплекции"
                            },
                            {
                                "target_lang_word": "пышечка",
                                "target_lang_sense_clarification": "ласково-эвфемистически о полных женщинах"
                            }
                        ]
                    }
                }
            ]
        }
