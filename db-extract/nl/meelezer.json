                        "examples": [
                            {
                                "example_id": "2c84b6aa-a2f7-4845-9cc8-db2e942ee6bd",
                                "sense_id": "48da57cb-5cf6-3341-8d68-21ef3f311bdd",
                                "text": "Het boek werd in 1937 vermoedelijk niet uitgegeven omdat de twee meest kritische meelezers van Toonder, zijn vrouw en zijn broer, het niet goed genoeg vonden. “Als zij op- of aanmerkingen hadden, was het niet geschikt voor openbaring”, aldus kleinzoon Irwin."
                            },
                            {
                                "example_id": "bef2675e-d28a-4754-9639-e8fc5c219775",
                                "sense_id": "48da57cb-5cf6-3341-8d68-21ef3f311bdd",
                                "text": "Arnolds liet aan het BoekBlad weten dat het besluit zijn levenswerk over te dragen niet eenvoudig was. Hij bedankte meteen de schare meelezers en -knippers die hem 35 jaar lang bijstonden. Zij verzamelden alles over de Boekenweek, de Kinderboekenweek, de maand van het Spannende Boek en alle andere activiteiten van het CPNB."
                            }
                        ]
