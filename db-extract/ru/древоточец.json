                                "target_senses": [
                                    {
                                        "sense_id": "37e26707-9f6c-3cab-ab0e-89c09bc494b9",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "A tool used for drilling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654ca86c-4715-35cd-997a-ed4e30b83e77",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "A knife fit for a stabbing."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32a5914e-aeb4-3224-871d-5d1a49dcb154",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "A person who bores or drills; a person employed to drill bore holes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d0b4cbd-1bd3-34b0-87a7-3a6670601bf6",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "A tedious person, who bores others; a bore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad992f1-b95b-46ed-b99f-426ff3a16692",
                                                "sense_id": "9d0b4cbd-1bd3-34b0-87a7-3a6670601bf6",
                                                "text": "The boree has been heard from frequently since the Renaissance, and his sentiments have undergone little change. The borer hasn't had much to say for himself."
                                            },
                                            {
                                                "example_id": "20140d93-244b-48dd-804d-720def5dfb0f",
                                                "sense_id": "9d0b4cbd-1bd3-34b0-87a7-3a6670601bf6",
                                                "text": "Rennie was an expert on boredom, having done a piece on it for Pandora's “Relationships” column in which she claimed that there were two people involved in boredom, not just one: the borer and the boree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b271a837-d76a-36e0-924b-e3863f1bf771",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "An insect or insect larva that bores into wood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "169b08f3-fa57-3ef4-a566-1ddd18a9cdb8",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "One of the many types of mollusc that bore into soft rock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9adfc72b-70ad-3228-bfe8-49ead6b137e1",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "A cyclostome, such as a hagfish, which bores into injured, dead, or decaying sea creatures to feed on their flesh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb9e6bbe-e808-3d5e-9927-4c3ec8605640",
                                        "entry_id": "6d578285-01f9-393c-aee3-769b6aee6d64",
                                        "glosses": [
                                            "The penetrating root of a parasitic plant."
                                        ],
