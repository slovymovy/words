    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c6cbc6a-2630-3496-8f5a-24de695aadfc",
                    "sense_definition": "Éclairer, expliquer ou appuyer une idée ou un propos au moyen d'exemples.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expliquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur donne un exemple concret pour <w>illustrer</w> cette règle difficile."
                        },
                        {
                            "text": "Ces quelques chiffres viennent <w>illustrer</w> la gravité de la situation économique."
                        }
                    ],
                    "synonyms": [
                        "éclairer",
                        "expliciter"
                    ],
                    "common_phrases": [
                        "illustrer par un exemple",
                        "illustrer un propos"
                    ]
                },
                {
                    "sense_id": "4bb1b61e-eafd-33e7-93df-52a70baff77c",
                    "sense_definition": "Accompagner ou orner un texte ou un livre de dessins, d'images ou de gravures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a accepté d'<w>illustrer</w> ce nouveau roman pour la jeunesse."
                        },
                        {
                            "text": "Elle <w>illustre</w> ses articles avec des photographies prises pendant ses voyages."
                        }
                    ],
                    "common_phrases": [
                        "illustrer un livre",
                        "illustrer un conte"
                    ]
                },
                {
                    "sense_id": "1280c3c6-558a-3c15-993e-82f4702b2ebb",
                    "sense_definition": "Rendre célèbre ou glorieux, ou se distinguer brillamment dans une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renommee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette scientifique s'est <w>illustrée</w> par ses recherches remarquables sur le climat."
                        },
                        {
                            "text": "Ses nombreuses victoires ont <w>illustré</w> le nom de sa famille à travers le pays."
                        }
                    ],
                    "synonyms": [
                        "distinguer",
                        "glorifier"
                    ],
                    "common_phrases": [
                        "s'illustrer dans"
                    ]
                }
            ]
        }
    ]
}