                "senses": [
                    {
                        "sense_id": "46bc0c0f-f281-3b45-8c31-324466cbf4a1",
                        "entry_id": "05244f9f-36e4-3806-99b0-3971fb249b92",
                        "glosses": [
                            "met kennis van zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0b791e-3b4e-4eba-bf58-bd1af61cb0e6",
                                "sense_id": "46bc0c0f-f281-3b45-8c31-324466cbf4a1",
                                "text": "Hij gaf een deskundig advies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7948de09-28bd-4b1d-a2a9-14af9a37050a",
                        "source_entry_id": "05244f9f-36e4-3806-99b0-3971fb249b92",
                        "source_sense_id": "46bc0c0f-f281-3b45-8c31-324466cbf4a1",
                        "source_sense_description": "met kennis van zaken",
                        "target_lang_word": "sachkundig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sachkundig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                        "entry_id": "e1e07df9-e86d-3164-a46d-4bb0e0dd696f",
                                        "glosses": [
                                            "von oder für etwas die Qualifikation, Sachkenntnis und Erfahrung habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446abcd4-6b1c-4e5c-ade7-2fc6017df7e3",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "An mein Auto lasse ich nur einen sachkundigen Mechaniker, das wird nicht in einer Hinterhofwerkstatt gewartet."
                                            },
                                            {
                                                "example_id": "e3d6aab9-110d-41c9-ae76-949b7d517367",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "Jürgen Hiller ist begeisterter Hobbyimker. […] Fragt man ihn nach seinen Bienen, gibt er ausführlich und sachkundig Antwort – obwohl er keine professionelle Ausbildung besitzt."
                                            },
                                            {
                                                "example_id": "e3a33d93-af2b-4f16-aa67-27d809443b9e",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "Die türkischen Funktionäre und Journalisten waren aus dem Häuschen, pöbelten um die Wette, während [die Journalistin Karen Krüger] seelenruhig und sachkundig Argumente vorbrachte."
                                            },
                                            {
                                                "example_id": "66b46106-79ed-4348-aee1-550ddd7cc24e",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "[Hubertus] Knabes Expertise als Wissenschaftler steht außer Frage. Er ist ein ebenso sachkundiger wie scharfzüngiger Kritiker der SED und ihrer Nachfolgeparteien."
                                            },
                                            {
                                                "example_id": "e36f1fac-a5fb-4151-a85d-b7006b3ae4cf",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "Die Jugendgynäkologin Ruth Draths beantwortet Fragen rund um die Pille und informiert sachkundig über Vor- und Nachteile verschiedener hormoneller Verhütungsmethoden und deren Gesundheitsrisiken."
                                            },
                                            {
                                                "example_id": "5eb546be-1a66-424c-9b5e-2b457b7c39d9",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "„‚Wenn der Richter meint, seine Oma sei sachkundig und der Richter sie bestellt, dann ist sie sachkundig‘, sagt Elmar Bergmann, ein pensionierter Familienrichter.“"
                                            },
                                            {
                                                "example_id": "d4c2328e-c150-4acf-9439-34816416c45c",
                                                "sense_id": "efed0b3c-c17d-30f3-8107-82e8364b7aeb",
                                                "text": "Das neue Angebot […] des SR [Saarländischen Rundfunks …] bietet eine zusätzliche Möglichkeit, sich über das politische, wirtschaftliche und kulturelle Geschehen jenseits der saarländischen Grenzen gezielt sachkundig zu machen […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbc2b840-53a1-4cd7-ac7f-010aef1a0577",
                        "source_entry_id": "05244f9f-36e4-3806-99b0-3971fb249b92",
                        "source_sense_id": "46bc0c0f-f281-3b45-8c31-324466cbf4a1",
                        "source_sense_description": "met kennis van zaken",
                        "target_lang_word": "expert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Extraordinary capable or knowledgeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbe4a80-66d4-4097-a3ad-45546766c13e",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "I am expert at making a simple situation complex."
                                            },
                                            {
                                                "example_id": "eee8d8f3-3bee-42d3-8827-3ff4f8a3767f",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "My cousin is an expert pianist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Characteristic of an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4400dc18-9d2f-4229-8859-303d3ebe0aeb",
                                                "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                                "text": "This problem requires expert knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9aa305-7602-3c0a-82df-44e4726b49c1",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Proven, experienced, veteran."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A person with extensive knowledge or ability in a given subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885b1c9c-fd0a-432d-a905-72485e899517",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "If an expert says it can't be done, get another expert. - David Ben-Gurion"
                                            },
                                            {
                                                "example_id": "837256c2-464e-4ceb-9acd-28049ca7978d",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "We called in several experts on the subject, but they couldn't reach an agreement."
                                            },
                                            {
                                                "example_id": "7df3c666-9ca6-4377-b295-f5f5a23d16c3",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            },
                                            {
                                                "example_id": "10fa2d69-4d43-4bc4-8c13-6a74b71efb35",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "I'm an expert in my field\nUfology, yes, it's all real\nAncient aliens, it's all true\nI'm an expert just like you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f712187-def4-3f07-87f9-c24dcf1000d4",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A player ranking just below master."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                        "entry_id": "9fa13cad-21c2-3a50-8034-e5883a66b45e",
                                        "glosses": [
                                            "To have (something) reviewed or checked by an expert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f6348c-29de-4106-a49c-490d8ca46ccb",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "Estimated cost of editorial work on Advanced History […] Estimated cost of experting the Advanced History […]"
                                            },
                                            {
                                                "example_id": "d6009af6-14c9-4c0c-b241-cfa0fd00642d",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "The bill in question was one proposing to appropriate from the public moneys of this State $30,000 to pay an accountant for experting the books of the Southern Pacific Company, in furtherance of litigation then pending."
                                            }
                                        ]
                                    }
                                ]
                            }
