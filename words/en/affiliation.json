                },
                {
                    "sense_id": "4ef16b0e-d8a8-30ad-8fca-51abfb913b95",
                    "sense_definition": "The legal process of establishing the paternity or maternity of a child.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_paternity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court issued an <w>affiliation</w> order requiring the father to pay for the child's maintenance.",
                            "target_lang_translations": {
                                "ru": "Суд вынес постановление об <w>установлении отцовства</w>, обязывающее отца выплачивать алименты на содержание ребенка."
