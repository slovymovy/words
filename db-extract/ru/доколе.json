        "ru-extract.jsonl": [
            {
                "entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                "word": "доколе",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4572ae5e-2f50-39e4-8917-b0d9f0c2ffaf",
                        "entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                        "glosses": [
                            "устар., высок., книжн., до каких пор?, как долго?; до какого места, предела?"
                        ],
                        "tags": [
                            "вопросит. наречие"
                        ],
                        "examples": [
                            {
                                "example_id": "653bf51a-82fc-4176-8fc6-022265d32c7f",
                                "sense_id": "4572ae5e-2f50-39e4-8917-b0d9f0c2ffaf",
                                "text": "Доколе, господи, доколе Мне слышать эхо древних лет: Ни мельниц тех, ни колоколен Давным-давно на свете нет."
                            },
                            {
                                "example_id": "172db027-7d5c-44ed-b61f-10e8ff2024c5",
                                "sense_id": "4572ae5e-2f50-39e4-8917-b0d9f0c2ffaf",
                                "text": "Доколе, наконец, Катилина, ты будешь злоупотреблять терпением нашим? Как долго ещё ты, в своем бешенстве, будешь издеваться над нами?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1038b7df-fe10-3c4e-abcb-9c982561a8ab",
                        "entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                        "glosses": [
                            "устар., высок., книжн. до тех пор, пока"
                        ],
                        "tags": [
                            "относит. наречие, союз, присоединяет придаточное времени"
                        ],
                        "examples": [
                            {
                                "example_id": "3bb9efc7-a037-4a81-8b84-bb512f868f3a",
                                "sense_id": "1038b7df-fe10-3c4e-abcb-9c982561a8ab",
                                "text": "...и шершней нашлет Господь, Бог твой, на них, доколе не погибнут."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c3193df-a871-341d-aa1b-b1059fcfb1a0",
                        "entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                        "glosses": [
                            "устар., высок., книжн. редк. насколько; до того места, куда"
                        ],
                        "tags": [
                            "относит. наречие, союз, присоединяет придаточное места"
                        ],
                        "examples": [
                            {
                                "example_id": "2a11849a-c696-40ba-99ac-8b19a1629326",
                                "sense_id": "1c3193df-a871-341d-aa1b-b1059fcfb1a0",
                                "text": "Направо, доколе хватает глаз, протянулось волнующееся Чёрное море."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad045fc1-71d8-4402-8150-2c4d56303bbd",
                        "source_entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                        "target_lang_word": "as long as",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as long as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2627d8ae-679b-31c4-b10a-c5667330401a",
                                        "entry_id": "a69b5240-dc9d-3801-a451-a07833c3fcfe",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see as, long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3f0515-b0ef-4de2-8362-a33d3a950b5c",
                                                "sense_id": "2627d8ae-679b-31c4-b10a-c5667330401a",
                                                "text": "It took three times as long as I expected (= three times longer than I did)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff0b07e-4acd-3c5c-99f2-3a7a07b9abaf",
                                        "entry_id": "a69b5240-dc9d-3801-a451-a07833c3fcfe",
                                        "glosses": [
                                            "Provided that, if, assuming (depending upon some condition or requirement)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf71eb3-ddda-4c88-8e19-1a6fe10037d2",
                                                "sense_id": "fff0b07e-4acd-3c5c-99f2-3a7a07b9abaf",
                                                "text": "I don't mind if he stays there, as long as he cleans up after himself when he's done."
                                            },
                                            {
                                                "example_id": "c3d6dbcc-8c6a-4f37-aafd-09cb7c786f1f",
                                                "sense_id": "fff0b07e-4acd-3c5c-99f2-3a7a07b9abaf",
                                                "text": "I don't care who you are, where you're from, what you did, as long as you love me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809770ad-496a-37b8-aa70-b417880ef9ee",
                                        "entry_id": "a69b5240-dc9d-3801-a451-a07833c3fcfe",
                                        "glosses": [
                                            "For the entire duration that; while; since."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b51e0f8-21ee-450e-85ae-b80c7088e696",
                                                "sense_id": "809770ad-496a-37b8-aa70-b417880ef9ee",
                                                "text": "As long as you're here, you may as well help me with the garden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "as long as",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae88fc21-0a12-3d2d-b51b-1c6b65225bc0",
                                        "entry_id": "bc3b4f42-1e83-3302-bd45-ebd23cc37ee4",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see as, long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178ba44e-0e3c-4ea9-b79b-637e1ed599d6",
                                                "sense_id": "ae88fc21-0a12-3d2d-b51b-1c6b65225bc0",
                                                "text": "These meetings can last as long as three hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bea6b921-cade-45e8-9082-18df9399a55f",
                        "source_entry_id": "a5f63833-b707-3b15-ba9c-75f1960dad2f",
                        "target_lang_word": "how long",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "how long",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aa7d9e7-b0c2-36a4-9dec-a4e380f0497e",
                                        "entry_id": "3bbf9a2c-5483-3298-af3a-8091fa9ca5b3",
                                        "glosses": [
                                            "Used literally: what length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519879cf-2342-45f6-9276-d11f1f991e61",
                                                "sense_id": "9aa7d9e7-b0c2-36a4-9dec-a4e380f0497e",
                                                "text": "How long is that piece of string?"
                                            },
                                            {
                                                "example_id": "d40004ba-6a07-43b4-8173-0ea0ad779a0b",
                                                "sense_id": "9aa7d9e7-b0c2-36a4-9dec-a4e380f0497e",
                                                "text": "I don't know how long the Amazon River is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d443dabb-c85f-3c34-ae46-1d77af6b4c8b",
                                        "entry_id": "3bbf9a2c-5483-3298-af3a-8091fa9ca5b3",
                                        "glosses": [
                                            "Used literally: what duration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecb60f0-da9a-477c-8c33-4c93054a3689",
                                                "sense_id": "d443dabb-c85f-3c34-ae46-1d77af6b4c8b",
                                                "text": "How long are you here for? ~ Until the end of next month."
                                            },
                                            {
                                                "example_id": "f56080d5-996b-48b7-b52a-9259b8b09def",
                                                "sense_id": "d443dabb-c85f-3c34-ae46-1d77af6b4c8b",
                                                "text": "How long have you already been here (for)? ~ Since last Friday"
                                            },
                                            {
                                                "example_id": "41b5ba10-644c-45a7-9418-c28d4956c7db",
                                                "sense_id": "d443dabb-c85f-3c34-ae46-1d77af6b4c8b",
                                                "text": "How long is it to lunch?"
                                            },
                                            {
                                                "example_id": "2331065e-877c-4d31-9b66-a0af7e1f9620",
                                                "sense_id": "d443dabb-c85f-3c34-ae46-1d77af6b4c8b",
                                                "text": "How long ago did you stop playing tennis?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "how long",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                        "entry_id": "a1e6466f-bc9f-30b4-969d-a80a1fc8bc3d",
                                        "glosses": [
                                            "Used literally: for what duration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a09f518-d1a8-4f73-9b65-590725353fdd",
                                                "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                                "text": "How long have you lived in Chicago?"
                                            },
                                            {
                                                "example_id": "bb0b1f0f-f5bd-4236-8d3f-72db50d5f4f9",
                                                "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                                "text": "He won't tell me how long he is going to stay."
                                            },
                                            {
                                                "example_id": "b0bfa13c-39b1-4274-8440-6328e3823cc1",
                                                "sense_id": "15840920-28e7-3d24-9528-86c2262d9242",
                                                "text": "How long I slept I cannot tell, for I had nothing to guide me to the time, but woke at length, and found myself still in darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
