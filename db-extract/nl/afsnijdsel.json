                        "glosses": [
                            "restjes die overblijven na snijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec09042-2846-4108-913f-22222f2d836f",
                                "sense_id": "6e629ef3-d61a-346d-9b9c-8e8f69d37114",
                                "text": "Is de schnitzel dan soms geboren in de Achterhoek, vroegen Vermeer en co zich af. Veel doet dat vermoeden, want de benaming schnitzel is een verbastering van het Achterhoekse woord voor afsnijdsel, fonetisch: afsnietsel. Zo wordt althans beweerd in een ronkend persbericht van de programmamakers."
                            },
                            {
                                "example_id": "25e58d42-53aa-4ea9-8a2a-6c093ed0b823",
                                "sense_id": "6e629ef3-d61a-346d-9b9c-8e8f69d37114",
                                "text": "Ik kwam op dit hapje doordat er op de zaak nog wat afsnijdsels van een grote zalmzijde in de koeling lagen."
                            }
                        ]
                    }
                ],
