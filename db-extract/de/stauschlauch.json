                "senses": [
                    {
                        "sense_id": "1c18f573-23b5-3d2e-a18a-3b9f9a28b490",
                        "entry_id": "5259bf3d-6587-31eb-9c4a-33be433afa83",
                        "glosses": [
                            "Textilband oder längliches Stück elastischen Kunststoffs, mit dessen Hilfe das Blut in einer Arm- oder Beinvene gestaut werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d884f1-e048-48e9-b0ad-5d89cef7a814",
                                "sense_id": "1c18f573-23b5-3d2e-a18a-3b9f9a28b490",
                                "text": "Dank des Stauschlauchs fand der Pfleger die Vene im nu."
                            },
                            {
                                "example_id": "d7e23b9b-c1a6-4e0d-8560-ab5b57051c68",
                                "sense_id": "1c18f573-23b5-3d2e-a18a-3b9f9a28b490",
                                "text": "„Sie legen den Stauschlauch an, desinfizieren die gut sichtbaren Venen und stellen die Blutröhrchen griffbereit neben sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b2700a1-a1ef-4fec-806f-930625ce9ae3",
                        "source_entry_id": "5259bf3d-6587-31eb-9c4a-33be433afa83",
                        "source_sense_id": "1c18f573-23b5-3d2e-a18a-3b9f9a28b490",
                        "target_lang_word": "tourniquet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourniquet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d28e47ed-fd32-39ee-9b66-576ca369e292",
                                        "entry_id": "a3ce4770-8920-3ba0-9209-bbe9a072cc9e",
                                        "glosses": [
                                            "A tightly-compressed bandage used to stop bleeding by stopping the flow of blood through a large artery in a limb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849de030-dd7f-46cd-983b-3edf7aa172d1",
                                                "sense_id": "d28e47ed-fd32-39ee-9b66-576ca369e292",
                                                "text": "His forefathers had been, as a rule, professional men—physicians and lawyers; his grandfather died under the walls of Chapultepec Castle while twisting a tourniquet for a cursing dragoon; an uncle remained indefinitely at Malvern Hill;[…]."
                                            },
                                            {
                                                "example_id": "4de093de-b5b7-4494-916a-6cdb51bc8072",
                                                "sense_id": "d28e47ed-fd32-39ee-9b66-576ca369e292",
                                                "text": "[…] Bull was in the bathroom taking his fix, clutching his old black necktie in his teeth for a tourniquet and jabbing with the needle into his woesome arm with the thousand holes;[…]"
                                            },
                                            {
                                                "example_id": "ebc99af0-ff70-4f50-bcad-c2adaccf78be",
                                                "sense_id": "d28e47ed-fd32-39ee-9b66-576ca369e292",
                                                "text": "After he was done, Lillehei's assistants released the tourniquet around Gregory's venae cavae, allowing blood to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6314b706-7f3a-3db9-b135-d438e9442e2f",
                                        "entry_id": "a3ce4770-8920-3ba0-9209-bbe9a072cc9e",
                                        "glosses": [
                                            "Any of several similar methods of clamping components into position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b81565b5-70d2-3f73-aaf3-c4bb1c06c432",
