                "senses": [
                    {
                        "sense_id": "8d976256-6628-3c6a-86e2-ebe928b51242",
                        "entry_id": "8060412a-cfc3-3b1b-90e7-91a143db5f85",
                        "glosses": [
                            "Qui a rapport à l'antiaméricanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738d588a-c37d-455d-8b52-73ad9b1169bc",
                                "sense_id": "8d976256-6628-3c6a-86e2-ebe928b51242",
                                "text": "Depuis George W. Bush, le sentiment antiaméricain s'est répandu dans le reste du monde, en particulier dans le monde arabomusulman."
                            },
                            {
                                "example_id": "026b123e-5e77-4e3e-9cec-87273b13cdf6",
                                "sense_id": "8d976256-6628-3c6a-86e2-ebe928b51242",
                                "text": "Un de mes interlocuteurs était farouchement antiaméricain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8071f39e-e78f-47b0-b7da-147bc2b9272e",
                        "source_entry_id": "8060412a-cfc3-3b1b-90e7-91a143db5f85",
                        "source_sense_id": "8d976256-6628-3c6a-86e2-ebe928b51242",
                        "target_lang_word": "antiamerikanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiamerikanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe32bcb-4047-3007-8280-02d9f26c9855",
                                        "entry_id": "e37f27e6-d325-34b8-b36b-d9cb91881f0c",
                                        "glosses": [
                                            "gegen die Vereinigten Staaten von Amerika gerichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10615baa-07e0-4e94-bcbd-fbffe8dd4279",
                                                "sense_id": "2fe32bcb-4047-3007-8280-02d9f26c9855",
                                                "text": "„Die antiamerikanische und antiwestliche Haltung, ja Feindschaft eines großen Teils der Gesellschaften in der arabischen und in der weiteren islamischen Welt würde zunehmen.“"
                                            },
                                            {
                                                "example_id": "40249c41-2b9f-4ea5-acd1-f5a2d478a7bf",
                                                "sense_id": "2fe32bcb-4047-3007-8280-02d9f26c9855",
                                                "text": "Um sich selbst moralisch zu erhöhen, ist antiamerikanischen Gutmenschen jeder unangebrachte Anlass willkommen."
                                            },
                                            {
                                                "example_id": "68dbf44e-6293-441e-9d65-ec857bdf0b6d",
                                                "sense_id": "2fe32bcb-4047-3007-8280-02d9f26c9855",
                                                "text": "Fröhder habe aus Vietnam und dem ersten Golfkrieg kritisch berichtet, und überhaupt sei die ARD mit ihrem Nahost-Korrespondenten Jörg Armbruster \"links und antiamerikanisch. Wir registrieren das.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
