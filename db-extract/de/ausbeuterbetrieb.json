                "senses": [
                    {
                        "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                        "entry_id": "09b4ac21-cd87-32fd-83b9-e076b28c51fa",
                        "glosses": [
                            "Firma, die ihre Arbeiter über Gebühr belastet und schlecht bezahlt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "cf17a909-c406-4a6a-8bfb-d97810706e04",
                                "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                                "text": "„Die Ausbildungen seien fehlleitend, die verheerenden Zustände in Ausbeuterbetrieben unzumutbar, das saisonale Trend-Diktat bewege sich fern jeder Realität.“"
                            },
                            {
                                "example_id": "f0b35f1f-8f47-427f-b65e-30a54e8a54e9",
                                "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                                "text": "„In einem gepunkteten Rock fand Rebecca Jones die handgeschriebenen Worte „Degrading sweatshop conditions\" (dt. „entwürdigende Verhältnisse im Ausbeuterbetrieb“). Das Etikett postete die Primark-Kundin auf Twitter.“"
                            },
                            {
                                "example_id": "36418a26-a572-458f-b13e-a544d877bbb5",
                                "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                                "text": "„Terry Kuo, der Vorsitzende der Hon-Hai-Gruppe, zu der Foxconn gehört, sagte dagegen: \"Foxconn ist kein Ausbeuterbetrieb.\" Das Unternehmen versuche aktiv, Selbstmorden vorzubeugen.“"
                            },
                            {
                                "example_id": "dd3cb20c-48fe-4b69-be58-52fe1c5aa63c",
                                "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                                "text": "„Nein, ich rede von der „Ein-Prozent-Wirtschaft\", von Ausbeuterbetrieben, von Werbung davon, dass das sehr treibstoffintensiv ist.“"
                            },
                            {
                                "example_id": "9b2abb59-ebb2-4275-bf84-df3e7cd34a9f",
                                "sense_id": "94a7a371-3238-36c1-ad59-be30dd6990dc",
                                "text": "„Die Samwer-Brüder werden in den Medien oder von Mitarbeitern schon mal als \"Killerhaie\" mit \"Ausbeuterbetrieben\" beschimpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
