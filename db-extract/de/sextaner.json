                ],
                "senses": [
                    {
                        "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                        "entry_id": "c3f7ea65-d03c-3cee-9047-5bc781ea3986",
                        "glosses": [
                            "Schüler, der in der Sexta ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea0a94e-a9a0-49c6-9b23-e8b9cd46752d",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "Melvin freut sich schon sehr darauf, nach den Sommerferien endlich Sextaner zu sein."
                            },
                            {
                                "example_id": "2e8aeac1-6fa3-49de-96fa-0cc1e47b4555",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "Die Sextaner werden als die Kleinsten an der Schule anfangs häufig von den älteren Schülern geärgert."
                            },
                            {
                                "example_id": "bbf89589-0d20-4680-99b8-f5191b3da16e",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "„Immerhin waren sie keine Sextaner oder Quintaner mehr, sondern Tertianer, zwei Jahre vor dem Einjährigen.“"
                            },
                            {
                                "example_id": "7d069a0f-05a3-4cf6-a711-526696321bbd",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "„Dann wurden die Sextaner von ihm über mehrere prachtvoll breite Treppen und durch hohe Hallen, vorbei an den Statuen altgriechischer Denker und den Büsten großer Staatsmänner Athens, in die Aula geführt, wo sich die gesamte Schülerschaft des Johanneums versammelte, wie jeden Wochenanfang, um den Gottesdienst abzuhalten.“"
                            },
                            {
                                "example_id": "0ef0e85e-61c1-4cad-a457-419706a1e3fb",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "„Als die Obersekunda ihren anerkannten Führer und heimlich bewunderten Elegant Jensen sich gebärden sah wie einen mutlosen Sextaner, brach sie in ein brüllendes Gelächter aus.“"
                            },
                            {
                                "example_id": "2a0295c8-1ebe-49f3-93ba-d7a010d63ab9",
                                "sense_id": "bbf7c308-0f76-3bdb-811e-5e6bf49b2ba5",
                                "text": "„Die Zeremonie zur Begrüßung der Sextaner fand in der Aula statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
