                "senses": [
                    {
                        "sense_id": "1d19b727-422d-3af4-a9f9-c7e03c6fc457",
                        "entry_id": "bb4de10b-e95a-300b-a07f-a10c9c7c8110",
                        "glosses": [
                            "Münze oder Banknote einer bestimmten Währung mit dem Nennwert fünfzig"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "c26cb995-c82a-4379-8e5c-593298617629",
                                "sense_id": "1d19b727-422d-3af4-a9f9-c7e03c6fc457",
                                "text": "Gib mir einen Fuffi und der Herd gehört dir."
                            },
                            {
                                "example_id": "2cd1676f-4425-406c-993c-bae6d66e08d0",
                                "sense_id": "1d19b727-422d-3af4-a9f9-c7e03c6fc457",
                                "text": "Wer die Veranda neu streicht, bekommt einen Fuffi."
                            },
                            {
                                "example_id": "9bfe90f6-d8c4-4a55-9e4a-5ce292d3d48b",
                                "sense_id": "1d19b727-422d-3af4-a9f9-c7e03c6fc457",
                                "text": "Wem gehört der Fuffi, der da auf dem Boden liegt?"
                            },
                            {
                                "example_id": "58459e55-0b2f-41cd-b547-a6ce8d25bfc0",
                                "sense_id": "1d19b727-422d-3af4-a9f9-c7e03c6fc457",
                                "text": "Fünf Euro habe ich nicht klein. Ich habe nur noch zwei Fuffis im Portemonnaie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
