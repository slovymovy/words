                "senses": [
                    {
                        "sense_id": "3d9cf87c-7b13-38b4-9432-ea2994838a3f",
                        "entry_id": "03a9b1de-9995-3f15-9eef-0de622367d04",
                        "glosses": [
                            "Injektion"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "215dc2e9-2d7c-4c8d-8b85-8c0340a617f3",
                                "sense_id": "3d9cf87c-7b13-38b4-9432-ea2994838a3f",
                                "text": "Wer weiß schon, dass ein Jaukerl eine Spritze ist und Lurch die Bezeichnung für Staub und Schmutz?"
                            },
                            {
                                "example_id": "0c33eb2c-1544-428a-9a39-b5f0cc75b96f",
                                "sense_id": "3d9cf87c-7b13-38b4-9432-ea2994838a3f",
                                "text": "„Botox-Partys, bei denen man neben ein paar Snacks auch ein ‚Jaukerl‘ vom Arzt bekommt, um sich die Falten im Gesicht zu glätten, sind auch hier zu Lande schon bekannt.“"
                            },
                            {
                                "example_id": "9c263222-b9b6-47bc-a06a-3fdcf890ba41",
                                "sense_id": "3d9cf87c-7b13-38b4-9432-ea2994838a3f",
                                "text": "„Hier wird aber auch die Flugtauglichkeit bestimmt und das fehlende ‚Jaukerl‘ für die Fernreise verabreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
