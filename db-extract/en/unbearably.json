                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нестерпи́мо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6e467307-53af-3a5f-b883-9135788e5aac",
                                        "entry_id": "d3d62865-2d9f-3ef2-8f56-f38d154de141",
                                        "glosses": [
                                            "наречие к нестерпимый"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1908dd-08ac-4d42-bc76-e8a3f3e1c9ee",
                                                "sense_id": "6e467307-53af-3a5f-b883-9135788e5aac",
                                                "text": "Явясь по двадцатому году к отцу, положительно в вертеп грязного разврата, он, целомудренный и чистый, лишь молча удалялся, когда глядеть было нестерпимо, но без малейшего вида презрения или осуждения кому бы то ни было."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724cfd94-d845-3fa8-bbd3-bb79741ffd66",
                                        "entry_id": "d3d62865-2d9f-3ef2-8f56-f38d154de141",
                                        "glosses": [
                                            "оценка какой-либо ситуации, чьих-либо действий как характеризующихся трудностью, невозможностью стерпеть, перенести что-либо; невыносимо"
                                        ],
                                        "tags": [
                                            "предикатив"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32fea551-bcc3-4c85-a802-ae0babf55681",
                                                "sense_id": "724cfd94-d845-3fa8-bbd3-bb79741ffd66",
                                                "text": "Какие-то маленькие пребойкие насекомые кусали его нестерпимо больно, так что он всей горстью скреб по уязвленному месту, приговаривая: «А, чтоб вас чёрт побрал вместе с Ноздревым!»"
                                            },
                                            {
                                                "example_id": "3005cc6e-b353-49f9-80b1-888c76f94737",
                                                "sense_id": "724cfd94-d845-3fa8-bbd3-bb79741ffd66",
                                                "text": "Ему было нестерпимо душно, и сильно стучало сердце."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
