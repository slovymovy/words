                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61fd7cfd-e1b3-48df-9d1d-654322c8abf0",
                                                "sense_id": "39cc6f6c-a372-3147-a254-70c97e57daf1",
                                                "text": "Découvrez les régions de la Galicie, des Asturies, de la Cantabrie et de la Castille-et-Léon qui sont très différentes du reste de l’Espagne de par leur nature, leurs traditions et leur train de vie."
                                            },
                                            {
                                                "example_id": "c5a85cbb-27b1-4869-bdb6-3e509bd6f979",
                                                "sense_id": "39cc6f6c-a372-3147-a254-70c97e57daf1",
                                                "text": "Les plans de protection développés dès les années 1990 entre la Cantabrie, les Asturies, la Galice et la Castille-et-Léon ont porté leurs fruits, au point que, selon les experts, le territoire des ours est aujourd’hui deux fois plus grand que la zone délimitée dans les plans de peuplement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
