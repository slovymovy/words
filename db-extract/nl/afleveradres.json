                        "examples": [
                            {
                                "example_id": "a6416471-cc5b-4cd0-9a09-bc88aa6b952b",
                                "sense_id": "7c34010d-8521-3780-99eb-ba8279019a3f",
                                "text": "De Douane en de Nationale Recherche hebben in de haven van Rotterdam een container met 145 kilo cocaïne onderschept. De drugs heeft een waarde van vijf miljoen euro en was afkomstig uit Peru. De Nationale Recherche volgde de container naar het afleveradres in Spijkenisse."
                            },
                            {
                                "example_id": "deef757f-33aa-4704-91fe-d3230af1bf40",
                                "sense_id": "7c34010d-8521-3780-99eb-ba8279019a3f",
                                "text": "Afleveradres: Webwinkelaars kunnen er binnenkort bij hun bestelling voor kiezen om een pakket bij één van de automaten te laten bezorgen. De klant krijgt een sms-bericht als het pakket klaarligt. Het moet daar wel binnen drie dagen worden opgehaald, anders gaat het naar een ander afhaalpunt van PostNL."
                            }
                        ]
