                "senses": [
                    {
                        "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                        "entry_id": "20ca9003-8694-33ac-afd2-34755a376ba4",
                        "glosses": [
                            "aufgeschüttetes Gelände zum Ausgleich von Unebenheiten, auf dem Gleise verlegt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7903c56c-05fc-4b47-a362-074f651dc0fd",
                                "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                                "text": "Ein Bahndamm ermöglicht eine Streckenführung auch in unebenem Gelände."
                            },
                            {
                                "example_id": "f1c74841-e1bb-47c5-87df-c8c1a583b1a6",
                                "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                                "text": "„Neben dem Bahndamm führt ein baumloser Feldweg entlang.“"
                            },
                            {
                                "example_id": "eb717dda-a022-4c6c-8753-e97883dd488a",
                                "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                                "text": "„Dann faßte er seinen Tornister, kroch unterm Zug weg und lief hinüber auf die andere Seite des Bahndammes und wanderte in die Nacht hinein.“"
                            },
                            {
                                "example_id": "8cf510dd-f037-4274-8a8a-59fb1000d60a",
                                "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                                "text": "„Wir stiegen vorsichtig den steilen Bahndamm in die Höhe.“"
                            },
                            {
                                "example_id": "f209a482-5ac6-45dd-8ed3-04317db154f3",
                                "sense_id": "b58040d6-30c3-3c6c-98bd-a692bf7c1c22",
                                "text": "„Ein endloser schwerer Güterzug rasselte herüber, der Bahndamm konnte nicht weit sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
