                "senses": [
                    {
                        "sense_id": "bad8257e-e00a-327a-9df9-fa27ed67f978",
                        "entry_id": "9bd81b3d-5081-3d79-8991-286ba6a71c04",
                        "glosses": [
                            "Mandragora L., rodzaj roślin z rodziny psiankowatych, którym ze względu na kształt korzeni przypominający postać ludzką przypisywano dawniej lecznicze i magiczne własności"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bd862ddc-cca7-3d4a-b70f-3a840083c67f",
                        "entry_id": "9bd81b3d-5081-3d79-8991-286ba6a71c04",
                        "glosses": [
                            "roślina z rodzaju mandragora (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5657c05-6e59-4be8-a56e-bd0f595c07b4",
                        "source_entry_id": "9bd81b3d-5081-3d79-8991-286ba6a71c04",
                        "source_sense_id": "bd862ddc-cca7-3d4a-b70f-3a840083c67f",
                        "target_lang_word": "mandrake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandrake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                                        "glosses": [
                                            "Any plant of the genus Mandragora, certain of which are said to have medicinal or aphrodisiac properties; the root of these plants often resembles the shape of a small person, hence occasioning various mythic, magical, or occult uses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdce6562-02e2-4a84-8d8e-cc4b128b2eac",
                                                "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                                                "text": "[T]his is the true deſcription of the plant and therefore thoſe idle formes of the Mandrakes and Womandrakes, as they are fooliſhly ſo called, which have beene expoſed to publike view, both in ours and other lands and countries, are utterly deceitfull being the work of cunning knaves, onely to get mony by their forgery."
                                            },
                                            {
                                                "example_id": "9a1d79bf-ccd0-4077-81ef-281d3d3308c8",
                                                "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                                                "text": "Pharmaceutically tested in recent times, mandrake show aphrodisiac properties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c22540d9-c77e-3e21-becc-3f1865781e7b",
                                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                                        "glosses": [
                                            "A root of a mandrake plant that resembled human form, especially one kept or used for magic or occult purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d241fd92-d4ed-4753-98e8-e885c71f0ccd",
                                                "sense_id": "c22540d9-c77e-3e21-becc-3f1865781e7b",
                                                "text": "Mandrakes were sometimes considered in the light of familiars. Witches kept both male and female specimens of the magic root in bottles[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea4ad47-1423-3057-a900-5a26c2e8fcdb",
                                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                                        "glosses": [
                                            "The drug methaqualone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d5c96cc-0b17-3bba-87e7-0db2765f1c0e",
                                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                                        "glosses": [
                                            "A kind of tiny demon immune to fire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9013f961-901f-4f99-87ea-d72ecc1bdd32",
                        "source_entry_id": "9bd81b3d-5081-3d79-8991-286ba6a71c04",
                        "source_sense_id": "bd862ddc-cca7-3d4a-b70f-3a840083c67f",
                        "target_lang_word": "mandragore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandragore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c5a3580-173d-310b-845e-661421a62db3",
                                        "entry_id": "0e4c0e8a-fdcf-36cd-96a0-2bfd96daec4d",
                                        "glosses": [
                                            "Plante de la famille des solanées, dont la racine a la forme d’un corps humain, douée de propriétés narcotiques, sédatives, stupéfiantes et aphrodisiaques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8448623-fac6-4d91-9515-48b7e91683cb",
                                                "sense_id": "4c5a3580-173d-310b-845e-661421a62db3",
                                                "text": "On employait autrefois en pareil cas la mandragore, qu’on a abandonnée depuis ; toujours est-il certain que sa racine […] guérit les inflammations et les douleurs des yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                        "entry_id": "0e4c0e8a-fdcf-36cd-96a0-2bfd96daec4d",
                                        "glosses": [
                                            "Plante de la famille des solanées dite porteuse de vertus magiques."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a0ae319-fcc8-4650-8204-9557be4e90bd",
                                                "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                                "text": "Ce sentier a ceci de dangereux, qu’il est bordé de Mandragores qui, la nuit, chantent au pied des arbres."
                                            },
                                            {
                                                "example_id": "4193aac7-9985-437d-a78b-2b2d89d82f38",
                                                "sense_id": "607da97e-2f37-3627-9fde-fc4433efb4f3",
                                                "text": "Le Maire. — C’est vrai ce qu’on raconte de la mandragore ?\nLe Droguiste. — Au sujet de la constipation ?\nLe Maire. — Non, au sujet de l’immortalité… Que les enfants conçus au-dessus d’une mandragore par un pendu deviennent des êtres démoniaques, et vivent sans terme ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
