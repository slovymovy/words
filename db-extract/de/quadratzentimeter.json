                "senses": [
                    {
                        "sense_id": "fbc2d0b2-6998-305f-b297-4146123035a1",
                        "entry_id": "57a83c01-572d-341d-8025-3b256f99f82b",
                        "glosses": [
                            "SI-Einheit als Flächenmaß, das der Fläche eines Quadrats mit der Seitenlänge eines Zentimeters entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff593a0-fd25-4521-89dd-66400eabaeda",
                                "sense_id": "fbc2d0b2-6998-305f-b297-4146123035a1",
                                "text": "Ein Kreis mit dem Radius von 10 Zentimetern hat einen Flächeninhalt von etwa 314 Quadratzentimetern."
                            },
                            {
                                "example_id": "237c8757-c33d-4ba2-bc1b-fa24f231b4a7",
                                "sense_id": "fbc2d0b2-6998-305f-b297-4146123035a1",
                                "text": "Ich habe jeden Quadratzentimeter des Zimmers abgesucht, aber nichts gefunden."
                            },
                            {
                                "example_id": "f4148a98-2b4b-474d-9f22-aaf45678bed5",
                                "sense_id": "fbc2d0b2-6998-305f-b297-4146123035a1",
                                "text": "„Es ist eiskalt, vollkommen dunkel und es herrscht ein enormer Druck von bis zu einer Tonne pro Quadratzentimeter — die Tiefsee scheint ein unwirtlicher Lebensraum zu sein.“"
                            },
                            {
                                "example_id": "26eef12e-5755-45ab-8c84-59a6e83c2eba",
                                "sense_id": "fbc2d0b2-6998-305f-b297-4146123035a1",
                                "text": "„Jeder Quadratzentimeter war verbaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
