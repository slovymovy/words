{
    "word_family": [
        "каждодневный"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "970b7992-c703-3cfb-877d-6f3bd5cae753",
                    "sense_definition": "Один из всех в данной группе или ряду; любой из однородных предметов или лиц.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Каждый> день приносит нам новые знания.",
                            "target_lang_translations": {
                                "en": "<Each> day brings us new knowledge.",
                                "cs": "<Každý> den nám přináší nové znalosti.",
                                "zh": "<每>一天都带给我们新的知识。"
                            }
                        },
                        {
                            "text": "Мы проверяем <каждую> деталь перед отправкой.",
                            "target_lang_translations": {
                                "en": "We check <every> detail before shipping.",
                                "cs": "Před odesláním kontrolujeme <každý> detail.",
                                "zh": "我们在发货前会检查<每>一个细节。"
                            }
                        },
                        {
                            "text": "<Каждую> весну мы ездим к морю.",
                            "target_lang_translations": {
                                "en": "<Every> spring we go to the sea.",
                                "cs": "<Každé> jaro jezdíme k moři.",
                                "zh": "<每>年春天我们都会去海边。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всякий",
                        "любой"
                    ],
                    "common_phrases": [
                        "каждый день",
                        "каждый раз",
                        "на каждом шагу",
                        "каждый год"
                    ],
                    "target_lang_definitions": {
                        "en": "One of a group considered individually; every single one in a series.",
                        "cs": "Jeden z celé skupiny nebo řady; každý jednotlivý prvek v souboru.",
                        "zh": "指群体中的每一个成员，强调个体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "every",
                                "target_lang_sense_clarification": "referring to all members of a group together"
                            },
                            {
                                "target_lang_word": "each",
                                "target_lang_sense_clarification": "referring to individual members of a group"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "každý",
                                "target_lang_sense_clarification": "označuje jednotlivé členy skupiny"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每",
                                "target_lang_sense_clarification": "用于名词前，表示每一个"
                            },
                            {
                                "target_lang_word": "各",
                                "target_lang_sense_clarification": "用于名词前，表示各个不同的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "41aa5792-8185-34ca-bd94-06ee4d60884f",
                    "sense_definition": "Любой человек; все люди в группе по отдельности.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Каждый> должен знать свои права и обязанности.",
                            "target_lang_translations": {
                                "en": "<Everyone> must know their rights and duties.",
                                "cs": "<Každý> by měl znát svá práva a povinnosti.",
                                "zh": "<每个人>都应该了解自己的权利和义务。"
                            }
                        },
                        {
                            "text": "В этой маленькой деревне <каждый> знает друг друга.",
                            "target_lang_translations": {
                                "en": "In this small village, <everyone> knows each other.",
                                "cs": "V této malé vesnici se <každý> zná s každým.",
                                "zh": "在这个小村庄里，<每个人>都互相认识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всякий",
                        "любой"
                    ],
                    "antonyms": [
                        "никто"
                    ],
                    "common_phrases": [
                        "каждый сам за себя"
                    ],
                    "target_lang_definitions": {
                        "en": "Every person; all people in a group.",
                        "cs": "Všichni lidé ve skupině bráni jednotlivě; kdokoli.",
                        "zh": "指群体中的所有人，强调每个人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "everyone",
                                "target_lang_sense_clarification": "all people"
                            },
                            {
                                "target_lang_word": "everybody",
                                "target_lang_sense_clarification": "all people (informal)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "každý",
                                "target_lang_sense_clarification": "všichni lidé v dané skupině"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每个人",
                                "target_lang_sense_clarification": "指代群体中的所有个体"
                            },
                            {
                                "target_lang_word": "大家",
                                "target_lang_sense_clarification": "指代群体中的所有人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}