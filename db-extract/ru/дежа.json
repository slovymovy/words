                    {
                        "translation_id": "72c5d7bc-92b9-49cc-99e5-0dd570f67f30",
                        "source_entry_id": "943fd4ed-3bbf-3d9a-8961-a1916981faad",
                        "target_lang_word": "Teigschale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b56ed49d-5702-40d1-b007-91a123c7ecb1",
                        "source_entry_id": "943fd4ed-3bbf-3d9a-8961-a1916981faad",
                        "target_lang_word": "Trog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                        "entry_id": "91e98e83-4c2b-369b-9e24-1b252555a18c",
                                        "glosses": [
                                            "größeres längliches Gefäß, in das man zum Beispiel Wasser oder Futter für Tiere gibt oder in dem Teig zubereitet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f505d7-b75e-4647-b1ec-52d055f9f9a6",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "Geh und füll Futter in den Trog! Die Schweine haben Hunger."
                                            },
                                            {
                                                "example_id": "79cd446b-6417-4b5e-9858-174bdbb716b6",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "Jeden Donnerstag knetete meine Großmutter den Teig für das Brot im Trog."
                                            },
                                            {
                                                "example_id": "98031ca2-b55f-460a-840e-c2624184c1a2",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "„Mit Marie und mit Mutter zankt sie ebenso wie mit mir, als ich nun auftauche und auf dem Hof nach einem Trog suche, um die Windeln zu waschen.“"
                                            },
                                            {
                                                "example_id": "f3519aa9-f503-42a5-bb49-f51a8c2838ff",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "„Man wusch sich an der Quelle, die hinterm Haus in einen Trog plätscherte.“"
                                            },
                                            {
                                                "example_id": "9d1c058c-b9af-44a5-8935-958df97882ff",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "„Dort hatten sich die meisten teils auf Stühlen, teils auf Baumstämmen und Trögen niedergelassen und sprachen von dem, was ihnen allen am nächsten lag, von den immer mehr und mehr um sich greifenden Pferdediebstählen.“"
                                            },
                                            {
                                                "example_id": "a6e43d5c-aabd-4236-b108-8d52cbddbcdf",
                                                "sense_id": "bcb275d9-99ce-396b-94f4-ca6a3f0d9077",
                                                "text": "„Wenn man die Schwelle überschritt, stieß man gegen einen steinernen Trog (einen gallo-römischen Sarkophag); dann fiel der Blick auf allerhand Metallgegenstände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "966dc9a9-9e70-35d1-8ee6-13107b445c18",
                                        "entry_id": "91e98e83-4c2b-369b-9e24-1b252555a18c",
                                        "glosses": [
                                            "Tiefdruckgebiet innerhalb der Strömung auf der Rückseite eines sich abbauenden Tiefdruckgebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8acbcdac-34b1-4975-8192-08d02c6d5f2a",
                                                "sense_id": "966dc9a9-9e70-35d1-8ee6-13107b445c18",
                                                "text": "Man spricht solange von einem Trog, wie die Zirkulation nicht abgeschlossen ist. Sobald es im Trogbereich zu einer abgeschlossenen Zirkulation kommt, spricht man von einem Trogtief."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "17b2b866-6d57-353c-9c01-66cf3ff20d7e",
                                        "entry_id": "91e98e83-4c2b-369b-9e24-1b252555a18c",
                                        "glosses": [
                                            "mit Sedimenten angefülltes Becken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee3f7b4-f430-4a43-bdc8-6b90a2b60af0",
                                                "sense_id": "17b2b866-6d57-353c-9c01-66cf3ff20d7e",
                                                "text": "Im Sauerland bildeten sich verschiedene Becken, so zum Beispiel der Hundem-Trog und der Lenne-Trog."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
