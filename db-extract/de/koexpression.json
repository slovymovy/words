                "senses": [
                    {
                        "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                        "entry_id": "3630fdcd-18f5-312f-a7ac-d63f6740583d",
                        "glosses": [
                            "simultane Expression zweier (beziehungsweise mehrerer) verschiedener Gene"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "4ababf65-feff-4beb-b4e4-fd4a1ab8b722",
                                "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                                "text": "Die Membran-Rezeptoren für verschiedene CSF unterliegen der Koexpression (werden koexprimiert)."
                            },
                            {
                                "example_id": "0375f44a-2fab-4550-b8b1-6b1cd08fd7aa",
                                "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                                "text": "Deshalb wurde ein Ansatz zur Koexpression der beiden Untereinheiten in einem E. coli-Stamm gewählt."
                            },
                            {
                                "example_id": "b98519ec-1b21-436a-b9f8-8b74fc8ef885",
                                "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                                "text": "Bei der B-Vorläufer-ALL eignet sich die Koexpression von CD19 und CD10."
                            },
                            {
                                "example_id": "9c4414b3-5367-48dd-b13b-a2b92005737d",
                                "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                                "text": "So spricht bspw. die Koexpression von CD33 auf einer CD34-positiven Zelle für eine myelomonozytär differenzierte und damit liniendeterminierte Vorläufer- oder Progenitorzelle."
                            },
                            {
                                "example_id": "2a2b7bf2-58b9-4abe-8b54-66ced4ad057a",
                                "sense_id": "e3fc007b-e6f6-34fa-b256-eead8d7a402e",
                                "text": "So ist die Ko-Expression der Zytokeratine Nr.8, 18, 19 und insbesondere 20 mit Neurofilamenten charakteristisch für Merkel-Zell-Karzinome, die anhand dieser Ko-Expression immunhistochemisch eindeutig identifizierbar sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
