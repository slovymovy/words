                "senses": [
                    {
                        "sense_id": "d61e46b3-6f65-3f00-96a1-5d885cfaa66f",
                        "entry_id": "259411a4-1597-374e-b47b-4476c11ff746",
                        "glosses": [
                            "To go up again; to rise another time."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f8b50823-f006-47f7-9668-3546d770d229",
                                "sense_id": "d61e46b3-6f65-3f00-96a1-5d885cfaa66f",
                                "text": "They remounted together to their sitting-room while Sir Claude, who said he would join them later, remained below to smoke and to converse with the old acquaintances that he met wherever he turned."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5092ad2-0b4f-333f-b200-d0e44082ab4d",
                        "entry_id": "259411a4-1597-374e-b47b-4476c11ff746",
                        "glosses": [
                            "To help (someone) back on a horse."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8bfe1115-22cb-3b2b-bad7-bb15f973b50f",
                        "entry_id": "259411a4-1597-374e-b47b-4476c11ff746",
                        "glosses": [
                            "To get back on a horse, bicycle etc."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3c24a909-2602-413c-962c-76c8acc86d4d",
                                "sense_id": "8bfe1115-22cb-3b2b-bad7-bb15f973b50f",
                                "text": "And, as it fell, his steed he ready found; / On whom remounting fiercely forth he rode […]"
                            },
                            {
                                "example_id": "a0aa309c-6472-4494-8534-468ae8d7481a",
                                "sense_id": "8bfe1115-22cb-3b2b-bad7-bb15f973b50f",
                                "text": "We remounted and took up the same hard tempo."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa83d046-306e-39f2-b3d1-506a0e49532b",
                        "entry_id": "259411a4-1597-374e-b47b-4476c11ff746",
                        "glosses": [
                            "To get back on (an animal, vehicle) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "26276f3a-7d3e-4ff8-8087-53f3259dd92b",
                                "sense_id": "aa83d046-306e-39f2-b3d1-506a0e49532b",
                                "text": "Still agitated, she watched resentfully as two traffic policemen remounted their motorcycles."
                            }
                        ]
                    },
                    {
                        "sense_id": "88939052-63c2-321b-9942-5b4b62288b5d",
                        "entry_id": "259411a4-1597-374e-b47b-4476c11ff746",
