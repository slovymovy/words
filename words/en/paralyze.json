{
    "word_family": [
        "paralysis",
        "paralytic"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13574c0e-1a04-398b-acf7-9941875888c9",
                    "sense_definition": "To make someone or something unable to move or act.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden shock seemed to <w>paralyze</w> him, leaving him unable to speak or move.",
                            "target_lang_translations": {
                                "zh": "突如其来的震惊似乎让他<w>瘫痪</w>了，导致他无法说话或移动。"
                            }
                        },
                        {
                            "text": "She was <w>paralyzed</w> with fear when she saw the large spider on the wall.",
                            "target_lang_translations": {
                                "zh": "当她看到墙上的大蜘蛛时，她被恐惧吓得<w>动弹不得</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immobilize",
                        "freeze"
                    ],
                    "common_phrases": [
                        "paralyzed with fear"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人或某物无法移动或行动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……瘫痪",
                                "target_lang_sense_clarification": "指因震惊、恐惧等心理因素导致无法动弹。"
                            },
                            {
                                "target_lang_word": "使……动弹不得",
                                "target_lang_sense_clarification": "强调因某种原因而无法做出任何动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3385c1b0-45c2-3bb4-9b21-ed6300072438",
                    "sense_definition": "To cause a system, organization, or process to stop functioning properly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snowstorm managed to <w>paralyze</w> the entire city for two days.",
                            "target_lang_translations": {
                                "zh": "那场大暴风雪使整座城市<w>瘫痪</w>了两天。"
                            }
                        },
                        {
                            "text": "A major computer failure <w>paralyzed</w> the company's operations during the busy morning hours.",
                            "target_lang_translations": {
                                "zh": "一次重大的电脑故障在繁忙的早晨时段使公司的业务陷入了<w>瘫痪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cripple",
                        "disable",
                        "halt"
                    ],
                    "common_phrases": [
                        "paralyze the city",
                        "paralyze operations"
                    ],
                    "target_lang_definitions": {
                        "zh": "使系统、组织或流程无法正常运作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……瘫痪",
                                "target_lang_sense_clarification": "指交通、系统或业务因突发状况而停滞。"
                            },
                            {
                                "target_lang_word": "使……陷入停顿",
                                "target_lang_sense_clarification": "指运作过程被迫中断或停止。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c68b2e5-bacc-37f2-9160-c3eb97f1e03e",
                    "sense_definition": "To cause a loss of muscle function or sensation in a part of the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident was severe enough to <w>paralyze</w> his legs permanently.",
                            "target_lang_translations": {
                                "zh": "那次事故非常严重，导致他的双腿永久性<w>瘫痪</w>。"
                            }
                        },
                        {
                            "text": "The disease can <w>paralyze</w> the muscles if it is not treated quickly.",
                            "target_lang_translations": {
                                "zh": "如果治疗不及时，这种疾病可能会导致肌肉<w>瘫痪</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "导致身体某部位失去肌肉功能或知觉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……瘫痪",
                                "target_lang_sense_clarification": "指医学上的肢体或器官失去功能。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}