                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le grand banquet, les serviteurs ont ramassé les <w>reliefs</w> du festin pour les cuisines."
                        },
                        {
                            "text": "Le chien attendait patiemment sous la table pour dévorer les <w>reliefs</w> du repas familial."
                        }
                    ],
                    "synonyms": [
