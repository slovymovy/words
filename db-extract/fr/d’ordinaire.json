                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Most of the time; less than always, but more than occasionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e958f07-9355-478e-a378-1ff94306a9e3",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "Except for one or two days a year, he usually walks to work."
                                            },
                                            {
                                                "example_id": "99b2aa89-3040-4c42-ab4e-38e00e966efb",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend ; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552ad584-410f-3d1a-8395-c0571badc9ed",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Under normal conditions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "512a2d0f-f0a5-4656-929a-23ef00a97d54",
                        "source_entry_id": "a6780226-13cb-3ce4-aceb-f0c7ac5a9f55",
                        "source_sense_id": "b94c564f-dc9a-37df-8def-28b1a90e8523",
