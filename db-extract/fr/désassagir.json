                "senses": [
                    {
                        "sense_id": "b27691b2-2e91-35f5-b6c7-71548525ec35",
                        "entry_id": "aa835039-bf7a-3909-89e2-e9825b963406",
                        "glosses": [
                            "Rendre moins sage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7840b0e-c126-4d7c-a941-5b023846e38a",
                                "sense_id": "b27691b2-2e91-35f5-b6c7-71548525ec35",
                                "text": "N'hésitez pas à jouer sur les camaïeux de couleurs, et osez la paire de sneakers à motifs pour désassagir la silhouette !"
                            },
                            {
                                "example_id": "c7863c60-5f9c-41c1-a459-635f1f60a098",
                                "sense_id": "b27691b2-2e91-35f5-b6c7-71548525ec35",
                                "text": "J'ai enfilé mes collants résille pour « désassagir » tout ça et contraster."
                            },
                            {
                                "example_id": "a4b2ca51-d7a6-4106-b206-4d7a4941fd4a",
                                "sense_id": "b27691b2-2e91-35f5-b6c7-71548525ec35",
                                "text": "Le cuir contribue, tout comme la croix qui constitue la boucle d'oreille, à désassagir la chemise et le haut, rendant le tout soudainement plus... sexy et attirant."
                            }
                        ]
                    }
