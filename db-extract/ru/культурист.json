                    {
                        "translation_id": "153e0ad0-0954-4843-a643-1274e420f409",
                        "source_entry_id": "bd4f06f8-79c0-3a0b-bdad-2a93e1dfbced",
                        "source_sense_id": "04fdc610-b15e-348f-9a96-ebdc8777776c",
                        "target_lang_word": "Bodybuilder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bodybuilder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                        "entry_id": "d367dffc-d21e-3f31-9188-175c5fcca127",
                                        "glosses": [
                                            "Sportler, der die Modellierung des Körpers durch gezielte Muskelübungen, in der Regel unter Verwendung von Fitnessgeräten durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa60c3d0-f20d-4fd1-9e9f-c453f5309eca",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Der amerikanische Fotograf Brian Finke fotografiert seit 2003 für seine Serie \"Most Muscular\" Bodybuilder und Bodybuilder-Wettkämpfe.“"
                                            },
                                            {
                                                "example_id": "783f33a7-daf7-4b9a-a489-507793ee9f19",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Ein Bodybuilder aus Münster ist an der Überdosis eines giftiges Muskelpräparats gestorben.“"
                                            },
                                            {
                                                "example_id": "29e24d47-b8b2-4881-84c5-2101a0201995",
                                                "sense_id": "74b93cc8-10b2-3385-9af0-ac754038ce8b",
                                                "text": "„Und wenn ich Pech habe, ist dieser Macker Bodybuilder, gewaltbereit und einen Kopf größer als ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
