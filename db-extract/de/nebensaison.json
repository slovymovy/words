                "senses": [
                    {
                        "sense_id": "d881d290-e9f8-3db8-8b88-b2227d416650",
                        "entry_id": "3f7b5858-57bd-31e0-a892-fc2eb1e6985d",
                        "glosses": [
                            "Zeitabschnitt des Jahres, in dem bestimmte Dinge, Vorhaben betrieben werden, aber weniger intensiv als in der Hochsaison"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad4eef3-e2d2-4b5d-b807-0d515ac77306",
                                "sense_id": "d881d290-e9f8-3db8-8b88-b2227d416650",
                                "text": "In vielen Regionen werden die Preise für Urlaubsquartiere in der Nebensaison gesenkt."
                            },
                            {
                                "example_id": "3ca50814-550e-4041-9f76-3521ac09b091",
                                "sense_id": "d881d290-e9f8-3db8-8b88-b2227d416650",
                                "text": "„Sollten Sie in der Nebensaison fahren, also im Frühjahr, Herbst oder Winter, schließen Sie eine Sandsturm-Versicherung ab.“"
                            },
                            {
                                "example_id": "6d844c51-468a-4f9a-ac0b-35e3317a035c",
                                "sense_id": "d881d290-e9f8-3db8-8b88-b2227d416650",
                                "text": "„Mir lag die Nebensaison.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
