            {
                "entry_id": "2f8f7696-56ce-322d-b647-93f02f1fcda6",
                "word": "quasi-synonyme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "22ac506c-243d-463c-8ef0-cae9a0c15ae6",
                        "entry_id": "2f8f7696-56ce-322d-b647-93f02f1fcda6",
                        "tags": [
                            "plural"
                        ],
                        "form": "quasi-synonymes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8ad9749-f264-3df4-a5bf-1f961d9555dd",
                        "entry_id": "2f8f7696-56ce-322d-b647-93f02f1fcda6",
                        "glosses": [
                            "Terme qui n’est interchangeable par son sens avec un autre que dans certains cas, selon le contexte, et sur une partie seulement de ses différentes acceptions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2950c8e-3358-4668-bf49-21cb52eeee59",
                                "sense_id": "f8ad9749-f264-3df4-a5bf-1f961d9555dd",
                                "text": "Volontaire et bénévole sont des quasi-synonymes."
                            },
                            {
                                "example_id": "24170035-c08a-4d38-a2b4-79c38384d1ca",
                                "sense_id": "f8ad9749-f264-3df4-a5bf-1f961d9555dd",
                                "text": "Adaptation et accoutumance (comme s'adapter et s'accoutumer) sont des quasi-synonymes. Interchangeables dans l'expression : « ce joueur de football s'adapte à son nouveau club », ils ne le sont pas dans l'expression : « cette caméra s'adapte à ce masque de plongée »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52fceb70-da6d-4114-8ce0-355c611a7637",
                        "source_entry_id": "2f8f7696-56ce-322d-b647-93f02f1fcda6",
                        "source_sense_id": "f8ad9749-f264-3df4-a5bf-1f961d9555dd",
                        "target_lang_word": "Quasisynonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quasisynonym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d115a1b-248a-359a-b999-0a4ab0424674",
                                        "entry_id": "060412fe-6b26-39b2-a9f4-1011714181f3",
                                        "glosses": [
                                            "ein Wort, das trotz unterschiedlicher Benennung zu einem anderen Wort beinahe die gleiche Bedeutung aufweist"
                                        ],
                                        "tags": [
                                            "lexikalische Semantik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f343c73-1683-44ce-b5ba-607ab710a284",
                                                "sense_id": "8d115a1b-248a-359a-b999-0a4ab0424674",
                                                "text": "Quasisynonyme für \"fuchteln\" sind beispielsweise \"gestikulieren\" und \"fuhrwerken\"."
                                            },
                                            {
                                                "example_id": "25842b91-d542-4213-b763-f7c7a9201b08",
                                                "sense_id": "8d115a1b-248a-359a-b999-0a4ab0424674",
                                                "text": "Die Fachausdrücke \"Quasisynonym\" und \"Verwandter Begriff\" werden in der Terminologie quasisynonym behandelt."
                                            },
                                            {
                                                "example_id": "99310640-6035-4eaf-a8ea-cedec77f0fde",
                                                "sense_id": "8d115a1b-248a-359a-b999-0a4ab0424674",
                                                "text": "Quasisynonyme sind zum Beispiel: finster/dunkel, groß/riesig, Ortsgruppe/Ortsverein, Prominenz/berühmte Persönlichkeit, Vegetationsgeographie/Pflanzengeographie, Ethik/Moralphilosophie, Hilfsmittel/Hilfsstoff, Beheizung/Etagenheizung, Sinn/Zweck, Sinn/Bewusstsein, Bücherei/Bibliothek, Arzt/Doktor, Schornstein/Rauchfang, etc."
                                            },
                                            {
                                                "example_id": "99bc3e6e-bd6f-4655-ad5f-946504155f19",
                                                "sense_id": "8d115a1b-248a-359a-b999-0a4ab0424674",
                                                "text": "„Da es reine Synonyme bei genauer Betrachtung in Fachsprachen und auch in der natürlichen Sprache kaum gibt, müssen die meisten sog. Synonyme als Quasisynonyme angesehen werden. In den Äquivalenzklassen der Thesauri sind sie dagegen als Nichtdeskriptoren per definitionem als Synonyme zu den dazugehörigen Deskriptoren ausgewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
