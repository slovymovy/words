                                        "sense_id": "d2161927-7f5b-328e-96f7-4840e670a44f",
                                        "entry_id": "14f8374e-6ec3-30a3-ba5a-a5056a80fb86",
                                        "glosses": [
                                            "Établissement hospitalier. Il n’a plus cette ancienne acception que dans :"
