                "senses": [
                    {
                        "sense_id": "7871f98f-b818-3ba5-8f15-be96279a512a",
                        "entry_id": "a1911563-162a-315b-9049-60db040ec944",
                        "glosses": [
                            "ein kurzer Nagel mit einem großflächigen, platten Kopf zum Anheften von Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8309cb03-f155-45af-8d46-85cb781477f3",
                                "sense_id": "7871f98f-b818-3ba5-8f15-be96279a512a",
                                "text": "An einer Heftzwecke kann man sich durchaus ernsthaft verletzen."
                            },
                            {
                                "example_id": "7a225c7f-78ce-4a05-a6af-f0946c06f36a",
                                "sense_id": "7871f98f-b818-3ba5-8f15-be96279a512a",
                                "text": "„An seinem Schreibtisch hingen ein Poster von Homer Simpson, ein Kalender der NASA, ein Poster mit dem Namen »Pale Blue Dot« und eine Kopie seiner Promotionsurkunde, die lediglich mit einer Heftzwecke an der Wand fixiert war.“"
                            },
                            {
                                "example_id": "1ed26f0a-1588-44f1-82d1-4b77e76a6bf0",
                                "sense_id": "7871f98f-b818-3ba5-8f15-be96279a512a",
                                "text": "„Einige waren mit Bleistift, Tinte oder Kohle direkt auf die Türfüllung geschrieben; die meisten jedoch auf Blätter, die mit Heftzwecken oder Klebpapier festgmacht worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
