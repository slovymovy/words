                                    {
                                        "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                        "entry_id": "de4d6815-7134-3c5a-b678-6f2e6e1a6349",
                                        "glosses": [
                                            "… mit dem Ziel, dass …"
                                        ],
                                        "tags": [
                                            "Konjunktion zur Begründung der Zielsetzung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31eda1a-0f39-4a65-b91f-1d2fc2b2617f",
                                                "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                                "text": "Es wurden Vorräte angelegt, damit es in Notzeiten nicht mangelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "damit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf ein Mittel, ein Werkzeug im direkten oder übertragenen Sinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9ca01e-cc09-4815-838b-ec98ed84919e",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Der Mann nahm den Hammer und trieb damit den Nagel in das Holz."
                                            },
                                            {
                                                "example_id": "7a0a6627-65e7-4e48-8deb-3f65c54586a6",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Damit kannst du ihn ruinieren."
                                            },
                                            {
                                                "example_id": "8eae5aa0-1b79-4bc0-a987-6c1fc61c73be",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf Zustände oder Sachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b276ed-22be-4719-98e0-6b784a6bf6f3",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Hier hast du eine Puppe, damit kannst du spielen."
                                            },
                                            {
                                                "example_id": "8eca93c9-40e0-4da8-b5db-99db04fffc83",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Der Räuber sah das Geld und rief: „Her damit!“"
                                            },
                                            {
                                                "example_id": "4fc89ce0-9469-4d96-bae5-a295bbd69165",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Damit hätte ich jetzt nicht gerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "zum Ausdruck einer zeitlichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b1ed6c-b726-466b-96e9-0d36ea9dfda3",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Im letzten Akt des Theaterstücks starb der Protagonist, damit endete auch das Stück."
                                            },
                                            {
                                                "example_id": "6f0dad9d-c6f0-4351-ba35-ecfad80ad145",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Und damit wäre ich am Ende meiner kleinen Geschichte angelangt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
