                                "sense_id": "f0f2e8d0-7747-391b-ade8-1798a0414392",
                                "text": "Popularnie rzecz ujmując, typ oleju określają dwa wskaźniki"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ece5c8bf-14aa-43a3-88ce-cd177d1fa3a2",
                        "source_entry_id": "e6208e97-8d9d-3724-aaa2-fe13f779e237",
