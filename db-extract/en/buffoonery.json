                    {
                        "translation_id": "306ec99d-a477-4530-aa96-bb09b68a30d2",
                        "source_entry_id": "d2fa18a7-0552-3457-bc0f-ae2a6fe66cbc",
                        "source_sense_id": "2cc54b08-67c6-358f-af7f-6c6e5a7f7fd3",
                        "source_sense_description": "behaviour expected of a buffoon — see also foolishness, silliness",
                        "target_lang_word": "Hanswurstiade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hanswurstiade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0d04fe-c041-37a0-bd0a-6242fbbd2564",
                                        "entry_id": "899754d0-5eb6-3e1e-ab36-03716d04bf07",
                                        "glosses": [
                                            "Verhalten wie ein Hanswurst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d932e9c3-f2b0-4201-a55f-a26523a5a9aa",
                                                "sense_id": "2c0d04fe-c041-37a0-bd0a-6242fbbd2564",
                                                "text": "„Niemals wäre mir das Vergnügen dieser Hanswurstiade zuteilgeworden, hätte ich den Mann offiziell – also »wahrhaftig« als Reporter –interviewt.“"
                                            },
                                            {
                                                "example_id": "821fbb59-3590-40e6-9444-caa6fc2e8792",
                                                "sense_id": "2c0d04fe-c041-37a0-bd0a-6242fbbd2564",
                                                "text": "„In Wahrheit blieb mir nicht einmal eine Erinnerung an jene Zeit, bis mich Dávilas Hanswurstiade darauf brachte, abgesehen von dem Leitmotiv, das mir immer wieder in den ungeahntesten Situationen über die Lippen kommt: ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac34f258-88e5-39d0-b8bb-9707b827345c",
                                        "entry_id": "899754d0-5eb6-3e1e-ab36-03716d04bf07",
                                        "glosses": [
                                            "Hanswurst-Spiel, Possenspiel mit Hanswurst in der Hauptrolle"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ffe323b-92d8-4c78-b672-3ebb4b3ac840",
                                                "sense_id": "ac34f258-88e5-39d0-b8bb-9707b827345c",
                                                "text": "„Der Begriff legt es nahe, dass es sich bei der Hanswurstiade um eine Gattung, genauer: eine Textsorte, handelt. Tatsächlich kann davon nicht die Rede sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
