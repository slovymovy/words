                    {
                        "sense_id": "a1b9792d-19b9-3131-a369-5469bc4e9957",
                        "entry_id": "780357fe-ed02-3b19-ab2a-f32c398b27dd",
                        "glosses": [
                            "Emitted outwards from a centre like rays."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                        "entry_id": "780357fe-ed02-3b19-ab2a-f32c398b27dd",
                        "glosses": [
                            "Having rays; radiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e4ac56-4786-403a-98ad-204ac8d2700e",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "Per Fess, Or, and Argent, a Rose irradiated Gules, therefrom issuant two Griphons' heads addorsed Sable. William Barlow."
                            },
                            {
                                "example_id": "a0ecd257-5bc4-47ae-9799-f3374e226f89",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "A Lion of England imperially crowned, between three roses gules in chief, and as many argent in base, barbed, seeded, and irradiated or […]"
                            },
                            {
                                "example_id": "4272b1cd-3d91-4025-a299-4699744959bd",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "[...] a naked child seized by a bear passant sable semee d'estoiles or, on a chief argent three roses gules irradiated."
                            },
                            {
                                "example_id": "494c2799-8c20-42ff-a1ec-dc0c4e35a879",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "Azure, on a cross quarterly pierced or, four chevrons gules, with an honourable augmentation, a chief argent, thereon a rose gules, irradiated gold, within a wreath of oak proper."
                            },
                            {
                                "example_id": "3eb55e47-2b4a-484b-983a-d62f43d31d4d",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "Quarterly : 1st and 4th, Sable, a fesse wavy between two estoiles irradiated argent, Drake; 2nd, Gules, on a bend or, a baton azure, on a chief the arms of[…]"
                            },
                            {
                                "example_id": "ec8fcb51-b3b1-4ff0-859c-45a8c7eaf796",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "[...] in her dexter hand a pair of scales or, and in her sinister a touchstone sable, her head irradiated."
                            },
                            {
                                "example_id": "8d559e8b-2b2c-496c-94b1-70ee1de5e128",
                                "sense_id": "d5f8681c-88fa-3074-a68a-db90ae0009ea",
                                "text": "Crest — Rising from the top of a lighthouse argent irradiated or a martlet azure."
                            }
                        ]
                    },
