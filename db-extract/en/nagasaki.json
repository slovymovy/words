    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4074c457-efc9-33f9-9af7-131184a7538a",
                "word": "Nagasaki",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8bb16def-9f67-3ef0-817e-e12daa91c340",
                        "entry_id": "4074c457-efc9-33f9-9af7-131184a7538a",
                        "glosses": [
                            "A port city, the capital and largest city of Nagasaki Prefecture, in southwestern Kyushu, Japan, famous as the country's early modern entrepot and for its nuclear bombing on 9 August 1945 at the end of World War II."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31af844-037d-4b8a-8a20-ec72e4eac2ae",
                                "sense_id": "8bb16def-9f67-3ef0-817e-e12daa91c340",
                                "text": "VINCENT: Tens of thousands killed before sundown; nobody's killed people that fast since Hiroshima and Nagasaki."
                            },
                            {
                                "example_id": "d6f4025b-aeb3-46c5-9644-be98da13fd58",
                                "sense_id": "8bb16def-9f67-3ef0-817e-e12daa91c340",
                                "text": "This slab is where the atomic bombs that were dropped on Hiroshima and Nagasaki 75 years ago were put together. It’s the assembly point for the dawning of the atomic age."
                            }
                        ]
                    },
                    {
                        "sense_id": "df34195c-ccf7-30ef-a0ca-922a4dda5bf4",
                        "entry_id": "4074c457-efc9-33f9-9af7-131184a7538a",
                        "glosses": [
                            "A prefecture of Japan."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be533ab8-7504-4a2b-a040-c8d768cfe5ff",
                        "source_entry_id": "4074c457-efc9-33f9-9af7-131184a7538a",
                        "source_sense_description": "Japanese port",
                        "target_lang_word": "Nagasaki",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nagasaki",
