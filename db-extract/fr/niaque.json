                    }
                ],
                "senses": [
                    {
                        "sense_id": "719c4aa6-a3b3-3259-b569-fc3a0f54c654",
                        "entry_id": "d51242ce-9208-3dad-899d-ec9c052fc2f8",
                        "glosses": [
                            "Variante orthographique de gnaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3967804-a28b-4717-a2e7-08fa901dfedc",
                                "sense_id": "719c4aa6-a3b3-3259-b569-fc3a0f54c654",
                                "text": "Elle avait retrouvé la niaque, ça faisait plaisir."
                            },
                            {
                                "example_id": "fa469890-de67-42af-bf83-097a0afa822d",
                                "sense_id": "719c4aa6-a3b3-3259-b569-fc3a0f54c654",
                                "text": "Boris Johnson explique la moisson de son pays par « la niaque, la volonté et le talent », en notant que les athlètes britanniques sont portés par « une foule supersonique » dans un contexte de « météo anglaise parfaite pour une garden fête (sic) »."
                            },
                            {
                                "example_id": "a0bf0d3c-c761-418e-a774-85b283575997",
                                "sense_id": "719c4aa6-a3b3-3259-b569-fc3a0f54c654",
                                "text": "La société réclame des individus qui ont de la niaque, plutôt que des gens sensibles."
                            },
                            {
                                "example_id": "c1abd212-8c30-4f97-9b5a-9c97af56d4ff",
                                "sense_id": "719c4aa6-a3b3-3259-b569-fc3a0f54c654",
                                "text": "Et puis, au bout d’un moment, c’est : vous pouvez gagner ou pas. C’est l’envie et la niaque."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
