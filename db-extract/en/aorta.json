                                                "example_id": "bdbea10f-791e-4f00-b23d-5221cb08c6b6",
                                                "sense_id": "86731a82-1c89-348c-b231-0bc1ea00fbe5",
                                                "text": "l'aorta è la più grande arteria del corpo umano, il suo compito è quello di distribuire il sangue ossigenato in tutto il corpo"
                                            }
