                "senses": [
                    {
                        "sense_id": "d686879f-d5c7-3623-a06b-fd6ce733cbb1",
                        "entry_id": "20c4fec3-488a-3c9f-bfbb-998b86414925",
                        "glosses": [
                            "Nut zur Verankerung eines Glases im Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5465550-5633-4abc-8288-da7157b4bf03",
                                "sense_id": "d686879f-d5c7-3623-a06b-fd6ce733cbb1",
                                "text": "„Bei Glasfalzen soll der Einstand zwischen den Leisten bei nicht vorgespannten Gläsern mindestens zwei Drittel der Glasfalzhöhe betragen, maximal jedoch 20 mm […].“"
                            },
                            {
                                "example_id": "c9ad47d5-b8ec-4ce0-be93-72b0d532d270",
                                "sense_id": "d686879f-d5c7-3623-a06b-fd6ce733cbb1",
                                "text": "„Für den Glasfalz ist das Ergebnis das gleiche wie bei einer ordnungsgemäß konzipierten und ausgeführten Fassade.“"
                            },
                            {
                                "example_id": "e1e76706-1d9a-43a2-ae48-ec4a6ace05d6",
                                "sense_id": "d686879f-d5c7-3623-a06b-fd6ce733cbb1",
                                "text": "„Sollen die Scheiben wiederverwendet werden, sind sie zerstörungsfrei aus dem Glasfalz zu lösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
