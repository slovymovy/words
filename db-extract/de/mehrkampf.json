                "senses": [
                    {
                        "sense_id": "cbc7c6e3-08e2-3ead-956f-f4ab270b9c56",
                        "entry_id": "60164da8-ce9a-3b97-9c55-116d84c31f51",
                        "glosses": [
                            "sportlicher Wettbewerb, der aus mehreren Teildisziplinen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0293e3d-ded3-4ef7-84fd-3bc0bb59929f",
                                "sense_id": "cbc7c6e3-08e2-3ead-956f-f4ab270b9c56",
                                "text": "„Um sich ihren Traum von Olympia zu erfüllen, muss Lisa bei der WM unter die ersten sechzehn im Mehrkampf kommen.“"
                            },
                            {
                                "example_id": "529645d4-c08e-4097-8f76-117619a7049e",
                                "sense_id": "cbc7c6e3-08e2-3ead-956f-f4ab270b9c56",
                                "text": "„Bei den Frauen besteht der Mehrkampf aus sieben Disziplinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb035e3a-b215-4faf-94c7-98fc33da2d3a",
                        "source_entry_id": "60164da8-ce9a-3b97-9c55-116d84c31f51",
                        "source_sense_id": "cbc7c6e3-08e2-3ead-956f-f4ab270b9c56",
                        "source_sense_description": "Sport: sportlicher Wettbewerb, der aus mehreren Teildisziplinen besteht",
                        "target_lang_word": "all-around",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all-around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecca929f-471b-3d10-85bc-52fa8d1d6826",
                                        "entry_id": "4512e531-1299-3e88-8065-87c82a50a2f8",
                                        "glosses": [
                                            "Able to do many or all things well."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f0fcf31-1f2b-4fad-adc7-14bf2bf41374",
                                                "sense_id": "ecca929f-471b-3d10-85bc-52fa8d1d6826",
                                                "text": "He is said to be a greater hunter and an all around sport."
                                            },
                                            {
                                                "example_id": "17817c73-60d4-4487-bd90-a278d9ff1851",
                                                "sense_id": "ecca929f-471b-3d10-85bc-52fa8d1d6826",
                                                "text": "If you want to polish your reputation as an all-around digital photographer, plan on developing at least a modicum of skill with a decent image editing program."
                                            },
                                            {
                                                "example_id": "dfa2042b-0e84-4501-9c86-0156c288974c",
                                                "sense_id": "ecca929f-471b-3d10-85bc-52fa8d1d6826",
                                                "text": "But it was as an all-around performer that Gill established his reputation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ef1252-af13-3d0b-aeb2-4b51d7955f73",
                                        "entry_id": "4512e531-1299-3e88-8065-87c82a50a2f8",
                                        "glosses": [
                                            "Comprehensive in extent."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2aa99c-d659-4bb4-a32e-fb53ac2f6c77",
                                                "sense_id": "e4ef1252-af13-3d0b-aeb2-4b51d7955f73",
                                                "text": "While Willie Mays's famous catch off the bat of Vic Wertz and Dusty Rhodes's clutch hitting are what fans remember most about the 1954 World Series, Thompson was easily the all-around best in those four games."
                                            },
                                            {
                                                "example_id": "dc476b84-0c63-4aee-8a04-9cceddd06534",
                                                "sense_id": "e4ef1252-af13-3d0b-aeb2-4b51d7955f73",
                                                "text": "Children must be given the opportunity to communicate in an all-around way, using language, drawing, music, drama, play, etc. (hence the expression \"a child has a hundred languages\")."
                                            },
                                            {
                                                "example_id": "02409370-5707-4895-bf05-9a0910c2b991",
                                                "sense_id": "e4ef1252-af13-3d0b-aeb2-4b51d7955f73",
                                                "text": "As mentioned above, the construction of modern population culture is an important and difficult task toward realizing the goal of population development for building a well-off society in an all-around way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all-around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                        "entry_id": "21721a76-30d2-3241-ad84-3381cdf33c50",
                                        "glosses": [
                                            "Generally, broadly."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be4f01ac-2d57-4e59-b062-23986fbafc68",
                                                "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                                "text": "an all-around better player than me"
                                            },
                                            {
                                                "example_id": "26436593-3e78-4432-a278-8028145ec6c8",
                                                "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                                "text": "Vacation with pay, annual passes, and all around better working conditions."
                                            },
                                            {
                                                "example_id": "59ca24e9-d1ed-4390-9340-8a3d009d54a6",
                                                "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                                "text": "In addition, be sure to reinforce - as persistently as possible - that addressing questionable behavior makes for an all-around better organization."
                                            },
                                            {
                                                "example_id": "2b6d47ea-8953-4ab9-9c53-8d4f5ddd7559",
                                                "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                                "text": "He graduated from the Police Academy in 1957 winning the Police Commissioner's Trophy for all around highest scores-academically, physically, and for firearm proficiency."
                                            },
                                            {
                                                "example_id": "1e9136b0-4f2d-43d9-acad-c5c7c0f07b6c",
                                                "sense_id": "9a3267fa-d19d-377e-8a09-24a96cf6ca25",
                                                "text": "Collectively, the three sections in this chapter are intended to add to what has gone before regarding personal behavior and to serve as additional food for thought for those attempting to be all-around better people."
                                            }
                                        ]
                                    }
                                ]
                            },
