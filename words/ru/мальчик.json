                    "sense_definition": "ребёнок или подросток мужского пола",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький <w>мальчик</w> играет в песочнице с машинками.",
