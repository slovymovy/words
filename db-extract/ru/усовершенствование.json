                    }
                ],
                "translations": [
                    {
                        "translation_id": "60e52e6c-64d1-45a7-83ab-e020daf122f6",
                        "source_entry_id": "2d811dd8-e778-3569-8388-c9eef3fe2466",
                        "source_sense_id": "5ea17a8b-09fd-37bc-bd31-224693bff353",
                        "target_lang_word": "Vervollkommnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vervollkommnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                        "entry_id": "dde41519-9c8b-3079-ac04-7fe32c8f539e",
                                        "glosses": [
                                            "Handlung, Vorgang, etwas so verbessern, bis es komplett richtig/gut (vollkommen) ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d7854d-9925-4145-b73e-3faacb5f87ec",
                                                "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                                "text": "„Das war der kleine Anfang, und damals galt eine Briefwahl auch ausschließlich als gute Sache, als Vervollkommnung des Wahlrechts.“"
                                            },
                                            {
                                                "example_id": "8450f55d-886b-4bd4-ae4c-5c7a09e2d724",
                                                "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                                "text": "„Die Vervollkommnung der Technik hinterlässt Spuren an unserem filmischen Erbe.“"
                                            },
                                            {
                                                "example_id": "3227aa85-b65e-4a16-a836-59eb095718eb",
                                                "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                                "text": "„Dann der Bruch, das Trauma der Trennung und damit Entfremdung, Vereinsamung, das jedoch ebenfalls in der Natur angelegt ist, weil der Mensch nach Erkenntnis, nach Herrschaft, nach Vervollkommnung strebt.“"
                                            },
                                            {
                                                "example_id": "a923843a-2c2b-487d-bf29-35659268d9a1",
                                                "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                                "text": "„Auch wenn, wie die großen Kraken versichern, mit den Informationen nicht unmittelbar gehandelt wird – sie werden ausgewertet und zur Vervollkommnung der Systeme verwertet.“"
                                            },
                                            {
                                                "example_id": "68953523-a17d-45ec-86c3-13b2e486fd33",
                                                "sense_id": "ae3ed895-24c1-3656-8a25-94595a615638",
                                                "text": "„In den Jahren nach 1784 durfte er seine Talente als wortgewandter Verfechter einer Vervollkommnung der Menschheit durch Reden und Aufsätze in den Illuminatenversammlungen beweisen; erst in Gotha, dann auch in Jena.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "353a28db-7a83-3e96-96ca-d7e2770ee023",
                                        "entry_id": "dde41519-9c8b-3079-ac04-7fe32c8f539e",
                                        "glosses": [
                                            "etwas, was verbessert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a371db-a9ee-46e6-ba2c-32789e6a81ea",
                                                "sense_id": "353a28db-7a83-3e96-96ca-d7e2770ee023",
                                                "text": "„Selten, ganz selten ist so gesagt worden, dass jede Vervollkommnung der Technik eine Vervollkommnung der Kunst selbst ist, dass sie den Inhalt, den verborgenen Sinn enthüllt und als Inkarnation der Kunst sinnenfällig wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
