                "senses": [
                    {
                        "sense_id": "f79889e8-686d-326a-a79d-a7f609f8fa69",
                        "entry_id": "6d14a961-b716-38c4-9555-7441013cebee",
                        "glosses": [
                            "Chimiste dont la spécialité est la biochimie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d6e599-7adb-4a9e-af79-f956fff3e1db",
                                "sense_id": "f79889e8-686d-326a-a79d-a7f609f8fa69",
                                "text": "Le lecteur curieux découvrira dans cet ouvrage tous les éléments que peut souhaiter un herpétologiste amateur ou chevronné, un étudiant en biologie animale ou un biochimiste intéressé par les venins de ces animaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29b85d52-692f-40a7-8919-2b192d27e4ac",
                        "source_entry_id": "6d14a961-b716-38c4-9555-7441013cebee",
                        "source_sense_id": "f79889e8-686d-326a-a79d-a7f609f8fa69",
                        "target_lang_word": "Biochemiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biochemiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf3d1bb3-3932-3593-83d3-083f4ae6b267",
                                        "entry_id": "5deb7012-3189-3c08-9f5d-aeedd4d7d9d6",
                                        "glosses": [
                                            "wissenschaftlicher Fachmann auf dem Gebiet der Biochemie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d80ead65-62bb-4766-8b2e-a7994d392ad7",
                                                "sense_id": "cf3d1bb3-3932-3593-83d3-083f4ae6b267",
                                                "text": "„Heute zeichnet sich für Pharmakologen, Toxikologen und Biochemiker immer deutlicher ab: Viele pflanzliche Stoffe, die in großen Mengen giftig sind, können bei niedriger Dosierung die Gesundheit fördern.“"
                                            },
                                            {
                                                "example_id": "d34b5c54-3a7a-479a-ab6a-e3f75c205507",
                                                "sense_id": "cf3d1bb3-3932-3593-83d3-083f4ae6b267",
                                                "text": "„Deswegen sind es inzwischen nicht mehr Philosophen, sondern Neurowissenschaftler, Biochemiker und Hirnforscher, die fundierte Aussagen über die Willensfreiheit des Menschen machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
