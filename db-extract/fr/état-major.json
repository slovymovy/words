                                        "examples": [
                                            {
                                                "example_id": "c201c7ce-4ebf-4e14-b436-397e33826d47",
                                                "sense_id": "32b5dc0c-0ca3-3b33-8eec-b1ca1fd5be3e",
                                                "text": "As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            },
