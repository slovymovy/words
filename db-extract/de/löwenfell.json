                "senses": [
                    {
                        "sense_id": "c4227a4d-26b3-3982-991d-336c7ba9c199",
                        "entry_id": "fdd23b94-84b9-3d56-8c4e-e045951b015b",
                        "glosses": [
                            "(abgezogenes) Fell eines Löwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769b1486-8bde-40fb-af7b-bfe13aa24660",
                                "sense_id": "c4227a4d-26b3-3982-991d-336c7ba9c199",
                                "text": "„Vielleicht war das Löwenfell für die modebewusste Römerin dasselbe, was für die neuzeitliche Frau ein teurer, von seltenem Getier – wie Nerz oder Zobel – stammender Mantel ist; der Löwe kam wohl, ob aus Nachschubmangel oder aus Gründen des Tierschutzes, irgendwann aus der Mode.“"
                            },
                            {
                                "example_id": "f1b4a08d-e043-47d3-b24f-ba412257bfdf",
                                "sense_id": "c4227a4d-26b3-3982-991d-336c7ba9c199",
                                "text": "„Denn sie steht nicht nur mit eng aneinandergepressten Oberschenkeln da, sondern hat das Ende des Löwenfelles so um die Hüfte nach vorn geschlungen, dass es mit der Hintertatze zwischen ihren Oberschenkeln herabhängt und die Scham verdeckt.“"
                            },
                            {
                                "example_id": "122dd3e0-7b3b-41b0-87df-393ffa75b8f5",
                                "sense_id": "c4227a4d-26b3-3982-991d-336c7ba9c199",
                                "text": "„Römische Frauen trugen keine Löwenfelle. Daher ist auch kein einziger Fall bekannt, in dem eine solche Darstellung zu Werbezwecken verwendet worden wäre, etwa an der Fassade eines Ladens für exotische Bekleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
