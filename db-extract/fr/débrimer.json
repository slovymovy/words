                "senses": [
                    {
                        "sense_id": "f2a5ae36-797b-3428-834e-73fbd1c5d1c7",
                        "entry_id": "9efc3579-ca4d-3435-807b-bd7541ebaf1e",
                        "glosses": [
                            "Cesser de brimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7112a5da-646c-4654-80a6-b2c9273ae2f5",
                                "sense_id": "f2a5ae36-797b-3428-834e-73fbd1c5d1c7",
                                "text": "Sir Popoff fait le dos rond ; les mômes le débriment en le laissant prendre l’air."
                            },
                            {
                                "example_id": "bd3f1942-51a6-484e-af10-f7a9b898eb39",
                                "sense_id": "f2a5ae36-797b-3428-834e-73fbd1c5d1c7",
                                "text": "Quand la moitié de la population est brimée par une loi sexiste, le premier souci est de la débrimer par l’abolition de la loi sexiste."
                            },
                            {
                                "example_id": "5df33ca9-27d2-46ec-a428-176f1fe1f385",
                                "sense_id": "f2a5ae36-797b-3428-834e-73fbd1c5d1c7",
                                "text": "Libéré, Jean-Yves entreprend des paysages \"débrimés\" dans la série \"Le Chemin ocre-rouge\"."
                            }
                        ]
                    }
