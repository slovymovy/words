    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                "word": "tooltip",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0a9d7d93-85cc-48d8-89e6-fbb5d2e05ef1",
                        "entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                        "tags": [
                            "plural"
                        ],
                        "form": "tooltips"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f2d4575-9626-3263-a9bd-f191a510aa0b",
                        "entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                        "glosses": [
                            "An element of a graphical user interface in the form of a box of text that appears when a cursor is made to hover over an item; normally used to explain the function of the item."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66241eb3-ca6a-42d5-9450-0f93ac9ab885",
                        "source_entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                        "source_sense_id": "1f2d4575-9626-3263-a9bd-f191a510aa0b",
                        "source_sense_description": "an element of a graphical user interface",
                        "target_lang_word": "infobulle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infobulle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                                        "entry_id": "3cfaf0cf-fbb0-3396-9203-04c58919459b",
                                        "glosses": [
                                            "Information qui s’affiche lorsque le curseur de la souris passe au-dessus d’un objet graphique (tel un bouton, un hyperlien…)."
                                        ],
                                        "tags": [
                                            "Interface graphique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c06fcde-d5ae-4e57-b384-d28a8ab6ce28",
                                                "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                                                "text": "Chaque fois que le pointeur de la souris survole une commande, une infobulle s'affiche pour en décrire la fonction et éventuellement indiquer le raccourci clavier associé."
                                            },
                                            {
                                                "example_id": "bac3e436-b813-4340-b9f8-fe38213234d5",
                                                "sense_id": "a1e495bc-d72f-30a4-97aa-ba500e880c4b",
                                                "text": "Les infobulles apparaissent lorsque vous pointez votre souris sur une option ou une icône. Elles permettent de décoder une image ou d'expliquer brièvement l'intérêt d'une fonctionnalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c10cc23-6210-4d58-ad25-b33e86c5448a",
                        "source_entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                        "source_sense_id": "1f2d4575-9626-3263-a9bd-f191a510aa0b",
                        "source_sense_description": "an element of a graphical user interface",
                        "target_lang_word": "Tooltip",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b6183b5-8c1e-46e1-9512-da19bfa402d1",
                        "source_entry_id": "a7517024-43f9-3099-9223-aa916d163481",
                        "source_sense_id": "1f2d4575-9626-3263-a9bd-f191a510aa0b",
                        "source_sense_description": "an element of a graphical user interface",
                        "target_lang_word": "подска́зка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подска́зка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "13cb2bac-1908-3e4b-a3db-1a5978aa1c0b",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "даваемый совет, намёк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776992d3-b865-4888-b6e6-1e08b7f7ff58",
                                                "sense_id": "13cb2bac-1908-3e4b-a3db-1a5978aa1c0b",
                                                "text": "Но ведь эту же теорию сам без всякой подсказки открыл безграмотный чегемский крестьянин по имени Камуг, которого многие чегемцы принимали за сумасшедшего, хотя и неопасного для жизни людей."
                                            },
                                            {
                                                "example_id": "0ea068db-6e9f-46a7-a11e-a4e2c0df59f2",
                                                "sense_id": "13cb2bac-1908-3e4b-a3db-1a5978aa1c0b",
                                                "text": "Прошлой весной, когда они приехали, домики в новом поселке только еще достраивались, квартир не хватало, и дочь по чьей-то подсказке привезла свою старуху в Матёру, где появились свободные избы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fea228b-8d6b-3f0f-a199-5c9ff55ba30c",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "слова, помогающие вспомнить что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb1b51f-b547-47e1-ae5e-35f43ee3e681",
                                                "sense_id": "2fea228b-8d6b-3f0f-a199-5c9ff55ba30c",
                                                "text": "Во время пения, случалось, Булат забывал строчку, спотыкался, останавливался, и тотчас из зала неслись подсказки, народ знал его песни наизусть."
                                            },
                                            {
                                                "example_id": "34939801-7ea0-4772-8d75-469f88c35777",
                                                "sense_id": "2fea228b-8d6b-3f0f-a199-5c9ff55ba30c",
                                                "text": "После таких подсказок Савелий, конечно, вспомнил паренька. Они действительно сидели с ним в одной камере во время следствия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e864c040-056f-3c0e-beb7-91567b3f0fd2",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "обстоятельство, указывающее на что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9538710b-a3d5-4a05-a834-c48fd1e5f83e",
                                                "sense_id": "e864c040-056f-3c0e-beb7-91567b3f0fd2",
                                                "text": "Подсказкой, что это именно ушедшие под воду острова, стал характер рельефа и состав пород, из которых они сложены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2be4fde-e33c-3732-9597-7f75b2c6b294",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "сказанное шёпотом указание, что говорить, что отвечать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3569887-d34f-422c-86dd-3b7452851388",
                                                "sense_id": "e2be4fde-e33c-3732-9597-7f75b2c6b294",
                                                "text": "подсказка суфлёра"
                                            },
                                            {
                                                "example_id": "2b24a816-30e7-4399-9673-dc728b6fa5df",
                                                "sense_id": "e2be4fde-e33c-3732-9597-7f75b2c6b294",
                                                "text": "Вот вы, Надежда Сергеевна, поставили мне двойку за подсказки. А Сьяновой все время подсказывали. Кто? Вот и скажу ― Парисова подсказывала, Слаутин, Вяльцев…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eba94bc-c426-3352-a684-2f4abb3605a8",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "разг. то же, что шпаргалка; листок бумаги или иной носитель информации со справочным материалом или подготовленными ответами на вопросы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170298a4-1333-4753-9994-a4dd92c1a5a6",
                                                "sense_id": "7eba94bc-c426-3352-a684-2f4abb3605a8",
                                                "text": "Снова делает паузу, заглядывает в листок-подсказку, потом поднимает голову, чтобы осмотреть зал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517953ae-01c2-32dc-b16e-5a3266b15fc6",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "комп. элемент графического интерфейса, как правило в виде автоматически всплывающего текста или окна, служащий средством обучения пользователя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "663df39d-e592-4ed9-90ea-d2808922d545",
                                                "sense_id": "517953ae-01c2-32dc-b16e-5a3266b15fc6",
                                                "text": "Наиболее распространенный вариант использования всплывающей подсказки — пояснения для элементов управления, не имеющих текстовой метки"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa09943d-3a11-3b21-8fd8-99d60730e072",
                                        "entry_id": "e8530e84-5132-3cd3-ab45-c3fc2f7b1795",
                                        "glosses": [
                                            "прогр. дополнительное указание в запросе в базу данных, позволяющее явным образом влиять на план выполнения запроса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14379118-6164-4595-ac30-6294449f673f",
                                                "sense_id": "aa09943d-3a11-3b21-8fd8-99d60730e072",
                                                "text": "Применять подсказки рекомендуется только опытным программистам, понимающим суть алгоритмов, стоящих за этими подсказками, после того, как такие меры повышения эффективности запроса, как модификация статистики таблиц, перетрансляция хранимых процедур для внутренних запросов, добавление или изменение индексов и пересмотр записи выражений для поиска, не дали ощутимого результата."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
