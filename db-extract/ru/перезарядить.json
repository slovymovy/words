                                                "example_id": "e122ceb5-b908-446c-92a5-cca79fc027cb",
                                                "sense_id": "ac94fcc9-4e7b-3279-8272-fde9fed2d1e8",
                                                "text": "Near-synonyms: relax, unwind"
                                            },
