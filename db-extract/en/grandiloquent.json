                                        "entry_id": "87eec47d-364c-350c-a6b1-afe39266e3eb",
                                        "glosses": [
                                            "projevující se nemírným vyjadřováním, zejména o sobě samém, slibující nereálné, vyvolávající nerealistická očekávání; který toho hodně namluví, ale málo (vy)koná"
                                        ],
