                                "target_senses": [
                                    {
                                        "sense_id": "0da583c4-fa36-3270-9570-eed827548c52",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Unable to contain or retain."
