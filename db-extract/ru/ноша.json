                                "target_senses": [
                                    {
                                        "sense_id": "2dc53214-348b-3ca3-88ec-0900023f9a73",
                                        "entry_id": "a5576e7a-7a34-3c22-a2e5-d395bcd89fcc",
                                        "glosses": [
                                            "A phrase or theme that recurs at the end of each verse in a folk song or ballad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24db904f-6e13-4247-8a27-55bc35c5aa7a",
                                                "sense_id": "2dc53214-348b-3ca3-88ec-0900023f9a73",
                                                "text": "Foot it featly here and there; / And, sweet sprites, the burden bear."
                                            },
                                            {
                                                "example_id": "f0435f62-5823-4067-8019-175eb7b34672",
                                                "sense_id": "2dc53214-348b-3ca3-88ec-0900023f9a73",
                                                "text": "As commonly used, the refrain, or burden, not only is limited to lyric verse, but depends for its impression upon the force of monotone - both in sound and thought."
                                            }
