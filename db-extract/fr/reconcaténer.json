                        "glosses": [
                            "Concaténer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbaff6f-9022-42c2-a835-ad99b3c2176b",
                                "sense_id": "5b22d378-265f-3cec-9c65-34ab862f0f16",
                                "text": "Pratiquant et renouvelant sans cesse l’exercice solennel ou facétieux de la narration, ils ne se lassent jamais de morceler les mots, de les déconcaténer et de les reconcaténer, de prêter l’oreille aux effets acoustiques et de saisir les opportunités sémantiques auxquelles ils parviennent."
                            },
                            {
                                "example_id": "f6efce2a-ab19-4da5-b516-60ab269ca6b4",
                                "sense_id": "5b22d378-265f-3cec-9c65-34ab862f0f16",
                                "text": "Tous les unix et donc Mac OS X ont la commande cat pour reconcaténer les fichiers."
                            }
                        ]
                    }
