    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44d1a2d2-d813-3fa7-973c-a218b973e99b",
                    "sense_definition": "Een rechthoekig stuk stof, meestal van katoen, dat op een matras wordt gelegd of waaronder men slaapt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet de <w>lakens</w> van mijn bed vandaag verschonen.",
                            "target_lang_translations": {
                                "en": "I need to change the <w>sheets</w> on my bed today.",
                                "ru": "Мне нужно сегодня сменить <w>простыни</w> на кровати.",
                                "zh": "我今天得换一下床上的<w>床单</w>。"
                            }
                        },
                        {
                            "text": "Het kind kroop lekker warm onder het <w>laken</w>.",
                            "target_lang_translations": {
                                "en": "The child crawled snugly under the <w>sheet</w>.",
                                "ru": "Ребенок уютно устроился под <w>простыней</w>.",
                                "zh": "孩子暖和地钻进了<w>床单</w>下面。"
                            }
                        },
                        {
                            "text": "In dit huis is zij degene die de <w>lakens</w> uitdeelt.",
                            "target_lang_translations": {
                                "en": "In this house, she is the one who calls the <w>shots</w>.",
                                "ru": "В этом доме она всем <w>заправляет</w>.",
                                "zh": "在这个家里，她是那个说了算的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beddenlaken",
                        "bedlaken"
                    ],
                    "common_phrases": [
                        "de lakens uitdelen",
                        "onder de lakens",
                        "witte lakens",
                        "tussen de lakens"
                    ],
                    "target_lang_definitions": {
                        "en": "A rectangular piece of fabric, usually cotton, placed on a mattress or used as a covering while sleeping",
                        "ru": "Прямоугольный кусок ткани, обычно из хлопка, который кладут на матрас или под которым спят",
                        "zh": "一种长方形的布，通常是棉制的，铺在床垫上或睡觉时盖在身上。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sheet",
                                "target_lang_sense_clarification": "bedding"
                            },
                            {
                                "target_lang_word": "bed sheet",
                                "target_lang_sense_clarification": "bedding"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "простыня",
                                "target_lang_sense_clarification": "постельное белье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "床单",
                                "target_lang_sense_clarification": "床上用品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4c4fdff-3655-3a1b-a834-d44165b600fa",
                    "sense_definition": "Een geweven en daarna vervilte wollen stof, vroeger veel gebruikt voor kleding en nu nog voor biljarttafels",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het biljart in het café is bedekt met groen <w>laken</w>.",
                            "target_lang_translations": {
                                "en": "The billiard table in the pub is covered with green <w>baize</w>.",
                                "ru": "Бильярдный стол в кафе покрыт зеленым <w>сукном</w>.",
                                "zh": "咖啡馆里的台球桌铺着绿色的<w>台呢</w>。"
                            }
                        },
                        {
                            "text": "In de middeleeuwen was de handel in <w>laken</w> erg belangrijk voor de stad.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, the trade in <w>broadcloth</w> was very important for the city.",
                                "ru": "В Средние века торговля <w>сукном</w> была очень важна для города.",
                                "zh": "在中世纪，<w>呢绒</w>贸易对这座城市非常重要。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A woven and subsequently felted woolen fabric, historically used for clothing and still used for billiard tables",
                        "ru": "Плотная шерстяная ткань с ворсом, исторически использовавшаяся для одежды, а ныне — для покрытия бильярдных столов",
                        "zh": "一种经过织造和缩绒处理的羊毛织物，历史上常用于制作服装，现在仍用于台球桌台面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "broadcloth",
                                "target_lang_sense_clarification": "historical textile"
                            },
                            {
                                "target_lang_word": "baize",
                                "target_lang_sense_clarification": "for billiard tables"
                            },
                            {
                                "target_lang_word": "cloth",
                                "target_lang_sense_clarification": "textile"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сукно",
                                "target_lang_sense_clarification": "шерстяная ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呢绒",
                                "target_lang_sense_clarification": "纺织品"
                            },
                            {
                                "target_lang_word": "台呢",
                                "target_lang_sense_clarification": "台球桌用布"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7036945e-8c38-3023-8d48-3fa314be6d1b",
                    "sense_definition": "Meervoud van <w>laak</w> (een grenswater of kleine waterloop)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>lakens</w> in het landschap vormen natuurlijke grenzen tussen de weilanden.",
                            "target_lang_translations": {
                                "en": "The old <w>watercourses</w> in the landscape form natural boundaries between the meadows.",
                                "ru": "Старые <w>водотоки</w> в ландшафте образуют естественные границы между лугами.",
                                "zh": "景观中那些古老的<w>水道</w>构成了草地之间的天然边界。"
                            }
                        },
                        {
                            "text": "Op de kaart kun je zien waar de verschillende <w>lakens</w> samenkomen.",
                            "target_lang_translations": {
                                "en": "On the map you can see where the different <w>streams</w> meet.",
                                "ru": "На карте можно увидеть, где сходятся различные <w>водотоки</w>.",
                                "zh": "在地图上你可以看到不同的<w>溪流</w>在哪里汇合。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of laak"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'laak' (a boundary water or small watercourse)",
                        "ru": "Небольшие естественные водотоки или пограничные воды (множественное число от laak)",
                        "zh": "laak的复数形式（指边界水域或小型水道）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watercourses",
                                "target_lang_sense_clarification": "geography"
                            },
                            {
                                "target_lang_word": "streams",
                                "target_lang_sense_clarification": "geography"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "водотоки",
