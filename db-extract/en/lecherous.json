                    {
                        "translation_id": "45b52ba7-ce18-4b54-b6d1-19e1f0ed2eb8",
                        "source_entry_id": "8db5b140-de8e-3d9b-89dd-06af5db31618",
                        "source_sense_id": "f0e70748-1a29-3ed7-903f-6253d86f522e",
                        "source_sense_description": "given to a lustful craving of sexual activities",
                        "target_lang_word": "lüstern",
