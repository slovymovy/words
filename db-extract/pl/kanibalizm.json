                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d456c25f-73f7-4f8d-9897-92a92d6760a2",
                        "source_entry_id": "aff8b5a9-5f88-31c4-a497-7b61f6be7b0a",
                        "source_sense_id": "681f7222-866c-3824-9e89-5c1b916eb744",
                        "target_lang_word": "cannibalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannibalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55e48db1-dc8f-31f1-976c-21da5d296678",
                                        "entry_id": "63f56c05-f553-34b1-a15c-67c90622f8a5",
                                        "glosses": [
                                            "Cruauté digne des cannibales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e925c-d35d-4986-af87-39b668f50f0c",
                                                "sense_id": "55e48db1-dc8f-31f1-976c-21da5d296678",
                                                "text": "Pour d’autres auteurs le cannibalisme répond à une nécessité beaucoup plus qu’à un goût particulier pour la chair humaine ou qu'à des croyances religieuses."
                                            },
                                            {
                                                "example_id": "26ac0790-46df-4fb9-9f84-f4ccc27525a7",
                                                "sense_id": "55e48db1-dc8f-31f1-976c-21da5d296678",
                                                "text": "Lorsque a commencé en Afrique la colonisation à proprement parler, la métaphore du cannibalisme a été adoptée par les Européens, qui l’ont retournée contre les Africains. C’étaient maintenant les Africains qui étaient les cannibales, mangeurs de missionnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc3da3b-c1fc-3104-9744-5f07f3950874",
                                        "entry_id": "63f56c05-f553-34b1-a15c-67c90622f8a5",
                                        "glosses": [
                                            "Comportement anormal d’une mère, qui au lieu de soigner et protéger son ou ses jeunes les rejette ou même s’attaque à eux."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac7fba2e-3c27-36e4-ae69-01f927ad811b",
                                        "entry_id": "63f56c05-f553-34b1-a15c-67c90622f8a5",
                                        "glosses": [
                                            "Comportement anormal des animaux d’un élevage qui se mordent entre eux tels les porcelets ou les porcs à l’engraissement."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b38e656c-2433-3a46-bfbd-a2b893dd35f9",
                                        "entry_id": "63f56c05-f553-34b1-a15c-67c90622f8a5",
                                        "glosses": [
                                            "Pratique consistant à manger une ou plusieurs parties d’un membre de la même espèce, par nécessité ou par instinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7d02d3-2106-498d-bfb7-3fcdf216ff75",
                                                "sense_id": "b38e656c-2433-3a46-bfbd-a2b893dd35f9",
                                                "text": "Un homme de 41 ans soupçonné de meurtre et de cannibalisme sur un autre quadragénaire est en détention provisoire à Berlin, après la découverte d'ossements humains dépourvus de chair dans un parc, a annoncé la justice hier."
                                            },
                                            {
                                                "example_id": "2201b82f-0213-4f53-9a1a-6f619260be26",
                                                "sense_id": "b38e656c-2433-3a46-bfbd-a2b893dd35f9",
                                                "text": "« C'est une histoire plus ou moins bien documentée. C'est sûr qu'il y a pas grand monde qui se vante de ça, historiquement parlant », affirme Laura Shine à propos de l'histoire du cannibalisme, qui remonterait à l'homme de Néandertal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2082cb7a-e994-4c52-8d14-22b5a6e4cd65",
                        "source_entry_id": "aff8b5a9-5f88-31c4-a497-7b61f6be7b0a",
                        "source_sense_id": "681f7222-866c-3824-9e89-5c1b916eb744",
                        "target_lang_word": "canibalismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canibalismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3b873a-3769-3d74-a3e6-96cca20af85f",
                                        "entry_id": "c603806a-d20f-3705-89f1-166b26a95328",
                                        "glosses": [
                                            "Calidad de caníbal"
                                        ],
                                        "tags": [],
