{
    "word_family": [
        "swaddling",
        "unswaddle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d55ee56b-604a-3ed1-b7fc-ecd914b00b35",
                    "sense_definition": "To wrap a baby tightly in a cloth or blanket to restrict movement and provide comfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrap_baby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse showed the new parents how to <w>swaddle</w> the newborn baby safely.",
                            "target_lang_translations": {
                                "pl": "Pielęgniarka pokazała świeżo upieczonym rodzicom, jak bezpiecznie <w>spowijać</w> noworodka."
                            }
                        },
                        {
                            "text": "It is much easier to soothe a crying infant when you <w>swaddle</w> a baby snugly.",
                            "target_lang_translations": {
                                "pl": "Dużo łatwiej jest uspokoić płaczące niemowlę, gdy ciasno <w>otuli się</w> dziecko."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrap",
                        "bind",
                        "envelop"
                    ],
                    "antonyms": [
                        "unswaddle",
                        "unwrap"
                    ],
                    "common_phrases": [
                        "swaddle a baby",
                        "swaddle a newborn"
                    ],
                    "target_lang_definitions": {
                        "pl": "Owinąć niemowlę ciasno w materiał lub kocyk, aby ograniczyć jego ruchy i zapewnić mu poczucie bezpieczeństwa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spowijać",
                                "target_lang_sense_clarification": "owijać niemowlę ciasno"
                            },
                            {
                                "target_lang_word": "owijać",
                                "target_lang_sense_clarification": "ciasno w kocyk lub rożek"
                            },
                            {
                                "target_lang_word": "otulać",
                                "target_lang_sense_clarification": "zapewniać ciepło i bezpieczeństwo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d60ed6-4020-3204-a2a5-41d6885605ee",
                    "sense_definition": "To beat or cudgel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry villager threatened to <w>swaddle</w> the thief with a heavy wooden stick.",
                            "target_lang_translations": {
                                "pl": "Wściekły wieśniak groził, że <w>obije</w> złodzieja ciężkim drewnianym kijem."
                            }
                        },
                        {
                            "text": "In the old tale, the giant promised to <w>swaddle</w> anyone who dared to enter his castle.",
                            "target_lang_translations": {
                                "pl": "W starej baśni olbrzym obiecał, że <w>obije</w> każdego, kto odważy się wejść do jego zamku."
                            }
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "cudgel",
                        "thrash"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of beating or cudgeling"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bić, okładać kijem (znaczenie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obijać",
                                "target_lang_sense_clarification": "bić kogoś kijem"
                            },
                            {
                                "target_lang_word": "okładać",
                                "target_lang_sense_clarification": "bić, chłostać"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aafc15da-0d26-3cbc-b1c1-b6948d3f66ce",
                    "sense_definition": "A cloth, band, or blanket used to wrap a baby tightly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrap_baby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infant wriggled restlessly, trying to escape from the tight <w>swaddle</w>.",
                            "target_lang_translations": {
                                "pl": "Niemowlę wierciło się niespokojnie, próbując uwolnić się z ciasnego <w>otulacza</w>."
                            }
                        },
                        {
                            "text": "She bought a soft cotton <w>swaddle</w> decorated with tiny yellow stars.",
                            "target_lang_translations": {
                                "pl": "Kupiła miękki bawełniany <w>otulacz</w> ozdobiony malutkimi żółtymi gwiazdkami."
                            }
                        }
                    ],
                    "synonyms": [
                        "swaddling band",
                        "wrap",
                        "blanket"
                    ],
                    "common_phrases": [
                        "cotton swaddle",
                        "baby swaddle"
                    ],
                    "target_lang_definitions": {
                        "pl": "Tkanina, opaska lub kocyk służący do ciasnego owijania niemowlęcia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "otulacz",
                                "target_lang_sense_clarification": "nowoczesny kocyk do ciasnego owijania niemowląt"
                            },
                            {
                                "target_lang_word": "powijak",
                                "target_lang_sense_clarification": "tradycyjny pas materiału do owijania dziecka"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}