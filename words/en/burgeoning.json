                    "synonyms": [
                        "blooming",
                        "flourishing",
                        "proliferating",
                        "thriving"
                    ],
                    "antonyms": [
                        "declining",
                        "dwindling",
                        "shrinking"
                    ],
                    "common_phrases": [
