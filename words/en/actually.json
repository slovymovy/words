{
    "word_family": [
        "actual",
        "actuality",
        "actualize",
        "act",
        "action",
        "active",
        "activity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7a29d532-2ee3-34e8-9de1-6ba276511a06",
                    "sense_definition": "Used to emphasize that something is true or real, especially when it is surprising or contradicts a previous belief.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "reality_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I thought he was joking, but he <w>actually</w> meant what he said.",
                            "target_lang_translations": {
                                "ru": "Я думал, он шутит, но он <w>действительно</w> имел в виду то, что сказал.",
                                "tr": "Şaka yaptığını sanmıştım ama söylediklerinde <w>gerçekten</w> ciddiymiş.",
                                "zh": "我以为他在开玩笑，但他<w>其实</w>是认真的。"
                            }
                        },
                        {
                            "text": "She looks very young, but she is <w>actually</w> over fifty years old.",
                            "target_lang_translations": {
                                "ru": "Она выглядит очень молодо, но <w>на самом деле</w> ей больше пятидесяти.",
                                "tr": "Çok genç görünüyor ama <w>aslında</w> elli yaşın üzerinde.",
                                "zh": "她看起来很年轻，但<w>实际上</w>已经五十多岁了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "really",
                        "in fact",
                        "in reality",
                        "truly",
                        "as a matter of fact",
                        "indeed"
                    ],
                    "antonyms": [
                        "ostensibly",
                        "virtually",
                        "figuratively"
                    ],
                    "common_phrases": [
                        "actually I think",
                        "actually it is",
                        "not actually",
                        "did actually"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для того, чтобы подчеркнуть, что что-то является правдой или реальностью, особенно когда это удивительно или противоречит предыдущему убеждению.",
                        "tr": "Bir şeyin doğru veya gerçek olduğunu vurgulamak için kullanılır; özellikle şaşırtıcı olduğunda veya önceki bir inançla çeliştiğinde.",
                        "zh": "用于强调某事是真实或事实，特别是在该事实令人惊讶或与之前的看法相矛盾时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на самом деле",
                                "target_lang_sense_clarification": "в действительности, вопреки ожиданиям"
                            },
                            {
                                "target_lang_word": "действительно",
                                "target_lang_sense_clarification": "подтверждение истинности факта"
                            },
                            {
                                "target_lang_word": "вообще-то",
                                "target_lang_sense_clarification": "разговорное; используется при возражении или уточнении"
                            },
                            {
                                "target_lang_word": "фактически",
                                "target_lang_sense_clarification": "по сути, практически"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aslında",
                                "target_lang_sense_clarification": "gerçekte, işin özünde"
                            },
                            {
                                "target_lang_word": "gerçekten",
                                "target_lang_sense_clarification": "doğruluğu vurgulamak için"
                            },
                            {
                                "target_lang_word": "gerçekte",
                                "target_lang_sense_clarification": "asıl durumu belirtirken"
                            },
                            {
                                "target_lang_word": "aslında bakarsan",
                                "target_lang_sense_clarification": "düzeltme veya açıklama yaparken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际上",
                                "target_lang_sense_clarification": "强调事实与表面现象或预期不符"
                            },
                            {
                                "target_lang_word": "其实",
                                "target_lang_sense_clarification": "用于转折，引出真实情况"
                            },
                            {
                                "target_lang_word": "真的",
                                "target_lang_sense_clarification": "强调某事确实发生了或确实如此"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc455ce9-8c5c-376a-aaa0-c2feb3a7e814",
                    "sense_definition": "At the present time; currently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_current",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regulations <w>actually</w> in force differ significantly from the old ones.",
                            "target_lang_translations": {
                                "ru": "Нормы, <w>в настоящее время</w> имеющие силу, существенно отличаются от старых.",
                                "tr": "<w>Halihazırda</w> yürürlükte olan yönetmelikler eskilerinden önemli ölçüde farklıdır.",
                                "zh": "目前生效的法规与旧法规有很大不同。"
                            }
                        },
                        {
                            "text": "She described the fashion <w>actually</w> in vogue during that specific era.",
                            "target_lang_translations": {
                                "ru": "Она описала моду, <w>в то время</w> бывшую популярной в ту конкретную эпоху.",
                                "tr": "<w>O dönemde</w> bizzat moda olan giyim tarzını tanımladı.",
                                "zh": "她描述了那个特定时代当时流行的时尚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "this usage is obsolete in modern English and often considered a false friend for speakers of Romance languages"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В настоящее время; на данный момент.",
                        "tr": "Şu anda; halihazırda (eski kullanım).",
                        "zh": "在当前时间；目前。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в настоящее время",
                                "target_lang_sense_clarification": "текущий момент (устаревшее значение оригинала)"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "в данный момент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şu anda",
                                "target_lang_sense_clarification": "mevcut zamanda"
                            },
                            {
                                "target_lang_word": "halihazırda",
                                "target_lang_sense_clarification": "yürürlükte veya geçerli olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目前",
                                "target_lang_sense_clarification": "指当前的时间段"
                            },
                            {
                                "target_lang_word": "现在",
                                "target_lang_sense_clarification": "指此时此刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0806d5e5-340e-32a9-a6b6-b4ed78021614",
                    "sense_definition": "In an active manner; involving action rather than potentiality or passivity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee was neither <w>actually</w> nor passively involved in the decision.",
                            "target_lang_translations": {
                                "ru": "Комитет не участвовал в принятии решения ни <w>активно</w>, ни пассивно.",
                                "tr": "Komite karara ne <w>fiilen</w> ne de pasif olarak dahil oldu.",
                                "zh": "委员会在决策过程中既没有<w>积极</w>参与，也没有被动参与。"
                            }
                        },
                        {
                            "text": "He did not just support the idea theoretically, but <w>actually</w> worked to achieve it.",
                            "target_lang_translations": {
                                "ru": "Он не просто поддерживал идею теоретически, но <w>на деле</w> работал над её воплощением.",
                                "tr": "Fikri sadece teorik olarak desteklemekle kalmadı, başarılması için <w>gerçekten</w> çalıştı.",
                                "zh": "他不仅在理论上支持这个想法，而且<w>实际上</w>为实现它付出了努力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in this specific sense in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Активным образом; подразумевает действие, а не потенциальную возможность или пассивность.",
                        "tr": "Aktif bir şekilde; potansiyel veya pasif olmak yerine eylem içeren.",
                        "zh": "以积极的方式；涉及行动而非潜在性或被动性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на деле",
                                "target_lang_sense_clarification": "на практике, в реальности"
                            },
                            {
                                "target_lang_word": "активно",
                                "target_lang_sense_clarification": "деятельно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fiilen",
                                "target_lang_sense_clarification": "bizzat eyleme dökerek"
                            },
                            {
                                "target_lang_word": "gerçekten",
                                "target_lang_sense_clarification": "pratikte, uygulamada"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际上",
                                "target_lang_sense_clarification": "指在实践中而非理论上"
                            },
                            {
                                "target_lang_word": "积极地",
                                "target_lang_sense_clarification": "指主动参与行动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                    "sense_definition": "Used to express strong agreement or confirmation of a statement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A: That was a surprisingly good movie. B: <w>Actually</w>!",
                            "target_lang_translations": {
                                "ru": "А: Это был удивительно хороший фильм. Б: <w>Действительно</w>!",
                                "tr": "A: Şaşırtıcı derecede iyi bir filmdi. B: <w>Kesinlikle</w>!",
                                "zh": "甲：那部电影好得令人惊讶。乙：<w>确实</w>！"
                            }
                        },
                        {
                            "text": "A: It is really cold out there today. B: <w>Actually</w>!",
                            "target_lang_translations": {
                                "ru": "А: На улице сегодня очень холодно. Б: <w>И правда</w>!",
                                "tr": "A: Bugün dışarısı gerçekten çok soğuk. B: <w>Gerçekten de</w> öyle!",
                                "zh": "甲：今天外面真的很冷。乙：<w>可不是吗</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "indeed",
                        "really"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения решительного согласия или подтверждения утверждения.",
                        "tr": "Bir ifadeye güçlü katılım veya onay belirtmek için kullanılır.",
                        "zh": "用于表示对某项陈述的强烈赞同或确认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действительно",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "и правда",
                                "target_lang_sense_clarification": "подтверждение сказанного"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kesinlikle",
                                "target_lang_sense_clarification": "güçlü onaylama"
                            },
                            {
                                "target_lang_word": "gerçekten de",
                                "target_lang_sense_clarification": "katılım belirtme"
                            },
                            {
                                "target_lang_word": "valla",
                                "target_lang_sense_clarification": "günlük konuşmada onaylama"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示完全同意对方的观点"
                            },
                            {
                                "target_lang_word": "可不是吗",
                                "target_lang_sense_clarification": "口语中表示强烈赞同"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}