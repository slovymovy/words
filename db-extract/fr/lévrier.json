                                                "sense_id": "3d07d88f-02f9-3df6-b1ab-9ca573a72fc1",
                                                "text": "Windhunde zählen zu den schnellsten Landlebewesen."
                                            },
                                            {
                                                "example_id": "23843d2e-603c-42f0-b502-9c98cd454e8e",
                                                "sense_id": "3d07d88f-02f9-3df6-b1ab-9ca573a72fc1",
                                                "text": "„Ein zweiter Windhund stürzte, kaum dass er den Herrn vom Blumengarten aus erblickt hatte, mit gekrümmtem Rücken auf die Freitreppe zu, hob die Rute und rieb sich an Nikolais Beinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "acf1fc70-44c3-30f9-aefe-8b63dca73e1e",
                                        "entry_id": "cb2721fb-4904-3399-b36c-5983feaf546e",
                                        "glosses": [
                                            "Person, die sich durch Unzuverlässigkeit und Oberflächlichkeit auszeichnet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56b2e68-11a1-4876-8ec2-10a7d0b95dc2",
                                                "sense_id": "acf1fc70-44c3-30f9-aefe-8b63dca73e1e",
                                                "text": "Auf diesen Windhund solltest du dich auf keinen Fall verlassen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
