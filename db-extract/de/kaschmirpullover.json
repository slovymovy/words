                            {
                                "example_id": "58977200-74a5-432b-9d0d-60c20c6f8b54",
                                "sense_id": "d16cf75b-2d81-3a3b-a386-e0301abb9a28",
                                "text": "„Er trug einen schwarzen Kaschmirpullover und schien Ende dreißig zu sein, vermutlich ein paar Jahre älter als Ferris.“"
                            },
                            {
                                "example_id": "12ef32e8-368a-4e31-83ad-13ea9f798210",
                                "sense_id": "d16cf75b-2d81-3a3b-a386-e0301abb9a28",
                                "text": "„Sie lief umher und hob Kaschmirpullover und Wolljacken mit Zopfmuster hoch, fuhr mit der Hand über einen Blazer, hielt sich ein Kleid an.“"
                            }
                        ],
