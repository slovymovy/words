                "senses": [
                    {
                        "sense_id": "17abdca8-d26c-3402-85e5-73c5ab544824",
                        "entry_id": "df741d73-e84e-38a2-b766-e5eef9713710",
                        "glosses": [
                            "To make something less legitimate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0e77c28d-67af-49b6-889b-46be20abbce9",
                                "sense_id": "17abdca8-d26c-3402-85e5-73c5ab544824",
                                "text": "Iran could not be happier. The more Israel sinks into the West Bank, the more it is delegitimized and isolated, the more the world focuses on Israel’s colonialism rather than Iran’s nuclear enrichment, the more people call for a single democratic state in all of historic Palestine."
                            },
                            {
                                "example_id": "135f6d16-0961-4c82-935e-bb1ae93b08ee",
                                "sense_id": "17abdca8-d26c-3402-85e5-73c5ab544824",
                                "text": "As that campaign seeks to do, fighting ISIS means delegitimizing Caliphism at home and abroad."
                            },
                            {
                                "example_id": "b2661e31-d8c5-48c4-8011-aeca31d7208d",
                                "sense_id": "17abdca8-d26c-3402-85e5-73c5ab544824",
                                "text": "Republicans are pushing legislation to crack down on voting by noncitizens, which happens rarely and is already illegal in federal elections, in a move that reinforces former President Donald J. Trump’s efforts to delegitimize the 2024 results if he loses."
                            },
                            {
                                "example_id": "70d9102b-c8a6-432a-bd64-dd48a70b4c86",
                                "sense_id": "17abdca8-d26c-3402-85e5-73c5ab544824",
                                "text": "“It is a strategy that delegitimizes the work of the public administration, generates long-term dependence and pockets of power that are later difficult to dismantle,” Fernando Nieto Morales, a professor specializing in government and public administration at The College of Mexico, said of the responsibility given to the military."
                            }
                        ]
                    },
                    {
                        "sense_id": "032b520a-e1bd-311e-a25b-9068728eabae",
                        "entry_id": "df741d73-e84e-38a2-b766-e5eef9713710",
                        "glosses": [
                            "To make something illegal that was previously legal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
