                "senses": [
                    {
                        "sense_id": "1e263a26-d035-378b-8293-3d1bca84c28d",
                        "entry_id": "05a98b5f-61e7-3e96-b537-0babc0b6737b",
                        "glosses": [
                            "związany z tartakiem, dotyczący tartaku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6bc784-72c1-418d-b190-66aeee5681fd",
                                "sense_id": "1e263a26-d035-378b-8293-3d1bca84c28d",
                                "text": "Jak zaznacza, rentowność netto przemysłu tartacznego po trzech kwartałach 2008 r. osiągnęła zaledwie 0,4%."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
