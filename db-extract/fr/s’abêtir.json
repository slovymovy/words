                ],
                "translations": [
                    {
                        "translation_id": "b44c70e4-c007-4a18-9f28-5b4fc22bf79b",
                        "source_entry_id": "893a407b-57be-3e3c-b814-d1d848b4cb01",
                        "source_sense_id": "1ce3f15c-cc21-3ead-bc2e-d6e182619667",
                        "target_lang_word": "dumb down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dumb down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73962a6a-0fac-35c8-8055-928fbd6df10d",
                                        "entry_id": "46d70aa2-17d5-3969-a95c-3972ad90d56a",
                                        "glosses": [
                                            "To convey some subject matter in simple terms, avoiding technical or academic language, especially in a way that is considered condescending."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9dd7892-740b-471a-8230-22e039f8f3a6",
                                                "sense_id": "73962a6a-0fac-35c8-8055-928fbd6df10d",
                                                "text": "The public won't understand this concept. We need to dumb down our explanation of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f54d9bf8-e0bc-318d-9f84-c5eb7f1b1c83",
                                        "entry_id": "46d70aa2-17d5-3969-a95c-3972ad90d56a",
                                        "glosses": [
                                            "To become simpler in expression or content; to become unacceptably simplistic."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd31ea61-6980-4d77-b62a-a52c253c751d",
                                                "sense_id": "f54d9bf8-e0bc-318d-9f84-c5eb7f1b1c83",
                                                "text": "Television has really dumbed down over the past ten years."
                                            },
                                            {
                                                "example_id": "84cabc34-f66e-4926-9f18-b7a4383c8a5f",
                                                "sense_id": "f54d9bf8-e0bc-318d-9f84-c5eb7f1b1c83",
                                                "text": "The dumbing down of America is most evident in the slow decay of substantive content in the enormously influential media, the 30-second sound bites (now down to 10 seconds or less), lowest common denominator programming, credulous presentations on pseudo-science and superstition, but especially a kind of celebration of ignorance."
                                            },
                                            {
                                                "example_id": "40269d82-d667-4fb9-b5a2-0ef3b3f6e11d",
                                                "sense_id": "f54d9bf8-e0bc-318d-9f84-c5eb7f1b1c83",
                                                "text": "As the reports are written for both the industry and general public, inspectors are required to use accessible language that is free from jargon but without 'dumbing down'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
