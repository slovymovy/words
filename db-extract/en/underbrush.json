                        "tags": [
                            "plural"
                        ],
                        "form": "underbrushes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da835248-54ea-307c-be05-51b46bf56c95",
                        "entry_id": "7d8d307a-71a1-3e14-aad3-caaa696636a1",
                        "glosses": [
                            "The small trees and other plants that clutter the floor of a forest."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "de98ec14-4d73-4066-9b35-5dd01236b0a5",
                                "sense_id": "da835248-54ea-307c-be05-51b46bf56c95",
                                "text": "How quick the eye and hand to catch him [the ruffed grouse] when he rises from the underbrush and is out of sight in the wood before the untrained sportsman stops him with what is little more than a snapshot, so instantaneously must all be done!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a05c17b-773d-4d5c-9b0b-81801053e5e4",
                        "source_entry_id": "7d8d307a-71a1-3e14-aad3-caaa696636a1",
                        "source_sense_id": "da835248-54ea-307c-be05-51b46bf56c95",
