                    {
                        "sense_id": "43a7a0d9-7816-316a-88e2-a2d2bc417210",
                        "entry_id": "ab140c7c-aeee-3513-a4ec-eadb8ced4ffc",
                        "glosses": [
                            "Protéine de la peau, qui se lie à la kératine dans l’épithélium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97146a40-b3ee-4bd5-873a-e3fcb3cb88cf",
                                "sense_id": "43a7a0d9-7816-316a-88e2-a2d2bc417210",
                                "text": "Ces grains contiennent une protéine, la filaggrine, qui forme des ponts unissant les tonofilaments au fur et à mesure que la kératine change de forme."
                            },
                            {
                                "example_id": "044dbbf0-b93e-445c-b544-0f5105562c88",
                                "sense_id": "43a7a0d9-7816-316a-88e2-a2d2bc417210",
                                "text": "La filaggrine est une phosphoprotéine matricielle exprimée dans les cellules épidermiques (kératinocytes)."
                            }
                        ]
                    }
                ],
