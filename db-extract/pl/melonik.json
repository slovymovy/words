                                                "sense_id": "3e926c3e-c06d-3b3e-adeb-a13e60800bd5",
                                                "text": "„Die letzten Glocken läuten.“"
                                            },
                                            {
                                                "example_id": "a7df2b93-d8cf-4374-a79c-c87962e15190",
                                                "sense_id": "3e926c3e-c06d-3b3e-adeb-a13e60800bd5",
                                                "text": "„Sie haben dann die zerschlagene Glocke in einen Fellsack geschoben.“"
                                            }
