    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0003693-a445-3a3c-8bf7-64557a90ee2c",
                    "sense_definition": "Ogół młodych ludzi, dorastające pokolenie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Współczesna <w>młodzież</w> spędza dużo czasu w internecie.",
                            "target_lang_translations": {
                                "ru": "Современная <w>молодёжь</w> проводит много времени в интернете.",
                                "de": "Die heutige <w>Jugend</w> verbringt viel Zeit im Internet."
                            }
                        },
                        {
                            "text": "Dla <w>młodzieży</w> szkolnej przygotowano specjalne zniżki na bilety.",
                            "target_lang_translations": {
                                "ru": "Для школьной <w>молодёжи</w> подготовили специальные скидки на билеты.",
                                "de": "Für die Schuljugend wurden spezielle Fahrkartenermäßigungen vorbereitet."
                            }
                        }
                    ],
                    "synonyms": [
                        "młódź",
                        "młodzi"
                    ],
                    "common_phrases": [
                        "młodzież szkolna",
                        "trudna młodzież",
                        "dzisiejsza młodzież",
                        "klub młodzieży"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность молодых людей, подрастающее поколение.",
                        "de": "Gesamtheit der jungen Menschen; heranwachsende Generation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодёжь",
                                "target_lang_sense_clarification": "молодое поколение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Jugend",
                                "target_lang_sense_clarification": "Gesamtheit der jungen Menschen"
                            },
                            {
                                "target_lang_word": "junge Leute",
                                "target_lang_sense_clarification": "Heranwachsende, Jugendliche"
                            },
                            {
                                "target_lang_word": "Jugendliche",
                                "target_lang_sense_clarification": "Gruppe junger Menschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd731515-e85b-3597-b1d9-0fcd66fc4b75",
                    "sense_definition": "Młode zwierzęta traktowane jako grupa, zwłaszcza w kontekście hodowlanym lub łowieckim.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik oddzielił <w>młodzież</w> od dorosłych osobników w stadzie.",
                            "target_lang_translations": {
                                "ru": "Фермер отделил <w>молодняк</w> от взрослых особей в стаде.",
                                "de": "Der Landwirt trennte die <w>Jungtiere</w> von den ausgewachsenen Tieren in der Herde."
                            }
                        },
                        {
                            "text": "Wiosną w lesie pojawia się liczna <w>młodzież</w> różnych gatunków.",
                            "target_lang_translations": {
                                "ru": "Весной в лесу появляется многочисленный <w>молодняк</w> разных видов.",
                                "de": "Im Frühling gibt es im Wald zahlreichen <w>Nachwuchs</w> verschiedener Arten."
                            }
                        }
                    ],
                    "synonyms": [
                        "młódź"
                    ],
                    "common_phrases": [
                        "młodzież hodowlana"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодые животные как группа, особенно в контексте разведения или охоты.",
                        "de": "Junge Tiere als Gruppe, insbesondere in der Tierzucht oder Jagd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодняк",
                                "target_lang_sense_clarification": "молодые животные"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Jungtiere",
                                "target_lang_sense_clarification": "Gruppe junger Tiere"
                            },
                            {
                                "target_lang_word": "Nachwuchs",
                                "target_lang_sense_clarification": "tierischer Nachwuchs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b114b1e1-cc0c-316a-8e15-930a8e953846",
                    "sense_definition": "Młode drzewa rosnące w skupisku, zwykle w lesie.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leśnicy dbają o to, by leśna <w>młodzież</w> miała dostęp do światła.",
                            "target_lang_translations": {
                                "ru": "Лесники заботятся о том, чтобы лесной <w>молодняк</w> имел доступ к свету.",
                                "de": "Die Förster sorgen dafür, dass der <w>Jungwuchs</w> im Wald Zugang zu Licht hat."
                            }
                        },
                        {
                            "text": "Gęsta sosnowa <w>młodzież</w> porastała całe zbocze góry.",
                            "target_lang_translations": {
                                "ru": "Густой сосновый <w>молодняк</w> покрывал весь склон горы.",
                                "de": "Dichter Kiefern-<w>Jungwuchs</w> bedeckte den gesamten Berghang."
                            }
                        }
                    ],
                    "synonyms": [
                        "młódź"
                    ],
                    "common_phrases": [
                        "pielęgnacja młodzieży"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодые деревья, растущие группой, обычно в лесу.",
                        "de": "Junge Bäume in dichter Gruppe, meist im Wald; Jungwuchs."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодняк",
                                "target_lang_sense_clarification": "молодой лес, поросль"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Jungwuchs",
                                "target_lang_sense_clarification": "junge Bäume, Forstwirtschaft"
                            },
                            {
                                "target_lang_word": "Dickung",
                                "target_lang_sense_clarification": "dicht stehender Jungwald"
                            }
                        ]
                    }
                }
            ]
        }
