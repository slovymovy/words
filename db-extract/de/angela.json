                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da9f192-b8a3-4002-b2a2-8e61f1b7be4a",
                                                "sense_id": "354b147c-ddcd-3a56-818b-ffb299c6a9ad",
                                                "text": "Il est mort le 22 mai dernier, à l’âge de 96 ans, dans sa ville de Saint-Christol-lez-Alès : Ange Alvarez n’aura pu assister à l’hommage qui lui a été rendu le samedi 2 juillet à Sainte-Bazeille."
                                            },
                                            {
                                                "example_id": "fa75fa2f-bb3b-4190-abcc-7c5e545b797f",
                                                "sense_id": "354b147c-ddcd-3a56-818b-ffb299c6a9ad",
                                                "text": "L’expo « Faut-il voyager pour être heureux ? », qui se tient jusqu’au 2 avril à la Fondation groupe EDF, à Paris (7ᵉ), met notamment en lumière les 70 globes de l’artiste corse Ange Leccia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad4f089-c5aa-3c6e-857f-738eaff7bd4b",
                                        "entry_id": "71fa7043-dfa4-3157-b978-10362ff294e9",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "023fb770-db84-4829-9362-c93e3a1c1528",
                        "source_entry_id": "ac29fd66-c4e0-3cdd-a6fa-a2c9faab09b2",
                        "source_sense_id": "cfe498ba-cb60-39ac-af7f-c6b88e9bc0db",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Angèle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angèle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                        "entry_id": "5d5b2e66-cd85-3894-8693-9209498492d2",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d82a0fd9-73e7-4732-8e7c-1dfe71de2906",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "Il me dit qu’elle était la fille de la ferme “La Douloire” là, en face, cette grangette sous les peupliers, qu’elle s’appelait Angèle et Barbaroux."
                                            },
                                            {
                                                "example_id": "b42b1721-26c0-46b0-b1ae-a1b26cc5f8e2",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "C'est juste lundi Angèle\n C'est juste lundi ma belle\n T'as le reste de ta vie\n Pour courir après lui."
                                            },
                                            {
                                                "example_id": "6443b150-24ed-4fa5-a794-8cb4d9070319",
                                                "sense_id": "f4a77388-be92-36ca-8171-a8d81ff59199",
                                                "text": "Angèle a retourné la chènevière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
