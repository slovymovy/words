                "senses": [
                    {
                        "sense_id": "57e5a269-7f23-3bd1-8190-56eeb6074d24",
                        "entry_id": "746e7876-00bf-303b-a01e-317e2441b198",
                        "glosses": [
                            "Donner un caractère soufi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd9ff6c-f65f-4cf1-baab-bedc6ba89d89",
                                "sense_id": "57e5a269-7f23-3bd1-8190-56eeb6074d24",
                                "text": "L'idéal pour la communauté, pour reprendre l'expression de nos savants, serait de 'soufiser le salafisme et de salafiser le soufisme', car le soufisme manque de la rigueur du salafisme dans les sciences de l’exégèse, du hadith, ou du fiqh et parce que le salafisme manque de la spiritualité, de la douceur et de l’esprit de tolérance du soufisme."
                            },
                            {
                                "example_id": "c310a884-3c61-4b95-bc8c-dced56d3b018",
                                "sense_id": "57e5a269-7f23-3bd1-8190-56eeb6074d24",
                                "text": "Mais bon heureusement qu'on peut soufiser de tps à autres."
                            },
                            {
                                "example_id": "cb2b9512-001c-4a4e-89a7-e7cd6a896bb5",
                                "sense_id": "57e5a269-7f23-3bd1-8190-56eeb6074d24",
                                "text": "Sinon concernant le soufisme en général je lis en ce moment les trois tomes de Ibnou Batuta qui parlent de son autobiographie ... à son époque il va traverser beaucoup de pays et de région ... il raconte le nombre incroyable de tariqa soufis ... d'ailleurs cela va beaucoup jouer dans sa vie ... ce qui est marrant c'est qu'il va rester 10 ans à la Mecque et cela ne l'empêche pas de se soufiser si je puis dire."
                            }
                        ]
                    }
