                    {
                        "sense_id": "c9d5db29-93ac-39db-80ee-99f8e31def35",
                        "entry_id": "68578234-9556-3bcf-a3c9-32cb0ece878b",
                        "glosses": [
                            "Soap-opéra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1edcacf5-26b6-4254-a3ea-1344e048664e",
                                "sense_id": "c9d5db29-93ac-39db-80ee-99f8e31def35",
                                "text": "Im Gegensatz zu anderen Serien, die meist aus in sich abgeschlossenen Episoden bestehen, endet eine Geschichte in der Seifenoper niemals in der Folge, in der sie begonnen hat."
                            },
                            {
                                "example_id": "cc803637-4756-4561-9726-12ab38c96c35",
                                "sense_id": "c9d5db29-93ac-39db-80ee-99f8e31def35",
                                "text": "Gerhard Polt hat mit anderen humoraffinen Mitstreitern eine japanische Kultseifenoper synchronisiert. In derbstem Bairisch.",
                                "translation": "Gerhard Polt a doublé un soap opera japonais culte avec d’autres compagnons humoreux. En langage bavarois le plus grossier."
                            }
                        ]
                    }
                ],
