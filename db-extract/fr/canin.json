                        ],
                        "form": "canines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b294e55-3b06-3c39-bc50-0cd5898b8e84",
                        "entry_id": "4ca584a2-1f2c-394b-ad4a-96197d2cb9d9",
                        "glosses": [
                            "Relatif au chien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c56bec6d-1ce9-4df7-913a-170bb564a064",
                                "sense_id": "3b294e55-3b06-3c39-bc50-0cd5898b8e84",
                                "text": "Race, espèce canine."
                            },
                            {
                                "example_id": "462be2f8-2a35-4ba4-811f-cc01fb0d4c95",
                                "sense_id": "3b294e55-3b06-3c39-bc50-0cd5898b8e84",
                                "text": "Concours canin"
                            },
                            {
                                "example_id": "969f88be-a02a-42ba-8f30-14f167af0a9b",
                                "sense_id": "3b294e55-3b06-3c39-bc50-0cd5898b8e84",
                                "text": "Juste à côté de la chapelle Saint-Louis (fin xivᵉ siècle) que l'équipe a de nouveau dégagée de sa gangue de terre cette année, une sépulture canine vient d’être mise à jour (*). « Pour le moment, nous ne savons pas si le chien, d’une stature assez importante, a été enterré juste avant la construction de la chapelle ou juste après », explique Pierre Papin, qui dirige les fouilles."
                            },
                            {
                                "example_id": "da02d130-c60a-40b2-b594-3206a669c8f7",
                                "sense_id": "3b294e55-3b06-3c39-bc50-0cd5898b8e84",
                                "text": "C’est une hécatombe canine qui a fait couler beaucoup d’encre. Depuis le début du mois, 13 chiens sont morts, pris de vomissements et de convulsions après avoir barboté dans l’eau de la Loire."
                            }
                        ]
                    },
                    {
                        "sense_id": "44b062f8-0395-31f0-bd03-029cb62659ff",
                        "entry_id": "4ca584a2-1f2c-394b-ad4a-96197d2cb9d9",
                        "glosses": [
                            "Mordant, dévorant."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62866422-1cbe-4d08-9e9e-20d294ab4d6c",
                        "source_entry_id": "4ca584a2-1f2c-394b-ad4a-96197d2cb9d9",
                        "target_lang_word": "canine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                                        "entry_id": "3199c65a-41a5-3616-9874-de1811bfe1bc",
                                        "glosses": [
                                            "Of, or pertaining to, a dog or dogs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aa80ee-6a26-4438-9d6a-cdba01659d5c",
                                                "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                                                "text": "Police in a West Springfield arrested a man named Kenneth Appleby and suggested that he might be a local version of Houston's Dean Corll (this was before John Gacy's Illinois murders had been discovered). Appleby's yard was dug up, but the only bones discovered was canine."
                                            },
                                            {
                                                "example_id": "dc220c4c-deb8-45c0-9d54-bd9dd4538c33",
                                                "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                                                "text": "Two canine animals in a time of dearth, may be truly said to struggle with each other which shall get food and live."
                                            },
                                            {
                                                "example_id": "43362b3e-9a53-4599-9959-8e847d64e856",
                                                "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                                                "text": "We carried the dog round to the yard, and I examined his head. […] I accepted the care of the canine patient."
                                            },
                                            {
                                                "example_id": "ffd89710-399c-448b-a0f5-c713cea224c2",
                                                "sense_id": "2b1dfbb0-df1d-37ec-9564-4b74a9695e44",
                                                "text": "A lost dog sniffed around the flower beds wishing it had some canine company[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06e1ad4-1646-37c2-be2b-2cad2bf57afb",
                                        "entry_id": "3199c65a-41a5-3616-9874-de1811bfe1bc",
                                        "glosses": [
                                            "Dog-like."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79333d99-e0dc-4f31-890b-6c9dcd2438e3",
                                                "sense_id": "b06e1ad4-1646-37c2-be2b-2cad2bf57afb",
                                                "text": "In many respects she made me an admirable wife. Her affection for me was canine—positively."
                                            },
                                            {
                                                "example_id": "687ea145-3ea0-4c2c-8072-7a23fe4e6e67",
                                                "sense_id": "b06e1ad4-1646-37c2-be2b-2cad2bf57afb",
                                                "text": "I look for reflections, in your face\nCanine devotion, time can't erase\nOut on the corner, locked in your room\nI never believe them and I never assume"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f750fa-2a36-3208-9591-e8aafdc4c44e",
                                        "entry_id": "3199c65a-41a5-3616-9874-de1811bfe1bc",
                                        "glosses": [
                                            "Of or pertaining to mammalian teeth which are cuspids or fangs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc0a4c7-5db6-4a42-a0c3-f1ee90c03c9f",
                                                "sense_id": "16f750fa-2a36-3208-9591-e8aafdc4c44e",
                                                "text": "Then his upper lip may be seen to be raised, especially at the corners, so that his huge canine teeth are exhibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536fa0fb-bce0-3dd3-9d23-e322bf9adc28",
                                        "entry_id": "3199c65a-41a5-3616-9874-de1811bfe1bc",
                                        "glosses": [
                                            "Of an appetite: depraved or inordinate; used to describe eating disorders."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "canine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8eae8c7f-fc96-3c80-a6b0-9a0ef9ed0ab0",
                                        "entry_id": "94bf2b1b-aa25-36bb-98ac-dd858d007067",
                                        "glosses": [
                                            "Any member of Caninae, the only living subfamily of Canidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce13d8c5-a34a-44b3-b55c-4e521116c1fe",
                                                "sense_id": "8eae8c7f-fc96-3c80-a6b0-9a0ef9ed0ab0",
                                                "text": "Whatever the case, the pair’s adventure certainly became famous in 2016, when a large dating program of fossils and artefacts from Chauvet Cave, which included the smear of charcoal discarded by the child, confirmed that the tracks constitute the oldest unequivocal evidence of a relationship between humans and canines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d1c42b-2bda-3478-9c77-11239fa291e4",
                                        "entry_id": "94bf2b1b-aa25-36bb-98ac-dd858d007067",
                                        "glosses": [
                                            "Any of certain extant canids regarded as similar to the dog or wolf (including coyotes, jackals, etc.) but distinguished from the vulpines, which are regarded as fox-like."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94580e3f-7e3d-4e05-b013-87459c8e5085",
                                                "sense_id": "b6d1c42b-2bda-3478-9c77-11239fa291e4",
                                                "text": "The canine ran across the room to the open window, put his front paws on the sill and pointed his nose at the sidewalk below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beeb56f6-da1a-3161-8752-116a686ce9ef",
                                        "entry_id": "94bf2b1b-aa25-36bb-98ac-dd858d007067",
                                        "glosses": [
                                            "In heterodont mammals, the pointy tooth between the incisors and the premolars; a cuspid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5d658c-e426-4f7b-a4c4-407163f53efd",
                                                "sense_id": "beeb56f6-da1a-3161-8752-116a686ce9ef",
                                                "text": "He tried to push Kissu into his cage, but the cougar charged back out and sank his canines into Wilson's rump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "321ac51e-3bfe-3bf8-9487-2193dca4c669",
                                        "entry_id": "94bf2b1b-aa25-36bb-98ac-dd858d007067",
                                        "glosses": [
                                            "A king and a nine as a starting hand in Texas hold 'em due to phonetic similarity."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3fe340-0480-4f0f-887a-f4c0026307a5",
                                                "sense_id": "321ac51e-3bfe-3bf8-9487-2193dca4c669",
                                                "text": "You have been dealt King-9 unsuited (\"canine\") in your pocket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "091bb62e-d38d-4aa4-a34e-4912fd2910d9",
