                                            {
                                                "example_id": "59b7cd33-5640-4d5a-b0b4-61f4f8d64f96",
                                                "sense_id": "038128cb-fde5-33dc-97b5-7de3bf889326",
                                                "text": "At the end of the line nearest the Arch, under a flary light, stood an old bearded man having the look on his face of a kindly but somewhat irritated moo-cow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c98981-55ba-30c2-b437-781d674d1ab8",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
