                                "example_id": "ef26ad91-cfcc-4d06-93ff-55ef09cdddc7",
                                "sense_id": "8adf9874-3310-37fc-8366-1176285683ae",
                                "text": "De gelovige bidt elke dag en gaat regelmatig naar de kerk.",
                                "translation": "The believer prays every day and attends church regularly.",
                                "english": "The believer prays every day and attends church regularly."
                            },
                            {
                                "example_id": "3d8a675b-8844-4819-8b34-3abe57417a0c",
                                "sense_id": "8adf9874-3310-37fc-8366-1176285683ae",
                                "text": "Na jaren van twijfel, werd hij eindelijk een gelovige en sloot zich aan bij de kerk.",
                                "translation": "After years of doubt, he finally became a convert and joined the church.",
                                "english": "After years of doubt, he finally became a convert and joined the church."
                            }
                        ]
