                        "examples": [
                            {
                                "example_id": "b0755606-314b-47c1-86f5-b7f3682eee14",
                                "sense_id": "655fc7f9-f60e-31ec-a91b-a715a0f10341",
                                "text": "„Nach der Stilllegung der Mühle wurde das Gelände in den 1950er-Jahren als Abfüllbetrieb für Getränke genutzt.“"
                            },
                            {
                                "example_id": "afe6192e-2189-466f-8b5d-db2b6bf571b3",
                                "sense_id": "655fc7f9-f60e-31ec-a91b-a715a0f10341",
                                "text": "„Nach einem Streik von 1500 Brauereiarbeiterinnen in Kopenhagen wird in Dänemark das Bier rationiert. Die Streikenden in den großen Abfüllbetrieben des Landes fordern den gleichen Lohn wie ihre männlichen Kollegen.“"
                            }
                        ],
