                    },
                    {
                        "translation_id": "aa420448-2ee5-4dac-8aff-cc78486bf44d",
                        "source_entry_id": "f5bb208f-caf9-3690-a62b-be5fe5fcb03b",
                        "source_sense_id": "34545bf8-3eaa-3512-800c-bcc473f3f5c4",
                        "source_sense_description": "rennend dalen",
                        "target_lang_word": "run down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "run down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3d484a-16b3-35d4-bb48-5f7cdf4ade7c",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To hit someone with a car or other vehicle and injure or kill them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2b5429-c1bc-4296-a314-68d98b57787b",
                                                "sense_id": "1e3d484a-16b3-35d4-bb48-5f7cdf4ade7c",
                                                "text": "He was run down while crossing the main road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To criticize someone or an organisation, often unfairly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2065dd3-473a-4b20-b5e7-ed55beac0590",
                                                "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                                "text": "Whatever the company says, the media is going to run them down."
                                            },
                                            {
                                                "example_id": "7a5a8eff-be47-43fa-bced-7180c5c424b5",
                                                "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                                "text": "My sister is always running me down in front of my friends."
                                            },
                                            {
                                                "example_id": "954e1dd3-7a35-45e7-ba1a-ff0636d5ff59",
                                                "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                                "text": "Don't run yourself down so much!"
                                            },
                                            {
                                                "example_id": "cfad4636-862c-4e6f-b19a-81146719bbff",
                                                "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                                "text": "Ha! ha! ha! 'tis very hard for them to leave a subject they have not quite run down."
                                            },
                                            {
                                                "example_id": "9fe62cd7-16ec-4134-b704-1db78d176391",
                                                "sense_id": "4b66cb5c-5189-3097-a518-a518f0b251df",
                                                "text": "Since I have put my name in GCN and received my first paper, I have only received two letters. But the one that pissed me off […] was from Bible belt hypocrite. He sent me an envelope full of tracts about homosexuality. Well, I have this to say to whoever he is (The person that's got nothing better to do than get the GCN to see who he can run down should take a damn good look at himself)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0305054-b7e7-32c4-a703-8f156827c7e6",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To find something or someone after searching for a long time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffdc3903-53ef-439e-a82e-11abcf871e8a",
                                                "sense_id": "b0305054-b7e7-32c4-a703-8f156827c7e6",
                                                "text": "I finally managed to run down that report. I had filed it incorrectly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19f318e3-72aa-3cb7-8fc5-d99a938bc377",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To lose power slowly. Used for a machine, battery, or other powered device."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5e9b1f-35ac-4a29-b9f5-e07bb236effa",
                                                "sense_id": "19f318e3-72aa-3cb7-8fc5-d99a938bc377",
                                                "text": "You need to wind up the clock every day so that it doesn't run down."
                                            },
                                            {
                                                "example_id": "d0f10899-ea08-4340-9975-63d7800f327b",
                                                "sense_id": "19f318e3-72aa-3cb7-8fc5-d99a938bc377",
                                                "text": "If you don't switch off the car lights, you will run the battery down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "866fbcca-2e06-3fcc-8e6b-1445635ed0ec",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To read quickly a list or other short text."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c57839e8-1ad5-4f6f-8d28-51b3122e2a06",
                                                "sense_id": "866fbcca-2e06-3fcc-8e6b-1445635ed0ec",
                                                "text": "Running down the list of suggestions, I can see three we can discard immediately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5abf183-44e8-311f-9de2-b7fe9e9d270c",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To describe in the form of a rundown, a rough outline or summary."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c45a8747-1db2-491a-bec4-4a9536e46b37",
                                                "sense_id": "e5abf183-44e8-311f-9de2-b7fe9e9d270c",
                                                "text": "When the minute was up, John Jay managed to make the woman twice as nervous as he ran down the rules and the possibilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fa816b-a7bf-3453-afe6-d28575d47c31",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To reduce the size or stock levels of a business, often with a view to closure."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30db5406-5988-4ac8-bad5-d25bea3cc67f",
                                                "sense_id": "52fa816b-a7bf-3453-afe6-d28575d47c31",
                                                "text": "The board of directors have decided to run down the stocks held in storage prior to offering the company for sale."
                                            },
                                            {
                                                "example_id": "b2c48d13-bc5c-4f54-a2a4-15f57d9bdf35",
                                                "sense_id": "52fa816b-a7bf-3453-afe6-d28575d47c31",
                                                "text": "Social media has been full of strident criticism of a Government perceived as pursuing a conscious policy to run down - even destroy - our railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db8ecf0f-0cb2-3753-8278-c25ea45c8852",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To decline in quality or condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b1af3a-399a-4d0c-82ac-d19d53c055cf",
                                                "sense_id": "db8ecf0f-0cb2-3753-8278-c25ea45c8852",
                                                "text": "to run down in health"
                                            },
                                            {
                                                "example_id": "d14706da-0cfb-46b0-9e6e-72f354d9f399",
                                                "sense_id": "db8ecf0f-0cb2-3753-8278-c25ea45c8852",
                                                "text": "TravelWatch SouthWest Chairman Chris Irwin said: \"This is intolerable. The South West deserves levelling up, not running down. SWR and its sponsors in the Department of Transport must be called to account.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c8fe6a-918b-3e4a-b8a6-f14e14eb1f39",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To chase till the object pursued is captured or exhausted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00837ccc-5218-4c2f-880e-a0595bd4fda4",
                                                "sense_id": "a5c8fe6a-918b-3e4a-b8a6-f14e14eb1f39",
                                                "text": "to run down a stag"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d946606-7c7c-3f7a-b1cf-26bc1ecf5029",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To run against and sink, as a vessel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dab58df4-37ae-48db-b294-6692ed55d583",
                                                "sense_id": "5d946606-7c7c-3f7a-b1cf-26bc1ecf5029",
                                                "text": "The Jylland only missed running down a schooner by a few yards in the fog; it was a near thing—near enough, in fact, to allow of some shouted remarks between those on the bridge of the motorship and the man at the wheel of the schooner to be clearly heard."
                                            },
                                            {
                                                "example_id": "68ee2473-0ef2-4a17-a219-5ff621cf3f53",
                                                "sense_id": "5d946606-7c7c-3f7a-b1cf-26bc1ecf5029",
                                                "text": "Hiei now loomed into the action, causing the leading U.S. destroyers to scatter before the oncoming behemoth lest they be run down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b303622d-9d0e-3df8-8ebe-d44e87705c85",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To crush; to overthrow; to overbear."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "967b191d-c051-457c-bd9f-e4f6d97bf722",
                                                "sense_id": "b303622d-9d0e-3df8-8ebe-d44e87705c85",
                                                "text": "Religion is […]run down by the prevailing licence of these times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49cb3a79-2a8b-31d7-bc6b-8227e04efc08",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To approach (someone, thing or place) aggressively, as to attack."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe8f63dd-ea0c-4785-92d9-3406715fcf18",
                                                "sense_id": "49cb3a79-2a8b-31d7-bc6b-8227e04efc08",
                                                "text": "He ran down on Rashad and them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9dae75b-05bc-3257-b981-d5fdadfc4fff",
                                        "entry_id": "3b06a68d-72ec-3bb0-bf44-50d1136cde68",
                                        "glosses": [
                                            "To move (some copy) down to the next line."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7998f6-03a9-4703-a3da-9b6036219812",
                                                "sense_id": "e9dae75b-05bc-3257-b981-d5fdadfc4fff",
                                                "text": "If they occasionally supply any additional copy after this element, run it down with a manual line break."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
