                "senses": [
                    {
                        "sense_id": "dcf9c0d0-cd3e-3e36-b849-a2977dcd1e0e",
                        "entry_id": "d73a7042-7624-3257-a16e-6478901dc6c1",
                        "glosses": [
                            "Instrument permettant de déterminer l'heure la nuit à partir de la position de l'étoile polaire par rapport à celle de Kochab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99762a7e-5ec3-4e50-a3ad-bb67493adfec",
                                "sense_id": "dcf9c0d0-cd3e-3e36-b849-a2977dcd1e0e",
                                "text": "L’utilisation du nocturlabe pour déterminer l’heure de nuit est des plus simples, et c’est ce qui fit sa popularité auprès des marins"
                            },
                            {
                                "example_id": "f03b290f-7a9e-4d47-8264-acfe571bae5d",
                                "sense_id": "dcf9c0d0-cd3e-3e36-b849-a2977dcd1e0e",
                                "text": "Conçu à cette fin, le nocturlabe utilisait la rotation quotidienne des étoiles et des constellations autour du pôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
