                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25870bdc-28ac-4a65-98d4-6892f7826a8d",
                        "source_entry_id": "fe5eb65a-8151-349f-afc0-7dd15f9f5c49",
                        "source_sense_id": "fe05a058-227c-3e34-a3e8-f07b64c49ac6",
                        "source_sense_description": "eine runde Vorführfläche im Zirkus",
                        "target_lang_word": "arena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "An enclosed area, often outdoor, for the presentation of sporting events (sports arena) or other spectacular events; earthen area, often oval, specifically for rodeos (North America) or circular area for bullfights (especially Hispanic America)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ff0b7a-64ee-4a22-aceb-4feccf2e37c8",
                                                "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                                "text": "A large crowd filled the seats of the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The building housing such an area; specifically, a very large, often round building, often topped with a dome, designated for indoor sporting or other major events, such as concerts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40968dfa-a82a-4c3d-a567-e7e273021f2e",
                                                "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                                "text": "The arena is grey with white beams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The sand-covered centre of an amphitheatre where contests were held in Ancient Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b88c0b-88f0-4c48-a466-99cb1b9f292d",
                                                "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                                "text": "The gladiators entered the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "A realm in which events take place; an area of interest, study, behaviour, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2fe36eb-87aa-4949-9c7d-415d709e6b5c",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "The company was a player in the maritime insurance arena."
                                            },
                                            {
                                                "example_id": "f09faa6d-f367-4e47-92c4-c7840908d89b",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "But transects have also been utilised in a large variety of arenas, including surveying the contents of Amerindian earthen mounds, determining levels of anti-rabies vaccinations in village dogs, and examining ecological factors under the canopy of trees growing in agricultural areas."
                                            },
                                            {
                                                "example_id": "b3013aa3-fd3c-41d0-9097-703d4bb8b541",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "To Musk, his vast fortune is a mere side effect of his ability not just to see but to do things others cannot, in arenas where the stakes are existential."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6be8ea-7412-404c-959f-c597af92230d",
                        "source_entry_id": "fe5eb65a-8151-349f-afc0-7dd15f9f5c49",
                        "source_sense_id": "fe05a058-227c-3e34-a3e8-f07b64c49ac6",
                        "source_sense_description": "eine runde Vorführfläche im Zirkus",
                        "target_lang_word": "manège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7aebe0a-3452-34b6-9570-859a1aa7afd5",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Dressage des chevaux ; art du dressage des chevaux ; ensemble des exercices que l’on fait faire à un cheval pour le dresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5690e90-5cfb-4157-bfc9-a9ac9cc2b40e",
                                                "sense_id": "b7aebe0a-3452-34b6-9570-859a1aa7afd5",
                                                "text": "Un cheval propre au manège, dressé au manège, bon pour le manège. - Mettre un cheval au manège. - Faire le manège. - Cheval de manège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277bddba-4899-3fe5-b525-7b5fd9fbc85e",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Lieu où l’on exerce les chevaux pour les dresser et où l’on donne des leçons d’équitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aea0182-07a4-4b5a-8469-3600e50a15c6",
                                                "sense_id": "277bddba-4899-3fe5-b525-7b5fd9fbc85e",
                                                "text": "Un manège couvert, découvert. - Nous avons loué, pour notre promenade, des chevaux du manège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef8c378-fed6-3eed-bf22-77acafcbed58",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Mécanisme qui fait tourner des chevaux de bois dans les fêtes publiques, carrousel."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce92a71-5d3e-4466-bb13-b3c5166ae62f",
                                                "sense_id": "2ef8c378-fed6-3eed-bf22-77acafcbed58",
                                                "text": "On arriva sur une petite place circulaire, où étaient dressées quelques boutiques, un bal, un manège. Il n'y avait pas grande foule, quelques badauds seulement circulaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a412fc5a-b773-3d1e-b36d-2bcbd0287449",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Attraction de fête foraine qui consiste en une plate-forme en rotation sur elle-même, sur laquelle sont disposées des miniatures d’animaux, de voitures, d’avions, etc., dans lesquelles s’assoient des enfants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c57398-63ff-46ea-bd64-a5a6b95432c5",
                                                "sense_id": "a412fc5a-b773-3d1e-b36d-2bcbd0287449",
                                                "text": "Au programme, en plus des tours en montgolfière : des magiciens, des amuseurs, des manèges pour enfants mais aussi une compétition de breakdance et le huitième Championnat canadien des athlètes de force."
                                            },
                                            {
                                                "example_id": "dcbb251b-f9a5-459a-a334-88a7c42f3b92",
                                                "sense_id": "a412fc5a-b773-3d1e-b36d-2bcbd0287449",
                                                "text": "La Saint-Gilles me rappelle la foire de Rouen. Jeune, c’était les manèges et leur insolent pom pom. Plus grand, ce fut le chapiteau de l’ours noir avec tout le graillon qui figurait au menu, arrosé par les bouteilles de « cuisses de bergère ». C’était la fête !"
                                            },
                                            {
                                                "example_id": "0a761de7-a702-4aeb-91b5-128aac661f8c",
                                                "sense_id": "a412fc5a-b773-3d1e-b36d-2bcbd0287449",
                                                "text": "La traditionnelle « vogue des marrons » de la Croix-Rousse a démarré samedi dernier pour sept semaines avec son lot de manèges, pêches aux canards et autres stands de tirs qui réjouissent les badauds, et ses inévitables problèmes de bruit et de stationnement qui irritent les riverains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0076611-ff49-38dd-9155-efc3c88a15c1",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Toute attraction de fête foraine ou de parc d'attractions, par exemple des montagnes russes, une grande roue, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04d76aa-33c1-4735-a9bf-0ce9169c670e",
                                                "sense_id": "e0076611-ff49-38dd-9155-efc3c88a15c1",
                                                "text": "Le Goliath, dont la réalisation a été annoncée officiellement hier, est le plus important projet entrepris à La Ronde depuis la construction du Monstre en 1985 et le plus important investissement pour un seul manège depuis l’ouverture du site en 1967."
                                            },
                                            {
                                                "example_id": "83962df5-3276-4baf-a052-ba5d5bb879ac",
                                                "sense_id": "e0076611-ff49-38dd-9155-efc3c88a15c1",
                                                "text": "L’élan des grands manèges soulevant le cœur et faisant crier d’effroi les adolescentes dans la nuit bleue ne s'écarte qu’en apparence des loteries pauvrettes et des tirettes aux peluches à deux sous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d680c2-2b55-37d9-ba24-e75847e50a9d",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Piste de cirque, de forme traditionnellement circulaire de 13 mètres de diamètre. Désigne cet espace autant que le spectacle qui s'y déroule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4a5f21-762b-4201-9550-0c27f7c79b25",
                                                "sense_id": "24d680c2-2b55-37d9-ba24-e75847e50a9d",
                                                "text": "Chaque cirque possède, en outre, un maître de manège, appelé chef de piste ou chef d'équitation, qui a la responsabilité de la cavalerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca1278c-695b-3ca0-a793-4a8679ea2d8a",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Appareil servant à utiliser la force des animaux pour faire mouvoir des machines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a4df760-a00c-4c29-8ee0-bd1ce8fab425",
                                                "sense_id": "6ca1278c-695b-3ca0-a793-4a8679ea2d8a",
                                                "text": "Faire monter de l’eau par un manège."
                                            },
                                            {
                                                "example_id": "96f86e58-d5f4-4026-843e-488ad3f2e445",
                                                "sense_id": "6ca1278c-695b-3ca0-a793-4a8679ea2d8a",
                                                "text": "L’emploi le plus courant des manèges concerne l’exhaure. Le manège entraîne une pompe ou une roue élévatrice dotée d’une chaîne à godets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3350782-0041-3acc-8b05-45f5c82e7d6c",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Appareil muni d’un train d’engrenage et fonctionnant à l’aide de moteurs."
                                        ],
                                        "tags": [
                                            "En général"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ee69148-7aee-39ad-9ff4-b1439cf17c2b",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Mouvement régulier qui sans cesse recommence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeccf282-5094-437a-b505-cf0f7ab78ad3",
                                                "sense_id": "6ee69148-7aee-39ad-9ff4-b1439cf17c2b",
                                                "text": "- Elle contempla longtemps, comme pour engourdir sa peine, le patient manège des abeilles qui s'affairaient d'une fleur à l'autre."
                                            },
                                            {
                                                "example_id": "4cafd50e-d107-46c2-bcbb-bef49e8d1829",
                                                "sense_id": "6ee69148-7aee-39ad-9ff4-b1439cf17c2b",
                                                "text": "Lizbeth n’y croit pas, elle dit que l’amour, c’est de la blague pour faire tourner le manège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1996535f-1e08-3a7e-85c9-33d5f4e87eb2",
                                        "entry_id": "fe988197-2bc2-3cc4-98f2-d05180276bd6",
                                        "glosses": [
                                            "Comportement adroit et artificieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d100168-fa06-41f4-83cb-83e2b33f5cb3",
                                                "sense_id": "1996535f-1e08-3a7e-85c9-33d5f4e87eb2",
                                                "text": "Elle résolut alors […] d'être coquette avec lui comme le sont ces capricieuses maîtresses qui se font un plaisir de tourmenter leurs amants. Ce manège odieux était le seul remède possible à ses maux."
                                            },
                                            {
                                                "example_id": "781e7b93-f0a4-416a-b092-169b73d05f40",
                                                "sense_id": "1996535f-1e08-3a7e-85c9-33d5f4e87eb2",
                                                "text": "Peut-être qu’avant le mariage il pinçait déjà en cachette la Julie. Alors tout ce manège, toute cette comédie, ne visait qu’à lui faire endosser, à lui le patron bonne poire, la paternité du moutard."
                                            },
                                            {
                                                "example_id": "ae8c26bd-299b-400f-89fa-bce8da191fdb",
                                                "sense_id": "1996535f-1e08-3a7e-85c9-33d5f4e87eb2",
                                                "text": "Crispée de jalousie, elle observait le manège de Régine qui, à la fin de la soirée, jouant les étonnées, prétexta que le dernier train pour le Vésinet était depuis longtemps parti pour me prier de l’héberger dans mon studio."
                                            }
                                        ]
                                    }
                                ]
                            },
