                        "entry_id": "106ab8f0-ee64-33ae-9ff6-270f07eff4f3",
                        "glosses": [
                            "The act of dissimilating, of making dissimilar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e1ad7719-8869-3b08-b6fc-33564986351d",
                        "entry_id": "106ab8f0-ee64-33ae-9ff6-270f07eff4f3",
                        "glosses": [
                            "A dissimilatory process that supply a cell with energy only without the assimilation of nutrients."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dca24cfb-3a84-3118-a23f-80edb2600aff",
                        "entry_id": "106ab8f0-ee64-33ae-9ff6-270f07eff4f3",
                        "glosses": [
                            "A phenomenon where one of a pair of similar adjacent consonant or vowel sounds in a word becomes less similar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "414880b2-0139-420f-848b-4348908cb7bf",
                                "sense_id": "dca24cfb-3a84-3118-a23f-80edb2600aff",
                                "text": "Brimstone is \"properly\" *brinstone, displaying an ancient careless pronunciation made respectable by being called \"dissimilation\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fd25a7f-bfdb-4a75-8a76-946a255630b5",
                        "source_entry_id": "106ab8f0-ee64-33ae-9ff6-270f07eff4f3",
                        "source_sense_description": "(phonology) A phenomenon whereby similar consonant or vowel sounds in a word become less similar",
                        "target_lang_word": "dissimilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissimilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                                        "entry_id": "4ea6fdba-7400-322c-af15-fed8b9c57a4b",
                                        "glosses": [
                                            "Différenciation phonétique de deux phonèmes similaires ou voisins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "721eaf61-6a8f-437f-b4e0-9d29f8ed90cb",
                                                "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                                                "text": "La dissimilation est le changement de consonnes internes et le plus fréquent est le passage de 'l' à 'r' ou inversement, comme dans les noms Bourven et Boulven."
                                            },
                                            {
                                                "example_id": "04d35902-1d8b-417f-98c4-17d85900ad16",
                                                "sense_id": "9ab13b7c-584a-3ae5-81b3-d7bbe75f5010",
                                                "text": "Le toponyme « Auvergne » repose sur l'étymon Arvernia qui, avec une dissimilation à distance r…r / l…r a donné Alvernia puis, par contraction de al en au Auvergne, le e final subissant en parallèle une apocope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4001bf75-2dec-4023-adf4-329bc97683de",
                        "source_entry_id": "106ab8f0-ee64-33ae-9ff6-270f07eff4f3",
