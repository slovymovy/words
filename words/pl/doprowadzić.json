    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ed3d554-d8d8-3a83-99e1-d0170b4d72cd",
                    "sense_definition": "towarzysząc komuś, pomóc mu dojść do określonego miejsca",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona była bardzo zmęczona, więc <w>doprowadził</w> ją bezpiecznie do samego domu.",
                            "target_lang_translations": {
                                "ru": "Она очень устала, поэтому он благополучно <w>довел</w> её до самого дома."
                            }
                        },
                        {
                            "text": "Nauczyciel szybko <w>doprowadził</w> zagubione dziecko do dyrekcji szkoły.",
                            "target_lang_translations": {
                                "ru": "Учитель быстро <w>отвёл</w> потерявшегося ребёнка к руководству школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "odprowadzić",
                        "przyprowadzić"
                    ],
                    "common_phrases": [
                        "doprowadzić do domu",
                        "doprowadzić do drzwi"
                    ],
                    "target_lang_definitions": {
                        "ru": "сопровождая кого-либо, помочь ему добраться до определённого места"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довести",
                                "target_lang_sense_clarification": "ведя кого-либо, помочь добраться до места"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "дойти вместе до определенного места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546a0d77-414a-3294-98fe-879f913125eb",
                    "sense_definition": "stać się przyczyną jakiegoś zdarzenia lub wprowadzić kogoś bądź coś w określony stan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "skutek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taka nieodpowiedzialna decyzja może łatwo <w>doprowadzić</w> do poważnego kryzysu w firmie.",
                            "target_lang_translations": {
                                "ru": "Такое безответственное решение может легко <w>привести</w> к серьёзному кризису в компании."
                            }
                        },
                        {
                            "text": "Ciągły hałas za oknem w końcu <w>doprowadził</w> go do wściekłości.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум за окном в конце концов <w>довёл</w> его до ярости."
                            }
                        }
                    ],
                    "synonyms": [
                        "spowodować",
                        "wywołać"
                    ],
                    "common_phrases": [
                        "doprowadzić do szału",
                        "doprowadzić do łez",
                        "doprowadzić do wypadku"
                    ],
                    "target_lang_definitions": {
                        "ru": "послужить причиной события или привести кого-либо либо что-либо в определённое состояние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довести",
                                "target_lang_sense_clarification": "до определённого состояния или предела"
                            },
                            {
                                "target_lang_word": "привести",
                                "target_lang_sense_clarification": "к событию, результату или последствию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4984d62-e7c7-3493-9a4a-c227744030a6",
                    "sense_definition": "sprawić, że instalacja, medium lub płyn dotrze do wyznaczonego miejsca",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instalacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel działki musiał najpierw <w>doprowadzić</w> prąd i wodę do nowej altany.",
                            "target_lang_translations": {
                                "ru": "Владелец участка должен был сначала <w>подвести</w> электричество и воду к новой беседке."
                            }
                        },
                        {
                            "text": "Mechanik <w>doprowadził</w> paliwo bezpośrednio do gaźnika, aby uruchomić silnik.",
                            "target_lang_translations": {
                                "ru": "Механик <w>подал</w> топливо напрямую в карбюратор, чтобы запустить двигатель."
                            }
                        }
                    ],
                    "synonyms": [
                        "podłączyć"
                    ],
                    "antonyms": [
                        "odciąć"
                    ],
                    "common_phrases": [
                        "doprowadzić prąd",
                        "doprowadzić wodę"
                    ],
                    "target_lang_definitions": {
                        "ru": "провести коммуникации, подать электричество, воду или другое вещество к нужному месту"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвести",
                                "target_lang_sense_clarification": "проложить коммуникации к объекту"
                            },
                            {
                                "target_lang_word": "подать",
                                "target_lang_sense_clarification": "направить топливо, жидкость или ток"
                            },
                            {
                                "target_lang_word": "провести",
                                "target_lang_sense_clarification": "проложить линии электропередач, трубы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}