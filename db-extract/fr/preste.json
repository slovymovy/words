                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb0fd857-5464-4e3d-a052-4fe3936c9478",
                        "source_entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
                        "target_lang_word": "vlug",
