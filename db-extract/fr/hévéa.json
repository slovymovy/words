                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7c443c2-3328-4339-a1ad-c5ebf4e0dc90",
                        "entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "tags": [
                            "plural"
                        ],
                        "form": "hévéas"
                    },
                    {
                        "form_id": "3e7e2d33-2921-4c92-88eb-f55fd1f44f37",
                        "entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "tags": [],
                        "form": "hévée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                        "entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "glosses": [
                            "Arbre à feuillage persistant aux feuilles trifoliées de la famille des euphorbiacées de la forêt amazonienne atteignant fréquemment plus de 30 m, connu pour produire du latex."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5861c9ef-89c7-4c0b-baad-9c2d293e0679",
                                "sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                                "text": "L’hévéa a été introduit au début du siècle en Asie du Sud-Est dans des plantations en monoculture par des sociétés privées."
                            },
                            {
                                "example_id": "7e35b2ba-3411-4998-9418-ec1fbf11478c",
                                "sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                                "text": "D’autres paysans louent leurs services dans les plantations de bananes ou d’hévéas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32df40e9-d689-402d-96e4-c4f163feabaf",
                        "source_entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "source_sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                        "target_lang_word": "Hevea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hevea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b969342-d030-3f29-9530-ba8953e837b0",
                                        "entry_id": "9ff8da24-a181-3852-a1e1-e839f9263ad1",
                                        "glosses": [
                                            "tropischer Baum, aus dem Kautschuk gewonnen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f437b30-2b83-48c5-a18e-ca627dad03a7",
                                                "sense_id": "4b969342-d030-3f29-9530-ba8953e837b0",
                                                "text": "„Die Gauchos erzählten von den Heveen am Strom und den Kautschukzapfern, mit denen sie eine Prügelei gehabt hatten; von gespenstischen Indianern, die in den Wäldern verborgen sein sollten; von dem seltsamen Licht, das in mondlosen Nächten wie eine fahle Drohung über die Steppe ginge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e9b484-f446-4773-95b4-594f8cd74ede",
                        "source_entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "source_sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                        "target_lang_word": "Gummibaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gummibaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eaaa2b2-99f4-358b-a503-e3a70de5cb53",
                                        "entry_id": "129eda6c-4c13-3607-b2cb-cc404f2042ae",
                                        "glosses": [
                                            "beliebte Zimmerpflanze aus der Gattung Ficus, aus deren Milchsaft Latex gewonnen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae77bb4-87a5-4335-921b-d6b0c6e2f2c5",
                                                "sense_id": "2eaaa2b2-99f4-358b-a503-e3a70de5cb53",
                                                "text": "In meinem Zimmer steht ein großer Gummibaum."
                                            },
                                            {
                                                "example_id": "bde1c3eb-fa46-41db-a4d2-4deaf6685c64",
                                                "sense_id": "2eaaa2b2-99f4-358b-a503-e3a70de5cb53",
                                                "text": "„Und Gummibäume konnte er nicht ausstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c45a3c7b-355c-3924-9751-b29f9738ff18",
                                        "entry_id": "129eda6c-4c13-3607-b2cb-cc404f2042ae",
                                        "glosses": [
                                            "Pflanze aus der Gattung Hevea, aus deren Milchsaft auch industriell Latex und Kautschuk gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5879c7d6-31f6-4d2b-ac15-62e25a3c56d9",
                                                "sense_id": "c45a3c7b-355c-3924-9751-b29f9738ff18",
                                                "text": "Gummibäume werden in großen Plantagen angepflanzt um Kautschuk zu gewinnen."
                                            },
                                            {
                                                "example_id": "73244b30-ffee-4cc3-bed0-32301a70090a",
                                                "sense_id": "c45a3c7b-355c-3924-9751-b29f9738ff18",
                                                "text": "„Die Hütte stand auf einem sanften Hang im Schatten einiger Gummibäume, die zum Meer hin abgeholzt worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cca0b20-ba6c-4311-97f8-7d4b3385620c",
                        "source_entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
                        "source_sense_id": "0c4e0c97-8faf-3aee-8369-4ad8828f8ca8",
                        "target_lang_word": "hevea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hevea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3870552-bbf7-38d1-8655-75836e7b21b6",
                                        "entry_id": "520c33a6-888f-31af-8fb7-849c35c7848d",
                                        "glosses": [
                                            "Any of the genus Hevea of flowering plants in the spurge family, including the economically important rubber tree Hevea brasiliensis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a78281-186f-4e32-976d-09a779d833ee",
                                                "sense_id": "d3870552-bbf7-38d1-8655-75836e7b21b6",
                                                "text": "Tire executives say that global demand for tires, which use as much as 70 percent of the world’s rubber supply, will expand as less developed nations industrialize, requiring roughly 21 million additional acres of hevea, the source of natural rubber, by 2024."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "194ec962-921a-40e3-a696-01b87c51fb0a",
                        "source_entry_id": "2a866d0b-7101-324f-b919-3ff8f27fcab3",
