        "fr-extract.jsonl": [
            {
                "entry_id": "36559e90-35dc-3ff2-9421-1e7cc734f9d7",
                "word": "géodésie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "484a4f07-9793-4135-876f-342d868fe7cf",
                        "entry_id": "36559e90-35dc-3ff2-9421-1e7cc734f9d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "géodésies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63e91287-efca-33e1-bca2-970132ac46b7",
                        "entry_id": "36559e90-35dc-3ff2-9421-1e7cc734f9d7",
                        "glosses": [
                            "Étude de la forme du globe terrestre déduite des mesures d’arcs de méridien et des mesures de la pesanteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bd1c49-f133-493c-9521-4426c32561bd",
                                "sense_id": "63e91287-efca-33e1-bca2-970132ac46b7",
                                "text": "Mais il a fallu attendre le lancement des premiers satellites artificiels de la Terre pour que la géodésie spatiale prenne tout son essort^([sic])."
                            },
                            {
                                "example_id": "4cebd469-73cf-4451-b469-cfb770cd99ba",
                                "sense_id": "63e91287-efca-33e1-bca2-970132ac46b7",
                                "text": "Thalès, Pythagore mais aussi Platon ou Aristote se seont attachés à résoudre le problème des dimensions et de la forme de la Terre, faisant de la géodésie la mère de toutes les sciences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "154098f0-41cc-484b-95c1-cb6d337a4af6",
                        "source_entry_id": "36559e90-35dc-3ff2-9421-1e7cc734f9d7",
                        "source_sense_id": "63e91287-efca-33e1-bca2-970132ac46b7",
                        "target_lang_word": "Geodäsie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geodäsie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                        "entry_id": "7c86af28-6939-3e30-a5cf-6e0c7ffabe88",
                                        "glosses": [
                                            "Wissenschaft von der Vermessung der Erdoberfläche und von der Technik der Vermessung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d049ff-866e-4f3e-8797-091fcaa6462d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Geodäsie sei weit mehr als Landvermessung und schließe die Geoinformatik, also zum Beispiel Satelliten-Navigation, mit ein."
                                            },
                                            {
                                                "example_id": "5ef07ca9-0492-443e-8e90-3714abee6fb4",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Zwischen 1816 und 1841 vermaß er das gesamte Königreich Hannover, trotz modernster Methoden der Geodäsie ein ermüdendes Tagwerk."
                                            },
                                            {
                                                "example_id": "37516519-fccd-42a9-8bf7-13c2aba63f7d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "In den letzten 20 Jahren stieg der Pegel mit etwa drei Millimeter pro Jahr doppelt so schnell wie im Durchschnitt. Das berichten Forscher vom Institut für Planetare Geodäsie in Dresden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea622f06-9f01-46e1-91d2-e061e1f3104f",
                        "source_entry_id": "36559e90-35dc-3ff2-9421-1e7cc734f9d7",
                        "source_sense_id": "63e91287-efca-33e1-bca2-970132ac46b7",
                        "target_lang_word": "Vermessungswesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermessungswesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbfefe4a-f5e7-3c6d-a881-3e2b4497fc42",
                                        "entry_id": "0ad5259d-5312-3b28-8377-acda161e59f4",
                                        "glosses": [
