                                "target_senses": [
                                    {
                                        "sense_id": "9cda93a0-2231-39bd-a305-cbe80482ee3c",
                                        "entry_id": "3ba41941-7753-3a10-8e06-e511b6924c5c",
                                        "glosses": [
                                            "Boot, das als Wohnung dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337d6cfd-7b7f-4a50-b352-52f409f95883",
                                                "sense_id": "9cda93a0-2231-39bd-a305-cbe80482ee3c",
                                                "text": "Im Hafen von Sausalito kann man immer Hausboote sehen."
                                            },
                                            {
                                                "example_id": "47a3c205-85eb-4303-90a3-f72036a2bb67",
                                                "sense_id": "9cda93a0-2231-39bd-a305-cbe80482ee3c",
                                                "text": "„Sie stand am großen Kreisverkehr und sah aus wie ein gestrandetes Hausboot.“"
                                            },
                                            {
                                                "example_id": "f2a06904-e04d-47e5-a57f-efa87551fd39",
                                                "sense_id": "9cda93a0-2231-39bd-a305-cbe80482ee3c",
                                                "text": "„Als ich 22 Jahre alt war, kaufte ich mir ein Eigenheim – ein Hausboot in London.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2476e926-a98d-464c-9521-d16965f74192",
                        "source_entry_id": "368b5c92-fab8-358d-88aa-a3d12c4ebe31",
                        "target_lang_word": "Wohnschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2efb751-ee7d-304b-8798-63f5f4fb000d",
                                        "entry_id": "44c8ba85-c34c-3046-93e8-f91e22b48641",
                                        "glosses": [
                                            "Schiff, das bewohnt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9178131f-a29b-438a-9fe7-e9de9a099351",
                                                "sense_id": "c2efb751-ee7d-304b-8798-63f5f4fb000d",
                                                "text": "„Ein paar Umdrehungen schneller, strebten wir unserem Wohnschiff zu.“"
                                            },
                                            {
                                                "example_id": "0dbd07cd-6374-40d5-b13d-c0567cc38f8b",
                                                "sense_id": "c2efb751-ee7d-304b-8798-63f5f4fb000d",
                                                "text": "„Das Urlauberschiff war Wohnschiff für über tausend uniform gekleidete Turner und Turnerinnen, unter ihnen Maiden vom Arbeitsdienst, die Nationalmannschaft der Reckturner, aber auch alte Herren, die immer noch am Barren turnten, sowie Gymnastikgruppen der Gemeinschaft »Glaube und Schönheit« und viele auf stadionweites Massenturnen gedrillte Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abbfd5d2-5f9e-4f66-a314-2c3e658cf44e",
