                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a9f8d7-fbdb-4a33-8e34-77b92502dbc8",
                                "sense_id": "c4019673-9170-3341-a2d6-87917ee433cb",
                                "text": "„Das Lüdische gehört zusammen mit dem Olonetzischen zu den Hauptdialekten des Karelischen und steht dem Wepsischen bereits näher als dem Finnischen.“"
                            },
                            {
                                "example_id": "082f5c15-0f92-4f21-9e40-0aec2d3f1a8a",
                                "sense_id": "c4019673-9170-3341-a2d6-87917ee433cb",
                                "text": "„Das Olonetzische wird im Südteil der Karelischen ASSR gesprochen, das Verbreitungsgebiet des Lüdischen liegt als schmaler Streifen östlich von dem des Olonetzischen.“"
                            }
                        ],
