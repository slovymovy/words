                ],
                "senses": [
                    {
                        "sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                        "entry_id": "9164c80d-3d9d-348b-8b89-451caafce912",
                        "glosses": [
                            "wyraz o znaczeniu przeciwnym do danego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a0a62fd-018f-47ab-be3b-c20b662cf46b",
                                "sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                                "text": "Antonimem słowa „dobry” jest „zły”, a „zły” jest antonimem dla „dobry”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fb2202c-31fc-452f-bc8a-6cc2190a3f8b",
                        "source_entry_id": "9164c80d-3d9d-348b-8b89-451caafce912",
                        "source_sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                        "target_lang_word": "antonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "518c5322-af98-333f-80c6-b93b4b7e7586",
                                        "entry_id": "1a651383-a826-36e5-99ec-ec105bb81193",
                                        "glosses": [
                                            "A word which has the opposite meaning of another word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac4887b-df53-4a27-98fb-7cc59875f486",
                                                "sense_id": "518c5322-af98-333f-80c6-b93b4b7e7586",
                                                "text": "“Rich” is an antonym of “poor”; “full” is an antonym of “empty”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b30dbf-93b1-3fab-828d-8fc498a2e44e",
                                        "entry_id": "1a651383-a826-36e5-99ec-ec105bb81193",
                                        "glosses": [
                                            "A word which has the opposite meaning of another word.",
                                            "A word that describes one end of a scale, while its opposite describes the other end, such as large versus small; a gradable antonym."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514b05b0-f45d-4929-aa3e-a97267dca9fd",
                                                "sense_id": "76b30dbf-93b1-3fab-828d-8fc498a2e44e",
                                                "text": "All four lines of the pattern are required to establish that hot and cold are antonyms.\nThe water is hot entails The water is not cold.\nThe water is cold entails The water is not hot.\nThe water is not hot does not entail The water is cold.\nThe water is not cold does not entail The water is hot."
                                            },
                                            {
                                                "example_id": "e091432c-1908-45be-9d3b-a9b75d56abbd",
                                                "sense_id": "76b30dbf-93b1-3fab-828d-8fc498a2e44e",
                                                "text": "\"The word 'boom' always makes me uneasy because the antonym of it is bust,\" said Patrick Jankowski, vice president of research at the Greater Houston Partnership. \"Houston is not in a boom -- it is on a new path.\""
                                            },
                                            {
                                                "example_id": "41db08dc-24f0-4385-8b2d-cf042aa0be8a",
                                                "sense_id": "76b30dbf-93b1-3fab-828d-8fc498a2e44e",
                                                "text": "\"To me, Pusher Street is actually the least unique, right? It is what I associate with violence, gangs, murder, threats, and everything which are actually antonyms to what Christiania is,\" said Mathilde Brandstrup, a Christiania local."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc2c4673-7f93-4070-9133-ef39eec40d87",
                        "source_entry_id": "9164c80d-3d9d-348b-8b89-451caafce912",
                        "source_sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                        "target_lang_word": "antonymum",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antonymum",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1b906155-dc75-3351-9ba5-fffc6e272658",
                                        "entry_id": "df01ad0b-45e1-3792-8059-4d3d6e7f2bd4",
                                        "glosses": [
                                            "slovo opačného významu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d60e8348-660e-4c0e-9716-c879af3d5776",
                                                "sense_id": "1b906155-dc75-3351-9ba5-fffc6e272658",
                                                "text": "Vysoký je antonymum ke slovu nízký."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc805e65-57f9-45a6-89f2-1b4ef6e36f30",
                        "source_entry_id": "9164c80d-3d9d-348b-8b89-451caafce912",
                        "source_sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                        "target_lang_word": "antonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                        "entry_id": "2c8e76e9-5b81-3656-bf25-579d6e4d0a46",
                                        "glosses": [
                                            "Mot qui a un sens opposé à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc96a1ed-fcfa-4691-a99b-8c8362156534",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "Typiquement, depuis il n'est pas possible de définir un « antonyme absolu » d'un mot spécifique, les substitutions s'effectuent en fonction du contexte et, en général, plusieurs résultats différents peuvent être obtenus à partir d'un même texte à manipuler."
                                            },
                                            {
                                                "example_id": "e37b48c7-1a2a-47d6-8267-2e50a7f73ed0",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "Sur le plan du lexique, lʼantonyme le plus courant de Dreck (saleté) est probablement Sauberkeit (propreté)."
                                            },
                                            {
                                                "example_id": "fc143822-11b4-41fa-9e3a-be9e2bb12037",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "Un antonyme est la désignation dans une langue d'un concept opposé à un autre. Par exemple: donner/prendre ; emprunter/rembourser ; monter/démonter ; analogique/numérique."
                                            },
                                            {
                                                "example_id": "cf901574-9a34-4a75-b785-9acc4ad51a60",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "C’était en cours de français avec Mme Maigre (qui est un antonyme vivant tellement elle a de bourrelets)."
                                            },
                                            {
                                                "example_id": "e7ba2c12-69b0-43de-a37a-7cf784232f34",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "La langue française est tellement facétieuse que ce qui peut être considéré comme antonyme (ou contraire) dans un contexte peut devenir synonyme (ou semblable) dans un autre."
                                            },
                                            {
                                                "example_id": "6c9d33b7-e3aa-4522-9f71-1d225faa27ee",
                                                "sense_id": "82e5d8ee-0beb-35fb-9056-76a2c9efed6b",
                                                "text": "Les couples formés par les antonymes ne sont pas indissociables. Le choix de l’antonyme doit être adapté au contexte d'emploi.\nUn mot pris au sens figuré n’a pas le même antonyme que lorsqu’il est pris au sens propre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e618ecb-4d8e-4541-b162-4da81431b842",
                        "source_entry_id": "9164c80d-3d9d-348b-8b89-451caafce912",
                        "source_sense_id": "91eb6c81-7a42-32dc-9d01-64ccfe6741f0",
                        "target_lang_word": "antónimo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antónimo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "631b9828-6ec4-3679-b5ca-eea2c07705ef",
                                        "entry_id": "8e08c674-f981-381f-8289-cd625c7c3112",
                                        "glosses": [
                                            "Palabra que tiene un significado opuesto a una o más de las acepciones de otra."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
