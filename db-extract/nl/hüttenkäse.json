                                        "entry_id": "e212853d-def4-3f21-b851-670c3c344143",
                                        "glosses": [
                                            "grobkörniger Frischkäse, der aus Magermilch hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484f9f01-dc87-4b55-96a6-e2fedf9ae9b2",
                                                "sense_id": "e367fc99-2e9d-3edc-91f6-120acba795fc",
                                                "text": "Hüttenkäse wird direkt gegessen oder auch als Brotaufstrich oder in Salatsoßen verwendet."
                                            },
                                            {
                                                "example_id": "e1c20f03-8db2-40fc-b3cb-dd1e2817e28e",
                                                "sense_id": "e367fc99-2e9d-3edc-91f6-120acba795fc",
                                                "text": "Mal können wir uns an Hüttenkäse mit Schnittlauch laben, mal wird uns ein Stück Vollkornbrot und eine durchsichtig dünne Scheibe Kalbsbraten serviert, mal tun wir uns gütlich an Magerquark mit Leinsamen."
                                            },
                                            {
                                                "example_id": "4b09e9af-7cce-4ae1-a445-3b4b1ec96d78",
                                                "sense_id": "e367fc99-2e9d-3edc-91f6-120acba795fc",
                                                "text": "Seit Tagen ernähre ich mich deshalb, so wie meine Frau es gerne hätte, mit Vollkornknäcke, Brunnenkresse, Radieschen und Hüttenkäse."
                                            }
                                        ],
