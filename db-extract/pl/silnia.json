                                                "example_id": "d49a92a4-2c9c-4f2c-9413-d9757442151a",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "Der Dekan begrüßt jedes Semester als Vorsteher der medizinischen Fakultät die neuen Studenten der Medizin."
                                            },
                                            {
                                                "example_id": "68237ac8-d31f-4094-b904-d4816a1e99b5",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "Über die Belegung des Albert-Einstein-Hörsaals entscheidet die Fakultät für Physik, nicht die Universitätsverwaltung."
                                            },
                                            {
                                                "example_id": "5a3fbe6a-7283-4bc1-b150-acd114067272",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "„Vor Dorpat warteten ein Dutzend Journalisten sowie die gesamte naturwissenschaftliche Fakultät.“"
                                            },
                                            {
                                                "example_id": "70341fd1-bc4f-44c8-8713-a806cf98e59e",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "„Die zuständige Fakultät der Universität Düsseldorf hat das Verfahren zur Aberkennung des Doktortitels einer früheren Doktorandin eingeleitet.“"
                                            },
                                            {
                                                "example_id": "9d59b2ff-1815-45c1-a425-e1595fe5caa2",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "„Den von der Vortragenden im Rahmen ihrer Dissertation erhobenen Daten lässt sich entnehmen, dass derzeit über ein Drittel der Deutschstudierenden aus anderen Fakultäten kommt.“"
                                            },
                                            {
                                                "example_id": "e21e9d1b-e00d-4bd8-b5c3-94de205ff621",
                                                "sense_id": "3d9365dd-a138-369a-9667-4e07d535cd86",
                                                "text": "„Von der Schiffsanlegestelle auf der linken Rheinseite waren es nur noch fünf Minuten bis zum Juridicum, der Rechtswissenschaftlichen Fakultät der Bonner Universität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ba2a7c7-0ca4-3b6c-9814-3757fadc80bf",
                                        "entry_id": "28b47274-5975-323e-8020-1deb09119bf4",
                                        "glosses": [
                                            "mathematische Funktion, die eine natürliche Zahl n auf n! = 1 · 2 · … · n abbildet"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9ee10d-27ac-46ad-9d86-8424c7812cff",
                                                "sense_id": "1ba2a7c7-0ca4-3b6c-9814-3757fadc80bf",
                                                "text": "5 Fakultät ist 1 · 2 · 3 · 4 · 5 = 120."
                                            },
                                            {
                                                "example_id": "59f94efe-4cd8-44c3-88ca-d61c01a3a10f",
                                                "sense_id": "1ba2a7c7-0ca4-3b6c-9814-3757fadc80bf",
                                                "text": "Für n Personen, die sich auf n fest platzierte Sitze verteilen, gibt es n! verschiedene Sitzordnungen."
                                            },
                                            {
                                                "example_id": "e9c68096-ab56-4fe4-92a7-b2a6f57ca1be",
                                                "sense_id": "1ba2a7c7-0ca4-3b6c-9814-3757fadc80bf",
                                                "text": "„Wenn Mathematiker Spaß haben wollen, denken sie sich Fakultäten aus, die sie mit ! kennzeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
