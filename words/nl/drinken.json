                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je hebt <w>gedronken</w>, mag je absoluut geen autorijden.",
                            "target_lang_translations": {
                                "en": "If you have <w>drunk</w>, you absolutely must not drive.",
                                "ru": "Если вы <w>выпили</w>, вам категорически нельзя садиться за руль.",
                                "pl": "Jeśli <w>piłeś</w>, absolutnie nie wolno ci prowadzić samochodu.",
                                "de": "Wenn du <w>getrunken</w> hast, darfst du absolut kein Auto fahren.",
                                "fr": "Si tu as <w>bu</w>, tu ne dois absolument pas conduire.",
                                "it": "Se hai <w>bevuto</w>, non devi assolutamente guidare.",
                                "cs": "Pokud jsi <w>pil</w>, nesmíš v žádném případě řídit auto.",
                                "tr": "Eğer alkol <w>aldıysan</w>, kesinlikle araba kullanmamalısın.",
                                "es": "Si has <w>bebido</w>, no debes conducir bajo ningún concepto."
                            }
                        },
                        {
                            "text": "Hij <w>dronk</w> gisteren te veel op het feest en heeft nu hoofdpijn.",
                            "target_lang_translations": {
                                "en": "He <w>drank</w> too much at the party yesterday and now has a headache.",
                                "ru": "Вчера на вечеринке он слишком много <w>выпил</w>, и теперь у него болит голова.",
                                "pl": "Wczoraj na imprezie za dużo <w>wypił</w> i teraz boli go głowa.",
                                "de": "Er hat gestern auf der Party zu viel <w>getrunken</w> und hat jetzt Kopfschmerzen.",
                                "fr": "Il a trop <w>bu</w> hier à la fête et a maintenant mal à la tête.",
                                "it": "Ieri alla festa ha <w>bevuto</w> troppo e ora ha mal di testa.",
                                "cs": "Včera na večírku moc <w>pil</w> a teď ho bolí hlava.",
                                "tr": "Dün partide çok fazla <w>içti</w> ve şimdi başı ağrıyor.",
                                "es": "Ayer <w>bebió</w> demasiado en la fiesta y ahora tiene dolor de cabeza."
                            }
