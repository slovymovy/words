                "senses": [
                    {
                        "sense_id": "f5531af6-a225-3f84-ac58-08b364df1a68",
                        "entry_id": "52520ea5-ea9d-351a-a937-5720899f5621",
                        "glosses": [
                            "goed te vergelijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b340a9f0-24a3-40ac-9d07-8349c7a14248",
                                "sense_id": "f5531af6-a225-3f84-ac58-08b364df1a68",
                                "text": "Het schubdier van Afrika en de miereneter van Zuid-Amerika spelen een vergelijkbare rol in de dierenwereld van hun werelddeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c5d82e2-b10f-4e22-8696-4a59b8db62c6",
                        "source_entry_id": "52520ea5-ea9d-351a-a937-5720899f5621",
                        "source_sense_id": "f5531af6-a225-3f84-ac58-08b364df1a68",
                        "source_sense_description": "goed te vergelijken",
                        "target_lang_word": "vergleichbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergleichbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b10a2c-72cb-33a0-80b3-3c0d0dcc6238",
                                        "entry_id": "bc5de426-0fe6-3f8e-be6e-f18c79fb47b4",
                                        "glosses": [
                                            "so, dass man es (mit etwas Anderem) vergleichen kann, weil es in einer Eigenschaft ähnlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "068edc13-7560-4e6a-b078-26813208c5cd",
                                                "sense_id": "e6b10a2c-72cb-33a0-80b3-3c0d0dcc6238",
                                                "text": "Einen vergleichbaren Fall hat der Richter noch nie erlebt."
                                            },
                                            {
                                                "example_id": "03c7ef99-ce18-49ec-8160-574554af95c2",
                                                "sense_id": "e6b10a2c-72cb-33a0-80b3-3c0d0dcc6238",
                                                "text": "Da Mussawi der Ethnie der Aserbaidschaner angehöre, wäre eine solche Niederlage mit einer Wahlniederlage Barack Obamas gegenüber John McCain unter den Afroamerikanern vergleichbar."
                                            },
                                            {
                                                "example_id": "5db13b1f-9f41-467a-bec6-2ffb8a95bea3",
                                                "sense_id": "e6b10a2c-72cb-33a0-80b3-3c0d0dcc6238",
                                                "text": "„Neben einer persönlichen Begutachtung helfen der offizielle Mietspiegel der Stadt, Informationen von Vermieterverbänden und vergleichbare Mietgesuche und Immobilienanzeigen in Zeitungen und im Internet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5a71d78-6c31-4691-ba45-cee8747235ea",
                        "source_entry_id": "52520ea5-ea9d-351a-a937-5720899f5621",
                        "source_sense_id": "f5531af6-a225-3f84-ac58-08b364df1a68",
                        "source_sense_description": "goed te vergelijken",
                        "target_lang_word": "comparable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                                        "glosses": [
                                            "Able to be compared (to)."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89bbd01a-fee0-4886-8076-ad38b5a3ce78",
                                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                                "text": "An elephant is comparable in size to a double-decker bus."
                                            },
                                            {
                                                "example_id": "5358a1fd-19aa-4161-a354-35a99ac9aee6",
                                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                                "text": "You can't say that robbing a bank is like pickpocketing. The two are just not comparable."
                                            },
                                            {
                                                "example_id": "4e053859-22fb-43e9-9112-a8989b85071b",
                                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                                "text": "The firebox married to Britannia's boiler is not, however, in the Doncaster tradition, notwithstanding that it is comparable in dimensions to that of the \"V2.\""
                                            },
                                            {
                                                "example_id": "2824843e-8fbf-4f63-a9ed-82db0d35f651",
                                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                                "text": "As yet, we don't know what the comparable figures will be like for the current financial year which ends in March 2022, but we can have a good stab at approximating them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                                        "glosses": [
                                            "Similar (to); like."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849c9409-e3da-443c-af74-43882688ab10",
                                                "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                                        "glosses": [
                                            "Constituting a pair in a particular partial order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07af34da-81ef-4c40-8745-1faa98ec289d",
                                                "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                                                "text": "Six and forty-two are comparable in the divides order, but six and nine are not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                                        "glosses": [
                                            "Having comparative and superlative forms."
                                        ],
                                        "tags": [
                                            "of an adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c40ef8-7bdd-4350-922c-b3f58a6cb44d",
                                                "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                                                "text": "\"Big\" is a comparable adjective because it can take the forms \"bigger\" and \"biggest\"; \"unique\" and \"amazing\", in contrast, are not comparable adjectives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa6a3eb-a590-380f-8756-89e017cdd642",
                                        "entry_id": "46a558a0-9b8a-33f0-be2a-49b36718d6c9",
                                        "glosses": [
                                            "Something suitable for comparison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e47de0-a50b-443a-b480-1408b08b6891",
                                                "sense_id": "daa6a3eb-a590-380f-8756-89e017cdd642",
                                                "text": "And the appraiser said he couldn't come up with comparables, because there hadn't been any sales nearby in several months."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a7f0fd-2eb2-4607-b671-d41099b8a1c3",
                        "source_entry_id": "52520ea5-ea9d-351a-a937-5720899f5621",
                        "source_sense_id": "f5531af6-a225-3f84-ac58-08b364df1a68",
                        "source_sense_description": "goed te vergelijken",
                        "target_lang_word": "comparable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                                        "glosses": [
                                            "Qui peut être comparé avec quelqu’un ou avec quelque chose pour leur ressemblance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df7591e-8160-4106-8a2f-96c76ee40f53",
                                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                                "text": "La rupture des glaces s’opérait avec un fracas extraordinaire, comparable parfois à des décharges d’artillerie."
                                            },
                                            {
                                                "example_id": "121a4196-6009-4284-baba-cc85e6f54efa",
                                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                                "text": "J'ai vu, dans ma longue carrière d'ingénieur acousticien, bien des matières excellentes conductrices du son, mais jamais je n'en rencontrerai une seule comparable, même de loin, à celle dont sont pétris les murs de l'hôtel Terminus à Marseille."
                                            },
                                            {
                                                "example_id": "9b661aa2-89fb-40de-8c1d-670a66542eff",
                                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                                "text": "La fragilité des aciers carburés trempés, comparable à celle du verre, semble, elle aussi, une propriété caractéristique du carbure trempant du fer β plutôt que du fer β lui—même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b80ec68-a913-393a-be3f-3d1c8f998c8e",
                                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                                        "glosses": [
                                            "Entre lesquels existe une relation d’ordre."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61a3d7b-3874-4a2f-928d-471f1e2ce895",
                                                "sense_id": "3b80ec68-a913-393a-be3f-3d1c8f998c8e",
                                                "text": "Deux éléments x et y d’un ensemble sont dits comparables si le premier est inférieur ou égal au second (noté x ≤ y) ou vice-versa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b3620c-c110-3fa0-bd3a-3015acffe1fb",
                                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                                        "glosses": [
                                            "Dont on peut former le comparatif de supériorité et le superlatif de supériorité."
                                        ],
                                        "tags": [
                                            "Adjectif ou adverbe"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
