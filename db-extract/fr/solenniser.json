        "fr-extract.jsonl": [
            {
                "entry_id": "f6eca5da-608a-3a17-81c1-88f068d80846",
                "word": "solenniser",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1515454-8726-466e-8c14-0d48869b1c2f",
                        "entry_id": "f6eca5da-608a-3a17-81c1-88f068d80846",
                        "tags": [],
                        "form": "solemniser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d26a9a57-a57c-33c8-a4ea-365b5d400221",
                        "entry_id": "f6eca5da-608a-3a17-81c1-88f068d80846",
                        "glosses": [
                            "Célébrer avec cérémonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628710a3-3172-434d-a3b2-d88a8d22b318",
                                "sense_id": "d26a9a57-a57c-33c8-a4ea-365b5d400221",
                                "text": "La menace de la mer est là, et ce qui achève de solenniser ce spectacle, c’est que, pendant cette récolte faite aux sillons de la vague comme pendant la moisson de terre, le silence plane, un silence actif, plein de l’effort d’un peuple en face de la nature avare et rebelle."
                            },
                            {
                                "example_id": "60351e49-bbb2-4421-9914-4f1f5733908a",
                                "sense_id": "d26a9a57-a57c-33c8-a4ea-365b5d400221",
                                "text": "Emporté par le mouvement multiforme de la lutte, il a tendance à se fixer sur des tâches locales, poursuivies avec ardeur mais presque toujours solennisées."
                            },
                            {
                                "example_id": "d2ec3f61-b016-4897-9bb1-44bdc9b81f6b",
                                "sense_id": "d26a9a57-a57c-33c8-a4ea-365b5d400221",
                                "text": "Il y avait aussi dans la saisine du sénat une volonté de solenniser certaines affaires, voire de les théâtraliser."
                            },
                            {
                                "example_id": "0eb100ad-43a4-4b93-b63f-eb25b96d3f34",
                                "sense_id": "d26a9a57-a57c-33c8-a4ea-365b5d400221",
                                "text": "C’est un jour de réjouissance, il faut le solenniser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "794031cf-a266-460f-8c9b-0bcb36ec320d",
                        "source_entry_id": "f6eca5da-608a-3a17-81c1-88f068d80846",
