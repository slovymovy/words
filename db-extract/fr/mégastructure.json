                        "form": "mégastructures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96d95332-4201-3e9c-80c6-547a9b037837",
                        "entry_id": "231ef380-a4f2-3f47-8e3b-8e1561e8d2ed",
                        "glosses": [
                            "Structure de très grande taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20527d5-cd1b-4554-8b5d-3f40c99ccc10",
                                "sense_id": "96d95332-4201-3e9c-80c6-547a9b037837",
                                "text": "Souvent sis dans des espaces industriels, semi-squats de mégastructures, pour garder de bas loyers, les artistes doivent souvent changer d’adresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f3b8dca-9995-355f-a655-b1e1b19691cf",
                        "entry_id": "231ef380-a4f2-3f47-8e3b-8e1561e8d2ed",
                        "glosses": [
                            "Dans les ouvrages de grandes dimensions, éléments principaux reprenant les efforts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a478064b-f2a6-4c6d-be85-225d61520a77",
                                "sense_id": "8f3b8dca-9995-355f-a655-b1e1b19691cf",
                                "text": "C’est lui qui a voulu que, dans ces deux parties de bâtiment bien moins classiques que les étages de bureaux, ici et là soit apparente la mégastructure, béton nu et formes puissantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "116633c4-3df6-4cdb-849e-c540d2bfe0d5",
                        "source_entry_id": "231ef380-a4f2-3f47-8e3b-8e1561e8d2ed",
                        "target_lang_word": "megastructure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megastructure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5acf6f00-3c84-3c67-ad17-c4d4f29d1044",
                                        "entry_id": "dc54ecfd-061d-36b4-9efe-0c78e0b7d00e",
                                        "glosses": [
                                            "A very large structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cacc07f0-c3d8-4e8a-9170-c6e31d2937b8",
                                                "sense_id": "5acf6f00-3c84-3c67-ad17-c4d4f29d1044",
                                                "text": "I never cared for zipways as a way to get around megastructures like this. I always thought that there was a reason God invented taxis."
                                            },
                                            {
                                                "example_id": "41d9bc16-8d2b-4e4c-8515-709cbbc9c3cb",
                                                "sense_id": "5acf6f00-3c84-3c67-ad17-c4d4f29d1044",
                                                "text": "“The concern,” said Mayor Brad Parton, “is ending up with a mega-structure that costs us more than we anticipated to maintain, and that will end up as a deficit on our tax rolls.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073b7054-dd8f-3ee8-8946-8510f0808e7d",
                                        "entry_id": "dc54ecfd-061d-36b4-9efe-0c78e0b7d00e",
                                        "glosses": [
                                            "A very large structure.",
                                            "A specific type of structure characterized by very large buildings with strictly artificial forms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b477e6-8c1e-4bd1-a238-496cb8137dc5",
                                                "sense_id": "073b7054-dd8f-3ee8-8946-8510f0808e7d",
                                                "text": "A fusion of architecture and city planning, megastructures were supposed to bring together mixed uses -- like housing, shopping, transportation and public space -- within a single building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5d7fbb2-4c4f-391b-afc1-462e412f31ea",
                                        "entry_id": "dc54ecfd-061d-36b4-9efe-0c78e0b7d00e",
                                        "glosses": [
                                            "A very large structure.",
                                            "A hypothetical structure not possible with current technology, e.g., a Dyson sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff95b984-fc0b-4875-a9f9-051712dccf1c",
                                                "sense_id": "d5d7fbb2-4c4f-391b-afc1-462e412f31ea",
                                                "text": "For lack of anything intelligent to do (it's a slow weekend), I've been compiling a list of stories about \"megastructures\" -- ringworlds, Dyson spheres, and so forth."
                                            },
                                            {
                                                "example_id": "21ba23bc-df27-4183-8216-9cc6d3cc036e",
                                                "sense_id": "d5d7fbb2-4c4f-391b-afc1-462e412f31ea",
                                                "text": "Wright and his co-authors say the unusual star’s light pattern is consistent with a “swarm of megastructures,” perhaps stellar-light collectors, technology designed to catch energy from the star."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "941780a6-0897-3d74-981f-d0bfbc545dd8",
                                        "entry_id": "dc54ecfd-061d-36b4-9efe-0c78e0b7d00e",
                                        "glosses": [
                                            "The large-scale structure of a material, as contrasted to the fine-scale structure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbd9baa1-b3af-418a-9dfb-6e189887d656",
                                                "sense_id": "941780a6-0897-3d74-981f-d0bfbc545dd8",
                                                "text": "That local concentration of the sulphur, phosphorous and carbon is also found in many other positions has been proved by the most invaluable method of examining the macrostructure or megastructure of complete sections, of ingots and forged material, after the surfaces of the steel have been polished and etched in a suitable way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
