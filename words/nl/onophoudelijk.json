    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                    "sense_definition": "zonder te stoppen of te onderbreken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuïteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar <w>onophoudelijke</w> geklaag over het weer begon iedereen in de kamer te irriteren.",
                            "target_lang_translations": {
                                "en": "Her <w>incessant</w> complaining about the weather started to irritate everyone in the room."
                            }
                        },
                        {
                            "text": "In de verte hoorden we het <w>onophoudelijke</w> geluid van de waterval in het bos.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard the <w>constant</w> sound of the waterfall in the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortdurend",
                        "constant",
                        "aanhoudend",
                        "continu"
                    ],
                    "antonyms": [
                        "incidenteel",
                        "onderbroken",
                        "stokkend"
                    ],
                    "common_phrases": [
                        "onophoudelijke regen",
                        "onophoudelijke stroom",
                        "onophoudelijke herhaling"
                    ],
                    "target_lang_definitions": {
                        "en": "without stopping or interrupting; continuing for a long time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "recurring or persisting over time"
                            },
                            {
                                "target_lang_word": "incessant",
                                "target_lang_sense_clarification": "continuing without pause, often in an annoying way"
                            },
                            {
                                "target_lang_word": "uninterrupted",
                                "target_lang_sense_clarification": "without any breaks or gaps"
                            },
                            {
                                "target_lang_word": "continuous",
                                "target_lang_sense_clarification": "forming an unbroken whole"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0a50dffa-3aee-339d-bdd7-653083245560",
                    "sense_definition": "op een manier die maar doorgaat zonder pauze",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuïteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bleef die middag <w>onophoudelijk</w> regenen waardoor de straten blank kwamen te staan.",
                            "target_lang_translations": {
                                "en": "It continued to rain <w>ceaselessly</w> that afternoon, causing the streets to flood."
                            }
                        },
                        {
                            "text": "De jonge kinderen praatten <w>onophoudelijk</w> over hun spannende belevenissen tijdens de schoolreis.",
                            "target_lang_translations": {
                                "en": "The young children talked <w>non-stop</w> about their exciting experiences during the school trip."
                            }
                        }
                    ],
                    "synonyms": [
                        "aan één stuk door",
                        "onafgebroken",
                        "constant"
                    ],
                    "antonyms": [
                        "af en toe",
                        "sporadisch"
                    ],
                    "common_phrases": [
                        "onophoudelijk doorgaan",
                        "onophoudelijk praten",
                        "onophoudelijk regenen"
                    ],
                    "target_lang_definitions": {
