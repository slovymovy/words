                        ],
                        "form": "die Umgebungslufttemperaturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                        "entry_id": "0e363e63-9d43-3e4d-b6b8-908399dae736",
                        "glosses": [
                            "Wahrnehmung der Temperatur der Luft um sich selbst oder einen bestimmten Punkt oder Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00faae21-9150-4704-9bd2-35c4b90fabbe",
                                "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                                "text": "„Diese Erfindung bezieht sich auf eine Kraftfahrzeugklimaanlage und insbesondere auf eine Meßschaltung zur Benutzung in einer Vorrichtung zum Erfassen einer Umgebungslufttemperatur, die in einer Kraftfahrzeugklimaanlage benutzt wird.“"
                            },
                            {
                                "example_id": "53b4e3df-00f6-46e8-b405-b7a11c976032",
                                "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                                "text": "„Es wird ein praktisches Verfahren zur Berechnung der Temperaturverteilung in ein- und mehrschichtigen Aussenwaenden infolge zeitlich veraenderlicher Umgebungslufttemperatur angegeben."
                            },
                            {
                                "example_id": "5ebfbeae-bb41-4555-a46f-938518112ce3",
                                "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                                "text": "„Falls Messdaten der Umgebungslufttemperatur für einen Standort vorhanden sind, können diese direkt als Eingabe für die Berechnung verwendet werden.“"
                            },
                            {
                                "example_id": "ce86eaa2-3b7e-49c6-82a3-0358a8291e25",
                                "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                                "text": "„Vollkommen keimfrei und ohne Wasserbehandlung wird das Kühlmedium auf Temperaturen abgekühlt die niedriger als die Umgebungstemperatur sind.“"
                            },
                            {
                                "example_id": "727dc3f5-9363-4b80-a4fc-1bd70cd66c76",
                                "sense_id": "5574c5c4-ecd2-37ac-a23b-90b59cb5e018",
                                "text": "„Er muss der Umgebungslufttemperatur entsprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
