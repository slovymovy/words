                                    {
                                        "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                        "entry_id": "31a28694-c5d9-3330-b02d-413b72ac8061",
                                        "glosses": [
                                            "De manière lente, peu rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc47efc2-87c9-4bbe-bdbc-2e0dac7c668c",
                                                "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                                "text": "On procède à l'incubation des œufs en les exposant à une température artificielle qui doit être élevée lentement et graduellement depuis 12° jusqu'à 25° ou 30°."
                                            },
                                            {
                                                "example_id": "2ace1672-3233-4ba0-b301-1ce7b0dd5b73",
                                                "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                                "text": "L'inlandsis du continent groenlandais se déversant lentement mais continuellement dans les fjords par des glaciers importants, vêle des icebergs de tailles variant à l'infini."
                                            },
                                            {
                                                "example_id": "29572f40-878b-45b0-baaf-30aeadfe7323",
                                                "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                                "text": "Tout d’un coup, lentement, comme une gueule, s’ouvrirent les deux battants des portes."
                                            },
                                            {
                                                "example_id": "e1a920bc-04a2-4014-a0b0-ba2658a9c692",
                                                "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                                "text": "L'infirmier n'appuyait que très lentement sur la seringue et le liquide ne devait s'écouler que goutte à goutte dans mon sang."
                                            },
                                            {
                                                "example_id": "d90351ab-8674-46d7-9701-2a8ff23a1128",
                                                "sense_id": "5e0a9b76-b2ab-349a-b6ee-8ce4505bbf7a",
                                                "text": "L’hélice tournait plus lentement, pour maintenir seulement l’aéronat contre la brise, et son ronflement était beaucoup plus perceptible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
