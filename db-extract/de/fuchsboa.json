                "senses": [
                    {
                        "sense_id": "26261a59-70ad-3908-b3df-594ec198414d",
                        "entry_id": "b2eb279e-caca-3354-80ed-9cb92723fb80",
                        "glosses": [
                            "aus Fuchspelz gefertigtes, schalartiges Kleidungsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a2222e-4264-4af7-bf71-0e1e645f487b",
                                "sense_id": "26261a59-70ad-3908-b3df-594ec198414d",
                                "text": "„Die Schöne greift nach einer weißen Fuchsboa, die sich über einen Stuhl neben ihr schlängelt, und wirft diese um den Hals.“"
                            },
                            {
                                "example_id": "e1c28fd0-1382-4f3e-ac2b-fa30ddb46456",
                                "sense_id": "26261a59-70ad-3908-b3df-594ec198414d",
                                "text": "„Johannes deutet auf eine der hinteren Reihen, wo bereits zwei alte Damen, beide mit Fuchsboa und Federhütchen, sitzen.“"
                            },
                            {
                                "example_id": "9ab845f1-fd3e-4bb4-b9e8-cd61c360cee9",
                                "sense_id": "26261a59-70ad-3908-b3df-594ec198414d",
                                "text": "„Sie legte ihren roten Mantel, ihre Fuchsboa ab, sie zog die Stiefeletten aus und sorgte für Essen und Trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
