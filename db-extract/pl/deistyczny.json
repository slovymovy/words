                ],
                "translations": [
                    {
                        "translation_id": "0796e97f-aa2f-4eb4-b695-c771cda7bdf7",
                        "source_entry_id": "14c09383-f7ac-37ae-9bba-fc6355c89d9b",
                        "source_sense_id": "68ea11d5-ff2d-31a2-a425-45ca60721368",
                        "target_lang_word": "deistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b9d96e4-ad74-3542-ac86-b53777fd8543",
                                        "entry_id": "717d4e75-2977-313c-b78c-8724752a4587",
                                        "glosses": [
                                            "Of or relating to deism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce63683-9d9e-4a94-aaea-dc064d4e0763",
                                                "sense_id": "2b9d96e4-ad74-3542-ac86-b53777fd8543",
                                                "text": "The mystic is one to whom the unitive, pantheistic, or at least the panentheistic, aspects of the divinity are as congenial as the deistic, polytheistic, and anthropomorphic aspects are to the institutional mind."
                                            },
                                            {
                                                "example_id": "de9cff87-f314-4285-8276-831d86bae33a",
                                                "sense_id": "2b9d96e4-ad74-3542-ac86-b53777fd8543",
                                                "text": "Sometimes these sagas and anecdotes are touched with ribaldry, or with excessive obscenity, according to the times, and sometimes they are rooted in obscure but still verifiable deistic concepts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebc82f06-425b-448d-9000-3de4b03b232b",
                        "source_entry_id": "14c09383-f7ac-37ae-9bba-fc6355c89d9b",
                        "source_sense_id": "68ea11d5-ff2d-31a2-a425-45ca60721368",
