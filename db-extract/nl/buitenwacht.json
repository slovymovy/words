                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a7608e-9e28-43ba-868f-0387b31e86c5",
                                "sense_id": "f483c29a-875a-3d63-979a-eeb7ed75c780",
                                "text": "Hans Goslinga, \"Jack de Vries staat niet voor zijn zaak in kwestie-Eddaoudi\", Trouw, April 18th 2009.\nIn het laatste geval krijgt de buitenwacht een eerste concrete aanwijzing voor de kansen op samenwerking tussen het CDA en de PVV in de nabije toekomst."
                            },
                            {
                                "example_id": "abb71d80-32ba-4246-90d3-a5a280a35db4",
                                "sense_id": "f483c29a-875a-3d63-979a-eeb7ed75c780",
                                "text": "Robert Stouthuysen, \"Omtrent de relatie van ondernemingbestuurder en parket\", I. Carmen, R. Blanpain (ed.), Onderneming & parket, 1999, 116.\nDrie maatschappelijke ontwikkelingen hebben hard activisme van de buitenwacht in de hand gewerkt:"
                            }
                        ]
                    },
                    {
                        "sense_id": "60da2c45-0fbe-3c27-bbb7-37c39fe56209",
                        "entry_id": "4902ef61-19d4-318a-8fff-e83673bc143c",
                        "glosses": [
                            "safety supervisor for confined spaces"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf63b8ec-5c76-3996-bb5b-00bc21fa47bd",
                        "entry_id": "4902ef61-19d4-318a-8fff-e83673bc143c",
                        "glosses": [
                            "outside guard"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c9dbcc5c-2592-4134-ac84-23cd972b300b",
                                "sense_id": "cf63b8ec-5c76-3996-bb5b-00bc21fa47bd",
                                "text": "Dit geschiedde echter ook met mij; en deze voorzigtigheid was geenszins overtollig, wanneer men bedenkt, dat, ingeval een van ons zich om het leven bragt, niet alleen de wachters en onze overgeblevene medegevangenen, maar ook de buitenwacht, die niets eens bij ons mogt komen, alles zouden te vreezen gehad hebben."
                            },
                            {
                                "example_id": "38791a73-2b99-421e-bab3-0b9a4dd58d1c",
                                "sense_id": "cf63b8ec-5c76-3996-bb5b-00bc21fa47bd",
                                "text": "Toen hij door de buitenwacht werd aangehouden, hield hij lang genoeg de teugel in om de wachtpost opgewekt te verzekeren: (...)"
                            },
                            {
                                "example_id": "1c98bc44-1891-4b9c-b6cf-423f109c586e",
                                "sense_id": "cf63b8ec-5c76-3996-bb5b-00bc21fa47bd",
                                "text": "Op zondagavond 21 augustus maakte De Haan samen met de inspecteur van de buitenwacht, een vijfentwintigjarige jongen, een avontuurlijke tocht."
                            }
                        ]
                    },
                    {
                        "sense_id": "13346f66-b1f6-36a2-951d-8cfdf75a80d3",
                        "entry_id": "4902ef61-19d4-318a-8fff-e83673bc143c",
                        "glosses": [
                            "guard duty outside"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d25a4e-c014-4fb6-8165-10f1335449e9",
                                "sense_id": "13346f66-b1f6-36a2-951d-8cfdf75a80d3",
                                "text": "De onderofficieren en manschappen, zoowel die te voet als te paard, genieten voor het doen van nachtdiensten, buitenwachten, enz., eene verhooging van de soldij, te weten:"
                            }
                        ]
                    },
                    {
                        "sense_id": "20537a53-225b-3bad-8cf1-5a12cd05b9e3",
                        "entry_id": "4902ef61-19d4-318a-8fff-e83673bc143c",
                        "glosses": [
                            "having to stay outside (usually with hebben or krijgen)"
                        ],
                        "tags": [
                            "East",
                            "Flanders",
                            "West",
                            "feminine",
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "cc2ec10e-60e6-4d44-b619-b02088d2f3e6",
                                "sense_id": "20537a53-225b-3bad-8cf1-5a12cd05b9e3",
                                "text": "'(...) Beseft Tom Boonen echt niet hoe de ploegleiding hem toen geholpen heeft? Bij vijftien andere ploegen had hij toen al gewoon de buitenwacht gekregen.'"
                            },
                            {
                                "example_id": "b9579e31-a8c3-4149-89cf-4122e0617dc6",
                                "sense_id": "20537a53-225b-3bad-8cf1-5a12cd05b9e3",
                                "text": "Zo verwoordde voorzitter Louis Van den Buijs het gevoel dat hij en zijn leden van wielerclub Bosduin in Kalmthout hadden toen ze het nieuws vernamen dat de bollebozen van de UCI hen de buitenwacht aangezegd hadden met hun cyclocross."
                            },
                            {
                                "example_id": "4b1e5cd8-ccbc-44e0-a18b-9d0853d02108",
                                "sense_id": "20537a53-225b-3bad-8cf1-5a12cd05b9e3",
                                "text": "2015 November 3,Shane Slambrouck, quoted in \"“Van man van de match tot rood en pineut”\", Het Nieuwsblad.\n\"Ik kwam tussenbeide om de twee kemphanen te scheiden, kreeg de buitenwacht.\"",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    }
