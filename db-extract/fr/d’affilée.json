                                                "sense_id": "33186a97-1ac6-304c-b774-7f11afe76bf9",
                                                "text": "Sie liefen hintereinander her."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6036e56-fcd7-3616-a22a-a0559f5600e9",
                                        "entry_id": "b3ec9643-afc6-3b8d-adb5-303db20c3d60",
                                        "glosses": [
                                            "zeitlich direkt aufeinander folgend"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdcd1c0-190c-4d55-898e-e1bce1b1e654",
                                                "sense_id": "f6036e56-fcd7-3616-a22a-a0559f5600e9",
                                                "text": "Er musste an fünf Tagen hintereinander die Nachtschicht übernehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40334fca-3bfc-4cbc-bc0f-ee48e79bb55f",
                        "source_entry_id": "50ff16bb-0df0-34a7-9a86-67eb00ae4c1b",
                        "source_sense_id": "1c80b602-e7b8-3725-b829-f941b5854721",
                        "target_lang_word": "in a row",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in a row",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0a8f1a-8734-3120-855c-57e019a4f22b",
                                        "entry_id": "a5eb0495-2152-3250-a9e6-dd7619c3b380",
                                        "glosses": [
                                            "successively, one after the other, in succession; together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ac8ef7-2847-4e28-8b94-2c45e0ff0e70",
                                                "sense_id": "0c0a8f1a-8734-3120-855c-57e019a4f22b",
                                                "text": "After making losses four years in a row, the manager knew she had to sack someone."
                                            },
                                            {
                                                "example_id": "011eed63-54f8-4819-b436-07ad55a75163",
                                                "sense_id": "0c0a8f1a-8734-3120-855c-57e019a4f22b",
                                                "text": "I dreamt of my dead husband, who asked me for a cozonac, adding, 'It's important that you prepare it yourself.' I had this dream three nights in a row until I finally baked it."
                                            },
                                            {
                                                "example_id": "85e4224e-d68f-4e61-bb08-b5cabbf51998",
                                                "sense_id": "0c0a8f1a-8734-3120-855c-57e019a4f22b",
                                                "text": "If you choose to drink again the best way to avoid another instance of withdrawal is to avoid drinking two days in a row."
                                            },
                                            {
                                                "example_id": "fac29b53-a432-4a8c-850a-a596de89aede",
                                                "sense_id": "0c0a8f1a-8734-3120-855c-57e019a4f22b",
                                                "text": "Monza was the seventh race in a row at which Leclerc had out-qualified Vettel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379b4773-ed00-3786-ac38-0c6e187f783d",
                                        "entry_id": "a5eb0495-2152-3250-a9e6-dd7619c3b380",
                                        "glosses": [
                                            "Placed in a straight line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3cde10-34d6-4022-b448-6b149bdee909",
                                                "sense_id": "379b4773-ed00-3786-ac38-0c6e187f783d",
                                                "text": "Bottles of every type of alcohol they had were lined up in a row behind the bar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
