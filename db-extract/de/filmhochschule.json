                "senses": [
                    {
                        "sense_id": "20ed26e7-f95b-36d3-9d77-f292e2ff5ddd",
                        "entry_id": "966043e9-d0d3-3dd4-a5c8-24862acefdeb",
                        "glosses": [
                            "Hochschule für Filmschaffende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e48093-691a-4e2e-8272-cdcd32870cf5",
                                "sense_id": "20ed26e7-f95b-36d3-9d77-f292e2ff5ddd",
                                "text": "„Er würde vor frisch von der Filmhochschule kommenden Autorenfilmern katzbuckeln, die von legalisiertem Marihuanageld finanziert wurden und ein Führungslicht nicht von einem Objektivfilter unterscheiden konnten.“"
                            },
                            {
                                "example_id": "d36a5a7e-0efd-47d6-a7a1-a93c340ff8c6",
                                "sense_id": "20ed26e7-f95b-36d3-9d77-f292e2ff5ddd",
                                "text": "„Im Studium, nachdem sämtliche Filmhochschulen und Studios auf Neurotranskripte umgeschwenkt waren, habe ich meine besten Sachen mit Junkies als Durchlaufstationen gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
