                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c09268c4-4183-3e9b-886f-208b2a5327c8",
                                        "entry_id": "2106a114-86d7-352a-9cde-ef7499450738",
                                        "glosses": [
                                            "Faire ricochet."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b97143-2a4e-48bc-b048-a49dfd67d45b",
                                                "sense_id": "c09268c4-4183-3e9b-886f-208b2a5327c8",
                                                "text": "Les obus et les boulets, qui tout à l’heure arrivaient seuls, étaient maintenant accompagnés d’une pluie de balles qui s’aplatissaient en auréole contre les murailles, ou ricochaient sur le fer des garde-fous avec un pétillement qui agaçait mes oreilles."
                                            },
                                            {
                                                "example_id": "3c7214f2-4703-4313-ae7c-1039967a62f7",
                                                "sense_id": "c09268c4-4183-3e9b-886f-208b2a5327c8",
                                                "text": "Ses lumières galvanisées ricochent sur les vitres, s’éclatent sur la carrosserie des voitures, se défoulent en une multitude de feux follets sur les trottoirs lubrifiés de rosée, et pas une flammèche ne réussit à éclairer l’œil des passants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47086a56-9d16-3cbb-b061-161153d7f078",
                                        "entry_id": "2106a114-86d7-352a-9cde-ef7499450738",
                                        "glosses": [
                                            "Attaquer à l’artillerie avec des tirs à ricochets, qui prennent en enfilade le sommet d’un rempart, sur lequel les boulets rebondissent, anéantissant les défenseurs."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0006b539-02d1-4fb9-928b-08d04eb38d55",
                                                "sense_id": "47086a56-9d16-3cbb-b061-161153d7f078",
                                                "text": "Dans tous les cas, directes ou obliques, les directrices des embrasures sont parallèles aux prolongements des faces des ouvrages à ricocher."
                                            },
                                            {
                                                "example_id": "a620a433-6cc9-4830-b9cf-4f959fe0d72e",
                                                "sense_id": "47086a56-9d16-3cbb-b061-161153d7f078",
                                                "text": "Le n ° 5, 3 pièces de 24, 4 de 16, et 1 obusier, devant ricocher la face droite du bastion San Pedro et battre de plein fouet sa face gauche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
