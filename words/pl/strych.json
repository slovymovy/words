                        {
                            "text": "Matka zabroniła dzieciom bawić się na <w>strychu</w>.",
                            "target_lang_translations": {
                                "en": "The mother forbade the children to play in the <w>attic</w>.",
                                "ru": "Мать запретила детям играть на <w>чердаке</w>.",
                                "nl": "Moeder verbood de kinderen om op <w>zolder</w> te spelen.",
                                "de": "Die Mutter verbot den Kindern, auf dem <w>Dachboden</w> zu spielen.",
                                "fr": "La mère a interdit aux enfants de jouer au <w>grenier</w>.",
                                "it": "La madre proibì ai bambini di giocare in <w>soffitta</w>.",
                                "cs": "Matka zakázala dětem hrát si na <w>půdě</w>.",
                                "tr": "Anne, çocukların <w>tavan arasında</w> oynamasını yasakladı.",
                                "es": "La madre les prohibió a los niños jugar en el <w>desván</w>.",
                                "zh": "母亲禁止孩子们在<w>阁楼</w>上玩耍。"
                            }
                        },
                        {
                            "text": "Wiele starych pamiątek przechowujemy na <w>strychu</w>.",
                            "target_lang_translations": {
                                "en": "We keep many old mementos in the <w>attic</w>.",
                                "ru": "Многие старые памятные вещи мы храним на <w>чердаке</w>.",
                                "nl": "Veel oude aandenkens bewaren we op <w>zolder</w>.",
                                "de": "Viele alte Erinnerungsstücke bewahren wir auf dem <w>Dachboden</w> auf.",
                                "fr": "Nous gardons beaucoup de vieux souvenirs au <w>grenier</w>.",
                                "it": "Conserviamo molti vecchi ricordi in <w>soffitta</w>.",
                                "cs": "Mnoho starých památek skladujeme na <w>půdě</w>.",
                                "tr": "Birçok eski hatırayı <w>tavan arasında</w> saklıyoruz.",
                                "es": "Guardamos muchos recuerdos viejos en el <w>desván</w>.",
                                "zh": "我们在<w>阁楼</w>里存放了许多旧纪念品。"
                            }
                        }
                    ],
