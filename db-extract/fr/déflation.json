        "fr-extract.jsonl": [
            {
                "entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
                "word": "déflation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "26ea3ac2-0009-4fbc-81ae-14d7ebc9e988",
                        "entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "déflations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3bbc82f-4e4c-3b6e-957f-cc9e2982796c",
                        "entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
                        "glosses": [
                            "Diminution progressive ou suppression totale de l’inflation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c67198bc-17bf-4b5b-a997-1540152613c1",
                                "sense_id": "f3bbc82f-4e4c-3b6e-957f-cc9e2982796c",
                                "text": "La déflation est une menace, sinon une issue, logique, de tout processus hyperinflationniste."
                            },
                            {
                                "example_id": "2dd3140b-4d1e-45a2-8200-311ef350ec1d",
                                "sense_id": "f3bbc82f-4e4c-3b6e-957f-cc9e2982796c",
                                "text": "Pierre Laval avait remplacé Doumergue, fin 1934. Il pensait résoudre les problèmes financiers et économiques par la déflation. Il prit des mesures draconiennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "80d3214b-2494-3156-a448-fd44251948c1",
                        "entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
                        "glosses": [
                            "Érosion éolienne impliquant le départ des particules les plus fines d'un sédiment (vannage éolien)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddc94088-d829-4d45-bcb6-51134f53b028",
                        "source_entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
                        "target_lang_word": "deflation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deflation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9339de1d-ddb3-3429-8956-5c6a02635c4f",
                                        "entry_id": "e83615da-a4f3-3365-af1b-dff7ecaa8aeb",
                                        "glosses": [
                                            "An act or instance of deflating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee9a8d7d-add8-479c-a29d-a9be72b541af",
                                                "sense_id": "9339de1d-ddb3-3429-8956-5c6a02635c4f",
                                                "text": "The loss caused utter deflation and disappointment among the fans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e626514d-0835-3831-8035-ac6915d70726",
                                        "entry_id": "e83615da-a4f3-3365-af1b-dff7ecaa8aeb",
                                        "glosses": [
                                            "A decrease in the general price level, that is, in the nominal cost of goods and services as well as wages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f544a5f2-b6d8-35a8-a298-b640cec77340",
                                        "entry_id": "e83615da-a4f3-3365-af1b-dff7ecaa8aeb",
                                        "glosses": [
                                            "An economic contraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96974521-45d2-4ea1-a072-bcdec7f846e5",
                                                "sense_id": "f544a5f2-b6d8-35a8-a298-b640cec77340",
                                                "text": "Beyond that, there is the hope that deflation of the US economy which the administration has in mind will, overtime; stem the import flood."
                                            },
                                            {
                                                "example_id": "5597d423-d911-465c-af25-6421f4d088ae",
                                                "sense_id": "f544a5f2-b6d8-35a8-a298-b640cec77340",
                                                "text": "It also must be acknowledged that Britain's problems won't be solved by an abrupt deflation of the economy."
                                            },
                                            {
                                                "example_id": "be382548-a6cf-4ebb-88b5-9894a36d96da",
                                                "sense_id": "f544a5f2-b6d8-35a8-a298-b640cec77340",
                                                "text": "The great deflation of the northern economy occurred with the rupturing of the Mackenzie Valley pipe dream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62bf8fb1-4ff4-38e0-b16a-b2f10d5e57cd",
                                        "entry_id": "e83615da-a4f3-3365-af1b-dff7ecaa8aeb",
                                        "glosses": [
                                            "The removal of soil and other loose material from the ground (or another surface) by wind, leaving it exposed to erosion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c019708b-e257-44dd-89a9-204137a89880",
                        "source_entry_id": "b9da9803-67e4-359f-a4f4-f0e54778f2c7",
