                        "target_lang_word": "bobbeltjesstof",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d54a3bcf-a887-4ece-98e2-8eb652667a83",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "crépon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crépon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                        "entry_id": "63fea28f-9b5b-3a41-b6e6-c19c8f226ac4",
                                        "glosses": [
                                            "Sorte d’étoffe de laine, de coton ou de soie, qui est un peu frisée et ressemble au crêpe, mais est beaucoup plus épaisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe11261a-c5c8-4a34-9bbc-e04318d9acc8",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "Elle sentait la sueur et le crépon mouillé."
                                            },
                                            {
                                                "example_id": "223c8d9c-63eb-4b97-8036-34462e770c99",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "Alignés sur le devant de l'estrade dans des chasubles de crépon rouge, les enfants chantaient une comptine."
                                            },
                                            {
                                                "example_id": "1873c6fd-ced5-4bfb-9427-393614c5d23c",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "J'en bricole un avec du papier crépon, comme dans mon imagerie des fêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c554a90f-9e3a-321b-bc79-26310bda2e22",
                                        "entry_id": "63fea28f-9b5b-3a41-b6e6-c19c8f226ac4",
                                        "glosses": [
                                            "Rouleau de cheveux postiches que l’on met sous les cheveux pour les faire bouffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af8bca3-0a12-47f3-ae8e-208f499af8e8",
                                                "sense_id": "c554a90f-9e3a-321b-bc79-26310bda2e22",
                                                "text": "Elle avait eu à peine le temps de remettre en place nattes, chignon et crépons, et de rattacher sa robe avec quelques épingles, que le convoi arrêta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "549c8220-ceda-470a-8e6e-e2affc06a02b",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "sirsacas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sirsacas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "879e31af-0d78-3873-901f-852c278958cc",
                                        "entry_id": "84d4d1bb-d275-3dc6-91a6-ca85b798c617",
                                        "glosses": [
                                            "Étoffe de coton qui était fabriquée en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd226a4-f53b-4b81-9137-ea20ab3af2de",
                                                "sense_id": "879e31af-0d78-3873-901f-852c278958cc",
                                                "text": "Rappelons cependant que Chardon était de tenue négligée. En 1780, il possédait :\nUn surtout de sirsacas rayé jaune et blanc.\nUne redingote de taffetas à petits carreaux."
                                            },
                                            {
                                                "example_id": "6625a332-967f-4ee3-b770-c9a9e43f0424",
                                                "sense_id": "879e31af-0d78-3873-901f-852c278958cc",
                                                "text": "Enfin, la nau le mena rive gauche, aux côtés d’un bourgeois qui portait un habit bleu barbeau à boutons de nacre, et d’un cadet paré d’une chemise et d’une cravate de sirsacas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45df52ae-5716-48c7-b742-b7ab18796216",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "cirsakas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirsakas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "876c5feb-3b0f-3fd7-beb4-121dcc92efda",
                                        "entry_id": "2e3ed8d3-15af-35cc-b3b1-c0223dedf242",
                                        "glosses": [
                                            "Variante de sirsacas."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc8edb4d-40af-4065-8259-ca589fea3127",
                                                "sense_id": "876c5feb-3b0f-3fd7-beb4-121dcc92efda",
                                                "text": "Elle était si jolie avec son bonnet rond et son ruban rose, son déshabillé de cirsakas et ses petits souliers jonquille, que mon oncle s'arrêta un instant pour la regarder."
                                            },
                                            {
                                                "example_id": "d4353fd2-f6dd-4786-ba80-e3cd149a0994",
                                                "sense_id": "876c5feb-3b0f-3fd7-beb4-121dcc92efda",
                                                "text": "Alexandrine consentit à rester et, bien qu’elle craignît comme la mort une querelle où sa belle jupe de cirsakas et sa calèche auraient été compromises, elle resta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7fbe90b-8784-47da-a102-87bf11b4d2fb",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "cirsac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirsac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0bd22e7-b382-3115-83ba-a65bfdfb45ef",
                                        "entry_id": "ff6d9677-9304-38b5-841a-bc14f3b1fac8",
                                        "glosses": [
                                            "Variante de sirsacas."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e1e5f4-5683-494a-995d-26585d62bfd4",
                                                "sense_id": "c0bd22e7-b382-3115-83ba-a65bfdfb45ef",
                                                "text": "Les tribunaux frappèrent, tout d'abord, assez durement, les gentilles délinquantes qui s'obstinaient à porter le gourgouran, soie légère de l'Inde, l’armoisin, joli taffetas très souple et le cirsac mollement cotonneux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a4295c4-de4e-4554-8652-fd830653f824",
                        "source_entry_id": "0f0518fb-0541-3c4f-ab03-af4db060848f",
