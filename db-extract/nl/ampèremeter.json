                    {
                        "sense_id": "f29c4cba-44ce-384b-888f-c2322233b3b5",
                        "entry_id": "d06f9328-443c-3bba-858f-94d634914c67",
                        "glosses": [
                            "een instrument om de elektrische stroom, uitgedrukt in ampère, te bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caec6c3d-f682-4b24-8f67-52df3ee847d9",
                                "sense_id": "f29c4cba-44ce-384b-888f-c2322233b3b5",
                                "text": "De ampèremeter wijst 6 ampère aan, dat is veel te hoog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "605b40f1-e4a6-4cd4-946b-a1ac5bfa1d1c",
                        "source_entry_id": "d06f9328-443c-3bba-858f-94d634914c67",
                        "source_sense_id": "f29c4cba-44ce-384b-888f-c2322233b3b5",
                        "source_sense_description": "stroommeter",
                        "target_lang_word": "Amperemeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amperemeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                                        "entry_id": "585bc6f7-c8b5-368a-9683-84b1da74f65f",
                                        "glosses": [
                                            "Messgerät zur Messung der Stärke des elektrischen Stroms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e748376e-54b6-42ee-b737-93e9dae697ae",
                                                "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                                                "text": "Für den Versuchsaufbau benötigte der Wissenschaftler mehrere Amperemeter."
                                            },
                                            {
                                                "example_id": "17d19ab8-64d4-4b43-bd8d-9cd3ecb0b2d5",
                                                "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                                                "text": "„Der Wunderkammer-Charakter der Vitrinen, in denen Pokale, Porzellane, mit Rotwein gefüllte Schalen und alte Messgeräte wie Baro- und Amperemeter altarähnliche Kompositionen bilden, steigert das Empfinden von Staunen und Wundern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "583f8fe4-eb96-4d9a-ac41-221a25be3ff5",
                        "source_entry_id": "d06f9328-443c-3bba-858f-94d634914c67",
                        "source_sense_id": "f29c4cba-44ce-384b-888f-c2322233b3b5",
                        "source_sense_description": "stroommeter",
                        "target_lang_word": "Strommesser",
                        "target_lang_code": "de",
