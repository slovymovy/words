                    "semantic_group_id": "мясо",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В традиционной кухне кочевых народов <w>конина</w> всегда занимала особое место.",
                            "target_lang_translations": {
                                "en": "In the traditional cuisine of nomadic peoples, <w>horsemeat</w> has always occupied a special place."
                            }
                        },
                        {
                            "text": "До сих пор помню прекрасный вкус котлет, приготовленных мамой из <w>конины</w>, купленной на базаре.",
                            "target_lang_translations": {
                                "en": "I still remember the wonderful taste of the cutlets made by mom from <w>horsemeat</w> bought at the bazaar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "колбаса из конины",
                        "тушеная конина"
