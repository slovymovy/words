                    {
                        "translation_id": "2f8c15f5-686f-4e5a-a304-05d59b4608b1",
                        "source_entry_id": "53d4d027-84c4-3451-a18f-d0946256d578",
                        "target_lang_word": "manzana reineta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
