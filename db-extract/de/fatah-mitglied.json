                "senses": [
                    {
                        "sense_id": "0b3fa8b5-e5da-3d5d-9d20-9cb81ff42f0c",
                        "entry_id": "79d9a7a3-1e7d-30a7-9cbe-d987ba1b615a",
                        "glosses": [
                            "Mitglied der Fatah"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e09143a6-5473-4f97-bd51-2201f13731aa",
                                "sense_id": "0b3fa8b5-e5da-3d5d-9d20-9cb81ff42f0c",
                                "text": "„Eines der Fatah-Mitglieder zeichnete sich darin besonders aus.“"
                            },
                            {
                                "example_id": "74808f49-0fb6-494a-9cf0-d916357d25a3",
                                "sense_id": "0b3fa8b5-e5da-3d5d-9d20-9cb81ff42f0c",
                                "text": "„Unterdessen erhielt Eschkol immer mehr Briefe von besorgten Bürgern, die ihm Vorschläge zur Terrorbekämpfung unterbreiteten. Darin wurden unter anderem die Todesstrafe für Fatah-Mitglieder und die Errichtung eines elektrischen Grenzzauns gefordert.“"
                            },
                            {
                                "example_id": "3876d5ea-5f10-4b10-949e-681da72464e4",
                                "sense_id": "0b3fa8b5-e5da-3d5d-9d20-9cb81ff42f0c",
                                "text": "„Hochrangige Fatah-Mitglieder nahmen sie am Flughafen in Empfang, wo die Iraner Khomeinis Kampfparolen wie etwa ›Heute Iran, morgen Palästina‹ skandierten und Poster mit seinem Konterfei hochhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
