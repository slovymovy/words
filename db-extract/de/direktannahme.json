                "senses": [
                    {
                        "sense_id": "8423d5a7-68f5-3cb8-a895-654d47b70aad",
                        "entry_id": "aec890a3-32b9-3895-a1f9-2c9f26588148",
                        "glosses": [
                            "Stelle, an der bestimmte Dinge ohne Umwege entgegengenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171e4acc-1d70-4008-b3cb-db30074d6931",
                                "sense_id": "8423d5a7-68f5-3cb8-a895-654d47b70aad",
                                "text": "„Der Serviceberater fährt das Kundenfahrzeug in einen hellen lichtdurchfluteten, weißgefliesten und warmen Raum, die Direktannahme.“"
                            },
                            {
                                "example_id": "9ed7ac90-b5c0-4045-8a99-565f10c6bc52",
                                "sense_id": "8423d5a7-68f5-3cb8-a895-654d47b70aad",
                                "text": "„Die Direktannahme ist Ihr direkter Draht zur Werkstatt – für maximale Sicherheit und Transparenz.“"
                            },
                            {
                                "example_id": "ea6a05e8-905d-4e27-a3df-d0a1adeaf88e",
                                "sense_id": "8423d5a7-68f5-3cb8-a895-654d47b70aad",
                                "text": "„Die Direktannahme verfügt über 2 Annahmeplätze mit modernen Hebebühnen, vernetzten EDV-Arbeitsplätzen und Diagnosegeräten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4dec9e0e-f9c3-346a-963d-f239db282d5a",
                        "entry_id": "aec890a3-32b9-3895-a1f9-2c9f26588148",
                        "glosses": [
                            "sofortiger Schuss des Balles nach einer Flanke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "397df0b7-d5c2-46e7-bfc8-8a219af43f13",
                                "sense_id": "4dec9e0e-f9c3-346a-963d-f239db282d5a",
                                "text": "„Bei Terranovas Direktannahme einer Landers-Flanke war SCP-Keeper Masuch zur Stelle.“"
                            },
                            {
                                "example_id": "c7e19f91-6f14-485e-b6e0-a4ddfb509d01",
                                "sense_id": "4dec9e0e-f9c3-346a-963d-f239db282d5a",
                                "text": "„Nur zwischen der 66. und 69. Minute sprangen gute Möglichkeiten heraus, doch McBride traf mit seinem Kopfball nur den Pfosten, ehe Bocanegra das Leder mit einer abgefälschten Direktannahme knapp über die Latte schoss.“"
                            },
                            {
                                "example_id": "fde8e20c-a41a-4dfc-8f7e-051321702d9c",
                                "sense_id": "4dec9e0e-f9c3-346a-963d-f239db282d5a",
                                "text": "„Am hinteren Pfosten lauert Götze, der es mit einer Direktannahme versucht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
