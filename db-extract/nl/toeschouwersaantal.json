                        "examples": [
                            {
                                "example_id": "97b0e3b5-c6b2-4077-9a26-2c655eea8ab5",
                                "sense_id": "9561ad75-7a5b-3921-96a5-77bf43a09d29",
                                "text": "Het hoge toeschouwersaantal in Zwolle kwam mede door een actie van de thuisclub. Iedereen die een knuffel meebracht, kon gratis het stadion in. Na afloop werden de knuffels ingezameld voor het goede doel."
                            },
                            {
                                "example_id": "30df6b17-2eef-4497-abae-14a7852d520f",
                                "sense_id": "9561ad75-7a5b-3921-96a5-77bf43a09d29",
                                "text": "De 34 clubs in het betaald voetbal, voetbalbond KNVB, de Eredivisie CV en de Keuken Kampioen Divisie vinden de versoepeling van het toeschouwersaantal veel te weinig, stelden ze dinsdag voor de persconferentie in een verklaring. Ze overleggen woensdag hoe ze met deze situatie moeten omgaan."
                            }
