                    {
                        "translation_id": "278fbda2-ccc6-42e0-b1eb-d86ffae15d07",
                        "source_entry_id": "a122ff2a-3efe-3d89-86f8-4b92b7183a33",
                        "source_sense_id": "6cdcc60d-67dc-3e93-b17b-9aef975383e3",
