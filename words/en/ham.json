                            },
                            {
                                "target_lang_word": "爱出风头的人",
                                "target_lang_sense_clarification": "强调爱在台上吸引注意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e55df878-3bf3-32a6-b7ec-298220c5de6a",
                    "sense_definition": "The back of the thigh in humans or animals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete felt a sharp pain in his <w>ham</w> while sprinting.",
                            "target_lang_translations": {
                                "ru": "Атлет почувствовал острую боль в <w>бедре</w> во время спринта.",
                                "zh": "那名运动员冲刺时感到自己的<w>大腿后侧</w>一阵剧痛。"
                            }
                        },
                        {
                            "text": "The horse had powerful <w>hams</w> that allowed it to jump very high.",
                            "target_lang_translations": {
                                "ru": "У лошади были мощные <w>задние ноги</w>, которые позволяли ей прыгать очень высоко.",
                                "zh": "这匹马的<w>大腿后侧肌肉</w>很有力，所以能跳得很高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задняя часть бедра у людей или животных.",
                        "zh": "人或动物大腿后面的部位。"
                    },
                    "translations": {
