                "senses": [
                    {
                        "sense_id": "c579b641-6050-3534-b2b9-8f7980cbda23",
                        "entry_id": "ed6850a7-b9dd-3846-8e40-fface9559688",
                        "glosses": [
                            "устар. воспитанник какого-либо учебного заведения состоящий на полном содержании в общежитии или интернате"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96fc75d8-372b-47cc-b12d-fb1513db8cb8",
                                "sense_id": "c579b641-6050-3534-b2b9-8f7980cbda23",
                                "text": "После классных занятий студенты-пансионеры отлучались, не спрашиваясь, в город и гуляли там нередко до утра."
                            },
                            {
                                "example_id": "a1c1785f-9e17-4088-af7b-3df2a692607c",
                                "sense_id": "c579b641-6050-3534-b2b9-8f7980cbda23",
                                "text": "Работы были поручены архитектору Ивану Денисьевичу Чернику, кубанскому казаку родом, бывшему войсковым пансионером в Императорской Академии Художеств."
                            }
                        ]
