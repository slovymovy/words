        "ru-extract.jsonl": [
            {
                "entry_id": "a8927313-f6c0-3277-befa-9cdee85c73ac",
                "word": "wyższy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "338b8c82-7e44-37b6-acb6-1e4c55f517e8",
                        "entry_id": "a8927313-f6c0-3277-befa-9cdee85c73ac",
                        "glosses": [
                            "верхний, высший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fa44f2-6735-4f85-82bc-4be8668e59d8",
                                "sense_id": "338b8c82-7e44-37b6-acb6-1e4c55f517e8",
                                "text": "Lecz u nas wyższa warstwa zakrzepła jak woda na mrozie i nie tylko wytworzyła osobny gatunek, który nie łączy się z resztą, ma do niej wstręt fizyczny, ale jeszcze własną martwotą krępuje wszelki ruch z dołu.",
                                "translation": "А у нас высший слой застыл, как вода на морозе, и не только превратился в обособленную касту, которая не соприкасается с остальным обществом и сторонится его с отвращением, но вдобавок еще собственной омертвелостью сковывает всякое движение, идущее снизу."
                            }
                        ]
                    },
                    {
                        "sense_id": "1502d913-3590-3838-bb2e-c74346e5c3ac",
                        "entry_id": "a8927313-f6c0-3277-befa-9cdee85c73ac",
                        "glosses": [
                            "возвышенный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f411509c-8de5-43ed-850e-143bd85b71b9",
                                "sense_id": "1502d913-3590-3838-bb2e-c74346e5c3ac",
                                "text": "Dusza wyższa nie znosi tłuszczu.",
                                "translation": "Возвышенная душа не переносит жира."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
