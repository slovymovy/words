                "senses": [
                    {
                        "sense_id": "49bf33ee-7aae-33c1-840f-5ad2df9a308f",
                        "entry_id": "66a1e14c-f14f-30c1-b7ca-e055970563bb",
                        "glosses": [
                            "het eetbare blad van een kool"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f6a41e-3e87-42dc-8e4f-6cccd2b1780a",
                                "sense_id": "49bf33ee-7aae-33c1-840f-5ad2df9a308f",
                                "text": "Een recept van foodfotograaf Tony Le Duc. 'Zet deze salade op een zwoele zomeravond in het midden van de tafel en laat de tafelgenoten samen delen uit een grote schaal. Geef het goede voorbeeld door een koolblad te nemen en het te vullen met de kipmengeling: sappig, krokant, pikant, zuur, zoet en zout in één hap in je mond.'"
                            },
                            {
                                "example_id": "50fb383e-44bf-4499-bb42-b1e25322e4cb",
                                "sense_id": "49bf33ee-7aae-33c1-840f-5ad2df9a308f",
                                "text": "Victoria en haar vriend Evgeniy Levchenko zijn trotse ouders en willen hun kleine spruit het beste geven. De eerste week in het leven van Kiy bestaat natuurlijk vooral uit slapen en eten. En voor dat eten moet Victoria met koolbladeren op haar voorgevel liggen."
                            },
                            {
                                "example_id": "de6794b3-3826-4f72-a3f8-d3176ab9c9dc",
                                "sense_id": "49bf33ee-7aae-33c1-840f-5ad2df9a308f",
                                "text": "Oekraïense holubsti (gevulde koolbladeren) worden traditioneel gemaakt met witte kool, maar Olia Hercules gebruikt savooiekool. Als de bladeren erg dikke nerven hebben, snijd er dan een driehoekje uit, bij de aanzet van het blad. Dat rolt veel fijner op."
                            }
                        ]
                    }
