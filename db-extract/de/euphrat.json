                    },
                    {
                        "translation_id": "de142187-5ddc-4d99-bab3-9f95aa8ee0ab",
                        "source_entry_id": "ff0ab61e-dcb0-3549-9429-650a936d6362",
                        "source_sense_id": "b9989dbb-600f-3110-af14-01b44ac65f35",
                        "source_sense_description": "großer Strom in Vorderasien",
                        "target_lang_word": "Euphrate",
                        "target_lang_code": "fr",
