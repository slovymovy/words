                ],
                "senses": [
                    {
                        "sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                        "entry_id": "d27127fa-101a-35f0-bf55-8b9ab5cb1a5c",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0575bd3-962d-4580-afec-449e07cb4cc7",
                                "sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                                "text": "Święty Patryk jest patronem Irlandii, Nigerii, fryzjerów, kowali, górników, upadłych na duchu, inżynierów oraz opiekunem zwierząt domowych."
                            },
                            {
                                "example_id": "0fda76d7-1bc4-4f4c-85f0-eb3309721bed",
                                "sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                                "text": "Spotkałem Patryka w pubie."
                            },
                            {
                                "example_id": "4197c698-938f-4a6b-b0f8-3c2431d35a2f",
                                "sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                                "text": "Według niektórych święty Kolumban ze świętym Patrykiem wspólnie ewangelizowali Irlandię."
                            },
                            {
                                "example_id": "26e52849-f6d4-488f-b378-4f29893f5c0f",
                                "sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                                "text": "Patrykowi bardzo zależało na towarzyszeniu mi w drodze powrotnej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8fb4733-8d72-4b63-80f6-c7875120746f",
                        "source_entry_id": "d27127fa-101a-35f0-bf55-8b9ab5cb1a5c",
                        "source_sense_id": "e2cb83fa-79cf-342b-806c-4c3f7927895d",
                        "target_lang_word": "Patrick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b6e4d0-8ca5-3804-8627-354664d6343f",
                                        "entry_id": "7130e95e-d178-3127-854a-8eb11d5d6b11",
                                        "glosses": [
                                            "A male given name."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab74702e-b8b1-4995-8604-7c042f5168d8",
                                                "sense_id": "e4b6e4d0-8ca5-3804-8627-354664d6343f",
                                                "text": "Yes, by Saint Patrick, but there is, Horatio,\nAnd much offence, too."
                                            },
                                            {
                                                "example_id": "a88385eb-aa3b-4f1e-a92d-e720fad9600b",
                                                "sense_id": "e4b6e4d0-8ca5-3804-8627-354664d6343f",
                                                "text": "- Are unusual names nice?\n- Yes.\n- Then why am I called Patrick?\nShe laughed but only for a little bit. She smiled at me, I think to make sure that I knew she wasn't laughing at me.\n- Because your daddy's called Patrick, she said.\nI liked that, being called after my da.\n- There are five Patricks in our class, I said.\n- Is that right?\n- Patrick Clarke. That's me. Patrick O'Neill. Patrick Redmond. Patrick Genocci. Patrick Flynn.\n- That's a lot, she said. - It's a nice name. Very dignified.\n- Three of them are called Paddy, I told her. - One Pat and one Patrick."
                                            }
                                        ]
                                    },
