                                        "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                        "entry_id": "3fd2b762-3014-39c0-9a6e-f221edb2fc58",
                                        "glosses": [
                                            "wesentlich, zum Wesen (einer Sache) gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17abef1-fc33-4010-8413-e64134e839e9",
                                                "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                                "text": "Das ist eine essenzielle Voraussetzung."
                                            },
                                            {
                                                "example_id": "2c731ca9-2fb1-44f7-b66d-2d3123303698",
                                                "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                                "text": "„Während die Munitionsfabriken längst eifrig produzieren und auch ein Mangel an Nahrung vorerst nicht zu befürchten steht, schenkt man im Kriegsministerium den essenziellen ökonomischen Fragen keinerlei Beachtung.“"
                                            },
                                            {
                                                "example_id": "1c91a347-8318-41b2-a22f-6d0cc61c9664",
                                                "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                                "text": "„Der Komponist will, dass der Flötist bei diesem Solostück seine Atmung in den Vordergrund stellt und sie als das Essenziellste des Werkes betrachtet.“"
                                            },
                                            {
                                                "example_id": "20138aa1-7986-4e65-a24b-22b5a5fec166",
                                                "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                                "text": "[Russisch-Ukrainischer Krieg 2024:] „Artilleriegranaten sind ein essenzieller Bestandteil der ukrainischen Verteidigung.“"
                                            },
                                            {
                                                "example_id": "21a9542d-ae1e-44d2-9484-1aefab155374",
                                                "sense_id": "87926181-2fc3-3c52-adb2-4051971d7ef8",
                                                "text": "„Der Marathon ist eine Königsdisziplin der Leichtathletik, bei der eine gute Renntaktik essenziell ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a2e916d-42ac-3733-bbab-9928c9d2012c",
                                        "entry_id": "3fd2b762-3014-39c0-9a6e-f221edb2fc58",
                                        "glosses": [
                                            "lebensnotwendig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed44f58-7a2c-4227-b1a0-87084a71fe64",
                                                "sense_id": "9a2e916d-42ac-3733-bbab-9928c9d2012c",
                                                "text": "Alle Vitamine sind essenziell, wie schon ihr Name zum Ausdruck bringt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c7dffafe-9aab-3bae-8dc1-87c03cf38aeb",
                                        "entry_id": "3fd2b762-3014-39c0-9a6e-f221edb2fc58",
                                        "glosses": [
                                            "wesensmäßig, (von Geburt an) zum Wesen (eines/des Menschen) gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0efe50da-edd8-4a60-8248-19831d151fe2",
                                                "sense_id": "c7dffafe-9aab-3bae-8dc1-87c03cf38aeb",
                                                "text": "„Die Struktur des Bewusstseins hat nach Sartre keine wesenhafte Qualität, ist also nicht essenziell vorbestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "95fb8b06-0cbb-3da4-9acf-5bf3af90e5a5",
                                        "entry_id": "3fd2b762-3014-39c0-9a6e-f221edb2fc58",
                                        "glosses": [
                                            "alleinstehend vorhanden seiend, nicht auf eine Krankheit verweisend"
                                        ],
                                        "tags": [
                                            "als Symptom"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4b0074-dfeb-4729-b78d-868a13416551",
                                                "sense_id": "95fb8b06-0cbb-3da4-9acf-5bf3af90e5a5",
                                                "text": "Der essenzielle Tremor betrifft vor allem die Hände und Arme, die zu zittern beginnen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d56a4933-dea6-42a8-896b-875f38695d28",
                        "source_entry_id": "24e83f1c-1df1-395d-8006-9e5dfc52a2cd",
