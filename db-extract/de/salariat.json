                                        "entry_id": "79f23a98-63f8-3783-b0fc-6dd9e1c10bb7",
                                        "glosses": [
                                            "Régime économique dans lequel le travail de l’ouvrier est rémunéré par un salaire."
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
