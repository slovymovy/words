                "senses": [
                    {
                        "sense_id": "216bca4e-25dd-3130-bb10-037e1eb4f0c8",
                        "entry_id": "c40c06dd-3267-3c4b-ae0b-b3180efc3c94",
                        "glosses": [
                            "ein Jahr im gregorianischen Kalender, der Zeitraum vom 1. Januar bis zum 31. Dezember (365 Tage / 366 Tage im Schaltjahr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61282921-781e-4c02-ae95-aba62e09988a",
                                "sense_id": "216bca4e-25dd-3130-bb10-037e1eb4f0c8",
                                "text": "Obwohl Peter das Auto erst im März gekauft hat musste er Steuern für das gesamte Kalenderjahr zahlen."
                            },
                            {
                                "example_id": "7f253694-de43-4070-b1ab-19d8c62082ea",
                                "sense_id": "216bca4e-25dd-3130-bb10-037e1eb4f0c8",
                                "text": "Im Kalenderjahr 2006 stiegen die Preise nur um 0,7% gegenüber dem Vorjahr."
                            },
                            {
                                "example_id": "361e4456-7241-4abf-ada3-f03aa5e84641",
                                "sense_id": "216bca4e-25dd-3130-bb10-037e1eb4f0c8",
                                "text": "„Noch ein Aspekt kommt in dieser aufs Kalenderjahr beschränkten Betrachtung zu kurz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
