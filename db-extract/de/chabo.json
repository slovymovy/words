                "senses": [
                    {
                        "sense_id": "c50935bf-9268-37db-b7b3-ff6b31165169",
                        "entry_id": "d315c732-6b90-3680-b122-3b405cccbc7c",
                        "glosses": [
                            "Japanese bantam"
