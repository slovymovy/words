                ],
                "senses": [
                    {
                        "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                        "entry_id": "f68d8798-bc3a-3e7b-a97c-0ffc0fb7f502",
                        "glosses": [
                            "Material, das geschnitten werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18449d86-2b3d-458b-8e69-9ac39006d7b5",
                                "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                                "text": "„Nun setzt du das vordere Ende der Säge (die Fußplatte) auf, aber so, dass das Sägeblatt das Schnittgut noch nicht berührt.“"
                            },
                            {
                                "example_id": "2a60e6b6-c979-4aa9-8401-5e9c5d4ea1ab",
                                "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                                "text": "„Im Stehen verankert man das Schnittgut an der Außenseite der Hüfte oder des Oberschenkels.“"
                            },
                            {
                                "example_id": "a8c4ea80-77b2-44e3-996a-81bd4297ea50",
                                "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                                "text": "„Nach jeder Lage streute sie eine knappe Handvoll Salz darüber und verdichtete das Schnittgut mit einem schweren buchenen Stampfholz.“"
                            },
                            {
                                "example_id": "0e9b7118-4619-4cf0-a337-3331d53f9adc",
                                "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                                "text": "„Es genügt, sie jährlich einmal Anfang Ende Juli oder im Frühjahr und Herbst zu mähen, das Schnittgut aufzunehmen und etwas Sand auszustreuen.“"
                            },
                            {
                                "example_id": "ceb0786f-5759-4055-a3ad-035fdd8c66b5",
                                "sense_id": "f9df79f6-c621-3d5d-9f8a-8444f85093b7",
                                "text": "„Mulchen ist das Abschneiden und Häckseln von Gras oder Wiese mit anschließendem Liegenlassen des Schnittgutes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
