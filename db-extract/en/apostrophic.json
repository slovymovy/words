        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69ffc41c-0be4-3dde-b0ca-79fdf53528bc",
                "word": "apostrophic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e453b07-8dd7-35db-8455-3bca8b8e768a",
                        "entry_id": "69ffc41c-0be4-3dde-b0ca-79fdf53528bc",
                        "glosses": [
                            "Pertaining to the rhetoric use of, or using, apostrophe (sudden, exclamatory dialogue)."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "9133f999-7fc1-43c4-b289-8d37dc5133dd",
                                "sense_id": "0e453b07-8dd7-35db-8455-3bca8b8e768a",
                                "text": "7 June 1820, Lord Byron, a letter to Mr. Murray written from Ravenna\nMrs. Hemans is a poet also, but too stiltified and apostrophic, […]"
                            },
                            {
                                "example_id": "6b60b08e-cd47-4307-ae8e-491aa0d942f9",
                                "sense_id": "0e453b07-8dd7-35db-8455-3bca8b8e768a",
                                "text": "The approach itself is apostrophic; or, if a more canonical term is required, it is phenomenological."
                            }
                        ]
                    },
                    {
                        "sense_id": "18570d14-0381-3ecd-b219-2591e1a9881d",
                        "entry_id": "69ffc41c-0be4-3dde-b0ca-79fdf53528bc",
                        "glosses": [
                            "Pertaining to the grammatical use of, or using, the apostrophe (the diacritical mark ')."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bcee1a7-aa6d-4d23-9f02-49815d0c8e1e",
                                "sense_id": "18570d14-0381-3ecd-b219-2591e1a9881d",
                                "text": "All we need to know is that, in Shakespeare’s time, an apostrophe indicated omitted letters, which meant Hamlet could say with supreme apostrophic confidence: “Fie on’t! O fie!”; […]"
                            }
                        ]
                    }
                ],
