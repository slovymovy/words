                ],
                "senses": [
                    {
                        "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                        "entry_id": "21dba6f1-02f5-3f98-9df2-bc7e706e9cf2",
                        "glosses": [
                            "Spiel auf dem Klavier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54a2a47-098f-465e-a80f-d650ad7e226b",
                                "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                                "text": "Jeden Samstagnachmittag hört man das Klavierspiel vom Nachbarn."
                            },
                            {
                                "example_id": "fdd62286-a73a-4d1c-9072-b1653f1548fb",
                                "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                                "text": "„In Frankfurt am Main besuchte sie im Sommer 1836 Felix Mendelssohn Bartholdy, der ihr Klavierspiel hoch schätzte und mit ihr musizierte.“"
                            },
                            {
                                "example_id": "83df3bda-06ea-4e9c-bcfe-53a2005435f8",
                                "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                                "text": "„Ich kann nicht behaupten, dass mein Klavierspiel Consuela so erregte, wie ihr gespieltes Dirigieren der Beethoven-Symphonie mich erregte.“"
                            },
                            {
                                "example_id": "7d17992b-e5fc-4215-aca5-c7b3c9b973a9",
                                "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                                "text": "„Er hörte sich intensiv in ihr Klavierspiel zurück und träumte sich noch weiter in ihr Bild hinein.“"
                            },
                            {
                                "example_id": "b9dd63ff-ff3a-4007-b002-1e3d26a9615d",
                                "sense_id": "0a9d03f9-21c0-3882-8fd5-3dca9eac5994",
                                "text": "„Er erlernt das Klavierspiel, was er in seinen autobiographischen Erzählungen nur einmal kurz erwähnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
