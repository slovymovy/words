                {
                    "sense_id": "df6979e3-d6fd-3fe4-97d9-9871d5df0469",
                    "sense_definition": "Łatwy do zrozumienia, logiczny i oczywisty; nie budzący wątpliwości.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "understanding_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To zadanie jest dla mnie zupełnie <w>jasne</w> i proste do wykonania.",
