                "translations": [
                    {
                        "translation_id": "51fa7fe2-0313-44d1-93ad-f174ee7b26bb",
                        "source_entry_id": "e2a53115-77cb-3218-84b6-2a603a8ef43e",
                        "source_sense_id": "c8fe81bc-17b7-32cc-9d4c-df926c963fcc",
                        "target_lang_word": "coherence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coherence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa11399-6af5-38b5-a806-2504c593f0cb",
                                        "entry_id": "e72e81f3-e6ff-3266-9ece-f3be53af5583",
                                        "glosses": [
                                            "The quality of cohering, or being coherent; internal consistency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "239516d8-9498-4120-b569-81e1f46905d5",
                                                "sense_id": "6aa11399-6af5-38b5-a806-2504c593f0cb",
                                                "text": "His arguments lacked coherence."
                                            },
                                            {
                                                "example_id": "0efe81ec-4ff6-423f-89d4-6c871dc86313",
                                                "sense_id": "6aa11399-6af5-38b5-a806-2504c593f0cb",
                                                "text": "Mrs. Grose listened with dumb emotion; she forbore to ask me what this meaning might be; so that, presently, to put the thing with some coherence and with the mere aid of her presence to my own mind, I went on: “That he’s an injury to the others.”"
                                            },
                                            {
                                                "example_id": "5c084ec1-4117-410a-a03a-5b55dae6c630",
                                                "sense_id": "6aa11399-6af5-38b5-a806-2504c593f0cb",
                                                "text": "He would then put down his pencil and stare in front of him, and wonder in what respects the world was different—it had, perhaps, more solidity, more coherence, more importance, greater depth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff610b1-e7d8-383f-9181-76a82fbff667",
                                        "entry_id": "e72e81f3-e6ff-3266-9ece-f3be53af5583",
                                        "glosses": [
                                            "The quality of forming a unified whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efef8c40-4d75-44e9-bc9d-ca23e4a144f6",
                                                "sense_id": "2ff610b1-e7d8-383f-9181-76a82fbff667",
                                                "text": "When I come to his connection with Blanche Stroeve I am exasperated by the fragmentariness of the facts at my disposal. To give my story coherence I should describe the progress of their tragic union, but I know nothing of the three months during which they lived together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3347ea4c-be84-3457-83b1-6929a5e03b2a",
                                        "entry_id": "e72e81f3-e6ff-3266-9ece-f3be53af5583",
                                        "glosses": [
                                            "A logical arrangement of parts, as in writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68446ab6-71ba-4f46-8089-a0156355faa4",
                                                "sense_id": "3347ea4c-be84-3457-83b1-6929a5e03b2a",
                                                "text": "In a lesson on coherence in academic writing, students engaged in the following discussion on the online platform TodaysMeet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea25ba9-7e42-3146-9faf-0227295f58a3",
                                        "entry_id": "e72e81f3-e6ff-3266-9ece-f3be53af5583",
                                        "glosses": [
                                            "The property of having the same wavelength and phase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5a33f12-1f07-3413-9ffd-a84342b48967",
                                        "entry_id": "e72e81f3-e6ff-3266-9ece-f3be53af5583",
                                        "glosses": [
                                            "A semantic relationship between different parts of the same text."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d38c7e0c-6695-41ef-ae70-35abdb6049a3",
                        "source_entry_id": "e2a53115-77cb-3218-84b6-2a603a8ef43e",
                        "source_sense_id": "c8fe81bc-17b7-32cc-9d4c-df926c963fcc",
                        "target_lang_word": "coherency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coherency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4e6ff7-5be3-3abc-9dea-9f18cb823270",
                                        "entry_id": "07480b39-7a46-3b3c-8ab5-e91bcc2a9213",
                                        "glosses": [
                                            "The state of being coherent; a coherent relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58a2623-e285-4cd3-8827-d332548852d1",
                                                "sense_id": "1c4e6ff7-5be3-3abc-9dea-9f18cb823270",
                                                "text": "even in all things therein created, there must be some image, somewhat resembling, and having coherencie with the workeman that wrought and framed them."
                                            },
                                            {
                                                "example_id": "8eeeba55-1711-496e-8806-4d9c82b5a06d",
                                                "sense_id": "1c4e6ff7-5be3-3abc-9dea-9f18cb823270",
                                                "text": "By ten o’clock the police organisation, and by midday even the railway organisations, were losing coherency, losing shape and efficiency, guttering, softening, running at last in that swift liquefaction of the social body."
                                            },
                                            {
                                                "example_id": "2dead165-ce21-4c3c-8366-f296504e2e3c",
                                                "sense_id": "1c4e6ff7-5be3-3abc-9dea-9f18cb823270",
                                                "text": "Then, as she released me, I made it out to her, made it out perhaps only now with full coherency even to myself. “Two hours ago, in the garden”—I could scarce articulate—“Flora saw!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7206cdfb-9779-478d-9a6f-e7589b6aa8bb",
                        "source_entry_id": "e2a53115-77cb-3218-84b6-2a603a8ef43e",
                        "source_sense_id": "c8fe81bc-17b7-32cc-9d4c-df926c963fcc",
                        "target_lang_word": "cohærence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohærence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8885bc-c76e-34b5-9552-a72aae669159",
                                        "entry_id": "33db9285-4967-321e-bc91-e8aeccabe77c",
                                        "glosses": [
                                            "Archaic spelling of coherence."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f897c8c-d9c9-4890-ad6a-45bbc695f3b4",
                                                "sense_id": "2e8885bc-c76e-34b5-9552-a72aae669159",
                                                "text": "Each of the two cohærent parts may be said to be adhærent to the other, but the latter term is often used to express a closer union than mere cohærence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf36fbc-ac6e-40b3-a9cc-942fc441b24a",
                        "source_entry_id": "e2a53115-77cb-3218-84b6-2a603a8ef43e",
                        "source_sense_id": "c8fe81bc-17b7-32cc-9d4c-df926c963fcc",
                        "target_lang_word": "cohérence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohérence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4013e65-3ab2-326e-82d5-ac76969aab1d",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "Union complète entre divers éléments d’un corps."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09d25ae7-475d-3fd3-bf89-c4252cc1a9f5",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "Accord ou harmonie, intuitive ou logique, d'un système d'idées entre elles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec10d3d-d427-4d26-b88c-272705bf1d8b",
                                                "sense_id": "09d25ae7-475d-3fd3-bf89-c4252cc1a9f5",
                                                "text": "Néanmoins, il est souvent souhaitable d’en confier la maîtrise d’œuvre totale à un même titulaire pour des raisons de cohérence d’ensemble et de continuité des études."
                                            },
                                            {
                                                "example_id": "7e3ed07d-0fbd-4791-85e6-bb1efbaab417",
                                                "sense_id": "09d25ae7-475d-3fd3-bf89-c4252cc1a9f5",
                                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s'efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d'une forme littéraire."
                                            },
                                            {
                                                "example_id": "5c7d5a6f-50d5-451f-ac9e-c3647b9dec1c",
                                                "sense_id": "09d25ae7-475d-3fd3-bf89-c4252cc1a9f5",
                                                "text": "Une telle synthétisation de la théorie implique un haut degré d'unité des explications fournies, de la cohérence philosophique, conceptuelle et méthodologique."
                                            },
                                            {
                                                "example_id": "f176eab7-918f-446b-9e40-10d3599b8b39",
                                                "sense_id": "09d25ae7-475d-3fd3-bf89-c4252cc1a9f5",
                                                "text": "La cohérence d'une théorie ne garantit pas qu'elle décrit son objet correctement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf72948-06b8-32ea-96fd-a5461939cae9",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "Consistance, absence de contradiction entre des données, des idées ou des informations."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d42ecd5-2e79-3c27-8e4f-d8739a4c8938",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "Ensemble des propriétés de corrélation d'un système ondulatoire."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b272a36-00e8-3038-a46c-27a547898315",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "En logique mathématique, la cohérence ou consistance est la propriété d'une théorie exempte de contradiction, ou de façon équivalente, d'une théorie qui possède un modèle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b360d8e-e610-3bf7-a2f6-e36598e5d208",
                                        "entry_id": "f194a2dd-8e0a-38d2-89e4-10ff9135d137",
                                        "glosses": [
                                            "Capacité pour un système à refléter sur la copie d'une donnée, les modifications intervenues sur d'autres copies de cette donnée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae921476-3f46-4432-862c-111ec8ddffba",
                        "source_entry_id": "e2a53115-77cb-3218-84b6-2a603a8ef43e",
                        "source_sense_id": "c8fe81bc-17b7-32cc-9d4c-df926c963fcc",
                        "target_lang_word": "Kohärenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohärenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3caddff6-c2bb-3aad-8474-588d5757b9b2",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "innerer oder äußerer Zusammenhang oder Zusammenhalt von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0f3144-b621-46bc-af43-37552a472176",
                                                "sense_id": "3caddff6-c2bb-3aad-8474-588d5757b9b2",
                                                "text": "Dem Aufsatz mangelt es an Kohärenz."
                                            },
                                            {
                                                "example_id": "e589d189-38b6-440e-a56a-b9100a2e54c2",
                                                "sense_id": "3caddff6-c2bb-3aad-8474-588d5757b9b2",
                                                "text": "„Deutschland setzt seinen Einfluss in den maßgeblichen internationalen und supranationalen Organisationen […] ein, um Kohärenz und Handlungsfähigkeit der Staatengemeinschaft zu verbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b63e71f5-ff27-35a2-b34f-e039d8bbe0fe",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "frequenz- und phasengleiche Wellen, beispielsweise Laserlichtwellen, oder quantenmechanische Zustände"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845fbf33-4521-4c51-a8bc-f157af3d8783",
                                                "sense_id": "b63e71f5-ff27-35a2-b34f-e039d8bbe0fe",
                                                "text": "Das charakteristische Merkmal von Laserlicht ist seine Kohärenz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e63925d-59ff-3df5-8219-bfa9823c42ef",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "in engerem Sinn semantischer Zusammenhang der Worte in einem Text; in einem weiteren Sinn umfasst der Begriff auch die syntaktischen Zusammenhänge zwischen Sätzen, zum Beispiel Anapher, Katapher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5935d91d-fae0-4354-b172-a726ef137962",
                                                "sense_id": "5e63925d-59ff-3df5-8219-bfa9823c42ef",
                                                "text": "Zwischen den Sätzen eines Textes bestehen verschiedene Arten von Kohärenz."
                                            },
                                            {
                                                "example_id": "e9da7bdd-8529-4e01-82e5-194cb0c63b8f",
                                                "sense_id": "5e63925d-59ff-3df5-8219-bfa9823c42ef",
                                                "text": "„Die folgenden Fragen werden hier gestellt: Was macht aus einer Ansammlung von Sätzen einen Text, welche Verknüpfungsmittel treten auf, wie wird Kohärenz hergestellt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "57015261-187f-34b4-ba5d-43f90fcc0d7f",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "logischer Zusammenhang und Nachvollziehbarkeit der Gedankengänge des Patienten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d2703ff-8058-4431-b87d-902895f45b30",
                                                "sense_id": "57015261-187f-34b4-ba5d-43f90fcc0d7f",
                                                "text": "Nach Wilhelm Schmid stellt der Schmerz die Kohärenz des Selbst in Frage."
                                            },
                                            {
                                                "example_id": "d9127c46-60e0-4b5f-b964-9c909a169040",
                                                "sense_id": "57015261-187f-34b4-ba5d-43f90fcc0d7f",
                                                "text": "In der Stressforschung spielt das Kohärenzgefühl eine wichtige Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4d10c1af-753b-34ac-ada0-823404a5d465",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "Betriebsart von Zwischenspeichern (Cache) bei Mehrprozessorsystemen, sodass jeder Prozessor auf aktuelle Daten zugreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7268b86d-ae7e-467f-8087-b2a3451514ee",
                                                "sense_id": "4d10c1af-753b-34ac-ada0-823404a5d465",
                                                "text": "Systeme mit zwei oder mehr Prozessoren brauchen ein Protokoll der Kohärenz, um letztlich sicherzustellen, dass nicht zwei Prozessoren gleichzeitig auf dieselbe Speicherstelle schreiben wollen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bd77c134-3357-390b-a68b-2ffb33f2f1c3",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "Eigenschaft von Modulgarben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11cb70cc-53e4-4c72-80a1-1483bf059dfa",
                                                "sense_id": "bd77c134-3357-390b-a68b-2ffb33f2f1c3",
                                                "text": "Kohärenz ist eine Eigenschaft der Modulgarbe, die damit eine sogenannte ›kohärente Garbe‹ ist."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "fb528bab-2f2f-38d4-8481-37a269ba10d1",
                                        "entry_id": "945a48a2-8337-3283-9ff2-e7db0b6b2eae",
                                        "glosses": [
                                            "Maß für den Grad der linearen Abhängigkeit zweier Signale über der Frequenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae502c6-3886-4555-bce6-3ead17179ced",
                                                "sense_id": "fb528bab-2f2f-38d4-8481-37a269ba10d1",
                                                "text": "Kohärenz zweier Lichtquellen bedeutet also nichts anderes als die Interferenzfähigkeit ihres ausgesandten Lichtes."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
