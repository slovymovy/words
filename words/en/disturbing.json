{
    "word_family": [
        "disturb",
        "disturbance",
        "disturbed",
        "disturbingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1cbb1c73-29df-3382-803d-019325921ea3",
                    "sense_definition": "Causing distress or worry; upsetting or unsettling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "upsetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news report contained <w>disturbing</w> images of the war zone that were difficult to watch.",
                            "target_lang_translations": {
                                "ru": "В репортаже новостей содержались <w>ужасающие</w> кадры из зоны боевых действий, на которые было тяжело смотреть."
                            }
                        },
                        {
                            "text": "It is a <w>disturbing</w> trend that more young people are dropping out of school lately.",
                            "target_lang_translations": {
                                "ru": "Это <w>тревожная</w> тенденция, что в последнее время всё больше молодых людей бросают школу."
                            }
                        }
                    ],
                    "synonyms": [
                        "upsetting",
                        "unsettling",
                        "troubling",
                        "disquieting"
                    ],
                    "antonyms": [
                        "reassuring",
                        "comforting",
                        "soothing"
                    ],
                    "common_phrases": [
                        "disturbing trend",
                        "disturbing news",
                        "deeply disturbing",
                        "disturbing thought"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий беспокойство, тревогу или дискомфорт; расстраивающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "вызывающий опасения или беспокойство"
                            },
                            {
                                "target_lang_word": "беспокоящий",
                                "target_lang_sense_clarification": "нарушающий спокойствие"
                            },
                            {
                                "target_lang_word": "ужасающий",
                                "target_lang_sense_clarification": "шокирующий или крайне неприятный"
                            },
                            {
                                "target_lang_word": "вызывающий тревогу",
                                "target_lang_sense_clarification": "о ситуации или новости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40f5e706-2a8d-3e8a-b9c1-e9a5afe39825",
                    "sense_definition": "Present participle and gerund of <w>disturb</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for <w>disturbing</w> you while you were trying to finish your work.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения за то, что <w>побеспокоил</w> вас, пока вы пытались закончить работу."
                            }
                        },
                        {
                            "text": "He was arrested for <w>disturbing</w> the peace after shouting loudly in the street at night.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за <w>нарушение</w> общественного порядка после того, как громко кричал на улице ночью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disturbing the peace"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола disturb (беспокоить, мешать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоящий",
                                "target_lang_sense_clarification": "в процессе совершения действия"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "в контексте общественного порядка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}