                        "entry_id": "df7a3a09-4d45-3bcb-a8c8-b1ef77656f21",
                        "glosses": [
                            "Preis, der sich aus der Handelstätigkeit an einem Spotmarkt ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a65905-aff5-4180-be88-68972839005c",
                                "sense_id": "f66fc6d9-c5e2-3ab5-8664-e00c8233f53b",
                                "text": "„Während in den meisten europäischen Ländern die aktuellen Spotpreise gelten, ist der Gaspreis für Serbien an den Ölpreis der letzten neun Monate gekoppelt.“"
                            },
                            {
                                "example_id": "9a5853d6-93ff-4457-aa27-86a830a5ad36",
                                "sense_id": "f66fc6d9-c5e2-3ab5-8664-e00c8233f53b",
                                "text": "„Der sogenannte Spotpreis für Gold ist unterdessen trotz einer rasanten Rekordjagd bisher noch an der 1.000-Dollar-Marke gescheitert.“"
                            }
                        ],
