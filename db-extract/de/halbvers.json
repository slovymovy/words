                        "sense_id": "b5f1a395-97bd-3624-a16f-4ec0938b1fd1",
                        "entry_id": "6b037713-5d82-3eea-ba42-2ec3f8fb6922",
                        "glosses": [
                            "einer der beiden Teile eines syntaktisch und metrisch zweigeteilten Verses"
                        ],
                        "tags": [
                            "Verslehre"
                        ],
                        "examples": [
                            {
                                "example_id": "45d45bcd-946d-42f6-b3e4-741469245ff7",
                                "sense_id": "b5f1a395-97bd-3624-a16f-4ec0938b1fd1",
                                "text": "„Auch V. 2 ist intertextuell vernetzt. Der erste Halbvers entspricht wörtlich 4,4c.“"
                            },
                            {
                                "example_id": "4b668eee-4760-4598-bb92-7a3228f0c6a6",
                                "sense_id": "b5f1a395-97bd-3624-a16f-4ec0938b1fd1",
                                "text": "„Statt dessen wird der erotische Teil mit dem Halbverse 75ᵃ […] resumiert […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
