                "senses": [
                    {
                        "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                        "entry_id": "e3b86557-e8c9-37bc-b1a7-2fbfa7c4422e",
                        "glosses": [
                            "durchweichter (zumeist lehmiger, toniger) Boden"
                        ],
                        "tags": [
                            "Namibia",
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "9bbc712c-1e2e-425a-9c67-e6625f1e7c94",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Früher mussten sich die Leute in der Regenzeit fragen, ob sie mit ihrer Tjorrie durchs Rivier kommen oder sonstwo auf Strecke im Monokko stecken bleiben, Äste kappen, diese unterlegen, Schuhe ausziehen und dann wieder anschieben.“"
                            },
                            {
                                "example_id": "daf15620-672f-4cd3-9169-5ae267731b36",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Lange ist’s her, dass der Etoscha-Nationalpark, dessen erstes Jahrhundert wir nächstes Jahr feiern wollen, von Oktober bis März wegen Hitze, Regenzeit (auch wenn sie ausgefallen ist), Moskiten, Monokko und wegen der Wurfzeit der meisten Tiere geschlossen blieb.“"
                            },
                            {
                                "example_id": "ffd81ff2-29c9-4af6-bf29-77eefa3818aa",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Die Wolken hängen mit dunklen Bäuchen durch bis auf den Boden wie das Otjiauto, das die Schotterpad verlässt und dann bis über die Achsen im Monokko versackt.“"
                            },
                            {
                                "example_id": "e6ea1251-c2c6-4acd-b425-78fee5bce351",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Liegt die Ursache denn nicht am Ausbleiben der braunen Swakop-Fluten, die wegen der Dämme im Oberlauf nicht mehr abkommen und daher weder Sand noch Monokko deponieren?“"
                            },
                            {
                                "example_id": "5aebfa9f-e0bf-4d44-9a76-552d811a0a2b",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Selbst unser Mercedes 5 Tonner gerät in den Monokko.“"
                            },
                            {
                                "example_id": "aae147d1-778b-45b0-bbc4-7d75e59658ed",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Fangen wir bei Lehm und Ton an, im [sic!] schlammiger Konsistenz hier als Monokko bekannt.“"
                            },
                            {
                                "example_id": "b724e61d-2e3f-4614-909c-c790132747b1",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Aber jetzt sind wir mos raus aus dem Monokko und sollten eigentlich im gelobten Land der Braven alle moi tjillen und den Qualm vom Braairost beim kühlen Ombira in den Sonnenuntergang kräuseln lassen, bis das Kreuz des Südens aufsteigt und sich in langer Nacht wieder neigt, wenn schließlich der Schakal aufheult.“"
                            },
                            {
                                "example_id": "12a5a0a9-55c6-4be1-a582-a9d7db477883",
                                "sense_id": "f5361730-a1af-34bb-ae81-a820f02ff00a",
                                "text": "„Die Dirty-Tricks-Maschine der Partei, die sich nich von ihrem Kolonialkürzel trennen kann, lief auf Hochtouren, um den HH mit Monokko zu bekleistern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
