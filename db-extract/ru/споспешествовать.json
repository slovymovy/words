                        "examples": [
                            {
                                "example_id": "b3754287-97e6-4f1f-9f56-89ffd4ed4652",
                                "sense_id": "1911fdc6-c808-368b-bc64-3052870b9f6c",
                                "text": "Как тело и душа суть одного состава, и очень тесно между собою связаны: то и должно б им быть во всегдашнем согласии и одно другому споспешествовать."
                            },
                            {
                                "example_id": "d9225d0f-a3a3-4fa5-a987-c4b47414bca8",
                                "sense_id": "1911fdc6-c808-368b-bc64-3052870b9f6c",
                                "text": "Тот же час изъявил он ему всякую готовность споспешествовать во всём…"
                            }
                        ]
                    }
