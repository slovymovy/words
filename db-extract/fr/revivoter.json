                        "entry_id": "acd9a935-5c9a-386c-b97b-e44cd95a5ed0",
                        "glosses": [
                            "Vivoter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1bcf90b-b5da-4ae2-8f51-dc7187123ffc",
                                "sense_id": "c91d335b-4b57-3597-8be8-48cf28c20d83",
                                "text": "Ils se rencoquillèrent dans leur bol, leurs mastications, les miettes à ramasser, la petite vaisselle... des convalescents, qui s'essaient à revivoter."
                            },
                            {
                                "example_id": "8fec6ca4-156c-4b2c-ab97-821344cf6a9e",
                                "sense_id": "c91d335b-4b57-3597-8be8-48cf28c20d83",
                                "text": "En fait, le PS a deux options : s'ouvrir vers l'extérieur ou revivoter dans un passé pas toujours glorieux."
                            }
                        ]
                    }
