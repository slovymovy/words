                    {
                        "translation_id": "19516b2a-56d1-46f8-89b2-cb3f35f3f7b6",
                        "source_entry_id": "c50b8cdd-3643-3080-bae6-5804afb7a665",
                        "source_sense_id": "a611675a-8953-373e-b077-e9e280545372",
                        "source_sense_description": "mammal",
                        "target_lang_word": "Bongo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bongo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                        "entry_id": "d4c9d5a0-6888-301c-98d3-7ad4789932ff",
                                        "glosses": [
                                            "kubanisches Musikinstrument, bestehend aus zwei kleinen Trommeln"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "häufig im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3fde199-ce23-4533-b6ec-a8834d3b5a62",
                                                "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                                "text": "Sie spielte die Bongo wie eine Göttin."
                                            },
                                            {
                                                "example_id": "24d9e468-029e-43d4-8af5-2bc4571a1959",
                                                "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                                "text": "„Hier schlägt er kurz die Becken an, dort ertönt ein Wirbel auf den Bongos, mit den Füßen bearbeitet er derweil die Bassdrums und rührt dazu in seinen Trommeln, daß das Auge kaum folgen kann.“"
                                            },
                                            {
                                                "example_id": "8d1ad7e0-80ad-4d59-a41f-d859087df59d",
                                                "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                                "text": "„‚Die Trommel ist blind für Geschlecht, Rasse oder Einkommen. In einer Trommelgruppe ist jeder ein Gewinner, der mit offenem Herz und Verstand dabei ist‘, zitiert Weber den Trommel-Guru Mickey Hart, schnappt sich eine Bongo und erzählt den Kindern im Rhythmus einer anderen Welt von der Geschichte Afrikas und einer Kultur, die im Gleichklang mit der Natur lebt.“"
                                            },
                                            {
                                                "example_id": "6eea538a-c35c-470b-a773-fc2673fea50d",
                                                "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                                "text": "„Congas sind die grossen Trommeln, Bongos die kleinen.“"
                                            },
                                            {
                                                "example_id": "d2afd33d-024d-4f5b-b135-19b2cab8d6c9",
                                                "sense_id": "656692e6-dd66-37df-a43d-f31a0cf58505",
                                                "text": "„Sämtliche Register kamen einzeln zu Wort, so die Trompeten im Dialog mit dem Holz, die ihre Führung an die Percussion abgaben; ein Bongo sorgte für zusätzliche Akzente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bongo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "575acdde-916c-3f42-ada5-9f976e5080cf",
                                        "entry_id": "729af4a7-798b-34f9-9f6a-dffe34e3854c",
                                        "glosses": [
                                            "Antilopenart, die in Äquatorialafrika vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75597faa-7e20-45c8-b7a8-3b7ae7fa0665",
                                                "sense_id": "575acdde-916c-3f42-ada5-9f976e5080cf",
                                                "text": "Im Wuppertaler Zoo gelang die seltene Nachzucht von Bongos in Gefangenschaft."
                                            },
                                            {
                                                "example_id": "1f9819ae-ace4-44b6-8530-d62ee71b8cdc",
                                                "sense_id": "575acdde-916c-3f42-ada5-9f976e5080cf",
                                                "text": "„Man sah die Elefanten, Zwergnilpferde, Bongos und Waldrentiere.“"
                                            },
                                            {
                                                "example_id": "1b06cc6f-4955-44ec-b79f-55b34ee1bfb9",
                                                "sense_id": "575acdde-916c-3f42-ada5-9f976e5080cf",
                                                "text": "„Kleine Bongos aber werden von ihren Müttern gesäugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
