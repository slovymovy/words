                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d90567-eea8-42ef-bb3d-19ff39d46c9d",
                                                "sense_id": "c5416ac8-e1f0-3f8f-9718-ad6064e499e8",
                                                "text": "Ätschi-bätsch! Jetzt habe ich dich aber reingelegt! Das war gar nicht dein Chef, der da angerufen hat!"
                                            },
                                            {
                                                "example_id": "fa7a1de4-95fc-4a11-9cd7-3b70c058d678",
                                                "sense_id": "c5416ac8-e1f0-3f8f-9718-ad6064e499e8",
                                                "text": "Da hast du dich reinlegen lassen, der Wagen ist das doch gar nicht mehr wert, so rostig, wie der ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
