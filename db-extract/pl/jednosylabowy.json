                    },
                    {
                        "translation_id": "eb4a700f-dab0-437f-95d6-241fca59a5ae",
                        "source_entry_id": "dc0e656c-955f-3717-bf51-338bb8a3a1d5",
                        "source_sense_id": "8c7e4b1a-489e-3a6f-bff3-888a32d81674",
                        "target_lang_word": "einsilbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einsilbig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                        "entry_id": "3ae4df16-893f-3b9e-8b51-fefddb5a1a5b",
                                        "glosses": [
                                            "Eigenschaft einer Person, nicht gern zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264f968e-802f-438c-931a-452ce166ce78",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "Er ist ein sehr einsilbiger Mensch."
                                            },
                                            {
                                                "example_id": "469b9ec1-15c1-4a0e-bf77-fc4d6149fce6",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Während wir ihr durch mehrere dunkle Straßen folgten, blieb Ambly recht einsilbig, …“"
                                            },
                                            {
                                                "example_id": "a07ccaa2-df54-44e8-930a-9f328cf15381",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Den übrigen Weg gab er sich einsilbig und fragte mich überhaupt nicht mehr nach meinem Buch.“"
                                            },
                                            {
                                                "example_id": "00a63833-1f1f-4aac-9f16-e9da847dcd36",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Er wundert sich, daß Franz einsilbig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                        "entry_id": "3ae4df16-893f-3b9e-8b51-fefddb5a1a5b",
                                        "glosses": [
                                            "nur aus einer Silbe bestehend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4565b50f-4755-4f1a-ac74-368845d2c39c",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Diese Schreibkonvention stammt aus der Zeit, als die Mehrzahl der chinesischen Wörter einsilbig waren und mit je einem Zeichen geschrieben wurden, als also keine Veranlassung bestand, Wortgrenzen graphisch zu markieren (…).“"
                                            },
                                            {
                                                "example_id": "283b96c5-2d5a-4d17-bdb1-4745264f1e99",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Hat sich Englisch als Weltsprache möglicherweise auch deshalb durchgesetzt, weil es die meisten einsilbigen Wörter aufweist?“"
                                            },
                                            {
                                                "example_id": "64d986a6-b063-4752-a823-7da01be6a668",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Der wie seine Figuren, die gern einsilbige Namen wie Zürn, Halm oder Horn tragen, schwer unter Abhängigkeiten leidet, die der Einzelne nicht selbst beeinflussen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
