                "senses": [
                    {
                        "sense_id": "4663f39f-a00f-3e20-896d-935d7530b399",
                        "entry_id": "0cb5bc99-500c-3e77-b06b-0e50c7b724b1",
                        "glosses": [
                            "hrabstwo ceremonialne i niemetropolitalne we wschodniej Anglii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97e9b8a-c2f5-4a71-8644-4c33eb28f163",
                                "sense_id": "4663f39f-a00f-3e20-896d-935d7530b399",
                                "text": "Obszar Esseksu jest nizinny i rozciąga się pomiędzy estuarium Tamizy na południu a ujściem rzeki Stour na północy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3b9101c2-1999-3f7e-bf0a-a49cf450fc1e",
                        "entry_id": "0cb5bc99-500c-3e77-b06b-0e50c7b724b1",
                        "glosses": [
                            "nazwa wielu hrabstw, miejscowości, gmin oraz innych toponimów w krajach anglojęzycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694935b1-811d-45f1-ba7a-8e881a0e51f0",
                                "sense_id": "3b9101c2-1999-3f7e-bf0a-a49cf450fc1e",
                                "text": "Samolot miał międzylądowanie w Essexie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "558f3c8c-3bad-3cfb-a5e5-8d988af79b64",
                        "entry_id": "0cb5bc99-500c-3e77-b06b-0e50c7b724b1",
                        "glosses": [
                            "średniowieczne królestwo istniejące we wschodniej Anglii w latach 527–825"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a33cdb-dd7c-42e1-afd9-f4a899ba6f5f",
                                "sense_id": "558f3c8c-3bad-3cfb-a5e5-8d988af79b64",
                                "text": "W połowie VIII wieku duża część terenów Essex, wraz z Londynem, dostała się pod panowanie Mercji."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
