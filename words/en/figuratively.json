    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a4c81077-f87d-3aa3-9eef-86c19ce67c05",
                    "sense_definition": "In a metaphorical or symbolic way, rather than a literal one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phrase was meant <w>figuratively</w>, so you should not take it as a fact."
                        },
                        {
                            "text": "He spoke <w>figuratively</w> when he said his head was about to explode from stress."
                        }
                    ],
                    "synonyms": [
                        "nonliterally"
                    ],
                    "antonyms": [
                        "literally"
                    ],
                    "common_phrases": [
                        "used figuratively",
                        "speaking figuratively"
                    ]
                },
                {
                    "sense_id": "a3224cb5-1a41-33d6-8eff-98fc4136e013",
                    "sense_definition": "Used as a sentence adverb to state that what is being said is a figure of speech and not literally true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Figuratively</w> speaking, the team was climbing an impossible mountain this season."
                        },
                        {
                            "text": "<w>Figuratively</w>, a dark cloud hung over the entire office following the announcement."
                        }
                    ],
                    "synonyms": [
                        "nonliterally"
                    ],
                    "antonyms": [
                        "literally"
                    ],
                    "common_phrases": [
