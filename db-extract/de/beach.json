                ],
                "senses": [
                    {
                        "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                        "entry_id": "fc375ddc-b1e9-3f52-bdd3-86b4dd485db0",
                        "glosses": [
                            "in ein Gewässer hineinragender, langgestreckter, flacher, sandiger oder kiesiger Streifen Land, besonders der bespülte Saum des Meeres"
                        ],
                        "tags": [
                            "zumeist bezogen auf Gegebenheiten englischsprachiger Länder"
                        ],
                        "examples": [
                            {
                                "example_id": "6f125a70-158a-4ce3-8fe1-14b2793ccec0",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Nur am Circular Quai, wo die Schiffe und Omnibusse zu den Beaches abgehen, findet ein Aderlaß von Bademänteln, Sonnenölgesichtem und Strohhüten statt.“"
                            },
                            {
                                "example_id": "e58ed683-d32f-4ae4-95f5-6274afbd4b34",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Seit Jahrzehnten studieren in Leipzig auch ‚farbche Neecher‘, und dem Touristen kann es schon einmal passieren, daß er beim Urlaub zwischen Busch und Beach in Kenia oder Tansania mit ‚meine Guudsden‘ begrüßt wird, ‚nu machen wir mal zu den großmächtchen Gatzen, dem Leewen, diesem Luder!‘“"
                            },
                            {
                                "example_id": "04b4d7f0-b552-4efd-bb24-864107d7993a",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Mindestens 1,2 Millionen Deutsche werden in diesem Sommer in den USA Urlaub machen, und die weitaus meisten wandeln auf ausgetretenen Pfaden: Jeder zweite besucht Kalifornien, jeder dritte sieht sich New York an, jeder vierte liegt in Florida an der Beach.“"
                            },
                            {
                                "example_id": "84778bda-f6a3-46f5-adc4-808722c29823",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Teneriffa, 500 Jahre nach der Zeit der Guanchen-Könige: Eine Insel zeigt, daß sie mehr Werte hat als Beach, Bier und Beton:[…]“"
                            },
                            {
                                "example_id": "1dfe623b-269c-4c66-8f70-61b00196d1e1",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Die Lage der Stadt mit ihren Buchten und Beaches gilt als einzigartig; Wasser und Land gehen hier ein besondere Symbiose ein.“"
                            },
                            {
                                "example_id": "f7294ef6-d231-4dd5-a952-bc11a8069847",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "In Swakop an der Beach kann man zu lekker vrotten. — Am Swakopmunder Strand kann man herrlich faulenzen."
                            },
                            {
                                "example_id": "cc8c96bd-3317-433e-bdce-9de5e11b8919",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Erstmal 3 km barfuß durch den Bush stappen um zum Beach zu kommen - und dann 45 Minuten Trockentraining am kalten Strand morgens um 10 Uhr!“"
                            },
                            {
                                "example_id": "12d21a9f-f39f-4ccf-a955-df7345ef2af0",
                                "sense_id": "aa1a8453-afc4-3d8b-b55a-78ca22998aff",
                                "text": "„Als alles zum Ausklang sich neigte, als der Vorhang sich über der noch einmal aufrauschenden Schlußmusik schloß und sie und die Leinwand in seinem dunklen Purpur begrub, da dauerte es einige Zeit, bis Benrath zu sich kam. Noch stand er schwankend auf einem Fixstern voller Palmenwälder und Beaches, und er erinnerte sich nicht, jemals so weit von der Erde entfernt gewesen zu sein, von jener Erde, deren Luft man Wirklichkeit nannte, eine chemische Verbindung, deren Elemente niemand genau kannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
