                        "entry_id": "4a2be9ea-5cbb-32a7-bad3-6c6d5e2dac2d",
                        "glosses": [
                            "Qui jacasse comme la pie ou qui a un chant bruyant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab637ff2-fe5e-4650-9098-be38b0621ed1",
                                "sense_id": "33d438bd-a8ee-383c-b3cd-eb5cf60fa1c0",
                                "text": "Le criquet jacasseur est souvent pris pour une sauterelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a74464-3c78-3d75-9b3a-c48c24888945",
                        "entry_id": "4a2be9ea-5cbb-32a7-bad3-6c6d5e2dac2d",
                        "glosses": [
                            "Qui parle beaucoup ou fort, qui radote, en parlant d’une personne."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "17b2a293-e33d-45cb-a50e-a033889c9f45",
                                "sense_id": "35a74464-3c78-3d75-9b3a-c48c24888945",
                                "text": "C’est turlupin et jacasseur, la France profonde, facile à manœuvrer en somme."
                            }
                        ]
                    }
                ],
