                    {
                        "form_id": "581e2e03-d339-417a-a94d-7fb96109bda7",
                        "entry_id": "9f3d5fb9-06ad-36d9-8997-81dd6a1f2a31",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Brettspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                        "entry_id": "9f3d5fb9-06ad-36d9-8997-81dd6a1f2a31",
                        "glosses": [
                            "Spiel, das auf einem Spielbrett gespielt wird und auf dem die Spieler mit Figuren, Steinen oder anderem Material agieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eaa58b8-0802-467e-ab63-89c0db3258f2",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "„Seeleute und Händler verbreiteten das Brettspiel rund um den Indischen Ozean.“"
                            },
                            {
                                "example_id": "1b7113c7-058e-4f9e-a848-9edbec38ce44",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "Brettspiele sind oft für die ganze Familie konzipiert."
                            },
                            {
                                "example_id": "af4021ff-73de-4cbe-a642-39fb6d4b8259",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "„Der Höhenflug dieser Vögel setzte sich auch als Brettspiel durch.“"
                            },
                            {
                                "example_id": "17f5a23a-5044-4add-8031-a2ff7a99b791",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "„Das Brettspiel, das erstmals um 1300 in der isländischen Grettissaga Erwähnung findet, wo es Hala-tafl genannt wird, ist viel komplizierter, obwohl es auch eine Variante des Fuchs-und-Gänse-Spiels darstellt.“"
                            },
                            {
                                "example_id": "5da04923-c981-4a34-857e-6c794013c2c3",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "„Im Rahmen eines Projekts ist es sogar möglich, bereits mit Schulanfängern ein Brettspiel zu gestalten, das den Schulweg abbildet.“"
                            },
                            {
                                "example_id": "5e906352-2a1c-4247-88ba-c7c5cd13c0ba",
                                "sense_id": "786aee82-e4a0-3c4a-beeb-029dc9b87035",
                                "text": "„Wir nehmen an, dass die Fähigkeit des Menschen, Brettspiele zu erfinden, älter ist als es die archäologischen Funde nahelegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
