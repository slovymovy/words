                        "sense_id": "7596a0fc-ca98-37c3-88c1-3fbd43ff68ad",
                        "entry_id": "afbb2388-9f91-31da-ab3b-47e216a3a588",
                        "glosses": [
                            "Qui peine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d2fe1a-f856-4594-add2-8e3908d7e952",
                                "sense_id": "7596a0fc-ca98-37c3-88c1-3fbd43ff68ad",
                                "text": "Il en revoyait la pauvre coursive noire de charbon, le carré dont on touchait le plafond de la main, avec sa table de bois entaillée de coups de canif et qui sentait la saumure et la gnôle, les cabestans ahanants et peinants, le mât, l’unique mât, si frêle au-dessus de la proue avec les feux vert et rouge au bout de ses bras."
                            },
                            {
                                "example_id": "7ec35416-2384-49dd-8b43-3cff1b3fde7b",
                                "sense_id": "7596a0fc-ca98-37c3-88c1-3fbd43ff68ad",
                                "text": "Ni le tumulte plaintif de la nature peinante, ni le cri de souffrance de l’humanité douloureuse ne furent primitivement perçus du cerveau subtil aux écoutes."
                            }
                        ]
                    }
