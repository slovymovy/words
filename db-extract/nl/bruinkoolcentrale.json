                        "examples": [
                            {
                                "example_id": "b0bcd41f-d697-4e25-80d7-6ff239e2f0c0",
                                "sense_id": "4abc0338-9bfb-3000-9550-88348849deb3",
                                "text": "In de krant Sächsische Zeitung zegt het energiebedrijf dat het een stilgelegd deel van de bruinkoolcentrale Jänschwalde in Brandenburg gaat reactiveren en dat de centrale daarvoor wordt klaargestoomd. Ook wordt er proefgedraaid. Om voor langere tijd stroom op te wekken zijn zo'n 200 mensen nodig. Die worden nu gezocht."
                            },
                            {
                                "example_id": "a2594cdf-6cef-42fb-aa82-f077abc31c42",
                                "sense_id": "4abc0338-9bfb-3000-9550-88348849deb3",
                                "text": "De protesten tegen de bruinkoolcentrale in de Duitse regio Lausitz zijn afgelopen. Demonstranten blokkeerden de centrale sinds vrijdag. Volgens een woordvoerder van de activisten wordt de blokkade nu opgeheven omdat hun politieke doelen zijn bereikt."
                            }
                        ]
