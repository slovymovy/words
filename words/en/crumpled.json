            "senses": [
                {
                    "sense_id": "79a77755-f93c-331c-bb4a-19e7759ea932",
                    "sense_definition": "Squeezed into a compact mass by irregular folds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threw the <w>crumpled</w> paper into the trash can.",
