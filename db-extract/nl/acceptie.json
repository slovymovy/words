                        "examples": [
                            {
                                "example_id": "40708c20-00b9-49a2-bff6-fe975d67e592",
                                "sense_id": "0542d8e9-bc93-3707-8435-495ed0a0e6d4",
                                "text": "De Tweede Kamerleden Tunahan Kuzu en Selcuk Öztürk, de ex-PvdA'ers die een nieuwe politieke beweging willen vormen, gaan de komende tijd ideeën verzamelen. Iedereen die 'voor verdraagzaamheid, tolerantie, acceptie en verbinding is', kan die ideeën aandragen via e-mail."
                            },
                            {
                                "example_id": "e0d8051a-020c-46da-91f0-f396b9a1de85",
                                "sense_id": "0542d8e9-bc93-3707-8435-495ed0a0e6d4",
                                "text": "De motie is een steun in de rug bij de verdere acceptie van lesbische vrouwen, homoseksuele mannen, biseksuelen, transgender- en intersekse personen (LHBTI)."
                            },
                            {
                                "example_id": "0bd88028-be49-468c-9e25-e8d796a81e77",
                                "sense_id": "0542d8e9-bc93-3707-8435-495ed0a0e6d4",
                                "text": "Ook stelt ze dat er binnen de moslimgemeenschap steeds meer acceptie is om dieren toch te verdoven voor de slacht."
                            }
                        ]
                    }
