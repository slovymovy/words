                ],
                "senses": [
                    {
                        "sense_id": "ada9a8d0-1a68-357b-a6ca-aa24f9d09793",
                        "entry_id": "b3ba0051-aa5f-3ab3-b7b8-6422501f35fd",
                        "glosses": [
                            "Teufel"
                        ],
                        "tags": [
                            "verhüllend"
                        ],
                        "examples": [
                            {
                                "example_id": "dcad457a-6616-4ba9-8742-ddb6b251f990",
                                "sense_id": "ada9a8d0-1a68-357b-a6ca-aa24f9d09793",
                                "text": "„Die Mutter hatte ihm so lange mit dem Leibhaftigen gedroht, dass er begonnen hatte, an ihn zu glauben.“"
                            },
                            {
                                "example_id": "351ab087-12f5-4995-8fc7-939b2622c72c",
                                "sense_id": "ada9a8d0-1a68-357b-a6ca-aa24f9d09793",
                                "text": "„Das, Leute, wissen selbst manche knallharte Katholiken nicht, was mir da Erika Schönhofen rüberschickte. Und zwar aus Ernzen, wo doch direkt überm Dorf ausgerechnet auch noch die, oh Leibhaftiger, Teufelsschlucht dräut, die in diesem Zusammenhang natürlich eine inhaltliche Fallhöhe (oder sagt man da: Falltiefe?) erzeugt, dass man sich lieber schnell dreimal bekreuzigt, bevor man weitererzählt.“"
                            },
                            {
                                "example_id": "38e6c59b-88a2-41ca-baf6-e49b1b1d8412",
                                "sense_id": "ada9a8d0-1a68-357b-a6ca-aa24f9d09793",
                                "text": "Hör auf, mir mit dem Teufel zu drohen. Dein Leibhaftiger geht mir völlig am Hintern vorbei."
                            },
                            {
                                "example_id": "938859ee-2c6c-45d3-afcb-6a2992300026",
                                "sense_id": "ada9a8d0-1a68-357b-a6ca-aa24f9d09793",
                                "text": "„Wir lachten und lachten und lachten, bis uns die Tränen kamen, während Ms. Howard davonlief, als sei der Leibhaftige hinter ihr her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
