                                "target_senses": [
                                    {
                                        "sense_id": "c095c2b7-6c50-323e-8762-66f139e66373",
                                        "entry_id": "86b56154-d0c4-3d09-9c98-5851b4a1b8cb",
                                        "glosses": [
                                            "Of, relating to, or shaped like a pentagon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbce4cbd-89c9-4317-9cca-fb528e119ef5",
                                                "sense_id": "c095c2b7-6c50-323e-8762-66f139e66373",
                                                "text": "If the base be a triangle, it is called a triangular prism; if a square, a square prism; if a pentagon, a pentagonal prism; and' if the base is any irregular figure, it is called an irregular prism : ..."
                                            },
                                            {
                                                "example_id": "042abacd-7f01-40e6-8fdb-00218196a589",
                                                "sense_id": "c095c2b7-6c50-323e-8762-66f139e66373",
                                                "text": "Seed micromorphology:—Seed coat is laticostate. Epidermal cells are elliptical to irregularly pentagonal. Cell walls are thickened mostly at the corners, the boundaries are raised […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pentagonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbb30a6-212d-3f09-95c3-9e7fd2039e2c",
                                        "entry_id": "ecd7d023-3991-33eb-ab4b-9192aecbce82",
                                        "glosses": [
                                            "Something having the shape of a pentagon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ae0e98-71fe-4eb6-a6fc-943362c348c6",
                                                "sense_id": "4dbb30a6-212d-3f09-95c3-9e7fd2039e2c",
                                                "text": "Speaking of protection, note that not only are the end pentagonals surrounded by a generous air space, but the entire instrument is insulated, […]"
                                            },
                                            {
                                                "example_id": "acfcc253-b4a9-4d7e-80f6-fd15a4687140",
                                                "sense_id": "4dbb30a6-212d-3f09-95c3-9e7fd2039e2c",
                                                "text": "The pentagonals with the flowers and the leaves of the central calyx are gilded all over, as is the inner lip of the vessel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
