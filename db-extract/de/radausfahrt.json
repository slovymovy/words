                "senses": [
                    {
                        "sense_id": "682cc08c-a479-3051-83d4-291fc8af085b",
                        "entry_id": "5b22ec7c-9faa-3084-8fcb-9f8cd6770b50",
                        "glosses": [
                            "Ausflug, Reise mit dem Fahrrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42afa8a7-2c8c-490f-9dde-1618d0cea21c",
                                "sense_id": "682cc08c-a479-3051-83d4-291fc8af085b",
                                "text": "Bei unserer gestrigen Radausfahrt genossen wir die frische Luft und die unberührte Natur."
                            },
                            {
                                "example_id": "1aab5aff-a9de-43cb-b146-4d5bbc7a2daf",
                                "sense_id": "682cc08c-a479-3051-83d4-291fc8af085b",
                                "text": "„Der Fahrtwind in den Haaren und im Gesicht während einer Radausfahrt ist zwar angenehm, bringt aber auch gewisse Gefahren mit sich. Die Luft kann nämlich verschiedene Verunreinigungen wie Sand, Staub, Pollen oder auch Kleintiere wie Fliegen und Mücken beinhalten.“"
                            },
                            {
                                "example_id": "1f41bc2d-ef41-470c-a41b-b68a9c1446c7",
                                "sense_id": "682cc08c-a479-3051-83d4-291fc8af085b",
                                "text": "„Gössner war bei einer Radausfahrt mit dem Mountainbike gestürzt und zunächst vor Ort medizinisch versorgt worden.“"
                            },
                            {
                                "example_id": "b86c829a-ce6c-4330-83e7-1a23d4e71c01",
                                "sense_id": "682cc08c-a479-3051-83d4-291fc8af085b",
                                "text": "„Obwohl jetzt Radausfahrten weit über 4 Stunden möglich wären, müssen Sportler, die die Bewältigung einer Triathlon-Sprintdistanz anstreben, im Frühjahrstraining nicht länger als 2–3 Stunden für eine Radeinheit aufwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
