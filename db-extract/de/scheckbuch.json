                        "target_lang_word": "chéquier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chéquier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed388232-0956-365e-8dec-7f0a2c5e5a1d",
                                        "entry_id": "fe790f60-3cb8-3dc3-911d-c97b053d8498",
                                        "glosses": [
                                            "Carnet à souche, réunissant des chèques, délivré par un banquier au titulaire d'un compte chèque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef66f6e5-ffe8-4b12-a59e-27fff9084efd",
                                                "sense_id": "ed388232-0956-365e-8dec-7f0a2c5e5a1d",
                                                "text": "En déplacement, le titulaire d’un compte en banque peut disposer de fonds sans carte ni chéquier."
                                            },
                                            {
                                                "example_id": "743075ab-1927-47f0-b4d2-4f17ec58292b",
                                                "sense_id": "ed388232-0956-365e-8dec-7f0a2c5e5a1d",
                                                "text": "J’ai besoin d’un nouveau chéquier."
                                            },
                                            {
                                                "example_id": "cec39fdb-c0b1-4f3a-892d-00d1b1b8eb65",
                                                "sense_id": "ed388232-0956-365e-8dec-7f0a2c5e5a1d",
                                                "text": "Elle fouille dans ses cassettes, en embarque une dizaine, elle prend aussi la bouteille de whisky et le chéquier de Séverine. Elle enjambe le cadavre plusieurs fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
