                "senses": [
                    {
                        "sense_id": "d080d979-873e-3ff3-8ffd-a1e054a87116",
                        "entry_id": "ad338b58-c71b-3d2d-8b49-45b3662179e6",
                        "glosses": [
                            "Enfermer dans un carcan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c416729-bdee-49cd-bbc1-e57ac1e57906",
                                "sense_id": "d080d979-873e-3ff3-8ffd-a1e054a87116",
                                "text": "Jamais on n’a pendu ou carcané personne, provisoirement et sauf l’appel."
                            },
                            {
                                "example_id": "9850a682-cfd1-4ff3-a586-ab7c88da64d5",
                                "sense_id": "d080d979-873e-3ff3-8ffd-a1e054a87116",
                                "text": "12mn ça peut encore passer, à 15 on se fait lyncher, lapider, rouer, carcaner, étriper, et plus si affinités..."
                            },
                            {
                                "example_id": "319f07ab-8b00-48d5-a910-c22005539474",
                                "sense_id": "d080d979-873e-3ff3-8ffd-a1e054a87116",
                                "text": "Le nombre de fenêtres à carcaner est évalué à 28, cette offre est estimée à 7.826€ HTVA, soit 9.469,46€ TVAC ;"
                            },
                            {
                                "example_id": "c48a1130-fbf7-433b-b32f-7ad1d8d3df68",
                                "sense_id": "d080d979-873e-3ff3-8ffd-a1e054a87116",
                                "text": "impossible de se carcaner dans des vêtements pour dormir."
                            }
                        ]
                    }
