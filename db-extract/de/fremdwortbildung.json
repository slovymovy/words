                "senses": [
                    {
                        "sense_id": "332e8667-ee60-3032-ba21-f4a6812276f8",
                        "entry_id": "0deb478d-df4e-36fb-a0c9-4c6dc096e521",
                        "glosses": [
                            "Bezeichnung für diejenigen Fälle von Wortbildung, bei denen Wörter, die fremdsprachige Eigenschaften aufweisen, in Wirklichkeit in der eigenen Sprache gebildet und nicht als Ganze entlehnt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4d14d8-87e4-4358-9b6d-771736517484",
                                "sense_id": "332e8667-ee60-3032-ba21-f4a6812276f8",
                                "text": "„Ein Manko bleibt allerdings, dass die Mehrheit der Anglizismen gar nicht entlehnt ist und das Verhältnis von Entlehnung einerseits und Fremdwortbildung andererseits ungeklärt bleibt.“"
                            },
                            {
                                "example_id": "f9fd21a7-8ece-48bb-84c6-7ef034069aee",
                                "sense_id": "332e8667-ee60-3032-ba21-f4a6812276f8",
                                "text": "„Die zwölf Beiträge in diesem Band zum Thema Fremdwortbildung reflektieren aktuelle Forschungstendenzen. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
