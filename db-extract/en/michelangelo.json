    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "321599c1-a670-37db-8576-e7ac8210f037",
                "word": "Michelangelo",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "816dfec0-c0f4-4de5-bbf9-757855cd8313",
                        "entry_id": "321599c1-a670-37db-8576-e7ac8210f037",
                        "tags": [
                            "plural"
                        ],
                        "form": "Michelangelos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf28c8ec-bbcb-3dfe-867f-705d0d8ee688",
                        "entry_id": "321599c1-a670-37db-8576-e7ac8210f037",
                        "glosses": [
                            "A 15th- and 16th-century Italian artist, full name Michelangelo di Lodovico Buonarroti Simoni (1475–1564)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7897e3c1-1d4f-43c1-8d18-7b43d5aa6e3c",
                                "sense_id": "cf28c8ec-bbcb-3dfe-867f-705d0d8ee688",
                                "text": "In the room the women come and go / Talking of Michelangelo."
                            },
                            {
                                "example_id": "c421f2ea-64a3-452b-bc9d-497e93e07ccd",
                                "sense_id": "cf28c8ec-bbcb-3dfe-867f-705d0d8ee688",
                                "text": "There are no evidences in these days of Michelangelos and Titians, who at the age of eighty or ninety could turn out stronger work than our people of thirty and forty today!"
                            },
                            {
                                "example_id": "83f1497a-7430-43d6-bcbe-ed8730b1c97d",
                                "sense_id": "cf28c8ec-bbcb-3dfe-867f-705d0d8ee688",
                                "text": "Where did Picasso come from? / There's no Michelangelo coming from Pittsburgh"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb03d11-550b-438b-b065-23dba2b08130",
                        "source_entry_id": "321599c1-a670-37db-8576-e7ac8210f037",
                        "source_sense_id": "cf28c8ec-bbcb-3dfe-867f-705d0d8ee688",
                        "source_sense_description": "Italian artist",
                        "target_lang_word": "Michel-Ange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Michel-Ange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c252c4-d8f1-39dd-a487-395b30fbcc98",
                                        "entry_id": "ae43a3ef-e490-32d7-b710-a24f8a9341ce",
                                        "glosses": [
                                            "Michelangelo Buonarroti, artiste italien de la Renaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1d407e-f326-418e-bd16-68c5ec2ac398",
                                                "sense_id": "e2c252c4-d8f1-39dd-a487-395b30fbcc98",
                                                "text": "Ainsi, ce paresseux génie a fondu la couleur vénitienne, la composition florentine, le style raphaëlesque dans les rares tableaux qu’il a daigné peindre et dont les cartons étaient dessinés, dit-on, par Michel-Ange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ea8fd1-b1dc-3fec-9640-f49928e87189",
                                        "entry_id": "ae43a3ef-e490-32d7-b710-a24f8a9341ce",
                                        "glosses": [
                                            "Celui ou celle qui peint ou dépeint comme Michel-Ange, ou d’un même talent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f309e550-c33a-4684-9b57-23586c51777c",
                                                "sense_id": "29ea8fd1-b1dc-3fec-9640-f49928e87189",
                                                "text": "On peut faire la même remarque sur une autre vie, celle de notre Michel-Ange français. Dans les premières années de sa vie, Corneille a été frappé aussi par le sentiment de la force et de l’héroïsme moral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
