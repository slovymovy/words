                "senses": [
                    {
                        "sense_id": "76a8ca78-338f-3a7a-a4fc-35087801da5a",
                        "entry_id": "aec2942e-7b7d-3b94-88cc-69225a92cf50",
                        "glosses": [
                            "Homologuer (un bateau) pour l’importer en Nouvelle-Calédonie, moyennant une taxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a00fd7b-2f2d-4800-8249-4b5ff074372a",
                                "sense_id": "76a8ca78-338f-3a7a-a4fc-35087801da5a",
                                "text": "De toute façon, pour le vendre ici tu es obligé de le \"nouméatiser\" et donc de payer 27% de taxes."
                            },
                            {
                                "example_id": "cbd4f92f-c5a1-4a2f-a767-ddd8560d6af8",
                                "sense_id": "76a8ca78-338f-3a7a-a4fc-35087801da5a",
                                "text": "Pour cela deux options : acheter le bateau \"nouméatisé\", ou arriver avec (TVA européenne payée)...de très loin!"
                            },
                            {
                                "example_id": "db28ca4a-4e4e-44a8-ae5c-768dd0ab781d",
                                "sense_id": "76a8ca78-338f-3a7a-a4fc-35087801da5a",
                                "text": "Excellent Etat, refait à neuf en 2016 à Nouméa, nouméatisé, expertisé en octobre 2018."
                            },
                            {
                                "example_id": "c8e80514-9aae-4984-a893-79117407844d",
                                "sense_id": "76a8ca78-338f-3a7a-a4fc-35087801da5a",
                                "text": "Arrivé en NC en 90, j'ai fait nouméatiser le bateau en passant par un transitaire qui remplit un formulaire D3 en se basant sur un inventaire fourni par moi même."
                            }
                        ]
                    }
