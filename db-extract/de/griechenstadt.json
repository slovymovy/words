                ],
                "senses": [
                    {
                        "sense_id": "68245a6b-f8a1-358c-bdc9-0084f5e48106",
                        "entry_id": "9b23af3d-86d9-36e7-ba5c-464b8d5d927d",
                        "glosses": [
                            "Stadt, die von Griechen besiedelt ist/die zu Griechenland gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a819e37-34de-4d51-ad40-4284811d8eb7",
                                "sense_id": "68245a6b-f8a1-358c-bdc9-0084f5e48106",
                                "text": "„Die Lukaner brauchten Hilfe gegen die Griechenstadt Tarent, welche den spartanischen König Kleonymos aus Griechenland zu ihrem Schutz herbeigerufen. hatte.“"
                            },
                            {
                                "example_id": "0342d7e0-10ed-4f88-b7fe-8bca69b8bb2b",
                                "sense_id": "68245a6b-f8a1-358c-bdc9-0084f5e48106",
                                "text": "„Wenngleich die Antigoniden im Gegensatz zu den Antipatriden den Griechenstädten ein weitaus höheres Maß an inneren Freiheiten gewährten, so ließen sie keinen Zweifel daran, dass sich die Griechen nach außen hin an ihren Interessen zu orientieren hatten.“"
                            },
                            {
                                "example_id": "f23f3d96-4d12-4b07-9d25-215302dea8a8",
                                "sense_id": "68245a6b-f8a1-358c-bdc9-0084f5e48106",
                                "text": "„Viel geringer an Zahl waren die Griechenstädte in Babylonien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
