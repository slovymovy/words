                "senses": [
                    {
                        "sense_id": "953030fe-5392-310f-bad1-d97bed3baf47",
                        "entry_id": "57bf6f56-939b-3530-8e5a-a20237268e24",
                        "glosses": [
                            "eine für das Wohnzimmer konzipierte elektronische Orgel"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f14155b1-a494-4bcd-a357-5882689a868b",
                                "sense_id": "953030fe-5392-310f-bad1-d97bed3baf47",
                                "text": "„Die Alten haben sich Insulinspritzen verpasst, die Wäsche aufgehängt, Blumenzwiebeln gesteckt, die Decke gestrichen, Geld gezählt, Verstecken gespielt, die Heimorgel angeworfen und das Tanzbein geschwungen.“"
                            },
                            {
                                "example_id": "7e6d204b-f263-4eab-9c64-c86f2826b8dc",
                                "sense_id": "953030fe-5392-310f-bad1-d97bed3baf47",
                                "text": "„Blütezeit der Heimorgeln waren die 1970er und frühen 1980er Jahre. Zu dieser Zeit waren sie durchaus auch Statussymbol, was sich in einer Leistungsklasseneinteilung ähnlich der Automobilwelt niederschlug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
