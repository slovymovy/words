                                        "entry_id": "6a6e8d51-384f-35c8-8c6f-25a2b484320b",
                                        "glosses": [
                                            "Nom d'un des livres de l’Ancien Testament, également appelé Ecclésiaste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f3510c-20ff-4d27-a5ec-f337054a3fba",
                                                "sense_id": "d77dfe2f-157c-3da5-ab42-49db2b00a588",
                                                "text": "Vanité des vanités, tout est vanité, disait Qohélet. (Qo 1,1)"
                                            }
