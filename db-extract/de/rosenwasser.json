                                    {
                                        "sense_id": "6bf56886-eed9-3394-8563-8324aef57c2c",
                                        "entry_id": "19cffb54-7b61-3b5a-85e2-d20aca6f5d81",
                                        "glosses": [
                                            "Eau de toilette préparée au cours de la distillation de l’essence de rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9e3bef-8f34-4f65-8f6f-6ca562cc7861",
                                                "sense_id": "6bf56886-eed9-3394-8563-8324aef57c2c",
                                                "text": "En entrant dans la maison du Marocain, nous fûmes enveloppés d’un nuage d’arômes orientaux : le parfum doux et pénétrant de l’eau de rose nous monta au cerveau, et nous fit penser aux mystères du harem et aux merveilles des Mille et une Nuits."
                                            },
                                            {
                                                "example_id": "7fc16a73-fbeb-4176-9913-a289278c14ba",
                                                "sense_id": "6bf56886-eed9-3394-8563-8324aef57c2c",
                                                "text": "La veille, préparez la crème achta libanaise en mélangeant un 1/2 L de lait entier, 40 g de maïzena, un bouchon d’eau de fleur d’oranger, un bouchon d’eau de rose et un peu de sucre en poudre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
