                                    {
                                        "sense_id": "c5bf82b6-aa0a-3624-8500-4b1f7983a3bc",
                                        "entry_id": "62c5b58d-32cf-3623-ac25-fc163b2f657c",
                                        "glosses": [
                                            "форма государственного управления, при которой верховная власть принадлежит одному лицу, монарху"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6503728b-0a73-4036-8482-dc464b0cdc90",
                                                "sense_id": "c5bf82b6-aa0a-3624-8500-4b1f7983a3bc",
                                                "text": "Политические партии Королевства Непал согласовали поэтапный сценарий упразднения монархии и провозглашения страны федеративной демократической республикой."
                                            }
