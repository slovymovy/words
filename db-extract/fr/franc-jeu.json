                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d92dc96-9336-3972-a9a0-23db4953889d",
                        "entry_id": "f8f178ab-4bc9-3c7c-b8f8-af8f064f881a",
                        "glosses": [
                            "Jeu respectueux des règles et de l’adversaire. Fair-play."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebcc7ea4-14d5-4f52-8936-393ab61aaa4d",
                                "sense_id": "4d92dc96-9336-3972-a9a0-23db4953889d",
                                "text": "Le franc-jeu est l’essence même du sport."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "641febc4-68bf-4bfb-bcdd-ed68ee408bc4",
                        "source_entry_id": "f8f178ab-4bc9-3c7c-b8f8-af8f064f881a",
                        "source_sense_id": "4d92dc96-9336-3972-a9a0-23db4953889d",
                        "target_lang_word": "Fairness",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fairness",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d30a797-1508-3c36-be81-58a978bca6ba",
                                        "entry_id": "2380ecf0-d2a1-3b93-a518-117e8cdf0041",
                                        "glosses": [
                                            "ein anständiges Verhalten anderen gegenüber im privaten und beruflichen Umgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01abdaaf-83b1-4dfb-bc1c-1ba00c8507a5",
                                                "sense_id": "7d30a797-1508-3c36-be81-58a978bca6ba",
                                                "text": "Mayr-Harting bezeichnete die neue Regelung als Fortschritt im Sinne von Transparenz und Fairness."
                                            },
                                            {
                                                "example_id": "f5ff4d04-f599-445a-985a-304f50b353dc",
                                                "sense_id": "7d30a797-1508-3c36-be81-58a978bca6ba",
                                                "text": "Chilcot betonte bei der Eröffnung, es handle sich um Anhörungen, niemand stehe vor Gericht. Er und seine Kollegen seien aber zu Gründlichkeit, Neutralität und Fairness entschlossen."
                                            },
                                            {
                                                "example_id": "77713d70-dabe-4b77-84ed-60cf613854da",
                                                "sense_id": "7d30a797-1508-3c36-be81-58a978bca6ba",
                                                "text": "Die Kraft zur Differenzierung, zur Fairness und Besonnenheit an den Tag zu legen – das ist stets richtig, ganz besonders aber die Forderung des Augenblicks."
                                            },
                                            {
                                                "example_id": "7a53a903-76b3-4392-b3e9-088c83486b47",
                                                "sense_id": "7d30a797-1508-3c36-be81-58a978bca6ba",
                                                "text": "„Lippenbekenntnisse zu Fairness und Chancengerechtigkeit für die Schwarzen waren substanzlos und dienten nur der Beruhigung Londons, das man davon abhalten wollte, von seinem Vetorecht Gebrauch zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f663d630-1d3c-3b60-8610-690e7d7c0484",
                                        "entry_id": "2380ecf0-d2a1-3b93-a518-117e8cdf0041",
                                        "glosses": [
                                            "ein rücksichtsvolles, regelkonformes Verhalten im sportlichen Wettkampf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b774a5-743c-4384-8b42-006b39fe0910",
                                                "sense_id": "f663d630-1d3c-3b60-8610-690e7d7c0484",
                                                "text": "Daher haben die Funktionäre zur Erhöhung von Sicherheit und Fairness zur kommenden Saison beschlossen, einerseits den BMI einen halben Punkt hochzusetzen, andererseits die zulässige Skilänge von 146 auf 143 Prozent der Körpergröße zu reduzieren."
                                            },
                                            {
                                                "example_id": "4b365a1a-01fa-4958-b125-18a549dd4489",
                                                "sense_id": "f663d630-1d3c-3b60-8610-690e7d7c0484",
                                                "text": "Der Gentlemansport der olympischen Bewegung, dem es um höhere Werte ging als um Unterhaltung, der Fairness und Chancengleichheit propagierte, der Sport als gesund für Körper und Geist sehen wollte, war ein völlig anderes Universum."
                                            },
                                            {
                                                "example_id": "f200b903-cb4f-4a5c-93a7-9272c0d28855",
                                                "sense_id": "f663d630-1d3c-3b60-8610-690e7d7c0484",
                                                "text": "Seine Einstellung zur Fairness im Sport, die ihn einst zu Ferrari trieb, hat sich hingegen wohl nicht geändert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf176fe3-d616-4605-b6f3-e486d385c097",
                        "source_entry_id": "f8f178ab-4bc9-3c7c-b8f8-af8f064f881a",
                        "source_sense_id": "4d92dc96-9336-3972-a9a0-23db4953889d",
                        "target_lang_word": "Fairplay",
