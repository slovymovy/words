                "senses": [
                    {
                        "sense_id": "9364f797-2f06-3b4a-b4f8-5f38f7b3ff7b",
                        "entry_id": "230caa3a-ec16-3f14-9d8d-70ca377aba51",
                        "glosses": [
                            "dotyczący lub związany z Syjonem"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "b1838886-9b37-43da-b00d-1b812b59dd0a",
                                "sense_id": "9364f797-2f06-3b4a-b4f8-5f38f7b3ff7b",
                                "text": "Zaśpiewajcie nam / jakąś z pieśni syjońskich!"
                            },
                            {
                                "example_id": "60e658e5-cf0c-4cef-b393-69b214b92ee3",
                                "sense_id": "9364f797-2f06-3b4a-b4f8-5f38f7b3ff7b",
                                "text": "Powiedzcie Córze Syjońskiej: Oto Król twój przychodzi do Ciebie łagodny, siedzący na osiołku, źrebięciu oślicy."
                            },
                            {
                                "example_id": "822f4e65-d371-45e5-962b-d2e2742d9d4d",
                                "sense_id": "9364f797-2f06-3b4a-b4f8-5f38f7b3ff7b",
                                "text": "Z dzielnicy żydowskiej wyszliśmy ze starego miasta Bramą Syjońską."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
