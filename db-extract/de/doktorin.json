                        "examples": [
                            {
                                "example_id": "c8959dbf-c238-451c-af11-967ff5204ec0",
                                "sense_id": "485df25c-6172-3cb5-b5b3-fa0192b6b8cf",
                                "text": "Sie haben einen Termin bei Doktorin Müller.",
