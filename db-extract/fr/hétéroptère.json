                        "entry_id": "1acf2cf2-f27c-31c1-8efd-c5d339d0ff01",
                        "glosses": [
                            "Insecte appartenant à l'ordre des hémiptères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c497036f-a3b1-4cc0-be4c-ac42540855d5",
                                "sense_id": "e9a3f445-013c-3eec-a68f-5bac41563207",
                                "text": "Les hétéroptères, ou punaises, appartiennent à l'ensemble des insectes ptérygotes hétérométaboles."
                            },
                            {
                                "example_id": "cc8b4076-0db7-40a2-b676-1aeca83a28e7",
                                "sense_id": "e9a3f445-013c-3eec-a68f-5bac41563207",
                                "text": "Orthunga bicolorata appartenant à la sous-famille Nemesiinae est un hétéroptère remarquable mentionné seulement à Mayotte."
                            }
                        ]
                    }
                ],
                "translations": [
