                        "sense_id": "ec088ac9-5199-3ef7-89ea-49381ea9bae1",
                        "entry_id": "cbae0c34-eac1-3a6a-8742-f5e4c43d67eb",
                        "glosses": [
                            "To engage in a firefight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1bc0ddd-9f4d-4309-82ea-a4e0e3af0b49",
                                "sense_id": "ec088ac9-5199-3ef7-89ea-49381ea9bae1",
                                "text": "His goal: a patch of high ground called Sperwan Ghar, where he and his men firefought a thousand Taliban to take the hill and call in the air strikes critical to turning the tide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ed3fb69-c472-401c-b737-c3de3a8e854a",
                        "source_entry_id": "cbae0c34-eac1-3a6a-8742-f5e4c43d67eb",
                        "source_sense_id": "ec088ac9-5199-3ef7-89ea-49381ea9bae1",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Feuergefecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuergefecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                        "entry_id": "c760d8b5-4b25-3898-909d-4497bf4b62c3",
                                        "glosses": [
                                            "Kampf mit Feuer-/Schusswaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97de6e66-ba62-44b5-b562-b6a03c6a6c53",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Um die Mannschaftsbaracke herum fand ein wildes Feuergefecht statt.“"
                                            },
                                            {
                                                "example_id": "7b14a0c6-c8e3-450a-9170-8b29b33ae66c",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Am 18. und 19. November rückten die Truppen noch zwei Tagemärsche weit vor, und die feindlichen Vorposten zogen sich nach unbedeutenden Feuergefechten zurück.“"
                                            },
                                            {
                                                "example_id": "1bde8cc5-b8b3-4af6-926c-3c2aa815d51d",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Aber sie hatte, noch im Backfischalter, die Gefahren des Feuergefechts erlebt, hatte die grauenvollen Berichte von Vergewaltigungen und Folterungen mitangehört, hatte gelegentlich gehungert und ständig in Angst gelebt und hatte zusehen müssen, wie eine Rotte roter Soldaten ihre Rigaer Vettern an die Wand des Hauses stellte und erschoß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3789e531-b6cd-4790-8769-4c7997584134",
                        "source_entry_id": "cbae0c34-eac1-3a6a-8742-f5e4c43d67eb",
                        "source_sense_id": "ec088ac9-5199-3ef7-89ea-49381ea9bae1",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Feuerkampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerkampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee97d71-6220-388b-ac0c-e974cbffa2c5",
                                        "entry_id": "ddaf2ca6-7c85-3c66-b09d-f06a5a670b0b",
                                        "glosses": [
                                            "Kampf unter Einsatz von Feuerwaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba533827-2a88-49b9-9a44-8278cab8b806",
                                                "sense_id": "2ee97d71-6220-388b-ac0c-e974cbffa2c5",
                                                "text": "„Auf dem Marktplatz, auf dem vor der Ankunft des Kaisers ein recht heftiger Feuerkampf stattgefunden hatte, lagen noch einige Gefallene und Verwundete, die man noch nicht hatte wegschaffen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
