                "senses": [
                    {
                        "sense_id": "76b74b3f-92d6-3e29-ab77-966c9d78286a",
                        "entry_id": "8d3c6153-b1d7-3db0-9f1c-7326830f74ef",
                        "glosses": [
                            "Action par laquelle, au moyen de médicaments ou d’autres agents, on détourne d’une partie du corps la cause d’une maladie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6a406e-b05f-4732-942c-17db383b0dd3",
                                "sense_id": "76b74b3f-92d6-3e29-ab77-966c9d78286a",
                                "text": "Dans les maladies où il faut sur-le-champ une évacuation sanguine avec forte dérivation et prompte révulsion , les ventouses scarifiées souvent l'emportent sur les sangsues : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "15889469-d19e-3802-87f8-5587798e690a",
                        "entry_id": "8d3c6153-b1d7-3db0-9f1c-7326830f74ef",
                        "glosses": [
                            "Effet de ce qui révulse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0731ac4c-2fa0-4cf5-b70e-a5521d849cb1",
                                "sense_id": "15889469-d19e-3802-87f8-5587798e690a",
                                "text": "Je ne puis même pas envisager l’idée de faire du mal ou de provoquer une révulsion inoubliable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
