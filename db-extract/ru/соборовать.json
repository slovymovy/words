                        ]
                    },
                    {
                        "translation_id": "428ff85a-053d-4e62-812e-cc4cebc04449",
                        "source_entry_id": "bac3a321-012e-301c-9848-0727e0f047aa",
                        "source_sense_id": "b97481d1-3fa2-315f-9ceb-58b91d8ca77e",
                        "target_lang_word": "administrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                                        "entry_id": "45ef129d-f4e8-3766-85ba-3a8ede4a380a",
                                        "glosses": [
                                            "Gouverner, régir les affaires publiques ou particulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed7d99d-20d3-4ee3-9078-fca76343a6b7",
                                                "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                                                "text": "On l’accusait d’avoir mal administré les affaires, d’avoir mal administré les finances, les revenus de l’état."
                                            },
                                            {
                                                "example_id": "185a54a4-5f94-4847-a4c1-21d8dec09394",
                                                "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                                                "text": "Il avait aussi les coudées franches pour administrer le domaine temporel et les affaires terrestres de la communauté, de l'État et de l'empire musulman."
                                            },
                                            {
                                                "example_id": "03f7cc3c-c326-4a6e-b23c-2b4d4ec237e7",
                                                "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                                                "text": "Ripont — […]. Commune entièrement détruite pendant la guerre de 1914-18. Son territoire est administré en 1919, par le \"ministère du blocus et des régions libérées\" puis par les Domaines."
                                            },
                                            {
                                                "example_id": "71c48194-463a-4f66-a377-906907f86d0e",
                                                "sense_id": "145e6a5c-cbcf-3765-9b8a-e5240b646dca",
                                                "text": "Il a sagement administré les biens de son pupille. - Il administre lui-même son bien. - On administre une base de données à l’aide d’un logiciel d’administration de base de données."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                        "entry_id": "45ef129d-f4e8-3766-85ba-3a8ede4a380a",
                                        "glosses": [
                                            "Donner ; appliquer ; infliger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f437a66f-18df-4b2c-97f1-1c06dc56ca79",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "Elle appelle le délinquant à son tribunal ; elle commence par lui administrer la bâtonnade pour lui rafraîchir la mémoire, et ensuite elle lui dit : Prouve ton innocence."
                                            },
                                            {
                                                "example_id": "427dd682-6c62-4687-82fb-666600d33ce6",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "Bob, au passage, le secoua, le fit se lever et, lui administrant sur le crâne une amicale taloche, dit en me l'amenant : […]."
                                            },
                                            {
                                                "example_id": "8c58a634-0062-4047-a732-0e97eb1f1ef2",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "Je ne sache pas que la benzine ait été administrée à l'intérieur à titre de vermicide. Son emploi a été borné jusqu'ici au traitement de l'infection trichineuse."
                                            },
                                            {
                                                "example_id": "41821b43-50af-4ad4-8ee6-b535657a918e",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "– Hello, toi, fit Carmine en lui administrant une tape sur l'épaule."
                                            },
                                            {
                                                "example_id": "631613b1-52a1-4bd5-a458-5d01ee257285",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "En tournée au domaine des Tutons, à Saint-Marcel, Demort y trouve « le sieur Sabourin maréchal à Lothiers qui administrait un prétendu spécifique contre (la maladie charbonneuse) à plusieurs bêtes à cornes, […]. »"
                                            },
                                            {
                                                "example_id": "262428a0-2e96-42a6-8041-3ec2a291ee5e",
                                                "sense_id": "f7c1baa0-a6df-35c2-82a1-50fcd2bce963",
                                                "text": "Dans les premiers âges historiques, on ne voit pas seulement les maîtres frapper et fouetter leurs esclaves ; les rois eux-mêmes administrent le supplice de la bastonnade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a7979c-ccd9-3185-b39b-7b55223d95cb",
                                        "entry_id": "45ef129d-f4e8-3766-85ba-3a8ede4a380a",
                                        "glosses": [
                                            "Conférer les sacrements."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cbd71c0-4b77-4593-8495-616455d3ae77",
                                                "sense_id": "84a7979c-ccd9-3185-b39b-7b55223d95cb",
                                                "text": "La cessation a divinis est la défense que l’Église fait à ses ministres de célébrer l’office divin et d’administrer les sacrements en certains lieux ([…])."
                                            },
                                            {
                                                "example_id": "26552249-f0c5-45ae-a327-4da982b568a3",
                                                "sense_id": "84a7979c-ccd9-3185-b39b-7b55223d95cb",
                                                "text": "Au regard de la discipline ecclésiastique, cette lettre laisse songeur, car la seule sanction grave pour des prêtres est la suspension a divinis, l’interdiction d’administrer les sacrements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                        "entry_id": "45ef129d-f4e8-3766-85ba-3a8ede4a380a",
                                        "glosses": [
                                            "Donner le viatique et l’extrême-onction, à un mourant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78621f7c-5975-4f78-adbd-f4eedbd6f396",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Où sont ces chiens de prêtres maintenant, hurla le baron, […] ils me laissent mourir comme le chien vagabond et traqué, sans me confesser ni m’administrer."
                                            },
                                            {
                                                "example_id": "baffad19-4ce9-4528-8278-4ebbfdc96aca",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Peu de jours après, il arriva chez elle d’un air sérieux qui devint sombre en lui tâtant le pouls, et il l’engagea à toutes les cérémonies religieuses qui, en province, sont comprises dans ce seul mot : se faire administrer."
                                            },
                                            {
                                                "example_id": "f81ea40b-11d8-4fd5-aa03-472b50cbe97a",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Lorsque le curé de la paroisse vint l’administrer, ses yeux, morts en apparence depuis quelques heures, se ranimèrent à la vue de la croix."
                                            },
                                            {
                                                "example_id": "7a52ef9f-89d5-4e79-8c63-703691e96b1f",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Quand monsieur Desfondrilles vint chez Auffray, Pierrette était à l’agonie, elle avait son confesseur à son chevet, elle allait être administrée."
                                            },
                                            {
                                                "example_id": "257ae77c-2195-4ae2-986e-10ddd578fe4f",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Après avoir été administré, mon bon maître me fit signe d’approcher de son lit."
                                            },
                                            {
                                                "example_id": "ac5dcb85-c146-4abc-ac7f-ff2e0fb95e0a",
                                                "sense_id": "5f990f9a-4ae4-34c8-a2a6-e9d5e16641b0",
                                                "text": "Et M. le curé, qui voulait à toute force administrer les coupables, dut s'en retourner au presbytère sans avoir accompli cette fonction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f54e84-d366-30f6-9a9e-b8486672ba1b",
                                        "entry_id": "45ef129d-f4e8-3766-85ba-3a8ede4a380a",
                                        "glosses": [
                                            "Produire, fournir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ba0ab6-3b03-4204-8f38-e3a427db8ce0",
