                                "target_senses": [
                                    {
                                        "sense_id": "d8d21a64-8231-3b71-ac87-3eda7542f12e",
                                        "entry_id": "ced9f41a-1359-32a1-be31-201a3ec07473",
                                        "glosses": [
                                            "разг. то же, что начальник"
                                        ],
                                        "tags": [],
