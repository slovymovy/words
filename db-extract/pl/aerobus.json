                                "target_senses": [
                                    {
                                        "sense_id": "e9b435b9-0d3b-3aae-b968-dd030b280d1e",
                                        "entry_id": "91042858-6021-37a4-970f-4152663c396a",
                                        "glosses": [
                                            "Hubschrauber im Taxidienst"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abccae8d-4776-4426-8671-82eec6696f08",
                                                "sense_id": "e9b435b9-0d3b-3aae-b968-dd030b280d1e",
                                                "text": "„Sollte es tatsächlich zum Bau der Einbahnschiene kommen, steht auch schon das nächste Megaprojekt an: ein ‚Aerobus‘ soll Touristen bequem auf die Insel Koh Larn bringen.“"
                                            },
                                            {
                                                "example_id": "23c7cda5-9741-4bfd-bdd9-c201c10fc45d",
                                                "sense_id": "e9b435b9-0d3b-3aae-b968-dd030b280d1e",
                                                "text": "„Der Aerobus verkehrt als Shuttle zwischen dem Flughafen und der Innenstadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
