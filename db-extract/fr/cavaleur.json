                    {
                        "sense_id": "64c15977-8a85-389d-8b12-1a9dad4c20e7",
                        "entry_id": "94dc8315-0350-303a-acca-f0a5eb212bc8",
                        "glosses": [
                            "Celui qui mène une vie de débauche, qui recherche les aventures amoureuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3196569a-52cc-4a21-a0d3-f75ea6afd8a6",
                                "sense_id": "64c15977-8a85-389d-8b12-1a9dad4c20e7",
                                "text": "Oui, c’est un cavaleur… C’est-à-dire qu’il profite de toutes les occasions qui lui tombent dans les bras."
                            },
                            {
                                "example_id": "5fef30a0-45c6-4289-b74b-6dbe094e9c61",
                                "sense_id": "64c15977-8a85-389d-8b12-1a9dad4c20e7",
                                "text": "Nous avons tous été des cavaleurs dans la famille, mais lui plus que tout autre. Il s’est barré tout de suite quand sa femme avait dix-huit ans !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bc5e87a-c22f-43e5-8171-4691a706e898",
                        "source_entry_id": "94dc8315-0350-303a-acca-f0a5eb212bc8",
                        "source_sense_id": "64c15977-8a85-389d-8b12-1a9dad4c20e7",
                        "target_lang_word": "skirt chaser",
