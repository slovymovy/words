                        ],
                        "examples": [
                            {
                                "example_id": "a0d95c04-7a9b-4711-a554-b3bbaefeb350",
                                "sense_id": "d9feff3f-3e53-3b4b-84ea-c958a22c69c1",
                                "text": "If you liked our old shampoo, you'll love the new kinder, gentler formulation."
