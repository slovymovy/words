                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abweichlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a640fc80-308b-3e6b-a493-1cc5899cf28e",
