    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e3b06b91-d439-3195-b902-ffd67b17bbeb",
                "word": "WTF",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c",
                        "entry_id": "e3b06b91-d439-3195-b902-ffd67b17bbeb",
                        "glosses": [
                            "Initialism of World Taekwondo Federation."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "dated",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "8937a9ff-62e8-4c41-ba25-dc46c799a49c",
                                "sense_id": "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c",
                                "text": "Likewise the WTF says they are the official Tae Kwon Do organization because […]"
                            },
                            {
                                "example_id": "dba50633-d5cf-4270-b6e0-0e2690a43819",
                                "sense_id": "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c",
                                "text": "The International Olympic Committee (IOC) recognizes WTF at its 83rd […]"
                            },
                            {
                                "example_id": "8b5c6387-c095-4c9a-aa47-d71a656dd4e1",
                                "sense_id": "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c",
                                "text": "The Secretariat of the World Taekwondo Federation (WTF) is located in Seoul, South Korea, in a beautiful edifice […]"
                            },
                            {
                                "example_id": "b43adc8b-3c98-4a91-a45a-2f43601f930b",
                                "sense_id": "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c",
                                "text": "The WTF secretary general, Hoss Rafaty, told insidethegames that the governing body would look to market itself as World Taekwondo for business and commercial purposes, although there are no current plans to officially change the organisation’s name."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "1f1c2419-bf9a-4b6c-b39a-a80ce3aa7372",
                        "source_entry_id": "e3b06b91-d439-3195-b902-ffd67b17bbeb",
                        "source_sense_ids": [
                            "18d7c2ac-87b7-3cfe-a630-c6d57b95a68c"
                        ],
