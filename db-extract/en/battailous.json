                        "examples": [
                            {
                                "example_id": "07963a47-4a27-48a6-927b-40ce765a60d0",
                                "sense_id": "be69cf6c-2bd3-3e75-b71c-c508334631f0",
                                "text": "He started vp, and did him selfe prepaire, / In sun-bright armes, and battailous array: / For with that Pagan proud he combat will that day."
                            },
                            {
                                "example_id": "cfa745f1-4b5a-49db-99b1-b332d9b1ef30",
                                "sense_id": "be69cf6c-2bd3-3e75-b71c-c508334631f0",
                                "text": "Lie! — but begone all ceremonious points\nOf honour battailous. I could not turn\nMy wrath against thee for the orbed world."
                            }
                        ]
                    }
