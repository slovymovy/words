                            },
                            {
                                "target_lang_word": "zmařit",
                                "target_lang_sense_clarification": "překazit plány"
                            },
                            {
                                "target_lang_word": "zarazit",
                                "target_lang_sense_clarification": "učinit konec něčemu"
                            },
                            {
