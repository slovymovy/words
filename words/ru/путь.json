    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0336033-0ede-3ff2-9ffb-1bc9547ea194",
                    "sense_definition": "Дорога или направление для передвижения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он находится в <w>пути</w> в Петербург.",
                            "target_lang_translations": {
                                "cs": "Je na <w>cestě</w> do Petrohradu."
                            }
                        },
                        {
                            "text": "Мы выбрали самый короткий <w>путь</w> до дома.",
                            "target_lang_translations": {
                                "cs": "Vybrali jsme nejkratší <w>cestu</w> domů."
                            }
                        }
                    ],
                    "synonyms": [
                        "доро́га",
                        "стезя́"
                    ],
                    "common_phrases": [
                        "короткий путь",
                        "обратный путь"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pás terénu určený k chůzi nebo jízdě, případně směr pohybu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cesta",
                                "target_lang_sense_clarification": "pás terénu určený k chůzi, jízdě"
                            },
                            {
                                "target_lang_word": "směr",
                                "target_lang_sense_clarification": "orientace pohybu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0e6d1cf-4fd0-3f56-b143-b5151cb4eb97",
                    "sense_definition": "Процесс перемещения из одного места в другое; поездка.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На следующее утро я собрался в <w>путь</w>.",
                            "target_lang_translations": {
                                "cs": "Příští ráno jsem se vydal na <w>cestu</w>."
                            }
                        },
                        {
                            "text": "Наш долгий <w>путь</w> наконец подошел к концу.",
                            "target_lang_translations": {
                                "cs": "Naše dlouhá <w>cesta</w> konečně skončila."
                            }
                        }
                    ],
                    "common_phrases": [
                        "собраться в путь"
                    ],
                    "target_lang_definitions": {
                        "cs": "Proces přemísťování z jednoho místa na druhé; výlet nebo putování."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cesta",
                                "target_lang_sense_clarification": "pohyb někoho někam"
                            },
                            {
                                "target_lang_word": "putování",
                                "target_lang_sense_clarification": "dlouhá nebo náročná cesta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5483cbac-ab6d-3f42-97a2-454865ab1544",
                    "sense_definition": "Железнодорожная колея, предназначенная для движения поездов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "транспорт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд отправляется с третьего <w>пути</w>.",
                            "target_lang_translations": {
                                "cs": "Vlak odjíždí ze třetí <w>koleje</w>."
                            }
                        },
                        {
                            "text": "Рабочие ремонтируют железнодорожные <w>пути</w>.",
                            "target_lang_translations": {
                                "cs": "Dělníci opravují železniční <w>koleje</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "железнодорожный путь"
                    ],
                    "target_lang_definitions": {
                        "cs": "Železniční kolej určená pro provoz vlaků."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kolej",
                                "target_lang_sense_clarification": "železniční trať nebo její část"
                            },
                            {
                                "target_lang_word": "nástupiště",
                                "target_lang_sense_clarification": "v kontextu odjezdu vlaku z určitého místa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57bd044-c477-3ad7-8b48-07ab1da2f42b",
                    "sense_definition": "Возможность достижения цели или развития.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "абстрактное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Упорный труд открывает <w>путь</w> к успеху.",
                            "target_lang_translations": {
                                "cs": "Usilovná práce otevírá <w>cestu</w> k úspěchu."
                            }
                        },
                        {
                            "text": "Они пытаются проложить <w>путь</w> к взаимопониманию.",
                            "target_lang_translations": {
                                "cs": "Snaží se najít <w>cestu</w> k vzájemnému porozumění."
                            }
                        }
                    ],
                    "common_phrases": [
                        "путь к успеху"
                    ],
                    "target_lang_definitions": {
                        "cs": "Možnost dosažení cíle, způsob konání nebo postup."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cesta",
                                "target_lang_sense_clarification": "způsob konání, postup"
                            },
                            {
                                "target_lang_word": "způsob",
                                "target_lang_sense_clarification": "metoda nebo postup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30fe6e2e-297d-38e0-a9ed-453009dfd486",
                    "sense_definition": "Адрес расположения файла или папки в компьютерной системе.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "технологии",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скопируйте полный <w>путь</w> к файлу в настройки.",
                            "target_lang_translations": {
                                "cs": "Zkopírujte úplnou <w>cestu</w> k souboru do nastavení."
                            }
                        },
                        {
                            "text": "Система не может найти указанный <w>путь</w>.",
                            "target_lang_translations": {
                                "cs": "Systém nemůže najít zadanou <w>cestu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "путь к файлу",
                        "имя файла"
                    ],
                    "common_phrases": [
                        "полный путь"
                    ],
                    "target_lang_definitions": {
                        "cs": "Řetězec znaků určující umístění souboru nebo složky v počítačovém systému."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "cesta",
                                "target_lang_sense_clarification": "umístění souboru v systému"
                            }
                        ]
                    }
                }
            ]
        }
