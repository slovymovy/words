                                            {
                                                "example_id": "fdcd68a0-a457-4599-a515-56f3221b672e",
                                                "sense_id": "2b1e93c8-36da-346e-be72-9a4f368fc2ce",
                                                "text": "In unserer Stadt gibt es ein Wohnheim für heimatlose Flüchtlinge."
