                    "semantic_group_id": "offspring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У моих друзей двое <w>детей</w> — сын и дочь.",
                            "target_lang_translations": {
                                "en": "My friends have two <w>children</w> — a son and a daughter.",
                                "zh": "我的朋友有两个<w>孩子</w>，一儿一女。",
                                "nl": "Mijn vrienden hebben twee <w>kinderen</w> — een zoon en een dochter.",
                                "pl": "Moi przyjaciele mają dwoje <w>dzieci</w> — syna i córkę.",
                                "de": "Meine Freunde haben zwei <w>Kinder</w> – einen Sohn und eine Tochter.",
                                "fr": "Mes amis ont deux <w>enfants</w> : un fils et une fille.",
                                "it": "I miei amici hanno due <w>figli</w>: un maschio e una femmina.",
                                "cs": "Moji přátelé mají dvě <w>děti</w> — syna a dceru.",
                                "tr": "Arkadaşlarımın iki <w>çocuğu</w> var; bir oğlan ve bir kız.",
                                "es": "Mis amigos tienen dos <w>hijos</w>: un niño y una niña."
                            }
                        },
                        {
                            "text": "Взрослые <w>дети</w> должны заботиться о своих родителях.",
                            "target_lang_translations": {
                                "en": "Adult <w>children</w> should take care of their parents.",
                                "zh": "成年的<w>子女</w>应该照顾自己的父母。",
                                "nl": "Volwassen <w>kinderen</w> moeten voor hun ouders zorgen.",
                                "pl": "Dorosłe <w>dzieci</w> powinny dbać o swoich rodziców.",
                                "de": "Erwachsene <w>Kinder</w> sollten sich um ihre Eltern kümmern.",
                                "fr": "Les <w>enfants</w> adultes doivent prendre soin de leurs parents.",
                                "it": "I <w>figli</w> adulti dovrebbero prendersi cura dei propri genitori.",
                                "cs": "Dospělé <w>děti</w> by se měly starat o své rodiče.",
                                "tr": "Yetişkin <w>evlatlar</w> ebeveynlerine bakmalıdır.",
                                "es": "Los <w>hijos</w> adultos deben cuidar de sus padres."
                            }
