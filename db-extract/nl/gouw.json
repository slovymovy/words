                "translations": [
                    {
                        "translation_id": "b16f7be4-2927-4710-8121-6f68cfd455ef",
                        "source_entry_id": "d342eb45-fd09-3c8c-9a5b-90ad8eb11a61",
                        "source_sense_id": "1266477b-15b7-3c36-a826-fc1bd99b7857",
                        "source_sense_description": "district, gewest, provincie",
                        "target_lang_word": "Gau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3bb0ed-6790-30e1-99b3-b5a6536a2de6",
                                        "entry_id": "e1e25b06-01c0-378b-9b9b-380aa0500144",
                                        "glosses": [
                                            "Landschaft am Wasser"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25237f9a-2df1-495a-aff2-c5cfb72bd8f6",
                                                "sense_id": "7a3bb0ed-6790-30e1-99b3-b5a6536a2de6",
                                                "text": "Gaue sind oft nach Flüssen, Himmelsrichtungen oder auch nach alten (Römer-)Städten benannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e44bee76-543f-3aaf-a8ee-52757a35c6c0",
                                        "entry_id": "e1e25b06-01c0-378b-9b9b-380aa0500144",
                                        "glosses": [
                                            "Unterabteilung des Stammes"
                                        ],
                                        "tags": [
                                            "historisch bei Germanen und Kelten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a5165e-7b11-4c73-8a93-10c869c8b435",
                                                "sense_id": "e44bee76-543f-3aaf-a8ee-52757a35c6c0",
                                                "text": "„Der Gau der Germanen und Gallier ist militärisch und politisch autonom; ob auch bei königlichen Stämmen, muss dahingestellt bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "936fbde3-f428-32ff-a01a-90bab56a6571",
                                        "entry_id": "e1e25b06-01c0-378b-9b9b-380aa0500144",
                                        "glosses": [
                                            "Grafschaft des Fränkischen Reiches (die meisten waren deckungsgleich mit den alten germanischen Gauen)"
                                        ],
                                        "tags": [
                                            "historisch im fränkischen Reich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e88b5d-8b53-43f5-9798-226617f915f5",
                                                "sense_id": "936fbde3-f428-32ff-a01a-90bab56a6571",
                                                "text": "„Dem Völkerschaftsverband entspricht im fränkischen Reich der Gau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8baf59ae-5e79-3dcc-b77e-8449ffe2a3c7",
                                        "entry_id": "e1e25b06-01c0-378b-9b9b-380aa0500144",
                                        "glosses": [
                                            "Gebietseinheit innerhalb der Gliederung der NSDAP"
                                        ],
                                        "tags": [
                                            "historisch unter dem Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a9986b-1e68-4df5-ba56-d35214caefac",
                                                "sense_id": "8baf59ae-5e79-3dcc-b77e-8449ffe2a3c7",
                                                "text": "„Durch die Fusion der Gaue München und Oberbayern am 15. November 1930 erhielt der Gau, der weiterhin unter Wagners Leitung blieb, seine bis zur »Machtergreifung« gültige Gestalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3aa0bf88-7987-3744-b12e-2a289cc4d611",
                                        "entry_id": "e1e25b06-01c0-378b-9b9b-380aa0500144",
                                        "glosses": [
                                            "regionale Untergliederung eines Vereines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72767251-ef5c-4a7f-b214-04c9ede6ff54",
                                                "sense_id": "3aa0bf88-7987-3744-b12e-2a289cc4d611",
                                                "text": "„Durch die Neueinteilung verringerte sich die Zahl der Gaue von ehemals 29 auf 21.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
