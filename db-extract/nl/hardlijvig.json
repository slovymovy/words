                                "target_senses": [
                                    {
                                        "sense_id": "0c94208c-cd97-3c8d-8534-b7d7e517f1a5",
                                        "entry_id": "ced3a56c-b4d3-31a6-b934-d1bf207a3e5c",
                                        "glosses": [
                                            "Unable to defecate; costive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93099e3b-a4c1-3ef5-a762-952557f53ff7",
                                        "entry_id": "ced3a56c-b4d3-31a6-b934-d1bf207a3e5c",
                                        "glosses": [
                                            "Failing to make a point or reach a conclusion; stifled."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b49c1b1-947b-4a73-8ce8-2f725af426bc",
                                                "sense_id": "93099e3b-a4c1-3ef5-a762-952557f53ff7",
                                                "text": "But there is no place for grand gestures but there's a basic contempt for women in this puny, constipated drama."
                                            },
                                            {
                                                "example_id": "9c33ba7c-d8e0-4641-9119-30b7d9b528cd",
                                                "sense_id": "93099e3b-a4c1-3ef5-a762-952557f53ff7",
                                                "text": "Currently, the way we help people die (and sometimes help them get through the weeks leading up to death) is to stultify or intoxicate them with opiates so that they can't think or feel. They may be pain-free but their body is constipated, their brain is numbed and they often don't have the ability to speak cogently before they die."
                                            }
                                        ]
                                    }
