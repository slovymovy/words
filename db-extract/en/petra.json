                    {
                        "translation_id": "1486413d-ac58-4f26-bf75-c0c646614a0f",
                        "source_entry_id": "ecec1198-b748-3068-af52-54ce580d721e",
                        "source_sense_id": "7e446e37-3d85-3d02-8297-79e81d93ad2c",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Petra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                        "entry_id": "6ed76c5c-33ef-35bd-9c3e-f946a8d812c6",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db9c4b3-5e28-4196-8ac1-a92998dcb5e2",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "„Sie zeigte diese Briefe Solveig, und auch Solveig schien von allen Jungen der Provinz begehrt zu werden, denn auch sie besaß Stapel von Briefen, die sie Petra zu lesen gab.“"
                                            },
                                            {
                                                "example_id": "0c9d6736-a9fb-4ecb-ae02-b984c6691694",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "Petra singt im Chor."
                                            },
                                            {
                                                "example_id": "a50295d7-1689-4e57-a197-c4ed7443ea4c",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "Petra und Jan haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "36ff17f7-e4f7-4883-9c74-0ee3a438d416",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "Petra spielt gern."
                                            },
                                            {
                                                "example_id": "d8118087-2910-4b06-b431-348f5e25698b",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "Petra Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "00a71be2-f08d-45c2-b0fb-768988b15a5d",
                                                "sense_id": "ff216ad1-a782-3252-8bbb-88966563b4e2",
                                                "text": "Kennen sie den Vornamen Petra?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Petra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                        "entry_id": "0e04fff6-c97c-39b8-886c-90b71ae6f8f6",
                                        "glosses": [
                                            "im Südwesten Jordaniens gelegene antike Felsenstadt und einstige Hauptstadt des Nabatäer-Reiches, die seit 1985 zum UNESCO-Welterbe gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a0761de-7fcf-482c-a790-07dd88c8bb5b",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Sechs Jahre später entdeckte Burckhardt als Vertreter der »British African Association« das zauberhafte Petra für die westliche Forschung.“"
                                            },
                                            {
                                                "example_id": "1c1ac12d-ff7c-42d9-92a0-ebed139ddd94",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Das jahrhundertelange vergebliche Anrennen der Römer gegen Petra hatte durch eine List Erfolg. Römische Späher wurden als Kaufleute in die schwer zugängliche Hauptstadt der Nabatäer eingeschleust und es gelang ihnen, die einzige Schwachstelle Petras auszukundschaften: die vielgerühmte Wasserversorgung. Die Römer zerstörten das technisch ausgeklügelte Leitungssystem, übernahmen Petra, machten die Stadt tributpflichtig und wandelten das gesamte Königreich im März des Jahres 106 n. Chr. in die römische Provinz Arabia Petraea um. Die Forderungen waren so hoch, daß die Nabatäer schließlich Petra aufgaben.“"
                                            },
                                            {
                                                "example_id": "77976a83-12e4-44e7-bfab-412e8ffb4125",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Identische Tempelmuster, das wußte er, finden sich in Petra, der einstigen Hauptstadt des edomitischen Reiches im heutigen Jordanien.“"
                                            },
                                            {
                                                "example_id": "a7086621-483d-408f-a5d0-0e447d795b8f",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Der wohlriechende Harz der gedrungenen Weihrauchbäume war hoch begehrt und machte die Nabatäer zu reichen Leuten, wie Petra zeigt oder ihre grandiose Nekropole in Saudi-Arabien.“"
                                            },
                                            {
                                                "example_id": "d555be3c-6671-4ace-940c-9cd59916f251",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Ruinen von Dörfern der Nabatäer um die christliche Zeitenwende sind ebenfalls erhalten geblieben und zeigen die Route der alten Karawanenstraße von Petra, im heutigen Jordanien gelegen, und dem nahe gelegenen Avdat auf.“"
                                            },
                                            {
                                                "example_id": "7e136005-d434-42cd-b415-abe02f3fe0d8",
                                                "sense_id": "45f4aa26-b6a4-396a-8fbb-68aca47fe5a8",
                                                "text": "„Stationen waren Madaba, die Stadt der Mosaiken, die Jordanauen, an deren Ende man die Stelle erreicht, an der Johannes der Täufer Jesus getauft haben soll, der Berg Nebo, von wo aus Moses ins Gelobte Land geblickt haben soll, Wadi Bin Hammad, eine atemberaubende Schlucht, das Naturschutzreservat von Dana, weiter durch das Land der Rut nach Petra, die rätselhafte rosarote Felsenstadt der Nabatäer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8223dc3-aad7-4afd-8e48-a20dc94a31c7",
                        "source_entry_id": "ecec1198-b748-3068-af52-54ce580d721e",
