                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c77c0a7c-5803-35c1-af05-21f0135c47d2",
                                        "entry_id": "b6fc1102-032b-3823-a181-864895ab975b",
                                        "glosses": [
                                            "To be converted into software by compilation, usually with minimal human intervention."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb771650-355c-46c0-9312-d98e0e5f8207",
                                                "sense_id": "c77c0a7c-5803-35c1-af05-21f0135c47d2",
                                                "text": "This code won’t build any more. Have you made any changes?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "build",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdc740b8-9646-30c6-bdcf-a314f3a19e52",
                                        "entry_id": "78fbad0b-224f-3675-b1b1-af7a699eef2a",
                                        "glosses": [
                                            "The physique of a human or animal body, or other object; constitution or structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01cf11b1-4704-4c6b-96bb-031e3493871c",
                                                "sense_id": "fdc740b8-9646-30c6-bdcf-a314f3a19e52",
                                                "text": "Rugby players are of sturdy build."
                                            },
                                            {
                                                "example_id": "5e2448fd-d133-446c-a337-6ebfb5019157",
                                                "sense_id": "fdc740b8-9646-30c6-bdcf-a314f3a19e52",
                                                "text": "According to the prevailing adolescent criteria Roger was not good looking. He had no build and did not give off very assertive, let alone aggressive vibrations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a390c8-aaff-31df-81e2-aedb3f9a863b",
                                        "entry_id": "78fbad0b-224f-3675-b1b1-af7a699eef2a",
                                        "glosses": [
                                            "Any of various versions of a software product as it is being developed for release to users."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede9b498-d72d-45f4-b96d-49f1b6378ba7",
                                                "sense_id": "50a390c8-aaff-31df-81e2-aedb3f9a863b",
                                                "text": "The computer company has introduced a new prototype build to beta testers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad5f0b97-e6c0-3324-9364-48482ac7eedd",
                                        "entry_id": "78fbad0b-224f-3675-b1b1-af7a699eef2a",
                                        "glosses": [
                                            "The process or period of constructing a physical object."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c9eed4-8d87-4a93-acf2-63c1cc196dd9",
                                                "sense_id": "ad5f0b97-e6c0-3324-9364-48482ac7eedd",
                                                "text": "This new Lego set was a very nice build."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec3a455-94ba-3075-8f19-0221824ebfef",
                                        "entry_id": "78fbad0b-224f-3675-b1b1-af7a699eef2a",
                                        "glosses": [
                                            "A structure, such as a building, statue, pool or forest created by the player."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a600b68-7f2d-456e-8324-5042c2808a5f",
                                                "sense_id": "cec3a455-94ba-3075-8f19-0221824ebfef",
                                                "text": "I made a build that looked like the Parthenon in that game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becfaa4e-89ce-31e8-8522-a410a6bb33e9",
                                        "entry_id": "78fbad0b-224f-3675-b1b1-af7a699eef2a",
                                        "glosses": [
                                            "A configuration of a character's items or skills created by the player."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a43912b-ac76-4204-af0b-cccdbadceced",
                                                "sense_id": "becfaa4e-89ce-31e8-8522-a410a6bb33e9",
                                                "text": "I made a build centered around attack speed."
                                            },
                                            {
                                                "example_id": "2868863d-34fa-4f48-b248-48698459774c",
                                                "sense_id": "becfaa4e-89ce-31e8-8522-a410a6bb33e9",
                                                "text": "In fact, thousands of D&D players constantly debate the virtues of various character builds (combinations of race, class, feat, and spell choices) and share their efforts with each other in hundreds of message boards and mailing lists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
