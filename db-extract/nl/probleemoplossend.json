                        "glosses": [
                            "goed moeilijkheden kunnen oplossen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa29eec-145d-4353-a24f-bf74716f1702",
                                "sense_id": "7903aa16-6442-3a43-89c2-327cdb0844b7",
                                "text": ",,Banen die een hoog niveau van probleemoplossend vermogen, goede sociale vaardigheden en computerskills vragen. Denk aan elektrotechnische ingenieurs, ict-managers, managers van zorginstellingen, loopbaancoaches.\""
                            },
                            {
                                "example_id": "bc75813f-e33f-4f94-a875-34602b4eecfd",
                                "sense_id": "7903aa16-6442-3a43-89c2-327cdb0844b7",
                                "text": "Bij de hogescholen doen vooral Fontys, Saxion, Hogeschool Arnhem Nijmegen en Stenden het goed. \"Je leert hier probleemoplossend te werken. Dat is moderner dan bij ons en de vaardigheden die we leren zijn relevanter voor het vinden van een baan\", is de ervaring van de Britse Sophie Bray (21), die de Hogere Hotelschool doet bij Stenden Hogeschool."
                            }
                        ]
                    }
