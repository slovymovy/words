                    {
                        "sense_id": "82e9aaf9-589f-3086-a1c8-1e39dfc5868c",
                        "entry_id": "394d75a2-c6fb-3021-8189-4a0a7d8a1657",
                        "glosses": [
                            "Werkstatt, in der Geschütze (Kanonen) hergestellt werden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "16cf738b-35bc-4755-86ca-8a42446fee5e",
                                "sense_id": "82e9aaf9-589f-3086-a1c8-1e39dfc5868c",
                                "text": "„Die Bedeutung der Sevillaner Kanonengießerei für die spanische Rüstung lässt sich alleine an der Zahl der produzierten und an den „mayordomo de artillería“ abgelieferten Geschützen ermessen.“"
                            },
                            {
                                "example_id": "e7277dc1-e68d-4646-ba05-a6d2010a5077",
                                "sense_id": "82e9aaf9-589f-3086-a1c8-1e39dfc5868c",
                                "text": "„Bevor sie in die Zentren zur Herstellung von Scheidemünze und, später, in Kanonengießereien kamen, wurden die requirierten Glocken in Arsenalen gestapelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
