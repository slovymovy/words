                "senses": [
                    {
                        "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                        "entry_id": "5e423e52-a53d-3c96-8379-e92545ea01f0",
                        "glosses": [
                            "Workout für den gesamten Körper; Trainingsroutine/Übungseinheit, die den gesamten Körper beansprucht und mehrere Muskelgruppen gleichzeitig trainiert"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "8af5c36f-036e-48fb-9d03-e497ecc10ac6",
                                "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                                "text": "„Im Prinzip ist Zumba Fitness ein Ganzkörper-Workout.“"
                            },
                            {
                                "example_id": "8f3ac457-eb3e-4319-a9fb-a7672f91e823",
                                "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                                "text": "„Neben dem Ganzkörper-Workout stehen Ihnen auch weitere Optionen aus den Bereichen Cardio, Bauch, Muskelstraffung, Beckenboden und Entspannung zur Auswahl.“"
                            },
                            {
                                "example_id": "7c21146a-08b0-4459-bd2c-59a534a53d71",
                                "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                                "text": "„Somit absolvierst du ein effektives Ganzkörper-Workout egal, wo du gerade bist und trainierst stets ergonomisch und sicher.“"
                            },
                            {
                                "example_id": "f79c4484-947f-4b29-bc65-c08510f1d973",
                                "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                                "text": "„Der Suspension-Trainer bietet bereits alles, was du für ein effektives Ganzkörper-Workout brauchst.“"
                            },
                            {
                                "example_id": "4e0c5e14-0ca4-4335-a631-63c0f407f903",
                                "sense_id": "415a21dd-df81-3411-81f4-0bdea6f22233",
                                "text": "„Mit diesem Ganzkörper-Workout aktivieren wir unsere ganze Muskulatur, bringen den Puls auf Hochtouren, regen effektiv unsere Fettverbrennung an und verbessern die Körperstabilität, Haltung und Koordination.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
