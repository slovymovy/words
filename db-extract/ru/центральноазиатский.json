                        "translation_id": "428d63aa-986e-4d4d-968b-08024053941f",
                        "source_entry_id": "d065612d-70a3-3669-9224-056e72b0ae15",
                        "source_sense_id": "5c6ac185-7da0-3b56-92b3-a5acc68ab077",
                        "target_lang_word": "zentralasiatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zentralasiatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eeab2b3-7b68-373f-859a-18b69b310859",
                                        "entry_id": "6509b894-8aa3-3396-8fba-154b2ae39ba2",
                                        "glosses": [
                                            "die Region im Zentrum Asiens betreffend, zu ihr gehörend, aus ihr stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6cc040-2272-47c6-a38b-b612f9ff2d03",
                                                "sense_id": "8eeab2b3-7b68-373f-859a-18b69b310859",
                                                "text": "Na, kommst du drauf, welches zentralasiatische Gebirge ich meine?"
                                            },
                                            {
                                                "example_id": "58fb363c-ccc8-4e0e-ab98-8a32770ee5f0",
                                                "sense_id": "8eeab2b3-7b68-373f-859a-18b69b310859",
                                                "text": "„Der Gründer dieser Dynastie, Sebük Tin (977–997), ein türkischer Sklavenoffizier, hatte sich Ende des 10. Jahrhunderts vom zentralasiatischen Samanidenreich (874–999) losgesagt, um eine unabhängige Herrschaft zu gründen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
