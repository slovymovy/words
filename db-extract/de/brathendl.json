                        "entry_id": "7850b8b8-2c80-3512-a69d-7c7b3f598e10",
                        "glosses": [
                            "ein am Grill oder im Backofen gebratenes Huhn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1825ff5-c2a7-46b3-b036-a9b92f0b758d",
                                "sense_id": "ae503bb2-de2a-357a-902a-703ce5c90829",
                                "text": "Du backst heute Brathendl?"
                            },
                            {
                                "example_id": "f81e7d6e-fcba-417d-8cee-252db97a6e9d",
                                "sense_id": "ae503bb2-de2a-357a-902a-703ce5c90829",
                                "text": "„Wenn nämlich, wie in der Hühnermast üblich, zigtausende Tiere auf engstem Raum und binnen exakt 35 Tagen vom Küken zum Brathendl aufgepumpt werden, dann muss eben mit Medikamenteneinsatz vorgebeugt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
