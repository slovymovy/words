                                "target_senses": [
                                    {
                                        "sense_id": "8b06797a-7002-3005-a9c0-72ea36931b90",
                                        "entry_id": "2d5f5641-273a-3e81-acfb-7828652ef5bb",
                                        "glosses": [
                                            "těžký elektron"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fca7c40-c450-41b3-9fa8-e0738f39a290",
                                                "sense_id": "8b06797a-7002-3005-a9c0-72ea36931b90",
                                                "text": "Když vědci g-faktor mionů poprvé vyčíslili, vypadalo to, že je rovný přesně dvěma. Po čase ale vyšlo najevo, že jeho hodnota je o chlup vyšší. Vyšla 2,0032. Brzo se to podařilo vysvětlit. Když mion cestuje prostorem, čas od času vypustí foton, který hned zase pohltí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
