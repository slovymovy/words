                                "example_id": "19a8a834-5289-4db1-b11e-ef3b204e25f8",
                                "sense_id": "283dda51-f22c-3195-a761-c1f776d92670",
                                "text": "The Empire State Building and the old Altman's Department store are catercorner, at Fifth Avenue and East 34th Street, with the ESB at the southwest, and Altman's at the northeast."
                            },
                            {
                                "example_id": "055d4112-6a61-4856-b2d0-2d7d00035009",
                                "sense_id": "283dda51-f22c-3195-a761-c1f776d92670",
                                "text": "From my living room, I trained my binoculars on the redbrick monstrosity catercorner from me."
                            }
                        ]
                    },
                    {
                        "sense_id": "06a11e34-7323-33cd-bc82-282e052633a5",
                        "entry_id": "114f3507-129c-39b1-82bf-fc220196868c",
                        "glosses": [
                            "Uneven, not square, as mislaid stones or people with a limping gait."
                        ],
