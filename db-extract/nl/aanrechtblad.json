                        "form_id": "b19767b4-c904-48bf-aa56-3a6170ca7c2f",
                        "entry_id": "7e560585-32a5-3b37-973d-67d2b5a11c5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "aanrechtbladen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                        "entry_id": "7e560585-32a5-3b37-973d-67d2b5a11c5c",
                        "glosses": [
                            "werkblad van een keuken dat water-, hitte- en krasbestendig is en makkelijk schoon te maken is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16af972b-1167-4910-be5d-de8ac571457a",
                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                "text": "De keuken is niet groot: de met witte glasplaten afdekbare Smev-kookplaat en spoelbak nemen vrijwel het hele aanrecht in beslag. Een uitklapbare aanrechtverlenger biedt wat meer werkruimte, maar beperkt de doorstap naar buiten. Onder het aanrechtblad zijn drie grote treklades gemonteerd met soft-close."
                            },
                            {
                                "example_id": "9a21b951-81c9-4ad0-89aa-9c44491bd5ee",
                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                "text": "Rudolph is naar eigen zeggen het gelukkigst als hij aan het koken is. Daarom heeft de zitkamer in zijn woning in Hilversum plaats moeten maken voor een enorme keuken, met een aanrechtblad van ruim tien meter."
                            },
                            {
                                "example_id": "c7eeff6b-ce47-41da-acd3-b654636d28f0",
                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                "text": "Ik ga naar de keuken, leun tegen het aanrechtblad en adem een paar keer diep in en uit."
                            },
                            {
                                "example_id": "ed63cb8f-72a6-4847-ab6a-72007d5b1f97",
                                "sense_id": "4e80ae96-b1f1-3174-a360-82b717bd4506",
                                "text": "Vanuit mijn ooghoeken zie ik het halve aanrechtblad vol staan met vuile vaat."
                            }
                        ]
                    }
                ],
