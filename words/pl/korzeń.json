                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Korzeń</w> został wybrany na nowego prezesa naszej lokalnej spółdzielni.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Кожень</w> был избран новым председателем нашего местного кооператива."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem Marka <w>Korzenia</w> na zakupach w centrum handlowym.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил Марека <w>Коженя</w> за покупками в торговом центре."
                            }
                        }
                    ],
