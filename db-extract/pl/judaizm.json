                        "translation_id": "80893794-3684-4a1c-bda2-ccc5f4645c85",
                        "source_entry_id": "ab312f18-c1c2-3442-9ad7-9f7f32fdea99",
                        "source_sense_id": "5723619c-4c56-376f-8753-c29708473970",
