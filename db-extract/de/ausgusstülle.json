                "senses": [
                    {
                        "sense_id": "a20e6841-9f53-30fd-9d45-535e85bb6367",
                        "entry_id": "32715774-7979-345f-9f3c-d09cdf2ba168",
                        "glosses": [
                            "schnabelförmige Öffnung eines Gefäßes"
