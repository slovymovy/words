                "senses": [
                    {
                        "sense_id": "d56bf718-2de4-3375-96df-a15971247a3c",
                        "entry_id": "17625495-34c7-3e06-b579-5b3b98a96d36",
                        "glosses": [
                            "witte rotsen die bestaan uit kalksteen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ce9f9b5-a12e-4b3b-ab39-32d39d09b66b",
                                "sense_id": "d56bf718-2de4-3375-96df-a15971247a3c",
                                "text": "Een cruise met een traditionele Arabische 'dhow' is een goede manier om Khasab te ontdekken, ook wel 'het Noorwegen van Arabië' genoemd door haar fjord-achtige wateren, vissersdorpjes en kalkrotsen."
                            },
                            {
                                "example_id": "02f99f01-1fbb-49a8-a32a-63f24ac0d9f0",
                                "sense_id": "d56bf718-2de4-3375-96df-a15971247a3c",
                                "text": "Door deze kloof baant de 2860 km lange rivier, die in het Zwarte Woud ontspringt, zich een weg tussen de grillige kalkrotsen. Dit is nog maar het begin van een super-de-luxe riviercruise over de Donau, waar we voortdurend worden geconfronteerd met een combinatie van boeiende historie, vrolijke muziek en drank, en verbluffende vergezichten."
                            },
                            {
                                "example_id": "7979a4c3-8c13-447b-950f-2066dc8cee2a",
                                "sense_id": "d56bf718-2de4-3375-96df-a15971247a3c",
                                "text": "Wie bovenop een rots staat, waant zich er veilig. Maar schijn bedriegt soms. In het Franse Saint-Jouin-Bruneval bijvoorbeeld, waar binnen een paar seconden een complete kalkrots naar beneden kwam."
                            }
                        ]
                    }
