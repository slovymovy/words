                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4bf60bf-eedc-465e-9dac-306582a94f2d",
                                                "sense_id": "2451806f-f369-31fd-aea6-2520446ca7d4",
                                                "text": "Take more men, and scout him round."
                                            }
