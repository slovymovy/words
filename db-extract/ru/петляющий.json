                        "examples": [
                            {
                                "example_id": "98afc77b-2cc0-4c28-a94f-edea1b8a8ff9",
                                "sense_id": "917686d2-e685-3ff6-a57b-0aa2a5d5790f",
                                "text": "Мы спустились в ложбину по крутой тропе, терпеливо петляющей между скалами."
                            },
                            {
                                "example_id": "289d3252-ab71-45e9-aaf0-13a028508454",
                                "sense_id": "917686d2-e685-3ff6-a57b-0aa2a5d5790f",
                                "text": "Повернув обратно, мы в зарослях ольхи наткнулись на затейливо петляющие звериные и птичьи следы."
                            }
                        ]
