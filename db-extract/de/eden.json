                            {
                                "example_id": "43f3d781-fdbc-4e8f-9332-89d7aecd796e",
                                "sense_id": "bac93c82-bec5-3974-ac38-89a8a28d86e2",
                                "text": "„Hier drinnen unter den schattenden Säulen war für uns, die wir aus der brennenden Sonne draußen kamen, ein wahres Eden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
