{
    "word_family": [
        "scherven",
        "granaatscherf",
        "potscherf"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4251f4da-1d69-338e-bd8c-1507daaa0814",
                    "sense_definition": "een onregelmatig gevormd stuk van een gebroken voorwerp, zoals glas of aardewerk",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je niet in een <w>scherf</w> van het gebroken glas stapt.",
                            "target_lang_translations": {
                                "en": "Be careful not to step on a <w>shard</w> of the broken glass."
                            }
                        },
                        {
                            "text": "Men zegt vaak dat <w>scherven</w> geluk brengen nadat er een bord valt.",
                            "target_lang_translations": {
                                "en": "It is often said that <w>shards</w> bring good luck after a plate falls."
                            }
                        }
                    ],
                    "synonyms": [
                        "diggel",
                        "splinter"
                    ],
                    "common_phrases": [
                        "scherven brengen geluk",
                        "scherp als een scherf"
                    ],
                    "target_lang_definitions": {
                        "en": "an irregularly shaped piece of a broken object, such as glass or pottery"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shard",
                                "target_lang_sense_clarification": "a sharp piece of glass or pottery"
                            },
                            {
                                "target_lang_word": "fragment",
                                "target_lang_sense_clarification": "a small part broken off from something"
                            },
                            {
                                "target_lang_word": "sherd",
                                "target_lang_sense_clarification": "a piece of broken pottery, especially in archaeology"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40f4ab05-fa5e-38ca-b37e-5af138eddc0e",
                    "sense_definition": "een metalen fragment van een ontplofte granaat of bom",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat werd geraakt door een vliegende <w>scherf</w> tijdens de explosie.",
                            "target_lang_translations": {
                                "en": "The soldier was hit by a flying piece of <w>shrapnel</w> during the explosion."
                            }
                        },
                        {
                            "text": "De chirurg verwijderde voorzichtig een metalen <w>scherf</w> uit de wond.",
                            "target_lang_translations": {
                                "en": "The surgeon carefully removed a metal <w>fragment</w> from the wound."
                            }
                        }
                    ],
                    "synonyms": [
                        "granaatscherf"
                    ],
                    "target_lang_definitions": {
                        "en": "a metal fragment from an exploded grenade or bomb"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrapnel",
                                "target_lang_sense_clarification": "fragments of a bomb or shell"
                            },
                            {
                                "target_lang_word": "shell splinter",
                                "target_lang_sense_clarification": "a fragment of an exploded shell"
                            },
                            {
                                "target_lang_word": "fragment",
                                "target_lang_sense_clarification": "a piece of metal from an explosion"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0b4a9e0-103d-3095-965f-39845b809e75",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>scherven</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>scherf</w> het materiaal in kleine stukjes voor het mozaïek.",
                            "target_lang_translations": {
                                "en": "I <w>break</w> the material into small pieces for the mosaic."
                            }
                        },
                        {
                            "text": "Wanneer ik dit aardewerk <w>scherf</w>, doe ik dat heel voorzichtig.",
                            "target_lang_translations": {
                                "en": "When I <w>shatter</w> this pottery, I do it very carefully."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of the verb 'scherven' (to break into shards)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break into shards",
                                "target_lang_sense_clarification": "to shatter into pieces"
                            },
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "to break into many small pieces"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}