                "senses": [
                    {
                        "sense_id": "3dce5fba-00ab-3ee9-bfbe-adcc346560e6",
                        "entry_id": "10afd93c-8d54-34e5-9f14-6b6c8cc74a39",
                        "glosses": [
                            "Eigenschaft, eine geografische Lage (als Insel) zu haben, die eine räumliche Trennung von anderen Gebieten mit sich bringt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "ac73b622-756c-4e87-bd83-f7cf491044fd",
                                "sense_id": "3dce5fba-00ab-3ee9-bfbe-adcc346560e6",
                                "text": "„Das Abgegrenztsein vom Rest der Welt und das Gefühl der Exklusivität heißt Insularität (vgl. Bonnemaison 1991). Insularität ist jedoch nicht zwingend an die naturgeographische Existenz der Insel gebunden.“"
                            },
                            {
                                "example_id": "b8583be7-f029-43d1-bbe6-11a63594ca6d",
                                "sense_id": "3dce5fba-00ab-3ee9-bfbe-adcc346560e6",
                                "text": "„Die ursprüngliche Stammesverwandtschaft des englischen Volkes mit dem deutschen wurde durch die Insularität aller gemeinsamen Wesenszüge entkleidet. Durch die Insularität blieb England von den Kriegsstürmen verschont.“"
                            },
                            {
                                "example_id": "0bb5cbfc-2c43-47de-b827-c2f398f7ce39",
                                "sense_id": "3dce5fba-00ab-3ee9-bfbe-adcc346560e6",
                                "text": "„Bei aller Isolierung und Insularität jedoch liegt die Insel Felsenburg keineswegs außerhalb eines historischen Raums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
