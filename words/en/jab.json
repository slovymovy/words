{
    "word_family": [
        "jabber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61073633-dfcb-3e8d-a758-49c4a194294d",
                    "sense_definition": "A medical hypodermic injection, such as a vaccination or inoculation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_injection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told me that getting a flu <w>jab</w> every autumn is the best way to stay healthy.",
                            "target_lang_translations": {
                                "de": "Der Arzt sagte mir, dass eine Grippe<w>impfung</w> jeden Herbst der beste Weg ist, um gesund zu bleiben.",
                                "zh": "医生告诉我，每年秋天打一次流感<w>疫苗</w>是保持健康的最好方法。"
                            }
                        },
                        {
                            "text": "Many children are afraid of needles, but they feel much better after receiving their routine <w>jabs</w>.",
                            "target_lang_translations": {
                                "de": "Viele Kinder haben Angst vor Nadeln, aber sie fühlen sich viel besser, nachdem sie ihre Routine<w>impfungen</w> erhalten haben.",
                                "zh": "许多孩子怕针，但在完成常规<w>注射</w>后，他们会感觉好多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flu jab",
                        "get a jab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine medizinische Injektion unter die Haut, wie eine Impfung.",
                        "zh": "一种医疗注射，例如疫苗接种或预防接种。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Piks",
                                "target_lang_sense_clarification": "umgangssprachlich für eine Spritze oder Impfung"
                            },
                            {
                                "target_lang_word": "Injektion",
                                "target_lang_sense_clarification": "medizinische Einspritzung"
                            },
                            {
                                "target_lang_word": "Impfung",
                                "target_lang_sense_clarification": "Schutzimpfung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注射",
                                "target_lang_sense_clarification": "医疗上的液体注入"
                            },
                            {
                                "target_lang_word": "疫苗接种",
                                "target_lang_sense_clarification": "预防疾病的接种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "735496f7-b51a-3772-96ee-53c5fe6ff986",
                    "sense_definition": "A quick stab, poke, or thrusting motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poke_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>jab</w> of his finger, he pointed out the mistake on the map.",
                            "target_lang_translations": {
                                "de": "Mit einem schnellen <w>Stupser</w> seines Fingers zeigte er auf den Fehler auf der Karte.",
                                "zh": "他用手指快速<w>戳</w>了一下，指出了地图上的错误。"
                            }
                        },
                        {
                            "text": "She gave him a sharp <w>jab</w> in the ribs with her elbow to make him stop talking.",
                            "target_lang_translations": {
                                "de": "Sie verpasste ihm mit ihrem Ellbogen einen kräftigen <w>Stoß</w> in die Rippen, damit er aufhörte zu reden.",
                                "zh": "她用手肘用力<w>捅</w>了他的肋骨一下，让他别再说话了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stab",
                        "thrust"
                    ],
                    "common_phrases": [
                        "sharp jab",
                        "jab in the ribs"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schneller Stoß, Stich oder Stupser.",
                        "zh": "快速的戳、捅或刺的动作。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stupser",
                                "target_lang_sense_clarification": "leichtes Anstoßen"
                            },
                            {
                                "target_lang_word": "Stich",
                                "target_lang_sense_clarification": "schnelle, stechende Bewegung"
                            },
                            {
                                "target_lang_word": "Stoß",
                                "target_lang_sense_clarification": "plötzliche Vorwärtsbewegung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用手指或尖物快速触碰"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用力向内刺入或触碰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63803335-8e8e-379b-b44e-3c28f680519f",
                    "sense_definition": "A short, straight punch in boxing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boxing_punch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer kept his opponent at a distance by using a quick, repetitive left <w>jab</w>.",
                            "target_lang_translations": {
                                "de": "Der Boxer hielt seinen Gegner mit einer schnellen, wiederholten linken <w>Geraden</w> auf Distanz.",
                                "zh": "拳击手通过快速且重复的左<w>刺拳</w>将对手保持在距离之外。"
                            }
                        },
                        {
                            "text": "He landed a solid <w>jab</w> to the chin, winning the round in the final seconds.",
                            "target_lang_translations": {
                                "de": "Er landete eine solide <w>Gerade</w> am Kinn und gewann die Runde in den letzten Sekunden.",
                                "zh": "他精准地打出一记<w>刺拳</w>击中对方下巴，在最后几秒赢得了这一回合。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "left jab",
                        "quick jab"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kurzer, gerader Schlag beim Boxen.",
                        "zh": "拳击中一种短促的直拳。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gerade",
                                "target_lang_sense_clarification": "gerader Schlag im Boxsport"
                            },
                            {
                                "target_lang_word": "Jab",
                                "target_lang_sense_clarification": "Führhandstoß im Boxen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺拳",
                                "target_lang_sense_clarification": "拳击中的快速直拳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f12b75f-0efc-3c04-8486-26b3455d62f6",
                    "sense_definition": "A mild verbal insult or mocking remark.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His comment about her cooking was just a playful <w>jab</w>, but she still felt hurt.",
                            "target_lang_translations": {
                                "de": "Sein Kommentar über ihr Essen war nur eine spielerische <w>Stichelei</w>, aber sie fühlte sich trotzdem verletzt.",
                                "zh": "他关于她厨艺的评论只是开玩笑的<w>挖苦</w>，但她还是感到受伤。"
                            }
                        },
                        {
                            "text": "The politicians exchanged clever <w>jabs</w> during the televised debate.",
                            "target_lang_translations": {
                                "de": "Die Politiker tauschten während der Fernsehdebatte geschickte <w>Seitenhiebe</w> aus.",
                                "zh": "政客们在电视辩论中进行了巧妙的言语<w>讥讽</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "playful jab",
                        "verbal jab"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine leichte verbale Beleidigung oder spöttische Bemerkung.",
                        "zh": "轻微的言语侮辱或嘲讽。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stichelei",
                                "target_lang_sense_clarification": "indirekte, leicht spöttische Kritik"
                            },
                            {
                                "target_lang_word": "Seitenhieb",
                                "target_lang_sense_clarification": "indirekte, spöttische Bemerkung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖苦",
                                "target_lang_sense_clarification": "带有讽刺意味的言语"
                            },
                            {
                                "target_lang_word": "讥讽",
                                "target_lang_sense_clarification": "嘲笑和讽刺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a5dba522-2c4b-3bab-b7b1-d9b58c3dad51",
                    "sense_definition": "To poke or thrust something abruptly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poke_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>jab</w> your fork into the non-stick pan while cooking.",
                            "target_lang_translations": {
                                "de": "Achte darauf, beim Kochen nicht mit der Gabel in die beschichtete Pfanne zu <w>stechen</w>.",
                                "zh": "做饭时小心别用叉子<w>戳</w>不粘锅。"
                            }
                        },
                        {
                            "text": "He tried to <w>jab</w> the key into the lock in the dark, but kept missing.",
                            "target_lang_translations": {
                                "de": "Er versuchte im Dunkeln, den Schlüssel in das Schloss zu <w>stoßen</w>, verfehlte es aber immer wieder.",
                                "zh": "他在黑暗中试图把钥匙<w>捅</w>进锁孔，但总是对不准。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stab",
                        "thrust",
                        "stick"
                    ],
                    "common_phrases": [
                        "jab into"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas abrupt stoßen, stechen oder hineinrammen.",
                        "zh": "突然地戳、捅或刺某物。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stoßen",
                                "target_lang_sense_clarification": "abrupt hineindrücken oder rammen"
                            },
                            {
                                "target_lang_word": "stechen",
                                "target_lang_sense_clarification": "mit einem spitzen Gegenstand eindringen"
                            },
                            {
                                "target_lang_word": "piksen",
                                "target_lang_sense_clarification": "leicht stechen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用尖物或手指刺入"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用力向内推或刺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73933da2-7853-3dd9-b2af-477bd545076e",
                    "sense_definition": "To deliver a quick punch, especially in boxing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boxing_punch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer instructed the fighter to <w>jab</w> with his left hand to set up the power punch.",
                            "target_lang_translations": {
                                "de": "Der Trainer wies den Kämpfer an, mit der linken Hand <w>eine Gerade zu schlagen</w>, um den harten Schlag vorzubereiten.",
                                "zh": "教练指导选手用左手<w>打刺拳</w>，为重拳做铺垫。"
                            }
                        },
                        {
                            "text": "He managed to <w>jab</w> his opponent repeatedly, wearing down his defense.",
                            "target_lang_translations": {
                                "de": "Es gelang ihm, seinen Gegner wiederholt mit <w>Geraden zu treffen</w> und so seine Verteidigung zu schwächen.",
                                "zh": "他成功地不断向对手<w>打刺拳</w>，消耗了对方的防御。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jab and move"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen schnellen, geraden Schlag ausführen, besonders beim Boxen.",
                        "zh": "打出快速的拳，尤指拳击中。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "eine Gerade schlagen",
                                "target_lang_sense_clarification": "beim Boxen gerade zuschlagen"
                            },
                            {
                                "target_lang_word": "jaben",
                                "target_lang_sense_clarification": "im Boxsport mit der Führhand schlagen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打刺拳",
                                "target_lang_sense_clarification": "拳击动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa8c81a3-799f-3e3f-a550-6fcaf72b6ad1",
                    "sense_definition": "To make fun of or mock someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedians love to <w>jab</w> at celebrities during their late-night shows.",
                            "target_lang_translations": {
                                "de": "Die Komiker lieben es, in ihren Late-Night-Shows über Prominente zu <w>sticheln</w>.",
                                "zh": "喜剧演员们喜欢在深夜秀中<w>挖苦</w>名人。"
                            }
                        },
                        {
                            "text": "He was constantly <w>jabbing</w> at his brother's fashion choices, much to their mother's annoyance.",
                            "target_lang_translations": {
                                "de": "Er <w>stichelte</w> ständig gegen den Modegeschmack seines Bruders, sehr zum Ärger ihrer Mutter.",
                                "zh": "他总是<w>讥讽</w>他兄弟的穿衣风格，这让他们的母亲非常恼火。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jab at"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich über jemanden lustig machen oder ihn necken.",
                        "zh": "取笑或嘲弄某人。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sticheln",
                                "target_lang_sense_clarification": "spöttische Bemerkungen machen"
                            },
                            {
                                "target_lang_word": "necken",
                                "target_lang_sense_clarification": "jemanden spielerisch ärgern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖苦",
                                "target_lang_sense_clarification": "言语上的嘲讽"
                            },
                            {
                                "target_lang_word": "讥讽",
                                "target_lang_sense_clarification": "言语上的嘲弄"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}