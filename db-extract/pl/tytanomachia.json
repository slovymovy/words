                "translations": [
                    {
                        "translation_id": "53cf136d-1a0c-4493-af89-59aad346b067",
                        "source_entry_id": "b164e831-35e4-36fb-b004-660f74680d5d",
                        "source_sense_id": "95863375-1d2f-300d-921a-384a37f0fd40",
                        "target_lang_word": "Titanomachy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titanomachy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34a8dcb-46a8-380e-bc18-7eca215b1772",
                                        "entry_id": "f94283ea-1045-382f-8779-3bf5ffc829b9",
                                        "glosses": [
                                            "The mythological war between the Titans and the Olympian gods."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "967b06ab-bfb2-4d74-8bc9-49df7858d4e7",
                                                "sense_id": "d34a8dcb-46a8-380e-bc18-7eca215b1772",
                                                "text": "1966, M. L. West (editor), Hesiod, Theogony: edited with prolegomena and commentary by M.L. West, Oxford University Press (Clarendon Press), page 337,\nA more important difference between the Titanomachy and Ragnarok is that the Norse gods, the Æsir, do not fight against other gods who are afterwards bound, but against an assortment of giants and monsters who have hitherto been bound […] ."
                                            },
                                            {
                                                "example_id": "b7258679-3bc3-4e1d-8be5-eda3e73cb5c8",
                                                "sense_id": "d34a8dcb-46a8-380e-bc18-7eca215b1772",
                                                "text": "His^([Thallus’]) history was arranged in three books, and, in part, by olympiads, and covered material from the Titanomachy (dated to 322 years before the Trojan war) to at least the Crucifixion."
                                            },
                                            {
                                                "example_id": "a9cf7924-fdfb-494a-b621-bef3aef8e203",
                                                "sense_id": "d34a8dcb-46a8-380e-bc18-7eca215b1772",
                                                "text": "Likewise, the tragedy's treatment of the Titanomachy departs significantly from the Hesiodic account. It has been suggested that the PV^([Prometheus Vinctus]) may be informed by the Cyclic epic Titanomachy attributed to Eumelus (or Arctinus),⁷² especially since an entry in Hesychius' Lexicon⁷³ has led some to believe that both Prometheus' involvement in the Titanomachy and his change of allegiance were elements of that Cyclic epic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Titanomachy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e1fe448-709f-33ff-bca6-81dcf0a70401",
                                        "entry_id": "5f8490a5-e6e0-32e1-8b27-c48e9764834b",
                                        "glosses": [
                                            "Any fight between two great forces."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d8ff57f-0ce8-4857-9107-2260b62fe84e",
                        "source_entry_id": "b164e831-35e4-36fb-b004-660f74680d5d",
                        "source_sense_id": "95863375-1d2f-300d-921a-384a37f0fd40",
                        "target_lang_word": "Titanomachie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titanomachie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                        "entry_id": "89162d1c-9db6-3952-9cc5-1d099ccf0d37",
                                        "glosses": [
                                            "Kampf der Titanen gegen die olympischen Götter unter Führung von Zeus"
                                        ],
                                        "tags": [
                                            "griechische",
                                            "Sage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31888f94-e4d7-4601-b154-c3e80d4abb23",
                                                "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                                "text": "Die griechische Mythologie der Titanomachie gehört zu einer Gruppe von Mythen, die in Europa und dem Nahen Osten verbreitet sind, in denen eine Generation oder Gruppe von Göttern mit einer anderen um die Vorherrschaft kämpft."
                                            },
                                            {
                                                "example_id": "8935517f-a0ff-4f7e-832a-da807312892a",
                                                "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                                "text": "Im Hinblick darauf erscheint dann die Titanomachie als mythologische Spiegelung eines historischen Prozesses."
                                            },
                                            {
                                                "example_id": "7707e57f-ea4d-4073-8823-52942c00bbfc",
                                                "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                                "text": "Diese Schilderungen der Titanomachie sind sehr eng verwandt mit denen der Gigantomachie, der Schlacht der Götter gegen die Riesen."
                                            },
                                            {
                                                "example_id": "8864e7b0-ddf9-490a-97f0-ffe552cbb5d2",
                                                "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                                "text": "Die Titanomachie ist, wenn man es so will, der griechische Gründungsmythos staatlicher Ordnung, der Unterordnung von Gewalt unter das Recht, der Ablösung archaischer Höhenkulte durch eine Stadtkultur."
                                            },
                                            {
                                                "example_id": "5041add5-40f1-4875-ba95-b809388ae69d",
                                                "sense_id": "db1cbe45-3f0c-3535-b767-a34953a6e0f3",
                                                "text": "Was die Zwölfzahl angeht, so ist hier schon zu bedenken, daß in der Titanomachie den zwölf Titanen sechs Olympier nebst zweimal drei Helfern gegenübertreten werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
