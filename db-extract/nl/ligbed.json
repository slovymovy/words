                ],
                "senses": [
                    {
                        "sense_id": "ad7686e9-05e4-3922-8ce8-d78445f92019",
                        "entry_id": "ac33478b-0d46-3306-b729-64892e31981c",
                        "glosses": [
                            "een bed waarop met verzetbaar hoofdeinde waarop je languit kunt liggen om uit te rusten, te relaxen of te zonnen maar meestal niet om op te slapen, een ligbed kan in tegenstelling tot een ligstoel helemaal plat gemaakt worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1bf1732-333e-42af-ab06-a6d916887e41",
                                "sense_id": "ad7686e9-05e4-3922-8ce8-d78445f92019",
                                "text": "Jean was naar binnen gekomen, klagend over rugpijn. Aan de keukentafel was hij begonnen over hoe heerlijk het nu zou zijn om in een warm zwembad rond te dobberen en daarna op een ligbed in de zon gemasseerd te worden."
                            },
                            {
                                "example_id": "f41a2a5e-6363-4469-86dd-923d272ed369",
                                "sense_id": "ad7686e9-05e4-3922-8ce8-d78445f92019",
                                "text": "Op het strand bij Lido Bizzarro huurden Sjeng en Bea twee ligbedden met uit zuinigheid één parasol. Terwijl we allemaal heel goed wisten dat de zon in Puglia zo hoog staat dat één parasol ook maar één bedje bestrijkt."
                            },
                            {
                                "example_id": "7abafa8f-b6bc-4de7-a7f7-d015d857e0a8",
                                "sense_id": "ad7686e9-05e4-3922-8ce8-d78445f92019",
                                "text": "Nu blijkt dat niet alleen de lange wachtrijen om een cabine te bemachtigen een probleem zijn, maar ook de geëscaleerde prijzen: badkarhouders in de buurt van Het Zoute vragen bedragen tot maar liefst 3.000 euro. Strandbar Siësta Beach biedt daarvoor een luxueuze cabine met koelkast en eigen afgebakend plaatsje met zetels en ligbedden aan. Ook toiletten, douches, een bar en een petanquebaan zijn op het terrein terug te vinden."
                            }
                        ]
                    }
                ],
