                        "examples": [
                            {
                                "example_id": "5609bfc1-7df1-4f19-9561-8835a33abb67",
                                "sense_id": "c2487eb5-3426-34b3-b648-4534e35bc6d9",
                                "text": "„Denn als er den zusammengesunkenen Kleiderhaufen umdrehte, ertönte ein fleischloses, trockenes Rasseln und ein Skelett grinste ihn an, die leeren Augenhöhlen nur ein paar Zentimeter von seinem Gesicht entfernt.“"
                            },
                            {
                                "example_id": "006ddc84-05f5-424a-91d7-e7f24bc901f5",
                                "sense_id": "c2487eb5-3426-34b3-b648-4534e35bc6d9",
                                "text": "„Der Raum war voller Kartons, Kleiderhaufen, zerbrochener Stühle und verschrammter Tische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
