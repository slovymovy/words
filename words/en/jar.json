{
    "word_family": [
        "jarful",
        "jarring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "465b0b56-ecfe-3280-9b56-5d692bab66d5",
                    "sense_definition": "A cylindrical container made of glass or clay, usually with a wide mouth, used for storing food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a <w>jar</w> of strawberry jam at the market.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>банку</w> клубничного варенья на рынке.",
                                "zh": "她在市场上买了一<w>罐</w>草莓果酱。"
                            }
                        },
                        {
                            "text": "Please put the lid back on the <w>jar</w> when you are done.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, закрой <w>банку</w> крышкой, когда закончишь.",
                                "zh": "用完后请把<w>罐子</w>的盖子盖好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pot"
                    ],
                    "common_phrases": [
                        "glass jar",
                        "jam jar",
                        "cookie jar",
                        "mason jar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндрический контейнер из стекла или глины, обычно с широким горлышком, используемый для хранения продуктов.",
                        "zh": "一种通常有宽口的玻璃或陶制圆柱形容器，用于储存食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "стеклянная емкость"
                            },
                            {
                                "target_lang_word": "склянка",
                                "target_lang_sense_clarification": "небольшая емкость, часто аптечная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罐子",
                                "target_lang_sense_clarification": "通用的容器名称"
                            },
                            {
                                "target_lang_word": "玻璃罐",
                                "target_lang_sense_clarification": "特指玻璃材质的容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2766f572-6c66-3484-bcd5-5e2b8e017033",
                    "sense_definition": "The amount that a jar can hold.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate a whole <w>jar</w> of cookies while watching the movie.",
                            "target_lang_translations": {
                                "ru": "Он съел целую <w>банку</w> печенья, пока смотрел фильм.",
                                "zh": "他看电影时吃掉了整整一<w>罐</w>饼干。"
                            }
                        },
                        {
                            "text": "We need another <w>jar</w> of sauce for the pasta.",
                            "target_lang_translations": {
                                "ru": "Нам нужна еще одна <w>банка</w> соуса для пасты.",
                                "zh": "我们还需要一<w>罐</w>意大利面酱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jar of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество содержимого, которое может вместить банка.",
                        "zh": "一个罐子所能容纳的量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка",
                                "target_lang_sense_clarification": "мера объема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一罐",
                                "target_lang_sense_clarification": "作为量词使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7877b0e9-3317-32cf-9846-4f4fffea63c6",
                    "sense_definition": "A sudden shake or strong vibration caused by an impact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car hit a large bump, and we felt a sudden <w>jar</w>.",
                            "target_lang_translations": {
                                "ru": "Машина наехала на большую кочку, и мы почувствовали резкий <w>толчок</w>.",
                                "zh": "车撞上了一个大坑，我们感到一阵突然的<w>震动</w>。"
                            }
                        },
                        {
                            "text": "The <w>jar</w> of the landing woke the sleeping passengers.",
                            "target_lang_translations": {
                                "ru": "<w>Тряска</w> при приземлении разбудила спящих пассажиров.",
                                "zh": "着陆时的<w>颠簸</w>把熟睡的乘客惊醒了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt"
                    ],
                    "common_phrases": [
                        "sudden jar",
                        "feel a jar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная тряска или сильная вибрация, вызванная ударом.",
                        "zh": "由撞击引起的突然震动或剧烈摇晃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "сотрясение",
                                "target_lang_sense_clarification": "вибрация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "物理上的晃动"
                            },
                            {
                                "target_lang_word": "颠簸",
                                "target_lang_sense_clarification": "车辆行驶时的剧烈晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7779d1b-8ea0-3394-9f6d-a803caac87d6",
                    "sense_definition": "A glass of beer or cider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's go to the pub for a <w>jar</w> after work.",
                            "target_lang_translations": {
                                "ru": "Пойдем в паб, пропустим по <w>кружечке</w> после работы.",
                                "zh": "下班后我们去酒吧喝<w>一杯</w>吧。"
                            }
                        },
                        {
                            "text": "He sat in the corner having a quiet <w>jar</w> with his friend.",
                            "target_lang_translations": {
                                "ru": "Он сидел в углу, спокойно попивая <w>пиво</w> с другом.",
                                "zh": "他坐在角落里和朋友安静地喝着<w>酒</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a jar",
                        "few jars"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British or Irish English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бокал пива или сидра (разговорное).",
                        "zh": "一杯啤酒或苹果酒（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружка",
                                "target_lang_sense_clarification": "пива"
                            },
                            {
                                "target_lang_word": "стаканчик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一杯酒",
                                "target_lang_sense_clarification": "指代饮酒的量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fab4161-91db-30c5-bd1d-f3eada7e358e",
                    "sense_definition": "To preserve food by sealing it in a jar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother likes to <w>jar</w> peaches every summer.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка любит <w>консервировать</w> персики каждое лето.",
                                "zh": "我祖母每年夏天都喜欢把桃子<w>装罐</w>保存。"
                            }
                        },
                        {
                            "text": "They decided to <w>jar</w> their own tomato sauce this year.",
                            "target_lang_translations": {
                                "ru": "В этом году они решили сами <w>закатать</w> томатный соус.",
                                "zh": "他们决定今年自己<w>装罐</w>番茄酱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bottle"
                    ],
                    "common_phrases": [
                        "jar fruit",
                        "jar pickles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Консервировать продукты, закрывая их в банки.",
                        "zh": "通过密封在罐子里来保存食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервировать",
                                "target_lang_sense_clarification": "заготавливать продукты"
                            },
                            {
                                "target_lang_word": "закатывать",
                                "target_lang_sense_clarification": "закрывать в банки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装罐",
                                "target_lang_sense_clarification": "将食物放入罐中保存"
                            },
                            {
                                "target_lang_word": "腌制",
                                "target_lang_sense_clarification": "通过罐装方式保存"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2547507-8e92-36d6-be58-748aa176c2ae",
                    "sense_definition": "To strike or shake something sharply.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explosion <w>jarred</w> the windows in the nearby houses.",
                            "target_lang_translations": {
                                "ru": "Взрыв <w>сотряс</w> окна в соседних домах.",
                                "zh": "爆炸声<w>震动</w>了附近房屋的窗户。"
                            }
                        },
                        {
                            "text": "He had to hit the machine to <w>jar</w> the coin loose.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось ударить по автомату, чтобы <w>вытряхнуть</w> застрявшую монету.",
                                "zh": "他不得不拍打机器，好把卡住的硬币<w>震</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt"
                    ],
                    "common_phrases": [
                        "jar loose",
                        "jar open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко ударить или потрясти что-либо.",
                        "zh": "猛烈地撞击或摇晃某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрясать",
                                "target_lang_sense_clarification": "вызывать дрожь"
                            },
                            {
                                "target_lang_word": "встряхивать",
                                "target_lang_sense_clarification": "резко двигать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "使某物产生剧烈晃动"
                            },
                            {
                                "target_lang_word": "猛撞",
                                "target_lang_sense_clarification": "通过撞击使某物松动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb35a96-7519-3a33-8c18-2953c9d09a19",
                    "sense_definition": "To shock or surprise someone unpleasantly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news <w>jarred</w> him, and he sat down in silence.",
                            "target_lang_translations": {
                                "ru": "Плохие новости <w>потрясли</w> его, и он молча сел.",
                                "zh": "坏消息让他感到<w>震惊</w>，他沉默地坐了下来。"
                            }
                        },
                        {
                            "text": "Her angry words <w>jarred</w> everyone in the quiet room.",
                            "target_lang_translations": {
                                "ru": "Ее гневные слова <w>коробили</w> всех в тихой комнате.",
                                "zh": "她愤怒的话语让安静房间里的每个人都感到<w>不适</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шокировать или неприятно удивить кого-либо.",
                        "zh": "使人感到震惊或不快。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясать",
                                "target_lang_sense_clarification": "шокировать"
                            },
                            {
                                "target_lang_word": "коробить",
                                "target_lang_sense_clarification": "вызывать неприятное чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "心理上的冲击"
                            },
                            {
                                "target_lang_word": "刺耳",
                                "target_lang_sense_clarification": "指言语或行为令人不适"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ccdc398-5f51-34f1-9e53-00b7921bf644",
                    "sense_definition": "To look strangely different or be incongruent with the surroundings.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The modern furniture seems to <w>jar</w> with the style of the old house.",
                            "target_lang_translations": {
                                "ru": "Современная мебель, кажется, <w>диссонирует</w> со стилем старого дома.",
                                "zh": "现代家具似乎与老房子的风格<w>不协调</w>。"
                            }
                        },
                        {
                            "text": "His rude comment <w>jarred</w> with his usually polite behavior.",
                            "target_lang_translations": {
                                "ru": "Его грубый комментарий <w>не вязался</w> с его обычно вежливым поведением.",
                                "zh": "他粗鲁的评论与他平时礼貌的行为<w>冲突</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jar with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть странно или не соответствовать окружению.",
                        "zh": "看起来格格不入或与周围环境不协调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диссонировать",
                                "target_lang_sense_clarification": "не сочетаться"
                            },
                            {
                                "target_lang_word": "не вязаться",
                                "target_lang_sense_clarification": "противоречить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不协调",
                                "target_lang_sense_clarification": "指事物之间不匹配"
                            },
                            {
                                "target_lang_word": "冲突",
                                "target_lang_sense_clarification": "指风格或观点上的不一致"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}