                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a680b1b-4c4a-4998-94a3-bc9d46715a2a",
                                "sense_id": "e5b0ffcd-9040-3a4c-a5bc-cce3ac7fb055",
                                "text": "„Hinten in dem Buch stehen einige Beschäftigungstipps drin, außerdem Bastelanleitungen für Katzenspielzeug.“"
                            },
                            {
                                "example_id": "98cac5bb-cc4b-4b29-a4de-d8ef5da925f0",
                                "sense_id": "e5b0ffcd-9040-3a4c-a5bc-cce3ac7fb055",
                                "text": "„Mit einem amüsierten Lächeln lud Alex einen Kratzbaum, eine Katzentoilette, eine Schachtel mit Katzenspielzeug und drei große Reisetaschen aus dem Taxi.“"
                            },
                            {
                                "example_id": "19e8ccf7-f116-47af-8063-e6ea3e29acbb",
                                "sense_id": "e5b0ffcd-9040-3a4c-a5bc-cce3ac7fb055",
                                "text": "„Ich ging zu Rose hinüber, die an einem Regal mit Tierfutter, Hundeleinen und Katzenspielzeug stand.“"
                            },
                            {
                                "example_id": "714c026e-2cea-4784-aae3-5636b42a90b3",
                                "sense_id": "e5b0ffcd-9040-3a4c-a5bc-cce3ac7fb055",
                                "text": "„Ich hole ihm einen Ball aus seinem Korb mit dem Katzenspielzeug und rolle ihn in seine Richtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
