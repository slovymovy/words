{
    "word_family": [
        "tread",
        "trodden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d8f6aef-7235-3868-836e-f1ac1805d63d",
                    "sense_definition": "To walk heavily or laboriously; to plod.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary travelers <w>trod</w> through the thick mud after the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Усталые путники <w>брели</w> по густой грязи после сильного дождя."
                            }
                        },
                        {
                            "text": "He <w>trod</w> the unfamiliar path with great caution during the dark night.",
                            "target_lang_translations": {
                                "ru": "Он с большой осторожностью <w>ступал</w> по незнакомой тропе темной ночью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trod the path"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb form is increasingly rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело или с трудом идти; брести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "идти медленно, с трудом"
                            },
                            {
                                "target_lang_word": "ступать",
                                "target_lang_sense_clarification": "делать шаги, часто с усилием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a0b9045-7734-3753-b72d-050593e646d4",
                    "sense_definition": "The simple past of <w>tread</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>trod</w> carefully across the wooden floor to avoid waking the baby.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>ступала</w> по деревянному полу, чтобы не разбудить ребенка."
                            }
                        },
                        {
                            "text": "He <w>trod</w> on a sharp stone while walking barefoot on the beach.",
                            "target_lang_translations": {
                                "ru": "Он <w>наступил</w> на острый камень, гуляя босиком по пляжу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола 'tread' (ступать, наступать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступал",
                                "target_lang_sense_clarification": "прошедшее время от глагола ступать"
                            },
                            {
                                "target_lang_word": "наступил",
                                "target_lang_sense_clarification": "прошедшее время от глагола наступить (на что-либо)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ec09119-737b-3a6d-a31d-cf2d53cb5cb3",
                    "sense_definition": "A track or pathway.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>trod</w> led the villagers through the dense forest to the valley.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>тропа</w> вела жителей деревни через густой лес к долине."
                            }
                        },
                        {
                            "text": "Hikers often follow the old <w>trod</w> to reach the mountain summit.",
                            "target_lang_translations": {
                                "ru": "Туристы часто следуют по старой <w>тропе</w>, чтобы добраться до вершины горы."
                            }
                        }
                    ],
                    "synonyms": [
                        "trailway"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Northern England."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропа или протоптанная дорожка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тропа",
                                "target_lang_sense_clarification": "узкая дорожка, протоптанная людьми или животными"
                            },
                            {
                                "target_lang_word": "тропинка",
                                "target_lang_sense_clarification": "небольшая тропа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}