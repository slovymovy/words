                    {
                        "translation_id": "f401afcd-dc5d-4618-a04a-d9ef9ea571ea",
                        "source_entry_id": "6b91c8db-4054-309a-9a11-08ee1795c93f",
                        "source_sense_id": "78818be4-1ba3-34f3-b766-77b5395255db",
                        "target_lang_word": "Pedant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pedant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26974c82-3f51-3d07-a932-2e32c723f23e",
                                        "entry_id": "dbea5917-f1b6-3920-a937-1e716dbe9f64",
                                        "glosses": [
                                            "ein in übertriebener Weise genauer, kleinlicher Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ef2214-1388-4005-b9b6-6b285dd5b9be",
                                                "sense_id": "26974c82-3f51-3d07-a932-2e32c723f23e",
                                                "text": "Was bist du nur für ein Pedant!"
                                            },
                                            {
                                                "example_id": "8ef8e91e-e3a4-40b5-866a-5b49b4b46479",
                                                "sense_id": "26974c82-3f51-3d07-a932-2e32c723f23e",
                                                "text": "„Es ist das Ensemble der Vorschriften, das Kleingedruckte, das von Pedanten des Kleingedruckten ausgeführt wird.“"
                                            },
                                            {
                                                "example_id": "799f8e4d-7575-4101-81df-01d9e7e26344",
                                                "sense_id": "26974c82-3f51-3d07-a932-2e32c723f23e",
                                                "text": "„Noch lange nach seinem Tod hing ihm der Ruf eines cholerischen Pedanten an.“"
                                            },
                                            {
                                                "example_id": "41e0f5bb-b668-43ce-a6d8-dc8d6df5260a",
                                                "sense_id": "26974c82-3f51-3d07-a932-2e32c723f23e",
                                                "text": "„Nach geltendem finnischen Recht – und da ist der Finne ein Pedant wie europäisch sonst höchstens noch der Deutsche und der Schweizer – darf Steuergeld nicht für Glücksspiele ausgegeben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89267ae3-dd54-44b6-ac6e-98694c4c5d04",
                        "source_entry_id": "6b91c8db-4054-309a-9a11-08ee1795c93f",
                        "source_sense_id": "78818be4-1ba3-34f3-b766-77b5395255db",
                        "target_lang_word": "Haarspalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarspalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7581cb-a3b8-35e2-bc9d-0ed2ac3082b7",
                                        "entry_id": "1448eb70-412f-30f4-8948-a235b8f83244",
                                        "glosses": [
                                            "kleinliche, auf irrelevante Unterscheidungen beharrende Person"
                                        ],
                                        "tags": [
