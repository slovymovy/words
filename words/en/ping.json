                            "trait_type": "colloquial",
                            "comment": "technical context (nautical)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звуковой импульс, используемый гидролокатором для обнаружения подводных объектов.",
                        "zh": "声呐设备用于探测水下物体的声音脉冲。"
                    },
                    "translations": {
