                    {
                        "translation_id": "699e2e7e-53cc-4ca8-b3b4-e083e64c5deb",
                        "source_entry_id": "cf4aebde-7dc8-38d5-acc3-568fc4500b85",
                        "source_sense_id": "01e18621-cd85-31e0-ad6e-0b7c5f6385e8",
                        "target_lang_word": "vanner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "494bcbf1-1344-3c5f-8919-4c097a482850",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "Nettoyer les grains au moyen d’un van ou en les lançant en l'air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40442ccb-5bc7-4838-b60c-805a9f1ccce8",
                                                "sense_id": "494bcbf1-1344-3c5f-8919-4c097a482850",
                                                "text": "Vanner du blé, de l’avoine, de l’orge."
                                            },
                                            {
                                                "example_id": "e4e4e867-b139-4f11-b803-73b2d8bb080d",
                                                "sense_id": "494bcbf1-1344-3c5f-8919-4c097a482850",
                                                "text": "[…] ces groupes de femmes sur les rochers à pic, prenant la direction de l’air et vannant le blé entre leurs mains levées, avec des gestes d’évocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9003a5-6c07-3e80-9d9c-08006f394df8",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "Épuiser, exténuer, claquer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb4d65f4-ff15-39ee-9cbc-2aca93361b75",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "Touiller avec une cuillère en bois ou agiter la casserole où se trouve une sauce en train de refroidir. L’objectif est d’éviter la formation d’une peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e168cf3-f621-49ed-89e3-b7b2916366d3",
                                                "sense_id": "fb4d65f4-ff15-39ee-9cbc-2aca93361b75",
                                                "text": "Aussitôt prête, la passer au chinois fin ou au linge, soit dans un bain-marie si elle doit être conservée chaude, soit dans une terrine si elle doit être employée froide. Dans ce cas, la vanner jusqu’à complet refroidissement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "774e33c3-b115-3dbf-909d-7345edfa8bdc",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "Se moquer de quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a87e440-8fd9-4557-9099-abc723da37e4",
                                                "sense_id": "774e33c3-b115-3dbf-909d-7345edfa8bdc",
                                                "text": "Le groupe le vanne sec, comme c’est l’habitude ici, dans le bassin minier, avec des répliques du tac au tac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc79d8b-df49-321a-b7a6-cb9bb1190807",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "réciproque Se moquer mutuellement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fa9bb2d-013c-301a-ada9-a8735efd7375",
                                        "entry_id": "51f41b83-e03e-386d-96b4-3321b89e0c3e",
                                        "glosses": [
                                            "S’enfuir, en parlant de personnes, ou d’un animal, par anthropomorphisme."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9875e074-3b79-4bbe-92d4-816cbece4b8c",
                                                "sense_id": "2fa9bb2d-013c-301a-ada9-a8735efd7375",
                                                "text": "Regarde le vanner. Du wallon. Vane èvôye ! : Fous le camp ! ; vane foû dchâl : Sors d’ici ! ; ce qui explique la persistance de ce sens en Wallonie."
                                            }
