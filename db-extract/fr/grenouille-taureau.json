                        "entry_id": "cf7c31b1-4ad2-3e71-83ff-055747fb7cac",
                        "glosses": [
                            "Grosse grenouille verte d’Amérique du Nord dont le croassement s’apparente au beuglement d’une vache."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc50ec1f-2ecc-4f99-84ba-831f1ab59916",
                        "source_entry_id": "cf7c31b1-4ad2-3e71-83ff-055747fb7cac",
                        "source_sense_id": "f56ef8f6-8bdc-34e1-9327-814643140bb4",
                        "target_lang_word": "Ochsenfrosch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ochsenfrosch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                        "entry_id": "b0eb449b-0818-342d-a043-7334357aa937",
                                        "glosses": [
                                            "sehr große, weltweit verbreitete Froschart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8fa426-f8fa-4e43-b848-e839686715b4",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Die Hälfte des Baus war den Elementen ungeschützt ausgesetzt und wir konnten, nicht weit entfernt in den Sümpfen, die Ochsenfrösche belfern hören, wir konnten die Abgasfackeln wie ferne defekte Sterne glimmern sehen.“"
                                            },
                                            {
                                                "example_id": "7b73adcf-947d-4d8e-acd5-76d23bdb62e2",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Sonia griff nach einem Ochsenfrosch mit übergroßen Augen aus Porzellan.“"
                                            },
                                            {
                                                "example_id": "5a55c224-326b-484f-b5ec-a6638b894422",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Triumphierend blies er sich auf wie ein Ochsenfrosch und landete einen Schwinger, schlug den Kopf des Gegners mit schrecklicher Wucht ein.“"
                                            },
                                            {
                                                "example_id": "ae5869ec-df29-430f-b9e7-4a51386900f1",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Ochsenfrösche krächzten, und überall um sie herum summten Moskitos mit einer Beharrlichkeit, die sie fast wahnsinnig machte.“"
                                            },
                                            {
                                                "example_id": "e2a5a33c-50b9-4853-8dba-e63a341a8999",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„›Wenn sie alles über jemand herausbekommen wollen, was es gibt, dann machen sie das mit ihm. Trensenbereifen. Seine Innenseite nach außen stülpen, so wie man bei einem Ochsenfrosch das Innerste nach außen stülpt.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
