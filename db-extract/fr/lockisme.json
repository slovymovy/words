                        "examples": [
                            {
                                "example_id": "4a2c4401-c8cf-42df-ba23-6c6c97d063b8",
                                "sense_id": "ec821faa-5938-35b2-99ee-18351d21dd95",
                                "text": "Tel est le système moral qui dérive, avec ses conséquences, de ce qu'on peut appeler le lockisme et le condillacisme. Helvétius l'a développé dans toute son étendue."
                            },
                            {
                                "example_id": "f5866653-bfa5-4598-aa4c-834155e88e16",
                                "sense_id": "ec821faa-5938-35b2-99ee-18351d21dd95",
                                "text": "Mais le « lockisme » de Rousseau, poussé avec rigueur dans ses dernières conséquences, le conduit pourtant à s’opposer presque terme pour terme à Locke sur la question discriminante du droit de propriété."
                            }
                        ]
