                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tiresome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>weary</w> journey through the muddy and dark forest.",
                            "target_lang_translations": {
                                "de": "Es war eine <w>mühsame</w> Reise durch den schlammigen und dunklen Wald."
                            }
                        },
                        {
                            "text": "They spent a <w>weary</w> afternoon filling out endless government forms.",
                            "target_lang_translations": {
                                "de": "Sie verbrachten einen <w>ermüdenden</w> Nachmittag damit, endlose Regierungsformulare auszufüllen."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiresome",
                        "tiring",
                        "tedious",
                        "exhausting",
                        "wearing"
                    ],
                    "antonyms": [
