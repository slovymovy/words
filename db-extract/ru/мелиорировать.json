                                    {
                                        "sense_id": "bc6c1d6f-d242-3932-95e5-6167f30885c8",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To return land to a suitable condition for use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9be762b3-172b-36aa-a306-1a19d5bad81b",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To obtain useful products from waste; to recycle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "093e8f78-53ce-3998-a63e-134736166df8",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To claim something back; to repossess."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To return someone to a proper course of action, or correct an error; to reform."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "643a3ce8-4355-4832-b05b-ccced5484152",
                                                "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                                                "text": "His Highneſſe pleaſure is that he ſhould liue,\nAnd be reclaim’d with princely lenitie."
                                            },
                                            {
                                                "example_id": "c86d0dac-1192-4c41-b5f2-c0e45ad5e1c6",
                                                "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                                                "text": "Your errour, in time reclaimed, will be veniall."
                                            },
                                            {
                                                "example_id": "8e748b2c-6377-4aff-b30f-c6692d352a23",
                                                "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                                                "text": "They, hardened more by what might most reclaim, / Grieving to see his glory […] took envy."
                                            },
                                            {
                                                "example_id": "21127e57-9155-47ad-9628-56bbe3e81586",
                                                "sense_id": "eb522c83-7833-3c82-a9c1-47a111b04055",
                                                "text": "It is the intention of Providence, in all the various expressions of his goodness, to reclaim mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0682cdf1-8c7e-30c5-a102-26fe19bd3f0a",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To tame or domesticate a wild animal."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780b234a-beb8-4b9a-9a96-28f570eb63a2",
                                                "sense_id": "0682cdf1-8c7e-30c5-a102-26fe19bd3f0a",
                                                "text": "an eagle well reclaimed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7b3091-2a59-39b1-9bcc-d27e1d19224b",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To call back from flight or disorderly action; to call to, for the purpose of subduing or quieting."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba025c8-4a29-4944-aa75-fada0f05ccdb",
                                                "sense_id": "df7b3091-2a59-39b1-9bcc-d27e1d19224b",
                                                "text": "They were the head-strong horses, who hurried Octavius […] along, and were deaf to his reclaiming them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0f4fd7-d978-3903-ac3c-f18b776cf954",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To cry out in opposition or contradiction; to exclaim against anything; to contradict; to take exceptions."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "882cbd8c-1849-4412-a511-bd43e8db261a",
                                                "sense_id": "4c0f4fd7-d978-3903-ac3c-f18b776cf954",
                                                "text": "True it is he was very wild in his youth till God (the best Chymick who can fix quicksilver it self) gratiously reclaim'd him"
                                            },
                                            {
                                                "example_id": "2501bd20-4bf6-4ed3-9556-4d4c894ca959",
                                                "sense_id": "4c0f4fd7-d978-3903-ac3c-f18b776cf954",
                                                "text": "Scripture reclaims, and the whole Catholic church reclaims, and Christian ears would not bear it."
                                            },
                                            {
                                                "example_id": "2eb69e3b-ce0a-4598-a9e5-9dbf8968e860",
                                                "sense_id": "4c0f4fd7-d978-3903-ac3c-f18b776cf954",
                                                "text": "At a later period Grote reclaimed strongly against Mill's setting Whately above Hamilton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f503666c-b5cb-3f76-8504-a9cd39877f9a",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To draw back; to give way."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "919b1de3-dc10-434c-bf1b-1d76f4ea3aa1",
                                                "sense_id": "f503666c-b5cb-3f76-8504-a9cd39877f9a",
                                                "text": "Yet would he not perswaded be for ought,\nNe from his currish will a whit reclame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bf16a1-daa4-35a0-85af-6e19fca19901",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To appeal from the Lord Ordinary to the inner house of the Court of Session."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9208170-57c5-3c03-81e0-c3867763d1bc",
                                        "entry_id": "00d5085b-eba1-3c3e-aea3-183c4e24b1b6",
                                        "glosses": [
                                            "To bring back a term into acceptable usage, usually of a slur, and usually by the group that was once targeted by that slur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687c225d-4d7e-4584-93eb-6491169279e6",
                                                "sense_id": "d9208170-57c5-3c03-81e0-c3867763d1bc",
                                                "text": "Once a term of homophobic abuse, the term “queer” has been reclaimed as a marker for some gay, lesbian, bisexual, transgender (GLBT), and other marginalized sexual identities."
                                            }
                                        ]
                                    }
                                ]
                            },
