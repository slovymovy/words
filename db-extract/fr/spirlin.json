                                    },
                                    {
                                        "sense_id": "2a6c2b86-4d11-3546-bf4e-64aaa7e72a4e",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "das Erreichen nur der Hälfte oder weniger der zum Gewinn nötigen Augen (Punkte)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43611648-d091-4ec6-92ef-60963e61fc0c",
                                                "sense_id": "2a6c2b86-4d11-3546-bf4e-64aaa7e72a4e",
                                                "text": "Na wenigstens aus dem Schneider!"
                                            },
                                            {
                                                "example_id": "ce649910-363c-4727-889e-5fa459a609f9",
                                                "sense_id": "2a6c2b86-4d11-3546-bf4e-64aaa7e72a4e",
                                                "text": "Der geht heute als Schneider nach Hause"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "282b6681-26be-31b2-8313-b4eb9ef8b04c",
                                        "entry_id": "9cac1d9a-a4d7-39e4-928f-7fdec4652224",
                                        "glosses": [
                                            "großes Wildschwein, Sau"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f60f470-9a03-4b46-a500-d9a5766e48b9",
                                                "sense_id": "282b6681-26be-31b2-8313-b4eb9ef8b04c",
                                                "text": "Der Schneider muss wohl zuerst dran glauben."
                                            }
                                        ],
