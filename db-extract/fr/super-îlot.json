                "translations": [
                    {
                        "translation_id": "9ab934eb-9db2-4215-b324-f3738abd72d5",
                        "source_entry_id": "cbd476e2-5ef6-3f77-ae01-1c0ed4f21392",
                        "source_sense_id": "f99085c5-fe0e-3343-818c-05d4302e74f7",
                        "target_lang_word": "superblock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superblock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc18159-a91e-33a5-b0a1-0c833887a8af",
                                        "entry_id": "1d46a2ec-929b-3dc4-942f-b4c239b93b86",
                                        "glosses": [
                                            "A very large block of buildings; in modern urban planning often designed for local needs, with access and speed restrictions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7093ee5-5219-4c2e-93dd-770ad243a8a8",
                                                "sense_id": "4dc18159-a91e-33a5-b0a1-0c833887a8af",
                                                "text": "All are blots on the urban environment, as blandly homogenous in their own way as the Modernist superblocks they were intended to improve on."
                                            },
                                            {
                                                "example_id": "a65c5bfc-a3f1-40ab-b050-de40e32ca964",
                                                "sense_id": "4dc18159-a91e-33a5-b0a1-0c833887a8af",
                                                "text": "Conceived as part of a 1950s-era slum-clearance program, the immense superblock required the demolition of an entire neighborhood of dilapidated tenements and brownstones."
                                            },
                                            {
                                                "example_id": "0034aa6a-60f3-4483-a01c-6c9ec2831a39",
                                                "sense_id": "4dc18159-a91e-33a5-b0a1-0c833887a8af",
                                                "text": "Superblocks are a relatively new urban planning concept that has been pioneered in Barcelona, Spain. The basic idea is to identify a 3 x 3 grid of 9 city blocks and restrict vehicle traffic to the streets on the perimeter. The interior streets then become available for walking, biking, and expanded green space."
                                            },
                                            {
                                                "example_id": "7c7ad4b1-170d-4948-b500-ecf654978c77",
                                                "sense_id": "4dc18159-a91e-33a5-b0a1-0c833887a8af",
                                                "text": "Barcelona’s flagship policy, which has attracted interest from around the world, is its superblocks, where groups of nine city blocks are transformed into people-friendly spaces, with benches, play areas and gardens. Cars may enter but cannot transit the superblock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed11fcf3-c94c-381b-a412-c92cae21fa29",
                                        "entry_id": "1d46a2ec-929b-3dc4-942f-b4c239b93b86",
