                                            {
                                                "example_id": "e06e1c25-103b-4cb0-b6af-0999d36c8c68",
                                                "sense_id": "22048679-803f-3cf1-84ec-cd682c0e3a25",
                                                "text": "I love eating beef."
                                            },
                                            {
                                                "example_id": "1a43ad4d-d75d-404d-9952-8a2f3086851f",
                                                "sense_id": "22048679-803f-3cf1-84ec-cd682c0e3a25",
                                                "text": "He was cooking beef for lunch."
                                            },
                                            {
                                                "example_id": "98aa7044-76a5-4ee0-8800-d2e764d79c2f",
                                                "sense_id": "22048679-803f-3cf1-84ec-cd682c0e3a25",
                                                "text": "But the cars & trucks held cartons of roast chickens, slabs of cheeses, loaves of bread, racks of hotdogs, case upon case of soft drinks, cases of bottled sparkling water, pies, cakes, roast beefs & baked hams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af12841b-06da-325b-beb8-9f937f41cdc7",
                                        "entry_id": "402a129e-d01a-37a2-a27e-209621e32625",
                                        "glosses": [
                                            "The meat from cattle or other bovines.",
                                            "The edible portions of a cow (including those which are not meat)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f7e0c34-9091-49c5-9f58-e8428816c79b",
