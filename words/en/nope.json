                    "sense_definition": "A historical indigenous name for the island of Martha's Vineyard in Massachusetts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Early colonial records often refer to the island as <w>Nope</w>.",
                            "target_lang_translations": {
                                "ru": "В ранних колониальных записях остров часто называют <w>Ноуп</w>.",
                                "zh": "早期的殖民记录常把该岛称为<w>诺普</w>。"
