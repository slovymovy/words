                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "об оправдании или доводах"
                            },
                            {
                                "target_lang_word": "неубедительный",
                                "target_lang_sense_clarification": "о доказательствах"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dun",
                                "target_lang_sense_clarification": "van bewijs of een excuus"
                            },
                            {
                                "target_lang_word": "zwak",
                                "target_lang_sense_clarification": "niet overtuigend"
                            }
