                "senses": [
                    {
                        "sense_id": "d17e5edb-b88e-33f0-9fde-cf96746c5766",
                        "entry_id": "7647e012-b5b7-385b-802b-b57f78c84457",
                        "glosses": [
                            "A picture; a portrait."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a878e2-2bff-4fc8-9683-32b77cb3f58b",
                                "sense_id": "d17e5edb-b88e-33f0-9fde-cf96746c5766",
                                "text": "Here are the Ritrattoes of the Family; amongst others some by Titian, Giorgion, &c […]"
                            },
                            {
                                "example_id": "5c3a4d4b-950a-46f8-8beb-b6b6c4306cf9",
                                "sense_id": "d17e5edb-b88e-33f0-9fde-cf96746c5766",
                                "text": "A little beyond this Vestibule […] is what they call the Painter's Chamber, fill'd from Top to Bottom, with the Ritrattos of all the most famous Men in that Art […]"
                            },
                            {
                                "example_id": "b5b5deb9-6e78-4300-9dc9-23064f09f6b9",
                                "sense_id": "d17e5edb-b88e-33f0-9fde-cf96746c5766",
                                "text": "——'tis more like a ritratto of the shadow of vanity, than of VANITY herself——of the two; resembling rather a faint thought of transient applause, secretly stirring up in the heart of the composer, than a gross mark of it, coarsely obtruded upon the world."
                            }
                        ]
                    }
                ],
