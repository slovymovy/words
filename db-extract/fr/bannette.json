                "senses": [
                    {
                        "sense_id": "9ece5956-fda2-365b-878e-ac84576f5999",
                        "entry_id": "4b94c3cc-ba49-3f8a-a516-4ec6af5c22f4",
                        "glosses": [
                            "Réceptacle à papier, généralement en plastique."
                        ],
                        "tags": [
                            "Papeterie"
                        ],
                        "examples": [
                            {
                                "example_id": "dbbf61bf-f21a-476e-b1f2-f09b43208a49",
                                "sense_id": "9ece5956-fda2-365b-878e-ac84576f5999",
                                "text": "Frédéric était chargé de traduire toutes les données administratives qui lui tombaient sous la main et proposer, en toute décomplexion, une première sélection dont on discutait ensuite en de plus hautes instances. Première bannette : dossiers particulièrement intéressants, personnes à fort potentiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "4aa17e49-7307-3891-8c53-b0b580d75356",
                        "entry_id": "4b94c3cc-ba49-3f8a-a516-4ec6af5c22f4",
                        "glosses": [
                            "Petite banne en osier."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2c8284f4-0c24-45a6-a179-e2ec24c7f822",
                                "sense_id": "4aa17e49-7307-3891-8c53-b0b580d75356",
                                "text": "Ensuite Mlle d’Andervilliers ramassa des morceaux de brioche dans une bannette, pour les porter aux cygnes sur la pièce d’eau."
                            },
                            {
                                "example_id": "95c83f55-5b25-490b-b89b-8ae5b3c01d37",
                                "sense_id": "4aa17e49-7307-3891-8c53-b0b580d75356",
                                "text": "Les tapisseries de ces murs, ces meubles, ces flambeaux, ces vases et jusqu’à ces fleurs dont j’eusse pu dire presque d’où elles venaient, dans leurs bannettes dorées, et combien elles avaient coûté, enfermaient fatalement mon imagination dans les limites d’un salon aussi banal que bien d’autres qui avaient au moins cette excuse de n’être point situés dans les dessous de l’Opéra."
                            },
                            {
                                "example_id": "4329d321-2445-4ec1-bfad-a2f6aaf7714d",
                                "sense_id": "4aa17e49-7307-3891-8c53-b0b580d75356",
                                "text": "Sur la banquette de devant, deux bannettes de satin blanc sont pleines de violettes de Nice …."
                            }
                        ]
                    },
                    {
                        "sense_id": "ade3846e-a364-35ef-997e-5b2138a983a3",
                        "entry_id": "4b94c3cc-ba49-3f8a-a516-4ec6af5c22f4",
                        "glosses": [
                            "Petite bâche."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2ec339a4-13ea-3ef5-807c-455af205a447",
                        "entry_id": "4b94c3cc-ba49-3f8a-a516-4ec6af5c22f4",
                        "glosses": [
                            "Paquet de peaux."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d6cfc039-a655-31b1-80fd-6e23af3d6ad3",
                        "entry_id": "4b94c3cc-ba49-3f8a-a516-4ec6af5c22f4",
                        "glosses": [
                            "Couchette d’équipage à bord d’un navire de guerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb78c8c7-de38-484a-90f0-45dc9e64cc2b",
                                "sense_id": "d6cfc039-a655-31b1-80fd-6e23af3d6ad3",
                                "text": "Voilà une trentaine de minutes qu’ils ont quitté le port et l’autre et le troisième homme se sont blottis dans leurs bannettes cigarette à la bouche."
                            }
                        ]
                    }
