                "senses": [
                    {
                        "sense_id": "0a234b7c-3987-3335-a037-7674dcbaa702",
                        "entry_id": "3eeb1ab0-824d-37bb-8c82-86487c613f06",
                        "glosses": [
                            "настольная игра для двух игроков, цель игрока во время игры — бросая кости и передвигая шашки в соответствии с выпавшими очками, переместить все свои шашки в определённую область игрового поля раньше противника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8931e2d8-e635-4a29-b71e-8316f458bfa0",
                                "sense_id": "0a234b7c-3987-3335-a037-7674dcbaa702",
                                "text": "Он играл в нарды с маленьким круглым татарином, хозяином скобяной лавки на выезде из города."
                            },
                            {
                                "example_id": "2c1f5137-1d1e-41f1-86b9-1fd068372e63",
                                "sense_id": "0a234b7c-3987-3335-a037-7674dcbaa702",
                                "text": "Посреди двора стояла развесистая шелковица, под которой уютно расположились скамейки и столик для нардов или домино, намертво вбитый в землю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e285fbe5-9f2c-4950-90f0-842b464102ed",
                        "source_entry_id": "3eeb1ab0-824d-37bb-8c82-86487c613f06",
                        "source_sense_id": "0a234b7c-3987-3335-a037-7674dcbaa702",
                        "target_lang_word": "backgammon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backgammon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1eccf00-845b-37fa-9d64-37b920242c1d",
                                        "entry_id": "5c0caf10-3a05-3783-af18-b755a433616b",
                                        "glosses": [
                                            "A board game for two players in which each has 15 stones which move between 24 triangular points according to the roll of a pair of dice; the object is to move all of one's pieces around, and bear them off the board."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4504951-3c86-412d-944b-9e4b30f2dae1",
                                                "sense_id": "c1eccf00-845b-37fa-9d64-37b920242c1d",
                                                "text": "\"I have borrowed Mrs. Palmer's backgammon-board,\" said Isabella, whose notion of an elderly gentleman's amusements of an evening was derived from what she had seen Mr. Palmer do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d6b5a9-6de1-3792-b1b4-569309b5e5b8",
                                        "entry_id": "5c0caf10-3a05-3783-af18-b755a433616b",
                                        "glosses": [
                                            "A victory in the game when the loser has not borne off a stone, and still has one or more stones in the winner's inner home row or on the bar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "backgammon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c604dee-6f15-321f-81ab-6a387e9ac9b3",
                                        "entry_id": "3dddd28b-a84a-3aa8-97d3-dfab4ed546fd",
                                        "glosses": [
                                            "To win at a backgammon game with the opponent having one or more pieces in the winner’s inner home row or on the bar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
