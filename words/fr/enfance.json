                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a passé toute son <w>enfance</w> dans un petit village au bord de la mer."
                        },
                        {
                            "text": "Elle garde de très beaux souvenirs d'<w>enfance</w> avec ses frères et sœurs."
                        }
                    ],
                    "synonyms": [
