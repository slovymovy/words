                        "glosses": [
                            "Gebäude, in dem mindestens ein Verein seine Sitzungen, Versammlungen, Treffen abhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06125c16-b0e0-4be7-9a9b-905ac1e441b6",
                                "sense_id": "ff8709db-eb8a-394c-af5c-28145ec69349",
                                "text": "„Wir gingen beim Rudertraining auf Nummer sicher und machten ein Trockentraining: Im Vereinshaus stehen Ruderergometer, die wir aus dem Fitnessstudio kannten. Hier wurde uns der exakte Bewegungsablauf beim Rudern erklärt – und Fehler gleich einmal ausgebessert.“"
                            }
                        ],
