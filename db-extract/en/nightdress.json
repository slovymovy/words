                "senses": [
                    {
                        "sense_id": "390af5f9-7734-3c2e-a4ea-e2baf90573fd",
                        "entry_id": "fc4190e2-517d-3246-8f46-dc51bae020d3",
                        "glosses": [
                            "Nachthemd, Nachtkleid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b9d715-01b9-427e-a36c-3599810fb947",
                                "sense_id": "390af5f9-7734-3c2e-a4ea-e2baf90573fd",
                                "text": "\"I took another clean nightdress to be aired on the following Saturday. Miss Constance's nightdresses are easily distinguishable from the other Misses Kent's, as they have plain frills, and the others have lace and work.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a655dd2b-466e-4cb5-b7a1-4448df1cd61e",
                        "source_entry_id": "fc4190e2-517d-3246-8f46-dc51bae020d3",
                        "source_sense_id": "390af5f9-7734-3c2e-a4ea-e2baf90573fd",
                        "source_sense_description": "Nachthemd, Nachtkleid",
                        "target_lang_word": "Nachthemd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachthemd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                        "entry_id": "2dd97b93-158f-38a3-a335-0858c6eef53f",
                                        "glosses": [
                                            "Bekleidungsstück für die Nachtruhe, das vor allem von Damen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff07b138-1720-4e75-8ad7-617ba03b294e",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "Zu Weihnachten bekam meine Mutter ein neues Nachthemd aus Seide."
                                            },
                                            {
                                                "example_id": "690bb719-f6ea-4bcf-b9e5-bcfd7bb9353c",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Sie sagte niemandem, wohin sie ging, und nahm nur ein Nachthemd und ihre Zahnbürste mit.“"
                                            },
                                            {
                                                "example_id": "732d79b9-57fc-48bb-bf22-61c7fd8e114a",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "Abla Fahita räkelt sich in einem dünnen Nachthemd auf ihrem Himmelbett, bis zwei gut gebaute Kerle im Bild auftauchen."
                                            },
                                            {
                                                "example_id": "20d97b6a-241d-4cf5-8237-b75df148c56e",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Die Sängerin trug bei einem Abendessen ein schwarzes Seidenkleid oder vielmehr ein Spaghettiträger-Nachthemd, welches ihre traumhaften Silhouette betonte.“"
                                            },
                                            {
                                                "example_id": "868bcfad-94d3-4e8a-813c-09aef6ed86f5",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Das Nachthemd Ihrer Oma hat noch nie so elegant ausgesehen.“"
                                            },
                                            {
                                                "example_id": "5f87522a-c937-4957-b4fa-f57d777a28f7",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Der Mann im Nachthemd hat die Nacht nicht allein verbracht.“"
                                            },
                                            {
                                                "example_id": "7e20e47b-224b-4fbe-bd45-ae543b4f31df",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Der alte Mann trug ein langes Nachthemd, das bis auf den Fußboden reichte.“"
                                            },
                                            {
                                                "example_id": "c13c34f9-92e9-4d5c-96b7-b6bfde296677",
                                                "sense_id": "ac486bf5-ff5b-37a0-a929-4455cf5428c7",
                                                "text": "„Aber nicht mehr der förmliche junge Mann in grauer Livree, sondern etwas Lächerliches in einem übermäßig langen, weißen Nachthemd mit bunter Borte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d39979e-d937-4a67-9d11-c060b907ee34",
                        "source_entry_id": "fc4190e2-517d-3246-8f46-dc51bae020d3",
                        "source_sense_id": "390af5f9-7734-3c2e-a4ea-e2baf90573fd",
                        "source_sense_description": "Nachthemd, Nachtkleid",
                        "target_lang_word": "Nachtkleid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtkleid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e0b6a69-4ad9-3147-b291-8a9586412c0e",
                                        "entry_id": "5b6e49d7-2750-3fbc-8e39-3e7195d8a6e4",
                                        "glosses": [
                                            "Bekleidungsstück für die Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2ce548-7e55-4363-b675-1297701536f2",
                                                "sense_id": "4e0b6a69-4ad9-3147-b291-8a9586412c0e",
                                                "text": "„Es klopft schon wieder! Wirf dein Nachtkleid über!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
