                "senses": [
                    {
                        "sense_id": "471164ad-e1b4-304d-b421-4dbb69301419",
                        "entry_id": "cda03bce-2f35-34e1-994f-2c5aa4a1ea4e",
                        "glosses": [
                            "To remove a branch or branches."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8bb04bb1-1f34-45d7-af9a-555147045851",
                                "sense_id": "471164ad-e1b4-304d-b421-4dbb69301419",
                                "text": "There is no tree admits of transplantation so well as the Elm, for a tree of twenty years growth will admit of a remove. Mr. Evelyn says, he has removed them twice as big as a man's waist ; but then they were totally disbranched, the top being left only intire […]"
                            },
                            {
                                "example_id": "3bf34073-c50c-45c0-bfc3-ae428004a463",
                                "sense_id": "471164ad-e1b4-304d-b421-4dbb69301419",
                                "text": "You have to disbud and disbranch your plants to get one bloom that is anywhere close to perfection."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd974a0d-e1ca-3848-a50a-548ea50e3ae4",
                        "entry_id": "cda03bce-2f35-34e1-994f-2c5aa4a1ea4e",
                        "glosses": [
                            "To tear away; to break off."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e32121cc-3f62-4906-b2a5-08c7564b8c76",
                                "sense_id": "dd974a0d-e1ca-3848-a50a-548ea50e3ae4",
                                "text": "She that herself will sliver and disbranch\nFrom her material sap, perforce must wither,\nAnd come to deadly use."
                            }
                        ]
                    }
