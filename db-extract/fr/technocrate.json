        "fr-extract.jsonl": [
            {
                "entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
                "word": "technocrate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "39e17fc9-5d76-4ccc-a7a2-7559ce2f6437",
                        "entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "technocrates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0543a98-6c88-3433-93f9-cac23d50ed05",
                        "entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
                        "glosses": [
                            "Expert technique qui détient le pouvoir. Note d’usage : Souvent péjoratif, les technocrates tendant à faire prévaloir les aspects techniques d’un problème sur les considérations sociales et humaines."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "30dcebec-7b66-470e-a90c-b45c99307718",
                                "sense_id": "c0543a98-6c88-3433-93f9-cac23d50ed05",
                                "text": "Les technocrates sont des hommes résolus qui travaillent sur des statistiques, et n’hésitent pas noyer une vallée par un lac dont la digue éclate l’année suivante ; à plonger une nation dans une monoculture qui la ruine en quelques semaines dès que le parasite efficace a décidé de s’y installer ; à supprimer, pour la faire fructifier, tous les buissons et les chemins creux d’une province pauvre, abandonnée désormais aux vents qui la transforment en désert."
                            },
                            {
                                "example_id": "bb4b0bf7-582c-4194-91a5-2d914f4ab979",
                                "sense_id": "c0543a98-6c88-3433-93f9-cac23d50ed05",
                                "text": "Les associations de protection des sites réclamèrent l’arasement, suivies sur ce point par le Ministre de l’Économie, Valéry Giscard d’Estaing, qui, en technocrate précis, demanda dans une lettre ouverte au Premier ministre que l’on bloquât la toise à cent mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "97900813-02fa-31a6-bbb3-2412ad4fa3e7",
                        "entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
                        "glosses": [
                            "Membre d’un mouvement social, initié par Howard Scott, qui défend l’adoption de la technocratie comme forme de gouvernement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1aac63e8-eaa2-46fa-b96f-14fe8f4f238f",
                        "source_entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
                        "target_lang_word": "technocrat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technocrat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a4c45d-ef95-3ecd-a622-029bf377734f",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "An advocate of technocracy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "An expert in some technology, especially one in a managerial or administrative role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e92ebdd3-2286-4daa-a04e-b308561234cf",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "Another by now trusted technocrat, d'Aguesseau, returned as Chancellor, initiating down to his death in 1751 landmark judicial reforms."
                                            },
                                            {
                                                "example_id": "fe70fb9c-a9d7-4129-932f-05a043c78f6d",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "Would the site’s community of decentralized, uncompensated editors continue to govern it according to its principles of openness, transparency, and neutrality, or would a handful of highly paid NGO technocrats re-orient Wikipedia toward endorsing and promoting the ever-shifting currents of the Western elite social justice regime?"
                                            },
                                            {
                                                "example_id": "1f42944b-e289-4f90-837f-b9980c7b4696",
                                                "sense_id": "1f13841a-5621-3fc3-863b-fea821fcc2b9",
                                                "text": "[Canadian Prime Minister Mark Carney]’s been able to sell himself as a no-nonsense technocrat who knows how to steer a crisis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94723fe-0cd7-3d23-a599-a67f67d982ab",
                                        "entry_id": "6b9185e7-570a-39bc-b0ac-70b3cbb5295f",
                                        "glosses": [
                                            "A person who makes decisions based solely on technical information and not personal or public opinion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d57eae9d-9ace-41eb-939d-a1c414d98581",
                        "source_entry_id": "282df9e4-508b-3706-8ef5-5c6949ab77a5",
