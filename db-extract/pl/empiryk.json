                    }
                ],
                "translations": [
                    {
                        "translation_id": "30a7b319-c902-47f2-8106-89cad1fa760e",
                        "source_entry_id": "38c830b0-40df-37bd-8adc-bf4a7ab4f0c8",
                        "source_sense_id": "8291dd9e-15a4-34d0-967b-6eb038027f18",
                        "target_lang_word": "empiric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empiric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90c2dfcf-90c2-338f-a9a3-3b517772c768",
                                        "entry_id": "b16ba5ee-d820-3745-bc9a-dc0203de283d",
                                        "glosses": [
                                            "Empirical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "empiric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb393b63-97f8-3acc-a829-66ce5455e6c4",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "A member of a sect of ancient physicians who based their theories solely on experience."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11f2e58b-f57b-3e4c-b63a-0d2c8870e05b",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "Someone who is guided by empiricism; an empiricist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "Any unqualified or dishonest practitioner; a charlatan; a quack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da81ec46-037f-4888-a549-fc14fb8dba6b",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "An empiric oftentimes, and a silly chirurgeon, doth more strange cures than a rational physician."
                                            },
                                            {
                                                "example_id": "1a3a4877-399b-4c85-8626-90033637ca70",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "[…] Paracelsus and some few other sooty Empiricks, rather then (as they are fain to call themselves) Philosophers, having their eyes darken'd, and their Brains troubl'd with the smoke of their own Furnaces, began to rail at the Peripatetick Doctrine, which they were too illiterate to understand […]"
                                            },
                                            {
                                                "example_id": "633c3aed-4303-4a6c-82d8-ac147a8bf65e",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "[…] and must therefore swallow down Opinions, as silly People do Empiricks['] Pills, without knowing what they are made of[…]"
                                            },
                                            {
                                                "example_id": "87061e60-65b3-4071-9621-16a083b35646",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "The fact is, that since a good, sound, honest, efficient, automatic, nonmetallic currency and standard was tampered with in 1893, India has been a happy hunting-ground for any empiric who conjured with a new scheme of currency, no matter how fantastic."
                                            },
                                            {
                                                "example_id": "cfe0f8a1-713a-4e55-bb93-8165936eeb36",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "To the disgust of doctors, the royal family at Versailles allowed one Brun, a wandering empiric […], to administer a proprietary ‘sovereign remedy’ to the ailing monarch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6259375d-41f0-4bdb-834d-a16c0ca8ba51",
                        "source_entry_id": "38c830b0-40df-37bd-8adc-bf4a7ab4f0c8",
                        "source_sense_id": "8291dd9e-15a4-34d0-967b-6eb038027f18",
                        "target_lang_word": "empirique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empirique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae19b0a-7675-3b0d-89d5-b8d569cc1f1d",
                                        "entry_id": "fab34497-9ffb-3b2f-bb2b-53a3b4a61896",
                                        "glosses": [
                                            "Fondé essentiellement sur l’expérience et l’observation, plutôt que sur l'usage de la raison abstraite (le rationalisme)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0508dfef-61d3-4881-a01f-38e3a0125a2a",
                                                "sense_id": "9ae19b0a-7675-3b0d-89d5-b8d569cc1f1d",
                                                "text": "Pour en revenir aux pratiques empiriques de nos anciennes pharmacopées, qui reposaient sur l'emploi de Matières médicales animales, j'aurai à vous dire, plus tard, certaines ressemblances curieuses que présentaient ces pratiques avec la méthode opothérapique moderne."
                                            },
                                            {
                                                "example_id": "efa346fd-7122-4de2-bbe7-7c5e5449f42e",
                                                "sense_id": "9ae19b0a-7675-3b0d-89d5-b8d569cc1f1d",
                                                "text": "Il semble au contraire que, dans l’épistémologie de la physique épicurienne, l'observation du monde, sa connaissance empirique, soit non seulement légitime, mais encore nécessaire."
                                            },
                                            {
                                                "example_id": "b1059e0d-cf74-4892-a51d-a88ae93184cf",
                                                "sense_id": "9ae19b0a-7675-3b0d-89d5-b8d569cc1f1d",
                                                "text": "Savoir reconnaître et différencier les différents champignons est un savoir très empirique qui demande temps, patience et conseils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "empirique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a64911f1-6a6f-3a78-b721-712da798bd6f",
                                        "entry_id": "869c13f4-7f1e-32ec-a6b7-5762636ba580",
                                        "glosses": [
                                            "Philosophe partisan du système de l’empirisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9075781a-aeb0-3b2a-8ba7-64963b6977df",
                                        "entry_id": "869c13f4-7f1e-32ec-a6b7-5762636ba580",
                                        "glosses": [
                                            "Praticien de méthodes empiriques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "425ef39b-2a8c-4401-b028-c24f53c86d39",
                                                "sense_id": "9075781a-aeb0-3b2a-8ba7-64963b6977df",
                                                "text": "J’envoie un médecin, un empirique qui m’appartient, au glorieux Cardinal, que les plus savants de Paris ont abandonné ; si vous vous entendez avec moi, il lui portera un remède universel et éternel."
                                            },
                                            {
                                                "example_id": "90b83a0a-d432-4201-93ed-8f7a0e64ef2e",
                                                "sense_id": "9075781a-aeb0-3b2a-8ba7-64963b6977df",
                                                "text": "Tout en s’extasiant sur la façon de conduire de notre compagnon, le maître de la voiture nous racontait ses petites affaires, et comme quoi il avait été guéri d’une maladie de foie par un empirique des plus singuliers. Cet empirique était un paysan du village de Lyss. Il demandait aux consultants leur nom, leur âge, et ne leur adressait, du reste, aucune question sur leur maladie."
                                            },
                                            {
                                                "example_id": "298a2b3b-1326-4265-8702-a7452768c782",
                                                "sense_id": "9075781a-aeb0-3b2a-8ba7-64963b6977df",
                                                "text": "D’ailleurs, en Anjou, les termes de mégeyeur, maige, empirique, hongreur, conjureur sont pratiquement synonymes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
