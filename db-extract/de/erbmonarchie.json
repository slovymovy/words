                "senses": [
                    {
                        "sense_id": "4db1b9b6-f16a-3bb1-aa80-6ade9884d493",
                        "entry_id": "dd66c9f1-ed20-3ec7-aa72-9fdfe8b46ee2",
                        "glosses": [
                            "Monarchie, deren Herrscher durch Erbfolge und nicht durch eine Wahl bestimmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "312494eb-c8ee-4aca-9d7b-31ba4789c133",
                                "sense_id": "4db1b9b6-f16a-3bb1-aa80-6ade9884d493",
                                "text": "„Die Erbmonarchie hat in Großbritannien überlebt, weil die lange Reihe der MonarchInnen [sic] sich fast immer bemüht hat, sich nicht in die Politik einzumischen und die eigene politische Meinung für sich zu behalten.“"
                            },
                            {
                                "example_id": "e3dc8be9-c513-4929-aa86-af25f0279802",
                                "sense_id": "4db1b9b6-f16a-3bb1-aa80-6ade9884d493",
                                "text": "„1660 wurde die Wahlmonarchie zugunsten einer Erbmonarchie ersetzt, dies wurde 1665 im neuen Königgesetz kodifiziert.“"
                            },
                            {
                                "example_id": "3a8e7370-fbf3-466c-b226-ffea96a13ad7",
                                "sense_id": "4db1b9b6-f16a-3bb1-aa80-6ade9884d493",
                                "text": "„Außerdem unterscheidet man auch noch zwischen einer Wahl- und einer Erbmonarchie und versteht unter ersterer eine solche, in welcher der Monarch gewählt wird, während bei der Erbmonarchie das Recht der Thronfolge erblich auf die Nachkommen des jedesmaligen Monarchen übergeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
