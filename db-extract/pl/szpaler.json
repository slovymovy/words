                    {
                        "sense_id": "ea0a5ba9-7480-313d-a477-b1816f4648ba",
                        "entry_id": "4a78ee25-a99a-3da0-abe3-5fd0a8bc6a65",
                        "glosses": [
                            "dwa równoległe szeregi ludzi tworzące korytarz służący jako przejście podczas różnych uroczystości"
