                "senses": [
                    {
                        "sense_id": "aa811f5f-3c50-3f45-a1e2-a73de547df9c",
                        "entry_id": "3f657ebe-6ee3-3a2c-a00e-0bcb04d913a2",
                        "glosses": [
                            "Avion équipé de deux réacteurs pour sa propulsion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4d308b-c86c-4fb1-9f95-ccd36515f343",
                                "sense_id": "aa811f5f-3c50-3f45-a1e2-a73de547df9c",
                                "text": "L’assemblage final des appareils sera assuré au site de Toronto, alors que la finition intérieure des biréacteurs aura lieu au Centre de finition Global de Bombardier, à Dorval."
                            },
                            {
                                "example_id": "7fd99443-bcf1-4b65-bad1-e31d201e9d3d",
                                "sense_id": "aa811f5f-3c50-3f45-a1e2-a73de547df9c",
                                "text": "Le programme du Dreamliner, un biréacteur long courrier dont le fuselage est composé à 50% de matériaux composites, a été entravé par des problèmes à répétition depuis son lancement en 2004, en grande partie à cause d’une répartition de la production sur plus d’une centaine de sites."
                            },
                            {
                                "example_id": "cef06b5e-a00d-46ae-8e8a-b7ac2ffd4526",
                                "sense_id": "aa811f5f-3c50-3f45-a1e2-a73de547df9c",
                                "text": "L’Alpha Jet, biréacteur biplace utilisé par la patrouille de France, sert à la formation des pilotes de chasse de l’armée de l’air à Tours et à Cazaux."
                            }
                        ]
                    }
