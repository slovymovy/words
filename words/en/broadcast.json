                            {
                                "target_lang_word": "вещательный",
                                "target_lang_sense_clarification": "связанный с телерадиовещанием"
                            },
                            {
                                "target_lang_word": "эфирный",
                                "target_lang_sense_clarification": "относящийся к эфиру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广播",
                                "target_lang_sense_clarification": "用于修饰媒体行业"
                            },
                            {
                                "target_lang_word": "电视",
                                "target_lang_sense_clarification": "用于修饰媒体行业"
