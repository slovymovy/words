{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "254f23f7-69d9-3609-adc3-9ab9ea937f9f",
                    "sense_definition": "To catch up with and pass a slower moving vehicle or person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should never try to <w>overtake</w> another vehicle on a dangerous narrow bend.",
                            "target_lang_translations": {
                                "tr": "Tehlikeli ve dar bir virajda asla başka bir aracı <w>sollamaya</w> çalışmamalısınız."
                            }
                        },
                        {
                            "text": "The sports car managed to <w>overtake</w> a slow truck on the highway easily.",
                            "target_lang_translations": {
                                "tr": "Spor araba, otoyolda yavaş giden kamyonu kolayca <w>sollamayı</w> başardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overtake a slow truck",
                        "overtake another vehicle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yavaş hareket eden bir araca veya kişiye yetişip onu geride bırakmak, geçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sollamak",
                                "target_lang_sense_clarification": "araçlar için"
                            },
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "geride bırakmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e15dfbbd-c52e-3cfb-8119-2d439026d8d6",
                    "sense_definition": "To become greater in amount, number, importance, or success than someone or something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Online news consumption will soon <w>overtake</w> traditional print media readership completely.",
                            "target_lang_translations": {
                                "tr": "İnternet üzerinden haber takibi yakında geleneksel basılı medya okurluğunu tamamen <w>geride bırakacak</w>."
                            }
                        },
                        {
                            "text": "Grocery sales in the north have <w>overtaken</w> those in the south this year.",
                            "target_lang_translations": {
                                "tr": "Kuzeydeki market satışları bu yıl güneydekileri <w>geçti</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overtake sales",
                        "overtake the market leader"
                    ],
                    "target_lang_definitions": {
                        "tr": "Miktar, sayı, önem veya başarı bakımından başka birini veya bir şeyi geride bırakmak, önüne geçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "üstünlük sağlamak, geride bırakmak"
                            },
                            {
                                "target_lang_word": "geride bırakmak",
                                "target_lang_sense_clarification": "başarı veya miktar olarak"
                            },
                            {
                                "target_lang_word": "önüne geçmek",
                                "target_lang_sense_clarification": "daha başarılı olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab0f3f2d-fed6-3dd1-a336-e158e009998e",
                    "sense_definition": "To happen unexpectedly and affect or overcome someone (such as a feeling, event, or misfortune).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A feeling of profound sadness began to <w>overtake</w> him as he watched the sunset.",
                            "target_lang_translations": {
                                "tr": "Gün batımını izlerken derin bir üzüntü hissi onu <w>kaplamaya</w> başladı."
                            }
                        },
                        {
                            "text": "Our original business plans were quickly <w>overtaken</w> by unexpected events.",
                            "target_lang_translations": {
                                "tr": "Orijinal iş planlarımız beklenmedik gelişmelerin gölgesinde <w>kaldı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overtaken by events",
                        "overtake with grief"
                    ],
                    "target_lang_definitions": {
                        "tr": "Beklenmedik bir şekilde gerçekleşip birini etkisi altına almak veya ele geçirmek (duygu, olay veya talihsizlik için)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kaplamak",
                                "target_lang_sense_clarification": "duygular için"
                            },
                            {
                                "target_lang_word": "bastırmak",
                                "target_lang_sense_clarification": "aniden etki altına almak"
                            },
                            {
                                "target_lang_word": "etkisi altına almak",
                                "target_lang_sense_clarification": "olaylar veya duygular için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d287664b-3135-361b-a576-101dc2ca6522",
                    "sense_definition": "An act or maneuver of catching up with and passing another moving object or vehicle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver made a risky <w>overtake</w> on the slippery road during the rainy race.",
                            "target_lang_translations": {
                                "tr": "Sürücü, yağmurlu yarış sırasında kaygan yolda riskli bir <w>sollama</w> yaptı."
                            }
                        },
                        {
                            "text": "There was not enough distance left before the sharp curve for a safe <w>overtake</w>.",
                            "target_lang_translations": {
                                "tr": "Keskin virajdan önce güvenli bir <w>geçiş</w> yapmak için yeterli mesafe kalmamıştı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "risky overtake",
                        "make an overtake"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hareket halindeki başka bir nesne veya araca yetişip onu geçme eylemi veya manevrası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "solla me",
                                "target_lang_sense_clarification": "trafikte sollama hareketi"
                            },
                            {
                                "target_lang_word": "geçiş",
                                "target_lang_sense_clarification": "önüne geçme eylemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}