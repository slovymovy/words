                "word": "xanthous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cc51e1e-74ae-3174-8fdc-1eca4531fe87",
                        "entry_id": "476208d6-86d1-3d5c-99f9-87097f8fe156",
                        "glosses": [
                            "Yellow-brown; yolk-colored."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0119358-5806-4ae5-9400-e9f102bbe4a6",
                                "sense_id": "9cc51e1e-74ae-3174-8fdc-1eca4531fe87",
                                "text": "Absorbent fatty xanthous histiocytes and xanthous granulations are observed in the marginal area of necrosis of the fatty tissue[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a7bd277d-a5b1-375a-bf2b-4c39f6d59bf0",
                        "entry_id": "476208d6-86d1-3d5c-99f9-87097f8fe156",
                        "glosses": [
                            "Pertaining to people with yellowish, red, auburn, or brown hair."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ab93598e-6fee-41ad-8717-e4f0ae4dc2cf",
                                "sense_id": "a7bd277d-a5b1-375a-bf2b-4c39f6d59bf0",
                                "text": "The xanthous variety springs up out of every black-haired race."
                            },
                            {
                                "example_id": "6badd896-1cf2-4aed-8e19-f3fb42c6149d",
                                "sense_id": "a7bd277d-a5b1-375a-bf2b-4c39f6d59bf0",
                                "text": "[…] the xanthous, or fair class, comprises those who have brown, auburn, yellow, flaxen, or red hair; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8301545-51ec-4fb1-9f55-24f5c3e9d628",
                        "source_entry_id": "476208d6-86d1-3d5c-99f9-87097f8fe156",
                        "source_sense_description": "yellow-brown",
                        "target_lang_word": "ocre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ocre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "286fcccf-7db2-3375-820c-69bacecd546d",
                                        "entry_id": "95338c3e-b3d5-345f-9ea3-2ef44c8c5b07",
                                        "glosses": [
                                            "Argile friable de couleur jaune, rouge ou brune suivant les oxydes, en particulier l’hydroxyde de fer et parfois d’oxyde de manganèse, qu’elle contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f92c9fb0-b187-4d55-9de6-99a54376aeb2",
                                                "sense_id": "286fcccf-7db2-3375-820c-69bacecd546d",
                                                "text": "En 1815, un habitant de Sauilly, hameau dépendant de la commune de Diges, découvrit une terre jaune, M. Cottih l’ayant reconnue pour ocre véritable, traita avec ce particulier, et fit exploiter cette nouvelle mine […]."
                                            },
                                            {
                                                "example_id": "3c4bffed-38c4-459e-b25f-1bff2d482cee",
                                                "sense_id": "286fcccf-7db2-3375-820c-69bacecd546d",
                                                "text": "C’est donc un panel de teintes terreuses, allant du noir au brun jusqu’au beige et à l’écru, passant par le camel et l’ocre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca389df8-dd5d-3e35-a2cd-7d23829e565b",
                                        "entry_id": "95338c3e-b3d5-345f-9ea3-2ef44c8c5b07",
                                        "glosses": [
                                            "Couleur, colorant à base d’argile. #CC7722"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc474ec-e9a7-4eaa-a9e0-6a830dcdda12",
                                                "sense_id": "ca389df8-dd5d-3e35-a2cd-7d23829e565b",
                                                "text": "Aussi, dès qu’un paysan a réalisé une minime aisance , fait-il badigeonner d’ocre la façade et les murs intérieurs de son réduit : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05624caf-ac7d-358f-9e4c-6974f3cb12aa",
                                        "entry_id": "95338c3e-b3d5-345f-9ea3-2ef44c8c5b07",
                                        "glosses": [
                                            "Couleur d’un brun tirant sur le jaune ou le rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b12f7927-d330-48ae-902d-b9f96a55764e",
                                                "sense_id": "05624caf-ac7d-358f-9e4c-6974f3cb12aa",
                                                "text": "Quand on parle de la couleur ocre (jaune ou rouge), et non de l’argile, on peut trouver indifféremment \"un ocre jaune\" ou \"une ocre jaune\", selon les auteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a6bcdca-9ba5-3550-bc87-d60cc98795dd",
                                        "entry_id": "95338c3e-b3d5-345f-9ea3-2ef44c8c5b07",
                                        "glosses": [
                                            "Nom donné à l'un des trois codon-stop. C'est le codon UAA."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09264f6c-2c49-463d-8a5c-b8c0ff0f4cd2",
                                                "sense_id": "8a6bcdca-9ba5-3550-bc87-d60cc98795dd",
                                                "text": "On s’attendait à trouver 20 codons. Or il y en a 61 et 3 non-sens : Ocre, Ambre et Azur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ocre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ca6702-7b22-399d-aaba-73e3f636fa82",
                                        "entry_id": "24e1b968-7bc3-3806-afaa-a93d35b53b73",
                                        "glosses": [
                                            "De la couleur de l’ocre brun de jaune à rouge. #CC7722"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "934db5cf-c985-4caf-97ba-9bc0052610a0",
                                                "sense_id": "a8ca6702-7b22-399d-aaba-73e3f636fa82",
                                                "text": "Le sol est de pavés ocre, de la couleur du sable des terrains de tennis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df3bdb12-7405-3495-a012-0f4be020661b",
                                        "entry_id": "24e1b968-7bc3-3806-afaa-a93d35b53b73",
                                        "glosses": [
                                            "Couleur de la robe d’un vin (blanc, rosé ou rouge) indiquant une maturité presque extrême, une oxydation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d6a661-1a8b-4267-9c39-f548ef0dfe8e",
                                                "sense_id": "df3bdb12-7405-3495-a012-0f4be020661b",
                                                "text": "La robe ocre de ce vin indique qu’il est trop vieux."
                                            }
                                        ]
                                    }
                                ]
                            },
