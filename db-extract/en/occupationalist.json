                        "entry_id": "d5141059-5a86-3457-bc16-2de4b8641105",
                        "glosses": [
                            "Providing benefits to people based on employment (as opposed to socialism, welfare, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d28532-6a53-459b-b1ef-75b4ba74acdd",
                                "sense_id": "0c032001-705a-3c45-b437-a380bf92d131",
                                "text": "Social Security, in accordance with the 'occupationalist approach', covers only persons engaged in the specified types of gainful activities."
                            },
                            {
                                "example_id": "6fa34ca4-0ef8-4682-8200-e3e8230bb8ee",
                                "sense_id": "0c032001-705a-3c45-b437-a380bf92d131",
                                "text": "The Italian pension system comprised more than 120 separate public pension funds for different sectors and categories of workers at its peak (Castellino 1976) and is therefore an unusually fragmented occupationalist system."
                            },
                            {
                                "example_id": "59e165b6-23e2-4665-8fbc-3c99b6bf81a6",
                                "sense_id": "0c032001-705a-3c45-b437-a380bf92d131",
                                "text": "These schemes are also occupationalist in nature and are primarily designed to protect workers in the event of work injury, sickness and maternity."
                            }
                        ]
                    }
                ],
