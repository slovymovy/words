                "senses": [
                    {
                        "sense_id": "1236eca5-f61c-369d-8c30-e5be75a7cf8a",
                        "entry_id": "d48b6db4-de81-3fbf-94bc-da079b7c7ad3",
                        "glosses": [
                            "sich platzend von etwas lösen (und abfallen)"
                        ],
                        "tags": [
                            "impersonal",
                            "intransitive",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ef6e643c-c6fc-47be-9a57-55cf449f1cb4",
                                "sense_id": "1236eca5-f61c-369d-8c30-e5be75a7cf8a",
                                "text": "„Er zeichnet ein Stück Erdrinde, wie es vor Jahrmillionen für sich vom übrigen abgeborsten sein mag.“"
                            },
                            {
                                "example_id": "f44502c7-ca6f-4abe-bfa5-7c120e59d51f",
                                "sense_id": "1236eca5-f61c-369d-8c30-e5be75a7cf8a",
                                "text": "„Und diese [Not] tritt nur in zweien Fällen ein: […] wo ein Deich in der Mitte, oder gegen die innere Böschung einen Riß bekommt, und ein Theil davon abbirst: da dann einem solchen Deiche, durch einen Fußdeich, die gehörige Steifigkeit, und Zusammenhaltung, wie einer geborstenen Mauer, durch Pfeiler, gegeben werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
