                ],
                "senses": [
                    {
                        "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                        "entry_id": "fc145258-2dac-3a52-8425-404100fd1122",
                        "glosses": [
                            "Pfarrerin, Geistliche"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "ae789976-aa45-45b4-9723-164600246c26",
                                "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                                "text": "„So, wenn die Pfäffin mir bei unserem ‹offenen Gespräch› […] erzählte, er habe ihr bei einer ersten Beichte gesagt, ICH hätte IHN verführt.“"
                            },
                            {
                                "example_id": "6764202a-2aaf-4f8a-929c-bf99cedb6b24",
                                "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                                "text": "„Du, Papa, auch wenn ich damals ziemlich klein war, ich weiß noch ganz genau, wie du die Typen aus der Regierung genannt hast: den Ministerpräsidenten hast du als einen hochgespülten Tierarzt bezeichnet und die Kultusministerin eine runterzuspülende Pfäffin.“"
                            },
                            {
                                "example_id": "1a7740bb-63ae-44ef-9a55-ed5906cc722a",
                                "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                                "text": "„Zunächst schwärmt er von seiner Pfäffin mit den Gurkensandwiches, und danach sagt er aus Schüchternheit kein einziges Wort mehr.“"
                            },
                            {
                                "example_id": "6682a340-21ef-410c-9837-098340586f8f",
                                "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                                "text": "„Ein gescheiter Anwalt, der den rechten Pfarrer Hintze und seine eigene pseudolinke Pfäffin Wagenknecht mit einem Augenzwinkern auf den gemeinsamen Nenner bringt, ist allemal für eine gelungene Pointe in den Medien gut.“"
                            },
                            {
                                "example_id": "6b68f13b-cd7a-4fb8-915d-756b5fbaba40",
                                "sense_id": "08faab0a-5a42-3e87-ac7f-c6f39ebb173c",
                                "text": "„Meinen Sie, der so genannte Pfarrer Nassmann hat an etwas geglaubt? Diese neue Generation von Pfäffinnen und Pfaffen. Die machen mit vierzehn ein Praktikum in einem Altersheim, und wenn sie an eine nette Dame geraten, dann entdecken sie die Nächstenliebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
