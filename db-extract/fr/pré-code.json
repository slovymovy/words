                        "glosses": [
                            "Période du cinéma hollywoodien qui se déroule avant l’instauration du Code Hays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af635570-9042-4c8f-bd46-65dd1dd465d3",
                                "sense_id": "cf062be2-dedb-3cc2-8058-c4813faa6eab",
                                "text": "Le code Hays est appliqué mollement entre 1930 et 1934 par le Studio Relations Committee (SRC) dirigé par Jason Joy, c’est le \"pré-code\"."
                            },
                            {
                                "example_id": "2572d877-dd3c-433a-8195-3b1ea93faa38",
                                "sense_id": "cf062be2-dedb-3cc2-8058-c4813faa6eab",
                                "text": "Une mise à l’honneur de longs-métrages datant de l’ère Pré-code (1929-1934), où un vent de liberté traversait l’industrie du cinéma américain."
                            }
                        ]
                    }
