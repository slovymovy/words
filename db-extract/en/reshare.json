                        "entry_id": "8aa693d4-e4bb-3601-a250-d807428b7a5c",
                        "glosses": [
                            "The act of sharing previously shared material again, so as to reach a further group of users."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "d151ca58-7a3a-4168-9584-fedafd290000",
                                "sense_id": "e2c17a8f-e813-3263-b0f1-b961b8d40ffc",
                                "text": "There are two types of reshares in Facebook: (a) link reshares and (b) content reshares."
                            },
                            {
                                "example_id": "a30ab8b2-e968-4a66-ae1d-a260c1bc83ba",
                                "sense_id": "e2c17a8f-e813-3263-b0f1-b961b8d40ffc",
                                "text": "The emphasis on boosting “meaningful social interactions” between friends and family meant that the feed leant towards reshared material, which was often misinformed and toxic. “Misinformation, toxicity and violent content are inordinately prevalent among reshares,” said internal research."
                            }
                        ]
                    }
