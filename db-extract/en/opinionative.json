                                "example_id": "fee6a8ac-e396-4a2a-b3fd-d8636d533ee8",
                                "sense_id": "01319edf-0d9e-35b5-bb02-fbe86912d5fa",
                                "text": "They were not only opinionative, peevish, covetous, morose, vain, talkative, but incapable of friendship, and dead to all natural affection."
                            },
                            {
                                "example_id": "a4b3e3eb-651d-4617-8c7d-49a99f9eb672",
                                "sense_id": "01319edf-0d9e-35b5-bb02-fbe86912d5fa",
                                "text": "He was a stout, squat figure, with a square face and broad black eyebrows, that announced him to be opinionative and disputatious."
                            }
                        ]
                    }
