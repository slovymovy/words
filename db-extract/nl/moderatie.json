                        "source_sense_id": "c7fde315-d54b-3da0-af99-ce3e238d0bc7",
                        "target_lang_word": "Mäßigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäßigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                        "entry_id": "1586fcb3-f54e-392b-a14b-e65121721351",
                                        "glosses": [
                                            "tugendhafte Eigenschaft Maß zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e43de43-7c3f-4d1d-8988-920f5f274989",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "Gerade bei Staatsdienern mit Vorbildfunktion sollte Mäßigung eine Grundtugend sein."
                                            },
                                            {
                                                "example_id": "63aba6d6-f9c4-44bc-8e8b-539b0aec9eed",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Die Idee der Mäßigung ist uralt.“"
                                            },
                                            {
                                                "example_id": "1310ad2f-ee81-4b68-b61a-90f66b93732a",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Es war bei aller scheinbaren Mäßigung und dem hohen Anstande des Sprechenden eine gewisse Heftigkeit und Bitterkeit des Gefühls zu bemerken, dem man es ansah, daß es Mühe kostete, den verbissenen Ingrimm zurückzuhalten.“"
                                            },
                                            {
                                                "example_id": "5d46f4be-7273-497f-9bb5-a93fcd358551",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Mäßigung ist der Anker des Lebens, sie verleiht uns Gleichgewicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4fe3333-d31f-458b-8dc8-7ec2b51a88de",
                        "source_entry_id": "51c1fb95-8b7a-33e8-a08e-6d11362212c2",
                        "source_sense_id": "c7fde315-d54b-3da0-af99-ce3e238d0bc7",
                        "target_lang_word": "moderation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moderation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The state or quality of being moderate; avoidance of extremes"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e84038c-44ec-47a2-9498-458216a68410",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "...It regulates and governs the Passions of the Mind, and brings them into due moderation and frame..."
                                            },
                                            {
                                                "example_id": "cf777ed3-3f6a-4215-8e1e-a80ac10c3a07",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "Mr. Chairman, at this moment I stand astonished at my own moderation!"
                                            },
                                            {
                                                "example_id": "40214534-ff55-4198-a690-1a7a9bf298bf",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "America is a model of force and freedom and moderation - with all the coarseness and rudeness of its people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "An instance of moderating: bringing something away from extremes, especially in a beneficial way"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efccf78-2695-490f-b209-5367c2697431",
                                                "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                                "text": "With the quick moderation of the weather some buying has appeared that had been held up because of the extremely cold weather […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The process of moderating a discussion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2d0ca-9554-4a71-b60c-ee7bc00de59e",
                                                "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                                "text": "The moderation of a large online forum can be hard work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ad9a2e-3e3f-3967-b4a0-c1549114c8af",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "Usage of neutron moderator to slow down neutrons in a nuclear reactor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5b00d29-b10e-44fb-b15d-9fa90fbc78f7",
                        "source_entry_id": "51c1fb95-8b7a-33e8-a08e-6d11362212c2",
                        "source_sense_id": "c7fde315-d54b-3da0-af99-ce3e238d0bc7",
                        "target_lang_word": "modération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Vertu qui porte à garder une sage mesure en toutes choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83c1690-c1ab-41ae-9505-0906ae2f9ae2",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Convenons-en, les exemples de bombance qui lui sont ici donnés ne sont pas faits pour lui inspirer des idées de modération."
                                            },
                                            {
                                                "example_id": "b6b2d813-4b77-438d-8315-530111306cb2",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Ce café, le dimanche, accompagnait parfois la traditionnelle tarte au riz belge que découvre sans modération le commissaire Maigret à Givet…"
                                            },
                                            {
                                                "example_id": "2d4800b0-4042-4966-bb45-6ae350c51199",
                                                "sense_id": "cd431cd3-cb4a-3b54-92b5-af89df519686",
                                                "text": "Même si les énoncés sont frelatés sur le plan scientifique, leur public associe la modération avec une posture savante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Retranchement, diminution d’un prix ou d’une taxe."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49bc316e-2dfb-433a-b7f7-41f2771c3572",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "La modération d’une contribution."
                                            },
                                            {
                                                "example_id": "6df5f204-4186-475b-94e4-9fdfd2bbf669",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "On ne lui a fait aucune modération."
                                            },
                                            {
                                                "example_id": "955ca41d-4c78-4f11-80e2-e4c2bec9ea13",
                                                "sense_id": "75103f78-2725-36a3-8f2b-ac98fc769d68",
                                                "text": "On ne lui accorde aucune modération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69aa9755-ff2c-3147-9a1c-a340d82181e0",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Adoucissement, mitigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84271ce5-65df-4103-be53-3bb5779b5101",
                                                "sense_id": "69aa9755-ff2c-3147-9a1c-a340d82181e0",
                                                "text": "La modération d’une peine, d’une amende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10efb278-4bd9-307d-ba4a-8bda63a96b83",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Présentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bea70a3-7152-4126-8358-838d4d479ba1",
                                                "sense_id": "10efb278-4bd9-307d-ba4a-8bda63a96b83",
                                                "text": "La modération du Journal 8h (Europe 1) par Eva Roque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                        "entry_id": "b9ff7376-52ca-3532-8e1a-0b27761d207c",
                                        "glosses": [
                                            "Conduite, direction, guidage, pilotage d'une discussion, d'une réunion, d'une séance, d'un congrès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502b8528-9756-4417-8a0d-d1d83224bc85",
                                                "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                                "text": "Modération par les utilisateurs. Autre différence majeure : la modération n'est pas verticale mais horizontale. Comme sur Wikipédia, les utilisateurs ont la possibilité d'intervenir directement pour modifier un contenu, un moyen selon lui (Jimmy Wales) d'encourager les comportements vertueux."
                                            },
                                            {
                                                "example_id": "e3422e70-f910-45a4-baaf-a45c7f21ec8c",
                                                "sense_id": "b8c967a5-8e74-3ed9-9f3f-512603fb39b2",
                                                "text": "Ils devraient en particulier inclure des renseignements ayant trait aux politiques, procédures, mesures et outils utilisés à des fins de modération des contenus, y compris la prise de décision fondée sur des algorithmes et le réexamen par un être humain ainsi que le règlement intérieur de leur système interne de traitement des réclamations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
