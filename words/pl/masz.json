                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ile <masz> lat i gdzie mieszkasz?",
                            "target_lang_translations": {
                                "ru": "Сколько <тебе> лет и где ты живешь?",
                                "en": "How old <are you> and where do you live?",
                                "nl": "Hoe oud <ben je> en waar woon je?",
                                "de": "Wie alt <hast> du und wo wohnst du?",
                                "fr": "Quel âge <as-tu> et où habites-tu ?",
                                "it": "Quanti anni <hai> e dove abiti?",
                                "cs": "Kolik <máš> let a kde bydlíš?",
                                "tr": "Kaç yaşındasın (<w>sahipsin</w>) ve nerede yaşıyorsun?",
                                "es": "¿Cuántos años <tienes> y dónde vives?",
                                "zh": "你<w>有</w>多少岁了，住在哪里？"
                            }
                        },
                        {
                            "text": "Czy <masz> ochotę pójść dzisiaj do kina?",
                            "target_lang_translations": {
                                "ru": "<Хочешь> ли ты пойти сегодня в кино?",
                                "en": "<Do you feel like> going to the cinema today?",
                                "nl": "<Heb je> zin om vandaag naar de bioscoop te gaan?",
                                "de": "Hast du Lust, heute ins Kino zu gehen?",
                                "fr": "<As-tu> envie d'aller au cinéma aujourd'hui ?",
                                "it": "<Hai> voglia di andare al cinema oggi?",
                                "cs": "Máš <chuť> jít dnes do kina?",
                                "tr": "Bugün sinemaya gitmeye <w>istekli misin</w>?",
                                "es": "¿<Tienes> ganas de ir al cine hoy?",
                                "zh": "你今天<w>有</w>兴趣去看电影吗？"
                            }
                        }
                    ],
                    "common_phrases": [
