                "senses": [
                    {
                        "sense_id": "2f0660b5-2578-3b09-9f7a-504ba05d3494",
                        "entry_id": "eca4c239-154e-3fd0-9da8-667361ee076c",
                        "glosses": [
                            "Exkremente von Fliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e8b16c9-9056-4d2d-abf0-93e090f2160a",
                                "sense_id": "2f0660b5-2578-3b09-9f7a-504ba05d3494",
                                "text": "„Es musste ein Alb der Perversheit sein, der Wally Gilman jede Nacht aufs Neue zu den mit Fliegendreck befleckten und von Zigarettenrauch verfärbten Fenstern hinzog.“"
                            },
                            {
                                "example_id": "c5961027-892e-440e-9145-d8990aa7bc52",
                                "sense_id": "2f0660b5-2578-3b09-9f7a-504ba05d3494",
                                "text": "„Und indem man die Wand eines angrenzenden leeren Büros durchbohrte, gelang es, eine kleine Kamera in die Wand zu setzen - nicht größer und nicht auffälliger als ein Fliegendreck -, die ausgezeichnete Aufnahmen machte.“"
                            },
                            {
                                "example_id": "a4bf48f0-bf4c-4903-b495-f74b8094a6e6",
                                "sense_id": "2f0660b5-2578-3b09-9f7a-504ba05d3494",
                                "text": "„Die Diplome an der grün gekachelten Wand des Untersuchungszimmers sind vergilbt, ganz verschwommen hinter dem Glas. Voller Wasserflecken. Und Fliegendreck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
