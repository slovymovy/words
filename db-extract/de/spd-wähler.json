                ],
                "senses": [
                    {
                        "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                        "entry_id": "1118df85-4e0f-3656-83cc-c1ad08ccd7fd",
                        "glosses": [
                            "Person, die bei einer Wahl für die Sozialdemokratische Partei Deutschlands (SPD) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e418011c-937e-418d-ad19-505590ff655d",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "Sein Vater war schon immer ein überzeugter SPD-Wähler."
                            },
                            {
                                "example_id": "2a68d584-6da4-49f9-ab3b-2d56dc0d4f83",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "[„Hartz IV“ wird die Grundsicherung für Arbeitssuchende genannt.] „Sie ist Teil der ‚Agenda 2010‘, die 2003 unter dem damalige SPD-Bundeskanzler Gerhard Schröder eingeführt wurde und mit der noch immer Parteimitglieder und SPD-Wähler hadern.“"
                            },
                            {
                                "example_id": "0de355fd-6cd0-4095-9071-4db4d4e020a8",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Ich sagte das immer schlechtere Abschneiden der SPD bei allen Wahlen der letzten Jahre voraus. Gestützt auf meine These, dass SPD-Wähler nicht blöd sind und nicht vergessen haben, wer ‚Hartz IV‘ erfunden hat.“"
                            },
                            {
                                "example_id": "35596e35-9198-4aef-a15b-8f2a323ae450",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Inzwischen leben über 19 Millionen Menschen mit Migrationshintergrund in Deutschland – Tendenz steigend. […] Alles potentielle SPD-Wähler, die ‚von einem sozialen, gerechten und solidarischen Deutschland Träumen‘, glaubt der Berliner SPD-Politiker Saleh.“"
                            },
                            {
                                "example_id": "3fcf89d0-a206-40f9-9abf-5253f4f6561a",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„»Das ist ein müder Haufen, denen fehlt jedes Funkeln, denen fehlen neue Gedanken«, sagt Wolfgang Meller. Er war mal überzeugter SPD-Wähler.“"
                            },
                            {
                                "example_id": "bd294fbd-04eb-47cb-a66b-5b3d1ab1485e",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Selbst bei einem früher ureigenen sozialdemokratischen Thema, der sozialen Gerechtigkeit, spricht nur noch ein knappes Drittel der SPD-Wähler ihrer Partei tatsächliche Kompetenz zu.“"
                            },
                            {
                                "example_id": "0596cf79-81a6-4869-8daa-cfc2753002b9",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Auch die SPD-Wähler sind gespalten – und zwar in der Frage, ob die Sozialdemokraten noch einmal als kleinerer Partner in eine große Koalition gehen sollten oder in die Opposition.“"
                            },
                            {
                                "example_id": "0eb946d8-41ef-4bc6-9a00-0b2245883a49",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Auch bei den Partei-Anhängern sprechen sich nur 16 Prozent der SPD-Wähler für das EU-Abkommen mit Kanada aus.“"
                            },
                            {
                                "example_id": "d8227a1c-8efb-45ea-9170-c52735b347af",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„[…] 59 Prozent der SPD-Wähler könnten sich grundsätzlich vorstellen, die Grünen zu wählen.“"
                            },
                            {
                                "example_id": "692c8e07-4969-4b8b-bf1e-1fe73294631d",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„[…] Selbst SPD-Wähler bevorzugen Habeck statt Scholz, auch FDP-Wähler wären am ehesten für den Grünen-Politiker.“"
                            },
                            {
                                "example_id": "32ff3c3f-17fe-4b3c-a584-584ec179fdf5",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Zugleich fällt es dem Seehofer-Kabinett schwerer, außerhalb der eigenen Reihen zu punkten: Unter den SPD-Wählern halten sich Zustimmung und Ablehnung aktuell etwa die Waage (52 zu 48 Prozent), […].“"
                            },
                            {
                                "example_id": "3b6b4bc5-8804-4058-93bc-78b2036d3080",
                                "sense_id": "92d082f0-3b60-300b-a81a-cb26651861b6",
                                "text": "„Auffällig viele ehemalige SPD-Wähler entschieden sich 2015 […] für die CDU.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
