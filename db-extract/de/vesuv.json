                    },
                    {
                        "translation_id": "18cfe4c2-504e-46b4-a8d9-42dc89dd25f6",
                        "source_entry_id": "e373ada9-5a4b-3106-931d-06e166deb7d0",
                        "source_sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                        "source_sense_description": "aktiver Schichtvulkan in der Nähe der Stadt Neapel",
                        "target_lang_word": "Vésuve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vésuve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Volcan d’Italie qui domine la baie de Naples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "408f6d9b-ee74-447a-865a-3bf7e29c5237",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "L’inscription retrouvée dans une maison prouve que la ville n’a pas été détruite par le Vésuve le 24 août 79, mais deux mois plus tard."
                                            },
                                            {
                                                "example_id": "aecbd138-12ab-496a-af72-b13ab3eb4e67",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "Je voyageois en Italie : arrivé à Naples, je m’empressai de visiter ce fameux Vésuve, dont la première éruption éclata, selon quelques auteurs, sous l’empereur Titus, l’an soixante-dix-neuf de notre ère, et coûta la vie au célèbre Pline."
                                            },
                                            {
                                                "example_id": "4179d535-8c74-4f4c-96c4-86ae2bc353e0",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "Faut-il étudier l’homme assagi, endormi sous la cendre, — ou, comme fit Pline l’Ancien pour le Vésuve, s’approcher de lui dans son jeune temps, alors qu’il jette sa lave et son feu ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76533514-e463-356f-b817-6c9245d61fc9",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Chose qui explose, qui déborde."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "360723a0-6dc2-4f8b-b7e6-a98fcb53656f",
                                                "sense_id": "76533514-e463-356f-b817-6c9245d61fc9",
                                                "text": "Coupe Balzac, deux boules chocolat, une boule framboise, arrosé de notre chocolat et un Vésuve de crème Chantilly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78fb23f2-750b-37b1-be0d-19a6012da275",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Ville en révolution."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e49f36-b621-4ea3-9710-e41d0f9bd57e",
                                                "sense_id": "78fb23f2-750b-37b1-be0d-19a6012da275",
                                                "text": "Et de quel air les rois, à l’instant où nous sommes,\nRegardent bouillonner dans ce Vésuve d’hommes\nLa lave des événements !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
