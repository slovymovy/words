                ],
                "senses": [
                    {
                        "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                        "entry_id": "cc848e31-e79a-39b2-a0a2-489bad0b4656",
                        "glosses": [
                            "Kongress, auf dem sich Gewerkschaftsmitglieder treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e641c8b8-531c-460b-801c-ae643885b9c2",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Diesen Anspruch haetten sie mit ihrem Blut bezahlt, hiess es in der Schlusserklärung des internationalen Gewerkschaftskongresses 1916 im englischen Leeds[.]“"
                            },
                            {
                                "example_id": "c8879e4c-0586-48fb-b0f4-189394877dc5",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„‚Die Vorteile sind offensichtlich‘, betont VHTL-Noch-Präsidentin Rita Gassmann, die ihr Mandat am Gewerkschaftskongress vom 27. Juni abgibt.“"
                            },
                            {
                                "example_id": "9c184cdf-8b3e-41ed-b3fc-a0eb6808a2ae",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Weitere Themen vom Gewerkschaftskongress in Frankfurt am Main waren die rasanten Veränderungsprozesse in Wirtschaft, Gesellschaft und Politik.“"
                            },
                            {
                                "example_id": "e3956561-d380-4858-8f61-e2e06c9a8641",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Das wird ihm auf dem Parteitag sowie diversen Gewerkschaftskongressen viel Zustimmung bringen.“"
                            },
                            {
                                "example_id": "a7b06734-4cd5-4d08-90ca-7eba0d803c8b",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Der gleichentags in Bern abgehaltene Gewerkschaftskongress erhob die Vision schliesslich zum Programm[.]“"
                            },
                            {
                                "example_id": "a1160052-6c01-4bfe-bbd8-ed9b3b0cf4e7",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Der Bezirksjugendausschussvorsitzende der IGBCE, Roberto Puzio, und der 2. Vorsitzende Andreas Isecke blickten am Rande des Gewerkschaftskongresses in Hannover auf ‚sieben Jahre erfolgreiche Jugendarbeit zurück‘.“"
                            },
                            {
                                "example_id": "6b22204c-161f-4978-aeb7-9af9fccd8645",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Ich glaube, ihn hat gestört, dass mich Benya als Hauptredner zum Gewerkschaftskongress eingeladen hat.“"
                            },
                            {
                                "example_id": "55294a13-d0e7-47f3-9de2-e3f883e28119",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Walter ist seit anderthalb Jahren kommissarischer Regionsgeschäftsführer des Deutschen Gewerkschaftsbunds (DGB) in Ostbrandenburg und soll an diesem Samstag bei einem Gewerkschaftskongress regulär gewählt werden.“"
                            },
                            {
                                "example_id": "c97bf16c-8430-4e6a-ab3c-fcd9ce0d69a4",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Auf einem Gewerkschaftskongress versuchte der frühere US-Vizepräsident die Zuhörer davon zu überzeugen, dass er der Mann sei, der hart arbeitenden Amerikanern wieder eine Stimme verschaffen werde.“"
                            },
                            {
                                "example_id": "01e007e2-9957-4780-bd32-ec2837e07ad1",
                                "sense_id": "e17cff3b-2bd3-3711-8ad1-a7690f945a59",
                                "text": "„Es dürfte also eigentlich ein eher ruhigerer Gewerkschaftskongress werden – wäre da nicht der Krieg in der Ukraine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
