            {
                "entry_id": "f4d3fd39-9981-31fa-9b0f-a724b958eeaa",
                "word": "hurst",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "31f1388e-b57d-40f2-a27e-b3c7c3073562",
                        "entry_id": "f4d3fd39-9981-31fa-9b0f-a724b958eeaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "hursts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                        "entry_id": "f4d3fd39-9981-31fa-9b0f-a724b958eeaa",
                        "glosses": [
                            "A wood or grove."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67d2d7e4-a0e3-46f0-833f-7e77de9b8f47",
                                "sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                                "text": "A blackthorn seedling can in this way expand into a hurst of 0,1-0, 5 ha in the space of 10 years, […]"
                            },
                            {
                                "example_id": "8957865d-3382-4114-8d40-b82edc5558b2",
                                "sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                                "text": "Where, to her neighboring Chase, the curteous Forrest show’d\nSo just conceived joy, that from each rising a hurst,\nWhere many a goodlie Oake had carefullie been nurst,"
                            },
                            {
                                "example_id": "9ff6f8c7-c9c3-47ac-b06c-c74a757f646f",
                                "sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                                "text": "‘How you grandiloquise. A forest of uncertainty. But there – I slow down, as you say. I hesitate. I wonder if – no , let’s try further down. I cannot see the hurst for the elms.’"
                            },
                            {
                                "example_id": "a0516aaa-09a2-4f22-a920-6f13bd90641c",
                                "sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                                "text": "A recognizable world seems to balloon up out of the names […]. Lovehurst down in the clay lands towards Staplehurst means \"the hurst that was left to someone in a will\": Legacy Wood. Its near neighbor, Tolehurst, originally called Tunlafahirst, means something like Heir's Farm Wood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57ec8a75-d471-402b-b378-5c8922bde445",
                        "source_entry_id": "f4d3fd39-9981-31fa-9b0f-a724b958eeaa",
                        "source_sense_id": "21fb519e-e2aa-3144-a172-cbace16477c0",
                        "source_sense_description": "a wood or grove",
                        "target_lang_word": "horst",
