                    {
                        "translation_id": "14883001-1939-454c-8d90-6fde29e03f46",
                        "source_entry_id": "317d3148-1a6a-37ce-93ca-cbb87db58ded",
                        "source_sense_id": "4ca00c61-e1bc-3300-9d3f-f10169b36ad1",
                        "source_sense_description": "crazy, mad, senseless, insane",
                        "target_lang_word": "meschugge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meschugge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                        "entry_id": "f12cf187-6ffa-3855-b2c2-67a1cf51756f",
                                        "glosses": [
                                            "nicht bei Verstand, verrückt"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ce5722-1627-47c3-b210-6da7d0c346b1",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„In Deinem Lehnstuhl regiertest Du die Welt. Deine Meinung war richtig, jede andere war verrückt, überspannt, meschugge, nicht normal.“"
                                            },
                                            {
                                                "example_id": "ad4fb9eb-0894-4427-8aff-3becfa64c77d",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Solln se lieber die Steuern gerecht verteilen, das wär mehr im Sinne des Verstorbenen gewesen! Fräulein! Wer sperrt das Telephon ab, wenn ich mal nicht mehr bin? Kein Mensch! Meschugge, das Telephon abzusperren!“"
                                            },
                                            {
                                                "example_id": "b47809c2-8369-406e-b7f5-5dc3cbd2f1a7",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„»Meschugge ist Trumpf,« dachte Eri, als sie in ihr Zimmer zurückging. Lore Wellenheimer … Die berühmte Lore Wellenheimer … Sie war darüber von Herzen belustigt.“"
                                            },
                                            {
                                                "example_id": "b9531d01-5fcc-4677-ae2f-955a7abb2685",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Schließlich war die Otti ganz meschugge geworden, sie war zur Polizei gelaufen und hatte den eigenen Mann wegen Mordes am Sohn angezeigt.“"
                                            },
                                            {
                                                "example_id": "ca055c21-4226-4348-9066-c51a8e4559ba",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Der meschuggene Edward erklärte dem Kaiser, dass dieses uralte Buch das Geheimnis der Unsterblichkeit enthielte.“"
                                            },
                                            {
                                                "example_id": "9b0331f2-a6a5-4f67-8445-29791e6efd2f",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Der meschuggene Motorradfahrer und das Kind sind bald die einzigen Menschen auf der Straße.“"
                                            },
                                            {
                                                "example_id": "d72dc74b-1abe-4ceb-a08f-874acf210d5c",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Gennat, der sein Pulver allmählich verschossen hatte und auch mit seiner korpulenzbedingten Kurzatmigkeit kämpfte, winkte genervt ab. ›Alle. Jeder. Der meschuggene Komponist und dieser Lackmeister und …‹“"
                                            },
                                            {
                                                "example_id": "622b4e97-c7ea-4e95-998f-df53e705b5fe",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Das aber, sagt der meschuggene Rosenfeld, liegt nur an der Mamme, die dem Kleinen – grad mal dreijährig – ein fieses Trauma unterschob.“"
                                            },
                                            {
                                                "example_id": "60b2af3c-2fb2-4552-9202-2e7907978551",
                                                "sense_id": "449d986a-ca07-3b00-b936-e4ab033795c4",
                                                "text": "„Wüllner hatte zu seiner Ältesten keinen Zugang, mühte sich nicht um sie, sie sei eine meschuggene Schnepfe und werde, ereignete sich nicht ein Wunder, vor die Hunde gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
