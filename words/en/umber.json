{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6708ef8-de12-3b9a-a60e-2620e8efb7ec",
                    "sense_definition": "A natural brown clay pigment that contains iron and manganese oxides, darker than ochre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pigment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed raw <w>umber</w> with white to capture subtle shadows in the portrait.",
                            "target_lang_translations": {
                                "es": "El artista mezcló <w>tierra de sombra natural</w> con blanco para capturar sombras sutiles en el retrato."
                            }
                        },
                        {
                            "text": "He bought a tube of burnt <w>umber</w> to paint the wooden fence.",
                            "target_lang_translations": {
                                "es": "Compró un tubo de <w>tierra de sombra tostada</w> para pintar la valla de madera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burnt umber",
                        "raw umber"
                    ],
                    "target_lang_definitions": {
                        "es": "Pigmento natural de arcilla marrón que contiene óxidos de hierro y manganeso, más oscuro que el ocre."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tierra de sombra",
                                "target_lang_sense_clarification": "pigmento marrón natural"
                            },
                            {
                                "target_lang_word": "sombra",
                                "target_lang_sense_clarification": "nombre abreviado del pigmento en pintura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d0a078b-3cea-3d67-a44f-f016bf6afe3c",
                    "sense_definition": "A medium-sized brown wading bird of sub-Saharan Africa, also known as the hamerkop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An African <w>umber</w> perched silently by the shallow edge of the river.",
                            "target_lang_translations": {
                                "es": "Un <w>pájaro martillo</w> africano se posó en silencio en la orilla poco profunda del río."
                            }
                        },
                        {
                            "text": "Birdwatchers gathered near the marsh hoping to spot an <w>umber</w> building its massive nest.",
                            "target_lang_translations": {
                                "es": "Los observadores de aves se reunieron cerca del pantano con la esperanza de ver a un <w>pájaro martillo</w> construyendo su enorme nido."
                            }
                        }
                    ],
                    "synonyms": [
                        "hamerkop"
                    ],
                    "target_lang_definitions": {
                        "es": "Ave zancuda marrón de tamaño mediano del África subsahariana, también conocida como pájaro martillo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pájaro martillo",
                                "target_lang_sense_clarification": "ave zancuda (Scopus umbretta)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8699ba16-6743-38a4-8baf-f0b10081f694",
                    "sense_definition": "A grayling fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to catch a small <w>umber</w> in the cold mountain stream.",
                            "target_lang_translations": {
                                "es": "Logró pescar un pequeño <w>tímalo</w> en el frío arroyo de montaña."
                            }
                        },
                        {
                            "text": "The local anglers referred to the freshwater grayling as an <w>umber</w>.",
                            "target_lang_translations": {
                                "es": "Los pescadores locales se referían al tímalo de agua dulce como un <w>tímalo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grayling"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically or dialectally for grayling"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tímalo, pez de agua dulce."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tímalo",
                                "target_lang_sense_clarification": "pez de agua dulce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07af5cc5-617d-30c0-b377-b2fd2d79688a",
                    "sense_definition": "Alternative form of <w>umbrere</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight raised the <w>umber</w> of his helmet to look upon the battlefield.",
                            "target_lang_translations": {
                                "es": "El caballero levantó la <w>visera</w> de su yelmo para contemplar el campo de batalla."
                            }
                        },
                        {
                            "text": "Damage to the steel <w>umber</w> obscured the warrior's vision.",
                            "target_lang_translations": {
                                "es": "Los daños en la <w>visera</w> de acero dificultaban la visión del guerrero."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical armor terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Visera o parte móvil de un yelmo medieval que protegía los ojos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "visera",
                                "target_lang_sense_clarification": "de un yelmo medieval"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c8b646b-5306-321b-93ec-eda634de7548",
                    "sense_definition": "Having a dark reddish-brown colour like that of the pigment umber.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pigment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hair gleamed with rich <w>umber</w> tones under the warm sunlight.",
                            "target_lang_translations": {
                                "es": "Su cabello brillaba con intensos tonos <w>pardo oscuros</w> bajo la cálida luz del sol."
                            }
                        },
                        {
                            "text": "The autumn leaves shifted from bright gold to deep <w>umber</w> shades.",
                            "target_lang_translations": {
                                "es": "Las hojas otoñales pasaron de un dorado brillante a tonos <w>marrón sombra</w> profundos."
                            }
                        }
                    ],
                    "synonyms": [
                        "brownish",
                        "reddish-brown"
                    ],
                    "target_lang_definitions": {
                        "es": "De color marrón rojizo oscuro similar al del pigmento tierra de sombra."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "marrón sombra",
                                "target_lang_sense_clarification": "color marrón oscuro o rojizo"
                            },
                            {
                                "target_lang_word": "pardo oscuro",
                                "target_lang_sense_clarification": "color amarronado oscuro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3797d8e4-df25-334c-ba99-fb2a8d9ea6de",
                    "sense_definition": "To colour, shade, or darken with reddish-brown pigment or shadows.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pigment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick evening shadows began to <w>umber</w> the quiet valleys below.",
                            "target_lang_translations": {
                                "es": "Espesas sombras vespertinas comenzaron a <w>ensombrecer</w> los tranquilos valles de abajo."
                            }
                        },
                        {
                            "text": "The smoke slowly drifted across the horizon, <w>umbering</w> the setting sun.",
                            "target_lang_translations": {
                                "es": "El humo avanzó lentamente por el horizonte, <w>oscureciendo</w> el sol poniente."
                            }
                        }
                    ],
                    "synonyms": [
                        "darken"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "chiefly literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Colorear, sombrear u oscurecer con tonos pardos o sombras."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ensombrecer",
                                "target_lang_sense_clarification": "oscurecer con sombras"
                            },
                            {
                                "target_lang_word": "empardar",
                                "target_lang_sense_clarification": "teñir o tornar de color pardo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}