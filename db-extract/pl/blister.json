                    },
                    {
                        "translation_id": "4bcfc153-6a63-49e4-bd08-43ae326eaef8",
                        "source_entry_id": "e2e4407e-27bb-3022-a45b-5f00a2160102",
                        "source_sense_id": "fd963160-f89b-3f8b-b2c3-02bf41dcca55",
                        "target_lang_word": "Blister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78956151-98a6-39f2-975c-5b9a6d09dd7e",
                                        "entry_id": "b1666c68-d043-30c4-b145-3117b071760c",
                                        "glosses": [
                                            "verkaufsfördernde Verpackung von Waren, die über einer Rückwand aus bedrucktem Karton mit einer durchsichtigen Folie aus Kunststoff umschlossen werden"
                                        ],
                                        "tags": [
                                            "Handel",
                                            "Marketing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6a87c6-0558-4753-846c-9973dc126319",
                                                "sense_id": "78956151-98a6-39f2-975c-5b9a6d09dd7e",
                                                "text": "Blister aus verschweißtem Plastik sind ohne Schneidewerkzeuge nicht aufzubekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "230fa073-57bd-3a4c-bfe1-ff9cf61522d5",
                                        "entry_id": "b1666c68-d043-30c4-b145-3117b071760c",
                                        "glosses": [
                                            "einzeln, auch undurchsichtig verpackte Tabletten, die durch eine Rückwand aus Aluminium gedrückt werden können"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cd242e1-02a3-4317-b9d8-54fba081648a",
                                                "sense_id": "230fa073-57bd-3a4c-bfe1-ff9cf61522d5",
                                                "text": "Und bei Medikamenten hilft auch etwas verblüffend Einfaches: \"Viele Pharmafirmen verpacken Schmerzmittel seit kurzem in Blister (Folien, aus denen man die Pillen herausdrücken muss) und nicht mehr in leichter zugängliche Flaschen\", erklärt die WHO: \"Das hatte einen signifikanten Einfluss.\""
                                            },
                                            {
                                                "example_id": "70dce5cd-4394-46a1-987f-6b6856dc4569",
                                                "sense_id": "230fa073-57bd-3a4c-bfe1-ff9cf61522d5",
                                                "text": "Patienten sollten sie daher auch dann nicht aus dem sogenannten Blister drücken, wenn sie die Pillen in Dosierschachteln sortieren. Es sei besser, die benötigten Stückzahlen vom Blister abzuschneiden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b2afd740-f895-3675-a641-a90f98d9ef3d",
                                        "entry_id": "b1666c68-d043-30c4-b145-3117b071760c",
                                        "glosses": [
                                            "großes, bauchiges, asymmetrisch dreieckiges Vorsegel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60c774c-c190-4c1e-b39f-a567544b6de0",
                                                "sense_id": "b2afd740-f895-3675-a641-a90f98d9ef3d",
                                                "text": "Um den Vortrieb auf Vorwindkursen zu verbessern, nimmt man gerne den Blister, ein Segel mit viel Fläche und sehr leichtem Material, das ohne Baum gefahren wird."
                                            },
                                            {
                                                "example_id": "4e70ff89-bd4f-4d7b-b4b9-ba16f9724043",
                                                "sense_id": "b2afd740-f895-3675-a641-a90f98d9ef3d",
                                                "text": "Vom Rudergänger ist große Aufmerksamkeit und Feinfühligkeit gefordert, um den Kurs möglichst genau vor dem Wind zu halten und den Blister nicht einfallen zu lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
