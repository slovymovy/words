        "fr-extract.jsonl": [
            {
                "entry_id": "0205fc34-21c9-39de-bbd5-9593dcab7a26",
                "word": "ci-devant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f498193d-4b5a-3b8b-b3a5-848670cce5d4",
                        "entry_id": "0205fc34-21c9-39de-bbd5-9593dcab7a26",
                        "glosses": [
                            "Ancien."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ecf2c5-71d8-478a-b078-cdc5f2292b74",
                                "sense_id": "f498193d-4b5a-3b8b-b3a5-848670cce5d4",
                                "text": "C’étaient, bien au contraire, des ci-devant malades que le saint avait guéris miraculeusement et qui, en reconnaissance, venaient le servir ainsi chaque année."
                            },
                            {
                                "example_id": "8c076b65-15a1-4eba-ae62-691625349e35",
                                "sense_id": "f498193d-4b5a-3b8b-b3a5-848670cce5d4",
                                "text": "Elle a des couilles au cul, la ci-devant fille à papa, comme son père. Sainte Geneviève et Jeanne Hachette peuvent aller se rhabiller."
                            }
                        ]
                    },
                    {
                        "sense_id": "2628d572-390f-32f8-9d8f-e494cf144f64",
                        "entry_id": "0205fc34-21c9-39de-bbd5-9593dcab7a26",
                        "glosses": [
                            "Qualifiait les nobles déchus de leurs titres par la Révolution."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "046a8bd2-bc36-424f-b163-41cbbb381772",
                                "sense_id": "2628d572-390f-32f8-9d8f-e494cf144f64",
                                "text": "Bientôt la voiture […] s’arrêta devant l’hôtel antique où demeurait la ci-devant comtesse de Listomère-Landon."
                            },
                            {
                                "example_id": "6816fa08-b5f8-4389-8f27-5d3810ec71f8",
                                "sense_id": "2628d572-390f-32f8-9d8f-e494cf144f64",
                                "text": "« Mauvais ! Le nom du ci-devant roi n’est pas effacé, mauvais, mauvais, cela ! »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d2873c91-9fd8-3543-af9b-b78790fa194f",
                "word": "ci-devant",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d5251f0-b883-32da-b0a5-d2927d7b3fde",
                        "entry_id": "d2873c91-9fd8-3543-af9b-b78790fa194f",
                        "glosses": [
                            "Précédemment ; ci-dessus."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1616882e-3b7c-4581-b1c6-6680f0934b42",
                                "sense_id": "8d5251f0-b883-32da-b0a5-d2927d7b3fde",
                                "text": "Comme nous avons dit ci-devant."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a662981-bad0-3616-a364-aba5545322c0",
                        "entry_id": "d2873c91-9fd8-3543-af9b-b78790fa194f",
                        "glosses": [
                            "Autrefois."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c7216bc5-efb3-4920-ac89-f7d4aae69272",
                                "sense_id": "0a662981-bad0-3616-a364-aba5545322c0",
                                "text": "Les Tribunaux de ce département sont placés à Libre-Ville, ci-devant Charleville, Sedan, Réthel, Roc-Libre, ci-devant Rocroy, Attigny & Buzancy."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ab167900-e449-3ba2-b7e2-7d8fd377df8a",
                "word": "ci-devant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8eecbc40-1bc8-3119-963b-0c98cf8936a7",
                        "entry_id": "ab167900-e449-3ba2-b7e2-7d8fd377df8a",
                        "glosses": [
                            "Ancien noble, après l’abolition des privilèges lors de la Révolution française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619962e3-22f1-46cc-aab0-efb62c61599d",
                                "sense_id": "8eecbc40-1bc8-3119-963b-0c98cf8936a7",
                                "text": "Aussi la jeune femme était-elle persuadée que l’inconnue était une ci-devant, et qu’elle avait appartenu à la cour."
                            },
                            {
                                "example_id": "7fb4251e-abaf-4a64-96ee-bab684b1e36b",
                                "sense_id": "8eecbc40-1bc8-3119-963b-0c98cf8936a7",
                                "text": "Politiquement, il protégea les ci-devant et empêcha de tout son pouvoir la vente des biens des émigrés."
                            },
                            {
                                "example_id": "acd375e9-5c89-4133-9cda-c6c49de66098",
                                "sense_id": "8eecbc40-1bc8-3119-963b-0c98cf8936a7",
                                "text": "Ces pieuses éducatrices, qui appartenaient presque toutes au monde des ci-devant, et dont plusieurs avaient eu des parents morts sur l’échafaud, inculquèrent aux jeunes filles leurs bonnes manières d’Ancien Régime."
                            },
                            {
                                "example_id": "0f32e0a7-2303-4ea1-b0cf-4338731d9637",
                                "sense_id": "8eecbc40-1bc8-3119-963b-0c98cf8936a7",
                                "text": "Nos pères y mirent jadis tant de négligence qu’ils ne guillotinèrent personne, et n’auraient même jamais arrêté un ci-devant si la Convention, émue de ce scandale, n’avait envoyé à Abbeville un représentant en mission."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
