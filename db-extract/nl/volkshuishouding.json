                    {
                        "translation_id": "03c131f3-d309-4099-a95d-8c04d028f9ab",
                        "source_entry_id": "31ff7017-cc9c-391e-8630-1fb51a9f173c",
                        "source_sense_id": "f4a75bde-03b3-3959-bffc-cccb2fb9f852",
                        "source_sense_description": "de economie van een land",
                        "target_lang_word": "political economy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "political economy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbca69e-21a1-362c-b865-98493cbe1027",
                                        "entry_id": "f4e17e3f-9ab6-3caf-b9b1-730d68de0cfc",
                                        "glosses": [
                                            "Interdisciplinary studies drawing upon economics, law, and political science in explaining how political institutions, the political environment, and the economic system — capitalist, socialist, mixed, and so on — influence each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1101dc-a484-4ebd-9a28-dda13c2e800e",
                                                "sense_id": "bbbca69e-21a1-362c-b865-98493cbe1027",
                                                "text": "Arguing for a limit on the power of money, [John Maynard Keynes] was faithful to a long tradition of political economy that was concerned with the balance of interests and the dangers of financial domination."
                                            },
                                            {
                                                "example_id": "33e44ac2-2dc6-42f8-8dee-d72360325725",
                                                "sense_id": "bbbca69e-21a1-362c-b865-98493cbe1027",
                                                "text": "Ten years ago, David Simon’s iconic TV series The Wire portrayed contemporary Baltimore as wracked by illegal drug use, violent crime and failing institutions. But underneath the symptoms were the structures of political economy. As the show’s tagline had it, “everything is connected”."
                                            },
                                            {
                                                "example_id": "dc6b926b-001c-4997-b6ab-b105d340fc52",
                                                "sense_id": "bbbca69e-21a1-362c-b865-98493cbe1027",
                                                "text": "Everywhere, international opposition to capitalism's global reach would have been fiercer; the Wall Street–City of London–Frankfurt axis that was to shape so much of global political economy in the 1990s and beyond would have been weaker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
