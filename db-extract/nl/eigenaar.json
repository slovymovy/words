                ],
                "senses": [
                    {
                        "sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                        "entry_id": "01756d69-9744-3362-9e43-7ab9ba4aeae5",
                        "glosses": [
                            "iemand die iets in eigendom heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f3c1487-ee10-43b6-b9c6-5091220e9374",
                                "sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                                "text": "Hij is de eigenaar van zijn eigen huis."
                            },
                            {
                                "example_id": "87202917-1435-4d47-b0ba-ea1307c86b67",
                                "sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                                "text": "Bewoners van de Kralingse Kettingstraat mogen de door henzelf bedachte inrichting van de straat realiseren. Ze ondertekenden deze week een zelfbeheercontract waarmee ze ‘eigenaar’ werden van een straatdeel. De bewoners, onder wie initiatiefnemer Ernest van der Kwast, gaan een parkeerterrein omtoveren tot groene speel- en ontmoetingsplek. Er komen nog vijf ‘droomstraten’."
                            },
                            {
                                "example_id": "66b5e16c-01e8-4368-b6f4-5533b7420bbe",
                                "sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                                "text": "Met handen en voeten legt hij uit dat de snor de eigenaar van ons hotel in Corleone is die hem hier afzet, zodat Vincenzo na de lunch met ons kan meelopen."
                            },
                            {
                                "example_id": "3721daf8-7c19-4821-8ef7-2705dc2d0e3b",
                                "sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                                "text": "`Ik weet het; zei de majordomus. 'Het was ijdele hoop dat dit u zou ontgaan. Ik vraag u met klem de grootmoedigheid op te brengen om mijn nederige excuses te aanvaarden. Deze uit de toon vallende decoratie is het jammerlijke gevolg van het enthousiasme van de nieuwe eigenaar.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8225d2b-edd8-444e-b22b-6fccea0da7f9",
                        "source_entry_id": "01756d69-9744-3362-9e43-7ab9ba4aeae5",
                        "source_sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
                        "source_sense_description": "iemand die iets in eigendom heeft",
                        "target_lang_word": "Eigentümer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigentümer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                        "entry_id": "6201469b-c727-3cfe-a0de-5015780a2883",
                                        "glosses": [
                                            "diejenige (natürliche oder juristische) Person, welche die rechtliche Herrschaft über eine Sache hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f730f8-e5ff-44f2-9cbf-7e14176c2bcd",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "Klaus ist Eigentümer dieses Fahrrads."
                                            },
                                            {
                                                "example_id": "fa6c28a7-4742-42df-b0f2-76a61eec457b",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "Frau Petra Meyer ist der Eigentümer dieses Hauses."
                                            },
                                            {
                                                "example_id": "d9d04760-0d62-494d-8ba1-ed213757260d",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "„Auch Eigentümer einer vermieteten Immobilie müssen mit ungeplanten Kosten für Reparaturen oder Nachzahlungen rechnen.“"
                                            },
                                            {
                                                "example_id": "363648a3-ea0d-4ae7-bcd8-32c894e7414d",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "„Bleiben wir vor einer Bude stehen, und der Eigentümer ist abwesend, kommt er nicht herbeigesprungen, um uns hineinzunötigen.“"
                                            },
                                            {
                                                "example_id": "7cdcb3fa-e68a-4f94-961d-04d20180c712",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "„Aber die Eigentümer erlaubten das nicht, sie hatten bereits überall ihre Sachen ausgebreitet.“"
                                            },
                                            {
                                                "example_id": "5d980ed7-4286-4d9b-928d-2e97ac4c78f3",
                                                "sense_id": "a28e2dcc-086b-3166-b2f9-1bf9c22d60a1",
                                                "text": "„Alle zwei Wochen sollten die Eigentümer abwechselnd den gemeinsamen Bereich saugen und putzen, und die Schilder auf Briefkästen und Türklingeln mussten in einer bestimmten Schriftart und Größe ausgedruckt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3a7e1d8-3dda-4eb4-b718-ce517b6875cd",
                        "source_entry_id": "01756d69-9744-3362-9e43-7ab9ba4aeae5",
                        "source_sense_id": "84adcd74-ac80-39c9-adca-aa807b4ec0ec",
