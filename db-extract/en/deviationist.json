                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "98c2abe5-9bc3-36a7-82bd-bf48559023a5",
                                        "entry_id": "dad48706-bc7a-33af-9472-90b538ce5bf1",
                                        "glosses": [
                                            "odstępca od dogmatów kościelnych, w dawnej Polsce ktoś wyznający religię chrześcijańską inną niż katolicyzm, szczególnie protestant"
                                        ],
