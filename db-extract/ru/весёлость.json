                ],
                "senses": [
                    {
                        "sense_id": "f0f8e30e-9e1a-3f0f-89f7-dff606dd839b",
                        "entry_id": "0c3c78c1-c944-3369-805d-bb49ff391eab",
                        "glosses": [
                            "cheerfulness, merriment"
                        ],
                        "tags": [
                            "feminine",
                            "inanimate"
                        ],
                        "examples": [
                            {
                                "example_id": "23395e56-cef6-418a-8280-120dbe19a319",
                                "sense_id": "f0f8e30e-9e1a-3f0f-89f7-dff606dd839b",
                                "text": "Тёплый осе́нний день ра́довал её, и каза́лось, что она́ несёт с собо́ю и распространя́ет вокру́г себя́ сво́йственный ей дух весёлости.",
                                "translation": "The warm autumn day gladdened her and it seemed as if she were bringing with her and spreading around her her own spirit of gaiety.",
                                "english": "The warm autumn day gladdened her and it seemed as if she were bringing with her and spreading around her her own spirit of gaiety."
                            },
                            {
                                "example_id": "968507ac-5012-4457-b936-c957cf1f5fd1",
                                "sense_id": "f0f8e30e-9e1a-3f0f-89f7-dff606dd839b",
                                "text": "В глаза́х Эра́ста Петро́вича вновь промелькну́ла и́скорка, кото́рую у норма́льного челове́ка мо́жно бы́ло бы счесть при́знаком весёлости.",
                                "translation": "Once again, Erast Fandorin’s eyes glinted briefly in a way that she might have taken for a sign of merriment in any normal man.",
                                "english": "Once again, Erast Fandorin’s eyes glinted briefly in a way that she might have taken for a sign of merriment in any normal man."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
