                    }
                ],
                "senses": [
                    {
                        "sense_id": "e919cc7c-8715-313a-8b40-5045686282d8",
                        "entry_id": "662d55de-58c2-31e3-83fe-2d6a22e2e604",
                        "glosses": [
                            "Variante rare de bradycardie : diminution anormale du nombre des battements du cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d5ce29-cac6-44e8-a3cf-dd8e8575c450",
                                "sense_id": "e919cc7c-8715-313a-8b40-5045686282d8",
                                "text": "Car, à l’intérieur, tout se disloque : brachycardie, déshydratation, lésions du foie et des reins, hémorragies du tube digestif, dépression nerveuse et défaillance cardiaque, il faudra cinq ou six jours pour consommer l’irréparable, au milieu de hoquets, de paralysie et de spasmes."
                            },
                            {
                                "example_id": "aa3cab2a-5d26-4a49-92c4-65088e4e4756",
                                "sense_id": "e919cc7c-8715-313a-8b40-5045686282d8",
                                "text": "Ces deux sortes de brachycardie de même nature sont reconnaissables pendant la vie à certains symptômes (dissociation du rythme des battements auriculaires et ventriculaires, épreuve de l’atropine)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79945610-2fea-423d-9527-7d3b05762dc9",
                        "source_entry_id": "662d55de-58c2-31e3-83fe-2d6a22e2e604",
                        "source_sense_id": "e919cc7c-8715-313a-8b40-5045686282d8",
                        "target_lang_word": "bradycardia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bradycardia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d14cb50a-1aa7-3d98-a78c-8e000f2060a8",
                                        "entry_id": "3c4a6b74-dd23-38fc-b49b-7daa73b2e43a",
                                        "glosses": [
                                            "The condition of having a slow heartbeat, defined as under 60 beats per minute for an adult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40caf72-1700-4916-b4ca-4b7f591ab91f",
                                                "sense_id": "d14cb50a-1aa7-3d98-a78c-8e000f2060a8",
                                                "text": "Both CRT-Ds and ICDs are implanted under the skin, in the patient’s upper chest area. The devices have wires called leads that attach to the heart and regulate the rhythm of the muscle. Defibrillators help patients with bradycardia – a slow heartbeat – by pacing the heartbeat and those with tachycardia – a fast heartbeat – by delivering shocks that reset heartbeats to normal."
                                            },
                                            {
                                                "example_id": "4840cb94-6568-40ff-9977-872e494ddf4e",
                                                "sense_id": "d14cb50a-1aa7-3d98-a78c-8e000f2060a8",
                                                "text": "When your resting heart rate is under 60 bpm, providers call it bradycardia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
