                                    {
                                        "sense_id": "1aae15c1-d566-30fd-9e9c-64a2f0a393f5",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of equity risk premium."
                                        ],
                                        "tags": [
