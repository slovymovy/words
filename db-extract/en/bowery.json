                        "entry_id": "59cf2eee-84c9-3ba2-b999-9e16eddfbe5e",
                        "glosses": [
                            "Structure with roof for shade but with no walls used for public gatherings. A pavilion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0232beac-b774-43c4-9a81-9baafb9db961",
                                "sense_id": "845798b8-b6e1-39a9-86c2-782be6ec8a07",
                                "text": "The group performed in the old bowery, an open-air building with a roof of branches laid over vertical poles, the forerunner of the first tabernacle."
                            },
                            {
                                "example_id": "8eb87f2c-8ee2-4917-bbdf-431abac58eff",
                                "sense_id": "845798b8-b6e1-39a9-86c2-782be6ec8a07",
                                "text": "This year’s Easter egg hunt will be at the community bowery on Saturday, April 15."
                            }
                        ]
                    }
                ],
