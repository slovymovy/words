                "senses": [
                    {
                        "sense_id": "86b869a1-f794-34bf-baec-bc24f0401bdc",
                        "entry_id": "a4210911-8466-3d31-9462-b8264a623447",
                        "glosses": [
                            "Zigzaguer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b120dd19-3b34-4dd2-a899-547f8351f5b7",
                                "sense_id": "86b869a1-f794-34bf-baec-bc24f0401bdc",
                                "text": "Il rezigzague un peu et regarde le kiosque à souvenirs et limonades, encore vide, encore plein de neige, il ne l'a jamais vu autrement."
                            },
                            {
                                "example_id": "a534d0c0-cf79-43df-bd84-53265a120a32",
                                "sense_id": "86b869a1-f794-34bf-baec-bc24f0401bdc",
                                "text": "Avant de reprendre les vélos, de remonter sur les selles, de retituber, de rezigzaguer, grotesque dans le soleil du matin."
                            }
                        ]
                    }
