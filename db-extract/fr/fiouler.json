                "senses": [
                    {
                        "sense_id": "b973bde4-a420-3704-9d84-b624d4b01ab0",
                        "entry_id": "3624c541-83a7-39b0-9a42-9b5f3896b647",
                        "glosses": [
                            "Approvisionner un véhicule en carburant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b60344-50e7-4d58-bb9f-34336dfc9000",
                                "sense_id": "b973bde4-a420-3704-9d84-b624d4b01ab0",
                                "text": "Hier suite à un souci d’approvisionnement de GNR au départ de Plestan, notre voisin #RennesTerminal nous à aidé et prêté ses installations pour nous permettre d’être fioulé dans l'urgence !"
                            },
                            {
                                "example_id": "e224d3c8-6cee-4ec3-82f6-97b804a4e2db",
                                "sense_id": "b973bde4-a420-3704-9d84-b624d4b01ab0",
                                "text": "elle le voit dans son écran, mercredi,il a fait du 460 et jeudi, il est passé aux vérins et depuis, il n'a pas pris la route puis il n'avait même pas été \"fioulé\" non plus."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f0b3ee7-eebd-3922-8015-f9090c96686e",
                        "entry_id": "3624c541-83a7-39b0-9a42-9b5f3896b647",
                        "glosses": [
                            "Saouler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4077dd2e-15ff-45eb-9df6-246e05a24f8a",
                                "sense_id": "8f0b3ee7-eebd-3922-8015-f9090c96686e",
                                "text": "apparemment tout est ok de ce coté là mais toujours rien… Ca me fioule grave…"
                            },
                            {
                                "example_id": "65647358-f585-4027-9ce8-05b469568bfa",
                                "sense_id": "8f0b3ee7-eebd-3922-8015-f9090c96686e",
                                "text": "De plus j’ai traversé des vignes toute la journée. Il y a de quoi se fiouler hic……"
                            },
                            {
                                "example_id": "d0c1afb4-605a-4e0e-9597-2c074ce5d28e",
                                "sense_id": "8f0b3ee7-eebd-3922-8015-f9090c96686e",
                                "text": "Ma petit bonhomme intérieur, dit Aizel, m’a informé qu’il fallait que je me fioule un peu pour que ces notes gardent leur essence profonde informative à minima. Alors j’ai bu un quart de vin, parce que le quart bu rend plus productif."
                            }
                        ]
                    }
