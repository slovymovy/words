        "nl-extract.jsonl": [
            {
                "entry_id": "a0a5cc0a-e782-3564-977e-4fa06cb33504",
                "word": "enthousiasme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8cf9af40-a144-3aa9-a9ea-e7616b90d10a",
                        "entry_id": "a0a5cc0a-e782-3564-977e-4fa06cb33504",
                        "glosses": [
                            "geestdrift, het geheel van iets vervuld zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad0513c-a8bf-4995-a696-9e9e574f5c1b",
                                "sense_id": "8cf9af40-a144-3aa9-a9ea-e7616b90d10a",
                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                            },
                            {
                                "example_id": "7a9665ee-6834-4100-ab9a-e7d6131ee537",
                                "sense_id": "8cf9af40-a144-3aa9-a9ea-e7616b90d10a",
                                "text": "`Ik weet het; zei de majordomus. 'Het was ijdele hoop dat dit u zou ontgaan. Ik vraag u met klem de grootmoedigheid op te brengen om mijn nederige excuses te aanvaarden. Deze uit de toon vallende decoratie is het jammerlijke gevolg van het enthousiasme van de nieuwe eigenaar.'"
                            },
                            {
                                "example_id": "d548d604-8fe0-4d10-a7f7-a5571d9b95f5",
                                "sense_id": "8cf9af40-a144-3aa9-a9ea-e7616b90d10a",
                                "text": "Ten slotte is bij veel mensen de koek gewoon op, na het enthousiasme aan het begin verliezen ze de motivatie om door te gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3785579-9231-4098-ae9e-e256e573b127",
                        "source_entry_id": "a0a5cc0a-e782-3564-977e-4fa06cb33504",
                        "source_sense_id": "8cf9af40-a144-3aa9-a9ea-e7616b90d10a",
                        "target_lang_word": "enthousiasme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthousiasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fde43a4c-1ce8-3c59-b670-0acd357ed941",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Émotion extraordinaire de l’âme, qu’on suppose être l’effet d’une inspiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce270b8b-7431-43af-95b4-2af56325a3f4",
                                                "sense_id": "fde43a4c-1ce8-3c59-b670-0acd357ed941",
                                                "text": "L'amour, par l’enthousiasme qu'il engendre, peut produire le sublime sans lequel il n'y aurait point de morale efficace."
                                            },
                                            {
                                                "example_id": "7949c6d4-0e1e-4c75-9098-ce9d419ac390",
                                                "sense_id": "fde43a4c-1ce8-3c59-b670-0acd357ed941",
                                                "text": "Saül, se trouvant parmi les prophètes, fut saisi du même enthousiasme qu’eux. La Sibylle, dans son enthousiasme, avait prédit que…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3184e3bc-56c6-3b58-95b7-76abd459be3c",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Exaltation de l’âme, des facultés, qui accompagne quelquefois et surexcite le travail de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13489b15-6b49-4906-9dea-55db8609ce73",
                                                "sense_id": "3184e3bc-56c6-3b58-95b7-76abd459be3c",
                                                "text": "En affaires, aujourd’hui, ne perdez pas votre élan ni votre enthousiasme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911d5cf8-129d-33a8-92b2-23a8209da51e",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Tout mouvement extraordinaire de l’âme qui excite à des actes de courage, de dévouement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad6aab2-20a9-4f51-a067-aa08cbd792ed",
                                                "sense_id": "911d5cf8-129d-33a8-92b2-23a8209da51e",
                                                "text": "On me signale de toutes parts les maux qu'engendrent ces mariages d'argent par quoi s'opère entre les sexes une sélection à rebours substituant de hideux calculs à cet enthousiasme courageux qui est le propre des jeunes amours."
                                            },
                                            {
                                                "example_id": "6cb5bded-d881-4b09-b0df-dd987e61c6d4",
                                                "sense_id": "911d5cf8-129d-33a8-92b2-23a8209da51e",
                                                "text": "Las, dans le petit monde de l'Université, la probité candide ne mène à rien, et l’enthousiasme pèse peu face aux manœuvres misérables de ceux qui ne reculent devant rien pour faire carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56ce9a15-160e-38e1-9c28-9b7dafe7609a",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Démonstration d’une grande joie, d’une vive allégresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c0db7b-5c41-452a-93d1-e66041832497",
                                                "sense_id": "56ce9a15-160e-38e1-9c28-9b7dafe7609a",
                                                "text": "De toutes parts s'élevaient les acclamations et les cris : « A Paris! » Ces vivats, ces enthousiasmes faisaient contraste avec la froideur, les réserves, les critiques, les refus d'obéissance des maréchaux comme Ney, Lefebvre, Oudinot, Mac-Donald qui, la veille, avaient déclaré à Napoléon qu'un projet de retour sur Paris était une folie."
                                            },
                                            {
                                                "example_id": "692688d1-2591-49dd-99de-f556712ea5d9",
                                                "sense_id": "56ce9a15-160e-38e1-9c28-9b7dafe7609a",
                                                "text": "Après trois ans de crise, une des denrées qui avaient le plus baissé était la faculté d'enthousiasme du peuple américain."
                                            },
                                            {
                                                "example_id": "af4005d1-03e3-4331-b448-b03f4f6331e2",
                                                "sense_id": "56ce9a15-160e-38e1-9c28-9b7dafe7609a",
                                                "text": "Ce message rabat-joie fut hué par une partie de la foule mais tempéra quelque peu l’enthousiasme général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc5f466-b91d-327e-aee5-8f1847ce3f05",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Admiration extrême, goût très vif, parfois excessif, pour une personne ou pour une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774713a7-4ecb-4a59-a72b-70e5cf492889",
                                                "sense_id": "3cc5f466-b91d-327e-aee5-8f1847ce3f05",
                                                "text": "[…], et comme les Sex-Appeal-Girls achevaient leur numéro par un grand écart qui suscitait l'enthousiasme, on entendit crier : — Rideau !"
                                            },
                                            {
                                                "example_id": "ec68da82-ca0b-4a86-acac-ef0ddf71eb6b",
                                                "sense_id": "3cc5f466-b91d-327e-aee5-8f1847ce3f05",
                                                "text": "Les magnifiques music-halls terminaient chaque numéro du programme par un couplet chauvin qui soulevait des scènes d’enthousiasme éperdu ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf58785-a5c9-3a26-9e92-3e28ccb3007e",
                                        "entry_id": "e1313318-aa91-3ba9-b399-224fd1e48d5d",
                                        "glosses": [
                                            "Dans les Mystères de Dionysos, possession par l'esprit divin."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enthousiasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b441091-826d-31e2-8b63-49d4f768a101",
