                                        "glosses": [
                                            "Any material engineered to have a property that is rarely observed in naturally occurring materials; especially"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e21f17-5b66-4f90-b96f-0c2a1fe19952",
                                                "sense_id": "a011d211-b57c-39ce-9347-c10ae51ffdd7",
                                                "text": "This study paves the way for investigating complex contact-based dynamics of microgranular media, demonstrates a novel acoustic metamaterial, and yields a new approach to studying micro- to nanoscale contact mechanics in multiparticle networks.."
                                            },
                                            {
                                                "example_id": "f95ae188-f90e-41a0-87c2-af48e56ee585",
                                                "sense_id": "a011d211-b57c-39ce-9347-c10ae51ffdd7",
                                                "text": "Planar metamaterials with subwavelength thickness, or metasurfaces, consisting of single-layer or few-layer stacks of planar structures, can be readily fabricated using lithography and nanoprinting methods, and the ultrathin thickness in the wave propagation direction can greatly suppress the undesirable losses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16d68fc4-4362-314a-bc34-672c877cca4f",
                                        "entry_id": "dfc73bed-6403-3d79-99e5-0bb908a3479d",
                                        "glosses": [
                                            "Any material engineered to have a property that is rarely observed in naturally occurring materials; especially:",
                                            "Any material that obtains its electromagnetic properties from its structure rather than from its chemical composition; especially a material engineered to have features of a size less than that of the wavelength of a class of electromagnetic radiation."
                                        ],
