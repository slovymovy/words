                            "target_lang_translations": {
                                "en": "The teacher gave us a difficult <w>assignment</w> for the weekend."
                            }
                        },
                        {
                            "text": "Het voltooien van dit project is een flinke <w>opgave</w> voor het team.",
                            "target_lang_translations": {
