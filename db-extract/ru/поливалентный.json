                                                "text": "Un lycée polyvalent."
                                            },
                                            {
                                                "example_id": "bb63b826-919f-4bd2-8d95-1f9cb0bbccef",
                                                "sense_id": "45547995-e5dc-321b-a604-474c9225f1ee",
                                                "text": "Un employé polyvalent."
                                            },
                                            {
                                                "example_id": "200e3d68-acc8-4b52-8de5-8703bff8de17",
                                                "sense_id": "45547995-e5dc-321b-a604-474c9225f1ee",
                                                "text": "Cette nouvelle approche révolutionnaire est plus rapide, moins coûteuse et plus polyvalente que les approches conventionnelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polyvalent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe643a55-91f2-38d3-9cda-440fe844f511",
                                        "entry_id": "82991fef-e432-3118-abf2-e8a578581832",
                                        "glosses": [
