        "nl-extract.jsonl": [
            {
                "entry_id": "f1189ef1-9c17-3535-ac9f-7d1693fb44dd",
                "word": "hogelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a41a3421-2a6d-3bdb-b311-09b176ae0f53",
                        "entry_id": "f1189ef1-9c17-3535-ac9f-7d1693fb44dd",
                        "glosses": [
                            "heel erg, met name in combinatie met verbazen en verbazing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e92a88e8-9d87-4b53-bf0b-aa5a2f84a572",
                                "sense_id": "a41a3421-2a6d-3bdb-b311-09b176ae0f53",
                                "text": "Als Mirjam het ontbijt brengt, lijkt ze enigszins in paniek. Als ik haar erop wijs, is ze hogelijk verbaasd. 'Ik heb daarnet wel weer een pilletje genomen, maar het werkt blijkbaar nog niet.' (Ze neemt de laatste tijd haar valium pas in de namiddag.) 'Om halftien komt Klaas... om de foto's van Jenny over te zetten. Ik moet nog douchen.'"
                            },
                            {
                                "example_id": "9361d1ce-ab36-4a11-9c61-7d750bf03116",
                                "sense_id": "a41a3421-2a6d-3bdb-b311-09b176ae0f53",
                                "text": "Volgens Heracles Almelo is het onzin dat kunstgras in de Eredivisie vanaf het seizoen 2020-2021 verboden is. Algemeen directeur Rob Toussaint was vrijdagochtend hogelijk verbaasd toen hij dat nieuws las. „Het is absoluut niet waar.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92178c01-7dfb-4a34-b245-7a53b9ece21a",
                        "source_entry_id": "f1189ef1-9c17-3535-ac9f-7d1693fb44dd",
                        "source_sense_id": "a41a3421-2a6d-3bdb-b311-09b176ae0f53",
                        "source_sense_description": "heel erg, met name in combinatie met verbazen en verbazing",
                        "target_lang_word": "extreme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extreme",
