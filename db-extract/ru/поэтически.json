                    {
                        "translation_id": "99a0ae24-56e4-461b-a0c7-b600d70c7177",
                        "source_entry_id": "989ea6a8-0c0b-3c76-b0e8-ee17337df924",
                        "source_sense_description": "наречие к поэтический; используя средства поэзии",
                        "target_lang_word": "poétiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poétiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1034b1a2-3dea-391f-a80c-9cff015d6178",
                                        "entry_id": "7e47a33c-21fd-3cbe-b485-17abd9db9678",
                                        "glosses": [
                                            "D’une manière poétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c328a3e2-3435-45da-8abc-56d740b8212f",
                                                "sense_id": "1034b1a2-3dea-391f-a80c-9cff015d6178",
                                                "text": "Platon philosophe poétiquement, et mêle la fable dans la théologie"
                                            },
                                            {
                                                "example_id": "275034ca-5b80-4123-a2a7-352fc9f20b29",
                                                "sense_id": "1034b1a2-3dea-391f-a80c-9cff015d6178",
                                                "text": "J’aime mieux m’occuper de la vie que vous faites présentement ; cela me fait une diversion, sans m’éloigner pourtant de mon sujet et de mon objet, qui est ce qui s’appelle poétiquement l’objet aimé"
                                            },
                                            {
                                                "example_id": "8dd13214-2ad5-4ed6-b4de-1b37a0008a19",
                                                "sense_id": "1034b1a2-3dea-391f-a80c-9cff015d6178",
                                                "text": "Que, depuis le moindre phénomène jusqu’au plus grand, rien ne peut être savamment examiné ou poétitiquement dépeint sans cette hauteur d’esprit qui fait voir l’ensemble en décrivant les détails"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b49b41c8-265b-3d19-99d0-5735c72bb255",
                                        "entry_id": "7e47a33c-21fd-3cbe-b485-17abd9db9678",
                                        "glosses": [
                                            "En fait de poésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33488dad-4e6c-43c3-93e2-6cf93b1217a2",
                                                "sense_id": "b49b41c8-265b-3d19-99d0-5735c72bb255",
                                                "text": "Le dieu des chrétiens est poétiquement supérieur au Jupiter antique"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
