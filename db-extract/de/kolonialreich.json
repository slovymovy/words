                ],
                "senses": [
                    {
                        "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                        "entry_id": "df74291b-c857-35b8-8852-81585d3d1fe4",
                        "glosses": [
                            "Gesamtheit der Kolonien eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf6498c-085f-4faf-9083-b2112bccb52d",
                                "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                                "text": "„Die meisten historischen Atlanten zeigten die verschiedenen Kolonialreiche.“"
                            },
                            {
                                "example_id": "0e52b8c9-c51e-4329-bb99-459fe0a7256a",
                                "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                                "text": "„Als Schreiber des portugiesischen Erzbischofs von Goa an der Westküste Indiens hatte er Informationen über das Kolonialreich ausspioniert.“"
                            },
                            {
                                "example_id": "b1da4b87-a0fe-44c4-a4d5-2119152cd6a9",
                                "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                                "text": "„Nur ein Kolonialreich, wie es etliche europäische Nachbarn erwerben, könnte dem Ungeliebten seinen Wert noch beweisen.“"
                            },
                            {
                                "example_id": "0296ff1b-c28d-4313-8aeb-bc1f574cd06e",
                                "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                                "text": "„In dieser Lage sichert nur noch das Kolonialreich den Status als Weltmacht.“"
                            },
                            {
                                "example_id": "49c223b6-7862-4413-a156-2d9768bbc0b4",
                                "sense_id": "ab22a3e9-bc9d-3485-bba0-ef2f9bb9c1d7",
                                "text": "„Damit war das Ende des portugiesischen Kolonialreichs abzusehen, und Südafrika musste damit rechnen, über kurz oder lang ein linkes Regime mit klarer Anlehnung an die Sowjetunion in seiner unmittelbaren Nachbarschaft, nämlich in Mosambik, zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
