                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c9884f-1904-4d2e-ba6f-f038f4362a56",
                                                "sense_id": "2ceb9eac-452e-3f41-8698-1e2e4a96d3c1",
                                                "text": "Die indianischen Sprachen Amerikas sind weitgehend ausgestorben."
                                            },
                                            {
                                                "example_id": "5175622c-3955-4fa6-9ec1-911e319861c5",
                                                "sense_id": "2ceb9eac-452e-3f41-8698-1e2e4a96d3c1",
                                                "text": "Viele befürchten, dass die deutschen Dialekte bald aussterben."
                                            },
                                            {
                                                "example_id": "816e66c9-4e72-4967-b6d4-099112c4568f",
                                                "sense_id": "2ceb9eac-452e-3f41-8698-1e2e4a96d3c1",
                                                "text": "Das alte Handwerk des Bürstenbinders stirbt aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "329f2481-9e49-3ab9-960c-efaaa43b554f",
                                        "entry_id": "4e41e0cb-d2fd-3a16-b130-e2a61c45c5f3",
                                        "glosses": [
