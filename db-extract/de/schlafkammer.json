                        "examples": [
                            {
                                "example_id": "f454fa40-51a9-4e07-bc16-e4bb4149f35a",
                                "sense_id": "a97ecd9b-6c21-305b-9bb6-89a4e6de5e58",
                                "text": "Er lag immer sehr lange im Bett, oft stand er erst kurz vor Mittag auf und ging im Schlafrock die paar Schritte von der Schlafkammer zu seinem Wohnzimmer hinüber.",
                                "translation": "Il restait toujours longtemps au lit, se levait souvent juste avant midi et franchissait alors en robe de chambre les quelques pas qui séparaient la pièce où il dormait de sa salle de séjour."
                            }
                        ]
                    }
