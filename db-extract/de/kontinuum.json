                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8161815d-5885-3efc-9aad-f58775f6f5ec",
                                        "entry_id": "40017806-ee45-3f9e-aa85-fed044fe9151",
                                        "glosses": [
                                            "Métier qui fonctionne sans s’arrêter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1af304-0ed0-475a-aae1-1ac2eb241a4c",
                                                "sense_id": "8161815d-5885-3efc-9aad-f58775f6f5ec",
                                                "text": "Le filage au continu permet d’obtenir une plus grande production, car le fil se produit et se renvide continuellement."
                                            }
