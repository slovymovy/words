            {
                "entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                "word": "antibacterial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                        "entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                        "glosses": [
                            "Killing or inhibiting bacteria."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "37fd3909-51a2-4fbd-a5f5-7df7f7685c5a",
                                "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                                "text": "This drug has an antibacterial effect."
                            },
                            {
                                "example_id": "92815561-e842-46b7-bf07-51145df44f43",
                                "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a27d5c4-0585-3070-8cf6-1325277377f5",
                        "entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                        "glosses": [
                            "Opposing the theory that diseases are caused by bacteria."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23b34e40-7f57-4e9d-89c3-06d65b4ba0ec",
