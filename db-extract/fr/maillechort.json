                                        "entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                                        "glosses": [
                                            "An alloy of gold and silver, used by the ancients; now specifically a natural alloy with between 20 and 50 per cent silver."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b8abaf-12ef-4d5b-97ea-46487655ec6d",
                                                "sense_id": "d0ed9a50-e4e2-35fc-9349-8ce14526e9e9",
                                                "text": "Native gold almost always contains silver in amounts varying widely between 5 and 50 per cent. This natural alloy is known as electrum although in classical antiquity where the word originated it seems to have been used for an artificial alloy of the two metals."
                                            },
                                            {
                                                "example_id": "7fa6b56f-e5f9-493a-aca8-c78a7b4a0e96",
                                                "sense_id": "d0ed9a50-e4e2-35fc-9349-8ce14526e9e9",
                                                "text": "A natural alloy containing more than 20 per cent silver is called electrum, and was regarded by the ancients as a different metal from gold."
                                            }
                                        ]
                                    },
