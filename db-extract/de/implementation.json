                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "0d1d9f4b-d665-4cca-8745-8d8a111093a7",
                                "sense_id": "bdad8dc6-890e-386d-b92d-2810dddd16b6",
                                "text": "Die neulich angekündigte vollständige freie Swing/AWT-Implementation von Intel für Apache Harmony ist nun verfügbar."
