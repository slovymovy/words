                        "sense_id": "e7771512-3912-34dc-9964-9142c93428c1",
                        "entry_id": "9a84f6a1-663c-321f-8166-4d39204cc473",
                        "glosses": [
                            "Not ascertained; undetermined; unknown."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56bae9f-de17-49c8-9786-1580d770a7dc",
                                "sense_id": "e7771512-3912-34dc-9964-9142c93428c1",
                                "text": "Throughout all future time, as now, the human mind may occupy itself, not only with ascertained phenomena and their relations, but also with that unascertained something which phenomena and their relations imply."
                            },
                            {
                                "example_id": "daef7d30-5a42-4587-a6d3-e003b80ae578",
                                "sense_id": "e7771512-3912-34dc-9964-9142c93428c1",
                                "text": "A conjecture vaguely taking shape in his mind resolved itself to nothing again, and left him with only the ache of something unascertained."
                            },
                            {
                                "example_id": "6318a9a6-97ce-4a42-b82e-c4902d7d4edd",
                                "sense_id": "e7771512-3912-34dc-9964-9142c93428c1",
                                "text": "This will dispose of the power of the five perhaps estimable but unknown individuals known as “independents” to control in accordance with their unascertained prejudices the self-defending labors of a great nation in the presence of an efficient foe."
                            }
                        ]
                    }
