                        ]
                    },
                    {
                        "sense_id": "0d959002-1bb6-38c2-a81c-02e25f246f26",
                        "entry_id": "8620f1b3-c09f-3f24-b00a-6f94f94d3bfc",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
