                                        "entry_id": "c23645ad-0c4d-392e-ba9e-6dbbdc1c7f9d",
                                        "glosses": [
                                            "Any of a family of mycotoxins, produced by molds of the Aspergillus genus, that can be toxic, carcinogenic, mutagenic or teratogenic; typically found as contaminants of animal food or peanuts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83f6e935-82fa-4522-816e-e8e6fe21ac59",
                        "source_entry_id": "3ec20275-440a-3280-a973-d14480949287",
                        "source_sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                        "source_sense_description": "mutagenes und krebserregendes Gift (Toxin), das von einigen Schimmelpilzarten gebildet wird",
                        "target_lang_word": "aflatoxine",
                        "target_lang_code": "fr",
