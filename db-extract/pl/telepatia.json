                    {
                        "translation_id": "6efb6e86-40f3-4161-94b4-cc3f05ba0b6d",
                        "source_entry_id": "1f660190-1038-3181-83b0-e7db62432849",
                        "source_sense_id": "5e51689e-d79f-3452-b915-367c4e2b1686",
