                    {
                        "translation_id": "a794276f-cac4-435c-8132-002e446329a7",
                        "source_entry_id": "22bf9820-7667-3001-8088-fc303d2067d5",
                        "source_sense_id": "cdcdbb6e-2579-3cb0-be10-79d9af5b5e32",
