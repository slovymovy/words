    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                "word": "seraglio",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b381cbf4-2235-47b4-9624-663d34a0add5",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "tags": [
                            "plural"
                        ],
                        "form": "seraglios"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0403d2fa-beed-3a75-8926-04897de41261",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "A palace of a sultan."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "de8faf04-61a8-356a-9684-bd36053bb639",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "A palace of a sultan.",
                            "The palace of the Grand Seignior in Constantinople."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affb4f8b-012f-460e-942b-e01872ee07f0",
                                "sense_id": "de8faf04-61a8-356a-9684-bd36053bb639",
                                "text": "At these words he started up, and beheld—not his Sophia—no, nor a Circassian maid richly and elegantly attired for the grand Signior's seraglio."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ffb6491-2bf6-3202-870f-3855e81e4273",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "A profligate or decadent residence of a rich person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb9daf2-aaeb-4a02-9920-cb876c007a6c",
                                "sense_id": "7ffb6491-2bf6-3202-870f-3855e81e4273",
                                "text": "In 1936 [Charles] Schwab's agents approached the La Guardia administration in New York, hoping to interest the city in buying his mansion for the official residence of the mayor. […] But Fiorello La Guardia took great pride in the fact that he lived in a modest walkup in Lower New York. He ridiculed the idea of moving into the robber baron's seraglio, telling newsmen that the city much preferred having the tax revenue from the mansion."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b99231c-7c16-3dbd-8d89-8fa41e6a9813",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "The sequestered living quarters used by wives and concubines (odalisques) in a Turkish Muslim household."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b931cc4f-bd58-3bf6-9702-c85ff8111e2f",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "A brothel or place of debauchery."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "284224a6-5583-301d-b71f-d33cda74fce1",
                        "entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "glosses": [
                            "An interior cage or enclosed courtyard for keeping wild beasts."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10823711-6bea-486c-bbd6-fd7140b6e43f",
                        "source_entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "source_sense_description": "palace",
                        "target_lang_word": "sérail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca9ea27-5c28-3348-b952-447c709f1222",
                                        "entry_id": "f61b37ee-4f2a-3de8-b8c1-bc538ea0de5c",
                                        "glosses": [
                                            "Vaste demeure luxueuse, palais dans les pays de culture ottomane et arabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a16964a-4d9d-40ef-aa52-54df1b91a10d",
                                                "sense_id": "9ca9ea27-5c28-3348-b952-447c709f1222",
                                                "text": "Tu ne m'as pas fait une seule caresse, depuis une heure que tu es ici, et tu as reçu les miennes avec la majesté du Grand Turc au Sérail."
                                            },
                                            {
                                                "example_id": "aa7589bc-5e4b-4004-a5ca-9991fa476f1a",
                                                "sense_id": "9ca9ea27-5c28-3348-b952-447c709f1222",
                                                "text": "– Les représentants des Puissances […] n’ont pu qu’exprimer toutefois leur désappointement à l’égard du soutien apporté par votre sérail à entreprise du vice-roi d’Égypte."
                                            },
                                            {
                                                "example_id": "ddacc3c0-934b-441a-8f14-e5fe94b4193f",
                                                "sense_id": "9ca9ea27-5c28-3348-b952-447c709f1222",
                                                "text": "Le sérail de Constantinople."
                                            },
                                            {
                                                "example_id": "cfd1da83-dfec-4671-bc29-ed514a40eccf",
                                                "sense_id": "9ca9ea27-5c28-3348-b952-447c709f1222",
                                                "text": "Le Grand Seigneur a des sérails dans plusieurs villes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94bb3e6-1775-3091-a335-b289fa8f1c5f",
                                        "entry_id": "f61b37ee-4f2a-3de8-b8c1-bc538ea0de5c",
                                        "glosses": [
                                            "Partie du palais où les femmes sont enfermées, harem."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73e584bb-b669-48ee-a0c8-de6c5186af78",
                                                "sense_id": "b94bb3e6-1775-3091-a335-b289fa8f1c5f",
                                                "text": "Moi qui ai un sérail au Caire, un à Smyrne et un à Constantinople, présider à un mariage ! jamais."
                                            },
                                            {
                                                "example_id": "2f442734-4776-41ed-a06c-28fbae7abdae",
                                                "sense_id": "b94bb3e6-1775-3091-a335-b289fa8f1c5f",
                                                "text": "Burma éprouve à peine moins d’agacement envers la colonie de professionnelles beautés groupées par affinité dans un élégant immeuble qu’on aurait appelé au XVIIIᵉ siècle : sérail, abbaye ou bagno."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02ebf68-50c7-3a7d-a656-acc4c19a777f",
                                        "entry_id": "f61b37ee-4f2a-3de8-b8c1-bc538ea0de5c",
                                        "glosses": [
                                            "Cercle ou groupe fermé, clique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f2b97b-5255-410b-9f31-de4747b8fc53",
                                                "sense_id": "f02ebf68-50c7-3a7d-a656-acc4c19a777f",
                                                "text": "La presse du monde entier nous appelle et nos résultats sortent du sérail scientifique."
                                            },
                                            {
                                                "example_id": "50a09d87-4742-484d-ab32-fcec0a3671d2",
                                                "sense_id": "f02ebf68-50c7-3a7d-a656-acc4c19a777f",
                                                "text": "Pierre est un cinéaste très estimé dans le sérail."
                                            },
                                            {
                                                "example_id": "cdacb750-2a47-4ca8-96e9-f7f8ac6799b9",
                                                "sense_id": "f02ebf68-50c7-3a7d-a656-acc4c19a777f",
                                                "text": "Comme en 2016, Donald Trump se pose en candidat qui n’appartient pas au sérail et qui se bat pour les Américains, loin des intrigues de Washington."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234a3940-cf82-3a2b-a00e-0564f3dddaa5",
                                        "entry_id": "f61b37ee-4f2a-3de8-b8c1-bc538ea0de5c",
                                        "glosses": [
                                            "Prestigieux immeuble administratif de Tripoli."
                                        ],
                                        "tags": [
                                            "Liban"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c3c99fc-2c53-4242-973d-d21a02872ca1",
                                                "sense_id": "234a3940-cf82-3a2b-a00e-0564f3dddaa5",
                                                "text": "De jeunes casseurs, armés de cocktails Molotov et de grenades pour certains, ont incendié les sièges du conseil municipal et du tribunal religieux, tentant d’en faire de même avec le sérail et d’autres institutions emblématiques de la capitale du Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "099333a7-7697-338f-aa4b-9437704e46f8",
                                        "entry_id": "f61b37ee-4f2a-3de8-b8c1-bc538ea0de5c",
                                        "glosses": [
                                            "Lieu d'exhibition des bêtes sauvages, indigènes ou exotiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe24b522-1396-4bfb-9f6d-d28bdf6d7588",
                                                "sense_id": "099333a7-7697-338f-aa4b-9437704e46f8",
                                                "text": "La ménagerie de Vincennes portait le nom de sérail ; […]"
                                            },
                                            {
                                                "example_id": "b2ddc52b-5ba5-4ada-b7c9-8f1626252184",
                                                "sense_id": "099333a7-7697-338f-aa4b-9437704e46f8",
                                                "text": "Pour cela, il existait des sérails d’animaux « féroces » plus ou moins temporaires, servant de dépôts avant les jeux ou de lieux de vente aux particuliers, ainsi que des parcs pour les herbivores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "203e3aab-c000-49c7-ae35-39a296d84c76",
                        "source_entry_id": "3b93cd62-c3d9-3d0a-ba20-321c19573238",
                        "source_sense_description": "palace",
                        "target_lang_word": "Serail",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serail",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc43f4d6-e0d2-3639-81b4-cfa025746760",
                                        "entry_id": "a3fb41da-d379-308d-8549-90a6d180e074",
                                        "glosses": [
                                            "Sultanspalast, orientalisches Schloss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc117d6f-eb56-44b4-8a06-c84e1f6bdef2",
                                                "sense_id": "dc43f4d6-e0d2-3639-81b4-cfa025746760",
                                                "text": "Das Topkapi-Serail in Istanbul war jahrhundertelang der Wohn- und Regierungssitz der Sultane sowie das Verwaltungszentrum des Osmanischen Reiches."
                                            },
                                            {
                                                "example_id": "1352a1a5-5525-4433-93e8-6c83ed317f29",
                                                "sense_id": "dc43f4d6-e0d2-3639-81b4-cfa025746760",
                                                "text": "„Meine Mutter, überzeugt davon, daß man sich gar nicht genug gegen die Langeweile des Serails wappnen kann, sah mit Genugtuung, wie gern wir uns beschäftigten.“"
                                            },
                                            {
                                                "example_id": "da22205d-55ed-49c4-9907-30ed5aba7a55",
                                                "sense_id": "dc43f4d6-e0d2-3639-81b4-cfa025746760",
                                                "text": "„Ich sollte die Rechte eines allmächtigen Gatten verletzen und mich in seinem göttlichen Serail der schönsten aller seiner Sultaninnen bemächtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
