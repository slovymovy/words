                    {
                        "translation_id": "ec29cf25-f143-435c-b4f4-c3a27dced756",
                        "source_entry_id": "c5aea961-fb34-3397-9a18-a1a95326d1ca",
                        "source_sense_id": "98bef771-26cf-3b5f-8ea9-338c8b79262a",
                        "source_sense_description": "Palmier",
                        "target_lang_word": "açaizeiro",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "açaizeiro",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "556c7c73-860c-3b24-b18b-3eb15e6fe31b",
                                        "entry_id": "32e85cdd-410f-3b04-b805-33517c38dabe",
                                        "glosses": [
                                            "nome comum da palmeira Euterpe oleracea, nativa da Amazônia e Caribe, de tronco fino com até vinte e cinco metros de onde é extraído palmito, folhas com até três metros de comprimento que variam em número de oito a catorze por pé (considerado pouco), flores monoicas dispostas em pedúnculos com cerca de setenta centímetros onde alternam-se em grupos de três (onde uma é masculina e roxa, e duas são fêmeas, marrom-clara), cujo fruto (açaí) é uma drupa arredondada comestível que possui importância econômica na culinária"
                                        ],
                                        "tags": [
                                            "Brazil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee927fc9-c3a2-46c1-99d4-c78c0060ce75",
                                                "sense_id": "556c7c73-860c-3b24-b18b-3eb15e6fe31b",
                                                "text": "Corpos leves são melhores para o serviço, pois num dia de trabalho é preciso subir e descer o açaizeiro umas 25 vezes."
                                            },
                                            {
                                                "example_id": "d0f8a1a7-ff9c-47ea-baac-9b5c668b5d58",
                                                "sense_id": "556c7c73-860c-3b24-b18b-3eb15e6fe31b",
                                                "text": "O fruto do açaizeiro precisa ser tratado em até 48 horas depois da colheita, porque se deteriora muito rápido."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
