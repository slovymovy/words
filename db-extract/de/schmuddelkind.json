                    {
                        "sense_id": "0d406e6f-f66e-34a5-b686-2223a1425903",
                        "entry_id": "8d3c9b1b-fa4b-3dd0-a581-b6d9fe4f2d70",
                        "glosses": [
                            "schmuddeliges (unsauberes, ungepflegtes) Kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7739d4-7108-497d-8ec8-2443b229690d",
                                "sense_id": "0d406e6f-f66e-34a5-b686-2223a1425903",
                                "text": "„Jetzt kamen von überall her irgendwelche Fremde, die aber Bekannte waren, das Schmuddelkind hielt eine Ansprache, der nette Hetero-Wirt verschwand, der Verschmuddelte entpuppte sich als Entertainer, die Traube Männer um ihn herum wuchs an, die Mädchen gerieten in den Sog, die Truppe wälzte sich über die Straße und brachte einen knallgelben Corvette zum Halten, aus dem zwei Freunde des Schmuddel-Entertainers stiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
