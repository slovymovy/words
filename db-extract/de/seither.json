                "forms": [],
                "senses": [
                    {
                        "sense_id": "b139aec5-5e6e-37d5-aa68-0d989cd87a4f",
                        "entry_id": "70942af8-56da-3e39-9d2a-45d4001fb446",
                        "glosses": [
                            "Depuis lors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c8d2bf-db2d-4567-a6ae-426c04efdf0f",
                                "sense_id": "b139aec5-5e6e-37d5-aa68-0d989cd87a4f",
                                "text": "Der platonische Mythos ist allgemein bekannt: am Anfang gab es Männer, Frauen und Androgyne; jedes Individuum hatte zwei Gesichter, vier Arme, vier Beine und zwei miteinander verbundene Körper. Sie wurden eines Tages entzweigeteilt, «wie man Eier teilt», und seither sucht jede Hälfte sich wieder mit ihrer Ergänzung zu vereinen: die Götter beschlossen daraufhin, daß durch die Paarung zweier ungleicher Hälften neue Menschen entstehen sollten.",
                                "translation": "On connaît le mythe platonicien : au commencement il y avait des hommes, des femmes et des androgynes ; chaque individu possédait une double face, quatre bras, quatre jambes et deux corps accolés ; ils furent un jour fendus en deux « à la manière dont on fend les œufs » et, depuis lors, chaque moitié cherche à rejoindre sa moitié complémentaire : les dieux décidèrent ultérieurement que par l’accouplement de deux moitiés dissemblables de nouveaux êtres humains seraient créés."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "0ef99cac-d08a-3794-9587-67822c22a99f",
                "word": "seither",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                        "entry_id": "0ef99cac-d08a-3794-9587-67822c22a99f",
                        "glosses": [
                            "von einem bestimmten Zeitpunkt an"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf64b89-a98a-4396-abf1-2fdc1bb4dea9",
                                "sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                                "text": "Die Studie ist zehn Jahre alt, seither hat sich aber viel verändert."
                            },
                            {
                                "example_id": "4197e841-ea53-45d0-b39c-3af7fc72f395",
                                "sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                                "text": "„Sämtliche Haushalte müssen Fiskus und Sozialversicherungen derzeit weniger Geld überweisen als noch im Jahr 2000. Und das, obwohl die nominalen Durchschnittslöhne seither um fast zwanzig Prozent gestiegen sind.“"
                            },
                            {
                                "example_id": "01a2f3f8-dd7c-4af4-9c96-7ed3f6dbf3b0",
                                "sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                                "text": "„Ich verlasse dich. Ich weiß nicht genau, wann ich den Satz zum ersten Mal gedacht habe. Und wieviele Male seither.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d671849-5597-4539-aa34-191dcc87e67e",
                        "source_entry_id": "0ef99cac-d08a-3794-9587-67822c22a99f",
                        "source_sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                        "source_sense_description": "von einem bestimmten Zeitpunkt an",
                        "target_lang_word": "since then",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e9a5bff9-f5f7-4b9e-b0af-110d02b24223",
                        "source_entry_id": "0ef99cac-d08a-3794-9587-67822c22a99f",
                        "source_sense_id": "3d608a16-351f-3e22-9dec-a34a767e92d0",
                        "source_sense_description": "von einem bestimmten Zeitpunkt an",
                        "target_lang_word": "depuis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depuis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "À partir de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9045b639-cbac-4f06-add8-a08d71e56c39",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d’un ognon de jacinthe jusqu’aux courants électriques."
                                            },
                                            {
                                                "example_id": "9344820a-2bd9-4985-b703-59ea674f7c65",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "[…], il ne parvint que jusqu'à l'Oued El-Abid, au Tedla, où il succomba subitement à une maladie qui le minait sournoisement depuis longtemps."
                                            },
                                            {
                                                "example_id": "a166a987-8e2e-4573-a312-655a872c4369",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Il y avait aussi à la base un prototype qui était arrivé depuis peu de temps, c'était le dernier-né de la société Avions Marcel Dassault. L’Ouragan MD 450 le premier avion à réaction de fabrication française, […]."
                                            },
                                            {
                                                "example_id": "e2fc67d5-7c30-4c0a-b240-ea95d6f4e610",
                                                "sense_id": "e45cbc58-79ec-3c74-874e-27646e72c56b",
                                                "text": "Quand vont-ils enfin faire quelque chose? Depuis le temps qu'on demande des ralentisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "Peut aussi indiquer un rapport de lieu ou de rang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd34e0d0-f1b6-4d83-88ec-72fd113c4ec8",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "La communication a été émise depuis une cabine téléphonique située au lieu-dit La Commodité, sur la RN 7 à Solterre dans le Loiret."
                                            },
                                            {
                                                "example_id": "8a758996-2ba4-4dda-a285-2586f37ee56f",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "Les lésions de la fièvre typhoïde intéressent l’appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu’aux ganglions mésentériques et à la rate."
                                            },
                                            {
                                                "example_id": "ed6ef9cb-b141-458a-96d3-0548f47f085f",
                                                "sense_id": "03055921-fa11-31c4-a3cf-22aad46598fc",
                                                "text": "Victor prit son téléphone, shoota quelques objets, son canapé, sa psyché, son tapis de course et, depuis son balcon en saillie, il immortalisa la ville repoussant la lumière qui l’orangeait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6471166-23d5-3a73-8b47-e7b176f7decf",
                                        "entry_id": "4ea42552-4d47-3232-b92b-c8cb60e39433",
                                        "glosses": [
                                            "(suivi de l'infinitif passé)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75aa3b60-c894-4565-a706-4048ad7a8303",
                                                "sense_id": "d6471166-23d5-3a73-8b47-e7b176f7decf",
                                                "text": "Depuis vous avoir écrit, c.-à-d. il y a quelque six mois, j'ai été fort occupé ou fort triste ou fort débauché de telle sorte que je n'ai pas eu le courage d'écrire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "depuis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                        "entry_id": "2e1051b1-04f1-315e-a36b-84e8c08a4150",
                                        "glosses": [
                                            "À partir de tel temps."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c5ba64-729d-4483-8bd0-85ce7aa47b65",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Ça remonte au déluge et depuis elle a eu trois maris, mais ils ont formé un couple hyper-glamour pendant des années."
                                            },
                                            {
                                                "example_id": "8d282b20-66df-403b-ba68-ab2b3418268b",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Depuis, je n’en ai plus entendu parler."
                                            },
                                            {
                                                "example_id": "cdd9a909-d145-4bca-8840-309d1b51ada0",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Tous les auteurs qui ont écrit depuis."
                                            },
                                            {
                                                "example_id": "e4449129-7f41-4b52-8699-cb4c26141a00",
                                                "sense_id": "5e2f195b-b133-3333-955a-1de11837098a",
                                                "text": "Qu’est-il arrivé depuis ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
