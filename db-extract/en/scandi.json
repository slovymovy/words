                        "examples": [
                            {
                                "example_id": "f3546417-f4ba-4813-8bd7-2ecc57ada7ac",
                                "sense_id": "7b481c4f-a53d-3af3-8f57-ad97466891b0",
                                "text": "A bonus for those working on their tans in the stands, but in the dressing room the made-for-the-shade Brits and the Scandis are sweating uncomfortably already."
                            },
                            {
                                "example_id": "dbb14923-e4f9-4d7b-9720-5853df38d71b",
                                "sense_id": "7b481c4f-a53d-3af3-8f57-ad97466891b0",
                                "text": "One of the Scandis, Sandra, had talked about how the men in south east Asia stared openly at women."
                            }
                        ]
                    }
