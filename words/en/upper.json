{
    "word_family": [
        "up",
        "uppermost",
        "upward",
        "uppity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ddbccd5-0e30-3ed2-a049-ed8806b8f005",
                    "sense_definition": "Located at a higher level, rank, or position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>upper</w> shelves in the kitchen are too high for the children to reach.",
                            "target_lang_translations": {
                                "ru": "<w>Ве́рхние</w> полки на кухне слишком высоки, чтобы дети могли до них достать.",
                                "zh": "厨房里的<w>上层</w>搁板太高了，孩子们够不着。"
                            }
                        },
                        {
                            "text": "He comes from a wealthy family and belongs to the <w>upper</w> class of society.",
                            "target_lang_translations": {
                                "ru": "Он из богатой семьи и принадлежит к <w>вы́сшему</w> классу общества.",
                                "zh": "他出身富裕家庭，属于社会<w>上层</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "higher",
                        "top"
                    ],
                    "antonyms": [
                        "lower"
                    ],
                    "common_phrases": [
                        "upper body",
                        "upper hand",
                        "upper class",
                        "upper limit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный на более высоком уровне, в более высоком звании или положении.",
                        "zh": "位于更高的位置、等级或地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рхний",
                                "target_lang_sense_clarification": "расположенный выше"
                            },
                            {
                                "target_lang_word": "вы́сший",
                                "target_lang_sense_clarification": "о ранге или классе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上层的",
                                "target_lang_sense_clarification": "指位置或等级较高"
                            },
                            {
                                "target_lang_word": "高级的",
                                "target_lang_sense_clarification": "指社会地位或阶层"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c6aaec-0634-3f16-923d-0d10d590178b",
                    "sense_definition": "Situated on higher ground, further inland, or towards the north.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers decided to travel by boat to the <w>upper</w> reaches of the river.",
                            "target_lang_translations": {
                                "ru": "Исследователи решили отправиться на лодке в <w>ве́рхнее</w> течение реки.",
                                "zh": "探险家们决定乘船前往河流的<w>上游</w>。"
                            }
                        },
                        {
                            "text": "Scientists study the <w>upper</w> atmosphere to understand climate change patterns.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>ве́рхнюю</w> атмосферу, чтобы понять закономерности изменения климата.",
                                "zh": "科学家们研究<w>高层</w>大气以了解气候变化的规律。"
                            }
                        }
                    ],
                    "antonyms": [
                        "lower"
                    ],
                    "common_phrases": [
                        "upper atmosphere",
                        "upper river"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на возвышенности, в верховьях реки или севернее.",
                        "zh": "位于高地、内陆深处或偏北方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рхний",
                                "target_lang_sense_clarification": "географически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上游的",
                                "target_lang_sense_clarification": "指河流的上游"
                            },
                            {
                                "target_lang_word": "高层的",
                                "target_lang_sense_clarification": "指大气层等空间位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67fa1f27-b99f-3f8a-89b4-ea34586b92ec",
                    "sense_definition": "The piece of leather or material that forms the top part of a shoe above the sole.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shoe_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>uppers</w> of these hiking boots are made from durable waterproof leather.",
                            "target_lang_translations": {
                                "ru": "<w>Верх</w> этих походных ботинок сделан из прочной водонепроницаемой кожи.",
                                "zh": "这些登山靴的<w>鞋面</w>是由耐用的防水皮革制成的。"
                            }
                        },
                        {
                            "text": "You should clean the <w>uppers</w> with a soft cloth to keep them looking new.",
                            "target_lang_translations": {
                                "ru": "Вам следует чистить <w>верх</w> обуви мягкой тканью, чтобы она выглядела как новая.",
                                "zh": "你应该用软布擦拭<w>鞋面</w>，以保持它们看起来像新的一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather uppers",
                        "synthetic uppers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя часть обуви, прикрепляемая к подошве.",
                        "zh": "鞋子覆盖在鞋底之上的皮革或材料部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верх",
                                "target_lang_sense_clarification": "обуви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞋面",
                                "target_lang_sense_clarification": "鞋子的顶部材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db8228b-c1ef-353e-bd42-52df51c21ce1",
                    "sense_definition": "A stimulant drug, such as amphetamine, that increases energy and mood.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started taking <w>uppers</w> to stay awake during the long night shifts.",
                            "target_lang_translations": {
                                "ru": "Он начал принимать <w>стимуля́торы</w>, чтобы не спать во время долгих ночных смен.",
                                "zh": "他开始服用<w>兴奋剂</w>以在漫长的夜班期间保持清醒。"
                            }
                        },
                        {
                            "text": "The doctor warned him about the dangerous side effects of mixing <w>uppers</w> with alcohol.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил его об опасных побочных эффектах смешивания <w>стимуля́торов</w> с алкоголем.",
                                "zh": "医生警告他将<w>兴奋剂</w>与酒精混合使用会有危险的副作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulant"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стимулирующий наркотик, повышающий энергию и настроение.",
                        "zh": "一种能增加能量和改善情绪的兴奋剂药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимуля́тор",
                                "target_lang_sense_clarification": "наркотик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兴奋剂",
                                "target_lang_sense_clarification": "指刺激神经系统的药物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f36953-7023-3820-b71b-266d3bab843e",
                    "sense_definition": "A tooth or set of false teeth located in the upper jaw.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "teeth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist examined his <w>uppers</w> and found two cavities that needed filling.",
                            "target_lang_translations": {
                                "ru": "Стоматолог осмотрел его <w>ве́рхние зу́бы</w> и обнаружил две полости, которые нужно было запломбировать.",
                                "zh": "牙医检查了他的<w>上牙</w>，发现有两处蛀牙需要补。"
                            }
                        },
                        {
                            "text": "My grandfather keeps his <w>uppers</w> in a glass of water by the bed at night.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка держит свой <w>ве́рхний проте́з</w> в стакане с водой у кровати по ночам.",
                                "zh": "我爷爷晚上把他的<w>上排假牙</w>放在床边的水杯里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "set of uppers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often refers to dentures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зуб или зубной протез верхней челюсти.",
                        "zh": "上颌的牙齿或假牙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рхние зу́бы",
                                "target_lang_sense_clarification": "зубы"
                            },
                            {
                                "target_lang_word": "ве́рхний проте́з",
                                "target_lang_sense_clarification": "вставная челюсть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上牙",
                                "target_lang_sense_clarification": "指上颌的牙齿"
                            },
                            {
                                "target_lang_word": "上排假牙",
                                "target_lang_sense_clarification": "指上颌的义齿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ba7c6b7-85d8-34fc-b676-1d47149e5d9f",
                    "sense_definition": "A sleeping berth on the top level, especially in a train or ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "berth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to sleep in the <w>upper</w> because the bottom bunk was already taken.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось спать на <w>ве́рхней по́лке</w>, потому что нижняя была уже занята.",
                                "zh": "因为下铺已经有人了，我只好睡在<w>上铺</w>。"
                            }
                        },
                        {
                            "text": "Climbing into the <w>upper</w> can be difficult for elderly passengers on the train.",
                            "target_lang_translations": {
                                "ru": "Забираться на <w>ве́рхнюю по́лку</w> может быть трудно для пожилых пассажиров поезда.",
                                "zh": "对于火车上的老年乘客来说，爬到<w>上铺</w>可能会很困难。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in historical travel contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спальное место на верхнем ярусе, особенно в поезде или на корабле.",
                        "zh": "火车或船上高层的卧铺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рхняя по́лка",
                                "target_lang_sense_clarification": "спальное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上铺",
                                "target_lang_sense_clarification": "指卧铺车厢的上方床位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}