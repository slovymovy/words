{
    "word_family": [
        "suppleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "044f084c-1416-37b7-bfdd-2eb640a2b733",
                    "sense_definition": "Pliant, flexible, and easy to bend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supple</w> leather of the new gloves felt very comfortable.",
                            "target_lang_translations": {
                                "zh": "新手套那<w>柔软</w>的皮革戴起来非常舒服。"
                            }
                        },
                        {
                            "text": "Modern materials are often designed to be <w>supple</w> yet durable.",
                            "target_lang_translations": {
                                "zh": "现代材料通常被设计得既<w>柔韧</w>又耐用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flexible",
                        "pliant",
                        "pliable"
                    ],
                    "antonyms": [
                        "stiff",
                        "rigid"
                    ],
                    "common_phrases": [
                        "supple leather",
                        "supple material"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体柔软、易于弯曲且富有弹性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柔软",
                                "target_lang_sense_clarification": "形容质地软，易于弯曲。"
                            },
                            {
                                "target_lang_word": "柔韧",
                                "target_lang_sense_clarification": "形容既柔软又有韧性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2f9b585-9e2b-3e72-ab05-64a5a5f6dcf8",
                    "sense_definition": "Lithe and agile when moving or bending.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved with <w>supple</w> grace across the stage.",
                            "target_lang_translations": {
                                "zh": "舞者在舞台上动作<w>灵活</w>，姿态优美。"
                            }
                        },
                        {
                            "text": "Regular yoga practice helps keep your joints <w>supple</w> and healthy.",
                            "target_lang_translations": {
                                "zh": "经常练习瑜伽有助于保持关节<w>柔韧</w>和健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lithe",
                        "agile",
                        "limber"
                    ],
                    "common_phrases": [
                        "supple joints",
                        "supple fingers"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的动作轻盈、灵活，身体柔韧。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灵活",
                                "target_lang_sense_clarification": "形容动作敏捷，不僵硬。"
                            },
                            {
                                "target_lang_word": "柔韧",
                                "target_lang_sense_clarification": "形容身体关节或动作的灵活性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ebe0fd5-462e-3475-adc7-6c77910acc60",
                    "sense_definition": "Compliant; yielding to the will of others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader demanded a <w>supple</w> and obedient staff.",
                            "target_lang_translations": {
                                "zh": "领导要求员工要<w>顺从</w>且听话。"
                            }
                        },
                        {
                            "text": "He found it difficult to remain <w>supple</w> under such strict pressure.",
                            "target_lang_translations": {
                                "zh": "他发现自己在如此严苛的压力下很难保持<w>顺从</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compliant",
                        "yielding",
                        "submissive"
                    ],
                    "antonyms": [
                        "stubborn",
                        "obstinate"
                    ],
                    "common_phrases": [
                        "supple will"
                    ],
                    "target_lang_definitions": {
                        "zh": "指性格顺从、容易被他人左右。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺从",
                                "target_lang_sense_clarification": "指服从他人的意愿。"
                            },
                            {
                                "target_lang_word": "温顺",
                                "target_lang_sense_clarification": "形容性格温和且容易听从指挥。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e91c638-26ed-33af-b1fa-27a80b8f433a",
                    "sense_definition": "Smooth and pleasant to drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wine had a <w>supple</w> texture that pleased the critics.",
                            "target_lang_translations": {
                                "zh": "这款酒口感<w>圆润</w>，令评论家们赞不绝口。"
                            }
                        },
                        {
                            "text": "This vintage is known for its <w>supple</w> finish.",
                            "target_lang_translations": {
                                "zh": "这款年份酒以其<w>顺滑</w>的余味而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smooth"
                    ],
                    "target_lang_definitions": {
                        "zh": "指酒的口感圆润、顺滑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圆润",
                                "target_lang_sense_clarification": "形容酒的口感饱满且顺滑。"
                            },
                            {
                                "target_lang_word": "顺滑",
                                "target_lang_sense_clarification": "形容口感平滑，没有刺激感。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49b7625a-ce14-3f24-99af-1cbe9853e50e",
                    "sense_definition": "To make or become flexible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warm oil can help <w>supple</w> the dry skin.",
                            "target_lang_translations": {
                                "zh": "温热的油有助于<w>软化</w>干燥的皮肤。"
                            }
                        },
                        {
                            "text": "The exercise routine helped <w>supple</w> his stiff muscles.",
                            "target_lang_translations": {
                                "zh": "这套锻炼动作有助于<w>放松</w>他僵硬的肌肉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soften",
                        "loosen"
                    ],
                    "antonyms": [
                        "stiffen"
                    ],
                    "target_lang_definitions": {
                        "zh": "使变得柔软或灵活。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……柔软",
                                "target_lang_sense_clarification": "通过某种方式让物体或身体部位变软。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb8fd606-64be-3ef2-8527-79d0d96dc66c",
                    "sense_definition": "To make compliant, submissive, or obedient.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh training was intended to <w>supple</w> the recruits' resistance.",
                            "target_lang_translations": {
                                "zh": "严酷的训练旨在<w>驯服</w>新兵们的反抗情绪。"
                            }
                        },
                        {
                            "text": "They tried to <w>supple</w> his stubborn attitude through constant criticism.",
                            "target_lang_translations": {
                                "zh": "他们试图通过不断的批评来<w>驯服</w>他固执的态度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subdue",
                        "tame"
                    ],
                    "target_lang_definitions": {
                        "zh": "使变得顺从或服帖。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驯服",
                                "target_lang_sense_clarification": "使人变得听话、顺从。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "31828765-e4c2-369f-9caf-352de3387442",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The family <w>Supples</w> moved to the city last year.",
                            "target_lang_translations": {
                                "zh": "<w>萨普尔</w>一家去年搬到了城里。"
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Supple</w> at the conference.",
                            "target_lang_translations": {
                                "zh": "我在会议上遇到了一位名叫<w>萨普尔</w>先生的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "萨普尔",
                                "target_lang_sense_clarification": "Supple 的音译姓氏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}