                                        "entry_id": "871317b3-c3cf-3bca-85bb-5a6650982210",
                                        "glosses": [
                                            "A tree that yields such wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
