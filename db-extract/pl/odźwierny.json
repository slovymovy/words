                    }
                ],
                "translations": [
                    {
                        "translation_id": "4af2f02c-a5d3-435b-ac20-98435932c7ae",
                        "source_entry_id": "ffed49eb-3004-35dd-8793-ba82a9c5a3e1",
                        "source_sense_id": "7cafe8a1-0baa-33ce-b0d9-567296546bea",
                        "target_lang_word": "Pförtner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pförtner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                        "entry_id": "c8499f85-3328-37b2-b5e6-5e690ef4798b",
                                        "glosses": [
                                            "eine Person, die den Zutritt von Personen zu größeren Gebäuden oder Gebäudekomplexen überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "160331b0-ec08-4351-8811-deef4ed8f51b",
                                                "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                                "text": "Der Pförtner öffnete die Schranke."
                                            },
                                            {
                                                "example_id": "6b882c5b-0237-4680-90c0-8236aa0bd508",
                                                "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                                "text": "„Jetzt am Vormittag steht der Pförtner davor, raucht seine Pfeife.“"
                                            },
                                            {
                                                "example_id": "3226e7d8-68b3-4700-a467-6df56dd33814",
                                                "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                                "text": "„An den ersten beiden Tagen rief der Pförtner noch bei Tante Dagmar an, bevor er mich reinließ, aber dann war ich schon ein alter Bekannter für den.“"
                                            },
                                            {
                                                "example_id": "e5f4d613-6cb9-4970-a9ec-0b2c6701ad98",
                                                "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                                "text": "„Er brachte mich noch zum Tor, damit der Pförtner mich kenne.“"
                                            },
                                            {
                                                "example_id": "264f6118-fa0b-4004-b3d8-8aff6499a19e",
                                                "sense_id": "aaf91131-236e-3c90-b2c7-ef2ce8dd9213",
                                                "text": "„Kein Pförtner im Haus, den ich mit einem Bahnbeamten verwechseln könnte, und doch ist diese Wohnung, in der ich nur drei bis vier Wochen im Jahr verbringe, mir fremder als jedes Hotel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a18902d9-fde7-3783-871e-b26a657a1102",
                                        "entry_id": "c8499f85-3328-37b2-b5e6-5e690ef4798b",
                                        "glosses": [
                                            "Schließmuskel am Magenausgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8486421-7ada-4e3c-b2ae-0a56137b9f5e",
                                                "sense_id": "a18902d9-fde7-3783-871e-b26a657a1102",
                                                "text": "Den größten Anteil des Magens macht der Magenkörper, der Korpus aus, der sich nach unten zum Pförtner hin verengt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f030aad1-0ec8-4d2b-9770-176e140058f9",
                        "source_entry_id": "ffed49eb-3004-35dd-8793-ba82a9c5a3e1",
                        "source_sense_id": "7cafe8a1-0baa-33ce-b0d9-567296546bea",
                        "target_lang_word": "Portier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                        "entry_id": "20e11cff-528f-3d67-827e-cc17ac7c67ff",
                                        "glosses": [
                                            "(männliche^☆) Person, die am Eingang von Gebäuden mit viel Publikumsverkehr (etwa Hotels, Wohnanlagen oder Bürokomplexen) Kommende und Gehende in Augenschein nimmt, ihnen beim Betreten beziehungsweise Verlassen des Gebäudes behilflich ist und Auskünfte erteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9be3bb9-0796-4048-8afc-7ff42688a431",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "Tino arbeitet als Portier in einem Luxushotel."
                                            },
                                            {
                                                "example_id": "4d3a05b4-6071-4ca1-b7ba-16b26904a298",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "Unser Portier wird Ihnen stets zu Diensten sein."
                                            },
                                            {
                                                "example_id": "f0cb9a75-1400-4b59-87a6-60f953d8462c",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "Die Portiers sind mit ihrer neuen Livree ganz und gar nicht glücklich."
                                            },
                                            {
                                                "example_id": "982df816-ef5d-4d56-9222-1ed92ce6936c",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "„In keinem teuren oder billigen Hotel der Welt, vor keinem anzüglichen oder arglosen Portier wäre sie mir peinlich gewesen, aber hier, in einer Atmosphäre der Katatonie, ein Zimmer zur Befriedigung vitalster Lebensbedürfnisse zu verlangen, empfand ich schon fast als unanständig.“"
                                            },
                                            {
                                                "example_id": "8f0c4960-deff-46e4-9f97-01cd6549203e",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                                            },
                                            {
                                                "example_id": "c733376c-c3b0-4407-b15f-af1c68e01794",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "„Die Portiers schenken mir Briefmarken, die ich sammle, weil ich sie vielleicht später verkaufen kann.“"
                                            },
                                            {
                                                "example_id": "3181f891-b531-43b9-9989-a3c9461e1b3c",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "„Endlich ist sie in der Eingangshalle des Bankgebäudes und trägt dem Herrn Portier ihre Bitte vor, Herrn Hackendahl für einen Augenblick herunterzurufen, Herrn Heinz Hackendahl von der statistischen Abteilung.“"
                                            },
                                            {
                                                "example_id": "2686302b-29f1-4ee5-bf7f-50358f2859ca",
                                                "sense_id": "0c2f7bfe-f6d0-3d17-947c-3009fb446628",
                                                "text": "„Der Portier konnte ihnen lediglich erklären, daß die Katze keinen Namen trage, und das verdroß ihn erheblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24a3a3e5-a2a8-39ae-bd6a-0f7ba6a7a1ab",
                                        "entry_id": "20e11cff-528f-3d67-827e-cc17ac7c67ff",
                                        "glosses": [
                                            "Hausmeister"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f196bb0-4c89-4ef1-94ce-fadc198c18c2",
                                                "sense_id": "24a3a3e5-a2a8-39ae-bd6a-0f7ba6a7a1ab",
                                                "text": "Informiere bitte den Portier über die unhaltbaren Zustände in der Waschküche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ef1e9e6-2b1d-4e10-bf60-53e2c9d12016",
                        "source_entry_id": "ffed49eb-3004-35dd-8793-ba82a9c5a3e1",
                        "source_sense_id": "7cafe8a1-0baa-33ce-b0d9-567296546bea",
                        "target_lang_word": "Schweizer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweizer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "(männlicher^☆) Staatsangehöriger der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e05039-24d1-41be-8716-4714e8de3b9c",
                                                "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                                "text": "„Schweizer des Jahres wird man nicht einfach so. Da muss man schon Schweizer sein.“"
                                            },
                                            {
                                                "example_id": "e24c4893-c532-457f-8fbc-5afcbd872555",
                                                "sense_id": "4b370330-4a09-3a84-a91a-a5e2e199f966",
                                                "text": "Viktor Giacobbo ist ein Schweizer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
                                            "Türhüter (beim Papst)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb06020-d2a5-4230-807a-5e14486f0c45",
                                                "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                                "text": "Man muß bis in die Zeit der Renaissance zurückgehen, um die Gründe zu verstehen, die Papst Julius II. bewogen, die Schweizer nach Rom kommen zu lassen. Heute steht an jedem Außeneingang des Vatikans mindestens ein Schweizer."
                                            },
                                            {
                                                "example_id": "80aa625a-50e9-47c3-bdd9-4a6252abba24",
                                                "sense_id": "3add0c46-82b5-34d2-be3f-f65f052411f0",
                                                "text": "„Ich wandte mich an den Schweizer und sagte ihm, ich hätte einen Brief für Versailles und es wäre mir sehr angenehm, ihn dem Kurier mitgeben zu können, der zurückreisen sollte, sobald er die Depeschen von Seiner Exzellenz erhalten hätte. »Aber, mein Herr,« sagte der Schweizer, »seit zwei Monaten haben wir keinen außerordentlichen Kurier hier gehabt!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f341abe8-c0ef-3dee-9f34-d0dc301d91b3",
                                        "entry_id": "4c8f259e-7609-3c81-8f54-30f43cd674d1",
                                        "glosses": [
