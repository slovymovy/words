                "senses": [
                    {
                        "sense_id": "70a01544-2bbb-3ac9-bb37-71a1fc1e50df",
                        "entry_id": "67b28a1e-3e85-3b37-8aea-3703cc7a9929",
                        "glosses": [
                            "Adventurous, exciting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e2cdf0-5dc6-4fbd-9ac0-a73ed1aed3ed",
                                "sense_id": "70a01544-2bbb-3ac9-bb37-71a1fc1e50df",
                                "text": "Brecel's swashbuckling style has endeared him to fans across the world, in particular the manner of his famous victories over O'Sullivan and Si Jiahui on his run to the final."
                            },
                            {
                                "example_id": "c4734270-5749-4489-9d84-560d9d552c6b",
                                "sense_id": "70a01544-2bbb-3ac9-bb37-71a1fc1e50df",
                                "text": "“Thank you, but I'm gonna come home, like, all the time. Ooh, I want to cuddle that baby!” “And maybe give her some swashbuckling tips?” “Already worried she's going to be deadly. You're going to be such a good mom.”"
                            }
                        ]
                    }
                ],
