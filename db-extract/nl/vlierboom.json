                                                "sense_id": "5943568b-d495-3759-9703-f5f5ca87392e",
                                                "text": "„Unter dem Holunderbaum",
                                                "translation": "Unter dem Holunderbaum. […]“"
                                            },
                                            {
                                                "example_id": "06c357c0-1339-4e64-9d17-ae9ee0a6c8a8",
                                                "sense_id": "5943568b-d495-3759-9703-f5f5ca87392e",
                                                "text": "„Holunderbäume wurden noch im Mittelalter auch Hel-Bäume oder Elfenbäume genannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42913632-94dc-426f-bef0-df58582bf583",
                        "source_entry_id": "c760e548-075d-36d9-8710-66a7f342744c",
                        "source_sense_id": "6edeb825-8bc7-34dd-b9ae-02b9785b33ce",
