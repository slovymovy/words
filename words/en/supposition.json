                    ]
                },
                {
                    "sense_id": "c5f808d9-86fd-3769-8802-b6c64e3dd3ee",
                    "sense_definition": "The act of assuming or imagining something to be true.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supposition</w> that he would arrive on time proved to be incorrect."
                        },
                        {
                            "text": "We must avoid the <w>supposition</w> that success is guaranteed without any effort."
