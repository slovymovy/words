                    {
                        "translation_id": "7393aca6-e931-4821-87b4-eccec2b6b35b",
                        "source_entry_id": "197e7b7e-d337-38e1-9793-6397f60309e5",
                        "source_sense_description": "cosmetic",
                        "target_lang_word": "бели́ла",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бели́ла",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88821697-5d7e-3995-8db0-e5a1d514a0e4",
                                        "entry_id": "3c6ba797-f42e-38a5-a9ec-b7efb72dc511",
                                        "glosses": [
                                            "белая минеральная краска, используемая в малярных работах и в живописи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f29da152-0837-4760-a5af-4cd5ffe6c82e",
                                                "sense_id": "88821697-5d7e-3995-8db0-e5a1d514a0e4",
                                                "text": "Возле церкви звонарь дядя Лёня размешивал палкой в ведре белила."
                                            },
                                            {
                                                "example_id": "00b8cad3-3c44-4286-a603-85bc39b6eda5",
                                                "sense_id": "88821697-5d7e-3995-8db0-e5a1d514a0e4",
                                                "text": "Дионисий любил, положив основной яркий тон, затем приглушить, сгладить его, положив сверху белила или разбеленную краску."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36333f6e-5332-360a-92fb-54b0d4ef5fca",
                                        "entry_id": "3c6ba797-f42e-38a5-a9ec-b7efb72dc511",
                                        "glosses": [
                                            "косметическое вещество белого цвета, используемое обычно как театральный грим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7069d2-e92f-44c5-9e3c-9db2df4e16c2",
                                                "sense_id": "36333f6e-5332-360a-92fb-54b0d4ef5fca",
                                                "text": "Мисс Жаксон, удостоверясь, что Лиза не думала поднять её на смех, успокоилась, поцеловала Лизу и в залог примирения подарила ей баночку английских белил, которую Лиза приняла с изъявлением искренней благодарности."
                                            },
                                            {
                                                "example_id": "71022e1c-e291-4322-ba26-a1a7ef15f888",
                                                "sense_id": "36333f6e-5332-360a-92fb-54b0d4ef5fca",
                                                "text": "Нина смотрит, актёрки белила кладут, и она белила. Те поверх белил — опять румяна, и она. Пока ей гримёр не сказал: — Ты, девушка, стирай всё, тебе до грима ещё далеко, милая."
                                            }
                                        ]
                                    }
                                ]
