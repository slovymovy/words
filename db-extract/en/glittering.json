    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                "word": "glittering",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e6612c74-3e2d-4d12-9e73-c3d770975696",
                        "entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more glittering"
                    },
                    {
                        "form_id": "3bbf3932-9c4c-4202-9bcc-875fa28fabb9",
                        "entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most glittering"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80891c30-550e-3492-b07b-477bb117e31b",
                        "entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                        "glosses": [
                            "Brightly sparkling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca0e262-08d6-4539-b587-74215d68b14a",
                                "sense_id": "80891c30-550e-3492-b07b-477bb117e31b",
                                "text": "[T]he fair star / That gems the glittering coronet of morn, / Sheds not a light so mild, so powerful, / As that which, bursting from the Fairy's form, / Spread a purpureal halo round the scene, / Yet with an undulating motion, / Swayed to her outline gracefully."
                            },
                            {
                                "example_id": "1d853cd6-4921-45be-923e-2e09cf90667f",
                                "sense_id": "80891c30-550e-3492-b07b-477bb117e31b",
                                "text": "It was flood-tide along Fifth Avenue; motor, brougham, and victoria swept by on the glittering current; pretty women glanced out from limousine and tonneau; young men of his own type, silk-hatted, frock-coated, the crooks of their walking sticks tucked up under their left arms, passed on the Park side."
                            }
                        ]
                    },
                    {
                        "sense_id": "48615604-2a0f-3bb5-83b1-3292d9d2faa7",
                        "entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                        "glosses": [
                            "Valuable, desirable."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "73a41751-3ceb-49a6-abe3-dd545c52f1b0",
                                "sense_id": "48615604-2a0f-3bb5-83b1-3292d9d2faa7",
                                "text": "Gaur was an example of a man without a BA who seemed infinitely better educated than the fellows who left Fort Hare with glittering degrees."
                            },
                            {
                                "example_id": "a71127c5-e7b0-4a4e-8fb8-e72e43993737",
                                "sense_id": "48615604-2a0f-3bb5-83b1-3292d9d2faa7",
                                "text": "There are some glittering stats out there regarding Brassey: namely that he'd built around one-third of Britain's railways by the time he was in his early 40s, and that by the time of his death (aged 65) he was responsible for around one-twentieth of the world's railways."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c2b0953-4387-4875-8c9d-e47964e86975",
                        "source_entry_id": "8a418df4-717b-343f-a83b-8b591d865082",
                        "source_sense_description": "brightly sparkling",
                        "target_lang_word": "étincelant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étincelant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui étincelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23941d3d-dd7f-49a2-8a61-5e8d9784e286",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "Il a fait très frais pendant la nuit, et, ce matin, quand je suis sorti de ma tente, la campagne était étincelante de givre."
                                            },
                                            {
                                                "example_id": "4530c0aa-2d4b-435b-afec-071f301f984a",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "À l’inverse, la Metro Goldwyn Mayer revendique le luxe étincelant dans des décors de rêve, mettant en valeur son écurie de stars ultra-glamour."
                                            },
                                            {
                                                "example_id": "6787ab76-f8fe-44af-b0a6-b0a194145723",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "Et, dans sa grâce, il créa une gigantesque coupole d'or étincelant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976c6096-6b4f-3770-8c90-6f5daadf289e",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui semble étinceler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff1c50b-d4aa-4ab7-97f3-90a6fbe4154f",
                                                "sense_id": "976c6096-6b4f-3770-8c90-6f5daadf289e",
                                                "text": "D’une maigreur extrême, les joues d’un rouge sombre, les yeux caves et étrangement étincelants, les lèvres amincies et douloureusement serrées, elle semblait vieillie de dix années, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c773976d-fd73-333f-804f-6a67eb27f2da",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui lance des traits d’esprit brillants."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a268ff08-ba05-4660-bec0-96a7ed494c1a",
                                                "sense_id": "c773976d-fd73-333f-804f-6a67eb27f2da",
                                                "text": "Un esprit étincelant. Un style étincelant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4edf5da-6c74-3b89-b1a7-a340ce910cb1",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Se dit de charbon, astre, lumière ou feux qui sont représentés avec des étincelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6252d5-228e-4794-b528-ce9bda2ba5ee",
                                                "sense_id": "f4edf5da-6c74-3b89-b1a7-a340ce910cb1",
                                                "text": "D’azur à la fasce ondée d’argent chargée de trois losanges de sable, accompagné en chef d’une étoile étincelante d’or et en pointe d’une croix patriarcale, qui est du Cardinal Joseph Charbonneau → voir illustration « étoile étincelante »"
                                            }
                                        ]
                                    }
                                ]
                            },
