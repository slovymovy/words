                "senses": [
                    {
                        "sense_id": "d21b6f6f-e6cc-36bf-9f9e-a133beead7f8",
                        "entry_id": "7b07404c-1548-300a-bda2-6fc725da68f5",
                        "glosses": [
                            "Faire une mâsse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "32575f5f-c4be-4dad-87b2-7cbcf676b4fc",
                                "sense_id": "d21b6f6f-e6cc-36bf-9f9e-a133beead7f8",
                                "text": "C’est en mon nom que vous avez mâssé les mulets ; je vous envoie cent pistoles, sur et tant moins de la perte que vous pouvez avoir faite pour moi."
                            },
                            {
                                "example_id": "f1215321-851d-414b-acda-1bf9cf9641fe",
                                "sense_id": "d21b6f6f-e6cc-36bf-9f9e-a133beead7f8",
                                "text": "Et qui mâsse mille pistoles Comme s’il mâssait mille oboles"
                            },
                            {
                                "example_id": "7e524b3b-b389-4810-af60-34337c2d19ec",
                                "sense_id": "d21b6f6f-e6cc-36bf-9f9e-a133beead7f8",
                                "text": "Je voulais de l’argent pour acheter des pipes ; Et, loin de m’en fournir comme j’aurais pensé, Peut-être ce jour-là vous auriez tout mâssé."
                            }
                        ]
                    }
