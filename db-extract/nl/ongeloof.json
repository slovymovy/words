        "nl-extract.jsonl": [
            {
                "entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                "word": "ongeloof",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "glosses": [
                            "het niet (kunnen) geloven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb139a35-309d-4452-88b0-1a2afcc2115a",
                                "sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                                "text": "De vreugde op de Nederlandse bank was uitzinnig. Waar iedereen sprong, bleef coach Ilse DeLange met de handen voor haar ogen zitten. Ongeloof won het nog van de vreugde. Laurence was al snel weer bij zijn positieven en nam de trofee in ontvangst met de woorden: ‘To Music first. Always.’"
                            },
                            {
                                "example_id": "f4b7ce3a-0e98-4ee1-8373-c20c1eca5655",
                                "sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                                "text": "Vol ongeloof sta ik op en voel aan haar lakens."
                            },
                            {
                                "example_id": "b9d3fb19-0c05-4dfa-9bf2-48128da2f479",
                                "sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                                "text": "Vol ongeloof staarden ze ernaar: een meisje van een jaar of tien met een peuter in haar armen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3f53213-7e89-4415-b796-8ea0c249423f",
                        "source_entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "source_sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "source_sense_description": "het niet geloven",
                        "target_lang_word": "Unglaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unglaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                        "entry_id": "ca472cb6-3ec0-3103-9b0c-1253508e6787",
                                        "glosses": [
                                            "Ablehnung religiösen Glaubens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30726986-40a0-4a2f-bd7d-077c6a6d1743",
                                                "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                                "text": "„Er brauchte etwas Großes, Weites, in das er sich hinein begeben könnte, nachdem er in dem Zustand des Unglaubens kein Glück gefunden hatte.“"
                                            },
                                            {
                                                "example_id": "8b11debb-9177-4aca-bfe8-afa433845f07",
                                                "sense_id": "4553efba-f539-3b5d-9450-e01803e52205",
                                                "text": "„Nicht wenige bezahlten ihren Unglauben sogar mit dem Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "890fee71-a8fe-394e-8703-0e243deacbae",
                                        "entry_id": "ca472cb6-3ec0-3103-9b0c-1253508e6787",
                                        "glosses": [
                                            "Annahme, dass eine Aussage/Behauptung wahrscheinlich nicht zutrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bbe27da-8bd8-40c9-aa7c-3f7ff64a3a0e",
                                                "sense_id": "890fee71-a8fe-394e-8703-0e243deacbae",
                                                "text": "„Sie spürte seine Nachgiebigkeit und seinen Unglauben; es waren die Spinngewebe, die sie wieder umwickeln und lähmen wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e312417-58cd-49f3-9f6a-a0a03c66219d",
                        "source_entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "source_sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "source_sense_description": "het niet geloven",
                        "target_lang_word": "disbelief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disbelief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "996f4771-ee53-322b-80c2-3015064627a2",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "An unpreparedness, unwillingness, or an inability to believe that something is the case."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "767badf0-32b3-4249-85d6-887601099990",
                                                "sense_id": "996f4771-ee53-322b-80c2-3015064627a2",
                                                "text": "She cried out in disbelief on hearing that terrorists had crashed an airplane into the World Trade Center in New York City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21ae535-e72a-3e37-812e-bd763050f9e9",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "Astonishment."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18dd6a3c-a92a-4e8d-9a40-b3b7c79ff93e",
                                                "sense_id": "c21ae535-e72a-3e37-812e-bd763050f9e9",
                                                "text": "I stared in disbelief at the Grand Canyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                        "entry_id": "18f3bdac-e5a6-374d-9919-76e1b9d40a8a",
                                        "glosses": [
                                            "The loss or abandonment of a belief; the cessation of belief."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223247ab-ddaf-43ea-8a57-54f8eed5eda0",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "Just like the disbelief in Santa Claus happens gradually, I wondered if it was similar for people leaving their faith."
                                            },
                                            {
                                                "example_id": "096db3af-4220-49cd-be58-f753959cad0b",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "There is an agony of suffering in that lingering doubt which haunts the human soul in the beginnings of disbelief."
                                            },
                                            {
                                                "example_id": "469f2194-8c9c-44e7-8551-6678e3f28c70",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "No adolescent can achieve disbelief in the stork without an eruption of young oaths and cynicisms."
                                            },
                                            {
                                                "example_id": "8d8df236-c22a-4f54-bd33-4ad49f145202",
                                                "sense_id": "c042fc21-5f66-3217-b98a-6e2ed610c949",
                                                "text": "His later left-wing films prevented any pure and strong emotional attachment between the two sexes from gaining narrative momentum, which might reflect his gradual disbelief in romantic love."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df05158a-c013-455f-8b0d-24ae3c92eb9f",
                        "source_entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "source_sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "source_sense_description": "het niet geloven",
                        "target_lang_word": "unbelief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbelief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53307342-18fb-3fbe-b912-4719e9a771ac",
                                        "entry_id": "62918ffd-c8a4-3c85-946c-20a694a2eba9",
                                        "glosses": [
                                            "An absence (or rejection) of belief, especially religious belief."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e960309e-232d-4b13-9a7d-5014c5c3a51e",
                                                "sense_id": "53307342-18fb-3fbe-b912-4719e9a771ac",
                                                "text": "And he coulde there ſhewe no myracles butt leyd his hondꝭ apon a feawe ſicke foolke ãd healed thẽ. And he merveyled at their vnbelefe."
                                            },
                                            {
                                                "example_id": "c71d0be6-5dfd-48d8-a013-74476626ac91",
                                                "sense_id": "53307342-18fb-3fbe-b912-4719e9a771ac",
                                                "text": "On hands and knees he looked at the empty siding and up at the sunfilled sky with unbelief and despair."
                                            },
                                            {
                                                "example_id": "51e44e61-44fa-430e-999a-589529f96ce2",
                                                "sense_id": "53307342-18fb-3fbe-b912-4719e9a771ac",
                                                "text": "Soon Spinoza was regarded as the standard-bearer for unbelief, even though pervading his carefully-worded writings there is a clear notion of a divine spirit inhabiting the world, and a profound sense of wonder and reverence for mystery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f924cd0f-a8d8-4056-8eab-bcdf1843deb0",
                        "source_entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "source_sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "source_sense_description": "het niet geloven",
                        "target_lang_word": "incroyance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incroyance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8239df3-db59-3033-8958-35211f31adeb",
                                        "entry_id": "5aa4a16c-f174-3396-831a-8e3b2570a9ba",
                                        "glosses": [
                                            "Absence de croyance, de foi en matière de religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b207e859-27a8-4b54-8eeb-db65bfbdcdd8",
                                                "sense_id": "f8239df3-db59-3033-8958-35211f31adeb",
                                                "text": "[L'influence du Génie du Christianisme]: L'athéisme et le matérialisme ne furent plus la base de la croyance ou de l'incroyance des jeunes esprits ; (…) On ne fut plus cloué dans sa place par un préjugé antireligieux ; on ne se crut plus obligé de rester momie du néant, entourée de bandelettes philosophiques ; on se permit d'examiner tout système, si absurde qu'on le trouvât, fût−il même chrétien."
                                            },
                                            {
                                                "example_id": "83954573-9ea0-410f-9a21-f9782c0f6e40",
                                                "sense_id": "f8239df3-db59-3033-8958-35211f31adeb",
                                                "text": "Soudain ces hommes sceptiques, aimables, indifférents à toute religion, se mirent à raconter des faits étranges, des histoires incroyables mais arrivées, affirmaient-ils, retombant brusquement en des croyances superstitieuses, se cramponnant à ce dernier reste de merveilleux, devenus dévots, à ce mystère du magnétisme, le défendant au nom de la science.\nUn seul souriait, un vigoureux garçon, grand coureur de filles et chasseur de femmes, chez qui une incroyance à tout s'était ancrée si fortement qu'il n'admettait même point la discussion."
                                            },
                                            {
                                                "example_id": "c9793e77-66e6-4ff7-9be6-97a6f080a96b",
                                                "sense_id": "f8239df3-db59-3033-8958-35211f31adeb",
                                                "text": "(…) si jadis la foi religieuse avait seule rendu possible la résignation aux injustices sociales, les vertus dont cette foi est le soutien pourraient, seules encore, assurer l'établissement et la durée d'une société d'où ces injustices seraient bannies. Or le peuple ne croyait plus. Incroyant lui-même, Hermann n'avait pas l'hypocrisie de lui reprocher son incroyance; mais il ne se dissimulait pas à quel point cette émancipation de l'esprit était destructive de la bonté et du désintéressement chez des hommes grossiers, (…) Si ces gens-là devenaient les maîtres, que feraient-ils de leur puissance? À quels brigandages, à quel désordre, à quel chaos fallait-il s'attendre?"
                                            },
                                            {
                                                "example_id": "fdcc9ddf-d58b-4e1b-988c-a2be51bbc87e",
                                                "sense_id": "f8239df3-db59-3033-8958-35211f31adeb",
                                                "text": "Un couple de comiques anglais révolutionne l’incroyance avec le mouvement international The Sunday Assembly. … Cette vague nouvelle d’athéisme, d’incroyance, d’irréligiosité se répand depuis 2013 dans le monde anglophone. Des Sunday Assemblies ont surgi au Royaume-Uni, en Irlande, aux Etats-Unis (même dans des villes profondément chrétiennes telles que Nash­ville), au Canada et en Australie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6cd5f8b-681f-45b3-8fac-3868070b5437",
                        "source_entry_id": "42003731-fd8e-3494-abbe-1a085a8720d6",
                        "source_sense_id": "b596ddbd-d51b-393e-b98a-7a52f3ac8562",
                        "source_sense_description": "het niet geloven",
                        "target_lang_word": "incrédulité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incrédulité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                                        "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                                        "glosses": [
                                            "Absence de crédulité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63f84c3-a85a-4a3c-89ab-bdacc3f5960d",
                                                "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                                                "text": "L’incrédulité de Bert était ébranlée. Il posait des questions, et le soldat y répondait complaisamment."
                                            },
                                            {
                                                "example_id": "72b1d8b6-5fa7-44d0-8bf7-531e7c9e1032",
                                                "sense_id": "1c96e672-dfec-3217-89d5-e3e5fa91ef5b",
                                                "text": "Dans l'espèce humaine, la Parthénogénèse n'a été vue que par les yeux de la foi ; il n'en est pas ainsi dans les rangs inférieurs de l'animalité, et même à ce degré, la chose est si extraordinaire qu'elle a dû, au début, être accueillie par les esprits prudents avec certaines réserves, sinon même avec incrédulité, […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                                        "entry_id": "b3882dcb-f3e0-3e30-8c2f-b12a2c26c33b",
                                        "glosses": [
                                            "Manque de foi, de croyance dans les choses religieuses."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39562b8e-207b-4484-b9db-ddaa7f76c735",
                                                "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                                                "text": "L’incrédulité est quelquefois le vice d’un sot, et la crédulité le défaut d’un homme d’esprit. L’homme d’esprit voit loin dans l’immensité des possibles ; le sot ne voit guère de possible que ce qui est."
                                            },
                                            {
                                                "example_id": "258396e0-f897-446b-8f6e-139e8f201f43",
                                                "sense_id": "02c25383-7338-3002-9cb3-ae0ebb319d1a",
                                                "text": "[…], je médite longtemps parmi les derniers tronçons d'une humble église qui put avoir ses beautés ; […], peu à peu le séculaire édifice tomba, détruit d’année en année par l'eau du ciel et l’incrédulité des hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
