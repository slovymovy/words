                ],
                "senses": [
                    {
                        "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                        "entry_id": "62bc83dc-96e7-3f29-9f18-3be57592ff1d",
                        "glosses": [
                            "Bereich, der für die Errichtung neuer Gebäude bestimmter Nutzungsart vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b1bd3b-7ba5-4fa6-a0a4-991cdd9a0250",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Zudem kündigte er detaillierte Untersuchungen der Klima-, Wind- und Lärmsituation im Baugebiet an.“"
                            },
                            {
                                "example_id": "858e5591-1c5a-4950-9da8-71c1177d0364",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Beim Baugebiet Böhmerwaldstraße, wo die Steag derzeit die Fernwärmeleitungen verlegt, kommt die Erschließung um über 500 000 Euro günstiger als gedacht, gut 2,5 Millionen waren geschätzt, tatsächlich werden es aber nur gut zwei Millionen.“"
                            },
                            {
                                "example_id": "f9226fb7-7f06-42ff-ad05-78894321d3d1",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Die Erschließungsarbeiten im Baugebiet ‚Nördlich der Bergstraße‘ haben begonnen.“"
                            },
                            {
                                "example_id": "e5ecf522-c4f3-4827-aff6-58c8e63db610",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Ein Akteneinsichtsausschuß der Stadtverordnetenversammlung wird sich auf Antrag der FDP-Fraktion mit den Erschließungsbeiträgen für das Baugebiet ‚Säuruh‘ in Dreieichenhain und deren teilweiser Verjährung beschäftigen.“"
                            },
                            {
                                "example_id": "5a6747ef-ce9c-46b2-b423-21f04995ca5b",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Seit 2011 kämen durch die Baugebiete Haide Süd und Henker mehr Familien, obwohl die Preise wegen der hohen Nachfrage im Rhein-Main-Gebiet stiegen.“"
                            },
                            {
                                "example_id": "5a78d028-67ad-4ce5-8d03-7cca5afbdce8",
                                "sense_id": "df0a723e-f0f9-342c-a558-a6ef6e7969eb",
                                "text": "„Da aber die Zuschüttung eines im Baugebiete sich befindlichen Teiches viel Zeit und Mühe erforderte, konnte es erst im Jahre 1805 vollendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
