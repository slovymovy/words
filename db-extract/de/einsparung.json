                "senses": [
                    {
                        "sense_id": "c3f76249-055b-34b4-9a49-4919e20a4fb4",
                        "entry_id": "be4b59de-aab0-3629-8a07-16e383345f53",
                        "glosses": [
                            "die Verringerung, Verkleinerung des Verbrauchs (häufig von Geld); das Einsparen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4cf137f-3339-4b55-9b88-9977dfa78dc0",
                                "sense_id": "c3f76249-055b-34b4-9a49-4919e20a4fb4",
                                "text": "In den meisten deutschen Haushalten ist die Einsparung von viel Energie und somit von viel Geld mit wenig Aufwand möglich."
                            },
                            {
                                "example_id": "856bb96d-fac1-47d7-bc22-4167f11794be",
                                "sense_id": "c3f76249-055b-34b4-9a49-4919e20a4fb4",
                                "text": "„Der Präsident des Bundes der Steuerzahler, Karl Heinz Däke, hat von den Bundesregierung deutliche Einsparungen verlangt, um weitere Steuersenkungen zu ermöglichen.“"
                            },
                            {
                                "example_id": "39b077f3-ae0f-40c5-8066-42986d915b80",
                                "sense_id": "c3f76249-055b-34b4-9a49-4919e20a4fb4",
                                "text": "„Trump verspricht sich von der neuen Abteilung massive Einsparungen im Regierungsapparat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21cfaec1-de90-43e4-aff7-1f3a601a6f55",
                        "source_entry_id": "be4b59de-aab0-3629-8a07-16e383345f53",
                        "source_sense_id": "c3f76249-055b-34b4-9a49-4919e20a4fb4",
                        "source_sense_description": "die Verringerung, Verkleinerung des Verbrauchs (häufig von Geld); das Einsparen",
                        "target_lang_word": "saving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saving",
