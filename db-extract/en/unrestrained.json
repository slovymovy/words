                ],
                "senses": [
                    {
                        "sense_id": "54cc60f0-080f-3e1c-b7b6-218d1d934778",
                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                        "glosses": [
                            "immoderate; not restrained or held in check; inordinate (literary)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26400c84-0d3a-4297-972a-10e47ab79c78",
                                "sense_id": "54cc60f0-080f-3e1c-b7b6-218d1d934778",
                                "text": "The party was a scene of unrestrained debauchery."
                            }
                        ]
                    },
                    {
                        "sense_id": "834a8fea-f5a0-3a9c-ac87-e3b16b28bbb9",
                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                        "glosses": [
                            "spontaneous, natural and informal; unconstrained"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf529a9-ed70-4f8c-be82-b472e2b91853",
                                "sense_id": "834a8fea-f5a0-3a9c-ac87-e3b16b28bbb9",
                                "text": "Their meeting was one of unrestrained joy."
                            }
                        ]
                    },
                    {
                        "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                        "entry_id": "22c62495-204d-3dcf-a7f2-cb3b28c32144",
                        "glosses": [
                            "Not subject to physical restraint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc5e99f-10fb-40d7-960d-7b717efcb957",
                                "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                                "text": "Managing unrestrained prisoners alone in any environment is inherently dangerous and should not be tolerated."
                            },
                            {
                                "example_id": "38a9905d-c4bb-4ed6-9e35-57d6bece0a30",
                                "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                                "text": "In an accident there will often be injuries, as people are unrestrained. But in the case of Sandilands, I don't think anyone would have foreseen the seven deaths and 62 injuries that occurred when the tram overturned [...]."
                            }
                        ]
                    }
                ],
