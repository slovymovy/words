                        "entry_id": "3f7093d3-0e7f-3506-9b3b-9ea00f0957db",
                        "glosses": [
                            "Celle qui continue après d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40e4960-5499-4269-a0b5-04e20e0282e9",
                                "sense_id": "4ac9e9d5-aebe-3082-b146-3b304253aa5f",
                                "text": "Mais, « femme d’un seul homme », comme le dit avec un soupir admiratif André Rousselet, elle aura été, sans le savoir et sans le vouloir, la continuatrice d’Yvonne de Gaulle."
                            }
                        ]
                    }
                ],
                "translations": [
