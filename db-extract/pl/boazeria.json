                ],
                "senses": [
                    {
                        "sense_id": "7fe1b03a-7210-3b60-abd8-2a70867c9a1e",
                        "entry_id": "acaab61e-e258-33b3-b6f6-28ba6b38d640",
                        "glosses": [
                            "drewniana lub drewnopodobna okładzina ścienna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb54d67-46ca-4302-8f43-b5ecd5cedc7d",
                                "sense_id": "7fe1b03a-7210-3b60-abd8-2a70867c9a1e",
                                "text": "Zasiedla nie tylko więźbę dachową, czy typowe ściany z drewna iglastego, ale nawet stare drewniane ramy okienne czy drewnianą boazerię i podłogi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6c4178a-fdf5-4aa6-958a-5c7c20fd602c",
                        "source_entry_id": "acaab61e-e258-33b3-b6f6-28ba6b38d640",
                        "source_sense_id": "7fe1b03a-7210-3b60-abd8-2a70867c9a1e",
                        "target_lang_word": "boiserie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boiserie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cefeba47-4daa-3143-8f73-9ab787757590",
                                        "entry_id": "cf02c9d2-1049-3cdf-bed5-8ffe27094272",
                                        "glosses": [
                                            "panelling; wood trim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e9072f-2f19-47bc-8c65-4e77b5bb463d",
                                                "sense_id": "cefeba47-4daa-3143-8f73-9ab787757590",
                                                "text": "Pot luck turned out to be an exquisite light lunch served at a round table in a room lined with rococo boiseries that had been removed wholesale from some grand Parisian town house and painted pale blue."
                                            },
                                            {
                                                "example_id": "04b63c4d-8db6-4604-9c7c-6b29f6a635fa",
                                                "sense_id": "cefeba47-4daa-3143-8f73-9ab787757590",
                                                "text": "Around 1960 the town house — 1081 Fifth Avenue, at 89th Street — was pulled down to make way for 1080 Fifth Avenue, and the boiseries were removed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "080f8796-9e0a-4b71-9289-da7db938a458",
                        "source_entry_id": "acaab61e-e258-33b3-b6f6-28ba6b38d640",
                        "source_sense_id": "7fe1b03a-7210-3b60-abd8-2a70867c9a1e",
                        "target_lang_word": "boiserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boiserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                        "entry_id": "d0994f48-9c9e-3fcb-addf-3160b55b61db",
                                        "glosses": [
                                            "Ouvrage de menuiserie dont on couvre les murs des appartements, des salles d’apparat, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef6e4dd-32ea-48f9-a2e4-7a7251b2dc62",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "A peine une salle était-elle cloisonnée que les menuisiers s'en emparaient pour y poser les boiseries et les vitrines, les tapissiers la tendaient d'étoffe, des ouvriers spéciaux la parquetaient de linoléum."
                                            },
                                            {
                                                "example_id": "80daf3a7-d6a5-4a4d-b8b6-b1fc39eef3da",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "Une atmosphère pesante et troublante régnait encore entre les murs aux boiseries sévères, sous le plafond à écussons."
                                            },
                                            {
                                                "example_id": "50b7aebb-48ad-4762-a040-0a14bf90be72",
                                                "sense_id": "e569eeb2-bb3a-3fd8-aeda-569487fe9317",
                                                "text": "[…] il n’est de bruit qu’un ver qui taraude incessamment les boiseries et dans le plafond, la course d’un rongeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
