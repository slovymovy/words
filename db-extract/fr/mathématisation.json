                "senses": [
                    {
                        "sense_id": "2c939a29-2a58-39e7-9451-47d3fde923cc",
                        "entry_id": "1ea6bbc6-2c01-3170-8e73-cc1914700e9d",
                        "glosses": [
                            "Utilisation de méthodes mathématiques pour décrire et synthétiser le monde réel ou l’un de ses aspects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e2ffd4-d0b7-4d3b-b40c-c0c50331e792",
                                "sense_id": "2c939a29-2a58-39e7-9451-47d3fde923cc",
                                "text": "En revanche, je dois reconnaître que je n’avais soupçonné l’importance que prendraient la mathématisation des risques et la commercialisation des actifs et créances risqués."
                            },
                            {
                                "example_id": "4318cf3e-38e0-4807-9706-41b1f46f95f5",
                                "sense_id": "2c939a29-2a58-39e7-9451-47d3fde923cc",
                                "text": "Le John Dee des années 1558 à 1583 est aujourd'hui considéré comme un des pionniers de la théorie empiriste de la connaissance fondée sur l'observation des faits, sur le raisonnement inductif et sur la mathématisation du monde."
                            },
                            {
                                "example_id": "d2609218-0f58-4ca2-813c-06d5c4f95f98",
                                "sense_id": "2c939a29-2a58-39e7-9451-47d3fde923cc",
                                "text": "La mathématisation de la physique."
                            },
                            {
                                "example_id": "8c2c3390-9b25-4b44-962e-636b22b2fea7",
                                "sense_id": "2c939a29-2a58-39e7-9451-47d3fde923cc",
                                "text": "L'École de Lausanne est la première à entreprendre la mathématisation des sciences économiques."
                            }
                        ]
                    }
