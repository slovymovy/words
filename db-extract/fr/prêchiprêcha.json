                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf4eb23-a0f2-3c8e-aeb4-865c17a59d85",
                                        "entry_id": "4bfed750-e6dc-3604-a589-3630c1533ffb",
                                        "glosses": [
                                            "A spoken lesson or exposition, usually delivered to a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fb1fe4-0121-456d-9b7a-641f5b902c00",
                                                "sense_id": "5cf4eb23-a0f2-3c8e-aeb4-865c17a59d85",
                                                "text": "During class today the professor delivered an interesting lecture."
                                            },
                                            {
                                                "example_id": "497451cf-30cb-4374-8532-f1031099e270",
                                                "sense_id": "5cf4eb23-a0f2-3c8e-aeb4-865c17a59d85",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee65e9fc-12f9-3100-9351-b02b1aa594a1",
                                        "entry_id": "4bfed750-e6dc-3604-a589-3630c1533ffb",
                                        "glosses": [
                                            "A class that primarily consists of a (weekly or other regularly held) lecture (as in sense 1), usually at college or university."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2159424-2841-46b1-bd7b-b203e0373cf9",
                                                "sense_id": "ee65e9fc-12f9-3100-9351-b02b1aa594a1",
                                                "text": "We will not have lecture tomorrow."
                                            },
                                            {
                                                "example_id": "41bd40e5-1846-4ae2-bfa3-2d114892d8d5",
                                                "sense_id": "ee65e9fc-12f9-3100-9351-b02b1aa594a1",
                                                "text": "Lecture notes are online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da4617f9-999f-3035-a9ca-620cebaacfef",
                                        "entry_id": "4bfed750-e6dc-3604-a589-3630c1533ffb",
                                        "glosses": [
                                            "A berating or scolding, especially if lengthy, formal or given in a stern or angry manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056505ff-b1e0-4bb3-8b0f-2f93fb158c30",
                                                "sense_id": "da4617f9-999f-3035-a9ca-620cebaacfef",
                                                "text": "I really don't want you to give me a lecture about my bad eating habits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a1bb3c-988e-3bd7-832c-226882079d0c",
                                        "entry_id": "4bfed750-e6dc-3604-a589-3630c1533ffb",
                                        "glosses": [
                                            "The act of reading."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce07327-b1a3-468e-8cb9-609c541db9f7",
                                                "sense_id": "c4a1bb3c-988e-3bd7-832c-226882079d0c",
                                                "text": "the lecture of Holy Scripture"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lecture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99037cd6-e3b1-381b-aef5-374c55fd0397",
                                        "entry_id": "e52f5083-dded-3145-8743-ec031a8ed27e",
                                        "glosses": [
                                            "To teach (somebody) by giving a speech on a given topic."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670eb3ec-e36d-40fa-aff1-cc5f8bc4110b",
                                                "sense_id": "99037cd6-e3b1-381b-aef5-374c55fd0397",
                                                "text": "The professor lectured to two classes this morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ca496a-0d96-3bde-9aa8-5e2a3645275c",
                                        "entry_id": "e52f5083-dded-3145-8743-ec031a8ed27e",
                                        "glosses": [
                                            "To preach, to berate, to scold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47270970-ece9-4fd5-b816-53cf55c6a609",
                                                "sense_id": "86ca496a-0d96-3bde-9aa8-5e2a3645275c",
                                                "text": "Emily's father lectured her about the importance of being home before midnight."
                                            },
                                            {
                                                "example_id": "26721d96-63dd-4953-b6c8-e83d5cc0a54b",
                                                "sense_id": "86ca496a-0d96-3bde-9aa8-5e2a3645275c",
                                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
