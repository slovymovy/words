                ],
                "translations": [
                    {
                        "translation_id": "640243b3-b6ac-4b0d-9e1d-037ccd9e0b9d",
                        "source_entry_id": "1b0b2bb0-4872-3859-83a6-74ae96cafa6b",
                        "target_lang_word": "distraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Something that distracts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28321ee-2b35-4b15-8530-4748faf84bdd",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "Poking one's eye is a good distraction from a hurting toe."
                                            },
                                            {
                                                "example_id": "d37d09d4-0811-47a6-aa59-d1bf92c76baa",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "At last the Duke of Anjou arrived, dressed, as his brother said, to distraction."
                                            },
                                            {
                                                "example_id": "a1618cc4-2dab-4b2a-91ea-d4611b79094d",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "“… This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "The process of being distracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f701c1e9-cf4e-4535-9d9c-2252126bbdfe",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We have to reduce distraction in class if we want students to achieve good results."
                                            },
                                            {
                                                "example_id": "e75ce999-88b9-40fa-a47d-173537338fda",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\",[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "9976f64f-8bdc-4c39-af5d-e359d58b3105",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We determined that the probable cause of the Tishomingo, Oklahoma, collision was the teen driver’s acceleration through the intersection after briefly slowing without stopping, due to distraction from having five teen passengers in the car, limited driving experience, and likely impairment from cannabis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Perturbation; disorder; disturbance; confusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de3b38e9-2e28-445e-8d66-683a13493993",
                                                "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                                "text": "It's true that the Copernican Systeme introduceth distraction in the universe of Aristotle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Mental disarray; a deranged state of mind; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c55cbc-725d-42eb-b546-965607926361",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "The incessant nightmares drove him to distraction."
                                            },
                                            {
                                                "example_id": "72ff139c-5411-44b3-bc8f-c79e0e2c6b43",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "[…] if he speak the words of an oath in a strange language, thinking they signify something else, or if he spake in his sleep, or deliration, or distraction, it is no oath, and so not obligatory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a56a58-05e1-3de7-90bd-7100f40ac23b",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Traction so exerted as to separate surfaces normally opposed."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbb3d953-c578-4728-b8c7-3743992eb443",
                        "source_entry_id": "1b0b2bb0-4872-3859-83a6-74ae96cafa6b",
                        "target_lang_word": "abstraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d88ad75-99b4-3295-af94-fa29b972805b",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bec9308-e329-46c5-b746-eb90066ad21b",
                                                "sense_id": "3d88ad75-99b4-3295-af94-fa29b972805b",
                                                "text": "The cancelling of the debt would be no destruction of wealth, but a transfer of it: a wrongful abstraction of wealth from certain members of the community, for the profit of the government, or of the tax-payers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc66616-bc72-36fe-95b8-50c4de379d12",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away.",
                                            "The taking surreptitiously for one's own use part of the property of another; purloining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60e0e216-8c56-35ad-b3fa-a2f8327edbf3",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of abstracting, separating, withdrawing, or taking away; withdrawal; the state of being taken away.",
                                            "Removal of water from a river, lake, or aquifer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0185cc38-4243-3e0d-a579-a6b3d8c8e26b",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "A separation from worldly objects; a recluse life; the withdrawal from one's senses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f37f6a-866b-4836-be2a-cb6647aea6d4",
                                                "sense_id": "0185cc38-4243-3e0d-a579-a6b3d8c8e26b",
                                                "text": "a hermit’s abstraction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "The act of focusing on one characteristic of an object rather than the object as a whole group of characteristics; the act of separating said qualities from the object or ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8079b8a5-7ab9-4882-a72d-861a4d9bfbf3",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Holonym: induction"
                                            },
                                            {
                                                "example_id": "33b4366e-8957-449a-b178-e9e86efdf50d",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Abstraction is no positive act: it is simply the negative of attention."
                                            },
                                            {
                                                "example_id": "529a8ddd-6e32-4fc5-b341-a0c9ef5c79f5",
                                                "sense_id": "76557d44-2a70-3da0-bcb4-92326852dc37",
                                                "text": "Abstraction is necessary for the classification of things into genera and species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa63acc0-d9c5-314c-8d81-2da00fffb6d2",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "Any characteristic of an individual object when that characteristic has been separated from the object and is contemplated alone as a quality having independent existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d7aeb69-b385-35e1-a714-60fdcad50076",
                                        "entry_id": "facccbea-c918-3ad4-872c-a80b6ed7e59f",
                                        "glosses": [
                                            "A member of an idealized subgroup when contemplated according to the abstracted quality which defines the subgroup."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
