                        "entry_id": "7d849a40-298f-3393-8c20-a3916c8c6f09",
                        "glosses": [
                            "Staatsbürgerin von Rumänien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9714d99e-67b1-4601-a952-b408abf1087b",
                                "sense_id": "51b4b94d-6183-307c-9a65-eb4cbdb91856",
                                "text": "Er hat eine Rumänin geheiratet und lebt jetzt in Bukarest."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08b3229a-1334-3a5e-831e-ab017164d1b7",
                        "entry_id": "7d849a40-298f-3393-8c20-a3916c8c6f09",
                        "glosses": [
