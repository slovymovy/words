                        "glosses": [
                            "Donner un statut emblématique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f27fd0-3057-48ee-9d1c-4b5c0b7098c3",
                                "sense_id": "30ec3357-5d30-3a12-8055-fa65736ac0ab",
                                "text": "Il serait plaisant d'emblématiser par ces triangles obsédants cette époque entre terre et Ciel."
                            },
                            {
                                "example_id": "5851aeef-a5d9-4cf6-9e38-a48daf636726",
                                "sense_id": "30ec3357-5d30-3a12-8055-fa65736ac0ab",
                                "text": "Pour emblématiser ce genre d'effets, pourquoi avoir choisi précisément l'acrostiche?"
                            }
                        ]
