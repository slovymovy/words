                "senses": [
                    {
                        "sense_id": "81707ce9-8861-3e4e-819e-3410efbc29a9",
                        "entry_id": "41865ca3-0c33-3787-9398-94ebc5f80516",
                        "glosses": [
                            "gemaakt om te experimenteren, met betrekking tot een proefneming"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb756dfb-8489-380d-add4-11041c7ae57a",
                        "entry_id": "41865ca3-0c33-3787-9398-94ebc5f80516",
                        "glosses": [
                            "vernieuwend zonder dat nog duidelijk is of het ook een verbetering is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b5d3c97-6bae-44b4-a145-4d13cda3ba6b",
                                "sense_id": "fb756dfb-8489-380d-add4-11041c7ae57a",
                                "text": "Ik kon mij voorstellen dat haar poëzie compromisloos experimenteel zou zijn, en van een aantrekkelijke eenzelvige gekte, die in feite een getormenteerde en door geen criticus begrepen verschijningsvorm was van passie die woedde als een uitslaande brand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e245196-72a4-496c-ab29-f4fc8877e39f",
                        "source_entry_id": "41865ca3-0c33-3787-9398-94ebc5f80516",
                        "source_sense_id": "81707ce9-8861-3e4e-819e-3410efbc29a9",
                        "target_lang_word": "experimentell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experimentell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                        "entry_id": "74e63f65-5a83-32ca-b2cf-8103e37c762f",
                                        "glosses": [
                                            "auf (wissenschaftlichen) Versuchen basierend; mithilfe von (wissenschaftlichen) Versuchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd8b3b1-f74d-4d41-ba52-739d553dc99a",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Auch die experimentelle Wirtschaftsforschung rüttelt an den Grundfesten der wirtschaftswissenschaftlichen Modelle, und die Neuroökonomen wollen den Menschen ebenfalls abbilden, wie er wirklich ist - nicht, wie er den Annahmen gemäß sein müsste.“"
                                            },
                                            {
                                                "example_id": "a041ad7c-7140-44c9-a7ef-dd73f68c4d61",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Apex ist ein experimentelles Teleskop, das bereits erste wissenschaftliche Erkenntnisse liefert - etwa über ein neues Molekül im All.“"
                                            },
                                            {
                                                "example_id": "5ba4026d-df35-42f9-bed6-98d2bbc922ee",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Die junge Mexikanerin forscht zurzeit in Wien, einem der weltweit führenden Zentren der experimentellen Quantenphysik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                        "entry_id": "74e63f65-5a83-32ca-b2cf-8103e37c762f",
                                        "glosses": [
                                            "durch besondere neuartige Merkmale geprägt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9185f871-4662-42cc-b8c9-f164289340cb",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Der Professor für experimentelle Musik, Theologe und Autor starb am Sonntag im Alter von 88 Jahren.“"
                                            },
                                            {
                                                "example_id": "011f5c2e-3f42-42cc-9b2e-f11b613ba082",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Die experimentelle Popgruppe Pram erschafft Soundtracks zu B-Movies, die es nicht gibt – in einer ebenso beklemmenden wie fidelen Melange aus Jazz, Post-Punk und Krautrock.“"
                                            },
                                            {
                                                "example_id": "f88ac132-f442-47b9-8772-76cac92de58f",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Die aktuell erfolgreichste österreichische Band Bilderbuch, die mit ihrem künstlerischen Universalansatz und experimentellem Indie-Pop seit Jahren die deutschsprachige Musikwelt aufmischt, wählte diese besondere Gitarre nicht nur als Cover ihrer Single ‚Dates‘, sondern machte sie auch zum Sinnbild ihres musikalischen Universums.“"
                                            },
                                            {
                                                "example_id": "3d2362c5-980b-4e23-979f-fac5aa6dff32",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Danach haben auch die arabischen Schriftsteller experimentellere und radikalere Wege genommen, auf denen ihnen Machfus nicht mehr zu folgen bereit war.“"
                                            },
                                            {
                                                "example_id": "78e18839-d303-45a3-bb78-ed1c3be24be7",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Alain Resnais war der intellektuellste und experimentellste unter den großen französischen Regisseuren im Umfeld der ‚Nouvelle Vague‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a04b682b-cfe5-4788-aea5-01bcd94846d5",
                        "source_entry_id": "41865ca3-0c33-3787-9398-94ebc5f80516",
                        "source_sense_id": "81707ce9-8861-3e4e-819e-3410efbc29a9",
