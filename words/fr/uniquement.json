    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c4713a49-16f7-391d-ab86-f6ba980680ce",
                    "sense_definition": "D'une manière exclusive ; rien que, seulement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée est ouvert <w>uniquement</w> les fins de semaine durant la saison hivernale."
                        },
                        {
                            "text": "Il se nourrit presque <w>uniquement</w> de légumes biologiques et de fruits frais."
                        }
                    ],
                    "common_phrases": [
                        "presque uniquement",
                        "valable uniquement"
                    ]
                },
                {
                    "sense_id": "5ec846bf-2790-3112-a184-0440922a4e46",
                    "sense_definition": "D'une manière singulière et sans égale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "singularite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bâtisse ancienne se distingue <w>uniquement</w> par son architecture novatrice."
                        },
                        {
                            "text": "Le peintre utilisait les couleurs d'une façon <w>uniquement</w> personnelle et expressive."
                        }
                    ],
                    "synonyms": [
