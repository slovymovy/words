        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "72cd9090-e46d-3297-911e-c2e74c230719",
                "word": "Portrait",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "16a85b51-ffd7-3583-82e3-4b8bc1211e1c",
                        "entry_id": "72cd9090-e46d-3297-911e-c2e74c230719",
                        "glosses": [
                            "eine Darstellung einer Person, meist in Form eines Gemäldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf93042-eb18-4d49-be7d-65e6c454531c",
                                "sense_id": "16a85b51-ffd7-3583-82e3-4b8bc1211e1c",
                                "text": "„Der Künstler fühlte sich verpflichtet, Csomas Bildnis für die Nachwelt festzuhalten, zumal kein einziges Portrait von ihm existierte.“"
                            },
                            {
                                "example_id": "084d938e-52a3-4c55-945a-44ddcf796f5c",
                                "sense_id": "16a85b51-ffd7-3583-82e3-4b8bc1211e1c",
                                "text": "„Auch ein witzig gemaltes Portrait kann man sich vorstellen, ganz abgesehen davon, dass es ja als dessen Sonderfall die Karikatur gibt.“"
                            },
                            {
                                "example_id": "d05e67fe-2f6d-4e2c-a5e8-c938f0d67fab",
                                "sense_id": "16a85b51-ffd7-3583-82e3-4b8bc1211e1c",
                                "text": "„Natürlich kannte er das elegante Portrait des mit einundfünfzig Jahren jugendlich wirkenden russischen Generalstabsarztes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "300ed83b-f1b4-33df-b650-6c0ea39c508e",
                        "entry_id": "72cd9090-e46d-3297-911e-c2e74c230719",
                        "glosses": [
                            "eine schriftliche Beschreibung einer Person beziehungsweise eines Gegenstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7219ae8-cdd3-4606-9aab-aa2e7f4a82bc",
                                "sense_id": "300ed83b-f1b4-33df-b650-6c0ea39c508e",
                                "text": "„Ein filmisches Portrait der Modeschöpferin Coco Chanel war der Auslöser.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
