                        "entry_id": "7cead144-ac26-3dd1-ae7d-9ddae34a738d",
                        "glosses": [
                            "Odeur caractéristique, plutôt désagréable, d'un lieu resté longtemps fermé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fd97f52-e96a-40bb-a6e1-6afd8fbd3526",
                                "sense_id": "ff6e3457-f784-33ca-8f5c-3bb41fd9b40f",
                                "text": "La porte en verre dépoli grinça sur ses gonds, une bouffée d’air vicié, de poussière, de renfermé, d’huile, de soude caustique, de cirage, de lessive les assaillit dès le premier pas."
                            }
                        ]
