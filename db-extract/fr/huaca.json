                "senses": [
                    {
                        "sense_id": "f2797b82-299b-3650-bdd9-23f9f5542af2",
                        "entry_id": "59ac5c5f-e171-3024-a677-76275939b294",
                        "glosses": [
                            "Lieu de culte autre que celui d'Inti, le soleil, chez les Incas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adfa0d70-7695-4901-a04e-4038a643c732",
                                "sense_id": "f2797b82-299b-3650-bdd9-23f9f5542af2",
                                "text": "Les huacas pouvaient être des objets sacrés, des rochers d'une forme particulière, une source, et jusqu'à une haute montagne."
                            },
                            {
                                "example_id": "9a97ee1a-6b36-42e3-ba45-ea1fcd4cc99d",
                                "sense_id": "f2797b82-299b-3650-bdd9-23f9f5542af2",
                                "text": "Au même moment, au sommet de la Huaca, avaient lieu de nombreux sacrifices humains (une cinquantaine d'hommes tués à coups de masse et démembrés)."
                            }
                        ]
                    },
                    {
                        "sense_id": "5efeee3b-5141-32cf-8913-464ce3eada5c",
                        "entry_id": "59ac5c5f-e171-3024-a677-76275939b294",
                        "glosses": [
                            "Objet votif des civilisations précolombiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7aa8d4-4cc6-4b21-8c23-653f0a8b46e5",
                                "sense_id": "5efeee3b-5141-32cf-8913-464ce3eada5c",
                                "text": "Écoute, Carlos, j’ai un acheteur pour des petits huacas en or."
                            }
                        ]
                    }
                ],
