                "senses": [
                    {
                        "sense_id": "9843e50c-31c8-334e-8926-25780308001d",
                        "entry_id": "6a0acdb9-7c29-3245-b3e9-49501769e67b",
                        "glosses": [
                            "Of or pertaining to Cairo, the capital of Egypt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f2afee32-2f15-494b-987f-2560918a3d14",
                                "sense_id": "9843e50c-31c8-334e-8926-25780308001d",
                                "text": "The shop, in typical Cairene fashion, was small."
                            }
                        ]
                    }
                ],
                "translations": [
