                "senses": [
                    {
                        "sense_id": "061f5397-2923-3f9e-a719-53a47b86fd2f",
                        "entry_id": "41c76f40-6235-37aa-8f94-7e756c94b8a5",
                        "glosses": [
                            "związany z rabinem, dotyczący rabina lub rabinatu"
                        ],
                        "tags": [],
