                "senses": [
                    {
                        "sense_id": "3fe678c8-887b-31c6-aa77-14503fdcb82d",
                        "entry_id": "ad1000bb-7118-3238-90ab-9579f5684ed4",
                        "glosses": [
                            "Kind, das in einem Kinderheim lebt oder aufgewachsen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073243cd-8c7c-40f3-b7cf-390a434ed8ef",
                                "sense_id": "3fe678c8-887b-31c6-aa77-14503fdcb82d",
                                "text": "Müller wuchs im Nachkriegsdeutschland als Heimkind auf und hat bis heute darunter zu leiden."
                            },
                            {
                                "example_id": "15350f7f-e4d0-4133-ae65-83237aea4aa7",
                                "sense_id": "3fe678c8-887b-31c6-aa77-14503fdcb82d",
                                "text": "„Es muß festgehalten werden, daß es den Heimkindern vor allem an zwei wichtigen Entwicklungsfaktoren mangelt: an hinreichender affektiver, emotioneller Zuwendung und an notwendigen Anregungen aus der sozialen Umwelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
