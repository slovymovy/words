                        "cross_references": [
                            {
                                "target_word": "splijtbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "59f25663-9d2f-3326-90cf-814aa99609c6",
                                        "entry_id": "4064da1a-61c5-31a8-bb0e-2d1ffa1c86f8",
                                        "glosses": [
                                            "van een gesteente dat dit in twee of meer stukken gespleten kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fe8876f-831f-4abd-acde-4eeb58b588f0",
                                                "sense_id": "59f25663-9d2f-3326-90cf-814aa99609c6",
                                                "text": "Volgens de Van Dale is schalie \"fijnkorrelig, ingeklonken en verhard sediment dat in regelmatige lagen (evenwijdig aan het afzettingsvlak) splijtbaar is\". Omdat schalie hard is, zijn er speciale technieken nodig om het gas uit de grond te halen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a5d8a7-84fa-3cf8-ad5c-df5d569ab106",
                                        "entry_id": "4064da1a-61c5-31a8-bb0e-2d1ffa1c86f8",
                                        "glosses": [
                                            "van een atoomkern dat deze in twee of meer stukken uiteen kan vallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d518cb04-ea39-4594-9aea-999f507c0cdb",
                                                "sense_id": "b6a5d8a7-84fa-3cf8-ad5c-df5d569ab106",
                                                "text": "Radioactief materiaal waarvan de celkern splijtbaar is. Splijtstoffen zijn onder meer: uranium u-235, plutonium, cesium-137. Dit materiaal is over het algemeen hoogradioactief en dus gevaarlijker. Sommige nucleaire materialen vervallen zo langzaam dat ze vele tienduizenden jaren gevaarlijk blijven."
                                            },
                                            {
                                                "example_id": "6fff80cf-bb53-4f9e-a5d2-12cec2c67ca4",
                                                "sense_id": "b6a5d8a7-84fa-3cf8-ad5c-df5d569ab106",
                                                "text": "In februari begon Iran daarop met het verrijken van uranium tot een splijtbaar gehalte van 20 procent. Daarmee kunnen atoombommen gemaakt worden. Iran zei het te gebruiken voor energiewinning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
