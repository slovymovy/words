                "senses": [
                    {
                        "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                        "entry_id": "6d6e3b8e-1def-352e-9815-8620c7e61fc2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3efcba3-426c-4235-a96d-1536c4bffd0d",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Frau Damköhler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "df012f07-954b-41eb-ac5b-0d382954d4aa",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Herr Damköhler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "14dd36db-eb50-485a-919c-e733ceb13b19",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Die Damköhlers kommen heute von der Insel Usedom."
                            },
                            {
                                "example_id": "b0f01071-187b-4437-844a-da47461f1bab",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Der Damköhler trägt nie die Schals, die die Damköhler ihm strickt."
                            },
                            {
                                "example_id": "fbe05d75-46d1-4173-876c-fffab80b6f22",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Damköhler kommt, geht der Herr Damköhler.“"
                            },
                            {
                                "example_id": "ae5db5c1-2e36-40a0-9ddc-ab4e13988726",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Damköhler kommt und geht."
                            },
                            {
                                "example_id": "9ee32154-7e8c-43a5-9eae-9a82eaf3524a",
                                "sense_id": "8995c3a3-b8e1-3d2f-a2ff-dd586b4608db",
                                "text": "Damköhlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
