                ],
                "senses": [
                    {
                        "sense_id": "dbff38b2-bcec-38f2-b7f1-49298d8572b2",
                        "entry_id": "04ba86a4-2f57-37c1-be5e-25470addd8a8",
                        "glosses": [
                            "Beherrschung relativ vieler Sprachen durch einzelne Personen oder Personengruppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0cefba4-3eb0-4bc8-8743-6ce38a8219ea",
                                "sense_id": "dbff38b2-bcec-38f2-b7f1-49298d8572b2",
                                "text": "„Mehrere Beiträge befassen sich ausführlich mit Themen der Mehr- und Vielsprachigkeit von Personen, der Sprachenvielfalt im vereinten Europa und der Sprachenfrage im Kontext der EU“."
                            },
                            {
                                "example_id": "fdbef504-91a4-4c16-95ef-01a83336f148",
                                "sense_id": "dbff38b2-bcec-38f2-b7f1-49298d8572b2",
                                "text": "„Diese Tatsache soll nichts relativieren, sondern nur darauf verweisen, dass Vielsprachigkeit bereits als solche sprachverändernd wirkt, ganz unabhängig davon, welche Sprachen und Sprachtypen gesprochen werden.“"
                            },
                            {
                                "example_id": "6bdc7fa9-60e8-4bad-8de0-e73fb1e77336",
                                "sense_id": "dbff38b2-bcec-38f2-b7f1-49298d8572b2",
                                "text": "„Nur auf diese Weise werden wir die Vielsprachigkeit in einer immer einheitlicher werdenden Welt erhalten können.“"
                            },
                            {
                                "example_id": "204de8c5-142e-45ca-832f-0f95292053a7",
                                "sense_id": "dbff38b2-bcec-38f2-b7f1-49298d8572b2",
                                "text": "„Die Vielsprachigkeit war in die Welt gekommen, als der Turm zu Babel gebaut wurde und Gott die Menschen dafür bestrafte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
