                "translations": [
                    {
                        "translation_id": "4e939962-51b4-4a51-bd19-a7d78aebed58",
                        "source_entry_id": "413f5e3f-a523-3189-a186-72deba0d8962",
                        "source_sense_id": "a5f90260-a963-32c5-ad3d-497e936b4fb3",
                        "target_lang_word": "sell off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sell off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c18343c-ecc0-32eb-b861-5923d26b67cf",
                                        "entry_id": "f59a8842-2836-3b60-8102-941171842842",
                                        "glosses": [
                                            "To sell assets for the purpose of disposing of them quickly rather than for maximizing profit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68b342a4-4526-4087-a7bf-13c873a78d60",
                                                "sense_id": "0c18343c-ecc0-32eb-b861-5923d26b67cf",
                                                "text": "When Cyril goes searching for his deadbeat father, he’s also looking for his bike, and he’s devastated to discover his dad sold it off to make ends meet."
                                            },
                                            {
                                                "example_id": "fe55ddc4-c3c6-4da1-bc5f-9387215af2f9",
                                                "sense_id": "0c18343c-ecc0-32eb-b861-5923d26b67cf",
                                                "text": "I have always argued that despite my opposition to rail privatisation, I should be grateful that John Major won the 1992 election on a platform to sell off the railways, as otherwise my column would have disappeared given the paucity of things to write about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72bade86-a4ef-4f39-9b9e-98482263960f",
                        "source_entry_id": "413f5e3f-a523-3189-a186-72deba0d8962",
                        "source_sense_id": "a5f90260-a963-32c5-ad3d-497e936b4fb3",
                        "target_lang_word": "sell out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sell out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91c808bc-5bb6-30fb-89c1-3f3dc83c2cc3",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To sell all of a product that is in stock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee81cfb-d147-426b-91da-fd4bfac061d6",
                                                "sense_id": "91c808bc-5bb6-30fb-89c1-3f3dc83c2cc3",
                                                "text": "They sold out of concert posters yesterday and won't get another shipment until next week."
                                            },
                                            {
                                                "example_id": "30c123f3-8e27-418c-ba02-fce83edcac91",
                                                "sense_id": "91c808bc-5bb6-30fb-89c1-3f3dc83c2cc3",
                                                "text": "Like when Rosario and I have a really on day, I mean, we could sell this place out of beer, you know."
                                            },
                                            {
                                                "example_id": "34c3c710-dc3d-415b-abe0-36b18a1dc352",
                                                "sense_id": "91c808bc-5bb6-30fb-89c1-3f3dc83c2cc3",
                                                "text": "By the end of July [2020], Brompton Road station was available as a virtual tour and tickets were selling out fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To abandon or betray one's principles to seek profit or other personal advantage; to abandon or betray one's supporters through this change."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981405eb-d048-4266-8c18-a13df50f2222",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "It's like tellin' Gwen Stefani she sold out / ‘Cause I was tryna leave no doubt"
                                            },
                                            {
                                                "example_id": "4f1790b3-f21f-4761-a9ab-a841ec48b57b",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "It used to be a pleasant little community, until the leaders sold out to the developers."
                                            },
                                            {
                                                "example_id": "1e461453-7944-4453-87d8-d913f3310fd1",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "He used to be a voice for the underdog until he sold out."
                                            },
                                            {
                                                "example_id": "93445030-553d-42b9-aaf0-0ffe3dd7a481",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "[…] Lelaina is also attempting to choose between two men who represent her divergent prospects: to sell out or not to sell out. That particular quandary was styled as a hallmark of Generation X, and Reality Bites was perhaps the most polished of a bunch of mainstream attempts to portray the ambivalent cohort."
                                            },
                                            {
                                                "example_id": "ba4a0a5e-d329-4830-9dca-1a37a047e2a8",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "The nineties were not an age for the aspirant. The worst thing you could be was a sellout, and not because selling out involved money. Selling out meant you needed to be popular, and any explicit desire for approval was enough to prove you were terrible."
                                            },
                                            {
                                                "example_id": "bd8b1b07-2df3-428d-a928-5d8c99461307",
                                                "sense_id": "146c2ca7-73c6-311b-ad7b-e390717a9ede",
                                                "text": "But the recent writer and actor strikes in the US show that selling out is not just a question of personal ethics, but an industry-wide concern. A director’s decision to align themselves with these Goliaths of entertainment has consequences; makes money for the big guy, in opposition to fostering an industry where smaller films and creators have more opportunities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80bc6092-0bc8-35a0-823e-cd32924225de",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To betray (a person), usually a close friend or family member, for personal gain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08cb16b1-4295-4f64-85ee-5b566aa6c498",
                                                "sense_id": "80bc6092-0bc8-35a0-823e-cd32924225de",
                                                "text": "I'll kill him if I see him again; he sold me out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "957b8561-2eb4-3087-aa8c-df97e7deba22",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To sell one's business (with a connotative emphasis on entirety and finality)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a216a95a-bc8f-4ec0-b5ab-01997ea8bfb6",
                                                "sense_id": "957b8561-2eb4-3087-aa8c-df97e7deba22",
                                                "text": "The owners long resisted buyout offers, but when they were ready to retire, they finally sold out to a competitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75ed871f-803f-394a-bad2-168eb2abcb62",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To sell one's business (with a connotative emphasis on entirety and finality).",
                                            "To commit or abandon oneself entirely (to a cause, a team, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "720ed2be-41cc-3f64-8afa-ade2b5ac348f",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To sell one's commission."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962e1e86-b8d6-45af-b04e-d07002e0d522",
                                                "sense_id": "720ed2be-41cc-3f64-8afa-ade2b5ac348f",
                                                "text": "After the peace of Versailles he resided in England; but, about three years before the breaking out of the Revolution, he sold out his commission in the army and emigrated to New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ded0ac0-059b-36dd-8dcf-a64cd007f37d",
                                        "entry_id": "609247c6-c489-37fa-93e3-4d92d92ace81",
                                        "glosses": [
                                            "To hurry out."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
