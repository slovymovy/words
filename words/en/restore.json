{
    "word_family": [
        "restoration",
        "restorative",
        "restorer",
        "restorable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9445434-f5b2-377c-a7e3-9fc913a365db",
                    "sense_definition": "To bring something back to a good condition after it has been damaged, neglected, or decayed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "repair_renovate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council decided to <w>restore</w> the old town hall to its former glory.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил <w>отреставрировать</w> старую ратушу, вернув ей былое великолепие.",
                                "zh": "市议会决定<w>修复</w>旧市政厅，使其重现往日的辉煌。"
                            }
                        },
                        {
                            "text": "After a long vacation, she felt completely <w>restored</w> and ready to work.",
                            "target_lang_translations": {
                                "ru": "После долгого отпуска она чувствовала себя полностью <w>восстановившейся</w> и готовой к работе.",
                                "zh": "长假过后，她感到精力完全<w>恢复</w>了，准备好投入工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "renovate",
                        "repair",
                        "refurbish",
                        "fix"
                    ],
                    "antonyms": [
                        "damage",
                        "ruin"
                    ],
                    "common_phrases": [
                        "restore a building",
                        "restore to health",
                        "fully restored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести что-либо в хорошее состояние после повреждения, запустения или разрушения.",
                        "zh": "指将受损、荒废或破旧的事物恢复到良好的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "приводить в прежнее состояние"
                            },
                            {
                                "target_lang_word": "реставрировать",
                                "target_lang_sense_clarification": "о зданиях или произведениях искусства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修复",
                                "target_lang_sense_clarification": "指修补破损的物体或建筑"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指使身体或精神状态回到良好水平"
                            },
                            {
                                "target_lang_word": "修缮",
                                "target_lang_sense_clarification": "特指对建筑物的修补和翻新"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b33f365e-3d17-3f7b-8bb1-ccc90627d4fc",
                    "sense_definition": "To cause a situation, rule, custom, or feeling to exist again.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reestablish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were called in to <w>restore</w> order after the protest turned violent.",
                            "target_lang_translations": {
                                "ru": "Полицию вызвали, чтобы <w>восстановить</w> порядок после того, как протест перерос в насилие.",
                                "zh": "抗议活动演变成暴力冲突后，警方被召集来<w>恢复</w>秩序。"
                            }
                        },
                        {
                            "text": "The government promised to <w>restore</w> confidence in the banking system.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало <w>восстановить</w> доверие к банковской системе.",
                                "zh": "政府承诺将<w>恢复</w>人们对银行系统的信心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reestablish",
                        "reinstate",
                        "bring back"
                    ],
                    "antonyms": [
                        "abolish",
                        "destroy"
                    ],
                    "common_phrases": [
                        "restore order",
                        "restore peace",
                        "restore confidence",
                        "restore faith"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возобновить существование ситуации, правила, обычая или чувства.",
                        "zh": "指使某种局势、规则、习俗或情感重新存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "порядок, доверие, отношения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指秩序、信心或关系的重建"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e29e1ba9-6dae-31a7-9c15-d2cfbea7709a",
                    "sense_definition": "To bring back computer data, files, or settings from a backup.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "data_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally deleted the file, but I was able to <w>restore</w> it from the cloud.",
                            "target_lang_translations": {
                                "ru": "Я случайно удалил файл, но смог <w>восстановить</w> его из облака.",
                                "zh": "我不小心删除了那个文件，但成功地从云端将其<w>还原</w>了。"
                            }
                        },
                        {
                            "text": "You should back up your phone before you try to <w>restore</w> the factory settings.",
                            "target_lang_translations": {
                                "ru": "Тебе следует сделать резервную копию данных телефона, прежде чем пытаться <w>восстановить</w> заводские настройки.",
                                "zh": "在尝试<w>还原</w>出厂设置之前，你应该先备份手机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recover"
                    ],
                    "antonyms": [
                        "delete"
                    ],
                    "common_phrases": [
                        "restore files",
                        "restore data",
                        "restore from backup"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть компьютерные данные, файлы или настройки из резервной копии.",
                        "zh": "指从备份中找回计算机数据、文件或设置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "данные или настройки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还原",
                                "target_lang_sense_clarification": "指将系统或数据恢复到之前的状态"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指找回丢失的文件或数据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                    "sense_definition": "To give something back to its former owner or to return it to its original place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "return_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stolen painting was finally <w>restored</w> to the museum after twenty years.",
                            "target_lang_translations": {
                                "ru": "Украденная картина была наконец <w>возвращена</w> в музей спустя двадцать лет.",
                                "zh": "那幅被盗的画作在二十年后终于被<w>归还</w>给了博物馆。"
                            }
                        },
                        {
                            "text": "Please <w>restore</w> the books to the shelf when you are finished reading them.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>верните</w> книги на полку, когда закончите их читать.",
                                "zh": "书读完后，请把它们<w>放回</w>书架上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "return",
                        "give back"
                    ],
                    "antonyms": [
                        "keep",
                        "take"
                    ],
                    "common_phrases": [
                        "restore to owner"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть вещь прежнему владельцу или на прежнее место.",
                        "zh": "指将某物归还给原主或放回原处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "отдать обратно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归还",
                                "target_lang_sense_clarification": "指把东西还给主人"
                            },
                            {
                                "target_lang_word": "放回",
                                "target_lang_sense_clarification": "指将物品归位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06dd6fb0-c170-3655-9f88-a6c09c5fcb7e",
                    "sense_definition": "The process of bringing back computer data or a system to a previous state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "data_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system <w>restore</w> failed because the backup file was corrupted.",
                            "target_lang_translations": {
                                "ru": "<w>Восстановление</w> системы не удалось, так как файл резервной копии был поврежден.",
                                "zh": "由于备份文件损坏，系统<w>还原</w>失败了。"
                            }
                        },
                        {
                            "text": "We performed a full <w>restore</w> of the database over the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы выполнили полное <w>восстановление</w> базы данных на выходных.",
                                "zh": "我们在周末对数据库进行了全面<w>还原</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery"
                    ],
                    "common_phrases": [
                        "system restore",
                        "data restore"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс возврата компьютерных данных или системы к предыдущему состоянию.",
                        "zh": "指将计算机数据或系统恢复到先前状态的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "данных или системы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还原",
                                "target_lang_sense_clarification": "指系统或数据的恢复操作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}