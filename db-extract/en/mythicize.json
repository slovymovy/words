                                "target_senses": [
                                    {
                                        "sense_id": "a0bc0dba-a9a5-31f7-a3e9-bceee86643ae",
                                        "entry_id": "defdcb3e-0e66-3853-b60e-06144d6b1781",
                                        "glosses": [
                                            "Donner un caractère de mythe à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0465505a-5fc5-43ca-860d-35b59bfb0f93",
                                                "sense_id": "a0bc0dba-a9a5-31f7-a3e9-bceee86643ae",
                                                "text": "Une légende, contrairement au mythe pur qui est a-temporel, peut être un mythe temporel ou historique ; elle est une histoire qui a été mythicisée, c'est-à-dire rendue typique, exemplaire, signifiante."
                                            },
                                            {
                                                "example_id": "43803723-4ba6-41fd-9069-44e34246c904",
                                                "sense_id": "a0bc0dba-a9a5-31f7-a3e9-bceee86643ae",
                                                "text": "Un groupe dirigeant utilise un système de classification (historicisé, mythicisé, sacralisé, naturalisé ou rationalisé) afin de légitimer et de maintenir sa domination."
                                            }
                                        ]
                                    }
                                ]
                            }
