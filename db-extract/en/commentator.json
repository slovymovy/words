                                            {
                                                "example_id": "ec20dbd7-404c-4d59-ac04-79b3ecde54f9",
                                                "sense_id": "b1afb751-bf29-30a4-a208-54a59308daa9",
                                                "text": "Część komentatorów zwraca uwagę, że poczucie moralności w Chile podlega głębokim zmianom."
                                            },
                                            {
                                                "example_id": "37060c7d-9b3b-461f-8753-a31b425b3063",
                                                "sense_id": "b1afb751-bf29-30a4-a208-54a59308daa9",
                                                "text": "Komentatorzy są zgodni, że większość decyzji tego rządu była błędna."
                                            }
