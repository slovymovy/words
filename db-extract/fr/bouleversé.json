                                "target_senses": [
                                    {
                                        "sense_id": "56715ebb-6219-3846-ad41-da291cc39bf0",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "Disturbance or disruption."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f654cddf-975d-4b22-8ad9-e1b8db7606e4",
                                                "sense_id": "56715ebb-6219-3846-ad41-da291cc39bf0",
                                                "text": "My late arrival caused the professor considerable upset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An unexpected victory of a competitor or candidate that was not favored to win."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11a1dad-3725-4935-90ea-48475695ae46",
                                                "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                                "text": "But it is probably the biggest upset for the away side since Ronnie Radford smashed a famous goal as Hereford defeated Newcastle 2-1 in 1972."
                                            },
                                            {
                                                "example_id": "b3abf7fe-cf52-43c3-80c2-288744d4b43c",
                                                "sense_id": "019a6333-8682-33bd-856b-7f1fad434f63",
                                                "text": "Sanders’s win in Michigan was one of the greatest upsets in modern political history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f224d80-f02b-39a3-bc36-352db0be312f",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An overturn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13deeb85-7ca3-4015-95c8-7218ce890c80",
                                                "sense_id": "6f224d80-f02b-39a3-bc36-352db0be312f",
                                                "text": "\"collision and upset\": impact with another object or an overturn for whatever reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0397b1-328a-3832-9a64-e7e4ecfd6ea6",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An upset stomach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d1555b-0d87-4427-9d10-4f4e1b52d12c",
                                                "sense_id": "5e0397b1-328a-3832-9a64-e7e4ecfd6ea6",
                                                "text": "“Bob, let's cancel the baby sitter. With this upset stomach, I can't go out tonight.”\n“Sure you can, Liz! Try Pepto-Bismol. Hospital tests prove it relieves upsets. And it's great for indigestion or nausea, too!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa3fe95-c02f-36f9-ab93-3fc43fd56d1c",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "An upper set; a subset (X,≤) of a partially ordered set with the property that, if x is in U and x≤y, then y is in U."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8d21665-3dfa-3ed0-b5b6-3ea9f5aef4cf",
                                        "entry_id": "f44debf6-9cd9-386c-92fb-861ed156ad6b",
                                        "glosses": [
                                            "The dangerous situation where the flight attitude or airspeed of an aircraft is outside the designed bounds of operation, possibly resulting in loss of control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
