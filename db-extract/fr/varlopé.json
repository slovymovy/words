                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb161dcf-2919-4983-b232-a2b1736cbd0f",
                                "sense_id": "f7340551-5c7f-36cf-b053-7be63ef2f9bd",
                                "text": "Des tas de planches dressées contre les murs et des empilements de copeaux balayés dans les coins répandaient un parfum de bois varlopé, une odeur de menuiserie, ce souffle résineux qui pénètre au fond des poumons."
                            },
                            {
                                "example_id": "7840be87-ec50-457f-89f3-9e71b7d5838e",
                                "sense_id": "f7340551-5c7f-36cf-b053-7be63ef2f9bd",
                                "text": "[…] il a vu comme des nids de serpents d'écorce se tordre sur le chemin, au gré du vent, avec une odeur, a-t-il dit, de copeaux varlopés […]"
                            }
                        ]
                    }
