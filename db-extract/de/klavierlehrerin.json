                ],
                "senses": [
                    {
                        "sense_id": "b74de532-959b-3808-9265-61ed955c3c12",
                        "entry_id": "fa05fc26-8076-31ec-8ac8-faa1417bb5ba",
                        "glosses": [
                            "Lehrerin, die Unterricht im Klavierspiel erteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b91f199-e9e8-428f-8b5e-f03f0d2b32f0",
                                "sense_id": "b74de532-959b-3808-9265-61ed955c3c12",
                                "text": "„Die Klavierlehrerin Erika Kohut stürzt wie ein Wirbelsturm in die Wohnung, die sie mit ihrer Mutter teilt.“"
                            },
                            {
                                "example_id": "83bd6b7e-f741-441d-a371-3e04b991dc4c",
                                "sense_id": "b74de532-959b-3808-9265-61ed955c3c12",
                                "text": "„Als er Hanna aus den Augen verloren hatte, war sie unverheiratet gewesen, und später einmal hatte ihm jemand erzählt, sie sei jetzt Klavierlehrerin in Hamburg.“"
                            },
                            {
                                "example_id": "a3c48dfa-3a0b-419e-b1b6-897f2111fcc9",
                                "sense_id": "b74de532-959b-3808-9265-61ed955c3c12",
                                "text": "„Seine frühere Klavierlehrerin Paola besaß dort eine Villa, die teilweise von ihrer Nichte bewohnt war.“"
                            },
                            {
                                "example_id": "66569fa4-b45f-4011-83df-88f2c8a51133",
                                "sense_id": "b74de532-959b-3808-9265-61ed955c3c12",
                                "text": "„Sie war seine erste Klavierlehrerin, und das Klavier war das erste Instrument, mit dessen Hilfe es dem Kind gelang, seine Gefühle auszudrücken und anderen zu vermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
