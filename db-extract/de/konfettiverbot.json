                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4b73c6-888e-4c9d-8fd2-11a6a45afbe1",
                                "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                                "text": "„Der Narrenfahrplan 2025 wird trotz Konfettiverbot und der Baustellen bunt und närrisch in Bad Säckingen.“"
                            },
                            {
                                "example_id": "3b72f848-b3a2-4d63-a24e-657ea90352ae",
                                "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                                "text": "„Das Konfettiverbot ist also vor allem eines: absolut vernünftig.“"
                            },
                            {
                                "example_id": "93d1eb50-1813-44b8-9aaf-f8c862035a64",
                                "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                                "text": "„Müll sei im Stadtbach entsorgt worden, wie es mit einem Konfettiverbot in Tettnang aussehe, wisse sie nicht.“"
                            },
                            {
                                "example_id": "08735d87-1416-42b3-b7c1-d7bfa0ae2ba7",
                                "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                                "text": "„Alkoholverbot, Konfettiverbot - kann es noch langweiliger kommen?“"
                            },
                            {
                                "example_id": "b5863286-beb6-43d2-8f3f-fbdb89e82582",
                                "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                                "text": "„Bei uns in der Narrenzunft herrscht Konfettiverbot\", sagt der Ulmer Zunftmeister Gerhard Wies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
