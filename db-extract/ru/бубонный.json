                "senses": [
                    {
                        "sense_id": "09ede8aa-6411-30aa-8c20-71de0d2c2d09",
                        "entry_id": "68c3fac3-8d1a-33f1-b184-6d042237ba63",
                        "glosses": [
                            "мед. связанный, соотносящийся по значению с существительным бубон; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf7c068-48bb-463a-8da0-bb87f3721b0d",
                                "sense_id": "09ede8aa-6411-30aa-8c20-71de0d2c2d09",
                                "text": "К карбункулам и бубонам прикладывали припарки, пластыри, делали надрезы. Шафонский старался вызвать на начальной стадии болезни испарину, благодаря чему иногда выздоравливали даже поражённые бубонной формой."
                            }
                        ]
                    }
                ],
