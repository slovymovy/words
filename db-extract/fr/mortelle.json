                "senses": [
                    {
                        "sense_id": "8d0076af-b048-3029-9707-942f82338686",
                        "entry_id": "f31df2ea-250c-3311-9ebf-d2ed8e897c2e",
                        "glosses": [
                            "Femme destinée à mourir un jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c367a4-db21-4e5c-b62b-55fa3ee8fa35",
                                "sense_id": "8d0076af-b048-3029-9707-942f82338686",
                                "text": "La faiblesse aux humains n’est que trop naturelle ;\nMortelle, subissez le sort d’une mortelle."
                            },
                            {
                                "example_id": "6b26960c-e11d-42a4-8a14-067e18b29193",
                                "sense_id": "8d0076af-b048-3029-9707-942f82338686",
                                "text": "« Des mortelles ! dit Héra dans un souffle. Tu as amené des mortelles dans l’Olympe ! Tu sais bien que c’est défendu. »"
                            },
                            {
                                "example_id": "c9211879-2d61-4a59-ac56-ba2327534778",
                                "sense_id": "8d0076af-b048-3029-9707-942f82338686",
                                "text": "Chacune veut influencer sa décision : Héra lui promet la puissance royale ; Athéna, la gloire militaire ; Aphrodite, l’amour de la plus belle des mortelles."
                            }
                        ]
                    }
