                "senses": [
                    {
                        "sense_id": "5cb42f8b-6ff7-36b9-bade-89474383f955",
                        "entry_id": "53a9dcab-a001-36a5-8763-bcb791ccc12c",
                        "glosses": [
                            "Gerät zur Ausübung einer beliebten Mannschaftssportart, welche mit 22 Spielern und ebendiesem gespielt wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "faf20d45-df22-49f5-9665-79bdd0c8266f",
                                "sense_id": "5cb42f8b-6ff7-36b9-bade-89474383f955",
                                "text": "„Tatsächlich – der öffentliche Raum ist, nach ‚westlicher‘ Sichtweise, die große Spielwiese politischer und wirtschaftlicher Kräfte, ein langsam rollendes überdimensionales Billboard, an dem sich die jeweiligen Machtverhältnisse nur allzu genau ablesen lassen: Unternehmensarchitekturen auf entgegenkommend gewidmeten Bauparzellen hier, grelle Markenlogos da, Shoppingmalls dort, Geschäftsarkaden und Überdachungen auf vom Kommerz eroberten Freiflächen, auf denen früher, vor Urzeiten sozusagen, vielleicht einmal die Kinder dem Fetzenlaberl nachgesprintet sind.“"
                            },
                            {
                                "example_id": "8b74abca-af70-45f7-a87b-98fd29e686ec",
                                "sense_id": "5cb42f8b-6ff7-36b9-bade-89474383f955",
                                "text": "„Die Berggasse heißt Berggasse, weil sie wirklich steil wie ein Berg ansteigt, sodass das Fetzenlaberl immer bergab rollt und die Gassenjungen niemals gute Fetzenlabler werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
