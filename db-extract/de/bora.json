                    {
                        "sense_id": "dc082436-951d-3da3-90de-eaf9ce047e89",
                        "entry_id": "7f7ba0ba-41d8-3937-88a0-9fdfc24c48e2",
                        "glosses": [
                            "trockener, kalter und böiger Fallwind in Dalmatien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b63d58-1697-4569-bf12-bdce2caedc9a",
                                "sense_id": "dc082436-951d-3da3-90de-eaf9ce047e89",
                                "text": "„Im gesamten Winterhalbjahr kann einen der launische Fallwind Bora erwischen, der mit über dreißig Metern pro Sekunde aus den Bergen im Nordosten weht.“"
                            },
                            {
                                "example_id": "9668e61f-ede5-4b01-a383-209016162dcf",
                                "sense_id": "dc082436-951d-3da3-90de-eaf9ce047e89",
                                "text": "„Der ernste Moment wurde akustisch begleitet vom Raunen der betenden Frau, und von den Klängen des Bora, der wie aus Orgelpfeifen durch das Gemäuer heulte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
