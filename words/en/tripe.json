{
    "word_family": [
        "tripeless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "330272ac-9e31-301e-b105-b095c724b116",
                    "sense_definition": "The edible lining of the stomach of a ruminant animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a traditional dish using <w>tripe</w> and fresh herbs.",
                            "target_lang_translations": {
                                "zh": "厨师用<w>牛肚</w>和新鲜香草制作了一道传统菜肴。"
                            }
                        },
                        {
                            "text": "Many people find the texture of <w>tripe</w> quite unusual.",
                            "target_lang_translations": {
                                "zh": "许多人觉得<w>牛肚</w>的口感相当独特。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cooked tripe",
                        "beef tripe"
                    ],
                    "target_lang_definitions": {
                        "zh": "反刍动物胃的内壁，可供食用。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "牛肚",
                                "target_lang_sense_clarification": "指牛的胃部，常用于烹饪。"
                            },
                            {
                                "target_lang_word": "肚",
                                "target_lang_sense_clarification": "指动物的胃，常作为食材。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04b1386d-6ea5-3b7e-bc08-0a7164edc12b",
                    "sense_definition": "Something that is considered foolish, worthless, or of very poor quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the new movie as absolute <w>tripe</w>.",
                            "target_lang_translations": {
                                "zh": "评论家认为这部新电影纯属<w>垃圾</w>。"
                            }
                        },
                        {
                            "text": "I refuse to read such <w>tripe</w> written by amateur authors.",
                            "target_lang_translations": {
                                "zh": "我拒绝阅读业余作者写的这种<w>废话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "nonsense",
                        "baloney"
                    ],
                    "common_phrases": [
                        "absolute tripe",
                        "total tripe"
                    ],
                    "target_lang_definitions": {
                        "zh": "被认为愚蠢、毫无价值或质量极差的东西。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "指毫无意义或荒谬的言论。"
                            },
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "比喻质量极差或毫无价值的作品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29fb41bd-8df8-3af2-ac8c-14e271b5fb61",
                    "sense_definition": "The internal organs or entrails of an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher removed the <w>tripe</w> from the carcass during the cleaning process.",
                            "target_lang_translations": {
                                "zh": "屠夫在清理过程中从尸体中取出了<w>内脏</w>。"
                            }
                        },
                        {
                            "text": "The hunter carefully cleaned the <w>tripe</w> in the field.",
                            "target_lang_translations": {
                                "zh": "猎人在野外小心地清理了<w>内脏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entrails",
                        "guts"
                    ],
                    "target_lang_definitions": {
                        "zh": "动物的内脏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内脏",
                                "target_lang_sense_clarification": "指动物体内的器官。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e381c9-dc05-3c46-a000-bc113f39bbf1",
                    "sense_definition": "A type of edible lichen found on rocks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Survivalists sometimes forage for rock <w>tripe</w> in mountainous regions.",
                            "target_lang_translations": {
                                "zh": "生存主义者有时会在山区寻找<w>石耳</w>。"
                            }
                        },
                        {
                            "text": "The lichen known as rock <w>tripe</w> can be eaten if prepared correctly.",
                            "target_lang_translations": {
                                "zh": "如果处理得当，这种被称为<w>石耳</w>的地衣是可以食用的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock tripe"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种生长在岩石上的可食用地衣。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石耳",
                                "target_lang_sense_clarification": "一种生长在岩石上的地衣，可食用。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "6a30a91b-0bb0-3ed0-99a5-91caacb2926c",
                    "sense_definition": "An exclamation used to express that something said is untrue or nonsense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tripe</w>! You know perfectly well that was not the truth.",
                            "target_lang_translations": {
                                "zh": "<w>胡说</w>！你心里很清楚那不是事实。"
                            }
                        },
                        {
                            "text": "He claimed he won the lottery, but I just shouted <w>tripe</w> at him.",
                            "target_lang_translations": {
                                "zh": "他声称自己中了彩票，但我只是对他喊了声<w>鬼话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "nonsense"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used as an exclamation of disbelief."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于表示某事不真实或胡说八道的感叹词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡说",
                                "target_lang_sense_clarification": "表示对某人言论的强烈否定。"
                            },
                            {
                                "target_lang_word": "鬼话",
                                "target_lang_sense_clarification": "指不可信的谎言。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}