                        "glosses": [
                            "A fixed telephone communications cable; originally, one run over land, as opposed to a submarine cable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df325e23-2d60-4281-864b-99375d18fa4a",
                                "sense_id": "7745b479-33c7-379a-b607-0913d75d24aa",
                                "text": "The land line was eight months later in its completion than was anticipated, but the fleet of cable ships, sent out by the British Australian Telegraph Company, arrived in Port Darwin at the date appointed by them: November 6th, 1871."
                            }
                        ]
                    },
                    {
