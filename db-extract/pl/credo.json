                                "target_senses": [
                                    {
                                        "sense_id": "9eb8aeff-57d5-3852-81a8-5cbdac5cfa64",
                                        "entry_id": "3341904e-60ff-309c-8401-8fb67be0c14c",
                                        "glosses": [
                                            "apostolisches Glaubensbekenntnis"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18f1f93e-ac3e-3157-898c-d041abb3198a",
                                        "entry_id": "3341904e-60ff-309c-8401-8fb67be0c14c",
                                        "glosses": [
                                            "Überzeugung, die jemand vertritt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b921f033-2cfe-4c7a-9703-33ac39ac0bce",
                                                "sense_id": "18f1f93e-ac3e-3157-898c-d041abb3198a",
                                                "text": "„Niemals ist sie in der Öffentlichkeit mit ihrem stets offensiv vorgetragenen Credo auf Ablehnung gestoßen.“"
                                            },
                                            {
                                                "example_id": "0cf2e275-d325-4781-a159-575a7f8c8e1e",
                                                "sense_id": "18f1f93e-ac3e-3157-898c-d041abb3198a",
                                                "text": "„Die von Hannibal von Anfang an konsequent betriebene ideologische Kriegsführung trug nun erste Früchte. Sie erlaubte ihm die Befolgung seines politisch-militärischen Credos: die Fortsetzung seines Feldzuges auf italischem Boden, was zur Folge hatte, dass Nordafrika von den Schrecken des Krieges verschont blieb.“"
                                            },
                                            {
                                                "example_id": "43bcf906-5e1b-40a3-bc8b-8a238c5a380f",
                                                "sense_id": "18f1f93e-ac3e-3157-898c-d041abb3198a",
                                                "text": "„Das Credo des Enkels ist unmissverständlich.“"
                                            },
                                            {
                                                "example_id": "a00a80a8-d154-4ebf-88dc-bc52e6c81c5e",
                                                "sense_id": "18f1f93e-ac3e-3157-898c-d041abb3198a",
                                                "text": "„Dieses Credo der Demokratie ist den meisten afrikanischen Führern bis heute fremd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
