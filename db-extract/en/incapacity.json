                "translations": [
                    {
                        "translation_id": "687472e3-7730-466b-9f9c-94cbc9024fda",
                        "source_entry_id": "cac5a608-9a2e-389e-88ae-d77dff03279e",
                        "source_sense_description": "lack of a capacity",
                        "target_lang_word": "onvermogen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvermogen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "57c9d5ed-6580-3800-8378-9bbf42988f0d",
                                        "entry_id": "0dd348c8-14c9-3016-a563-b80806ff8deb",
                                        "glosses": [
                                            "niet bij machte zijn iets te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7172f1b-82da-4b91-b041-987b26218c98",
                                                "sense_id": "57c9d5ed-6580-3800-8378-9bbf42988f0d",
                                                "text": "Het was niet onwil, het was onvermogen waarom hij onvoldoendes haalde voor zijn examen."
                                            },
                                            {
                                                "example_id": "4e57cdc7-68fd-4379-bf2c-ac75a8168726",
                                                "sense_id": "57c9d5ed-6580-3800-8378-9bbf42988f0d",
                                                "text": "De felle, vaak gewelddadige tegenstand die hun bewegingen ondervonden van de autoriteiten en sommige bevolkingsgroepen ging terug op dezelfde constanten: angst voor verlies van controle, woede over het ontwaakte zelfbewustzijn van mensen die ‘hun plaats’ niet meer kenden, agressie uit schuldbewustzijn over het stilzwijgend accepteren van onrecht en de bange verwachting dat er hel en verdoemenis zou uitbreken wanneer de ‘ander’ de macht zou overnemen. Daaronder: het onvermogen of de onwil om in de ander werkelijk een gelijke te zien."
                                            },
                                            {
                                                "example_id": "96b3bc86-3109-4a64-b371-20560f0ae8ac",
                                                "sense_id": "57c9d5ed-6580-3800-8378-9bbf42988f0d",
                                                "text": "Het onvermogen om met elkaar te communiceren was een groot probleem. Mobieltjes gaven geen gehoor, vinkjes op WhatsApp bleven grijs, zelfs satelliettelefoons lieten het afweten. Dat had alles te maken met de grootste zendmast van telecombedrijf UTS die in hoofdstad Philipsburg omver waaide alsof het niets was. Het gevaarte van 40 meter hoog belandde bovenop het hoofdgebouw en sloeg een krater in het dak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae1d0e2-c96a-38d3-a984-34b2ca710d04",
                                        "entry_id": "0dd348c8-14c9-3016-a563-b80806ff8deb",
                                        "glosses": [
                                            "kennelijk onvermogen: niet bij machte zijn iets te betalen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bac44d7-0284-31d6-beb9-aa0aae5a47fd",
                                        "entry_id": "0dd348c8-14c9-3016-a563-b80806ff8deb",
                                        "glosses": [
                                            "armoede"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11acebe3-dca1-402f-9bbd-1fc03243877d",
                        "source_entry_id": "cac5a608-9a2e-389e-88ae-d77dff03279e",
                        "source_sense_description": "lack of a capacity",
                        "target_lang_word": "incapacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incapacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7825164f-9b6e-328d-9856-e0d0c5c38d86",
                                        "entry_id": "d2319586-96c9-3336-9b57-aeaecb6f5682",
                                        "glosses": [
                                            "État de celui qui est incapable de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c12f3a-11b3-4a57-8194-590f026c9eeb",
                                                "sense_id": "7825164f-9b6e-328d-9856-e0d0c5c38d86",
                                                "text": "Leur incapacité à s’en prendre directement à l’État les a conduits à viser d’autres cibles, notamment la minorité chrétienne — et d’abord la communauté copte —, puis à « démolir le pharaon lui-même »."
                                            },
                                            {
                                                "example_id": "d599c476-066f-4e33-afdb-dbe7fdf97cf0",
                                                "sense_id": "7825164f-9b6e-328d-9856-e0d0c5c38d86",
                                                "text": "Il a laissé voir toute son incapacité."
                                            },
                                            {
                                                "example_id": "2f44abc8-a18b-47be-baf0-1824e7ea1eda",
                                                "sense_id": "7825164f-9b6e-328d-9856-e0d0c5c38d86",
                                                "text": "Complète incapacité."
                                            },
                                            {
                                                "example_id": "7d97063b-f115-485a-800a-1e2ca3090147",
                                                "sense_id": "7825164f-9b6e-328d-9856-e0d0c5c38d86",
                                                "text": "Il est d’une telle incapacité qu’on ne peut l’employer à rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e484bdf-e628-3a20-b615-26260bf1c5c3",
                                        "entry_id": "d2319586-96c9-3336-9b57-aeaecb6f5682",
                                        "glosses": [
                                            "État d’une personne que la loi prive de certains droits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963ed6d3-9444-454b-b3ec-742dca15166d",
                                                "sense_id": "0e484bdf-e628-3a20-b615-26260bf1c5c3",
                                                "text": "L’homme, historiquement parlant, a accumulé contre sa compagne tout ce qu’il a pu imaginer de duretés et d’incapacités. … on l’a déclarée incapable de succéder à son père et à sa mère, incapable de tester, incapable d’exercer la tutelle sur ses propres enfants, et retournant elle-même en tutelle à la dissolution du mariage par la mort."
                                            },
                                            {
                                                "example_id": "ea8593fd-3f12-4d9f-a73a-b2e359c45f74",
                                                "sense_id": "0e484bdf-e628-3a20-b615-26260bf1c5c3",
                                                "text": "Un enfant est dit mineur par la loi : son jeune âge fait présumer que l’autonomie n’est pas acquise, qu’il doit donc être protégé et que le statut juridique de l’incapacité est une protection. La raison commande donc de reconnaître qu’il y a une asymétrie irrécusable entre l’enfant et l’adulte et d’admettre que cette asymétrie inclut les émotions, les désirs, les relations affectives, sentimentales ou sexuelles."
                                            },
                                            {
                                                "example_id": "3d2dafb8-545a-489c-b31b-cf6a2217d41b",
                                                "sense_id": "0e484bdf-e628-3a20-b615-26260bf1c5c3",
                                                "text": "Incapacité légale. — Incapacité de contracter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incapacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a10f5e48-1ca8-3180-bbc9-4647101c9789",
                                        "entry_id": "d1e439a0-2fe7-33db-97c5-649d07e9fc26",
                                        "glosses": [
                                            "Participe passé masculin singulier de incapaciter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b90a9a19-c6c2-45cf-828b-9f9af8effd6b",
                        "source_entry_id": "cac5a608-9a2e-389e-88ae-d77dff03279e",
                        "source_sense_description": "lack of a capacity",
                        "target_lang_word": "Unfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                        "entry_id": "c026aef2-3cf2-3c57-b418-ffe75b6d18f0",
                                        "glosses": [
                                            "der (angeborene) Zustand, zu etwas nicht fähig oder nicht in der Lage zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc6a979-0526-4ab4-a8a8-01efd210dff1",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "Mit der Unfähigkeit, mit den Menschen nicht umgehen zu können, hatte er nie wirklich eine Chance im Berufsleben."
                                            },
                                            {
                                                "example_id": "0ce866f9-e18a-4d78-8b08-341a8c0b6803",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Diese Terrorpanikmache nutzt dem Staat, den regierenden Parteibonzen, die damit von eigenen Problemen, der eigenen Unfähigkeit ablenken können.“"
                                            },
                                            {
                                                "example_id": "3ce80a7f-6ba6-466a-a0c7-71433604c9ef",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Ich dachte an die chronische Unfähigkeit meiner Landsleute, sich einer solchen Ordnung zu unterwerfen.“"
                                            },
                                            {
                                                "example_id": "5caf9651-2ce9-4dc3-ac8c-b27fc82a2b9e",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Seiner Unfähigkeit zur prinzipiellen Sinngebung, zur Einfühlung auch, versucht Schmidt durch Reisen zu entgehen.“"
                                            },
                                            {
                                                "example_id": "80547872-983c-4137-853d-35230f505945",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Was mich so unruhig macht, ist die Unfähigkeit, mich zu beschränken oder, wie mein Agent Zohnerer sagen würde, zu konzentrieren.“"
                                            },
                                            {
                                                "example_id": "560ef93b-b3ba-4f32-a703-a28bcb7c98c2",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Der Staat, der gerade in Berlin immer wieder seine Unfähigkeit beweist, soll alles richten, während der freie Markt angeblich nichts als eine profitgierige, ‚neoliberale‘ Verirrung ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
