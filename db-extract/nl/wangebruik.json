                        "examples": [
                            {
                                "example_id": "c986a859-2a19-487c-94a8-658677aff3f3",
                                "sense_id": "a112e134-df0a-3120-97a7-2ac1f853d634",
                                "text": "Wanneer de reeks van emoties, welke hij moet weergeven, te ver en te snel uiteenloopt, en zó, dat elk onderling verband onvindbaar wordt, dan zal de dirigent in gelijke mate als zijn hoorders zich verleid zien om te blijven aan de buitenkant. Dit is veel te gemakkelijk. En wijl het aanvaarden der gemakkelijkheid het begin is van alle decadentie, geloof ik nu reeds te moeten waarschuwen tegen de mogelijke terugkeer van een wangebruik, dat wegens psychologische redenen uit de muziek werd verbannen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a22dcc5-3ed4-3d1f-9450-66a5d7b14e24",
                        "entry_id": "7ed8d60b-31db-3df2-a1b7-cf3c531904d1",
                        "glosses": [
                            "benutting op een manier die verkeerd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e19b9a-bf9e-4106-8553-589c155d7548",
                                "sense_id": "3a22dcc5-3ed4-3d1f-9450-66a5d7b14e24",
                                "text": "Het lijkt wel aannemelijk dat Warnars wangebruik van zijn geld gekoppeld aan het doodshoofdverhaal uit de mond van juist de vrek, zijn verschijnen op het kerkhof en de bewoordingen van Lecker in een volgende scène bij de toenmalige toeschouwer en lezer de gedachte aan de betrekkelijkheid van (onbenut) bezit en de vereffening door de dood doet ontstaan."
                            }
                        ]
                    }
