                    {
                        "sense_id": "39313e22-d267-3309-9c14-a01d8d52054b",
                        "entry_id": "1caf49cc-5e11-3fda-af69-8482ddff612b",
                        "glosses": [
                            "Beeinflussung des Kurses von Wertpapieren, Währungen oder Rohstoffen unter Verwendung von unzulässigen Mitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7ff5f8-8695-45d7-b903-c0d0c2b0c7ae",
                                "sense_id": "39313e22-d267-3309-9c14-a01d8d52054b",
                                "text": "„Dort versuchte sie sich 2004 als Troubleshooterin, als das fast neun Millionen Euro schwere Managerbonus-Programm in den Verdacht von Kursmanipulation und Insiderhandel geriet: Hlawati löste das Problem elegant, das Geld wurde unter Vorbehalt ausgezahlt.“"
                            },
                            {
                                "example_id": "d691f78a-dff1-4c3a-bd2c-5189239aad51",
                                "sense_id": "39313e22-d267-3309-9c14-a01d8d52054b",
                                "text": "„Bei der Schlammschlacht zwischen Aktionärsschützern und der Firma Wirecard wird viel geboten: Es geht um Kursmanipulation, geheime Daten und wüste Drohungen.“"
                            },
                            {
                                "example_id": "d4c36825-7873-42c1-b69c-08d8816caca1",
                                "sense_id": "39313e22-d267-3309-9c14-a01d8d52054b",
                                "text": "„Zahlreiche Bestimmungen über Insiderhandel, Kursmanipulation und Publizitätspflichten ändern sich zum 3. Juli drastisch.“"
                            },
                            {
                                "example_id": "31b8e624-e221-4535-8eaf-01a3a9dc41aa",
                                "sense_id": "39313e22-d267-3309-9c14-a01d8d52054b",
                                "text": "„Die enorme Kursrallye der Kryptowährungen im November und Dezember des Vorjahres war das Ergebnis einer gezielten Kursmanipulation, wie die New York Times berichtet.“"
                            }
                        ],
