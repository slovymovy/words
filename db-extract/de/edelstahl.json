                                "example_id": "e632a7b8-a920-49f8-b458-56c2e12ad9cc",
                                "sense_id": "72117b51-b09a-3191-bb6b-612eb3783ddd",
                                "text": "„Edelstahl findet sich zwar in jedem Haushalt - doch die Herstellung ist für die Unternehmen in Europa seit langem kein gutes Geschäft.“"
                            },
                            {
                                "example_id": "05b3aabe-405d-4010-bdac-6137d5041817",
                                "sense_id": "72117b51-b09a-3191-bb6b-612eb3783ddd",
                                "text": "„\"Die Unternehmen haben über Jahre hinweg wichtige Preisbestandteile beim Vertrieb von Edelstahl abgesprochen\", so der Vorwurf der deutschen Kartellbehörde.“"
                            },
                            {
                                "example_id": "014454eb-616e-4f88-a9a0-859eda81ea2c",
                                "sense_id": "72117b51-b09a-3191-bb6b-612eb3783ddd",
                                "text": "„Einmal fand ich eine Bettpfanne aus Edelstahl, ein anderes Mal eine Chirurgenschere (für die Bettpfanne hatte ich keine Verwendung, aber die Schere war in der Küche verdammt praktisch).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96f5dd97-e075-3c4f-9158-c3bbd8b0e8cc",
                        "entry_id": "2f3c4245-dcb4-3698-9738-56a06f6aacc9",
                        "glosses": [
                            "rostfreier, mit Chrom und Nickel legierter Stahl"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "52911caf-6d8a-4626-91e6-ea7461418be4",
                                "sense_id": "96f5dd97-e075-3c4f-9158-c3bbd8b0e8cc",
                                "text": "„Auf eine Spüle aus Edelstahl hatten sie zuletzt gespart.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
