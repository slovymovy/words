                                                "sense_id": "5b0b6f73-37d1-37d8-a587-35c7a1b7fbb3",
                                                "text": "Fier en rechtop stond de jongen in de rij."
                                            },
                                            {
                                                "example_id": "93ae39f1-31ae-4f52-ab21-6e7a491ec8d5",
                                                "sense_id": "5b0b6f73-37d1-37d8-a587-35c7a1b7fbb3",
                                                "text": "Ik ga rechtop zitten en vis de deken van de grond."
                                            },
                                            {
                                                "example_id": "353a1af3-34e0-4a43-afcc-f6640a77f007",
                                                "sense_id": "5b0b6f73-37d1-37d8-a587-35c7a1b7fbb3",
                                                "text": "Een grote kwak Griekse yoghurt, zo stevig dat mijn lepel rechtop blijft staan."
                                            },
                                            {
                                                "example_id": "ddf23c11-9a84-4805-bb74-7d0d0b58e902",
                                                "sense_id": "5b0b6f73-37d1-37d8-a587-35c7a1b7fbb3",
                                                "text": "Zo stil mogelijk ging ik rechtop in mijn slaapzak zitten en probeerde mijn overvolle blaas geruisloos te legen."
                                            }
                                        ]
                                    }
