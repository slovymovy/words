{
    "word_family": [
        "swim",
        "swimmer",
        "swimsuit",
        "swimwear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c8dcdf0-c7de-3542-ad6f-4b0f24d6dea3",
                    "sense_definition": "The activity or sport of moving through water by moving your body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We go <w>swimming</w> at the community center every Saturday.",
                            "target_lang_translations": {
                                "ru": "Мы ходим на <w>плавание</w> в общественный центр каждую субботу.",
                                "zh": "我们每周六都去社区中心<w>游泳</w>。"
                            }
                        },
                        {
                            "text": "<w>Swimming</w> is a great way to stay healthy and fit.",
                            "target_lang_translations": {
                                "ru": "<w>Плавание</w> — отличный способ оставаться здоровым и подтянутым.",
                                "zh": "<w>游泳</w>是保持健康和体形的好方法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go swimming",
                        "swimming pool",
                        "swimming lesson",
                        "swimming trunks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или вид спорта, заключающиеся в передвижении по воде с помощью движений тела.",
                        "zh": "通过身体运动在水中移动的活动或运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "вид спорта или занятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "作为运动或休闲活动的游泳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "472e46db-8f8a-3c1e-bf19-633a40bd8a1e",
                    "sense_definition": "The state of being dizzy or in vertigo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sudden <w>swimming</w> in his head after standing up too quickly.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапное <w>головокружение</w>, встав слишком быстро.",
                                "zh": "他起得太快，突然感到一阵<w>头晕</w>。"
                            }
                        },
                        {
                            "text": "The fever caused a strange <w>swimming</w> of his senses.",
                            "target_lang_translations": {
                                "ru": "Лихорадка вызвала странное <w>головокружение</w> и помутнение чувств.",
                                "zh": "发烧使他产生了奇怪的<w>眩晕</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dizziness",
                        "vertigo",
                        "giddiness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние головокружения или ощущение вращения.",
                        "zh": "感到头晕或眩晕的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головокружение",
                                "target_lang_sense_clarification": "физическое состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头晕",
                                "target_lang_sense_clarification": "感到天旋地转的身体感觉"
                            },
                            {
                                "target_lang_word": "眩晕",
                                "target_lang_sense_clarification": "医学或文学上描述的严重头晕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26fc9e4a-3788-37e2-96a4-c5d76b1db92a",
                    "sense_definition": "Present participle and gerund of <w>swim</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>swimming</w> in the lake.",
                            "target_lang_translations": {
                                "ru": "Дети <w>плавают</w> в озере.",
                                "zh": "孩子们正在湖里<w>游泳</w>。"
                            }
                        },
                        {
                            "text": "He was <w>swimming</w> towards the shore when the storm started.",
                            "target_lang_translations": {
                                "ru": "Он <w>плыл</w> к берегу, когда начался шторм.",
                                "zh": "暴风雨开始时，他正向岸边<w>游</w>去。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола swim.",
                        "zh": "动词 swim 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавать",
                                "target_lang_sense_clarification": "процесс или способность"
                            },
                            {
                                "target_lang_word": "плыть",
                                "target_lang_sense_clarification": "движение в определенном направлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "正在进行的游泳动作"
                            },
                            {
                                "target_lang_word": "游",
                                "target_lang_sense_clarification": "表示移动过程的动词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}