                        "examples": [
                            {
                                "example_id": "e14cb605-6d44-4adb-9a50-bef8e03d961a",
                                "sense_id": "645d8f58-9aea-3501-943a-72b8eadd0239",
                                "text": "I became most distressed when talking to a man from Liverpool who said he was going up the ozzie? I thought he was planning to examine an Australian, but it turned out he was going to the hospital."
                            },
                            {
                                "example_id": "b1f92097-2208-4c49-878c-22fa69304fd4",
                                "sense_id": "645d8f58-9aea-3501-943a-72b8eadd0239",
                                "text": "What a way to start the new century – in the ozzie or a police cell."
                            }
                        ]
