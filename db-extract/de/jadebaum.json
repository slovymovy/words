                ],
                "senses": [
                    {
                        "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                        "entry_id": "65f8d548-2f77-3897-9919-dac8ef666d7d",
                        "glosses": [
                            "eine Pflanzenart (Crassula ovata) aus der Gattung Dickblatt (Crassula) mit der Heimat ist südliches Afrika, die eine beliebte Zimmerpflanze ist; er besitzt als Sukkulente die Fähigkeit, Wasser in den Blättern zu speichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb0e298-fc64-4fbf-af0a-a55681ba4938",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Der Jadebaum zählt zu meinen Lieblingspflanzen."
                            },
                            {
                                "example_id": "04ca842b-0736-439a-af77-fa5e1cdd5bc2",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Ehedem wurde der Jadebaum in den Gärten ebenfalls zur Anlegung von Hecken und Pyramiden benutzt."
                            },
                            {
                                "example_id": "93641baa-cf9a-4f0d-8387-808e69251c5c",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Der Jadebaum ist vertrocknet."
                            },
                            {
                                "example_id": "29432735-943f-4b9d-82cc-acd9e5c56f53",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Wenn er mit glänzenden Augen seine Weinschale gen Himmel hob, stand er da wie ein flimmernder Jadebaum im Himmel."
                            },
                            {
                                "example_id": "248071cc-1a01-4547-905e-9bb2410de84b",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Ich sehe mir deine Bonsais an, der Jadebaum muss beschnitten werden, ein bisschen feuchter müsste der Topf mit den beiden chinesichen Ulmen eigentlich gehalten werden, dann würden die Blätter nicht abfallen, glaube ich, aber es sind deine Bäumchen, ich wollte mich nicht einmischen."
                            },
                            {
                                "example_id": "bed65ee2-7d95-47ea-b083-657af5647713",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Nebenan stand unter einem künstlichen Jadebaum eine lebensgroße, vergoldete Gazelle auf einem schwarzen Marmorsockel."
                            },
                            {
                                "example_id": "d179c45b-6cbd-46df-8f65-c3d66dc0a8bd",
                                "sense_id": "11569035-7ab5-3bf7-8bf0-69ad83c1311b",
                                "text": "Neben Pinien, Jadebäumen und Korkeichen gedeihen im Nationalpark Doñana, der von dem Naturpark Entorno de Doñana umschlossen ist, Mastixsträucher, Zistrosen, Wacholder, Lavendel und Heidekraut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
