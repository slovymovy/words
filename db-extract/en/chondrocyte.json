                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8da47b4-bf04-4929-8a9e-0f5e5294bcbb",
                                "sense_id": "4cf49145-334f-3f84-9ff6-ea1ba8335fcc",
                                "text": "Ectopic chondrocyte hypertrophy has been demonstrated in OA, suggesting that the pathogenetical process involves a recapitulation of endochondral ossification [ 11 – 13 ]."
                            },
                            {
                                "example_id": "1ee1027f-dd09-4271-b606-84da606c3be3",
                                "sense_id": "4cf49145-334f-3f84-9ff6-ea1ba8335fcc",
                                "text": "The pinnacocytes of the outer surface and the adjacent chondrocytes contain pigment granules."
                            }
                        ]
                    }
                ],
                "translations": [
