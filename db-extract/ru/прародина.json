                ],
                "translations": [
                    {
                        "translation_id": "d48c944f-3ead-4797-9bcf-751e5abce681",
                        "source_entry_id": "9b2fd121-acb0-3dec-9aaf-0b8320a33501",
                        "source_sense_id": "bdaf07a0-1a9c-387f-9f75-5e06e07dc604",
                        "target_lang_word": "Urheimat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urheimat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                        "entry_id": "6d6b4f6c-d745-3c10-9ecf-f86679a57a58",
                                        "glosses": [
                                            "Region, in der der historische Ursprung eines Volkes vermutet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea0563d-e268-4d3c-a175-5f6fc684639a",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Obwohl auch die Archäologen nicht genau sagen können, woher die Kelten kamen, fanden sie immerhin heraus, daß deren Urheimat irgendwo in Mitteleuropa lag.“"
                                            },
                                            {
                                                "example_id": "acee808d-7dbb-4696-9d52-43def00974b4",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Über die Urheimat des Indogermanischen ist viel und wild gerätselt worden.“"
                                            },
                                            {
                                                "example_id": "b418c368-cff4-4f45-ae46-c4707a86a14b",
                                                "sense_id": "b9226ecf-89d5-3ced-b9f5-5316572c3aae",
                                                "text": "„Einzelne Wörter reichen also zum Nachweis einer bestimmten Urheimat nicht aus, weil sich das Verhältnis von »Wörtern« und »Sachen« im Laufe der Jahrhunderte verändern kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09031b54-6093-4c8c-88a3-a47f903d5884",
                        "source_entry_id": "9b2fd121-acb0-3dec-9aaf-0b8320a33501",
                        "source_sense_id": "bdaf07a0-1a9c-387f-9f75-5e06e07dc604",
                        "target_lang_word": "berceau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0da8428-4d76-3497-b6b4-09e007afafd8",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Petit lit où l’on couche les nourrissons et qui est disposé pour que l’on puisse le balancer, le bercer, aisément."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82e155b-7ec4-4ce0-9189-a897572a75ef",
                                                "sense_id": "f0da8428-4d76-3497-b6b4-09e007afafd8",
                                                "text": "Deux berceaux côte à côte, dans sa chambre, renfermaient les deux petits corps."
                                            },
                                            {
                                                "example_id": "976ea818-680f-439c-87e6-495ae52b2b76",
                                                "sense_id": "f0da8428-4d76-3497-b6b4-09e007afafd8",
                                                "text": "C’était une carapace de tortue de mer qui, paraît-il, avait servi de berceau à Henri IV nouveau-né."
                                            },
                                            {
                                                "example_id": "23fee247-361c-469c-8b96-2aff732dd2aa",
                                                "sense_id": "f0da8428-4d76-3497-b6b4-09e007afafd8",
                                                "text": "Les parents d’un bébé trouvé mort dans son berceau à Bray-Saint-Aignan (Loiret) ont été mis en examen ce vendredi du chef de « meurtre d’un mineur de moins de 15 ans » et placés en détention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb72286-d4f3-354e-b756-1731967342cc",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Lieu du commencement, du début, de l’origine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b718a8-2197-4446-96d9-6d6b3bfb4076",
                                                "sense_id": "cbb72286-d4f3-354e-b756-1731967342cc",
                                                "text": "Au milieu de cet entraînement général vers l’Afrique, l’Asie est négligée d’une manière vraiment inexplicable. Presque tout reste à découvrir dans cet antique berceau du genre humain."
                                            },
                                            {
                                                "example_id": "d8e0fbd7-4bfd-4645-a334-f7dcb52c3bec",
                                                "sense_id": "cbb72286-d4f3-354e-b756-1731967342cc",
                                                "text": "A gauche, une agglomération de toits rouges coiffe le sommet d'un mamelon abrupt : c'est Champigneulle, qui fut le berceau du peintre animalier François Desportes (1661-1743)."
                                            },
                                            {
                                                "example_id": "5a7d66e2-fc8d-40a4-a731-9af1e8116419",
                                                "sense_id": "cbb72286-d4f3-354e-b756-1731967342cc",
                                                "text": "Agustina accoucha seule au-delà des faubourgs de Cádiz, Andalucía, berceau de ce mythe, près du cap de Trafalgar où cet hijo de puta de Nelson mit la pâtée à la flotte franco-espagnole — ce qui n'a rien à voir avec notre histoire, passons."
                                            },
                                            {
                                                "example_id": "9cf684ef-1412-4e49-902f-257ea9569899",
                                                "sense_id": "cbb72286-d4f3-354e-b756-1731967342cc",
                                                "text": "En cette fin de XIXᵉ siècle, la France est le berceau incontesté de la recherche sur les personnalités multiples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81406bf-6aed-338f-aa24-9d2dd8ce4a24",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Prime enfance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc581aff-89db-4507-b1d6-d1dac1c2da37",
                                                "sense_id": "c81406bf-6aed-338f-aa24-9d2dd8ce4a24",
                                                "text": "Roland avait, depuis le berceau, ce que nos grands-mères appelaient le diable au corps, ce que nous appellerions nous la bougeotte névrotique, un besoin viscéral de se frotter à tous les interdits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb3e513-537a-3775-9993-fef85f8727dc",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Charmille taillée en voûte, treillage de même forme sur lequel on fait monter de la vigne, du jasmin, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "519dbd32-3abd-4cf6-9a68-41a8d0128a32",
                                                "sense_id": "ccb3e513-537a-3775-9993-fef85f8727dc",
                                                "text": "Vous ne sentez pas, sous les berceaux de clématite où vous méditez sur les poésies, l’odeur du cigare qui dépoétise les manuscrits."
                                            },
                                            {
                                                "example_id": "5e34456e-1ad9-452f-8612-81e9b42dae74",
                                                "sense_id": "ccb3e513-537a-3775-9993-fef85f8727dc",
                                                "text": "Mais un des charmes de ce jardin d’hiver était, aux quatre coins, des antres de verdure, des berceaux profonds, que recouvraient d’épais rideaux de lianes."
                                            },
                                            {
                                                "example_id": "de07af54-ada3-41fa-b772-46cf7a3be89f",
                                                "sense_id": "ccb3e513-537a-3775-9993-fef85f8727dc",
                                                "text": "Et enfin il me faut parler de certain berceau qui s’y trouvait et où se passa, deux étés plus tard, le fait capital de ma vie d’enfant. Il était adossé au mur d’enceinte et couvert d’une treille de muscat toujours grillée par le soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b6c455-3bcd-39b5-95eb-6d6b809b9f68",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Arceau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fec1871-861c-4afe-bdb0-a15bebadc30d",
                                                "sense_id": "27b6c455-3bcd-39b5-95eb-6d6b809b9f68",
                                                "text": "La voûte centrale, en berceau avec arcs-doubleaux, est contre-butée par les voûtes également en berceau, couvrant les collatéraux très-étroits."
                                            },
                                            {
                                                "example_id": "dafb6109-bc01-4ac6-a6ae-cbc99aebdd3a",
                                                "sense_id": "27b6c455-3bcd-39b5-95eb-6d6b809b9f68",
                                                "text": "Si on dispose orthogonalement entre elles deux voûtes en berceau et que l'on élimine les parties qui se trouvent en dessous de l'intersection, on obtient une nouvelle figure structurale appelée voûte d'arêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f53a9092-a2c0-32e0-bff5-ab84bbb6a6bf",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Pièce ou chemin courbé dans le plan vertical pour permettre un changement d’inclinaison (pivotement vertical) sans employer d’essieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2db6d5b-902d-419d-904e-878c34ff50ab",
                                                "sense_id": "f53a9092-a2c0-32e0-bff5-ab84bbb6a6bf",
                                                "text": "Le berceau d’un canon. - Les berceaux d’une chaise berçante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7012d389-471d-366b-aac4-500a9bcbdba1",
                                        "entry_id": "f299f551-7f5c-30f1-8390-cf31add0404c",
                                        "glosses": [
                                            "Lavoir à barrage pour certains minerais."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89126b53-41b1-34e9-839f-ef82ee18fc9e",
