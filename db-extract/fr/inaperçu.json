                ],
                "senses": [
                    {
                        "sense_id": "c64caf37-af99-3cef-b89a-d969dcf9efad",
                        "entry_id": "9086c377-124b-3634-adcf-64ed682a21a4",
                        "glosses": [
                            "Ce qui n’est pas aperçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5139b9-392d-4468-95b3-5d280197656f",
                                "sense_id": "c64caf37-af99-3cef-b89a-d969dcf9efad",
                                "text": "Tout ce qu’elle choisissait prenait un sens nouveau ou une nouvelle importance ; elle avait de l’invention, elle éclairait l’inaperçu, elle déconcertait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27e576c0-c1a7-499e-8f67-cda65541eae6",
                        "source_entry_id": "9086c377-124b-3634-adcf-64ed682a21a4",
                        "source_sense_id": "c64caf37-af99-3cef-b89a-d969dcf9efad",
                        "target_lang_word": "unbemerkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
