    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc66e874-997d-3b01-8ef8-ce40848e3343",
                    "sense_definition": "wręczyć komuś coś, przekazać coś na czyjąś własność lub do dyspozycji",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "przekazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek <w>dał</w> siostrze ciekawą książkę na urodziny.",
                            "target_lang_translations": {
                                "en": "Marek <w>gave</w> his sister an interesting book for her birthday."
                            }
                        },
                        {
                            "text": "Proszę, <w>daj</w> mi swój numer telefonu, abym mógł zadzwonić.",
                            "target_lang_translations": {
                                "en": "Please <w>give</w> me your phone number so I can call."
                            }
                        }
                    ],
                    "synonyms": [
                        "wręczyć",
                        "darować",
                        "przekazać",
                        "obdarować"
                    ],
                    "antonyms": [
                        "zabrać",
                        "oddać"
                    ],
                    "common_phrases": [
                        "dać prezent",
                        "dać radę",
                        "dać znać",
                        "dać spokój"
                    ],
                    "target_lang_definitions": {
                        "en": "to hand over, gift, or make something available to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to present or transfer possession of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da09c40-62b3-3e5e-8bf1-b78cb45f9090",
                    "sense_definition": "podać coś komuś do ręki",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "przekazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Daj</w> mi sól ze stołu, proszę.",
                            "target_lang_translations": {
                                "en": "<w>Pass</w> me the salt from the table, please."
                            }
                        },
                        {
                            "text": "Kelner szybko <w>dał</w> klientowi czyste sztućce.",
                            "target_lang_translations": {
                                "en": "The waiter quickly <w>handed</w> the customer clean cutlery."
                            }
                        }
                    ],
                    "synonyms": [
                        "podać"
                    ],
                    "target_lang_definitions": {
                        "en": "to hand or pass something to someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hand",
                                "target_lang_sense_clarification": "to pass something to someone with one's hand"
                            },
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to hand something over across a table or space"
                            },
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to hand or deliver into someone's hand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1b2ffcf-665b-3dcb-b02f-ac075da4583e",
                    "sense_definition": "pozwolić lub zezwolić komuś na zrobienie czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przyzwolenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama nie <w>dała</w> dzieciom wyjść na dwór podczas ulewy.",
                            "target_lang_translations": {
                                "en": "Mom didn't <w>let</w> the children go outside during the downpour."
                            }
                        },
                        {
                            "text": "Proszę, <w>daj</w> mi dokończyć to zdanie bez przerywania.",
                            "target_lang_translations": {
                                "en": "Please <w>let</w> me finish this sentence without interrupting."
                            }
                        }
                    ],
                    "synonyms": [
                        "pozwolić",
                        "zezwolić",
                        "umożliwić"
                    ],
                    "target_lang_definitions": {
                        "en": "to allow or permit someone to do something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "to allow someone to do something"
                            },
                            {
                                "target_lang_word": "allow",
                                "target_lang_sense_clarification": "to permit someone to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2af87204-a5df-38bd-9804-1b3013c13f26",
                    "sense_definition": "być możliwym do zrobienia lub urzeczywistnienia (używane zwrotnie: dać się)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "możliwość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten stary zamek w drzwiach z pewnością <w>da</w> się naprawić.",
                            "target_lang_translations": {
                                "en": "This old door lock <w>can</w> definitely <w>be</w> repaired."
                            }
                        },
                        {
                            "text": "Niestety nic więcej nie <w>dało</w> się w tej trudnej sprawie zrobić.",
                            "target_lang_translations": {
                                "en": "Unfortunately, nothing more <w>could be</w> done in this difficult matter."
                            }
                        }
                    ],
                    "synonyms": [
                        "można"
                    ],
                    "antonyms": [
                        "nie sposób"
                    ],
                    "target_lang_definitions": {
                        "en": "to be possible or feasible to do (used reflexively: dać się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "can be",
                                "target_lang_sense_clarification": "to be able to be done"
                            },
                            {
                                "target_lang_word": "be possible",
                                "target_lang_sense_clarification": "to be feasible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b0e838e-33da-3b95-895f-1d9a97cb32c3",
                    "sense_definition": "zapłacić określoną sumę pieniędzy za coś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ile <w>dałeś</w> za te nowe skórzane buty na wyprzedaży?",
                            "target_lang_translations": {
                                "en": "How much did you <w>pay</w> for these new leather shoes on sale?"
                            }
                        },
                        {
                            "text": "Za ten zabytkowy zegar na targu staroci <w>dałbym</w> każde pieniądze.",
                            "target_lang_translations": {
                                "en": "I would <w>pay</w> any amount of money for this antique clock at the flea market."
                            }
