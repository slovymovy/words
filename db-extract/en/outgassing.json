    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8f4a9a0c-4802-312a-80cc-07934a9721f5",
                "word": "outgassing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ac1ee60c-5070-415e-8769-976aa4c282eb",
                        "entry_id": "8f4a9a0c-4802-312a-80cc-07934a9721f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "outgassings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ec652b1-3b9d-3b16-880c-2f6b735dbf9a",
                        "entry_id": "8f4a9a0c-4802-312a-80cc-07934a9721f5",
                        "glosses": [
                            "The slow release of gas from a solid or liquid; especially, the release of gases into the atmosphere of a planet, or the release of gases from plastic parts."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a773635-06c2-480c-a77d-45edb60f225e",
                                "sense_id": "1ec652b1-3b9d-3b16-880c-2f6b735dbf9a",
                                "text": "A major component of new-car smell is outgassing by plastic interior parts."
                            },
                            {
                                "example_id": "20931c61-bb75-405d-8160-7988c43aaa97",
                                "sense_id": "1ec652b1-3b9d-3b16-880c-2f6b735dbf9a",
                                "text": "A sudden out-gassing of methane from the seabed sends up a giant bubble that lowers water density at the sea surface so much that a ship is no longer buoyant and sinks like a stone down a mineshaft."
                            },
                            {
                                "example_id": "8c3b3947-1cfb-41d8-b7fd-072efdb21884",
                                "sense_id": "1ec652b1-3b9d-3b16-880c-2f6b735dbf9a",
                                "text": "Zeona has a thin atmosphere of sulfur dioxide and trioxide, created by volcanic outgassing. There are traces of water vapor in the atmosphere, but over the last five centuries of observation particle counts have decreased 4%."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b72dd47e-0609-4ba3-9717-bc1d1606c0c0",
                        "source_entry_id": "8f4a9a0c-4802-312a-80cc-07934a9721f5",
                        "source_sense_id": "1ec652b1-3b9d-3b16-880c-2f6b735dbf9a",
                        "source_sense_description": "slow release of gas",
                        "target_lang_word": "dégazage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégazage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                        "entry_id": "a09bcc7f-2c78-3c4d-afcc-10bbe0705847",
                                        "glosses": [
                                            "Élimination des gaz contenus dans un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1790f8ce-88f9-4f06-8501-d10dd541b218",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "Techniquement, un tel dégazage est simple et peu coûteux, mais le travail est compliqué par la pauvreté du pays et les difficultés politiques."
                                            },
                                            {
                                                "example_id": "4667c0a6-6aef-422e-925d-4847a0fe5b56",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "Si l’effervescence est la seule visible à l’œil nu, elle ne représente que 20 pour cent de la totalité du dégazage."
                                            },
                                            {
                                                "example_id": "6666d107-dc0b-4cb0-98b7-47f876837112",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "La roche en fusion aurait cependant subi un fort dégazage, éliminant ce qui restait des éléments et composés les plus volatils."
                                            },
                                            {
                                                "example_id": "8344ee46-b515-4221-81a3-880615a0d372",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "Une problématique très importante aujourd’hui dans tous les domaines de l’industrie des salles propres (microélectronique, optique, spatial et même automobile) concerne le dégazage des matériaux."
                                            },
                                            {
                                                "example_id": "3f02e62e-4620-432e-afe6-6e5272921911",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "\"En s'approchant du Soleil, c'était la première fois de sa vie qu'elle subissait un dégazage – comme si elle perdait sa virginité\", explique l'astronome français de l'Observatoire de la Côte d'Azur."
                                            },
                                            {
                                                "example_id": "f0dc08fe-76d6-42ca-abd0-6a2de028197f",
                                                "sense_id": "ff7c146a-fecd-3800-9b82-c3987861b733",
                                                "text": "Lorsque le magma remonte à travers la croûte terrestre, l’eau qu’il contient se transforme en vapeur par un phénomène de dégazage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d694060-7402-3445-a0b0-29901b2c5172",
                                        "entry_id": "a09bcc7f-2c78-3c4d-afcc-10bbe0705847",
                                        "glosses": [
                                            "Opération qui consiste, après déchargement, à ventiler ou laver les citernes à cargaison pour éliminer les gaz explosifs qu'elles contiennent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
