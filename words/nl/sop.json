                    "sense_definition": "Gebiedende wijs van <w>soppen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "schoonmaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sop</w> die tafel nu maar eens goed schoon.",
                            "target_lang_translations": {
                                "en": "<w>Scrub</w> that table clean now."
                            }
                        },
                        {
                            "text": "<w>Sop</w> de vloer voordat je naar buiten gaat.",
                            "target_lang_translations": {
                                "en": "<w>Scrub</w> the floor before you go outside."
                            }
                        }
                    ],
                    "target_lang_definitions": {
