                        "sense_id": "8dc42a02-3b66-3ae8-bf65-5dceab9b0351",
                        "entry_id": "23af94cc-f2f7-389e-8844-92d796f8090f",
                        "glosses": [
                            "Lack of resolution; lack of decision or purpose; vacillation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23498ef1-9962-4cd5-9353-a1947f564e45",
                                "sense_id": "8dc42a02-3b66-3ae8-bf65-5dceab9b0351",
                                "text": "Again he paced the chamber; but an involuntary movement of awe and inquietude constantly led his eye towards the alcove. He drew near it with irresolution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e473877-564e-4a24-aa2a-d67758867f21",
                        "source_entry_id": "23af94cc-f2f7-389e-8844-92d796f8090f",
                        "source_sense_id": "8dc42a02-3b66-3ae8-bf65-5dceab9b0351",
                        "source_sense_description": "lack of resolution or decision — see also indecision",
                        "target_lang_word": "irrésolution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrésolution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc43daa-d629-3e2d-87c2-8a87afc47c7e",
                                        "entry_id": "a0293e9e-de52-38d1-b78d-6ec02bc4688b",
                                        "glosses": [
                                            "État de celui qui demeure irrésolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f4096f-145f-45de-9caf-bc1f9678cf22",
                                                "sense_id": "2cc43daa-d629-3e2d-87c2-8a87afc47c7e",
                                                "text": "Sa figure, […], annonçait une agitation violente où l’orgueil semblait lutter avec l’irrésolution."
                                            },
                                            {
                                                "example_id": "5deb6e8e-f6ea-464d-a544-52451f5f3c82",
                                                "sense_id": "2cc43daa-d629-3e2d-87c2-8a87afc47c7e",
                                                "text": "Au milieu de ces irrésolutions, le 22 avril, les républicains de Fribourg en Brisgau font prévenir les chefs des diverses colonnes qu’ils sont maîtres de la ville et qu’ils les attendent."
                                            },
                                            {
                                                "example_id": "4efd61a4-86c3-48c3-8b20-d1d795ec276d",
                                                "sense_id": "2cc43daa-d629-3e2d-87c2-8a87afc47c7e",
                                                "text": "– Ne me rejetez pas, par vos paroles, par vos regards, par votre douleur, dans les irrésolutions affreuses que j’ai dû traverser."
                                            },
                                            {
                                                "example_id": "3e66919e-c545-4d10-912b-ccca48aad61c",
                                                "sense_id": "2cc43daa-d629-3e2d-87c2-8a87afc47c7e",
                                                "text": "Et brusquement il se leva et se remit en route. il avait hâte d’avancer. On aurait dit que son irrésolution même le rendait impatient. Comme s’il avait voulu par son ardeur étouffer en lui le doute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
