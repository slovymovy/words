                        "glosses": [
                            "Equus ferus ferus, wymarły gatunek dzikiego konia o szarym ubarwieniu z ciemną pręgą na grzbiecie oraz czarną, stojącą grzywą i czarnym ogonem, wytępiony w XIX wieku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c652533a-4bbc-3b34-80c7-42b355735369",
