                            },
                            {
                                "target_lang_word": "бриз",
                                "target_lang_sense_clarification": "слабый ветер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e291a0-38a8-3fe8-ac16-573da59b8cc7",
                    "sense_definition": "A shrub, also called sweet gale or bog myrtle (Myrica gale), that grows on moors and fens.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damp moors were covered with sweet <w>gale</w> and heather.",
                            "target_lang_translations": {
                                "ru": "Влажные пустоши были покрыты болотным <w>восковником</w> и вереском."
                            }
                        },
                        {
                            "text": "They used the leaves of the bog <w>gale</w> to brew a traditional herbal tea.",
                            "target_lang_translations": {
                                "ru": "Они использовали листья болотного <w>восковника</w> для заваривания традиционного травяного чая."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweet gale",
                        "bog myrtle"
                    ],
                    "common_phrases": [
                        "sweet gale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кустарник семейства Восковницевые (Myrica gale), растущий на болотах и вересковых пустошах; восковник болотный."
                    },
