                                    {
                                        "sense_id": "29d85ab1-bf35-3f89-8c82-3d3a35693f41",
                                        "entry_id": "88e5e10c-f760-37c0-ad89-90ec016427d0",
                                        "glosses": [
                                            "Pertaining, similar, or belonging to a germ."
                                        ],
                                        "tags": [],
