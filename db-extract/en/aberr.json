                                                "sense_id": "6ec2542e-ef66-3e42-86f8-6f7d46c1d130",
                                                "text": "„Damit werden auch Chancen vertan, etwas gegen die - im Vergleich mit der gegenwärtigen Wirtschaftskrise - viel bedrohlichere ökologische Krise zu unternehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c27a35a7-1442-32ad-8a6e-0b3af9605f40",
                                        "entry_id": "0066564a-8064-39e8-9864-56ac27014acf",
                                        "glosses": [
                                            "etwas irrtümlicherweise für wahr oder richtig erachten, einen Fehler (bei etwas) begehen"
                                        ],
                                        "tags": [
                                            "reflexiv; umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f83c3bfd-7944-4099-89af-cfa35dc5f83b",
                                                "sense_id": "c27a35a7-1442-32ad-8a6e-0b3af9605f40",
                                                "text": "„Denn wenn der Gesetzgeber sich hier zu Lasten der Betroffenen vertut, zwingt er sie zu einem menschenunwürdigen Leben. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ffde33ae-7575-35c3-9ebc-904cb7264338",
                                        "entry_id": "0066564a-8064-39e8-9864-56ac27014acf",
                                        "glosses": [
                                            "uneingeschränkt seinem Bewegungsdrang nachgeben, ungezügelt herumtollen; sich beschäftigen"
                                        ],
                                        "tags": [
                                            "Schweiz; reflexiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b215c6-00b1-4167-9467-2cde8b839a45",
                                                "sense_id": "ffde33ae-7575-35c3-9ebc-904cb7264338",
                                                "text": "„Die Kinder konnten sich in dieser Zeit im Garten vertun, während den Eltern Zeit blieb, sich um ihre künstlerischen Aktivitäten zu kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
