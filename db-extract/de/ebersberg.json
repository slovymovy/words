                    }
                ],
                "senses": [
                    {
                        "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                        "entry_id": "b5fdceb9-b5e0-35b6-8bec-831f44bd4d7b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "429d293d-357b-412f-bd2c-742a37229977",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Die Ebersbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "05d667c6-1518-47c8-9259-a753c70ba377",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Frau Ebersberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52c85477-85b1-4dda-9fd1-8e94aed959e8",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Herr Ebersberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ea94b16-17e0-4b33-9ac7-3617da352d5a",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Der Ebersberg trägt nie die Schals, die die Ebersberg ihm strickt."
                            },
                            {
                                "example_id": "c9576c68-f968-4327-8035-dcb8c85a12c6",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ebersberg kommt, geht der Herr Ebersberg.“"
                            },
                            {
                                "example_id": "1904298b-d521-4797-88eb-543a83d9d928",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Ebersberg kommt und geht."
                            },
                            {
                                "example_id": "70b0b2b5-e0a3-482f-a39a-7d6908dd2744",
                                "sense_id": "36316dba-eb7f-344c-8996-9d9653c19f88",
                                "text": "Ebersbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
