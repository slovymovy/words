                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c44459b-9a22-348e-b1c3-a92b2d3147ed",
                        "entry_id": "5b322e8c-9c37-3835-a87e-1c3f481626dd",
                        "glosses": [
                            "te angstig en te bang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f63a199-e701-49d8-b745-47c61015e04c",
                                "sense_id": "1c44459b-9a22-348e-b1c3-a92b2d3147ed",
                                "text": "De paniekerige man zaaide veel angst bij zijn buren."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee10a7f8-1da5-397f-81f1-54abe59220c2",
                        "entry_id": "5b322e8c-9c37-3835-a87e-1c3f481626dd",
                        "glosses": [
                            "door angst niet meer weten wat je moet doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2879fc-b6b3-4f6a-9317-8c4448cd3241",
                                "sense_id": "ee10a7f8-1da5-397f-81f1-54abe59220c2",
                                "text": "De paniekerige man begon als een kip zonder kop rond te rennen toen hij de klap hoorde."
                            },
                            {
                                "example_id": "c2c19f8c-1c57-4231-888b-4c52f271967b",
                                "sense_id": "ee10a7f8-1da5-397f-81f1-54abe59220c2",
                                "text": "Paniekerig schoten allerlei gedachten door mijn hoofd: was dit niet nog gevaarlijker, helemaal alleen onbeschut en hoog in de bergen? Had ik een fout gemaakt door de mensen voor me uit het oog te verliezen en nu alleen op een berg van meer dan 3.000 meter hoog rond te dwalen? Het pad liep door een gigantische lege hoogvlakte met bergen aan weerszijde en de boomgrens twee uur onder me."
                            },
                            {
                                "example_id": "43e42aff-747a-4bfa-a48e-513ae00ecc10",
                                "sense_id": "ee10a7f8-1da5-397f-81f1-54abe59220c2",
                                "text": "Vooral de mensen die nog onvoldoende voorbereidingen hebben getroffen, zijn volgens de weerman \"paniekerig\". De weerman zag 's ochtends vroeg (plaatselijke tijd) dat inwoners van Curaçao nog druk bezig waren hun huizen te verstevigen."
                            }
                        ]
                    }
                ],
