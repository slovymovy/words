                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "637a4616-8599-4038-9d7e-d9e463ae9c2a",
                        "source_entry_id": "2f8c2184-6799-30f3-a018-89cd0dc3c387",
                        "source_sense_description": "linguistical term",
                        "target_lang_word": "métalangage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métalangage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "073357ab-529c-30e6-947e-0bd68c6de63f",
                                        "entry_id": "856ead85-c217-30e0-affd-33867411f719",
                                        "glosses": [
                                            "Discours, parole dont le langage est l’objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecd48257-b4f9-401b-bf73-f014d39fe23d",
                                                "sense_id": "073357ab-529c-30e6-947e-0bd68c6de63f",
                                                "text": "Écrire des définitions de mots dans le dictionnaire, c’est faire du métalangage."
                                            },
                                            {
                                                "example_id": "90834cdf-f7ca-49d8-a081-57e3729986ba",
                                                "sense_id": "073357ab-529c-30e6-947e-0bd68c6de63f",
                                                "text": "Le métalangage, langage à propos du langage, caractéristique du mythe, travaille à partir d’un premier langage, d’un langage-objet qu’il parasite et qu’il déforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20ff0293-9292-48eb-8ef7-7f8047ea1ba4",
                        "source_entry_id": "2f8c2184-6799-30f3-a018-89cd0dc3c387",
                        "source_sense_description": "linguistical term",
                        "target_lang_word": "Metasprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metasprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                        "entry_id": "119b540b-309d-35e6-8a0c-1393ca2eddd7",
                                        "glosses": [
                                            "die Sprache, mit der über Sprache – und nicht über Außersprachliches – gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc5e5d0-e1f5-4883-a5ff-b99460174dcd",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "Zur Metasprache gehören alle Begriffe, die man braucht, um sprachliche Gegenstände zu beschreiben, z. B. Laut, Phonem, Morphem, Wort, Satz."
                                            },
                                            {
                                                "example_id": "325dd083-ae40-4644-a3e5-15bbf774ed5c",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "„Aussagen über nicht-sprachliche Sachverhalte (z. B. „München liegt an der Isar“) werden in der Objektsprache gemacht, während Aussagen über Ausdrücke der Objektsprache (z. B. „»München« ist ein Eigenname“) sich einer Sprache höherer Stufe, einer »Metasprache« […] bedienen.“"
                                            },
                                            {
                                                "example_id": "5e4a8c32-3c64-4323-a3d4-dd6fbe5fe5fa",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "„Unter Metasprache (wörtlich etwa: ‚Sprache darüber‘) verstehen die Linguisten ‚Sprache über Sprache‘, also jedes Reden, das auf die Form eines bestimmten Stücks Sprache Bezug nimmt.“"
                                            },
                                            {
                                                "example_id": "e501a311-6613-4537-bf62-1b9cd28650aa",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "„Die Unterscheidung von Objektsprache und Metasprache hat Tarski (1935) im Rahmen der logischen Semantik als Stufenunterschied von »Grundsprache« und Metasprache eingeführt, nachdem erkannt worden war, daß die Nichtbeachtung dieser Unterscheidung zu folgenschweren Paradoxien und semantischen Antinomien führt.“"
                                            },
                                            {
                                                "example_id": "5561c958-ef6e-4af6-8100-2c912d6a076a",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "„Natürlich kann man auch über die Metasprache sprechen, also eine Meta-Metasprache entwickeln undsofort.“"
                                            },
                                            {
                                                "example_id": "0602794a-626f-4207-8a92-0d5636190ac6",
                                                "sense_id": "ce8a64fc-d992-3478-b585-907fde56399e",
                                                "text": "„Besonders hat sich dabei seit etwa dem 18. Jahrhundert eine Art Metasprache gebildet, die auf dem Lateinischen basiert, aber ihren eigenen Regeln folgt und sich zum Teil morphologisch in einzelne lebende Sprachen einpasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
