                        ]
                    },
                    {
                        "translation_id": "3a325572-8b3f-4458-970c-4815489f3162",
                        "source_entry_id": "588a966d-5a1e-3dde-bc0b-f3b47c3858e6",
                        "source_sense_description": "hand-operated brake in a car",
                        "target_lang_word": "frein à main",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frein à main",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1650e73e-2521-3d20-a3df-07cebf56a582",
                                        "entry_id": "3c7e4ea9-a1cf-3912-a90b-bbd30637ce0d",
                                        "glosses": [
                                            "Système de freinage agissant généralement sur les roues arrière d'une voiture, fonctionnant à l'aide d'un levier situé dans l'habitacle et servant à garantir l’immobilisation d’un véhicule à l’arrêt, ainsi que de freinage de secours en cas de panne des freins hydrauliques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100e4b05-7984-452f-b636-ee7b71bba8aa",
                                                "sense_id": "1650e73e-2521-3d20-a3df-07cebf56a582",
                                                "text": "Sauf sur certaines voitures récentes, le frein à main commande les organes de freinage par l'intermédiaire d'un simple câble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8113d340-96c4-4dab-bc7b-fde68aeafb0c",
                        "source_entry_id": "588a966d-5a1e-3dde-bc0b-f3b47c3858e6",
                        "source_sense_description": "hand-operated brake in a car",
                        "target_lang_word": "Handbremse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handbremse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c22de59a-6d0d-3603-bb18-30b6b2d9528a",
                                        "entry_id": "ffbeffac-2928-3c6c-9d4e-71b0a5a5f1ff",
                                        "glosses": [
                                            "Bremsanlage bei Kraftfahrzeugen, welche per Hand festgestellt wird und ein ungewolltes Rollen des Fahrzeugs verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a95873-24a7-4367-9f02-1b49855ff21b",
                                                "sense_id": "c22de59a-6d0d-3603-bb18-30b6b2d9528a",
                                                "text": "„In Frankreich, dem Mutterland solcher Auto-Ikonen wie dem Citroën DS oder dem Renault Alpine, wird grundsätzlich ohne angezogene Handbremse geparkt.“"
                                            },
                                            {
                                                "example_id": "d97f70d4-27d9-42dc-ad10-58dd8ea64544",
                                                "sense_id": "c22de59a-6d0d-3603-bb18-30b6b2d9528a",
                                                "text": "„Ich machte die Handbremse los und fuhr langsam vorbei.“"
                                            },
                                            {
                                                "example_id": "3f010cfb-09cf-4ffe-981a-1fb28bc69d49",
                                                "sense_id": "c22de59a-6d0d-3603-bb18-30b6b2d9528a",
                                                "text": "Ich benutze die Handbremse selten."
                                            },
                                            {
                                                "example_id": "c3ba1f33-65bb-4885-9664-3bf2e8013058",
                                                "sense_id": "c22de59a-6d0d-3603-bb18-30b6b2d9528a",
                                                "text": "„Val umklammerte die Handbremse und atmete tief aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ac1848e-d9cb-30a9-9227-a7353a9fe1f9",
                                        "entry_id": "ffbeffac-2928-3c6c-9d4e-71b0a5a5f1ff",
                                        "glosses": [
                                            "Bremsanlage bei Zweiradfahrzeugen, die mit der Hand bedient wird und zur Verminderung der Geschwindigkeit dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f811047-3233-461c-a58e-5bfec2a222fb",
                                                "sense_id": "0ac1848e-d9cb-30a9-9227-a7353a9fe1f9",
                                                "text": "Jedes Fahrrad muss mit einer Handbremse ausgestattet sein."
                                            },
                                            {
                                                "example_id": "c40d4800-f6d6-49b0-8de7-cd0418603425",
                                                "sense_id": "0ac1848e-d9cb-30a9-9227-a7353a9fe1f9",
                                                "text": "„Die Handbremse funktionierte jetzt, auch der Dynamo und beide Scheinwerfer, die Kette war frisch geölt und das vordere Schutzblech saß wieder fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
