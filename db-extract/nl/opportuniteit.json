                        "entry_id": "d67a7e5c-2eb5-325c-baa9-379721b7051a",
                        "glosses": [
                            "geschiktheid van tijd of gelegenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26cfe51a-60cc-4ad1-b69c-b3f97ebb79c8",
                                "sense_id": "14be494e-0858-3187-968c-d5ffcd6a12bf",
                                "text": "Hoewel hij bekend stond als een bestuurder die soms meer oplossingen uit zijn hoge hoed toverde dan er problemen waren, liet hij zich niet leiden door de opportuniteit van de tijd maar door een coherente politieke visie."
                            }
                        ]
                    },
                    {
                        "sense_id": "da33913e-9136-380e-ba99-b1969ae942e3",
                        "entry_id": "d67a7e5c-2eb5-325c-baa9-379721b7051a",
                        "glosses": [
                            "afwezigheid van redenen om in het algemeen belang toch af te zien van strafrechtelijke vervolging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2ccdb3-e89f-44ca-988e-edd7a0d0ad6e",
                                "sense_id": "da33913e-9136-380e-ba99-b1969ae942e3",
                                "text": "Het is nu aan het parket in Rotterdam om te beoordelen of sprake is van een redelijk vermoeden van schuld en om de haalbaarheid en de opportuniteit van de vervolging te beoordelen."
                            }
                        ]
                    },
