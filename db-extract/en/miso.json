                                    {
                                        "sense_id": "9a17829a-fbdc-3262-b7d2-5acce2f21cef",
                                        "entry_id": "56092f58-38cf-3a5e-b466-861a50fcca61",
                                        "glosses": [
                                            "Pâte fermentée, à base de soja et de riz ou d'orge, de goût très prononcé et très salé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d494e60-f200-4084-9718-0f9f35af2222",
                                                "sense_id": "9a17829a-fbdc-3262-b7d2-5acce2f21cef",
                                                "text": "Une fois la femme partie, il sortit dîner seul dans un restaurant proche ; du maquereau grillé à la mode de Kyoto et du tofu, des légumes marinés au vinaigre, de la soupe au miso et un bol de riz."
                                            },
                                            {
                                                "example_id": "306b76de-1b78-4b6a-b59f-98240c89bf49",
                                                "sense_id": "9a17829a-fbdc-3262-b7d2-5acce2f21cef",
                                                "text": "- Euh, c’est un déclic absolu, madame Yamazaki ! s’exclama le visiteur français en goûtant une première gorgée de soupe miso.\n- Merci. Je suis heureuse que vous appréciiez… C’est peu de chose pourtant…"
                                            },
                                            {
                                                "example_id": "a266de10-90d6-47fb-97d8-0f2d5e1da8dd",
                                                "sense_id": "9a17829a-fbdc-3262-b7d2-5acce2f21cef",
                                                "text": "Dressage : déposez une belle quenelle de mousse au chocolat, puis quelques épines-vinettes, les noix du Brésil caramélisées au miso, et le piment d’Espelette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
