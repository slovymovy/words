                    {
                        "translation_id": "f86bd7db-d0a1-4e7a-9117-d0e344af2fbb",
                        "source_entry_id": "9d2536af-4e93-326b-bc75-14073e009464",
                        "source_sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "knospend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knospend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                        "entry_id": "b9078aa7-b91c-3603-b4f0-0d20b363d0f5",
                                        "glosses": [
                                            "Sprossspitzen entwickelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49ba4d3-451b-4d8d-8679-e6850a1f4490",
                                                "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                                "text": "„Nicht zufällig hat Wedekind dieser Inkarnation einer dem Leben zugewandten Haltung sein Stück gewidmet, und der Jugendstileinband der Erstausgabe, den Franz Stuck nach Wedekinds Angaben gestaltete, zeigt eine Frühlingswiese mit knospenden Bäumen, frischen Blumen und munteren Schwalben – ein \"sonniges Abbild des Lebens\", wie Wedekind es sich, trotz aller tragischen Momente, auch für die Inszenierung des Stückes wünschte.“"
                                            },
                                            {
                                                "example_id": "2a528d45-b338-4db9-93b6-8695b27b51e3",
                                                "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                                "text": "„17 Doppelseiten für 12 Monate, für wechselnde Wetterverhältnisse und Lichtstimmungen, für keimendes Laub und knospende Blumen, denn auch die Vegetation rund um den Baum ist abgebildet. Und ebenso die Tiere; die Vögel, die im Baum nisten, und der Siebenschläfer, der sich hier tummelt.“"
                                            },
                                            {
                                                "example_id": "a2b380d4-e542-404e-bc42-ebdfb8a0819c",
                                                "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                                "text": "„Nur einige knospende Kirschbäume im Innenhof hellen die grauen Fassaden auf. “"
                                            },
                                            {
                                                "example_id": "c89bc352-656a-4d80-bf65-0af681d2e919",
                                                "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                                "text": "„Die Sonne strahlt auf die knospenden Obstbäume, nirgendwo sonst gibt es so viele in Deutschland.“"
                                            },
                                            {
                                                "example_id": "08ce79ab-1463-4e1a-8a24-4e41d0c75cf3",
                                                "sense_id": "e1f2981a-44ce-36fc-b1a6-5a9d9b4b966f",
                                                "text": "„Selbst das nahezu dreizehn Minuten währende Epos Siberian Breaks wirkt trotz einiger drastischer Rhythmus- und Stimmungswechsel wie ein Spaziergang durch einen zart knospenden Frühlingstag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                        "entry_id": "b9078aa7-b91c-3603-b4f0-0d20b363d0f5",
                                        "glosses": [
                                            "zart beginnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82117472-bd70-4865-b04a-f826b589e8a7",
                                                "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                                "text": "„Heute kommt es mir primär darauf an, dass die USA die knospenden Beziehungen zwischen der Türkei und Armenien nicht gefährdet\", sagte der US-Präsident.“"
                                            },
                                            {
                                                "example_id": "48c13157-861c-4fe1-a1c1-445ecf55392d",
                                                "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                                "text": "„Wie ein junger Trieb aus einem Eschenbaum, so soll dieses Haus emporwachsen, geschmeidig und wunderbar knospend.“"
                                            },
                                            {
                                                "example_id": "f6572e64-558e-4fe3-a77d-a133c488eb49",
                                                "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                                "text": "„Eine Flut von »Schmutz und Schund« schwappte in die humanistisch knospende Republik.“"
                                            },
                                            {
                                                "example_id": "234b2b0d-ed7f-4cca-8f10-bdb0cd72c1c1",
                                                "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                                "text": "„Sie hatte schon in ihrer Jugend das Glück genossen, von Kim Jong Il persönlich in den Journalismus eingeführt worden zu sein: \"Es war einige Jahre zuvor gewesen, als er in dem jungen Mädchen das knospende Talent der Schreibkunst entdeckte.“"
                                            },
                                            {
                                                "example_id": "e5d76f1b-d13c-42cc-a960-a3fb7a2db40e",
                                                "sense_id": "a8688b2f-a728-304f-a241-9367206b24bc",
                                                "text": "„Frankreichs knospende Ökobewegung, ist in Frankreichs Zeitungen zu lesen, sei \"grün vor Wut\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "knospend",
                                "target_lang_code": "de",
                                "target_senses": [
