                                        "entry_id": "ed0950fa-2877-3d30-947e-5282b2050d5e",
                                        "glosses": [
                                            "tvar přídavného jména nebo příslovce, který vyjadřuje maximální nebo minimální míru mezi všemi zkoumanými jevy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e30dcdf-1315-4406-9f42-9eac81627a77",
                                                "sense_id": "8272703d-9212-3035-ae10-d647965c051e",
                                                "text": "Superlativem je například slovo největší."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97bff578-783f-4146-a53a-31ea592d587e",
                        "source_entry_id": "bde55159-8b21-3320-8199-08b1bad6714d",
                        "source_sense_id": "7ccead39-3762-37be-ab80-3dbb37c95f18",
                        "target_lang_word": "superlativo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superlativo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd0bf43-d0b4-39a8-9cd1-8c098624ea5c",
                                        "entry_id": "5eeb7ea3-1439-3da9-ab0e-56ba85bc203f",
                                        "glosses": [
                                            "De gran nivel o máximo grado en su género."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880d1aa7-f121-4656-9e07-3009305180fa",
                                                "sense_id": "9cd0bf43-d0b4-39a8-9cd1-8c098624ea5c",
                                                "text": "Uno, si es superlativamente bueno, vale para mí por diez mil."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ffddb57-796f-3c9f-b9ee-caf99ce7fbf6",
                                        "entry_id": "5eeb7ea3-1439-3da9-ab0e-56ba85bc203f",
                                        "glosses": [
                                            "Que corresponde al grado máximo de la cualidad que expresa un adjetivo."
