                "senses": [
                    {
                        "sense_id": "87f1af80-a9b9-3804-9ea6-64f66ad0d953",
                        "entry_id": "e517b107-f928-3355-9af8-e0840853fdd8",
                        "glosses": [
                            "Qui fait très mal au crâne, à la tête."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "572d33c2-9177-4071-a4a6-0d8c8f1353ec",
                                "sense_id": "87f1af80-a9b9-3804-9ea6-64f66ad0d953",
                                "text": "De tous les cabotins qui empoisonnèrent jamais Paris et le monde, je n’en connais pas de plus répugnants, de plus exaspérants, de plus trépanants que les cabotins provençaux."
                            },
                            {
                                "example_id": "b9135c88-2312-4ffa-ba54-5d4162ff428f",
                                "sense_id": "87f1af80-a9b9-3804-9ea6-64f66ad0d953",
                                "text": "Elle poussait des cris trépanants, de successifs hou! hou ! de terreur folle, la prunelle diluvienne, la stéarine ravinée de sa face agitée de brusques remous, happant l’air par saccades de sa bouche aux gencives sanieuses et aux dents nécrosées."
                            },
                            {
                                "example_id": "d2f06fde-da06-41c8-ab76-f89e11f4320a",
                                "sense_id": "87f1af80-a9b9-3804-9ea6-64f66ad0d953",
                                "text": "Cet ultime effort haut placé\npas un son qui puisse le rejoindre\ndécollage grondant d’un gros avion\nune diva qui s’envole vers sa dernière note\nl’insistance trépanante d’une scie électrique,\nl’écrasement des ordures"
                            }
                        ]
                    }
