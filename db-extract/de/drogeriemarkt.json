                ],
                "senses": [
                    {
                        "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                        "entry_id": "f946f7cf-84a2-36cc-b0b7-50720c9e51f5",
                        "glosses": [
                            "Drogerie in einem Kaufhaus oder Supermarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f7988a-ff2a-4d5a-8d3f-09bda7fbb6d8",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Tüchtige Einzelhändler stellen derzeit Drogerien veralteten Stils auf Drogeriemärkte nach dem Selbstbedienungssystem um.“"
                            },
                            {
                                "example_id": "76168b26-c547-4e60-ab6f-168efa6d57ef",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Nachdem 1975 der erste Drogeriemarkt eröffnet wurde, hat das Unternehmen […] in Deutschland einen Marktanteil von 40 Prozent.“"
                            },
                            {
                                "example_id": "60b25708-0b32-493f-ae0b-f1a4385a217a",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Mit Arzneimitteln, die etwa in Apotheken, Reformhäusern oder Drogeriemärkten auch ohne Rezept über den Ladentisch gehen (= verkauft werden), wird gut.“"
                            },
                            {
                                "example_id": "34fbc338-4ad2-4f50-8939-6b99a3132695",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Flohsamenschalen gibt’s im Drogeriemarkt im Gesundheitsregal.“"
                            },
                            {
                                "example_id": "785dacd6-197e-4ede-bffb-39f1b28a6953",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Insgesamt eröffnete der Konzern im vergangenen Geschäftsjahr 163 neue Drogeriemärkte.“"
                            },
                            {
                                "example_id": "6aff4b80-810f-48aa-935e-f497503a4623",
                                "sense_id": "cb6e957b-5b19-355e-9923-3c2b99afe1e4",
                                "text": "„Die Fotos […] ließen sie vom Drogeriemarkt nebenan billig entwickeln[…].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
