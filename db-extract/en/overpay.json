                        ],
                        "form": "overpaid"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1045b78b-9d26-3aa6-b8cf-9591d3a269f1",
                        "entry_id": "7d54dfd4-852f-36da-9f44-00413e523de9",
                        "glosses": [
                            "To pay too much."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "187a3456-b4ab-4da2-98df-efab2d5a5896",
                                "sense_id": "1045b78b-9d26-3aa6-b8cf-9591d3a269f1",
                                "text": "I think we overpaid for that old car."
                            },
                            {
                                "example_id": "27676420-685e-495f-b05a-02a98e62e8db",
                                "sense_id": "1045b78b-9d26-3aa6-b8cf-9591d3a269f1",
                                "text": "Be careful not to overpay when buying second-hand items."
                            },
                            {
                                "example_id": "16135b17-1df1-4734-9f21-c7c40c80ffd3",
                                "sense_id": "1045b78b-9d26-3aa6-b8cf-9591d3a269f1",
                                "text": "The customer accidentally overpaid and was refunded."
                            }
                        ]
                    },
                    {
                        "sense_id": "91cee39b-22ba-329d-b259-c146c2048b33",
                        "entry_id": "7d54dfd4-852f-36da-9f44-00413e523de9",
                        "glosses": [
                            "To be more than an ample reward for."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa14d0b9-2eef-41ef-89c4-548f6057a079",
                        "source_entry_id": "7d54dfd4-852f-36da-9f44-00413e523de9",
                        "source_sense_description": "to pay too much",
                        "target_lang_word": "teveel betalen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c863a8d8-87a7-4b6f-a205-d7af5c1d7e59",
                        "source_entry_id": "7d54dfd4-852f-36da-9f44-00413e523de9",
                        "source_sense_description": "to pay too much",
                        "target_lang_word": "surpayer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surpayer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                        "entry_id": "ae1b887e-4592-3fb5-a2a1-ee1893c2bf70",
                                        "glosses": [
                                            "Payer quelque chose au-delà de la juste valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43001a10-7b4a-4cf5-8663-03706a854a9f",
                                                "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                                "text": "Cette étoffe ne vaut pas davantage, c’est la surpayer que d’en donner tant."
                                            },
                                            {
                                                "example_id": "c69957d1-8576-4c97-9652-7ae727b9e792",
                                                "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                                "text": "Héliodore paya, mais le dépit redoubla son génie et la semaine suivante le fisc surpaya jusqu’à rendre dix fois l’amende."
                                            },
                                            {
                                                "example_id": "bba91a76-a9ba-4a2a-a24e-bbb437f20711",
                                                "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                                "text": "Manifestement surpayés, cet kits étaient, au titre des « frais de campagne », remboursés par l’État. Un joyeux détournement de fonds publics, évalué par la justice à 10 millions d’euros."
                                            },
                                            {
                                                "example_id": "88937f7e-b6ac-4e5d-9870-a300e167d021",
                                                "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                                "text": "Mais les leçons de cette bulle ne devraient pas être \"oubliées\". \"Il ne faut pas surpayer une action\", insiste M. Rochon. Parfois, la croissance des entreprises sous-jacentes et leurs bénéfices ne justifient tout simplement pas leur prix."
                                            },
                                            {
                                                "example_id": "02b1f89b-96f7-4d73-b692-d495904a7070",
                                                "sense_id": "6f4bcf1e-fbb9-3652-a367-0dc0afc32aac",
                                                "text": "Printemps 1910, New York. La vente aux enchères de la collection Hoe, surnommée la vente du siècle.[…]\n– Cette vente n’était qu’une fumisterie !!! Tout, absolument tout a été surpayé… Quelle honte !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e66ab5d-4466-3fbb-8b29-852412d1f484",
                                        "entry_id": "ae1b887e-4592-3fb5-a2a1-ee1893c2bf70",
                                        "glosses": [
                                            "Payer quelqu’un au-delà de ce qui lui est dû."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f16f423-3388-4d11-93fc-e84e0246bfc0",
                                                "sense_id": "9e66ab5d-4466-3fbb-8b29-852412d1f484",
                                                "text": "Je ne vous donnerai rien en plus, je vous ai surpayé."
                                            },
                                            {
                                                "example_id": "70df4de3-fa03-4277-90a2-e14c3cd5141e",
                                                "sense_id": "9e66ab5d-4466-3fbb-8b29-852412d1f484",
                                                "text": "« Nous sommes réunis pour célébrer encore une fois le mérite de ceux, employés, agents de maîtrise ou bien cadres surpayés (rires) dont nul ne saurait méconnaître quels efforts ils ont pour l’entreprise si bien déployés », etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22662d79-fd5a-391a-87b5-9b9995b6ba31",
                                        "entry_id": "ae1b887e-4592-3fb5-a2a1-ee1893c2bf70",
                                        "glosses": [
                                            "Payer quelqu’un qui a déjà été payé par quelqu’un d’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079956f1-c8f0-493f-923d-8854bfd35230",
                                                "sense_id": "22662d79-fd5a-391a-87b5-9b9995b6ba31",
                                                "text": "J’ai surpayé les claqueurs envoyés contre moi, ils siffleront maladroitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f896489-50c2-4a4c-8599-02cb362fe291",
                        "source_entry_id": "7d54dfd4-852f-36da-9f44-00413e523de9",
                        "source_sense_description": "to pay too much",
                        "target_lang_word": "überbezahlen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überbezahlen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                        "entry_id": "c447bb06-89fe-3982-a1eb-8357ed3758c6",
                                        "glosses": [
                                            "zu viel bezahlen; zu hoch bezahlen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc78a82-1aa4-4039-937f-6de5c2a2a44a",
                                                "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                                "text": "Im Allgemeinen gilt, dass es eine sehr teure Methode ist, Mitarbeiter überzubezahlen, weil man sie gerne halten will."
                                            },
                                            {
                                                "example_id": "1595bba5-7ef9-4486-9c1c-b12f2c5bbabb",
                                                "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                                "text": "Die Wachen überzubezahlen, das war einfach kluge Investitionsstrategie."
                                            },
                                            {
                                                "example_id": "a29572f7-4d0c-4e5e-8a22-aca8ada18304",
                                                "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                                "text": "Zitat CEO: „ich brauche meine Mitarbeiter nicht überzubezahlen da sie stolz drauf sind für die Avantgarde zu arbeiten.“"
                                            },
                                            {
                                                "example_id": "35ea3c9e-f78f-4032-ac5b-cc27d81a51cf",
                                                "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                                "text": "Ein großes Geheimnis verriet Bono damit ja nicht gerade: „Ich bin vom Glück verwöhnt und überbezahlt!“"
                                            },
                                            {
                                                "example_id": "59034ad4-e385-456e-a87d-f531a190b185",
                                                "sense_id": "a6d19f07-1234-39bf-995d-2da87809e3d1",
                                                "text": "„Streben wir nicht alle danach, überbezahlt zu werden?“, fragte der 43-Jährige Schauspieler in einem Interview mit dem „People“-Magazin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
