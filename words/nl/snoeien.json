                    "sense_id": "dc6d8b61-183c-369d-bb0c-27f10189b1c8",
                    "sense_definition": "het inkorten of weghalen van takken van een boom of struik om de groei te bevorderen of de vorm te behouden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tuinieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het vroege voorjaar moet je de rozen <w>snoeien</w> voor een mooie bloei.",
                            "target_lang_translations": {
                                "en": "In early spring, you must <w>prune</w> the roses for a beautiful bloom."
                            }
                        },
                        {
                            "text": "De tuinman is de hele middag bezig geweest om de oude heg te <w>snoeien</w>.",
                            "target_lang_translations": {
                                "en": "The gardener spent the whole afternoon <w>trimming</w> the old hedge."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de heg snoeien",
                        "bomen snoeien",
                        "rozen snoeien"
                    ],
                    "target_lang_definitions": {
                        "en": "To shorten or remove branches from a tree or shrub to promote growth or maintain shape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prune",
                                "target_lang_sense_clarification": "to trim a plant for health or shape"
                            },
                            {
                                "target_lang_word": "trim",
                                "target_lang_sense_clarification": "to cut off irregular or unwanted parts"
                            },
                            {
                                "target_lang_word": "cut back",
                                "target_lang_sense_clarification": "to reduce the length of branches"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a7fd683-ad06-3457-b635-6ea8ad537a75",
                    "sense_definition": "het drastisch verminderen van kosten, teksten of andere zaken; bezuinigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beperken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid moet flink <w>snoeien</w> in de uitgaven voor cultuur.",
                            "target_lang_translations": {
                                "en": "The government must <w>slash</w> spending on culture significantly."
                            }
                        },
                        {
                            "text": "Je moet echt in die lange tekst <w>snoeien</w> om de kernboodschap helder te krijgen.",
                            "target_lang_translations": {
