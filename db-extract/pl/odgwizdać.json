                    },
                    {
                        "sense_id": "582a9007-fe37-3144-a6da-fa936a74c82e",
                        "entry_id": "2470ff0e-ee50-3dac-8c7e-eafc9f7f772a",
                        "glosses": [
                            "gwizdnięciem powiadomić o przerwie lub końcu czegoś"
                        ],
                        "tags": [],
