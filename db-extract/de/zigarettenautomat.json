                "senses": [
                    {
                        "sense_id": "a9edb01f-4cac-31a2-a6a0-2ca557d58c3d",
                        "entry_id": "a2221cfa-4019-3385-a3fc-8e5690125cbb",
                        "glosses": [
                            "Distributeur automatique de cigarettes."
