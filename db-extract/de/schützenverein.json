                "senses": [
                    {
                        "sense_id": "fe3335bd-aff3-3ead-83ca-094537103192",
                        "entry_id": "99703e93-67a7-3a49-ac8b-eb90bc3cd265",
                        "glosses": [
                            "Verein, dessen Mitglieder Schießsport betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c91cb8-100b-4ea4-8787-fca2f71b53a4",
                                "sense_id": "fe3335bd-aff3-3ead-83ca-094537103192",
                                "text": "„In der Idylle aus Wäldern und Badeseen gibt es nicht nur den obligatorischen Schützenverein und einen Fußballclub, hier wohnt auch Bundesinnenminister Hans-Peter Friedrich.“"
                            },
                            {
                                "example_id": "91e05eea-a2c1-463b-9063-b7ff2b620531",
                                "sense_id": "fe3335bd-aff3-3ead-83ca-094537103192",
                                "text": "„Der Amokläufer sei ein unauffälliger Einzelgänger, der selbst in seinem Schützenverein keine großen Freundschaften pflegte, aber immer sehr nett gegrüßt habe.“"
                            },
                            {
                                "example_id": "50728050-db41-480f-ace4-29365154dea7",
                                "sense_id": "fe3335bd-aff3-3ead-83ca-094537103192",
                                "text": "„Jetzt also hat er es geschafft, auch in einen Schützenverein zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
