                                        "glosses": [
                                            "Spitzname, Beiname, Nickname oft für Menschen mit guten Augen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe7b4fd-7ba6-4232-a46f-7bb286d2693b",
                                                "sense_id": "9f7c2956-ec4d-3eb4-8154-0c4a725c1f22",
                                                "text": "Na, du Adlerauge, es gibt wohl nichts, was du nicht siehst."
                                            },
                                            {
                                                "example_id": "0c761283-8dac-4e92-965a-a1eda31a6f5f",
                                                "sense_id": "9f7c2956-ec4d-3eb4-8154-0c4a725c1f22",
                                                "text": "„Ein Gegenstand allerdings scheint den Adleraugen der Zensoren vom Umweltbundesamt entgangen zu sein: der Tischmülleimer.“"
                                            }
