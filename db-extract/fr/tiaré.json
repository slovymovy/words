                        "entry_id": "8661d2a4-1b27-3c57-a66f-e265b4d74d53",
                        "glosses": [
                            "Plante dite aussi jasmin double, qui croît dans l’Océanie."
                        ],
                        "tags": [
                            "Polynésie française"
                        ],
                        "examples": [
                            {
                                "example_id": "d42eecdd-aaa1-4565-8130-b94bff1ce825",
                                "sense_id": "900e7ada-4f00-3df8-ac4f-2ec8e2fbf339",
                                "text": "Respirez un parfum de Polynésie dans votre intérieur grâce à la magnifique fleur de Tiaré."
                            },
                            {
                                "example_id": "549690dd-1ecf-4c89-a46a-947051ac574d",
                                "sense_id": "900e7ada-4f00-3df8-ac4f-2ec8e2fbf339",
                                "text": "Ce tiaré est une sorte de dahlia vert que les femmes d’Océanie se plantent dans les cheveux, un peu au-dessus de l’oreille, les jours de gala."
                            }
                        ]
                    }
                ],
