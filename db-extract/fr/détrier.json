                "senses": [
                    {
                        "sense_id": "764f4afa-3459-3aa8-ba4d-a4077f7343fa",
                        "entry_id": "fb501800-dede-36e2-beab-8f23b83853df",
                        "glosses": [
                            "Trier."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "122c3c21-7d15-493e-bf46-e6d4601eb18f",
                                "sense_id": "764f4afa-3459-3aa8-ba4d-a4077f7343fa",
                                "text": "La mère Pailler qui n’y voyait point trop pour détrier les morceaux trempés, gorgés de souillure, s’apprêtait à gourmander celui qui lui bouchait sottement la lumière lorsque, levant la tête, elle s’écria : - Ah, l’Alban !"
                            },
                            {
                                "example_id": "0591f57f-f84a-4082-bf84-a52aee2b80c7",
                                "sense_id": "764f4afa-3459-3aa8-ba4d-a4077f7343fa",
                                "text": "Mais en fait, ce n’est pas fini : à l'arrivée, il faut désencartonner, désensacher, détrier..."
                            }
                        ]
                    },
                    {
                        "sense_id": "73a5f7f7-1cec-3fe0-9717-f38028179f3e",
                        "entry_id": "fb501800-dede-36e2-beab-8f23b83853df",
                        "glosses": [
                            "Faire revenir à l’état initial après un tri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c669bcc-2308-4910-8157-2f417544da0d",
                                "sense_id": "73a5f7f7-1cec-3fe0-9717-f38028179f3e",
                                "text": "Tu ne peux pas détrier.. tu peux retrier.. ou alors copier les données les trier puis les supprimer."
                            },
                            {
                                "example_id": "c385850c-776b-4262-8104-9a563f50b0c0",
                                "sense_id": "73a5f7f7-1cec-3fe0-9717-f38028179f3e",
                                "text": "Trier - Détrier ? !"
                            }
                        ]
                    }
