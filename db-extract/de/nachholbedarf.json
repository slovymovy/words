                ],
                "senses": [
                    {
                        "sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                        "entry_id": "d03c7d77-a48b-34ca-912d-fd166df999fd",
                        "glosses": [
                            "Bedürfnis/Streben danach, etwas im Nachhinein zu tun oder zu bekommen, weil es zuvor versäumt wurde beziehungsweise unerreichbar war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b7223e-6413-413f-899b-091fb0e1b12a",
                                "sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                                "text": "„Die windreichen Nordländer, aber auch Baden-Württemberg und Rheinland-Pfalz sehen Nachholbedarf beim Windkraftausbau, während zum Beispiel Bayern mehr Interesse an Photovoltaik und Biomasse als an der Förderung von Windenergie hat.“"
                            },
                            {
                                "example_id": "569bd027-38b5-42d0-a598-c0ba9fb15cea",
                                "sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                                "text": "„[Es] lässt sich feststellen, dass bei einer Eintrübung der gesamtwirtschaftlichen Aussichten, Fahrzeugkäufe zurückgestellt werden, was in konjunkturellen Aufschwungsphasen dann zur Auflösung von Nachholbedarfen führt.“"
                            },
                            {
                                "example_id": "82a02048-efc7-45a7-87a5-701602f74106",
                                "sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fec9508-2cdf-4171-988c-a9b34c8b7f5b",
                        "source_entry_id": "d03c7d77-a48b-34ca-912d-fd166df999fd",
                        "source_sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                        "target_lang_word": "backlog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backlog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0187f6e-f4a8-33cb-819a-4e7db0fed035",
                                        "entry_id": "e0901b91-6518-3975-be21-2a0a2bdeae3a",
                                        "glosses": [
                                            "A large log to burn at the back of a fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580d9d9a-1186-4825-a290-158bd23557d7",
                                                "sense_id": "c0187f6e-f4a8-33cb-819a-4e7db0fed035",
                                                "text": "While she was preparing my breakfast, I chopped off a backlog and put it on the fire,[…]"
                                            },
                                            {
                                                "example_id": "0163f143-4360-4abd-8144-efb6207a12bd",
                                                "sense_id": "c0187f6e-f4a8-33cb-819a-4e7db0fed035",
                                                "text": "He threw it on the fire for a back-log, first scraping the live coals and ashes to a heap for his damper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0e6d7a-641d-3a28-861d-6b12a6252a71",
                                        "entry_id": "e0901b91-6518-3975-be21-2a0a2bdeae3a",
                                        "glosses": [
                                            "A reserve source or supply."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab256c60-6f31-31bc-9817-a57086f392bc",
                                        "entry_id": "e0901b91-6518-3975-be21-2a0a2bdeae3a",
                                        "glosses": [
                                            "An accumulation or buildup, especially of unfilled orders, unconsumed products or unfinished work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674552a8-123b-4ba9-86c0-c18d272bb669",
                                                "sense_id": "ab256c60-6f31-31bc-9817-a57086f392bc",
                                                "text": "He went to work on Saturday to try to work through the backlog of papers on his desk."
                                            },
                                            {
                                                "example_id": "274a8d4d-32d4-45a5-8d53-7694d1508849",
                                                "sense_id": "ab256c60-6f31-31bc-9817-a57086f392bc",
                                                "text": "Kyle purchased a new one despite having a backlog of video games that he hasn't played."
                                            },
                                            {
                                                "example_id": "477c11a9-16ef-4ff8-a041-2820848a97b2",
                                                "sense_id": "ab256c60-6f31-31bc-9817-a57086f392bc",
                                                "text": "With much of the building unrenovated since it was built in the 19th century, there is a significant backlog of repairs estimated to be in excess of £1bn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d59557-da31-336c-b5d3-e51fa3fadd7f",
                                        "entry_id": "e0901b91-6518-3975-be21-2a0a2bdeae3a",
                                        "glosses": [
                                            "A log containing text previously read, as in text-based video games or chat rooms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "backlog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17410baf-c509-3228-acb4-88f6ead9c5bf",
                                        "entry_id": "c3f0e84a-8bbf-3905-ad96-f838871fed6f",
                                        "glosses": [
                                            "To acquire something as a backlog, or to become a backlog"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec327a56-e0f5-4219-ac1c-9b46c519424d",
                        "source_entry_id": "d03c7d77-a48b-34ca-912d-fd166df999fd",
                        "source_sense_id": "242875db-5828-36b8-959d-c2be412cea05",
                        "target_lang_word": "besoin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besoin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Privation de quelque chose qui est nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35c82e5-a228-43c9-81de-ed3a40c8e0a0",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "On lui a donné de l’argent, il en avait bien besoin."
                                            },
                                            {
                                                "example_id": "60622625-5a2a-44d4-b6ee-c71b9546db77",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Avez-vous besoin de quelque chose ?"
                                            },
                                            {
                                                "example_id": "3959d663-6f42-4416-a349-a42445063f8f",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Je n’ai plus besoin de rien."
                                            },
                                            {
                                                "example_id": "b8731c13-e1f1-47e0-a16f-3bf23ab81151",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Chacun connaît ses besoins."
                                            },
                                            {
                                                "example_id": "bd58e934-d6b5-48a9-90b7-71c158daf0c1",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Confier, exposer à quelqu’un ses besoins."
                                            },
                                            {
                                                "example_id": "7dc56733-35f3-443f-93fa-e7484a80b838",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Subvenir, pourvoir à ses besoins, aux besoins de sa famille."
                                            },
                                            {
                                                "example_id": "94883e56-8b85-4891-9719-0a576efb7961",
                                                "sense_id": "da764b92-d205-3b5d-97d9-a481ddbbec67",
                                                "text": "Cela me fait besoin, bien besoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8724fe7b-8f99-30cf-b55c-46d0afb005c2",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Indigence ; dénuement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea5c95e-cbcf-4f48-951d-f1d4c26e2aa6",
                                                "sense_id": "8724fe7b-8f99-30cf-b55c-46d0afb005c2",
                                                "text": "Que répondre d'autre à cette femme qui avait été choyée, entourée... Qui n'avait certainement jamais su ce qu’étaient le besoin, les boulots permettant de gagner trois francs six sous puis la délinquance, la descente aux enfers... En dix ans, Clara avait tout connu ou presque."
                                            },
                                            {
                                                "example_id": "05edfedf-93f1-4c88-8438-30deb9b62b04",
                                                "sense_id": "8724fe7b-8f99-30cf-b55c-46d0afb005c2",
                                                "text": "Il l’a assisté dans le besoin, dans son besoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e7995f0-4a4a-3a76-8e5f-37e9f2b7cb33",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Manque de nourriture."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f37d9c5-f296-4c06-a73a-88d2b37fe5dd",
                                                "sense_id": "8e7995f0-4a4a-3a76-8e5f-37e9f2b7cb33",
                                                "text": "Être épuisé de fatigue et de besoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Mouvement instinctif, du sentiment qui porte à rechercher ou à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fffc1d5-7451-4259-a7ad-9944c7f3e504",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Roland avait, depuis le berceau, ce que nos grands-mères appelaient le diable au corps, ce que nous appellerions nous la bougeotte névrotique, un besoin viscéral de se frotter à tous les interdits, […]."
                                            },
                                            {
                                                "example_id": "3a1226c0-bd1e-4fda-8428-b3f0562c31f5",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Le tabac devient un besoin pour quelques personnes, [mais] à quoi bon augmenter le nombre des besoins ? La nature ne nous en avait donné que trois ou quatre. La civilisation, qui a commencé par nous faciliter la satisfaction de ces trois ou quatre besoins, y a ajouté une trentaine d'autres besoins..., et la sottise, une centaine. De ces besoins viennent la dépendance, les tyrannies, la nécessité du travail incessant, la pauvreté du plus grand nombre\"."
                                            },
                                            {
                                                "example_id": "d5a09a00-1be5-48ef-bd45-8c3d061cf0f1",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "C'est curieux, chez les marins, ce besoin de faire des phrases…"
                                            },
                                            {
                                                "example_id": "4bd48951-925a-4599-8f1a-9563ecb7b5af",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Les besoins du corps et de l’âme."
                                            },
                                            {
                                                "example_id": "ab64d2b0-2851-41fd-858d-9c4d547ee523",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Les besoins de la nature."
                                            },
                                            {
                                                "example_id": "f0688f5e-336e-4fea-a1e5-73789ca756db",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "C’est un besoin naturel."
                                            },
                                            {
                                                "example_id": "8bd64bbe-78f3-461a-a7c6-d1d5eb6e71fd",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Se créer des besoins factices."
                                            },
                                            {
                                                "example_id": "ff4444bd-7ed9-40ad-9362-64594c872a4a",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Prévenir tous les besoins d’une personne."
                                            },
                                            {
                                                "example_id": "26c44750-7efd-47dd-90d2-a5c4a8ca24b3",
                                                "sense_id": "7085b3e1-1988-34b9-b229-457646f2d35c",
                                                "text": "Le besoin d’aimer, de connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b534b8a-92e2-3672-929b-6675075c6b94",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Besoins du corps qui résultent de la digestion"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b6583e4-4399-43e3-8c5d-28859edeb96e",
                                                "sense_id": "4b534b8a-92e2-3672-929b-6675075c6b94",
                                                "text": "Je pris l'habitude, à l'imitation des goumiers et des bellahs, d'aller pisser accroupi, à flanc de dune, pour parer au risque de m'humidifier le saroual par vent tourbillonnant et parce qu'en terre d'Islam, ce besoin est à satisfaire discrètement."
                                            },
                                            {
                                                "example_id": "2caf1df9-c9f0-4d84-9217-a842a2507a80",
                                                "sense_id": "4b534b8a-92e2-3672-929b-6675075c6b94",
                                                "text": "Un besoin naturel. — Faire ses besoins."
                                            },
                                            {
                                                "example_id": "2f66ab94-6299-4c60-b07b-6939c98dc1ac",
                                                "sense_id": "4b534b8a-92e2-3672-929b-6675075c6b94",
                                                "text": "Ici, dans mon intérieur, on tient a chier nanti. On voudrait libérer Mandela en grand tralala. Quoi de plus naturel qu'un gros besoin mené à bien aux accords du Boléro de Ravel et dans les effluves d'un déodorant à la vanille ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Nécessité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa7067d-cf0b-4bcb-a49e-835ee9dfef7c",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Lorsque dans une armée le besoin de récompenses se fait très vivement sentir, on peut affirmer que sa valeur est en baisse."
                                            },
                                            {
                                                "example_id": "c83c6691-0eb1-4a52-b5f2-27b2fb2d52a0",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Je n’ai pas besoin de vous dire que cela doit rester secret entre nous, signifie il est impératif que cela reste entre nous."
                                            },
                                            {
                                                "example_id": "0302831f-8681-4a83-888a-7bfdd9132555",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Qu’est-il besoin de… Qu’est-il nécessaire de…"
                                            },
                                            {
                                                "example_id": "7be4b296-c0b0-4c16-887c-6088e2a1ff35",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Avoir besoin de, avoir besoin que, se dit de Ce qui est ou de Ce que l’on croit nécessaire, utile, convenable."
                                            },
                                            {
                                                "example_id": "7b995c64-310a-4ed6-8fbd-2c92c11c32db",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Cet homme a besoin de repos, a un extrême besoin de se reposer."
                                            },
                                            {
                                                "example_id": "c8ca42d9-74c5-4e9b-837a-3aef8852fdab",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Avoir besoin de dormir, de manger, de marcher, etc."
                                            },
                                            {
                                                "example_id": "90db985a-df7c-47c4-95d9-0148b3fcac93",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Vous pouvez vous retirer, je n’ai plus besoin de vous."
                                            },
                                            {
                                                "example_id": "6bd76c42-6eb4-4e7f-9dd0-7c657355c919",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Je ne puis vous prêter le livre que vous me demandez, j’en ai besoin."
                                            },
                                            {
                                                "example_id": "235ac5eb-9289-4387-8626-e7dffb3752ec",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Ce jeune homme a besoin, aurait besoin, grand besoin d’être surveillé."
                                            },
                                            {
                                                "example_id": "bb4c3ab6-51d1-490a-8ebc-df6b230266da",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Il n’a pas besoin qu’on lui dise deux fois la même chose."
                                            },
                                            {
                                                "example_id": "88b2316d-c830-49c7-ac63-f9fc1d9b5fd6",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Ce plancher s’affaisse, il a besoin d’une poutre neuve."
                                            },
                                            {
                                                "example_id": "0a53aa6a-13f8-437b-86be-d851a5f73a90",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Ces plantes ont besoin d’eau, ont besoin d’être arrosées."
                                            },
                                            {
                                                "example_id": "40b85d3d-677d-46c8-b051-705917410d1e",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Avoir besoin de, suivi d’un infinitif, signifie aussi être dans l’obligation, dans la nécessité de…"
                                            },
                                            {
                                                "example_id": "091f1763-76b4-4d80-a426-fd81a2d218bd",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "J’ai besoin d’aller à tel endroit."
                                            },
                                            {
                                                "example_id": "78c7b933-d23a-47a0-9466-1746f20772e6",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "J’ai besoin d’être de retour à la fin du mois."
                                            },
                                            {
                                                "example_id": "72c6be69-ca65-4b03-8258-71252e0065e3",
                                                "sense_id": "27f1c978-bdf7-3877-84ff-01f8b84e2dc1",
                                                "text": "Tu n'avais donc pas besoin de modifier cette chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19fcf56a-1c25-3094-8f49-b43cba605b90",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Ce qui peut être utile ou nécessaire à un projet, à une entreprise, à un but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76febb4a-7f8e-48c6-a181-7ae12ecaa89c",
                                                "sense_id": "19fcf56a-1c25-3094-8f49-b43cba605b90",
                                                "text": "Il est expliqué plus bas que le scandale n’est qu’un mot, qu’on fait naître la chose selon les besoins et les circonstances et que le plus scandaleux n’est point que tel banquier couche, un beau jour à la Santé, mais que tant d’autres dorment paisibles dans leurs draps."
                                            },
                                            {
                                                "example_id": "e899f5a0-670e-42b8-8851-e74a6d7426fb",
                                                "sense_id": "19fcf56a-1c25-3094-8f49-b43cba605b90",
                                                "text": "Les besoins de la cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15420b45-4aa8-3e24-bd9c-bf6f4cefb9ba",
                                        "entry_id": "520377b4-0ae3-3370-bd2f-14ea7f3c5e3c",
                                        "glosses": [
                                            "Personne à laquelle on présente une lettre de change, une créance, quand le tiré est absent ou ne paye pas. Recommandataire"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "besoin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0af49098-564c-302b-babd-45a775c50a82",
                                        "entry_id": "e1eac0ad-26be-3da0-8488-1541adc38fec",
                                        "glosses": [
                                            "Nécessaire."
                                        ],
                                        "tags": [],
                                        "note": "Il n’existe alors que dans de rares usages",
                                        "examples": [
                                            {
                                                "example_id": "dbbdbd25-4886-4391-8664-52ce5c10a508",
                                                "sense_id": "0af49098-564c-302b-babd-45a775c50a82",
                                                "text": "L’Adige, — est-il besoin de le dire ? — est la rivière qui passe à Vérone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
