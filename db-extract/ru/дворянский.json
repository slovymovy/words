                    {
                        "translation_id": "39b1ce7b-c843-46c4-96ea-9c900cff23c9",
                        "source_entry_id": "220e7709-23b3-3a19-8ae8-4ee387fdd7e7",
                        "source_sense_id": "2a6d01f0-ade0-3c09-9310-70e6815928e3",
                        "target_lang_word": "nobiliaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nobiliaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "698c25e1-ec25-3506-aac2-df7e2c10da67",
                                        "entry_id": "acaf097c-9266-3264-a05a-47182ca5726c",
                                        "glosses": [
                                            "Qui appartient à la noblesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7882058e-d824-4b83-8e54-ac923831acc7",
                                                "sense_id": "698c25e1-ec25-3506-aac2-df7e2c10da67",
                                                "text": "« Sir Bryah Jowahir Mothooranath, dit-il, en prononçant ces noms avec le respect que tout Anglais professe pour les titres nobiliaires, je suis heureux de vous avoir découvert et d’être le premier à vous présenter mes hommages ! »"
                                            },
                                            {
                                                "example_id": "ce7b7f37-b192-4c0a-b9b9-92e36cbb2b58",
                                                "sense_id": "698c25e1-ec25-3506-aac2-df7e2c10da67",
                                                "text": "La société enrichie la veille par des spéculations, honnêtes ou non, joignait à ses richesses des titres nobiliaires ; chacun s'improvisait comte, marquis ou baron."
                                            },
                                            {
                                                "example_id": "b77f8c02-00f8-421e-aec3-969d5336478b",
                                                "sense_id": "698c25e1-ec25-3506-aac2-df7e2c10da67",
                                                "text": "La figure centrale de ce procès est celle de Marie de la Roche, qui apparaît tour à tour fragile dans sa condition de femme, en tant qu’épouse spoliée ou mère bafouée, ou forte dans sa condition nobiliaire, en tant qu’héritière de lignées prestigieuses ou alliée à d’influentes familles nobles."
                                            },
                                            {
                                                "example_id": "bfa9f66c-a3d5-4a1f-b294-48a9f31c2a1d",
                                                "sense_id": "698c25e1-ec25-3506-aac2-df7e2c10da67",
                                                "text": "Il est toujours avantageux de porter un titre nobiliaire. Être \"de quelque chose\", ça pose un homme, comme être \"de garenne\", ça pose un lapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfbe7baa-a890-39a7-a279-9965299713e2",
                                        "entry_id": "acaf097c-9266-3264-a05a-47182ca5726c",
                                        "glosses": [
                                            "Qui est au service de la noblesse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9556d63-6eef-429a-a9ee-a33d8fa98bc0",
                                                "sense_id": "bfbe7baa-a890-39a7-a279-9965299713e2",
                                                "text": "[…]; ce titre de valet de chambre n'avait pas la même signification qu'à présent; la domesticité nobiliaire était fort recherchée, et il ne faudrait pas conclure que l’instruction musicale fût assez répandue à cette époque pour que tous les laquais jouassent du violon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nobiliaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d2d7f2-7873-3870-813c-e4f6fc3aa4eb",
                                        "entry_id": "a2cd9df8-b50d-3086-9d7d-9b23a74f6a4e",
                                        "glosses": [
                                            "Catalogue détaillé des familles nobles d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d928fe9d-48ae-4f45-9b50-89fcdba78a22",
                                                "sense_id": "b2d2d7f2-7873-3870-813c-e4f6fc3aa4eb",
                                                "text": "On trouve la généalogie de cette maison dans le nobiliaire de la province."
                                            },
                                            {
                                                "example_id": "fd19b44c-18a8-468f-8a0c-634f68185ee8",
                                                "sense_id": "b2d2d7f2-7873-3870-813c-e4f6fc3aa4eb",
                                                "text": "Voir, pour vérifier les armes, l’Histoire des grands officiers de la couronne, tome IX, page 92, promotion des chevaliers de l’ordre du Saint-Esprit du 31 décembre 1585, au nom Giraud de Mauléon, et à celui de Johanne dans le Nobiliaire de France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
