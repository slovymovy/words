                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb44b95-bfba-32af-9d11-50d0fed766f9",
                                        "entry_id": "394b9bd4-e259-393c-9515-af78812f4286",
                                        "glosses": [
                                            "Action de faire le pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d6a134-16da-4e77-8379-8d04e7312f13",
                                                "sense_id": "dbb44b95-bfba-32af-9d11-50d0fed766f9",
                                                "text": "- CERALIMENT.LU.BRUN à Augy fabrique des biscottes, du pain grillé, des biscuits et réalise de la panification fraîche."
                                            },
                                            {
                                                "example_id": "b21089e7-b573-4737-a436-6d065d4b349c",
                                                "sense_id": "dbb44b95-bfba-32af-9d11-50d0fed766f9",
                                                "text": "La panification est un processus complexe pendant lequel le boulanger doit gérer à la fois la qualité de la pâte au début du pétrissage mais aussi son évolution au cours du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f2dfaae-49bb-3118-9ffd-2d521802d078",
                                        "entry_id": "394b9bd4-e259-393c-9515-af78812f4286",
                                        "glosses": [
                                            "Transformation en pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc62f94f-1a44-4d86-82a5-1201c3df1fa1",
                                                "sense_id": "9f2dfaae-49bb-3118-9ffd-2d521802d078",
                                                "text": "Aussi M. Parmentier éloigné de tout système, & n’ayant d’autre but que de procurer aux pauvres une nourriture suffisante & saine, avoue-t-il avec franchise, d’après les essais les plus multipliés, qu’il est inutile de dénaturer la châtaigne par la panification, …."
                                            },
                                            {
                                                "example_id": "a21896e1-ec78-4e08-9ce1-e194c019509b",
                                                "sense_id": "9f2dfaae-49bb-3118-9ffd-2d521802d078",
                                                "text": "… par exemple, de la folle-avoine sera plus inacceptable dans une production de céréales destinée à la panification, que dans une céréale destinée à l’alimentation du bétail."
                                            },
                                            {
                                                "example_id": "89624fd3-3b53-4505-8072-77f3860f6556",
                                                "sense_id": "9f2dfaae-49bb-3118-9ffd-2d521802d078",
                                                "text": "La pomme de terre se prête à la panification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
