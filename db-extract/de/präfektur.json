                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6714fb4-c0c7-3578-9c4a-22f13cce6467",
                        "entry_id": "0eaf80c0-645e-309e-b026-12afc2df2397",
                        "glosses": [
                            "Amt oder Amtsbereich eines",
                            "hohen Beamten im Römischen Reich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac00c0e6-2781-4b56-b895-6ae38bb923c2",
                                "sense_id": "e6714fb4-c0c7-3578-9c4a-22f13cce6467",
                                "text": "„Die zunächst vier, später drei Inhaber dieses Amtes (gallische, italische, illyrische und orientalische Präfektur) galten als die höchsten Würdenträger des Reiches.“"
                            },
                            {
                                "example_id": "12a77985-e672-4103-bd9a-88c9220bdbac",
                                "sense_id": "e6714fb4-c0c7-3578-9c4a-22f13cce6467",
                                "text": "„Constantius Chlorus erhält Gallien und macht Trier zu seiner Residenz und zum Verwaltungssitz der gallischen Präfektur.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "1898a613-2b7d-302a-b358-2e4a8f8ad25a",
                        "entry_id": "0eaf80c0-645e-309e-b026-12afc2df2397",
                        "glosses": [
                            "Amt oder Amtsbereich eines",
                            "obersten Verwaltungsbeamten in Frankreich (Departement), Italien (Provinz) oder Japan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45179862-510f-41f1-89fc-88279bc039e0",
                                "sense_id": "1898a613-2b7d-302a-b358-2e4a8f8ad25a",
                                "text": "„Nun, Robert würde sich in den ersten Vormittagsstunden bei der Präfektur melden und die näheren Umstände erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
