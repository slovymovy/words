                ],
                "senses": [
                    {
                        "sense_id": "ec68290b-2135-301f-899a-cf27edfe57d3",
                        "entry_id": "4e3e297a-0288-3970-85d8-cfcdea82664d",
                        "glosses": [
                            "de naar beneden gerichte zijde, de bodem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296a754b-32af-4ded-bf61-027c8b2c8bca",
                                "sense_id": "ec68290b-2135-301f-899a-cf27edfe57d3",
                                "text": "De onderkant was zwart geschilderd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e3f9bd7-6031-46fc-8a9c-b0bb7027c710",
                        "source_entry_id": "4e3e297a-0288-3970-85d8-cfcdea82664d",
                        "source_sense_id": "ec68290b-2135-301f-899a-cf27edfe57d3",
                        "target_lang_word": "Unterseite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterseite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                        "entry_id": "75f4f090-fbe7-398b-976f-a9979d3e0e28",
                                        "glosses": [
                                            "Teil von etwas, der normalerweise nach unten (Richtung Boden) zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5219aeb-5dba-4819-9bd4-3c885aab1c3c",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Die jungen Blindschleichen sind auf der Unterseite schwarz, auf der Oberseite hellbraun gefärbt und tragen einen schwarzen Rückenstreifen.“"
                                            },
                                            {
                                                "example_id": "ee80edf9-2f3e-4683-9947-5d2c6645d661",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Die Oberseite der Zungenwurzel geht unmittelbar in die mittlere Fläche der Gaumenbögen und Mandeln über, die Unterseite ist durch eine derbe Schleimhautfalte (Frenulum linguae, Zungenbändchen) am Zahnfleisch fixiert.“"
                                            },
                                            {
                                                "example_id": "a2dbe7f5-c4f6-4afa-8a02-e2369dd026c6",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„Auf der Unterseite hat die Graugans schwarze Flecken.“"
                                            },
                                            {
                                                "example_id": "87fa9de3-abb0-4d7f-b1e1-1fc8b3d6c193",
                                                "sense_id": "ed28f811-9b8f-30e2-8a10-ef7a110ce73b",
                                                "text": "„In der Kammer, die ich betrat, waren nur ein Tisch, ein Stuhl, ein kleiner Spiegel und ein Bett mit zusammengerollter Matratze, so daß nur deren Unterseite zu sehen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                        "entry_id": "75f4f090-fbe7-398b-976f-a9979d3e0e28",
                                        "glosses": [
                                            "Website, die Teil einer anderen Website ist, einer Website untergeordnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9d9442-4fe7-41a1-bb67-5062db55b62c",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Bislang blendet der Konzern die Anfragen nur auf den europäischen Unterseiten wie Google.de oder Google.fr aus.“"
                                            },
                                            {
                                                "example_id": "166bfac8-304f-41aa-977d-989bd6fc5bee",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Die Information zur Energieeffizienzklasse erschien erst, nachdem der User ein konkretes Gerät angeklickt hatte und durch diesen Klick auf eine Unterseite geleitet wurde.“"
                                            },
                                            {
                                                "example_id": "7fb17bfe-7c5c-474b-b79d-6bd4ca8003fc",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Selbst in der URL einer Unterseite ist eine \"88\" versteckt.“"
                                            },
                                            {
                                                "example_id": "8f3f2124-1496-4dd3-ba67-1b81d61b8281",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Ob sie nun den E-Mail-Dienst Gmail, die Videoplattform Youtube oder das Blogprogramm Blogger nutzten – für jeden einzelnen Dienst gab es spezielle Unterseiten, über die sich Einstellungen zur Nutzung der Dienste oder zum Schutz der Privatsphäre verwalten ließen.“"
                                            },
                                            {
                                                "example_id": "3bb65564-e7de-4843-82eb-5ab06504c09f",
                                                "sense_id": "a7614062-43c2-35e3-85e2-4387dabee0c8",
                                                "text": "„Seit Freitag ist eine neue Unterseite im städtischen Internet-Auftritt zu finden, auf der alle, die helfen wollen, einen Überblick über Hilfsangebote erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3321d302-3a9c-4ed5-959a-7023359019e7",
                        "source_entry_id": "4e3e297a-0288-3970-85d8-cfcdea82664d",
                        "source_sense_id": "ec68290b-2135-301f-899a-cf27edfe57d3",
                        "target_lang_word": "underside",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25692781-c8f9-3203-8dfe-6f03c53dd6f4",
                                        "entry_id": "6d4bf313-3ae2-3fda-ab35-b6f46d44f7bc",
                                        "glosses": [
                                            "The side that is below or underneath, the bottom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ecf82ab-1aa7-4aad-b668-e8703b4c6cce",
                                                "sense_id": "25692781-c8f9-3203-8dfe-6f03c53dd6f4",
                                                "text": "A correspondent suggested that the superior riding qualities of the latter were due to the absence of piston-valve chests above the cylinders, which made it possible to bring the underside of the water-tanks to a lower level than that of the \"Rivers\", so minimising the unsteadying effect of water surging in the tanks."
                                            },
                                            {
                                                "example_id": "a09ed770-4289-407c-9240-b621d589d79d",
                                                "sense_id": "25692781-c8f9-3203-8dfe-6f03c53dd6f4",
                                                "text": "[...] and the neat reading lamps on the underside of the luggage racks, under passenger control, are an attractive feature of the first class compartments."
                                            },
                                            {
                                                "example_id": "a5aa154f-6b7d-4d98-9d40-c9c5f96f19d6",
                                                "sense_id": "25692781-c8f9-3203-8dfe-6f03c53dd6f4",
                                                "text": "The Eagles then hit the woodwork twice in a matter of seconds as Scott Dann headed Jason Puncheon's free-kick against the underside of the bar, before substitute Mile Jedinak also hit the crossbar with a shot on the turn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5003ec9-016f-4b96-a14f-2d596c5fc4c6",
                        "source_entry_id": "4e3e297a-0288-3970-85d8-cfcdea82664d",
                        "source_sense_id": "ec68290b-2135-301f-899a-cf27edfe57d3",
                        "target_lang_word": "dessous",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c55699e-b962-37bb-a02a-9d9ec11f6b30",
                                        "entry_id": "3b292842-f70f-3f9b-bc16-6185c05a04e6",
                                        "glosses": [
                                            "Dans la partie, à la face inférieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691b1107-49b0-478f-a11d-344fc9647039",
                                                "sense_id": "2c55699e-b962-37bb-a02a-9d9ec11f6b30",
                                                "text": "Devant chaque porte se trouvait une botte de paille, pour empêcher le froid de passer dessous."
                                            },
                                            {
                                                "example_id": "381e6df1-15b4-4afe-8478-0311737a278e",
                                                "sense_id": "2c55699e-b962-37bb-a02a-9d9ec11f6b30",
                                                "text": "On le cherchait sur le lit, il était dessous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dessous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3784abcb-b18a-363f-84ab-aae9d88e41f3",
                                        "entry_id": "95fea3bb-4326-36d2-9e1c-1d7528fbdb08",
                                        "glosses": [
                                            "À la partie, à la face inférieure d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8b104f-53fa-4dd3-9cdc-bfc0824a1b75",
                                                "sense_id": "3784abcb-b18a-363f-84ab-aae9d88e41f3",
                                                "text": "Cherchez dessous la table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dessous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54f49568-1312-30ad-8143-c5aaaae5802f",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "Partie, face inférieure d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e666724-1378-4d34-bf6d-595292087bdc",
                                                "sense_id": "54f49568-1312-30ad-8143-c5aaaae5802f",
                                                "text": "Le dessous d’une boîte, d’un plateau."
                                            },
                                            {
                                                "example_id": "4ebae41e-df9a-4e58-8cf3-7a06a415055e",
                                                "sense_id": "54f49568-1312-30ad-8143-c5aaaae5802f",
                                                "text": "Le dessous de la queue et du croupion est roux clair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9f241bb-4864-3bb3-be0d-f2ce4cd29ab5",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "Premier travail de l’artiste, l’ensemble des touches préparatoires qu’un travail ultérieur recouvrira plus ou moins."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df9bfd94-e056-3251-b8d0-e6bfd0337ef2",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "Quelque chose de secret, de caché dont il faut se défier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb84b82e-8330-434f-927f-8d517097151a",
                                                "sense_id": "df9bfd94-e056-3251-b8d0-e6bfd0337ef2",
                                                "text": "Le dessous des cartes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f0bff1-580c-3802-a2fd-ed7ba4deac42",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "Étage ou pièces inférieurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a779730-fbdb-4533-9800-65470b2a41d0",
                                                "sense_id": "f3f0bff1-580c-3802-a2fd-ed7ba4deac42",
                                                "text": "Les dessous d’un théâtre, étages disposés sous la scène pour la machination."
                                            },
                                            {
                                                "example_id": "28a81ebc-33a8-4f15-89a1-29b2e75fa220",
                                                "sense_id": "f3f0bff1-580c-3802-a2fd-ed7ba4deac42",
                                                "text": "Cette fois, les praticables s’effondraient en se tordant, les dessous flambaient pour tout de bon."
                                            },
                                            {
                                                "example_id": "28042079-6a97-4a17-9bfd-d4cacf77e832",
                                                "sense_id": "f3f0bff1-580c-3802-a2fd-ed7ba4deac42",
                                                "text": "« Ça, c’est Joseph Buquet que l’on a trouvé pendu dans le troisième dessous, entre un portant et un décor du Roi de Lahore. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb076d61-3e11-358d-8a83-9008d6b90b68",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "plur. Sous-vêtement féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b89cb8-dab8-4509-8480-ff8ba2b7cd4f",
                                                "sense_id": "fb076d61-3e11-358d-8a83-9008d6b90b68",
                                                "text": "Cette femme a des dessous élégants."
                                            },
                                            {
                                                "example_id": "a855e6bb-6b26-4f6a-9a6d-2eef5f782cfe",
                                                "sense_id": "fb076d61-3e11-358d-8a83-9008d6b90b68",
                                                "text": "Elle avait une forte odeur de brune, de caraco mouillé de sueur, d'épais dessous échauffés par le travail."
                                            },
                                            {
                                                "example_id": "1d8e08ba-b47c-4a6d-a6b5-cf20e4e26ac7",
                                                "sense_id": "fb076d61-3e11-358d-8a83-9008d6b90b68",
                                                "text": "Toutefois le contraste entre la popeline légèrement empesée du chemisier et la batiste délicate des dessous qui apparaissaient dans l’échancrure, attira mon attention. Une batiste blanche, ni molle, ni cassante, du vrai linge, comme en portaient les jeunes filles des pensionnats, ourlé d’un point très serré et brodé de jours en couronne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b708b65a-a3da-3d56-b894-ca891775283d",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "Désavantage dans un combat, dans une lutte, dans un débat quelconque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f1a464-95fb-4eef-a436-ef281a07ac21",
                                                "sense_id": "b708b65a-a3da-3d56-b894-ca891775283d",
                                                "text": "Les ennemis eurent le dessous."
                                            },
                                            {
                                                "example_id": "e32ca8ba-3b0e-4abc-8d4e-ebfb1afd1b5e",
                                                "sense_id": "b708b65a-a3da-3d56-b894-ca891775283d",
                                                "text": "Il aime la discussion quoiqu’il y ait presque toujours le dessous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f198b75-18e3-314e-a26b-f526f87a6077",
                                        "entry_id": "bf5490f4-07a3-3ce3-a24c-6beb61c61ca2",
                                        "glosses": [
                                            "La partie cachée d’un évènement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "412a2c6c-4632-4a0b-bca0-e6a7d49835e2",
                                                "sense_id": "0f198b75-18e3-314e-a26b-f526f87a6077",
                                                "text": "Il pensait aussi à la singulière visite de la marquise havanaise, aux velléités jalouses de Solange, aux empressements de Bernage, et il soupçonnait des dessous qui ne lui apparaissaient pas encore clairement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
