                "senses": [
                    {
                        "sense_id": "bd088580-50b5-3523-b0f8-9243bcb08b5f",
                        "entry_id": "8b7e0d93-9b06-3b15-9290-1d24026914d0",
                        "glosses": [
                            "Faire perdre son caractère beauf à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289d7890-91c3-4d13-b7bb-d398f017baab",
                                "sense_id": "bd088580-50b5-3523-b0f8-9243bcb08b5f",
                                "text": "La poignée, sur le string, c'est pour la prendre et la cogner contre l'asphalte dans le but de la rendre stérile et de débeaufiser la terre ?"
                            },
                            {
                                "example_id": "7a77d803-8b8f-452b-aa80-6e1fef615d35",
                                "sense_id": "bd088580-50b5-3523-b0f8-9243bcb08b5f",
                                "text": "Avec les années la ville devrait se débeaufiser je pense (même si ces gens ne sont pas méchants, juste mentalité et mode de vie inadapté à une grande ville)."
                            },
                            {
                                "example_id": "350131cf-be6e-4c18-87f4-8e124b477ee3",
                                "sense_id": "bd088580-50b5-3523-b0f8-9243bcb08b5f",
                                "text": "Et toi tu devrais essayer de te débeaufiser."
                            }
                        ]
                    }
                ],
