                ],
                "senses": [
                    {
                        "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                        "entry_id": "6e055566-7015-3325-87ae-2fa530ec0788",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e0a646-e2ad-463d-bb27-33b32f2b9281",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Frau Eckerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "185a8bd9-cd33-4c8e-8aa1-12527030fad4",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Herr Eckerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "218ebdc2-407f-44dc-bbd9-639ef2554c56",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Die Eckerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "025f2276-e111-42f4-adfc-b4408d7cd987",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Der Eckerle trägt nie die Pullover, die die Eckerle ihm strickt."
                            },
                            {
                                "example_id": "9dafde25-88e1-430a-ab0a-9445f8748ae2",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eckerle kommt, geht der Herr Eckerle.“"
                            },
                            {
                                "example_id": "bb39e815-bfc4-4e84-a74e-deedee4a9d9b",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Eckerle kommt und geht."
                            },
                            {
                                "example_id": "83b69ba6-2a05-4133-8f2f-0b6ebe401310",
                                "sense_id": "8cff9570-efa3-316f-84ad-7542f341164e",
                                "text": "Eckerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
