                        ]
                    },
                    {
                        "translation_id": "c61915ce-611e-4a7f-bb29-bfb2f81c5592",
                        "source_entry_id": "b60230f3-e684-3f73-88ed-eb10eba3786f",
                        "target_lang_word": "звонкий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "звонкий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3dddac24-a202-3fac-a83c-b16caa71e5bc",
                                        "entry_id": "03c6ffd5-b290-360e-b323-2f0419b4fded",
                                        "glosses": [
                                            "громкий, отчётливо звучащий; звучный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "048e5cf1-b3ee-4b97-8689-f9db58ae2ed0",
                                                "sense_id": "3dddac24-a202-3fac-a83c-b16caa71e5bc",
                                                "text": "Голос у него звонкий, походка твердая, глаза светлые и весёлые, губы полные, сочные, вид открытый."
                                            },
                                            {
                                                "example_id": "e2c90caa-c7a1-413a-81bf-1f9c15b80f5c",
                                                "sense_id": "3dddac24-a202-3fac-a83c-b16caa71e5bc",
                                                "text": "Раз в театре, в коридоре, некто быстро приблизился к кому-то и дал тому при всей публике звонкую пощечину."
                                            },
                                            {
                                                "example_id": "456494c6-d73e-444e-bd76-5e7c9b1fd028",
                                                "sense_id": "3dddac24-a202-3fac-a83c-b16caa71e5bc",
                                                "text": "В темной избе, завеянной снежными вьюгами, вспоминалась Марье её молодость, вспоминались жаркие сенокосы и вечерние зори, когда шла она в девичьей толпе полевою дорогой с звонкими песнями, а за ржами опускалось солнце и золотою пылью сыпался сквозь колосья его догорающий отблеск."
                                            },
                                            {
                                                "example_id": "1066dae2-c366-4d9b-885b-b2a23827520a",
                                                "sense_id": "3dddac24-a202-3fac-a83c-b16caa71e5bc",
                                                "text": "Звонкий звук стекла по асфальту на пустынной улице."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856f6c12-cb8c-3c14-8fd1-7992c72fb0a9",
                                        "entry_id": "03c6ffd5-b290-360e-b323-2f0419b4fded",
                                        "glosses": [
                                            "способный издавать звон, то есть чистый и напряжённый протяжный звук"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3acefe0-2e29-4852-af9f-4f00bddd1792",
                                                "sense_id": "856f6c12-cb8c-3c14-8fd1-7992c72fb0a9",
                                                "text": "Во-первых, не следует упускать из вида, что в настоящий момент на Дунае все расплаты производятся не кредитными рублями, а на звонкую монету."
                                            },
                                            {
                                                "example_id": "5f12d7d1-a00b-4b3d-b105-b373a7bf1828",
                                                "sense_id": "856f6c12-cb8c-3c14-8fd1-7992c72fb0a9",
                                                "text": "При первых же заморозках, отковавших железную корку на земле и звонкий лед на озерах, появился широкий путаный нарыск зверьков по тундре."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4953ee-64d1-3725-bf8a-22b6095bc30d",
                                        "entry_id": "03c6ffd5-b290-360e-b323-2f0419b4fded",
                                        "glosses": [
                                            "лингв. произносимый при колебании связок"
                                        ],
                                        "tags": [
                                            "о звуке"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bad0ac2e-6654-4d3c-989e-3ecdf3b5b395",
                                                "sense_id": "7c4953ee-64d1-3725-bf8a-22b6095bc30d",
                                                "text": "Чтобы определить, какой согласный: звонкий или глухой, нужно закрыть уши ладошками и произнести этот звук. Если при произнесении слышишь голос, то это звонкий согласный."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
