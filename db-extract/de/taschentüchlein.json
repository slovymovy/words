                        "examples": [
                            {
                                "example_id": "3c803dfc-f805-4c66-b5cf-a96ca684095e",
                                "sense_id": "70152372-66f8-35a7-8056-615b32d6d691",
                                "text": "„Als er fort wollte, schenkte sie ihm noch zwei Scherf Silber nebst einem schillernden Taschentüchlein und trug ihm viele Empfehlungen an alle Damen daheim auf.“"
                            },
                            {
                                "example_id": "72249f9c-69d6-4413-9482-453f24f9606b",
                                "sense_id": "70152372-66f8-35a7-8056-615b32d6d691",
                                "text": "„Sie nahmen ein winziges Prischen nach Sitte vornehmer Frauen, und Snaefrídur mußte nießen, lachte und wischte sich schnell mit dem Taschentüchlein Nase und Mund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
