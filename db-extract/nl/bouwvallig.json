                                    }
                                ]
                            },
                            {
                                "target_word": "lapsed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a94d996-dc1f-326b-99c2-422b869e483a",
                                        "entry_id": "3f32acfe-9e30-3b12-bf8d-5b7d2d4228c6",
                                        "glosses": [
                                            "Discontinued; having ceased or gone out of use."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c31bac5-68c7-46c1-9d6b-fe8ed2e587ff",
                                                "sense_id": "0a94d996-dc1f-326b-99c2-422b869e483a",
                                                "text": "The royal charities on Maunday Thursday, are really a portion of an otherwise lapsed custom, which recalled the action of our Lord on the day before His Crucifixion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bc4a22b-9c93-32ec-b848-699c7379d343",
                                        "entry_id": "3f32acfe-9e30-3b12-bf8d-5b7d2d4228c6",
                                        "glosses": [
                                            "Changed to a less valued condition or state; especially having lost one's religious faith."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ceb273-7f05-4d6f-a8a7-f886e20e6f01",
                                                "sense_id": "4bc4a22b-9c93-32ec-b848-699c7379d343",
                                                "text": "...satisfy the Doubtful, confirm the Wavering, recover the Lapsed, and be useful to all according to their several Circumstances and Conditions."
                                            },
                                            {
                                                "example_id": "df11850e-f6e5-4b14-8771-431053d62b7f",
                                                "sense_id": "4bc4a22b-9c93-32ec-b848-699c7379d343",
                                                "text": "One of them is a lapsed Catholic; the other is in no doubt of what to do, as he has suffered much on account of his adherence to Christianity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92decd42-1cad-386e-b506-6ff1b51b1f05",
                                        "entry_id": "3f32acfe-9e30-3b12-bf8d-5b7d2d4228c6",
                                        "glosses": [
                                            "By extension, having changed a (secular) belief or adherence."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e9ad48-2f73-4da3-9dc0-dee47d8e9acd",
                                                "sense_id": "92decd42-1cad-386e-b506-6ff1b51b1f05",
                                                "text": "My mother knew that I was a lapsed Republican, but did not dream of the depth to which I had fallen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "919aff31-4e4e-377c-ad7e-02ae56185638",
                                        "entry_id": "3f32acfe-9e30-3b12-bf8d-5b7d2d4228c6",
                                        "glosses": [
                                            "Having passed from the original holder or authority; no longer claimed."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ee106f-0753-4b57-9c48-59d03ab7e767",
                                                "sense_id": "919aff31-4e4e-377c-ad7e-02ae56185638",
                                                "text": "The only legitimate claimants must be, Albert of Austria, son of the sister of the last duke John; and the emperor Sigsmund, who might consider this part of Bavaria as a lapsed fief: that in this quality he had given the investiture of it to his son-in-law"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
