                "senses": [
                    {
                        "sense_id": "81108e24-9ffa-3218-b017-748876bc4223",
                        "entry_id": "55d15c97-62e6-33bf-901d-d1015557cd52",
                        "glosses": [
                            "met name over de huid: met veel dunne stukjes materiaal die loslaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b7a0cd-a778-47dd-a5a6-fc5eff779988",
                                "sense_id": "81108e24-9ffa-3218-b017-748876bc4223",
                                "text": "Het is al een tijdje bekend dat Kim Kardashian lijdt aan de chronische auto-immuunziekte psoriasis. En dat zorgt er nu voor dat de socialite last heeft van rode, schilferige plekken in haar gezicht."
                            },
                            {
                                "example_id": "31855a87-4545-419b-85a7-78b1c23c4cff",
                                "sense_id": "81108e24-9ffa-3218-b017-748876bc4223",
                                "text": "Doordat de huid er vaak rood en schilferig uitziet, reageren mensen die de ziekte niet kennen vaak zeer kwetsend\", aldus de Psoriasis Vereniging Nederland."
                            },
                            {
                                "example_id": "a6ebfdad-394b-4c07-a263-f5b4245318b1",
                                "sense_id": "81108e24-9ffa-3218-b017-748876bc4223",
                                "text": "Talloze Nederlanders die gedwongen overstappen naar een goedkoper medicijn, ondervinden daar last van. Bijwerkingen als een schilferige huid, diarree en haaruitval zijn voor hen aan de orde van de dag."
                            }
                        ]
                    }
                ],
