                "senses": [
                    {
                        "sense_id": "1231d15a-b2e3-39e6-8f31-1e3f7c6e0eda",
                        "entry_id": "761eb0e1-e7e3-3aa5-a986-5545d5486876",
                        "glosses": [
                            "groot raam aan de straatkant van een winkel waarachter de te verkopen goederen staan uitgestald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a559fa98-bb0c-4d65-9d97-7ec66f6b63ca",
                                "sense_id": "1231d15a-b2e3-39e6-8f31-1e3f7c6e0eda",
                                "text": "Met de fiets tussen hun enigszins zwaaiende lichamen in stonden ze voor het etalageraam."
                            },
                            {
                                "example_id": "433b6bf4-7e96-4226-9240-7205995d4c1f",
                                "sense_id": "1231d15a-b2e3-39e6-8f31-1e3f7c6e0eda",
                                "text": "De kinderen in de rij, vooral jongens, zijn zenuwachtig en staan met hun neus tegen het etalageraam om alvast een glimp van hun held op te vangen. De ouders en voorbijgangers zijn verbaasd over de lange rij voor iemand waarvan ze nog nooit gehoord hebben."
                            },
                            {
                                "example_id": "b59aec0b-048b-46ac-8790-8a8588784499",
                                "sense_id": "1231d15a-b2e3-39e6-8f31-1e3f7c6e0eda",
                                "text": "Met plakletters stond de naam van de zaak groot op het etalageraam: 'Bakkerij Anne & Frank'. De toeristen die binnen zitten, is de naam niet opgevallen. Nu ze erop wordt gewezen, zegt een Engelse vrouw uit Londen tegen Het Parool: ,,Ze proberen een graantje mee te pikken van het hele gebeuren rondom Anne Frank.\" Of dat nu kies is of niet, daar wil ze op haar vakantie niet mee bezig zijn."
                            }
                        ]
                    }
