                        "sense_id": "1aaef4a7-6414-3484-8549-5fadf813b734",
                        "entry_id": "64b692d1-6c69-3961-9386-8519086caed0",
                        "glosses": [
                            "andere Bezeichnung für Kindersprachforschung, Spracherwerbsforschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b56ff7-59c0-4cd7-85c9-fdd671d26ccd",
                                "sense_id": "1aaef4a7-6414-3484-8549-5fadf813b734",
                                "text": "„Die interdisziplinäre Orientierung in der Pädolinguistik sollte nicht in der Weise verstanden werden, daß es keine Eigenständigkeit des Bereiches gebe.“"
                            },
                            {
                                "example_id": "6c839634-ada1-4ee4-8961-850cff623354",
                                "sense_id": "1aaef4a7-6414-3484-8549-5fadf813b734",
                                "text": "„Da diese verschiedenen Positionen teilweise sehr komplex sind, ist es zunächst einmal nötig, die geschichtliche Entwicklung der Pädolinguistik zu beleuchten, um einen groben Überblick zu erhalten.“"
                            }
                        ],
