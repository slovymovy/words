                "senses": [
                    {
                        "sense_id": "6defbeef-06be-3eab-a018-0d223cf68463",
                        "entry_id": "7c1527d6-bf6d-34b6-ba17-b974edc3ca80",
                        "glosses": [
                            "van iets dat het doorzichtig is voor licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "503aebbd-dc91-428f-afcd-60c8c189a904",
                                "sense_id": "6defbeef-06be-3eab-a018-0d223cf68463",
                                "text": "Ik gebruik koud licht omdat de binnenste schaal van lichtdoorlatend gips is gemaakt, dat geen goede warmtegeleider is."
                            },
                            {
                                "example_id": "71857366-4dfe-4bfc-a342-222d52dcaf68",
                                "sense_id": "6defbeef-06be-3eab-a018-0d223cf68463",
                                "text": "Het feit dat hij door de buitenste lagen naar de kern kon kijken wees erop dat die lagen doorzichtig of lichtdoorlatend waren, en het licht van die lagen was waarschijnlijk enkel verspreid licht uit de kern."
                            },
                            {
                                "example_id": "9a966fdc-a570-444b-a07c-08d20670b9f5",
                                "sense_id": "6defbeef-06be-3eab-a018-0d223cf68463",
                                "text": "Architect Peter van Delft Westerhof staat voor het eerst op de Dutch Design Week. Hij promoot er zijn lichtdoorlatend beton. “Anderhalf jaar geleden wilde ik er al mee werken, maar het was nog niet te krijgen.” Dus besloot hij het zelf te ontwikkelen."
                            }
                        ]
                    }
