{
    "word_family": [
        "annotate",
        "annotator",
        "annotative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3957a6a6-31a9-337a-8e8c-d49a428303f6",
                    "sense_definition": "A note or comment added to a text to provide explanation or extra information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textual_notes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student made a brief <w>annotation</w> in the margin of the textbook.",
                            "target_lang_translations": {
                                "ru": "Студент сделал краткое <w>примечание</w> на полях учебника."
                            }
                        },
                        {
                            "text": "The manuscript was filled with helpful <w>annotations</w> from the previous owner.",
                            "target_lang_translations": {
                                "ru": "Рукопись была испещрена полезными <w>пометками</w> предыдущего владельца."
                            }
                        }
                    ],
                    "synonyms": [
                        "note",
                        "comment",
                        "gloss"
                    ],
                    "common_phrases": [
                        "make an annotation",
                        "brief annotation",
                        "marginal annotation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметка или комментарий, добавленные к тексту для пояснения или предоставления дополнительной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примечание",
                                "target_lang_sense_clarification": "заметка к тексту"
                            },
                            {
                                "target_lang_word": "пояснение",
                                "target_lang_sense_clarification": "разъясняющее замечание"
                            },
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "дополнительная информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d98c722d-8df7-36ed-90ae-473491192da5",
                    "sense_definition": "A critical or explanatory analysis or commentary on a literary work or document.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "textual_notes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar provided a detailed <w>annotation</w> for each poem in the collection.",
                            "target_lang_translations": {
                                "ru": "Ученый представил подробный <w>комментарий</w> к каждому стихотворению в сборнике."
                            }
                        },
                        {
                            "text": "She added an <w>annotation</w> in the margin to clarify the complex legal text.",
                            "target_lang_translations": {
                                "ru": "Она добавила <w>пояснение</w> на полях, чтобы разъяснить сложный юридический текст."
                            }
                        }
                    ],
                    "synonyms": [
                        "commentary",
                        "analysis",
                        "exegesis"
                    ],
                    "common_phrases": [
                        "critical annotation",
                        "explanatory annotation",
                        "detailed annotation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "academic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критический или пояснительный анализ или комментарий к литературному произведению или документу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "аналитический разбор"
                            },
                            {
                                "target_lang_word": "аннотация",
                                "target_lang_sense_clarification": "краткая характеристика текста"
                            },
                            {
                                "target_lang_word": "пояснение",
                                "target_lang_sense_clarification": "разъяснение сложного текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e84ac35-e528-3228-a6f0-a3f51aaa8851",
                    "sense_definition": "The act or process of adding notes or comments to a document or data set.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>annotation</w> of the ancient scrolls took several years to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Аннотирование</w> древних свитков заняло несколько лет."
                            }
                        },
                        {
                            "text": "Manual <w>annotation</w> of data is a time-consuming but necessary task for machine learning.",
                            "target_lang_translations": {
                                "ru": "Ручная <w>разметка</w> данных — трудоемкая, но необходимая задача для машинного обучения."
                            }
                        }
                    ],
                    "synonyms": [
                        "noting",
                        "labeling"
                    ],
                    "common_phrases": [
                        "process of annotation",
                        "manual annotation",
                        "data annotation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс добавления заметок или комментариев к документу или набору данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннотирование",
                                "target_lang_sense_clarification": "процесс составления аннотаций"
                            },
                            {
                                "target_lang_word": "комментирование",
                                "target_lang_sense_clarification": "процесс добавления комментариев"
                            },
                            {
                                "target_lang_word": "разметка",
                                "target_lang_sense_clarification": "процесс подготовки данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2ce7672-8040-33ed-91c5-4089fb0c4016",
                    "sense_definition": "Metadata or descriptive information added to a digital document, image, or computer program.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows for the <w>annotation</w> of PDF files with digital ink.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет добавлять <w>аннотации</w> в PDF-файлы с помощью цифровых чернил."
                            }
                        },
                        {
                            "text": "Each image in the database requires a specific <w>annotation</w> for the search engine to find it.",
                            "target_lang_translations": {
                                "ru": "Каждому изображению в базе данных требуется определенная <w>метка</w>, чтобы поисковая система могла его найти."
                            }
                        }
                    ],
                    "synonyms": [
                        "metadata",
                        "tag"
                    ],
                    "common_phrases": [
                        "digital annotation",
                        "image annotation",
                        "code annotation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метаданные или описательная информация, добавленная к цифровому документу, изображению или компьютерной программе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннотация",
                                "target_lang_sense_clarification": "цифровая пометка или тег"
                            },
                            {
                                "target_lang_word": "метаданные",
                                "target_lang_sense_clarification": "описательная информация"
                            },
                            {
                                "target_lang_word": "метка",
                                "target_lang_sense_clarification": "тег для поиска или классификации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b36008e9-a839-3074-8950-124714184f89",
                    "sense_definition": "The identification and description of genetic structures and sequences within a genome.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Functional <w>annotation</w> helps scientists understand what specific genes actually do.",
                            "target_lang_translations": {
                                "ru": "Функциональная <w>аннотация</w> помогает ученым понять, что именно делают конкретные гены."
                            }
                        },
                        {
                            "text": "The project focused on the genome <w>annotation</w> of a newly discovered species.",
                            "target_lang_translations": {
                                "ru": "Проект был сосредоточен на <w>аннотировании</w> генома недавно обнаруженного вида."
                            }
                        }
                    ],
                    "common_phrases": [
                        "genome annotation",
                        "functional annotation",
                        "gene annotation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идентификация и описание генетических структур и последовательностей внутри генома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннотация",
                                "target_lang_sense_clarification": "описание функций генов"
                            },
                            {
                                "target_lang_word": "аннотирование",
                                "target_lang_sense_clarification": "процесс анализа генома"
                            }
                        ]
                    }
                }
            ]
        }
    ]
