                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unlustig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e397ce1-0ff9-38bd-8847-5f62bd8d9f2e",
                                        "entry_id": "1bea8f8e-eb16-3719-aeed-534929b2a036",
                                        "glosses": [
                                            "Unlust äußernd, empfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b48ab2-aa9d-4f99-b37b-33e9df1b186e",
                                                "sense_id": "6e397ce1-0ff9-38bd-8847-5f62bd8d9f2e",
                                                "text": "„Denn in den Lustigen Weibern, die Shakespeare sehr unlustig auf Wunsch der Königin Elisabeth geschrieben hat, lebt Falstaff nur noch als der Pensionär seines einstigen Ruhms.“"
                                            },
                                            {
                                                "example_id": "92959004-d8b6-4143-bb58-ec4b1d393be9",
                                                "sense_id": "6e397ce1-0ff9-38bd-8847-5f62bd8d9f2e",
                                                "text": "„In diesen Tagen bereitet ihm der wiederbegonnene Joseph steten Verdruß: ‚Vormittags am Joseph, sehr unlustig.‘ (23.9.1940) ‚Etwas am Roman geschrieben, unlustig.‘ (27.9.1940) ‚Am dritten Kapitel geschrieben u. umgeschrieben, unlustig.‘ (28.9.1940) ‚Nach dem Frühstück gearbeitet, aber gegen Trägheit und Unerfindsamkeit. Deprimiert.‘“"
                                            },
                                            {
                                                "example_id": "1f840bf6-3bc5-428a-a384-89cdbb03496e",
                                                "sense_id": "6e397ce1-0ff9-38bd-8847-5f62bd8d9f2e",
                                                "text": "„Ich fahre unlustig, von Hitze benommen heim. Ich bin krank, ich habe Fieber, ich lege mich hin, ich verdunkele das Zimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb25bb46-86e6-3929-8d44-ae93bba0d72c",
                                        "entry_id": "1bea8f8e-eb16-3719-aeed-534929b2a036",
                                        "glosses": [
                                            "nicht lustig, ohne Heiterkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958cfa91-d2b9-4cf2-ba2f-cec317215e2d",
                                                "sense_id": "bb25bb46-86e6-3929-8d44-ae93bba0d72c",
                                                "text": "Der unlustige Clown erhielt keinen Applaus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
