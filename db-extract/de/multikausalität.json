                "senses": [
                    {
                        "sense_id": "e39f0d4c-2d49-3ec2-9925-325201b52995",
                        "entry_id": "d77f1827-1a89-314d-8052-31b674a7b2f5",
                        "glosses": [
                            "Eigenschaft/Umstand, mehrere Ursachen zu haben"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3cae64c7-c6e2-487b-a087-a23626ed63fd",
                                "sense_id": "e39f0d4c-2d49-3ec2-9925-325201b52995",
                                "text": "„Der Begriff Multikausalität beinhaltet das ausgesprochen schwer kontrollierbare Phänomen, das in der Experimentalpsychologie ‚Variablenkonfundierung‘ genannt wird, also das gleichzeitige Auftreten vieler möglicher Ursachen.“"
                            },
                            {
                                "example_id": "ba6ab89e-2c1a-4f90-9738-f9c854645138",
                                "sense_id": "e39f0d4c-2d49-3ec2-9925-325201b52995",
                                "text": "„Die in der Praxis existierenden Ursache-Wirkungsbeziehungen im Marketing, zwischen der Vision auf der einen Seite und dem Bereichsziel auf der anderen Seite, sind komplexe Multikausalitäten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
