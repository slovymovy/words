                "senses": [
                    {
                        "sense_id": "c16d88c6-8970-30f7-a994-4845a73237e1",
                        "entry_id": "5d268a2c-0acf-3b0b-88e0-94d3f477d011",
                        "glosses": [
                            "Fall, bei dem wegen einer Entführung ermittelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191bd32c-a6c5-42b7-b825-22dc99773f95",
                                "sense_id": "c16d88c6-8970-30f7-a994-4845a73237e1",
                                "text": "„Normalerweise gibt es bei Entführungsfällen ein Zeitfenster von vierundzwanzig Stunden, in dem man das Verbrechen aufklären kann - danach sucht man eine Leiche.“"
                            },
                            {
                                "example_id": "39833e32-cdee-4b41-9b30-69ee728b16bd",
                                "sense_id": "c16d88c6-8970-30f7-a994-4845a73237e1",
                                "text": "„Er betonte, dass es sich möglicherweise um einen Entführungsfall handle, und fügte hinzu, dass der Kombi durch sein Tor den Stützpunkt verlassen habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
