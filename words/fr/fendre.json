            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2e63fab-8a94-30e6-a423-82e5c3f1ec75",
                    "sense_definition": "Couper ou diviser un matériau dur, en particulier du bois, selon le fil ou dans sa longueur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bûcheron utilise une lourde hache pour <w>fendre</w> du bois avant le début de l'hiver."
                        },
                        {
                            "text": "Mon voisin a passé tout le week-end à <w>fendre</w> des bûches dans sa cour."
                        }
                    ],
                    "common_phrases": [
                        "fendre du bois",
                        "fendre des bûches"
                    ]
                },
                {
                    "sense_id": "53267817-e98a-3e25-861b-796ad70185c2",
                    "sense_definition": "S'ouvrir en formant une crevasse ou une fissure, sous l'effet du gel, de la sécheresse ou de l'usure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fissurer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec cet hiver particulièrement rigoureux, le mur en béton commence à se <w>fendre</w>."
                        },
                        {
                            "text": "Les températures négatives ont fait geler à pierre <w>fendre</w> tout le lac du village."
                        }
                    ],
                    "synonyms": [
                        "crevasser",
                        "lézarder"
                    ],
                    "common_phrases": [
                        "geler à pierre fendre"
                    ]
                },
                {
                    "sense_id": "5f391950-d746-3012-aa5a-879b47cdc528",
                    "sense_definition": "Traverser une foule, un liquide ou un obstacle dense en se frayant un passage avec effort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "traverser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont dû <w>fendre</w> la foule pour atteindre la place principale."
                        },
                        {
                            "text": "Le grand navire <w>fendait</w> les flots sombres pendant cette terrible tempête nocturne."
                        }
                    ],
                    "common_phrases": [
                        "fendre la foule",
                        "fendre les flots"
                    ]
                },
                {
                    "sense_id": "41273369-d82f-3d99-bafb-c6fb3d60e9e6",
                    "sense_definition": "Causer une immense peine ou un profond chagrin à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pleurs déchirants de cet enfant abandonné finissent par <w>fendre</w> le cœur de tous."
                        },
                        {
                            "text": "Cette triste nouvelle nous <w>fend</w> le cœur depuis ce matin."
                        }
                    ],
                    "common_phrases": [
                        "fendre le cœur"
                    ]
                },
                {
                    "sense_id": "673d9345-8299-3f14-b558-74f8e49770b8",
                    "sense_definition": "Se résoudre à donner, à payer ou à offrir quelque chose, souvent avec un certain effort ou réticence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "payer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour célébrer sa promotion, Paul s'est enfin <w>fendu</w> d'un bon repas pour ses collègues."
                        },
                        {
                            "text": "Après une longue négociation, le client a fini par se <w>fendre</w> de quelques pièces."
                        }
                    ],
                    "common_phrases": [
                        "se fendre de quelques sous"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "b434e969-e28e-3dae-bfa9-ed1f93c48b2c",
                    "sense_definition": "En escrime, allonger la jambe avant en fléchissant le genou pour porter une attaque.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître d'armes lui a appris à se <w>fendre</w> rapidement vers l'avant."
                        },
                        {
                            "text": "L'escrimeur s'est <w>fendu</w> avec précision pour marquer le point décisif du duel."
                        }
                    ]
                }
            ]
        }
