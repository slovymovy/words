                    }
                ],
                "senses": [
                    {
                        "sense_id": "8568d357-c4c9-3023-9eb1-8d2034356d0e",
                        "entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
                        "glosses": [
                            "waarneembaar voor het oog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e06427-fc4b-436b-9ea4-31e25b8c0bad",
                                "sense_id": "8568d357-c4c9-3023-9eb1-8d2034356d0e",
                                "text": "De andere twee waren oud en doorgezakt en zichtbaar veel gebruikt."
                            },
                            {
                                "example_id": "a6e1f859-5060-4c62-a373-8d3eb8348bb4",
                                "sense_id": "8568d357-c4c9-3023-9eb1-8d2034356d0e",
                                "text": "De jongen naast me deed zijn koplamp aan waardoor de in de muur gekraste namen zichtbaar werden: hier waren al eerder mensen gestrand."
                            }
                        ]
                    },
                    {
                        "sense_id": "be13169d-5fbf-3243-a90d-06f87bcd1aef",
                        "entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
                        "glosses": [
                            "waarneembaar in het algemeen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "046b255b-bbda-4029-8a06-1497cfb0eb05",
                                "sense_id": "be13169d-5fbf-3243-a90d-06f87bcd1aef",
                                "text": "In het voorstel staat ook dat telefoonnummers en e-mailadressen niet meer openbaar in het Handelsregister moeten komen te staan. Overigens blijven afgeschermde gegevens wel zichtbaar voor overheidsinstanties en beroepsgroepen met een wettelijke toestemming, zoals de Belastingdienst en deurwaarders. Daardoor blijven bepaalde gegevens controleerbaar en komt de rechtszekerheid niet in het geding, schrijft de minister."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe52dfb1-390f-403f-aaa3-0edb76d39b24",
                        "source_entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
                        "target_lang_word": "sichtbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sichtbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                        "entry_id": "9e68b48d-cb22-3b3f-a236-6687921c1db8",
                                        "glosses": [
                                            "dem Sehen zugänglich, mit den Augen wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85ab04ac-964a-4b10-a7d8-006f6def3f38",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "Milben sind so klein, dass sie für das menschliche Auge nicht sichtbar sind."
                                            },
                                            {
                                                "example_id": "8cc2b96b-f250-493d-878a-8fc6f9d5843b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Die Beobachtungen unterstützen die Theorie, wonach der Großteil des Universums aus unsichtbarer dunkler Materie besteht, die durch Beobachtung ihrer Gravitationskraft auf sichtbare Materie entdeckt wurde.“"
                                            },
                                            {
                                                "example_id": "d2caf792-ad4c-43ef-87cb-b0d124848ad2",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Was in den zurückliegenden schönen Herbstwochen dazu führte, dass China in Xianyang seinen sichtbarsten Arbeiterausstand seit Jahren erlebte.“"
                                            },
                                            {
                                                "example_id": "ce18ee3d-94bc-4716-a339-10802df1562b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Und zwar immer dann, wenn Experten und Medien auf die sichtbarsten Schwächen der Berufsausbildung hinweisen: Zum Beispiel fehlende Lehrstellen in Ballungsgebieten und fehlende Bewerber im Osten.“"
                                            },
                                            {
                                                "example_id": "d30d1701-1b5a-441b-9674-31c23aa72a9b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc628c30-34aa-4f51-ac97-435785253d47",
                        "source_entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
