                    },
                    {
                        "translation_id": "fe8f3e38-02a0-4c0d-af67-ecce0bd0a673",
                        "source_entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                        "source_sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
