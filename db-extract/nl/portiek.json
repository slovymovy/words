                    }
                ],
                "translations": [
                    {
                        "translation_id": "30478741-4d32-4653-b0c3-48c0db92ee0f",
                        "source_entry_id": "b9498337-7b43-396c-bab0-79e796f358fd",
                        "source_sense_id": "ff8c4b30-61d6-3bb5-b292-9e843296b3f3",
                        "source_sense_description": "woningingang bestaande uit een open portaal binnen de voorgevellijn",
                        "target_lang_word": "porch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A covered entrance to a building, whether taken from the interior, and forming a sort of vestibule within the main wall, or projecting without and with a separate roof. A porch often has chair(s), table(s) and swings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd83e935-f280-4556-bc92-8ac38c713c95",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "He sat on his porch, waiting for his friend to come over."
                                            },
                                            {
                                                "example_id": "b4427204-bd67-4105-8e0b-abacba4479e0",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "But Miss Thorn relieved the situation by laughing aloud,[…]. We began to tell her about Mohair and the cotillon, and of our point of observation from the Florentine galleried porch, and she insisted she would join us there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84535f0e-a39c-3050-a918-08f7e8143f31",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A portico; a covered walk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "The platform outside the external hatch of a spacecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1110cd98-0ed3-45f4-ada1-cfe40857f0a6",
                                                "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                                "text": "By the time he had put on the backpack, McDivitt was ready to let him do more—to stand on the porch at least."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29ab424b-174f-4493-85b6-463652283bef",
                        "source_entry_id": "b9498337-7b43-396c-bab0-79e796f358fd",
                        "source_sense_id": "ff8c4b30-61d6-3bb5-b292-9e843296b3f3",
                        "source_sense_description": "woningingang bestaande uit een open portaal binnen de voorgevellijn",
                        "target_lang_word": "porche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                                        "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                                        "glosses": [
                                            "Portique, lieu couvert à l’entrée d’un temple, d’une église, ou même d’un palais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff297353-d017-4672-afd2-2dff7848e8cd",
                                                "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                                                "text": "Un soir, sous le porche de Saint-Benoît-le-Bétourné, qui est garni de bancs de pierre, elle m’apprit ce que je ne savais pas encore et qu’elle savait depuis longtemps."
                                            },
                                            {
                                                "example_id": "004d255d-29a3-4023-8952-c8dbfa2502fa",
                                                "sense_id": "2d1e57c9-899a-312c-973b-2d358e89c252",
                                                "text": "Des porches cintrés s'exhale parfois une odeur enivrante; […], et l'on surprend souvent dans l'air, le puissant arôme des distillations qui s'opèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                                        "entry_id": "c5293877-da1b-3762-a81e-5352d944275a",
                                        "glosses": [
                                            "Construction abritant une porte d'entrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5989483e-2426-4bf9-9865-334d0c4e0190",
                                                "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                                                "text": "La voiture passa devant la grande porte de la cour de la ferme, continua son chemin le long d’une épaisse charmille et s’arrêta en face d’un petit porche de bois rustique à demi caché sous un vigoureux cep de vigne aux feuilles empourprées par l’automne."
                                            },
                                            {
                                                "example_id": "10268da1-ba7b-4070-8f12-c5cc5b446bde",
                                                "sense_id": "578331f8-00a4-3727-997a-b2485f3827ab",
                                                "text": "Sous le porche, un boueux attendait l'arrivée de la voiture en songeant que, par un temps pareil, elle ne viendrait sans doute pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
