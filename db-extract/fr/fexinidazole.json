                "senses": [
                    {
                        "sense_id": "54ee28e7-97fe-3c16-a379-59f9462c313a",
                        "entry_id": "5756c4b2-43cf-3323-94ee-cd077140bcd7",
                        "glosses": [
                            "Médicament prometteur pour le traitement de la maladie du sommeil (Trypanosomiase Humaine Africaine), maladie mortelle qui menace 60 millions de personnes en Afrique subsaharienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f638c127-d806-4479-a265-a678c25ecdcb",
                                "sense_id": "54ee28e7-97fe-3c16-a379-59f9462c313a",
                                "text": "Le fexinidazole doit changer la dynamique de la prise en charge de cette pathologie transmise par la mouche tsé-tsé. II suffira d’avaler une dose une fois par jour pendant dix jours, alors qu’actuellement des injections complexes à mettre en œuvre sont nécessaires."
                            },
                            {
                                "example_id": "e49ebdd1-501e-4f88-ad11-3282ddc8547a",
                                "sense_id": "54ee28e7-97fe-3c16-a379-59f9462c313a",
                                "text": "Au terme de plus de deux années de recherche sur plusieurs molécules issues de la famille des nitroimidazoles, DNDi (la fondation Drugs for Neglected Diseases initiative) a confirmé que l’une d’entre elles, le fexinidazole pouvait constituer un médicament candidat prometteur contre la maladie du sommeil."
                            },
                            {
                                "example_id": "72fcd289-4e99-4826-ab0b-277a86546748",
                                "sense_id": "54ee28e7-97fe-3c16-a379-59f9462c313a",
                                "text": "Nous avons un accord avec Novartis pour développer un candidat pour la maladie du sommeil en cas d’échec du fexinidazole."
                            }
                        ]
                    }
