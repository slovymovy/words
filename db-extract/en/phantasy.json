        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5b696dcc-af20-320b-964e-40255995df48",
                "word": "phantasy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "99a9446d-c1b6-43ac-a8ee-b604febf66f9",
                        "entry_id": "5b696dcc-af20-320b-964e-40255995df48",
                        "tags": [
                            "plural"
                        ],
                        "form": "phantasies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe8a9c9a-d20b-3dfc-aa49-9e65e15f4ac4",
                        "entry_id": "5b696dcc-af20-320b-964e-40255995df48",
                        "glosses": [
                            "Archaic spelling of fantasy."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f404bb0a-51a6-4e85-bb55-ec6bec03a483",
                                "sense_id": "fe8a9c9a-d20b-3dfc-aa49-9e65e15f4ac4",
                                "text": "What generous self-sacrifice—what a world of gentle affection, were now called forth in Emily by a moment's phantasy, whose life depended on that frailest of frail things, a coquette's vanity!"
                            },
                            {
                                "example_id": "7f52693c-aa8a-42f7-97f3-620b1e6e228c",
                                "sense_id": "fe8a9c9a-d20b-3dfc-aa49-9e65e15f4ac4",
                                "text": "Yet his passion for her had grown fiercer than ever, and he swore to himself that he would win her back from her phantasies."
                            },
                            {
                                "example_id": "90a5f45f-f3ca-4c40-bfcf-eb70945566a6",
                                "sense_id": "fe8a9c9a-d20b-3dfc-aa49-9e65e15f4ac4",
                                "text": "[…] what man has hitherto known only in febrile phantasy and tenuous legend?"
                            }
                        ]
                    },
                    {
                        "sense_id": "dedb2db4-fe2d-3732-98e5-2789d8dc6cf9",
                        "entry_id": "5b696dcc-af20-320b-964e-40255995df48",
                        "glosses": [
                            "The innate, mental image of an object; the link between instinct and reality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "58bf9ef9-b4e1-4b91-b26e-c3af4aa9545b",
                                "sense_id": "dedb2db4-fe2d-3732-98e5-2789d8dc6cf9",
                                "text": "By later Kleinians and critics alike, phantasy is often seen as identical to Freud's concept of psychic reality."
                            },
                            {
                                "example_id": "f11e0a38-2c63-4662-8404-b1b9f311502c",
                                "sense_id": "dedb2db4-fe2d-3732-98e5-2789d8dc6cf9",
                                "text": "However, Klein's phantasy is not exactly Lacan's imaginary fantasy; it is, I think, more than that."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
