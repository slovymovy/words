                ],
                "senses": [
                    {
                        "sense_id": "26ea6d94-114a-3719-be8c-4a0597719ebc",
                        "entry_id": "bbbe9d70-4e36-3b25-9133-c2342e4051bc",
                        "glosses": [
                            "Variante de shako."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "55167668-e12b-4f98-84ac-872452ea4c33",
                                "sense_id": "26ea6d94-114a-3719-be8c-4a0597719ebc",
                                "text": "Elle n’est pas trop en arrière ? cela aurait l’air un peu niais; mais il ne faut pas non plus la porter baissée sur les yeux comme un schako d’officier."
                            },
                            {
                                "example_id": "2e6446ac-a4f9-4e65-b66b-467322de5fbd",
                                "sense_id": "26ea6d94-114a-3719-be8c-4a0597719ebc",
                                "text": "J’ai vu le schako du soldat […]"
                            },
                            {
                                "example_id": "da5432f9-69af-4034-adef-7a3275018fce",
                                "sense_id": "26ea6d94-114a-3719-be8c-4a0597719ebc",
                                "text": "Ses broderies pétillaient si vivement au soleil, et l'aigrette de son schako étroit et long en recevait de si fortes lueurs, que les spectateurs durent le comparer à un feu follet, […]."
                            },
                            {
                                "example_id": "3d1b7265-6188-43c2-b78d-66c7aa542aa6",
                                "sense_id": "26ea6d94-114a-3719-be8c-4a0597719ebc",
                                "text": "Il avait son magnifique uniforme, de canonnier, son schako, les canons de cuivre en croix sur le devant et le panache rouge au-dessus, ce qui lui donnait un air superbe."
                            }
                        ]
                    }
                ],
