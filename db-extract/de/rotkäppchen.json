                                        "sense_id": "e673a9be-5510-33bf-b7f8-c89019db9a9e",
                                        "entry_id": "2eae8651-6d6e-3d85-8081-7bdffed9edd5",
                                        "glosses": [
                                            "Personne caractérisée par la tenue vestimentaire prêtée au Petit Chaperon rouge, ou bien caractérisée par sa personnalité décrite dans le conte, principalement son insouciance et sa crédulité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d87825a-4a07-4f79-aebe-4a6eceb5192c",
                                                "sense_id": "e673a9be-5510-33bf-b7f8-c89019db9a9e",
                                                "text": "Et pour vous garantir de l’humidité des soirs,\nOn vous fait envelopper d’une couverture de laine\nD’un rouge éclatant, en sorte\nQue les dames sont toutes des petits Chaperons rouges."
                                            }
                                        ]
