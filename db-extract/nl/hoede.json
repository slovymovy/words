                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92d253e2-6ec4-3931-b0df-06a435f97847",
                        "entry_id": "d48337a4-6837-3332-8a6c-b33dfeaa2a78",
                        "glosses": [
                            "waakzaamheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4208017-835a-4bd3-a5c8-9a7a706ff83b",
                                "sense_id": "92d253e2-6ec4-3931-b0df-06a435f97847",
                                "text": "'Wie bent u?' vroeg ze, op haar hoede als een kat."
                            },
                            {
                                "example_id": "5dfac420-e370-4fce-8dea-b6759feea634",
                                "sense_id": "92d253e2-6ec4-3931-b0df-06a435f97847",
                                "text": "Op zijn hoede wachtte hij op haar, terwijl zij stopte om op adem te komen."
                            },
                            {
                                "example_id": "6e8dd0ab-32a5-40c5-b7c2-3b3e44425470",
                                "sense_id": "92d253e2-6ec4-3931-b0df-06a435f97847",
                                "text": "Ondanks al mijn gesprekken met je ben ik waarschijnlijk nog meer op mijn hoede dan jij."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0f9cd4c-aeda-3f6a-a94e-484a933c018e",
                        "entry_id": "d48337a4-6837-3332-8a6c-b33dfeaa2a78",
                        "glosses": [
                            "bewaking, bescherming, bewaring, zorg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db6982e-d62e-49f5-94ef-554faaf9b1de",
                                "sense_id": "f0f9cd4c-aeda-3f6a-a94e-484a933c018e",
                                "text": "' 'U hebt ook een zwarte in dienst genomen, nietwaar?' 'Hij komt uit Porto-Novo, in Dahomey ' 'U hebt hem onder uw hoede genomen en hem onze gebruiken geleerd."
                            },
                            {
                                "example_id": "7ac294f7-75f9-4970-bcd9-748dab0c20d5",
                                "sense_id": "f0f9cd4c-aeda-3f6a-a94e-484a933c018e",
                                "text": "Waarom zou ze ook, als ze er geen been in zag om haar eigen moeder te laten verdrinken en daar nooit over te praten, en haar eigen zusje - een kind nog! - achter te laten bij een of andere koeienhoeder? Ik zou Arabella onder mijn hoede hebben genomen, houdt Thea zichzelf voor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f5580c8-f006-4a0d-b42e-df1641965a0e",
                        "source_entry_id": "d48337a4-6837-3332-8a6c-b33dfeaa2a78",
                        "target_lang_word": "guard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A person who, or thing that, protects or watches over something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3e50fc-e601-456d-8c86-e33d52956ff6",
                                                "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                                "text": "The prison guard unlocked the door of the cell. After completing the repairs, he replaced the sump guard."
                                            },
                                            {
                                                "example_id": "0359c61e-6ca4-4076-b061-505e3bf1ffc2",
                                                "sense_id": "b65c034f-1f03-3e73-9eaf-e8d0205d2994",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a60cac-32c7-3ee4-93a4-e403a554d537",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A garda; a police officer."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8965f02a-f295-4327-8aaa-f81d1750588a",
                                                "sense_id": "a9a60cac-32c7-3ee4-93a4-e403a554d537",
                                                "text": "The Garda Regulations 1924 required a candidate for appointment as a guard to be able to produce satisfactory references as to his character"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f24be898-5b39-3056-8972-d4e5c9b8aa76",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A squad responsible for protecting something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a362b8b4-86b4-4857-97be-ca26ac3be2e7",
                                                "sense_id": "f24be898-5b39-3056-8972-d4e5c9b8aa76",
                                                "text": "The president inspected the guard of honour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789087f8-0f21-3628-8a89-85c89e78f582",
                                        "entry_id": "9451d927-2aa3-3783-b347-b10c3b2f1aa7",
                                        "glosses": [
                                            "A squad responsible for protecting something.",
                                            "An elite military unit in Russia, the former Soviet Union and several post-Soviet countries."
                                        ],
