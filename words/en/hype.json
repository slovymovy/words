{
    "word_family": [
        "overhype",
        "hypeman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97d416a7-ec25-33e2-8703-eb80e71a9e5d",
                    "sense_definition": "Promotion or propaganda, especially exaggerated claims.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "promotion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie did not live up to the <w>hype</w> generated by the media.",
                            "target_lang_translations": {
                                "ru": "Фильм не оправдал <w>шумихи</w>, поднятой в СМИ.",
                                "zh": "这部电影没有达到媒体制造的<w>炒作</w>所带来的期待。",
                                "es": "La película no estuvo a la altura del <w>bombo</w> generado por los medios."
                            }
                        },
                        {
                            "text": "Don't believe the <w>hype</w> about this new diet plan.",
                            "target_lang_translations": {
                                "ru": "Не верьте <w>хайпу</w> вокруг этой новой диеты.",
                                "zh": "别相信围绕这个新减肥计划的<w>吹捧</w>。",
                                "es": "No te creas el <w>bombo</w> sobre este nuevo plan de dieta."
                            }
                        }
                    ],
                    "synonyms": [
                        "publicity",
                        "promotion",
                        "buildup"
                    ],
                    "common_phrases": [
                        "media hype",
                        "live up to the hype",
                        "believe the hype"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агрессивная реклама, шумиха или ажиотаж, часто с преувеличением достоинств.",
                        "zh": "宣传或鼓吹，尤指带有夸大成分的炒作。",
                        "es": "Promoción o publicidad exagerada, a menudo con el fin de crear expectativas artificiales."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шумиха",
                                "target_lang_sense_clarification": "громкое обсуждение, часто раздутое искусственно"
                            },
                            {
                                "target_lang_word": "хайп",
                                "target_lang_sense_clarification": "модный сленг: ажиотаж вокруг чего-либо"
                            },
                            {
                                "target_lang_word": "ажиотаж",
                                "target_lang_sense_clarification": "сильное возбуждение, волнение вокруг события"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炒作",
                                "target_lang_sense_clarification": "媒体或公众刻意制造的热度，常带夸大意味"
                            },
                            {
                                "target_lang_word": "吹捧",
                                "target_lang_sense_clarification": "过度宣传、吹得很厉害"
                            },
                            {
                                "target_lang_word": "造势",
                                "target_lang_sense_clarification": "热闹而夸张的宣传声势"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "bombo",
                                "target_lang_sense_clarification": "Publicidad exagerada y con grandes elogios."
                            },
                            {
                                "target_lang_word": "expectativa artificial",
                                "target_lang_sense_clarification": "Interés creado de forma exagerada."
                            },
                            {
                                "target_lang_word": "propaganda exagerada",
                                "target_lang_sense_clarification": "Promoción que excede la realidad."
                            }
                        ]
                    }
                },
