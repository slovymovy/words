                        "entry_id": "b020bff9-3012-36ca-bbae-a90e67afe467",
                        "glosses": [
                            "mit Propan- oder Butangas betriebener Brenner, dessen Flamme für großflächige Lötungen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a95083c-8f03-4410-b782-e72715977da5",
                                "sense_id": "3d1ac305-9470-334b-92c0-75f4a8a21447",
                                "text": "Die Crème-brûlée wird mit braunem Zucker bestreut und zügig mit einer Lötlampe, oder Brenner, goldbraun karamellisiert."
                            },
                            {
                                "example_id": "27c5180d-ede9-4372-8346-56370f74d2e3",
                                "sense_id": "3d1ac305-9470-334b-92c0-75f4a8a21447",
                                "text": "„Es ist ein zärtliches Ritual, wenn Maxim seinen Wagen für den Start vorbereitet. Erst zündet er die Lötlampe an und wärmt mit ihr den Motorblock von unten an…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
