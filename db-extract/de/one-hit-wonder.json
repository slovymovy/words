                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-hit wonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77b28ad1-7d77-36c2-a4d1-add7f24da4e0",
                                        "entry_id": "72d127d5-037d-3124-8a47-34ba1af6c2cf",
                                        "glosses": [
                                            "A recording artist known for only one hit song, especially after failing at subsequent attempts at success."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4220f8da-e89d-4b10-991c-ec1fbf8bc4ac",
                                                "sense_id": "77b28ad1-7d77-36c2-a4d1-add7f24da4e0",
                                                "text": "Eleven years ago, Arrested Development became one of Southern hip-hop's first crossover successes with “Tennessee,” a wistful, bohemian-influenced song about the scars of history. But the group was a one-hit wonder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464e8c32-3951-3eb4-b096-fc9fff6d4c1f",
                                        "entry_id": "72d127d5-037d-3124-8a47-34ba1af6c2cf",
                                        "glosses": [
                                            "A person or group known for achieving only a single major accomplishment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "008a6183-5221-4285-b5c6-9d60d9c6b476",
                                                "sense_id": "464e8c32-3951-3eb4-b096-fc9fff6d4c1f",
                                                "text": "The European company is no one-hit wonder. The company has another best seller in its J-class car, sold as a Vauxhall Cavalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7290c1a5-fcee-3204-9025-056d77bba327",
                                        "entry_id": "72d127d5-037d-3124-8a47-34ba1af6c2cf",
                                        "glosses": [
                                            "An instance of achieving a high from the first hit."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
