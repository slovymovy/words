                "senses": [
                    {
                        "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                        "entry_id": "24eaa351-b585-3a16-a96a-d7c11fe3a41b",
                        "glosses": [
                            "auf Verhinderung anstrebende Einstellung"
                        ],
                        "tags": [
                            "Verhalten"
                        ],
                        "examples": [
                            {
                                "example_id": "88120b33-3b4d-46fe-8938-d3c605456fcb",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„Bereits 2020 und 2021 war eine Akkreditierung der Wikimedia Foundation mit Sitz in San Francisco als WIPO-Beobachterorganisation an der Blockadehaltung Chinas gescheitert.“"
                            },
                            {
                                "example_id": "f67a977c-ab46-4153-b0e0-286719fb8204",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„›Die erneute Blockadehaltung Deutschlands beim EU-Lieferkettengesetz heute ist ein Schlag ins Gesicht der Betroffenen von Menschrechtsverletzungen durch Unternehmen weltweit. […]‹“"
                            },
                            {
                                "example_id": "7b596c3e-271e-40d0-ba9e-f464417af6af",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„Der Minister warf Union und FDP eine Blockadehaltung vor, die eine Gleichbehandlung verhindere und zu einer Zweiklassenmedizin geführt habe, die beendet werden müsse.“"
                            },
                            {
                                "example_id": "9ee1538a-7114-4623-8d8b-12994175d2e4",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„[…] Präsidentin des Sozialverbands VdK, übte am Wochenende scharfe Kritik an der Blockadehaltung der FDP und deren Sparpolitik.“"
                            },
                            {
                                "example_id": "b1f906b1-c24c-4906-8a58-490d93495dab",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„Nimmt beispielweise ein Gesellschafter eine Blockadehaltung ein, indem er sinnvolle Beschlüsse blockiert, so kann ein Stimmrechtsmissbrauch vorliegen.“"
                            },
                            {
                                "example_id": "4c695fd7-3549-48da-8a38-08306d437145",
                                "sense_id": "0afd0844-3c5f-3e7c-a943-994503ec1fc2",
                                "text": "„Die Deutsche Bahn (DB) hat ihre Blockadehaltung aufgegeben und Verhandlungsbereitschaft für die Kernforderungen der GDL schriftlich vereinbart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
