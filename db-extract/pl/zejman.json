                ],
                "translations": [
                    {
                        "translation_id": "f5999359-53c3-47bd-b34d-30c82c306564",
                        "source_entry_id": "3889a05b-6693-3f54-95b4-445d92117e4e",
                        "source_sense_id": "7381ec64-d53f-3c2a-9aff-860515d2554d",
                        "target_lang_word": "seaman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61dc017c-d456-3b0e-870c-27d6ca117e75",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "Synonym of sailor, particularly on a maritime vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62e9762-980c-42e1-b1ba-6a100325ca78",
                                                "sense_id": "61dc017c-d456-3b0e-870c-27d6ca117e75",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa07803-d63d-344d-ab72-59d2195557e3",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "A person of the lowest rank in the Navy, below able seaman."
                                        ],
                                        "tags": [
                                            "British",
                                            "Navy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "021ebbf6-c5dd-3355-ae57-575e82be5def",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "An enlisted rate in the United States Navy and United States Coast Guard, ranking below petty officer third class and above seaman apprentice."
                                        ],
                                        "tags": [
                                            "Navy",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3db751fd-f829-3f36-9b74-9e2e514cc1b4",
                                        "entry_id": "6f0c9922-0718-386a-8495-225e2c460323",
                                        "glosses": [
                                            "A merman; the male of the mermaid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75a0f4b-fd35-4085-b1ca-e2f0a59d8d98",
                                                "sense_id": "3db751fd-f829-3f36-9b74-9e2e514cc1b4",
                                                "text": ", Book III\nnot to mention what is confidently reported of mermaids, or sea-men"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f154afdc-12ec-4c9e-bb2f-e7e267130ae4",
                        "source_entry_id": "3889a05b-6693-3f54-95b4-445d92117e4e",
                        "source_sense_id": "7381ec64-d53f-3c2a-9aff-860515d2554d",
                        "target_lang_word": "zeeman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeeman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd82272-e974-3b46-9115-ee4d63887d65",
                                        "entry_id": "6f6d2376-97e6-3c2e-92c0-e83afbca409d",
