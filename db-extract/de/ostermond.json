                "senses": [
                    {
                        "sense_id": "739d5337-d2c7-3330-a241-0dc73c1b4858",
                        "entry_id": "cf98aa8f-ee57-3b18-afb7-ac6cceb9cdb4",
                        "glosses": [
                            "der vierte Monat des Jahres"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "9f5b7377-e51c-4945-a551-b56b762d83e4",
                                "sense_id": "739d5337-d2c7-3330-a241-0dc73c1b4858",
                                "text": "Im Ostermond feiert man fast jedes Jahr das Osterfest."
