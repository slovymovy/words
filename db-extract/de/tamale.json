                        "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                        "entry_id": "d3cf0779-a7d2-3c21-a010-0087aeb7e5f4",
                        "glosses": [
                            "aus Maismehl gebackener Fladen"
                        ],
                        "tags": [
                            "Mexiko und Mittelamerika"
                        ],
                        "examples": [
                            {
                                "example_id": "f983db38-3290-48e2-b1a2-11cce8d8073c",
                                "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                                "text": "„Sofort standen sie von ihrem Außentisch in einem Café auf, warfen mit Tamale getränkte Pappteller in den Müll, gingen in den Juwelierladen auf der anderen Straßenseite und erschossen den Mann, den sie verfolgt hatten, zusammen mit seiner Frau und zwei Leibwächtern.“"
                            },
                            {
                                "example_id": "1ab78ab2-d514-48fc-b71c-124a694f46f3",
                                "sense_id": "804b92e9-ba62-3668-bc0b-b8f7052860b1",
                                "text": "„Die Tamales waren mit dekorativen Mustern verziert wie etwa einer Muschel, umrahmt von roten Bohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
