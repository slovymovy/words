                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf81522-7aac-409b-8304-9218c09ae457",
                                "sense_id": "6938e252-b579-374e-ac93-0614abc1abb7",
                                "text": "„Auf den ersten Blick schien es ein typischer Hostessenclub zu sein mit gedämpftem Licht, künstlichen Topfpflanzen, Samtsofas und Tischen sowie Kristallkaraffen mit Whiskey und Wasser.“"
                            },
                            {
                                "example_id": "455694eb-1076-49bf-8feb-2fed9b840132",
                                "sense_id": "6938e252-b579-374e-ac93-0614abc1abb7",
                                "text": "„In Zimmern jeder Größe standen funkelnde Kristallkaraffen auf Silbertabletts und enthielten Fusel, ausgezeichneten Fusel, und Jamal goss sich ein Glas ein und trank davon, während er seinen neuen Besitz inspizierte.“"
                            },
                            {
                                "example_id": "7acefcbb-67fa-4873-b5b6-f6dd72ab9967",
                                "sense_id": "6938e252-b579-374e-ac93-0614abc1abb7",
                                "text": "„Boonstra legte das Dokument auf den Schreibtisch, ging zur Hausbar, zog den Stopfen aus einer Kristallkaraffe und schenkte dunklen Sherry in zwei Gläser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
