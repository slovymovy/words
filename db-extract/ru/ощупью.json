                "translations": [
                    {
                        "translation_id": "4e9524de-f10a-4663-93db-630ca940ffe7",
                        "source_entry_id": "4eeb6c29-4155-36b5-99b8-67516020f349",
                        "target_lang_word": "gropingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gropingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a28352da-311b-3009-b2bb-b02861f4cfe4",
                                        "entry_id": "dfdae3e6-009b-38a9-ae13-b10359b46db2",
                                        "glosses": [
                                            "In a groping manner; blindly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ece09d-41e0-4bfc-860a-67379f76e10e",
                                                "sense_id": "a28352da-311b-3009-b2bb-b02861f4cfe4",
                                                "text": "[…] all other sects of Philosophers, have but like men in Cimmerian darkenesse, gropingly stumbled, now and then, upon the nature of the true God-head […]"
                                            },
                                            {
                                                "example_id": "30900feb-f365-437f-9796-ebf94336de37",
                                                "sense_id": "a28352da-311b-3009-b2bb-b02861f4cfe4",
                                                "text": "1881, Gerard Manley Hopkins, Letter to Robert Bridges dated 27 April, 1881 in Claude Colleer Abbott (editor), Letters of Gerard Manley Hopkins to Robert Bridges, Oxford University Press, 1935, p. 125,\nI am gropingly making my way into harmony and may come to harmonise some of my airs."
                                            },
                                            {
                                                "example_id": "6a5367cf-b703-486a-9f0e-8c421d4fb2d4",
                                                "sense_id": "a28352da-311b-3009-b2bb-b02861f4cfe4",
                                                "text": "With the impetus of his rush the man drove straight on, his face suddenly gaping disfigured, with his hands open before him gropingly, as though blinded, and landed with terrific violence on his forehead, just short of Jim’s bare toes."
                                            },
                                            {
                                                "example_id": "be4027de-1577-4615-8ef2-2c097422a31c",
                                                "sense_id": "a28352da-311b-3009-b2bb-b02861f4cfe4",
                                                "text": "Toward the end of the year Greg, normally a sound sleeper, started to sleep poorly, to get up in the middle of the night and wander gropingly for hours around his room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad676219-b076-4457-8e2b-49b2f7c6690f",
                        "source_entry_id": "4eeb6c29-4155-36b5-99b8-67516020f349",
                        "target_lang_word": "by feel",
                        "target_lang_code": "en",
