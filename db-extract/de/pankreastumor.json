                ],
                "senses": [
                    {
                        "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                        "entry_id": "561d76b4-5568-3ef1-bc51-6feb4a1e3796",
                        "glosses": [
                            "ein Tumor der Bauchspeicheldrüse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cecef840-1e74-48ae-b024-353ff615605f",
                                "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                                "text": "„Die Behandlung von Pankreastumoren erfolgt individuell und ist unter anderem abhängig von Art, Lage, Größe und Ausbreitung der Tumoren, aber auch von der Konstitution des Patienten und seinen zusätzlichen Erkrankungen.“"
                            },
                            {
                                "example_id": "bb7ae0e0-4a14-4fb5-bf6b-a22c8a9b809f",
                                "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                                "text": "„Somit unterscheidet man auch den Pankreastumor in exokrine oder endokrine Tumoren.“"
                            },
                            {
                                "example_id": "4d39f5e7-8e9d-4507-811d-20f14daf4576",
                                "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                                "text": "„Ein exokriner Pankreastumor macht vor allem Beschwerden, wenn er benachbarte Organe wie zum Beispiel Magen, Zwölffingerdarm, Bauchfell oder Milz verdrängt oder in sie hineinwächst und so ihre Funktion stört.“"
                            },
                            {
                                "example_id": "77307401-4023-4cb3-afc1-2bef87e4f66e",
                                "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                                "text": "„Pankreastumoren werden nach der Verwandtschaft zum normalen Gewebe und nach dem Grad der Bösartigkeit eingeteilt.“"
                            },
                            {
                                "example_id": "b11d1568-0c49-4f70-941e-cf98217a3c6a",
                                "sense_id": "d6d7990e-5a4b-38c2-870b-f77e77d7b613",
                                "text": "„Diese Therapie besteht wie bei den anderen Pankreastumoren in der kompletten Entfernung des Tumors.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
