                "senses": [
                    {
                        "sense_id": "565ac36a-135d-3d78-82a3-60367608e625",
                        "entry_id": "3f033650-2352-3e15-b0fe-cd1171af00e8",
                        "glosses": [
                            "Schule, die von einer Missionsstation betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15a40c00-4fd0-4f45-879d-0abcf120e30f",
                                "sense_id": "565ac36a-135d-3d78-82a3-60367608e625",
                                "text": "„Diese Männer entstammen der winzigen schwarzen Mittelschicht, die sich in den Städten herausgebildet hatte, wurden oft in christlichen Missionsschulen unterrichtet und gründen nun mehrere politische Vereine, deren wichtigster bald die Kenya African Union wird.“"
                            },
                            {
                                "example_id": "d2910487-4e1f-4340-b6c4-13d8bb90012a",
                                "sense_id": "565ac36a-135d-3d78-82a3-60367608e625",
                                "text": "„Meetom, der als Schüler einer Missionsschule Englisch gelernt hatte, war als Vermittler zwischen den Deutschen und der Bevölkerung des Küstengebiets eine Schlüsselfigur.“"
                            },
                            {
                                "example_id": "8dab8c8d-858f-4886-85a5-bd3a6f534ba2",
                                "sense_id": "565ac36a-135d-3d78-82a3-60367608e625",
                                "text": "„Er wurde in der Missionsschule der Jesuiten im heimischen Kutama eingeschult.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e17738ef-9b05-3409-a66f-1cc5cc97f3c5",
                        "entry_id": "3f033650-2352-3e15-b0fe-cd1171af00e8",
                        "glosses": [
                            "Ausbildungseinrichtung für Personen, die später den Glauben verbreiten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac45141-63d5-431b-92a1-5e194b47567a",
                                "sense_id": "e17738ef-9b05-3409-a66f-1cc5cc97f3c5",
                                "text": "„Hier kannst du nachlesen, welche Voraussetzungen für eine Bewerbung an der Missionsschule notwendig sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
