                "senses": [
                    {
                        "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                        "entry_id": "18c59257-192c-3489-8e94-e6c15347d012",
                        "glosses": [
                            "farblose Körperflüssigkeit, die im Gewebe vorkommt, das Gehirn und Rückenmark aller Wirbeltiere einschließlich des Menschen umschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668d404e-5f14-4086-b797-dd0221d1ce4c",
                                "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                                "text": "„So haben wir 20 ccm Zisternenflüssigkeit auf 1 ccm eingeengt und davon zweimal hintereinander je 0,15 ccm injiziert, so daß dadurch der Hormonnachweis in 6 ccm Zisternenflüssigkeit möglich war.“"
                            },
                            {
                                "example_id": "b7baea4e-7695-41fc-90db-179cfa34cbe9",
                                "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                                "text": "„Nur durch stundenlange Aufregungen der Hunde mit Vorzeigen von Katzen gelang es Hoff und Werner, eine beträchtliche Vermehrung des Gehaltes der Zisternenflüssigkeit an Oxytocin nachzuweisen.“"
                            },
                            {
                                "example_id": "2f280d14-d8d9-440a-88cf-844ce225ec1d",
                                "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                                "text": "„Gleichzeitig wurde in der Zisternenflüssigkeit die Durchlässigkeitssteigerung der Blut - Hirn - Schranke mittels Albumin 131 J gemessen und ein Anstieg zusammen mit dem Steigen von GOT und LDH festgestellt.“"
                            },
                            {
                                "example_id": "76d99450-9b90-4cbd-863a-6dcc6c852491",
                                "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                                "text": "„Mittels dieser Reaktion konnte auch gezeigt werden, daß diese Substanz in der Zisternenflüssigkeit reichlicher vorhanden ist als im Lumbalpunktat.“"
                            },
                            {
                                "example_id": "97804f78-f73f-4508-bd04-3addfcb1f2d9",
                                "sense_id": "b80951b4-6749-3f48-8af4-5516b17bd072",
                                "text": "„Bei zerebraler Lues gibt die Zisternenflüssigkeit keine nennenswerten Unterschiede gegenüber der Lumbalflüssigkeit, aber auch bei spinaler Lues sind die Unterschiede nicht von Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
