                "senses": [
                    {
                        "sense_id": "6e8f0de4-0ee6-3751-858a-7ea7c98d2aa1",
                        "entry_id": "99298592-aec3-3cf2-8b9c-b67dd859c442",
                        "glosses": [
                            "Considérer comme relevant de la maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97083370-b9e9-4f37-b11e-e55a725e2e72",
                                "sense_id": "6e8f0de4-0ee6-3751-858a-7ea7c98d2aa1",
                                "text": "Cf. les intérêts médicamenteux/pharmaceutiques qu'il y a à \"maladifier\" chaque état humain estampillé \"anormal\" pour mieux solutionner le problème par la vente du médoc \"miracle\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "3024bf82-5c52-3353-8bb7-4ba725894a39",
                        "entry_id": "99298592-aec3-3cf2-8b9c-b67dd859c442",
                        "glosses": [
                            "Considérer comme malade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bd3885-eeaf-40cc-9be5-87da3b83b9ed",
                                "sense_id": "3024bf82-5c52-3353-8bb7-4ba725894a39",
                                "text": "Aujourd'hui, mon jour de service de tranchée, j'ai eu la chance de remplacer le proto-chirurgien de l'ambulance, qui s'est laissé maladifier."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0e59292-ddab-301c-b223-b92b4a43152c",
                        "entry_id": "99298592-aec3-3cf2-8b9c-b67dd859c442",
                        "glosses": [
                            "Rendre malade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f4269f-6132-4cfc-b6e3-614d874a1f91",
                                "sense_id": "e0e59292-ddab-301c-b223-b92b4a43152c",
                                "text": "L'accélération du cycle du parasite n'est pas une bonne idée s'il n'y a pas de traitement dans l'eau, ça va maladifier les poissons plus vite"
                            },
                            {
                                "example_id": "36a45236-08c5-4f52-94f9-d28c74bc6540",
                                "sense_id": "e0e59292-ddab-301c-b223-b92b4a43152c",
                                "text": "Oui, je suis maladifié, confirma Oh."
                            }
                        ]
                    }
