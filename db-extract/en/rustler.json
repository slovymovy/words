                    {
                        "translation_id": "e982ab63-8bde-41a5-8f1c-f2fce6a7a297",
                        "source_entry_id": "5f608703-776f-33d4-bfe2-ba2766230cdc",
                        "source_sense_description": "cattle thief",
                        "target_lang_word": "конокра́д",
