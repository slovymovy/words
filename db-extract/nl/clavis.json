                    },
                    {
                        "sense_id": "9f2e28dd-12c3-3fdf-ade9-aa536a31071f",
                        "entry_id": "bdd2d8c5-672c-3592-b601-3b6cbe05899b",
                        "glosses": [
                            "met de voet bediende toets van een orgel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8c7e4e0-c3db-40a2-b477-704dc322a834",
                                "sense_id": "9f2e28dd-12c3-3fdf-ade9-aa536a31071f",
                                "text": "Het regeerwerk van het pedaal is meer een drukwerk dan een trekwerk te noemen, want in plaats dat er, als bij het manuaal, stiften op de toetsen staan, die met de abstracten verbonden zijn, bevindt zich hier onder elke clavis een steker, een dun houten staafje, aan beide einden van een stift voorzien, van welke de bovenste door den toets, de onderste door den eersten arm der onder hem liggende wel gaat; de clavis drukt nu den steker, de laatste weder de wel nederwaarts, en de tweede arm van de wel trekt nu de aan hem hangende abstract tot zich."
                            }
                        ]
                    }
