                        ]
                    },
                    {
                        "translation_id": "4a2e73c4-33cb-4032-a798-993dc36e2d34",
                        "source_entry_id": "f62180b1-ae08-34a6-abca-4f8b819bd5f3",
                        "source_sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                        "source_sense_description": "Person, die ein Boot rudert",
                        "target_lang_word": "гребец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гребец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "48f5a489-01b5-3da5-8347-355e77802f63",
                                        "entry_id": "4adabde6-e2ba-395a-9ed6-a79b9e13cbe0",
                                        "glosses": [
                                            "человек, гребущий на шлюпке веслом или гребком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c0a638-da1f-47c8-922a-45f7b35fe755",
                                                "sense_id": "48f5a489-01b5-3da5-8347-355e77802f63",
                                                "text": "Рулем управлял Его величество сам, а гребцы работали в гребле так сильно против беспрестанно ударяющихся волн, что ослабевать уже начали и потопления ожидали."
                                            },
                                            {
                                                "example_id": "aa55ae4c-4a48-4784-84b8-58e71c4466b4",
                                                "sense_id": "48f5a489-01b5-3da5-8347-355e77802f63",
                                                "text": "Двенадцать гребцов, в двадцать четыре весла, с песнями, понесли их по гладкому хребту зеркального озера."
                                            },
                                            {
                                                "example_id": "11533503-2fe7-46b1-8ed9-ad10d2ddcc38",
                                                "sense_id": "48f5a489-01b5-3da5-8347-355e77802f63",
                                                "text": "Другой гребец молча, проворно стал забирать веслом слева, потом ударили в два весла, и лодка быстро помчалась обратно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148d07f0-01d4-3e92-94db-f9a520f02f26",
                                        "entry_id": "4adabde6-e2ba-395a-9ed6-a79b9e13cbe0",
                                        "glosses": [
                                            "спорт. спортсмен, занимающийся гребным спортом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c97101a8-a92a-49f0-86b9-8c81a28a5d79",
                                                "sense_id": "148d07f0-01d4-3e92-94db-f9a520f02f26",
                                                "text": "Закончились продолжавшиеся несколько дней всесоюзные юношеские соревнования гребцов общества «Динамо»."
                                            },
                                            {
                                                "example_id": "f4185187-9b19-4026-8361-233859aebd65",
                                                "sense_id": "148d07f0-01d4-3e92-94db-f9a520f02f26",
                                                "text": "С большим интересом он писал полуобнаженные фигуры гребцов и борцов, показывал напряжение мышц, стремительное движение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a272333b-6fc8-3cfc-ab0b-86dabe34178d",
                                        "entry_id": "4adabde6-e2ba-395a-9ed6-a79b9e13cbe0",
                                        "glosses": [
                                            "рег. тот, кто сгребает сено на сенокосе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7190ee60-feb2-49e5-af52-0d07ffc8afab",
                                                "sense_id": "a272333b-6fc8-3cfc-ab0b-86dabe34178d",
                                                "text": "Они шли по большим и малым дорогам, с косой за плечами, парни и девки, нанимаясь по пути в косари и гребцы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
