                "senses": [
                    {
                        "sense_id": "c5448484-57ad-3ed0-bbc6-a689ef49a2c5",
                        "entry_id": "fbf99165-9eba-3dce-b694-c09bee64a9c8",
                        "glosses": [
                            "Se mettre en injection, en parlant d'un produit ; se faire une injection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1996210-91ff-4d02-b1e1-b8790f446b2d",
                                "sense_id": "c5448484-57ad-3ed0-bbc6-a689ef49a2c5",
                                "text": "Ce n'est pas parce qu'on s’habille en L.A. Gear et qu'on s’injecte de la silicone qu'on est plus porté sur le crime que le reste de la population."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d1ff629-9c05-3ecc-b60c-91a38683694b",
                        "entry_id": "fbf99165-9eba-3dce-b694-c09bee64a9c8",
                        "glosses": [
                            "Mettre en soi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8aeeb115-3304-4afd-8fa5-e1d37ba75124",
                                "sense_id": "6d1ff629-9c05-3ecc-b60c-91a38683694b",
                                "text": "Se souvenant de la fatigue qui l'avait assommée, pour ne point y succomber, elle s’injectait de la volonté. Toutefois, pour s’économiser, elle ralentit l'allure."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae977d7c-a2ab-3099-9a6b-991afa015d5d",
                        "entry_id": "fbf99165-9eba-3dce-b694-c09bee64a9c8",
                        "glosses": [
                            "Devenir injecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec5b4bbe-a929-4275-8aeb-4783fc123fed",
                                "sense_id": "ae977d7c-a2ab-3099-9a6b-991afa015d5d",
                                "text": "A travers son tissu parfaitement transparent , on peut voir le tissu lamineux subjacent ; il n'est ordinairement que médiocrement injecté; il s’injecte davantage si l'animal s'agite beaucoup et se livre à de violens efforts."
                            },
                            {
                                "example_id": "cac1206c-0735-4f66-85ae-bcf68113517c",
                                "sense_id": "ae977d7c-a2ab-3099-9a6b-991afa015d5d",
                                "text": "Au niveau du siège du dépôt tuberculeux, le périoste se détache de l'os , s’injecte , s’enflamme et fournit de l’exsudation plastique , qui peut s'organiser en substance osseuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa2152e4-f7c2-3b01-8176-2ec83369732b",
                        "entry_id": "fbf99165-9eba-3dce-b694-c09bee64a9c8",
                        "glosses": [
                            "Admettre une injection"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ecf6a0-0858-4348-b6b2-272fd66d363b",
                                "sense_id": "aa2152e4-f7c2-3b01-8176-2ec83369732b",
                                "text": "Puisque Z (infini) s'injecte dans Q via l’application φ : Z ——> Q, le corps Q sera infini."
                            }
                        ]
                    }
                ],
