                "senses": [
                    {
                        "sense_id": "1de08b71-89cd-3d1c-9f5d-9b1e20166395",
                        "entry_id": "72022228-8242-3114-973b-a5fb00a445c6",
                        "glosses": [
                            "Choisir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1bff93f-52b3-4539-b7ca-3168d0dd3733",
                                "sense_id": "1de08b71-89cd-3d1c-9f5d-9b1e20166395",
                                "text": "Alors, le Diable le fit rechoisir."
                            },
                            {
                                "example_id": "d0db81f5-bd76-4c81-bba3-4794d94deaa4",
                                "sense_id": "1de08b71-89cd-3d1c-9f5d-9b1e20166395",
                                "text": "Mais le Sultan me paye dans ma misère, et j'irai dans quelques mois en Orient y rechoisir un plus petit royaume et un modeste palais de bois."
                            },
                            {
                                "example_id": "54ef30ae-e169-425d-9b1f-d6f19c9a0368",
                                "sense_id": "1de08b71-89cd-3d1c-9f5d-9b1e20166395",
                                "text": "On dit bien que l'on épouse toujours un peu son père ou sa mère ou l'inverse, ce qui est une façon de les rechoisir."
                            }
                        ]
                    }
                ],
