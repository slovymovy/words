                    {
                        "sense_id": "3d4fffdf-db15-3da6-8930-66a62e45239b",
                        "entry_id": "f1783bae-0c61-3f64-a64d-1fbd92e33fc5",
                        "glosses": [
                            "Stadt im französischen Département Somme in der Picardie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280c8cfb-0acb-4210-9f27-ac2681803a20",
                                "sense_id": "3d4fffdf-db15-3da6-8930-66a62e45239b",
                                "text": "„Wir hingen sozusagen in der Luft. Eines Tages erhielt ich den Befehl, mich nach dem vier bis fünf Meilen entfernten Amiens zu begeben, festzustellen, ob die Stadt frei vom Feinde sei und mich über die sanitären Anstalten zu vergewissern, vor allem darüber, ob noch deutsche Verwundete dort seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
