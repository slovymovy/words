                        "cross_references": [
                            {
                                "target_word": "дюралюминий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f266cd8a-caa2-3623-a729-08745d07be5e",
                                        "entry_id": "b92a179f-3367-3aae-9694-745d7bc9eb1e",
                                        "glosses": [
                                            "лёгкий и прочный сплав алюминия с медью, магнием и некоторыми другими элементами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ce4c6e-a23d-42d8-8495-fe3eaf0ab173",
                                                "sense_id": "f266cd8a-caa2-3623-a729-08745d07be5e",
                                                "text": "Например, алюминий — очень лёгкий и мягкий металл. Но если его сплавить с ничтожными количествами меди, марганца и магния, то полученный сплав (дюралюминий) приобретает твёрдость стали, сохраняя при этом лёгкость алюминия. Благодаря именно этим качествам — лёгкости и твёрдости — дюралюминий широко применяется для строительства самолётов и дирижаблей."
                                            },
                                            {
                                                "example_id": "eb8ec882-bc27-4388-aae4-302ff8c4c804",
                                                "sense_id": "f266cd8a-caa2-3623-a729-08745d07be5e",
                                                "text": "Подковку делают из дюралюминия, она охватывает весь каблук и крепится к нему шурупами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
