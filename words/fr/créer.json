                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cosmologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon les textes sacrés, Dieu <w>créa</w> le monde en six jours."
                        },
                        {
                            "text": "Plusieurs mythologies racontent comment les dieux ont <w>créé</w> l'humanité."
