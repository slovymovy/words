                                                "example_id": "2a7d7a4f-bcc2-46b5-aa48-47da9fd4e455",
                                                "sense_id": "4530c8e3-b315-3f0f-b8ee-b853d945d584",
                                                "text": "No one, then or now, wanted to drink the mead that came out of Odin's arse."
                                            },
                                            {
