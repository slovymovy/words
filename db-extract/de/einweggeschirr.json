                "senses": [
                    {
                        "sense_id": "caf40a7e-9771-3c92-9625-e4e1cfd22a3f",
                        "entry_id": "789d2a71-2a11-34ee-89ae-f4f289f4c2dc",
                        "glosses": [
                            "Gesamtheit aller Werkzeuge und Gefäße, die beim Essen einmalig benötigt werden und dann Abfall sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7f578d-cd41-4d82-b9c8-ad69a2f66419",
                                "sense_id": "caf40a7e-9771-3c92-9625-e4e1cfd22a3f",
                                "text": "„Darf man in einem Büro bzw. in einer Firma oder einem Haushalt überhaupt mit Einweggeschirr hantieren, wenn gleichzeitig viel Wert auf Umweltschutzmaßnahmen wie etwa die Verwendung von Recyclingpapier gelegt wird? Die Antworten auf solche Fragen können schon mal etwas komplizierter sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
