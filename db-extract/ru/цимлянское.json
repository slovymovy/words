                "senses": [
                    {
                        "sense_id": "02223f6f-ec57-3713-b509-3d94fc662f2e",
                        "entry_id": "79660c6b-bb58-308e-8cbb-f97111cc0d5f",
                        "glosses": [
                            "сорт игристого виноградного вина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f172b29-5727-41d7-b373-b34090e2fc73",
                                "sense_id": "02223f6f-ec57-3713-b509-3d94fc662f2e",
                                "text": "Несколько бутылок горского и цимлянского громко были уже откупорены и приняты благосклонно под именем шампанского .."
                            },
                            {
                                "example_id": "d18b1c03-cd5b-4c93-a575-03d799272bff",
                                "sense_id": "02223f6f-ec57-3713-b509-3d94fc662f2e",
                                "text": "В это время все развеселились, а хозяин встал, поднял вверх бокал с шипучим цимлянским .."
                            },
                            {
                                "example_id": "f1c1dc98-2156-4976-b29e-41ae5ee12054",
                                "sense_id": "02223f6f-ec57-3713-b509-3d94fc662f2e",
                                "text": "Не могу выразить, сколько я съел свежей зернистой икры и выпил цимлянского!"
                            },
                            {
                                "example_id": "d73740e8-0e6e-463a-9e36-3750cdaa444d",
                                "sense_id": "02223f6f-ec57-3713-b509-3d94fc662f2e",
                                "text": "Выпили водочки — старик любил выпить, а после борща .. появилась на столе и бутылочка цимлянского."
                            }
                        ]
                    }
                ],
