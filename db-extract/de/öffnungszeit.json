                "senses": [
                    {
                        "sense_id": "05bb62dc-6496-3cf9-bea3-adb45dec394f",
                        "entry_id": "72b3d466-4ea6-3b4a-af2f-4977625cd60b",
                        "glosses": [
                            "festgelegter Zeitabschnitt (meist nach Wochentag differenziert), an dem ein Betrieb mit Publikumsverkehr (zum Beispiel ein Geschäft, Amt oder Museum) geöffnet ist"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "71c5e74a-7d59-4285-9b70-896ab185f499",
                                "sense_id": "05bb62dc-6496-3cf9-bea3-adb45dec394f",
                                "text": "Die Öffnungszeiten der Geschäfte könnten flexibler gestaltet werden."
                            },
                            {
                                "example_id": "1f600ba7-a7fe-4e97-86ce-dbd28e3e2336",
                                "sense_id": "05bb62dc-6496-3cf9-bea3-adb45dec394f",
                                "text": "„Dabei wird sich die Bank-Hälfte in der Filiale dem Postbereich in puncto Öffnungszeiten anpassen, 18 Uhr gilt als Richtzeit.“"
                            },
                            {
                                "example_id": "33baef19-e417-44b9-8a88-7dd04b23ddf5",
                                "sense_id": "05bb62dc-6496-3cf9-bea3-adb45dec394f",
                                "text": "„Sie gingen vorbei an einer Palette, auf der mit schwarzem Edding die Öffnungszeiten des neuen Leuchtturms standen, auf Englisch und auf Isländisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23b5a411-559a-43a2-9b06-21356fc9893d",
                        "source_entry_id": "72b3d466-4ea6-3b4a-af2f-4977625cd60b",
                        "source_sense_id": "05bb62dc-6496-3cf9-bea3-adb45dec394f",
