        "fr-extract.jsonl": [
            {
                "entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                "word": "leucocyte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95ec8db5-dded-4b64-91b0-152dfeeaa337",
                        "entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                        "tags": [
                            "plural"
                        ],
                        "form": "leucocytes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                        "entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                        "glosses": [
                            "Globule blanc du sang, de la lymphe et de nombreux tissus, qui est pourvu d’un noyau, contrairement aux hématies ou globules rouges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c149ea71-255d-465b-9412-d8f3c198d5e4",
                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                "text": "Mais outre ces leucocytes, il y a dans le pus sécrété par les plaies un bactérien qui possède aussi la propriété de provoquer la formation du pus en plus grande quantité, quand il est introduit dans les tissus vivants ; […]."
                            },
                            {
                                "example_id": "2493d702-6f54-42aa-9701-cb481199ec17",
                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                "text": "Finalement cette formation s’est dégagée du leucocyte."
                            },
                            {
                                "example_id": "71e1e35e-6551-47a0-b6a8-1e9f03b37e5f",
                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                "text": "La première ligne de défense est composée d’un ensemble de cellules appelées leucocytes (ou globules blancs) qui circulent dans les tissus et le flux sanguin. Ces cellules sont plus grandes et moins nombreuses que les érythrocytes ou globules rouges, qui transportent l’oxygène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c11f183-f8e5-46c5-8ddf-aae214d74a47",
                        "source_entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                        "source_sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                        "target_lang_word": "Leukozyt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leukozyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                                        "entry_id": "87e6fea1-c11f-33b7-acb9-09782e5dbb99",
                                        "glosses": [
                                            "Biologie, Medizin: Blutkörperchen ohne Hämoglobin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b9a922-e829-4863-99a5-a400acaf666e",
                                                "sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                                                "text": "Leukozyten erfüllen spezielle Aufgaben in der Abwehr von Krankheitserregern und körperfremden Strukturen."
                                            },
                                            {
                                                "example_id": "28f4408c-d4cc-4300-9c0e-f5cc66536c6e",
                                                "sense_id": "98719239-edd2-30f8-9113-0b99ba9d35a2",
                                                "text": "Bei den Leukämien verändern sich einzelne Untergruppen der Leukozyten zu Tumorzellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7440db3e-a59f-45bd-857c-d352cc7c5122",
                        "source_entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                        "source_sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
