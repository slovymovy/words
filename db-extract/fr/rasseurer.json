                "senses": [
                    {
                        "sense_id": "db98fa30-0315-3009-9b47-6f51a1827a0f",
                        "entry_id": "0d343b02-cd16-3dad-bed0-b46054cf55d3",
                        "glosses": [
                            "Orthographe ancienne de rassurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f7cd6d-86c9-428e-a819-fd24d00e51b2",
                                "sense_id": "db98fa30-0315-3009-9b47-6f51a1827a0f",
                                "text": "Le sommeil ne m'eut pas repris Que, songeant encore à ta vie, Tu vins rasseurer mes esprits Qu'on ne te l'avoit point ravie."
                            },
                            {
                                "example_id": "abd6ddb0-6cf8-482e-9aec-40d2b3d939c6",
                                "sense_id": "db98fa30-0315-3009-9b47-6f51a1827a0f",
                                "text": "Le moyen de les rasseurer est que les bons chréstiens touchés sensiblement des maulx que lon faict fondre sur nous sans relasche facent des efforts considerables pour soustenir le residu de peuple qui appartient à son alliance ;"
                            }
                        ]
                    }
