                                    {
                                        "sense_id": "35babe88-12ad-3be2-9a0e-5240b4af6717",
                                        "entry_id": "0d8d2d0e-14a9-357c-a4eb-472f36ef7585",
                                        "glosses": [
                                            "verzamelterm om deze drie landen aan te duiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f275d2b1-68ae-4fbf-829b-a628e5d961f5",
                                                "sense_id": "35babe88-12ad-3be2-9a0e-5240b4af6717",
                                                "text": "Zij geeft leiding aan alle vestigingen in de Benelux."
                                            },
                                            {
                                                "example_id": "30e6c4b0-00f8-4bd1-bd21-0ec65f5147a6",
                                                "sense_id": "35babe88-12ad-3be2-9a0e-5240b4af6717",
                                                "text": "Als er tienduizenden gewonden vallen, zou dat de capaciteit van de zorg in de complete Benelux vele malen overtreffen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd93277-01e8-3a3d-b2eb-bfe4b6703034",
                                        "entry_id": "0d8d2d0e-14a9-357c-a4eb-472f36ef7585",
                                        "glosses": [
                                            "samenwerkingsverband van België, Nederland en Luxemburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b85f403-aeb5-4c6c-9d46-a4749acee6d5",
                                                "sense_id": "5fd93277-01e8-3a3d-b2eb-bfe4b6703034",
                                                "text": "Alle landen van de Benelux zijn ook lid van de EU."
                                            },
                                            {
                                                "example_id": "1aa531b2-0d69-4150-87db-140c80b8c569",
                                                "sense_id": "5fd93277-01e8-3a3d-b2eb-bfe4b6703034",
                                                "text": "Ook deed Nederland na het Brexitreferendum zijn best om nieuwe bondgenoten te vinden. Het haalde de banden met Parijs aan en activeerde de Benelux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
