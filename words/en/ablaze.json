                    "sense_definition": "With intense passion, excitement, or emotional fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eyes burned <w>ablaze</w> as she delivered the powerful speech.",
                            "target_lang_translations": {
                                "ru": "Её глаза <w>яростно пылали</w>, когда она произносила свою мощную речь."
                            }
