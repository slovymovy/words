                    {
                        "sense_id": "ce8cb904-38ef-38ac-accf-623bf8425a06",
                        "entry_id": "0cbec0c6-1b77-3ed6-9383-e7d0d512e625",
                        "glosses": [
                            "A type of yeast traditionally used in winemaking, baking, and brewing, now identified as Saccharomyces cerevisiae."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7dc86100-6614-45ad-9134-ef60bf53a92a",
                                "sense_id": "ce8cb904-38ef-38ac-accf-623bf8425a06",
                                "text": "Pound 5 kg of round ragi (yeast) and 5 pieces of thinly sliced ragi into powder. Mix ragi into cooled rice."
                            },
                            {
                                "example_id": "1bd5af66-ec23-454b-a94b-ae025b6dac5e",
                                "sense_id": "ce8cb904-38ef-38ac-accf-623bf8425a06",
                                "text": "2010, M.J. Robert Nout, Kofi E. Aidoo, 2: Asian Fungal Fermented Food, Martin Hofrichter (volume editor), Karl Esser (editor), The Mycota, Volume X: Industrial Applications, page 49,\nIt is made from cooked gelatinised rice and red pulverised ragi (yeast cake or jui-piang) and fermented for up to 30 days at 25°C."
                            },
                            {
                                "example_id": "f4a348fa-bcd1-47bb-85f1-fa2053a76ff8",
                                "sense_id": "ce8cb904-38ef-38ac-accf-623bf8425a06",
                                "text": "Finely ground and sifted round ragi yeast 3⁄4 tsp"
                            }
                        ]
                    }
