                ],
                "senses": [
                    {
                        "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                        "entry_id": "449445ab-ad48-3c9b-aac5-d9d91b9cc642",
                        "glosses": [
                            "Linie eines Spielfelds (meist von Ballsportarten, beispielsweise Tennis, Volleyball, Feldhockey, Fußball), die dieses am Anfang und Ende begrenzt; ist der Ball hinter der Grundlinie, so ist er im Aus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a973f0e6-d6e7-4e50-833d-76587269c5bd",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„Werner spielte sich über links zur Grundlinie, ließ seinen Gegenspieler aussteigen und legte ab auf Forsberg, der nur noch vollenden musste: 2:0.“"
                            },
                            {
                                "example_id": "a847ad80-beac-4fae-a852-289430cef95c",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„An der Grundlinie düpierte Max Meyer den Freiburger Mike Frantz und dribbelte in den Strafraum […]“"
                            },
                            {
                                "example_id": "b64d4a0a-de5d-42a3-b478-d0a8207ab6b7",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„Asllani setzt sich im niederländischen Strafraum durch, doch anstatt den Ball von der Grundlinie nach hinten abzulegen, passt sie genau auf Torfrau Van Veenendaal.“",
                                "translation": "Tennis:"
                            },
                            {
                                "example_id": "2b6a5301-0616-41f3-b272-a8557b4ac848",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "[Schlagzeile:] Federer: «Von der Grundlinie aus hapert es immer am Anfang»"
                            },
                            {
                                "example_id": "ddf384c5-b932-4800-b4d5-3bc2a78463af",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„Gegen Alexander Zverev wollte Roger Federer eigentlich gewohnt offensiv agieren. Stattdessen musste er aber Meter um Meter an der Grundlinie zurücklegen.“"
                            },
                            {
                                "example_id": "fbc75f4e-64fb-476b-b372-433532989c70",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„Bei angenehmen 25 Grad […] agierte Djokovic von der Grundlinie aus aber nahezu fehlerfrei […].“"
                            },
                            {
                                "example_id": "7477d08b-ffcf-4db7-aa94-92a7cff45fd7",
                                "sense_id": "0a51b366-144b-359c-a64f-d109d897bb38",
                                "text": "„Wer [Anmerkung: beim SUP-Polo vom Brett] runterfällt, muss zurück zur Grundlinie und darf erst dann wieder ins Spiel eingreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cfd74d7-ebef-3998-a03d-bb553651547b",
                        "entry_id": "449445ab-ad48-3c9b-aac5-d9d91b9cc642",
                        "glosses": [
                            "Linie, an der die Buchstaben einer Zeile ausgerichtet werden"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "e28a25b8-6639-418b-a74c-a264aa65b02a",
                                "sense_id": "3cfd74d7-ebef-3998-a03d-bb553651547b",
                                "text": "„Gemessen wird der Abstand von Grundlinie zu Grundlinie von Textzeilen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0257f3b5-f2bf-3bdd-9f51-11ac7a79e6d4",
                        "entry_id": "449445ab-ad48-3c9b-aac5-d9d91b9cc642",
                        "glosses": [
                            "unterste Linie eines Drei- oder Vierecks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2687cd6-3c11-4c7c-a490-cea42d5408bb",
                                "sense_id": "0257f3b5-f2bf-3bdd-9f51-11ac7a79e6d4",
                                "text": "„[…] die Fläche eines rechtwinkeligen Dreiecks […] ließe sich nun einfach nach der bekannten Formel Fläche ist gleich 0,5 mal Grundlinie mal Höhe, in diesem Fall A = 0,5 ·s ·F bzw. für die Arbeit W = 0,5 · s · F berechnen […]“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                        "entry_id": "449445ab-ad48-3c9b-aac5-d9d91b9cc642",
                        "glosses": [
                            "generelle Richtlinien, Kernpunkte"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "52c9a25e-1d22-4b99-b378-cfdc1a0099cb",
                                "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                                "text": "„Es gibt die Grundlinie, [Anmerkung: für Kinder mit Migrationshintergrund] möglichst rasch Sprachkompetenz herzustellen.“"
                            },
                            {
                                "example_id": "fa704a89-f9f2-47c0-9484-f813e01cf81b",
                                "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                                "text": "„Der Etat des Kanzleramtes in der Haushaltswoche des Bundestages ist traditionell Anlass für einen Schlagabtausch zwischen Opposition und Regierungsparteien über die Grundlinien der Politik.“"
                            },
                            {
                                "example_id": "fa2e25f5-8a8f-4b60-8c65-2826e66295fb",
                                "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                                "text": "„Mustafa Kemal, genannt Atatürk, ist ein Wahrzeichen der Türkei geworden. […] die Grundlinien seiner Politik bestimmen nach wie vor das politische Leben in der Türkei.“"
                            },
                            {
                                "example_id": "37f46361-2b83-4334-8325-085163d68128",
                                "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                                "text": "„Ludwig XIV. verfügt über keine neuen außenpolitischen Konzepte, er verfolgte die Grundlinien, die die beiden großen Kardinäle Richelieu und Mazarin vorgebahnt hatten.“"
                            },
                            {
                                "example_id": "68adefe5-3906-4631-afe6-73336426074f",
                                "sense_id": "9f65f2c5-8b40-3d2e-a15d-9c8eeb16229d",
                                "text": "[Helmut Schmidt, Ex-Bundeskanzler:] „»Als mich nach meinem Ausscheiden aus der Bundesregierung der Verleger Gerd Bucerius aufforderte als Herausgeber und später sogar als Geschäftsführer in 'Die Zeit' einzutreten, habe ich das sehr gerne gemacht. Weil ich im Grunde einverstanden war mit der Grundlinie, die 'Die Zeit' verfolgte. […]«“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
