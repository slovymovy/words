{
    "word_family": [
        "ехать",
        "ездить",
        "поездка",
        "поезд",
        "выехать",
        "заехать",
        "приехать",
        "уехать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27dae549-06e5-3298-a6a5-4abb3aa1130c",
                    "sense_definition": "Начать движение на транспортном средстве или верхом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <w>поехать</w> на вокзал на такси.",
                            "target_lang_translations": {
                                "en": "We decided to <w>go</w> to the station by taxi."
                            }
                        },
                        {
                            "text": "Завтра утром мы <w>поедем</w> в горы на машине.",
                            "target_lang_translations": {
                                "en": "Tomorrow morning we will <w>go</w> to the mountains by car."
                            }
                        }
                    ],
                    "synonyms": [
                        "отправиться"
                    ],
                    "common_phrases": [
                        "поехать на машине",
                        "поехать на поезде"
                    ],
                    "target_lang_definitions": {
                        "en": "To start moving using a vehicle or while riding."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "To move through space, especially to a destination."
                            },
                            {
                                "target_lang_word": "set off",
                                "target_lang_sense_clarification": "To begin a journey."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d4e39f2-6ad6-36bc-9bde-8509e61f34ef",
                    "sense_definition": "Отправиться в путь, начать путешествие или поездку куда-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы <w>поедем</w> отдыхать на море.",
                            "target_lang_translations": {
                                "en": "In the summer we will <w>go</w> on vacation to the sea."
                            }
                        },
                        {
                            "text": "Они <w>поехали</w> в командировку на неделю.",
                            "target_lang_translations": {
                                "en": "They <w>went</w> on a business trip for a week."
                            }
                        }
                    ],
                    "synonyms": [
                        "отправиться"
                    ],
                    "common_phrases": [
                        "поехать отдыхать",
                        "поехать в отпуск"
                    ],
                    "target_lang_definitions": {
                        "en": "To set off on a journey, start a trip or travel somewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "To travel to a destination."
                            },
                            {
                                "target_lang_word": "leave for",
                                "target_lang_sense_clarification": "To depart for a specific place."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a65db86-3229-3bcf-bca4-48e6a301cc58",
                    "sense_definition": "Сдвинуться с места, начать движение.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автобус <w>поехал</w> ровно по расписанию.",
                            "target_lang_translations": {
                                "en": "The bus <w>started moving</w> exactly on schedule."
                            }
                        },
                        {
                            "text": "Машина <w>поехала</w> медленно по узкой дороге.",
                            "target_lang_translations": {
                                "en": "The car <w>moved</w> slowly along the narrow road."
                            }
                        }
                    ],
                    "synonyms": [
                        "тронуться"
                    ],
                    "antonyms": [
                        "остановиться"
                    ],
                    "common_phrases": [
                        "поезд поехал"
                    ],
                    "target_lang_definitions": {
                        "en": "To move from a stationary position, to start moving."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "To change position or start motion."
                            },
                            {
                                "target_lang_word": "start moving",
                                "target_lang_sense_clarification": "To begin to be in motion."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c892dcef-c2a1-3745-9519-202ffefd13c9",
                    "sense_definition": "Начать какое-либо действие или процесс (часто в значении «начали!»).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все были готовы, и работа наконец <w>поехала</w>.",
                            "target_lang_translations": {
                                "en": "Everyone was ready, and the work finally <w>got going</w>."
                            }
                        },
                        {
                            "text": "Мы закончили приготовления, <w>поехали</w>!",
                            "target_lang_translations": {
                                "en": "We finished the preparations, let's <w>go</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "начать"
                    ],
                    "target_lang_definitions": {
                        "en": "To begin an action or process (often meaning 'let's start!')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get going",
                                "target_lang_sense_clarification": "To begin or commence an activity."
                            },
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "To initiate an action."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e764f00-f1cb-336f-b50d-9f1009471d22",
                    "sense_definition": "Испортиться, деформироваться, потерять форму или структуру.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за влажности обои на стене <w>поехали</w>.",
                            "target_lang_translations": {
                                "en": "Due to the humidity, the wallpaper on the wall <w>tore</w>."
                            }
                        },
                        {
                            "text": "У неё на колготках <w>поехала</w> большая стрелка.",
                            "target_lang_translations": {
                                "en": "She got a big run <w>tearing</w> through her tights."
                            }
                        }
                    ],
                    "synonyms": [
                        "деформироваться",
                        "испортиться"
                    ],
                    "target_lang_definitions": {
                        "en": "To spoil, deform, lose shape or structure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tear",
                                "target_lang_sense_clarification": "To become damaged or ripped."
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "To become damaged or stop functioning."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111ed821-6561-3b06-bdd7-f3ee24bcf3ab",
                    "sense_definition": "Сойти с ума, потерять рассудок.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он совсем <w>поехал</w> от постоянного стресса на работе.",
                            "target_lang_translations": {
                                "en": "He completely <w>went crazy</w> from the constant stress at work."
                            }
                        },
                        {
                            "text": "Ты что, <w>поехал</w> делать такие глупости?",
                            "target_lang_translations": {
                                "en": "Are you crazy, <w>losing your mind</w> doing such stupid things?"
                            }
                        }
                    ],
                    "synonyms": [
                        "свихнуться"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To go crazy, lose one's mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go crazy",
                                "target_lang_sense_clarification": "To lose one's sanity."
                            },
                            {
                                "target_lang_word": "lose one's mind",
                                "target_lang_sense_clarification": "To become mentally unstable."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}