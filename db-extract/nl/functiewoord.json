                                        "glosses": [
                                            "A word that has little meaning when standing alone, but instead serves to express grammatical relationships with other words within a sentence, or specify the attitude or mood of the speaker, including conjunctions, prepositions, pronouns, auxiliary verbs, certain frequent adverbs."
                                        ],
                                        "tags": [],
