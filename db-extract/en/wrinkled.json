                                "target_senses": [
                                    {
                                        "sense_id": "3437197f-8f1b-365e-9ffc-cbbd7987c4a1",
                                        "entry_id": "eff67a61-c107-3a75-9a23-6230e8a316f6",
                                        "glosses": [
                                            "Couvert de rides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47de9ff6-623c-4309-a7cb-ec3747a62069",
                                                "sense_id": "3437197f-8f1b-365e-9ffc-cbbd7987c4a1",
                                                "text": "Une vieille toute ridée."
                                            },
                                            {
                                                "example_id": "ea2b8b46-b394-419f-92ea-18c33f2d1c05",
                                                "sense_id": "3437197f-8f1b-365e-9ffc-cbbd7987c4a1",
                                                "text": "Un visage ridé."
                                            },
                                            {
                                                "example_id": "6e0f83ec-d1a2-4ad5-97a6-542e82d281a3",
                                                "sense_id": "3437197f-8f1b-365e-9ffc-cbbd7987c4a1",
                                                "text": "Une pomme ridée — Une pomme ratatinée."
                                            },
                                            {
                                                "example_id": "2fe55410-a27c-43d4-9032-6ba05b5185c9",
                                                "sense_id": "3437197f-8f1b-365e-9ffc-cbbd7987c4a1",
                                                "text": "C’était bien le plus drôle de corps qu’on puisse imaginer : sa taille, de cinq pieds huit pouces, faisait le plus singulier contraste avec sa petite tête, ridée comme une pomme et grosse comme le poing."
                                            }
                                        ]
                                    }
                                ]
                            },
