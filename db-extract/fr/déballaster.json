                "senses": [
                    {
                        "sense_id": "cb88d5a7-449e-3ec0-823a-97d96bbd7bd1",
                        "entry_id": "60809f13-07b5-3bc9-98bd-78986470f503",
                        "glosses": [
                            "Vidanger l’eau de mer contenue dans les ballasts pour corriger de la gîte ou l’assiette d’un navire qui présente un chargement déséquilibré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47742cd1-9ad6-4f76-93f9-091c24286948",
                                "sense_id": "cb88d5a7-449e-3ec0-823a-97d96bbd7bd1",
                                "text": "Pour aller plus vite, nous venons de déballaster, cela nous donne une moyenne de 11 nœuds et demi."
                            },
                            {
                                "example_id": "ad3a6632-3375-49d7-85d9-2785a73b2e58",
                                "sense_id": "cb88d5a7-449e-3ec0-823a-97d96bbd7bd1",
                                "text": "Dès lors il aurait été idiot de déballaster en plein jour la veille."
                            },
                            {
                                "example_id": "b823dab4-de49-480b-83c6-797816a89928",
                                "sense_id": "cb88d5a7-449e-3ec0-823a-97d96bbd7bd1",
                                "text": "Ceci sert également à l'expédition du fuel oil exporté ; une autre conduite de 24 permet aux bateaux de déballaster à terre."
                            }
                        ]
                    }
