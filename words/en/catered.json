                {
                    "sense_id": "ccb1c90e-5e49-39ff-b1c4-011487b52367",
                    "sense_definition": "Describing an event or accommodation where food and service are provided by a professional provider.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "catering_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to host a <w>catered</w> lunch for all the employees.",
                            "target_lang_translations": {
                                "ru": "Компания решила организовать обед <w>с обслуживанием</w> для всех сотрудников."
                            }
                        },
                        {
                            "text": "They booked a <w>catered</w> event to ensure the guests enjoyed high-quality food.",
                            "target_lang_translations": {
                                "ru": "Они забронировали мероприятие <w>с кейтерингом</w>, чтобы гости могли насладиться качественной едой."
                            }
