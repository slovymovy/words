                    {
                        "translation_id": "a7061991-7456-421e-92b8-606e99ff67ca",
                        "source_entry_id": "e367473d-932b-34db-99a4-e65d1976209d",
                        "source_sense_id": "cec7e1c1-0e23-38aa-a5f9-fb7c8e3fb8e8",
