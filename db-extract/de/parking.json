                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bb7bf6a-3eeb-475d-9fa1-b7743ca8caa7",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "It is important also that we improve car park security."
                                            },
                                            {
                                                "example_id": "c49dcd19-9948-4502-9d1f-374d5e1f2181",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "The dog lumbered his way across the car park to a point where he had to cross Emmons′s path."
                                            },
                                            {
                                                "example_id": "f7d689e0-3688-45b4-bbf2-01a3746e307c",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "Beyond the car park a rough old track ran uphill."
                                            },
                                            {
                                                "example_id": "30ffcb51-f182-47f7-9a6d-fa113aaf2b94",
                                                "sense_id": "c3779b07-83f8-3b0a-9551-a536acd3b9cd",
                                                "text": "Follow the road to the car park and boat ramp at Buffalo Creek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968bda4f-5704-3d7a-80af-70ed95af0c5c",
