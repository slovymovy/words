                "senses": [
                    {
                        "sense_id": "3ceed37e-c146-31d0-a4bc-8bb336e672cc",
                        "entry_id": "551c9116-2e67-30ed-946f-df5847281420",
                        "glosses": [
                            "mit Ruß bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f787f2f7-90a4-49a4-bfa5-2cbb254e07ce",
                                "sense_id": "3ceed37e-c146-31d0-a4bc-8bb336e672cc",
                                "text": "„Huda erzählet allen dasselbe: dass die Kinder rußbedeckt gewesen seien und sie nichts über ihre Kleidung sagen könne.“"
                            },
                            {
                                "example_id": "2393227b-ee62-4fc0-88c9-7f20ada2d385",
                                "sense_id": "3ceed37e-c146-31d0-a4bc-8bb336e672cc",
                                "text": "„Das Heck war vom Rumpf abgebrochen und die rußbedeckten Fenster sowie die zum Teil geschmolzenen und komplett rauchgeschwärzten Triebwerke deuteten auf ein Feuer an Bord hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
