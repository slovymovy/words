                ],
                "senses": [
                    {
                        "sense_id": "ce12a9f6-815b-3459-9bf4-de77d0def8f5",
                        "entry_id": "18c32238-fbc5-32f3-be21-044efbf68a67",
                        "glosses": [
                            "Trihydrure d’arsenic, de formule brute AsH₃, gaz incolore et toxique, plus lourd que l’air, qui a été utilisé en association avec d'autres gaz dans les obus chimiques de la Première Guerre mondiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de9469ec-fa98-47e3-a434-b324587fe854",
                                "sense_id": "ce12a9f6-815b-3459-9bf4-de77d0def8f5",
                                "text": "L’arsine est un gaz toxique qui s’enflamme facilement dans l’air mais ses analogues organiques (radical aryle ou alkyle) sont beaucoup plus stables ce qui permet de les utiliser en chimie des métaux ou pour doper le silicium dans l’industrie des composants."
                            },
                            {
                                "example_id": "4547e9d9-bc85-4844-b4ba-35303a5ca219",
                                "sense_id": "ce12a9f6-815b-3459-9bf4-de77d0def8f5",
                                "text": "Les obus toxiques habituellement utilisés sont accompagnés d’une nouvelle substance, l’arsine, et beaucoup d’hommes souffrent d’une irritation aiguë des voies respiratoires."
                            }
                        ]
                    }
                ],
