                    {
                        "sense_id": "bc100022-2e57-32f6-a90f-6e7e1b864087",
                        "entry_id": "db6fab4c-acf7-382e-b7d4-866343074227",
                        "glosses": [
                            "godzina 10 przed południem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0fff803-744d-40df-b3b1-3abb3fde2c0d",
                                "sense_id": "bc100022-2e57-32f6-a90f-6e7e1b864087",
                                "text": "Prezes będzie uchwytny tylko od dziesiątej do dwunastej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "528696d0-476d-3606-a3f1-72bbf0a4883d",
                        "entry_id": "db6fab4c-acf7-382e-b7d4-866343074227",
                        "glosses": [
                            "godzina 10 (22) przed północą"
                        ],
                        "tags": [],
