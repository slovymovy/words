                "senses": [
                    {
                        "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                        "entry_id": "a3ba2738-8e04-3817-9f90-99a1dd771e37",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ab89bc-101c-4ff3-8818-5ba6192b5b7c",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Frau Rindle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5b2cc4bb-372d-44da-b216-3b3ecf0b2a86",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Herr Rindle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8ba8eede-44c2-449d-b441-0045255d9373",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Die Rindles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8afc1d6e-46ea-4dac-b0c3-359da9d517c4",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Der Rindle trägt nie die Pullover, die die Rindle ihm strickt."
                            },
                            {
                                "example_id": "265a0a1a-9b4b-47bd-9ec0-7e3d73db74c1",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rindle kommt, geht der Herr Rindle.“"
                            },
                            {
                                "example_id": "4e8814c2-9ce2-424a-8acf-64b8a164cba2",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Rindle kommt und geht."
                            },
                            {
                                "example_id": "8f3eb4af-bb0d-4b74-a6a6-2dbe95fdbf50",
                                "sense_id": "581c3712-affd-3573-a7be-c315a133f116",
                                "text": "Rindles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
