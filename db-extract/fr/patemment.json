                "word": "patemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36301e38-411a-3fa9-968a-d774e5893085",
                        "entry_id": "35749bd3-440c-3ca7-9282-2e5da6e0815d",
                        "glosses": [
                            "D’une manière patente, évidente, manifeste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3315872b-191f-4c74-ab89-877ac630f36e",
                                "sense_id": "36301e38-411a-3fa9-968a-d774e5893085",
                                "text": "Mme la comtesse Sixte triomphait si patemment de Lucien, elle en jouait si bien en femme enchantée de son instrument, elle lui fournissait la réplique avec tant d’à-propos, elle quêtait pour lui des approbations par des regards si compromettants, que plusieurs femmes commencèrent à voir dans la coïncidence du retour de Louise et de Lucien un profond amour victime de quelque double méprise."
                            },
                            {
                                "example_id": "0f25193c-30ff-44bb-9245-8813cba7f966",
                                "sense_id": "36301e38-411a-3fa9-968a-d774e5893085",
                                "text": "Le vol commis par son père, occultement au préjudice d’Ursule, patemment au préjudice des héritiers."
                            },
                            {
                                "example_id": "1aa8fac1-c27f-48b5-b98d-310581da76f3",
                                "sense_id": "36301e38-411a-3fa9-968a-d774e5893085",
                                "text": "Ce fait se déclare plus ou moins patemment à toutes les époques."
                            }
                        ]
                    }
                ],
