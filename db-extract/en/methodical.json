                        "glosses": [
                            "In an organized manner; proceeding with regard to method; systematic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77ec08e2-f2a9-3f2b-a947-b27e74c5f4fe",
                        "entry_id": "6977227f-54a5-3726-b435-3ba8fea5bbea",
                        "glosses": [
                            "Arranged with regard to method; disposed in a suitable manner, or in a manner to illustrate a subject, or to facilitate practical observation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09fa8e95-6342-468c-9fd1-9d4563702792",
                                "sense_id": "77ec08e2-f2a9-3f2b-a947-b27e74c5f4fe",
                                "text": "the methodical arrangement of arguments; a methodical treatise"
                            },
                            {
                                "example_id": "79824a34-251c-4313-b0f8-5d5641d933a0",
                                "sense_id": "77ec08e2-f2a9-3f2b-a947-b27e74c5f4fe",
                                "text": "[…]methodical regularity which would have been requisite in a prose author."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e13b9a07-d35a-43a9-9ec9-e5c0d6b26fce",
                        "source_entry_id": "6977227f-54a5-3726-b435-3ba8fea5bbea",
                        "source_sense_description": "in an organized manner",
                        "target_lang_word": "méthodique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthodique",
