                {
                    "sense_id": "b7f93768-dc95-3aa2-bb86-be5ed4786e96",
                    "sense_definition": "Часто встречающийся, обычный.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "common",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был едва ли не самый <w>распространённый</w> вид заработка среди студентов.",
                            "target_lang_translations": {
                                "de": "Das war wohl die am <w>weitesten verbreitete</w> Art des Verdienstes unter Studenten."
                            }
                        },
                        {
                            "text": "Грипп — это очень <w>распространённый</w> вирус в зимнее время.",
                            "target_lang_translations": {
