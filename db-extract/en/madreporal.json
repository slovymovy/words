    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4dbfd435-d07d-3a3c-b0d4-ddeacef11cb4",
                "word": "madreporal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ada34d68-0edb-32f9-889f-1060ad05b52f",
                        "entry_id": "4dbfd435-d07d-3a3c-b0d4-ddeacef11cb4",
                        "glosses": [
                            "Characteristic of or associated with reef coral of genus Madrepora; madreporic."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a7bdf006-d3d3-4b44-8c2a-dcaa196546a5",
                                "sense_id": "ada34d68-0edb-32f9-889f-1060ad05b52f",
                                "text": "As the Nautilus headed for Clermont-Tonnere, one of the curious islands of the group discovered in 1822 by Captain Bell of the Minerva, I prepared to study the madreporal system that has created these particular isle."
                            },
                            {
                                "example_id": "828c366d-26e7-4107-be36-cf710d97d7dc",
                                "sense_id": "ada34d68-0edb-32f9-889f-1060ad05b52f",
                                "text": "The instrument is about twenty feet above sea level, and is built on ground composed of hard madreporal rock."
                            },
                            {
                                "example_id": "a797a0bf-5bcd-42c9-a727-f02668fd2f28",
                                "sense_id": "ada34d68-0edb-32f9-889f-1060ad05b52f",
                                "text": "Liquid fuel, such as the residues of petrol, etc., is absorbed by some porous incombustible substance, such as pumicestone, tufaceous or madreporal material, or bones from which the grease, gelatine, and moisture have been removed, and the resulting product used as a substitute for coal."
                            },
                            {
                                "example_id": "59c3302e-b262-4b7a-9f54-3a32df70e651",
                                "sense_id": "ada34d68-0edb-32f9-889f-1060ad05b52f",
                                "text": "Looking out to sea, the eye rests on a fringe of madreporal shelves over which the blue waves, broken farther out in a line of silvery foam, come lazily."
                            }
                        ]
                    },
                    {
                        "sense_id": "3628779b-effd-39bc-a626-7031e5f26a02",
                        "entry_id": "4dbfd435-d07d-3a3c-b0d4-ddeacef11cb4",
                        "glosses": [
                            "Pertaining to a sieve-like plate in echinoderms, which admits water into the ambulacral tubes;"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02061fd9-6f6c-458f-b8be-d0e3e69338e0",
                                "sense_id": "3628779b-effd-39bc-a626-7031e5f26a02",
                                "text": "Dorsal view with genital plates and large, sievelike madreporal plate in the center, below which is the large, anal field (periproct), shaded dark."
                            },
                            {
                                "example_id": "9886766e-00ed-4b70-8006-108acb43c75b",
                                "sense_id": "3628779b-effd-39bc-a626-7031e5f26a02",
                                "text": "Between these vascular rings there is a long muscular heart, which, united to the calcareous pouch or cord, extends from the madreporal plate to the mouth."
                            },
                            {
                                "example_id": "edeb3cfa-698b-4c86-a08c-78f54a07da97",
                                "sense_id": "3628779b-effd-39bc-a626-7031e5f26a02",
                                "text": "Its constituents are all coalesced into one piece, the madreporal filter spreading its pores over its central forepart."
                            },
                            {
                                "example_id": "41a4bbcb-c3bd-490c-a4ea-5feeab4afffc",
                                "sense_id": "3628779b-effd-39bc-a626-7031e5f26a02",
                                "text": "The water-vascular system communicates with the exterior by a separate canal through a single pore or a cluster of pores, the hydropore, situated in the so-called madreporal inter-radius."
                            }
                        ]
                    }
                ],
