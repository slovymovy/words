        "nl-extract.jsonl": [
            {
                "entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                "word": "neerslachtigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7c702f71-262d-4429-b2ba-058e31536839",
                        "entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "neerslachtigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                        "entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                        "glosses": [
                            "droeve, depressieve stemming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fffade76-d277-48f7-9be1-1035ab14db63",
                                "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                                "text": "Bloeddruk, temperatuur en spierspanning worden hoger en de gebruiker kan gaan zweten en tandenknarsen en ook een droge mond en grote pupillen krijgen. Gebruikers kunnen verder onder meer verschijnselen als hoofdpijn, verwarring, misselijkheid, angst, neerslachtigheid, hartkloppingen, uitputting, uitdroging, oververhitting en spierspasmes ervaren. Ook een epileptische aanval, delier of drugspsychose is niet uitgesloten."
                            },
                            {
                                "example_id": "03e4bd95-f33d-4d0c-9f5c-8377ab373d6a",
                                "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                                "text": "Hij zat voorovergebogen, ellebogen op zijn knieën, zijn handen tegen de zijkant van zijn hoofd gedrukt het toonbeeld van neerslachtigheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e93a6ba7-d2e9-4692-9dd9-cb76e111b487",
                        "source_entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                        "source_sense_id": "534c3309-3391-3f75-9926-228440d83409",
                        "source_sense_description": "droeve, depressieve stemming",
                        "target_lang_word": "melancholy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Black bile, formerly thought to be one of the four \\\"cardinal humours\\\" of animal bodies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c425b3-26d4-4a76-b5ed-d6bfbfa2f18d",
                                                "sense_id": "1f8cdfa2-3578-3200-be35-23b7fcba2341",
                                                "text": "Melancholy, cold and dry, thick, black, and sour, […] is a bridle to the other two hot humours, blood and choler, preserving them in the blood, and nourishing the bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                        "entry_id": "bff5e659-0944-3a3a-96af-88c5df07f6d8",
                                        "glosses": [
                                            "Great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0307c175-9790-4017-abd3-f5675a01ff4d",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "My mind was troubled with deep melancholy."
                                            },
                                            {
                                                "example_id": "93c233e1-b1a2-4891-9422-369335f87292",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "I have neither the scholar’s melancholy, which is emulation; nor the musician’s, which is fantastical; nor the courtier’s, which is proud; nor the soldier’s, which is ambitious; nor the lawyer’s, which is politic; nor the lady’s, which is nice; nor the lover’s, which is all these; but it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "ceda47bf-1209-4f90-8612-fd4d136999b5",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "\"The ancients referred melancholy to the mind, the moderns make it matter of digestion—to either case my plan applies,\" said Lady Mandeville."
                                            },
                                            {
                                                "example_id": "8b1514c4-373a-43a6-8c0f-2ad9bb567f0c",
                                                "sense_id": "08f16276-9026-3841-8f06-8398c90818b0",
                                                "text": "As to Ernest... He is quite as nervously broken down as I am but it manifests itself in different ways. His inclination is towards megalomania and mine towards melancholy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                        "entry_id": "62d7b7ad-cfc0-3539-978f-64a64043c1d0",
                                        "glosses": [
                                            "Affected with great sadness or depression."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9d3648-3a09-463a-a7dc-1f1e82fa1506",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "Melancholy people don't talk much."
                                            },
                                            {
                                                "example_id": "3265362c-9be8-4312-a0af-b62feb6c647b",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "[…] he is melancholy without cause, and merry against the hair: […]"
                                            },
                                            {
                                                "example_id": "dccecd0a-19b5-45e0-8b80-aa6f78492945",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. […] And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "1c37b54e-6b07-4f1f-8006-00dddf8ccca1",
                                                "sense_id": "9a7f6b09-1788-31b2-9229-cd6121c79219",
                                                "text": "It was the same old song / With a melancholy sound"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e22854a-b846-4c26-a612-76d209c72c75",
                        "source_entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                        "source_sense_id": "534c3309-3391-3f75-9926-228440d83409",
                        "source_sense_description": "droeve, depressieve stemming",
                        "target_lang_word": "depression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A state of mind producing serious, long-term lowering of enjoyment of life or inability to visualize a happy future; any of several mental disorders with this state of mind as a central feature."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1749bcdf-e767-4053-9d5b-f862a1fe7c66",
                                                "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                                "text": "I used to suffer from depression, but now I'm mostly content with my life."
                                            },
                                            {
                                                "example_id": "8713f305-24a9-4126-82a3-ca5acd5fc07a",
                                                "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                                "text": "It is that Mr. Levi's death could not be dissociated from the major depression with which he was afflicted, and that indeed his suicide proceeded directly from that illness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A period of low morale or unhappiness (a period of experiencing the above-mentioned state of mind) which lasts longer than several weeks and may include ideation of self-inflicted injury or suicide."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1423222-2c35-48d7-9e28-deef1a507172",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "[…] your illness reflects the textbook description of bipolar disorder (euphoric, grandiose, manic highs followed by deep depressions,[…]"
                                            },
                                            {
                                                "example_id": "72f37d12-857d-4fc5-8ea8-57745b245bb6",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "His first major breakdown occurred when his son was five years old; he continued to go to pieces periodically, with a particularly deep depression that lasted from the time Bill was in sixth grade until the time he finished junior high[…]"
                                            },
                                            {
                                                "example_id": "f1c985b3-783b-4bb2-a9d1-19855141d111",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "Many alcoholics who die from suicide suffer from deep depressions that are quite frequently protracted,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "An area that is lower in topography than its surroundings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d846d42e-3b2c-4ee8-bdf7-10d7c7553c67",
                                                "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            },
                                            {
                                                "example_id": "9f9eee97-9980-4923-b876-0aab06817bd9",
                                                "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                                "text": "These large [mazes] led to smaller ones which were constructed to hold in the hand, usually in the form of a circular tray. In these a marble was contained which had to be manipulated to roll into a depression in the centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e08f9-c6aa-3c23-8450-b18ceb5b3d20",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "An area of lowered air pressure that generally brings moist weather, sometimes promoting hurricanes and tornadoes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31fe5a85-4c25-3d28-a8ff-fc0c05bfeb52",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A period of major economic contraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3ddf00-5857-3760-9f49-cfceee1d9a48",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "Four consecutive quarters of negative, real GDP growth. See NBER."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe34d832-66cb-4618-810e-0fa95e8614aa",
                                                "sense_id": "ed3ddf00-5857-3760-9f49-cfceee1d9a48",
                                                "text": "The Great Depression was the worst financial event in US history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d9c171-4061-3706-b425-7ef8bcd79f6f",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "The act of lowering or pressing something down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da65eb7-76cd-4e0a-9f33-340810e4daa1",
                                                "sense_id": "d2d9c171-4061-3706-b425-7ef8bcd79f6f",
                                                "text": "Depression of the lever starts the machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7dc6c1-6642-37a3-aa4a-212f9fa5cd15",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A lowering, in particular a reduction in a particular biological variable or the function of an organ, in contrast to elevation."
                                        ],
