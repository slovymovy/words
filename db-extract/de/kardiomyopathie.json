                                "target_senses": [
                                    {
                                        "sense_id": "202d1c14-3f82-3881-86df-708170557845",
                                        "entry_id": "ec8334e4-6d74-3cd3-b53f-08a6b09850e2",
                                        "glosses": [
                                            "Pathologie affectant le myocarde."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c5c798-9a60-4b9a-a588-e580db5ae7ff",
                                                "sense_id": "202d1c14-3f82-3881-86df-708170557845",
                                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                                            },
                                            {
                                                "example_id": "71351ec2-ca27-44f0-82de-6e3be4336bdd",
                                                "sense_id": "202d1c14-3f82-3881-86df-708170557845",
                                                "text": "Le myocarde est touché moins sévèrement, bien que 10% des cas décèdent de cardiomyopathie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d32966-d4e8-46b2-b56f-7c4a652d62cc",
                        "source_entry_id": "f3af01d9-3337-389f-b632-2602c3f9ea14",
                        "source_sense_id": "f6df2631-6120-350d-8b3c-051b9a14c8e9",
                        "source_sense_description": "Erkrankung des Herzmuskels",
                        "target_lang_word": "cardiomiopatia",
