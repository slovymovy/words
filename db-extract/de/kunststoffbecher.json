                            {
                                "example_id": "cbf8e0df-17d6-4a5a-b2db-11afd8ec86e7",
                                "sense_id": "4686e60a-87ee-3522-a72c-ecbcfb540ae0",
                                "text": "Inzwischen werden 85 % der Warmgetränke in Porzellantassen serviert und nur noch 5 % in Kunststoffbechern."
                            },
                            {
                                "example_id": "cf48cfce-9937-4d0a-a4f2-f8b6c9e59c74",
                                "sense_id": "4686e60a-87ee-3522-a72c-ecbcfb540ae0",
                                "text": "„Nach dem Erkalten löst man den Schmelzkuchen in einem Kunststoffbecher mit destilliertem Wasser.“"
                            }
