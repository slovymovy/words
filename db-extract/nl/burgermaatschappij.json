                                    {
                                        "sense_id": "ff5603c3-9a3f-3bf0-88e4-73034291cbae",
                                        "entry_id": "22bf7616-fcaa-3e61-ac7f-0897091e0d3d",
                                        "glosses": [
                                            "Gesamtheit der Bürger eines Ortes/Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23128cc-7350-41f0-8668-3f3e7c1a027b",
                                                "sense_id": "ff5603c3-9a3f-3bf0-88e4-73034291cbae",
                                                "text": "„Außerdem fieberte die Bürgerschaft der Stadt mit großem Ernst dem Kongress der Deutschen Anthropologischen Gesellschaft Anfang August entgegen.“"
                                            },
                                            {
                                                "example_id": "070cb90b-4b13-4f6b-aadd-b785a7b12704",
                                                "sense_id": "ff5603c3-9a3f-3bf0-88e4-73034291cbae",
                                                "text": "„Die Bürgerschaft hatte nach langen Gesuchen und mit hohen Gebühren vom Burgherrn die Erlaubnis bekommen, ihre Schafe auf den Wiesen außerhalb der Mauer weiden zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
