                    }
                ],
                "translations": [
                    {
                        "translation_id": "26f1a1b3-258e-435e-97e5-07bd8e40e5f5",
                        "source_entry_id": "e5c5afa6-f50f-3a1e-aed8-7114502b516c",
                        "source_sense_id": "1fa828f2-0165-3b54-a83a-2cd58f51fc61",
                        "source_sense_description": "to scale the walls of a fortification",
                        "target_lang_word": "escalader",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escalader",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                        "entry_id": "a19e6ab8-5cf8-3b96-b5e5-3847d8074b1d",
                                        "glosses": [
                                            "Monter dans ou sur un édifice ; franchir un obstacle, etc., soit à l’aide d’une échelle, soit en grimpant, ou de toute autre manière semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ae2702-e2d1-4834-9b0c-9c630bd577da",
                                                "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                                "text": "[…], et tantôt louvoyant, tantôt escaladant, car le chemin était parsemé d’entassements de décombres, ils arrivèrent non sans peine à la muraille indiquée par le Cornouaillais."
                                            },
                                            {
                                                "example_id": "61d0961b-dade-4a86-be14-74b735170634",
                                                "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                                "text": "Hollmann rapporte le cas d'un octopus se rappelant sa lutte avec un homard. En effet, ce dernier fut exterminé par l’octopus qui avait escaladé une cloison verticale pour arriver à lui."
                                            },
                                            {
                                                "example_id": "9e45b241-6110-4ac5-b971-683cca6ead19",
                                                "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                                "text": "L’homme au carnet avait quitté sa place et lestement escaladé les marches du praticable qui reliait le plateau à la salle."
                                            },
                                            {
                                                "example_id": "befcd6d9-43da-4212-8217-8589035ac782",
                                                "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                                            },
                                            {
                                                "example_id": "58efa959-2946-41e7-89d8-0f07cf68b9e2",
                                                "sense_id": "c735881e-bd69-3a72-a124-76a2573375ac",
                                                "text": "De temps en temps, des hommes et des femmes s’engouffraient dans l’entrée obscure, secouaient leurs manteaux ou leurs imperméables et escaladaient vivement l’escalier étroit et raide ; on percevait leurs voix lorsqu’ils échangeaient quelques mots avec le surveillant-concierge qui devait être posté au premier étage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "172c762c-ef43-384e-b74e-5f2849f2f508",
                                        "entry_id": "a19e6ab8-5cf8-3b96-b5e5-3847d8074b1d",
                                        "glosses": [
                                            "Monter sur une montagne ou grimper une falaise ou un bloc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7048094-e110-4065-a691-022e01a7b186",
                                                "sense_id": "172c762c-ef43-384e-b74e-5f2849f2f508",
                                                "text": "Il escalade une paroi dans une route de septième degré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41adf0ad-0134-32c6-8db9-09b278de0151",
                                        "entry_id": "a19e6ab8-5cf8-3b96-b5e5-3847d8074b1d",
                                        "glosses": [
                                            "Attaquer ; emporter par escalade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c6b953-9012-4d54-a1e1-9b907bd70e07",
                                                "sense_id": "41adf0ad-0134-32c6-8db9-09b278de0151",
                                                "text": "Pour cela, il faut savoir, ou se rappeler qu’en l’année 1602, le duc de Savoie, Charles-Emmanuel, fit, en pleine paix, une tentative, dès long-temps préparée, pour s’emparer de Genève par un coup de main. Ses troupes escaladèrent la ville dans la nuit du 11 au 12 décembre; mais cette entreprise, hardiment conçue, fut très mal exécutée, et n’eut d’autre résultat que la mort de la plupart de ceux qui s’y aventurèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b00943-db0a-3cd7-9c96-aa8fdbce618d",
                                        "entry_id": "a19e6ab8-5cf8-3b96-b5e5-3847d8074b1d",
                                        "glosses": [
                                            "Transférer une demande de support client à une personne plus compétente."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
