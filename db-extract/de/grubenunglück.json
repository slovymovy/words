                "senses": [
                    {
                        "sense_id": "65e53bdd-e0a5-3252-8879-f0487f2210a1",
                        "entry_id": "6352da2f-b30e-3247-b3db-695ac9fda3ca",
                        "glosses": [
                            "tragisches und folgenschweres Ereignis in einer Grube^([2]) (Bergwerk)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7220efc8-cf04-4a55-9a7e-d4d0ab8cfa4d",
                                "sense_id": "65e53bdd-e0a5-3252-8879-f0487f2210a1",
                                "text": "„Neue Eskalation der Gewalt zwischen Protestierenden und der türkischen Polizei: Die Beamten feuerten mit Tränengas auf etwa 10.000 Menschen, die in Soma - dem Ort des Grubenunglücks - die Absetzung der türkischen Regierung gefordert hatten.“"
                            },
                            {
                                "example_id": "dd2eae80-b738-464c-862e-a4424e137f92",
                                "sense_id": "65e53bdd-e0a5-3252-8879-f0487f2210a1",
                                "text": "„Das Grubenunglück in der türkischen Stadt Soma ist mir sehr nahgegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
