                        "sense_id": "6180cb4b-6ce7-35a0-90a4-e3b9389a466b",
                        "entry_id": "d17093f7-b39e-3b6c-8312-d649cfa8f302",
                        "glosses": [
                            "Toxicomane."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2f441420-3d7f-4c34-a934-f9bfeabb6b07",
                                "sense_id": "6180cb4b-6ce7-35a0-90a4-e3b9389a466b",
                                "text": "En fait, à ce stade, il avait l’impression qu'il n’était plus qu’un toxico qui avait besoin de son fix. Une question de vie ou de mort."
                            },
                            {
                                "example_id": "98e5bd16-f622-4d8d-821a-fca555c2e26d",
                                "sense_id": "6180cb4b-6ce7-35a0-90a4-e3b9389a466b",
                                "text": "J’ai connu assez de toxicos pour savoir qu’on le reste toujours, que la rechute complote …."
                            },
                            {
                                "example_id": "2f2754c1-782e-4642-bdf2-337921bc5c53",
                                "sense_id": "6180cb4b-6ce7-35a0-90a4-e3b9389a466b",
                                "text": "– J’aimerais pourtant que tu m’aides. Kate était défoncée quand on l’a assassinée : tu étais au courant de son passé de toxico ?"
                            }
                        ]
                    }
