                        "glosses": [
                            "verwijderen van gegevens die zouden kunnen leiden tot de identificatie van de persoon waarover het gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c51cb0-5634-4c6a-86de-2928c66df04c",
                                "sense_id": "56177579-55f5-350a-b201-55c762bf00cf",
                                "text": "Maar er is één risico: wie op de een of andere manier de unieke stemcodes kan achterhalen, weet ook meteen wie wat heeft gestemd. In tegenstelling tot bij anonimisering kun je bij pseudonimisering mensen opnieuw identificeren."
                            },
                            {
                                "example_id": "52c34409-51af-4a61-9209-8823247001e0",
                                "sense_id": "56177579-55f5-350a-b201-55c762bf00cf",
                                "text": "Het OM is met de rechtbank in gesprek over de anonimisering. Het principe wordt volgens een woordvoerder zelden toegepast, maar onlangs nog wel in de Amsterdamse zedenzaak."
                            }
                        ]
                    }
