{
    "word_family": [
        "жесткость",
        "жестко",
        "жестковатый"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11f738b6-7ea7-3f72-8259-50d270c05357",
                    "sense_definition": "Твёрдый, плохо поддающийся деформации или разделению.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>жёсткий</w> матрас совсем не удобен для сна.",
                            "target_lang_translations": {
                                "en": "This <w>hard</w> mattress is not comfortable for sleeping at all."
                            }
                        },
                        {
                            "text": "Для строительства фундамента нужен <w>жёсткий</w> материал.",
                            "target_lang_translations": {
                                "en": "A <w>hard</w> material is needed for building the foundation."
                            }
                        }
                    ],
                    "synonyms": [
                        "твёрдый",
                        "прочный"
                    ],
                    "antonyms": [
                        "мягкий",
                        "гибкий"
                    ],
                    "common_phrases": [
                        "жёсткий пластик",
                        "жёсткий материал"
                    ],
                    "target_lang_definitions": {
                        "en": "Solid, firm, and resistant to pressure or deformation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "General term for solid, firm objects resistant to pressure."
                            },
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "Used for objects that are rigid and difficult to bend."
                            },
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "Used for materials that are strong, resilient, and hard to break."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be771fb9-1fd1-3050-b5c7-3877a208c460",
                    "sense_definition": "Содержащий значительную концентрацию солей (о воде).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом районе очень <w>жёсткая</w> вода, поэтому на кранах быстро появляется налёт.",
                            "target_lang_translations": {
                                "en": "The water in this area is very <w>hard</w>, so limescale builds up quickly on the faucets."
                            }
                        },
                        {
                            "text": "Чтобы смягчить <w>жёсткую</w> воду, необходимо использовать специальные фильтры.",
                            "target_lang_translations": {
                                "en": "To soften <w>hard</w> water, it is necessary to use special filters."
                            }
                        }
                    ],
                    "common_phrases": [
                        "жёсткая вода"
                    ],
                    "target_lang_definitions": {
                        "en": "Containing a high concentration of dissolved mineral salts, especially calcium and magnesium."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "Specifically used to describe water with high mineral content."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80b3feef-f783-3478-b8e3-71dc726751ad",
                    "sense_definition": "Оборудованный сиденьями или полками без мягкого покрытия.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы купили билеты в <w>жёсткий</w> вагон, так как других мест не было.",
                            "target_lang_translations": {
                                "en": "We bought tickets for the <w>hard-class</w> carriage because there were no other seats available."
                            }
                        },
                        {
                            "text": "Ехать всю ночь в <w>жёстком</w> вагоне было довольно утомительно.",
                            "target_lang_translations": {
                                "en": "Traveling all night in a <w>hard-class</w> carriage was quite tiring."
                            }
                        }
                    ],
                    "common_phrases": [
                        "жёсткий вагон"
                    ],
                    "target_lang_definitions": {
                        "en": "Equipped with seats or berths that lack soft padding or upholstery."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hard-class",
                                "target_lang_sense_clarification": "Used in the context of train travel to describe non-upholstered seating."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dd941bc-f95a-3f67-90a8-5782783268e3",
                    "sense_definition": "Суровый, грубый, не допускающий возражений или колебаний.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Начальник принял <w>жёсткое</w> решение уволить всех опоздавших сотрудников.",
                            "target_lang_translations": {
                                "en": "The boss made a <w>tough</w> decision to fire all the employees who were late."
                            }
                        },
                        {
                            "text": "Правительство ввело <w>жёсткие</w> меры для борьбы с экономическим кризисом.",
                            "target_lang_translations": {
                                "en": "The government introduced <w>strict</w> measures to combat the economic crisis."
                            }
                        }
                    ],
                    "synonyms": [
                        "суровый",
                        "грубый"
                    ],
                    "antonyms": [
                        "уступчивый"
                    ],
                    "common_phrases": [
                        "жёсткие меры",
                        "жёсткий контроль"
                    ],
                    "target_lang_definitions": {
                        "en": "Severe, strict, or uncompromising in nature or decision-making."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tough",
                                "target_lang_sense_clarification": "Used for strict measures or uncompromising stances."
                            },
                            {
                                "target_lang_word": "strict",
                                "target_lang_sense_clarification": "Used for rules or measures that allow no flexibility."
                            },
                            {
                                "target_lang_word": "harsh",
                                "target_lang_sense_clarification": "Used for severe or unforgiving actions."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}