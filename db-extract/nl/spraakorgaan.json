                        "entry_id": "bdcf26de-a7f3-318a-ac7b-37204825474f",
                        "glosses": [
                            "dat deel van de bovenste luchtwegen dat betrokken is bij het produceren van klanken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116e0d46-5643-4f30-8f89-ff4e677a6188",
                                "sense_id": "78c79217-a0b1-3623-8ea2-9ea54e71c460",
                                "text": "Toen onze spraakorganen zich nog aan het ontwikkelen waren, beschikten we nog niet over de fijne motoriek om, zeg maar, een woord als ‘schreeuwlelijk’ uit te spreken. De eerste woorden moeten de gemakkelijkst te realiseren zijn geweest."
                            },
                            {
                                "example_id": "5fbeb44f-eb9b-41e7-9013-daa8a781251f",
                                "sense_id": "78c79217-a0b1-3623-8ea2-9ea54e71c460",
                                "text": "Van anatomen en neurobiologen leende hij kennis over de bouw van het spraakorgaan en het oor, over het herkennen en verwerken van spraak, muziek en emoties."
                            }
                        ]
                    }
