                        "glosses": [
                            "foto die op de buitenkant van een boek of tijdschrift staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a634c871-12d0-4927-a9bd-a15876dc0e66",
                                "sense_id": "dbe881cf-7215-3a04-be0d-39e361f60cda",
                                "text": "Op de omslagfoto van het tijdschrift staan bekende vrouwen als actrice Ashley Judd, zangeres Taylor Swift en voormalig Uber-medewerkster Susan Fowler, met wier onthullingen de beweging begon. Ook op de foto staat een vrouw die haar gezicht niet laat zien."
                            },
                            {
                                "example_id": "c1463548-b0da-4c6e-9e71-9628b0ace0da",
                                "sense_id": "dbe881cf-7215-3a04-be0d-39e361f60cda",
                                "text": "Een vrouwelijke verdachte was bij de politie in beeld gekomen omdat ze de A7 als omslagfoto op haar Facebook had staan. Volgens haar \"ging het allemaal heel netjes en zijn er geen gekke dingen gebeurd\". Ook zij verklaarde dat het doel was om de bussen met betogers te vertragen, niet om ze tegen te houden."
                            }
                        ]
                    }
