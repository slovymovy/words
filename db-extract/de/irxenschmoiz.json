                "senses": [
                    {
                        "sense_id": "a90ef685-75cb-39b1-87e3-8d42f4d03a12",
                        "entry_id": "8fdd2ad0-0375-3227-9047-afa23356bfb6",
                        "glosses": [
                            "Muskelkraft im Arm"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "24287bd4-90d4-422e-b26c-9277af80db1d",
                                "sense_id": "a90ef685-75cb-39b1-87e3-8d42f4d03a12",
                                "text": "„Irxenschmoiz ist dabei gefragt, denn oft werden die Maibäume noch mit Schwaiben aufgestellt und nur mit Kran abgesichert.“"
                            },
                            {
                                "example_id": "81852fb7-72a9-4eda-99c2-28a2da2b6d46",
                                "sense_id": "a90ef685-75cb-39b1-87e3-8d42f4d03a12",
                                "text": "„An die 40 Männer aus Holzham hoben den Stamm in einer knapp zweistündigen Aktion mit Hilfe von Schwaiberln, Stacherln und Irxenschmoiz unter Leitung von Thomas Niedermaier in die Senkrechte.“"
                            },
                            {
                                "example_id": "ee5e5ce9-9b21-4b88-a5a7-4902699003af",
                                "sense_id": "a90ef685-75cb-39b1-87e3-8d42f4d03a12",
                                "text": "„Am 1. Mai ist wieder viel ‚Irxenschmoiz‘, also Muskelkraft gefragt: Denn in den meisten Gemeinden werden die meterhohen Maibäume noch ganz traditionell und ohne technische Hilfsmittel aufgestellt.“"
                            },
                            {
                                "example_id": "d654390b-4bf4-42e3-9d26-1fe2e475fa3d",
                                "sense_id": "a90ef685-75cb-39b1-87e3-8d42f4d03a12",
                                "text": "„Ausgerüstet mit einem PS-starken Bulldog und ordentlich Irxenschmoiz haben sich die Kapfhamerinnen in der Nacht zum Sonntag, 21. April, nach Schönberg aufgemacht, um sich dort den Maibaum der Gemeinde unter den Nagel zu reißen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
