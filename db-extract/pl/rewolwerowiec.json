                "senses": [
                    {
                        "sense_id": "618e1fd0-b23c-3b6f-a443-791c416588cb",
                        "entry_id": "608aebdd-9fe6-3dee-abca-3543e8579746",
                        "glosses": [
                            "osoba posługująca się zręcznie rewolwerem, biorąca udział w pojedynkach lub napadach, zwłaszcza w Stanach Zjednoczonych za czasów Dzikiego Zachodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447fff01-235c-49d1-add5-6214e22d32e9",
                                "sense_id": "618e1fd0-b23c-3b6f-a443-791c416588cb",
                                "text": "Kilka osób jakoby obserwowało pojedynek rewolwerowców przed saloonem."
                            },
                            {
                                "example_id": "a80a4873-82ad-418b-ac5f-de7fb90be128",
                                "sense_id": "618e1fd0-b23c-3b6f-a443-791c416588cb",
                                "text": "Wśród polskich rewolwerowców i bandziorów colt nie cieszy się aż taką popularnością."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
