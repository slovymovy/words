                                "target_senses": [
                                    {
                                        "sense_id": "14c30c7b-2e7a-3219-a076-f48ea520c740",
                                        "entry_id": "e165226f-6779-3125-ac90-f4b92fa9a8b7",
                                        "glosses": [
                                            "Groupe de vaisseaux de guerre sous un même chef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c693a60f-5348-4421-b1d1-92978b158cd5",
                                                "sense_id": "14c30c7b-2e7a-3219-a076-f48ea520c740",
                                                "text": "En 1585, des escadres anglaises avaient attaqué, sans déclaration de guerre, Saint-Domingue et Carthagène. Une année plus tard, Drake insulta Lisbonne et détruisit, à Cadix, une flotte entière de navires de transport."
                                            },
                                            {
                                                "example_id": "830379d2-1068-4a2c-8378-5994421aafd4",
                                                "sense_id": "14c30c7b-2e7a-3219-a076-f48ea520c740",
                                                "text": "Dans la nuit du 13 au 14 novembre 1854, les signes précurseurs d’une tempête vinrent éveiller les justes appréhensions des amiraux commandant les escadres alliées devant Sébastopol."
                                            },
                                            {
                                                "example_id": "303620df-1ab8-4510-9581-bbc7e62ec3df",
                                                "sense_id": "14c30c7b-2e7a-3219-a076-f48ea520c740",
                                                "text": "Radoubée et parée pour la course, la petite escadre réduite à la Normande et à la Dauphine, commença à descendre, sans doute à partir du début de janvier 1524, le long de la côte ibérique."
                                            },
                                            {
                                                "example_id": "8f629198-1fcb-484d-807b-ae61dca05c44",
                                                "sense_id": "14c30c7b-2e7a-3219-a076-f48ea520c740",
                                                "text": "Mais la vieille cité commerçante n’est pas armée pour abriter l’escadre qui lanterne dans ses eaux. Son port engorgé, les gros navires mouillent au large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9480fa5-a739-3faf-9b13-05eb1f0d62d8",
                                        "entry_id": "e165226f-6779-3125-ac90-f4b92fa9a8b7",
                                        "glosses": [
                                            "Groupe important d’unités aériennes, équivalant au régiment des forces terrestres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c7d2a0-38db-43cb-b4ec-0890eb4b5532",
                                                "sense_id": "f9480fa5-a739-3faf-9b13-05eb1f0d62d8",
                                                "text": "Escadre de chasse, de reconnaissance, de bombardement."
                                            },
                                            {
                                                "example_id": "0ed9f5e9-89c7-441f-b28e-15fafc352ca2",
                                                "sense_id": "f9480fa5-a739-3faf-9b13-05eb1f0d62d8",
                                                "text": "L’escadre aérienne regroupe, selon sa nationalité, plusieurs escadrons ou escadrilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
