                ],
                "senses": [
                    {
                        "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                        "entry_id": "d8b141f5-53b7-3cc6-aa64-b355b04efd8d",
                        "glosses": [
                            "mehr als die Hälfte der Regel betragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347652b9-5345-4530-b38f-9f961c4fa73e",
                                "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                                "text": "„Eine oberhälftige Teilzeitbeschäftigung ist zeitlich weiterhin unbegrenzt möglich.“"
                            },
                            {
                                "example_id": "708b72dd-3591-4586-98f8-e26c25513b29",
                                "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                                "text": "„Wie viele dieser Lehrkräfte sind teilzeitbeschäftigt, aufgeteilt in unter- und oberhälftig (bitte aufgeschlüsselt in männlich/weiblich und nach Regierungsbezirken)?“"
                            },
                            {
                                "example_id": "685860c5-5a7b-48a5-9ed8-f78c5b73b9b9",
                                "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                                "text": "„Herr Musterfrau wird in diesem Beispiel oberhälftig für die Betreuung in Modul II eingesetzt und unterstützt Frau Mustermann parallel in Modul I.“"
                            },
                            {
                                "example_id": "5a114ffd-fbba-4630-99ff-cc6c4ffb9eb7",
                                "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                                "text": "„Die oberhälftig fremdbestimmte und denaturierte Heidin erregt den Zorn ihres Gatten, der notwendig seinem error, d.i. die Informationsspanne (§1213) zwischen ihm und den Liebenden — das wohlinformierte Publikum eingeschlossen, verhaftet bleibt.“"
                            },
                            {
                                "example_id": "64995eee-31c3-4a4f-b72d-58ebdd7bdc9f",
                                "sense_id": "ec41b2ce-eff0-3ef8-a950-5fce4286644f",
                                "text": "„Dort zeigt sich: Es platzieren sich zwar auch in dieser Auswertung drei ostdeutsche Universitäten unter den ersten vierzig, doch ist darunter keine der oberhälftig platzierten Ost-Hochschulen aus der absoluten Betrachtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                        "entry_id": "d8b141f5-53b7-3cc6-aa64-b355b04efd8d",
                        "glosses": [
                            "im höher liegenden Teil befindlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c80cf58-94f7-491f-8d34-106622820deb",
                                "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                                "text": "„Alle Punkte, welche auf der oberhälftigen Kugel liegen, haben ihre Projektion innerhalb, alle Punkte auf der unteren Hälfte der Kugel haben ihre Projektion ausserhalb des Grundkreises.“"
                            },
                            {
                                "example_id": "5d386701-a84c-4f04-9b4d-be4b06cd323d",
                                "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                                "text": "„Die Wohnungstür, die sie aufschloß, bestand aus einem dunklen Holzrahmen, in dem oberhälftig vier Glasscheiben […]“"
                            },
                            {
                                "example_id": "8e54dc12-ece4-406b-9c25-940900bc0f13",
                                "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                                "text": "„Sie zeigte mir mein kleines Zimmer, das innerhalb ihrer Wohnung lag und dessen Tür oberhälftig aus undurchsichtigem Glas bestand.“"
                            },
                            {
                                "example_id": "59b347bb-279a-43bb-ae87-fd3bb0e30e4e",
                                "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                                "text": "„Im Horizont (B)B₁ deuten die oberhälftig angereicherten kaffeebraunen Wolken von fast Faustgröße auf bereits fortgeschrittene Ausfällungsvorgänge hin.“"
                            },
                            {
                                "example_id": "f6956d2e-3edf-4d66-a598-a76f38e77ca6",
                                "sense_id": "d26822af-d99c-3fc5-8633-a75af6379bc4",
                                "text": "„[…] das führt sehr oft zu der verwirrlichen Situation, daß Bilder über oder neben einem Text stehen – alle oberhälftigen Bilder und alle ganzseitigen auf Versoseiten, insgesamt 20 % -, zu dem sie nicht gehören.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
