                        "source_sense_id": "b331f263-178b-3556-aaf1-1a69ad0a9fd5",
                        "source_sense_description": "Reaktor, in dem Atomkerne durch Spaltung zur Energiegewinnung eingesetzt werden",
                        "target_lang_word": "nuclear reactor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear reactor",
