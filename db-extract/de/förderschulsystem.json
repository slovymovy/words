                "senses": [
                    {
                        "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                        "entry_id": "16d8b1a9-0ae2-3bd6-92c7-1eceb7d7230a",
                        "glosses": [
                            "Gesamtheit aller (organisatorischen) Regelungen, Bestimmungen und Vorgänge im Rahmen der Förderung und Bildung an Förderschulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e23c86-9529-43ea-b144-aac9d5e9188e",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„‚Wenn die ganzen Ressourcen, die jetzt im Förderschulsystem sind, in der Regelschule bereitgehalten würden, dann wäre auch dort eine angemessene Beschulung möglich, so wie wir das zum Beispiel in Finnland sehen‘, sagt sie.“"
                            },
                            {
                                "example_id": "0fdd2539-2958-42ef-abf9-2219ca0d4bde",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„Es sei versucht worden, das Förderschulsystem möglichst schnell abzuwickeln.“"
                            },
                            {
                                "example_id": "c46d2ca9-d1ff-4ec8-9dfd-6303fbca66cc",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„Im internationalen Vergleich beschreitet Deutschland demnach mit seinem differenzierten Förderschulsystem einen Sonderweg.“"
                            },
                            {
                                "example_id": "843b1fd0-ea5a-4eb8-afbc-5fceafc65ecb",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„Nirgend sonst auf der Welt gibt es ein so hochspezialisiertes Förderschulsystem wie in Deutschland.“"
                            },
                            {
                                "example_id": "9cbf361f-e59a-49bc-b3ac-c9ee85844f46",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„Den Erhalt der Förderschulen und eine gute Umsetzung der Inklusion hielt er schlicht für nicht bezahlbar. Er forderte deshalb das Ende des bisherigen Förderschulsystems.“"
                            },
                            {
                                "example_id": "664c505d-a231-492f-9212-585e93400adc",
                                "sense_id": "91e474ed-ad51-3129-b4ad-23acc0dc66f4",
                                "text": "„Für diese Eingrenzung spricht darüber hinaus die unterschiedliche schulorganisatorische und konzeptionelle Ausgestaltung der Förderschulsysteme in den einzelnen Bundesländern, die eine Übertragung der Ergebnisse problematisch machen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
