                ],
                "senses": [
                    {
                        "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                        "entry_id": "27296df4-6304-3b30-a79c-338fe8f2f109",
                        "glosses": [
                            "Trinkgefäß für Sekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3daf06df-32fc-4481-b31e-12c4f3a0a275",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "Gib mir mal das Sektglas."
                            },
                            {
                                "example_id": "5bb622f0-0991-48a2-9f01-c6a23eb06baf",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "Wo sind denn die Sektgläser?"
                            },
                            {
                                "example_id": "fa87f040-fd93-4b1d-a1b1-87caede9883f",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "„Fünf vor zwölf füllte der Kammerdiener Emil die Sektgläser und drehte das Radio auf höchste Lautstärke.“"
                            },
                            {
                                "example_id": "d3d7e622-f560-4c88-9461-2542fa8a414d",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "„Tante Alma hat mich gebeten, die Sektgläser zu polieren.“"
                            },
                            {
                                "example_id": "9a5c0b15-95b0-4e65-8049-763ad9c84643",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "„Er verpaßte mir eine solche Ohrfeige, daß mein Bademantel verrutschte und das Sektglas sich in tausend Splitter auflöste.“"
                            },
                            {
                                "example_id": "8fbe8055-0a2f-4c3d-8fb8-076ccd7d6203",
                                "sense_id": "79bbcdfa-5127-321a-80b1-91e28e48fecd",
                                "text": "„Er drehte sein Sektglas hin und her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
