                    "sense_definition": "Inspiré par de bons principes, bénéfique ou conforme à des normes éthiques ou écologiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a mis en place un cercle <w>vertueux</w> favorisant le recyclage."
