                    {
                        "translation_id": "ac855351-c216-40d2-bc38-7253ddf77fbc",
                        "source_entry_id": "f19be639-4fac-32ff-95d6-1fdd6ad8c023",
                        "source_sense_id": "32d14936-b089-3635-8061-8dcca11bb346",
                        "source_sense_description": "Wolle, die von Schafen gewonnen wird",
                        "target_lang_word": "schapenwol",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schapenwol",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                        "entry_id": "111309fc-3561-36b4-942e-eb6e17ee76a0",
                                        "glosses": [
                                            "lange krullende haren uit de vacht van het evenhoevig zoogdier Ovis aries gebruikt als materiaal waarmee weefsels worden gemaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825dea6e-d084-49c3-8744-a65f67d79de2",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Djengis Khan was de eerste die de stad verwoestte. De weg ernaartoe was namelijk van oudsher een belangrijke handelsweg, veel werd erover vervoerd naar India zoals fruit, kamelenhaar en schapenwol."
                                            },
                                            {
                                                "example_id": "ef2f1ae0-f186-4489-aea2-9f9db987c7c7",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Voor het hotel maakte hij gebruik van de ambachten uit de omgeving: Kihlgren huurde lokale bouwvakkers in voor de restauratie, liet de dekens maken van lokale schapenwol en liet zich voor het eten inspireren door de lokale keuken."
                                            },
                                            {
                                                "example_id": "dd5542ae-465f-4b0e-82f2-69318cb2f4ae",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Vilt, gemaakt uit schapenwol, is haar basismateriaal."
                                            },
                                            {
                                                "example_id": "8c5d6dd4-017c-4920-b589-a7e4ff942c8c",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Een groot deel van de jaarlijks geproduceerde anderhalf miljoen kilo Nederlandse schapenwol wordt vernietigd omdat er geen markt voor is. De waarde van wol is dusdanig gedaald dat schapenboeren er zelfs op moeten toeleggen om van hun scheerwol af te komen."
                                            },
                                            {
                                                "example_id": "a18829f1-1958-4882-b63f-708fe9c174d1",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Anno 2013 heeft UGG Australia de wereld verovert, maar heeft het zijn binding met zijn roots enigszins verloren. Steeds minder fans van de boots weten namelijk dat je dat heerlijke schapenwolletje eigenlijk ook in de zomer kan dragen, dat het toen zelfs ontworpen is, en dat het ook voor mannen toegankelijk is."
                                            },
                                            {
                                                "example_id": "95b1d4f5-d9f6-4c1f-9f3d-ef4cb2180c1b",
                                                "sense_id": "a2e5b0da-f279-3157-9914-a5c6e9815561",
                                                "text": "Wat opviel was dat patiënten heel vaak een directe relatie hadden met dieren. De een was boer, een ander had een echtgenote die schapenwol spon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
