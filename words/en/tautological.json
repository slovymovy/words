            "senses": [
                {
                    "sense_id": "2f4c06f2-18fc-3a60-9e74-d7116fab7883",
                    "sense_definition": "Relating to or involving a statement that is true by necessity or by virtue of its logical form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained that the <w>tautological</w> statement was true simply because of its structure."
                        },
                        {
                            "text": "In formal logic, a <w>tautological</w> expression provides no new information about the world."
                        }
                    ],
                    "synonyms": [
                        "self-evident"
                    ]
                },
                {
                    "sense_id": "4226623f-f8ea-3d8f-8e62-a2b3975d4c39",
                    "sense_definition": "Characterized by unnecessary repetition or excessive wordiness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "redundancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor removed the <w>tautological</w> phrases to make the essay more concise."
                        },
                        {
                            "text": "His writing style is often <w>tautological</w>, repeating the same point in different words."
                        }
                    ],
                    "synonyms": [
