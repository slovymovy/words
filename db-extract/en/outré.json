                                                "sense_id": "a92aa7f7-0524-3bb3-9942-9d8ba08deadb",
                                                "text": "Die Dame erschien in einem extravaganten Kleid."
                                            },
                                            {
                                                "example_id": "92044771-de1b-43c9-bfe9-468f96bff3cf",
                                                "sense_id": "a92aa7f7-0524-3bb3-9942-9d8ba08deadb",
                                                "text": "„Das Emirates Palace in Abu Dhabi ist so etwas wie der Primus unter den extravagantesten Hotels der Welt…“"
                                            },
                                            {
                                                "example_id": "34dc9931-d304-4a60-b05a-00f9bd30e6fe",
                                                "sense_id": "a92aa7f7-0524-3bb3-9942-9d8ba08deadb",
                                                "text": "„Die Beerdigung findet in extravaganter Atmosphäre in New York statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4faf9cd3-cd57-3013-825b-6bf797be463c",
                                        "entry_id": "07ce687e-9d78-3466-825f-2451728b3f14",
                                        "glosses": [
                                            "negativ bewertet: übertrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
