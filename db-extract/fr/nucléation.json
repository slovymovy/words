                "senses": [
                    {
                        "sense_id": "86389096-e675-3c51-bdae-5e3ac282a341",
                        "entry_id": "ce817195-8e54-3ab8-8399-b3847f5dc96d",
                        "glosses": [
                            "Étape initiale d’un changement de phase ou d’une réorganisation de la matière, au cours de laquelle apparaissent les premiers noyaux stables de la nouvelle phase ou structure."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "f4dd4d93-d1ab-44ca-831a-b4087475d9df",
                                "sense_id": "86389096-e675-3c51-bdae-5e3ac282a341",
                                "text": "La durée de la germination est liée également au degré de dépassement de la solubilité limite (GIROU et ROQUES, 1971). […]. Enfin, la présence de magnésium est susceptible d'augmenter le temps de nucléation (CAILLEAU et al, 1977)."
                            },
                            {
                                "example_id": "ccb20326-0555-4a85-a5bf-686230314b31",
                                "sense_id": "86389096-e675-3c51-bdae-5e3ac282a341",
                                "text": "La formation d’agrégats se décompose en deux étapes : une phase de nucléation correspondant à la création d’un germe et une phase de croissance où le germe grossit par accrétion d’atomes."
                            }
                        ]
                    },
                    {
                        "sense_id": "461b237e-b5d9-31cd-b6c4-6139618b8a8a",
                        "entry_id": "ce817195-8e54-3ab8-8399-b3847f5dc96d",
                        "glosses": [
                            "Processus par lequel des molécules présentes dans l’atmosphère s’agrègent pour former des noyaux de particules suffisamment stables pour croître."
                        ],
                        "tags": [
                            "Chimie atmosphérique"
