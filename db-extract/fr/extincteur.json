                ],
                "senses": [
                    {
                        "sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
                        "entry_id": "8a0e3574-486b-3777-a505-8080544a9a85",
                        "glosses": [
                            "Appareil dont on se sert pour éteindre les incendies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b065c91c-d33a-4edf-bef5-02e572f811c3",
                                "sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
                                "text": "Les unités de transport transportant des marchandises dangereuses conformément au 1.1.3.6 doivent être munies d'un extincteur d'incendie portatif adapté aux classes d'inflammabilité1 A, B et C, d'une capacité minimale de 2 kg d'agent anticombustion."
                            },
                            {
                                "example_id": "40681c75-a99f-43cd-958a-373c6bb9335d",
                                "sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
                                "text": "Le concierge surgit bientôt, armé d’un extincteur, et noya le début de sinistre dans un nuage de neige carbonique."
                            },
                            {
                                "example_id": "ce598dda-9e92-4efc-b98b-c41c073b7e2a",
                                "sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
                                "text": "Il y a tout de même une sacrée différence entre un extincteur et un lance-gaz, fit observer Eole."
                            },
                            {
                                "example_id": "d7429b41-cc81-437a-826b-a36e6daca652",
                                "sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
                                "text": "Le policier ainsi que les voisins ont réussi à circonscrire le feu à l'intérieur du garage, à l'aide d'un extincteur, et également à l'aide de la neige."
                            }
                        ]
                    },
                    {
                        "sense_id": "56496c3b-18d2-36aa-baa9-0713378b9e8f",
                        "entry_id": "8a0e3574-486b-3777-a505-8080544a9a85",
                        "glosses": [
                            "Entité moléculaire ou espèce chimique introduite dans une substance luminescente afin de supprimer l’émission lumineuse ou d’en réduire la durée."
                        ],
                        "tags": [
                            "Photochimie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e8a43fa-0959-4e30-9cfd-bc12b7ea72fc",
                        "source_entry_id": "8a0e3574-486b-3777-a505-8080544a9a85",
                        "source_sense_id": "90d09b22-4438-3a32-9943-8c61d5bc1a3c",
