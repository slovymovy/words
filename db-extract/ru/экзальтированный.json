                                                "example_id": "080e4fe8-888a-40db-b0dc-8701bbe7dde0",
                                                "sense_id": "8a99ceff-0888-3174-8e67-9d857b545786",
                                                "text": "exalted status"
                                            },
                                            {
                                                "example_id": "ad77b9d1-4fef-4d7d-90ad-f794cd66ee8b",
                                                "sense_id": "8a99ceff-0888-3174-8e67-9d857b545786",
                                                "text": "He spoke of the president in the most exalted terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd785761-4229-3c9c-b0b1-5547dd24a29d",
