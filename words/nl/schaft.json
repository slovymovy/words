{
    "word_family": [
        "schaften",
        "schafttijd",
        "schaftkeet",
        "schacht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a857c017-2a41-3ff9-adf7-6f90f33e0f56",
                    "sense_definition": "Een onderbreking van de arbeid om een maaltijd te nuttigen, met name door handarbeiders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pauze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>schaft</w> aten de bouwvakkers hun boterhammen op in de keet.",
                            "target_lang_translations": {
                                "en": "During the <w>lunch break</w>, the construction workers ate their sandwiches in the shed."
                            }
                        },
                        {
                            "text": "De opzichter riep dat het tijd was voor de <w>schaft</w>.",
                            "target_lang_translations": {
                                "en": "The foreman called out that it was time for the <w>break</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schafttijd",
                        "schaftpauze",
                        "eetpauze"
                    ],
                    "common_phrases": [
                        "tijd voor schaft"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vooral gebruikt onder handarbeiders en in de bouw."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A break from work to have a meal, especially by manual laborers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lunch break",
                                "target_lang_sense_clarification": "for manual workers"
                            },
                            {
                                "target_lang_word": "meal break",
                                "target_lang_sense_clarification": "during work"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7894644a-6edd-3c75-af42-b128c5f832a6",
                    "sense_definition": "Het massieve, centrale deel van een vogelveer tussen de spoel en de vlag.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "veer_anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>schaft</w> van de veer is hol aan de basis maar massief daarboven.",
                            "target_lang_translations": {
                                "en": "The <w>shaft</w> of the feather is hollow at the base but solid above it."
                            }
                        },
                        {
                            "text": "Hij bestudeerde de structuur van de <w>schaft</w> onder een vergrootglas.",
                            "target_lang_translations": {
                                "en": "He studied the structure of the <w>shaft</w> under a magnifying glass."
                            }
                        }
                    ],
                    "synonyms": [
                        "schacht"
                    ],
                    "target_lang_definitions": {
                        "en": "The solid, central part of a bird's feather between the calamus and the vane."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shaft",
                                "target_lang_sense_clarification": "of a feather"
                            },
                            {
                                "target_lang_word": "rachis",
                                "target_lang_sense_clarification": "anatomical term for feather shaft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27c6e84-b52e-3040-ba7c-facf231316f7",
                    "sense_definition": "Het langwerpige, schachtvormige deel van een anker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anker_onderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ketting is stevig bevestigd aan de <w>schaft</w> van het anker.",
                            "target_lang_translations": {
                                "en": "The chain is securely attached to the <w>shank</w> of the anchor."
                            }
                        },
                        {
                            "text": "Bij deze constructie is de <w>schaft</w> beweegbaar ten opzichte van de armen.",
                            "target_lang_translations": {
                                "en": "In this design, the <w>shaft</w> is movable relative to the arms."
                            }
                        }
                    ],
                    "synonyms": [
                        "ankersteel",
                        "schacht"
                    ],
                    "target_lang_definitions": {
                        "en": "The elongated, shaft-like part of an anchor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shaft",
                                "target_lang_sense_clarification": "of an anchor"
                            },
                            {
                                "target_lang_word": "shank",
                                "target_lang_sense_clarification": "of an anchor"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4949c6f3-ca93-34f8-bb56-83947b002229",
                    "sense_definition": "Gebogen vorm van <w>schaffen</w>: tweede en derde persoon enkelvoud tegenwoordige tijd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schaffen_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>schaft</w> elke week nieuwe boeken aan voor haar studie.",
                            "target_lang_translations": {
                                "en": "She <w>purchases</w> new books for her studies every week."
                            }
                        },
                        {
                            "text": "Wie <w>schaft</w> er tegenwoordig nog zulke dure apparaten aan?",
                            "target_lang_translations": {
                                "en": "Who still <w>buys</w> such expensive devices nowadays?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoeging van schaffen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Conjugated form of 'schaffen' (to purchase/acquire): second and third person singular present tense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purchases",
                                "target_lang_sense_clarification": "third-person singular of 'to purchase'"
                            },
                            {
                                "target_lang_word": "acquires",
                                "target_lang_sense_clarification": "third-person singular of 'to acquire'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6758d50-49ea-3329-935a-010a18e6fae5",
                    "sense_definition": "Gebogen vorm van <w>schaften</w>: eerste, tweede en derde persoon enkelvoud tegenwoordige tijd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schaften_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schaft</w> meestal rond een uur of twaalf samen met mijn collega's.",
                            "target_lang_translations": {
                                "en": "I usually <w>have my lunch break</w> around twelve o'clock with my colleagues."
                            }
                        },
                        {
                            "text": "De timmerman <w>schaft</w> op de bouwplaats.",
                            "target_lang_translations": {
                                "en": "The carpenter <w>is having his break</w> on the construction site."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoeging van schaften"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Conjugated form of 'schaften' (to have a meal break): first, second, and third person singular present tense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "has a break",
                                "target_lang_sense_clarification": "takes a lunch break"
                            },
                            {
                                "target_lang_word": "eats lunch",
                                "target_lang_sense_clarification": "during a work break"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}