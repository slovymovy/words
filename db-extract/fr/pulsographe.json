                        "glosses": [
                            "Tout appareil enregistreur de pulsation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ede29d-3cb5-4f01-a3a4-3a28e92babe0",
                                "sense_id": "cfa051ee-77a1-30fa-acc8-52b07ef90780",
                                "text": "Le contrôle de la pulsation s'effectue au moyen d'un pulsographe qui effectue un enregistrement de la variation du vide sur chacun des faisceaux trayeurs."
                            }
                        ]
