                                                "sense_id": "f7de4e1f-3f54-30e3-b20c-dc120efc4827",
                                                "text": "Zvedl se silný vítr, potom se obloha zatáhla a začalo pršet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "potom",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0d7db4b4-2822-3a82-8af7-d356eca07ea8",
