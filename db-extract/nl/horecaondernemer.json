                        "glosses": [
                            "iemand die een eigen bedrijf in de horeca heeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "ddfe30dc-ac1d-4524-b7fd-b8a13342ddfa",
                                "sense_id": "8a660e00-8af5-3235-ba8f-99259c228a2a",
                                "text": "De horecaondernemer deed goede zaken toen het buiten lekker warm werd."
                            },
                            {
                                "example_id": "f16c784b-df44-46eb-810b-296c818e9cf2",
                                "sense_id": "8a660e00-8af5-3235-ba8f-99259c228a2a",
                                "text": "Samen met Koninklijke Horeca Nederland, Jellinek preventie en het Centrum voor Criminaliteitspreventie en Veiligheid start volgend jaar een voorlichting voor ondernemers, zodat barmedewerkers beter inzicht krijgen in het moment waarop ze moeten stoppen met het schenken van alcohol. Een horecaondernemer mag iemand die dronken is geen alcohol meer schenken; daar zal volgend jaar op worden gecontroleerd. Bij overtreding kan (nu al) de drankvergunning voor een week worden ingetrokken."
                            },
                            {
                                "example_id": "9dcf66b9-dd34-4f20-8380-446e58ce1deb",
                                "sense_id": "8a660e00-8af5-3235-ba8f-99259c228a2a",
                                "text": "Daarom gaat de gemeente bestaande maatregelen verstevigen. Zo gaat ze inwoners en horecaondernemers beter informeren over hoe ze afval het beste kunnen opruimen en komen er meer afvalbakken. Ook geeft de gemeente woningcorporaties en bewoners advies over kieren en gaten in huizen, en hoe deze gedicht kunnen worden."
                            }
                        ]
                    }
