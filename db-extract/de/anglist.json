                        "sense_id": "9dc282d7-134c-3cf2-9fc7-d5c964f81e33",
                        "entry_id": "9354b181-e2c7-3a5d-92fc-4ddced1b9fb0",
                        "glosses": [
                            "Lehrer oder Wissenschaftler im Fach Anglistik; Person, die sich mit der englischen Sprache, der englischsprachigen Literatur und der Kultur des englischen Sprachraumes beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45884ec-3c19-496b-adf8-d212c4798e57",
                                "sense_id": "9dc282d7-134c-3cf2-9fc7-d5c964f81e33",
                                "text": "„Anglisten und Anglistinnen bzw. Amerikanisten und Amerikanistinnen können in unterschiedlichen Bereichen tätig sein. Beispielsweise lesen, prüfen und bearbeiten sie im Verlagswesen Manuskripte, entwickeln neue Medienprodukte und betreuen Autoren.“"
                            }
                        ],
