                    {
                        "translation_id": "615107bf-771d-431c-b7a0-43b52e28047b",
                        "source_entry_id": "880895f5-1f3e-383d-92b7-310f123cc372",
                        "source_sense_id": "c7f19f57-8016-3881-9824-75a651fa4d37",
                        "source_sense_description": "Measurement and description of navigable waters",
                        "target_lang_word": "hydrographie",
                        "target_lang_code": "fr",
