                        "entry_id": "d91c177f-3c9b-3583-923a-bbc46215425f",
                        "glosses": [
                            "One who punts a football."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cca5058f-b729-3c55-9044-0d1135253f64",
                        "entry_id": "d91c177f-3c9b-3583-923a-bbc46215425f",
                        "glosses": [
                            "A program used to forcibly disconnect another user from a chat room."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "97d066f7-2f82-4ac7-b5a1-5250133999a6",
                                "sense_id": "cca5058f-b729-3c55-9044-0d1135253f64",
                                "text": "Punters generate hundreds of information inquiries to a legitimate user's client, such as invitations to chat. […] The user is punted from the channel, and must rejoin to gain access."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce2bc32e-a0f5-47b0-b0cc-e6f177e32eae",
                        "source_entry_id": "d91c177f-3c9b-3583-923a-bbc46215425f",
                        "source_sense_description": "One who punts a football; one who propels a punt",
                        "target_lang_word": "Punter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Punter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6729f892-2fd3-3443-86b9-4ac7a3c2e9c5",
                                        "entry_id": "a8bcc1cb-3ff4-3b10-8c9c-2b19ff5db7ac",
                                        "glosses": [
                                            "Sportler, der einen Punt ausführt"
                                        ],
                                        "tags": [
                                            "American Football"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cfd5052-7dae-47bd-9cd5-7206903d9adc",
                                                "sense_id": "6729f892-2fd3-3443-86b9-4ac7a3c2e9c5",
                                                "text": "„In vielen Fällen, vor allem in Nähe der gegnerischen Endzone, versuchte man gar nicht erst, die fehlende Distanz für ein First Down zu holen, sondern ließ den Punter gleich beim ersten Versuch ans Werk.“"
                                            },
                                            {
                                                "example_id": "eff821a2-db82-4eb8-b8af-bdc8f0a61e82",
                                                "sense_id": "6729f892-2fd3-3443-86b9-4ac7a3c2e9c5",
                                                "text": "„Punter sind nicht unbedingt die gefragtesten Interview-Partner der Medienvertreter.“"
                                            },
                                            {
                                                "example_id": "79077148-fc2a-409d-bfb4-afec44f5f30c",
                                                "sense_id": "6729f892-2fd3-3443-86b9-4ac7a3c2e9c5",
                                                "text": "„Chris Kluwe ist einer, der mit der Macho-Kultur der NFL einschlägige Erfahrungen gemacht hat. Er war acht Jahre lang Punter bei den Minnesota Vikings und Teamkollege von Adrian Peterson.“"
                                            },
                                            {
                                                "example_id": "29b468f7-7e66-4563-a8f6-b3b859f235e1",
                                                "sense_id": "6729f892-2fd3-3443-86b9-4ac7a3c2e9c5",
                                                "text": "„Das Footballteam der University of Nebraska verlor vor wenigen Wochen seinen Punter Sam Foltz durch einen tragischen Autounfall, bei dem ein weiterer College-Footballer getötet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
