                                            {
                                                "example_id": "f4bfa43a-fcb9-4555-8f9b-5195487f1e55",
                                                "sense_id": "ffed2126-3c41-375e-9e7e-63e90835410d",
                                                "text": "Der berufliche Druck ist sehr belastend."
                                            },
                                            {
                                                "example_id": "1fef9be6-3939-4158-be7d-d0fca039b059",
                                                "sense_id": "ffed2126-3c41-375e-9e7e-63e90835410d",
                                                "text": "Für viele Mütter und Väter ist es in der Tat belastend, wenn ihr Kind nicht gut in der Schule ist."
                                            },
                                            {
                                                "example_id": "50ca43c0-5fee-477c-812a-5492bc027c4e",
                                                "sense_id": "ffed2126-3c41-375e-9e7e-63e90835410d",
                                                "text": "Einige Grundsatzurteile wie die zum Streichen und Renovieren seien für Vermieter aber „finanziell extrem belastend“, sagt GdW-Pressesprecherin Katharina Burkards, …"
                                            },
                                            {
                                                "example_id": "2290aa77-2f0c-4506-8ed2-c2556a603348",
                                                "sense_id": "ffed2126-3c41-375e-9e7e-63e90835410d",
                                                "text": "„Die belastenden Erlebnisse meiner mütterlichen und väterlichen Großeltern in Kriegs- und Nachkriegszeit wirken noch heute auf die Familie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "275a66f4-e804-3a83-b657-a93f1940663c",
                                        "entry_id": "f8bdf4f3-8754-311f-8c45-e9321ffed29b",
                                        "glosses": [
                                            "eine kriminelle Handlung vorwerfend, als Schuldbeweis dienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1b53b3-80be-4aab-b3ba-a95f2a117651",
                                                "sense_id": "275a66f4-e804-3a83-b657-a93f1940663c",
                                                "text": "Über Generationen hinweg bereiten sie den Aufstieg einzelner vor und organisieren belastendes Material über diejenigen, die ihnen im Weg stehen."
                                            },
                                            {
                                                "example_id": "56fc0673-25c5-414e-933f-32b633f4af1e",
                                                "sense_id": "275a66f4-e804-3a83-b657-a93f1940663c",
                                                "text": "Im Dopingfall Alberto Contador liegen womöglich weitere belastende Indizien gegen den dreimaligen Toursieger vor."
                                            },
                                            {
                                                "example_id": "e9351e9b-af29-48b2-886f-c17c3494a152",
                                                "sense_id": "275a66f4-e804-3a83-b657-a93f1940663c",
                                                "text": "Nach Angaben von Kassandras Anwalt ist das Mädchen in der vergangenen Monaten von einem Team von Psychologen auf die belastende Zeugenaussage vorbereitet worden."
                                            }
