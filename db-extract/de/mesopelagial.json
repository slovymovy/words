                ],
                "senses": [
                    {
                        "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                        "entry_id": "9c34f8e8-fa0e-3900-8224-1e9c52a682bd",
                        "glosses": [
                            "Wasserschicht des Meeres oder eines Sees, die von 200 bis 1.000 Metern Tiefe reicht"
                        ],
                        "tags": [
                            "Biogeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "dda45eaf-7340-4689-84b3-14ddde2174ba",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Im Mesopelagial erstirbt das Licht in der Tiefe, zugleich steigt der Wasserdruck."
                            },
                            {
                                "example_id": "232d2cc2-bc4b-42be-8855-5db8259625f8",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Die ersten Menschen, welche sich aus eigener Anschauung ein Bild der Verhältnisse im Mesopelagial machen konnten, waren William Beebe und Otis Barton."
                            },
                            {
                                "example_id": "f5218e5a-2708-4b87-a1ca-e24fa4a834b2",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Viele Vertreter des Mesozooplanktons und des Makrozooplanktons lassen sich nicht eindeutig dem Epipelagial oder dem Mesopelagial zuordnen, da sie täglich zwischen beiden Zonen hin und her wandern."
                            },
                            {
                                "example_id": "a9a8d279-2cf0-44a4-92da-fa6541209a13",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Der Lebensraum der ebenfalls zur Familie der Requiemhaie gehörenden Seidenhaie (Carcharhinus falciformis) liegt in tropischen und subtropischen Meeren im Mesopelagial bis zu einer maximalen Wassertiefe von rund 500 Metern."
                            },
                            {
                                "example_id": "477e0d43-edc3-48eb-9dc3-fcd2316fc9ba",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Ebenfalls im Mesopelagial der subtropischen Meeresregionen treibt sich der bis zu 2 Meter große Hundshai (Galeorhinus galeus) aus der Familie der Glatthaie bis in 550 Meter Tiefe herum."
                            },
                            {
                                "example_id": "f7b0f90a-9835-4967-8d0e-0dc12119e097",
                                "sense_id": "cad0aadc-279a-311d-841f-8d7be238a29b",
                                "text": "Im Mesopelagial leben beispielsweise die Tiefsee-Beilfische."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
