                "senses": [
                    {
                        "sense_id": "a4b496db-53a7-3577-945c-f2fd415f1f9a",
                        "entry_id": "70ab47a8-4bff-38ae-a390-2d445c318463",
                        "glosses": [
                            "niet al te precies; geneigd tot het sluiten van compromissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04490de-9cb8-448a-bc45-e7805e4afa4f",
                                "sense_id": "a4b496db-53a7-3577-945c-f2fd415f1f9a",
                                "text": "De ECB, die al een paar keer eerder als reddende engel optrad, is gevangen in een titanenstrijd tussen (Duitse) haviken, gebrand op haar geloofwaardigheid als inflatiebestrijder, en de rekkelijken (de rest)."
                            },
                            {
                                "example_id": "1f18d3c0-92b1-4137-8398-808eec66cd1c",
                                "sense_id": "a4b496db-53a7-3577-945c-f2fd415f1f9a",
                                "text": "Ik meende altijd dat ik rekkelijk was, maar in mijn rekkelijkheid ben ik vervelend precies."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ec9b3ac-454c-302d-9b3e-f641f7e548cb",
                        "entry_id": "70ab47a8-4bff-38ae-a390-2d445c318463",
                        "glosses": [
                            "van iets dat je het ruim kunt opvatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75baef9a-881e-4df7-bc44-4aaceeb9f61a",
                                "sense_id": "3ec9b3ac-454c-302d-9b3e-f641f7e548cb",
                                "text": "De soberheid waar François Hollande zich tijdens zijn campagne op liet voorstaan, blijkt een rekkelijk begrip."
                            }
                        ]
                    },
