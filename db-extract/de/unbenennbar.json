                        "form": "es ist unbenennbar"
                    },
                    {
                        "form_id": "5df0154d-43ba-4c11-9167-b8a09024df2f",
                        "entry_id": "4f01e70d-8ae7-3981-889f-fc9b07bcf4ff",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbenennbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                        "entry_id": "4f01e70d-8ae7-3981-889f-fc9b07bcf4ff",
                        "glosses": [
                            "so, dass es nicht benannt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6db7a2-f258-408f-95bc-8f21081a5b92",
                                "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                                "text": "„Keine der Eigenschaften, die wir an existierenden Wesen kennen, findet Anwendung auf jenen Ursprungsgrund. Er ist für uns ebenso unbegreiflich wie unbenennbar.“"
                            },
                            {
                                "example_id": "1bc65a8d-cc92-4bab-9250-34ff858c8798",
                                "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                                "text": "„Endlich war der Kronprinz schwer erkrankt. Die Krankheit war von solcher Art, wie in jungen Jahren auch des Vaters Krankheiten gewesen waren: jäh, erschreckend, verzehrend und unbenennbar, wenn sie wie ein Sturm verflogen waren!“"
                            },
                            {
                                "example_id": "1f1216b6-d23d-465a-8832-93b61d8b3287",
                                "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                                "text": "„Denn Gut und Böse stehen unbenennbar, als Namenlose, außerhalb der Namensprache, in welcher der paradiesische Mensch die Dinge benannt hat und die er im Abgrund jener Fragestellung verläßt.“"
                            },
                            {
                                "example_id": "f5b56995-ab88-4353-8d95-a1f9547ccdc4",
                                "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                                "text": "„[»Sein des Seienden«], das kein höchstes oder begründendes Sein wäre und deswegen unarretierbar und unbenennbar bleibt ….“"
                            },
                            {
                                "example_id": "fa66a0e2-ac11-4b7a-97e9-f744222360f6",
                                "sense_id": "c7dc1406-c37c-3c1d-98f7-b0ebd82d4b7f",
                                "text": "„Diese transparenten Formen erinnern den Betrachter unmittelbar an natürliche ozeanische Gebilde und bleiben dennoch unbenennbar abstrakt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
