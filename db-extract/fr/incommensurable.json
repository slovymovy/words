                                        "entry_id": "997783af-c467-30bc-af05-2b0bb800d70f",
                                        "glosses": [
                                            "Out of proportion (in size, degree or extent) with something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "266aaf76-8dc0-42f1-870a-e5cdd7b73379",
                                                "sense_id": "23f2cf90-c06c-3a18-b6ed-3eef1c94cc4a",
                                                "text": "In the marriage of Inanna and Dumuzi we saw a commensurate relationship between the two, a marriage of Heaven and earth, but now in the fall of Inanna into hell, the relationship becomes incommensurate."
                                            }
                                        ]
