                                        "entry_id": "9d528770-6a8b-37b1-bc05-1d82fe88142b",
                                        "glosses": [
                                            "The variation or deviation from a standard, especially the maximum permitted variation in an engineering measurement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1ca26a-b295-4725-95ab-d19a60904faf",
                                                "sense_id": "90af0a04-c15c-3bd3-a8de-94e65f1edab3",
                                                "text": "Our customers can generally accept ten times the tolerance which we can achieve in our machining operations."
