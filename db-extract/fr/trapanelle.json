                "senses": [
                    {
                        "sense_id": "f3e012da-833a-3724-99c3-2b042f958a91",
                        "entry_id": "4d333513-c6ed-39b7-9639-0c709e4e9da4",
                        "glosses": [
                            "Petit avion à hélice de faible puissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abeff498-17c6-4876-96b9-c8b64c4b580f",
                                "sense_id": "f3e012da-833a-3724-99c3-2b042f958a91",
                                "text": "Quant à nos avions, nous volions sur Morane 500, monoplan à la silhouette fort disgracieuse. Ces trapanelles étaient dotées de grandes ailes hautes et larges qui leur valaient une excellente portance."
                            }
                        ]
                    },
                    {
                        "sense_id": "82057e54-c4c4-3e62-9470-5b7bc7abf349",
                        "entry_id": "4d333513-c6ed-39b7-9639-0c709e4e9da4",
                        "glosses": [
                            "Avion aux performances d'un autre âge."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "994cdea5-4b57-45d0-a8e4-8431e88147f6",
                                "sense_id": "82057e54-c4c4-3e62-9470-5b7bc7abf349",
                                "text": "Par-dessus le marché, après le ronron majestueux du Rolls-Royce de nos Spitfire, le moteur de cette trapanelle tourne comme un vieux moulin à café avec ses soupapes jouant les castagnettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "861c7366-c470-38aa-b39e-748ef16c23fc",
                        "entry_id": "4d333513-c6ed-39b7-9639-0c709e4e9da4",
                        "glosses": [
                            "Vieux camion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c2c212f-85e2-3b87-9360-a1cafe1f04da",
                        "entry_id": "4d333513-c6ed-39b7-9639-0c709e4e9da4",
                        "glosses": [
                            "Vieille voiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4a27b0-728d-4891-8a7e-4d201c8b1930",
                                "sense_id": "2c2c212f-85e2-3b87-9360-a1cafe1f04da",
                                "text": "Bon, je te ramène à ta trapanelle ? — Elle tourne comme une horloge ma trapanelle !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c169d7-6aba-3827-bb6e-cd3845cd95c3",
                        "entry_id": "4d333513-c6ed-39b7-9639-0c709e4e9da4",
                        "glosses": [
                            "Vieille moto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31af2c00-5b78-4767-8cfc-82577245c03b",
                                "sense_id": "c3c169d7-6aba-3827-bb6e-cd3845cd95c3",
                                "text": "Chaque matin, par espièglerie, je garais systématiquement la rutilante Mercedes de mon épouse sur le parking de service, juste à côté de la vieille trapanelle de mon directeur… histoire de le faire maronner à la convoitise."
                            },
                            {
                                "example_id": "e516bd7a-b10c-41bc-9f54-524791b38a6d",
                                "sense_id": "c3c169d7-6aba-3827-bb6e-cd3845cd95c3",
                                "text": "Trapanelle vieille voiture sans permis"
                            }
                        ]
                    }
