                },
                {
                    "sense_id": "97f179e1-2648-3577-831e-3defe4bd358d",
                    "sense_definition": "An adult female cat that has not been spayed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeder kept the <w>queen</w> in a quiet room with her new kittens.",
                            "target_lang_translations": {
                                "ru": "Заводчик держал <w>кошку</w> в тихой комнате с ее новорожденными котятами.",
                                "zh": "繁育者把这只<w>母猫</w>和它刚出生的小猫安置在一个安静的房间里。"
                            }
                        },
                        {
                            "text": "A pregnant <w>queen</w> requires special nutrition and care.",
                            "target_lang_translations": {
                                "ru": "Беременная <w>кошка</w> требует особого питания и ухода.",
                                "zh": "怀孕的<w>母猫</w>需要特殊的营养和照顾。"
                            }
                        }
