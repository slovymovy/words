                        "sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
                        "entry_id": "5208d327-41be-388c-9fe6-7ff60649bc1a",
                        "glosses": [
                            "Een koekenpan (Nederlands-Nederlands) of kortweg pan (Belgisch-Nederlands) is een platte pan met een lang handvat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54114284-3d12-4657-82cb-5198a975e27f",
                                "sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
                                "text": "Wij bakken pannenkoeken in een koekenpan."
                            },
                            {
                                "example_id": "05c76d73-6fc8-4f1d-8982-0d1d88fdf120",
                                "sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
                                "text": "Het familierecord in het schoonmaken en fileren van een bot of schol zodat hij klaar was voor de koekenpan was veertien seconden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "782c314f-3c19-41c9-9cc7-6668bcdef0f0",
                        "source_entry_id": "5208d327-41be-388c-9fe6-7ff60649bc1a",
                        "source_sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
                        "source_sense_description": "een platte pan met een lang handvat",
                        "target_lang_word": "Bratpfanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bratpfanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                        "entry_id": "79cd26ca-d8d1-3cf4-b382-a17a3ffd3e56",
                                        "glosses": [
                                            "Küchengerät zum Braten von Fisch, Fleisch, Kartoffeln, Nudeln, …"
                                        ],
                                        "tags": [
                                            "Haushalt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ac7591-8feb-4b56-a755-bd50ee6626ae",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "Unsere Bratpfanne muss mal gründlich gesäubert werden."
                                            },
                                            {
                                                "example_id": "50d07f64-d0a8-4c3a-853c-1d21009ee761",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "„Keine fünf Minuten später brutzelte ich Speck und Rühreier in einer Bratpfanne, während er einen Eimer Wasser aus dem Kühlkasten holte und Tee zu kochen begann.“"
                                            },
                                            {
                                                "example_id": "6ea75d3f-1c76-4051-9889-58d4f2c4d039",
                                                "sense_id": "b9182605-3e9e-32b7-8f64-06785663fcd7",
                                                "text": "„Die mag zwar, an normalen Maßstäben gemessen, dürftig sein, jetzt aber haben Betten und Stühle, Kochtopf und Bratpfanne einen unschätzbaren Wert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7e5d0fc-0108-4526-ac91-ce6b3ec26976",
                        "source_entry_id": "5208d327-41be-388c-9fe6-7ff60649bc1a",
                        "source_sense_id": "396aec0f-c4c6-30ff-b039-281a31ef5dbe",
