                "senses": [
                    {
                        "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                        "entry_id": "6b9f7abb-d5d6-3a7c-8ed7-3c37a4deb0e3",
                        "glosses": [
                            "Person, die im Freien, ohne dafür eine Sanitäranlage zu nutzen, uriniert"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "20b11f7c-a7a9-41bc-86c0-7917f333daa6",
                                "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                                "text": "Die Stadtverwaltung sagt Wildpinklern den Kampf an."
                            },
                            {
                                "example_id": "6cf411d2-de3e-431b-a203-5c451aa0c59c",
                                "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                                "text": "„Der Kölner Dom wird so häufig Opfer von Wildpinklern, dass die Säure im Urin bereits die Domtüren angreift.“"
                            },
                            {
                                "example_id": "4685077f-660c-471a-a36a-fb5689b4372e",
                                "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                                "text": "„San Francisco: Wildpinkler bringen Laternenmast zum Umkippen“"
                            },
                            {
                                "example_id": "6d08e163-c125-4cf3-8ee0-edcc59d5eade",
                                "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                                "text": "„Das Problem ist nicht neu. Rund um das Rathaus wurden bereits Hecken gestutzt, um Wildpinklern den Sichtschutz zu nehmen.“"
                            },
                            {
                                "example_id": "752f6952-5125-4f11-9b02-bc8f714b59d3",
                                "sense_id": "ab6160d1-471a-3e13-be10-89b35f0e570c",
                                "text": "„650 Dixie-Klos und Urinale sollen Wildpinkler stoppen, 30 Streetworker allein am Rheinufer Jugendliche vom Komasaufen abhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
