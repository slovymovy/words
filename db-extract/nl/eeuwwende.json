                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0e0ab1-c29b-4c89-ba53-87d5444fcc1b",
                                "sense_id": "89b2b122-22d5-3bf9-8f60-8b188bbd10ca",
                                "text": "Na de eeuwwende schurkte Khashoggi steeds meer aan tegen de machthebbers. Zo was hij bevriend met prins Turki bin-Faisal, een voormalig hoofd van de Saoedische geheime dienst."
                            },
                            {
                                "example_id": "800743e6-e2b5-4402-bbac-e808beb8a89a",
                                "sense_id": "89b2b122-22d5-3bf9-8f60-8b188bbd10ca",
                                "text": "Hoe lang heb ik al compassie met de Engelsen? In ieder geval sinds de eeuwwende al."
                            },
                            {
                                "example_id": "f4aee749-0b14-4bfe-8bd1-58f58b871957",
                                "sense_id": "89b2b122-22d5-3bf9-8f60-8b188bbd10ca",
                                "text": "Prof. Nissen wil echter geen waardeoordeel geven over deze religieuze herleving. „Ik ben historicus en probeer zo goed mogelijk te begrijpen. Ik laat me dus niet uit over de vraag of deze mystiek waar of vals is, zoals gedaan is rond de eeuwwende van 1900."
                            }
                        ]
                    }
