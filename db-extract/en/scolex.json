                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6620e409-91b5-4222-8ee9-fee308fd5104",
                                                "sense_id": "2aba19a8-2b14-3968-97df-4b46df873594",
                                                "text": "Zapałka zapala się przez potarcie jej główki o draskę na pudełku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
