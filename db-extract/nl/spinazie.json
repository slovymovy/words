                                "sense_id": "8e16f7b6-b806-3b96-93ca-95ba41d704bc",
                                "text": "Spinazie groeit niet goed op een zure grond."
                            },
                            {
                                "example_id": "17d5e76e-9e69-4c73-83f0-0780dca4a149",
                                "sense_id": "8e16f7b6-b806-3b96-93ca-95ba41d704bc",
                                "text": "De spinazie zaait u op regels in de volle grond. Om voortdurend te kunnen oogsten, kunt u het beste regelmatig kleine hoeveelheden zaaien."
                            }
                        ]
                    }
