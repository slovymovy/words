                        "glosses": [
                            "наречие к подражательный; подражая кому-либо, чему-либо"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "cc78e3d9-e5c9-4b3a-9d75-e51f5f5dd73a",
                                "sense_id": "5c2277f0-eb19-3864-9163-6e46d7fd2bde",
                                "text": "Большая часть пишут подражательно с чужого голоса; в них действует пленной мысли раздраженье, по выражению Лермонтова."
                            },
                            {
                                "example_id": "5d53dcff-a395-4d06-9c3e-03b42ca670c0",
                                "sense_id": "5c2277f0-eb19-3864-9163-6e46d7fd2bde",
                                "text": "Забулькал-зарокотал, полня собой небо, отрадный гром, чтобы подражательно, бодрыми голосами помощников отозвались собаки."
                            }
                        ]
                    }
