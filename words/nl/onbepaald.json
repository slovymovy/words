{
    "word_family": [
        "bepalen",
        "bepaling",
        "bepaaldheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bdf315e-2726-31a1-b9d4-dcd059eaf277",
                    "sense_definition": "Niet precies vastgesteld of geformuleerd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>onbepaalde</w> tijd afgesproken voor het project.",
                            "target_lang_translations": {
                                "it": "È stato concordato un tempo <w>indeterminato</w> per il progetto.",
                                "ru": "Для проекта был согласован <w>неопределенный</w> срок."
                            }
                        },
                        {
                            "text": "De datum van het feest is nog <w>onbepaald</w>.",
                            "target_lang_translations": {
                                "it": "La data della festa è ancora <w>indeterminata</w>.",
                                "ru": "Дата праздника еще <w>не определена</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onzeker"
                    ],
                    "antonyms": [
                        "bepaald"
                    ],
                    "common_phrases": [
                        "onbepaalde tijd"
                    ],
                    "target_lang_definitions": {
                        "it": "Non stabilito o formulato con precisione.",
                        "ru": "Не установленный или не сформулированный точно."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "indeterminato",
                                "target_lang_sense_clarification": "riferito a tempo o durata non fissati"
                            },
                            {
                                "target_lang_word": "non definito",
                                "target_lang_sense_clarification": "riferito a qualcosa che manca di una definizione precisa"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в значении не имеющий точных рамок или сроков"
                            },
                            {
                                "target_lang_word": "неустановленный",
                                "target_lang_sense_clarification": "в значении не зафиксированный официально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1362f569-6464-3452-82bc-343ba9810715",
                    "sense_definition": "Niet zeker of niet vaststaand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitkomst van de wedstrijd blijft <w>onbepaald</w> tot het laatste fluitsignaal.",
                            "target_lang_translations": {
                                "it": "L'esito della partita rimane <w>incerto</w> fino al fischio finale.",
                                "ru": "Исход матча остается <w>неопределенным</w> до финального свистка."
                            }
                        },
                        {
                            "text": "Hij keek met een <w>onbepaalde</w> blik uit het raam.",
                            "target_lang_translations": {
                                "it": "Guardava fuori dalla finestra con uno sguardo <w>indefinito</w>.",
                                "ru": "Он смотрел в окно с <w>неопределенным</w> выражением лица."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzeker"
                    ],
                    "antonyms": [
                        "bepaald"
                    ],
                    "target_lang_definitions": {
                        "it": "Non certo o non stabilito.",
                        "ru": "Не уверенный или не окончательный."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "incerto",
                                "target_lang_sense_clarification": "riferito a un esito o una situazione non sicura"
                            },
                            {
                                "target_lang_word": "indefinito",
                                "target_lang_sense_clarification": "riferito a uno sguardo o un'espressione vaga"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "в значении нечеткий или сомнительный"
                            },
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в значении не имеющий четкого выражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89996bdf-6613-33cd-903e-50915e191edf",
                    "sense_definition": "Niet duidelijk om wie of wat het gaat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er klonk een <w>onbepaald</w> geluid in de gang.",
                            "target_lang_translations": {
                                "it": "Nel corridoio si è sentito un rumore <w>indefinito</w>.",
                                "ru": "В коридоре послышался <w>неопределенный</w> звук."
                            }
                        },
                        {
                            "text": "De dader had een <w>onbepaalde</w> leeftijd.",
                            "target_lang_translations": {
                                "it": "Il colpevole aveva un'età <w>indeterminata</w>.",
                                "ru": "Преступник был <w>неопределенного</w> возраста."
                            }
                        }
                    ],
                    "synonyms": [
                        "onduidelijk"
                    ],
                    "antonyms": [
                        "bepaald"
                    ],
                    "target_lang_definitions": {
                        "it": "Non chiaro riguardo a chi o cosa si tratti.",
                        "ru": "Непонятно, о ком или о чем идет речь."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "indefinito",
                                "target_lang_sense_clarification": "riferito a qualcosa di vago o non identificabile"
                            },
                            {
                                "target_lang_word": "vago",
                                "target_lang_sense_clarification": "riferito a un suono o un'identità poco chiara"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в значении не поддающийся идентификации"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "в значении смутный или трудноразличимый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c11fafe5-7012-3afd-834a-360aadc6dfc7",
                    "sense_definition": "Zonder duidelijke grenzen of beperkingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbepaaldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het getal is <w>onbepaald</w> in deze wiskundige context.",
                            "target_lang_translations": {
                                "it": "Il numero è <w>indeterminato</w> in questo contesto matematico.",
                                "ru": "Это число является <w>неопределенным</w> в данном математическом контексте."
                            }
                        },
                        {
                            "text": "De ruimte leek <w>onbepaald</w> door de mist.",
                            "target_lang_translations": {
                                "it": "Lo spazio sembrava <w>illimitato</w> a causa della nebbia.",
                                "ru": "Из-за тумана пространство казалось <w>безграничным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grenzeloos"
                    ],
                    "antonyms": [
                        "bepaald"
                    ],
                    "target_lang_definitions": {
                        "it": "Senza confini o limitazioni chiare.",
                        "ru": "Без четких границ или ограничений."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "indeterminato",
                                "target_lang_sense_clarification": "riferito a concetti matematici o spaziali senza limiti"
                            },
                            {
                                "target_lang_word": "illimitato",
                                "target_lang_sense_clarification": "riferito a uno spazio che sembra non avere confini"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в математическом или абстрактном контексте"
                            },
                            {
                                "target_lang_word": "безграничный",
                                "target_lang_sense_clarification": "в значении не имеющий видимых пределов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}