                    {
                        "sense_id": "46a8504f-f35c-30c1-b1ff-49cecfb6ed4a",
                        "entry_id": "ffb60dc2-bad3-3d55-bcbb-f8e69ce743c6",
                        "glosses": [
                            "ein bestimmter am Boden von Gewässern lebender Fisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59fdcfd-8899-41e1-bec7-2010507dae20",
                                "sense_id": "46a8504f-f35c-30c1-b1ff-49cecfb6ed4a",
                                "text": "Der Gründling ist ein gesellig lebender Karpfenfisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfe38494-f0e5-40a0-a9cd-f180a7f5cd0e",
                        "source_entry_id": "ffb60dc2-bad3-3d55-bcbb-f8e69ce743c6",
                        "source_sense_id": "46a8504f-f35c-30c1-b1ff-49cecfb6ed4a",
                        "source_sense_description": "Zoologie: ein bestimmter am Boden von Gewässern lebender Fisch",
                        "target_lang_word": "gudgeon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gudgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8476a528-c75f-3e21-9280-38c8e9b23474",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "A small freshwater fish, Gobio gobio, that is native to Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e5384b-8a9c-487d-a7d3-444bd609699f",
                                                "sense_id": "8476a528-c75f-3e21-9280-38c8e9b23474",
                                                "text": "[...] Ile tell thee more of this another time. / But fiſh not with this melancholy baite, / For this foole gudgin, this opinion: [...]"
                                            },
                                            {
                                                "example_id": "5dc067f8-f844-4a7e-895f-3ab35b475ca5",
                                                "sense_id": "8476a528-c75f-3e21-9280-38c8e9b23474",
                                                "text": "[...] Make Fools believe in their fore-seeing / Of things before they are in Being; / To swallow Gudgeons ere th' are catch'd, / And count their Chickens ere th' are hatch'd, [...]"
                                            },
                                            {
                                                "example_id": "b645cda6-753c-4cbd-ae47-83018f2ac76f",
                                                "sense_id": "8476a528-c75f-3e21-9280-38c8e9b23474",
                                                "text": "The Gudgeon is reputed a fish of excellent taste, and to be very wholesome: he is of a fine shape, of a silver colour, and beautified with black spots both on his body and tail."
                                            },
                                            {
                                                "example_id": "a840adee-8aec-488d-a54c-e960b0cf3052",
                                                "sense_id": "8476a528-c75f-3e21-9280-38c8e9b23474",
                                                "text": "You save your souls here, eating cabbage, and think you are the righteous. You eat a gudgeon a day, and you think you bribe God with gudgeon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead32b62-0c5e-3460-9862-bbff1ed5a99d",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "Cottus bairdii, more widely known as mottled sculpin."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aed8dc06-4945-3e4f-8928-9584a670846e",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "Any of various similar small fish of the family Eleotridae, often used as bait."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41dad8f1-125c-4414-866d-9cc8b433179b",
                                                "sense_id": "aed8dc06-4945-3e4f-8928-9584a670846e",
                                                "text": "The southern purple-spotted gudgeon [Mogurnda adspersa] can be hard to find. Although colourful, they are thin and only grow up to 12 centimetres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e20d895-5480-324a-a173-2111ea88389e",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "Other fish, similar in appearance, principally in families Butidae and Eleotridae, but also in others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea2a616-781f-3783-b79d-2207e85c61dc",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "A person apt to take the bait; one easily cheated or duped; also, an idiot."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7de95a2-5c16-4b33-b6fe-3ab2d8f20a0a",
                                                "sense_id": "6ea2a616-781f-3783-b79d-2207e85c61dc",
                                                "text": "The Doctor now obeys the Summons, / Likes both his Company, and Commons; / Diſplays his Talent, ſits till Ten; / Next Day invited, comes again; / Soon grows Domeſtick, ſeldom fails, / Either at Morning, or at Meals; / Came early, and departed late: / In ſhort, the Gudgeon took the Bait."
                                            },
                                            {
                                                "example_id": "616ebfa5-36b5-4ae6-ae2e-b3e2b39bb7a4",
                                                "sense_id": "6ea2a616-781f-3783-b79d-2207e85c61dc",
                                                "text": "\"Is it not also known that you two innocents were doing the Churches week by week? Was it not patent that sooner or later you would come to a Spiritualist gathering? Here was a chance for a convert! They set a bait and poor old gudgeon Malone came along and swallowed it.\""
                                            },
                                            {
                                                "example_id": "7793d928-b1e0-417d-87aa-0bc3f3772ae4",
                                                "sense_id": "6ea2a616-781f-3783-b79d-2207e85c61dc",
                                                "text": "\"Don't be a gudgeon,\" she grumbled, tugging at the dress much more fiercely than was necessary. \"If this works as you say it will, nobody will notice me.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1005b248-949f-3c27-b753-36b0f6bc02dc",
                                        "entry_id": "f8cc2bab-67c9-3256-bbeb-feadbbb3ecb6",
                                        "glosses": [
                                            "Something used to lure or tempt; bait, a lure."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gudgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97bdaf82-d867-32ea-8012-4de33007624a",
                                        "entry_id": "3ef49060-e6af-3ae6-a08b-00569d22f12c",
                                        "glosses": [
                                            "To deprive (someone) fraudulently; to cheat, to dupe."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f616ed-56dd-42e8-8532-b9551641695a",
                                                "sense_id": "97bdaf82-d867-32ea-8012-4de33007624a",
                                                "text": "I have seen when you were willing to tie his points or brush his cloak, or the like—and to be treated thus ungratefully—and gudgeoned of the opportunities which had been given you—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c67117-3b11-366f-99f5-e922138e73eb",
                                        "entry_id": "3ef49060-e6af-3ae6-a08b-00569d22f12c",
                                        "glosses": [
                                            "To take the bait; to be defrauded or duped."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gudgeon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "200eea58-9848-3eb1-8824-4ab88842922a",
                                        "entry_id": "b051c482-230f-3e1a-ae90-025274127ffe",
                                        "glosses": [
                                            "A circular or cylindrical fitting, often made of metal, into which a pin or pintle fits to create a hinge or pivoting joint."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6fc997-b770-4008-8986-713994150476",
                                                "sense_id": "200eea58-9848-3eb1-8824-4ab88842922a",
                                                "text": "[A]s to a Wheel-barrow, I fancy'd I could make all but the Wheel; but that I had no Notion of, neither did I know how to go about it; beſides, I had no possible way to make the Iron Gudgeons for the Spindle or Axis of the Wheel to run in, ſo I gave it over; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37cc718-5136-34a0-b1a3-50489b67cc11",
                                        "entry_id": "b051c482-230f-3e1a-ae90-025274127ffe",
                                        "glosses": [
                                            "In a vessel with a stern-mounted rudder: the fitting into which the pintle of the rudder fits, allowing the rudder to swing freely."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14cb72f-cba4-4fb5-8ab2-3ea195e32374",
                                                "sense_id": "a37cc718-5136-34a0-b1a3-50489b67cc11",
                                                "text": "This afternoon the gudgeon of the rudder belonging to the large cutter, was drawn out and ſtolen, without being perceived by the man that was ſtationed to take care of her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16e8ac9b-8abe-42e8-be21-1b493982bfe9",
                        "source_entry_id": "ffb60dc2-bad3-3d55-bcbb-f8e69ce743c6",
                        "source_sense_id": "46a8504f-f35c-30c1-b1ff-49cecfb6ed4a",
                        "source_sense_description": "Zoologie: ein bestimmter am Boden von Gewässern lebender Fisch",
                        "target_lang_word": "goujon",
