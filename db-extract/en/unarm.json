                    {
                        "sense_id": "40ca9e60-7a90-3220-b025-8be6b4d2c6d0",
                        "entry_id": "9dc89996-97f9-3ff5-a5d4-b027df9fe188",
                        "glosses": [
                            "To disarm, to remove the armour and weapons from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "83085aa8-d3d5-4d2a-801e-042373fe0f23",
                                "sense_id": "40ca9e60-7a90-3220-b025-8be6b4d2c6d0",
                                "text": "Thenne anone la beale Isoud sente in to the toune / and prayd syr Dynadan that he wold come in to the castel / & repose hym there with a lady / with a good wylle sayd sir Dynadan / & soo he mounted vpon his hors and rode in to the castel / & there he alyghte / and was vnarmed / & brought in to the castel"
                            }
                        ]
                    },
                    {
                        "sense_id": "5e4c1acb-ae13-3b05-ad25-dbaef01cdfc3",
                        "entry_id": "9dc89996-97f9-3ff5-a5d4-b027df9fe188",
                        "glosses": [
                            "To remove one's armour."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ac094b6b-c90d-4999-9876-11860718928c",
                                "sense_id": "5e4c1acb-ae13-3b05-ad25-dbaef01cdfc3",
                                "text": "Call here my varlet; I'll unarm again:\nWhy should I war without the walls of Troy,\nThat find such cruel battle here within?"
                            }
                        ]
                    }
                ],
