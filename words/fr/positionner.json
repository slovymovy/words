    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a806bc74-fd02-3456-9eb9-c7eafe7b958d",
                    "sense_definition": "Mettre quelqu'un ou quelque chose dans une position, un lieu ou une orientation déterminée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>positionner</w> l'écran à la hauteur des yeux pour travailler confortablement."
                        },
                        {
                            "text": "L'entreprise cherche à <w>positionner</w> son nouveau produit sur le marché haut de gamme."
                        }
                    ],
                    "synonyms": [
                        "situer"
                    ],
                    "common_phrases": [
                        "positionner le curseur",
                        "bien positionner"
                    ]
                },
                {
                    "sense_id": "5ca3dbcb-eb17-3209-a6b6-4d4f35748c84",
                    "sense_definition": "Prendre position, exprimer son avis ou adopter une attitude précise face à une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a refusé de se <w>positionner</w> sur cette question controversée."
                        },
                        {
                            "text": "Chaque candidat doit se <w>positionner</w> clairement avant le vote de demain."
                        }
                    ],
                    "common_phrases": [
                        "se positionner clairement",
                        "se positionner contre"
                    ]
                }
            ]
        }
    ]
