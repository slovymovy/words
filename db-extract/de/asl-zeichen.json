                "senses": [
                    {
                        "sense_id": "5557e439-ea6e-3241-b679-6b746342e0a1",
                        "entry_id": "249d3bd1-27ea-30ad-b1fb-e5119530e853",
                        "glosses": [
                            "zum Inventar einer weit verbreiteten Gebärdensprache (American Sign Language) gehörendes Zeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68942da-44a5-4f31-af0f-b964b1feef31",
                                "sense_id": "5557e439-ea6e-3241-b679-6b746342e0a1",
                                "text": "„Die Mehrzahl der ASL-Zeichen aber ist eine Mischung von bildhaften und willkürlichen Elementen, und wie in den meisten Zeichen- und Bildersprachen tritt auch hier ein gewisser Grad der Verwischung durch den wiederholten und raschen Gebrauch der Zeichen ein, so daß viele von ihnen höchst stereotyp werden.“"
                            },
                            {
                                "example_id": "e338cc7d-ec5f-446e-b45f-af4752868be3",
                                "sense_id": "5557e439-ea6e-3241-b679-6b746342e0a1",
                                "text": "„Washoe lernte mehrere hundert ASL-Zeichen sowie diverse Zeichenkombinationen, die meist aus zwei oder drei Gesten bestanden.“"
                            },
                            {
                                "example_id": "94ce0a20-cd60-49f3-ac99-c6d75694b081",
                                "sense_id": "5557e439-ea6e-3241-b679-6b746342e0a1",
                                "text": "„Unter seiner Anleitung lernte die Schimpansin mehrere hundert ASL-Zeichen und verschiedene Zeichenkombinationen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
