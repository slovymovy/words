                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a238ceb6-d951-34b0-b140-3c551954d060",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To cohabit with; to coexist with; occur with."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce0aa82-83e1-4884-86e9-1b5ea8ec4c83",
                                                "sense_id": "a238ceb6-d951-34b0-b140-3c551954d060",
                                                "text": "Gijb, Suche as accompanyeth with man-killers and murtherers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40328a43-f463-3fd1-936d-b77eeaae39c4",
                                        "entry_id": "531fd9f1-bac0-32a9-9247-42da5f8d5be4",
                                        "glosses": [
                                            "To be found at the same time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097ea191-8c09-4f70-9f27-6c98b4404917",
                                                "sense_id": "40328a43-f463-3fd1-936d-b77eeaae39c4",
                                                "text": "Thunder almost always accompanies lightning during a rain storm."
                                            }
                                        ]
                                    }
                                ]
                            }
