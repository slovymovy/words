        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3f9c7db1-70ec-35f1-8d79-4ea5eb8d0836",
                "word": "uncorked",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8ae1ff1-5430-366e-b6c4-79312de50909",
                        "entry_id": "3f9c7db1-70ec-35f1-8d79-4ea5eb8d0836",
                        "glosses": [
                            "Having had the cork removed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f99218f-66aa-4ead-bfad-a05e3eedefbb",
                                "sense_id": "f8ae1ff1-5430-366e-b6c4-79312de50909",
                                "text": "an uncorked bottle of wine"
                            }
                        ]
                    },
                    {
                        "sense_id": "a05524d6-7657-3e8f-975a-e5d4d08f6f78",
                        "entry_id": "3f9c7db1-70ec-35f1-8d79-4ea5eb8d0836",
                        "glosses": [
                            "Not corked; allowing liquid to flow freely."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f31b801-4a4c-4c77-99d3-0dfb77595532",
                                "sense_id": "a05524d6-7657-3e8f-975a-e5d4d08f6f78",
                                "text": "Right before Dozier and the real General Williams's eyes (and optics), Charr's bones snapped and broke painfully as his entire body was sucked into his scar like an uncorked drain."
                            },
                            {
                                "example_id": "3ac36186-bc82-4d1d-9c3e-a60fccaba405",
                                "sense_id": "a05524d6-7657-3e8f-975a-e5d4d08f6f78",
                                "text": "Next to the sink was an uncorked bottle of wine, a can of beer, and two glasses."
                            },
                            {
                                "example_id": "15ca789f-9a2e-4311-8c1e-c5c74728cf0b",
                                "sense_id": "a05524d6-7657-3e8f-975a-e5d4d08f6f78",
                                "text": "Her brow began to pucker. “If Sister Marguerite is dead, that must mean that I...that I'm—” It took three tries before the next sentence emerged, but then it burst forth like an uncorked geyser: “I'm the oldest living virgin in Oakdale!”"
                            },
                            {
                                "example_id": "29522b86-c23c-4f41-8ff9-6a507397832f",
                                "sense_id": "a05524d6-7657-3e8f-975a-e5d4d08f6f78",
                                "text": "And after some prodding it all came out, like uncorked champagne -- he had feelings for Sammy, feelings he couldn't explain, not ever, and he didn't know what to do, and I must understand, no one could ever know."
                            }
                        ]
                    },
                    {
                        "sense_id": "df129779-6c98-3ed1-8ed2-6802f4d39958",
                        "entry_id": "3f9c7db1-70ec-35f1-8d79-4ea5eb8d0836",
                        "glosses": [
                            "Allowing exhaust gasses to be released to the atmosphere immediately after exiting the exhaust manifold."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1945cf54-7e93-4b77-8e2d-897928680f0f",
                                "sense_id": "df129779-6c98-3ed1-8ed2-6802f4d39958",
                                "text": "With their uncorked engine exhaust snarling, the B-25s zoomed over the twin spires of the impressive white cathedral and strafed several supply dumps alongside the waterfront."
                            }
                        ]
                    }
                ],
