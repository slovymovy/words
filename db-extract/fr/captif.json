                ],
                "senses": [
                    {
                        "sense_id": "25a5b759-e6de-31b8-9e5a-8b71357c420b",
                        "entry_id": "91153a96-a891-3873-800a-2695d109cea6",
                        "glosses": [
                            "Personne ou créature capturée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb5e29dd-aa30-4b82-9afe-794b84b554b8",
                                "sense_id": "25a5b759-e6de-31b8-9e5a-8b71357c420b",
                                "text": "Le Sénégal peut fournir , année commune , cinquante captifs, quatre mille cuirs, douze cens quintaux de gomme , & vingt quintaux de morfil."
                            }
                        ]
                    },
                    {
                        "sense_id": "d37280de-b2c1-36b4-ac41-294beb0f722d",
                        "entry_id": "91153a96-a891-3873-800a-2695d109cea6",
                        "glosses": [
                            "Prisonnier."
                        ],
                        "tags": [
                            "broadly",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "84778b61-4d99-4e2b-ad71-e71ee5063671",
                                "sense_id": "d37280de-b2c1-36b4-ac41-294beb0f722d",
                                "text": "Des captifs dix mille fois plus distingués que toi sont morts entre ces murailles, et jamais leur sort n’a été connu."
                            },
                            {
                                "example_id": "f3929be2-2dbe-41f0-aa25-e8ef271e8e4d",
                                "sense_id": "d37280de-b2c1-36b4-ac41-294beb0f722d",
                                "text": "Le jeune captif qui promenait en ce moment son ennui matinal était une victime de la puissance bureaucratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c1bb500-2ea5-40e6-8b42-4375d0f62a2e",
                        "source_entry_id": "91153a96-a891-3873-800a-2695d109cea6",
                        "target_lang_word": "cautivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cautivo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c94bd71f-5572-3098-9afe-a0f95e06cca1",
                                        "entry_id": "1c7bff0a-88bf-3e59-977d-b953fa4c0896",
                                        "glosses": [
                                            "Que se encuentra privado de libertad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b58bb4dd-43f4-3d6a-b3c0-3928e3663171",
                                        "entry_id": "1c7bff0a-88bf-3e59-977d-b953fa4c0896",
                                        "glosses": [
                                            "Por antonomasia, dicho de una persona, que ha sido capturado por el enemigo en la guerra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b356a6-b0b0-4a7e-8ff6-0bb1a65622ff",
                                                "sense_id": "b58bb4dd-43f4-3d6a-b3c0-3928e3663171",
                                                "text": "Y así Israel fue llevado cautivo de su tierra a Asiria, hasta el día de hoy Reyes IV, 17:23."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7145e8d8-aa93-39ac-b249-6e1ea072cf83",
                                        "entry_id": "1c7bff0a-88bf-3e59-977d-b953fa4c0896",
                                        "glosses": [
                                            "Por extensión, seducido por algo o alguien hasta la capitulación de la voluntad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201868ba-563b-4304-9d6c-d1d756e63939",
                                                "sense_id": "7145e8d8-aa93-39ac-b249-6e1ea072cf83",
                                                "text": "Un otoño trae de vuelta al que se dejó llevar por la pasión amorosa y ahora es un hombre amargado, perseguido y cautivo de su ira."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bc4b590-2015-4aa6-a8f2-9565d1c079fa",
