                            {
                                "example_id": "5dd6b35f-5048-4ddb-ba44-2e07614e4ef4",
                                "sense_id": "0fcf3f57-00bb-3bd7-a5e4-e0454394de7b",
                                "text": "Dziś widziałam Oliwię w sklepie."
