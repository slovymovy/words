                        "zh": [
                            {
                                "target_lang_word": "占有",
                                "target_lang_sense_clarification": "法律上的实际控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f18875e1-42fa-376c-b2cd-7060eb156ec7",
                    "sense_definition": "A syntactic relationship between two nouns or nominals that may be used to indicate ownership.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, <w>possession</w> is often marked by an apostrophe followed by an s.",
                            "target_lang_translations": {
                                "ru": "В английском языке <w>принадлежность</w> часто обозначается апострофом и буквой s.",
                                "zh": "在英语中，<w>领属</w>关系通常用撇号加s来表示。"
                            }
