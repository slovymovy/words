                                    {
                                        "sense_id": "f08391a2-a779-3862-840a-2592e354f3bc",
                                        "entry_id": "4c154097-0487-3efe-bd14-a97dd77f70c9",
                                        "glosses": [
                                            "allgemein: Messsystem, Verfahren zur Messung quantifizierbarer Einheiten, Größen",
                                            "eine meist mathematische Funktion, die eine Eigenschaft der Software in einem Zahlenwert abbildet; kurz für Softwaremetrik"
                                        ],
                                        "tags": [
                                            "Softwareentwicklung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "ccc8b14a-bddf-387e-8cca-fb449dbf6e67",
                                        "entry_id": "4c154097-0487-3efe-bd14-a97dd77f70c9",
                                        "glosses": [
                                            "Verslehre"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft",
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d885fbc-4a2d-4bb2-bb09-2ad410c8c3d7",
                                                "sense_id": "ccc8b14a-bddf-387e-8cca-fb449dbf6e67",
                                                "text": "Die Metrik untersucht die unterschiedlichen Möglichkeiten des Versbaus hinsichtlich Alliteration, Metrum, Reim, Rhythmus, Zäsur."
                                            },
                                            {
                                                "example_id": "99b6a889-0ef1-44ef-9b91-41d22bca0a9a",
                                                "sense_id": "ccc8b14a-bddf-387e-8cca-fb449dbf6e67",
                                                "text": "„Für eine eindeutigere Kennzeichnung der Metrik dieses Textes ist diese Probe viel zu klein, sie reicht aber, um an ihr das Verfahren zu erklären.“"
                                            },
                                            {
                                                "example_id": "9d7944a1-e897-4bd5-8841-88ecddf2145b",
                                                "sense_id": "ccc8b14a-bddf-387e-8cca-fb449dbf6e67",
                                                "text": "„Für Wilhelm Busch ergab diese frühe Einführung in die Metrik die Grundlage für seine spätere, unnachahmlich routinierte, verskünstlerische Meisterschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
