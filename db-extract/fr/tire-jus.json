        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "589937d9-ec37-3578-ad28-7e0f8337122a",
                "word": "tire-jus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3e446bc-20a1-3550-a5d9-dc5b09674500",
                        "entry_id": "589937d9-ec37-3578-ad28-7e0f8337122a",
                        "glosses": [
                            "Mouchoir."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7a824be6-8c20-4870-a484-6123d8caa4f7",
                                "sense_id": "b3e446bc-20a1-3550-a5d9-dc5b09674500",
                                "text": "Carmen sortit un tire-jus grisâtre de son cabas."
                            },
                            {
                                "example_id": "37df1103-12e1-481c-9f18-cd7df6ecb79b",
                                "sense_id": "b3e446bc-20a1-3550-a5d9-dc5b09674500",
                                "text": "C’est les poches civiles où c’que tu fourres, dans l’civil, ton tire-jus, ton tabac et l’adresse où tu vas livrer."
                            },
                            {
                                "example_id": "60cbdc1b-2f0e-4aea-b061-93126257fd23",
                                "sense_id": "b3e446bc-20a1-3550-a5d9-dc5b09674500",
                                "text": "Te vois donc pas, grand gognan, que c’est z’un corset \"YGETÉ\" breveté que se démonte tout : le busc, les baleines, les jarretelles et même les œillets, ce qui fait que peut se lavasser comme un simple tire-jus ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e881f75-64d1-4890-bdaa-1efbfc4ba4be",
                        "source_entry_id": "589937d9-ec37-3578-ad28-7e0f8337122a",
                        "source_sense_id": "b3e446bc-20a1-3550-a5d9-dc5b09674500",
                        "target_lang_word": "Taschentuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschentuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                        "entry_id": "70b01a1c-f194-3468-89a2-d0b765d8e3a5",
                                        "glosses": [
                                            "ein Tuch, mit dem man sich die Nase putzen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac2beb3-df14-4eb0-a12d-56bb82d6100b",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "Brauchst du ein Taschentuch?"
                                            },
                                            {
                                                "example_id": "7d4bcdc9-e2ea-43db-803a-143dbfd802ea",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Mrs. Hawkins stand am Kamin und zerknüllte ein Taschentuch zwischen ihren Händen, und die Tränen liefen ihr über die Wangen.“"
                                            },
                                            {
                                                "example_id": "c862fd04-91cd-425c-ba8f-eacb2f8e7046",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Der Mann nahm ein Taschentuch aus einer Hosentasche und trocknete die Tränen, und dann kam er auf mich zu und wollte auch mich sofort umarmen.“"
                                            },
                                            {
                                                "example_id": "d220cd75-9fdc-44f8-ac38-1bfa214a5b18",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Und nun verstummte er und zog sein Taschentuch hervor und wischte sich die Stirn.“"
                                            },
                                            {
                                                "example_id": "2dda0bb0-abfa-4920-b162-d2c6363b3593",
                                                "sense_id": "2002734c-7a10-3369-8def-e11998934268",
                                                "text": "„Er zieht ein Taschentuch mit einer Krone heraus und wischt sich den Staub aus dem Gesicht, darauf nimmt er eine Zigarrentasche mit Krone heraus und zündet sich eine Zigarre an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
