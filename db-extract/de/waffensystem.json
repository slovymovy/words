                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f268f2-31e3-400b-8fb4-cd636977672c",
                                "sense_id": "177e6bb3-4a15-370e-9b59-1e1c97751019",
                                "text": "Eine Boden-Luft-Rakete ist ein Beispiel für ein Waffensystem."
                            },
                            {
                                "example_id": "5fc1c50b-713f-434f-b10e-c5ec26add659",
                                "sense_id": "177e6bb3-4a15-370e-9b59-1e1c97751019",
                                "text": "„Doch das Geld, das die jungen Staaten erhalten, investieren viele Herrschende nicht in Infrastruktur, Bildung oder Gesundheitssystem, sondern kaufen sich Waffensysteme oder behalten die Millionen gleich für sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b51bd599-669d-319f-b153-25d2c5935dcd",
                        "entry_id": "a5279b8f-b916-3351-befb-98e0b257f6a1",
                        "glosses": [
                            "Kombination von Waffen zu einer Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c1fadab-acc7-48f5-b342-4ed5750ea3f6",
                                "sense_id": "b51bd599-669d-319f-b153-25d2c5935dcd",
                                "text": "Kampfhubschrauber, -flugzeuge und -panzer sind moderne Waffensysteme."
                            },
                            {
                                "example_id": "a2e5e235-93a9-4d49-bb70-015f26af6980",
                                "sense_id": "b51bd599-669d-319f-b153-25d2c5935dcd",
                                "text": "„Doch das Geld, das die jungen Staaten erhalten, investieren viele Herrschende nicht in Infrastruktur, Bildung oder Gesundheitssystem, sondern kaufen sich Waffensysteme oder behalten die Millionen gleich für sich.“"
