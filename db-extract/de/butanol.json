                "senses": [
                    {
                        "sense_id": "ff593bf9-aaae-3d9a-b0b6-1db0ee6ee660",
                        "entry_id": "37a402ec-7bc4-3ccc-8d92-997a8beb288a",
                        "glosses": [
                            "aliphatischer Alkohol, dessen Moleküle aus vier Kohlenstoffatomen und einer Hydroxygruppe am ersten Kohlenstoffatom bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d002615-b418-4c26-92ab-67f35902de97",
                                "sense_id": "ff593bf9-aaae-3d9a-b0b6-1db0ee6ee660",
                                "text": "„1-Butanol kommt von Natur aus in vielen Nahrungsmitteln vor und entsteht beim mikrobiologischen Abbau von Kohlenhydraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bab8d147-03b0-3b94-a94b-09a22038b9a8",
                        "entry_id": "37a402ec-7bc4-3ccc-8d92-997a8beb288a",
                        "glosses": [
                            "aliphatische Alkohole, deren Moleküle aus vier Kohlenstoffatomen und einer Hydroxygruppe bestehen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "15cdd8cd-7ea5-4b0d-b3e5-9a24d555cd27",
                                "sense_id": "bab8d147-03b0-3b94-a94b-09a22038b9a8",
                                "text": "„Alle Butanole lassen sich verestern, dabei erhält man fruchtartige Geruchsstoffe, die als Komponenten für Parfümierungen geignet sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
