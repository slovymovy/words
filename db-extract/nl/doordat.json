                    {
                        "sense_id": "3a097bc8-7f92-3376-82eb-aede46afb706",
                        "entry_id": "21ea21d5-984f-32b8-af7b-8da13b72a4c6",
                        "glosses": [
                            "because (implying an external cause)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942e40f2-f249-429d-bfbc-1b03e54e58e1",
                                "sense_id": "3a097bc8-7f92-3376-82eb-aede46afb706",
                                "text": "De wedstrijd werd afgelast, doordat het hevig regende.",
                                "translation": "The match was canceled, because it was raining heavily.",
                                "english": "The match was canceled, because it was raining heavily."
                            },
                            {
                                "example_id": "1ffe704e-e97f-4b96-85cb-e2b2477a62c6",
                                "sense_id": "3a097bc8-7f92-3376-82eb-aede46afb706",
                                "text": "Hij kon niet slapen, doordat de buren een feestje hielden.",
                                "translation": "He couldn't sleep, because the neighbors were having a party.",
                                "english": "He couldn't sleep, because the neighbors were having a party."
                            },
                            {
                                "example_id": "3bbc45fc-10a6-43af-b623-5bcb2380769f",
                                "sense_id": "3a097bc8-7f92-3376-82eb-aede46afb706",
                                "text": "Het evenement liep uit, doordat er technische problemen waren.",
                                "translation": "The event ran late, because there were technical issues.",
                                "english": "The event ran late, because there were technical issues."
                            }
                        ]
                    }
                ],
