                "senses": [
                    {
                        "sense_id": "1ad60304-e57f-3908-8f99-ae805b7ca48c",
                        "entry_id": "08fa2601-7100-3352-8d26-280010a4a50e",
                        "glosses": [
                            "Aktion, eine Person gegen ihren Willen von ihrem Ort/Platz zu entfernen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5cb51e-6d02-463e-ba72-dae3c1897bad",
                                "sense_id": "1ad60304-e57f-3908-8f99-ae805b7ca48c",
                                "text": "Nach ihrem Rauswurf bei Meier und Co. war sie erst einmal eine Weile arbeitslos."
                            },
                            {
                                "example_id": "9e6e3c20-60c2-4721-95de-2555689280af",
                                "sense_id": "1ad60304-e57f-3908-8f99-ae805b7ca48c",
                                "text": "Ein Rauswurf aber bedeutete Lokalverbot, und das war noch schlimmer."
                            },
                            {
                                "example_id": "ef9d46cc-fa31-4600-982c-dc5a31a4ad3a",
                                "sense_id": "1ad60304-e57f-3908-8f99-ae805b7ca48c",
                                "text": "„Johannes Nohl erinnerte sich, dass der Rauswurf aus der elterlichen Wohnung ihm vom Vater brieflich mitgeteilt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
