                                "target_senses": [
                                    {
                                        "sense_id": "4edf41cd-eef0-3d93-85ec-7d3e1ab3b20f",
                                        "entry_id": "892db38b-3e51-372b-9999-3dc5383feee3",
                                        "glosses": [
                                            "Indikator für den pH-Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0b34ee-c418-413a-b40d-059aaf3a1ab0",
                                                "sense_id": "4edf41cd-eef0-3d93-85ec-7d3e1ab3b20f",
                                                "text": "Lackmus ist im sauren Bereich rot und schlägt im alkalischen Bereich (ungefähr ab pH-Wert 8,3) zu Blau um."
                                            },
                                            {
                                                "example_id": "e25d13e7-3983-48b9-81ef-561b9fe6f95a",
                                                "sense_id": "4edf41cd-eef0-3d93-85ec-7d3e1ab3b20f",
                                                "text": "„Lackmus ist ein aus bestimmten Flechtenarten gewonnener blauvioletter Farbstoff.“"
                                            },
                                            {
                                                "example_id": "5acc27ae-73c8-48d6-b610-d9e2e55eb89c",
                                                "sense_id": "4edf41cd-eef0-3d93-85ec-7d3e1ab3b20f",
                                                "text": "„1 g löst sich in 2 ml kalten Wassers und bildet eine leichtflüssige Lösung, die gegenüber Lackmus sauer ist; in Ethanol ist es unlöslich“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
