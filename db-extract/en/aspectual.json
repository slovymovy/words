                        "entry_id": "0ac59c32-28a0-3cb3-a30c-f178e7d27478",
                        "glosses": [
                            "Of or pertaining to grammatical aspect."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "da313747-5d09-4867-a1ea-f7812ab9d126",
                                "sense_id": "965df6be-7c70-3a59-9fcd-c3735af8d288",
                                "text": "Perfective have and progressive be are together known as Aspectual Auxiliaries, since they mark Aspect (viz. whether an action is in progress or has been completed)."
                            }
                        ]
                    }
                ],
                "translations": [
