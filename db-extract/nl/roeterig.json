                                                "sense_id": "d4f9bf2f-e6ce-3b65-a375-aabbfd78f587",
                                                "text": "The grisly legions that troop under the sooty flag of Acheron.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb45957a-77c5-390a-9e4a-68a4c2e3b3a3",
                                        "entry_id": "e6c82a51-bf26-3fc4-9314-360b11357379",
                                        "glosses": [
                                            "Dark-skinned; black."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1162ec2a-578f-4004-bfd4-6962cb962f18",
                                                "sense_id": "fb45957a-77c5-390a-9e4a-68a4c2e3b3a3",
                                                "text": "While thus reduced, his few surviving senses were at once called into acute activity by the appearance of a sooty little negro, who placed within his grasp a misshapen fold of dirty paper, […]"
                                            },
                                            {
                                                "example_id": "2ba2d4dd-c06b-438c-9dd8-6078d952787f",
                                                "sense_id": "fb45957a-77c5-390a-9e4a-68a4c2e3b3a3",
                                                "text": "And, though I've laughed at your expense, / O sister of the sooty hue, / No man who has a heart and sense / Would do one deed to injure you."
                                            }
                                        ]
                                    }
                                ]
