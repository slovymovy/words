                    {
                        "sense_id": "05aa7956-c96a-3c73-924d-49f67467bd41",
                        "entry_id": "bb5996e2-0db9-37f8-9ea5-443af6ee9bd0",
                        "glosses": [
                            "Programme informatique à activer sous certaines conditions, et stocké dans une blockchain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd174cdf-9e61-410c-a5af-33cdf74bd5b8",
                                "sense_id": "05aa7956-c96a-3c73-924d-49f67467bd41",
                                "text": "Depuis que la blockchain et ses applications se développent, les smart-contracts, des programmes définitifs qui permettent l’exécution automatique d’actions prédéfinies, sont présentés comme l’un de ses usages les plus prometteurs pour les entreprises."
                            },
                            {
                                "example_id": "9b99dc8b-1a96-496a-96ee-dd98e6cee1c4",
                                "sense_id": "05aa7956-c96a-3c73-924d-49f67467bd41",
                                "text": "Les langages informatiques utilisés pour écrire les smart-contracts sont souvent « Turing complet », ce qui veut dire qu’ils sont capables de mettre en place tous les mécanismes algorithmiques imaginables, quelle qu’en soit la complexité."
                            },
                            {
                                "example_id": "2b528448-885a-4621-a76e-69972e048e3f",
                                "sense_id": "05aa7956-c96a-3c73-924d-49f67467bd41",
                                "text": "Paradoxalement, le smart-contract n’est pas un contrat à proprement parler."
                            }
                        ]
                    }
