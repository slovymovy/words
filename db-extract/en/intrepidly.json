                "translations": [
                    {
                        "translation_id": "1295e87c-1d44-4752-9a0b-375555630de5",
                        "source_entry_id": "6e3d5827-17e2-3ca8-8c8e-179595530c75",
                        "source_sense_id": "85a5db74-23e1-3d2a-a8dd-3bea05f4927c",
                        "source_sense_description": "kühn: unerschrocken, furchtlos",
                        "target_lang_word": "unerschrocken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerschrocken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e938d5de-607a-3b57-b054-42100a68c35f",
                                        "entry_id": "2b386ad2-4411-3898-940f-f588677970db",
                                        "glosses": [
                                            "durch nichts zu erschrecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad08ed5-e6e8-4c10-b72a-4a6be34e0c8d",
                                                "sense_id": "e938d5de-607a-3b57-b054-42100a68c35f",
                                                "text": "Er war ein unerschrockener junger Mann."
                                            },
                                            {
                                                "example_id": "214690c2-ebf2-45b0-99c3-5791aaf5c2e5",
                                                "sense_id": "e938d5de-607a-3b57-b054-42100a68c35f",
                                                "text": "Hermann Hesse über Gottfried Benn: »Der unerschrockenste deutsche Dichter unserer Zeit.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1899dc5e-111a-47b5-a1e1-1013d3e076e7",
                        "source_entry_id": "6e3d5827-17e2-3ca8-8c8e-179595530c75",
                        "source_sense_id": "85a5db74-23e1-3d2a-a8dd-3bea05f4927c",
                        "source_sense_description": "kühn: unerschrocken, furchtlos",
                        "target_lang_word": "furchtlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furchtlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                        "entry_id": "4047c970-aa68-30f8-8e8f-05af1b9b87fc",
                                        "glosses": [
                                            "unerschrocken, ohne Furcht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f774c73-c52c-437f-87bf-c38795a77708",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "Furchtlos zog er in die Schlacht."
                                            },
                                            {
                                                "example_id": "1dadcb82-50d1-4f0a-a172-4df81525b57c",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Unermüdlich ging er von Zelle zu Zelle […] stets sein eigenes Leid vergessend, völlig furchtlos, was die eigene Person anging.“"
                                            },
                                            {
                                                "example_id": "aaf6dc5d-a998-41eb-9593-cfcf6d150e71",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Damals, als er diese Barbara geheiratet hatte, das Bürgermädchen, da war Juliette zuversichtlich und furchtlos geblieben: sie hatte gewußt, daß er zu ihr, zu seiner Schwarzen Venus zurückkehren würde.“"
                                            },
                                            {
                                                "example_id": "5f8ffa48-968d-46a2-b2e4-be08f0311b0f",
                                                "sense_id": "bcd21719-8ab5-3df4-a4a1-c561a4d40390",
                                                "text": "„Ich liebe die Männer, welche furchtlos sind, und darum will ich dir deine Bitte erfüllen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
