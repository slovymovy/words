                                                "sense_id": "56d92f1d-32cd-36ba-ae5b-3523e89e2cbe",
                                                "text": "Die Kapazität des Behälters war viel zu klein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d89b1b67-fa0b-344a-98f1-a5c3cc205b4e",
