                                    },
                                    {
                                        "sense_id": "f0e67c33-d701-39c0-8db8-7c9bc5d253bd",
                                        "entry_id": "8371b758-0ef0-3685-9dac-cfa1ba5f4103",
                                        "glosses": [
                                            "einzelnes Blatt, das in Aquatinta-Technik erstellt wurde"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
