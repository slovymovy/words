                "senses": [
                    {
                        "sense_id": "c7d4f6f0-96b8-3825-8341-3751aa54dd94",
                        "entry_id": "8e503c06-b5f3-3a4c-97f4-7ac6567f3e05",
                        "glosses": [
                            "composer"
                        ],
                        "tags": [
