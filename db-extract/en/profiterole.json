                                "target_senses": [
                                    {
                                        "sense_id": "04536358-d481-306b-a7b0-9bfe304549d4",
                                        "entry_id": "cc94a216-3ddf-3e5e-bd98-912213867871",
                                        "glosses": [
                                            "hohles Gebäck mit unterschiedlicher Füllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093ac8d0-2fc2-491b-958c-40f27ab3f0c1",
                                                "sense_id": "04536358-d481-306b-a7b0-9bfe304549d4",
                                                "text": "Im Harz gibt es in mehreren Lokalen sehr beliebte Windbeutel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b04108c9-12ab-3c85-9bc6-b7bfaa2ab1e9",
                                        "entry_id": "cc94a216-3ddf-3e5e-bd98-912213867871",
                                        "glosses": [
                                            "leichtfertiger, unseriöser Mensch"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f570f5b8-4935-41d3-a055-cde0537fa005",
                                                "sense_id": "b04108c9-12ab-3c85-9bc6-b7bfaa2ab1e9",
                                                "text": "„Wie kam dieser Windbeutel ohne einen Pfennig Geld und ohne Talent dazu, diese Schönheit durch Europa zu schleppen, die sich, ungefällig wie sie war, nur auf Kosten von Dummköpfen durchschlagen konnte?“"
                                            }
                                        ],
