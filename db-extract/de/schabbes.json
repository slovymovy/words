                                    {
                                        "sense_id": "cab8bedc-f020-33aa-ac6a-5513597c8aa7",
                                        "entry_id": "2f3629d4-e685-3f84-81e1-ffab0f0b9d83",
                                        "glosses": [
                                            "Alternative form of Shabbat."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9648ad4b-141a-4c49-84b1-3b04f2743994",
                                                "sense_id": "cab8bedc-f020-33aa-ac6a-5513597c8aa7",
                                                "text": "She renewed contact with the rabbi and other orthodox patients in the hospital, went to all the religious services, and loved nothing so much as lighting the Shabbas candles."
                                            },
                                            {
                                                "example_id": "afa3fe54-6eb4-418d-8a70-1ca1b795c864",
                                                "sense_id": "cab8bedc-f020-33aa-ac6a-5513597c8aa7",
                                                "text": "I'm saying, I see what you're getting at, Dude, he kept the money, but my point is, here we are, it's shabbas, the sabbath, which I'm allowed to break only if it's a matter of life and death—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
