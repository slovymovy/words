                                    {
                                        "sense_id": "37ac08cd-72dd-38fe-87f0-4c723914eb43",
                                        "entry_id": "067cc602-d562-378d-a39e-36f96e9aa103",
                                        "glosses": [
                                            "souprava k rozdělávání ohně křesáním sestávající z křesacího kamene, ocílky a troudu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e35ae0-6674-4d5f-9d2b-c1e7f4041f74",
                                                "sense_id": "37ac08cd-72dd-38fe-87f0-4c723914eb43",
                                                "text": "Tu si vzpomněl, že v křesadle, jež z dutého stromu vynesl, je ještě oharek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "183ca95d-c0cd-38d3-bf3a-f671f3d3bf2b",
                                        "entry_id": "067cc602-d562-378d-a39e-36f96e9aa103",
                                        "glosses": [
                                            "samotný kámen nebo ocílka k rozdělávání ohně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d72885-cba2-4b24-a5f6-516e6b790d1c",
                                                "sense_id": "183ca95d-c0cd-38d3-bf3a-f671f3d3bf2b",
                                                "text": "Nad krbem měl díru na křesadlo, troud a sirky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ea7858-3b24-3d7d-afa9-a594c987be6e",
                                        "entry_id": "067cc602-d562-378d-a39e-36f96e9aa103",
                                        "glosses": [
                                            "zařízení na pušce, kterým se křesnutím zažehne střelný prach a spustí výstřel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7c2294-fd2e-40bd-95ec-3a593c159ff1",
                                                "sense_id": "84ea7858-3b24-3d7d-afa9-a594c987be6e",
                                                "text": "Přinesl vojákovi střelný prach a křesadlo, aby si spravil ručnici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
