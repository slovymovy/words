                "senses": [
                    {
                        "sense_id": "e7d46e17-1201-38be-b101-ea349607e6a4",
                        "entry_id": "4e4ffba7-bf75-33fb-be3b-836ca0c2ca3d",
                        "glosses": [
                            "anhaltender Beschuss durch Artillerie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f609467-2afa-4ac8-9030-ca767e29eafb",
                                "sense_id": "e7d46e17-1201-38be-b101-ea349607e6a4",
                                "text": "„Am 21. Februar 1916, 8h15 setzte ein Artilleriebeschuss ein, aus 1200 Rohren aller Kaliber, wie ihn die Welt noch nicht erlebt hatte. […] Das Dauerfeuer hielt bis Ende Juni an, als die deutschen Truppen gezwungen waren, an die Somme, einen noch größeren Kriegsschauplatz, weiterzuziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a49d4d01-ab81-37b6-9772-3d32d36c6cf2",
                        "entry_id": "4e4ffba7-bf75-33fb-be3b-836ca0c2ca3d",
                        "glosses": [
                            "Funktion von automatischen Schusswaffen, bei der mehrere Schüsse unmittelbar hintereinander abgegeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846fd426-2ac8-48f2-8f4d-0fddc55dccc9",
                                "sense_id": "a49d4d01-ab81-37b6-9772-3d32d36c6cf2",
                                "text": "„Der Panzer konnte mit seinem Kettenantrieb den Drahtverhau überwinden und trotzte gleichzeitig dem Dauerfeuer der Maschinengewehre.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fcb00517-f6d0-3869-b0d9-1e7c1aa7a9db",
                        "entry_id": "4e4ffba7-bf75-33fb-be3b-836ca0c2ca3d",
                        "glosses": [
                            "meist kritische Äußerungen, die anhaltend vorgebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed75c456-8bfc-4423-8365-4c1f6ec971c2",
                                "sense_id": "fcb00517-f6d0-3869-b0d9-1e7c1aa7a9db",
                                "text": "„Merkel war in Berlin noch nicht mal auf dem Weg zum Regierungsflieger, da eröffnete Donald Trump schon das befürchtete Dauerfeuer auf Deutschland - und wetterte vor dem Beginn des Treffens der 29 Staats- und Regierungschefs munter gegen Merkel.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
