                        "glosses": [
                            "Langue bantoue issue du groupe linguistique pahouin (fang-beti-bulu) parlée dans le Centre du Cameroun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d173736e-0947-4134-9660-31af1f5298ed",
                                "sense_id": "74696c4e-eb34-3738-ba42-4ed16fd99bc8",
                                "text": "La femme, ewondo, s’adresse toujours à son mari en ewondo et celui-ci (eton), le plus souvent, lui parle en eton."
                            }
                        ]
                    }
