                    {
                        "translation_id": "8890cf47-0ac6-4115-b4bb-7daa819d5d3f",
                        "source_entry_id": "6fbb86bf-3fec-37cc-8c0a-d69361fdc61e",
                        "target_lang_word": "astrakan",
