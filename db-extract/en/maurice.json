            {
                "entry_id": "f0af5fc8-944f-3a89-a3ed-1ed1f45a00a6",
                "word": "Maurice",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c070137-b393-348c-8a94-4906025090ed",
                        "entry_id": "f0af5fc8-944f-3a89-a3ed-1ed1f45a00a6",
                        "glosses": [
                            "A male given name from Latin, equivalent to English Morris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd5aa96-ba0b-4c55-8763-239a81c72b15",
                                "sense_id": "8c070137-b393-348c-8a94-4906025090ed",
                                "text": "For some reason I am a man known by his surname; I might never have been christened for all the use my friends make of the rather affected Maurice my literary parents gave me."
                            }
                        ]
                    },
                    {
                        "sense_id": "df8bbb38-ae53-36d1-b418-8e9d02158888",
                        "entry_id": "f0af5fc8-944f-3a89-a3ed-1ed1f45a00a6",
                        "glosses": [
                            "A surname originating as a patronymic, equivalent to English Morris."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
