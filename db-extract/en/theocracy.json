                    {
                        "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                        "entry_id": "021dd8ec-d4b4-3d17-bc71-00b3124ac386",
                        "glosses": [
                            "Government under the control of a state religion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "67e2208a-6eae-4181-824d-71b896bea42d",
                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                "text": "Near-synonym: clericocracy"
                            },
                            {
                                "example_id": "6a3b9dd5-b918-4a2a-8656-2191eb786ef5",
                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                "text": "Tibet was a Buddhist theocracy ruled by the Dalai Lama prior to Chinese annexation."
                            },
                            {
                                "example_id": "eb5a13de-a642-451f-ac19-a51f194dc069",
                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                "text": "The Vatican City State is a sovereign city-state and a Christian theocracy ruled by the Pope."
                            },
                            {
                                "example_id": "11b60fea-101e-4d17-a8cf-d2803688646e",
                                "sense_id": "28bf9de6-d7a3-3d9b-8542-f2a38dee3d47",
                                "text": "Lynch certainly seems to think to. “We feel liberated from the prism of the past,” he says. “Ireland was a theocracy.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "018ac820-4ac5-3d7b-bc34-31848f5b4ad3",
