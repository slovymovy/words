                        "examples": [
                            {
                                "example_id": "881114c2-0b3e-4dee-8bf2-612d9c8dc581",
                                "sense_id": "62d50cbf-6e53-395e-839c-e04afe358a95",
                                "text": "„Bei seinem ersten unbekümmerten Aftersausen, wenige Wochen nach der Hochzeit, wäre sie fast in Ohnmacht gefallen. Der brachiale Darmkrach überträfe die Kanonade von Valmy, klagte sie mit entsetzter Miene und nickte bedeutungsvoll, als wäre sie damals mit Goethe dabei gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9f090c2a-ccc3-345e-bb3c-1130ba1407c6",
                        "entry_id": "4414e82b-b285-346e-95b9-3dc5e93aecf4",
                        "glosses": [
                            "Angst vor einer schweren Aufgabe, einer drohenden Gefahr"
                        ],
                        "tags": [
                            "derb, veraltend"
                        ],
                        "examples": [
                            {
                                "example_id": "d49b8ebd-2ceb-49d8-a524-060d0e06a24f",
                                "sense_id": "9f090c2a-ccc3-345e-bb3c-1130ba1407c6",
                                "text": "Kurz vor dem Fallschirmsprung bekam er Aftersausen."
                            }
                        ],
                        "sense_index_json": "\"2\""
