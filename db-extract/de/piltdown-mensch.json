                                    {
                                        "sense_id": "0b80d60b-e208-3103-8b10-4757b42de8e9",
                                        "entry_id": "4af5e163-4718-3f54-ad88-e402c9923514",
                                        "glosses": [
                                            "A supposed early human theorized from bone fragments said to have been found in a gravel pit in Piltdown, England, in 1912, but later identified as a forgery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1a07ff-78df-4b93-8051-0f659bfcf564",
                                                "sense_id": "0b80d60b-e208-3103-8b10-4757b42de8e9",
                                                "text": "The Piltdown man of Sussex, England. Antiquity variously estimated at 100,000 to 300,000 years. The ape-like structure of the jaw does not prevent the expression of a considerable degree of intelligence in the face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
