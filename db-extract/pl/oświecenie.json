                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "oświetlenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.8\""
                    },
                    {
                        "sense_id": "b80ea4bf-9a5f-371d-aa10-be9ccae30d44",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "sprawienie, że coś staje się rozświetlone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923f0942-e669-439d-b8db-05f3712478f6",
                                "sense_id": "b80ea4bf-9a5f-371d-aa10-be9ccae30d44",
                                "text": "Nagłe ożywienie krajobrazu spowodowane było oświeceniem stoków przez słońce."
                            }
                        ],
                        "sense_index_json": "\"1.9\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48fe7cba-7535-4941-9ea9-ac139fd4b428",
                        "source_entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "source_sense_id": "9558788c-7104-3169-b907-e372007a1486",
                        "target_lang_word": "enlightenment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlightenment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040582c2-13de-3cf4-8dc1-b43fe9326857",
                                        "entry_id": "91466191-6fbf-37c7-8322-2ed61f3782e4",
                                        "glosses": [
                                            "An act of enlightening, or the state of being enlightened or instructed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                        "entry_id": "91466191-6fbf-37c7-8322-2ed61f3782e4",
                                        "glosses": [
                                            "A concept in spirituality, philosophy and psychology related to achieving clarity of perception, reason and knowledge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c55ee04-06b7-43e9-a8a7-856b949fac76",
                                                "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                                "text": "But the man who has attained enlightenment sees that the apparent reality is mere illusion, or, as was said a couple of thousand years later, that there is nothing good nor bad but thinking makes it so."
                                            },
                                            {
                                                "example_id": "91663a4c-fe4f-4d39-a22a-c093220aa027",
                                                "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                                "text": "Thus Django becomes the carrier of the “public use of one's reason”—the Kantian road to enlightenment given to him by the German “Forty-Eighter” dentist–turned-bounty hunter Dr. “King” Schultz, and represents the fictive, allohistorical beginning of the battle against slavery and racism in the United States."
                                            }
