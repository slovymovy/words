                    },
                    {
                        "translation_id": "d0943dff-334f-49d8-b6b1-5f5441865e84",
                        "source_entry_id": "e7ce1b71-db87-3706-b977-31a3120350ed",
                        "source_sense_description": "inclined to be generous",
                        "target_lang_word": "généreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "généreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4dba5ff-6bc5-33de-8553-0dacb69ff303",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui est de nature élevée, noble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06ca90e8-03ce-4382-82f4-17bf8ed48c6b",
                                                "sense_id": "f4dba5ff-6bc5-33de-8553-0dacb69ff303",
                                                "text": "Se montrer généreux."
                                            },
                                            {
                                                "example_id": "aa89a937-e7d7-4374-a792-5797385d0322",
                                                "sense_id": "f4dba5ff-6bc5-33de-8553-0dacb69ff303",
                                                "text": "Âme généreuse."
                                            },
                                            {
                                                "example_id": "548e0ab7-1435-4ae6-9077-08010a6af535",
                                                "sense_id": "f4dba5ff-6bc5-33de-8553-0dacb69ff303",
                                                "text": "Si le loup est le plus fort, il déchire, il dévore sa proie ; le chien, au contraire, plus généreux, se contente de la victoire, et ne trouve pas que le corps d'un ennemi mort sente bon ; il l'abandonne pour servir de pâture aux corbeaux et même aux autres loups […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ea96c3-089a-3353-a4fd-c652586ac09d",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui est l’indice d’une âme généreuse ; qui part d’une âme généreuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564deecb-0764-46d5-b533-d798baf6a8c4",
                                                "sense_id": "a6ea96c3-089a-3353-a4fd-c652586ac09d",
                                                "text": "C’était elle qui assumait dans la maison les travaux de l’homme que sa vieillesse lui eût rendus difficiles. Combien de ménagères auraient, d’elles-mêmes, pris cette initiative généreuse !"
                                            },
                                            {
                                                "example_id": "caa97ad5-5ee4-43db-937c-92f6032976de",
                                                "sense_id": "a6ea96c3-089a-3353-a4fd-c652586ac09d",
                                                "text": "Offrir cinq cents flacons de vinaigre des quatre-voleurs comme produit désinfectant au bureau de bienfaisance du XIᵉ arrondissement, c'est un acte généreux ; faire savoir qu'il provient de la maison Maille, Robillard, Segond et Cie, cela devient de la réclame […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465ed324-1a1f-3a68-b5c9-f05492c65573",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui est porté à donner plus qu’il n’est tenu de donner, ou à recevoir moins que ce qu’il a le droit de réclamer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017b12c7-dbfd-4a8b-91f8-a601f5d00b02",
                                                "sense_id": "465ed324-1a1f-3a68-b5c9-f05492c65573",
                                                "text": "Cheikh Gaafar se montra généreux pour la dot et les cadeaux. Il fit célébrer de belles fêtes pour le mariage. […]. Le village entier fut en liesse."
                                            },
                                            {
                                                "example_id": "a4ed7de9-e0a6-4f51-9d92-29caac914fe4",
                                                "sense_id": "465ed324-1a1f-3a68-b5c9-f05492c65573",
                                                "text": "Elle collectionne aussi toutes les plaques officielles des rues, et à chaque instant un généreux donateur arrive, apportant des panonceaux ou des affiches."
                                            },
                                            {
                                                "example_id": "a702651b-5427-4f34-afc3-a2b8ca8fd667",
                                                "sense_id": "465ed324-1a1f-3a68-b5c9-f05492c65573",
                                                "text": "Mais les vivants aujourd'hui ne sont plus si généreux :\nQuand ils possèdent un mort ils le gardent pour eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d25de1-d498-3d2b-a58f-bb33c8b2977e",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui produit beaucoup."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1529872e-af20-456b-9b6c-863782954399",
                                                "sense_id": "20d25de1-d498-3d2b-a58f-bb33c8b2977e",
                                                "text": "Sol généreux, terre généreuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2efa5e5-ef50-349b-aa4c-0d4897308a8b",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui a du corps et qui réconforte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4044c123-562b-4fd2-9468-011146c32e02",
                                                "sense_id": "e2efa5e5-ef50-349b-aa4c-0d4897308a8b",
                                                "text": "Vin généreux : Vin agréable, de bonne qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84a0aa5-b486-34c6-a0e7-bbeb4fb8dafc",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Qui est de bonne race, de race noble, qui a le sens de l’honneur. On ne retrouve plus cette acception que dans les expressions poétiques :"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b5a638-7997-4de0-8c08-5cfcb90e8d1b",
                                                "sense_id": "e84a0aa5-b486-34c6-a0e7-bbeb4fb8dafc",
                                                "text": "Un lion généreux."
                                            },
                                            {
                                                "example_id": "73c374da-75a6-4710-a561-cdf1b65cbc7b",
                                                "sense_id": "e84a0aa5-b486-34c6-a0e7-bbeb4fb8dafc",
                                                "text": "Un généreux coursier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357fe0a6-0c62-3ff5-970c-56d780b1bd04",
                                        "entry_id": "a356cf61-b929-3cbe-bbc8-9c9c31411f4b",
                                        "glosses": [
                                            "Présent en grandes quantités ; volumineux."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f9a3a03-8cc7-42d5-9e6e-d45d57e99845",
                                                "sense_id": "357fe0a6-0c62-3ff5-970c-56d780b1bd04",
                                                "text": "Si Lanfear n’avait pas été là, Graendal serait à coup sûr passée pour un parangon de beauté. Vêtue d’une robe de soie verte au décolleté plongeant, elle arborait entre ses seins généreux un rubis de la taille d’un œuf, et une couronne incrustée de pierres précieuses reposait sur sa longue chevelure blonde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "généreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d442d951-3842-3827-81c6-b8d9bb96c07d",
                                        "entry_id": "be33ca6b-23f1-3e19-bb52-89f2190452aa",
                                        "glosses": [
                                            "Personne qui fait preuve de générosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c874451-03a4-4028-b8fb-9618adecc76b",
                                                "sense_id": "d442d951-3842-3827-81c6-b8d9bb96c07d",
                                                "text": "Faire le généreux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
