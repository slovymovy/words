        "fr-extract.jsonl": [
            {
                "entry_id": "0658149b-8610-3f02-9b72-55e5903face2",
                "word": "anthropocentrique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a84cf389-46fa-4ec1-a34e-5796820c690b",
                        "entry_id": "0658149b-8610-3f02-9b72-55e5903face2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anthropocentriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7647b112-cbd7-388c-82d0-389ddf8a70c6",
                        "entry_id": "0658149b-8610-3f02-9b72-55e5903face2",
                        "glosses": [
                            "Où le genre humain est considéré comme le centre de l’univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee52f4c-516a-4f4d-8c13-e4ec65cea2e8",
                                "sense_id": "7647b112-cbd7-388c-82d0-389ddf8a70c6",
                                "text": "[La biodiversité des procaryotes] semble d’ailleurs largement sous-estimée et seule une déformation anthropocentrique nous les fait percevoir comme un groupe bien individualisé."
                            },
                            {
                                "example_id": "9e4c3d81-3426-403a-ab31-7c7c066b5266",
                                "sense_id": "7647b112-cbd7-388c-82d0-389ddf8a70c6",
                                "text": "“Si vous donnez la personnalité juridique à une personnalité non-humaine, c’est une petite révolution en soi qui signifie un certain changement dans l’aspect anthropocentrique ou biocentrique de la perception qu’on a du monde, de l'homme et de son environnement […]”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55e3af8d-011d-431f-95d1-053add706a7c",
                        "source_entry_id": "0658149b-8610-3f02-9b72-55e5903face2",
                        "source_sense_id": "7647b112-cbd7-388c-82d0-389ddf8a70c6",
                        "target_lang_word": "anthropocentric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropocentric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "260d4dc0-2857-324d-9b4e-b3df961df62b",
                                        "entry_id": "78f3a644-a8a6-3f05-be13-1aaea3a7a995",
                                        "glosses": [
                                            "Placing humans at the center of something, giving preference to humans above all other considerations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969468b9-53d8-40a4-9266-7868321c8806",
                                                "sense_id": "260d4dc0-2857-324d-9b4e-b3df961df62b",
                                                "text": "But just as we recognize that nature doesn't provide a very good guide for human social conduct, isn't it anthropocentric of us to assume that our moral system offers an adequate guide for what should happen in nature?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
