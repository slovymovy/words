                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6655129a-f7da-30d4-89cb-2b8926088d79",
                        "entry_id": "af8261df-e0ae-31e0-b119-9877d48594ca",
                        "glosses": [
                            "перен., разг. уничтожить, заглушить, расстроить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c456efe-dfe3-4344-b574-f3eaac1b8b26",
                                "sense_id": "6655129a-f7da-30d4-89cb-2b8926088d79",
                                "text": "Грибы эти отваривают, чтобы отбить горечь."
                            },
                            {
                                "example_id": "d6da7303-bbd1-4f78-9bfd-b6706f152167",
                                "sense_id": "6655129a-f7da-30d4-89cb-2b8926088d79",
                                "text": "Отбить аппетит."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2fe643b-eb33-3877-8b70-e733281f552e",
                        "entry_id": "af8261df-e0ae-31e0-b119-9877d48594ca",
                        "glosses": [
                            "отнять с боем, силою; выручить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae376d28-16db-4493-9318-47ae6a2ee0eb",
                                "sense_id": "e2fe643b-eb33-3877-8b70-e733281f552e",
                                "text": "Отбить орудие у противника."
                            },
                            {
                                "example_id": "f59ba778-cd74-4224-987b-782ddf2bcc97",
                                "sense_id": "e2fe643b-eb33-3877-8b70-e733281f552e",
                                "text": "Отбить пленных."
                            },
                            {
                                "example_id": "9ad7e96c-5352-4fa3-9d94-183627e0d41c",
                                "sense_id": "e2fe643b-eb33-3877-8b70-e733281f552e",
                                "text": "Стрелецкие сотники отбили гетмана."
                            }
                        ]
                    },
                    {
                        "sense_id": "15605056-0c83-3934-aac4-f204a62170a4",
                        "entry_id": "af8261df-e0ae-31e0-b119-9877d48594ca",
                        "glosses": [
                            "намеренно отдалить, отвратить, отнять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5383770c-c66b-43b7-9531-54707f176097",
                                "sense_id": "15605056-0c83-3934-aac4-f204a62170a4",
                                "text": "Отбить покупателей."
                            },
                            {
                                "example_id": "2b7a5c8c-0b47-4c31-ab43-6f55d024fb4f",
                                "sense_id": "15605056-0c83-3934-aac4-f204a62170a4",
                                "text": "Отбить корову от стада."
                            },
                            {
                                "example_id": "63ff9c0b-e3a9-4a7e-8b83-3a1f353c17ca",
                                "sense_id": "15605056-0c83-3934-aac4-f204a62170a4",
                                "text": "Молодой человек, у которого я отбил даму, танцовал мазурку в первой паре."
                            }
                        ]
                    },
                    {
                        "sense_id": "05d9918a-e0ca-3b4a-b2d6-ba32bd8e69a8",
