                        "glosses": [
                            "Someone who acts in a sophisticated, aristocratic manner, reminiscent of the fourth Earl of Chesterfield."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f3427b-020a-4fb9-b5ef-564b81e4de2b",
                                "sense_id": "2ac5791e-7d25-3a0a-b3e5-f59ce65e3a87",
                                "text": "For example, in the chapter on “The Imperial Family,\" by Baron Sannomiya, this consummate Chesterfieldian, who acts as the court chamberlain, tells us what went on—outside of the imperial family."
                            }
                        ]
