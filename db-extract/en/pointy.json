                    {
                        "sense_id": "e69f3cc2-41f0-39a5-ae56-b986ff71d3a7",
                        "entry_id": "5c9cdff7-513a-31d8-aa66-3055c98f5bfa",
                        "glosses": [
                            "Any pointed object."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "320d6934-0fcb-49fe-aaa6-6afa455b748c",
                                "sense_id": "e69f3cc2-41f0-39a5-ae56-b986ff71d3a7",
                                "text": "Even though Skylar has never had a seizure to my knowledge since the incident in school, she still sees the things she likes to call pointies, just not as many as before, since she started taking the valproic acid, but still there's a few."
                            },
                            {
                                "example_id": "57b66481-7848-4fd9-91ba-f2d19c2ac7e7",
                                "sense_id": "e69f3cc2-41f0-39a5-ae56-b986ff71d3a7",
                                "text": "Plus, it's likely she will bite you the first few times you try messing with her mouth, so why not get those bites out of the way before the sharp pointies come in?"
                            }
                        ]
                    }
                ],
