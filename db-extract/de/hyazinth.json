                    {
                        "sense_id": "a4d7581d-20ca-3836-a98b-924770a1cb57",
                        "entry_id": "168f38f7-2df9-3e09-9977-237915065659",
                        "glosses": [
                            "gelbe/gelbrote bis rotbraune Varietät des Zirkons"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "c7d1603b-e4d2-46f0-84ec-0bdc479a97a8",
                                "sense_id": "a4d7581d-20ca-3836-a98b-924770a1cb57",
                                "text": "„Die Grundsteine der Stadtmauer sind mit edlen Steinen aller Art geschmückt; der erste Grundstein ist ein Jaspis, der zweite ein Saphir, der dritte ein Chalzedon, der vierte ein Smaragd, der fünfte ein Sardonyx, der sechste ein Sardion, der siebte ein Chrysolith, der achte ein Beryll, der neunte ein Topas, der zehnte ein Chrysopras‚der elfte ein Hyazinth, der zwölfte ein Amethyst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2977356-d7a9-49ca-a4f2-ee07f30e2a5a",
                        "source_entry_id": "168f38f7-2df9-3e09-9977-237915065659",
                        "source_sense_id": "a4d7581d-20ca-3836-a98b-924770a1cb57",
                        "source_sense_description": "Mineralogie: gelbe/gelbrote bis rotbraune Varietät des Zirkons",
                        "target_lang_word": "hyacinth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyacinth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "119939fd-8c0b-3fec-bfe9-9e699a65dac5",
                                        "entry_id": "caca9d21-6b90-37d0-a056-44a8af3ddaad",
                                        "glosses": [
                                            "Any bulbous plant of the genus Hyacinthus, native to the Mediterranean and South Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceeaccbf-7077-43a6-b366-599b5df0dda2",
                                                "sense_id": "119939fd-8c0b-3fec-bfe9-9e699a65dac5",
                                                "text": "On life's long round by chance I found / A dell impearled with dew, / Where hyacinths, gushing from the ground, / Lent to the earth heaven's native hue / Of holy blue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fabf3f-461a-3679-bc91-ecf308c10716",
                                        "entry_id": "caca9d21-6b90-37d0-a056-44a8af3ddaad",
                                        "glosses": [
                                            "A variety of zircon, ranging in color from brown, orange, reddish-brown and yellow; a jacinth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
