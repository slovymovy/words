            {
                "entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                "word": "vitrier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6385815-08cd-4be4-bead-a519aa405ee3",
                        "entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                        "tags": [
                            "plural"
                        ],
                        "form": "vitriers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3690283-10c2-3851-a6ae-96e89c283b97",
                        "entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                        "glosses": [
                            "Celui qui fait le commerce du verre à vitres, qui pose des vitres aux fenêtres."
                        ],
                        "tags": [],
                        "note": "ne pas confondre avec verrier",
                        "examples": [
                            {
                                "example_id": "c00416e5-fbe9-45e8-8193-7554ebfa0578",
                                "sense_id": "c3690283-10c2-3851-a6ae-96e89c283b97",
                                "text": "Un vitrier et l’entrepreneur en construction responsable du gratte-ciel étaient également sur place pour solidifier la structure et les fenêtres restantes, précise-t-il."
                            },
                            {
                                "example_id": "ffd798a8-10b8-47da-b64e-d86fbf3ced8f",
                                "sense_id": "c3690283-10c2-3851-a6ae-96e89c283b97",
                                "text": "La boutique d’un vitrier."
                            },
                            {
                                "example_id": "f83c3882-8db3-4218-8859-3a87326fc063",
                                "sense_id": "c3690283-10c2-3851-a6ae-96e89c283b97",
                                "text": "Vitrier ambulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e23cdff-f9a9-379b-880f-0e88b5613c67",
                        "entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                        "glosses": [
                            "Surnom donné aux chasseurs à pied de Vincennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e27569-0bcb-4447-a702-ad2f380fb600",
                                "sense_id": "7e23cdff-f9a9-379b-880f-0e88b5613c67",
                                "text": "Puis défilent les dragons avec leurs lances, les fantassins en gants blancs précédés de leur musique ; leur succèdent les chasseurs à pied, entraînés dans leur pas rapide par l’air bien connu et leur clique :\nPan Pan Larbi\nLes chacals sont par ici,\nLes chacals et les vitriers…\nEncore un carreau d’cassé !\nV’là le vitrier qui passe,\nEncore un carreau d’cassé !\nV’là le vitrier passé ! — (Édouard Bled, J’avais un an en 1900, Fayard, 1987, Le Livre de Poche, page 222.)"
                            },
                            {
                                "example_id": "cff322dd-d7ef-471c-971a-8c09b98b58b4",
                                "sense_id": "7e23cdff-f9a9-379b-880f-0e88b5613c67",
                                "text": "Au fort de Vincennes, on voyait circuler des soldats de toutes armes dont les célèbres et populaires chasseurs à pied surnommés « les vitriers »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a833b923-b3ce-4183-a354-72525e965099",
                        "source_entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                        "target_lang_word": "Glaser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glaser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                        "entry_id": "d61be226-f8d3-3ce9-8ea7-654e344a3ebc",
                                        "glosses": [
                                            "im Fenster- und Glasbau tätige Person; Fachmann für Fenster- und Glastechnik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8932118d-8d68-4328-a1b8-c2d06c60a177",
                                                "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                                "text": "Nach dem Sturm musste der Glaser vorbeikommen, um alle beschädigten Fenster instand zusetzen."
                                            },
                                            {
                                                "example_id": "f71fcbaf-1f80-437c-a0b8-db718541e0ff",
                                                "sense_id": "81f95c12-7a34-3dac-8897-180a22e481fb",
                                                "text": "„Der Glaser, den ich diesbezüglich sofort um Rat und Hilfe bat, teilte mir fernmündlich mit, diese Kleinigkeit lohne nicht den Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaac9458-70b1-4eb5-90b5-dfe2da481396",
                        "source_entry_id": "05ea1070-0b45-3682-bb93-589c70441b03",
                        "target_lang_word": "glazier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glazier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2d6d50-b2de-308a-98c5-afa9a411ba22",
