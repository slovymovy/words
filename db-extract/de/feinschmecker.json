                ],
                "senses": [
                    {
                        "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                        "entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                        "glosses": [
                            "Mensch mit einem verwöhnten und/oder anspruchsvollen Geschmack und einem ausgeprägten Sinn für feine Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8eb7a9-4abc-4f6c-bf06-e7d32ccec5fb",
                                "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                                "text": "„In keiner anderen deutschen Stadt gibt es so viele chinesische Restaurants wie in Berlin. Als Ende der 20er Jahre bereits das erste in der Hauptstadt eröffnete, bejubelten die Feinschmecker die \"neue, kulinarische Weltoffenheit\" der Metropole.“"
                            },
                            {
                                "example_id": "ba16db79-b1b4-48da-8c4b-379eef1fc0f5",
                                "sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                                "text": "„Er war ein schöner Mann, ein Feinschmecker und Schlemmer und sehr geistreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5ac0c2c-daf6-470c-8bba-f75f469a7838",
                        "source_entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                        "source_sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                        "target_lang_word": "gastronomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gastronomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66f18d36-3516-3e93-aca7-2236160e6c0f",
                                        "entry_id": "8fab8356-2f03-331f-866f-e622d5e1a6c5",
                                        "glosses": [
                                            "a lover of good food; a connoisseur or gourmet"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c2afbec-1da4-46e9-9687-b30e39abc619",
                        "source_entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                        "source_sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                        "target_lang_word": "gourmet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gourmet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                        "entry_id": "d24d1366-eb60-39d0-8804-22f72260b91c",
                                        "glosses": [
                                            "Fine; of superior quality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3eb5549-50bf-40b1-8115-1d32b39b4194",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "We need to go to the gourmet grocery store to get the exotic ingredients for this recipe."
                                            },
                                            {
                                                "example_id": "1330b9c6-491e-47a0-b449-cb4c5b5dc8b2",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "The restaurant offered gourmet coffee and cigars after the meal."
                                            },
                                            {
                                                "example_id": "9e5aec0e-c632-4d54-835f-8971da4aac12",
                                                "sense_id": "2ecb1d1d-f78a-3439-bd58-d04af47ada12",
                                                "text": "[On the coffee] Mmm! God damn, Jimmie! This is some serious gourmet shit!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gourmet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0c8fff-5e43-35ca-958e-70807c0838f5",
                                        "entry_id": "51a1c672-b4fd-3e9e-927f-fca8da74fb6e",
                                        "glosses": [
                                            "A connoisseur in eating and drinking; someone who takes their food seriously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fa427a-dca3-4b85-b58b-682a927e2942",
                                                "sense_id": "7f0c8fff-5e43-35ca-958e-70807c0838f5",
                                                "text": "The vulvae of the sow were popular as a gourmet's dish. Credited with erotic effects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2ba68dd-09a5-4e4d-87cd-14929674acc1",
                        "source_entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                        "source_sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                        "target_lang_word": "foodie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foodie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                        "entry_id": "f3340e60-1de5-35db-b19d-142bb097a786",
                                        "glosses": [
                                            "A person with a special interest in or knowledge of food, a gourmet."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c46c64-fb53-47fb-b6c7-8085dec007a9",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "We self-professed foodies liked to meet in restaurants and talk like experts about what we were eating."
                                            },
                                            {
                                                "example_id": "f71d894e-3db7-4ee1-9a55-6c507e381150",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "She offers crayfish with white feet or red . . . three ways, tends stove in high heels, slips into the small Art Deco dining room of Restaurant d'Olympe—a funeral parlor of shiny black walls and red velvet—to graze cheeks with her devotees, serious foodies, and, from ten on, tout Paris, the men as flashily beautiful as their beautiful women."
                                            },
                                            {
                                                "example_id": "b392e62a-774e-4b5c-a9c9-eb0ada934fb5",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "Foodies are the ones talking about food in any gathering—salivating over restaurants, recipes, radicchio. They don't think they are being trivial–Foodies consider food to be an art, on a level with painting or drama."
                                            },
                                            {
                                                "example_id": "95042abf-5b38-4087-b30e-51c5c9aa425e",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "“Foodie” has now pretty much everywhere replaced “gourmet”, perhaps because the latter more strongly evokes privilege and a snobbish claim to uncommon sensory discrimination—even though those qualities are rampant among the “foodies” themselves."
                                            },
                                            {
                                                "example_id": "bb8e6be1-b0a2-4a47-8c15-230179a26608",
                                                "sense_id": "cd150ac7-11a7-3e71-8fdd-5e51f6361699",
                                                "text": "While the Foodie Handbook is now decades old, its message strikes a chord with contemporary foodie discourse, touching on themes like the abysmal quality of mainstream food (e.g., “cheese in plastic-wrapped portions”), the appeal of foodie accoutrement like chefs' knives and gas stoves, as well as the importance of thinking and talking about food (as opposed to just eating well—“pigs can eat well”) (1984: 6–7)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9cd221-a64d-4dcf-bfec-e549876b50e1",
                        "source_entry_id": "0b48cff2-6476-36c4-99ff-11734a3e61ae",
                        "source_sense_id": "af897dc3-a03b-395a-abdd-e7b4c44f7ff7",
                        "target_lang_word": "connoisseur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connoisseur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                        "entry_id": "a5ba02aa-8b3b-3a61-b8ed-f44e609f0f62",
                                        "glosses": [
                                            "A specialist in a given field whose opinion is highly valued, especially in one of the fine arts or in matters of taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc76876-3979-4c0b-96dd-71a7c5e3180d",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "beer connoisseur"
                                            },
                                            {
                                                "example_id": "13c4d7f6-2a8e-4d51-8b2b-87ed48b37608",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "chocolate connoisseur"
                                            },
                                            {
                                                "example_id": "d93e4dba-e388-485f-99da-8f17022654a3",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "wine connoisseur"
                                            },
                                            {
                                                "example_id": "aaa6daf9-b782-4b4f-8636-0eb0d6971377",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "It is evident, in spite of his frequent attention to her while she draws, that in fact he knows nothing of the matter. He admires as a lover, not as a connoisseur."
                                            },
                                            {
                                                "example_id": "db6c3e12-575f-4b3c-9beb-9e81e1223ef8",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "No; nonsense, Naumann! English ladies are not at everybody’s service as models. And you want to express too much with your painting. You would only have made a better or worse portrait with a background which every connoisseur would give a different reason for or against."
                                            },
                                            {
                                                "example_id": "f9a07937-93dc-4096-ada3-1e9e71d47be9",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "This, when it was brought to him, he drank slowly, like a connoisseur, lingering on the taste and still looking about him at the cliffs and up at our signboard."
                                            },
                                            {
                                                "example_id": "a9f78890-bae5-4744-ab39-d1ab74061cea",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "Real connoisseurs know that to nose and taste properly you have to add still water to your tulip-shaped glass so that the alcohol doesn't overwhelm you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
