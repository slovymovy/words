                    {
                        "sense_id": "91130329-1c74-37fa-bc9e-982574b964c4",
                        "entry_id": "8ce98530-e157-3856-8295-9364a5ffb02c",
                        "glosses": [
                            "Zeit, die ein IT-System benötigt, um auf eine Benutzeranfrage adäquat zu reagieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e308a3da-5d41-433a-908a-125e09031bca",
                                "sense_id": "91130329-1c74-37fa-bc9e-982574b964c4",
                                "text": "„Bereits in der alten Version stiegen die Antwortzeiten des Servers in dieser Konfiguration bei längerem Betrieb enorm an.“"
                            },
                            {
                                "example_id": "b09dfe2a-0d2c-4d80-aa3c-f7de8116fdd8",
                                "sense_id": "91130329-1c74-37fa-bc9e-982574b964c4",
                                "text": "„Die durchschnittliche Antwortzeit bei einer Suche beträgt zurzeit nur noch einen Bruchteil einer Sekunde.“"
                            },
                            {
                                "example_id": "c229a187-4ace-4a5e-a6c8-b43d276e2acd",
                                "sense_id": "91130329-1c74-37fa-bc9e-982574b964c4",
                                "text": "Das sind keine Antwortzeiten mehr, das sind Lieferzeiten!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1d37364-f735-3537-8779-0fac62fc5b6b",
