                "senses": [
                    {
                        "sense_id": "90e499c6-bb46-3724-bf7d-d0eb866f4347",
                        "entry_id": "2aa88685-d463-32a6-aafd-2f10d1d93ac1",
                        "glosses": [
                            "angeschwemmtes, fruchtbares Land an der Küste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75847295-3e03-4461-9ba9-a59ad583d789",
                                "sense_id": "90e499c6-bb46-3724-bf7d-d0eb866f4347",
                                "text": "„Wale, weite, flache Landschaft, historische Häuser und expressionistische Malerei der ersten Stunde: In Nordfriesland erstreckt sich die Marschlandschaft um den kleinen Ort Seebüll in der Gemeinde Neukirchen.“"
                            },
                            {
                                "example_id": "92aad6a9-4864-45dc-9ac0-7c4bcf9a6056",
                                "sense_id": "90e499c6-bb46-3724-bf7d-d0eb866f4347",
                                "text": "„In der Marschlandschaft zwischen Euphrat und Tigris, die einst als Vorbild für den biblischen Garten Eden galt, wird das Wasser knapp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
