                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "ba9b6963-6e6c-41c1-aebc-0f8cc1bf141d",
                                "sense_id": "338b1c54-3e1c-366e-b45b-96fd557c0a9f",
                                "text": "C'est crevant de voir crever une crevette sur la cravate d'un homme crevé dans une crevasse.",
                                "translation": "Het is stikleuk een garnaal te zien creperen op de stropdas van een man die doodop in een kloof ligt."
                            }
                        ]
                    }
