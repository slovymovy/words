                "senses": [
                    {
                        "sense_id": "65dc76f1-1c01-3e2a-98af-27580c56be61",
                        "entry_id": "22129f2c-ad11-389c-9113-1b5b9c5520cd",
                        "glosses": [
                            "Outil qui sert à fendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63db0f6f-0faa-4143-83a9-5296c3722885",
                                "sense_id": "65dc76f1-1c01-3e2a-98af-27580c56be61",
                                "text": "Lorsque le fendoir est enfoncé, on le tourne un peu pour faire fendre le piquet; on y fait entrer le lacet par le bout opposé au nœud coulant; […]."
                            },
                            {
                                "example_id": "0b16ae93-df92-4cb0-b2a0-9523c95faffa",
                                "sense_id": "65dc76f1-1c01-3e2a-98af-27580c56be61",
                                "text": "Avec la serpette, elle fend en quatre l'extrémité d'un brin qu'elle engage ensuite dans le fendoir. Un coup de manivelle et le brin s'ouvre en quatre comme une corolle de fleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8f5e40b-9111-42e9-8a28-74096368e6d8",
                        "source_entry_id": "22129f2c-ad11-389c-9113-1b5b9c5520cd",
                        "source_sense_id": "65dc76f1-1c01-3e2a-98af-27580c56be61",
                        "target_lang_word": "cleaver",
