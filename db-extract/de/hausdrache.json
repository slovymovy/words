                "senses": [
                    {
                        "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                        "entry_id": "82bce7b2-fb13-3c61-8573-1eb1c6f7b3b5",
                        "glosses": [
                            "Frau, die streitsüchtig/zänkisch und sehr dominant ist und im Haus des Mannes lebt (häufig die Ehefrau, aber auch die Schwiegermutter oder eigene Mutter)"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c8e50538-fa21-4ec6-8129-7d620a519d81",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "„Wenn du dich hier weiter als Hausdrache aufführst, dann werden wir uns trennen!“"
                            },
                            {
                                "example_id": "a822bd15-7f8f-4d78-af6e-0afef05d41d6",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "Seine [des Schriftstellers Kurt Tucholskys] Mutter muss ein ziemlicher Hausdrache gewesen sein […]."
                            },
                            {
                                "example_id": "915e88f3-fd41-4676-910b-b9a8122724f0",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "„Sie können ja ein richtiger Hausdrache sein.“ „Was bleibt mir anderes übrig, wenn ich es mit solchen Dickschädeln wie Ihnen und Poppy zu tun habe?“"
                            },
                            {
                                "example_id": "f0ac103d-465f-4d31-84df-fb4c59dffd7f",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "Dass sie kein nörgelnder, unzufriedener Hausdrache geworden ist, verdankt sie ihrer positiven Einstellung."
                            },
                            {
                                "example_id": "e9044ce6-1534-4c73-a1d3-0b68f840eb6d",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "In mehr als 65 Jahren stand die Schauspielerin [Heidi Kabel aus Hamburg] in über 160 plattdeutschen Stücken auf der Bühne, spielte tratschsüchtige Nachbarsfrauen, keifende Hausdrachen, bauernschlaue Mütter und schrullige Alte."
                            },
                            {
                                "example_id": "e8b40cb8-508b-421a-9906-28cd747477e5",
                                "sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                                "text": "Längst keine Seltenheit mehr, aber selten ein Thema, ist dagegen die Gewalt, die Frauen gegen Männer richten. Gemeint ist nicht etwa die Standpauke eines Bratpfannen schwingenden Hausdrachen sondern brachiale Ausbrüche mit harten Schlägen, blutenden Wunden und tiefen seelischen Verletzungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff67e3b0-e742-4f11-afa4-35b71c9670e4",
                        "source_entry_id": "82bce7b2-fb13-3c61-8573-1eb1c6f7b3b5",
                        "source_sense_id": "587ab6ca-a3dd-35fa-ad7d-ca680faef683",
                        "source_sense_description": "streitsüchtige, zänkische im gleichen Haushalt lebende Frau",
                        "target_lang_word": "shrew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrew",
