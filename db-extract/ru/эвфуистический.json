                                "target_senses": [
                                    {
                                        "sense_id": "3fa29b39-1bf0-3ec3-a918-127e032a83de",
                                        "entry_id": "2426a359-b5cc-34b7-b3b4-664f04b473da",
                                        "glosses": [
                                            "Of or pertaining to euphuism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537cc107-ffba-4f43-9c81-7cfcbfc09055",
                                                "sense_id": "3fa29b39-1bf0-3ec3-a918-127e032a83de",
                                                "text": "James Harvey, a prominent Methodist, published his Meditation among Tombs in 1745. It contained many a euphuistic sentence as morbid as the following: “Instead of sumptuous tables and delicious treats, the poor voluptuary is himself a feast for fattened insects; the reptile riots in his flesh.”"
                                            },
                                            {
                                                "example_id": "98d6b6e7-e9a7-45d3-8f6b-741b98210c0b",
                                                "sense_id": "3fa29b39-1bf0-3ec3-a918-127e032a83de",
                                                "text": "In English, curiously, the euphuistic use of “behind” (as in “Get off your behind”) to mean “buttocks” is turning this preposition into a body-part noun (which is rare)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
