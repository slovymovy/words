                        "glosses": [
                            "Celle qui vend des graines ou des grains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be2bfe43-4d7f-43e2-b988-d7063657cb13",
                                "sense_id": "3fc40fcb-8b6f-35ce-b9cf-e93240c79ad2",
                                "text": "Par une disposition exceptionnelle, dans une corporation mixte et qui prouve que les femmes devaient être presque aussi nombreuses que les hommes dans la corporation, non seulement les maîtresses grainières pouvaient, après six ans d’exercice, être élues jurées par la communauté des maîtres et des maîtresses, mais deux jurées sur quatre devaient être choisies parmi les maîtresses."
                            },
                            {
                                "example_id": "a46bee94-b61a-468c-a362-bc2fb9a934ca",
                                "sense_id": "3fc40fcb-8b6f-35ce-b9cf-e93240c79ad2",
                                "text": "Les autres commerçantes – une grainière, une boulangère, une logeuse – sont locataires de leur maison et de leur boutique."
                            }
                        ]
                    }
