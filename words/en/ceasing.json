{
    "word_family": [
        "cease",
        "ceaseless",
        "ceaselessly",
        "cessation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4c0c754-be45-3739-9966-9c5288684d63",
                    "sense_definition": "present participle and gerund of <w>cease</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory workers are <w>ceasing</w> operations until safety inspections are complete.",
                            "target_lang_translations": {
                                "de": "Die Fabrikarbeiter <w>stellen</w> den Betrieb <w>ein</w>, bis die Sicherheitsprüfungen abgeschlossen sind."
                            }
                        },
                        {
                            "text": "She listened to the wind gradually <w>ceasing</w> outside her window as the storm passed.",
                            "target_lang_translations": {
                                "de": "Sie lauschte dem Wind vor ihrem Fenster, wie er allmählich <w>abklang</w>, als der Sturm vorüberzog."
                            }
                        }
                    ],
                    "synonyms": [
                        "stopping",
                        "halting",
                        "ending"
                    ],
                    "antonyms": [
                        "starting",
                        "beginning",
                        "continuing"
                    ],
                    "common_phrases": [
                        "ceasing operations",
                        "ceasing to exist"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „cease“; mit etwas aufhören, einstellen oder enden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einstellen",
                                "target_lang_sense_clarification": "eine Tätigkeit oder einen Betrieb beenden"
                            },
                            {
                                "target_lang_word": "aufhören",
                                "target_lang_sense_clarification": "zum Stillstand oder Ende kommen"
                            },
                            {
                                "target_lang_word": "abklingen",
                                "target_lang_sense_clarification": "bei Wetter, Geräuschen oder Empfindungen nachlassen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d69b754f-7679-3cb5-99b3-35bf29148584",
                    "sense_definition": "The act or instance of stopping; a cessation or ending.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher reflected on the constant arising and <w>ceasing</w> of all physical things.",
                            "target_lang_translations": {
                                "de": "Der Philosoph dachte über das ständige Entstehen und <w>Vergehen</w> aller materiellen Dinge nach."
                            }
                        },
                        {
                            "text": "With the gradual <w>ceasing</w> of the rain, people returned to the city streets.",
                            "target_lang_translations": {
                                "de": "Mit dem allmählichen <w>Nachlassen</w> des Regens kehrten die Menschen auf die Straßen der Stadt zurück."
                            }
                        }
                    ],
                    "synonyms": [
                        "cessation",
                        "stopping",
                        "termination"
                    ],
                    "antonyms": [
                        "continuation",
                        "beginning"
                    ],
                    "common_phrases": [
                        "arising and ceasing"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Aufhören, Beenden oder Aussetzen; das Ende oder das Vergehen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Aufhören",
                                "target_lang_sense_clarification": "das Zu-Ende-Gehen einer Handlung oder eines Zustands"
                            },
                            {
                                "target_lang_word": "das Vergehen",
                                "target_lang_sense_clarification": "das Enden oder Verschwinden im philosophischen/zeitlichen Kontext"
                            },
                            {
                                "target_lang_word": "die Einstellung",
                                "target_lang_sense_clarification": "die Beendigung von Vorgängen oder Tätigkeiten"
                            },
                            {
                                "target_lang_word": "das Nachlassen",
                                "target_lang_sense_clarification": "das allmähliche Aufhören von Naturereignissen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}