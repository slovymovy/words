    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c89aac6-9914-3756-a2b5-a6015f725145",
                    "sense_definition": "Of or relating to the nation of Germany, its people, or their culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_germany_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>German</w> economy is the largest in Europe.",
                            "target_lang_translations": {
                                "ru": "<w>Немецкая</w> экономика — крупнейшая в Европе.",
                                "zh": "<w>德国的</w>经济规模在欧洲最大。"
                            }
                        },
                        {
                            "text": "We enjoyed traditional <w>German</w> food at the festival.",
                            "target_lang_translations": {
                                "ru": "На фестивале нам понравилась традиционная <w>немецкая</w> еда.",
                                "zh": "我们在节庆上品尝了传统的<w>德国</w>美食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "German shepherd",
                        "German measles",
                        "German engineering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Германии, её народу или культуре.",
                        "zh": "德国的，或与德国、德国人民及其文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немецкий",
                                "target_lang_sense_clarification": "относящийся к современной Германии"
                            },
                            {
                                "target_lang_word": "германский",
                                "target_lang_sense_clarification": "относящийся к государству или истории"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "德国的",
                                "target_lang_sense_clarification": "指德国这个国家、德国人或德国文化的"
                            },
                            {
                                "target_lang_word": "德式",
                                "target_lang_sense_clarification": "多指风格、做法或文化特色"
                            },
                            {
                                "target_lang_word": "德意志的",
                                "target_lang_sense_clarification": "较正式，指德意志相关的"
                            }
