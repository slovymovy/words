                    "frequency": "High",
                    "semantic_group_id": "part_of_whole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like another <w>piece</w> of pie for dessert.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел еще один <w>кусочек</w> пирога на десерт."
                            }
                        },
                        {
                            "text": "I have lost a <w>piece</w> of this jigsaw puzzle and cannot finish it.",
                            "target_lang_translations": {
                                "ru": "Я потерял <w>деталь</w> этого пазла и не могу его закончить."
                            }
                        }
                    ],
                    "synonyms": [
                        "part",
                        "portion",
                        "bit",
                        "fragment",
                        "slice",
                        "chunk"
                    ],
                    "antonyms": [
                        "whole",
                        "entirety"
                    ],
                    "common_phrases": [
                        "piece of pie",
                        "puzzle piece",
                        "piece of cake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть целого, обычно в такой форме, которая позволяет отделить её от других частей."
