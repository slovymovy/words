                                        "entry_id": "83924fb4-dda8-3d6a-a35b-b9e4ef4caf83",
                                        "glosses": [
                                            "längliches Gerät, um in einer Brandstelle das Brennmaterial zu richten oder zu entfernen"
                                        ],
