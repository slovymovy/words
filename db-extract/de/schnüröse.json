                        "target_lang_word": "œillet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œillet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73b806e6-77db-3dae-bb60-3690b4378a71",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Petit trou en forme d’œil, pratiqué dans une étoffe, dans du cuir ou dans un autre matériau, entouré de soie, de fil ou d’un petit cercle de métal, et qui sert à accrocher ou à passer un lacet, un cordon, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e42869-a77a-46a6-95e7-818d3f1ad245",
                                                "sense_id": "73b806e6-77db-3dae-bb60-3690b4378a71",
                                                "text": "Les œillets des chaussures permettent de faire passer les lacets."
                                            },
                                            {
                                                "example_id": "43cbc47c-c2f5-413b-8d9e-91265337f620",
                                                "sense_id": "73b806e6-77db-3dae-bb60-3690b4378a71",
                                                "text": "… portant des jeans noirs, des brodequins de cuir jaune à œillets et à la tige bordée d'un galon marron foncé, elle venait de doubler le cap de la cinquantaine."
                                            },
                                            {
                                                "example_id": "a5c58d6b-6726-4133-b9bb-a0d06881d264",
                                                "sense_id": "73b806e6-77db-3dae-bb60-3690b4378a71",
                                                "text": "La France, c’était d’abord une carte, que ses œillets de cuivre tenaient suspendue au mur, avec, en grosses lettres noires, le nom d’un certain Vidal-Lablache, aussi mystérieux que le cheval Balker du garage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79fb3c36-13cd-39bc-b934-76fc09deeca9",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Nom de la bordure en métal de ce trou."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d65d2b31-f9dc-46d1-ab0c-c009ca68dcf7",
                                                "sense_id": "79fb3c36-13cd-39bc-b934-76fc09deeca9",
                                                "text": "Pince à œillets."
                                            },
                                            {
                                                "example_id": "a8ed7c5f-3f3a-433f-94c0-4e706bf68903",
                                                "sense_id": "79fb3c36-13cd-39bc-b934-76fc09deeca9",
                                                "text": "Poser des œillets sur un corsage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f84adac-e079-3c01-a8f0-9728c3bada6b",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Bague située à l'extrémité d’une manœuvre pour y faire passer un cordage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fadaccaa-98ee-30f0-8c7c-962c36e7dc0b",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Extrémité de la hampe d'un hameçon, formant un anneau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efb957d0-9c96-3ea2-a95f-bf941d5aa2f4",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Papier autocollant utilisé comme renfort des perforations des feuilles de classeur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35962cdb-cf24-31f7-9167-80236b4933d3",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Bassin d'un marais salant de forme rectangulaire situé dans la partie centrale de la saline et où se dépose le sel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21034399-3adb-4173-866b-caf4b0c4f53e",
                                                "sense_id": "35962cdb-cf24-31f7-9167-80236b4933d3",
                                                "text": "Ce paludier possède cinquante œillets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d84b0a5-924f-3be2-ba2b-d864396465dd",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "Nom de différentes espèces de plantes dicotylédones appartenant généralement à divers genres de la famille des caryophyllacées à végétation annuelle ou vivace et cultivées pour leurs fleurs rouges, roses, blanches, jaunes, oranges et parfois odorantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e084fd61-3eb5-467c-802a-fd7c94ec6930",
                                                "sense_id": "7d84b0a5-924f-3be2-ba2b-d864396465dd",
                                                "text": "De même que les horticulteurs s’adonnent aux roses, aux dahlias, aux œillets, aux pélargoniums, et ne font aucune attention à l’espèce qu’ils n'ont pas élue pour leur fantaisie, ce jeune La Rochefoucauld-Liancourt appartenait aux ouvriers, aux prolétaires, aux misères des faubourgs Saint-Jacques et Saint-Marceau."
                                            },
                                            {
                                                "example_id": "b13e0b0d-25e6-4284-979f-a8e7a71e29d7",
                                                "sense_id": "7d84b0a5-924f-3be2-ba2b-d864396465dd",
                                                "text": "À l’entrée de sa loge, le Marseillais s’exhibait dans un smoking lavande fleuri d’un œillet pourpre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75b7bc4c-f64a-3b1b-a114-be764b7d348b",
                                        "entry_id": "5156a66b-a426-3cc2-95f0-c387b2b6587e",
                                        "glosses": [
                                            "La plante elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7164a7a-3b57-4a6f-af1a-54337d07c791",
                                                "sense_id": "75b7bc4c-f64a-3b1b-a114-be764b7d348b",
                                                "text": "Planter des œillets."
                                            },
                                            {
                                                "example_id": "6025f725-9669-454e-b22f-21cdb0c67fbd",
                                                "sense_id": "75b7bc4c-f64a-3b1b-a114-be764b7d348b",
                                                "text": "Un pied, un pot d’œillets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
