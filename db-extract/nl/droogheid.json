                                        "sense_id": "deb28c5e-88e2-31b9-be86-1cddfe71aaaa",
                                        "entry_id": "3c1f8f56-62d0-3daa-9e84-0b2f95fc839f",
                                        "glosses": [
                                            "A lack of moisture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de6e563a-9022-4e35-a85f-f86b6a8c2bf8",
                                                "sense_id": "deb28c5e-88e2-31b9-be86-1cddfe71aaaa",
                                                "text": "Dr. Khorana added that this is especially true of cleansers that feature surfactants like sodium lauryl sulfate, as this class of ingredients can cause “dryness, irritation and eczema.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be05654a-f2f7-3a3a-9547-3ffa327ac5f9",
                                        "entry_id": "3c1f8f56-62d0-3daa-9e84-0b2f95fc839f",
                                        "glosses": [
                                            "The degree to which something is dry."
                                        ],
                                        "tags": [
                                            "countable",
