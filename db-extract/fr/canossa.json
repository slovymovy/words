                "senses": [
                    {
                        "sense_id": "4c312129-174c-3bb4-afc8-8d5133c5cae7",
                        "entry_id": "fdafb4b0-548e-3edb-aa98-92974a2ccd62",
                        "glosses": [
                            "Le fait d’aller à Canossa; pénitence humiliante."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1072a306-44c0-4f99-9eeb-0b88c9206768",
                                "sense_id": "4c312129-174c-3bb4-afc8-8d5133c5cae7",
                                "text": "Aussi voyons-nous la France et la Papauté dans une telle étreinte, qu'il faudra que le secours suprême de l'humanité lui soit apporté par la race de ceux qui ont inscrit le mot de Canossa dans les deuils de leur dignité mémorieuse."
                            },
                            {
                                "example_id": "72fa8a23-7b2a-4ed8-b80d-82a5880b8965",
                                "sense_id": "4c312129-174c-3bb4-afc8-8d5133c5cae7",
                                "text": "Quant à la nation, elle figure sans doute la pénitence de ces internationalistes, le Canossa de ces pèlerins d’Amsterdam, de Stockholm ou de Genève."
                            }
                        ]
                    }
