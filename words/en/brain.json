    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dacd2e75-1d6a-3873-bea7-e9143cf91b76",
                    "sense_definition": "The organ inside the head that controls thought, memory, feelings, and activity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sem_organ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The human <w>brain</w> is a very complex organ.",
                            "target_lang_translations": {
                                "ru": "Человеческий <w>мозг</w> — очень сложный орган.",
                                "pl": "Ludzki <w>mózg</w> jest bardzo złożonym narządem."
                            }
                        },
                        {
                            "text": "Doctors were worried about possible <w>brain</w> damage after the accident.",
                            "target_lang_translations": {
                                "ru": "Врачи беспокоились о возможном повреждении <w>мозга</w> после аварии.",
                                "pl": "Lekarze martwili się o możliwe uszkodzenie <w>mózgu</w> po wypadku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human brain",
                        "brain damage",
                        "brain tumor",
                        "brain surgery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Орган внутри головы, управляющий мышлением, памятью, чувствами и деятельностью.",
                        "pl": "Narząd wewnątrz głowy, który kontroluje myślenie, pamięć, uczucia i aktywność."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мозг",
                                "target_lang_sense_clarification": "анат. орган нервной системы"
                            },
                            {
                                "target_lang_word": "головно́й мозг",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mózg",
                                "target_lang_sense_clarification": "narząd anatomiczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc07914f-2f58-33bc-8079-9618fcd2691a",
                    "sense_definition": "The ability to think clearly, learn quickly, and understand things; intellect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a fine <w>brain</w> for mathematics and logic.",
                            "target_lang_translations": {
                                "ru": "У нее прекрасный <w>ум</w> для математики и логики.",
                                "pl": "Ona ma świetny <w>umysł</w> do matematyki i logiki."
                            }
                        },
                        {
                            "text": "You need to use your <w>brain</w> to solve this puzzle.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно использовать свои <w>мозги</w>, чтобы решить эту головоломку.",
                                "pl": "Musisz ruszyć <w>głową</w>, żeby rozwiązać tę zagadkę."
                            }
                        }
                    ],
                    "synonyms": [
                        "mind",
                        "intellect",
                        "intelligence"
                    ],
                    "common_phrases": [
                        "use your brain",
                        "pick someone's brain",
                        "rack one's brain",
                        "no-brainer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность ясно мыслить, быстро учиться и понимать; интеллект.",
                        "pl": "Zdolność jasnego myślenia, szybkiej nauki i rozumienia rzeczy; intelekt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ум",
                                "target_lang_sense_clarification": "способность мыслить"
