                        "glosses": [
                            "Inhaber eines Unternehmens mit großem Einfluss auf die Wirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812b7420-bcd4-4866-9ba5-0fb9c4226522",
                                "sense_id": "bc90ec02-8799-3bf8-bb43-bcc2f5dd1920",
