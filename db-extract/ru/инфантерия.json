                                        "sense_id": "985e87cb-9c8d-374b-8a5e-451fe0b030a3",
                                        "entry_id": "dbc8e5b3-0fc1-3980-8ee6-f426cacb95eb",
                                        "glosses": [
                                            "Soldiers who fight on foot (on land), as opposed to cavalry and other mounted units, regardless of external transport (e.g. airborne)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3a6b3a-c9e3-3daa-bcda-84d09e267aec",
                                        "entry_id": "dbc8e5b3-0fc1-3980-8ee6-f426cacb95eb",
                                        "glosses": [
                                            "The part of an army consisting of infantry soldiers, especially opposed to mounted and technical troops."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6710e0b-b139-3583-b272-9cf8d728db76",
                                        "entry_id": "dbc8e5b3-0fc1-3980-8ee6-f426cacb95eb",
                                        "glosses": [
                                            "A regiment of infantry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e0b91fa-5382-3d2b-8f37-8a8c454b1bec",
                                        "entry_id": "dbc8e5b3-0fc1-3980-8ee6-f426cacb95eb",
                                        "glosses": [
                                            "Infants; children."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e674d4-52bf-4c52-80a5-6f4d58279cf5",
                                                "sense_id": "3e0b91fa-5382-3d2b-8f37-8a8c454b1bec",
                                                "text": "The next summer there was a crop of blackberries in the woods. I took wife and babies, supplied with lunch and horse feed; […] Wife took command of the infantry and I of the transportation. We were both soon calling loudly for assistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
