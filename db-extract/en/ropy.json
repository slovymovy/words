                        "entry_id": "e861908b-71d9-3f6a-b6e5-f4389fe9411e",
                        "glosses": [
                            "Of poor quality; in poor health."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "673a0b98-f1ca-4362-86bd-623bacafa206",
                                "sense_id": "a2d494f2-88de-3646-9126-9c546876ba2a",
                                "text": "The very poultry in the coop / Began to pine away and droop— / The cock was first to go; / And glad we were on all our parts, / He used to damp our very hearts / With such a ropy crow."
                            },
                            {
                                "example_id": "bcb2ae81-2d32-42ad-ab11-03c027615458",
                                "sense_id": "a2d494f2-88de-3646-9126-9c546876ba2a",
                                "text": "Although Britain’s migration figures are ropey, other data point in the same direction."
                            }
                        ]
                    }
