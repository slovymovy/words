                                        "entry_id": "a6bbb37c-cfa5-3156-bdc3-34c793dd7f6e",
                                        "glosses": [
                                            "relativo ao pai"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bcecd1c-9dc8-4c56-bb70-bda818c88693",
                                                "sense_id": "5546f4b6-c2b1-312d-a091-302fcf656f98",
                                                "text": "Seu avô paterno foi criado no interior do Quênia durante o Império Britânico."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921a8ef5-dce7-4dc7-be15-20412defaebe",
                        "source_entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "target_lang_word": "отцовский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отцовский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bade3081-671b-3672-a2c5-8c88f42c5cee",
                                        "entry_id": "7314ab40-2062-3f10-8cd8-cfad897f74bd",
                                        "glosses": [
                                            "относящийся к отцу, принадлежащий отцу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ddcb647-b7de-4017-8250-2efeb3e7b7a5",
                                                "sense_id": "bade3081-671b-3672-a2c5-8c88f42c5cee",
                                                "text": "Тем не менее половину зимы Костя проходил в отцовских валенках, пока из города не приехала их добрая тётя Наста, которая привезла ботинки, ставшие тесными её племяннику."
                                            },
                                            {
                                                "example_id": "7913a1a1-8239-4033-a0aa-9d677571eaeb",
                                                "sense_id": "bade3081-671b-3672-a2c5-8c88f42c5cee",
                                                "text": "Предки Данилова по отцовской линии к музыке относились без интереса."
                                            },
                                            {
                                                "example_id": "51e6dae0-1947-4f7a-af12-fa54bf867111",
                                                "sense_id": "bade3081-671b-3672-a2c5-8c88f42c5cee",
                                                "text": "И вспомнил я отцовский дом, // Ущелье наше, и кругом // В тени рассыпанный аул."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42cc710b-e841-32d0-9be4-fbfd03a414cf",
                                        "entry_id": "7314ab40-2062-3f10-8cd8-cfad897f74bd",
                                        "glosses": [
                                            "свойственный отцу, характерный для отца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1bf129-eaa9-45f7-a847-8434f09bb855",
                                                "sense_id": "42cc710b-e841-32d0-9be4-fbfd03a414cf",
                                                "text": "Раньше он никогда не баловался с дочкой, у него не было отцовских чувств, может, потому, что она маленькая."
                                            },
                                            {
                                                "example_id": "4cec2644-6618-43fe-aae1-71c7b2a8e62a",
                                                "sense_id": "42cc710b-e841-32d0-9be4-fbfd03a414cf",
                                                "text": "У него такое же круглое лицо, как и у отца, однако о магической проницательности отцовских глаз не может быть и речи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e6f4c1f-2bfd-470d-9cbb-81f13532a3c2",
                        "source_entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "target_lang_word": "otcovský",
