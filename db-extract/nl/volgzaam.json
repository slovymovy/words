                "senses": [
                    {
                        "sense_id": "2cd00812-6a27-3524-82be-24a7d154b7df",
                        "entry_id": "b1259399-b916-33de-8a3a-5cbb44addbfe",
                        "glosses": [
                            "bereid te volgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b70560-41a6-4d5e-8526-76d7a956fd77",
                                "sense_id": "2cd00812-6a27-3524-82be-24a7d154b7df",
                                "text": "Hij was nooit erg volgzaam geweest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d209708-68df-499a-a270-de4667784250",
                        "source_entry_id": "b1259399-b916-33de-8a3a-5cbb44addbfe",
                        "source_sense_id": "2cd00812-6a27-3524-82be-24a7d154b7df",
                        "target_lang_word": "folgsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folgsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c23b1752-fff4-3a9b-9c77-118fcff6f547",
                                        "entry_id": "07f63a98-fe6b-30ad-9b02-f2ae6aebf673",
                                        "glosses": [
                                            "bereit zu folgen, sich fügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399ad462-185e-4b0b-a44a-ecebfd4860e6",
                                                "sense_id": "c23b1752-fff4-3a9b-9c77-118fcff6f547",
                                                "text": "Die Mädchen sind immer folgsam und deswegen dürfen sie wiederkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ec6e147-e8c4-4659-848e-cc4db11a869d",
                        "source_entry_id": "b1259399-b916-33de-8a3a-5cbb44addbfe",
                        "source_sense_id": "2cd00812-6a27-3524-82be-24a7d154b7df",
                        "target_lang_word": "docile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "docile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c702ccac-4a5e-36cd-b1d4-bd71d74880cb",
                                        "entry_id": "712e44ae-5a10-3d0e-bab7-a640be02129a",
                                        "glosses": [
                                            "Ready to accept instruction or direction; obedient; subservient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9ea809-41b0-465a-9bcc-a64e914c3d10",
                                                "sense_id": "c702ccac-4a5e-36cd-b1d4-bd71d74880cb",
                                                "text": "With that he dropped his head again, lamenting over and caressing her, and there was not a sound in all the house for a long, long time; they remaining clasped in one another’s arms, in the glorious sunshine that had crept in with Florence.\nHe dressed himself for going out, with a docile submission to her entreaty; and walking with a feeble gait, and looking back, with a tremble, at the room in which he had been so long shut up, and where he had seen the picture in the glass, passed out with her into the hall."
                                            },
                                            {
                                                "example_id": "4e9f94d5-c350-49a7-bbb2-9a982cffbf68",
                                                "sense_id": "c702ccac-4a5e-36cd-b1d4-bd71d74880cb",
                                                "text": "Harriet certainly was not clever, but she had a sweet, docile, grateful disposition; was totally free from conceit; and only desiring to be guided by any one she looked up to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca5db22-62b8-30b7-ab41-bc7bcc099597",
                                        "entry_id": "712e44ae-5a10-3d0e-bab7-a640be02129a",
                                        "glosses": [
                                            "Yielding to control or supervision, direction, or management."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa581da-fc96-4f2f-a13f-81324e22c679",
                                                "sense_id": "cca5db22-62b8-30b7-ab41-bc7bcc099597",
                                                "text": "Such literature may well be anathema to those, who are too docile and petty for their own good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbdb2c96-7791-4466-adb6-064865164399",
                        "source_entry_id": "b1259399-b916-33de-8a3a-5cbb44addbfe",
                        "source_sense_id": "2cd00812-6a27-3524-82be-24a7d154b7df",
                        "target_lang_word": "docile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "docile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "662db420-588c-3312-91a5-afa92f603a80",
                                        "entry_id": "871689a2-0dc6-3868-80c5-965b5982e03f",
                                        "glosses": [
                                            "Qui a de la disposition à se laisser conduire et diriger. Qui obéit facilement. Caractère docile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30fe00c1-e9b4-4729-ba8e-1f26867fd6af",
                                                "sense_id": "662db420-588c-3312-91a5-afa92f603a80",
                                                "text": "Il y avait bien un peu de négligence, chez eux, à son égard. Ils étaient moins empressés à le servir, moins dociles, désobéissant souvent à ses ordres, …."
                                            },
                                            {
                                                "example_id": "85eef5d8-2ab4-433e-a297-e9da654e2960",
                                                "sense_id": "662db420-588c-3312-91a5-afa92f603a80",
                                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, […], docile à toutes les flagorneries, aussi dépourvu de sens critique que de sens pratique, joueur, débauché, dépensier, […]"
                                            },
                                            {
                                                "example_id": "0df59744-712f-4406-bfec-504dc32e2bb9",
                                                "sense_id": "662db420-588c-3312-91a5-afa92f603a80",
                                                "text": "Ils gèrent leur domaine en exploitation semi-directe, par l'intermédiaire d'un régisseur qui a la haute main sur les travaux et les ouvriers, le plus souvent des ouvriers employés au mois, \"mesadiers\" venus de la montagne et plus dociles que les journaliers venus du village voisin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f4cd53c-ab27-3b4d-bf60-017fa26c4578",
                                        "entry_id": "871689a2-0dc6-3868-80c5-965b5982e03f",
                                        "glosses": [
                                            "Qui a de la disposition à céder, à obéir."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a92370-d1b6-4934-ac25-2c76b5c5e2c3",
                                                "sense_id": "5f4cd53c-ab27-3b4d-bf60-017fa26c4578",
                                                "text": "L'écolier est docile à ses maîtres, aux leçons magistrales, aux préceptes de bonne conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07cce658-4c34-307c-8e88-3dc41dde8749",
                                        "entry_id": "871689a2-0dc6-3868-80c5-965b5982e03f",
                                        "glosses": [
                                            "(a priori hors d'un champ de domination et de servitude) Qui se laisse instruire et éduquer. Un bon élève est par définition docile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81dd4a4-6eac-429a-b9c9-6d208bb547c9",
                                                "sense_id": "07cce658-4c34-307c-8e88-3dc41dde8749",
                                                "text": "(Cas particulier des débats, disputes et autres rivalités en gestation) Un personnage docile reste conciliant, n'expose aucune revendication, n'affiche encore moins une opposition virulente ou un point d’honneur."
                                            },
                                            {
                                                "example_id": "f3b8f4d2-c322-44c9-9cc5-ff3f7536f72b",
                                                "sense_id": "07cce658-4c34-307c-8e88-3dc41dde8749",
                                                "text": "Facile à vivre, doux et discipliné : Gaël est docile c'est un bon camarade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                        "entry_id": "871689a2-0dc6-3868-80c5-965b5982e03f",
                                        "glosses": [
                                            "Se dit aussi, des animaux domestiques dressés ou élevés, et ainsi préparés à des tâches spécifiques. L'adjectif s'applique même à des choses, par exemple à des matières qui se prêtent à un travail de transformation, qui obéissent à une mise en forme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eaffb1c-0bc6-49b8-b318-fc541332bdff",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "[…], les bêtes levèrent leur mufle humide et, dociles à l’invite de leur jeune gardien, gravirent le coteau pour reprendre, […], le chemin de terre bordé de haies vives aboutissant au village."
                                            },
                                            {
                                                "example_id": "8b87836c-06de-4768-bdc4-b602c51acdd6",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "Ce cheval, ce chien sont des animaux dociles."
                                            },
                                            {
                                                "example_id": "8a7c5c27-3007-4154-9722-2ada912a1b12",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "Ce bœuf docile au joug fera un excellent droitier pour l'attelage."
                                            },
                                            {
                                                "example_id": "779e356b-2f6d-481f-9316-728e3b0746a4",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "Une monture docile désigne un cheval ou un poney au caractère doux, facile à monter."
                                            },
                                            {
                                                "example_id": "5494715c-497b-4b1d-8a58-e95a7b09c239",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "L’osier est docile à la main du vannier."
                                            },
                                            {
                                                "example_id": "e6742b86-bb2e-4bd3-ac63-ae866fe29e50",
                                                "sense_id": "da081c7b-35e4-33fe-a74b-acd63bed9c56",
                                                "text": "Cheveux dociles : qui se coiffent aisément."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
