                "senses": [
                    {
                        "sense_id": "20f94f32-54f2-36b5-9029-6d9c4d9e63d7",
                        "entry_id": "72806492-92e9-3b4f-aee7-56eb42aa586c",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными киприот, Кипр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641738f0-3393-4cd6-b1d8-6f061f586fe7",
                                "sense_id": "20f94f32-54f2-36b5-9029-6d9c4d9e63d7",
                                "text": "На этот Новый год Ирина подарила такой же плейер своему давнему киприотскому партнеру."
                            }
                        ]
                    }
                ],
                "translations": [
