                "senses": [
                    {
                        "sense_id": "6ce60c1b-d023-3b38-8b38-51e1fcd61770",
                        "entry_id": "5359be1a-6c87-3f21-80dd-5f9e1b875d30",
                        "glosses": [
                            "Zeitraum, in dem eierlegende Tiere ihre Eier ausbrüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a427547-c9c6-4291-bb74-028e4225ed80",
                                "sense_id": "6ce60c1b-d023-3b38-8b38-51e1fcd61770",
                                "text": "„Außerhalb der Brutzeit leben Strauße in großen Trupps, während der Brutzeit hat ein Hahn meist mehrere Hennen, die in ein gemeinsames Nest legen (15–30 Eier je Nest).“"
                            },
                            {
                                "example_id": "fa2fd6a6-cd2d-459b-a374-1ef4538342c5",
                                "sense_id": "6ce60c1b-d023-3b38-8b38-51e1fcd61770",
                                "text": "„Denn die Brutzeit war fast vorbei.“"
                            }
                        ],
