                    {
                        "translation_id": "7e2cc402-ef37-4b42-96ea-93ace2054ca6",
                        "source_entry_id": "4b9a332a-d566-3bc8-83fd-e210219f6ae3",
                        "source_sense_id": "57bb87f6-1d6f-3b5d-b93a-33e5dbb41ac4",
                        "source_sense_description": "Jew from Germany or Eastern Europe",
                        "target_lang_word": "Aschkenasi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aschkenasi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                        "entry_id": "033e3efc-a497-3d91-9151-48d6c127e5fe",
                                        "glosses": [
                                            "Angehöriger oder Nachkomme der Gruppe nord-, mittel- und osteuropäischer Juden mit eigener Tradition, Kultur und Sprache, dem Jiddischen"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df26d71c-407e-44af-85b8-4bb1376dc654",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Die orientalischen Juden (Einwanderer aus Asien und Afrika), die immerhin etwa die Hälfte der Bevölkerung ausmachen, stellten nie mehr als 20 Prozent der Kibbuzniks, es waren vor allem die Aschkenasim (Juden aus Europa und Amerika), die sich von den Kibbuzim angezogen fühlten.“"
                                            },
                                            {
                                                "example_id": "561618c5-4a88-4752-be3f-404ad3ac3d5e",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Die ‚Rechten‘ haben den ‚aschkenasischen‘ Oslo-Vertrag verworfen, ein religiös-rechter Fanatiker hat Yitzhak Rabin, ein Aschkenasi par excellence, in einer ‚linken‘ Massenkundgebung ermordet.“"
                                            },
                                            {
                                                "example_id": "a06a856e-27c9-4c2a-a247-67bca06ca8f4",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Diese biografischen Stationen im Leben des Autors sind wichtig, um den Skandal nachvollziehen zu können, der am Anfang der literarischen Karriere des Aschkenasi David Grossman stand.“"
                                            },
                                            {
                                                "example_id": "54123b41-ea56-4f3b-b9b7-a831b5fd9948",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Derrida und Roudinesco erzählen, wie sie durch das Aufeinandertreffen verschiedener Kulturen und Religionen geprägt wurden: Roudinesco von ihrem Vater, einem aus Rumänien immigrierten Aschkenasi, der das Kainsmal des verbitterten jüdischen Selbsthasses nicht überwand, schliesslich die Tochter taufen liess, um sie in der ‚wahren katholischen Religion‘ zu erziehen; Derrida von seinem ‚gedemütigten Vater‘, einem jüdischen Handelsvertreter in der französischen Kolonialstadt Algier, ebenso von den Gefahren eines von oben dekretierten Antisemitismus.“"
                                            },
                                            {
                                                "example_id": "682716a3-81d4-450a-affb-b22d6851dfbe",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Zwischen 1880 und 1939 lassen sich rund 110 000 Aschkenasim in Frankreich nieder, viele von ihnen im Marais.“"
                                            },
                                            {
                                                "example_id": "605d4d10-454f-4bbc-aee3-953579131c73",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Der Grund für die Verzweiflung der irakischen Juden waren weniger die Lebensbedingungen als die Verunglimpfung ihrer Kultur in einem Israel, in dem die Aschkenasim aus Osteuropa dominierten.“"
                                            },
                                            {
                                                "example_id": "e16526e7-f1b1-4c6c-9028-c10061b03414",
                                                "sense_id": "52c4d5be-cc22-3fbd-8dce-f478a71d9e5a",
                                                "text": "„Im östlichen Europa, wohin im Hoch- und Spätmittelalter die meisten Aschkenasim auswanderten, waren dies vor allem slawische Sprachen, nicht zuletzt Polnisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
