                    {
                        "sense_id": "c1959a0a-9da1-39e7-8d11-2936e2fe57e7",
                        "entry_id": "3a213620-16ad-37e9-a953-c15300e2e4c1",
                        "glosses": [
                            "Fragment aus Metall, aus Metall bestehendes Bruchstück eines größeren Gegenstands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb2489c-e9c2-4dbd-b9f9-f2a952bcc23a",
                                "sense_id": "c1959a0a-9da1-39e7-8d11-2936e2fe57e7",
                                "text": "„Die Erde vor der Öffnung war mit einer Mischung aus Gesteinssplittern und rasiermesserscharfen Metallfragmenten übersät.“"
                            },
                            {
                                "example_id": "8e9a7fad-6bac-4c80-9559-2b95e61b26a6",
                                "sense_id": "c1959a0a-9da1-39e7-8d11-2936e2fe57e7",
                                "text": "„Ein Metallfragment habe den vorübergehenden Kurzschluss in einem der gewaltigen Magnete im unterirdischen Beschleunigerring verursacht, teilte das Teilchenforschungsinstitut in Meyrin bei Genf mit.“"
                            }
                        ],
