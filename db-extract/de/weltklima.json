                ],
                "senses": [
                    {
                        "sense_id": "6d0cbd56-d1bb-3ba0-a111-abc1f8d8e9a8",
                        "entry_id": "f128ada5-6cfa-32ab-b216-963759cad30a",
                        "glosses": [
                            "globales Klima der Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4164eef1-9ee2-4d5b-aff2-39622c075dc3",
                                "sense_id": "6d0cbd56-d1bb-3ba0-a111-abc1f8d8e9a8",
                                "text": "„Würden wir unsere Lebensmittelverschwendung um die Hälfte reduzieren, hätte das laut Thurn den gleichen Effekt auf das Weltklima, als würden wir auf jedes zweite Auto verzichten.“"
                            },
                            {
                                "example_id": "c12fc1fb-6ebf-4b7e-9382-e9fffb51111f",
                                "sense_id": "6d0cbd56-d1bb-3ba0-a111-abc1f8d8e9a8",
                                "text": "„Und die guten Vorsätze, das Weltklima zu retten, verpuffen wortwörtlich, solange man mit der Zerstörung der Umwelt mehr Profit machen kann als mit deren Schutz.“"
                            },
                            {
                                "example_id": "b1ad3e81-8b54-4f87-af5e-4cf8f11899be",
                                "sense_id": "6d0cbd56-d1bb-3ba0-a111-abc1f8d8e9a8",
                                "text": "„Mein Nachbar möchte demnächst sogar eine Organisation gründen, die das Weltklima stabilisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
