                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62b14389-4ef8-48cb-adf2-e108a04fbe15",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "tags": [
                            "plural"
                        ],
                        "form": "solariums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d56716f-21ca-3038-a5df-d2e674358682",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Établissement où l'on traite certaines affections par la lumière solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba92ce15-0803-458b-895f-b04cd817b609",
                                "sense_id": "9d56716f-21ca-3038-a5df-d2e674358682",
                                "text": "Faire une cure de soleil dans un solarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "9de40418-021a-35e3-bc00-3a81e66c05c0",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Emplacement aménagé pour les bains de soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f93f14e-50ca-4f56-acf8-2ebf0e93489a",
                                "sense_id": "9de40418-021a-35e3-bc00-3a81e66c05c0",
                                "text": "En 1952, la clinique se voit adjoindre un nouveau pavillon, plus moderne que la maison initiale, qui comporte onze chambres et un solarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "599aa1ea-2668-3ff2-b638-5ca278a582b9",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Terrasse ou salle largement vitrée exposée au soleil pour ces traitements."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8d334456-d448-417f-8d3a-b60d929049ea",
                                "sense_id": "599aa1ea-2668-3ff2-b638-5ca278a582b9",
                                "text": "Le toit terrasse voulu par Le Corbusier peut servir de solarium, de terrain de sport ou de piscine."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f9af151-548b-3cea-9c42-d87901bca354",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Établissement où l'on peut se faire bronzer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6464d38-c336-4995-a35f-35c46360c6b9",
                                "sense_id": "9f9af151-548b-3cea-9c42-d87901bca354",
                                "text": "Aller au solarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d9f8bbc-b31e-318b-bb12-b97274eddc87",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Banc solaire ou machine à bronzer."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "8e9ce410-53e0-4e2a-aa8e-0d8985d1d0c9",
                                "sense_id": "2d9f8bbc-b31e-318b-bb12-b97274eddc87",
                                "text": "Je me suis acheté un solarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "de3b4abf-ed83-3886-8414-da66cd290ee2",
                        "entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "glosses": [
                            "Lieu d'exposition au soleil pour les animaux à sang froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095bf5a1-3b4c-4c94-b2a8-eb52bbb899ee",
                                "sense_id": "de3b4abf-ed83-3886-8414-da66cd290ee2",
                                "text": "Les tortues cistudes d'Europe s'exposent au soleil sur des solariums (troncs d'arbres morts, pierres, mottes ou roseaux couchés). Ce comportement s'appelle le bain de soleil. Elles adoptent alors une position optimale pour capter le rayonnement solaire. Quand l'énergie captée est suffisante, elles plongent dans l'eau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2ee0721-f0a4-448c-a135-4732c6d39432",
                        "source_entry_id": "19ebceb7-5e78-3aa2-bb77-87180d4d0f9f",
                        "target_lang_word": "solarium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solarium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef95dd3-bfc3-3269-8a39-61fbb8450775",
                                        "entry_id": "b92996eb-f941-3f06-b74a-33e62b5b18ed",
                                        "glosses": [
                                            "A room, rooftop, balcony, or terrace, used for its abundant sunlight, especially when used as a medical treatment."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2adc2b1-3f4e-4089-8648-b7e48756d706",
                                                "sense_id": "bef95dd3-bfc3-3269-8a39-61fbb8450775",
                                                "text": "My brother kept a health-lift a few years ago... and then he had a blue-glass solarium."
                                            },
                                            {
                                                "example_id": "09015bf8-bc74-4658-9a85-04f52c93918b",
                                                "sense_id": "bef95dd3-bfc3-3269-8a39-61fbb8450775",
                                                "text": "The solariums on the roofs of the houses of the ancient Greeks and Romans testify to the benefits obtained by them from sun baths."
                                            },
                                            {
                                                "example_id": "79f32a9b-e604-4ae5-842d-5b167186af70",
                                                "sense_id": "bef95dd3-bfc3-3269-8a39-61fbb8450775",
                                                "text": "The Greeks had their helioses and the Romans their solaria; yet heliotherapy has as yet scarcely emerged from the most empiric of performances into the dignity of a scientifically justified or rationalized procedure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5c19d9-25c7-3b64-8180-54ec588ff54c",
                                        "entry_id": "b92996eb-f941-3f06-b74a-33e62b5b18ed",
                                        "glosses": [
                                            "Synonym of tanning salon, a room or business used for its sunlamps or tanning beds."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af7737cd-621f-3125-9b4c-b6a45a5ddc8c",
                                        "entry_id": "b92996eb-f941-3f06-b74a-33e62b5b18ed",
                                        "glosses": [
                                            "An earthen structure constructed by certain ants for the purpose of brood incubation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52837da5-22a2-30f6-bc24-4e146f0bfec7",
                                        "entry_id": "b92996eb-f941-3f06-b74a-33e62b5b18ed",
                                        "glosses": [
                                            "Synonym of sundial."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e729178-67c3-4550-831c-c80ffb6c38a8",
                                                "sense_id": "52837da5-22a2-30f6-bc24-4e146f0bfec7",
                                                "text": "[…] this solarium being made for a different meridian […]"
                                            },
                                            {
                                                "example_id": "e8b6bd4e-4050-4d97-bcbd-e807ff6ebf2c",
                                                "sense_id": "52837da5-22a2-30f6-bc24-4e146f0bfec7",
                                                "text": "[…] lifting his eyes from the solarium set under the aplustre for reference in keeping the course..."
