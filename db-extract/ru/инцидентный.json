                "senses": [
                    {
                        "sense_id": "404a2ed0-0f01-32fa-937d-7c23ee8b7fd3",
                        "entry_id": "ed33906c-ea29-3608-91fe-2d91fc898b84",
                        "glosses": [
                            "геометр. лежащий на…, проходящий через…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9affa0-fc9b-4a0c-83b9-0e76cff86e55",
                                "sense_id": "404a2ed0-0f01-32fa-937d-7c23ee8b7fd3",
                                "text": "Прямая и точка инцидентны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f828f23-fc2c-48ef-b328-3f0a5853bd40",
                        "source_entry_id": "ed33906c-ea29-3608-91fe-2d91fc898b84",
                        "source_sense_id": "404a2ed0-0f01-32fa-937d-7c23ee8b7fd3",
                        "target_lang_word": "incident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                                        "entry_id": "d653f9f8-f4b4-3e34-b6b3-e0e391f4c8b6",
                                        "glosses": [
                                            "An event or occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41fabc49-e4f5-49a6-b41d-0e1fcd9ab2ef",
                                                "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                                                "text": "She could not recall the time of the incident."
                                            },
                                            {
                                                "example_id": "2cada413-c18e-4851-9584-05bfed49d4d3",
                                                "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                                                "text": "It was an incident that he hoped to forget."
                                            },
                                            {
                                                "example_id": "781b50a7-d2eb-4fb7-8213-dedb0797ecdb",
                                                "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                                                "text": "The suspect was released without further incident."
                                            },
                                            {
                                                "example_id": "31e8b88b-5c36-49bc-b3ab-c106dc7f7371",
                                                "sense_id": "8d56e78f-b9dc-336e-aadd-114484186764",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5bdf0fc-ab58-38f1-ae76-3a08547cfb54",
                                        "entry_id": "d653f9f8-f4b4-3e34-b6b3-e0e391f4c8b6",
                                        "glosses": [
                                            "A (relatively minor) event that is incidental to, or related to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b82b526-1343-3ef8-b059-412188fa04c5",
                                        "entry_id": "d653f9f8-f4b4-3e34-b6b3-e0e391f4c8b6",
                                        "glosses": [
                                            "An event that causes or may cause an interruption or a crisis, such as a workplace illness or a software error."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b518a39-fdcb-32d9-98e6-3dc840227fc7",
                                        "entry_id": "d653f9f8-f4b4-3e34-b6b3-e0e391f4c8b6",
                                        "glosses": [
                                            "An event that causes or may cause an interruption or a crisis, such as a workplace illness or a software error.",
                                            "An event affecting an aircraft, usually a plane crash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f69871da-50b7-384f-8547-286c1f3b5013",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "Arising as the result of an event, inherent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08fcf025-9736-448d-a93d-c6591973f530",
                                                "sense_id": "f69871da-50b7-384f-8547-286c1f3b5013",
                                                "text": "No major hazards incident to this job."
                                            },
                                            {
                                                "example_id": "3f16e95b-db50-4488-ab61-3859e4d3d651",
                                                "sense_id": "f69871da-50b7-384f-8547-286c1f3b5013",
                                                "text": "It is at this juncture that Toder launches into the familiar and troubling topic of monogamy versus non-monogamy. She outwardly expresses no preference for either option, considering each to hold certain consequences incident to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812caf74-e342-31cf-aaff-8f4b4cded44d",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "Falling on or striking a surface."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916eaeab-946e-4391-aa48-37d9a39dbe69",
                                                "sense_id": "812caf74-e342-31cf-aaff-8f4b4cded44d",
                                                "text": "The incident light illuminated the surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a115e57-9cd0-3cc5-9e8f-3fabd87a32dd",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "Coming or happening accidentally; not in the usual course of things; not in connection with the main design; not according to expectation; casual; fortuitous."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb063f41-5560-4169-b146-fd29739c547b",
                                                "sense_id": "7a115e57-9cd0-3cc5-9e8f-3fabd87a32dd",
                                                "text": "As the ordinary course of common affairs is disposed of by general laws, so likewise men's rarer incident necessities and utilities should be with special equity considered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b21eb0b-1218-37ba-a683-3a255838ccc4",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "Liable to happen; apt to occur; befalling; hence, naturally happening or appertaining."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45043270-e50c-4f04-b530-a0ddff773564",
                                                "sense_id": "1b21eb0b-1218-37ba-a683-3a255838ccc4",
                                                "text": "All chances incident to mans frail life."
                                            },
                                            {
                                                "example_id": "e75c41af-aa30-47b0-8de5-143b37945bdb",
                                                "sense_id": "1b21eb0b-1218-37ba-a683-3a255838ccc4",
                                                "text": "17th century, Richard Milward, \"Preface\" to Seldeniana\nthe studies incident to his profession"
                                            },
                                            {
                                                "example_id": "990752d2-9ce5-4a9d-a68e-0578350572e9",
                                                "sense_id": "1b21eb0b-1218-37ba-a683-3a255838ccc4",
                                                "text": "The Vives, like the strangles, is most incident to young horses, and usually proceeds from the same causes, such as catching cold, being over-heated, or over-worked, about the time of shedding their teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d8227f-38d9-3308-8eae-7d7419a8f778",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "Dependent upon, or appertaining to, another thing, called the principal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f2b184d-8402-3a78-a068-e6061db0d3ee",
                                        "entry_id": "e56657ad-7ce7-3403-8a4e-a4de97aec827",
                                        "glosses": [
                                            "In a relation of incidence"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0128cfb6-d671-42b3-b5ef-c3c508fc21e3",
                                                "sense_id": "5f2b184d-8402-3a78-a068-e6061db0d3ee",
                                                "text": "The second inequality follows from the fact that all the edges incident with a fixed vertex separate [an arbitrary graph] G."
                                            },
                                            {
                                                "example_id": "2596780d-fc8f-43f6-83cc-cda7ffc0df0f",
                                                "sense_id": "5f2b184d-8402-3a78-a068-e6061db0d3ee",
                                                "text": "If there is only one ideal point U and only one ideal line u, then either (i) every point in u is incident with a line in U, or else (ii) no point in u is incident with any line of U."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd3403f6-7f51-429e-879b-759bd97df55a",
                        "source_entry_id": "ed33906c-ea29-3608-91fe-2d91fc898b84",
                        "source_sense_id": "404a2ed0-0f01-32fa-937d-7c23ee8b7fd3",
                        "target_lang_word": "incidental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incidental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdc5386-11db-30ae-b95b-fe747164b21f",
                                        "entry_id": "2471ea98-e82a-3610-b0f5-cabe936c4af8",
                                        "glosses": [
                                            "Loosely associated; of limited relevance except indirectly; only accidentally related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5fa03ca-3115-4180-b605-ccc94c48573e",
                                                "sense_id": "ffdc5386-11db-30ae-b95b-fe747164b21f",
                                                "text": "That character, though colorful, is incidental to the overall plot."
                                            },
                                            {
                                                "example_id": "be9bf0e0-d58b-4d6d-919b-792e5e319f5e",
                                                "sense_id": "ffdc5386-11db-30ae-b95b-fe747164b21f",
                                                "text": "incidental evidence"
                                            }
                                        ]
