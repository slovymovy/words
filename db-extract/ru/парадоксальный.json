                    {
                        "translation_id": "3ee1644b-5aee-4827-9b9a-add8d38c7364",
                        "source_entry_id": "974f8c38-d089-399b-97fb-d8de9098c7e2",
                        "source_sense_id": "586bb70c-c8e3-3f9a-b7ca-9a67c3bee876",
                        "target_lang_word": "paradox",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradox",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c97135e-23a1-39cb-80cf-9c6bca19848f",
                                        "entry_id": "85d7f854-8d46-387c-a27f-32e8e53ef6b3",
                                        "glosses": [
                                            "einen unauflösbaren Widerspruch enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f771a3-a4ec-49a2-9554-ae46c5aa5feb",
                                                "sense_id": "9c97135e-23a1-39cb-80cf-9c6bca19848f",
                                                "text": "Eine Idee war paradoxer als alle anderen."
                                            },
                                            {
                                                "example_id": "50d96776-8a77-4da2-bc68-29aa432ea771",
                                                "sense_id": "9c97135e-23a1-39cb-80cf-9c6bca19848f",
                                                "text": "„Der Zweck der paradoxen Formulierung ist zunächst, einen Gedanken besonders zugespitzt auszudrücken, indem man ihn scharf von der üblichen Ansicht abhebt.“"
                                            },
                                            {
                                                "example_id": "d5311add-50cd-4df8-8924-fa21f81ae462",
                                                "sense_id": "9c97135e-23a1-39cb-80cf-9c6bca19848f",
                                                "text": "„Und auch in den Anfangsphasen der Aviatik, von den ersten Fesselballons des 18. Jahrhunderts bis zu den Sichtflügen in der Pionierphase der Fliegerei, wiederholen sich die paradoxen Erfahrungen von ausgeschlossener Gegenwart, wie sie bis dahin lediglich bei Bergbesteigungen durch den Höhenblick aufgetreten waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c927c1de-1db8-4970-9bfa-2c07ed99c5eb",
                        "source_entry_id": "974f8c38-d089-399b-97fb-d8de9098c7e2",
                        "source_sense_id": "586bb70c-c8e3-3f9a-b7ca-9a67c3bee876",
                        "target_lang_word": "paradoxal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradoxal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aaeee40-5d83-34b9-9a18-f79d30524380",
                                        "entry_id": "af5b1964-8d6f-32cd-9084-a9f9d5caf75d",
                                        "glosses": [
                                            "paradox, widersinnig, gegensätzlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d93ea64-993f-4865-af88-454015a10057",
                                                "sense_id": "1aaeee40-5d83-34b9-9a18-f79d30524380",
                                                "text": "Der Geist bewegt, durchdringt alles, affiziert ohne selbst affiziert zu werden, und seine Bewegungen sind paradoxal."
                                            },
                                            {
                                                "example_id": "e0267301-7180-4494-9356-7a605969335f",
                                                "sense_id": "1aaeee40-5d83-34b9-9a18-f79d30524380",
                                                "text": "Stets ist sie, die Mystik wie die besagte Primärerfahrung, paradoxal gelagert: Indem der Gläubige seine religiöse Lebenstat selbsttranszendent vollzieht, wird er sich selbst genommen, hört er auf er zu sein und wird doch erst - sei es auch nur momenthaft - er selbst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
