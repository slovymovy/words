{
    "word_family": [
        "fatigue",
        "fatigant",
        "infatigable",
        "infatigablement",
        "fatigabilité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8a5f7a1-1d66-3167-a7f1-6f01cb4fdfab",
                    "sense_definition": "Causer de la fatigue physique ou mentale à quelqu'un, affaiblir ses forces.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "epuisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue marche en montagne commence à <w>fatiguer</w> les enfants."
                        },
                        {
                            "text": "Travailler devant un écran toute la journée peut <w>fatiguer</w> les yeux."
                        }
                    ],
                    "synonyms": [
                        "épuiser",
                        "éreinter",
                        "lasser"
                    ],
                    "antonyms": [
                        "reposer",
                        "délasser"
                    ],
                    "common_phrases": [
                        "fatiguer les yeux",
                        "fatiguer le corps"
                    ]
                },
                {
                    "sense_id": "bec4076c-81a0-3f12-812c-48ddb930ebaf",
                    "sense_definition": "Importuner, agacer ou lasser quelqu'un par des propos ou une attitude insistante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu me <w>fatigues</w> avec tes remarques et tes plaintes constantes."
                        },
                        {
                            "text": "Ses discours interminables finissent par <w>fatiguer</w> tout le monde dans la salle."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "énerver",
                        "ennuyer",
                        "lasser"
                    ],
                    "antonyms": [
                        "amuser",
                        "divertir"
                    ]
                },
                {
                    "sense_id": "104e5522-711f-3864-934e-e9115b2f2a0c",
                    "sense_definition": "Fournir un effort ou se donner de la peine, surtout utilisé à la forme négative.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne se <w>fatigue</w> vraiment pas pour aider ses collègues au bureau."
                        },
                        {
                            "text": "Ne te <w>fatigue</w> pas à lui expliquer, il n'écoute rien."
                        }
                    ],
                    "synonyms": [
                        "peiner",
                        "s'efforcer"
                    ],
                    "common_phrases": [
                        "ne pas se fatiguer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé familièrement ou ironiquement à la forme négative"
                        }
                    ]
                },
                {
                    "sense_id": "74baac13-45f5-3525-9362-09191f2c812c",
                    "sense_definition": "User, détériorer ou altérer le bon état de quelque chose par un usage prolongé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "usure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Conduire trop vite sur des routes défoncées va vite <w>fatiguer</w> le moteur."
                        },
                        {
                            "text": "Crier aussi fort pendant le concert risque de <w>fatiguer</w> vos cordes vocales."
                        }
                    ],
                    "synonyms": [
                        "abîmer",
                        "détériorer",
                        "user"
                    ],
                    "antonyms": [
                        "ménager",
                        "préserver"
                    ],
                    "common_phrases": [
                        "fatiguer le moteur"
                    ]
                },
                {
                    "sense_id": "1718815b-e427-3566-8f93-b4161eaea356",
                    "sense_definition": "Subir une contrainte ou une pression mécanique excessive qui menace la solidité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous le poids de la neige accumulée, la charpente en bois commence à <w>fatiguer</w>."
                        },
                        {
                            "text": "Pendant la tempête, la coque du bateau <w>fatiguait</w> sous les chocs répétés des vagues."
                        }
                    ],
                    "synonyms": [
                        "fléchir",
                        "plier"
                    ]
                },
                {
                    "sense_id": "7358423c-0aff-3025-a745-831408289205",
                    "sense_definition": "Remuer vivement une salade afin de bien y incorporer l'assaisonnement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>fatiguer</w> la salade pour que la vinaigrette imprègne chaque feuille."
                        },
                        {
                            "text": "Avant de servir le repas, le cuisinier prit soin de <w>fatiguer</w> la salade verte."
                        }
                    ],
                    "synonyms": [
                        "remuer",
                        "tourner"
                    ],
                    "common_phrases": [
                        "fatiguer la salade"
                    ]
                }
            ]
        }
    ]
}