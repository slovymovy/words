                        "entry_id": "e196f5d8-4e74-391d-9bb2-09b64674599d",
                        "glosses": [
                            "Bahnangestellter, der für die Betätigung der Bahnschranken an einem Bahnübergang sowie die Kontrolle der Gleisanlage zuständig ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c092645a-ca4f-4aa0-906a-e248a5162c65",
                                "sense_id": "802a7a37-a3aa-31dd-b61c-01a185b35565",
                                "text": "Der Bahnwärter betätigte die Schranken."
                            },
                            {
                                "example_id": "6d44ab67-b426-488c-ad4a-bae8b5283224",
                                "sense_id": "802a7a37-a3aa-31dd-b61c-01a185b35565",
                                "text": "„Saß man selbst im Auto, konnte man noch Bahnwärter erleben, die eine Schranke hoch- und runterkurbelten.“"
                            }
                        ],
