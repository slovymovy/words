                "senses": [
                    {
                        "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                        "entry_id": "6f426f54-ecc0-3c36-a85b-e5cdff2778b8",
                        "glosses": [
                            "Fachmann im Weinbau, also in der Önologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869d587c-8460-41d6-a569-d5fc8b95f651",
                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                "text": "„Franz Wehrheim ist Betriebswirt, Önologe und hat einen Master of Business-Administration.“"
                            },
                            {
                                "example_id": "0ccc5456-5ee5-4436-993d-1c39c40e6a61",
                                "sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                                "text": "„Der Winzer, Önologe und Biochemiker Jules Chauvet war in den 1970ern im Beaujolais auf der Suche nach authentischen Terroirweinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1393c22-37eb-479b-a809-b22de51601d3",
                        "source_entry_id": "6f426f54-ecc0-3c36-a85b-e5cdff2778b8",
                        "source_sense_id": "6c249f8b-c3b7-371a-9268-21027fe7688e",
                        "source_sense_description": "Fachmann im Weinbau, also in der Önologie",
                        "target_lang_word": "œnologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œnologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                        "entry_id": "61332289-52a2-37aa-b2bd-46b5c0678d59",
                                        "glosses": [
                                            "Spécialiste du vin, de son élaboration et de sa dégustation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba56d540-79b1-407b-b689-946f22a0e5bf",
                                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                                "text": "L’Othello, le barbare Othello, conspué, bafoué, honni par tous les Congrès, avait bien enrichi quelques adroits œnologues qui avaient su utiliser son acidité en la sucrant généreusement et défoxer son moût en le chauffant avant fermentation, […]."
                                            },
                                            {
                                                "example_id": "05b8b106-4a62-4a61-b785-d01a0815d9cf",
                                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                                "text": "Les vins primeurs sont très flatteurs pour les consommateurs, car ils sont très aromatiques, explique l’œnologue Régine Le Coz."
                                            },
                                            {
                                                "example_id": "fd38692c-e7d4-4e20-bd24-4a8667b6fdce",
                                                "sense_id": "f68e818c-06f0-33e4-882e-5293eb541bb7",
                                                "text": "Les écrits des œnologues fourmillent de recettes qu’on propose pour corriger l’acidité des vins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf249958-f271-411d-9316-9d8b3e902ee2",
                        "source_entry_id": "6f426f54-ecc0-3c36-a85b-e5cdff2778b8",
