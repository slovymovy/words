                        "cross_references": [
                            {
                                "target_word": "кибитка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3397fa47-73a0-302e-afae-bfe2541fa8b7",
                                        "entry_id": "a07d32d7-0400-31b8-a452-794fa5ad536c",
                                        "glosses": [
                                            "крытая дорожная повозка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005f59b5-1b38-48af-ad1b-1db11020a5a2",
                                                "sense_id": "3397fa47-73a0-302e-afae-bfe2541fa8b7",
                                                "text": "Взятая со мною кибитка совсем развалилась; я принуждён был купить вместо её маленькую фуру."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf500611-2f78-3ef8-91b9-bf2368f2bb17",
                                        "entry_id": "a07d32d7-0400-31b8-a452-794fa5ad536c",
                                        "glosses": [
                                            "устар. верх повозки (тарантаса, саней) из кожи, ткани, натянутой на дугах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31037b9e-8723-4123-8a53-9713cc8ce737",
                                                "sense_id": "cf500611-2f78-3ef8-91b9-bf2368f2bb17",
                                                "text": "В исход 11 часов изволил отсюда выехать в Петербург в простых санях и без кибитки, тройкою с колокольным звоном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088d9c5b-835c-319c-8cf4-8535b2fbc188",
                                        "entry_id": "a07d32d7-0400-31b8-a452-794fa5ad536c",
                                        "glosses": [
                                            "лёгкое переносное жилище у кочевых народов; юрта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e8934-b5d4-4aac-a893-2465f9fccdb6",
                                                "sense_id": "088d9c5b-835c-319c-8cf4-8535b2fbc188",
                                                "text": "ты в кибитку не ходи"
                                            },
                                            {
                                                "example_id": "f7676148-9fe0-461d-af8c-cdf23a6f6e0f",
                                                "sense_id": "088d9c5b-835c-319c-8cf4-8535b2fbc188",
                                                "text": "Что вы требуете о Золотой орде, то, мне помнится, в моем лексиконе кратко описано, оное и есть nomen proprium, от несмысленных руских писцов за то принято: слово бо Золотая орда значит ханская кибитка или ставка, ибо Чингиз, получа от китайского хана золотой шатер, имел для приема иностранных, чему его наследники последовали, как в Карпеине и Рубруке видеть ясно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10c2e5f-955a-304c-998b-e51afc73b7f4",
                                        "entry_id": "a07d32d7-0400-31b8-a452-794fa5ad536c",
                                        "glosses": [
                                            "небольшой дом старого типа (глинобитный или из сырцового кирпича) в среднеазиатских республиках)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e3fbbb6-1334-42f3-91be-4009bb01d068",
                                                "sense_id": "b10c2e5f-955a-304c-998b-e51afc73b7f4",
                                                "text": "Среди деревьев разбросаны юрты киргизов и их зимние глиняные дома, называемые кибитками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
