                        "entry_id": "1c9c49e8-87bc-31fc-acae-bb64244595f7",
                        "glosses": [
                            "The act of cancelling an arrest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9d023e-b3d7-4aa4-8ee3-31e171f824ad",
                                "sense_id": "5cec2f48-7258-3d77-83bd-777a2cfe3bcc",
                                "text": "However, it has been suggested to the Committee that police will not utilise this power because there will be a fear of the \"unarrest\" being used as evidence of a wrongful arrest."
                            },
                            {
                                "example_id": "339afc9d-7433-42f3-94e3-5ad021fed5f4",
                                "sense_id": "5cec2f48-7258-3d77-83bd-777a2cfe3bcc",
                                "text": "Several unarrests, and only two total successful arrests, occurred at the Navy Memorial."
                            },
                            {
                                "example_id": "a8cc478e-ec1b-4de8-9431-17800dc46175",
                                "sense_id": "5cec2f48-7258-3d77-83bd-777a2cfe3bcc",
                                "text": "These long stops essentially consist of a form of illegal, undocumented arrest, an investigation, and an “unarrest”—a wholly unconstitutional process."
                            }
                        ]
                    }
