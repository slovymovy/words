{
    "word_family": [
        "wallop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d33d9754-8ab7-37d3-a09d-efec93864169",
                    "sense_definition": "A series of heavy blows or a physical beating.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer received a severe <w>walloping</w> during the final round of the match.",
                            "target_lang_translations": {
                                "pl": "Bokser otrzymał dotkliwy <w>łomot</w> w ostatniej rundzie meczu."
                            }
                        },
                        {
                            "text": "He walked away from the fight with a <w>walloping</w> that left him bruised.",
                            "target_lang_translations": {
                                "pl": "Wyszedł z walki z <w>lanie</w>, które pozostawiło go posiniaczonym."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Seria silnych uderzeń lub fizyczne pobicie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łomot",
                                "target_lang_sense_clarification": "potoczne określenie silnego pobicia"
                            },
                            {
                                "target_lang_word": "lanie",
                                "target_lang_sense_clarification": "potoczne określenie bicia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4a2ac6-b235-335d-ac38-9ffb5b2fb29f",
                    "sense_definition": "A crushing or decisive defeat in a competition or game.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The home team suffered a <w>walloping</w> in the championship game last night.",
                            "target_lang_translations": {
                                "pl": "Drużyna gospodarzy poniosła wczoraj wieczorem <w>pogrom</w> w meczu mistrzowskim."
                            }
                        },
                        {
                            "text": "Despite their efforts, they took a <w>walloping</w> from the league leaders.",
                            "target_lang_translations": {
                                "pl": "Pomimo wysiłków, doznali <w>klęski</w> z rąk liderów ligi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotkliwa lub miażdżąca porażka w zawodach lub grze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pogrom",
                                "target_lang_sense_clarification": "bardzo wysoka porażka w sporcie"
                            },
                            {
                                "target_lang_word": "klęska",
                                "target_lang_sense_clarification": "dotkliwa przegrana"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "912a8556-2736-3de4-9ca8-a08e4afee418",
                    "sense_definition": "A harsh verbal scolding or reprimand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the mistake, the manager gave the employee a real <w>walloping</w> in front of everyone.",
                            "target_lang_translations": {
                                "pl": "Po tym błędzie menedżer udzielił pracownikowi ostrego <w>ochrzanu</w> na oczach wszystkich."
                            }
                        },
                        {
                            "text": "She received a <w>walloping</w> from her parents for staying out past her curfew.",
                            "target_lang_translations": {
                                "pl": "Dostała <w>burę</w> od rodziców za to, że wróciła po godzinie policyjnej."
                            }
                        }
                    ],
                    "synonyms": [
                        "tongue lashing"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ostra reprymenda lub słowna nagana."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ochrzan",
                                "target_lang_sense_clarification": "potoczna, ostra reprymenda"
                            },
                            {
                                "target_lang_word": "bura",
                                "target_lang_sense_clarification": "słowna nagana"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c50e2fa5-eb61-351e-831c-9bfb3a709f16",
                    "sense_definition": "Very large in size or amount.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>walloping</w> profit increase this quarter.",
                            "target_lang_translations": {
                                "pl": "Firma odnotowała w tym kwartale <w>ogromny</w> wzrost zysków."
                            }
                        },
                        {
                            "text": "He paid a <w>walloping</w> sum of money for that vintage car.",
                            "target_lang_translations": {
                                "pl": "Zapłacił <w>kolosalną</w> sumę pieniędzy za ten zabytkowy samochód."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo duży pod względem rozmiaru lub ilości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ogromny",
                                "target_lang_sense_clarification": "bardzo duży"
                            },
                            {
                                "target_lang_word": "kolosalny",
                                "target_lang_sense_clarification": "imponujący rozmiarem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df333b22-aff7-346c-88df-c873c5714949",
                    "sense_definition": "Of exceptional or impressive quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band gave a <w>walloping</w> performance that left the audience cheering for more.",
                            "target_lang_translations": {
                                "pl": "Zespół dał <w>znakomity</w> występ, po którym publiczność domagała się bisów."
                            }
                        },
                        {
                            "text": "It was a <w>walloping</w> success that exceeded all our expectations.",
                            "target_lang_translations": {
                                "pl": "To był <w>rewelacyjny</w> sukces, który przerósł nasze oczekiwania."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyjątkowej lub imponującej jakości."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "znakomity",
                                "target_lang_sense_clarification": "wysokiej jakości"
                            },
                            {
                                "target_lang_word": "rewelacyjny",
                                "target_lang_sense_clarification": "imponujący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2fe73e2c-b6fc-3718-94f4-5e86b7be408e",
                    "sense_definition": "The present participle and gerund of <w>wallop</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>walloping</w> the punching bag to release his frustration.",
                            "target_lang_translations": {
                                "pl": "Z <w>łomotem</w> uderzał w worek treningowy, aby rozładować frustrację."
                            }
                        },
                        {
                            "text": "The storm was <w>walloping</w> the coast with heavy rain and strong winds.",
                            "target_lang_translations": {
                                "pl": "Burza <w>okładała</w> wybrzeże ulewnym deszczem i silnym wiatrem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od słowa wallop (uderzać, łomotać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łomoczący",
                                "target_lang_sense_clarification": "uderzający z dużą siłą"
                            },
                            {
                                "target_lang_word": "okładający",
                                "target_lang_sense_clarification": "bijący kogoś lub coś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}