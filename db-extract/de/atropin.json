                ],
                "senses": [
                    {
                        "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                        "entry_id": "f63bc2b6-f56f-3ae7-81cd-cda3442bfd24",
                        "glosses": [
                            "hochgiftiges Alkaloid oder krampflösendes Arzneimittel, das in Nachtschattengewächsen, besonders in der Tollkirsche Atropa belladonna, vorkommt"
                        ],
                        "tags": [
                            "Pharmazeutische Chemie"
                        ],
                        "examples": [
                            {
                                "example_id": "42df721c-2ecb-477b-9071-dfb34a649a9f",
                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                "text": "„Die Kinder haben Probleme mit den Augen, ich träufle ihnen alle vier Stunden Atropin in die Augen.“"
                            },
                            {
                                "example_id": "af9190d3-b880-4e36-b25c-b80c38bc46ae",
                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                "text": "„Ein altbekannter Antagonist an diesen Rezeptoren ist Atropin, das Gift der Tollkirsche.“"
                            },
                            {
                                "example_id": "1f20eea2-9c71-4f04-95cc-6b6a6891a0cd",
                                "sense_id": "226ac17e-2a81-37ce-924a-67e5989eceb2",
                                "text": "„In der Drogenszene in Bern und Biel ist Kokain im Umlauf, das mit giftigem Atropin verunreinigt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
