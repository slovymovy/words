                        "examples": [
                            {
                                "example_id": "7a078b88-947c-4d0d-8928-4bd99ee6bbd0",
                                "sense_id": "8b919f31-f5e7-3249-98a9-e4b5bd27525b",
                                "text": "A sort of vagabonds, rascals, and runaways, / A scum of Bretons, and base lackey peasants, / Whom their o'er-cloyed country vomits forth / To desperate ventures and assured destruction."
                            },
                            {
                                "example_id": "3867de56-7a7d-4634-9c4a-7ba8da7fcd6f",
                                "sense_id": "8b919f31-f5e7-3249-98a9-e4b5bd27525b",
                                "text": "He neuer pleaſd his fathers eyes till now, / Nor fild my hart with ouer cloying ioyes."
                            }
                        ]
                    }
