                                        "sense_id": "b114e7a5-ccac-33cd-8544-6bde189ee11d",
                                        "entry_id": "0895a7a7-31ea-37d3-936c-bf8e1bb1011d",
                                        "glosses": [
                                            "To mock or make a fool of (someone) in a playful way."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2baea76-2619-4cb6-ba7b-5804444038a9",
                                                "sense_id": "b114e7a5-ccac-33cd-8544-6bde189ee11d",
                                                "text": "They were always kidding her for her stutter."
                                            }
