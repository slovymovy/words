                        "sense_id": "5d5890a9-18d9-3c6d-8313-cfeae08a2a2a",
                        "entry_id": "78520eff-dff4-371e-9b9f-e3bd77af0f3b",
                        "glosses": [
                            "(in Bayern zusätzlicher) Ausweis von Schulnoten, der zum Wechsel in eine höhere Schule berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b240788b-f42f-4d82-9edd-f76a034bab4a",
                                "sense_id": "5d5890a9-18d9-3c6d-8313-cfeae08a2a2a",
                                "text": "„Das Übertrittszeugnis für Viertklässler wird wegen der Corona-Krise heuer auf Grundlage derjenigen Noten erstellt, die die Kinder vor den Schulschließungen vergangenen Montag erzielt haben.“"
                            },
                            {
                                "example_id": "c7736278-7d00-4bc8-93e7-dfe47877ddba",
                                "sense_id": "5d5890a9-18d9-3c6d-8313-cfeae08a2a2a",
                                "text": "„Die Proben müssen allerdings bis Ende April geschrieben sein, denn am 3. Mai gibt es das Übertrittszeugnis.“"
                            }
                        ],
