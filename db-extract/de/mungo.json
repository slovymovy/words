                                "sense_id": "7cd2bc1f-6f0c-3555-b78c-7ce88287277f",
                                "text": "Der Mungo kämpft gegen eine Schlange."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ab8cd7d-02e2-3f6c-ad28-bf11af9d8892",
                        "entry_id": "71c9fa8b-0ba0-3288-b6b4-248f02bc9f9e",
                        "glosses": [
                            "Wolle aus Stoffabfällen, Wollresten, Lumpen, circa 20 mm lange Fasern zur Beimischung für preiswerte Garne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a36121-a55c-4dfd-916c-f52a97d34dad",
                                "sense_id": "6ab8cd7d-02e2-3f6c-ad28-bf11af9d8892",
                                "text": "Mungo bezeichnet man auch als Lumpenwolle."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1886eca2-a3bb-3031-8a99-856a1c68bfb4",
                        "entry_id": "71c9fa8b-0ba0-3288-b6b4-248f02bc9f9e",
                        "glosses": [
