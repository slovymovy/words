{
    "word_family": [
        "hand",
        "handy",
        "handle",
        "handily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3bfd68a-18cc-3ce6-9e26-3821c395c99f",
                    "sense_definition": "The amount of something that can be held in one hand.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_literal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He picked up a <w>handful</w> of sand and let it slip through his fingers.",
                            "target_lang_translations": {
                                "ru": "Он поднял <w>горсть</w> песка и позволил ему просочиться сквозь пальцы.",
                                "zh": "他抓起<w>一把</w>沙子，让它们从指缝间滑落。"
                            }
                        },
                        {
                            "text": "Add a <w>handful</w> of chopped nuts to the cake mixture.",
                            "target_lang_translations": {
                                "ru": "Добавьте <w>горсть</w> рубленых орехов в смесь для торта.",
                                "zh": "往蛋糕糊里加<w>一把</w>碎坚果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fistful"
                    ],
                    "common_phrases": [
                        "handful of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество чего-либо, которое можно удержать в одной руке.",
                        "zh": "指单手能抓取或容纳的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горсть",
                                "target_lang_sense_clarification": "стандартный перевод; объем, вмещающийся в ладонь"
                            },
                            {
                                "target_lang_word": "пригоршня",
                                "target_lang_sense_clarification": "ладони, сложенные вместе, или полная горсть"
                            },
                            {
                                "target_lang_word": "жменя",
                                "target_lang_sense_clarification": "разговорный вариант слова «горсть»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一把",
                                "target_lang_sense_clarification": "最常用的量词，指单手抓取的量"
                            },
                            {
                                "target_lang_word": "一捧",
                                "target_lang_sense_clarification": "指双手合拢捧起的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21cd8b90-1345-3a0e-9927-0ec90a6d3f31",
                    "sense_definition": "A small number of people or things.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a <w>handful</w> of people attended the meeting last night.",
                            "target_lang_translations": {
                                "ru": "Лишь <w>горстка</w> людей пришла на собрание вчера вечером.",
                                "zh": "昨晚只有<w>寥寥几个人</w>参加了会议。"
                            }
                        },
                        {
                            "text": "She has written a <w>handful</w> of books, but they are all bestsellers.",
                            "target_lang_translations": {
                                "ru": "Она написала <w>несколько</w> книг, но все они бестселлеры.",
                                "zh": "她只写了<w>几本</w>书，但本本都是畅销书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "only a handful",
                        "handful of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество людей или предметов.",
                        "zh": "指极少数的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горстка",
                                "target_lang_sense_clarification": "часто используется по отношению к людям (горстка людей)"
                            },
                            {
                                "target_lang_word": "небольшое количество",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数",
                                "target_lang_sense_clarification": "指数量很少"
                            },
                            {
                                "target_lang_word": "寥寥几个",
                                "target_lang_sense_clarification": "强调数量极少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50f6e12a-d75f-3f5b-840a-5728faa2d3b0",
                    "sense_definition": "A person or thing, often a child, that is difficult to manage or control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her youngest son is a real <w>handful</w> when he misses his nap.",
                            "target_lang_translations": {
                                "ru": "Её младший сын — <w>сущее наказание</w>, когда пропускает дневной сон.",
                                "zh": "她的小儿子如果不睡午觉，简直<w>让人头疼</w>。"
                            }
                        },
                        {
                            "text": "The new puppy proved to be a bit of a <w>handful</w> for the family.",
                            "target_lang_translations": {
                                "ru": "Новый щенок доставил семье <w>немало хлопот</w>.",
                                "zh": "这只新来的小狗让全家人觉得<w>挺难对付</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "real handful",
                        "bit of a handful"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often applied to children or pets"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (часто ребёнок) или предмет, с которым трудно справиться или который доставляет много хлопот.",
                        "zh": "指难以管教或处理的人（常指小孩）或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сущее наказание",
                                "target_lang_sense_clarification": "идиома; о непослушном ребенке или трудном человеке"
                            },
                            {
                                "target_lang_word": "хлопотное дело",
                                "target_lang_sense_clarification": "о ситуации или предмете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "让人头疼",
                                "target_lang_sense_clarification": "形容难以应付"
                            },
                            {
                                "target_lang_word": "难对付",
                                "target_lang_sense_clarification": "形容难以管理或控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33ec2ede-0612-323c-880e-db0b91b3c3d0",
                    "sense_definition": "A unit of measurement equal to a hand's breadth or four inches.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water in the stream was only about a <w>handful</w> deep.",
                            "target_lang_translations": {
                                "ru": "Вода в ручье была глубиной всего с <w>ладонь</w>.",
                                "zh": "溪水深度只有大约一<w>掌宽</w>。"
                            }
                        },
                        {
                            "text": "Measure a <w>handful</w> from the bottom edge of the fabric.",
                            "target_lang_translations": {
                                "ru": "Отмерьте <w>ширину ладони</w> от нижнего края ткани.",
                                "zh": "从布料底边量出<w>一掌宽</w>的距离。"
                            }
                        }
                    ],
                    "synonyms": [
                        "handbreadth",
                        "handsbreadth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения, равная ширине ладони (около 10 см).",
                        "zh": "一种古老的长度单位，约等于手掌的宽度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладонь",
                                "target_lang_sense_clarification": "как мера длины/ширины"
                            },
                            {
                                "target_lang_word": "ширина ладони",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌宽",
                                "target_lang_sense_clarification": "作为长度单位的描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212b8446-92d5-336a-ab62-3aa49dcf5bd1",
                    "sense_definition": "A prison sentence of five years.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge gave him a <w>handful</w> for his part in the robbery.",
                            "target_lang_translations": {
                                "ru": "Судья дал ему <w>пятёрку</w> за участие в ограблении.",
                                "zh": "法官因他参与抢劫而判了他<w>五年徒刑</w>。"
                            }
                        },
                        {
                            "text": "He served a <w>handful</w> and was released on parole.",
                            "target_lang_translations": {
                                "ru": "Он отсидел <w>пятёрку</w> и был освобождён условно-досрочно.",
                                "zh": "他服刑<w>五年</w>后被假释出狱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тюремный срок в пять лет (сленг).",
                        "zh": "指五年刑期（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятёрка",
                                "target_lang_sense_clarification": "разговорное/сленг"
                            },
                            {
                                "target_lang_word": "пятерик",
                                "target_lang_sense_clarification": "тюремный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五年徒刑",
                                "target_lang_sense_clarification": "正式表达"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}