                ],
                "senses": [
                    {
                        "sense_id": "deefb340-ba79-37e6-8217-617b666bf5af",
                        "entry_id": "6141b0ba-49d3-36c8-b5ad-fd92d4782ed8",
                        "glosses": [
                            "Kalender, der Sonnen- und Mondkalender vereint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d35c70-f66b-44bb-81a7-f479268a7b51",
                                "sense_id": "deefb340-ba79-37e6-8217-617b666bf5af",
                                "text": "„Die meisten Völker verwendeten entweder reine Lunarkalender oder Solarkalender, während die Tibeter, Chinesen, Griechen und Römer (bis zur Einführung des Julianischen Kalenders, 46 v. Chr.) Lunisolarkalender, ähnlich dem der Juden, verwendeten.“"
                            },
                            {
                                "example_id": "b8d6d463-c22d-48ba-a6fb-4e3c51d0cfb7",
                                "sense_id": "deefb340-ba79-37e6-8217-617b666bf5af",
                                "text": "„Der jüdische Kalender ist ein Lunisolarkalender, das bedeutet, die Monate dauern von Neumond bis Neumond und das Jahr eine Umdrehung der Erde um die Sonne.“"
                            },
                            {
                                "example_id": "d53064c7-5b78-4f93-9859-66a3968dfbd4",
                                "sense_id": "deefb340-ba79-37e6-8217-617b666bf5af",
                                "text": "„In der Vollmondmacht des zwölften Monats im thailändischen Lunisolarkalender werden kleine beleuchtete Boote, die Krathongs, dem Fluss übergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
