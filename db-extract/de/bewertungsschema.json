                ],
                "senses": [
                    {
                        "sense_id": "89daa08f-1499-3479-8dfb-8616a1b299d5",
                        "entry_id": "feb6e39c-103b-3144-8ac4-e88c3de9591c",
                        "glosses": [
                            "Vorlage, nach der beurteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2febea9a-4558-4160-911e-3b8cc66eab49",
                                "sense_id": "89daa08f-1499-3479-8dfb-8616a1b299d5",
                                "text": "„Für Obststandorte besteht ein Bewertungsschema, das auf Bodenansprachen (Gründigkeit, Bodenart, Kalkgehalt) und Aufnahme der Wildflora fußt und außerdem Exposition und Inklination sowie Wärme und Spätfrostgefährdung berücksichtigt.“"
                            },
                            {
                                "example_id": "5a5337b8-157a-4633-9e66-809692611fcf",
                                "sense_id": "89daa08f-1499-3479-8dfb-8616a1b299d5",
                                "text": "Zur Beurteilung der Bewerber wurden unterschiedliche Bewertungsschemata entwickelt."
                            },
                            {
                                "example_id": "e926b974-5385-4c48-a542-59386a51892b",
                                "sense_id": "89daa08f-1499-3479-8dfb-8616a1b299d5",
                                "text": "Je mehr ihr das, was ihr tatsächlich erlebt, in diese vorgefertigten Bewertungsschemen hineinzupressen versucht, umso weiter entfernt ihr euch davon, zu verstehen, wie die Schöpfung gemeint ist."
                            },
                            {
                                "example_id": "e6459937-b705-4800-a9ed-06843b2db5fc",
                                "sense_id": "89daa08f-1499-3479-8dfb-8616a1b299d5",
                                "text": "Da schaut man sich ganz gerne die Bewertungsschemas der Autozeitschriften an und analysiert akribisch, wo die Punkte zu holen sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
