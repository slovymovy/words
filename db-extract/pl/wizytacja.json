                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e525c9-4017-41bf-8a8d-1b04ff79d979",
                                "sense_id": "ea5fea00-0792-3561-aaee-a8193a1c8da5",
                                "text": "Takowe zezwolenie wydaje się na czas nieokreślony po wizytacji obiektu"
                            },
                            {
                                "example_id": "8ecd5412-db72-4759-862b-379dc29cfc47",
                                "sense_id": "ea5fea00-0792-3561-aaee-a8193a1c8da5",
                                "text": "Zadaniem generałów inspektorów były objazdowe wizytacje wszystkich pułków i składanie raportów hetmanowi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d14a1a71-f327-306e-945f-04645fe1441b",
                        "entry_id": "845ce336-0f4a-3e3a-a188-3f13a1432c39",
                        "glosses": [
                            "komisja dokonująca kontroli instytucji zależnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e12bdb-02ab-42a5-877e-c8f661ec9341",
                                "sense_id": "d14a1a71-f327-306e-945f-04645fe1441b",
                                "text": "Nigdy nie wpuszczono żadnej wizytacji na teren zakładu."
