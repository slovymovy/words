                        "examples": [
                            {
                                "example_id": "17d836cc-3daa-48e7-a07a-89cf1ec50922",
                                "sense_id": "8321ee38-a1f4-3a56-8ca3-0ff97d28a47d",
                                "text": "Rat.\nI’ll slily seize and\nLet blood from her weasand,—\nCreeping through crevice, and chink, and cranny,\nWith my snaky tail, and my sides so scranny."
                            },
                            {
                                "example_id": "3aa486ff-7553-431b-ab2a-4f6ec0d2a7b3",
                                "sense_id": "8321ee38-a1f4-3a56-8ca3-0ff97d28a47d",
                                "text": "Observe in the whole lot, from the magnificent lord of the herd down to the scranniest runt, the superlative of self-reliance, the air of puffy arrogance and solid disregard of public or private opinion such as few of us attain."
                            },
                            {
                                "example_id": "8734aabe-d46d-488d-bab0-478214af4257",
                                "sense_id": "8321ee38-a1f4-3a56-8ca3-0ff97d28a47d",
                                "text": "“Well, in the first place,\" I explained the little lady, \"they've got three of the scranniest kids, and the mother herself don't look very strong.\""
                            },
                            {
                                "example_id": "4cebbd25-a01e-428d-95dc-1cc933c6ec01",
                                "sense_id": "8321ee38-a1f4-3a56-8ca3-0ff97d28a47d",
                                "text": "Among the affairs of men their voices, single or united, amounted to no more than a scranny interruption easily put aside;"
                            },
                            {
                                "example_id": "dd29b5d3-4b94-4142-828f-46349bb8ca33",
                                "sense_id": "8321ee38-a1f4-3a56-8ca3-0ff97d28a47d",
                                "text": "'Look at him, said Ada, pursing her lips. 'Is he fighting material? If Hitler's crack Panzer divisions see a scranny feller like him coming towards them, will they panic?\""
                            }
                        ]
                    }
