        "de-extract.jsonl": [
            {
                "entry_id": "9ce93937-b9ea-3f77-a6b9-711277df2e94",
                "word": "vielerorts",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                        "entry_id": "9ce93937-b9ea-3f77-a6b9-711277df2e94",
                        "glosses": [
                            "an vielen Orten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1cea736-d15e-40b5-aebc-8173acd9a646",
                                "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                                "text": "„In der Nacht zu Silvester setzte vielerorts leichter Nieselregen ein, der auf dem Boden sofort gefror.“"
                            },
                            {
                                "example_id": "d6c6e181-a550-4285-b151-6074c6324422",
                                "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                                "text": "„Vielerorts dreht sich an den Tagen zwischen den Jahren im wahrsten Sinne alles um die Worscht.“"
                            },
                            {
                                "example_id": "8050bdba-ec01-4bf4-8fcb-e2412b31dc20",
                                "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                                "text": "„Praktisch überall in der Schweiz steigt das Thermometer wieder über Null Grad. Doch mit dem Abtauen des Schnees reissen vielerorts die Strassen auf – es entstehen gefährliche Schlaglöcher.“"
                            },
                            {
                                "example_id": "b6ff3660-0d99-4ba0-9605-77ec1a907156",
                                "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                                "text": "„Einige der heutigen Deponien stossen an ihre Grenzen, vielerorts sind keine Nachfolgedeponien gesichert.“"
                            },
                            {
                                "example_id": "7ce1e4fd-8bed-4557-9378-7fe6c42f7a52",
                                "sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                                "text": "„Am Dienstag hat es vielerorts im Land geregnet – wenn meistens auch nur leicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53193877-95b5-460e-920b-e8b031a921cf",
                        "source_entry_id": "9ce93937-b9ea-3f77-a6b9-711277df2e94",
                        "source_sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
