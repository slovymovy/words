                                                "example_id": "c9cd9ec9-acd2-4f5f-b35a-cd711e7db602",
                                                "sense_id": "79745d63-5aec-3ca9-9bac-7786cdcf9bd4",
                                                "text": "Elle sentait le marrube et le talc, et ses cheveux planaient au-dessus de lui tel un boulet de canon."
                                            }
                                        ]
