                "senses": [
                    {
                        "sense_id": "978a833d-3c55-3872-884c-56f6672a6722",
                        "entry_id": "35a0f427-cab9-3592-bf5b-16a3d0803a8f",
                        "glosses": [
                            "To imagine incorrectly; to form an inaccurate mental image of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e7641b-212b-4268-824d-67e7c1a323d0",
                                "sense_id": "978a833d-3c55-3872-884c-56f6672a6722",
                                "text": "When the fact of their being ice, and not snow, is fully realized, still persons are apt to misimagine their appearance; for they are by no means smooth like our frozen lakes and rivers, but present a very unequal surface, undulating, furrowed, and broken."
                            },
                            {
                                "example_id": "23413979-a6be-4412-82df-2e71142b08a3",
                                "sense_id": "978a833d-3c55-3872-884c-56f6672a6722",
                                "text": "The stupidity, parochialism, and greed in the international mismanagement of the whole nuclear challenge should not tempt us to misimagine the circumstances of the bomb's first “use.”"
                            },
                            {
                                "example_id": "82a40a75-820e-4873-aedf-145093f3675d",
                                "sense_id": "978a833d-3c55-3872-884c-56f6672a6722",
                                "text": "It is not easy to say what it is to misimagine another person. It is easier to give a useful description of some other kinds of misimagination."
                            }
                        ]
                    }
