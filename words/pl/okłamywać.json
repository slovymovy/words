{
    "word_family": [
        "kłamca",
        "kłamstwo",
        "kłamliwy",
        "kłamliwie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53f7ef52-3bba-3535-b545-d65daafe7af9",
                    "sense_definition": "świadomie mówić komuś nieprawdę, aby wprowadzić go w błąd",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kłamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie powinieneś <w>okłamywać</w> swoich rodziców w tak ważnej sprawie.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует <w>лгать</w> своим родителям в таком важном деле."
                            }
                        },
                        {
                            "text": "Czuł się źle, ponieważ musiał <w>okłamywać</w> przyjaciół, by ukryć prawdę.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя плохо, потому что ему приходилось <w>обманывать</w> друзей, чтобы скрыть правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukiwać",
                        "zwodzić"
                    ],
                    "common_phrases": [
                        "okłamywać w żywe oczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "сознательно говорить кому-либо неправду, чтобы ввести в заблуждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лгать",
                                "target_lang_sense_clarification": "общее значение, говорить неправду"
                            },
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение, совершать обман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2132444a-37cc-3cb3-b1f0-2a5f711020c4",
                    "sense_definition": "wmawiać sobie nieprawdę, nie chcieć przyjąć do wiadomości faktów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kłamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestań <w>okłamywać</w> samego siebie, on nigdy do ciebie nie wróci.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>лгать</w> самому себе, он никогда к тебе не вернется."
                            }
                        },
                        {
                            "text": "Długo <w>okłamywał</w> się, że jego praca sprawia mu jakąkolwiek satysfakcję.",
                            "target_lang_translations": {
                                "ru": "Он долго <w>обманывал</w> себя, что его работа приносит ему хоть какое-то удовлетворение."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukiwać się",
                        "zwodzić się"
                    ],
                    "target_lang_definitions": {
                        "ru": "внушать себе неправду, не желать принимать факты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лгать самому себе",
                                "target_lang_sense_clarification": "заниматься самообманом"
                            },
                            {
                                "target_lang_word": "обманываться",
                                "target_lang_sense_clarification": "находиться в заблуждении относительно себя или ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84d10e4-8315-394d-a5d6-06921acf4201",
                    "sense_definition": "wzajemnie wprowadzać się w błąd",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kłamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez lata <w>okłamywali</w> się nawzajem, udając szczęśliwe małżeństwo.",
                            "target_lang_translations": {
                                "ru": "Годами они <w>лгали</w> друг другу, притворяясь счастливым браком."
                            }
                        },
                        {
                            "text": "W tym związku oboje <w>okłamywali</w> się, co doprowadziło do rozstania.",
                            "target_lang_translations": {
                                "ru": "В этих отношениях оба <w>обманывали</w> друг друга, что привело к расставанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukiwać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно вводить друг друга в заблуждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лгать друг другу",
                                "target_lang_sense_clarification": "взаимный обман"
                            },
                            {
                                "target_lang_word": "обманывать друг друга",
                                "target_lang_sense_clarification": "взаимное введение в заблуждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}