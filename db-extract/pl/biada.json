                    },
                    {
                        "translation_id": "c7ad9e4e-b179-4c6c-b19e-cb6d8ee03257",
                        "source_entry_id": "dbb44fb2-058e-30d3-8191-efdcb5927415",
                        "source_sense_id": "9a02eec9-c9b6-3e8e-9aac-82e1a295b455",
                        "source_sense_description": "Ausruf der Klage über etwas, das bereits geschehen ist oder vermeintlich eintreffen wird",
                        "target_lang_word": "weh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                        "entry_id": "e087060a-f1eb-3ca8-864e-3124306c3422",
                                        "glosses": [
                                            "erfüllt, geprägt von Kummer, Leid, (seelischem) Schmerz, Weh"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae801db-f2c1-4b15-87bd-68ff14b08746",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "„Und allerwegen, indeß er in verlangſamten, nachdenklichen Zügen, die feuchte Seeluft atmete, ſah er Augen, die ſo blau, Haare, die ſo blond, Geſichter, die von eben der Art und Bildung waren, wie er ſie in den ſeltſam wehen und reuigen Träumen der Nacht geſchaut, die er in ſeiner Vaterſtadt verbracht hatte.“"
                                            },
                                            {
                                                "example_id": "00fdf015-0d3f-4798-9088-c88a5da58c8f",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "„Mochte eine Anſpielung meinen Feinden auch noch ſo fern gelegen haben, dieſer Zusammenhang traf die weheſte Stelle meiner Seele, denn er ſchnitt mir mit ſchärferer Schneide als alles ſonſt ein Menetekel darüber ins Fleiſch, wohin ich gehörte.“"
                                            },
                                            {
                                                "example_id": "4d522c09-d7aa-4458-af88-5bb1b2c275b4",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "„Ich hatte Angst vor dem Gefühl, das mir die Brust mit weher Seligkeit zu sprengen drohte.“"
                                            },
                                            {
                                                "example_id": "dd6f252d-e529-4b33-a863-a7f3ba9233dc",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "„Das Gespann sowie der nachfolgende Trauerzug bewegten sich in einem unvorstellbaren Schneckentempo, aus Blechinstrumenten ertönte eine wehe, peinlich schleppende Musik dazu.“"
                                            },
                                            {
                                                "example_id": "0a946467-97c1-4420-9eda-6bcea99bfa3d",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "übertragen: „Es kommen die Abende bei offenem Fenster: man hört seine Helle voll zwitschernder Vögel, es ist, als spüre man die Luft, die wehe Erregung der Knospen, die Weite der Felder … O Kind, wie ist es schön auf der Erde, wie ist es schön auf der Erde!“"
                                            },
                                            {
                                                "example_id": "0a2b0b14-24bd-4e92-b863-8cac6ecc53e0",
                                                "sense_id": "126b3e8e-5182-3d18-bf98-ed04ae9e7431",
                                                "text": "„Doch die Frau weiß ihren brennenden Schmerz stolz zu tragen; sie jammert nicht, nur den wehen Zug um den schönen Mund kann sie nicht verbergen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d59f5d7d-81ea-36ee-8ecc-d85566bcfb46",
                                        "entry_id": "e087060a-f1eb-3ca8-864e-3124306c3422",
                                        "glosses": [
                                            "(körperlichen) Schmerz verursachend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e234e8-2ed3-42be-bbef-c36b0b6c94f2",
                                                "sense_id": "d59f5d7d-81ea-36ee-8ecc-d85566bcfb46",
                                                "text": "„Ich legte mich ins Bett, hatte aber keine Ruhe und stand nach einer halben Stunde wieder auf und ging auf und ab. Es war, als schwölle das Fleisch immerfort und würde weher und weher von den Metallklammern.“"
                                            },
                                            {
                                                "example_id": "53589dc8-fb1e-4513-ba4a-152777624f33",
                                                "sense_id": "d59f5d7d-81ea-36ee-8ecc-d85566bcfb46",
                                                "text": "„Sie sprang noch einige Male vor dem Mittagessen, wartete immer zu lange, sprang im falschen Moment, ihr Bauch tat ihr weh, dann der Kopf, doch, ich spür es doch, er hielt das für ausgeschlossen, hielt aber behutsam ihren Kopf in seinen Händen und tröstete sie, bis sie merkte, daß sie Hunger hatte, sie vergaß ihren wehen Kopf, und sie liefen hinauf zur Kabine.“"
                                            },
                                            {
                                                "example_id": "c729237b-50de-4c98-a723-e5afaf75f44d",
                                                "sense_id": "d59f5d7d-81ea-36ee-8ecc-d85566bcfb46",
                                                "text": "„Die Ohren weh von Schreien[,] Flüchen[,] Gewimmer[,] Gestöhn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "weh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e637b0a8-0ce4-3ac7-9b74-34b9b4dfd484",
                                        "entry_id": "b2df69cf-0b28-315a-beeb-504b817cdc27",
                                        "glosses": [
                                            "als Ausruf der Bestürzung, Klage, des Kummers, Leids, (seelischen) Schmerzes oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c5aa66-2c4f-46cf-bfca-2f8b53aadb2d",
                                                "sense_id": "e637b0a8-0ce4-3ac7-9b74-34b9b4dfd484",
                                                "text": "Weh mir, ich bin verloren!"
                                            },
                                            {
                                                "example_id": "568c5520-84d8-40c4-b28f-7d13e679cb84",
                                                "sense_id": "e637b0a8-0ce4-3ac7-9b74-34b9b4dfd484",
                                                "text": "„Doch weh! Zwischen ihm und mir, da ist die Sünde, der ich mich beflissen mit ihm, den mir Gott entrissen.“"
                                            },
                                            {
                                                "example_id": "d894ba47-e172-46e3-9be4-f5e76958ed4d",
                                                "sense_id": "e637b0a8-0ce4-3ac7-9b74-34b9b4dfd484",
                                                "text": "„»Nein!« schrie sie, »Weh mir!« und: »Wer tut mir das an?«“"
                                            },
                                            {
                                                "example_id": "d8b63e05-7ec7-4d1d-8883-30760dc52a51",
                                                "sense_id": "e637b0a8-0ce4-3ac7-9b74-34b9b4dfd484",
                                                "text": "„Mit einem Blick zwischen Mitleid und Bewunderung sagte Zollikofer: Wenn Sie zwanzig wären, würde ich denken: o weh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                        "entry_id": "b2df69cf-0b28-315a-beeb-504b817cdc27",
                                        "glosses": [
                                            "Ausruf als Ankündigung oder Androhung von etwas Schlimmen, Unheilvollen oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a46b36-2925-45dd-8807-e7cbb424208c",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "Weh dir, wenn ich hinkomme!"
                                            },
                                            {
                                                "example_id": "36c17f76-d1a9-44fb-8380-cdc0cf7475da",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "„Die Wüste wächst: weh Dem, der Wüsten birgt!“"
                                            },
                                            {
                                                "example_id": "8c7b3c2b-70bc-4d3e-af11-45044f35b212",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "„‚[…] Antworteten die Rabbinen: »Weh dem, der es sagt; weh dem, der es nicht sagt.« Was du tust, mein Junge, er wird versuchen, dir einen Strick zu drehen.‘“"
                                            },
                                            {
                                                "example_id": "671bc7c7-2840-46e7-b465-9ae0c7d59f7a",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "„Aber sollte ich mich heute in irgendeiner meiner Entscheidungen auf dieses Staatsgefühl als auf einen klar umschriebenen Wert verlassen: weh mir, dreimal weh mir, wenn ich ein solcher Narr wäre!“"
                                            },
                                            {
                                                "example_id": "c34cde6a-7502-4da4-b28b-bfc97cefa5f3",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "„Die blaublaue Kornblume wird untergepflügt. Kein Jammer. Das Blümchen hat geblüht, nun ordnet es sich den menschlichen Plänen unter. Eine moderne Blume. Weh dem, der weint!“"
                                            },
                                            {
                                                "example_id": "656e3a97-4f6a-4720-9ec4-4aea58c05918",
                                                "sense_id": "f1a4589a-518f-3a5f-9e8d-03c52bde3729",
                                                "text": "„Damals, als die RAF hier war, hab ich zum Sicherheitsschef gesagt: ‚Nehmen die mich als Geisel, dann setzt die besten Schützen auf den Kirchturm, aber weh, ihr trefft mich.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
