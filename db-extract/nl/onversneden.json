                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6321e515-8f33-43fe-a06e-94593a360daa",
                                                "sense_id": "1f1d177b-0d90-3f39-9252-df906e133638",
                                                "text": "... the establishment of an inferior College, and the consequent connexion of the many thousands of British practitioners in medicine and surgery with a subordinate institution, and one that should be subservient to the government of the pures."
                                            },
                                            {
                                                "example_id": "9e38f4e5-2c14-442e-b7e9-beaee0291880",
                                                "sense_id": "1f1d177b-0d90-3f39-9252-df906e133638",
                                                "text": "Took a drop of the pure, to keep my spirits from sinking, […]"
                                            },
                                            {
                                                "example_id": "b8157927-aeaa-40c9-a810-4026a4cab532",
                                                "sense_id": "1f1d177b-0d90-3f39-9252-df906e133638",
                                                "text": "All interpretive frames will impose their categories on the object of historical analysis, and I am not proposing that this narrative of the \"pures\"; be rejected in favor of some phantasmatic framework that claims to derive more purely from the sources themselves. I will show in chapter 3 that, since the \"pures\" possibly did not even exist […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be19f5bd-f9fe-3fae-b1df-0cd1319d08a2",
                                        "entry_id": "8fd4acff-b9fc-3a61-aa5b-898577c00cbf",
                                        "glosses": [
                                            "Alternative form of puer (“dung (e.g. of dogs)”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aadf0a83-7105-44bb-9e47-f3b20da9b72f",
                                                "sense_id": "be19f5bd-f9fe-3fae-b1df-0cd1319d08a2",
                                                "text": "[…] Dogs'-dung is called ‘Pure’, from its cleansing and purifying properties."
                                            },
                                            {
                                                "example_id": "94baba91-5b48-4dfa-ba9e-eb5a4cb7ee49",
                                                "sense_id": "be19f5bd-f9fe-3fae-b1df-0cd1319d08a2",
                                                "text": "Mary smelled the rancid odor of the tannery on the right side of the road.[…]\n\"What is that, Mary?\" Jake asked.\n\"'Tis a bag for collecting pure. That is going to be your job, Jake. You are to collect pure.\"\n\"Pure? What is pure?\"\n\"Pure is another word for dung,\" Mary answered."
                                            },
                                            {
                                                "example_id": "7f7ee794-a7f5-4e21-9cf4-ebeb8d7b73f7",
                                                "sense_id": "be19f5bd-f9fe-3fae-b1df-0cd1319d08a2",
                                                "text": "[…] surely there was something better for him than chasing the pure (footnote: A term, technically speaking, for dog muck, much prized by the tanneries.) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
