{
    "word_family": [
        "solemnity",
        "solemnize",
        "solemnly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f02fc51-87a2-3d67-99cd-e363cf077bb4",
                    "sense_definition": "Deeply serious and sombre; grave.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "serious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>solemn</w> promise to always tell the truth.",
                            "target_lang_translations": {
                                "tr": "Her zaman doğruyu söyleyeceğine dair <w>ciddi</w> bir söz verdi."
                            }
                        },
                        {
                            "text": "The <w>solemn</w> expression on her face showed she was worried.",
                            "target_lang_translations": {
                                "tr": "Yüzündeki <w>ağırbaşlı</w> ifade endişeli olduğunu gösteriyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "serious",
                        "grave",
                        "sober"
                    ],
                    "antonyms": [
                        "lighthearted",
                        "unserious"
                    ],
                    "common_phrases": [
                        "solemn promise",
                        "solemn expression"
                    ],
                    "target_lang_definitions": {
                        "tr": "Son derece ciddi, ağırbaşlı ve vakur."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ciddi",
                                "target_lang_sense_clarification": "Bir durumun veya kişinin ciddiyetini belirtir."
                            },
                            {
                                "target_lang_word": "ağırbaşlı",
                                "target_lang_sense_clarification": "Kişinin vakur ve ciddi tavrını ifade eder."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d32ba88-3cda-374c-b895-24199d547220",
                    "sense_definition": "Characterized by or performed with appropriate or great ceremony or formality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "formal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solemn</w> ceremony marked the end of the long war.",
                            "target_lang_translations": {
                                "tr": "<w>Resmi</w> tören, uzun savaşın sona erdiğini simgeliyordu."
                            }
                        },
                        {
                            "text": "They held a <w>solemn</w> procession through the city streets.",
                            "target_lang_translations": {
                                "tr": "Şehir sokaklarında <w>törensel</w> bir geçit düzenlediler."
                            }
                        }
                    ],
                    "synonyms": [
                        "formal",
                        "ceremonial"
                    ],
                    "common_phrases": [
                        "solemn ceremony",
                        "solemn procession"
                    ],
                    "target_lang_definitions": {
                        "tr": "Resmi törenlere uygun, büyük bir ciddiyet ve formalite ile gerçekleştirilen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "resmi",
                                "target_lang_sense_clarification": "Törensel ve kurallara bağlı durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "törensel",
                                "target_lang_sense_clarification": "Bir törenin ciddiyetini ve yapısını vurgular."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64909945-6c39-378c-9ff9-8142926a7e34",
                    "sense_definition": "Relating to religious ceremonies or sacred rites.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monks performed their <w>solemn</w> rites at dawn.",
                            "target_lang_translations": {
                                "tr": "Keşişler şafak vakti <w>kutsal</w> ayinlerini gerçekleştirdiler."
                            }
                        },
                        {
                            "text": "The cathedral is a place for <w>solemn</w> prayer and reflection.",
                            "target_lang_translations": {
                                "tr": "Katedral, <w>kutsal</w> dua ve tefekkür için bir yerdir."
                            }
                        }
                    ],
                    "synonyms": [
                        "sacred",
                        "holy"
                    ],
                    "common_phrases": [
                        "solemn rites"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dini törenler veya kutsal ayinlerle ilgili."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kutsal",
                                "target_lang_sense_clarification": "Dini bir önemi ve saygınlığı olan."
                            },
                            {
                                "target_lang_word": "ayinle ilgili",
                                "target_lang_sense_clarification": "Dini ritüelleri tanımlamak için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6492c4-06f3-3eec-82d5-5de6f12dc6b2",
                    "sense_definition": "Cheerless, gloomy, or sombre.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gloomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solemn</w> atmosphere in the room made everyone feel quiet.",
                            "target_lang_translations": {
                                "tr": "Odadaki <w>kasvetli</w> hava herkesin sessizleşmesine neden oldu."
                            }
                        },
                        {
                            "text": "He looked out at the <w>solemn</w> landscape under the grey sky.",
                            "target_lang_translations": {
                                "tr": "Gri gökyüzünün altındaki <w>kasvetli</w> manzaraya baktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "sombre",
                        "cheerless"
                    ],
                    "antonyms": [
                        "cheerful",
                        "sad"
                    ],
                    "common_phrases": [
                        "solemn atmosphere"
                    ],
                    "target_lang_definitions": {
                        "tr": "Neşesiz, kasvetli veya hüzünlü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kasvetli",
                                "target_lang_sense_clarification": "İç karartıcı ve neşesiz ortamlar için kullanılır."
                            },
                            {
                                "target_lang_word": "hüzünlü",
                                "target_lang_sense_clarification": "Kederli veya melankolik bir ruh halini belirtir."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}