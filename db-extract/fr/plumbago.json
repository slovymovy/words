                        "entry_id": "e9c9d85a-a230-3ff6-b0c8-32d5dd52f186",
                        "glosses": [
                            "Genre de plantes vivaces plombaginacées, également appelées dentelaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c906b423-d9c7-42ab-8ede-179f9fdfb0f3",
                                "sense_id": "2b8118a1-9614-3b80-b701-b488a394feb8",
                                "text": "Plus haut, là où le terrain devenait pentu, les plumbagos prenaient le relais, puis venaient les agapanthes et, enfin, les pieds de lavande."
                            },
                            {
                                "example_id": "14191afb-ec1e-4f2a-a306-338f3448d763",
                                "sense_id": "2b8118a1-9614-3b80-b701-b488a394feb8",
                                "text": "Le plumbago, plus connu sous le nom de « Dentelaire du Cap » forme un buisson couvert de fleurs bleu pâle tout au long de l'été."
                            }
                        ]
                    }
