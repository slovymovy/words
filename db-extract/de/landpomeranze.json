                                        "examples": [
                                            {
                                                "example_id": "5ab4bd08-62c4-4414-b6ad-a47f8cf3714d",
                                                "sense_id": "3004cd9f-4089-30c0-b0f7-30753ab0b38b",
                                                "text": "La nouvelle a l’air un peu péquenaude mais elle est compétente."
                                            }
                                        ]
