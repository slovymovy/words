                ],
                "senses": [
                    {
                        "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                        "entry_id": "7999b19c-cabc-3b2f-8ed1-ff8e103fdb3d",
                        "glosses": [
                            "weibliche Person, die Mitglied einer Gewerkschaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2052a17-4fce-4a6c-a562-646dbe8843fc",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "Die Gewerkschafterinnen werden dazu angehalten, sich am Streik zu beteiligen."
                            },
                            {
                                "example_id": "175978da-ea0f-4800-955a-9c5a28ba60c9",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Die Nummer eins auf der Grünen-Landesliste ist unbekannt. Das liegt nicht an Marianne Hürten, einer jungen Chemielaborantin, Gewerkschafterin, die im Bayer-Betriebsrat gegen alte IG-Chemie-SPDler opponiert.“"
                            },
                            {
                                "example_id": "c8e5d5b1-9df6-4367-885b-ea0f1629de91",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Mit Blick auf eine mögliche Änderung des Beamtenrechts oder eine bereits vorgeschlagene Zahlung der Sozialversicherungsabgaben auch von Beamten nannte die Gewerkschafterin das neue Offenbacher Modell ‚eine Illusion‘.“"
                            },
                            {
                                "example_id": "20545304-dcb8-4a4a-a452-53ce704e2928",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Deren Qualifikation sei nicht geregelt und sie würden meistens zu gering bezahlt, bemängelt die Gewerkschafterin.“"
                            },
                            {
                                "example_id": "a73ebd6d-4762-4bd9-b325-17867dd8b3e7",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Wir befürchten das Schlimmste, sagt die Gewerkschafterin unter einem großen roten Netz, das sie als stellvertretende Ortsvorsitzende von ver.di wie ein symbolisches „Netz für ein menschenwürdiges Dasein“ auch bei weiteren Aktionen einsetzen will.“"
                            },
                            {
                                "example_id": "fb9a677e-e5a2-4f75-8569-11fe282c04e5",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„In Brandenburg könne das Schiffshebewerk in Niederfinow und die große Schleuse im Bereich des Wasser- und Schifffahrtsamtes (WSA) Brandenburg betroffen sein, meinte die Gewerkschafterin.“"
                            },
                            {
                                "example_id": "b337fec7-fb40-4c39-931e-93ebf43d06fc",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Dies will der SPD-Stadtverband mit der Juso-Bundesvorsitzenden Johanna Uekermann und der Gewerkschafterin Karla Stamm diskutieren.“"
                            },
                            {
                                "example_id": "5d333689-4a45-4352-a494-73442bbdb1ce",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Gysi ist nicht die klassische Gewerkschafterin wie ihr Berner Ratskollege Corrado Pardini, der den Sektor Industrie der Unia leitet.“"
                            },
                            {
                                "example_id": "c915a71b-83f2-4a43-8f22-ad71eb62f68e",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Analoges Lernen darf aber nicht auf der Strecke bleiben, sagen ein Bildungsforscher, eine Gewerkschafterin und Bildungsministerin Christine Streichtert-Clivot (SPD).“"
                            },
                            {
                                "example_id": "6465b07e-26ac-40e2-bf73-7e133861026b",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„Vor allem jedoch, so kritisiert die Gewerkschafterin, betreffe der generelle Lehrermangel in Sachsen die Ober- und Förderschulen weit mehr als die Gymnasien.“"
                            },
                            {
                                "example_id": "78b950a5-128f-405b-8e9b-7071ddcf89b6",
                                "sense_id": "d09ce43a-e7f5-3952-a6b8-75213fc5b671",
                                "text": "„‚Bürokratieabbau ist so ein Schlagwort, das oft von Arbeitgebern und Wirtschaftsliberalen in Debatten eingeworfen wird‘, sagt die Gewerkschafterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
