                        ],
                        "examples": [
                            {
                                "example_id": "dcc8398e-62a3-43cd-af59-bbc2534d7561",
                                "sense_id": "610f19fb-6147-3801-83b4-498cf645dc57",
                                "text": "Diese Bumserei auf der Baustelle nebenan geht mir auf die Nerven."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b070032c-b83e-367d-a6ba-2a5ce1061e8b",
                        "entry_id": "a06053ab-38c5-37f4-91fb-fea48b1bc7f0",
                        "glosses": [
                            "andauernder oder wiederholter Geschlechtsverkehr"
                        ],
                        "tags": [
                            "umgangssprachlich, meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "8cb406d5-c0e3-4cf3-b172-707a42435654",
                                "sense_id": "b070032c-b83e-367d-a6ba-2a5ce1061e8b",
                                "text": "„Die ersten kindlichen Bumsereien liegen unendlich weit zurück, unwichtig, weil ohne Gefühl, auch ohne Selbstgefühl; sie hatten hingehalten; danach folgten Spannen der Enthaltsamkeit, wegen der Ernüchterung und Enttäuschung, es war mehr erwartet worden und soviel weniger eingetroffen, nein, nun nicht mehr; schließlich forderte das neue Brauchtum sein Recht, kein Mädchen konnte sich entziehen auf längere Zeit, also schlief es mal mit dem und mal mit jenem, nicht aus wirklich eigenem Antrieb.“"
                            },
                            {
                                "example_id": "316ab7e9-90b1-4ece-a9d0-b318df3befa2",
                                "sense_id": "b070032c-b83e-367d-a6ba-2a5ce1061e8b",
                                "text": "„Von ihrer Bumserei abgesehen, sind Marla und Tyler nie im selben Raum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
