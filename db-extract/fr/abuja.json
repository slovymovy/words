                    }
                ],
                "senses": [
                    {
                        "sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
                        "entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
                        "glosses": [
                            "Capitale du Nigeria (depuis 1991)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7e0f28-2662-4781-a5f1-92a66bcfbb3a",
                                "sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
                                "text": "Toujours est-il qu’il meurt le 8 juin 1998 dans le palais présidentiel d’Abuja, la capitale. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 217)"
                            },
                            {
                                "example_id": "7b1e898e-06fc-4977-a38e-c1a7cf36030f",
                                "sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
                                "text": "À l’issue du sommet d’Abuja au Nigeria, où elle s’est réunie jeudi, la Cedeao n’a pas donné de date butoir aux putschistes pour libérer le Président nigérien Mohammed Bazoum, prisonnier depuis le 26 juillet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edd88820-eaae-4b18-b31b-d49841353418",
                        "source_entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
                        "source_sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
                        "source_sense_description": "Ville",
                        "target_lang_word": "Abuja",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abuja",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c64329f-6b17-3b3f-8ac5-9c6e1fe1f643",
                                        "entry_id": "77af4241-d98b-3c2a-ae9d-cab3f4ef26fe",
                                        "glosses": [
                                            "Hauptstadt von Nigeria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a839c3-6b41-42a6-8212-ea9bd6f219ed",
                                                "sense_id": "2c64329f-6b17-3b3f-8ac5-9c6e1fe1f643",
                                                "text": "„Sie wollte, dass wir nach Abuja gehen und ein neues Leben beginnen.“"
                                            },
                                            {
                                                "example_id": "eb733575-f3aa-4a0f-9e60-80b05294ec37",
                                                "sense_id": "2c64329f-6b17-3b3f-8ac5-9c6e1fe1f643",
                                                "text": "„Die Moschee ist voll, niemand unterhält sich nebenher, als Sheikh über den Tod des Gouverneurs spricht, über die Planlosigkeit der Regierung in Abuja und warum wir beim nächsten Mal einen muslimischen Kandidaten zum Präsidenten wählen müssten.“"
                                            },
                                            {
                                                "example_id": "0dfb6d6c-f841-4d54-ab64-8d55b24996f0",
                                                "sense_id": "2c64329f-6b17-3b3f-8ac5-9c6e1fe1f643",
                                                "text": "„Sie kommen aus Lagos und manche sogar aus Abuja.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "192d4b17-cf3f-4932-8d2b-d43842f79bb5",
                        "source_entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
                        "source_sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
                        "source_sense_description": "Ville",
                        "target_lang_word": "Abuja",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abuja",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2862e9a4-73b9-305c-bcce-376a4f158c2e",
                                        "entry_id": "7965baa4-3fe6-31e3-bed0-2accfd144674",
                                        "glosses": [
                                            "The capital city of Nigeria; lying in the Federal Capital Territory in the North Central geopolitical zone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22cda64d-a33c-4c33-8e9c-a008c552e8a6",
                                                "sense_id": "2862e9a4-73b9-305c-bcce-376a4f158c2e",
                                                "text": "Abuja, Nigeria’s capital city, rises out of the Sahel like a modernist apparition. The avenues are clean and broad, and the government buildings are imposing, with that soulless and vaguely fascistic air common to capital cities from Washington, D.C., to Brasília."
                                            },
                                            {
                                                "example_id": "cff72a83-f32a-4238-b064-fc4e64192f90",
                                                "sense_id": "2862e9a4-73b9-305c-bcce-376a4f158c2e",
                                                "text": "Gunshots rang out in the capital Abuja and also in the neighboring Niger state as police lobbed tear gas to disperse defiant protesters. In Niger, at least six people are now feared dead, local media reported."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a85d756-ed2b-46c0-bec7-eda326401077",
                        "source_entry_id": "5969b0cc-eb73-35e9-83fa-6309c2523fae",
                        "source_sense_id": "aeb2432b-23fd-39f9-872b-87e47dbd6de1",
