    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "381e101d-1fe1-3191-ae1e-c801485ef117",
                    "sense_definition": "Personne reconnue comme membre d'un État, jouissant de droits civils et politiques et soumise à des devoirs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appartenance_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>citoyen</w> a le droit d'exprimer son opinion lors des consultations électorales."
                        },
                        {
                            "text": "Tous les <w>citoyens</w> doivent respecter les lois fondamentales de la République."
                        }
                    ],
                    "common_phrases": [
                        "citoyen du monde",
                        "droits du citoyen"
                    ]
                },
                {
                    "sense_id": "6e014c70-073c-3071-9544-e2bc32aabc5b",
                    "sense_definition": "Habitant d'une ville qui jouit du droit de cité et des privilèges urbains.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ville",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>citoyens</w> de la commune se sont réunis sur la place centrale."
                        },
                        {
                            "text": "Autrefois, seuls certains habitants avaient le statut privilégié de <w>citoyen</w>."
                        }
                    ],
                    "synonyms": [
                        "bourgeois"
                    ],
                    "common_phrases": [
                        "citoyens de la ville"
                    ]
                },
                {
                    "sense_id": "12d06ff0-a7b2-3d58-a02e-93b2bc298a22",
                    "sense_definition": "Dans l'Antiquité, homme libre membre d'une cité et détenteur de prérogatives politiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "antiquite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À Rome, l'empereur a accordé le statut de <w>citoyen</w> à tous les hommes libres."
                        },
                        {
                            "text": "Les <w>citoyens</w> athéniens participaient directement aux décisions de l'assemblée du peuple."
                        }
                    ],
                    "common_phrases": [
                        "citoyen romain"
                    ]
                },
                {
                    "sense_id": "28136bcb-7c69-31a3-a5e9-33724b9b4bf0",
                    "sense_definition": "Formule d'adresse employée notamment sous la Révolution française à la place de monsieur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tourmente révolutionnaire, on s'adressait aux gens en disant « bonjour, <w>citoyen</w> »."
                        },
                        {
                            "text": "Le tribunal a interrogé le <w>citoyen</w> sur ses activités récentes."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usité principalement pendant la Révolution française"
                        }
                    ]
                },
                {
                    "sense_id": "64cd5a65-5594-32db-b74d-757876ffe972",
                    "sense_definition": "Individu quelconque, quidam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce drôle de <w>citoyen</w> traînait dans la rue sans savoir où aller."
                        },
                        {
                            "text": "Le vieux <w>citoyen</w> refusait catégoriquement de quitter son quartier."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d45b683a-6de1-316f-b9ae-26c202c55307",
                    "sense_definition": "Qui manifeste un sens civique ou qui vise l'intérêt collectif d'une communauté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "civisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ramasser ces déchets abandonnés dans la forêt est un véritable acte <w>citoyen</w>."
                        },
                        {
                            "text": "Les habitants ont rejoint une initiative <w>citoyenne</w> pour végétaliser leur quartier."
                        }
                    ],
                    "synonyms": [
                        "civique"
                    ],
                    "antonyms": [
                        "incitoyen",
                        "incivique"
                    ],
                    "common_phrases": [
                        "acte citoyen",
                        "initiative citoyenne",
                        "mouvement citoyen"
                    ]
                },
                {
                    "sense_id": "9bdbc93a-0105-38d7-b6ad-2b386925cf83",
                    "sense_definition": "Employé en apposition pour désigner quelqu'un qui agit en citoyen ou qui en a les qualités.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le monarque voulait donner de lui l'image rassurante d'un roi-<w>citoyen</w>."
                        },
                        {
                            "text": "Ce soldat-<w>citoyen</w> défendait sa patrie avec beaucoup de courage et d'ardeur."
                        }
                    ],
                    "common_phrases": [
                        "roi-citoyen"
                    ]
                }
            ]
        }
    ]
