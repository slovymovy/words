                "senses": [
                    {
                        "sense_id": "e45ed4f9-cb0c-38c8-b446-5148b6d9c108",
                        "entry_id": "5e4a7425-e986-380c-ad50-7cac1ad18139",
                        "glosses": [
                            "Donner une forme tubulaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d28bedf-0da1-4209-adc3-7b5e616b3590",
                                "sense_id": "e45ed4f9-cb0c-38c8-b446-5148b6d9c108",
                                "text": "Le connard de vendeur me dévisage avec ses yeux de tubes prêts à me tubulariser à la moindre provocation."
                            },
                            {
                                "example_id": "569a5b4c-2008-4782-8abd-996b73515ba2",
                                "sense_id": "e45ed4f9-cb0c-38c8-b446-5148b6d9c108",
                                "text": "Chez le garçon, cette gouttière urétrale va se tubulariser, va donner l’urètre antérieur."
                            },
                            {
                                "example_id": "181b31fa-434c-4cce-9928-c12d4b0ba5a3",
                                "sense_id": "e45ed4f9-cb0c-38c8-b446-5148b6d9c108",
                                "text": "Chez les Planorbidae, pourtant, la poche néphridienne s’allonge, elle tend même à se tubulariser dans certains genres (Bulinus et Camptoceras), tandis que parallèlement ses replis internes se simplifient et même disparaissent."
                            }
                        ]
                    }
