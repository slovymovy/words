                ],
                "senses": [
                    {
                        "sense_id": "d0a620db-ac14-39c7-99db-7f5e5f8eacdb",
                        "entry_id": "0892f0a3-a5fd-329b-a3b4-88f7cb99ea46",
                        "glosses": [
                            "прост. состояние страха, неуверенности в себе, нервозности; боязнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e102728c-7d5f-49b5-a412-89d817c87aac",
                                "sense_id": "d0a620db-ac14-39c7-99db-7f5e5f8eacdb",
                                "text": "— У нас в школе была чокнутая учительница, — продолжал он, — вся школа, начиная от директора и кончая последним учеником, хезали перед ней от мандража!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c7c6f5a-737e-4607-abac-0b7bb491d260",
                        "source_entry_id": "0892f0a3-a5fd-329b-a3b4-88f7cb99ea46",
                        "source_sense_id": "d0a620db-ac14-39c7-99db-7f5e5f8eacdb",
                        "target_lang_word": "ansia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ansia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7bbc35-39c9-3e13-b003-8068dd3f0018",
                                        "entry_id": "827322b1-f177-34bc-9d46-46adf070273d",
                                        "glosses": [
                                            "sensazione di incertezza o paura causata da uno o più conflitti inconsci di fronte a qualcosa o qualcuno che viene identificato come pericoloso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a44f241-eb5d-4e74-9be7-4a1d9841a20c",
                                                "sense_id": "9b7bbc35-39c9-3e13-b003-8068dd3f0018",
                                                "text": "Quando il professore mi rivolse quella domanda complicata, fui preso dall'ansia di non essere in grado di rispondere correttamente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536947af-f9e6-3b22-ad90-68ae4090ca9a",
                                        "entry_id": "827322b1-f177-34bc-9d46-46adf070273d",
                                        "glosses": [
                                            "voglia tormentosa"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91465248-a8d3-4f1c-9bb7-0652cadd1c10",
                                                "sense_id": "536947af-f9e6-3b22-ad90-68ae4090ca9a",
                                                "text": "Quel ragazzo ha un'incredibile ansia di conoscenza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7166bfe1-3490-41f2-a6de-79530ce6a67e",
                        "source_entry_id": "0892f0a3-a5fd-329b-a3b4-88f7cb99ea46",
                        "source_sense_id": "d0a620db-ac14-39c7-99db-7f5e5f8eacdb",
                        "target_lang_word": "trac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d84d8f9-eeee-311e-a4e7-bfd62891f768",
                                        "entry_id": "15a388d3-b32d-3b14-88e0-b859567c5eed",
                                        "glosses": [
                                            "Allure du cheval, du mulet, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d3265f-1c13-4eeb-8f12-7d0d3c0c9266",
                                                "sense_id": "3d84d8f9-eeee-311e-a4e7-bfd62891f768",
                                                "text": "Le trac des chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef0ae19-be53-3f55-b9aa-d0dc525f5aa6",
                                        "entry_id": "15a388d3-b32d-3b14-88e0-b859567c5eed",
                                        "glosses": [
                                            "Trace de la piste des bêtes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "330674c4-4cf7-49c5-9265-64831f8e8fe5",
                                                "sense_id": "6ef0ae19-be53-3f55-b9aa-d0dc525f5aa6",
                                                "text": "Suivre une bête au trac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                                        "glosses": [
                                            "Sentiment d'appréhension irraisonnée avant d'affronter le public, d'entrer en scène. Peur qu’éprouvent les acteurs, chanteurs, orateurs, etc., au moment de paraître en public."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b9394de-2cbc-4f9f-a6b3-4535b1356204",
                                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                                "text": "Une fois le pied sur les planches, je sentis ce courage factice fondre à la menace du danger. Il me passait devant les yeux des éblouissements convulsifs. J'éprouvais dans les jambes, le tremblement nerveux du conscrit à son premier coup de feu, et j'entendais distinctement le tic-tac de mon cœur qui battait comme un balancier de pendule. Tranchons le mot : j'avais le trac."
                                            },
                                            {
                                                "example_id": "62f4b670-d380-4f21-8312-550e2703d15c",
                                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                                "text": "Elle attendait le trac qui ne venait pas. Pourtant tous les bons comédiens l’ont."
                                            },
                                            {
                                                "example_id": "b2463dab-8c34-4f77-b73e-903abbbc7290",
                                                "sense_id": "a1baccf1-d515-324a-8277-2564b614270f",
                                                "text": "C’était bel et bien l’espion qui a le trac d’être pris et qui ne veut plus continuer son redoutable métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                                        "glosses": [
                                            "Sentiment d’appréhension éprouvé dans une situation délicate ou cruciale."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4dc7928-cec0-48aa-a487-2e0fefbc0df8",
                                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                                "text": "– On veut se dépêcher, disait-il, il faudrait avoir le temps de fouiller dans toutes ces affaires ; on ne peut pas, parce que, il n’y a pas à dire, on a tout de même un peu le trac."
                                            },
                                            {
                                                "example_id": "d793be4d-d23e-44ce-90af-d5ac66b0b7c3",
                                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                                "text": "On était pareil à un chat qui s’est glissé dans le buffet pour manger une sauce. Il a vaguement le trac, et quand il s’agit d’attaquer la sauce, voilà qu’il n’a plus d’appétit."
                                            },
                                            {
                                                "example_id": "d9cb3450-701b-4b34-8d1d-debce6028f9a",
                                                "sense_id": "2b794c22-805a-3e41-ae2f-b4ff4827be53",
                                                "text": "– Je crains que nous n’ayons des ennuis !\n– On croirait qu’il t’a filé le trac !\n– Exactement !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d05b2ae-125a-3323-9ce1-58e50bdcb0e5",
                                        "entry_id": "9c5100ee-df55-37a2-8fb7-fa3986292753",
                                        "glosses": [
                                            "Sentiment de tension, de peur et de désarroi dont la cause est diffuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ec8634-a38b-44e8-a24a-175cd0a21ae0",
                                                "sense_id": "8d05b2ae-125a-3323-9ce1-58e50bdcb0e5",
                                                "text": "C’était une ville qui collait le trac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9fd6418-7e4c-47fa-998f-9f579fc49893",
                        "source_entry_id": "0892f0a3-a5fd-329b-a3b4-88f7cb99ea46",
                        "source_sense_id": "d0a620db-ac14-39c7-99db-7f5e5f8eacdb",
                        "target_lang_word": "frousse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frousse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                        "entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                                        "glosses": [
                                            "Peur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b78342-10d7-4ef6-a974-04fa34b3a5d7",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "Je suis content que tu sois revenu. Tu nous a foutu une sacrée frousse."
                                            },
                                            {
                                                "example_id": "d63cf499-3397-4d61-97bf-9c2ad08268dd",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "C’était pas permis de vous faire droguer ainsi, quand on avait une frousse pareille !"
                                            },
                                            {
                                                "example_id": "a620c3b5-1513-4d40-a0b9-b9b1ff4fa447",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "Ne cède pas à la frousse, me réconforte Tacherot, c'est un mauvais moment à passer."
                                            },
                                            {
                                                "example_id": "741f36bf-7fd6-49ba-83d5-60f7e5821adc",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "Je ne vis plus, j’ai tout le temps la frousse d’être pincée."
                                            },
                                            {
                                                "example_id": "119be908-435f-4a0f-b646-291caa65e9a6",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "La poulaille n’est certainement pas en odeur de sainteté dans le coinstot. Non pas que les indigènes craignent une vulgaire peste aviaire, mais la frousse qu'un gallinacé au plumage bleu nuit engendre des émeutes incendiaires de guimbardes reste vivace."
                                            },
                                            {
                                                "example_id": "a2172e3b-1bbc-41b0-9ba1-8ef0836979fd",
                                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                                "text": "C'était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu'un des deux se viandât méchamment cinq mètres plus bas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
