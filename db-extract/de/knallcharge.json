                ],
                "senses": [
                    {
                        "sense_id": "80a2d7b8-1fe5-3ac2-ac76-8f8519482dbb",
                        "entry_id": "5934c958-8d8b-379a-bda4-00f72dac1640",
                        "glosses": [
                            "ein Schauspieler in einer Rolle, die plumpe, derbe Komik und Überzeichnung aufweist"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e7d4b0b3-ee8c-41ad-9759-b8edadbcff16",
                                "sense_id": "80a2d7b8-1fe5-3ac2-ac76-8f8519482dbb",
                                "text": "„Eine unwichtige Knallcharge zu spielen, darauf habe ich keinen Bock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                        "entry_id": "5934c958-8d8b-379a-bda4-00f72dac1640",
                        "glosses": [
                            "wenig intelligente, dumme Person"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5aa02cfc-af8d-481f-af42-fd98673d00d6",
                                "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                                "text": "„Nichts wäre für ihn schlimmer gewesen, als in den Augen seiner Leute als Knallcharge oder Abiturientenschnösel dazustehen.“"
                            },
                            {
                                "example_id": "adf9f210-a052-49fc-93f9-d67b4a39ff66",
                                "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                                "text": "„Und auf dem Feld der Ost- und Deutschlandpolitik war man sich ohnehin am nächsten: Vor allem wollte man sich die Fortschritte in den innerdeutschen Beziehungen nicht von einer Knallcharge im Weißen Haus vermasseln lassen.“"
                            },
                            {
                                "example_id": "9a3e8132-2d84-4f1a-be97-55e0d7c67843",
                                "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                                "text": "„»Steif und starr bist du, du dämlicher Sitzpinkler! Das hast du jetzt davon!« »Wie? Was?« »Selber schuld! Du blöde Knallcharge!«“"
                            },
                            {
                                "example_id": "ccca3160-7767-4e99-8fd5-eed861b9242b",
                                "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                                "text": "„»Ein Kollege von mir hätte jetzt >Sie Knallcharge!'< erwidert.« »Wie gut, dass mich meine gute Erziehung davon abhält, >Vollidiot!< zu dir zu sagen!«“"
                            },
                            {
                                "example_id": "a3155067-8537-447c-8601-8c7ea343f1a5",
                                "sense_id": "6605a5e6-b284-3220-a2b2-4237654784a4",
                                "text": "„Bis auf jene subalterne Knallcharge, die keine Ahnung hatte, stellte in Bonn folglich niemand eine Frage zur RAF.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
