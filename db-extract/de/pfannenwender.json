                    {
                        "sense_id": "f6901a38-78bc-3477-955b-b82a44ff3056",
                        "entry_id": "a2512032-ce80-3850-ad8a-219c5a15b241",
                        "glosses": [
                            "Küchengerät, mit dem man Speisen, zum Beispiel Bratlinge oder Fleisch, in der Bratpfanne umdreht (wendet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9ecd8f-7040-4320-8eb4-cbe3879a2d88",
                                "sense_id": "f6901a38-78bc-3477-955b-b82a44ff3056",
                                "text": "Wenn die Bouletten auf einer Seite angebraten sind, müssen sie mit einem Pfannenwender vorsichtig umgedreht und von der anderen Seite gebraten werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
