                        "glosses": [
                            "Épouse d’un despote (souverain d’un despotat)."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "bf223a34-a4c2-447c-be3d-b5f913675381",
                                "sense_id": "1a9844b9-66a5-38b3-9282-f865155141e2",
                                "text": "Il agrandit le couvent qu’il enrichit de ses bienfaits et des libéralités de sa sœur Kyra Angelina, despotesse de Joannina, et il en fut nommé higoumène."
                            },
                            {
                                "example_id": "f43b4c41-f95c-4da3-bbf9-8bca8c235392",
                                "sense_id": "1a9844b9-66a5-38b3-9282-f865155141e2",
                                "text": "Il nous est donné ici comme le propre fils du roi serbe Siméon Ourésis, régnant à Tricca comme le frère de la princesse Marie-Ange Doucas Paléologue, despotesse d’Épire."
                            }
                        ]
                    }
