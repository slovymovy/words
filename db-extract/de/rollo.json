                "senses": [
                    {
                        "sense_id": "d1d94024-25cd-310a-9131-f1762f86f4fc",
                        "entry_id": "59ec27cc-ffed-3f3d-9d3c-fe106d031e5b",
                        "glosses": [
                            "innen an Fenstern oder Glastüren befestigter, aufrollbarer Licht- und/oder Sichtschutz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7972331-cbfd-4914-8bd9-c297b10d0022",
                                "sense_id": "d1d94024-25cd-310a-9131-f1762f86f4fc",
                                "text": "Im Winter wurden bei Familie Schüller-Müdenleid die Rollos überhaupt nicht mehr hochgezogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9725a45b-d69a-45d3-85e6-fd50caf1f9e9",
                        "source_entry_id": "59ec27cc-ffed-3f3d-9d3c-fe106d031e5b",
                        "source_sense_id": "d1d94024-25cd-310a-9131-f1762f86f4fc",
                        "source_sense_description": "innen an Fenstern oder Glastüren befestigter, aufrollbarer Licht- und/oder Sichtschutz",
                        "target_lang_word": "store",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "store",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                        "entry_id": "7c443fbc-bf7d-39c4-ae8f-d3fa70186853",
                                        "glosses": [
                                            "Rideau fait d’étoffe, de lames de bois, etc., qui se lève et se baisse par le moyen d’un cordon ou d’un ressort, et qu’on met devant une fenêtre, à une portière de voiture, etc., pour se protéger du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66bed9b7-690e-4a2e-bb83-d3c445bb867c",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Avoir des stores à ses fenêtres."
                                            },
                                            {
                                                "example_id": "60b0348c-296a-4f05-b863-4632712485f9",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Lever les stores."
                                            },
                                            {
                                                "example_id": "21a5a700-c6a1-4328-bb10-b1c45a4c5f92",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Baisser, abaisser les stores."
                                            },
                                            {
                                                "example_id": "71464677-619e-4c77-ae61-3173b6643b90",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Les maisons d'en face dormaient, assommées sous les coups de soleil, tous volets clos, tous stores descendus."
                                            },
                                            {
                                                "example_id": "75d2ae25-a35a-4c21-a149-386c17f47142",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Le père ne la quitta des yeux qu’après avoir vu retomber derrière elle le store de perles de la cuisine."
                                            },
                                            {
                                                "example_id": "36b54d37-f827-4d48-9af1-7352d8220219",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Store à l'italienne, store extérieur qui peut se mettre en position oblique ou verticale grâce à des montants repliables."
                                            },
                                            {
                                                "example_id": "51109c5e-5b22-4db2-934e-073ccb45fcc9",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Store vénitien, store extérieur ou intérieur composé de lamelles horizontales orientables."
                                            },
                                            {
                                                "example_id": "cf577050-adea-4882-831f-812c801de1b5",
                                                "sense_id": "c880004b-aaaf-30b9-aadd-6b8b94a159eb",
                                                "text": "Les fenêtres sont encadrées d’ornements et d’architectures simulés avec force volutes, enroulements, petits Amours et pots à fleurs, et garnies de stores à la vénitienne rayés de larges bandes bleues et blanches, ou de tapis de sparterie qu’on arrose pour charger d’humidité et de fraîcheur le vent qui les traverse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "store",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4279a9c4-fc61-34b3-aefb-58441f448647",
                                        "entry_id": "2ab16a2c-d38e-36b2-ba27-576304cda075",
                                        "glosses": [
                                            "Boutique en ligne d’applications (payantes ou gratuites) destinées à des systèmes d’exploitation grand public, tels qu’Android ou Ubuntu."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
