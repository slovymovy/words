                    "semantic_group_id": "separation_marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn ouders zijn tien jaar geleden officieel <w>gescheiden</w>.",
                            "target_lang_translations": {
                                "en": "My parents officially <w>divorced</w> ten years ago.",
                                "ru": "Мои родители официально <w>развелись</w> десять лет назад.",
                                "pl": "Moi rodzice oficjalnie <w>rozwiedli się</w> dziesięć lat temu.",
                                "de": "Meine Eltern haben sich vor zehn Jahren offiziell <w>scheiden lassen</w>.",
                                "fr": "Mes parents ont officiellement <w>divorcé</w> il y a dix ans.",
                                "it": "I miei genitori hanno ufficialmente <w>divorziato</w> dieci anni fa.",
                                "cs": "Moji rodiče se před deseti lety oficiálně <w>rozvedli</w>.",
                                "tr": "Annemle babam on yıl önce resmen <w>boşandı</w>.",
