                "senses": [
                    {
                        "sense_id": "8fe6f166-a5d1-3320-af91-21a7f70b99cb",
                        "entry_id": "e3d500a1-e179-30dc-a08d-c769be6bbbc1",
                        "glosses": [
                            "Donner un caractère rhénan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a4c634f-d34f-4377-a3c3-7a931a3b2725",
                                "sense_id": "8fe6f166-a5d1-3320-af91-21a7f70b99cb",
                                "text": "Quelle stratégie de marketing urbain faut-il mettre en œuvre pour rhénaniser les périphéries ?"
                            },
                            {
                                "example_id": "77a08305-ad5a-4aad-8362-389b130f464a",
                                "sense_id": "8fe6f166-a5d1-3320-af91-21a7f70b99cb",
                                "text": "En ce sens, la France - et les néogroupes avec elle - aurait tendance à se rhénaniser : les investisseurs financiers, surtout depuis le krach et la difficulté accrue de procéder à des augmentations de capital, prennent le relais de la Bourse pour satisfaire les besoins en fonds propres de ces assoiffés de croissance."
                            },
                            {
                                "example_id": "4a98ef14-6889-4b04-adfc-b169c029c8a6",
                                "sense_id": "8fe6f166-a5d1-3320-af91-21a7f70b99cb",
                                "text": "Je contemplai le fleuve le trafic des péniches filant vers Maastricht Nijmegen et Rotterdam, la Meuse pressée de se rhénaniser."
                            }
                        ]
                    }
