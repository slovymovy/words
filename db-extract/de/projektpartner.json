                "senses": [
                    {
                        "sense_id": "bb893d8c-772f-350b-a0a6-8101e82c5d43",
                        "entry_id": "c034f84b-3d9e-3c72-897a-1053fdbfa2ef",
                        "glosses": [
                            "Person, die mit einer anderen zusammen an einem Projekt arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e96d7a-a68a-4611-9187-d06793513395",
                                "sense_id": "bb893d8c-772f-350b-a0a6-8101e82c5d43",
                                "text": "„Einen Batteriegroßspeicher für Strom haben der Energieversorger EWE und japanische Projektpartner am Donnerstag in Varel im Kreis Friesland offiziell in Betrieb genommen.“"
                            },
                            {
                                "example_id": "2fc2dfb9-24e3-4d59-8e59-bd593470d901",
                                "sense_id": "bb893d8c-772f-350b-a0a6-8101e82c5d43",
                                "text": "„Gemeinsam mit dem Stadtverkehr Lübeck soll in den nächsten zwei Jahren eine Lösung für das Problem der begrenzten Reichweite von Elektrobussen gefunden werden. Dafür wollen die Projektpartner mit Nutzern der Busse einen Reichweitenassistenten entwickeln und im praktischen Betrieb testen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
