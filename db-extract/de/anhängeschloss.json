                "senses": [
                    {
                        "sense_id": "3c73f1f6-b1a1-3639-9a91-84a17d036103",
                        "entry_id": "a537e37c-c2b6-38aa-a6e1-2e489492baec",
                        "glosses": [
                            "nicht integriertes Schloss, das einfache Verschlüsse mit einem festgestellten Bügel verschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae6535a-93be-449c-bad4-e1c5418a5d2b",
                                "sense_id": "3c73f1f6-b1a1-3639-9a91-84a17d036103",
                                "text": "Der Verschluss bietet die Möglichkeit zum Befestigen eines Anhängeschlosses."
                            },
                            {
                                "example_id": "a2d26b54-1c10-48fe-9631-651389f7672c",
                                "sense_id": "3c73f1f6-b1a1-3639-9a91-84a17d036103",
                                "text": "Ein Anhängeschloss versperrt den Weg in den nächsten Raum."
                            },
                            {
                                "example_id": "1091d05f-d89a-410f-9fb3-5d815ede8fbe",
                                "sense_id": "3c73f1f6-b1a1-3639-9a91-84a17d036103",
                                "text": "Im Zuge von Instandhaltungsmaßnahmen an der Fußgängerbrücke zur Mühleninsel werden die Anhängeschlösser entfernt."
                            },
                            {
                                "example_id": "842e63f5-6ecd-40c9-875c-e0bb748483b1",
                                "sense_id": "3c73f1f6-b1a1-3639-9a91-84a17d036103",
                                "text": "Wie versteinert stand Alex Weitgruber da und starrte nur noch auf den leeren Radständer. Das aufgezwickte Anhängeschloss baumelte noch."
                            }
                        ],
