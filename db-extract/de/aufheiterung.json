                "senses": [
                    {
                        "sense_id": "bed12fb9-fbf8-3fcc-a375-970760f9fce8",
                        "entry_id": "2385acbf-78b3-33c9-a719-fa1e10a91e61",
                        "glosses": [
                            "der Übergang von schlechtem Wetter zu sonnigem Wetter"
                        ],
                        "tags": [
                            "vom Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "d35decbe-de03-4336-b60a-2e2f08479088",
                                "sense_id": "bed12fb9-fbf8-3fcc-a375-970760f9fce8",
                                "text": "Eine baldige Aufheiterung des Wetters ist nicht zu erwarten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25e7c782-306a-3f1c-80dc-a2ddd0f5957c",
                        "entry_id": "2385acbf-78b3-33c9-a719-fa1e10a91e61",
                        "glosses": [
                            "der Versuch, jemandem die Laune zu verbessern"
                        ],
                        "tags": [
                            "von Menschen"
                        ],
                        "examples": [
                            {
                                "example_id": "c584a5b1-1055-4f08-93bb-fff6e32214c3",
                                "sense_id": "25e7c782-306a-3f1c-80dc-a2ddd0f5957c",
                                "text": "Danke für deine Aufheiterung, aber es geht schon."
                            },
                            {
                                "example_id": "668defc7-b0a1-49a1-805c-d44a19dfa8a7",
                                "sense_id": "25e7c782-306a-3f1c-80dc-a2ddd0f5957c",
                                "text": "„Dieses fröhliche Bild nutzt eine große Fastfoodkette als Werbefigur und sogar in der Kinderkrebshilfe und in Krankenhäusern werden Clowns zur Aufheiterung eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7f2d0b08-ba99-3311-9d4e-2d5c4ac02380",
                        "entry_id": "2385acbf-78b3-33c9-a719-fa1e10a91e61",
                        "glosses": [
                            "die eigentliche Verbesserung des Gemütszustandes"
                        ],
                        "tags": [
                            "von Stimmungen"
                        ],
                        "examples": [
                            {
                                "example_id": "53e7b3d9-7130-4d93-a2ee-e052a56bf567",
                                "sense_id": "7f2d0b08-ba99-3311-9d4e-2d5c4ac02380",
                                "text": "Die Aufheiterung war in der gesamten Atmosphäre des Gespräches zu spüren."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bea7072-1710-44ac-91ef-35cd98f0ee79",
                        "source_entry_id": "2385acbf-78b3-33c9-a719-fa1e10a91e61",
                        "source_sense_id": "bed12fb9-fbf8-3fcc-a375-970760f9fce8",
                        "source_sense_description": "vom Wetter: der Übergang von schlechtem Wetter zu sonnigem Wetter",
                        "target_lang_word": "amélioration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amélioration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Action de prendre quelque chose pour le transformer en le rendant meilleur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e112c6-c3dc-473f-9be5-6cc50b7b34ca",
                                                "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                                "text": "Le kaizen est un processus d'améliorations concrètes, simples et peu onéreuses réalisées dans un laps de temps très court."
                                            },
                                            {
                                                "example_id": "458e4cfd-8109-4215-88b2-0b0bf5c5e0b0",
                                                "sense_id": "79021c52-af6d-37a0-a86b-c9e958030584",
                                                "text": "Il n’est pas de question zootechnique qui ait été plus débattue, plus controversée que celle de l’amélioration des races chevalines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759315a5-3170-4643-8b87-c90ebd9ae6b3",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Le Dʳ Aignier déclare au Congrès des monistes (Magdebourg, 6-10 septembre 1912) n’avoir constaté à Lourdes ni guérison ni amélioration véritables."
                                            },
                                            {
                                                "example_id": "4ac5a7b5-52c6-497e-a7e2-b6fdb0bbcb10",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Une psychasthénique mysophobe, avec rituels de propreté, n’a accusé aucune amélioration par le R 1625. Il convient cependant de multiplier les essais chez les obsédés-phobiques."
                                            },
                                            {
                                                "example_id": "82eff728-84be-4e0b-9f02-87465d5a53e2",
                                                "sense_id": "ca5fd307-a59d-3f9f-8b04-0ef491014ad2",
                                                "text": "Tout échange monétaire est délicat : il serait bon de faire coïncider l'introduction du saarmark, et plus encore l'introduction du franc, avec une amélioration des conditions matérielles et politiques de la vie sarroise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Investissement dans un fonds de terre ou dans une maison pour les mettre en état et pour en augmenter le revenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f865aab1-84f6-4285-83e8-6581983f0d35",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l’amélioration des grandes étendues des sols de minime valeur."
                                            },
                                            {
                                                "example_id": "36d499a6-eac2-4797-87e9-bcb2e80180e4",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Le problème de l’excès de sel se pose dans de nombreux périmètres irrigués des régions sèches. Leur amélioration peut se faire par des apports de gypse ou de phosphogypse."
                                            },
                                            {
                                                "example_id": "793097f5-d713-44e8-ab6e-cda830f35401",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "L’éclaircie est généralement une coupe d’amélioration réalisée dans un peuplement régulier dans le but de favoriser la stabilité, la dominance et la croissance soutenue des tiges d’avenir."
                                            },
                                            {
                                                "example_id": "c4e38382-b5cc-459d-976b-42d7172961da",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Améliorations utiles."
                                            },
                                            {
                                                "example_id": "fa0ef0b6-ad1e-4450-8781-b2609386475f",
                                                "sense_id": "468ae6c9-fd40-34df-967d-1c1db676ff06",
                                                "text": "Améliorations voluptuaires, qui n’ont en vue que l’agrément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3515ebea-08dd-324c-bc92-08113ef0ae80",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Amélioration des plantes : technique qui consiste à rendre les variétés mieux adaptées aux besoins des utilisateurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98138a40-fe80-3ec3-8e05-91d2144f2376",
                                        "entry_id": "fc6e1d30-7a96-3951-8cab-bdfe5b834abd",
                                        "glosses": [
                                            "Augmentation de la qualité globale d’un peuplement par la coupe de tiges au profit d’essences de plus grande valeur, d’arbres à la bille de pied mieux conformée…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2dbbab-fcb5-405c-b35b-3371b412230f",
                                                "sense_id": "98138a40-fe80-3ec3-8e05-91d2144f2376",
                                                "text": "La qualification est la phase qui débute lorsque le peuplement a atteint la hauteur de 3 m (qui marque, par convention, le seuil de passage de la phase de régénération à la phase d’amélioration) et s’achève lorsque la hauteur dominante du peuplement atteint 11 à 14 m selon l’essence et la fertilité de la station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e4ccb19-9dd2-415d-a5e7-99ec34a3f57d",
                        "source_entry_id": "2385acbf-78b3-33c9-a719-fa1e10a91e61",
                        "source_sense_id": "bed12fb9-fbf8-3fcc-a375-970760f9fce8",
                        "source_sense_description": "vom Wetter: der Übergang von schlechtem Wetter zu sonnigem Wetter",
                        "target_lang_word": "éclaircie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Endroit clair qui paraît au ciel en temps de brume ou entre des nuages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca769802-3b03-4b2d-aa8c-ec97ec1ee872",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Le vent, qui parfois mollissait, reprenait bientôt avec plus de rage, au milieu de grains de grêle et de neige. À travers les éclaircies on ne découvrait que des sinistres."
                                            },
                                            {
                                                "example_id": "c4634734-d06b-4356-a2d8-5cb3a07ed1cf",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Des éclaircies, en contrepoint à la marche sombre des corps."
                                            },
                                            {
                                                "example_id": "b68798e1-5536-47df-88f9-2bda8e3b9010",
                                                "sense_id": "2084f71b-a4e8-36d6-a93e-900e277fcb44",
                                                "text": "Il y a une éclaircie dans la situation politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Période ensoleillée plus ou moins longue ou dépourvue de nuage et de brume pendant la nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73bd9c0e-6d3c-4663-b8c3-a45a3cd64aba",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "Le ciel était nuageux, l’humidité pénétrante. Entre des éclaircies de soleil, des averses tombaient."
                                            },
                                            {
                                                "example_id": "bf7fe5cd-ddb9-418b-bb7e-3935e28bdc7a",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "Vers le soir, nous commençons à distinguer des formes vagues qui se dessinent derrière le voile de brume, puis, à travers une éclaircie, nous reconnaissons des montagnes qui se découvrent une à une ; […]."
                                            },
                                            {
                                                "example_id": "9f6a835a-4038-46c4-a656-0b7711e03cb5",
                                                "sense_id": "0005561a-cbe5-3b8c-9730-971167d3035a",
                                                "text": "3. - Beau temps dans la matinée et le milieu du jour. On pêche. Dans la soirée, des nuées épaisses montent du S.-O., et la houle du large arrive jusqu'à nous. Éclaircie dans la nuit. 4. - Mer houleuse du S.-O. Brumes orageuses. Pêche difficile?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                        "entry_id": "7bde3765-ebd6-3d33-91e9-4e0524ccb473",
                                        "glosses": [
                                            "Action visant à réduire la densité d’un peuplement ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f31cb0-954d-4ee7-8ca5-3b00fe5e7e7c",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Une éclaircie se manifesta tout à coup à notre droite, - quelqu'une de ces coupes sombres qui éclaircissent singulièrement la forêt."
                                            },
                                            {
                                                "example_id": "6784b359-949a-446c-bac2-767df36de65e",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Je ne pouvais pénétrer dans ces bois où personne n’avait posé le pied, où j’étais probablement le premier à tenter de me frayer un chemin à l’aide de mon sabre. Il m’arrivait cependant de trouver quelques éclaircies."
                                            },
                                            {
                                                "example_id": "237b73a2-0120-4839-9795-6ce88f1d3614",
                                                "sense_id": "5da7299a-3a3b-329b-b79c-1f4f51cb691f",
                                                "text": "Par-dessous les arbres, on apperçoit la mer ; et dans les éclaircis, tout le golfe de la Napoule et les isles Sainte Marguerite. C’est un site vraiment délicieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b30e30d7-99f5-3edb-8814-8eadd731cd4d",
                                        "entry_id": "b73fc695-8534-37ec-a3c7-9230dfa8d389",
                                        "glosses": [
                                            "Féminin singulier de éclairci."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "éclaircie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfea4b0e-3cb8-36ac-8d04-1bcf6037d402",
                                        "entry_id": "6a4f5e82-6258-38cf-b134-032f370bc838",
                                        "glosses": [
                                            "Participe passé féminin singulier de éclaircir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc8b9dd-8801-4d50-a6ca-4f1a0385fe7a",
                                                "sense_id": "cfea4b0e-3cb8-36ac-8d04-1bcf6037d402",
                                                "text": "L’une d’entre elles a déjà été éclaircie, dans une certaine mesure, celle des relations des doctrines viollet-le-duciennes avec les écrits de Ludovic Vitet et de Daniel Ramée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
