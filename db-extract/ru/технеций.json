                                "target_senses": [
                                    {
                                        "sense_id": "b8df56e4-928f-3426-a3ba-b4b849e36b61",
                                        "entry_id": "4fcf5a90-523d-368c-9998-b2a723eae162",
                                        "glosses": [
                                            "elemento chimico artificiale facente parte del gruppo dei metalli del blocco d, avente numero atomico 43, peso atomico 98 e simbolo chimico Tc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8febad14-bb78-4ac1-9fa7-207781dfb2e9",
                                                "sense_id": "b8df56e4-928f-3426-a3ba-b4b849e36b61",
                                                "text": "l'atomo di tecnezio ha 43 protoni nel nucleo e 43 elettroni al di fuori di esso"
                                            },
                                            {
                                                "example_id": "b2f58755-7f9a-4442-8d44-2fe7599624ae",
                                                "sense_id": "b8df56e4-928f-3426-a3ba-b4b849e36b61",
                                                "text": "la prova sotto sforzo del cuore accoppiata alla scintigrafia al tecnezio è indolore"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bedb58e9-4b67-49ae-8faf-06f3104281af",
                        "source_entry_id": "33d01885-b453-34db-9090-e25413c1d443",
                        "source_sense_id": "c088e457-ee4e-3326-aeac-d86941b4358b",
                        "target_lang_word": "Technetium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Technetium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                        "entry_id": "5a1df0ea-672b-325b-9859-96e021c0a8a7",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 43, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fb50c0-f227-4bd8-aeb5-ad12a6c7b28c",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Technetium ist ein radioaktives Metall, das in der häufigen Pulverform mattgrau erscheint.“"
                                            },
                                            {
                                                "example_id": "94c3b13f-afa0-4feb-8ad5-576c5858cc2b",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Überalterte Kernreaktoren kommen nicht nach mit der Produktion von Technetium.“"
                                            },
                                            {
                                                "example_id": "ba4f1537-e0bd-4019-9d1c-adb33fd41433",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Segrè und Perrier kochten die Probe in Chemikalien aus und stießen dabei auf das Element 43, das sie später Technetium nannten, hergeleitet vom altgriechischen Wort technētós, ‚künstlich‘.“"
                                            },
                                            {
                                                "example_id": "5aa1d07b-37b5-428b-b2ab-c6d7fd0d4271",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Die Folge war ein Engpass bei der Versorgung mit Technetium für die Krebsdiagnostik - auch in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "890da700-de73-42f0-932b-4e7d24938d24",
                        "source_entry_id": "33d01885-b453-34db-9090-e25413c1d443",
                        "source_sense_id": "c088e457-ee4e-3326-aeac-d86941b4358b",
