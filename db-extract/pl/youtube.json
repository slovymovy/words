                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "YouTube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "507689d2-fde2-360c-8363-d6130b6b99cf",
                                        "entry_id": "20749b5f-f413-3826-82e4-069d5d86049e",
                                        "glosses": [
                                            "A video-sharing website."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3dd59e-cd2f-433f-8ede-8b779cfc2bc2",
                                                "sense_id": "507689d2-fde2-360c-8363-d6130b6b99cf",
                                                "text": "Anthony just subscribed to someone on YouTube a day ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aec117b-f758-378a-a98e-1554c2d049fa",
                                        "entry_id": "20749b5f-f413-3826-82e4-069d5d86049e",
                                        "glosses": [
                                            "Collectively, the users of YouTube; especially the content creator's viewers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2862a002-ae9e-4d63-b301-f0c53f7032e6",
                                                "sense_id": "6aec117b-f758-378a-a98e-1554c2d049fa",
                                                "text": "Hi, how's it going YouTube! Sorry I wasn't able to upload a video last week!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "YouTube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                                        "glosses": [
                                            "Any website that allows users to upload content, particularly YouTube itself."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714b4295-e222-4983-aa30-04ff95156cf5",
                                                "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                                                "text": "None of this is to suggest that academic libraries should turn their websites into a YouTube or Facebook in which our user communities would create all the content,[…]"
                                            },
                                            {
                                                "example_id": "8bfd886e-bd79-434a-b6f8-ddcae0276449",
                                                "sense_id": "815d41b7-0512-3af1-ae87-7b195c248d3c",
                                                "text": "There is all kinds of stuff that people post there- some of it is entertaining, some is actually useful as a template for studying or for business...it is sort of like a YouTube for documents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                                        "glosses": [
                                            "A small video that can be viewed online, particularly one hosted on YouTube."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15634f42-6159-44dc-b8b2-9fe3f1f6249d",
                                                "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                                                "text": "Then it's a YouTube of some kid trying to play \"Radar Love\" on a cheap guitar using only his feet,[…]"
                                            },
                                            {
                                                "example_id": "45de7424-dfe6-4f46-919f-c4a2ab93a72a",
                                                "sense_id": "350b506b-9568-36d4-8ed0-53c7ea7f2018",
                                                "text": "Not too long ago, there was a YouTube of you two brawling. How did the musical collaboration happen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4904b5-3fc6-3451-96b3-196d7b73a456",
                                        "entry_id": "7cf89745-8870-319d-beda-94a8f86efbe3",
                                        "glosses": [
                                            "A YouTube channel."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f334bf38-74ce-41cb-bb0c-493823513412",
                                                "sense_id": "7d4904b5-3fc6-3451-96b3-196d7b73a456",
                                                "text": "National Theatre at Home also unveiled titles for the remainder of its season, which continues to release streams every Thursday at 2 PM ET on its YouTube, with productions remaining on demand through noon ET the following Thursday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "YouTube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5df2e9ad-b222-398f-8b93-d7e78fabb60b",
                                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                                        "glosses": [
                                            "To upload a video of something to YouTube."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a843ad29-ec50-4dfe-93e3-3f98134864d3",
                                                "sense_id": "5df2e9ad-b222-398f-8b93-d7e78fabb60b",
                                                "text": "The revolution will not be televised. It will be YouTubed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                                        "glosses": [
                                            "To search for and view on YouTube."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67deeb9-d265-4ce5-840d-d020e973296a",
                                                "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                                                "text": "Inquiry elicited that he was a pop singer. I YouTubed him, revealing another ghastly microphone-gripping, anguished nasal wailer."
                                            },
                                            {
                                                "example_id": "a3c91372-f4da-4a0b-818e-154e71cba2e2",
                                                "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                                                "text": "If you don't know me, YouTube me, because soon the whole world is going to know me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a39aca-3280-3e3e-9f2e-b6185cc8d49e",
                                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                                        "glosses": [
                                            "To upload or watch videos on YouTube."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d88835-ecf2-4b7d-8fd5-a09ea4a68495",
                                                "sense_id": "83a39aca-3280-3e3e-9f2e-b6185cc8d49e",
                                                "text": "He had discussed joining Atlanta United in MLS and following his retirement, there was an outside chance that Hugo Lloris’ current injury at Tottenham Hotspur would create an opening there. Other offers came and went, but it was YouTubing and podcasting that filled [Ben] Foster’s time, not football, albeit with the door to a comeback left slightly ajar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
