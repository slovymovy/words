                "senses": [
                    {
                        "sense_id": "a301ccdb-ea82-3ff5-8882-8e83a70324dc",
                        "entry_id": "21677ebd-491c-3336-9a3e-a17e8782f83f",
                        "glosses": [
                            "ein von Wasser, von Gewässern, wie Flüssen, Sümpfen und Seen, geprägtes Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13a2999-711e-4359-b3ed-9a814ef66efc",
                                "sense_id": "a301ccdb-ea82-3ff5-8882-8e83a70324dc",
                                "text": "„Ist Achaja das Wasserland, so ist begreiflich, warum Penelope obigen Grund zu dem Gewebe angibt.“"
                            },
                            {
                                "example_id": "7f90a2ef-63f3-4803-a848-3c6e86cf423a",
                                "sense_id": "a301ccdb-ea82-3ff5-8882-8e83a70324dc",
                                "text": "„Und das Glück wendete sich ab, von den Menschen am Wasserland und ihr Felsen erstrahlte nicht mehr in der unbeschwerten Helle, die sie kannten.“"
                            },
                            {
                                "example_id": "e85fe247-4685-4aeb-9be5-6e7ca72dba4a",
                                "sense_id": "a301ccdb-ea82-3ff5-8882-8e83a70324dc",
                                "text": "Das Saarland kann man nicht gerade als Wasserland bezeichnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
