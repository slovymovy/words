                                        "entry_id": "d8e3af5e-4496-3f12-985e-fa0ef029c0f7",
                                        "glosses": [
                                            "To plan, control and record the position and course of a vehicle, ship, aircraft, etc., on a journey; to follow a planned course."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8b4df4-4c4d-4efb-a4c0-f618e432cf32",
                                                "sense_id": "7abe060e-5956-3590-a1b3-4b6d44511995",
                                                "text": "He navigated the bomber to the Ruhr."
                                            },
                                            {
                                                "example_id": "6c34bd2b-d677-45ef-929e-becc22aa7cdd",
                                                "sense_id": "7abe060e-5956-3590-a1b3-4b6d44511995",
                                                "text": "Earlier this month, the National Highway Traffic Safety Administration began an investigation into four crashes of Teslas operating with a partial-automation system (which can navigate highways and steer the car on city streets but requires a licensed driver to be present), including one in which a pedestrian was killed. In a news release, NHTSA said reduced visibility may have led to the crashes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e228c9-5934-3a1d-b468-90ddb629f9bb",
                                        "entry_id": "d8e3af5e-4496-3f12-985e-fa0ef029c0f7",
                                        "glosses": [
                                            "To give directions, as from a map, to someone driving a vehicle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f1df14a-8e5e-4e68-bbd7-384448130cdb",
                                                "sense_id": "08e228c9-5934-3a1d-b468-90ddb629f9bb",
                                                "text": "You drive. I'll navigate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae1a4927-f129-30ed-ab84-6d900a539fe0",
                                        "entry_id": "d8e3af5e-4496-3f12-985e-fa0ef029c0f7",
                                        "glosses": [
                                            "To travel over water in a ship; to sail."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b4ddb4-6eb0-4a3a-baab-a52c921008e7",
                                                "sense_id": "ae1a4927-f129-30ed-ab84-6d900a539fe0",
                                                "text": "We navigated to France in the dinghy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a6c81e-9f4a-343b-9037-8661203f8bfe",
                                        "entry_id": "d8e3af5e-4496-3f12-985e-fa0ef029c0f7",
                                        "glosses": [
                                            "To move between web pages, menus, etc. by means of hyperlinks, mouse clicks, or any other mechanism."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77feb594-eab4-4b46-9bf6-1d4300607eb3",
                                                "sense_id": "17a6c81e-9f4a-343b-9037-8661203f8bfe",
                                                "text": "It was difficult to navigate back to the home page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2295c8ec-ac9c-3023-900d-0df0ed71fb7a",
                                        "entry_id": "d8e3af5e-4496-3f12-985e-fa0ef029c0f7",
                                        "glosses": [
                                            "To find a way through a difficult situation or process."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cafc988-4164-473b-865c-48b9a579800e",
                                                "sense_id": "2295c8ec-ac9c-3023-900d-0df0ed71fb7a",
                                                "text": "However, given current sensibilities about individual privacy and data protection, the recording of oral data is becoming increasingly onerous for researchers who are obliged to navigate an often time-consuming and complex series of administrative requirements and corollary review processes in order to be granted ethics clearance."
                                            },
                                            {
                                                "example_id": "16c660b5-25c8-4356-94f6-1f477b1dd04d",
                                                "sense_id": "2295c8ec-ac9c-3023-900d-0df0ed71fb7a",
                                                "text": "Complaints have risen in particular from passengers changing trains, who have observed little or no improvement in their ability to navigate between the station's 13 platforms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
