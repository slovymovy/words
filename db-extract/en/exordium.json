                        "form": "exordiums"
                    },
                    {
                        "form_id": "1265e061-cd45-4190-889a-a2f7c371d9ad",
                        "entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "exordia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b816a69-1381-31dd-b39a-1ce30ebf1cf6",
                        "entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                        "glosses": [
                            "A beginning."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84007e89-dc70-38d4-afdc-098ac8c0eb49",
                        "entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                        "glosses": [
                            "The introduction to an essay or discourse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ed6264-802b-4e0f-94a4-d56c43e0486f",
                                "sense_id": "84007e89-dc70-38d4-afdc-098ac8c0eb49",
                                "text": "Cicero thinks, in discourses of philosophy, the exordium to be the hardest part: if it be so, I wisely lay hold on the conclusion."
                            },
                            {
                                "example_id": "fc9451fa-eed7-41c9-aa16-633102c35392",
                                "sense_id": "84007e89-dc70-38d4-afdc-098ac8c0eb49",
                                "text": "The depreciation of her produce was next insisted upon; and I found this exordium led to the information that Messrs. Standish and Co. had been enabled, from the depressed state of the market, to lay in a large stock of Irish linen at unheard-of low prices."
                            },
                            {
                                "example_id": "0fb7197c-1917-44d1-ab19-dad46211bc9b",
                                "sense_id": "84007e89-dc70-38d4-afdc-098ac8c0eb49",
                                "text": "This is a feeble article of faith to begin with, but it helps to push my pen through this exordium and what now follows."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50b3164-d540-48a2-9d58-adae18d8ac59",
                        "source_entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                        "source_sense_description": "beginning",
                        "target_lang_word": "нача́ло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нача́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4348d178-249a-31a2-99da-39804572bae0",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "первый, ранний момент или период существования чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78279f56-8eae-45bb-9ae8-487457a6e2a5",
                                                "sense_id": "4348d178-249a-31a2-99da-39804572bae0",
                                                "text": "В начале июля, в чрезвычайно жаркое время, под вечер, один молодой человек вышел из своей каморки, которую нанимал от жильцов в С — м переулке, на улицу и медленно, как бы в нерешимости, отправился к К — ну мосту."
                                            },
                                            {
                                                "example_id": "fcd93f14-2734-4bc5-81c9-013c7d7cbb1c",
                                                "sense_id": "4348d178-249a-31a2-99da-39804572bae0",
                                                "text": "Начало работы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1014dd77-bb83-3c52-bdae-b954f373eb7b",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "первая, исходная точка чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "999144b0-5262-4b83-bd5a-e95a5da4f282",
                                                "sense_id": "1014dd77-bb83-3c52-bdae-b954f373eb7b",
                                                "text": "Началом отсчёта времени по нашему современному календарю считается год Рождества Христова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24038da2-eec5-3b4c-ba0c-8cf02ff9fda8",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "мн. ч. основа, важнейшая суть чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845f5c3f-9c95-4d7a-b2a4-3c99c1417836",
                                                "sense_id": "24038da2-eec5-3b4c-ba0c-8cf02ff9fda8",
                                                "text": "Начала геометрии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59fc5fb-b2c5-3cfb-903f-d037dcf64fbf",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "шахм. первые ходы шахматной партии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0719a200-d554-46d7-b207-299dff155ded",
                                                "sense_id": "e59fc5fb-b2c5-3cfb-903f-d037dcf64fbf",
                                                "text": "Открытое начало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9f4bb1-d242-344f-b428-ddf2840ec70f",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "устар. руководство, главенство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64320e36-5d8a-40a2-ae47-a72b0cbf2414",
                                                "sense_id": "0e9f4bb1-d242-344f-b428-ddf2840ec70f",
                                                "text": "Из числа войск, находившихся под его началом, только отряд Дембинского смог прорваться из Литвы к Варшаве."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ca4223-6719-3030-97fd-16cfb5d0aa3d",
                                        "entry_id": "556f3d25-8b31-39a0-85de-8729fdc3cb02",
                                        "glosses": [
                                            "мн. ч. религ. название одного из чинов в иерархии ангелов"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "нача́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9521fd0e-14df-3c81-933f-8c9a3bb7639a",
                                        "entry_id": "d2c0b22e-a272-35f4-ae2f-3a549e88ce3d",
                                        "glosses": [
                                            "форма прошедшего времени среднего рода единственного числа изъявительного наклонения глагола начать"
                                        ],
