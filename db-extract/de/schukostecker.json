                        "tags": [],
                        "examples": [
                            {
                                "example_id": "163b4053-3704-4a2a-b398-c42f04e3b7bf",
                                "sense_id": "95b6411d-4725-321c-9b8c-66ec2cb58984",
                                "text": "„Für Frankreich sollte man sich mit einem dreipoligen Adapter ausstatten, da die deutschen und die sogenannten Schukostecker nicht immer passen.“"
                            },
                            {
                                "example_id": "9082d35b-2e13-4359-bf1a-13deb9954c0d",
                                "sense_id": "95b6411d-4725-321c-9b8c-66ec2cb58984",
                                "text": "„Sollte ein deutscher Schukostecker mal nicht passen, findet man in größeren Supermärkten Adapter.“"
                            },
                            {
                                "example_id": "d0a0d1a7-f81c-484f-8f97-3ceab51fb7c4",
                                "sense_id": "95b6411d-4725-321c-9b8c-66ec2cb58984",
                                "text": "„Die deutschen Schukostecker passen oft in die griechischen Steckdosen, manchmal aber nur die flachen Eurostecker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
