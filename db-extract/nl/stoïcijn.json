        "nl-extract.jsonl": [
            {
                "entry_id": "aa7e97d2-d00b-3f4a-9808-e2f072b47f48",
                "word": "stoïcijn",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c4b1031d-63b7-41fd-b1af-cff6c77c3531",
                        "entry_id": "aa7e97d2-d00b-3f4a-9808-e2f072b47f48",
                        "tags": [
                            "plural"
                        ],
                        "form": "stoïcijnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                        "entry_id": "aa7e97d2-d00b-3f4a-9808-e2f072b47f48",
                        "glosses": [
                            "een onverstoorbaar en gelijkmoedig mens die leed onverstoorbaar draagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a11366-a8b2-4297-ba43-4a50ccf9abca",
                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                "text": "De stoïcijn naast de bank riep: laaaaar en liet van opwinding zijn lege mok op het parket kapotvallen. Hij rende naar de televisie om de herhaling beter te zien: 'Zie je dat? Die vent neemt het leer in één keer op zijn slof!'"
                            },
                            {
                                "example_id": "9f9101a1-3ef3-4408-9236-57dea5dd494d",
                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                "text": "Onophoudelijk speelt hij rollen: die van de diplomaat, de aristocraat, de gentleman, de stoïcijn en zo verder. Hij is zich volkomen bewust van zijn onechtheid, want hij bestudeert zichzelf voortdurend, maar redeneert die weg: 'En wat ge u inbeeldt te zijn, dat zijt ge tenslotte.'"
                            },
                            {
                                "example_id": "b127db7c-bf7c-4c33-bb05-3c4b0eb1e60c",
                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                "text": "Hij zorgde ook dat hij angsthazen met angsthazen vergeleek, stoïcijnen met stoïcijnen en vrouwen met vrouwen."
                            },
                            {
                                "example_id": "10f95076-8cc2-486d-bac5-bf8f6c385648",
                                "sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                                "text": "Wie nu zijn nuchtere en soms gelaten beschouwingen over de menselijke emoties leest, herkent een man die van zichzelf verlangt dat hij de werkelijkheid onvervaard beziet, met alle besef van onmacht en verlies van dien, een zachte stoïcijn. Dus was hij tegen de mensen die hem na stonden zorgzaam, belangstellend, vaak heel grappig en haast altijd vol goede moed. Hij heeft de mensenwetenschap en de mensen veel nagelaten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1f79246-02ae-48a0-af23-397cd88c7ada",
                        "source_entry_id": "aa7e97d2-d00b-3f4a-9808-e2f072b47f48",
                        "source_sense_id": "8ab1a868-9c8e-38ca-9416-19b1fa39bb7b",
                        "source_sense_description": "kalm en rustig persoon",
                        "target_lang_word": "stoic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa812fd-920b-33cd-b1d5-511347bcbf2e",
                                        "entry_id": "c70da862-b38f-3aec-be17-23b067f40d75",
                                        "glosses": [
                                            "Proponent of stoicism, a school of thought, from in 300 B.C.E. up to about the time of Marcus Aurelius, who holds that by cultivating an understanding of the logos, or natural law, one can be free of suffering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df61ca6-657f-4511-a1d1-3d76e15c93bc",
                                                "sense_id": "daa812fd-920b-33cd-b1d5-511347bcbf2e",
                                                "text": "The anima mundi, to whose disposal of his own personal destiny the Stoic consents, is there to be respected and submitted to, but the Christian God is there to be loved; and the difference of emotional atmosphere is like that between an arctic climate and the tropics, though the outcome in the way of accepting actual conditions uncomplainingly may seem in abstract terms to be much the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6272d90f-f2b0-3d65-8e50-8fcf2fca1d42",
                                        "entry_id": "c70da862-b38f-3aec-be17-23b067f40d75",
                                        "glosses": [
                                            "A person indifferent to pleasure or pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e5b74b-f5a9-40df-b89d-ab6fcaacd195",
                                                "sense_id": "6272d90f-f2b0-3d65-8e50-8fcf2fca1d42",
                                                "text": "Even a Rolls-Royce owner, I began to feel, would be a stoic to travel across Europe by car when the \"Rheingold\" is on offer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88e5006c-b394-392b-b491-f23f1bd888a8",
                                        "entry_id": "086edcd8-8b2e-3581-abee-f6f8822050ba",
                                        "glosses": [
                                            "Of or relating to the Stoics or their ideas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1069590f-e8ab-319d-baa7-51c0dd3b02f8",
                                        "entry_id": "086edcd8-8b2e-3581-abee-f6f8822050ba",
                                        "glosses": [
                                            "Not affected by pain or distress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0cd819a-cb08-3ada-8e4b-20d107a711e9",
                                        "entry_id": "086edcd8-8b2e-3581-abee-f6f8822050ba",
                                        "glosses": [
                                            "Not displaying any external signs of being affected by pain or distress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92c896c-fc52-4ebe-a9f4-c09e2b846dd7",
                                                "sense_id": "f0cd819a-cb08-3ada-8e4b-20d107a711e9",
                                                "text": "It makes a tremendous emotional and practical difference to one whether one accept the universe in the drab discolored way of stoic resignation to necessity, or with the passionate happiness of Christian saints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
