                    "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                    "sense_definition": "In a rash, hasty, or incautious manner, without careful thought or consideration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>rashly</w> decided to quit his job before finding another one.",
                            "target_lang_translations": {
                                "ru": "Он <w>опрометчиво</w> решил уволиться с работы до того, как нашёл другую."
                            }
                        },
                        {
                            "text": "She promised <w>rashly</w> to help without realizing how much work it involved.",
                            "target_lang_translations": {
                                "ru": "Она <w>необдуманно</w> пообещала помочь, не осознавая, сколько работы это потребует."
                            }
                        }
                    ],
                    "antonyms": [
                        "cautiously",
                        "prudently"
                    ],
                    "common_phrases": [
                        "act rashly",
                        "decide rashly",
                        "speak rashly"
                    ],
                    "target_lang_definitions": {
