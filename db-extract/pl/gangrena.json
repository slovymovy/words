                                    },
                                    {
                                        "sense_id": "a0fb0e75-3233-300b-8343-7eaf86ce688c",
                                        "entry_id": "2322ce6c-9841-3cd6-a434-558976c60849",
                                        "glosses": [
                                            "Enfermedad que afecta a los árboles y produce la destrucción de la madera."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f7d250f-415e-368f-b2c6-b0e8ea2d1093",
                                        "entry_id": "2322ce6c-9841-3cd6-a434-558976c60849",
                                        "glosses": [
                                            "Que es perjudicial para la sociedad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac999b8-861a-478a-a9f2-c9d60c75b6f3",
                                                "sense_id": "3f7d250f-415e-368f-b2c6-b0e8ea2d1093",
                                                "text": "El materialismo parece haberse convertido en una gangrena de la sociedad actual."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aceba014-d1ef-449e-9b26-a38c74eaf23b",
                        "source_entry_id": "1ba927d3-575f-3564-b5fb-e40c4c8f2ea4",
                        "source_sense_id": "c1ebc284-da74-3802-a3c3-04547ddf4713",
