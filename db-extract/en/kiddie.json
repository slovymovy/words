                                "target_senses": [
                                    {
                                        "sense_id": "fac1dc6f-2573-3b6c-aaf0-af92783e8556",
                                        "entry_id": "d7804972-50e0-351d-a2e6-83a574b189fd",
                                        "glosses": [
                                            "menschliches Wesen, welches noch nicht aus dem Kindesalter herausgewachsen ist"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5224da36-9252-49c5-8d57-57a1dfcc97e0",
                                                "sense_id": "fac1dc6f-2573-3b6c-aaf0-af92783e8556",
                                                "text": "„Der Fernseher war schon kaputt, aber der Plattenspieler und das Radio funktionierten noch und so haben wir Kiddies abends immer Radio gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6833ef7-9348-4991-b0a6-7fa0eaa39b3e",
