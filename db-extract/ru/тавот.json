                                        "sense_id": "574dc429-8526-35fe-b25c-cc8f71c6dae9",
                                        "entry_id": "22973d9a-ee4f-3f3e-a052-fdeb690a61cb",
                                        "glosses": [
                                            "halbflüssiger Schmierstoff, der aus Schmieröl, einem Eindicker und verschiedenen Zusätzen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39eefaec-f25f-4b64-8738-f8bac1393e1c",
                                                "sense_id": "574dc429-8526-35fe-b25c-cc8f71c6dae9",
                                                "text": "„Shaw war außerdem schwindelig, wahrscheinlich von der Luft hier, die beißend nach Dieselöl roch, nach Schmierfett und großen Mengen Schimmel.“"
                                            },
                                            {
                                                "example_id": "cec9a36e-3797-4a1d-951a-d05853792d61",
                                                "sense_id": "574dc429-8526-35fe-b25c-cc8f71c6dae9",
                                                "text": "„Ein stark säuerlicher Duft ging von ihm aus, ein Geruch nach Holzasche, Schmierfett und Fisch.“"
                                            },
                                            {
                                                "example_id": "fdecd97f-1a23-4aef-8a3d-42e13083676e",
                                                "sense_id": "574dc429-8526-35fe-b25c-cc8f71c6dae9",
                                                "text": "„Lippenstift sehe wie rotes Schmierfett aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
