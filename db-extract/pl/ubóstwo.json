                                "sense_id": "d1b9d0da-b2b5-3c72-991e-2b7f4de57540",
                                "text": "Co mnie razi w jego wypowiedzi to ubóstwo słownictwa."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
