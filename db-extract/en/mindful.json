                                                "text": "giungemmo ad essere veramente consapevoli solo dopo"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ef5d25-ea8e-31a5-8894-a245ad891986",
                                        "entry_id": "454ec70d-bf3d-3c3d-83d2-d255e112fb63",
                                        "glosses": [
                                            "capire una propria grave colpa"
