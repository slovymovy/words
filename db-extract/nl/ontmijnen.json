        "nl-extract.jsonl": [
            {
                "entry_id": "622d9fe5-31e6-3152-b16a-559545152f1e",
                "word": "ontmijnen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6e0994e-7722-38be-9318-45b75fabed67",
                        "entry_id": "622d9fe5-31e6-3152-b16a-559545152f1e",
                        "glosses": [
                            "verwijderen van mijnen; ruimen van mijnen; vegen van mijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39a3b42-3a72-4a9f-868d-8af3929af0c5",
                                "sense_id": "f6e0994e-7722-38be-9318-45b75fabed67",
                                "text": "Inmiddels wordt een deel van de schietbanen ontmijnd door een commercieel bedrijf. „Maar ik heb gehoord dat sommige militairen ook zelf aan het opruimen zijn. We weten niets over de methoden die ze gebruiken, en waar ze precies aan het werk zijn.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff5583cb-a4f1-3cc5-8905-dc4d923ebee1",
                        "entry_id": "622d9fe5-31e6-3152-b16a-559545152f1e",
                        "glosses": [
                            "vermijden van een conflict"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba30993-e159-4b1d-a5eb-4f67fa3d4ab9",
                                "sense_id": "ff5583cb-a4f1-3cc5-8905-dc4d923ebee1",
                                "text": "‘De situatie is erg gevaarlijk, ook omdat er momenteel al Russische troepen in Syrië zijn', zei Vasilly Nebenzja, de Russische ambassadeur bij de Verenigde Naties. 'Indien we er niet in slagen de situatie te ontmijnen, kan dat zelfs leiden tot een oorlog tussen Rusland en de Verenigde Staten.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "4350d205-e7a9-356c-97a8-6860bd6cb8f5",
                        "entry_id": "622d9fe5-31e6-3152-b16a-559545152f1e",
                        "glosses": [
                            "vermijden van een probleem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831d8c54-48d3-4761-8b96-a1e9b5b9dc6b",
                                "sense_id": "4350d205-e7a9-356c-97a8-6860bd6cb8f5",
                                "text": "En dus probeerde Ethias die tikkende tijdbom op de balans de voorbije jaren geleidelijk aan te ontmijnen met meerdere terugkoopacties bij de klanten, liefst zeven in totaal. Daardoor was de First-tijdbom geslonken van meer dan 3 miljard naar uiteindelijk nog 200 miljoen euro."
                            }
                        ]
                    }
                ],
