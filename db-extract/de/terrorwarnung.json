                        "glosses": [
                            "Warnung vor einer (erwarteten) terroristischen Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300feb3e-7555-448e-bd19-b64b7fbc1cec",
                                "sense_id": "6a3e1bc6-ed5b-3367-857a-67d77513614a",
                                "text": "Die Bundesregierung sprach eine Terrorwarnung aus und empfahl der Bevölkerung, große Menschenmengen zu meiden."
                            },
                            {
                                "example_id": "b79e238c-a0ca-4392-bf64-1bde4958fc7b",
                                "sense_id": "6a3e1bc6-ed5b-3367-857a-67d77513614a",
                                "text": "Schon mehrfach richtete Al-Kaida Terrorwarnungen an Deutschland, die das Ziel hatten, die Bevölkerung zu verunsichern."
                            },
                            {
                                "example_id": "78054bfd-d161-4632-b3f5-0db4c6d92f78",
                                "sense_id": "6a3e1bc6-ed5b-3367-857a-67d77513614a",
                                "text": "Nach einer Terrorwarnung hat ein Massenaufgebot von Sicherheitskräften in den vergangenen Stunden die New Yorker U-Bahn durchsucht. („Aufregung in New York nach Terrorwarnung“, www.tagesanzeiger.ch, 07.10.2005)"
                            }
                        ],
