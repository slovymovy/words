                        ],
                        "examples": [
                            {
                                "example_id": "64199728-885f-4a79-a455-c77c1a171f1b",
                                "sense_id": "ab5388d6-2eaa-30eb-ac0f-38be77be614f",
                                "text": "Als het gehalte goed is, krijgt het voorwerp pneumatisch een keurteken; […]",
                                "translation": "If the content is correct, the object is pneumatically supplied with a hallmark; […]",
                                "english": "If the content is correct, the object is pneumatically supplied with a hallmark; […]"
                            },
                            {
                                "example_id": "de8dfbfa-9ab4-4af1-9084-bd9641fb00fd",
                                "sense_id": "ab5388d6-2eaa-30eb-ac0f-38be77be614f",
                                "text": "Ook deze landen kennen een wettelijk verplicht systeem van een onafhankelijke keuring vooraf en het laten aanbrengen van een keurteken.",
                                "translation": "These countries also have a legally required system of an independent prior inspection and applying a hallmark.",
                                "english": "These countries also have a legally required system of an independent prior inspection and applying a hallmark."
                            },
                            {
                                "example_id": "d690b605-1f4e-40b3-9830-c1d33f166795",
                                "sense_id": "ab5388d6-2eaa-30eb-ac0f-38be77be614f",
                                "text": "WaarborgHolland onderzoekt voorwerpen van platina, goud of zilver op het gehalte aan edelmetaal en voorziet ze van een keurteken.",
                                "translation": "WaarborgHolland examines objects made of platinum, gold, or silver for their precious metal content and provides them with a hallmark.",
                                "english": "WaarborgHolland examines objects made of platinum, gold, or silver for their precious metal content and provides them with a hallmark."
