                "senses": [
                    {
                        "sense_id": "4faeefc2-5e4c-328e-9819-74db53a4c08b",
                        "entry_id": "6287d883-46b8-3be8-8481-06fbe014580e",
                        "glosses": [
                            "mit Schotter befestigter Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c5ac2e-095b-4f3b-9c26-a32800c67c3a",
                                "sense_id": "4faeefc2-5e4c-328e-9819-74db53a4c08b",
                                "text": "„Fünfundvierzig Kilometer weiter die Straße entlang kamen wir zu einer Abzweigung und fuhren dann den Rest des Nachmittags über einen engen Schotterweg durch niedrigen gelben Busch, der Schotter ratterte in der trockenen Erde, wir rutschten und holperten langsam, die Fenster überzogen mit einer Schicht aus aufgewirbeltem Staub.“"
                            },
                            {
                                "example_id": "90a1c87c-4ea8-41c3-8165-ed466a33269b",
                                "sense_id": "4faeefc2-5e4c-328e-9819-74db53a4c08b",
                                "text": "„Sie bog nach rechts ab, fuhr an den weißen Fischfabriken vorbei und bog dann auf einen Schotterweg ein.“"
                            },
                            {
                                "example_id": "7d2dec13-1fb9-4834-8ade-7bbefe1be1c6",
                                "sense_id": "4faeefc2-5e4c-328e-9819-74db53a4c08b",
                                "text": "„Ich fahre an Einars und Lóas Hof vorbei und muss kurz dahinter abbremsen, um auf einen Schotterweg abzubiegen und dann einer nicht sehr ausgeprägten Fahrspur zu dem kleinen Wohnwagen zu folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
