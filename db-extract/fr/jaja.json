                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6df637-d1bc-48b9-89fa-228e29e3761d",
                                "sense_id": "8e60b1c0-0fb5-3d46-9213-1c8b17e0613a",
                                "text": "Jeanne Barraud, la Jaja de toujours, nous accueille au dernier étage."
                            },
                            {
                                "example_id": "2d7677fb-e602-4d41-82ab-8b867ae1716b",
                                "sense_id": "8e60b1c0-0fb5-3d46-9213-1c8b17e0613a",
                                "text": "Jaja s’arrêta avant le réverbère, dans une zone sombre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1dcbc6d-3216-35f3-939a-53824de995d7",
                        "entry_id": "8b3d23cb-606a-3be3-845a-c09136ad82f8",
                        "glosses": [
                            "Diminutif de Jacques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5274dab-9078-4782-8db7-1941b79e2a5c",
                                "sense_id": "c1dcbc6d-3216-35f3-939a-53824de995d7",
                                "text": "Non, je ne vous quitterai point, Jaja, et, si vous êtes sage, vous serez toujours mienne !…"
                            }
                        ]
                    }
