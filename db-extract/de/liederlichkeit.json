                "senses": [
                    {
                        "sense_id": "70729464-45f9-357a-b2b7-d8913a509950",
                        "entry_id": "33c2d9d3-c7d6-31cb-b0eb-a34baad3973a",
                        "glosses": [
                            "Mangel an Ordnung/Sorgfalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f105f686-3a68-4b92-ac91-dd8be8045d81",
                                "sense_id": "70729464-45f9-357a-b2b7-d8913a509950",
                                "text": "„Ohne seine Liederlichkeit wäre ich nie in seine literarischen Reihen geraten.“"
                            },
                            {
                                "example_id": "be50658b-a520-4ec0-b948-29dc910cd864",
                                "sense_id": "70729464-45f9-357a-b2b7-d8913a509950",
                                "text": "„Als er sah, daß seine Schwester mit dem Rücken zu ihm vor einen Spiegel getreten war und daß mir diese Liederlichkeit mißfiel, raffte er ihren Rock hoch, um mich bewundern zu lassen, was ich bei ihrem Sturz an der Brenda bereits gesehen und später auch gebraucht hatte.“"
                            },
                            {
                                "example_id": "7d15c50a-b516-4c11-a01e-076483914869",
                                "sense_id": "70729464-45f9-357a-b2b7-d8913a509950",
                                "text": "„Auf dem Weg in die gute Stube inspiziert Lampe die Zimmer und entdeckt Liederlichkeiten: einen schräg stehenden Stuhl, eine in der Vitrine umgefallene Tasse, eine unordentlich gearbeitete Spitzendecke auf einem Tisch, der dringend gefettet werden müßte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
