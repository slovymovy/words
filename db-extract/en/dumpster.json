                                                "sense_id": "20372869-2464-387c-a4fa-328ff6893f8e",
                                                "text": "Der Müllcontainer wird immer montags entleert."
                                            },
                                            {
                                                "example_id": "93fe1594-1bf8-4289-97f3-3e1a2edc4d96",
                                                "sense_id": "20372869-2464-387c-a4fa-328ff6893f8e",
                                                "text": "„Müllcontainer werden sehr häufig nach Art des Mülls angeboten, beispielsweise für Elektromüll, Sondermüll, reine Kunststoffmüll-Behälter und ähnliche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
