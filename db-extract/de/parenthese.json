                                        "entry_id": "4062a0a9-1498-386c-bf65-0cae755a7f1b",
                                        "glosses": [
                                            "parzysty znak graficzny w postaci łuków lub klamer zwróconych w przeciwne strony, który grupuje lub wyodrębnia tekst lub symbole i pełni pewną umowną rolę – piśmienniczą, matematyczną, programistyczną, w zapisie chemicznym itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9ec3ee-0e73-46d9-a9ab-ad4e77cfd15f",
                                                "sense_id": "1d65cc2b-c482-3d53-ba0e-77db73016575",
                                                "text": "Ten tekst w nawiasie trzeba poprawić, bo jest prawie niezrozumiały."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "0fd36383-cfe7-3f2f-abdb-a423c8e5ac2e",
                                        "entry_id": "4062a0a9-1498-386c-bf65-0cae755a7f1b",
                                        "glosses": [
                                            "każdy z dwóch łuków będących elementem nawiasu (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e2cf14-b24f-4cc7-9370-681d66916b58",
                                                "sense_id": "0fd36383-cfe7-3f2f-abdb-a423c8e5ac2e",
                                                "text": "Działania matematyczne w nawiasach wykonujemy zawsze w pierwszej kolejności."
