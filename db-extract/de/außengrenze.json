                        "source_sense_id": "cacbb837-7775-3bbc-9262-6aab4312c16b",
                        "source_sense_description": "Grenze einer politischen/territorialen Einheit gegenüber ihren direkten Nachbarn",
                        "target_lang_word": "frontière extérieure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontière extérieure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "538dadd9-0ae8-323c-9298-091d8cb5699c",
                                        "entry_id": "7c64d8d8-2c3b-3429-b6b9-00a9b33394be",
                                        "glosses": [
                                            "Frontière entre l’Union européenne (UE) et l’extérieur, constitué des pays tiers."
                                        ],
                                        "tags": [
                                            "European-Union"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c0637f-b161-427e-9527-7ca21ed58f6a",
                                                "sense_id": "538dadd9-0ae8-323c-9298-091d8cb5699c",
                                                "text": "Le chancelier autrichien Christian Stocker a évoqué des discussions « intenses » sur la protection des frontières extérieures et la Convention européenne des droits de l’Homme, dont l'interprétation par la Cour européenne des droits de l'Homme est jugée par certains comme trop favorable aux migrants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fa475b-0db6-36d7-a2af-844005f6dc40",
                                        "entry_id": "7c64d8d8-2c3b-3429-b6b9-00a9b33394be",
                                        "glosses": [
                                            "(restrictivement) Frontière entre l’espace Schengen et l’extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b00308-bf0f-4e1d-9d63-9b127661b2f2",
                                                "sense_id": "41fa475b-0db6-36d7-a2af-844005f6dc40",
                                                "text": "L’espace Schengen, zone unique sans contrôle aux frontières intérieures, requiert une politique commune de gestion des frontières extérieures. L’Union a par conséquent entrepris de définir des normes communes de contrôle à ses frontières extérieures et de mettre progressivement en place un système intégré de gestion de ces frontières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
