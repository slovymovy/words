                        "tags": [],
                        "examples": [
                            {
                                "example_id": "483dac63-4a3d-4a1f-9940-1a48952c87ad",
                                "sense_id": "bd2b31a2-b80f-3710-bc32-946934b0bd6f",
                                "text": "Na zachodzie Europy Katarzyna II uważana była za reformatorkę i monarchinię oświeconą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c8008c-f1c2-473a-ba43-f93300b61e1d",
