                ],
                "senses": [
                    {
                        "sense_id": "b52fe576-ff7c-3013-a839-4d04e8102531",
                        "entry_id": "70f8bf50-af2d-337c-a8fb-000be9f7e5cb",
                        "glosses": [
                            "Gelehrter des 18. Jahrhunderts, der an deutschen Universitäten Vorlesungen aus primär monetären Gründen und weniger aus dem Grunde, wissenschaftliche Kenntnisse zu verbreiten und zu fördern, hielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8863921d-c9b8-4a45-99be-6f5432c650be",
                                "sense_id": "b52fe576-ff7c-3013-a839-4d04e8102531",
                                "text": "„In seinem Vortrag unterscheidet Schiller zwei Typen des Historikers: den Brotgelehrten und den philosophischen Kopf.“"
                            },
                            {
                                "example_id": "a4742f1d-badb-484b-b110-5d29c4a270cf",
                                "sense_id": "b52fe576-ff7c-3013-a839-4d04e8102531",
                                "text": "„Mit sicherem Blick diagnostizierte Schiller in der erbärmlichen Gestalt des überall anzutreffenden Brotgelehrten ein Hauptübel der meisten Universitäten seiner Zeit […]: „Der Brotgelehrte verzäunet sich […]. Jede Erweiterung seiner Brotwissenschaft beunruhigt ihn, weil sie ihm neue Arbeit zusendet […]; nicht bei seinen Gedankenschätzen sucht er seinen Lohn, seinen Lohn erwartet er von fremder Anerkennung, von Ehrenstellen, von Versorgung.““"
                            },
                            {
                                "example_id": "cd87aee6-0704-4629-9e62-5c58a76b5678",
                                "sense_id": "b52fe576-ff7c-3013-a839-4d04e8102531",
                                "text": "„So sei alles, was den Brotgelehrten interessiere, seine »zusammengehäuften«, also unverbundenen »Gedächtnisschätze zur Schau zu tragen«, wobei er streng darauf achte, daß diese in »ihrem Werte nicht sinken«, weswegen jede »Neuerung« diesen »Haufen der Brotgelehrten« aufschrecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
