                "senses": [
                    {
                        "sense_id": "de53ce94-25bc-3078-ac1a-922faec10d85",
                        "entry_id": "91d9419f-28c5-3892-9008-f72228cc64e8",
                        "glosses": [
                            "Donner un caractère dévot à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49018bf3-7cc7-4881-a6dd-0142b26d5c9c",
                                "sense_id": "de53ce94-25bc-3078-ac1a-922faec10d85",
                                "text": "Le recrutement de cette dernière était très élitiste et visait à « dévotiser » l’élite du royaume."
                            },
                            {
                                "example_id": "03b54405-8352-4594-93ae-3dcb506a15a2",
                                "sense_id": "de53ce94-25bc-3078-ac1a-922faec10d85",
                                "text": "Puisque l’affaire s’est effectivement déplacée vers le CFCM, avez-vous constaté ce glissement d’un propos qui concerne les « Arabes » au monde dévotisé des « musulmans » ?"
                            },
                            {
                                "example_id": "45e91079-c14d-4144-9fc4-f0b6201bdbed",
                                "sense_id": "de53ce94-25bc-3078-ac1a-922faec10d85",
                                "text": "Ainsi un humain pourrait évoluer soit en esclave, soit en humain à demi dévotisé."
                            }
                        ]
                    }
