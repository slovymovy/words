                    "sense_definition": "Courage, bravery, or toughness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a lot of <w>balls</w> to stand up to the boss like that.",
                            "target_lang_translations": {
                                "ru": "Нужно было иметь стальные <w>яйца</w>, чтобы так противостоять боссу.",
                                "zh": "敢那样顶撞老板，真需要很大的<w>胆量</w>。"
                            }
                        },
                        {
                            "text": "He doesn't have the <w>balls</w> to tell her the truth.",
                            "target_lang_translations": {
                                "ru": "У него не хватает <w>смелости</w> сказать ей правду.",
                                "zh": "他没有那个<w>胆子</w>告诉她真相。"
                            }
