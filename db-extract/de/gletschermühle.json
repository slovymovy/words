                ],
                "senses": [
                    {
                        "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                        "entry_id": "d6e9a0b2-7f23-39e0-a9c4-4bbc74b8ff4c",
                        "glosses": [
                            "horizontaler Schacht, der sich durch strömendes Schmelzwasser in einem Gletscher gebildet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36ce086-f4c2-410e-91d4-f76369fca009",
                                "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                                "text": "„Die Gletschermühle ist, wie der Name schon sagt, ein Zeitzeuge der Eiszeit.“"
                            },
                            {
                                "example_id": "bc823d58-51de-4cbc-8d7b-1e9be31a6533",
                                "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                                "text": "„Zunächst strömt Schmelzwasser durch eine Gletschermühle – ein größeres Loch im Eis – zum Grund des Gletschers.“"
                            },
                            {
                                "example_id": "4f71304f-e589-4757-8569-c814efb07057",
                                "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                                "text": "„In der Nähe des Wasserfalls befindet sich auch die größte Gletschermühle des Schwarzwaldes.“"
                            },
                            {
                                "example_id": "8fbcc3b2-a37f-47a6-a03a-6320b8680c17",
                                "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                                "text": "„Doch es geht auch weniger kosmisch: In einer Gletschermühle am Knud-Rasmussen-Gletscher im Nordwesten Grönlands gibt das Eis Auskunft über die geologische und klimatische Vergangenheit der Erde.“"
                            },
                            {
                                "example_id": "9c86c923-952c-48b0-bbae-e8a7b87f66ce",
                                "sense_id": "d8c4e31a-3b7f-38f3-b67c-9852e379c53b",
                                "text": "„Deutliche Spuren der letzten Eiszeit, wie Gletschermühlen und Felsrillen, sieht man am Strand südlich von Fykan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
