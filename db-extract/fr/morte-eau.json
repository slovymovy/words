                                "target_senses": [
                                    {
                                        "sense_id": "bf804965-29ef-37fc-8511-126168f091d6",
                                        "entry_id": "a40e907c-76e7-3866-832a-929060b3ebdf",
                                        "glosses": [
                                            "The tongue or pole of a cart or other vehicle drawn by two animals."
                                        ],
                                        "tags": [],
