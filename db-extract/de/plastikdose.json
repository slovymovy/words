                        "examples": [
                            {
                                "example_id": "5bc60a0e-3f2e-40f4-8a85-c03aac818d94",
                                "sense_id": "e959279f-808f-30ed-9a2d-78f45b542252",
                                "text": "Anna-Maria hat sage und schreibe 26 Plastikdosen im Haushalt."
                            },
                            {
                                "example_id": "6c292e9b-1ac5-407a-9fd4-5e8132acf1e6",
                                "sense_id": "e959279f-808f-30ed-9a2d-78f45b542252",
                                "text": "„Es ging um eine kleine, halbrunde Plastikdose, die Azhar ihm kurz vor dem Abschied überreichte.“"
                            },
                            {
                                "example_id": "30a3a455-7f8b-4e47-895b-4e75c9262a49",
                                "sense_id": "e959279f-808f-30ed-9a2d-78f45b542252",
                                "text": "„Der Mann räuspert sich, spuckt aus, greift in die Gesäßtasche und fischt eine flache Plastikdose heraus.“"
                            }
                        ],
