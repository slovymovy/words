                "senses": [
                    {
                        "sense_id": "954534c3-8f2b-310c-b790-d220da885735",
                        "entry_id": "aebcc677-7f14-349b-abc7-009c19429b86",
                        "glosses": [
                            "Jeune fille qui a les cheveux blonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4156b1f5-dd48-46f6-848d-2c83a2c09cec",
                                "sense_id": "954534c3-8f2b-310c-b790-d220da885735",
                                "text": "En notre forêt de Nyons, il y avait un bonhomme, bûcheron de son état, … qui vivait pauvrement du produit de ses fagots, avec sa femme qui s’appelait Brisquette et ses deux enfants : un garçon de sept ans qui était brun et s’appelait Biscotin et une blondine de six ans qui s’appelait Biscotine."
                            },
                            {
                                "example_id": "84a8c68b-bc5a-423b-bc2b-10f6067b543e",
                                "sense_id": "954534c3-8f2b-310c-b790-d220da885735",
                                "text": "La petite Jeanne était une blondine anémique, à figure mince, délicate, et dont la misère avait singulièrement avivé l’inelligence et la sensibilité."
                            },
                            {
                                "example_id": "563c1030-d2ba-4bc1-a35e-a606ee4b1ebc",
                                "sense_id": "954534c3-8f2b-310c-b790-d220da885735",
                                "text": "Je me souviens vaguement des traits de la gamine, une blondine coiffée d’un chapeau de paille orné de cerises artificielles, avec une robe en lingerie blanche, percée de trou-trous ourlés."
                            }
                        ]
                    }
                ],
