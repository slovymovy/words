    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f56e0a8-33fe-3a44-9d5a-bc87f7cd2728",
                    "sense_definition": "Qui pend et suit librement les mouvements du corps, en parlant des membres ou des vêtements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oscillation_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il marchait lentement sur le trottoir, les bras <w>ballants</w> et la tête baissée."
                        },
                        {
                            "text": "L'enfant était assis sur le muret, les jambes <w>ballantes</w> au-dessus du ruisseau."
                        }
                    ],
                    "synonyms": [
                        "pendant"
                    ],
                    "common_phrases": [
                        "bras ballants",
                        "jambes ballantes"
                    ]
                },
                {
                    "sense_id": "a93f89c3-3aff-3f8f-b68c-2b23c3c8b86c",
                    "sense_definition": "Qui oscille librement ou qui n'est pas fermement fixé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oscillation_objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La corde <w>ballante</w> frappait contre la façade à chaque rafale de vent."
                        },
                        {
                            "text": "Un panneau <w>ballant</w> menaçait de tomber sur les passants après la tempête."
                        }
                    ],
                    "synonyms": [
                        "oscillant"
                    ],
                    "antonyms": [
                        "fixe"
                    ]
                },
                {
                    "sense_id": "605269d1-7605-371f-a2ae-ec7b2b745611",
                    "sense_definition": "Qualifie un câble, une amarre ou un cordage qui n'est pas tendu.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tension_cable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marin a resserré le cordage <w>ballant</w> avant la manœuvre d'amarrage."
                        },
                        {
                            "text": "Un câble électrique <w>ballant</w> traversait la cour à faible hauteur."
                        }
                    ],
                    "synonyms": [
                        "détendu",
                        "lâche",
                        "mou"
                    ],
                    "antonyms": [
                        "tendu"
