                                        "examples": [
                                            {
                                                "example_id": "ec2b3023-44a3-460c-86d0-d3158eabc611",
                                                "sense_id": "ddd9e67a-e262-3203-9f05-a6a06671696d",
                                                "text": "„Die historische Altstadt von Florenz spiegelt die überragenden Leistungen der Stadt auf dem Gebiet der Architektur wider.“"
                                            },
                                            {
                                                "example_id": "9620746a-efcc-43c1-9ce6-1ef044afebcf",
                                                "sense_id": "ddd9e67a-e262-3203-9f05-a6a06671696d",
                                                "text": "Das Florenz der Medici bietet sich für Historienromane an."
                                            },
                                            {
                                                "example_id": "e095ec9a-d78f-4f16-bb78-885569120163",
                                                "sense_id": "ddd9e67a-e262-3203-9f05-a6a06671696d",
                                                "text": "„Da ich nichts Besseres vorhatte, nahm ich sein Angebot an und fuhr direkt nach Siena, ohne Florenz überhaupt zu berühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
