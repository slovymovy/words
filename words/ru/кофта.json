                                "target_lang_sense_clarification": "A short outer garment."
                            },
                            {
                                "target_lang_word": "coat",
                                "target_lang_sense_clarification": "An outer garment worn outdoors."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8a75877-d952-3218-8628-69b363c930be",
                    "sense_definition": "Старинная домашняя женская одежда, надевавшаяся на ночь поверх рубашки.",
