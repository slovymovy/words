                "forms": [],
                "senses": [
                    {
                        "sense_id": "eddce802-affe-3dd5-b40f-7c0a47ce9f89",
                        "entry_id": "09f877a3-6c04-3497-b8c2-5ed823a0e485",
                        "glosses": [
                            "związany z przekształceniami afinicznymi, czyli wzajemnie jednoznacznymi przeształceniami geometrycznymi, odwzorowującymi proste na proste"
                        ],
                        "tags": [],
