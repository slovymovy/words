                                    {
                                        "sense_id": "103b3894-7105-3853-834e-351f41e23d82",
                                        "entry_id": "9b1f4a19-be2a-31c7-89c8-39f4afc0e4fc",
                                        "glosses": [
                                            "Fass zum Einsalzen von Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e0717e-de6c-4094-817e-482c9c38af46",
                                                "sense_id": "103b3894-7105-3853-834e-351f41e23d82",
                                                "text": "Bereits die Römer nutzten die konservierende Wirkung des Salzes und machten Speck in Salzfässern haltbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bb9f94b-91e0-34a2-9126-d4c59488b17b",
                                        "entry_id": "9b1f4a19-be2a-31c7-89c8-39f4afc0e4fc",
                                        "glosses": [
                                            "kleiner, offener Behälter für Salz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d5c89d-8a9a-4583-99b1-ad5fc42aee9c",
                                                "sense_id": "9bb9f94b-91e0-34a2-9126-d4c59488b17b",
                                                "text": "„[Der Mann sagt:] »Die Suppe ist wieder nicht genug gesalzen […]«. Die Frau erwidert: »Draussen in der Küche ist das Salzfass. Ein ander Mal koch' dir selber, oder sieh, wer dir kocht.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8afd8188-7a0d-3886-8418-b17e56021b2f",
                                        "entry_id": "9b1f4a19-be2a-31c7-89c8-39f4afc0e4fc",
                                        "glosses": [
                                            "markante Stelle am (menschlichen) Hals hinter den Schlüsselbeinen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b50fc54-4989-40f1-884f-bd94dd5bde6f",
                                                "sense_id": "8afd8188-7a0d-3886-8418-b17e56021b2f",
                                                "text": "Besonders wenn sie den Kopf hob, um zu lachen, waren die tiefen Salzfässer über ihren Schlüsselbeinen gut zu erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
