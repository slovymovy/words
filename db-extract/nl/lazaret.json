                    {
                        "translation_id": "a97012a7-0898-4290-8a3b-0995c28c0003",
                        "source_entry_id": "11ec447d-3a63-383c-8f1e-d0aa6ad2fe40",
                        "source_sense_id": "3d8fe5c5-86db-376a-b936-5d63119178a2",
                        "source_sense_description": "een grote mobiele medische (militaire) installatie die tijdelijk de taken van een ziekenhuis kan overnemen",
                        "target_lang_word": "Lazarett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lazarett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                        "entry_id": "479b6027-3b85-31a3-bc89-8113790ea22f",
                                        "glosses": [
                                            "Krankenhaus für erkrankte und verwundete Soldaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a37154b9-4a06-48ed-b890-7aa232e7b6fd",
                                                "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                                "text": "Verwundete Soldaten kommen zur Behandlung in ein Lazarett."
                                            },
                                            {
                                                "example_id": "98f759c5-1439-457e-823b-60860340b634",
                                                "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                                "text": "„Das Lazarett ist voll belegt worden aus unserm Zug, es sind viele schwere Fälle dabei.“"
                                            },
                                            {
                                                "example_id": "6f53732f-be1b-433f-8e46-7637df60165a",
                                                "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                                "text": "„…denn nach seiner Selbstverstümmelung erfuhren wir nur, daß er in einem Lazarett für Gefangene geheilt wurde, keiner von uns durfte ihn besuchen.“"
                                            },
                                            {
                                                "example_id": "aadbb35b-d7f3-4a57-9ec0-c43303c864f5",
                                                "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                                "text": "„Auf dem Weg zum Lazarett begegnet mir ein Soldat mit einem zweiten Mädchen, das man gleichfalls in dem Massenquartier aufgetrieben hat.“"
                                            },
                                            {
                                                "example_id": "519011ab-6c04-4405-88b2-78a3ff0b6631",
                                                "sense_id": "8976a39a-7158-3237-a3ca-1b3ecae7ad70",
                                                "text": "„Die Somme-Offensive war im Gang, die Lazarette in der Etappe wurden geleert, und Schlump rollte mit dem Lazarettzug in die Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
