{
    "word_family": [
        "yesterday",
        "yesterweek",
        "yesternight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6c1e58f-1280-387b-833b-5c7755524878",
                    "sense_definition": "Past years, or time gone by, often associated with nostalgia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "past_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic station still retains much of its charm and character of <w>yesteryear</w>.",
                            "target_lang_translations": {
                                "pl": "Zabytkowa stacja wciąż zachowuje wiele uroku i charakteru <w>dawnych lat</w>."
                            }
                        },
                        {
                            "text": "Many people look back at the fashion of <w>yesteryear</w> with great fondness.",
                            "target_lang_translations": {
                                "pl": "Wiele osób z wielkim sentymentem wspomina modę <w>minionych lat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foretime",
                        "yestertide",
                        "the past"
                    ],
                    "common_phrases": [
                        "character of yesteryear",
                        "snows of yesteryear"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or nostalgic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Minione lata lub czas, który przeminął, często kojarzony z nostalgią."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dawne czasy",
                                "target_lang_sense_clarification": "ogólne określenie przeszłości"
                            },
                            {
                                "target_lang_word": "minione lata",
                                "target_lang_sense_clarification": "podkreślenie upływu czasu"
                            },
                            {
                                "target_lang_word": "przeszłość",
                                "target_lang_sense_clarification": "literackie określenie tego, co było"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d4b28b-01d1-33bf-85e8-8953d6b71438",
                    "sense_definition": "The year immediately preceding the present one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "past_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harvest of <w>yesteryear</w> was far more bountiful than this year's crop.",
                            "target_lang_translations": {
                                "pl": "Zbiory z <w>ubiegłego roku</w> były znacznie obfitsze niż tegoroczne."
                            }
                        },
                        {
                            "text": "We must compare our current financial performance with the records of <w>yesteryear</w>.",
                            "target_lang_translations": {
                                "pl": "Musimy porównać nasze obecne wyniki finansowe z danymi z <w>zeszłego roku</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean literally last year"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rok bezpośrednio poprzedzający obecny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ubiegły rok",
                                "target_lang_sense_clarification": "standardowe określenie poprzedniego roku"
                            },
                            {
                                "target_lang_word": "zeszły rok",
                                "target_lang_sense_clarification": "potoczne określenie poprzedniego roku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "afa3d2c5-dc10-310b-88a7-111bae35e12e",
                    "sense_definition": "In past years; during time gone by.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What lives in this forest today provides a clue as to what lived here <w>yesteryear</w>.",
                            "target_lang_translations": {
                                "pl": "To, co żyje dziś w tym lesie, daje wskazówkę, co żyło tu <w>dawniej</w>."
                            }
                        },
                        {
                            "text": "The grand steam trains that thundered across the country <w>yesteryear</w> are now mostly gone.",
                            "target_lang_translations": {
                                "pl": "Wspaniałe pociągi parowe, które <w>niegdyś</w> dudniły w całym kraju, teraz w większości zniknęły."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W minionych latach; w czasach, które przeminęły."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dawniej",
                                "target_lang_sense_clarification": "w przeszłości"
                            },
                            {
                                "target_lang_word": "niegdyś",
                                "target_lang_sense_clarification": "literackie określenie przeszłości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}