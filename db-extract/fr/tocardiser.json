                "senses": [
                    {
                        "sense_id": "318d1d4a-b92d-37cb-8479-ca789e359dae",
                        "entry_id": "458180c7-4b48-3b1c-b700-c6c8a0ebcaf7",
                        "glosses": [
                            "Donner un caractère tocard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55b43f5b-8bc8-40a7-9c4f-953ee7f3a86b",
                                "sense_id": "318d1d4a-b92d-37cb-8479-ca789e359dae",
                                "text": "Le PSG est-il une machine à tocardiser les bons joueurs qu'il embauche, vouant les supporters à fantasmer en permanence sur de futures recrues sans comprendre que le mal est dans la place?"
                            },
                            {
                                "example_id": "0c8e2181-bfb7-486e-aea9-7f0b1ecfde37",
                                "sense_id": "318d1d4a-b92d-37cb-8479-ca789e359dae",
                                "text": "Navrant de la part de Garcia, qui préfère se tocardiser à rejoindre la franchouillardise plutôt que parler des vrais problèmes du foot francais."
                            }
                        ]
                    },
                    {
                        "sense_id": "164f6b47-e72f-3074-ba4a-bd2ad0b53ef6",
                        "entry_id": "458180c7-4b48-3b1c-b700-c6c8a0ebcaf7",
                        "glosses": [
                            "Se comporter ou parler comme un tocard."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "17c8aca3-08bf-4550-a6e1-947f7d5e990f",
                                "sense_id": "164f6b47-e72f-3074-ba4a-bd2ad0b53ef6",
                                "text": "Je ne vais pas trop tocardiser aujourd'hui, j'ai un boulot de tocard monstre."
                            }
                        ]
                    }
                ],
