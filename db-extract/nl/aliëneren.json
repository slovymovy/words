                "senses": [
                    {
                        "sense_id": "1248141c-6ad1-3038-86cf-12ef0b410f9d",
                        "entry_id": "b03930c4-7318-3fc1-8023-943b8d887df0",
                        "glosses": [
                            "vervreemden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e908d6-b76c-4f40-b5ff-3f02e1fd85af",
                                "sense_id": "1248141c-6ad1-3038-86cf-12ef0b410f9d",
                                "text": "Kan een emancipatiepartij de minderheden in ons land werkelijk meer doen participeren aan onze democratie? Of zal het hen aliëneren van de 'gewone' partijen? Het zijn noodzakelijke vragen, nu sp.a-banneling Ahmet Koç met gelijkgestemden aan een eigen partij bouwt voor de gemeenteraadsverkiezingen."
                            },
                            {
                                "example_id": "566683a1-311d-4d39-a244-82c3885a6833",
                                "sense_id": "1248141c-6ad1-3038-86cf-12ef0b410f9d",
                                "text": "Het feminisme staat vandaag voor een grote uitdaging: onrecht tegen vrouwen aanklagen, zonder de mannen te vergeten, of te aliëneren."
                            }
                        ]
                    }
