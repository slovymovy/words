                        "entry_id": "d568c5e8-c0ac-3ac3-9798-9b921f74bc4c",
                        "glosses": [
                            "Se dit d'un casque audio qui recouvre entièrement les oreilles."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "c00df208-104c-4825-a872-68d84f423096",
                                "sense_id": "4c2c8714-6ed1-3a69-862a-5e4f3b7efd56",
                                "text": "Dévoilé au salon de l’électronique IFA de Berlin 2023, le casque Aonic 50 Gen 2 de Shure est un modèle circum-aural haut de gamme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68285634-57fc-4e66-8d5d-7b120bbc5289",
                        "source_entry_id": "d568c5e8-c0ac-3ac3-9798-9b921f74bc4c",
                        "source_sense_id": "4c2c8714-6ed1-3a69-862a-5e4f3b7efd56",
