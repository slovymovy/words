                "senses": [
                    {
                        "sense_id": "060a15c1-c8f7-396f-9bad-78457a2de701",
                        "entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "glosses": [
                            "belediging of bespotting van God/een godheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6b2f35-5840-4902-b1ad-4bfb073bca2d",
                                "sense_id": "060a15c1-c8f7-396f-9bad-78457a2de701",
                                "text": "Hij werd aangeklaagd wegens godslastering."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e515c1e-512f-36b9-a219-032441cc3d48",
                        "entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "glosses": [
                            "vloek"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c932c4e-ec6f-3283-b1e0-6402a2e78a6e",
                        "entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "glosses": [
                            "zware zonde"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "91c47f41-0949-4ccd-9c8d-4d783c6b2803",
                                "sense_id": "3c932c4e-ec6f-3283-b1e0-6402a2e78a6e",
                                "text": "Het is niet geoorloofd geweld te gebruiken tegen je ouders, maar het is een godslastering om geweld te gebruiken tegen de gemeenschap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c122b481-232a-4bec-aebe-c5199ba97d44",
                        "source_entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "source_sense_id": "060a15c1-c8f7-396f-9bad-78457a2de701",
                        "source_sense_description": "belediging of bespotting van God/een godheid",
                        "target_lang_word": "Gotteslästerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gotteslästerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                        "entry_id": "89b10721-f102-3467-8f4a-68512d3d418e",
                                        "glosses": [
                                            "eine öffentliche, ärgerniserregende Beschimpfung Gottes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c718c3-a50a-4b03-9582-011f5b9daf2d",
                                                "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                                "text": "„Sie machen ein finster Gesicht, lieber Graf, das ist noch recht, daß es Ihnen wenigstens ernst ist; die meisten würden über meine Gotteslästerung lachen. […]“"
                                            },
                                            {
                                                "example_id": "0f7d58e7-a034-4468-8160-dfe64b7ab875",
                                                "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                                "text": "„Nachdem ich nach München zurückgekehrt war, veröffentlichte eine extremistische Gruppe in Ägypten, die sich die Verteidigung des Islam auf die Fahne schreibt, eine Stellungnahme im Internet, in der sie mir Apostasie und Gotteslästerung vorwarf.“"
                                            },
                                            {
                                                "example_id": "3abb7f98-6251-4a1e-8d7a-d972c10a699c",
                                                "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                                "text": "„Der Doktor sagte mir, ihre wirren Reden enthielten sogar Gotteslästerungen, und sie müsse daher besessen sein, denn es sei nicht anzunehmen, daß sie Pater Prospero einfach aus Verrücktheit so übel behandelt hätte.“"
                                            },
                                            {
                                                "example_id": "871f6e37-bd9c-46e3-8eff-b53d0cfc3974",
                                                "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                                "text": "„Das konnte für den Anfang gehn, und das Zentralkomitee zur Bekämpfung der Gotteslästerung konnte an dem Text nichts auszusetzen haben.“"
                                            },
                                            {
                                                "example_id": "b1406676-7ea5-4a40-a0d2-65f2f732c3cf",
                                                "sense_id": "e4c232fc-333e-3850-82e6-ecdc2a70c0d4",
                                                "text": "„Ihre Gotteslästerung schien ihn nicht mehr zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3be915a7-56eb-4437-b173-9a1154d2363c",
                        "source_entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "source_sense_id": "060a15c1-c8f7-396f-9bad-78457a2de701",
                        "source_sense_description": "belediging of bespotting van God/een godheid",
                        "target_lang_word": "Blasphemie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blasphemie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                        "entry_id": "d90cde60-88fc-304e-9fba-e1bee4e2dadb",
                                        "glosses": [
                                            "Gotteslästerung; die Schmähung von etwas Heiligem oder Göttlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1020c2b7-626e-47e6-a029-46721379d9bd",
                                                "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                                "text": "Er wurde der Blasphemie angeklagt."
                                            },
                                            {
                                                "example_id": "97ca5c76-0c95-494b-905b-9546c691a9d6",
                                                "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                                "text": "„Schmäh- und Drohbriefe werfen mir Blasphemie vor.“"
                                            },
                                            {
                                                "example_id": "0f0a4d62-6bfd-4ad4-906e-dd8e4a9abc93",
                                                "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                                "text": "„1905 wurde Julio Flóres wegen Blasphemie des Landes verwiesen.“"
                                            },
                                            {
                                                "example_id": "5c5ee7c7-02db-4c32-932a-ed4e779ae902",
                                                "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                                "text": "„Es ist noch gar nicht so lange her, da wäre man für solche Blasphemie leicht im Gefängnis gelandet.“"
                                            },
                                            {
                                                "example_id": "3d7bc5be-ae0b-450c-8986-3a05ab244635",
                                                "sense_id": "1409f4cd-785a-318e-8677-86d010ffd2a1",
                                                "text": "„Aus der Tatsache, daß schon den kleinsten Kindern Gebete, Bibeltexte und religiöse Glaubensinhalte eingebleut werden, ergeben sich gerade hier kindliche Fehlleistungen, die, mit Erwachsenenaugen betrachtet, natürlich den Charakter der atheistischen Blasphemie erreichen und somit zugleich auch zum Kapitel des konfessionellen Witzes gehören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d9e00a7-c3eb-3f8a-835f-89bdb0d56506",
                                        "entry_id": "d90cde60-88fc-304e-9fba-e1bee4e2dadb",
                                        "glosses": [
                                            "Kritik an einer allgemein anerkannten oder respektierten Person, Sache oder Idee"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e850a2cc-208e-4414-aff2-945366baf25d",
                                                "sense_id": "5d9e00a7-c3eb-3f8a-835f-89bdb0d56506",
                                                "text": "Kritik an Linux ist für manche Open-Source-Anhänger reine Blasphemie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22289fed-187b-4735-b7d9-70cb54d7850d",
                        "source_entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
                        "source_sense_id": "060a15c1-c8f7-396f-9bad-78457a2de701",
                        "source_sense_description": "belediging of bespotting van God/een godheid",
                        "target_lang_word": "blasphemy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blasphemy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                        "entry_id": "9f407d59-c936-3f4f-8f2e-a778cab4c9b4",
                                        "glosses": [
                                            "An act of irreverence or contempt toward a god or toward something considered sacred; an impious act, utterance, view, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc88a0f-a3c6-4adc-a0d7-d1e3e81dafc9",
                                                "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                                "text": "That imam said that drawing the prophet Muhammad was a form of blasphemy."
                                            },
                                            {
                                                "example_id": "480dd10b-afbb-4afe-9978-6fb7f8fbc24a",
                                                "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                                "text": "Had God cancelled His everlasting Covenant with Israel? The mere thought was blasphemy! But what did God's silence and the present dark cloud mean?"
                                            },
                                            {
                                                "example_id": "f37f80b2-ff88-4d90-bd2e-12eb021c7676",
                                                "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                                "text": "Look, I don't think it ought to be blasphemy, just saying \"Jehovah\"."
                                            },
                                            {
                                                "example_id": "3992338f-60eb-4be5-bf16-438675414abb",
                                                "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                                "text": "Shepard: What happened to those other Alliance officers? The ones who came before me?\nMajor Kyle: They wanted to take me away from here! They wanted me to abandon this place. Turn my back on my family. They spoke blasphemy!\nMajor Kyle: I did what I could to make their end quick and painless. I had no other choice. It was necessary to protect my children. Only I can keep them safe."
                                            },
                                            {
                                                "example_id": "6b08f19c-96b8-4faa-914b-4bc1a99633b1",
                                                "sense_id": "af400088-1cd2-37bd-a8c9-eb5edbb3615b",
                                                "text": "The fundamentalists in that religion hold that such views are blasphemy and that religion is above criticism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3ee0a8-1752-3ab1-ac9a-138b3cc7617c",
                                        "entry_id": "9f407d59-c936-3f4f-8f2e-a778cab4c9b4",
                                        "glosses": [
                                            "An act of irreverence towards anything considered inviolable; the act of disregarding a convention."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd25a97f-8d91-4378-b3e4-9d3dd0d18e52",
                                                "sense_id": "cc3ee0a8-1752-3ab1-ac9a-138b3cc7617c",
                                                "text": "Some historical information is given on the Panormo family of guitar makers and a whole chapter is called, \"Maccaferri's 'Monstrosity',\" the name given Julian's Maccaferri guitar due to the blasphemy of its having more than six strings, […]"
                                            },
                                            {
                                                "example_id": "4784bf77-eaa4-43c1-8a8e-2a7f5f342d70",
                                                "sense_id": "cc3ee0a8-1752-3ab1-ac9a-138b3cc7617c",
                                                "text": "The market has responded well to this type of packaging [wine in cardboard containers], even if some consider it near blasphemy, and it has had a role in bringing wine to the younger generation and to social classes intimidated by the high price of many bottled products."
                                            },
                                            {
                                                "example_id": "63c013f8-43fa-4c78-9f6e-c12c1037b437",
                                                "sense_id": "cc3ee0a8-1752-3ab1-ac9a-138b3cc7617c",
                                                "text": "I know this is utter blasphemy and completely incomprehensible to developers and power users who love their keyboard shortcuts, but some people just love having buttons on their screens with the exact name of their function written on them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e24820d8-d1a0-42ca-9da6-d2181b32dcb4",
                        "source_entry_id": "432bdec3-fc63-38bd-857c-89387812bc64",
