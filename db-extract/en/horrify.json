                                "target_senses": [
                                    {
                                        "sense_id": "81732e4f-cc13-319b-9aea-af175e9b4ad5",
                                        "entry_id": "02818102-ae46-367a-91a3-aabf464ba4b3",
                                        "glosses": [
                                            "jemanden aus der Fassung bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8dce5e0-93c9-4da2-a252-4b9a7f308d21",
                                                "sense_id": "81732e4f-cc13-319b-9aea-af175e9b4ad5",
                                                "text": "Du entsetzt mich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                        "entry_id": "02818102-ae46-367a-91a3-aabf464ba4b3",
                                        "glosses": [
                                            "(gehoben) aus der Fassung geraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69bd502-ccba-494a-8b4b-47c894253e3f",
                                                "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                                "text": "Wir entsetzten uns, als wir davon erfuhren."
                                            },
                                            {
                                                "example_id": "3aefb14a-42e8-4504-b99f-a2fb060362b0",
                                                "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                                "text": "„Aller Welt will ich kurz und sachlich eine Reihe von rein häuslichen Begebenheiten enthüllen, deren Wirkungen mich entsetzt – gemartert – vernichtet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "982f86c0-e849-35a9-9b93-76a967599c34",
                                        "entry_id": "02818102-ae46-367a-91a3-aabf464ba4b3",
                                        "glosses": [
                                            "eine von Feinden belagerte Festung oder einen eingeschlossenen Teil des Heeres befreien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb64cd3-08c3-46d3-a539-0eebd2a491b8",
                                                "sense_id": "982f86c0-e849-35a9-9b93-76a967599c34",
                                                "text": "„Edward durfte die Burg nicht entsetzen, denn das hätte Roberts Autorität untergraben, und die Engländer hätte die strategische Initiative wiedererlangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ec1514-e1f9-4844-9d21-7479eb45800a",
                        "source_entry_id": "878e8051-3e8f-389b-b9cc-3a25d4c9b1f5",
                        "source_sense_id": "d98f10fe-6419-3ee5-b73a-acd2ddabd82d",
                        "source_sense_description": "to cause to feel extreme apprehension or unease",
                        "target_lang_word": "erschrecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erschrecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "036b4e86-b396-3db2-8a30-2e3cb4e12a30",
                                        "entry_id": "6bf64bcf-0afc-36ab-be2d-6b8e698fc101",
                                        "glosses": [
                                            "jemandem einen Schrecken einflößen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61c787b-ad2c-4f8b-a650-cd812976893b",
                                                "sense_id": "036b4e86-b396-3db2-8a30-2e3cb4e12a30",
                                                "text": "Peter hat Simone mit seiner Fahrweise erschreckt."
                                            },
                                            {
                                                "example_id": "d03b320b-d618-4ec3-87b3-4d8d461fbdfd",
                                                "sense_id": "036b4e86-b396-3db2-8a30-2e3cb4e12a30",
                                                "text": "„Bevor er vom Examinator aufgerufen wurde, war er, mit dem Zylinder eines anderen Kandidaten auf dem Kopfe, durch die Korridore spaziert und hatte den Pedell erschreckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "erschrecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a71ea497-46fd-3f58-82bf-e664f73daf3c",
                                        "entry_id": "d4fe612b-856d-3b99-a5dc-14cc11a4546c",
                                        "glosses": [
                                            "von einem Schrecken ergriffen werden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde4083c-80bb-4103-b62d-fc3f11d4c335",
                                                "sense_id": "a71ea497-46fd-3f58-82bf-e664f73daf3c",
                                                "text": "Simone sieht Peters Fahrweise und erschrickt."
                                            },
                                            {
                                                "example_id": "bcc85728-bec6-4489-a226-92993ea2b7ff",
                                                "sense_id": "a71ea497-46fd-3f58-82bf-e664f73daf3c",
                                                "text": "Erschrick nicht, wenn du mich gleich siehst."
                                            },
                                            {
                                                "example_id": "93e1398d-fa49-468e-baa1-edc335db27ad",
                                                "sense_id": "a71ea497-46fd-3f58-82bf-e664f73daf3c",
                                                "text": "„Als die Räte das hörten, erschraken sie und sprachen: ‚Es ist verboten, daß der Vater seine Tochter heiratet. Daraus kann nichts Gutes entspringen, und das Reich wird mit ins Verderben gezogen.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "erschrecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3d1480-f530-3e9a-92b2-acbd7e7f2b39",
                                        "entry_id": "140aff03-d8f2-368b-9797-20552fabc2e9",
                                        "glosses": [
                                            "von einem Schrecken ergriffen werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2a3bef-53a4-4977-be01-6317c5490356",
                                                "sense_id": "ce3d1480-f530-3e9a-92b2-acbd7e7f2b39",
                                                "text": "Erschrick dich nicht, wenn du mich gleich siehst."
                                            },
                                            {
                                                "example_id": "b59fa621-7803-494b-af21-67ae66cbccec",
                                                "sense_id": "ce3d1480-f530-3e9a-92b2-acbd7e7f2b39",
                                                "text": "Erschrecke dich nicht, wenn du mich gleich siehst."
                                            },
                                            {
                                                "example_id": "b860c73c-304d-4ff0-9ac0-184b0984f4c5",
                                                "sense_id": "ce3d1480-f530-3e9a-92b2-acbd7e7f2b39",
                                                "text": "Ich habe mich trotz seiner Warnung fürchterlich erschrocken."
                                            },
                                            {
                                                "example_id": "7d38499c-23f4-4d2b-9bdf-932a0cb9207e",
                                                "sense_id": "ce3d1480-f530-3e9a-92b2-acbd7e7f2b39",
                                                "text": "Ich habe mich trotz seiner Warnung fürchterlich erschreckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
