                    {
                        "translation_id": "07cb7a8a-01d8-49b9-969d-6c6cf33243de",
                        "source_entry_id": "0a2546a2-2a25-388b-b81c-89c973b2ea66",
                        "source_sense_id": "753a029e-cc5d-3369-ba8d-177af7ccd6c8",
                        "source_sense_description": "pregnant (now used chiefly of egg-laying animals, or metaphorically)",
                        "target_lang_word": "gravide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46a4992b-839e-33db-8016-fc979386d92b",
                                        "entry_id": "cf1830f3-ba17-3049-8466-fd750ca568be",
                                        "glosses": [
                                            "Se dit d’une femelle prête à pondre, portant un sac d’œufs ou en gestation."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bf6e3f-6870-45fe-88ee-7a13943dee9c",
                                                "sense_id": "46a4992b-839e-33db-8016-fc979386d92b",
                                                "text": "La grande majorité des biches sont gravides chaque année. En outre, la gravidité des bichettes semblent en forte augmentation. Les causes de ce phénomène sont liées aux ressources alimentaires du milieu de vie : […]."
                                            },
                                            {
                                                "example_id": "8bc2730d-71dc-4e15-bada-28bb50680a8b",
                                                "sense_id": "46a4992b-839e-33db-8016-fc979386d92b",
                                                "text": "Aussi, selon le biologiste, “certaines des femelles gravides risquent d’avorter, et les autres mettront bas dans le milieu récepteur, ce qui augmentera les effectifs dans ces milieux”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cddfcdb3-eab7-3fc9-bbbe-56c5e14b49bc",
                                        "entry_id": "cf1830f3-ba17-3049-8466-fd750ca568be",
                                        "glosses": [
                                            "Qui contient un embryon ou un fœtus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ac32d2b-ad42-4d9c-9754-5f7bbac698f0",
                                                "sense_id": "cddfcdb3-eab7-3fc9-bbbe-56c5e14b49bc",
                                                "text": "La patronne me suivit, s’arrêta sur le seuil et dit à haute voix, cependant que son gros ventre gravide se gonflait vers moi : « Mais c’est la dernière nuit que vous couchez ici, tenez-vous-le pour dit. »"
                                            },
                                            {
                                                "example_id": "e8be9963-e439-4ad4-bb58-ed69ef73aa69",
                                                "sense_id": "cddfcdb3-eab7-3fc9-bbbe-56c5e14b49bc",
                                                "text": "Utérus gravide"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b42ca8ed-ff6f-35f4-85f2-f8b6ab890b9c",
                                        "entry_id": "cf1830f3-ba17-3049-8466-fd750ca568be",
                                        "glosses": [
                                            "Qui se rapporte à l’état de la femme enceinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13a651f-691e-4283-a1fe-aeab3dcb62b6",
                                                "sense_id": "b42ca8ed-ff6f-35f4-85f2-f8b6ab890b9c",
                                                "text": "Prurit gravide"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
