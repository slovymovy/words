                "senses": [
                    {
                        "sense_id": "9050d47f-6bd3-3c8c-a836-eec37bd82bf5",
                        "entry_id": "08c456ec-adaa-3cf7-9dc8-e2a72fa37af4",
                        "glosses": [
                            "Ne plus considérer quelque chose comme un tout, mais comme une collection d'éléments individuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb334691-1c13-49f5-be8a-a9bda481cad4",
                                "sense_id": "9050d47f-6bd3-3c8c-a836-eec37bd82bf5",
                                "text": "Cet historicisme ne s'arrête ni au passé ni au présent, il scrute tous les ensembles pour les détotaliser et en tirer les éléments d'un avenir faisable."
                            },
                            {
                                "example_id": "de8dd26b-f301-4b42-bd82-7cd3a1aa2528",
                                "sense_id": "9050d47f-6bd3-3c8c-a836-eec37bd82bf5",
                                "text": "Sa procédure essentielle consiste à détotaliser l'homme."
                            }
                        ]
                    }
