        "fr-extract.jsonl": [
            {
                "entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                "word": "agronome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a65e2c7-c7f5-4313-aced-399d98385d41",
                        "entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "agronomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                        "entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                        "glosses": [
                            "Scientifique formé aux sciences agricoles et agronomiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "739edc17-6d48-4bb6-a6ce-2e5d648a42a7",
                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                "text": "Il est, davantage qu'un agronome, un chimiste de l'alimentation."
                            },
                            {
                                "example_id": "73127356-fd2c-419b-9ea2-b1e02fd88222",
                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                "text": "Je dois dire que ces balbutiements de terrain d’agronome en herbe m'ont permis de concrétiser le contenu de nos conversations sur l'agriculture et la position de l’agronome, sur la nécessité d'une démarche d'observation rigoureuse […]."
                            },
                            {
                                "example_id": "e8af3a9d-e516-4b82-ade0-59f8c1ed2ed7",
                                "sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                                "text": "Le désaccord qui s'est manifesté entre les agriculteurs et les agronomes , quant aux résultats plus ou moins avantageux de l’écobuage sur les terres qu'on soumet à cette opération , provient uniquement de ce qu'on n'avait pas distingué les diverses natures des sols."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f1d4f64-91b8-42e8-9b7b-8ddd8576f754",
                        "source_entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                        "source_sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                        "target_lang_word": "Agronom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agronom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a6bc23-4e98-318a-aa10-24e1b3e5934e",
                                        "entry_id": "a6c94ea7-0dd9-37a2-9392-3e9611269d72",
                                        "glosses": [
                                            "Wissenschaftler, der im Bereich des Ackerbaus/der Landwirtschaft forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14f8f85-5571-43f8-8759-e73f2dbfea3a",
                                                "sense_id": "c0a6bc23-4e98-318a-aa10-24e1b3e5934e",
                                                "text": "„Unser großer Agronom ist höchst unzufrieden mit den Herbergen, in denen er abstieg, sowie mit der Kleidung und dem Benehmen der Bediensteten, die ihm Essen brachten, das er angewidert beschreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d204c0a-4554-4543-bed4-0c496d92de7e",
                        "source_entry_id": "97322a06-e430-33dc-936d-9d1646e7c206",
                        "source_sense_id": "d5124a71-5832-36d3-8f33-751dababd273",
                        "target_lang_word": "Agronomin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agronomin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87af132b-00ad-3541-81ab-681a51be5221",
                                        "entry_id": "aea07cca-917d-38d3-9c68-8bb2465edf6d",
                                        "glosses": [
                                            "Wissenschaftlerin, die im Bereich des Ackerbaus/der Landwirtschaft forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05debc66-84aa-461d-a6dc-9cc5b34a853d",
                                                "sense_id": "87af132b-00ad-3541-81ab-681a51be5221",
                                                "text": "„Das junge Mädchen ist eine Armenierin, Absolventin der Timirjasew-Akademie in Moskau, hier als Agronomin tätig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
