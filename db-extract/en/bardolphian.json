                        "glosses": [
                            "Of or relating to Bardolph, an alcoholic thief in four of Shakespeare's plays, especially in having the red nose of a habitual drunkard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37aef70-7f29-4f13-8c9a-418edf677b37",
                                "sense_id": "b1497789-6bf2-3af1-bee7-c6e47256419d",
                                "text": "You intend to paint it red — a true Bardolphian nose!"
                            },
                            {
                                "example_id": "b5b56519-ada1-4f37-bb73-6473552fed9d",
                                "sense_id": "b1497789-6bf2-3af1-bee7-c6e47256419d",
                                "text": "His cheeks were plump and sanguine; his eyes bright and cheerful; and the tip of his nose glowed with a Bardolphian fire, a flame, indeed, which Hugh was so far a vestal as to supply with its necessary fuel at all some seasons of the year."
