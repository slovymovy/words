                                "en": "My father <w>taught</w> me to cycle when I was little.",
                                "pl": "Mój ojciec <w>nauczył</w> mnie jeździć na rowerze, kiedy byłem mały.",
                                "de": "Mein Vater <w>brachte</w> mir das Fahrradfahren <w>bei</w>, als ich klein war.",
                                "fr": "Mon père m'a <w>appris</w> à faire du vélo quand j'étais petit.",
                                "it": "Mio padre mi <w>ha insegnato</w> ad andare in bicicletta quando ero piccolo.",
                                "cs": "Můj otec mě <w>naučil</w> jezdit na kole, když jsem byl malý.",
                                "tr": "Ben küçükken babam bana bisiklete binmeyi <w>öğretti</w>.",
                                "es": "Mi padre me <w>enseñó</w> a andar en bicicleta cuando era pequeño."
                            }
                        },
                        {
                            "text": "De leraar <w>leert</w> de leerlingen hoe ze moeten rekenen.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>учит</w> учеников считать.",
                                "en": "The teacher <w>teaches</w> the students how to do math.",
                                "pl": "Nauczyciel <w>uczy</w> uczniów, jak liczyć.",
                                "de": "Der Lehrer <w>lehrt</w> die Schüler, wie man rechnet.",
                                "fr": "L'enseignant <w>apprend</w> aux élèves comment calculer.",
                                "it": "L'insegnante <w>insegna</w> agli alunni come fare i calcoli.",
                                "cs": "Učitel <w>učí</w> žáky, jak mají počítat.",
                                "tr": "Öğretmen, öğrencilere nasıl hesap yapacaklarını <w>öğretiyor</w>.",
                                "es": "El maestro <w>enseña</w> a los alumnos cómo calcular."
                            }
