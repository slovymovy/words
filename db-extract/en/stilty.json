                        "entry_id": "30e29b77-f057-3512-9f68-bd7a8f76d130",
                        "glosses": [
                            "uneven, as if walking on stilts"
                        ],
                        "tags": [
                            "of a gait"
                        ],
                        "examples": [
                            {
                                "example_id": "1f74b41e-e9e0-4edd-bc09-ccd7e029d989",
                                "sense_id": "13781b80-26c9-37e4-87a6-f08408240ec4",
                                "text": "He has the animal trotted, and may notice at this stage that there is an inclination to go on the toes, that the lame limb or limbs are not put forward freely, and that progression is stilty and uncertain; it is such, in fact, as to at once suggest the possibility of corns being present."
                            },
                            {
                                "example_id": "de622fd9-d141-4710-9987-2d6b46a1abee",
                                "sense_id": "13781b80-26c9-37e4-87a6-f08408240ec4",
                                "text": "If he is lame in both feet the gait is stilty, the shoulders seem stiff, and, if made to work, he sweats profusely from intense pain."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddc4ba70-fc44-3000-a277-2c7a2a3c2440",
