                "senses": [
                    {
                        "sense_id": "3436a770-3706-3ccd-a3c3-98079a296172",
                        "entry_id": "819d0f7c-b860-3d7d-90a9-d4a9d6c4f6cb",
                        "glosses": [
                            "Person, die bei einem Paketdienst arbeitet und Paketsendungen an Kunden ausliefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953cfb52-f91d-42fd-8cf2-7e49af805c41",
                                "sense_id": "3436a770-3706-3ccd-a3c3-98079a296172",
                                "text": "„Ein falscher Paketbote hat eine 73-Jährige in ihrer Wohnung in Hamburg-Othmarschen mit einer Waffe bedroht und um 40 Euro beraubt.“"
                            },
                            {
                                "example_id": "c7ab4395-d63a-40be-bc75-1d448405dc5c",
                                "sense_id": "3436a770-3706-3ccd-a3c3-98079a296172",
                                "text": "„In Teilen Hessens sind am Freitag die Paketboten der Deutschen Post in einen Warnstreik getreten.“"
                            },
                            {
                                "example_id": "e01c53e7-1ab5-454b-8f46-6efb3c67a753",
                                "sense_id": "3436a770-3706-3ccd-a3c3-98079a296172",
                                "text": "„Das lang erwartete Probengefäß, das die Forscher Ewan Birney und Nick Goldman im vergangenen Jahr vom Paketboten in Empfang nahmen, war leer.“"
                            },
                            {
                                "example_id": "ad9275d4-8979-43e9-9929-a020256c25dc",
                                "sense_id": "3436a770-3706-3ccd-a3c3-98079a296172",
                                "text": "„Tagsüber waren sie Busfahrer, Lagerarbeiter, Gleisbauer, Paketboten oder Altenpfleger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
