                "senses": [
                    {
                        "sense_id": "faf307db-fbf3-3e84-b333-36514a79c567",
                        "entry_id": "1857ab6e-9118-3f39-9d84-801536cd0297",
                        "glosses": [
                            "Pfeife einer Orgel aus Metall, bei der ein hörbarer Ton dadurch erzeugt wird, dass ein in die Pfeife geblasener Luftstrom auf ein kleines abgeflachtes Metallstück, die Zunge, ‚Lingua‘, trifft und diese in Schwingungen versetzt, wodurch ein Klang entsteht, der dann von einem dazugehörigen Resonanzkörper, dem Becher, verstärkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10c33fc-cd3d-4a57-9753-5c2fcb78d444",
                                "sense_id": "faf307db-fbf3-3e84-b333-36514a79c567",
                                "text": "Die Lingualpfeife erzeugt einen wohlklingenden Ton."
                            },
                            {
                                "example_id": "0cbd4820-4d9a-47dd-b1d7-74927429ff24",
                                "sense_id": "faf307db-fbf3-3e84-b333-36514a79c567",
                                "text": "Die Orgel verfügt über 18 Lingualpfeifen."
                            },
                            {
                                "example_id": "d31a69c3-6d4d-49be-a874-94caf543bbeb",
                                "sense_id": "faf307db-fbf3-3e84-b333-36514a79c567",
                                "text": "„Die Lingualpfeife ist oft konisch gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
