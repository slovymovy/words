                ],
                "senses": [
                    {
                        "sense_id": "b4116581-6b24-3e6a-8b8e-0751fe4e8fae",
                        "entry_id": "2b5bb5b5-cfbe-363e-82e9-b6d326b041f9",
                        "glosses": [
                            "die Zahl der in einem bestimmten Zeitraum (in der Regel ein Kalenderjahr) lebend Geborenen je 1.000 der Bevölkerung"
                        ],
                        "tags": [
                            "Demografie"
                        ],
                        "examples": [
                            {
                                "example_id": "5c762e0d-2454-42b9-9e1a-9b2329844483",
                                "sense_id": "b4116581-6b24-3e6a-8b8e-0751fe4e8fae",
                                "text": "„Dieser Bevölkerungsanstieg muß ganz wesentlich mit einem Anstieg der Natalität in Verbindung gebracht werden, die im 16. Jahrhundert zwischen 35 und 45 pro 1000 Einwohner lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4b252e8a-19c1-3158-95a4-ce94f277fcde",
                        "entry_id": "2b5bb5b5-cfbe-363e-82e9-b6d326b041f9",
                        "glosses": [
                            "in der Lehre vom Menschen die Tatsache des Geborenwerdens und damit zusammenhängende Eigenschaften des Menschseins. Nach Hannah Arendt „der Neubeginn, der mit jeder Geburt in die Welt kommt“, und so das Handeln ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781c777e-c61e-4ac1-a0d4-81e55504cd78",
                                "sense_id": "4b252e8a-19c1-3158-95a4-ce94f277fcde",
                                "text": "„Dabei ist aber das Handeln an die Grundbedingung der Natalität enger gebunden als Arbeiten und Herstellen. Der Neubeginn, der mit jeder Geburt in die Welt kommt, kann sich in der Welt nur darum zur Geltung bringen, weil dem Neuankömmling die Fähigkeit zukommt, selbst einen Anfang zu machen, d.h. zu handeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
