                "senses": [
                    {
                        "sense_id": "302342e1-b1dc-3622-93c9-403dfcbbfd3d",
                        "entry_id": "35dcee22-bf81-35d5-bcff-5ebac5836622",
                        "glosses": [
                            "het leveren van een dienst of pakket van diensten door een persoon, instantie of onderneming aan een andere partij."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5dd3b0c-2f94-4215-96c0-9708769a6e56",
                                "sense_id": "302342e1-b1dc-3622-93c9-403dfcbbfd3d",
                                "text": "Dienstverlening banken amper verbeterd'."
                            },
                            {
                                "example_id": "0d2eef26-17ce-4337-b2a5-1c361b362c25",
                                "sense_id": "302342e1-b1dc-3622-93c9-403dfcbbfd3d",
                                "text": "Na landbouw en industrie is dienstverlening de tertiaire sector in de economie."
                            },
                            {
                                "example_id": "47106080-03e8-444a-9982-75cbc8fc468f",
                                "sense_id": "302342e1-b1dc-3622-93c9-403dfcbbfd3d",
                                "text": "De studenten van de opleiding maatschappelijk werk en dienstverlening werden opgeleid om de 'empowerment' van hun cliënten te bevorderen, om ze meer macht over hun eigen leven te geven, maar tegelijkertijd heeft het maatschappelijk werk de taak om mensen in te passen in de samenleving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6be218d4-924d-481d-aac0-2908239cf199",
                        "source_entry_id": "35dcee22-bf81-35d5-bcff-5ebac5836622",
                        "source_sense_id": "302342e1-b1dc-3622-93c9-403dfcbbfd3d",
                        "target_lang_word": "service",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "service",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "891caa7a-5b04-3686-b909-8c2bc4213b62",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
                                            "An act of being of assistance to someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5507b202-bd7d-4088-8415-8ea10a6b7f85",
                                                "sense_id": "891caa7a-5b04-3686-b909-8c2bc4213b62",
                                                "text": "I say I did him a service by ending our relationship – now he can freely pursue his career."
                                            },
                                            {
                                                "example_id": "220b34dc-fd71-419f-8b19-4f7a0b158c7d",
                                                "sense_id": "891caa7a-5b04-3686-b909-8c2bc4213b62",
                                                "text": "The Parliament for ever cries more money, / The service of the state demands more money. / Just heaven! of what service is the state?"
                                            },
                                            {
                                                "example_id": "7c9626f6-a65f-4150-a6d1-bd1b4dc89e5e",
                                                "sense_id": "891caa7a-5b04-3686-b909-8c2bc4213b62",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a72c8280-7c19-3af6-a595-a7e118cd92f9",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
                                            "The state of being subordinate to or employed by an individual or group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d00b434-320e-4d48-a917-3594db6bb1b0",
                                                "sense_id": "a72c8280-7c19-3af6-a595-a7e118cd92f9",
                                                "text": "Lancelot was at the service of King Arthur."
                                            },
                                            {
                                                "example_id": "3cd4a85e-7c94-4ffa-8728-2e3e0e04e3fc",
                                                "sense_id": "a72c8280-7c19-3af6-a595-a7e118cd92f9",
                                                "text": "The lesser griefs that may be said, / ⁠That breathe a thousand tender vows, / ⁠Are but as servants in a house / Where lies the master newly dead; / Who speak their feeling as it is, / ⁠And weep the fulness from the mind: / ⁠‘It will be hard’ they say ‘to find / Another service such as this.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10a2a213-988b-3947-8132-03e2a51b973c",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
                                            "Work as a member of the military."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da1f4989-993c-4706-a11a-d988034a224d",
                                                "sense_id": "10a2a213-988b-3947-8132-03e2a51b973c",
                                                "text": "Thank you for your service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c79236c-64cc-3b05-abc2-2175af7dda89",
                                        "entry_id": "1d32c8a4-8f4b-3d1e-a29e-c93722ce28c3",
                                        "glosses": [
                                            "The practice of providing assistance as economic activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6410a6-3a85-494f-8b49-8ce0d1280386",
                                                "sense_id": "6c79236c-64cc-3b05-abc2-2175af7dda89",
                                                "text": "Hair care is a service industry."
                                            },
                                            {
                                                "example_id": "fe6804c1-619b-493d-a037-357bbe83ef01",
                                                "sense_id": "6c79236c-64cc-3b05-abc2-2175af7dda89",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you \"stay up to date with what your friends are doing\",[...]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e431e4af-ba94-3177-8f2d-7251c4227d60",
