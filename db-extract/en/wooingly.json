                        "glosses": [
                            "In a wooing manner; enticingly; with persuasiveness or seduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01525b50-d89e-4f25-a5c7-464301b6130d",
                                "sense_id": "7ef7ceb4-9095-31b6-a8a0-e7ff4c2b61a9",
                                "text": "Smells wooingly here; no jutty, frieze,"
                            },
                            {
                                "example_id": "2ee7370d-6928-46d5-9ce0-0fed8c2547ad",
                                "sense_id": "7ef7ceb4-9095-31b6-a8a0-e7ff4c2b61a9",
                                "text": "\"Yes,\" I cried, startled at her candor, \"to win your love.\" Hope slowly rekindled within my breast, and then with half-closed eyes, and wooingly, she said:\n\"No drooping Clytie could be more constant than I to him who strikes the chord that is responsive in my soul.\""
                            },
                            {
                                "example_id": "06738941-afdb-4a34-a187-5e6343180aac",
                                "sense_id": "7ef7ceb4-9095-31b6-a8a0-e7ff4c2b61a9",
                                "text": "'Sing to me, Bernardino,' she whispered wooingly, 'sith the cloud is gone from our moon, and I am in the will to love.'"
                            }
                        ]
                    }
                ],
