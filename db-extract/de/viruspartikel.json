                ],
                "senses": [
                    {
                        "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                        "entry_id": "e73ba683-1095-3f02-9cc1-552f09c2a8cb",
                        "glosses": [
                            "einzelner Krankheitserreger vom Typ Virus, der sich außerhalb einer Wirtszelle befindet"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "349992ee-7beb-4be3-8093-263857137239",
                                "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                                "text": "„Die infektiösen Viruspartikel oder Virionen bestehen aus Proteinen und sind bei einigen Virustypen von einer Lipidmembran umgeben, die man oft als Hülle oder Envelope bezeichnet; die Partikel enthalten jeweils nur eine Art von Nucleinsäure, nämlich entweder DNA oder RNA.“"
                            },
                            {
                                "example_id": "94385df3-c715-4305-98e1-6a0d96140336",
                                "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                                "text": "„Zwischen 100 und 5.000 Viruspartikel reichen für eine Ansteckung mit dem Coronavirus aus. Lüften, Abstand halten und Mund-Nasen-Schutz tragen sind die besten Schutzmaßnahmen gegen eine Ansteckung.“"
                            },
                            {
                                "example_id": "d77b87bc-9f1b-441b-a70d-d34b7c0853e6",
                                "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                                "text": "Eine ins Krankenhaus eingewiesene, infizierte Person atmete um die 120.000 Viruspartikel in einem Liter Atemluft aus."
                            },
                            {
                                "example_id": "c894d9d0-148a-417a-a18e-218ffb3fa484",
                                "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                                "text": "„Auf Viruspartikeln basierende Impfstoffe sind deshalb interessant, weil das Immunsystem auf Viruspartikel im Rahmen der normalen Infektionsabwehr direkt anspringt.“"
                            },
                            {
                                "example_id": "f40c77ea-bdad-486a-8157-d96d1c7e97c7",
                                "sense_id": "653a28b9-d01f-3135-bd36-9507eca85b00",
                                "text": "„Es gibt viele verschiedene Ansätze zur Herstellung von Impfstoffen, die auf sogenannten Plattform-Technologien beruhen. Plattform-Technologien kann man mit einem Baukasten vergleichen, bei dem gleiche Grundstrukturen (Plattformen) verwendet werden und nur der Erreger-spezifische Teil (Antigen oder genetische Information des Antigens) ausgetauscht wird. Dies können gereinigte und inaktivierte Viruspartikel (inaktivierter Ganzvirus-Impfstoff) oder Teile davon sein. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
