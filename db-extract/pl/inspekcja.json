                    {
                        "sense_id": "7d69166b-de80-3c77-94e9-9923f0abdfa2",
                        "entry_id": "d652b402-2f22-3693-aa35-c3aef2f2e4cb",
                        "glosses": [
                            "kontrola działalności jakiejś instytucji lub stanu jakiegoś miejsca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2e03ea-c207-4788-a108-fb066ba36b85",
                                "sense_id": "7d69166b-de80-3c77-94e9-9923f0abdfa2",
                                "text": "Lokalne władze utrzymują, że karuzela przeszła inspekcje bezpieczeństwa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fd0ba6a3-9ab4-391c-900b-f066efc70997",
                        "entry_id": "d652b402-2f22-3693-aa35-c3aef2f2e4cb",
                        "glosses": [
                            "urząd nadzorujący i kontrolujący stan lub pracę czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1a51fb-60fe-4d39-9f91-988b3a553d1e",
                                "sense_id": "fd0ba6a3-9ab4-391c-900b-f066efc70997",
                                "text": "Główny Inspektor Pracy podkreśla, że w przypadku kontroli w zakładzie, w którym występują ogniska wirusa i ryzyko zarażenia jest wysokie, pracownik inspekcji pracy będzie dodatkowo wyposażony w pełny strój ochronny"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
