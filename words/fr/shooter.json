                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant n'a pas hésité et a <w>shooté</w> directement vers la cage adverse pour marquer."
                        },
                        {
                            "text": "Quand tu te trouves seul devant le gardien, tu dois <w>shooter</w> sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "botter",
                        "tirer"
                    ],
                    "common_phrases": [
