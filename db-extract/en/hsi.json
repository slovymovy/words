                                        "glosses": [
                                            "한 지역의 행정 단위. '도시'를 줄인 말로 쓰이기도 한다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e445e7a-3c9d-4834-9666-2bd974805005",
                                                "sense_id": "2ede0ec4-7a69-3f00-8472-92e89cf64ccf",
                                                "text": "시로 승격하다."
                                            },
                                            {
                                                "example_id": "9f37e2b2-085e-4f25-9497-b966faa5ab4e",
                                                "sense_id": "2ede0ec4-7a69-3f00-8472-92e89cf64ccf",
                                                "text": "한국의 지방 행정 구역에서 군은 시 밑의 단위이다."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
