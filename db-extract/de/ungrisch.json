                ],
                "senses": [
                    {
                        "sense_id": "7bd482c5-c6fe-3147-a785-14b41a6db245",
                        "entry_id": "c1f16414-e9f6-3a27-9cbf-198c07e777ec",
                        "glosses": [
                            "die Ungarn oder ihre Sprache oder das Land Ungarn betreffend"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "07bd54d2-2f89-4192-a9fe-47972538ac6e",
                                "sense_id": "7bd482c5-c6fe-3147-a785-14b41a6db245",
                                "text": "„Denn wider alles Erwarten war es bei der Schlumpe, einem ungrischen Weibe, ganz und gar nichts Rechtes mit ihm, und ganz und gar nicht war er bei ihr auf dem Posten, worüber sein Ärger unmäßig war und auch sein Schrecken.“"
                            },
                            {
                                "example_id": "f4ff3fd7-c9bb-4885-9dff-73a907398c1b",
                                "sense_id": "7bd482c5-c6fe-3147-a785-14b41a6db245",
                                "text": "„Ich bin eben als Fremde nicht österreichisch und nicht habsburgisch, und wenn es sich darum handelt, ungrisch zu sein oder ungrisch zu werden, so liegt nichts in mir, was mich daran hinderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
