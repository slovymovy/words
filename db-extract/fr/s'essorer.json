                "senses": [
                    {
                        "sense_id": "40efa7b4-7d01-3cfb-b23e-be4567c0e4b9",
                        "entry_id": "45fdbc12-628e-3134-9d84-1822de2b0c28",
                        "glosses": [
                            "Prendre son essor."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e992b517-19f0-4f0e-8722-c1534ff17776",
                                "sense_id": "40efa7b4-7d01-3cfb-b23e-be4567c0e4b9",
                                "text": "Le XIVᵉ siècle, en somme, se borne à continuer les édifices commencés pendant le siècle précédent. Il faut attendre la fin du XVᵉ, ce moment où la France respira, pour voir l’architecture s’essorer encore."
                            },
                            {
                                "example_id": "07b8a0e3-5671-4e5f-a44f-707e37a8975b",
                                "sense_id": "40efa7b4-7d01-3cfb-b23e-be4567c0e4b9",
                                "text": "La forme molle au loin monte des collines\nComme un amour encore mal défini,\nEt le brouillard qui s'essore des ravines\nSemble un effort vers quelque but réuni."
                            }
                        ]
                    }
