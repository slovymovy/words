                        "source_sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                        "source_sense_description": "bank of snow",
                        "target_lang_word": "сугро́б",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сугро́б",
