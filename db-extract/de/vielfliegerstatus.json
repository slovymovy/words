                "senses": [
                    {
                        "sense_id": "cd389643-d4bd-360e-820b-1057a0f8cb19",
                        "entry_id": "2cbf9034-2442-3899-baec-53978eef53c0",
                        "glosses": [
                            "mit besonderen Vorteilen versehene Stellung, die jemand innerhalb des Vielfliegerprogramms einer Fluggesellschaft erreichen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c165b78-f2e3-4346-ae05-bcd8709fd98b",
                                "sense_id": "cd389643-d4bd-360e-820b-1057a0f8cb19",
                                "text": "„Vom neuen System unberührt blieben der Vielfliegerstatus der Teilnehmer, damit verbundene Privilegien und die Vergabe von Statusmeilen, betonte Lufthansa.“"
                            },
                            {
                                "example_id": "adf2e08b-4bce-4f2b-a97d-27d9b7c1d4f9",
                                "sense_id": "cd389643-d4bd-360e-820b-1057a0f8cb19",
                                "text": "„Zudem gibt es keinen Vielfliegerstatus, sodass der Lounge-Zugang stets an den gebuchten Tarif gebunden ist.“"
                            },
                            {
                                "example_id": "0128bccd-52d3-4e3a-aa9d-880f91d5e0b0",
                                "sense_id": "cd389643-d4bd-360e-820b-1057a0f8cb19",
                                "text": "„Geklagt hatte ein Kunde, der am Vielflieger-und Prämienprogramm der Lufthansa beteiligt war und dort den höchsten Vielfliegerstatus erhalten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
