                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffbd206-3e35-452a-ac67-eef2783841ab",
                                                "sense_id": "7d1e12f5-2833-389f-8e5b-b3d0ad938274",
                                                "text": "W którym roku Francuzi opuścili Indochiny?"
                                            },
                                            {
                                                "example_id": "0edd3176-8fdf-4bc9-beee-1fe6f343fc3a",
                                                "sense_id": "7d1e12f5-2833-389f-8e5b-b3d0ad938274",
                                                "text": "„Kolonizacja nie była nigdy aktem cywilizacyjnym, nie wyrosła z woli cywilizowania kogokolwiek — mówi Albert Sarraut, w swoim czasie gubernator Indochin. — Jest ona aktem przemocy, i to przemocy kierowanej interesem własnym”"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7e471253-5110-366e-83e1-86e49fc754ea",
                                        "entry_id": "a71361c3-1904-3106-ba8c-014678c791b7",
                                        "glosses": [
                                            "wschodnia część Półwyspu Indochińskiego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8af099c-1c95-46e0-a879-dde9b6c4e5cd",
                                                "sense_id": "7e471253-5110-366e-83e1-86e49fc754ea",
                                                "text": "W zeszłym roku na wakacjach byliśmy w Indochinach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
