                ],
                "senses": [
                    {
                        "sense_id": "022855be-8e0d-318f-97e2-20707c5354a4",
                        "entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "glosses": [
                            "A nomadic excursion into the bush, especially one taken by young teenage boys in certain ancient-custom honoring tribes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a18a62a-9987-3b51-8d3b-f27b18b842b7",
                        "entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "glosses": [
                            "A walking trip."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dba491a2-f4c0-3fe5-9dd5-c023e0c3e6d6",
                        "entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "glosses": [
                            "A public stroll by some celebrity to meet a group of people informally."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "49d9aa18-e170-42bf-afb1-d28b07b203c6",
                                "sense_id": "dba491a2-f4c0-3fe5-9dd5-c023e0c3e6d6",
                                "text": "While the world altered dramatically during the course of her reign, the monarchy did too, though rather more imperceptibly: the walkabouts that increasingly characterised royal appearances, the pop concerts at Buckingham Palace, the throwing open of the royal palaces to visitors – even the paying of income tax, and royal podcasts – would have been inconceivable as innovations at the time Elizabeth came to the throne."
                            }
                        ]
                    },
                    {
                        "sense_id": "e23a864d-e189-39ae-9e72-acaa12b670f4",
                        "entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "glosses": [
                            "An absence, usually from a regular place with a possibility of a return."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3346efa1-5c01-4c0d-927d-d21c315adc22",
                        "source_entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "source_sense_description": "public stroll",
                        "target_lang_word": "rondgang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rondgang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "efa38ef3-cca8-396c-bedb-d50468108090",
                                        "entry_id": "aea4a908-91f0-3207-8dad-b718dfbaba88",
                                        "glosses": [
                                            "het afleggen van een weg die weer naar het punt van vertrek voert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebffe4e-d7bc-49b0-bd78-d0304871b845",
                                                "sense_id": "efa38ef3-cca8-396c-bedb-d50468108090",
                                                "text": "Heel het dorp liep mee in de stille rondgang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be7825c-2ac6-322f-a3d7-1be3850d6cc4",
                                        "entry_id": "aea4a908-91f0-3207-8dad-b718dfbaba88",
                                        "glosses": [
                                            "een omwenteling rond een middelpunt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ec116c-3ea9-44ef-8edc-f325e8e979a6",
                                                "sense_id": "1be7825c-2ac6-322f-a3d7-1be3850d6cc4",
                                                "text": "De jaarlijkse rondgang van de aarde om de zon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335d84c7-a157-307d-8de7-9bdd8c758359",
                                        "entry_id": "aea4a908-91f0-3207-8dad-b718dfbaba88",
                                        "glosses": [
                                            "het afleggen van bezoeken ter kennismaking of het onderhouden van contacten in een kring van personen, plaatsen, bedrijfsonderdelen enz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e746fb0c-2804-4460-af73-0da518c8ac00",
                                                "sense_id": "335d84c7-a157-307d-8de7-9bdd8c758359",
                                                "text": "De net benoemde abt besloot een rondgang door de abdij te maken."
                                            },
                                            {
                                                "example_id": "007a01ba-af01-4208-aaa5-032ade4d9663",
                                                "sense_id": "335d84c7-a157-307d-8de7-9bdd8c758359",
                                                "text": "Veel ziekenhuizen waren toen overvol door grieppatiënten en ook veel eigen personeel werd geveld door de griep. Dat leidde her en der tot problemen. Vorige maand bleek uit een rondgang dat veel ziekenhuizen daarom al volop bezig waren met het komende griepseizoen om alles op alles te zetten om te voorkomen dat ze weer door een griepgolf worden overvallen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9cd38a5-fd31-45ad-8f46-ce14d9f14e87",
                        "source_entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "source_sense_description": "public stroll",
                        "target_lang_word": "bain de foule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bain de foule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c9abc02-95a2-35eb-b2d4-d1599c20094e",
                                        "entry_id": "60583d86-f11d-3cd6-ab00-dcca6a6f76e2",
                                        "glosses": [
                                            "Action de serrer furtivement les mains de nombreuses personnes d’une foule de badauds ou d’admirateurs."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1cdff4-23d2-4334-bbe8-bf699d3caf88",
                                                "sense_id": "5c9abc02-95a2-35eb-b2d4-d1599c20094e",
                                                "text": "Le lit, la solitude, après les bains de foule et de bruit, quelles délices !"
                                            },
                                            {
                                                "example_id": "1172a482-5516-4c4b-93e2-77d94cb05062",
                                                "sense_id": "5c9abc02-95a2-35eb-b2d4-d1599c20094e",
                                                "text": "L’allocution se termine, le candidat se jette dans un énième bain de foule et signe des autographes sur les bons de retard des élèves – cheveux en pétard, sweat-shirts à capuche – qui l’approchent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66668641-7f9d-445e-b63b-0d45bc1dbf71",
                        "source_entry_id": "14c2a49c-34fd-37ec-807d-ab5a0b1621ad",
                        "source_sense_description": "public stroll",
                        "target_lang_word": "Rundgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rundgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9317b767-a2c2-3e67-9ec6-7249af5459ba",
                                        "entry_id": "5f8a75b3-fa4e-345c-a854-742abaf27deb",
                                        "glosses": [
                                            "Weg, der zu seinem Ausgangspunkt zurückführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b3499d-29dd-4a8a-b225-37000ddaf34c",
                                                "sense_id": "9317b767-a2c2-3e67-9ec6-7249af5459ba",
                                                "text": "Sie folgen dem Rundgang, soweit sie können, und legen vor dem Weitermarsch eine kurze Pause ein."
                                            },
                                            {
                                                "example_id": "2e2c61a0-9a07-468c-a2aa-c091745d4465",
                                                "sense_id": "9317b767-a2c2-3e67-9ec6-7249af5459ba",
                                                "text": "„So ermöglicht der stadtökologische Rundgang ortsfremden und ortskundigen Nutzern gleichermaßen Einblicke in die Natur der Stadt Koblenz, aber auch in den eigenen Lebensraum.“"
                                            },
                                            {
                                                "example_id": "265a8631-5a81-4507-a96e-43e4371aae53",
                                                "sense_id": "9317b767-a2c2-3e67-9ec6-7249af5459ba",
                                                "text": "„Der neue Gefängnisdirektor macht seinen ersten Rundgang und fragt die Häftlinge nach Strafmaß und Grund der Verurteilung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b356ac02-99f2-3a51-96a0-74bc7bfdf3ea",
                                        "entry_id": "5f8a75b3-fa4e-345c-a854-742abaf27deb",
                                        "glosses": [
                                            "Spaziergang, Wanderung, deren Ziel ihr Ausgangspunkt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83084452-6112-467b-8acb-1a1ceb60762d",
                                                "sense_id": "b356ac02-99f2-3a51-96a0-74bc7bfdf3ea",
                                                "text": "„Nach dem Rundgang serviert uns seine Frau Tee und weist uns einen Ehrenplatz in der Hollywoodschaukel zu.“"
                                            },
                                            {
                                                "example_id": "901ce581-984d-42ce-9d14-7f2c54fa961d",
                                                "sense_id": "b356ac02-99f2-3a51-96a0-74bc7bfdf3ea",
                                                "text": "„Mit der Beobachtung der Raubtiere haben wir unseren Rundgang beendet.“"
                                            },
                                            {
                                                "example_id": "4c8c5536-fcdb-4a16-bb5b-bf8e4e92e37b",
                                                "sense_id": "b356ac02-99f2-3a51-96a0-74bc7bfdf3ea",
                                                "text": "„Bei einem Rundgang durch das Museum erzählt Eckmann, wie er zum Bart-Retter berufen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
