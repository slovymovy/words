    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebc641b1-e0b9-302f-98ea-e89870d09a3c",
                    "sense_definition": "iemand dwingen tot seksuele handelingen zonder dat er sprake is van penetratie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seksueel_geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dader probeerde de vrouw op straat aan te randen, maar zij wist gelukkig te ontsnappen.",
                            "target_lang_translations": {
                                "en": "The perpetrator tried to <w>assault</w> the woman in the street, but she fortunately managed to escape."
                            }
                        },
                        {
                            "text": "Hij werd ervan beschuldigd een collega te hebben <w>aangerand</w> tijdens het bedrijfsuitje.",
                            "target_lang_translations": {
                                "en": "He was accused of having <w>molested</w> a colleague during the company outing."
                            }
                        }
                    ],
                    "synonyms": [
                        "molesteren"
                    ],
                    "common_phrases": [
                        "iemand aanranden"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone into sexual acts without penetration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assault sexually",
                                "target_lang_sense_clarification": "to subject someone to unwanted sexual contact"
                            },
                            {
                                "target_lang_word": "molest",
                                "target_lang_sense_clarification": "to abuse someone sexually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edaf1fcb-9902-3ead-a868-ce8d11029290",
                    "sense_definition": "iemand fysiek aanvallen of te lijf gaan",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief <w>randde</w> de voorbijganger <w>aan</w> om zijn tas te kunnen stelen.",
                            "target_lang_translations": {
                                "en": "The thief <w>assaulted</w> the passerby in order to steal his bag."
                            }
                        },
                        {
                            "text": "Het is onacceptabel om hulpverleners tijdens hun werk fysiek aan te randen.",
                            "target_lang_translations": {
                                "en": "It is unacceptable to physically <w>assault</w> emergency workers during their work."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvallen",
                        "bestormen",
                        "belaagden"
                    ],
                    "antonyms": [
                        "verdedigen"
                    ],
                    "common_phrases": [
                        "fysiek aanranden"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically attack or assault someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assault",
                                "target_lang_sense_clarification": "to physically attack someone"
                            },
                            {
                                "target_lang_word": "assail",
                                "target_lang_sense_clarification": "to attack violently"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7acbefd-cfec-3f32-8610-917565074fb6",
                    "sense_definition": "iets abstracts, zoals een recht, vrijheid of waardigheid, ernstig aantasten of schenden",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aantasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe wetgeving dreigt de fundamentele rechten van de burgers ernstig aan te randen.",
                            "target_lang_translations": {
                                "en": "This new legislation threatens to seriously <w>infringe</w> upon the fundamental rights of citizens."
                            }
                        },
                        {
                            "text": "Men mag de autonomie van de lokale gemeenschappen niet zomaar <w>aanranden</w>.",
                            "target_lang_translations": {
                                "en": "One cannot simply <w>encroach upon</w> the autonomy of local communities."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantasten",
                        "schenden",
                        "ondermijnen"
                    ],
                    "antonyms": [
                        "respecteren",
                        "waarborgen"
                    ],
                    "common_phrases": [
                        "de vrijheid aanranden",
                        "rechten aanranden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak gebruikt in formele, juridische of plechtige contexten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To seriously infringe upon, violate, or undermine something abstract, such as a right, freedom, or dignity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infringe",
                                "target_lang_sense_clarification": "to violate a right or law"
                            },
                            {
                                "target_lang_word": "violate",
                                "target_lang_sense_clarification": "to disregard or go against a right or freedom"
                            },
                            {
                                "target_lang_word": "encroach upon",
                                "target_lang_sense_clarification": "to gradually intrude on rights or autonomy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}