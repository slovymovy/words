                                        "glosses": [
                                            "Toucher le pied de quelqu’un pour lui dire quelque chose ou entrer en contact avec lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d0c885-50ed-476f-8d2d-1eeeeec88486",
                                                "sense_id": "12e0e23d-f451-364a-b050-67dd38873b48",
                                                "text": "Mariette faisait de temps à autre du pied à Hélène et lui adressait des sourires qui se voulaient apaisants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d09bf9-4227-3871-9893-bcf1337fc353",
                                        "entry_id": "69ad5484-a0dc-3e79-8a22-066f0ce287e9",
                                        "glosses": [
                                            "Faire des avances discrètes, par un contact des pieds ou par un autre moyen."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe36ed7e-91bc-4772-b3bc-b88de39647c8",
                                                "sense_id": "48d09bf9-4227-3871-9893-bcf1337fc353",
                                                "text": "Ils ont commencé par me regarder, ensuite, ils se sont assis à côté de moi, et le premier m’a fait du pied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
