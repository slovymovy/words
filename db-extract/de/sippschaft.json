                "senses": [
                    {
                        "sense_id": "3ea80db8-7589-38cb-83b9-715d10afbe26",
                        "entry_id": "ca25b31a-9f02-363b-a9af-24e50fe8f534",
                        "glosses": [
                            "alle Angehörigen des weiteren Verwandtenkreises"
                        ],
                        "tags": [
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "16b9842c-5394-4f22-9ce1-94a1011301f4",
                                "sense_id": "3ea80db8-7589-38cb-83b9-715d10afbe26",
                                "text": "„Auch das hat sie rübergeschickt, äußert sich dafür aber abfällig über ihre Sippschaft drüben.“"
                            },
                            {
                                "example_id": "f62505fc-c7ee-4567-9423-76032c4873bc",
                                "sense_id": "3ea80db8-7589-38cb-83b9-715d10afbe26",
                                "text": "Ich möchte eine Hochzeit im kleinen Kreis feiern und nicht gleich die gesamte Sippschaft einladen."
                            },
                            {
                                "example_id": "5cf46bd7-1468-43b3-8542-fccaacc12444",
                                "sense_id": "3ea80db8-7589-38cb-83b9-715d10afbe26",
                                "text": "„Er wußte ebensosehr Bescheid mit dem Leben und der Sippschaft von gehängten Dieben und Landstreicherdirnen als mit dem Tun von Allthingsschöffen und hochgelahrten Herren und deren Anhang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
