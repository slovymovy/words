                                    {
                                        "sense_id": "333b011f-0cfe-3864-a32c-d597c6bfd27d",
                                        "entry_id": "2073c339-e41d-38a0-be42-d3fee464976f",
                                        "glosses": [
                                            "The quality of being willful and ignoring opposition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a646fd7-17e6-4428-ab1e-35d2b3347a80",
                                                "sense_id": "333b011f-0cfe-3864-a32c-d597c6bfd27d",
                                                "text": "This Marian principle indicates that women ought to divest themselves of self-will in order to be obedient to the word of God as articulated by male spokesmen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
