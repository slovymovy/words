                "senses": [
                    {
                        "sense_id": "f2676f41-e6b9-3664-af5a-3351b64b268e",
                        "entry_id": "ced63f4f-8575-324f-b97d-732c868ed8c6",
                        "glosses": [
                            "zástěrka, fěrtošek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb40a6a-432d-416b-a2e6-a6b789d964d5",
                                "sense_id": "f2676f41-e6b9-3664-af5a-3351b64b268e",
                                "text": "Schwyciła biały fartuszek z wieszaka na scianie i weszła do laboratorium."
                            },
                            {
                                "example_id": "a6b063c5-159c-4f0d-b6fa-bd214c78a236",
                                "sense_id": "f2676f41-e6b9-3664-af5a-3351b64b268e",
                                "text": "Lecz ta mając całą twarz białym fartuszkiem zakrytą , ze zwieszoną głową, głośném tylko tkaniem na zapytanie odpowiedziała. - No, Małgoś nie bądźże głupia, i czegóż płaczesz? Jata wierzę, co ludzie gadają. - A cóż ludzie gadają?"
                            }
                        ]
                    }
