                "senses": [
                    {
                        "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                        "entry_id": "534f3db6-8e3c-3d82-9f73-ceb519844b60",
                        "glosses": [
                            "Werkzeug, das (zum Beispiel bei Autoreparaturen) verwendet wird, um Teile in bestimmten Positionen oder Ausrichtungen zu fixieren oder zu arretieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3efab5c-efc3-493f-9583-2a36d106ca1e",
                                "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                                "text": "„Jetzt muß der Absteckdorn 2064 in die Bohrung für Einspritzpumpenrad und Einspritzpumpenhalter passen. Durch den Absteckdorn wird das Einspritzpumpenrad arretiert.“"
                            },
                            {
                                "example_id": "9375813f-aa2c-4978-a260-7b7719b378c0",
                                "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                                "text": "„Spannvorrichtung etwas im Gegenuhrzeigersinn drehen und Absteckdorn herausziehen.“"
                            },
                            {
                                "example_id": "f9a9cff0-8d1a-4990-9ec5-edff4b860771",
                                "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                                "text": "„Absteckdorn für Einspritzpumpenrad entfernen.“"
                            },
                            {
                                "example_id": "a23537f8-6b60-431e-a310-3c39683d4ce5",
                                "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                                "text": "„Keilrippenriemen-Spanner spannen, Absteckdorn einsetzen, Keilrippenriemen einbauen, dabei die Laufrichtung beachten. Spanner entspannen und Absteckdorn herausziehen, siehe auch Seite 181.“"
                            },
                            {
                                "example_id": "5dfd568e-469f-4d1b-aa23-81c07667b6bc",
                                "sense_id": "86e20bd2-e0a8-37f4-97ad-1c20e5122813",
                                "text": "„Hierbei ist der in einer Führungsbuchse a verschiebbare Absteckdorn b von einem Paßstift c gehalten, der in einem Führungsbolzen d längsbeweglich gelagert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
