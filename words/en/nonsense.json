{
    "word_family": [
        "nonsensical",
        "nonsensically",
        "nonsensicality"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89b006da-574e-35bc-9704-c3c6d074e1d4",
                    "sense_definition": "Ideas, behavior, or statements that are silly, illogical, and lack any meaning, reason, or value.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "absurdity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never heard such <w>nonsense</w> in my entire life.",
                            "target_lang_translations": {
                                "ru": "Я никогда в жизни не слышал подобной <w>чепухи</w>."
                            }
                        },
                        {
                            "text": "Stop talking absolute <w>nonsense</w> and tell me what really happened.",
                            "target_lang_translations": {
                                "ru": "Перестань нести <w>абсолютную чушь</w> и расскажи мне, что произошло на самом деле."
                            }
                        }
                    ],
                    "synonyms": [
                        "absurdity",
                        "silliness",
                        "stupidity",
                        "foolishness",
                        "rubbish"
                    ],
                    "antonyms": [
                        "sense"
                    ],
                    "common_phrases": [
                        "absolute nonsense",
                        "utter nonsense",
                        "talk nonsense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеи, поведение или утверждения, которые являются глупыми, нелогичными и лишенными всякого смысла или ценности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чепуха",
                                "target_lang_sense_clarification": "нечто бессмысленное, глупое"
                            },
                            {
                                "target_lang_word": "ерунда",
                                "target_lang_sense_clarification": "разг. вздор, нелепость"
                            },
                            {
                                "target_lang_word": "бессмыслица",
                                "target_lang_sense_clarification": "нечто, не имеющее смысла"
                            },
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "разг. что-либо несерьезное, не заслуживающее внимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f84c921c-d824-334d-9624-33530a2601f7",
                    "sense_definition": "Letters or words, in writing or speech, that have no meaning or pattern.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaningless_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After my father had a stroke, every time he tried to talk, it sounded like <w>nonsense</w>.",
                            "target_lang_translations": {
                                "ru": "После того как у моего отца случился инсульт, каждый раз, когда он пытался заговорить, это звучало как <w>бессмыслица</w>."
                            }
                        },
                        {
                            "text": "The computer program generated a string of <w>nonsense</w> characters that no one could read.",
                            "target_lang_translations": {
                                "ru": "Компьютерная программа сгенерировала строку <w>бессмысленных</w> символов, которые никто не мог прочитать."
                            }
                        }
                    ],
                    "synonyms": [
                        "gibberish",
                        "double Dutch",
                        "meaninglessness"
                    ],
                    "antonyms": [
                        "plain English"
                    ],
                    "common_phrases": [
                        "sound like nonsense",
                        "nonsense words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буквы или слова в письменной или устной речи, не имеющие смысла или структуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмыслица",
                                "target_lang_sense_clarification": "набор слов или знаков без смысла"
                            },
                            {
                                "target_lang_word": "абракадабра",
                                "target_lang_sense_clarification": "бессмысленный набор букв или слов"
                            },
                            {
                                "target_lang_word": "тарабарщина",
                                "target_lang_sense_clarification": "непонятная, бессмысленная речь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2e44b80-22f7-3592-a017-a66f9df445e8",
                    "sense_definition": "A statement that is untrue or a lie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "falsehood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was uttering a great deal of <w>nonsense</w> about things of which he knew nothing.",
                            "target_lang_translations": {
                                "ru": "Свидетель нес много <w>вздора</w> о вещах, о которых он ничего не знал."
                            }
                        },
                        {
                            "text": "Don't believe a word he says; his entire story is just <w>nonsense</w>.",
                            "target_lang_translations": {
                                "ru": "Не верь ни единому его слову; вся его история — просто <w>вранье</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "falsehood",
                        "lie",
                        "untruth"
                    ],
                    "common_phrases": [
                        "pure nonsense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение, которое является неправдой или ложью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "разг. что-либо не соответствующее действительности, ложь"
                            },
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "разг. неправда, выдумки"
                            },
                            {
                                "target_lang_word": "ахинея",
                                "target_lang_sense_clarification": "разг. вздор, ложь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e20a78c8-6ba3-3318-9f81-e82255fd1ba6",
                    "sense_definition": "A type of poetry or literature that contains strange, surreal, or whimsical ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Edward Lear is famous for his <w>nonsense</w> verse and whimsical illustrations.",
                            "target_lang_translations": {
                                "ru": "Эдвард Лир знаменит своими <w>абсурдными</w> стихами и причудливыми иллюстрациями."
                            }
                        },
                        {
                            "text": "The children enjoyed the <w>nonsense</w> rhymes because of their funny sounds and impossible situations.",
                            "target_lang_translations": {
                                "ru": "Детям нравились <w>шуточные</w> стишки из-за их забавного звучания и невозможных ситуаций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nonsense verse",
                        "nonsense rhymes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary genre"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид поэзии или литературы, содержащий странные, сюрреалистичные или причудливые идеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нонсенс",
                                "target_lang_sense_clarification": "литературный жанр, основанный на бессмыслице"
                            },
                            {
                                "target_lang_word": "бессмыслица",
                                "target_lang_sense_clarification": "в контексте абсурдной поэзии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afd1081c-defe-32bb-a6d9-b28232b02999",
                    "sense_definition": "A damaged DNA sequence whose products are not biologically active.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mutation resulted in a <w>nonsense</w> sequence that failed to produce a functional protein.",
                            "target_lang_translations": {
                                "ru": "Мутация привела к появлению <w>нонсенс-последовательности</w>, которая не смогла произвести функциональный белок."
                            }
                        },
                        {
                            "text": "Scientists identified a <w>nonsense</w> mutation in the gene responsible for the disorder.",
                            "target_lang_translations": {
                                "ru": "Ученые выявили <w>нонсенс-мутацию</w> в гене, ответственном за это расстройство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nonsense mutation",
                        "nonsense sequence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденная последовательность ДНК, продукты которой биологически неактивны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нонсенс-последовательность",
                                "target_lang_sense_clarification": "генетический термин для неактивной последовательности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "460cb0e6-7876-38cb-a118-8ae0fd414c86",
                    "sense_definition": "An emphatic rejection of something one has just heard and does not believe or agree with.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They claim this is a benefit for the customers. <w>Nonsense</w>! It is just a way to save money.",
                            "target_lang_translations": {
                                "ru": "Они утверждают, что это выгодно для клиентов. <w>Глупости</w>! Это просто способ сэкономить деньги."
                            }
                        },
                        {
                            "text": "He said he was too busy to help, but I said, \"<w>Nonsense</w>, you have all afternoon!\"",
                            "target_lang_translations": {
                                "ru": "Он сказал, что слишком занят, чтобы помочь, но я ответил: «<w>Ерунда</w>, у тебя в распоряжении весь день!»"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "baloney",
                        "poppycock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительное неприятие того, что человек только что услышал и во что он не верит или с чем не согласен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупости",
                                "target_lang_sense_clarification": "восклицание несогласия"
                            },
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "эмоциональное отрицание сказанного"
                            },
                            {
                                "target_lang_word": "ерунда",
                                "target_lang_sense_clarification": "выражение недоверия к словам собеседника"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d34fd531-2868-35c7-829b-12b5d9fbd955",
                    "sense_definition": "Describing something that is <w>nonsensical</w> or lacks meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absurdity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician gave a <w>nonsense</w> answer to a very straightforward question.",
                            "target_lang_translations": {
                                "ru": "Политик дал <w>бессмысленный</w> ответ на очень прямой вопрос."
                            }
                        },
                        {
                            "text": "I am tired of these <w>nonsense</w> rules that don't help anyone.",
                            "target_lang_translations": {
                                "ru": "Я устал от этих <w>глупых</w> правил, которые никому не помогают."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsensical",
                        "absurd",
                        "meaningless"
                    ],
                    "antonyms": [
                        "sense"
                    ],
                    "common_phrases": [
                        "nonsense rules",
                        "nonsense answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает что-то бессмысленное или нелепое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий логики или цели"
                            },
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "нелепый, несерьезный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82662a12-c222-37d6-87a9-dbf97b143fb2",
                    "sense_definition": "Relating to a genetic mutation where a codon is changed into a stop codon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>nonsense</w> mutation can lead to the premature termination of protein synthesis.",
                            "target_lang_translations": {
                                "ru": "<w>Нонсенс-мутация</w> может привести к преждевременному прекращению синтеза белка."
                            }
                        },
                        {
                            "text": "The researchers studied the effects of <w>nonsense</w> codons on gene expression.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили влияние <w>нонсенс-кодонов</w> на экспрессию генов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nonsense codon",
                        "nonsense mutation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к генетической мутации, при которой кодон заменяется на стоп-кодон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нонсенс-мутация",
                                "target_lang_sense_clarification": "специальный термин в генетике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "986af08d-39bc-34c9-8ccb-18794cc1c18f",
                    "sense_definition": "To attempt to dismiss something as unimportant or to treat it as if it were nonsense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He further <w>nonsensed</w> press suggestions that the unit was set up for sporting activities.",
                            "target_lang_translations": {
                                "ru": "Далее он <w>отверг</w> предположения прессы о том, что подразделение было создано для спортивных мероприятий."
                            }
                        },
                        {
                            "text": "They haven't <w>nonsensed</w> these difficult workouts; instead, they have used them very well.",
                            "target_lang_translations": {
                                "ru": "Они не стали <w>считать бесполезными</w> эти сложные тренировки; вместо этого они использовали их очень эффективно."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismiss",
                        "belittle",
                        "pooh-pooh",
                        "rubbish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка отвергнуть что-либо как неважное или относиться к этому как к бессмыслице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмахиваться",
                                "target_lang_sense_clarification": "отвергать как несерьезное"
                            },
                            {
                                "target_lang_word": "выставлять вздором",
                                "target_lang_sense_clarification": "представлять что-либо бессмысленным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9c7a792-728f-3852-80cb-30dea3631f65",
                    "sense_definition": "To joke around or waste time in a silly manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When he told me to go, he meant it, with no <w>nonsensing</w> around.",
                            "target_lang_translations": {
                                "ru": "Когда он велел мне уходить, он говорил серьезно, без всяких <w>глупостей</w>."
                            }
                        },
                        {
                            "text": "Stop <w>nonsensing</w> and get back to your work immediately.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>валять дурака</w> и немедленно возвращайся к работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool around",
                        "mess around"
                    ],
                    "common_phrases": [
                        "nonsensing around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутить или тратить время впустую, ведя себя глупо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валять дурака",
                                "target_lang_sense_clarification": "заниматься глупостями, бездельничать"
                            },
                            {
                                "target_lang_word": "дурачиться",
                                "target_lang_sense_clarification": "вести себя несерьезно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}