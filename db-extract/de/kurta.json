                        "glosses": [
                            "aus Südasien stammendes, von Männern getragenes kragenloses langes Hemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a0f244-39ca-4e17-8974-fdd1b9ad2fbf",
                                "sense_id": "dd059627-9c9e-3b5e-8044-bbb7a41d9bbe",
                                "text": "„Er sah sich stürzen, seine weiße Kurta wild flatternd, Brust und Bauch entblößt, die wehende Nada, einen abwärts segelnden blau-weißen Gummischlappen, seine Füße, die einen Kreis beschrieben, und, noch ehe er vollendet war, hörte er das kurze Krachen des Schädels und dann - Stille.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
