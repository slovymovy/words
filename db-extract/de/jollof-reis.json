                        "examples": [
                            {
                                "example_id": "2a69ab28-b97b-4c86-a759-225352618681",
                                "sense_id": "641bfa04-2470-3ea6-a470-a6803296ce5b",
                                "text": "„Sie stand auf und verschwand im Zimmer und kam dann mit einem Teller Jollof-Reis wieder, den sie mir reichte.“"
                            },
                            {
                                "example_id": "6435798c-1269-4a73-9405-9aa1ecf7c998",
                                "sense_id": "641bfa04-2470-3ea6-a470-a6803296ce5b",
                                "text": "„In beiden Packungen ist Jollof-Reis, aber nur in einem ein Fleischstückchen.“"
                            },
                            {
                                "example_id": "d96c9336-a9d5-41de-a7a1-b3cd624556bd",
                                "sense_id": "641bfa04-2470-3ea6-a470-a6803296ce5b",
                                "text": "„Die Menschen mögen sich zum Makaberen hingezogen fühlen, aber das hält niemals lange an, weshalb die Nachricht von Femis Verschwinden übertrumpft wurde von Diskussionen darüber, in welchem Land der Jollof-Reis besser schmeckt.“"
                            }
