    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12f61da5-6e65-36ef-9af2-c973432c6f52",
                    "sense_definition": "High-sounding language with little meaning, used to impress people; pompous or pretentious speech or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His political speech was filled with empty <w>bombast</w> rather than concrete proposals."
                        },
                        {
                            "text": "The critic dismissed the novel as sheer <w>bombast</w> wrapped in pretentious vocabulary."
                        }
                    ],
                    "synonyms": [
                        "grandiloquence",
                        "fustian",
                        "purple prose"
                    ],
                    "common_phrases": [
                        "empty bombast",
                        "sheer bombast",
                        "political bombast"
                    ]
                },
                {
