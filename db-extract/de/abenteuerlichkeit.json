                ],
                "senses": [
                    {
                        "sense_id": "ec310476-bedf-3315-9895-d8795f7fb938",
                        "entry_id": "b9748083-f25b-347d-85bc-bb23a854fb07",
                        "glosses": [
                            "Eigenschaft, wie ein Abenteuer zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e54df2a4-ec09-4692-8bde-8bb7e9336986",
                                "sense_id": "ec310476-bedf-3315-9895-d8795f7fb938",
                                "text": "„Bei aller Kuriosität und Abenteuerlichkeit dieser Forschung auf den Wipfeln des Regenwaldes wird zum Ende des Buches ihr wichtiges und überaus ernsthaftes Potenzial ganz deutlich: Sie könnte zur Rettung für den bedrohten Regenwald werden!“"
                            },
                            {
                                "example_id": "7cf4104d-ade7-4342-acb1-674532c42105",
                                "sense_id": "ec310476-bedf-3315-9895-d8795f7fb938",
                                "text": "„Abenteuerlichkeit und ein weltweites Machtbewusstsein vereinigten sich in der Empire-Dichtung (R. Kipling), während der Kolonialismus durch die Romane J. Conrads kritisiert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75bb2d52-4e7f-3e64-a9fe-9d443e0acf5e",
                        "entry_id": "b9748083-f25b-347d-85bc-bb23a854fb07",
                        "glosses": [
                            "etwas, das abenteuerlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e6522a-389f-4e3c-b8c1-b81c85cad81d",
                                "sense_id": "75bb2d52-4e7f-3e64-a9fe-9d443e0acf5e",
                                "text": "„Denn an Abenteuerlichkeiten hätte schon der Inhalt weitaus genug zu bieten: Volker Sommer, renommierter Anthropologe, unterwegs in Nigeria, um im 6600 Quadratkilometer großen Gashaka-Gumpti-Nationalpark eine noch unerforschte Schimpansenunterart näher zu studieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
