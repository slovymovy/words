                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174c4189-fb35-43ee-99ad-c52208ab71b3",
                                "sense_id": "7809e5e5-23c0-3604-82d1-6a21fde1067a",
                                "text": "Harburg liegt im Südosten von Deutschland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44432afe-2847-350b-80d6-f010e1f5d2e8",
                        "entry_id": "ad0404cc-a948-3188-992e-48ca2c6ccea1",
                        "glosses": [
                            "Landkreis in Niedersachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8100cc51-22bb-452b-8aeb-912e946d7886",
                                "sense_id": "44432afe-2847-350b-80d6-f010e1f5d2e8",
                                "text": "Früher gehörte das Gebiet vom Landkreis Harburg zur preußischen Provinz Hannover."
                            },
                            {
                                "example_id": "ea0d48eb-24f1-4416-b601-9f0482267422",
                                "sense_id": "44432afe-2847-350b-80d6-f010e1f5d2e8",
                                "text": "Der Landkreis Harburg bildet zusammen mit dem Landkreis Stade die Grenze zwischen Niedersachsen und Hamburg."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4335d08a-ad22-3d2c-9e21-9b31ceecba17",
                        "entry_id": "ad0404cc-a948-3188-992e-48ca2c6ccea1",
                        "glosses": [
                            "Verwaltungsbezirk von Hamburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbeb4b06-1ceb-4e88-8282-695af91686fd",
                                "sense_id": "4335d08a-ad22-3d2c-9e21-9b31ceecba17",
                                "text": "Der Bezirk Harburg bildet den Großteil des Südwestens von Hamburg."
                            },
                            {
                                "example_id": "87bcd18a-0233-4e86-9b6b-5d9ccbc178b1",
                                "sense_id": "4335d08a-ad22-3d2c-9e21-9b31ceecba17",
                                "text": "„Hamburg besaß Postanstalten in Harburg und Ritzebüttel, vor dem 30. Juni 1866 auch eine Postagentur auf Helgoland.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "b7f69a2f-93d6-3319-ba58-cf594e66fd36",
                        "entry_id": "ad0404cc-a948-3188-992e-48ca2c6ccea1",
                        "glosses": [
                            "Stadtteil von Hamburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "699d29d8-f538-4f34-8c35-6a521a0cfbb8",
                                "sense_id": "b7f69a2f-93d6-3319-ba58-cf594e66fd36",
                                "text": "Der eigentliche Stadtteil Harburg ist nur ein kleiner Teil des gleichnamigen Bezirks."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
