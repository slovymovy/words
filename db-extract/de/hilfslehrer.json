                "senses": [
                    {
                        "sense_id": "281251d2-7e0f-3921-bf2f-e153c4270b51",
                        "entry_id": "631c9e2b-3d6d-3a99-879c-458d0834e65d",
                        "glosses": [
                            "ein Lehrer, der nur aushilfsweise unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4154c3d0-3cfb-45f8-855b-3699533c1be9",
                                "sense_id": "281251d2-7e0f-3921-bf2f-e153c4270b51",
                                "text": "„Weit über die Hälfte der Lehrerschaft war eingezogen worden, mit ein paar kümmerlichen Hilfslehrern (dienstuntauglichen) suchte man den Unterricht durchzuführen.“"
                            },
                            {
                                "example_id": "2345579d-ff8f-4a1c-b751-d97bbe764cd5",
                                "sense_id": "281251d2-7e0f-3921-bf2f-e153c4270b51",
                                "text": "„Als ein Hilfslehrer die Tochter des Wasserträgers Moische geschwängert hatte, war das ganze Schtetl in Aufruhr geraten.“"
                            },
                            {
                                "example_id": "83bdfe33-e9e4-470e-be20-083e8557ff8b",
                                "sense_id": "281251d2-7e0f-3921-bf2f-e153c4270b51",
                                "text": "„Bis zum 14. Oktober 1902 blieb er als Hilfslehrer in Winterthur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
