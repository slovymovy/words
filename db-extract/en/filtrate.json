                                        "glosses": [
                                            "Passer par un filtre pour séparer un ou des éléments constituants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef80e6f-b6da-4a91-917e-c0d21c463e44",
                                                "sense_id": "05e38493-a1f9-3d95-b3d4-cfc5810bb557",
                                                "text": "Cette lentille oculaire filtre la couleur bleue."
                                            },
                                            {
                                                "example_id": "c47ae4e5-7567-489f-b5fd-6cd3ae50b34f",
                                                "sense_id": "05e38493-a1f9-3d95-b3d4-cfc5810bb557",
                                                "text": "Filtrer du petit-lait."
                                            },
                                            {
                                                "example_id": "1ba0c572-eba5-4871-ab22-be215b1fd38a",
                                                "sense_id": "05e38493-a1f9-3d95-b3d4-cfc5810bb557",
                                                "text": "Pierre à filtrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287ae2eb-d2a7-3ce6-97a3-d987f2704e46",
                                        "entry_id": "17a9e8dc-1df7-3ff8-9603-058d9468943a",
                                        "glosses": [
                                            "Passer par un filtre, pénétrer à travers les pores, les interstices d’un corps quelconque."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0365046d-5d41-4809-96ae-ea1143b37184",
                                                "sense_id": "287ae2eb-d2a7-3ce6-97a3-d987f2704e46",
                                                "text": "Cette lie de vin filtre bien lentement."
                                            },
                                            {
                                                "example_id": "79ad032f-f9ec-4374-a854-d0eb1bfc423d",
                                                "sense_id": "287ae2eb-d2a7-3ce6-97a3-d987f2704e46",
                                                "text": "L’eau filtre au travers des terres, au travers de la muraille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c601e0ac-9834-391b-adc3-99521940ab88",
                                        "entry_id": "17a9e8dc-1df7-3ff8-9603-058d9468943a",
                                        "glosses": [
                                            "Passer au travers d’une chose conçue comme obstacle, ralentissement, ou paroi infranchissable."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68120ce5-7469-4293-bc62-9e5da31a48a1",
                                                "sense_id": "c601e0ac-9834-391b-adc3-99521940ab88",
                                                "text": "Des informations ont filtré."
                                            },
                                            {
                                                "example_id": "069b51c3-53b4-4255-b0e7-814b5eb3d3ff",
                                                "sense_id": "c601e0ac-9834-391b-adc3-99521940ab88",
                                                "text": "Ce bataillon a filtré à travers le bois."
                                            },
                                            {
                                                "example_id": "13fc94b9-2db8-4495-921c-442817578973",
                                                "sense_id": "c601e0ac-9834-391b-adc3-99521940ab88",
                                                "text": "Pour l’instant rien n’a filtré sur les quantités de drogue qui ont pu être saisies par ses troupes, ni sur l’identité et le profil des gardés à vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1e5c02-d1f9-38a8-9bbb-e19dfa18ea38",
                                        "entry_id": "17a9e8dc-1df7-3ff8-9603-058d9468943a",
                                        "glosses": [
                                            "Trier le bon du mauvais, arrêter le mauvais pour ne laisser passer que le bon, ou au contraire, retenir le bon en laissant partir le mauvais."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23680514-c3b3-4d59-8d72-d5285f138c5f",
                                                "sense_id": "ff1e5c02-d1f9-38a8-9bbb-e19dfa18ea38",
                                                "text": "Le jus déféqué est filtré sur du noir animal en grains qui le débarrasse d'une grande partie de ses matières colorantes, […]."
                                            },
                                            {
                                                "example_id": "cb833197-0c7d-44d3-b443-24d14454b41e",
                                                "sense_id": "ff1e5c02-d1f9-38a8-9bbb-e19dfa18ea38",
                                                "text": "Le service d’ordre filtre les invités."
                                            },
                                            {
                                                "example_id": "6296f31f-72bc-4ddb-93f3-093c07fbd0c5",
                                                "sense_id": "ff1e5c02-d1f9-38a8-9bbb-e19dfa18ea38",
                                                "text": "Les chercheurs d’or filtrent l’eau des rivières pour retenir les pépites."
                                            }
                                        ]
                                    },
