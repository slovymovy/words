                        "source_sense_id": "94fd9135-3b9e-3db3-9b1f-359e8156675d",
                        "source_sense_description": "ehemals: Staat auf der südostasiatischen Insel Timor",
                        "target_lang_word": "Timor oriental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Timor oriental",
