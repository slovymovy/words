                "senses": [
                    {
                        "sense_id": "45444449-b464-3659-9465-b582f835d3c8",
                        "entry_id": "caf0487e-8197-31ba-b2f0-9a79192d2eff",
                        "glosses": [
                            "Qui ne peut être analysé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfc2b4e-a4db-46c3-ad72-9cc90f6a5370",
                                "sense_id": "45444449-b464-3659-9465-b582f835d3c8",
                                "text": "[…], non seulement la morte ne dégagea aucune odeur de putréfaction, mais encore elle continua à embaumer, comme de son vivant, une senteur inanalysable, exquise."
                            },
                            {
                                "example_id": "db889f85-ac2f-4095-81e4-1b1b3ed3a6d3",
                                "sense_id": "45444449-b464-3659-9465-b582f835d3c8",
                                "text": "Il pesa un à un ses moindres mots, ses regards, mille choses inanalysables et cependant expressives."
                            },
                            {
                                "example_id": "978d3761-95a2-4e1d-be39-731e2ee28152",
                                "sense_id": "45444449-b464-3659-9465-b582f835d3c8",
                                "text": "Je ne parle ici que selon la chair. S'il est question de tout un ensemble de transmissions plus inanalysables, c'est de la terre entière que nous sommes les légataires universels."
                            },
                            {
                                "example_id": "2d720050-52c9-4e55-ba47-dfe14e407374",
                                "sense_id": "45444449-b464-3659-9465-b582f835d3c8",
                                "text": "Il est également intéressant de noter que même certains mots de base, qui dans la plupart des langues correspondent à des mots inanalysables, sont des composés."
                            }
                        ]
                    }
                ],
