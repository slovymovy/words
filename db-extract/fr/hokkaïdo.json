                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hokkaido",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64f9377b-1759-3b6a-839c-a5813e5affe2",
                                        "entry_id": "3b54920b-5fbc-36cf-9a25-c9a44e90f260",
                                        "glosses": [
                                            "The second largest island of Japan, capital Sapporo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9cd7ba-6d1c-465d-888f-d71a589555cd",
                                                "sense_id": "64f9377b-1759-3b6a-839c-a5813e5affe2",
                                                "text": "In the past, the Ainu (their selfname meaning 'person'), traditionally huntergatherers, occupied not only Hokkaido but also a considerable part of the island of Honshu until the middle the eighteenth century, […]"
                                            },
                                            {
                                                "example_id": "5b58e3c5-027e-4f07-88c6-23911f96bf3e",
                                                "sense_id": "64f9377b-1759-3b6a-839c-a5813e5affe2",
                                                "text": "I took another look at the map, impressed by how useful random modern Earth knowledge was in this world. Tsia Mountain, which contained our dungeon, was within the Empire’s territory. Using the size of the mountain to estimate distance… Yeah, the Empire was pretty huge. How many Hokkaidos could even fit in here? More than a few. Not to mention that there’s dozens of dungeons marked on the map."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hokkaido",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef7288c6-5862-3c46-9b96-3ec99964a0e8",
                                        "entry_id": "fecf4ca5-fe41-3305-a2d8-c516acee1727",
                                        "glosses": [
                                            "A breed of dog originating from Japan, resembling a spitz dog breed, although not officially ranked as a spitz dog breed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a31afc5-a15b-400f-bfff-9e38adcb5f27",
                                                "sense_id": "ef7288c6-5862-3c46-9b96-3ec99964a0e8",
                                                "text": "[…] Hokkaidos or Ainus (smaller versions of the Akita); Akitas, Japanese Spitz, Japanese Chin, Nippon Terriers and Kai Ken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
