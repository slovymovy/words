{
    "word_family": [
        "emery-cloth",
        "emery-paper",
        "emery-wheel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a94fd433-e075-34a6-8cb5-ba5bc7b7044f",
                    "sense_definition": "An impure type of corundum, often used for sanding or polishing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abrasives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman used a fine <w>emery</w> to smooth the edges of the metal blade.",
                            "target_lang_translations": {
                                "ru": "Мастер использовал мелкий <w>наждак</w>, чтобы сгладить края металлического лезвия."
                            }
                        },
                        {
                            "text": "You can buy <w>emery</w> paper at any hardware store for your woodworking project.",
                            "target_lang_translations": {
                                "ru": "Вы можете купить <w>наждачную</w> бумагу в любом хозяйственном магазине для вашего столярного проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emery paper",
                        "emery board",
                        "emery cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечистый вид корунда, часто используемый для шлифовки или полировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наждак",
                                "target_lang_sense_clarification": "минерал для шлифовки"
                            },
                            {
                                "target_lang_word": "наждачный порошок",
                                "target_lang_sense_clarification": "абразивный материал"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90c04fbc-f5c1-3174-b7db-eefa7578d379",
                    "sense_definition": "To sand or polish with emery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "polishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon <w>emerying</w> the rusted surface until it shone again.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>шлифуя наждаком</w> заржавевшую поверхность, пока она снова не заблестела."
                            }
                        },
                        {
                            "text": "The technician will <w>emery</w> the contact points to ensure a better electrical connection.",
                            "target_lang_translations": {
                                "ru": "Техник <w>зачистит наждаком</w> точки контакта, чтобы обеспечить лучшее электрическое соединение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шлифовать или полировать с помощью наждака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлифовать наждаком",
                                "target_lang_sense_clarification": "обрабатывать поверхность"
                            },
                            {
                                "target_lang_word": "чистить наждаком",
                                "target_lang_sense_clarification": "удалять неровности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e1bd2a-ba1e-3a3f-9e12-8aab0cdd0a5a",
                    "sense_definition": "To coat with emery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industrial wheel was <w>emeried</w> to provide a more abrasive surface for grinding.",
                            "target_lang_translations": {
                                "ru": "Промышленное колесо было <w>покрыто наждаком</w>, чтобы обеспечить более абразивную поверхность для шлифования."
                            }
                        },
                        {
                            "text": "They decided to <w>emery</w> the fabric to create a specialized cleaning tool.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>нанести наждачное покрытие</w> на ткань, чтобы создать специальный инструмент для чистки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать слоем наждака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать наждаком",
                                "target_lang_sense_clarification": "наносить абразивный слой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d7fd87b3-2baf-32ea-bb26-ccd0f2cd8a41",
                    "sense_definition": "A male given name from the Germanic languages.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My grandfather's name was <w>Emery</w>, which was quite common in his generation.",
                            "target_lang_translations": {
                                "ru": "Моего дедушку звали <w>Эмери</w>, это имя было довольно распространено в его поколении."
                            }
                        },
                        {
                            "text": "Young <w>Emery</w> decided to follow in his father's footsteps and become a doctor.",
                            "target_lang_translations": {
                                "ru": "Юный <w>Эмери</w> решил пойти по стопам отца и стать врачом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя германского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмери",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a14286-b903-3a4a-a877-b6396d9217b7",
                    "sense_definition": "A surname transferred from the given name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Emery</w> published a groundbreaking study on historical linguistics last year.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Эмери</w> опубликовал в прошлом году новаторское исследование по исторической лингвистике."
                            }
                        },
                        {
                            "text": "The <w>Emery</w> family has lived in this small village for over three centuries.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Эмери</w> живет в этой маленькой деревне уже более трех веков."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Derived from the given name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, произошедшая от личного имени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмери",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cb0b622-cba2-33bc-b81d-bac33c665a8f",
                    "sense_definition": "A female given name transferred from the surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personal_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They named their daughter <w>Emery</w> because they liked its modern and unique sound.",
                            "target_lang_translations": {
                                "ru": "Они назвали свою дочь <w>Эмери</w>, потому что им понравилось её современное и уникальное звучание."
                            }
                        },
                        {
                            "text": "Little <w>Emery</w> started kindergarten this week and already made many friends.",
                            "target_lang_translations": {
                                "ru": "Маленькая <w>Эмери</w> пошла в детский сад на этой неделе и уже завела много друзей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, перешедшее из фамилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмери",
                                "target_lang_sense_clarification": "женское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3924e383-e0f8-31ce-86cf-cd8dfb3ac71e",
                    "sense_definition": "A town in Emery County, Utah, United States.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small town of <w>Emery</w> is located in the heart of Utah's coal country.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Эмери</w> расположен в самом сердце угольного края штата Юта."
                            }
                        },
                        {
                            "text": "We drove through <w>Emery</w> while exploring the scenic landscapes of the American West.",
                            "target_lang_translations": {
                                "ru": "Мы проезжали через <w>Эмери</w>, исследуя живописные пейзажи американского Запада."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Эмери, штат Юта, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмери",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51bb9b49-65bb-34cf-80c1-9e2348060745",
                    "sense_definition": "A neighborhood in Toronto, Canada, also known as Humbermede.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The <w>Emery</w> area of Toronto has seen significant residential development in recent years.",
                            "target_lang_translations": {
                                "ru": "Район <w>Эмери</w> в Торонто в последние годы пережил значительную жилую застройку."
                            }
                        },
                        {
                            "text": "Many locals still refer to the Humbermede district by its older name, <w>Emery</w>.",
                            "target_lang_translations": {
                                "ru": "Многие местные жители до сих пор называют район Хамбермид его старым названием — <w>Эмери</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Humbermede"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Район в Торонто, Канада, также известный как Хамбермид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмери",
                                "target_lang_sense_clarification": "название района"
                            }
                        ]
                    }
                }
            ]
        }
    ]
