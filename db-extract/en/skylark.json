                            {
                                "target_word": "Feldlerche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5510fef8-a661-3569-b1c4-ad57a6eaec8f",
                                        "entry_id": "946da0b8-5284-3817-9c65-b8b4eec96d77",
                                        "glosses": [
                                            "erdbrauner Vogel aus der Familie der Lerchen, der häufig auf Feldern und Äckern brütet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae2f342d-ea0e-4bdc-bff2-ceec4a630454",
                                                "sense_id": "5510fef8-a661-3569-b1c4-ad57a6eaec8f",
                                                "text": "Die Feldlerche ist noch relativ häufig bei uns anzutreffen."
                                            },
                                            {
                                                "example_id": "750f2791-97ef-4671-bfcb-4b46a6aeede1",
                                                "sense_id": "5510fef8-a661-3569-b1c4-ad57a6eaec8f",
                                                "text": "Neben dem Hamster leiden auch die sogenannten Ackervögel wie Feldlerche und Rebhuhn unter einer Landwirtschaft, die über die Jahrzehnte hinweg immer lebensfeindlicher geworden ist."
                                            },
                                            {
                                                "example_id": "21b68bf0-f067-4036-89b1-6ccf08aad8c2",
                                                "sense_id": "5510fef8-a661-3569-b1c4-ad57a6eaec8f",
                                                "text": "[Vogel des Jahres 2019:] Es kommt selten vor, dass wir einen Vogel zum zweiten Mal als Vogel des Jahres ausrufen. Die Feldlerche war es schon einmal, und zwar 1998. Schon damals warnten wir davor, dass [sie] in vielen Gebieten Deutschlands selten oder gar aussterben wird."
                                            },
                                            {
                                                "example_id": "b09ea64b-5379-45bd-8613-563226c1e0a0",
                                                "sense_id": "5510fef8-a661-3569-b1c4-ad57a6eaec8f",
                                                "text": "Die Pfalz ist die Frühkartoffel- und Gemüsekammer der Nation – mit endlosen Ackerflächen. Am Horizont einige Windräder, aber kaum ein Baum, kaum eine Hecke. Am Himmel: keine Feldlerche. Zu hören: kein Gezwitscher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
