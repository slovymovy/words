                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208dbd57-c1a3-4fc7-b60c-67fd0bad5b7a",
                                "sense_id": "3142aa5e-a512-3267-9c16-2db60fcdd6d3",
                                "text": "„Ich wusch mir am Spülbecken neben dem Herd Gesicht und Hände, kämmte mich mit der Nagelbürste, die in der Seifenschale lag, ich zog meinen Hemdkragen glatt, die Krawatte hoch und prüfte noch einmal meine Fingernägel: Sie waren sauber.“"
                            }
                        ],
