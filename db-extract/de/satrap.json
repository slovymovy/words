                ],
                "senses": [
                    {
                        "sense_id": "129a9158-9b5f-3e6c-8509-7af12422bb41",
                        "entry_id": "38f3babf-7596-3462-9b46-5592f2acd5da",
                        "glosses": [
                            "persischer Provinzstatthalter"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "cd8dd24a-b332-443e-973a-102a0accedcf",
                                "sense_id": "129a9158-9b5f-3e6c-8509-7af12422bb41",
                                "text": "Der Intendant wurde ernst, wie ein Satrap, der Provinzen verteilt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "57f2f023-b24d-30d5-83b0-3df48b5cbffa",
                        "entry_id": "38f3babf-7596-3462-9b46-5592f2acd5da",
                        "glosses": [
                            "bestechlicher, hoher Verwaltungsbeamter in einem Regime, der sein Amt missbraucht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "703c54b0-6e28-4c5f-b0af-02420f883c00",
                                "sense_id": "57f2f023-b24d-30d5-83b0-3df48b5cbffa",
                                "text": "„Während Dänemark bis zum Sommer 1943 immer noch relative Freiheit genoß, wurden Norwegen und die Niederlande […] von «Reichskommissaren», von Vertretern der NSDAP, regiert, die sowohl Satrapen als auch ideologische Bevollmächtigte waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a814acf5-9982-496b-acd9-704900d09ab2",
                        "source_entry_id": "38f3babf-7596-3462-9b46-5592f2acd5da",
                        "source_sense_id": "129a9158-9b5f-3e6c-8509-7af12422bb41",
                        "source_sense_description": "Antike: persischer Provinzstatthalter",
                        "target_lang_word": "satrap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38074f9e-b81e-39fa-95b7-f4ff92bf0861",
                                        "entry_id": "2705590c-55be-3ad5-9d55-d68c75b49e95",
                                        "glosses": [
                                            "A governor of a Persian province."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83558feb-53be-44fd-abda-c673d8cd5f07",
                                                "sense_id": "38074f9e-b81e-39fa-95b7-f4ff92bf0861",
                                                "text": "Eunuchs were chiefly employed in the harems of the king, and his satraps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81acd39e-f1a5-334f-b4ff-a85c7141fa49",
                                        "entry_id": "2705590c-55be-3ad5-9d55-d68c75b49e95",
                                        "glosses": [
                                            "A subordinate ruler."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4141b790-bfbc-46ff-ac6c-82ae01dc8c8a",
                                                "sense_id": "81acd39e-f1a5-334f-b4ff-a85c7141fa49",
                                                "text": "Hey, sir? Sir, excuse me?” The blonde was calling out to him, in imperious tones that insisted on a reply. Her satraps became watchful, like a Praetorian guard."
                                            },
                                            {
                                                "example_id": "fd3a23c1-694f-44aa-92f1-db17dde021f3",
                                                "sense_id": "81acd39e-f1a5-334f-b4ff-a85c7141fa49",
                                                "text": "Backed by an expansive and brutal security system, Mr. Lukashenko shows no sign of losing his grip at home, if at the cost of becoming Mr. Putin’s enfeebled satrap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b52be9b-ddcf-4554-bccd-b544d1f1d018",
                        "source_entry_id": "38f3babf-7596-3462-9b46-5592f2acd5da",
                        "source_sense_id": "129a9158-9b5f-3e6c-8509-7af12422bb41",
                        "source_sense_description": "Antike: persischer Provinzstatthalter",
                        "target_lang_word": "satrape",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satrape",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f6fee16-5d05-3b8a-983f-455c926b4c16",
                                        "entry_id": "9c2375b0-6aeb-33c9-81b0-c861cc2fc67b",
                                        "glosses": [
                                            "Titre des gouverneurs de province, chez les anciens Perses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c8a9298-c079-473f-b5d9-152337cc2d62",
                                                "sense_id": "2f6fee16-5d05-3b8a-983f-455c926b4c16",
                                                "text": "Tissapherne vint ensuite dans l’Hellespont ; Alcibiade va vers lui avec une seule trirème, apportant les présens de l’hospitalité et ceux de l’amitié ; le satrape le fait arrêter sur un prétendu ordre du roi, qui voulait qu’on traitât les Athéniens en ennemis."
                                            },
                                            {
                                                "example_id": "1cee5eb9-a7f1-43f6-862a-ef6f3834e606",
                                                "sense_id": "2f6fee16-5d05-3b8a-983f-455c926b4c16",
                                                "text": "Le satrape de Syrie voulut m'en déposséder ; mais j'étais déjà bien trop riche pour avoir rien à craindre : je donnai de l'argent au satrape, moyennant quoi je conservai ce château..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29548784-a422-37c2-ad00-b5799bb7763c",
                                        "entry_id": "9c2375b0-6aeb-33c9-81b0-c861cc2fc67b",
                                        "glosses": [
                                            "Personnage qui exerce une autorité despotique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8937db7-891f-469b-906d-e7517d513df0",
                                                "sense_id": "29548784-a422-37c2-ad00-b5799bb7763c",
                                                "text": "Un éventuel échec [au Mali] réduirait le rôle de la France à celui d’un satrape régional."
                                            },
                                            {
                                                "example_id": "9daa6cbc-dc72-4af0-a09c-537f2b5b3c8c",
                                                "sense_id": "29548784-a422-37c2-ad00-b5799bb7763c",
                                                "text": "Le satrape tchétchène Kadyrov alimente la spéculation sur son avenir … Ramzan Kadyrov, caricature du roitelet corrompu et mafieux, vit-il ses dernières heures ? Est-il devenu trop embarrassant pour le Kremlin à force de provocations et de déclarations tonitruantes ?"
                                            },
                                            {
                                                "example_id": "a3634891-8e9b-4056-8b9a-55706a3ad108",
                                                "sense_id": "29548784-a422-37c2-ad00-b5799bb7763c",
                                                "text": "La faiblesse du califat permit aux gouverneurs de provinces et autres satrapes d’usurper le pouvoir et de fonder ainsi, à leur gré, des dynasties de courte ou de longue durée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcb0ce64-c25b-32f2-a57d-8dfc9448fa41",
                                        "entry_id": "9c2375b0-6aeb-33c9-81b0-c861cc2fc67b",
                                        "glosses": [
                                            "Personne très riche qui mène grand train."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7266694d-b27e-435c-9996-8fe69f93c227",
                                                "sense_id": "fcb0ce64-c25b-32f2-a57d-8dfc9448fa41",
                                                "text": "Selon lui, les satrapes aux commandes des gazettes et des enquêtes d’opinion ont « faussé le jeu démocratique et galvaudé la réalité, conditionnant les consciences à gros coup (sic) de renfort médiatique, pour favoriser un ou plusieurs candidats du sérail. »."
                                            },
                                            {
                                                "example_id": "c576b2a0-6a31-438a-857b-b1092b059581",
                                                "sense_id": "fcb0ce64-c25b-32f2-a57d-8dfc9448fa41",
                                                "text": "L’arrivée dans l’édition de cet homme d’affaires à la réputation de satrape a curieusement provoqué peu d’émoi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b651c31-3f98-371c-962d-4c2094a6f143",
                                        "entry_id": "9c2375b0-6aeb-33c9-81b0-c861cc2fc67b",
                                        "glosses": [
                                            "Titre porté par certains membres du collège de pataphysique."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce9621b0-583e-4fbf-a3b3-2186fb2d31cb",
                                                "sense_id": "5b651c31-3f98-371c-962d-4c2094a6f143",
                                                "text": "Il est promu satrape par le Collège de Pataphysique."
                                            },
                                            {
                                                "example_id": "b3225c18-37cd-419c-9bdf-c06c69dc89de",
                                                "sense_id": "5b651c31-3f98-371c-962d-4c2094a6f143",
                                                "text": "Cher Paul Émile Victor, transcendant satrape du collège de pataphysique, je t’aimais, quand aux côtés de Boris Vian, de Raymond Queneau, d’Eugène Ionesco, de Jean Dubuffet et de bien d’autres, sur les traces de Jules Verne et d’Alfred Jarry, tu célébrais le centenaire de la découverte du pôle Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b874a8-9d6e-479e-ac29-a1abf3fef276",
