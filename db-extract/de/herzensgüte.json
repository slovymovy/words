                "senses": [
                    {
                        "sense_id": "43064264-19fa-3dde-b42e-bd0be4a44950",
                        "entry_id": "174b2a79-e4c1-3add-a109-9ec03b53c3c3",
                        "glosses": [
                            "große, von Herzlichkeit und Zuneigung geprägte Güte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31148ad5-753e-4c51-afd1-bea672d7bf78",
                                "sense_id": "43064264-19fa-3dde-b42e-bd0be4a44950",
                                "text": "„Die Herzensgüte meiner Oma entfaltete sich an dem großen gusseisernen Ofen, auf dem sie von morgens bis abends kochte, und mein Opa machte Späße dazu, auch von morgens bis abends.“"
                            },
                            {
                                "example_id": "ac817052-e4df-4a78-b0cf-3e96f76cc538",
                                "sense_id": "43064264-19fa-3dde-b42e-bd0be4a44950",
                                "text": "„Sie schrieb das seiner zarten Verschämtheit und Herzensgüte zu, die ihrer Meinung nach allen anderen Menschen genau ebenso galt wie ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
