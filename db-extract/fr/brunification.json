                        "glosses": [
                            "Processus de formation des sols mettant en place un complexe argilo-humique avec pont ferreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a28336-c797-4563-9124-a6cfb55adef1",
                                "sense_id": "16986173-c0de-3bc4-a787-0c1180f0e973",
                                "text": "Rappelons que sur serpentine à l’étage alpin de Davos, la phase la plus développée des sols, la brunification des ranker, est liée à une situation colluviale (non engorgée)."
                            },
                            {
                                "example_id": "c0e75266-6c2d-4267-9cca-2aa3feff21a0",
                                "sense_id": "16986173-c0de-3bc4-a787-0c1180f0e973",
                                "text": "Les horizons supérieurs (A et S) présentent des caractères de brunification sur une faible épaisseur (couleur brune, libération de fer amorphe ou cryptocristallin) ; l’horizon A est grumeleux ou à tendance grumeleuse ; l’épisolum humifère est un mull. Cette brunification peut être due à une altération plus intense ou à un matériau parental initialement plus riche en illite."
                            }
                        ]
                    }
