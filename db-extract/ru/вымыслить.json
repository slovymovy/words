                "senses": [
                    {
                        "sense_id": "6efad5fa-d6ef-3eb3-aabb-1ba8d791e1e2",
                        "entry_id": "68feae80-719c-322c-ba2d-5b734f47ee76",
                        "glosses": [
                            "устар. создать воображением; выдумать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1171ab7-cd96-46c5-90bb-9ab10b45f1e8",
                                "sense_id": "6efad5fa-d6ef-3eb3-aabb-1ba8d791e1e2",
                                "text": "Смерти его было причиною следующее обстоятельство: он получил повеление вымыслить и расположить публичный маскерад для увеселения народного, который он и сочинил под именем «Торжествующия Минервы»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9334b3cd-bb3b-4fd5-b318-6528a24d38d7",
                        "source_entry_id": "68feae80-719c-322c-ba2d-5b734f47ee76",
                        "source_sense_id": "6efad5fa-d6ef-3eb3-aabb-1ba8d791e1e2",
                        "target_lang_word": "fabricate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabricate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f812f38-9362-3ac7-9205-30126d824a12",
                                        "entry_id": "0f0ae936-2235-3fcb-aa75-8bc4e6bd45ba",
                                        "glosses": [
                                            "To form into a whole by uniting its parts; to construct; to build."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7859d0-4ecc-43d1-817e-7e40bb21315b",
                                                "sense_id": "3f812f38-9362-3ac7-9205-30126d824a12",
                                                "text": "to fabricate a bridge or ship"
                                            },
                                            {
                                                "example_id": "ca002405-8cda-4fcb-8bff-207e0675ef10",
                                                "sense_id": "3f812f38-9362-3ac7-9205-30126d824a12",
                                                "text": "The bronze that formerly ornamented this temple was made use of to fabricate the baldachin of St Peter's."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122b022f-97e9-32a5-a49c-f35f01bf0c08",
                                        "entry_id": "0f0ae936-2235-3fcb-aa75-8bc4e6bd45ba",
                                        "glosses": [
                                            "To form by art and labor; to manufacture; to produce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bff0923-bfea-4565-8abb-7e2a05f5b900",
                                                "sense_id": "122b022f-97e9-32a5-a49c-f35f01bf0c08",
                                                "text": "to fabricate computer chips"
                                            },
                                            {
                                                "example_id": "9fa3b219-a37e-47d1-9168-5d1ce935ad53",
                                                "sense_id": "122b022f-97e9-32a5-a49c-f35f01bf0c08",
                                                "text": "The omni-tool itself is a combination computer and general-purpose engineering device that fabricates tools and equipment as needed. It acts as a translator, computer, holographic recorder and player, full translation software, and can create lockpicks and any other equipment needed to use a character's skills. An omni-tool can be upgraded with a number of options."
                                            },
                                            {
                                                "example_id": "0323ce8b-3320-423e-83f7-e9bdca0ef240",
                                                "sense_id": "122b022f-97e9-32a5-a49c-f35f01bf0c08",
                                                "text": "Planar metamaterials with subwavelength thickness, or metasurfaces, consisting of single-layer or few-layer stacks of planar structures, can be readily fabricated using lithography and nanoprinting methods, and the ultrathin thickness in the wave propagation direction can greatly suppress the undesirable losses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d986796f-e1c6-3812-a1d0-df8629b75689",
                                        "entry_id": "0f0ae936-2235-3fcb-aa75-8bc4e6bd45ba",
                                        "glosses": [
                                            "To invent and form; to forge; to devise falsely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6b3eae-7db3-491c-a47a-1862d4d66db2",
                                                "sense_id": "d986796f-e1c6-3812-a1d0-df8629b75689",
                                                "text": "to fabricate a lie or story"
                                            },
                                            {
                                                "example_id": "945a1469-a63a-4edf-8c7f-b3f2d8bb28ea",
                                                "sense_id": "d986796f-e1c6-3812-a1d0-df8629b75689",
                                                "text": "Both sites, with their ad-laden interfaces emphasizing information about pregnancy, baby names, celebrity moms, and family fun, reflect pervasive concerns about the roles that adults, particularly women, play in creating the conditions of childhood. These concerns are illustrated by the desire of the aforementioned mom-bloggers to curate extraordinary adult memories for their children by fabricating a mythical period of wide-eyed wonder and magical moments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b41125d7-3056-3367-9be5-6d69648f6171",
                                        "entry_id": "0f0ae936-2235-3fcb-aa75-8bc4e6bd45ba",
                                        "glosses": [
                                            "To cut up an animal as preparation for cooking, particularly used in reference to fowl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d8bd735-edd8-4775-8688-244616725548",
                        "source_entry_id": "68feae80-719c-322c-ba2d-5b734f47ee76",
                        "source_sense_id": "6efad5fa-d6ef-3eb3-aabb-1ba8d791e1e2",
                        "target_lang_word": "invent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b677810-2bdc-3a52-8f2c-d7d21ff03bce",
                                        "entry_id": "80ca486e-8f27-3c93-9e4f-f9f7a4cc7b2e",
                                        "glosses": [
                                            "To design a new process or mechanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a37dad69-dcc9-4416-98d1-465803293fc2",
                                                "sense_id": "2b677810-2bdc-3a52-8f2c-d7d21ff03bce",
                                                "text": "After weeks of hard work, I invented a new way to alphabetize matchbooks."
                                            },
                                            {
                                                "example_id": "955d8ab1-ea26-4477-9dcc-b5d6d0aab036",
                                                "sense_id": "2b677810-2bdc-3a52-8f2c-d7d21ff03bce",
                                                "text": "Accurſt be he that firſt inuented war"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5a7f06-ee57-3651-a06c-b3be3cf9b6a9",
                                        "entry_id": "80ca486e-8f27-3c93-9e4f-f9f7a4cc7b2e",
                                        "glosses": [
                                            "To create something fictional for a particular purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b04417-9c58-4789-856a-25f3586b7ec1",
                                                "sense_id": "7c5a7f06-ee57-3651-a06c-b3be3cf9b6a9",
                                                "text": "I knew I had to invent an excuse, and quickly."
                                            },
                                            {
                                                "example_id": "0d634ee5-22b6-45c8-a78c-ec6283ef6c94",
                                                "sense_id": "7c5a7f06-ee57-3651-a06c-b3be3cf9b6a9",
                                                "text": "We need a name to put in this form, so let's just invent one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc1d1059-b9f4-36cb-8c0f-632c31318e02",
                                        "entry_id": "80ca486e-8f27-3c93-9e4f-f9f7a4cc7b2e",
                                        "glosses": [
                                            "To come upon; to find; to discover."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf06f09-86ce-45b3-86d3-32a3bb07e599",
                                                "sense_id": "dc1d1059-b9f4-36cb-8c0f-632c31318e02",
                                                "text": "Far off he wonders, what them makes so glad, / If Bacchus merry fruit they did inuent [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09406023-48f5-4a74-8c73-75d5270eb952",
                        "source_entry_id": "68feae80-719c-322c-ba2d-5b734f47ee76",
