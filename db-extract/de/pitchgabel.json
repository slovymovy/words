                                        "sense_id": "669e74b1-09e0-3e68-a5be-7ddc25bf0e6e",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "An agricultural tool comprising a fork with sparse, light tines, attached to a long handle, used for pitching hay (especially loose hay) high up onto a stack (as on a wagon or haystack, or into a haymow)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dc54f89-7f01-3b8f-af75-cc6bb492bfdc",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "A similar fork with slightly more and heavier tines, used for mucking stalls and pitching soiled bedding into a wagon or manure spreader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e349f72-bc2f-4811-9840-52f398d26462",
                                                "sense_id": "7dc54f89-7f01-3b8f-af75-cc6bb492bfdc",
                                                "text": "After my second illness, being too old for “piggy-back rides”, I generally sat in 'Resting Nuke' on a seat naturally formed in a low branch of a cedar, watching relatives down in the bay with pitchforks furiously digging out long black slithery \"cockworms\" from the muddy sands of Sinky Bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af938f4-0c3b-38d1-a72a-8267b414e70b",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "Any fork used for farm labor, even a digging fork (but such usage is often considered ignorant by experienced farmers)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "690b8f3f-e46a-3b8b-8b7e-42e4ecd4f2a6",
                                        "entry_id": "250a89e5-4ce7-3002-a5d8-742fe48848f4",
                                        "glosses": [
                                            "A tuning fork."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de55f4a3-14ca-46e0-8143-d2db29b8eb3e",
                                                "sense_id": "690b8f3f-e46a-3b8b-8b7e-42e4ecd4f2a6",
                                                "text": "I went around with a pitchfork [tuning fork] in my pocket, and I'd hit it whenever I thought of it, and I developed perfect pitch […]"
                                            }
                                        ]
                                    }
                                ]
