        "fr-extract.jsonl": [
            {
                "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                "word": "sellerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b581440-35af-4089-b9bf-c96744736b61",
                        "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "selleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ceb7b5a-88a2-349d-8d8b-238fc1f45d20",
                        "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "glosses": [
                            "Lieu où l’on serre les selles et les harnais des chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f4cda0-8173-4ab4-a78d-a71f6b2a6b0b",
                                "sense_id": "6ceb7b5a-88a2-349d-8d8b-238fc1f45d20",
                                "text": "J’allai dans la sellerie où je choisis des courroies solides dont j’éprouvai la force de résistance […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "59d2dace-11aa-34ab-a4e3-5f7d54bcaa1c",
                        "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "glosses": [
                            "Fabrication et du commerce des selles et des harnais."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bc01b7f8-491e-3a68-84fc-893dbb4cf463",
                        "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "glosses": [
                            "Ouvrages qui se font pour l’équipement et le harnachement des chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f396810-1e9a-4fc8-ae16-add7c5cc6342",
                                "sense_id": "bc01b7f8-491e-3a68-84fc-893dbb4cf463",
                                "text": "Ouvrier en sellerie. — Il avait l’entreprise de la sellerie des écuries du roi."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f625e2a-e381-3bfc-aa26-786366b18b91",
                        "entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "glosses": [
                            "fabrication de sièges, canapés, fauteuils, etc. généralement en cuir (peau)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ae2f793-7378-4a3f-a035-1f9f9913d4ae",
                        "source_entry_id": "2ee87761-bc2f-3f94-906c-23e2060f85cf",
                        "target_lang_word": "saddlery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saddlery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e77114cc-6f6d-3204-a45f-7fd84c7d6b29",
                                        "entry_id": "1163434b-bf52-3663-b0a4-0e2fe27eb201",
                                        "glosses": [
                                            "The trade or craft of a saddler."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd24f393-250f-411e-8656-a7b11b0eb9a6",
                                                "sense_id": "e77114cc-6f6d-3204-a45f-7fd84c7d6b29",
                                                "text": "A good deal of dressed leather is now sent to London, from whence formerly much of what was used here was brought. Saddlery is carried on to some extent."
                                            },
                                            {
                                                "example_id": "7413236f-a29a-432a-80c3-47f85859377e",
                                                "sense_id": "e77114cc-6f6d-3204-a45f-7fd84c7d6b29",
                                                "text": "1863, Rachel Henning, letter dated 27 January, 1863, in David Adams (ed.), The Letters of Rachel Henning, Penguin, 1969, p. 124,\nThe whole station is engaged in saddlery just now. It is wonderful how soon people learn to do everything for themselves in the bush."
                                            },
                                            {
                                                "example_id": "0661a270-54d1-4109-91c9-057d81c28d50",
                                                "sense_id": "e77114cc-6f6d-3204-a45f-7fd84c7d6b29",
                                                "text": "He resolved that when winter came he would go into one of the regimental workshops and learn a trade, either saddlery or ferriery, which would enable him to earn his living for a time abroad until he saw something better to do."
                                            },
                                            {
                                                "example_id": "ee216142-2454-453b-9886-b3ae23e7bdb8",
                                                "sense_id": "e77114cc-6f6d-3204-a45f-7fd84c7d6b29",
                                                "text": "He traveled almost altogether afoot, observing the strictest economy and supporting himself by occasional jobs of saddlery and harness mending."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f00393e-535c-3647-82e6-75ea7b101237",
                                        "entry_id": "1163434b-bf52-3663-b0a4-0e2fe27eb201",
                                        "glosses": [
                                            "A place of business of a saddler."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06989fa3-1768-481d-8567-02f94bb3a231",
                                                "sense_id": "6f00393e-535c-3647-82e6-75ea7b101237",
                                                "text": "There is a tinker’s shop and a pharmacy; a saddlery, where the broken gear used in cultivating the monastery lands is mended […]"
                                            },
                                            {
                                                "example_id": "b26caeae-43f5-45de-9941-ae38612a5d43",
                                                "sense_id": "6f00393e-535c-3647-82e6-75ea7b101237",
                                                "text": "1931, Ruth Russell, Lake Front, Chicago: Thomas S. Rockwell, Part 3, Chapter 2, p. 209,\nOccasional stores pressed close to the wooden walk, and you got the dry smell of hay-and-feed shops or leathery whiffs from saddleries […]"
                                            },
                                            {
                                                "example_id": "d1189539-e8cb-4b5b-9028-b30ed04f6dae",
                                                "sense_id": "6f00393e-535c-3647-82e6-75ea7b101237",
                                                "text": "Although there are saddleries in almost every Montana town, only a few have national reputations and are convenient for travelers to visit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                        "entry_id": "1163434b-bf52-3663-b0a4-0e2fe27eb201",
                                        "glosses": [
                                            "The inventory and equipment of a saddler; saddles and other horse-riding equipment, or the materials for making them."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60af83e4-32b4-49d1-bae0-b9b705d1eb59",
                                                "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                                "text": "Near-synonym: tack"
                                            },
                                            {
                                                "example_id": "387356d2-4f49-4554-bb61-c0c5ce0f4bc9",
                                                "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                                "text": "The next article, and the most important article of all to this country, was saddlery. This embraced every part of the leather manufacture, boots, shoes, gloves, &c."
                                            },
                                            {
                                                "example_id": "64872af1-3b1f-4177-bf39-0b103f6d7641",
                                                "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                                "text": "[…] we notice that the most gorgeous piece of Japanese saddlery is the crupper, which, even on a pack-horse, is painted crimson and gilded gloriously."
                                            },
                                            {
                                                "example_id": "8ca73380-d607-4bc8-9a48-1cc71ff2bc34",
                                                "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                                "text": "A heap of saddlery was thrown in a corner, and from this each man, as he captured his mount, made shift to draw proper equipment […]"
                                            },
                                            {
                                                "example_id": "c655f098-5217-453a-8aeb-93412614ae14",
                                                "sense_id": "647694c9-f30e-3b7b-941f-4a6bdab833aa",
                                                "text": "He heard the creak of saddlery and the thud of a horse’s hoofs on the hard turf behind him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c3d0105-80f8-4054-ab95-66acaa460448",
