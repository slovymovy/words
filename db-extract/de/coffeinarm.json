                ],
                "senses": [
                    {
                        "sense_id": "2fde9363-fd2d-3b62-a9e3-f9b154ae0f81",
                        "entry_id": "142b40dd-37fc-3ef6-b0a4-7215a1369625",
                        "glosses": [
                            "nur wenig Coffein enthaltend; arm an Coffein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e978b16d-da48-4a95-b133-2ab69b8c344a",
                                "sense_id": "2fde9363-fd2d-3b62-a9e3-f9b154ae0f81",
                                "text": "„Der coffeinarme Kaffee unter der Schutzmarke ‚Rettungsring‘ soll weder an Aroma noch an Geschmack eingebüßt haben.“"
                            },
                            {
                                "example_id": "f4a41b5d-0dd3-43a2-943e-507f8f452b5c",
                                "sense_id": "2fde9363-fd2d-3b62-a9e3-f9b154ae0f81",
                                "text": "„Coffeinempfindliche Menschen bevorzugen nicht selten coffeinfreien oder coffeinarmen Kaffee.“"
                            },
                            {
                                "example_id": "5d5927d8-ce8b-4258-a051-053f2a37a376",
                                "sense_id": "2fde9363-fd2d-3b62-a9e3-f9b154ae0f81",
                                "text": "„Es empfiehlt sich daher, daß herzschwache und empfindliche Menschen coffeinfreien oder coffeinarmen Kaffee zu sich nehmen, der aber die Geruchs- und Geschmacksstoffe des Kaffees noch aufweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
