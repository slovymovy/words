                        "examples": [
                            {
                                "example_id": "ccc9817d-eec1-4b08-b647-1dabe3fa1fbd",
                                "sense_id": "b52f0c43-5930-3b7c-8b57-7df8ce7007de",
                                "text": "Daarmee was het overduidelijk geworden dat hij onschuldig was."
                            },
                            {
                                "example_id": "dc9779dd-ef0d-42a1-a1a1-6c5194400b08",
                                "sense_id": "b52f0c43-5930-3b7c-8b57-7df8ce7007de",
                                "text": "Hij zat erbij als een man die overduidelijk geen maaltijd oversloeg en die ook voor het overige beter wist dan wie ook wat goed was voor hemzelf en de wereld."
                            }
                        ]
                    }
