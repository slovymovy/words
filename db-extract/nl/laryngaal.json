                        "target_lang_word": "hrtanový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hrtanový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
