                "senses": [
                    {
                        "sense_id": "a1e87b35-2457-3473-a7d9-8bcf14bf552c",
                        "entry_id": "e44d9651-c046-367c-802b-13ae15ce4980",
                        "glosses": [
                            "eine Person, die mäht"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "b383edcb-6fdc-46f9-98d3-9b448acbd493",
                                "sense_id": "a1e87b35-2457-3473-a7d9-8bcf14bf552c",
                                "text": "„Die Mähder dort auf den blumenreichen Wiesen mähen mit ihren blitzenden Sensen; die Getreidefelder sind bereits gelb, und bald wird man die Sichel anschlagen.“"
                            },
                            {
                                "example_id": "ba0fd3da-5bf5-47f2-9a30-943dec268f12",
                                "sense_id": "a1e87b35-2457-3473-a7d9-8bcf14bf552c",
                                "text": "„Auf dem Felde ackerten Bauern und säeten Korn; gleich daneben klangen die Sicheln der Schnitter, die Sensen der Mähder, und die Arbeiter hatten ihre bunteste Sonntagstracht an.“"
                            },
                            {
                                "example_id": "054357e8-e198-4485-a857-293f7760547e",
                                "sense_id": "a1e87b35-2457-3473-a7d9-8bcf14bf552c",
                                "text": "„Johannes winkte gegen den Hügel, wo ein Mähder die Sense schulterte und ihm entgegenging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
