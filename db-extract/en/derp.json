                        "sense_id": "90f42726-5362-390d-b03e-1c5a314c64d5",
                        "entry_id": "574381be-3324-3bbd-929a-3f8d7b6ae640",
                        "glosses": [
                            "Draws attention to an act of foolishness or stupidity."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2f56c38b-5e65-4320-bdb0-13ce142232b8",
                                "sense_id": "90f42726-5362-390d-b03e-1c5a314c64d5",
                                "text": "I put chips in my soup instead of crackers. Derp."
                            },
                            {
                                "example_id": "3fc02896-7473-4a56-8ff8-7e9935a684de",
                                "sense_id": "90f42726-5362-390d-b03e-1c5a314c64d5",
                                "text": "Now that I think of it, i'm surprised that you didn't make fun of his first name as well- 'How could you believe in a guy who has a girly first name?' derp- you are a fool."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7ffffe3-7a83-39f8-bf37-2d2e11dbc980",
                        "entry_id": "574381be-3324-3bbd-929a-3f8d7b6ae640",
                        "glosses": [
                            "A placeholder for unimportant details, blah blah blah."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c5968866-b540-4916-adbb-9c30ad3e7705",
                                "sense_id": "a7ffffe3-7a83-39f8-bf37-2d2e11dbc980",
                                "text": "Rob Schneider derp dee derp. Derp dee derpity derpy derp. Until one day, a derp a derp a derp a derp."
                            },
                            {
                                "example_id": "ca417868-cece-4496-b5e7-797fbe058af7",
                                "sense_id": "a7ffffe3-7a83-39f8-bf37-2d2e11dbc980",
                                "text": "Me: Hi, remember me from SSG? Can I ask you about herping the derp?\nR1: Oh, hai Tom. Sure, that would be the derp that was herping blah blah blah..."
                            }
                        ]
                    }
