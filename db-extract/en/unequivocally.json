                "senses": [
                    {
                        "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                        "entry_id": "dff512b6-20c5-3a47-a736-0fce82a8b63f",
                        "glosses": [
                            "In a way that leaves no doubt; in an unequivocal or unambiguous manner, unquestionably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91553daf-def3-4819-88b9-eb8c21af4d0c",
                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                "text": "They strove to make their product unequivocally the best in the industry."
                            },
                            {
                                "example_id": "0b354b68-5bbb-4321-a36f-5775e32df931",
                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                "text": "'Surely, in hindsight, you realise she was an unsuitable wife for you,' he stated unequivocally.\n'Don't go there, Dad,' Luc warned, hard ruthless steel in his own eyes. 'You've lost one son. You're very close to losing another.'"
                            },
                            {
                                "example_id": "b96527f6-c8b1-4e22-b98d-31c92c34fea8",
                                "sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                                "text": "The millettioid group involves the unequivocally sustained millettioid and phaseoloid clades including numerous vital crop species, for example, the cultivated soybean […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa037201-4a98-43ab-a8d0-d2a0d14ba9e5",
                        "source_entry_id": "dff512b6-20c5-3a47-a736-0fce82a8b63f",
                        "source_sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
                        "source_sense_description": "in an unequivocal or unambiguous manner",
                        "target_lang_word": "sans conteste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans conteste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c097f5ed-1482-30d7-8fd6-498dd9ffca00",
                                        "entry_id": "cdfa1715-d443-3d49-9129-4c54c476364c",
                                        "glosses": [
                                            "Sans contestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8bd675-73c7-482e-adaf-96f4d5073190",
                                                "sense_id": "c097f5ed-1482-30d7-8fd6-498dd9ffca00",
                                                "text": "Il était sans conteste du côté des plus forts, mais il avait souvent un sens démagogique assez poussé et il savait faire la part des choses."
                                            },
                                            {
                                                "example_id": "1b7436ef-9f63-4d54-9613-2a52a2058b3e",
                                                "sense_id": "c097f5ed-1482-30d7-8fd6-498dd9ffca00",
                                                "text": "Ce pays était si vaste et riche, et si peu peuplé, qu’il appartiendrait sans conteste à ceux qui sauraient le soumettre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87e8c18d-cf8d-42f1-ac25-9971abe1d4e1",
                        "source_entry_id": "dff512b6-20c5-3a47-a736-0fce82a8b63f",
                        "source_sense_id": "10a8a3c2-5fa9-3f93-9672-d09a82d93944",
