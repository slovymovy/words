                        "entry_id": "3223d911-75d3-352b-85d7-507ead0b79dc",
                        "glosses": [
                            "Of, or relating to food, nutrition or digestion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59d633e2-71bd-4276-9164-b903f4db5405",
                                "sense_id": "304f9a13-3489-3f44-b507-737519e3856b",
                                "text": "Like Malthus and Young, [Ricardo] could not imagine that humankind would ever be totally freed from the alimentary imperative."
                            }
                        ]
                    },
