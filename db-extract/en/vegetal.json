                                            {
                                                "example_id": "fd61668e-ac1c-4635-9ed8-89d491d26441",
                                                "sense_id": "c2882755-06cf-3af4-9fa6-11b09c4d5758",
                                                "text": "Meine Mutter schwört auf pflanzliche Ernährung, ich aber brauche einmal pro Woche ein gutes Steak."
                                            },
                                            {
                                                "example_id": "2e702adf-7ce9-4917-baa9-689e6b547928",
