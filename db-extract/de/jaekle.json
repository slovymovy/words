                ],
                "senses": [
                    {
                        "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                        "entry_id": "0b0db6ff-24e4-3cb7-98ba-9c0e9900836f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0fe0dd-eca1-4f8f-9a91-0fac3f9ec297",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Frau Jaekle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2eb6ab37-516a-4997-bb1f-a8313d4ed947",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Herr Jaekle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5373a8ec-5f13-49df-9b90-94c167010f9a",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Die Jaekles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3aa62763-10e4-4891-b7de-111f424cda50",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Der Jaekle trägt nie die Schals, die die Jaekle ihm strickt."
                            },
                            {
                                "example_id": "8dd9d788-ab2b-44cb-b001-426f94f80223",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jaekle kommt, geht der Herr Jaekle.“"
                            },
                            {
                                "example_id": "11f1b52f-d98e-469c-92b1-bce184f07b60",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Jaekle kommt und geht."
                            },
                            {
                                "example_id": "128a30f8-82d1-48e6-bd0e-d6923939c65f",
                                "sense_id": "fb26e23d-cf74-310f-b9a2-0a163df309b1",
                                "text": "Jaekles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
