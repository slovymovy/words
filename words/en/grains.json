                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist skillfully <w>grains</w> the door to make the cheap wood look like expensive oak.",
                            "target_lang_translations": {
                                "ru": "Художник искусно <w>отделывает под дерево</w> дверь, чтобы дешевая древесина выглядела как дорогой дуб.",
                                "pl": "Artysta umiejętnie <w>maluje słoje</w> na drzwiach, aby tanie drewno wyglądało jak drogi dąb."
                            }
                        },
                        {
                            "text": "Sugar often <w>grains</w> and becomes crunchy if the syrup is not stirred properly while cooling.",
                            "target_lang_translations": {
                                "ru": "Сахар часто <w>кристаллизуется</w> и становится хрустящим, если сироп не помешивать должным образом во время остывания.",
                                "pl": "Cukier często <w>krystalizuje się</w> i staje się chrupiący, jeśli syrop nie jest odpowiednio mieszany podczas stygnięcia."
                            }
                        }
                    ],
