                    {
                        "translation_id": "7bca19dc-07cf-4d19-8377-8ac3cfc44bd8",
                        "source_entry_id": "ca982837-9370-3509-b964-94192f1442a6",
                        "source_sense_description": "person whose occupation specializes in the science of physics",
                        "target_lang_word": "natuurkundige",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natuurkundige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c8fd7f65-abcd-39cc-93d5-2d26966152c6",
                                        "entry_id": "556f32c5-679e-31fb-b733-14aec5ea46f8",
                                        "glosses": [
                                            "wetenschapper die de natuurkunde of fysica beoefent"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da05e35-d8a4-49a1-8031-dda2e9e88ed5",
                                                "sense_id": "c8fd7f65-abcd-39cc-93d5-2d26966152c6",
                                                "text": "Zelfs mensen die zich religieus noemen, verlaten zich op hoogopgeleide natuurkundigen en kankerspecialisten."
                                            },
                                            {
                                                "example_id": "b911406e-651c-4d93-94c5-56858475b920",
                                                "sense_id": "c8fd7f65-abcd-39cc-93d5-2d26966152c6",
                                                "text": "In het verleden was de Amerikaanse STAR-detector altijd sneller in het vinden van recordbrekende antimateriedeeltjes. ‘Elke keer als ze [het LHC-team] ergens naar op zoek gingen, waren de onderzoekers van STAR ze voor’, zegt natuurkundige Horst Stöcker van het Frankfurt Institute for Advanced Studies in Duitsland. ‘Dit is de eerste keer dat het STAR-team iets nog niet heeft gezien, maar LHC-onderzoekers wel.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "natuurkundige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f4567f-c536-33b4-8a9e-9ce97c5fc1a4",
                                        "entry_id": "79c96ada-1a5e-33e9-843d-b4774c0b6038",
                                        "glosses": [
                                            "verbogen vorm van de stellende trap van natuurkundig"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02c7c2db-7a02-4c06-8576-fff12229fc0a",
                        "source_entry_id": "ca982837-9370-3509-b964-94192f1442a6",
                        "source_sense_description": "person whose occupation specializes in the science of physics",
                        "target_lang_word": "fysicus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fysicus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                                        "entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                                        "glosses": [
                                            "wetenschapper die de fysica of natuurkunde beoefent."
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f4beb8-ae78-4f37-98b8-ef79c61dd478",
                                                "sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                                                "text": "Zijn grootste succes kende de LHC in 2012, toen fysici in de versneller het langgezochte higgsdeeltje ontdekten. Dat deeltje wordt breed beschouwd als het laatste ontbrekende puzzelstukje van het zogeheten standaardmodel, de natuurkundetheorie die alle deeltjes en hun gedrag in een enkele wiskundige formule giet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f362c70-9f10-46fe-842a-3d5ffe606c93",
                        "source_entry_id": "ca982837-9370-3509-b964-94192f1442a6",
