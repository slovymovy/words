                                        "sense_id": "bc043bea-d606-30a4-8b7b-c532ecb2d5c5",
                                        "entry_id": "0de24cfe-a196-33b6-8ddf-9a2b73eb043d",
                                        "glosses": [
                                            "Eastertide (“the period from Easter to Whitsun”)."
                                        ],
                                        "tags": [
