                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0553d43c-69e7-4b31-8694-9e301dc6b8a1",
                        "entry_id": "e7123584-853c-3016-98c6-bb8176c86950",
