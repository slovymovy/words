                        "entry_id": "fc3c8ee6-ffea-3dce-b0eb-e786da9e3b42",
                        "glosses": [
                            "To travel (or work) on the footplate of a locomotive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b055049-fed6-427e-ab46-68a0834229bb",
                                "sense_id": "3ba2c08b-4eb1-3c0a-bcaf-83890538d4f1",
                                "text": "Hard work is required from men and machines as I was to experience later when footplating Lambton No 5 on five bogies battling its way up Newtondale."
                            }
                        ]
                    }
