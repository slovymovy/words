                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dfbc5c8-dc5b-468f-bd33-2ce78fd6b4ba",
                                "sense_id": "d6df2c3d-65e3-3fdd-a2ac-4eecd383e8de",
                                "text": "Zasadniczo, to jest całkiem proste: na początku wyciągu spalin znajduje się ssawka, a na końcu wentylator."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0d2d6f6d-4082-33fe-b173-fb7c27b6de96",
                        "entry_id": "7be44020-ac63-308d-b0b6-c084c50a2eb7",
                        "glosses": [
                            "opierając się na zasadzie bezkompromisowo"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6de081e4-a94e-4006-afd4-322f5ca11384",
                                "sense_id": "0d2d6f6d-4082-33fe-b173-fb7c27b6de96",
                                "text": "Gdy zaś (…) zaczął wykazywać ochotę do ustępstw, teść postawił sprawę zasadniczo (…)."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
