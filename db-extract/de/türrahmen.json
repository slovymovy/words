                        "form": "den Türrahmen"
                    },
                    {
                        "form_id": "884292ed-05c4-4f38-ada2-c17981c61263",
                        "entry_id": "4fa1ea11-6538-39dc-a1e8-fec501618cb7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Türrahmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                        "entry_id": "4fa1ea11-6538-39dc-a1e8-fec501618cb7",
                        "glosses": [
                            "unbeweglicher Teil der Tür, an dem der Türflügel angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f777021-5a76-40a1-9718-f9fce71ae839",
                                "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                                "text": "Viele Türrahmen bestehen aus Holz."
                            },
                            {
                                "example_id": "53969ec6-e605-4fb5-947b-e3addcac3db8",
                                "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                                "text": "„Sein massiger Körper füllte den ganzen Türrahmen aus.“."
                            },
                            {
                                "example_id": "b8c43461-2b95-40d4-b74d-42cd804d71be",
                                "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                                "text": "„Eine zweite Frau trat in den Türrahmen und gesellte sich zu der ersten.“"
                            },
                            {
                                "example_id": "745054a3-a22b-4fa8-a8e8-7fa2e3427f7a",
                                "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                                "text": "„Und dann, wie der Schwärze der Nacht entstiegen, lehnt die Afrikanerin am Türrahmen.“"
                            },
                            {
                                "example_id": "2da43eaf-a02c-484f-972d-f79108b58ef2",
                                "sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
                                "text": "„Die wachsame, aber höfliche Matriarchin nickte mir zu, und ein kleiner, überrascht wirkender Junge lugte hinter einem Türrahmen hervor.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bcacc9d-a7de-4bb1-aef1-033b86593c14",
                        "source_entry_id": "4fa1ea11-6538-39dc-a1e8-fec501618cb7",
                        "source_sense_id": "d72452c7-74e0-3f1d-958f-e83665bc8e53",
