                        ],
                        "examples": [
                            {
                                "example_id": "1b11d2a3-907a-4e32-8e5b-16601b46862e",
                                "sense_id": "8fbc40ba-95b0-3387-a884-87fcdbdc34fb",
                                "text": "реку́ подёрнуло то́нким льдом",
                                "translation": "the river was covered with thin ice",
                                "english": "the river was covered with thin ice"
                            },
                            {
                                "example_id": "3741da34-1cdf-4710-aa83-44a114df80a8",
                                "sense_id": "8fbc40ba-95b0-3387-a884-87fcdbdc34fb",
                                "text": "моро́з подёрнул реку́ то́нким сло́ем льда",
                                "translation": "the frost covered the river with a thin layer of ice",
                                "english": "the frost covered the river with a thin layer of ice"
                            }
                        ]
                    },
                    {
                        "sense_id": "b022865a-7be3-3e70-91f4-f1776bc0a1e4",
