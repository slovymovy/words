                                        "glosses": [
                                            "Of or pertaining to the epithelium."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9aed29f-436a-45b3-ab43-b14daea57897",
                                                "sense_id": "e403118f-280e-301b-af9c-674db2d5fe42",
                                                "text": "A similar procedure, Lasek (laser epithelial keratomileusis), is an option for people not suitable for Lasik."
                                            },
                                            {
                                                "example_id": "e67a9314-55af-4ba0-9047-d695496c55c1",
                                                "sense_id": "e403118f-280e-301b-af9c-674db2d5fe42",
                                                "text": "These included multilobular consolidation with histiological lesions of bronchiolitis with epithelial necrosis and syncytia [14 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25e9e66e-6a0f-4475-9ff8-58db794127c9",
                        "source_entry_id": "914064e7-7ec9-3ea1-8904-7dc9f4b98b71",
