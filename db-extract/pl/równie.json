        "pl-extract.jsonl": [
            {
                "entry_id": "35139d0e-c733-303b-b33d-28e6da35686e",
                "word": "równie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                        "entry_id": "35139d0e-c733-303b-b33d-28e6da35686e",
                        "glosses": [
                            "w taki sam sposób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768ce443-490d-411e-888e-a76660bd74b9",
                                "sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                                "text": "Czymże jest nazwa? To, co zowiem różą, pod inną nazwą równie by pachniało"
                            },
                            {
                                "example_id": "5c758adf-e928-4a16-a145-3cb0ce0a7c4b",
                                "sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                                "text": "Marzeniem jest wszystkich miasteczkowych ptaszników zastawiać w tym zakątku sidła na wilgi, kraski, dzwońce, drozdy, jemiołuchy – dostęp wszakże do pustelni równie trudny od strony wody, jak lądu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7f5fc6f-d28b-4500-8f75-722586b4467a",
                        "source_entry_id": "35139d0e-c733-303b-b33d-28e6da35686e",
                        "source_sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                        "target_lang_word": "equally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "In an equal manner; in equal shares or proportion; with equal and impartial justice; evenly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4035306-4358-4029-b909-31b301618a92",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "All citizens are equally taxed."
                                            },
                                            {
                                                "example_id": "4f29a561-e1c3-49b4-90af-58fc98681568",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "The pie was divided equally among the guests."
                                            },
                                            {
                                                "example_id": "0fb3bca3-463e-4a6e-a648-13519b297074",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "They shared equally in the spoils."
                                            },
                                            {
                                                "example_id": "16d66741-8ef9-4045-abc0-982778f7ba0e",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "And when their ſcattered armie is ſubdu’d:\nAnd you march on their ſlaughtered carkaſſes,\nShare equally the gold that bought their liues,\nAnd liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "c74c8e28-0ef6-4e0c-b7a4-07afa81c4c78",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "You have to give them credit, rarely does a character appeal equally to four-year-old children and middle-aged aunts posting tepid jokes and fake Oscar Wilde quotes on their timelines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "In equal degree or extent; just as."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8790eec-4eb4-4b6b-b7d8-15328aa0cd1a",
                                                "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                                "text": "The gas stations are equally far from the highway."
                                            },
                                            {
                                                "example_id": "4a06f7c9-a1a5-4bbd-9e44-5b9690fa421b",
                                                "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd4e538a-0714-3012-b072-70395f0449cf",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "Used to link two or more coordinate elements"
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7235afb9-7b90-49d2-92e4-ce22c9af897a",
                                                "sense_id": "bd4e538a-0714-3012-b072-70395f0449cf",
                                                "text": "John suffered setbacks at his job. Equally, Frank's business slowed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd49225a-f2a4-4124-99e7-b8ac0f06a1ce",
                        "source_entry_id": "35139d0e-c733-303b-b33d-28e6da35686e",
                        "source_sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                        "target_lang_word": "stejně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stejně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6dce87-3380-3627-a9b4-42135cb375ca",
                                        "entry_id": "99edc898-3f45-32e1-aa17-2db2b18f3a46",
                                        "glosses": [
                                            "stejným způsobem, bez rozdílu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f34c36b-022c-4ccb-9377-99a11f4e5519",
                                                "sense_id": "1f6dce87-3380-3627-a9b4-42135cb375ca",
                                                "text": "Udělal to stejně jako minule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2920f787-3e8b-398a-bfb8-5fad7004efb3",
                                        "entry_id": "99edc898-3f45-32e1-aa17-2db2b18f3a46",
                                        "glosses": [
                                            "tak jako tak, bez ohledu na ostatní skutečnosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627e7f85-b682-4ee4-b531-93b42e6d35ad",
                                                "sense_id": "2920f787-3e8b-398a-bfb8-5fad7004efb3",
                                                "text": "Stejně si do toho nenechá mluvit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15c8bf57-6803-491f-afd8-96d2742f5654",
                        "source_entry_id": "35139d0e-c733-303b-b33d-28e6da35686e",
                        "source_sense_id": "b96bff44-8f37-3673-8672-bd29893a1a02",
                        "target_lang_word": "aussi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aussi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "Autant."
                                        ],
                                        "tags": [],
                                        "note": "Établit une égalité qui peut révéler une intensité plus grande qu'à l’habitude",
                                        "examples": [
                                            {
                                                "example_id": "2d26a691-3d84-4413-ac92-87bb359bad7d",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Supputer ce qui eût été accompli, avec une volonté différente, est une spéculation aussi vaine que magnifique."
                                            },
                                            {
                                                "example_id": "9bc0a430-0ef4-47ca-b556-2ec0182a0027",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Le répandage se fait sur une surface sèche et le gravillonnage suit d’aussi près que possible le répandage, de manière que la surface du gravillon soit bien mouillée par le liant fluide."
                                            },
                                            {
                                                "example_id": "168f5b78-73c4-498e-b8ae-8233c32c5acc",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Elle est aussi belle que sa mère."
                                            },
                                            {
                                                "example_id": "453b89f3-f258-4c1b-8518-99e7a5d65391",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Il n’est plus aussi beau qu'autrefois."
                                            },
                                            {
                                                "example_id": "416301d8-fa9e-4930-8360-b831b0bc62b1",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Vous savez cela aussi bien que moi."
                                            },
                                            {
                                                "example_id": "98ff9ec1-c011-4850-9ce2-520a02a11bdb",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Elle danse aussi bien qu'elle chante."
                                            },
                                            {
                                                "example_id": "f6ebba26-b73d-4387-9180-f03e6380f778",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Ce livre est estimable, mais il y en a d’aussi bons."
                                            },
                                            {
                                                "example_id": "b6bea828-fb18-4589-9ad2-65b96ea50d89",
                                                "sense_id": "83ca4be0-146f-32d5-99d1-02e3b6eb40d6",
                                                "text": "Il est aussi affable que son frère est bourru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "Également ; de même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9a726d-593f-4180-ba5b-7cb992a3de84",
                                                "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                                "text": "Flic et journaliste, c'est comme chien et chat, c'est comme flic et avocat aussi. Ça s'attire, ça se respecte, ça se cajole ; jusqu'au coup de griffe qui laisse des cicatrices."
                                            },
                                            {
                                                "example_id": "91c68cba-a693-4b2e-b236-29e7704212fc",
                                                "sense_id": "3c0fbaab-78c4-3b37-b420-0ee49fab7fe8",
                                                "text": "Sur le chemin du retour Djinn leva deux lapins et une outarde, que nous fléchâmes aussi, enrichissant notre tableau de chasse en le diversifiant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1288413b-3d31-31ce-9ef8-b385963734a9",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "De plus ; encore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c91066ec-d98b-4599-a2c8-b66ed3e5edb2",
                                                "sense_id": "1288413b-3d31-31ce-9ef8-b385963734a9",
                                                "text": "Dites- lui aussi bonjour de ma part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                        "entry_id": "22472235-f7f4-3725-a36e-6ed7f2502a3d",
                                        "glosses": [
                                            "C’est pourquoi ; à cause de cela."
                                        ],
                                        "tags": [],
                                        "note": "Avec l'inversion de sujet",
                                        "examples": [
                                            {
                                                "example_id": "a8a17d89-37e3-4896-bf67-d9d65ad52925",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Quinze sous par jour, pour cinq personnes, il n’y a pas de quoi faire gras, je vous assure… Aussi nous ne mangions pas tous les jours parce qu’il fallait d’abord que le père malade ne manquât de rien."
                                            },
                                            {
                                                "example_id": "6424a511-053b-4dfe-a66a-611dd6825906",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Le général était podagre depuis longtemps et ne pouvait se déplacer qu'avec d'extrêmes difficultés ; aussi se faisait-il porter par ses soldats."
                                            },
                                            {
                                                "example_id": "1af52692-d17d-4da5-9377-e2812150fb6a",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi, dès les âges les plus reculés, le pays a-t-il été habité."
                                            },
                                            {
                                                "example_id": "88876c70-6121-4f28-94db-60f7bd4fe841",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi n’aimaient-ils pas à ce que les rarissimes piroguiers de passage photographiassent leur antiques et vénérables maisons croulantes."
                                            },
                                            {
                                                "example_id": "7f449232-b3c0-4570-913d-f516f7f26516",
                                                "sense_id": "c4db11e6-25b4-3954-9fcb-4484e25d9afe",
                                                "text": "Aussi par ce temps où la pièce de cent sous est tapie dans toutes les consciences, où elle roule dans toutes les phrases, le docteur, âgé de trente ans, doué d’une mère sans relations, restait-il garçon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aussi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                        "entry_id": "3174850c-388d-364c-9176-eac2bb31d110",
                                        "glosses": [
                                            "Marque la conformité, le rapport logique d’une proposition avec celle qui précède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dca6de4-fe90-4668-b0d3-1ccc953321a4",
                                                "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                                "text": "Il aime les sucreries. Aussi aime-t-il les caramels."
                                            },
                                            {
                                                "example_id": "88415dcf-1ec5-4fed-85be-9476ccffc7f2",
                                                "sense_id": "fcd73633-cbfe-31d9-bdc4-58022bfd5d53",
                                                "text": "Il a été volé la nuit ; mais aussi pourquoi n’y avait-t-il personne pour garder cet entrepôt ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
