                        "examples": [
                            {
                                "example_id": "e171de40-9d4d-42a7-8883-7aa78f469566",
                                "sense_id": "f60b39a4-af81-384d-b26f-0511ba944ca2",
                                "text": "Whilst he was searching Luna in an attempt to spot Ego, the two Irish Bhoys tried to focus the other 'scope on the bedroom of a brunette opposite."
                            },
                            {
                                "example_id": "65c51b87-497b-4231-a748-a8502a9181b8",
                                "sense_id": "f60b39a4-af81-384d-b26f-0511ba944ca2",
                                "text": "Refreshed from my little rest, I am left to guard the turrets as the bhoy goes to fetch his beloved who has returned from her daily toils"
                            }
                        ]
                    }
