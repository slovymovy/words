                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0993eb7-aec8-4146-afbe-d4619eef1eef",
                                "sense_id": "3ae3616d-d699-3877-9f8d-5e4839eddf74",
                                "text": "Der Anreißer arbeitet mit Schablonen und Stativ."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e03faceb-58b9-3815-b368-7f9020d85df4",
                        "entry_id": "c203dc00-8c8c-3042-86b9-1c56202977d6",
                        "glosses": [
                            "Person, die marktreißerisch auf ein Produkt oder eine Leistung aufmerksam macht; Objekt, das Lust auf mehr machen soll"
                        ],
                        "tags": [
                            "Marketing"
                        ],
                        "examples": [
                            {
                                "example_id": "8613440c-bbdb-4c5e-bc99-0843be3eb935",
                                "sense_id": "e03faceb-58b9-3815-b368-7f9020d85df4",
                                "text": "Auf der ersten Seite steht dann ein Anreißer zum Thema, das auf Seite 6 ausführlich behandelt wird."
                            },
                            {
                                "example_id": "fee8f82e-efc6-42b9-817b-1138b83cc622",
                                "sense_id": "e03faceb-58b9-3815-b368-7f9020d85df4",
                                "text": "Dieses ganz besondere Einzelangebot ist aber lediglich Blickfang und Anreißer für den Kunden."
                            },
                            {
                                "example_id": "960868e6-016b-4876-8d81-40a6d9de177c",
                                "sense_id": "e03faceb-58b9-3815-b368-7f9020d85df4",
                                "text": "Auf dem Rathausplatz steht ein Anreißer, der lautstark die Shows von Tommy True anpreist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
