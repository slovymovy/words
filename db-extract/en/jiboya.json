                        "examples": [
                            {
                                "example_id": "88ec6aea-b0c3-4c67-a980-19468bb0b34b",
                                "sense_id": "6cb44a78-76cc-362e-a429-8e19789ae815",
                                "text": "[…] the largest animal of this kind, which has been brought into Europe, is but thirty-six feet long : the most usual length however of the jiboya is about twenty feet, and the thickness in proportion."
                            },
                            {
                                "example_id": "bb02d6f0-ea5c-4fec-832f-de4f00603465",
                                "sense_id": "6cb44a78-76cc-362e-a429-8e19789ae815",
                                "text": "Prince Maximilian of Neu Wied tells us that the experienced hunter laughs when asked whether the jiboya attacks and devours man."
                            },
                            {
                                "example_id": "bf229be0-3fb2-4741-9f08-1006d44c89b8",
                                "sense_id": "6cb44a78-76cc-362e-a429-8e19789ae815",
                                "text": "The Indians kept them in huge wooden boxes, and for a small tip, five or six boys would take out the gigantic sucuris, anacondas that live in water, and then some jiboyas of a similar size, but that are primarily land creatures."
                            }
                        ]
                    }
