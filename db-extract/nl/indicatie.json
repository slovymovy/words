                            {
                                "example_id": "802f4e20-e7c3-4d57-b2b0-b61d1198ca17",
                                "sense_id": "e87fe8a9-20a8-33c7-b511-51970a5b8a17",
                                "text": "\"In Rusland is de afgelopen weken en maanden terughoudend gereageerd op de mogelijkheid van een NAVO-lidmaatschap voor Finland en Zweden. Uit de commentaren proef je wrevel, men is in Moskou duidelijk 'not amused' en lijkt enigszins verrast door de stroomversnelling waarin dit proces ineens is gekomen. Maar concrete indicaties van een mogelijk Russisch antwoord op de uitbreiding van de alliantie zijn vooralsnog uitgebleven."
                            }
                        ]
                    },
                    {
                        "sense_id": "a401ba87-9670-3ff1-ba0b-aec69c2c05b8",
                        "entry_id": "efdb3537-2344-3f1d-818d-b54f14b8b7af",
                        "glosses": [
                            "grond van verdenking"
                        ],
                        "tags": [],
