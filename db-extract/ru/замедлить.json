                        "sense_id": "3acb28d0-4d6e-3022-a1ae-9bbd4299762e",
                        "entry_id": "157463ec-d6b8-316c-a4f3-7600d6640c7a",
                        "glosses": [
                            "to slow down, to decelerate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61daf002-47e8-47d6-8113-9296ebb7a43d",
                                "sense_id": "3acb28d0-4d6e-3022-a1ae-9bbd4299762e",
                                "text": "заме́длить те́мпы",
                                "translation": "to slacken the pace",
                                "english": "to slacken the pace"
                            },
                            {
                                "example_id": "ea453813-e94d-4f28-b524-5a3588a4c593",
                                "sense_id": "3acb28d0-4d6e-3022-a1ae-9bbd4299762e",
                                "text": "заме́длить ход",
                                "translation": "to slow down; reduce speed",
                                "english": "to slow down; reduce speed"
                            },
                            {
                                "example_id": "89a17e72-7434-4469-892b-d56ea21b34c1",
                                "sense_id": "3acb28d0-4d6e-3022-a1ae-9bbd4299762e",
                                "text": "заме́длить шаги́",
                                "translation": "to slow down one's pace; walk slower",
                                "english": "to slow down one's pace; walk slower"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e864e77-3507-31a3-9986-f0b465c63987",
                        "entry_id": "157463ec-d6b8-316c-a4f3-7600d6640c7a",
                        "glosses": [
                            "to hold back, to delay, to retard"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3c8030cd-4415-3aa6-8f4e-27147fdf1131",
                        "entry_id": "157463ec-d6b8-316c-a4f3-7600d6640c7a",
                        "glosses": [
                            "in expressions"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e2f27b9-bece-4ef3-892c-4a2ad3c103aa",
                                "sense_id": "3c8030cd-4415-3aa6-8f4e-27147fdf1131",
                                "text": "он не заме́длил яви́ться",
                                "translation": "he did not take long to appear; he was not long in coming",
                                "english": "he did not take long to appear; he was not long in coming"
                            },
                            {
                                "example_id": "05ab51c6-bf50-4338-8233-3f72d3bca752",
                                "sense_id": "3c8030cd-4415-3aa6-8f4e-27147fdf1131",
                                "text": "они́ не заме́длили воспо́льзоваться э́тим",
                                "translation": "they hastened to take advantage of it",
                                "english": "they hastened to take advantage of it"
                            },
                            {
                                "example_id": "4209120f-b548-42b6-8ebb-09058387d3d4",
                                "sense_id": "3c8030cd-4415-3aa6-8f4e-27147fdf1131",
                                "text": "не заме́длить",
                                "translation": "not to take long",
                                "english": "not to take long"
                            },
                            {
                                "example_id": "7645611f-be06-4e85-afdb-770db65cb18c",
                                "sense_id": "3c8030cd-4415-3aa6-8f4e-27147fdf1131",
                                "text": "прошу́ не заме́длить с отве́том",
                                "translation": "please reply immediately [without delay]",
                                "english": "please reply immediately [without delay]"
                            }
                        ]
