                "senses": [
                    {
                        "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                        "entry_id": "68a23470-1ac9-34fe-b7f8-5a1500f26354",
                        "glosses": [
                            "zur Schau gestellter Reichtum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d59bebf-554f-4a1d-ba8a-d9474e698e2c",
                                "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                                "text": "„Abt Mathias Fink, der auch Geheimschreiber Kaiser Friedrichs war und großes Ansehen genoss, legte jedoch viel Wert auf Prunk.“"
                            },
                            {
                                "example_id": "91d302c2-5f1e-4095-9d0d-f64ddfce231c",
                                "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                                "text": "„Das ist die Quintessenz dessen, was auch Sade bei seinem Aufenthalt in Neapel oder durch spätere Berichte erfahren haben dürfte: Sittenlosigkeit, Armut auf der einen, Prunk auf der anderen Seite, grausame Neigungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3afc303f-152c-4105-ad95-293fcce68f96",
                        "source_entry_id": "68a23470-1ac9-34fe-b7f8-5a1500f26354",
                        "source_sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                        "source_sense_description": "zur Schau gestellter Reichtum",
                        "target_lang_word": "splendour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "splendour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9837c9-4f7d-3c1a-bc41-1c30cb731f79",
                                        "entry_id": "69c4aad4-9351-31ae-ad59-34e57103beda",
                                        "glosses": [
                                            "British, Canadian, Ireland, South Africa, Australian, and New Zealand standard spelling of splendor."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ccb8f38-d7c7-4514-a9c0-b5e2df530dc8",
                                                "sense_id": "2a9837c9-4f7d-3c1a-bc41-1c30cb731f79",
                                                "text": "If the kind of network we envisage is to be established, it would be unwise to begin any of its services hurriedly with older stock, which, however admirable in its day, now has an air of faded Edwardian splendour that is out of joint with the times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d72495-8698-405a-a11b-dff480723cca",
                        "source_entry_id": "68a23470-1ac9-34fe-b7f8-5a1500f26354",
                        "source_sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                        "source_sense_description": "zur Schau gestellter Reichtum",
                        "target_lang_word": "splendeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "splendeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d81942f9-e5a4-3429-bbc7-3c3bc14a8d26",
                                        "entry_id": "83057c89-e233-3b55-836d-fcddcbe4e9c1",
                                        "glosses": [
                                            "Grand éclat de lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06d975e5-1709-40ef-8896-c3304b76dd2a",
                                                "sense_id": "d81942f9-e5a4-3429-bbc7-3c3bc14a8d26",
                                                "text": "[…], et ce qui sauvait du désespoir, c’était seulement la farouche splendeur des aubes et des couchants, des torrents tourbillonnants, de la cavalcade des nuages, et de l’infinie solitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1533e57b-3fbe-3627-949b-e5bcb4baeb55",
                                        "entry_id": "83057c89-e233-3b55-836d-fcddcbe4e9c1",
                                        "glosses": [
                                            "Grand éclat d’honneur, de gloire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e8d9a6-b7f5-4bf5-8522-97ac91fa97ed",
                                                "sense_id": "1533e57b-3fbe-3627-949b-e5bcb4baeb55",
                                                "text": "Sur le même ton caustique, elle décrivait ses trois mariages soldés par deux divorces et un veuvage, son entêtement obsessionnel pour racheter sa bastide, mais aussi ses souvenirs de jeunesse à l’époque des gemmeurs et de la splendeur des Nogaro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d54694-66cb-3dd6-b55f-b807f9e03af2",
                                        "entry_id": "83057c89-e233-3b55-836d-fcddcbe4e9c1",
                                        "glosses": [
                                            "Magnificence, pompe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b9864a-4d3e-4248-86a4-f172aae71626",
                                                "sense_id": "97d54694-66cb-3dd6-b55f-b807f9e03af2",
                                                "text": "Il vit avec beaucoup de splendeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7992cfb2-3528-3eeb-bcb2-c943536fd4ce",
                                        "entry_id": "83057c89-e233-3b55-836d-fcddcbe4e9c1",
                                        "glosses": [
                                            "Choses éclatantes, magnifiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "979f3a7f-e0c6-4c64-9697-84dc325ba681",
                                                "sense_id": "7992cfb2-3528-3eeb-bcb2-c943536fd4ce",
                                                "text": "Toute la grande nature du Noordland qui s’est dévoilée à nos yeux depuis Throndjhem, n’est que le prélude des splendeurs qui nous attendent dans l’archipel des Loffoden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
