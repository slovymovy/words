                                                "sense_id": "5332e326-5796-3e7a-a8cd-aee6a3405f85",
                                                "text": "Cet animal vient d’avoir des petits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc62c381-d75d-363d-a4b9-10edf60b4f61",
                                        "entry_id": "2bbe6d55-e080-3463-9583-253ff0df61b1",
                                        "glosses": [
                                            "Petit objet, petite chose."
                                        ],
                                        "tags": [
