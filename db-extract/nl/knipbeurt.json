                        "entry_id": "9035f6b1-25a0-30cc-8dcf-79c577801c23",
                        "glosses": [
                            "hairdo, haircut done at a regular frequency"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "7edf8baa-0067-482b-9a73-d33e9fc7e7cf",
                                "sense_id": "43e63dec-f7a1-3dbd-8df3-34cfb7b86f28",
                                "text": "Naast doe-het-zelven, bier drinken en een maandelijkse knipbeurt bij de kapper, gebeurt er niet veel.",
                                "translation": "Besides DIY, drinking beer and getting a monthly haircut at the hairdresser, not much happens.",
                                "english": "Besides DIY, drinking beer and getting a monthly haircut at the hairdresser, not much happens."
                            },
                            {
                                "example_id": "17f7e653-73de-4e3a-b1a4-f0ad9826e338",
                                "sense_id": "43e63dec-f7a1-3dbd-8df3-34cfb7b86f28",
                                "text": "Het is weer eens tijd dat onze poedel een knipbeurt krijgt, want zo kan hij de wedstrijd nooit winnen.",
                                "translation": "It's time for our poodle to get a hairdo again, because he'll never win the competition like this.",
                                "english": "It's time for our poodle to get a hairdo again, because he'll never win the competition like this."
                            }
                        ]
                    }
