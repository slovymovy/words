                                        "examples": [
                                            {
                                                "example_id": "38d4a043-97e4-4e0c-b6ae-bea881e55fa9",
                                                "sense_id": "80028176-cf69-32cd-9610-def3fa62e160",
                                                "text": "Klasówka z chemii okazała się być bardzo trudna, tylko dwóm uczniom udało się dostać piątki, a aż dziesięciu otrzymało z niej jedynki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4e467feb-a0f2-33f6-9d03-42752e1d30c6",
                                        "entry_id": "09c45c72-a5b4-3bb7-b610-f83699d03bb1",
                                        "glosses": [
                                            "to, co ma numer 5, jest oznaczone liczbą 5, np. dom, autobus, bieg (w skrzyni biegów)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9074b38-dc72-48ef-b2d8-6dcaccb8044c",
                                                "sense_id": "4e467feb-a0f2-33f6-9d03-42752e1d30c6",
                                                "text": "Miałem jechać piętnastką, a przez pomyłkę wsiadłem do piątki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
