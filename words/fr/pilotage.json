                        "pilotage automatique",
                        "cabine de pilotage"
                    ]
                },
                {
                    "sense_id": "6ef75e88-49ae-3233-9a7a-a5fa7acb30a9",
                    "sense_definition": "Action de diriger, gérer ou coordonner un projet, une organisation ou une stratégie.",
