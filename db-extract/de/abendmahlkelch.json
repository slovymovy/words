                    {
                        "sense_id": "df4f5d42-14e8-3959-bf98-7064a550e48f",
                        "entry_id": "b676e04f-439f-378f-bb8e-013587b67d7f",
                        "glosses": [
                            "Kelch, der bei der Abendmahlsfeier verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1a46dd-59ad-4d6c-8047-e4597f447eb6",
                                "sense_id": "df4f5d42-14e8-3959-bf98-7064a550e48f",
                                "text": "„Viele Menschen in Spanien glauben, dass dieser Kelch der authentische Abendmahlkelch aus Jerusalem ist, den der heilige Petrus nach Rom mitgenommen hat.“"
                            },
                            {
                                "example_id": "e7b9d2e7-f1e8-483f-8cf2-5b1ab874cbe3",
                                "sense_id": "df4f5d42-14e8-3959-bf98-7064a550e48f",
                                "text": "„Der Abendmahlkelch und damit die unmittelbare Begegnung mit dem Heiland war bisher dem Priester vorbehalten, für die Gläubigen blieben Brot und Hostie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
