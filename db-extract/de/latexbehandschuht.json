                "senses": [
                    {
                        "sense_id": "4025dd48-0c6c-3630-9495-38b7caecd1ef",
                        "entry_id": "c616cf85-a1bc-3c20-a65b-2c7d68a9627d",
                        "glosses": [
                            "Latexhandschuhe tragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c993e48-81f3-4c0c-b053-6bae604d71ee",
                                "sense_id": "4025dd48-0c6c-3630-9495-38b7caecd1ef",
                                "text": "„Seine latexbehandschuhte Hand war rot verschmiert, aber nicht mit Barbecuesoße.“"
                            },
                            {
                                "example_id": "55f95258-d355-4e9c-8f3b-2e27c8873e55",
                                "sense_id": "4025dd48-0c6c-3630-9495-38b7caecd1ef",
                                "text": "„Am nächsten Tag konnte Kevin kaum die Augen aufhalten, als der Commander mit zwei latexbehandschuhten Fingern demonstrierte, wie ihre Penisse während des Geschlechtsverkehrs in Betsey eindringen würden.“"
                            },
                            {
                                "example_id": "659d0e07-a4b4-49ba-9842-295f7e8882f1",
                                "sense_id": "4025dd48-0c6c-3630-9495-38b7caecd1ef",
                                "text": "„Mit einer latexbehandschuhten Hand griff er in ihr Kreuz und tastete ihre Wirbelsäule ab, bis er fand, was er suchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
