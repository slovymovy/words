                {
                    "sense_id": "967f728d-0aa9-3baa-a482-aae01f194206",
                    "sense_definition": "In any other place or way; otherwise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sem_exception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have looked here, but nowhere <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Я искал здесь, но нигде <w>больше</w>.",
                                "zh": "我在这儿找过了，但<w>别处</w>没找过。",
                                "pl": "Szukałem tutaj, ale <w>nigdzie indziej</w>.",
                                "fr": "J'ai cherché ici, mais <w>nulle part ailleurs</w>."
                            }
                        },
                        {
                            "text": "She has visited France but nowhere <w>besides</w> in Europe.",
                            "target_lang_translations": {
                                "ru": "Она посетила Францию, но нигде <w>больше</w> в Европе.",
                                "zh": "她去过法国，但在欧洲<w>别处</w>没去过。",
                                "pl": "Odwiedziła Francję, ale <w>nigdzie indziej</w> w Europie.",
                                "fr": "Elle a visité la France, mais <w>nulle part ailleurs</w> en Europe."
                            }
