                                    {
                                        "sense_id": "bbb7c0a6-5710-3748-a8c6-4a669d329021",
                                        "entry_id": "f9d97130-9f92-348c-a956-7fce5968fd95",
                                        "glosses": [
                                            "Absenkung der Temperatur einer Flüssigkeit unter den Gefrierpunkt, ohne dass diese erstarrt"
                                        ],
                                        "tags": [
                                            "Thermodynamik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7da8dd-651e-48d0-9cb3-7b170499fec9",
                                                "sense_id": "bbb7c0a6-5710-3748-a8c6-4a669d329021",
                                                "text": "Bei einer Unterkühlung von Wasser in einem Gefäß kristallisiert das Wasser nach einem Stoß gegen den Behälter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                        "entry_id": "f9d97130-9f92-348c-a956-7fce5968fd95",
                                        "glosses": [
                                            "tiefgehende Wirkung von Kälte auf Menschen und anderer Warmblüter in Verbindung mit einer Verringerung der Körpertemperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4649cd-aa85-4def-8512-6d048b2f208d",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "Nachdem die Person zu lange der Kälte ausgesetzt war, wurde sie mit einer Unterkühlung ins Krankenhaus eingeliefert."
                                            },
                                            {
                                                "example_id": "d2e04a83-3703-4b73-a5d0-57f1da77b1a2",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "„Über Monate andauernde Unterkühlung, Frostbeulen und Mangelernährung haben ihre Spuren hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d5b279f6-ca0a-4795-8e51-81f3ec111207",
                                                "sense_id": "4d16d8be-14ff-3133-b0bb-7fdc2f12fe92",
                                                "text": "„Um mich vor neuen Unterkühlungen zu schützen, erhalte ich einen blütenweißen Seidenschal, ein Prachtstück seiner Gattung, der früher einmal zu einem Frack gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
