                    {
                        "sense_id": "ddef9966-63e9-311c-bfc0-cfad3ebb64c3",
                        "entry_id": "6ae9d9d4-457b-318d-962f-255ab2eeeed2",
                        "glosses": [
                            "To laugh loudly, immoderately, or too often."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15caea60-c878-40ad-8025-b136abbb8bae",
                                "sense_id": "ddef9966-63e9-311c-bfc0-cfad3ebb64c3",
                                "text": "The villain began to cachinnate and twirl his moustache."
                            },
                            {
                                "example_id": "fff7a568-6afd-451e-ba31-4754fcfeac62",
                                "sense_id": "ddef9966-63e9-311c-bfc0-cfad3ebb64c3",
                                "text": "There is a sense of spectral whirling through liquid gulfs of infinity, of dizzying rides through reeling universes on a comet’s tail, and of hysterical plunges from the pit to the moon and from the moon back again to the pit, all livened by a cachinnating chorus of the distorted, hilarious elder gods and the green, bat-winged mocking imps of Tartarus."
                            }
                        ]
                    }
