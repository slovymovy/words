                ],
                "translations": [
                    {
                        "translation_id": "074b1b5a-8571-4426-b5bf-bd4172d9b81c",
                        "source_entry_id": "155d9d4b-cd6d-33e0-89ad-fa62ebc49a48",
                        "source_sense_id": "5ec2660b-07e5-37f8-868d-4325540d83b7",
                        "target_lang_word": "calm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
