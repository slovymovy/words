                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b784c77a-e812-406c-b339-296483291fe6",
                                                "sense_id": "83b9a41b-4693-3c50-82ca-d03eeb9b6ef7",
                                                "text": "Отбитую взрывом соль выдают на поверхность в вагонетках и измельчают."
                                            }
                                        ]
                                    }
                                ]
