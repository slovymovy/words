    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed67556f-4239-388d-a68d-f75a38bd6971",
                    "sense_definition": "Электронное устройство с экраном для приёма и показа телевизионных передач, фильмов и видео.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Папа купил новый большой <w>телевизор</w> в гостиную.",
                            "target_lang_translations": {
                                "en": "Dad bought a new big <w>TV</w> for the living room.",
                                "nl": "Papa heeft een nieuwe grote <w>televisie</w> voor in de woonkamer gekocht."
                            }
                        },
                        {
                            "text": "Пожалуйста, выключи <w>телевизор</w>, я хочу спать.",
                            "target_lang_translations": {
                                "en": "Please turn off the <w>TV</w>, I want to sleep.",
                                "nl": "Zet alsjeblieft de <w>tv</w> uit, ik wil slapen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "смотреть телевизор",
                        "включить телевизор",
                        "выключить телевизор",
                        "пульт от телевизора",
                        "цветной телевизор"
                    ],
                    "target_lang_definitions": {
                        "en": "An electronic device with a screen for receiving and showing television broadcasts, films, and videos.",
                        "nl": "Een elektronisch apparaat met een scherm voor het ontvangen en tonen van televisie-uitzendingen, films en video's."
                    },
                    "translations": {
                        "en": [
                            {
