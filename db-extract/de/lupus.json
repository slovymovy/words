                "senses": [
                    {
                        "sense_id": "37454462-a661-342d-8661-055943f2ce76",
                        "entry_id": "80e67a63-1688-3195-b3b4-aad2e2ce872d",
                        "glosses": [
                            "Autoimmunerkrankung der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc70cdb-83de-468f-87a6-ffd5c09f31f7",
                                "sense_id": "37454462-a661-342d-8661-055943f2ce76",
                                "text": "„Erinnern Sie sich, was wir über als Lust ausgedrückten Zorn und Lupus, der sich als Nesselausschlag präsentiert, gesagt haben?“"
                            },
                            {
                                "example_id": "a173eb25-78de-483b-bbd4-9308653aebae",
                                "sense_id": "37454462-a661-342d-8661-055943f2ce76",
                                "text": "„In den nächsten Stunden gerate ich an einen älteren Mann, der an Nierenversagen stirbt. Eine Frau in mittleren Jahren, die offenbar ihren Kampf gegen Lupus verliert.“"
                            },
                            {
                                "example_id": "491b2586-614b-46a0-ba79-8e1e0dd39ecd",
                                "sense_id": "37454462-a661-342d-8661-055943f2ce76",
                                "text": "„›Mutter leidet an Lupus, sie hat nur noch ein paar Jahre zu leben.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428ded73-4b98-44d0-a670-3241a6abe17f",
                        "source_entry_id": "80e67a63-1688-3195-b3b4-aad2e2ce872d",
                        "source_sense_id": "37454462-a661-342d-8661-055943f2ce76",
