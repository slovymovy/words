                ],
                "senses": [
                    {
                        "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                        "entry_id": "3a005ffd-df47-3683-90ce-2396cd61410f",
                        "glosses": [
                            "kleiner Vogel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ac0eef2e-d78a-4426-8fd0-d12fd34ed12c",
                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                "text": "Dieser Piepmatz frisst am liebsten Sonnenblumenkerne."
                            },
                            {
                                "example_id": "30415c16-5068-4d8b-8abf-467bd971dfec",
                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                "text": "„Für einen Moment stellte ich mir vor, wie es wäre, so fixiert zu sein, so fest verschraubt in die eigenen Möglichkeiten wie dieser aufgeschmissene Piepmatz.“"
                            },
                            {
                                "example_id": "16f15559-aab3-4032-b057-4a0cf88d314e",
                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                "text": "„Ein Piepmatz ist vorbeigeflogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46568ce0-a696-4c1a-ac8d-aee7f43241af",
                        "source_entry_id": "3a005ffd-df47-3683-90ce-2396cd61410f",
                        "source_sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                        "source_sense_description": "umgangssprachlich: kleiner Vogel",
                        "target_lang_word": "birdie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birdie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                                        "entry_id": "39f04559-8398-3f0d-a81d-577fe97fb8c3",
                                        "glosses": [
                                            "A bird; especially, a small and cute one."
                                        ],
                                        "tags": [
                                            "childish",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d26c51-ff14-41b6-8142-6e71eb81b53b",
                                                "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                                                "text": "Near-synonyms: birdlet, birdling, birb, cocky"
                                            },
                                            {
                                                "example_id": "9a051948-925c-41e4-b7af-79fe908468c1",
                                                "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                                                "text": "Aw, that's a cute little birdie. Is it a budgie?"
                                            },
                                            {
                                                "example_id": "695213aa-4c64-4438-8d06-5bc2295144da",
                                                "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                                                "text": "'Listen to th' birdies,' said the child, raising her radiant face to the roof, and at the supreme moment accompanying them in perfect mimicry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77995b30-ab39-359b-84c7-6651cee1e642",
                                        "entry_id": "39f04559-8398-3f0d-a81d-577fe97fb8c3",
                                        "glosses": [
                                            "The completion of a hole one stroke below par."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "532fb6cd-3852-4fee-9459-5cc4786451f9",
                                                "sense_id": "77995b30-ab39-359b-84c7-6651cee1e642",
                                                "text": "He scored ten birdies during the tournament."
                                            },
                                            {
                                                "example_id": "4ca43f46-0597-4530-95ff-c2de16bd92f4",
                                                "sense_id": "77995b30-ab39-359b-84c7-6651cee1e642",
                                                "text": "The heat brought one blessing. It baked the 7,053-yard par 35-35—70 course to concrete hardness and gave some added roll to the drives. Birdie, which have been at a premium, came easier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4f52f0-2510-3236-8c67-c4a46ad6f50d",
                                        "entry_id": "39f04559-8398-3f0d-a81d-577fe97fb8c3",
                                        "glosses": [
                                            "A shuttlecock."
                                        ],
