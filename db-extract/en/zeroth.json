                        "glosses": [
                            "In the initial position in a sequence whose elements are numbered starting at zero; the ordinal number corresponding to zero."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "711eebe8-ffa6-4adf-8b69-92dc5b59c9ea",
                                "sense_id": "928ac249-5e4d-34c3-93d2-604379f92219",
                                "text": "The zeroth order polynomial approximation is constant."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb252fc7-5c7f-3053-86de-feb7615055c2",
                        "entry_id": "4138fa40-21b0-32aa-a642-1828bfe7e94c",
                        "glosses": [
