                            "comparative"
                        ],
                        "form": "черня́вее"
                    },
                    {
                        "form_id": "91ec8526-8aab-417b-baae-330af7aa3b29",
                        "entry_id": "474304b8-abac-38ba-a818-40abf0480b12",
                        "tags": [
                            "comparative"
                        ],
                        "form": "черня́вей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad622c96-592f-3872-9f2a-4f4dc3e34bfd",
                        "entry_id": "474304b8-abac-38ba-a818-40abf0480b12",
                        "glosses": [
                            "субстантивир. прост. тот, кто имеет смуглое лицо, тёмные глаза и волосы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9afcb25d-47a7-4736-a0a6-941a29d80cc8",
                                "sense_id": "ad622c96-592f-3872-9f2a-4f4dc3e34bfd",
                                "text": "Заслышав смех, чернявый обиделся, взмахнул руками, и стал запальчиво доказывать, что в зепи у него не только розмысл с сотником, но и весь участок Люта Незнамыча…"
                            },
                            {
                                "example_id": "f9c5fe2b-af20-45c3-897b-1411c1ee730d",
                                "sense_id": "ad622c96-592f-3872-9f2a-4f4dc3e34bfd",
                                "text": "Она боялась поднять свой взор на чернявого."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8f49e38-dbfe-367e-99fb-f001c73e6225",
                        "entry_id": "474304b8-abac-38ba-a818-40abf0480b12",
                        "glosses": [
                            "прост. имеющий смуглое лицо, тёмные глаза и волосы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d9aaf3-f162-4f0d-b0be-44deab32c1b1",
                                "sense_id": "e8f49e38-dbfe-367e-99fb-f001c73e6225",
                                "text": "Там, в дальнем углу, за бутылкой вина, одиноко пригорюнился на диване чернявый юноша в коротком сюртуке и верховых сапогах."
                            },
                            {
                                "example_id": "c5b26303-fac3-4d68-9ff8-219753dbe6f4",
                                "sense_id": "e8f49e38-dbfe-367e-99fb-f001c73e6225",
                                "text": "Но чернявый Мишка бойко стучал молотком по каблуку перевернутого вверх подошвой и зажатого в колени сапога, один за одним вгонял в него мелкие деревянные гвоздики."
                            },
                            {
                                "example_id": "20425c60-e318-45c8-b5a5-e4db6efe418f",
                                "sense_id": "e8f49e38-dbfe-367e-99fb-f001c73e6225",
                                "text": "Вот кто переживает большие дни своей жизни ― этот чернявый двадцативосьмилетний парень в вышитой украинской рубашке под пиджаком, скуластый и курносый, с угольно-черными умными глазами."
                            }
                        ]
                    }
                ],
