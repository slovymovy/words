                        "cross_references": []
                    },
                    {
                        "translation_id": "1c917b9a-0542-4103-bb27-8484188d5ce2",
                        "source_entry_id": "3fd1ba59-69ab-33e9-be07-103500b9dad6",
                        "source_sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                        "target_lang_word": "crop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f20852db-fb51-30c6-8676-146a8cbc54db",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A plant, grown for it, or its fruits or seeds, to be harvested as food, livestock fodder, or fuel or for any other economic purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed1f7de-d76c-450e-8470-fac90b9e6fe4",
                                                "sense_id": "f20852db-fb51-30c6-8676-146a8cbc54db",
                                                "text": "The farmer had to decide which crop to grow as his main bet for the coming year. Would it be barley, oats, or something else?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4952072b-e93a-3477-9702-a8908892d210",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The production amount of such an output for a specific season or year, particularly of plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b554020d-795d-4325-8ea4-2e4e3ee24a40",
                                                "sense_id": "4952072b-e93a-3477-9702-a8908892d210",
                                                "text": "It was a good crop of oats this year. What a nice change after last year's crop!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A group, cluster, or collection of things occurring at the same time."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92770923-579e-4f95-bb45-aa7eaab61718",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "The decade produced a whole crop of ideas about space travel."
                                            },
                                            {
                                                "example_id": "6a14edd9-0cec-4474-95c5-102d7eb24d78",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "The university had an exceptional crop of graduates in 1892, including three who went on to win Nobel Prizes."
                                            },
                                            {
                                                "example_id": "8260b488-a7f6-4562-8bea-3fec05949aba",
                                                "sense_id": "bbd3a994-79d2-3def-af2d-ae078b79b53c",
                                                "text": "And even if Anna Wintour wanted to invite a fresh crop of internet talent, who would she choose? Can you name anyone in the past year who has ascended in a major way?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8b5611-c8a1-35f9-b7f6-f13b6b8fe99c",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A group of vesicles at the same stage of development in a disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aceea72-6c8b-42a3-a301-65f6332ef9a3",
                                                "sense_id": "0c8b5611-c8a1-35f9-b7f6-f13b6b8fe99c",
                                                "text": "The patient had a crop of bumps indicative of chicken pox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06eaf5e8-a719-3eab-8e6a-ff05529394c1",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The lashing end of a whip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ca2fc1c-5fee-3c60-a10a-94a1176eb4d0",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "An entire short whip, especially as used in horse-riding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecd7571a-f09a-3246-93c1-68f71261a7f6",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A rocky outcrop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d379043f-2ca5-30a2-aecd-564092cffd79",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The act of cropping."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A photograph or other image that has been reduced by removing the outer parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25f51ac-6b27-4f5a-b2f2-1d33e3e4f245",
                                                "sense_id": "d0cedede-4158-34f2-a083-dd47a2bb895b",
                                                "text": "This indicates to the engraver that the subject may be cropped to yield the size desired, but it is advisable that the position for the crop also be determined and marked, else some essential feature of the copy may be cut off by arbitrary cropping to get the required size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A short haircut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a05fd2c3-6375-41e6-ae8f-0c5cd1c9c954",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "She went from a ponytail to a crop."
                                            },
                                            {
                                                "example_id": "773d8932-218f-4159-8e48-37e91ab77759",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "Eton crop"
                                            },
                                            {
                                                "example_id": "a0d63286-5c8e-4112-a4b7-dba9351d24b0",
                                                "sense_id": "a4877e70-af82-351c-80a1-fbd13a233b53",
                                                "text": "From an inner pocket he produces a costly Ramillies Wig, shakes it out in a brisk Cloud of scented Litharge, and claps it on, with a minimum of fuss, over his ascetic’s Crop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "A pouch-like part of the alimentary tract of some birds (and some other animals), used to store food before digestion or for regurgitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49613a9b-a0f2-41cf-a998-bcdf2596adce",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "A little bird sat on the edge of her nest;\nHer yellow-beaks slept as sound as tops;\nThat day she had done her very best,\nAnd had filled every one of their little crops."
                                            },
                                            {
                                                "example_id": "5188b635-7b46-4188-968f-47eda5fdfb4a",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "The bird gave a gulp, and I felt the stone pass along its gullet and down into its crop."
                                            },
                                            {
                                                "example_id": "1c3d13d6-631b-4e65-934b-d56a71395a0c",
                                                "sense_id": "95f40e7c-64cc-35d8-b828-a668affad3cb",
                                                "text": "As the wildebeest shrinks, the circle of sated birds lounging in the short grass expands. With bulging crops, the vultures settle their heads atop folded wings and slide their nictitating membranes shut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2824a59a-c8a4-3733-96fa-55dc3b661b73",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The foliate part of a finial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d414fcba-3249-321f-8314-9fa3805d3d68",
                                        "entry_id": "020d8cd3-aed5-309e-a234-8708c71d799d",
                                        "glosses": [
                                            "The head of a flower, especially when picked; an ear of corn; the top branches of a tree."
                                        ],
                                        "tags": [
