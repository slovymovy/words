                "senses": [
                    {
                        "sense_id": "9be1afab-e243-3ee8-a097-c14bbf2d903d",
                        "entry_id": "b6e2d070-763c-3ee2-b6cb-9e9186fb9f63",
                        "glosses": [
                            "dachsprache, umbrella language (a language form that serves as a standard language in a country above other dialects)"
                        ],
                        "tags": [
                            "countable",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2e73cace-2266-463a-9362-6010cf8372f6",
                                "sense_id": "9be1afab-e243-3ee8-a097-c14bbf2d903d",
                                "text": "Der italienische Dialekt aus Florenz wurde als Amtsprache in Italien eingeführt und diente als Dachsprache.",
                                "translation": "The Italian dialect of Florence eventually became the standard language of Italy to serve as an umbrella language.",
                                "english": "The Italian dialect of Florence eventually became the standard language of Italy to serve as an umbrella language."
                            },
                            {
                                "example_id": "9ca086d3-6e92-4522-8e48-9e73efb0f195",
                                "sense_id": "9be1afab-e243-3ee8-a097-c14bbf2d903d",
                                "text": "Tatsächlich ist dieser politische Einfluss nicht zu leugnen, namentlich dadurch, dass in jedem Staat üblicherweise eine bestimmte Varietät die Rolle einer Dachsprache zugewiesen bekommt. Diese Dachsprache ist die Amtssprache und zugleich die Varietät, die verschriftlicht wird und auch in den Massenmedien benutzt wird."
                            }
                        ]
                    }
