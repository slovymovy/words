{
    "word_family": [
        "maraud",
        "marauder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30c9cf69-2b81-3095-9358-a05e30dba7e7",
                    "sense_definition": "Roaming around in search of things to steal or people to attack.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plundering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The remote village was attacked at dawn by a <w>marauding</w> band of outlaws.",
                            "target_lang_translations": {
                                "nl": "Het afgelegen dorp werd bij zonsopgang aangevallen door een <w>plunderende</w> bende vogelvrijen."
                            }
                        },
                        {
                            "text": "Farmers built sturdy stone walls to protect their cattle from <w>marauding</w> invaders.",
                            "target_lang_translations": {
                                "nl": "Boeren bouwden stevige stenen muren om hun vee te beschermen tegen <w>rovende</w> indringers."
                            }
                        }
                    ],
                    "synonyms": [
                        "plundering",
                        "raiding",
                        "pillaging"
                    ],
                    "common_phrases": [
                        "marauding band",
                        "marauding hordes"
                    ],
                    "target_lang_definitions": {
                        "nl": "Rondtrekkend op zoek naar dingen om te plunderen of mensen om aan te vallen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plunderend",
                                "target_lang_sense_clarification": "bezig met roven en vernielen"
                            },
                            {
                                "target_lang_word": "rondtrekkend en plunderend",
                                "target_lang_sense_clarification": "rondzwervend om te plunderen"
                            },
                            {
                                "target_lang_word": "rovend",
                                "target_lang_sense_clarification": "op rooftocht zijnd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82476ceb-6eec-3a05-a78e-38548570a3fe",
                    "sense_definition": "Roaming about searching for prey, livestock, or victims to kill or destroy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plundering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>marauding</w> stoat entered the rabbit warren and killed fifteen bunnies.",
                            "target_lang_translations": {
                                "nl": "Een <w>rondstruinende</w> hermelijn drong de konijnenburcht binnen en doodde vijftien konijntjes."
                            }
                        },
                        {
                            "text": "The <w>marauding</w> lion jumped the fence and killed the goat.",
                            "target_lang_translations": {
                                "nl": "De <w>rondzwervende</w> leeuw sprong over het hek en doodde de geit."
                            }
                        }
                    ],
                    "synonyms": [
                        "predatory"
                    ],
                    "target_lang_definitions": {
                        "nl": "Rondzwervend op zoek naar prooien of vee om te doden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rondzwervend",
                                "target_lang_sense_clarification": "op zoek naar prooi"
                            },
                            {
                                "target_lang_word": "rovend",
                                "target_lang_sense_clarification": "roofdiergedrag"
                            },
                            {
                                "target_lang_word": "rondstruinend",
                                "target_lang_sense_clarification": "op zoek naar slachtoffers"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c409fb6-b767-395a-bc1d-3accb362e0fb",
                    "sense_definition": "Present participle of <w>maraud</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Armed groups were <w>marauding</w> through the countryside during the collapse of the empire.",
                            "target_lang_translations": {
                                "nl": "Gewapende groepen waren tijdens de ineenstorting van het rijk <w>aan het plunderen</w> op het platteland."
                            }
                        },
                        {
                            "text": "The wolves were <w>marauding</w> across nearby farmland in search of easy prey.",
                            "target_lang_translations": {
                                "nl": "De wolven <w>zwierven rovend rond</w> op nabijgelegen landbouwgrond, op zoek naar een gemakkelijke prooi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord van 'maraud': plunderend of rovend rondtrekken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plunderen",
                                "target_lang_sense_clarification": "rooftochten houden"
                            },
                            {
                                "target_lang_word": "brandschatten",
                                "target_lang_sense_clarification": "verwoestend rondtrekken"
                            },
                            {
                                "target_lang_word": "roven",
                                "target_lang_sense_clarification": "gewelddadig stelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7362fb91-9332-3dcf-808a-f3a0aec1ed65",
                    "sense_definition": "The act of raiding, pillaging, or roaming in search of plunder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local militia was organized specifically to prevent violent <w>marauding</w> by enemy forces.",
                            "target_lang_translations": {
                                "nl": "De plaatselijke militie werd specifiek georganiseerd om gewelddadige <w>plunderingen</w> door vijandelijke troepen te voorkomen."
                            }
                        },
                        {
                            "text": "Years of continuous warfare and <w>marauding</w> left the borderlands completely deserted.",
                            "target_lang_translations": {
                                "nl": "Jaren van aanhoudende oorlogsvoering en <w>rooftochten</w> lieten het grensgebied volkomen verlaten achter."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillaging",
                        "plundering",
                        "raiding"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het uitvoeren van plunderingen of rooftochten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het plunderen",
                                "target_lang_sense_clarification": "het plegen van plunderingen"
                            },
                            {
                                "target_lang_word": "plunderingen",
                                "target_lang_sense_clarification": "reeks van rooftochten"
                            },
                            {
                                "target_lang_word": "rooftochten",
                                "target_lang_sense_clarification": "invallen om buit te maken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}