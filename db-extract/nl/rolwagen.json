                                        "examples": [
                                            {
                                                "example_id": "be3ff60d-fb60-4993-8dff-b15b49ea9ba4",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "Almost all of them learned wheelchairing and all learned to manage to eat by themselves."
                                            },
                                            {
                                                "example_id": "e3dc392f-204d-40fd-9d04-a615dac31ddd",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "People who took part walked, jogged, ran, rollerbladed and wheelchaired the five kilometers"
                                            },
                                            {
                                                "example_id": "35c92482-0643-4594-87e3-8dd31e5b693d",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "They strolled, ran, walked and wheelchaired the track."
