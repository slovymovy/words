                                        "sense_id": "465a72c6-e37f-3f77-bae0-e3aae027198e",
                                        "entry_id": "ea428ed6-131c-368d-afec-a9f442cb6514",
                                        "glosses": [
                                            "Personne qui demande quelque chose, qui fait métier de demander."
