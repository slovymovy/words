                "senses": [
                    {
                        "sense_id": "ecb13f0a-9eb5-39a9-94a9-dc358d81ce56",
                        "entry_id": "d61cda42-0d2d-3d8c-8ad6-92e2568f0144",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord gewervelde"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3fccd175-2816-4332-b713-cae3278f872a",
                                "sense_id": "ecb13f0a-9eb5-39a9-94a9-dc358d81ce56",
                                "text": "En bovendien is van andere eekhoornsoorten ook bekend dat ze niet strikt plantaardig voedsel eten, maar het soms ook hebben voorzien op kleine gewervelden, zoals vogels of muizen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c21bcc48-9869-3064-a2d2-4b7b4ca780c0",
                        "entry_id": "d61cda42-0d2d-3d8c-8ad6-92e2568f0144",
                        "glosses": [
                            "een onderstam Vertebrata van chordadieren. Gewervelde dieren kenmerken zich door de aanwezigheid van een wervelkolom, een schedel en neurale lijstcellen. Tot de gewervelden behoren onder meer de prikken, vissen, amfibieën, reptielen, vogels en de zoogdieren. De gewervelden maken het grootste deel uit van de Chordata, dieren die (in aanleg) een chorda dorsalis hebben. Tot de Chordata behoren naast de gewervelden ook lancetvisjes (Cephalochordata) en manteldieren (Urochordata). Er zijn ongeveer 70.000 soorten gewervelde dieren benoemd en beschreven"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming",
                            "dieren"
                        ],
                        "examples": [
                            {
                                "example_id": "d95350ee-f439-4cd5-8a90-6e10567f350d",
                                "sense_id": "c21bcc48-9869-3064-a2d2-4b7b4ca780c0",
                                "text": "De pantservissen (Placodermi) zijn een uitgestorven groep van zwaargepantserde vissen. Ze staan aan de basis van de stamboom van de gewervelden met een kaak (er zijn ook kaakloze gewervelden)."
                            }
                        ]
                    }
