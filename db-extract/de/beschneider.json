                ],
                "senses": [
                    {
                        "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                        "entry_id": "d765e0ac-c787-37c3-9e29-0f826fdb1ec5",
                        "glosses": [
                            "(männliche^☆) Person, die eine (rituelle) Beschneidung bei Jungen – je nach Glaubensgemeinschaft auch bei Mädchen – vornimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5201a4a1-9476-4c43-8a6e-4a426772b93e",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Die Beschneidung wird zu einem beliebigen Zeitpunkt zwischen dem fünften und zehnten Lebensjahr vollzogen. Der ‚Modin‘ (Beschneider) ist ein gewöhnlicher Mann aus dem Dorf.“"
                            },
                            {
                                "example_id": "5dbab54f-0589-48ad-9854-5ceb6d7068c3",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„In einigen Städten gibt es professionelle Beschneider (sünnetçi) und auch teilweise Spezialgeschäfte für diesen Anlaß.[…]In manchen Fällen erfolgt der Eingriff in der Klinik oder Praxis eines Beschneiders, und das Fest folgt gesondert.“"
                            },
                            {
                                "example_id": "d2b2be94-c939-43c2-9093-f619fa1299f5",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Der Unicef geht, gestützt auf mehrere Untersuchungen, davon aus, dass in der Schweiz aufgewachsene Mädchen für Ferien in das Heimatland der Eltern geschickt und dort beschnitten werden – wenn nicht auf einen durchreisenden Beschneider zurückgegriffen werden kann.“"
                            },
                            {
                                "example_id": "6600ca76-5ac5-4fda-b484-ad4f42de66b2",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Aber auch Barbiere z.B. bei den Hausa im Norden Nigerias, und männliche ‚Priester‘, wie im nördlichen Zaire traditionell üblich, können Beschneider kleiner Mädchen sein.“"
                            },
                            {
                                "example_id": "01e6298e-3064-414e-97ed-2c7216f29b6e",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„In der Regenzeit ruft der Otschongo, der Beschneider, alle Bürschchen einer Ortschaft, also etwa 1o—2o, zusammen.“"
                            },
                            {
                                "example_id": "5564121f-0e3e-4e22-8be7-295671754a30",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Auch nach dem Kölner Urteil würden die von den Synagogen bestellten Beschneider (Mohel) die Entfernung der Vorhaut von Knaben fortsetzen, fügte der Rabbiner Avichai Apel von der Orthodoxen Rabbinerkonferenz Deutschland hinzu.“"
                            },
                            {
                                "example_id": "3940ed6a-ea02-4ff5-92fd-e60675f75d3d",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Die Väter in Syrien oder dem Libanon bringen ihre Söhne im ersten Lebensjahr zum mutahir, dem ‚Beschneider‘.“"
                            },
                            {
                                "example_id": "f03c8700-adcc-4e9b-a5bb-a08a2f29a515",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Kurz vorher waren in Boston sechs Kinder an Herpes gestorben, nachdem der Beschneider ihnen mit herpesinfizierten Lippen das Blut aus der Wunde saugte.“"
                            },
                            {
                                "example_id": "d070ddcd-ef49-4398-b9ef-d8ca8b2b300d",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Gastgeber Eli Kalderon hat auf Anweisung des Beschneiders Menachem Fleischman alles vorbereitet: zwei Gebetsschals, zwei Babyunterhosen, ein Kopfkissen, eine antiseptische Salbe zur Wundheilung.“"
                            },
                            {
                                "example_id": "d42b2a99-bc94-4af2-aab2-00361748f5f0",
                                "sense_id": "6d3c24d2-ca01-392f-97d8-76cb1a83422f",
                                "text": "„Metzger hatte gefordert, dass deutsche Ärzte jüdische Beschneider für ihre Arbeit ausbilden sollten, und betont, der Einsatz schmerzstillender Mittel widerspreche religiösen Geboten. Diese Ausführungen gehen laut Kramer an der deutsch-jüdischen Realität weit vorbei. ‚Weder ist es nötig, Mohalim (Beschneider) durch deutsche Ärzte ausbilden zu lassen, noch lehnen die Gemeinden und Eltern in Deutschland schmerzstillende Mittel rundweg ab‘, betont der Generalsekretär.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
