                "senses": [
                    {
                        "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                        "glosses": [
                            "With great haste, with a sense of urgency, because it is very important."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0960ee83-65a9-4fe0-b355-135de6f1041e",
                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                "text": "We all urgently need to apply solutions to the problem of pollution."
                            },
                            {
                                "example_id": "5f897afc-c224-44d0-abbe-dc942424a401",
                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                "text": "Funds are urgently required if this work is to be completed as planned."
                            },
                            {
                                "example_id": "81e8f139-3e98-4dee-8dcb-40ffc4ed41d4",
                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                "text": "And now we're waiting for the very same people to establish GBR, drive through urgently needed fares reform, and come up with imaginative and effective train operating contracts..."
                            }
                        ]
                    },
                    {
                        "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                        "glosses": [
                            "Continuously. With insistence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7392ed-5d36-450f-b4d3-828069e868c3",
                                "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                                "text": "He pleaded urgently for release from what he considered to be an unjust imprisonment."
                            }
                        ]
                    }
                ],
