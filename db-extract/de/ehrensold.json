                        "cross_references": [
                            {
                                "target_word": "émoluments",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e3ee1ea-ab2d-3d4d-886e-8f6361af7dd8",
                                        "entry_id": "6c60f15c-2ed8-337f-a381-2b9f71562658",
                                        "glosses": [
                                            "Pluriel de émolument."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebca9b6-0e14-402a-8d16-14f808de883d",
                                                "sense_id": "0e3ee1ea-ab2d-3d4d-886e-8f6361af7dd8",
                                                "text": "Ernest de La Brière, jeune homme alors âgé de vingt-sept ans, décoré de la Légion d’honneur, sans autre fortune que les émoluments de sa place, possédait la triture des affaires, et savait beaucoup après avoir habité pendant quatre ans le cabinet du principal ministère."
                                            },
                                            {
                                                "example_id": "b738e62f-99a4-4519-b20a-e06e05983c7d",
                                                "sense_id": "0e3ee1ea-ab2d-3d4d-886e-8f6361af7dd8",
                                                "text": "Parbleu ! s’écria le comte d’une voix tonnante, vous refusez votre appui à cette malheureuse, vous faites disparaître sa dernière lueur d’espérance, vous la réduisez au désespoir, au lieu de la soutenir et de la défendre, comme c’est votre devoir !… Et vous osez garder votre place, vous osez en toucher les émoluments !… ah ! Monsieur !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
