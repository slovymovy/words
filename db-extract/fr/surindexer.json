                "senses": [
                    {
                        "sense_id": "c55821f0-a67b-37b6-9163-6b0469dc40db",
                        "entry_id": "a70bded7-57f8-3dc6-b899-8ef492d55491",
                        "glosses": [
                            "Indexer mais en utilisant une valeur supérieure à la valeur de l’index choisi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4adc5c15-5267-453b-92fd-ba33bd9b0b2d",
                                "sense_id": "c55821f0-a67b-37b6-9163-6b0469dc40db",
                                "text": "Ceux-ci, en effet, écœurés par la baisse de leurs cens, se tournent vers la propriété de la terre, dont la valeur est garantie contre l’inflation parce que indexée, surindexée même par rapport au mouvement des prix."
                            },
                            {
                                "example_id": "0d962ef2-96ad-4524-8244-f4d18a8c95bb",
                                "sense_id": "c55821f0-a67b-37b6-9163-6b0469dc40db",
                                "text": "Il semble que les salaires aient été surindexés et qu’une hausse des prix de détail engendre, à long terme, une hausse un peu plus forte du taux de salaire."
                            }
                        ]
                    }
