                "senses": [
                    {
                        "sense_id": "2d60aed9-64e6-342b-9ede-6d5a2ded9ff4",
                        "entry_id": "8ff2625d-b5fe-36dd-a81c-15e2ca230839",
                        "glosses": [
                            "Kreditinstitut, fast immer in öffentlicher Trägerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a558890-36e1-4c75-b259-d5dd00790a84",
                                "sense_id": "2d60aed9-64e6-342b-9ede-6d5a2ded9ff4",
                                "text": "„Der Auffassung des Berufungsgerichtes, daß der Umstand, daß der Gläubiger bei einer Bank (oder Sparkassa) ein Konto unterhält, schlechthin den Schuldner ermächtige, auf dieses Konto Zahlungen zu leisten, kann nicht zugestimmt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8a7eca2-c916-33ce-8e00-93e257841a64",
                        "entry_id": "8ff2625d-b5fe-36dd-a81c-15e2ca230839",
                        "glosses": [
                            "Gefäß zur Aufbewahrung von Geld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c8c138-34d2-44ba-8c19-fda4d2d83857",
                                "sense_id": "f8a7eca2-c916-33ce-8e00-93e257841a64",
                                "text": "„Du darfst es in deine Sparkassa werfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed155b9c-8038-454c-929e-f726d5636552",
                        "source_entry_id": "8ff2625d-b5fe-36dd-a81c-15e2ca230839",
                        "source_sense_id": "2d60aed9-64e6-342b-9ede-6d5a2ded9ff4",
