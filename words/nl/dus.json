            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d90e1ae6-2ef7-33f1-b467-76d475f59e5e",
                    "sense_definition": "Om die reden; verbindt een oorzaak met een gevolg.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is mooi warm weer, <w>dus</w> trek ik geen trui aan.",
                            "target_lang_translations": {
                                "ru": "Стоит хорошая теплая погода, <w>поэтому</w> я не надеваю свитер.",
                                "en": "The weather is nice and warm, <w>so</w> I'm not putting on a sweater.",
                                "pl": "Jest ładna, ciepła pogoda, <w>więc</w> nie zakładam swetra.",
                                "de": "Das Wetter ist schön warm, <w>deshalb</w> ziehe ich keinen Pullover an.",
                                "fr": "Il fait beau et chaud, <w>donc</w> je ne mets pas de pull.",
                                "it": "Fa un bel tempo caldo, <w>quindi</w> non mi metto il maglione.",
                                "cs": "Je hezké teplé počasí, <w>takže</w> si neberu svetr.",
                                "tr": "Hava güzel ve sıcak, <w>bu yüzden</w> kazak giymiyorum.",
                                "es": "Hace un tiempo agradable y cálido, <w>así que</w> no me pongo un suéter."
                            }
                        },
                        {
                            "text": "Hij had goed gestudeerd, <w>dus</w> was hij niet bang voor zijn examen.",
                            "target_lang_translations": {
                                "ru": "Он хорошо учился, <w>поэтому</w> не боялся экзамена.",
                                "en": "He had studied well, <w>so</w> he wasn't afraid of his exam.",
                                "pl": "Dobrze się uczył, <w>dlatego</w> nie bał się egzaminu.",
                                "de": "Er hatte gut gelernt, <w>also</w> hatte er keine Angst vor seiner Prüfung.",
                                "fr": "Il avait bien étudié, <w>donc</w> il n'avait pas peur de son examen.",
                                "it": "Aveva studiato bene, <w>quindi</w> non aveva paura del suo esame.",
                                "cs": "Dobře se učil, <w>proto</w> se nebál zkoušky.",
                                "tr": "İyi çalışmıştı, <w>bu yüzden</w> sınavından korkmuyordu.",
                                "es": "Él había estudiado bien, <w>por lo tanto</w> no tenía miedo de su examen."
                            }
                        }
                    ],
                    "synonyms": [
                        "daarom",
                        "vandaar"
                    ],
                    "common_phrases": [
                        "en dus"
                    ],
