                                    {
                                        "sense_id": "e2db77db-baa4-3da0-8740-72f30ebbbdf3",
                                        "entry_id": "9fb082da-fd34-386b-99e5-789c34ccabce",
                                        "glosses": [
                                            "The profession of teaching."
                                        ],
                                        "tags": [
                                            "countable",
