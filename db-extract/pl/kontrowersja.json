                        "cross_references": []
                    },
                    {
                        "translation_id": "b12ce8f1-19e5-49c6-b982-c9f424ecb829",
                        "source_entry_id": "2911b154-61f6-3f36-85f0-093bc6d00269",
                        "source_sense_id": "f7cd0974-031a-31e6-b6ee-e32a32e5340f",
                        "target_lang_word": "controverse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "controverse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cecd6f-543a-33bf-91d4-d65c50780bf8",
                                        "entry_id": "c3fa8718-5062-3a20-a5c2-37001248bc64",
                                        "glosses": [
                                            "Débat sur une question, sur une opinion, etc. suscité par des avis divergents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed2a701-40ee-4ab4-8d00-fb31354557b2",
                                                "sense_id": "f7cecd6f-543a-33bf-91d4-d65c50780bf8",
                                                "text": "L’Assemblée de Versailles […] consuma toute une année en controverses stériles, en discussions puériles, en luttes bysantines."
                                            },
                                            {
                                                "example_id": "6875b06f-b62f-42f0-b7d3-493ed808bcd4",
                                                "sense_id": "f7cecd6f-543a-33bf-91d4-d65c50780bf8",
                                                "text": "Malgré les controverses de l’entre-deux-guerres, sous la pression de la laïcisation en cours des affaires publiques, la plupart des sociétés ont rechigné à abandonner l'idée que l’État représente un système décrété par Dieu, pour le salut des hommes dans ce monde et dans l'autre."
                                            },
                                            {
                                                "example_id": "c1bb36b7-4418-440c-8f82-910cd9b32085",
                                                "sense_id": "f7cecd6f-543a-33bf-91d4-d65c50780bf8",
                                                "text": "[…] et le démontage systématique du mécanisme de l’improvisation, comme l’explication hardie que nous en offrons ensuite, donnent prise à la controverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f392b06f-e524-346e-9140-480b6e505b15",
                                        "entry_id": "c3fa8718-5062-3a20-a5c2-37001248bc64",
                                        "glosses": [
                                            "Dispute qui a pour objet des points de foi."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4c3458-742a-4443-9e40-2726a537f9e9",
                                                "sense_id": "f392b06f-e524-346e-9140-480b6e505b15",
                                                "text": "Pour confondre à tout jamais les « ennemis du Christ », Louis IX accepta d’organiser, en 1240, une controverse solennelle sur le Talmud."
                                            }
                                        ]
                                    }
                                ]
                            },
