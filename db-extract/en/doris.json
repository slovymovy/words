                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b25bba6b-5f1a-38e5-9003-510a30674d8d",
                        "entry_id": "518cbe90-c669-3485-a04c-57cf54dbab04",
                        "glosses": [
                            "An ancient mountainous region of Greece, the traditional homeland of the Dorians."
