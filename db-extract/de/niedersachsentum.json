                        "sense_id": "44fdcc4a-1c41-3167-8013-169b6db09b0c",
                        "entry_id": "c93b4092-e5fa-3f01-a0cf-e475060764e5",
                        "glosses": [
                            "für Niedersachsen typische Einstellungen, Verhaltensweisen"
