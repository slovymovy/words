        "nl-extract.jsonl": [
            {
                "entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                "word": "dolleman",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "0c87f570-370c-4fdc-a37f-5e1725e628b5",
                        "entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "dollemannen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                        "entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "glosses": [
                            "een wilde woesteling; iemand die zich druk en vreemd gedraagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df92a539-1ad6-490d-b60e-d17d8f1c3d68",
                                "sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                                "text": "Hij kreeg een lading pepperspray te verwerken, maar de dolleman slaagde er toch nog in het gevecht met de politie aan te gaan."
                            },
                            {
                                "example_id": "a24ab3e5-06a7-4cd1-b3c9-7dc496664138",
                                "sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                                "text": "De trainer van PSV zegt, als hij nog niet helemaal bij zinnen is, dat Blom een 'homereferee' is, een thuisfluiter. Hij koelt zijn woede over de rode kaart van Strootman. De middenvelder zelf verlaat als een dolleman het veld en slaat in de catacomben een paar keer tegen de muur. De camera's registreren alles."
                            },
                            {
                                "example_id": "1151b37f-77f5-470c-91fb-2fdc526ae580",
                                "sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                                "text": "Formeel was de vlak voor hem gestarte Wernke, die als een dolleman door het parcours in het Duitse stadspark ging, sneller dan Bruggink. Maar de jonge Duitser maakte op de laatste hindernis een fout en kreeg daardoor vier seconden extra aan de broek. Dat was precies genoeg voor de ook altijd snelle Bruggink om er nog onder te duiken."
                            },
                            {
                                "example_id": "3e5d3daf-1433-489a-9b3e-c15ae245192e",
                                "sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                                "text": "\"Ik ben als een dolleman gaan rijden.\" Juan zegt dat twee passagiers hem opjutten om gas te geven. Hij negeerde stoptekens van de politie, ramde op zijn vlucht zes auto's waaronder twee politiewagens en zou zes agenten met zijn rijgedrag hebben bedreigd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fcd1faa-c56c-4ce7-ad7d-78d34eb76074",
                        "source_entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
                        "source_sense_id": "45ebecd4-007d-3082-85a9-5c1f7cedfc71",
                        "target_lang_word": "imbecile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbecile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db3dfade-0631-330f-9940-d00dbd61fc65",
                                        "entry_id": "fd18cecd-e17f-3c70-8aa8-bd201b992d94",
                                        "glosses": [
                                            "A person with limited mental capacity who can perform tasks and think only like a young child, in medical circles meaning a person who lacks the capacity to develop beyond the mental age of a normal five- to seven-year-old child."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e51676e7-4185-4cf1-8eea-fb623316a222",
                                                "sense_id": "db3dfade-0631-330f-9940-d00dbd61fc65",
                                                "text": "It is an offence for a man to have unlawful sexual intercourse with a woman whom he knows to be an idiot or imbecile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a91fb4-34dc-3747-acd9-4dce796f9f4a",
                                        "entry_id": "fd18cecd-e17f-3c70-8aa8-bd201b992d94",
                                        "glosses": [
                                            "A fool, an idiot."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11fb6e98-929c-40ad-8bdf-07d934999004",
                                                "sense_id": "d0a91fb4-34dc-3747-acd9-4dce796f9f4a",
                                                "text": "VLADIMIR: Because he wouldn't save them. / ESTRAGON: From hell? / VLADIMIR: Imbecile! From death."
                                            },
                                            {
                                                "example_id": "43e8a678-43d0-4f79-b557-0d8e22ca4d26",
                                                "sense_id": "d0a91fb4-34dc-3747-acd9-4dce796f9f4a",
                                                "text": "“A rat picked up a drink can and threw it at me?” yelled Mr Big.\n“A big rat, guv’nor? One of them super-rats?” suggested Thumbs.\n“It landed on my head, you imbecile!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imbecile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ffb10d4-0ae0-3568-a92e-72917e10b6f5",
                                        "entry_id": "21cda2d6-7998-3786-a88b-61ee6a1723dd",
                                        "glosses": [
                                            "Destitute of strength, whether of body or mind; feeble; impotent; especially, mentally weak."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc480902-e7ac-4d6e-ac4e-bfbc17f2eeef",
                                                "sense_id": "9ffb10d4-0ae0-3568-a92e-72917e10b6f5",
                                                "text": "hospitals for the imbecile and insane"
                                            },
                                            {
                                                "example_id": "d0e2e5b2-bcda-4154-9f94-c17da9424c78",
                                                "sense_id": "9ffb10d4-0ae0-3568-a92e-72917e10b6f5",
                                                "text": "And then that imbecile crowd down on the deck started their little fun, and I could see nothing more for smoke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfb7451b-0d47-4b60-9594-ac3511583108",
                        "source_entry_id": "de6ca540-fcda-3179-8484-b9aba762faaa",
