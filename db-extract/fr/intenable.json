        "fr-extract.jsonl": [
            {
                "entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                "word": "intenable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a597cd9-a3d4-4bd3-985d-41ec8de3cb98",
                        "entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intenables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                        "entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                        "glosses": [
                            "Que l’on ne peut tenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94d814d-a843-4c46-a6df-69bb936a0766",
                                "sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                                "text": "Promesse intenable."
                            },
                            {
                                "example_id": "de9ebb98-e53e-4155-afc2-966839bed944",
                                "sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                                "text": "— C’est vrai, vous autres catholiques, vous n’aimez pas les positions intenables. Vous avez l’âme habituée au confort.\n— Je ne trouve pas, dit Pierson avec tout juste un peu de sécheresse dans la voix, le catholicisme exige beaucoup.\n— Non, il n’exige pas beaucoup par rapport au repos qu’il donne. C’est merveilleux, le repos qu’il donne."
                            },
                            {
                                "example_id": "052dc843-3681-44aa-8fa8-144c5f51ca49",
                                "sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                                "text": "[Stephen Hawking] Il se pourrait que les attentes classiques du physicien d’une théorie unifiée de la nature soient intenables, et qu’il n’existe aucune explication unique."
                            },
                            {
                                "example_id": "11c7ba3d-4903-4488-9a9d-ee019be8c5a8",
                                "sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                                "text": "Symbole d’une position de plus en plus intenable pour le tempétueux président, la Géorgie, où Joe Biden l’a emporté d’une courte tête, a officiellement certifié vendredi après-midi les résultats de l’élection."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b86d876-61e1-3c6b-af71-b383d39461e5",
                        "entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                        "glosses": [
                            "Où l’on ne peut se maintenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f52075-1405-45cf-a507-7c8123509a21",
                                "sense_id": "8b86d876-61e1-3c6b-af71-b383d39461e5",
                                "text": "« Les gens vivent un enfer, sont agressifs… La situation est intenable » a-t-il poursuivi, ajoutant que « c’est aussi un enfer pour les crackers, indigne de la République française »."
                            },
                            {
                                "example_id": "9ee957d2-4bf0-4d91-b415-58ec69522ba6",
                                "sense_id": "8b86d876-61e1-3c6b-af71-b383d39461e5",
                                "text": "Dans les églises, dans les rues, sur les places publiques, évêques, prêtres et moines, nestoriens et cyrilliens se prennent à partie et s'invectivent en termes crus. La situation devient intenable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cc3e75b-9e3d-4971-9749-81ae62ba1eb4",
                        "source_entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                        "source_sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                        "source_sense_description": "Que l’on ne peut tenir",
                        "target_lang_word": "untenable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untenable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                        "entry_id": "4b168b6f-730d-3588-9e27-bdca2b9ff7e0",
                                        "glosses": [
                                            "Not able to be held or sustained, such as of an opinion or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee57282-1e0b-4962-83ff-744baa7cb5b9",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "The theory of cold fusion was untenable."
                                            },
                                            {
                                                "example_id": "472f7bb4-ea98-4b5e-a09a-d206ba63cf02",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "They are seeking to escape from the unpleasant implications of an untenable status dilemma. They desire but cannot afford a prestigious social status."
                                            },
                                            {
                                                "example_id": "118b45cf-548f-460f-8411-6a96fb0362b6",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "The rumors about Anderson nevertheless placed Glasgow in an untenable social position, for close friends either suspected or knew of their engagement."
                                            },
                                            {
                                                "example_id": "239aa367-6187-420c-b608-14a6515f0c8e",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "The modern family would be an artificial and untenable social structure in this early period, just as the clan appears to be an artificial institution in our own society."
                                            },
                                            {
                                                "example_id": "32c0612b-ef24-40c3-be28-e61843cbaa79",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "Celebrating him [Robert E. Lee] in the time of George Floyd became, at last, untenable."
                                            },
                                            {
                                                "example_id": "f8cf8513-1a4a-4855-9360-700bbbe1e0b0",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "He describes the untenable position of the railways' finances reasonably dispassionately. From 1952 onwards, British Railways ran an operational deficit, and in 1961 made an annual loss of £86.9 million."
                                            },
                                            {
                                                "example_id": "a74031f6-8ae4-4ab2-b658-01376fdafbed",
                                                "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                                                "text": "The Site Director was expected to initiate DISCIDIUM Protocol should the situation become untenable; so far as remote observation of the remains of Ipperwash Park above can show, this was not done. Transmissions are occasionally intercepted from the Site, and after memetic 'washing' by RAISA have been determined to originate from uncompromised personnel conducting a war of attrition against the above-mentioned entities. It is from their reports that the majority of this information, save for that regarding SCP-001-A, has been derived. As an understanding of each entity may aid in the defeat of SCP-001-A, no action has been taken to remove Site-43 from operational effectiveness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471f96a7-b455-3b9d-ade8-40bbd8b18335",
                                        "entry_id": "4b168b6f-730d-3588-9e27-bdca2b9ff7e0",
                                        "glosses": [
                                            "Unfit for habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a66bfc14-2928-4def-9c74-11be2f2e94fa",
                                                "sense_id": "471f96a7-b455-3b9d-ade8-40bbd8b18335",
                                                "text": "[…] ceilings, staircases, all that make a house habitable had vanished in the flare of his conflagration, and since his soul could no longer dwell there, it dwelt instead, so to speak, in the pleasant garden which surrounded the untenable house."
                                            },
                                            {
                                                "example_id": "a30208d7-e2cf-474b-906c-ea593a4fd43b",
                                                "sense_id": "471f96a7-b455-3b9d-ade8-40bbd8b18335",
                                                "text": "The floor was a veritable mud puddle, and even the meager bedding of old reindeer skins was wet from the dripping walls and ceiling. This untenable dwelling housed a family of six Eskimos: a grandmother, father and mother and three children."
                                            },
                                            {
                                                "example_id": "ce3012e0-78d1-4049-857e-9c95ea0e9844",
                                                "sense_id": "471f96a7-b455-3b9d-ade8-40bbd8b18335",
                                                "text": "It is equally plausible to interpret the evidence to imply a life-span extending well into the fifth century, followed by a phase when the building became increasingly shabby and then untenable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad15e024-1a3f-41f9-9acd-1de428147baa",
                        "source_entry_id": "01548d8c-e964-3b3a-805e-e60d9b2dfbbe",
                        "source_sense_id": "e2429220-ce46-36f8-94f5-cc0dd91c32ef",
                        "source_sense_description": "Que l’on ne peut tenir",
                        "target_lang_word": "unsustainable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsustainable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8ea5ae-9da3-3703-9619-6a488eae7e05",
                                        "entry_id": "2770764d-4b3e-36d8-afc4-654f27f3b207",
                                        "glosses": [
                                            "Not sustainable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553bcf7b-c63c-4299-81d7-6ca88c032f49",
                                                "sense_id": "5c8ea5ae-9da3-3703-9619-6a488eae7e05",
                                                "text": "You don't have to be Einstein to work out that this level of government subsidy is unsustainable."
                                            },
                                            {
                                                "example_id": "78a490d2-965c-4c95-81fa-1ed2344a4303",
                                                "sense_id": "5c8ea5ae-9da3-3703-9619-6a488eae7e05",
                                                "text": "RTDs cover a multitude of sips, including: “hard” or “spiked” teas, coffees, kombuchas and seltzers; […]. And although the sector was birthed in the ’30s by drinks like Campari Soda, and boomed in the ’90s with Bacardi Breezer and Smirnoff Ice, RTDs are now at a point of seemingly unsustainable saturation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unsustainable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eafd854-0527-3c72-8c01-5a60af51876f",
                                        "entry_id": "b4da0b74-92b9-3c97-a566-e1e26236a4b8",
                                        "glosses": [
                                            "Something that cannot be sustained."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
