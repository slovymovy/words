                "senses": [
                    {
                        "sense_id": "8573db7d-2e11-3f7c-8eb9-fd0c7c76aabc",
                        "entry_id": "021a0d0d-6b07-3ee5-a14f-c3d2eb5efec4",
                        "glosses": [
                            "mit einer vor allem metallenen Panzerung versehener oder vollständig metallener Handschuh (als Teil einer Rüstung)"
                        ],
                        "tags": [
                            "historical",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0d42c630-e1e0-4c6b-8a0f-29618738497c",
                                "sense_id": "8573db7d-2e11-3f7c-8eb9-fd0c7c76aabc",
                                "text": "„Natürlich wäre das Armzeug ohne die Panzerhandschuhe, die als Fingerhandschuhe oder Fäustlinge gearbeitet sein können, nicht vollständig. Dabei nennt man Panzerhandschuhe ohne Finger Hentzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "782e7e26-dd15-3b0f-93d3-8a25afa4173c",
                        "entry_id": "021a0d0d-6b07-3ee5-a14f-c3d2eb5efec4",
                        "glosses": [
                            "bestimmter (Wund-)Verband, der die Hand und Finger in mehreren Lagen stabilisierend umwickelt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "85187f2f-ea37-4776-9cf0-aeb4a6941f51",
                                "sense_id": "782e7e26-dd15-3b0f-93d3-8a25afa4173c",
                                "text": "„Um den halben Panzerhandschuh anzulegen, wählt man eine 3 bis 4 Ellen lange, höchstens einen Zoll breite, einköpfige Binde, und macht mit derselben einige Zirkelgänge um das Handwurzelgelenk von der Seite des kleinen Fingers her nach der des Daumens, geht hierauf schräg über den Rücken der Hand zwischen Daumen und Zeigefinger durch, um den unteren Theil des Zeigefingers herum, und wieder über den Handrücken nach der Daumenseite der Handwurzel, so daſs sich die Gänge auf dem untersten Gelenke des Fingers kreuzen. […]“ [1831]"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0178cabd-bb5a-4403-8078-322cced2a430",
                        "source_entry_id": "021a0d0d-6b07-3ee5-a14f-c3d2eb5efec4",
                        "source_sense_id": "8573db7d-2e11-3f7c-8eb9-fd0c7c76aabc",
