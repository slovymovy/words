                "senses": [
                    {
                        "sense_id": "b5a605d6-53ba-352d-8731-b9261ac8af5f",
                        "entry_id": "d4b658d9-2a80-3f44-a4a5-47e40bb1c9e5",
                        "glosses": [
                            "bestimmtes Verkehrsschild, das Verkehrsteilnehmern das Gewähren von Vorfahrt vor der eigenen Weiterfahrt vorschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f364efb3-cf8b-40bf-bc7b-789af7f21e5e",
                                "sense_id": "b5a605d6-53ba-352d-8731-b9261ac8af5f",
                                "text": "„Bei Warnzeichen zeigt die Spitze wie bei einem A nach oben. Beim Vorfahrt-gewähren-Schild zeigt sie wie beim V nach unten.“"
                            },
                            {
                                "example_id": "206b7481-e46d-40fd-80dc-0f9aa37869b1",
                                "sense_id": "b5a605d6-53ba-352d-8731-b9261ac8af5f",
                                "text": "„Ein Motor heult auf, ein schwarzer BMW rast mit unwahrscheinlichem Karacho an der Gebäudereihe vorbei, hundert Meter weiter leuchtet ein Vorfahrt-gewähren-Schild.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
