                "senses": [
                    {
                        "sense_id": "51a1ae8b-7d98-38ef-a250-129f2935f176",
                        "entry_id": "48787945-d448-303b-9b14-8719aba503e1",
                        "glosses": [
                            "Faire un bisou à quelqu’un, embrasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf244eee-e011-4de1-a5a1-3044837367da",
                                "sense_id": "51a1ae8b-7d98-38ef-a250-129f2935f176",
                                "text": "Car poutouner Mme Merkel, après tout, pourquoi pas, les Allemands savent tous, maintenant que les Français claquent la bise aux dames."
                            },
                            {
                                "example_id": "af2707e3-dc35-459c-b6d0-1183eaad49ef",
                                "sense_id": "51a1ae8b-7d98-38ef-a250-129f2935f176",
                                "text": "Un film pour une soirée avec son amoureux(se) où seule domine l'envie de se pelotonner l'un contre l'autre et de se poutouner, sans se casser la tête."
                            }
                        ]
                    }
