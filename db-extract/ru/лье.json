                                        "entry_id": "a7a01a05-e0c6-3484-abec-1283a0fbe3a8",
                                        "glosses": [
                                            "To form an association; to unite in a league or confederacy; to combine for mutual support."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6096d404-a7d1-498b-9477-6ad2dab5faea",
                                                "sense_id": "4c114cad-aff6-3efd-831e-48b1e4c48ee0",
                                                "text": "Out of my sight, thou Serpent, that name best Befits thee with him leagu'd."
                                            },
                                            {
                                                "example_id": "5a2d0256-d0d2-495f-8f72-1f5311650af0",
                                                "sense_id": "4c114cad-aff6-3efd-831e-48b1e4c48ee0",
                                                "text": "I believe that all the Bohemians and the great folks in Paris are so leagued together, that they are afraid of one another, and the people receive all the buffets of their disagreeings."
                                            }
                                        ]
                                    }
                                ]
                            },
