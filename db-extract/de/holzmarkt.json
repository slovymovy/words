                ],
                "senses": [
                    {
                        "sense_id": "907ce109-90c8-3a89-b236-fceef075f28b",
                        "entry_id": "3e3a47be-e9ca-37cf-a715-64a3b253b274",
                        "glosses": [
                            "Veranstaltung (sowie der Ort, an dem diese stattfindet), bei der mit Holz Handel getrieben beziehungsweise dieses zum Verkauf angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d000406c-41fd-4dae-99fe-573a1b0121db",
                                "sense_id": "907ce109-90c8-3a89-b236-fceef075f28b",
                                "text": "„Sonntags durfte [in Bologna] kein Markt stattfinden. Mittwochs sowie montags war der Holzmarkt ebenfalls geschlossen.“"
                            },
                            {
                                "example_id": "fcd175ce-0784-4a25-be7f-b486f116af71",
                                "sense_id": "907ce109-90c8-3a89-b236-fceef075f28b",
                                "text": "„Es brannten zugleich das Viertel, wo die Wagenfabriken waren, Samoskworetschje, der Kaufhof, die Powarskaja, die Barken auf der Moskwa und der Holzmarkt an der Dorogomilowka-Brücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64ba0c8d-1cfe-3234-abb1-9dde8e8e6a8f",
                        "entry_id": "3e3a47be-e9ca-37cf-a715-64a3b253b274",
                        "glosses": [
                            "Bereich der Wirtschaft (eines Staates), der von Angebot und Nachfrage an Holz geregelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0dea1f-7787-41ff-950e-9006d5e85566",
                                "sense_id": "64ba0c8d-1cfe-3234-abb1-9dde8e8e6a8f",
                                "text": "„Für den Schweizer Holzmarkt gibt es nur wenig Marktforschung.“"
                            },
                            {
                                "example_id": "0c4a472c-71e8-453b-ac57-2ca176549ab9",
                                "sense_id": "64ba0c8d-1cfe-3234-abb1-9dde8e8e6a8f",
                                "text": "„Holzmärkte sind durchaus ein interessantes Feld der ökonomischen Analyse.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
