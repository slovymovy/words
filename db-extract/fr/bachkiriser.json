                        "glosses": [
                            "Donner un caractère bachkir à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720112a5-eaa5-4aea-8dc3-c8b877d56f75",
                                "sense_id": "3d358024-63d1-388b-a16d-ab0c80663fcc",
                                "text": "Avec le Târîkh-nâma-yi Bulghâr, objet du quatrième chapitre, nous voyons comment son auteur, Yâlchïgul-ûghlî, « bachkirise » l’identité bulghare, popularisée avant lui par Husâm al-Dîn."
                            },
                            {
                                "example_id": "4798519e-1816-4fe4-bdf3-20c2d798709b",
                                "sense_id": "3d358024-63d1-388b-a16d-ab0c80663fcc",
                                "text": "Le Bachkortostan se bachkirise...."
                            },
                            {
                                "example_id": "47c0695a-c9ee-4e13-a17a-4bfa4b4dca7e",
                                "sense_id": "3d358024-63d1-388b-a16d-ab0c80663fcc",
                                "text": "Quant aux Teptères qui sont des Tatars bachkirisés, leur taille est de 1.653 m/m d’après 37 sujets mesurés par Nikolsky (899, p. 220)."
                            }
                        ]
                    }
