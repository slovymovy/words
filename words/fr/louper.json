{
    "word_family": [
        "loupé",
        "loupage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51ae1ab1-0750-3a57-bb4b-ac130dfb4877",
                    "sense_definition": "Arriver trop tard pour prendre un moyen de transport ou laisser passer une occasion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi un peu ou nous allons <w>louper</w> le dernier train pour Paris.",
                            "target_lang_translations": {
                                "en": "Hurry up a bit or we're going to <w>miss</w> the last train to Paris.",
                                "ru": "Поторопись немного, или мы <w>опоздаем</w> на последний поезд в Париж.",
                                "de": "Beeil dich ein bisschen, sonst <w>verpassen</w> wir den letzten Zug nach Paris.",
                                "es": "Date prisa un poco o vamos a <w>perder</w> el último tren a París.",
                                "zh": "快一点，不然我们就要<w>错过</w>去巴黎的末班车了。"
                            }
                        },
                        {
                            "text": "Je suis parti trop tard et j'ai fini par <w>louper</w> le début du film au cinéma.",
                            "target_lang_translations": {
                                "en": "I left too late and ended up <w>missing</w> the start of the film at the cinema.",
                                "ru": "Я вышел слишком поздно и в итоге <w>опоздал</w> к началу фильма в кинотеатре.",
                                "de": "Ich bin zu spät losgegangen und habe schließlich den Anfang des Films im Kino <w>verpasst</w>.",
                                "es": "Salí demasiado tarde y al final <w>me perdí</w> el inicio de la película en el cine.",
                                "zh": "我出门太晚了，最后还是<w>错过</w>了电影院里这部电影的开头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manquer",
                        "rater"
                    ],
                    "common_phrases": [
                        "louper le train",
                        "louper le coche",
                        "louper une occasion"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive too late to catch a means of transport or let an opportunity pass.",
                        "ru": "Прийти слишком поздно, чтобы успеть на транспорт, или упустить возможность.",
                        "de": "Zu spät kommen, um ein Verkehrsmittel zu erreichen, oder eine Gelegenheit verstreichen lassen.",
                        "es": "Llegar demasiado tarde para tomar un medio de transporte o dejar pasar una oportunidad.",
                        "zh": "因来得太晚而没赶上交通工具，或让机会白白溜走。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "missing a train or opportunity"
                            }
                        ],
                        "ru": [
