                                        "entry_id": "0f6e935b-c133-39e1-8c5d-724677eac751",
                                        "glosses": [
                                            "kleine Einbuchtung/Vertiefung, insbesondere in den Wangen beim Lachen oder am Kinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4a03bf-10a2-4f92-89ff-856ddce5043b",
                                                "sense_id": "006cbbcb-cfcd-34a3-a2ea-973bb466120f",
                                                "text": "Sie hat nette Grübchen auf der Wange."
                                            },
                                            {
                                                "example_id": "657f57c3-8916-4214-8db1-753acd6cb8a6",
                                                "sense_id": "006cbbcb-cfcd-34a3-a2ea-973bb466120f",
                                                "text": "„»Einer der jungen Schauspieler gefiel mir ganz besonders: Er war ausgesprochen attraktiv, blond, blauäugig, Grübchen am Kinn und zu allem Überfluss noch sehr begabt«, schreibt sie später in ihren Erinnerungen.“"
                                            },
                                            {
                                                "example_id": "9a3e7074-9b08-4ade-b1fa-43ecbb12a0de",
                                                "sense_id": "006cbbcb-cfcd-34a3-a2ea-973bb466120f",
                                                "text": "„Er war nur mit weißen Boxershorts bekleidet, hatte dunkle Augen, ein Grübchen im Kinn und einen breiten Mund mit vollen fraulichen Lippen.“"
                                            },
                                            {
                                                "example_id": "f8b7b1be-4d88-4299-b9f6-e6ebe783653f",
                                                "sense_id": "006cbbcb-cfcd-34a3-a2ea-973bb466120f",
                                                "text": "„Sie sah das Grübchen an seinem Kinn und die Lachfältchen an den Augen und fühlte sich augenblicklich zu ihm hingezogen.“"
                                            },
                                            {
                                                "example_id": "aafc844d-2a59-40b0-8304-5d1ef4caf2e0",
                                                "sense_id": "006cbbcb-cfcd-34a3-a2ea-973bb466120f",
                                                "text": "„Sie lächelte und hatte dabei Grübchen auf den roten Backen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
