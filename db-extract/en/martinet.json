                "senses": [
                    {
                        "sense_id": "798facbe-3630-3dad-b871-1795a2658bce",
                        "entry_id": "98a1f967-f75b-3be9-9949-e7d6979deacd",
                        "glosses": [
                            "A strict disciplinarian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db7e9a0-83f2-4e5c-834c-7f10b1baf618",
                                "sense_id": "798facbe-3630-3dad-b871-1795a2658bce",
                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                            },
                            {
                                "example_id": "74e27020-0497-4aa4-a896-9a8f8e0fbf78",
                                "sense_id": "798facbe-3630-3dad-b871-1795a2658bce",
                                "text": "The same Aubrey deLint I'd dismissed for years as a 2-D martinet knelt gurneyside to squeeze my restrained hand and say ‘Just hang in there, Buckaroo,’ […]"
                            },
                            {
                                "example_id": "f4fb1418-f26b-48ac-a1c0-45c38dd4c24d",
                                "sense_id": "798facbe-3630-3dad-b871-1795a2658bce",
                                "text": "In Seattle, he was replaced by a martinet from Annapolis, a man so vain and incompetent, so impatient with advice from experienced sailors and sure of his own right way, that, when the Hull set sail for the South Pacific, twenty men went AWOL, certain that to ship with this man was a death sentence."
                            }
                        ]
                    },
                    {
                        "sense_id": "34dd0fab-edf0-3dde-abc8-85614033dc94",
                        "entry_id": "98a1f967-f75b-3be9-9949-e7d6979deacd",
                        "glosses": [
                            "Anyone who lays stress on a rigid adherence to the details of discipline, or to forms and fixed methods or rules."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "25b840bb-76c7-4ab8-970f-8946ebf7bebd",
                                "sense_id": "34dd0fab-edf0-3dde-abc8-85614033dc94",
                                "text": "Before I met Mr. Bowen Cooke I had been given to understand that he was of a reserved nature, and on occasion could be a \"bit of a martinet\"; [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8b5beec-beaf-3da4-8612-150e9cb1a791",
                        "entry_id": "98a1f967-f75b-3be9-9949-e7d6979deacd",
                        "glosses": [
                            "A short whip with multiple lashes once used in France."
                        ],
