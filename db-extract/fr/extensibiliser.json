                "senses": [
                    {
                        "sense_id": "ed1f57db-dafd-3772-91d4-cc3702a2fed7",
                        "entry_id": "0560b688-85cd-391a-938e-ecaec038ad61",
                        "glosses": [
                            "Donner un caractère extensible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cce8653-9b84-4d09-9627-717cdb241310",
                                "sense_id": "ed1f57db-dafd-3772-91d4-cc3702a2fed7",
                                "text": "Les pensées savent si bien extensibiliser les objets les plus insignifiants, les mots jetés à la hâte sur un bout de papier froissé par le temps."
                            },
                            {
                                "example_id": "ea4874a0-7c03-4181-bd6c-0b5c8762f9e1",
                                "sense_id": "ed1f57db-dafd-3772-91d4-cc3702a2fed7",
                                "text": "Il est de toi ? Je vais essayer de l'extensibiliser"
                            },
                            {
                                "example_id": "4bf8e266-b4fb-4ba2-9030-46a8688b208d",
                                "sense_id": "ed1f57db-dafd-3772-91d4-cc3702a2fed7",
                                "text": "Extensibiliser vos projets de localisation signifie que vous devez avoir des ressources humaines suffisantes de tout type et dans différentes disciplines."
                            }
                        ]
                    }
