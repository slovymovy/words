                        "glosses": [
                            "Wissenschaft, die sich mit dem Wachstum und der Entwicklung von Kindern beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa90fd49-e192-4b2b-8e97-3917525d54fa",
                                "sense_id": "b0f7ba37-455d-399f-aa13-b9aa40a71061",
                                "text": "„Die Pädagogik, wie sie sein soll, geht hervor aus der Pädologie, der Kinderkunde, d. h. der causalen Kenntniß aller der körperlich-geistigen Eigenthümlichkeiten des kindlichen Lebens in seinen verschiedenen Entwickelungsstufen, in deren strenger accommodirender Beachtung die rationelle Pädagogik, die naturrichtige erzieherische Behandlung des Kindes besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
