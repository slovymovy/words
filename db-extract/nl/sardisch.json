                    {
                        "translation_id": "cfcef7c3-8bf6-4a29-a3dd-40c5e81acbe3",
                        "source_entry_id": "b8268aee-8c3b-360f-b254-08db3b3073e5",
                        "source_sense_id": "d654878d-26c8-3d83-995a-6c28facd42d7",
                        "source_sense_description": "Romaanse taal die wordt gesproken door 1,3 miljoen mensen op Sardinië",
                        "target_lang_word": "sarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4051099d-3296-3977-aceb-ffe08ed0509a",
                                        "entry_id": "23b6ba1f-6cc1-380f-ae5e-a98e51a292e7",
                                        "glosses": [
                                            "Sardoine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54cd16df-7b03-4f5b-9ff4-d23476764de3",
                                                "sense_id": "4051099d-3296-3977-aceb-ffe08ed0509a",
                                                "text": "La calcédoine est translucide, grise, bleuâtre ou brune, d'un aspect cireux ; elle jouissait dans l'Antiquité d'une grande réputation malgré son aspect modeste; lorsqu'elle est rouge, on l'intitule sarde, sardoine ou cornaline."
                                            },
                                            {
                                                "example_id": "acee6acd-724a-4b22-b7a4-5b36be9a0877",
                                                "sense_id": "4051099d-3296-3977-aceb-ffe08ed0509a",
                                                "text": "Afin d’en finir avec cette orfèvrerie symbolique, disons encore que […] la sarde évoque les Séraphins, la topaze les Chérubins, le jaspe les Trônes, la chrysolithe les Dominations, le saphir les Vertus, l’onyx les Puissances, le béryl les Principautés, le rubis les Archanges et l’émeraude les Anges."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63f4606a-6b41-33db-90d6-ec3479f093db",
                                        "entry_id": "f2024c9e-eae5-32cc-a746-3c9b5773b505",
                                        "glosses": [
                                            "Relatif à la Sardaigne, ses habitants, sa culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805da436-c123-4db4-9014-58748ef3b4aa",
                                                "sense_id": "63f4606a-6b41-33db-90d6-ec3479f093db",
                                                "text": "Un village sarde."
                                            },
                                            {
                                                "example_id": "c5eba5d7-fd9b-4bb6-8979-83e91e2331a1",
                                                "sense_id": "63f4606a-6b41-33db-90d6-ec3479f093db",
                                                "text": "Grâce à certaines herbes cueillies à certaines époques et vendues aux contrebandiers par de vieilles femmes sardes, la blessure se referma bien vite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00cd1bc2-d4d0-329a-bbcd-8d7d5c8793a1",
                                        "entry_id": "f2024c9e-eae5-32cc-a746-3c9b5773b505",
                                        "glosses": [
                                            "Relatif au sarde, la langue de Sardaigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90836228-5035-4d7a-bd9a-15743d7ad256",
                                                "sense_id": "00cd1bc2-d4d0-329a-bbcd-8d7d5c8793a1",
                                                "text": "L'homme qui était sur le rivage […] cria qui vive en patois sarde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27255c4f-21ae-320c-94e9-823914cd6cc6",
                                        "entry_id": "f2024c9e-eae5-32cc-a746-3c9b5773b505",
                                        "glosses": [
                                            "Relatif au Royaume de Sardaigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58df9e2-d2b6-4fe5-a5f8-7fdb76d29b52",
                                                "sense_id": "27255c4f-21ae-320c-94e9-823914cd6cc6",
                                                "text": "Moi ! […] un malheureux petit souverain, aplati entre deux gros voisins, qui n'hésitent que sur la sauce à laquelle ils dévoreront mes États […] Seulement, forcé par le traité de 1817 à tolérer une garnison sarde à Menton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "047abc8c-fd39-3a69-9c50-67f0d26ffa06",
                                        "entry_id": "c2b52fcf-873f-3a7f-aa97-11901cf476c5",
                                        "glosses": [
                                            "Langue romane parlée principalement en Sardaigne."
                                        ],
                                        "tags": [],
                                        "note": "On considère que c’est la langue qui est restée la plus proche du latin",
                                        "examples": [
                                            {
                                                "example_id": "aebf439d-72cf-4169-9ff6-c4f598c0ac9b",
                                                "sense_id": "047abc8c-fd39-3a69-9c50-67f0d26ffa06",
                                                "text": "Une telle situation rend la survie du sarde plus difficile que jamais et condamne les sardophones à un statut de diglossie, loin du bilinguisme souhaité, dans lequel leur langue apparait cantonnée, plus que jamais, à des situations de communication limitées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52499094-79af-3704-af66-10e6d5041946",
                                        "entry_id": "8b4ba6e4-3aad-349e-866a-99d6ddf72da9",
                                        "glosses": [
                                            "Baleine franche."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf22fef-2adf-449b-8757-d7ee5a864aa0",
                                                "sense_id": "52499094-79af-3704-af66-10e6d5041946",
                                                "text": "La permission à perpétuité de faire ou faire faire ladite pêche et fonte des baleines, sardes, chiens et loups de mer, — (Lettre patente déc. 1657. — du Littré)"
                                            },
                                            {
                                                "example_id": "7b85d2b7-6f0d-483a-bde0-97a435f4f1ab",
                                                "sense_id": "52499094-79af-3704-af66-10e6d5041946",
                                                "text": "Si l'on ne voulait absolument admettre qu'une seule espèce de ces baleines des mers tempérées, il serait raisonnable de supposer que le Nordkaper ou Sarde ou Slelbak appartenait à cette même espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea9e5ae3-67bb-32a5-8ec7-b13e8ce1c2f2",
                                        "entry_id": "8b4ba6e4-3aad-349e-866a-99d6ddf72da9",
                                        "glosses": [
                                            "Nom vulgaire d'une clupée indéterminée que les pêcheurs des Canaries et de Madère prennent en grande abondance sur les côtes du Brésil, et qu'ils préparent à la manière du hareng pour la consommation des peuples de l'Archipel atlantique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cc143aa-3480-35a3-ae32-1404e5aad2e2",
                                        "entry_id": "8b4ba6e4-3aad-349e-866a-99d6ddf72da9",
                                        "glosses": [
                                            "Nom vulgaire et spécifique de la pélamide sarde, acanthoptérygiens, qui est le scombre sarde de certains auteurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
