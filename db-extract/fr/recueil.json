        "fr-extract.jsonl": [
            {
                "entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                "word": "recueil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8551ab6-67cd-4918-85db-388f464fd1ab",
                        "entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "tags": [
                            "plural"
                        ],
                        "form": "recueils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e2da1f6-4daa-3fce-9175-f5e6d7da7271",
                        "entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "glosses": [
                            "Action de recueillir ; résultat de cette action."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "1975158d-432e-4f90-b0b7-c55ff014ce2b",
                                "sense_id": "8e2da1f6-4daa-3fce-9175-f5e6d7da7271",
                                "text": "Il existe encore un dernier facteur limitant : la rareté de l'eau de surface […]. Le recueil de l'eau de pluie tombée sur les toits dans des fûts et de gros cubiteneurs n'est pas possible pendant la saison sèche qui dure 4 mois ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "274bcaed-527d-336a-87fa-0c8129461acd",
                        "entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "glosses": [
                            "Assemblage ou réunion de divers actes ou écrits, d’ouvrages en prose ou en vers, de pièces de musique, d’estampes, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ecc04b4-54c9-4fc2-b064-9d3d9e3f4bec",
                                "sense_id": "274bcaed-527d-336a-87fa-0c8129461acd",
                                "text": "Les philippistes déterminèrent le prince électeur Auguste à donner la sanction légale à un recueil des écrits de Mélanchthon , […]."
                            },
                            {
                                "example_id": "59a171f1-5435-4d1f-a6ab-00bd8ca8608f",
                                "sense_id": "274bcaed-527d-336a-87fa-0c8129461acd",
                                "text": "Recueil de poésies, de pièces d’éloquence, de pièces de musique, de sentences, d’anecdotes, de bons mots, de traits d’esprit, de chansons."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b79929f-a01a-347c-8aa2-6b7cb1e6d5df",
                        "entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "glosses": [
                            "Le livre ou le livret où sont imprimés ces œuvres."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9e16da35-5684-4be5-ae8f-767753b32d8f",
                                "sense_id": "7b79929f-a01a-347c-8aa2-6b7cb1e6d5df",
                                "text": "Il vient de publier un volume, l’Art du Théâtre. C'est un recueil de ses chroniques théâtrales avec une préface de Courteline."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72a714f4-27e7-4871-9f6e-82dedc1a50cf",
                        "source_entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "target_lang_word": "Sammlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sammlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                        "entry_id": "d9a9b85a-d9a6-3ff6-9f30-793698d9e0e5",
                                        "glosses": [
                                            "Anzahl von aufbewahrten, gezielt gesammelten Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24e66cf-c12d-4eb8-aa3c-80abd32ea6de",
                                                "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                                "text": "Er besitzt die größte Sammlung von Kugelschreibern, die ich je gesehen habe."
                                            },
                                            {
                                                "example_id": "ee12d90d-ca17-4acd-8174-6565da71e16f",
                                                "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                                "text": "„Ich hatte gerade beschlossen, den Nachmittag mit einer in arabischer Sprache verfassten Sammlung von Kurzgeschichten zu verbringen, die in den Gassen der Altstadt von Damaskus spielten.“"
                                            },
                                            {
                                                "example_id": "111f16f2-094c-4136-8843-8560633607e8",
                                                "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                                "text": "„Nicht weniger überraschend wird es für uns heute sein, daß die enthusiastisch gelobte Sammlung keine glänzende Metropole ziert, sondern das wohlgehütete Schatzhaus einer kleinen Provinzstadt ist.“"
                                            },
                                            {
                                                "example_id": "44327d46-b546-49fe-8428-670d41154260",
                                                "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                                "text": "„Es ist also eine erfolgreiche Sammlung von Witzen, die typisch für die Siebzigerjahre sind.“"
                                            },
                                            {
                                                "example_id": "8bdaa459-fa09-4ae3-82f9-e87c04b494df",
                                                "sense_id": "ba3820e5-90e5-36b9-824a-15f3b330c5de",
                                                "text": "„Beim Nachtisch zog Lia die Sammlung aus ihrer Tasche und entflammte mich mit der Bitte um Erklärungen; sie verbot mir jedoch unter der Drohung, sofort zu gehen, jede Vorführung, die das Erklären belebt hätte, denn das Buch sei nur für die Augen gemacht, und ich hätte es vielleicht nötiger als sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4315b6f-7cf2-398c-8123-2715edabb5b2",
                                        "entry_id": "d9a9b85a-d9a6-3ff6-9f30-793698d9e0e5",
                                        "glosses": [
                                            "die Aktion des Sammelns; meist Geld für einen guten Zweck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e85e09-7598-4346-8825-3e9f6aabc29a",
                                                "sense_id": "c4315b6f-7cf2-398c-8123-2715edabb5b2",
                                                "text": "„Bis zu ihrer Krankheit erinnere ich mich an meine Mutter wie an eine Frau, die sich bei sämtlichen Sammlungen zum Kampf gegen den Krebs oder auch zu allen Stadtfesten fotografieren ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e14d059e-0568-3f4f-a509-34b32ab3f434",
                                        "entry_id": "d9a9b85a-d9a6-3ff6-9f30-793698d9e0e5",
                                        "glosses": [
                                            "die meditative oder religiöse Versenkung (im Gebet)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d15080dd-17ee-487c-a630-831f7cfa7acd",
                        "source_entry_id": "3cc34c3c-b8bf-3e55-af2f-52cd8344cfab",
                        "target_lang_word": "collection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of items or amount of material procured, gathered or presented together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930830be-7592-4b27-ad7c-83b711501bf7",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "The attic contains a remarkable collection of antiques, oddities, and random junk."
                                            },
                                            {
                                                "example_id": "fdf0842c-04e9-46f4-936f-22a905183fa5",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "The asteroid belt consists of a collection of dust, rubble, and minor planets."
                                            },
                                            {
                                                "example_id": "ee03fd50-3c02-456f-896a-f006272e0aae",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "This year's Summer Collection will include a wide range of evening wear."
                                            },
                                            {
                                                "example_id": "c118d158-7d3e-462d-9e9a-1596d4607645",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "He has a big collection of stamps."
                                            },
                                            {
                                                "example_id": "21bb0f60-a99e-4a83-b2b4-cb1a10940303",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "He has a superb coin collection."
                                            },
                                            {
                                                "example_id": "e783e06c-ccdd-4bdb-8d85-1d72dfcc2490",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            },
                                            {
                                                "example_id": "cdc2ce49-0b3c-4827-b2b3-57dfe3381b28",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "collections of moisture"
                                            },
                                            {
                                                "example_id": "da8c0e21-3a20-4c1d-b8a4-242c4a72d82b",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "a purulent collection"
                                            },
                                            {
                                                "example_id": "97457347-f340-4a16-8a03-438c6ad7770d",
                                                "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of pitch classes used by a composer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96996b87-4b35-4748-8477-6ca8dd05aaa9",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "The \"collectional information\" one receives is ambiguous since the collection { C, E, F, G, A } occurs in the key of C and in the key of F."
                                            },
                                            {
                                                "example_id": "7e6534e8-c95c-468f-ab39-c630e20224d0",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "In fact, students are often taught that specific collections—diatonic, octatonic, and whole-tone, etc.—typify these composers' compositional language."
                                            },
                                            {
                                                "example_id": "ace9cd0b-9241-4396-872a-df9435e97f07",
                                                "sense_id": "be280f98-4598-3b11-98b6-497c0a6e1297",
                                                "text": "Simply put, the realm of available collections in a largely diatonic environment is much smaller than it is in truly atonal one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The activity of collecting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecc03cd-2573-43d5-a7de-84cd65911173",
                                                "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                                                "text": "Collection of trash will occur every Thursday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8f79ef-2c90-329f-a05d-b0d51467bd16",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A set of sets; used because such a thing is in general too large to comply with the formal definition of a set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af838664-db9b-3426-bcd9-84337a178840",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "A gathering of money for charitable or other purposes, as by passing a contribution box for donations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014eadae-6eed-4c43-aea3-70ede63fbc02",
                                                "sense_id": "af838664-db9b-3426-bcd9-84337a178840",
                                                "text": "The people here are very good to each other, too. When someone's house burned down, when someone was in the hospital, they took up collections for the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b4f17e-d057-32c0-b72c-ca886dbda4a1",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "Debt collection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb35057-06c6-3395-8b16-5f23639cc214",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
                                        "glosses": [
                                            "The act of inferring or concluding from premises or observed facts; also, that which is inferred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1801ed7d-0e6e-415b-b821-8991af9d2cf0",
                                                "sense_id": "abb35057-06c6-3395-8b16-5f23639cc214",
                                                "text": "We may safely say thus, that wrong collections have been hitherto made out of those words by modern divines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0344b116-9904-3b86-b248-4fc38edbaa2c",
                                        "entry_id": "01657fee-51e4-3863-b8f5-11aeaca27ce6",
