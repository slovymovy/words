                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ogromna <w>odległość</w> od cywilizacji dawała im poczucie wolności.",
                            "target_lang_translations": {
                                "ru": "Огромная <w>удалённость</w> от цивилизации давала им чувство свободы.",
