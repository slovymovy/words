                    {
                        "sense_id": "09c85834-83c1-3a06-bd0d-fcaee5b0d006",
                        "entry_id": "66588862-22b2-3689-8b29-c8e67d34805e",
                        "glosses": [
                            "Individu."
                        ],
                        "tags": [
                            "dated",
