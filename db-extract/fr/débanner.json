                ],
                "senses": [
                    {
                        "sense_id": "42c39ebb-409e-30e3-9554-4623aecce117",
                        "entry_id": "7319d9fd-5ed7-3b9f-9275-b906290f7273",
                        "glosses": [
                            "Enlever ce qui recouvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6164250e-6356-4831-81f9-d699d3180b63",
                                "sense_id": "42c39ebb-409e-30e3-9554-4623aecce117",
                                "text": "Il faisait un vent à débanner les toitures."
                            },
                            {
                                "example_id": "919c2e00-1d85-433c-bcd7-7a976b6d021f",
                                "sense_id": "42c39ebb-409e-30e3-9554-4623aecce117",
                                "text": "Le berger ne pourra « débanner » les terres ou prairies appartenant à des particuliers sans leur consentement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c79672cf-5edf-3b2e-acf1-f8e146ce744b",
                        "entry_id": "7319d9fd-5ed7-3b9f-9275-b906290f7273",
                        "glosses": [
                            "Enlever les cornes d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbdf7c1-d5c2-41e2-abcb-ecb5e3527b22",
                                "sense_id": "c79672cf-5edf-3b2e-acf1-f8e146ce744b",
                                "text": "Comme l’élastique n’a rien pu faire, ils attendent six mois, choisissent un jour de vieille lune pour « débanner »."
                            },
                            {
                                "example_id": "c3486fff-1364-4d54-99e0-fffc10375fba",
                                "sense_id": "c79672cf-5edf-3b2e-acf1-f8e146ce744b",
                                "text": "Ce matin le Mistral souffle si fort qu’il pourrait « débanner » les taureaux qui se cachent dans les tamaris."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d13bdb1-fbaa-3302-943a-c0b867e447c7",
                        "entry_id": "7319d9fd-5ed7-3b9f-9275-b906290f7273",
                        "glosses": [
                            "Enlever les bannes de la vigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c10be5a-ca1f-4406-a2ad-92c561b37b2f",
                                "sense_id": "6d13bdb1-fbaa-3302-943a-c0b867e447c7",
                                "text": "Travaux d’hiver: Une fois la taille de la souche effectuée, on peut éliminer les bras (bannes) morts, cette action s’appelle débanner= enlever les bannes."
                            }
                        ]
                    },
                    {
                        "sense_id": "35d5c83d-9f92-3c2f-ab66-29fa52c20d81",
                        "entry_id": "7319d9fd-5ed7-3b9f-9275-b906290f7273",
                        "glosses": [
                            "Renverser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48aed3c6-1bba-4395-9bff-8eac06f30019",
                                "sense_id": "35d5c83d-9f92-3c2f-ab66-29fa52c20d81",
                                "text": "Oui, pour faire « débanner » (renverser) la voiture."
                            }
                        ]
                    }
                ],
