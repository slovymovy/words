                },
                {
                    "sense_id": "184bdf8b-9fdf-3fce-8b91-d0798fa9ec8e",
                    "sense_definition": "przynieść jakiś skutek, rezultat lub korzyść",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "skutek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieloletnia ciężka praca wreszcie <w>dała</w> upragnione rezultaty.",
                            "target_lang_translations": {
                                "en": "Years of hard work finally <w>yielded</w> the desired results."
                            }
