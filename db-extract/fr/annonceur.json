                                "target_senses": [
                                    {
                                        "sense_id": "054e9700-6c39-35f0-bf43-258dec838724",
                                        "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                                        "glosses": [
                                            "One who advertises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295afcaf-e7a0-46b0-88d4-a7c04dba07a3",
                                                "sense_id": "054e9700-6c39-35f0-bf43-258dec838724",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention. Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88972db8-4bd8-39d6-96ab-e5ea8ffdcaec",
                                        "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                                        "glosses": [
                                            "A periodical in which advertisements can be published by individuals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77513548-29ea-47a1-af07-063755d474ef",
                        "source_entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "target_lang_word": "announcer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                        "entry_id": "446d08f8-7506-31ec-a3b8-f8aeb41f3058",
                                        "glosses": [
                                            "One who makes announcements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e150d7-0d3e-44a7-8949-3ad3500f4983",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "radio announcer"
                                            },
                                            {
                                                "example_id": "c153baa4-96cd-4e9e-a96f-cf89d00d822d",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Even TV announcers at the last Winter Olympics were spotted with a swoosh on their jackets."
                                            },
                                            {
                                                "example_id": "511d5df9-6300-41a6-af6d-ddf49132aa94",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "Perlman devised a format inspired by the seminal mockumentary Spinal Tap, where the spot started with an ESPN announcer speaking to camera in a serious, straight voice, framing the story as “real” documentary."
                                            },
                                            {
                                                "example_id": "3dec8bff-9084-41aa-81fc-150a1477eff8",
                                                "sense_id": "88cac9e1-611b-378b-96f5-12f7870cdf5b",
                                                "text": "There were passing moments when it threatened to be a difficult night and, with the game goalless at half-time, the stadium announcer sounded almost apologetic when he relayed the news that Ukraine, kicking off an hour earlier, had gone to the top of the group by beating Poland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
