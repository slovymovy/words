                "senses": [
                    {
                        "sense_id": "4ac53925-0f58-3767-8700-1d7886a2806c",
                        "entry_id": "57ec5dd5-5841-39a7-9419-0901b889d823",
                        "glosses": [
                            "Cocktail alcoolisé à base de gin et d’eau tonique, souvent accompagné avec une tranche de citron ou de citron vert, servi avec de la glace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30394b83-40d0-4ab2-9234-074a28039c52",
                                "sense_id": "4ac53925-0f58-3767-8700-1d7886a2806c",
                                "text": "Lors de l’escale de Genève, vous irez vous désaltérer au comptoir du bar, un homme s’approchera de vous et proposera de vous offrir un gin-tonic."
                            },
                            {
                                "example_id": "d1df8714-fcd7-480d-9b31-5ec8b6b64d39",
                                "sense_id": "4ac53925-0f58-3767-8700-1d7886a2806c",
                                "text": "Si vous trouvez l’entrée du bar Big in Japan, vous serez récompensés par d’excellents gin-tonics."
                            },
                            {
                                "example_id": "ad44760f-d721-44a7-9249-6a22c8513775",
                                "sense_id": "4ac53925-0f58-3767-8700-1d7886a2806c",
                                "text": "Après trois gin-tonics il a voulu raconter à son ami Pacôme et au petit groupe qui s’était formé autour d’eux une histoire drôle."
                            }
                        ]
                    }
                ],
                "translations": [
