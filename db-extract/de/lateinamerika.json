                                        "sense_id": "38827a0a-901b-3a6e-90d9-f2bb11bd5954",
                                        "entry_id": "947ef116-b8a2-3fc8-ad61-9f0f89aa8ce4",
                                        "glosses": [
                                            "Those parts of the Americas which speak Romance (Latin-derived) languages, namely Spanish, Portuguese, French, or creoles based on these."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77ec1d00-55ca-33d3-8a88-85af206a813e",
                                        "entry_id": "947ef116-b8a2-3fc8-ad61-9f0f89aa8ce4",
                                        "glosses": [
                                            "A continental region consisting of those parts of the Americas located south of the United States where Spanish or Portuguese is predominantly spoken; sometimes including areas speaking French or French-based creoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97364d6e-5f82-4971-b0f7-e87d53d8a49d",
                                                "sense_id": "77ec1d00-55ca-33d3-8a88-85af206a813e",
                                                "text": "Young Indians looking for work opportunities have made up a sizeable portion of undocumented migrants in the US, many after making the dangerous trek through Latin America to reach the US southern border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61b424b9-c5eb-3efb-ad37-9a62060c6d35",
                                        "entry_id": "947ef116-b8a2-3fc8-ad61-9f0f89aa8ce4",
                                        "glosses": [
                                            "Ibero-America (excluding all French-speaking areas)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d12f4cc-97c5-3a2b-94ba-1c9718948673",
                                        "entry_id": "947ef116-b8a2-3fc8-ad61-9f0f89aa8ce4",
                                        "glosses": [
                                            "umbrella term for South America, Central America, Mexico and the Caribbean (including English and Dutch-speaking areas)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250b46bf-4242-46e9-9ab8-47cbeee30e23",
                        "source_entry_id": "d15a1796-cfb7-3870-a0ee-3cdcd9ca7546",
