                    "sense_id": "f1b87f86-1043-3b71-9424-1beee3cfcf93",
                    "sense_definition": "Person oder Partei, die vor Gericht eine zivilrechtliche Klage gegen jemanden erhebt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Kläger</w> forderte vor Gericht die vollständige Rückzahlung der ausstehenden Summe."
                        },
                        {
                            "text": "Im Zivilprozess einigten sich der <w>Kläger</w> und der Beklagte schließlich auf einen Vergleich."
                        }
                    ],
                    "synonyms": [
                        "Klagender"
                    ],
                    "antonyms": [
                        "Beklagter"
                    ],
                    "common_phrases": [
