                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7812445-d23e-4c17-929c-5f73addfa89e",
                        "source_entry_id": "307b2e81-a7d2-33e3-9951-16b90425d45f",
