                        "glosses": [
                            "Adepte du zervanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95252be-d960-44a7-a34d-46740e1cff20",
                                "sense_id": "52daecd5-cd32-3e5b-a08d-aeae1f2bf66f",
                                "text": "Les auteurs arméniens, Eznik et Elisaeus, témoignent de l’existence d’au moins deux principales sectes zoroastriennes au Vᵉ siècle, connues sous les noms de Mog et Zendik, et Shahristani (1086-1153) attestera encore la peristance de nombreuses communautés zoroastriennes sous l’Islam, dont les zervanites, les gayomartiens et les mazdakites (Livre des Sectes)."
                            }
                        ]
                    }
