                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Waite</w> delivered an inspiring lecture on medieval history this afternoon.",
                            "target_lang_translations": {
                                "tr": "Profesör <w>Waite</w> bu öğleden sonra Orta Çağ tarihi üzerine ilham verici bir ders verdi."
                            }
                        },
                        {
                            "text": "We met the <w>Waite</w> family while traveling through northern England.",
                            "target_lang_translations": {
                                "tr": "Kuzey İngiltere'de seyahat ederken <w>Waite</w> ailesiyle tanıştık."
