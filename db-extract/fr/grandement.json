        "fr-extract.jsonl": [
            {
                "entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
                "word": "grandement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1fd066b4-cde6-3ec2-a159-e95bf77c9706",
                        "entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
                        "glosses": [
                            "Avec grandeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b851e7-f8d9-4fec-9e3f-8e468cce4d1f",
                                "sense_id": "1fd066b4-cde6-3ec2-a159-e95bf77c9706",
                                "text": "Les grandes choses doivent être grandement exprimées."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                        "entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
                        "glosses": [
                            "Beaucoup."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e5c8b3-7005-494c-a111-3d459eefd993",
                                "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                                "text": "Il lui reste une chose qui m’inquiète grandement pour lui."
                            },
                            {
                                "example_id": "9a79847c-e699-4616-8f3c-4aae2a93753e",
                                "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                                "text": "Fouché, dans ses Mémoires, avoue que ses plans ne réussirent pas; Talleyrand fut plus heureux, il contribua grandement à la restauration des Bourbons ; […]."
                            },
                            {
                                "example_id": "672e9328-8bba-4027-9ada-c7482b6fdf51",
                                "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                                "text": "Si, chez un malade atteint de sténose mitrale, se montrent inopinément des crachats sanglants, on aura grandement raison de supposer l'existence d'un infractus pulmonaire hémorrhagique."
                            },
                            {
                                "example_id": "84fd95cd-c881-4a39-87ee-8cc2ea1a77b8",
                                "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                                "text": "Je suis retourné dans mon coin, seul, plus grandement seul qu’avant."
                            },
                            {
                                "example_id": "e5c29f10-c150-46bc-b716-27a4d10d17dd",
                                "sense_id": "d3da530f-48b5-390b-a870-94ebb039a36b",
                                "text": "Dans ce même temps et peut-être sous la même influence, les continuateurs de la tradition classique, comme Mehmed Akif, ont grandement simplifié la langue d'autrefois."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e496023-8ba4-3dbd-90e5-09317c490253",
                        "entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
                        "glosses": [
                            "Largement ; en abondance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947fe3a9-ee4e-4d63-b8f4-8b3d3810a126",
                                "sense_id": "9e496023-8ba4-3dbd-90e5-09317c490253",
                                "text": "Partez ! faites qu’on ait grandement soin d’eux ; qu’ils ne disent pas dans leur orgueil que le rude Saxon a montré à la fois sa pauvreté et son avarice."
                            },
                            {
                                "example_id": "556e977c-c685-4a6c-b3a2-32f9786318ed",
                                "sense_id": "9e496023-8ba4-3dbd-90e5-09317c490253",
                                "text": "Faire les choses grandement, c’est ne pas épargner la dépense, payer avec générosité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0ff5f0b-9be9-46be-99ae-64963c011e23",
                        "source_entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
                        "target_lang_word": "greatly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greatly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                        "entry_id": "35b3c682-a5a9-3bbc-b9be-6a7e802a6e64",
                                        "glosses": [
                                            "To a great extent or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a938ac68-03cd-41ac-965a-22d98d7c9f4a",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Expenses greatly exceeded revenues this year, much to nobody's surprise."
                                            },
                                            {
                                                "example_id": "df33be7a-e68d-4308-94b3-6102a24ab72e",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "He was more greatly beloved than anyone in living memory."
                                            },
                                            {
                                                "example_id": "57e9eb3d-84c9-4401-adb7-9258ad862af9",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "5421a778-d12f-4e92-a761-83b5711af321",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Terry's goal looked to have put Chelsea in control on the stroke of half-time but Arsenal's response presented a compelling case for Wenger's insistence that reports of his side's demise have been greatly exaggerated."
                                            },
                                            {
                                                "example_id": "98b550b3-469c-4002-b5d1-7e078cb7b127",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Instead of retracing my route, I have elected to walk across Blackpool to the town's remaining large station, although even this has been greatly reduced in size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                        "entry_id": "35b3c682-a5a9-3bbc-b9be-6a7e802a6e64",
                                        "glosses": [
                                            "Nobly; magnanimously."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c6a1ba-e211-4777-9d18-a68462604190",
                                                "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                                "text": "His Suff’rings ſhine, and ſpread a Glory round him;\nGreatly unfortunate, he fights the Cauſe\nOf Honour, Virtue, Liberty, and Rome."
                                            },
                                            {
                                                "example_id": "0ce7d7dd-a1aa-4dc0-bc0c-8629540eac76",
                                                "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                                "text": "But all this our fisher, who was neither a poet, nor a dependent, did not know, so he concluded, that all who were truly great, were truly greatly minded, and noble in soul, as they were exalted by birth, and rich in splendour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c5801d6-d942-416e-8c11-40c0b5e845da",
                        "source_entry_id": "63549615-f8f7-335e-a217-abb3946f1df8",
