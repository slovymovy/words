        "fr-extract.jsonl": [
            {
                "entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                "word": "empirisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ec1d02c-c765-4e4a-947c-6063148666a5",
                        "entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "tags": [
                            "plural"
                        ],
                        "form": "empirismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08680984-8123-3cd8-b18e-e1c89aed180c",
                        "entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "glosses": [
                            "Système de philosophie dans lequel l’origine de nos connaissances est uniquement attribuée à l’expérience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d67a33-f943-4414-8e34-57617966d672",
                                "sense_id": "08680984-8123-3cd8-b18e-e1c89aed180c",
                                "text": "Mais, avec le triomphe du Newtonisme et de l’Empirisme en Angleterre, du Cartésianisme en France, le règne de la Scolastique prend fin."
                            },
                            {
                                "example_id": "f28a9a32-62de-48ab-a05f-38874069ab2d",
                                "sense_id": "08680984-8123-3cd8-b18e-e1c89aed180c",
                                "text": "Après des années de clivage idéologique fédéralistes-souverainistes, lucides-solidaires, « on verra » était une expression de pragmatisme. Un empirisme, diraient les philosophes, antonyme de l’idéalisme, base des idéologies."
                            },
                            {
                                "example_id": "ffc97c98-3ad1-4ff3-8167-42979e5a26f0",
                                "sense_id": "08680984-8123-3cd8-b18e-e1c89aed180c",
                                "text": "L’empirisme de Locke fut combattu par Leibnitz."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7899951-f79f-3551-9e6f-d2511076c2bf",
                        "entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "glosses": [
                            "Pratique de la médecine exercée sans connaissances théoriques et fondée sur la seule expérience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ea3644-9086-4ae4-ad96-c37e190fcf33",
                                "sense_id": "b7899951-f79f-3551-9e6f-d2511076c2bf",
                                "text": "L’empirisme le désolait. Du moment que la médecine n’était pas une science expérimentale, mais un art, il demeurait inquiet devant l’infinie complication de la maladie et du remède, selon le malade."
                            }
                        ]
                    },
                    {
                        "sense_id": "991622c0-4c50-3961-b051-6b5c0e5624b2",
                        "entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "glosses": [
                            "Toute méthode qui prétend ne s’appuyer que sur l’expérience."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b9e48dfa-1ac8-4676-98b5-9dae3d473523",
                                "sense_id": "991622c0-4c50-3961-b051-6b5c0e5624b2",
                                "text": "Il se montrait au contraire farouchement zélé, et son empirisme, dans sa façon de comprendre ou d’appliquer la discipline, aurait surpris, en d’autres temps, les maîtres de l’Inquisition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5550d5c-7f25-4c83-8491-a164b1137716",
                        "source_entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "target_lang_word": "Empirismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empirismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0c6bb4-c710-3872-b439-b80d4f5dc212",
                                        "entry_id": "a8fbcb2c-5177-3b2a-95c4-a5b7a99c5a38",
                                        "glosses": [
                                            "Lehre, die davon ausgeht, dass jede Erkenntnis erst durch die Sinne in den Verstand gelangen muss (maßgeblich geprägt durch John Locke)"
                                        ],
                                        "tags": [
                                            "Erkenntnistheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11250bff-fbda-4c11-814e-95ccd772c771",
                                                "sense_id": "9f0c6bb4-c710-3872-b439-b80d4f5dc212",
                                                "text": "Der Empirismus ist eine aufklärerische Variante der Erkenntnistheorie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a152db51-fe59-4333-8f39-afdf5c46a2f9",
                        "source_entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
                        "target_lang_word": "empiricism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empiricism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13d391f2-ab4c-36e3-9a94-f766ffe70409",
                                        "entry_id": "73b8dfd3-6ccd-3329-9954-5535f51db083",
                                        "glosses": [
                                            "A doctrine which holds that the only or, at least, the most reliable source of human knowledge is experience, especially perception by means of the physical senses. (Often contrasted with rationalism.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08d2953a-b921-458b-9c51-67628c1d714d",
                                                "sense_id": "13d391f2-ab4c-36e3-9a94-f766ffe70409",
                                                "text": "Empiricism teaches us that we are unceasingly and intimately in contact with a full, living, breathing Reality, that experience is a constant communion with the real."
                                            },
                                            {
                                                "example_id": "65ef5a99-21ee-4399-b6a2-09f99b4ae0d8",
                                                "sense_id": "13d391f2-ab4c-36e3-9a94-f766ffe70409",
                                                "text": "He agrees with Kant that Hume's empiricism is refuted de facto by the example of mathematics, whose judgments are synthetic a priori."
                                            },
                                            {
                                                "example_id": "e77c93ad-f0ee-437c-a22c-e60ee2af6502",
                                                "sense_id": "13d391f2-ab4c-36e3-9a94-f766ffe70409",
                                                "text": "Empiricism is the doctrine that human knowledge is grounded on the kind of experience, mostly achieved through the five senses, whose objects are particular events occurring at particular times and in particular places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b345a8-1ecc-36e2-9315-95d7063c860e",
                                        "entry_id": "73b8dfd3-6ccd-3329-9954-5535f51db083",
                                        "glosses": [
                                            "A pursuit of knowledge purely through experience, especially by means of observation and sometimes by experimentation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ee9353-0167-4c9c-b338-8b8d347c6a4d",
                                                "sense_id": "83b345a8-1ecc-36e2-9315-95d7063c860e",
                                                "text": "Our whole life in some of its highest and most important aspects is simply empiricism. Empiricism is only another word for experience."
                                            },
                                            {
                                                "example_id": "636c5a47-81f6-4279-ae0a-e3bb43c66014",
                                                "sense_id": "83b345a8-1ecc-36e2-9315-95d7063c860e",
                                                "text": "I have found no better expression than \"religious\" for confidence in the rational nature of reality.... Whenever this feeling is absent, science degenerates into uninspired empiricism."
                                            },
                                            {
                                                "example_id": "c3200616-a96d-410f-8d66-1627c9389077",
                                                "sense_id": "83b345a8-1ecc-36e2-9315-95d7063c860e",
                                                "text": "Painting needs no explanation or apology. This most religious of art forms belies the pathetic empiricisms of contemporary discussions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18839fc5-bc3d-3b06-b5ec-fc69bf35f5b3",
                                        "entry_id": "73b8dfd3-6ccd-3329-9954-5535f51db083",
                                        "glosses": [
                                            "Research methodology shaped from empirical philosophy (see above), e.g. surveys, statistics, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8b5a18b-7810-35f9-99c2-4fb4102e3eeb",
                                        "entry_id": "73b8dfd3-6ccd-3329-9954-5535f51db083",
                                        "glosses": [
                                            "Medicine as practised by an empiric, founded on mere (personal or anecdotal) experience, without the aid of science or a knowledge of principles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ed2e6b-24ad-4714-8aa2-868c8ebccf95",
                                                "sense_id": "a8b5a18b-7810-35f9-99c2-4fb4102e3eeb",
                                                "text": "Near-synonyms: folk medicine; quackery; charlatanry"
                                            },
                                            {
                                                "example_id": "a0c84083-4d99-4616-92af-c1266964b57b",
                                                "sense_id": "a8b5a18b-7810-35f9-99c2-4fb4102e3eeb",
                                                "text": "Empiricism is not peculiar to Denmark; and I know of no way of rooting it out, though it be a remnant of exploded witchcraft, till the acquiring a general knowledge of the component parts of the human frame, become a part of public education."
                                            },
                                            {
                                                "example_id": "9d6a5e15-1bd3-425f-a772-3866cc56f57f",
                                                "sense_id": "a8b5a18b-7810-35f9-99c2-4fb4102e3eeb",
                                                "text": "Even at the height of its popularity, medical empiricism was the creature of a most unforgiving free market economy. Successful practitioners seduced crowds as well as public officials."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b428489b-ccc7-4df6-85d1-cc876b1f8939",
                        "source_entry_id": "3c7a1f38-4a99-3b27-a3a3-40d915213334",
