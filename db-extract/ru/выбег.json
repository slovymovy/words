                        "target_lang_word": "runout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "runout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46236521-218e-32cb-b7da-e14e9883b6bc",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "Something that has been run out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722c473c-dd21-4ec9-9ffd-837cb9b789cf",
                                                "sense_id": "46236521-218e-32cb-b7da-e14e9883b6bc",
                                                "text": "The landslide had a long runout."
                                            },
                                            {
                                                "example_id": "fb8cb21a-fc77-4efa-875e-17b5c7599d7b",
                                                "sense_id": "46236521-218e-32cb-b7da-e14e9883b6bc",
                                                "text": "The freeway guardrail runout around this object is shorter than recommended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceee3e5d-c18e-3a73-a095-febb924e9ced",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "The method of getting out (dismissed from play) in which a batsman, in making a run, has not reached the popping crease when a fielder breaks his wicket with the ball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cdccb1d-0ace-3b64-a133-bb521b4887f7",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "A relatively flat portion at the end of a ski run to slow down, or to connect trails."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38378b03-6043-3830-929f-dba2c8770271",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "Slowing down at the end of a ski run, skiing on a runout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e03dc07-0932-406f-a96b-6a451d712f77",
                                                "sense_id": "38378b03-6043-3830-929f-dba2c8770271",
                                                "text": "If, as people often say, skiing is like sex, then the run-out that follows a great run—that breezy pole-and-glide along a logging road, stream, or moraine back to the lift, hut, truck, or bar—is the cigarette in bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eec3077-cd80-3bb8-a261-0e3e11edcbe4",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "The end portion of the groove of a phonographic record, after the recorded sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0adb73b7-dbe5-31ca-b38e-42632ed9a25a",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "A supposed auction employing shill bidders in order to convince legitimate buyers to purchase worthless articles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accf943a-a689-4a72-8238-0827baa73101",
                                                "sense_id": "0adb73b7-dbe5-31ca-b38e-42632ed9a25a",
                                                "text": "There is a lot of trouble in Petticoat Lane. In fact, the mock auction boys have muscled in to such an extent on the bomb damaged ground that there is a danger that Petticoat Lane may lose its good name by the boys coming in now with the \"runouts\" to make quick profits and then get out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4f7b96-4df8-3121-9592-939c04d0e410",
                                        "entry_id": "4d6415bb-21a6-395f-9480-2bde2bb5f863",
                                        "glosses": [
                                            "Deviation of the axis of rotation of a rotating object (especially a milling cutter or workpiece) relative to that object's centerline; the specific amount of deviation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e490c4c7-9203-4f7b-994f-fdd5a5effec0",
                                                "sense_id": "6e4f7b96-4df8-3121-9592-939c04d0e410",
                                                "text": "We determined that inaccuracy was caused by a large amount of tool runout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
