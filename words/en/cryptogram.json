{
    "word_family": [
        "cryptographic",
        "cryptography",
        "cryptographer",
        "cryptograph"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                    "sense_definition": "A piece of text that has been written in code or cipher.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy sent a secret <w>cryptogram</w> to his headquarters using a complex substitution cipher.",
                            "target_lang_translations": {
                                "zh": "间谍使用复杂的替换密码向总部发送了一份秘密<w>密文</w>。"
                            }
                        },
                        {
                            "text": "Historians discovered an ancient <w>cryptogram</w> hidden within the margins of the medieval manuscript.",
                            "target_lang_translations": {
                                "zh": "历史学家在中世纪手稿的页边空白处发现了一段古老的<w>密文</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ciphertext",
                        "code"
                    ],
                    "common_phrases": [
                        "solve a cryptogram"
                    ],
                    "target_lang_definitions": {
                        "zh": "用密码或暗号编写的文本。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "密文",
                                "target_lang_sense_clarification": "指经过加密处理后的文本内容。"
                            },
                            {
                                "target_lang_word": "密码文本",
                                "target_lang_sense_clarification": "指以加密形式呈现的文字。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0373b19-e768-3154-ac5a-b41a06ce5876",
                    "sense_definition": "A word puzzle consisting of a short piece of text that has been encrypted using a simple substitution cipher.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy spending my Sunday mornings solving the <w>cryptogram</w> in the local newspaper.",
                            "target_lang_translations": {
                                "zh": "我喜欢在周日上午花时间解开当地报纸上的<w>密码谜题</w>。"
                            }
                        },
                        {
                            "text": "The <w>cryptogram</w> was printed in the puzzle section, challenging readers to decode the famous quote.",
                            "target_lang_translations": {
                                "zh": "这则<w>密码谜题</w>刊登在益智版块，挑战读者去破译那句名言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cipher puzzle"
                    ],
                    "common_phrases": [
                        "daily cryptogram"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过简单替换加密的文字解谜游戏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "密码谜题",
                                "target_lang_sense_clarification": "指报纸或杂志上常见的替换式密码游戏。"
                            },
                            {
                                "target_lang_word": "替换密码游戏",
                                "target_lang_sense_clarification": "指需要通过逻辑推理还原原文的文字游戏。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}