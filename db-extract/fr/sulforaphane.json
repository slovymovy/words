                "senses": [
                    {
                        "sense_id": "46d27067-119b-31a1-9dd7-a8919d909849",
                        "entry_id": "ee012a77-3556-3524-8420-39c36db53d6f",
                        "glosses": [
                            "Composé organosulfuré anticancer, antidiabétique, et antimicrobien contenu dans des crucifères comme les brocolis, les choux de Bruxelles ou les choux-fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167932ce-c09d-4364-a14d-e83a53a1ab52",
                                "sense_id": "46d27067-119b-31a1-9dd7-a8919d909849",
                                "text": "Son pouvoir, le brocoli le tient de sa molécule, le sulforaphane, dont les chercheurs ont découvert qu'il possédait une activité antibactérienne"
                            },
                            {
                                "example_id": "8db9df14-9ac4-45c1-a6c2-e405ea68a4c3",
                                "sense_id": "46d27067-119b-31a1-9dd7-a8919d909849",
                                "text": "Surtout, il est très riche en sulforaphane, un composé connu pour ses propriétés anticancer et cardio-protectrices, mais méconnu pour ses aptitudes antidiabète."
                            },
                            {
                                "example_id": "7a6d5a0a-0069-4102-9ae9-ff9c5d3c0e5b",
                                "sense_id": "46d27067-119b-31a1-9dd7-a8919d909849",
                                "text": "Les isothiocyanates, et plus particulièrement le sulforaphane, sont retrouvés dans les légumes crucifères, comme le radis noir, mais aussi les brocolis, les choux de Bruxelles ou les choux-fleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de57b404-8d75-4351-8314-597a2019ee00",
                        "source_entry_id": "ee012a77-3556-3524-8420-39c36db53d6f",
                        "source_sense_id": "46d27067-119b-31a1-9dd7-a8919d909849",
