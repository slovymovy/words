        "fr-extract.jsonl": [
            {
                "entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                "word": "arrière-saison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f40061c0-7e75-4362-bb4b-66ab540da6d9",
                        "entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrière-saisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef93f771-9fee-3856-89ae-623a0222821b",
                        "entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "glosses": [
                            "L’automne, la fin de l’automne ou même le commencement de l’hiver."
                        ],
                        "tags": [
                            "Calendrier"
                        ],
                        "examples": [
                            {
                                "example_id": "fc4be40b-4bf4-4b34-9bad-dc366c2107f5",
                                "sense_id": "ef93f771-9fee-3856-89ae-623a0222821b",
                                "text": "Elles sont exécutées par un grand nombre de petits propriétaires qui font le rouissage à l’arrière-saison et réservent le travail du broyage et du teillage pour les longues soirées d'hiver."
                            },
                            {
                                "example_id": "e63fcc33-c127-4bfb-9dac-b6028285dc25",
                                "sense_id": "ef93f771-9fee-3856-89ae-623a0222821b",
                                "text": "L’ensemble des dispositions que nous venons de passer en revue s’applique spécialement à la filature d’été, c’est-à-dire du mois de juin à octobre. Mais lorsqu’on veut continuer le dévidage pendant l’arrière-saison […] on ferme les bâtiments au moyen de châssis vitrés."
                            },
                            {
                                "example_id": "07cbee6e-c3a5-4a42-82fc-68768539d7be",
                                "sense_id": "ef93f771-9fee-3856-89ae-623a0222821b",
                                "text": "L’arrière-saison prolongeait l’éclosion tardive des bolets, des russules « jolies », des tricholomes bleus."
                            }
                        ]
                    },
                    {
                        "sense_id": "bff76e8c-e733-38d9-b9f9-185f806a81ad",
                        "entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "glosses": [
                            "Commencement de la vieillesse."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5183b52e-ca6d-43db-bac3-46cb420f47d6",
                                "sense_id": "bff76e8c-e733-38d9-b9f9-185f806a81ad",
                                "text": "Il faut se ménager, se réserver quelque chose pour l’arrière-saison."
                            },
                            {
                                "example_id": "a8dd7bce-d6c5-41fc-80ec-157f26dd3391",
                                "sense_id": "bff76e8c-e733-38d9-b9f9-185f806a81ad",
                                "text": "Rires détestables, qui se moquaient de Marco et de moi […] comme si l’aventure qui illuminait l’arrière-saison de Marco ne fût qu’un vieux fait divers."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c527591-6e3b-380a-989c-52d7e51882c5",
                        "entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "glosses": [
                            "Derniers mois qui précèdent la récolte ou les vendanges, en parlant du blé et du vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a80ca7e-84e8-46b0-91c9-28ceb2656feb",
                                "sense_id": "5c527591-6e3b-380a-989c-52d7e51882c5",
                                "text": "Le blé se vend plus cher dans l’arrière-saison, c’est-à-dire dans les mois de juin et de juillet."
                            },
                            {
                                "example_id": "9bea3b4c-b1b8-4816-95e5-7adf37468251",
                                "sense_id": "5c527591-6e3b-380a-989c-52d7e51882c5",
                                "text": "Ce vin ne se boit que dans l’arrière-saison, c’est-à-dire dans les mois de juillet et d’août."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3823c192-648c-48f2-b425-7543db639208",
                        "source_entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "target_lang_word": "Nachsaison",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c99d23fa-7ffc-4488-89a4-f4c836030583",
                        "source_entry_id": "84438bde-b351-31e4-a852-7f3740dfcd8a",
                        "target_lang_word": "autumn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autumn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                        "entry_id": "ab64c76d-0e5c-3bed-bd69-f501ea52015d",
                                        "glosses": [
                                            "Traditionally the third of the four seasons, when deciduous trees lose their leaves, and temperatures and daylight hours decrease; typically regarded as spanning the months of September, October, and November in the Northern Hemisphere, and the months of March, April and May in the Southern Hemisphere."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034b7e76-f555-41a8-9902-fed7cfd09e2e",
                                                "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                                "text": "autumn leaves"
                                            },
                                            {
                                                "example_id": "279f7506-09b1-4650-b20e-a84f536486da",
                                                "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                                "text": "The Spring, the Sommer, / The childing Autumne, angry Winter change / Their wonted Liueries, […]"
                                            },
                                            {
                                                "example_id": "527ea061-914b-4ef9-a4d2-1258d7dd4a40",
                                                "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            },
                                            {
                                                "example_id": "1cc92ae2-ecde-4e59-a0c4-d939ae603a37",
                                                "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            },
                                            {
                                                "example_id": "6d61b74a-6ca1-41db-87ff-a5416874454e",
                                                "sense_id": "bb952388-99aa-3240-bf65-a5ceb19f360c",
                                                "text": "I left my cell, my pager, and my home phone at the bottom / I sent two letters back in autumn, you must not've got 'em"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                                        "entry_id": "ab64c76d-0e5c-3bed-bd69-f501ea52015d",
                                        "glosses": [
                                            "The time period when someone or something is past its prime."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55192c9-65d9-44a4-8d62-17ffb8ab9e9d",
                                                "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                                                "text": "She has beauty still, and if it be not in its heyday, it is not yet in its autumn."
                                            },
                                            {
                                                "example_id": "32757c81-2d39-4993-ab3f-b715a928a8ec",
                                                "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                                                "text": "It has been portrayed as the well-intended yet wrongly directed reaction to latter-day scholasticism, or as the harvest of medieval theology in its autumn years, as a revolution that is theological, political, economic, cultural—or all of the above."
                                            },
                                            {
                                                "example_id": "98947850-7b02-4ae0-904e-e1dc9ffb6f34",
                                                "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                                                "text": "Unlike the decline of British hegemony, in the current world-system no military or economic contender has emerged to replace US hegemony. Even though the US SCA has entered its autumn with the Vietname War and the economic crisis of the mid-1970s, there has been no legitimate hegemonic contender capable of instituting a new global regime to resolve both social and economic contradictions of global capitalism."
                                            },
                                            {
                                                "example_id": "302fc2a7-0092-47bc-9f16-d4a9eefef155",
                                                "sense_id": "1e64df27-d291-3340-897f-c221285022d1",
                                                "text": "The autumn of life is also a matter of saying farewell, but the strange thing is that I do not feel it is autumn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61bd35b3-9dc2-316a-8e26-02738a0c5cae",
                                        "entry_id": "ab64c76d-0e5c-3bed-bd69-f501ea52015d",
                                        "glosses": [
                                            "A person with relatively dark hair and a warm skin tone, seen as best suited to certain colours in clothing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "autumn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                        "entry_id": "68e0c6eb-1ec8-3e68-a65b-84b02ec2ccd2",
                                        "glosses": [
                                            "To spend the autumn (in a particular place)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae0693e-9602-4571-9a1c-93a07c50be99",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "So when she summered with her family in the Mediterranean, she sailed across the ocean from New York, and when she autumned in Maine, her chauffeur drove her ten hours north through the foliage, and when winter thawed and it was time again for spring training, she met her Mets in Florida after a long journey down the coast by train."
                                            },
                                            {
                                                "example_id": "5fc60d23-700e-4b6b-808b-f5ded853cddb",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "True it is that, owing to the migratory propensities of our countrymen, every third man has wintered at Naples, springed at Vienna, summered in Switzerland, and autumned on the banks of the Lago Maggiore;"
                                            },
                                            {
                                                "example_id": "c30f6482-593c-4614-9f09-b9ef3af74e41",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "If Tad’s father and Tad had wintered, springed, summered, and autumned together for an hundred years instead of fifteen they could[…]"
                                            },
                                            {
                                                "example_id": "d8dae350-26f1-4ca1-8bc0-838fee771dfd",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "They wintered in a warm place / And summered in a cold, / But where they springed and autumned / I never have been told."
                                            },
                                            {
                                                "example_id": "5f7b4e97-58d5-4d52-ba53-27233b7db2fa",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "Floyd Waggaman, the namesake of “Floyd’s Folly,” summered and autumned at Siasconset, which your columnist has been told is hard by Nantucket, Martha’s Vineyard, or one of the disenchanted isles."
                                            },
                                            {
                                                "example_id": "7491b9b4-8f51-4fb9-b1a0-00872f7827f5",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "The major’s office, young pudgy Major Lewis whose wife once offered Joe a bag of peanuts and who summered in New England and early-autumned in New York."
                                            },
                                            {
                                                "example_id": "e0ba946f-6256-4f66-b337-4167dc723e60",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "She springed in London, summered in Stockholm, autumned at Vichy, and wintered at Monte Carlo."
                                            },
                                            {
                                                "example_id": "70f2bc17-4813-4bb0-9e9f-8810dd01eb1e",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "I have summered and autumned (fallen?) on the North Fork for forty-two years."
                                            },
                                            {
                                                "example_id": "168448b4-5a66-4c2a-9463-283aeaedb443",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "In recent years his friend the fourth-quarter king summered, autumned, and springed in nearby Southern California, which was how they stayed so easily in touch."
                                            },
                                            {
                                                "example_id": "184ed312-d0ac-4b79-ad62-de3e804b7191",
                                                "sense_id": "03856163-0fda-3bf8-81a2-0d50e24f2704",
                                                "text": "Larry and Bill had planned to hold a white-linen “fancy” fund-raiser dinner in late June or early July, which would bring out the moneyed crowd who “summered” on the Island. If you summer or winter somewhere you are affluent, Larry knew. (Funny, though, he had never heard of anyone who “autumned” in Vermont or who was “springing” in Colorado.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                        "entry_id": "68e0c6eb-1ec8-3e68-a65b-84b02ec2ccd2",
                                        "glosses": [
                                            "To (cause to) undergo the changes associated with autumn, such as leaves changing color and falling from trees."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179c29ad-7ce4-4c33-ac89-8f21584594cf",
                                                "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                                "text": "The glistening path where weeds had clung, / And tumbled bushes lay, / Was hidden now, but yet there rung / Tones of an autumned May.[…]And cheers rang out, the song and shout, / For the fray had found its eve, / And pirate chief like autumned leaf, / O’er fallen pride did grieve!”"
                                            },
                                            {
                                                "example_id": "e86b0abe-a7a9-42af-be04-384c8fddd3f1",
                                                "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                                "text": "[…]he himself roamed with innocent Kate through the fast autumning woods[…]"
                                            },
                                            {
                                                "example_id": "45679a11-fd79-4b06-a9f5-c2d2bf9c08f4",
                                                "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                                "text": "She turns off towards the river, where the lawns lie autumned on the banks between the frayed golden willow branches."
                                            },
                                            {
                                                "example_id": "764c9360-910e-48b7-9f1f-5ac40ca5c301",
                                                "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                                "text": "[…]three quarters, two thirds of the flowering tops have changed colour and these are very resinous, solid buds and the colouration of the leaf, you can see how it’s yellowed off, it’s autumning, autumn has come if you would like to put it that way."
                                            },
                                            {
                                                "example_id": "f2cc3bad-1d5b-48ea-a8e6-43108f174fc4",
                                                "sense_id": "b6669425-28e0-3e8d-959a-84092ea32e6f",
                                                "text": "Spirit of Autumn, When I grow tired of using my gifts to benefit others, take me to the autumned fields where earth freely yields the bounty of her summer.[…]All night a steady rain fell upon the autumned earth, moistening every dried crack of the bony summer, rinsing what lay tattered and soiled in the remnants of yesterday."
                                            }
                                        ]
                                    }
                                ]
                            },
