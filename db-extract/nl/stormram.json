                    },
                    {
                        "translation_id": "b7516856-4a9d-478a-9f0d-98b832f4f927",
                        "source_entry_id": "57279ba0-0692-3c81-b921-755c16c9804e",
                        "source_sense_description": "een toestel, balk, e.d. om een deur, poort te forceren",
                        "target_lang_word": "battering ram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "battering ram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c06455-7c69-3430-9333-f4e4bc668e29",
                                        "entry_id": "9bc2c8ea-218d-3bd4-9784-75fed1fa592a",
                                        "glosses": [
                                            "A heavy object used for battering down walls and gates or a siege engine that includes such an object."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d540b2ee-cb4a-3b51-a524-855696916663",
                                        "entry_id": "9bc2c8ea-218d-3bd4-9784-75fed1fa592a",
                                        "glosses": [
                                            "A modern device, usually in the form of a metal bar with handles, chiefly used by police and firefighters to force open locked doors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18ee195-c324-3a80-acaa-c68e14e9e318",
                                        "entry_id": "9bc2c8ea-218d-3bd4-9784-75fed1fa592a",
                                        "glosses": [
                                            "Something which acts as a powerful tool against something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947d5667-c0a5-4fff-93c6-533187e1f3b2",
                                                "sense_id": "c18ee195-c324-3a80-acaa-c68e14e9e318",
                                                "text": "And in the edition of their party newspaper released last week, [the Tories] pledged to Manitobans that they would continue their battering ram approach this time around."
                                            },
                                            {
                                                "example_id": "44205a9d-4e6c-4438-b34d-c825a89c1dfb",
                                                "sense_id": "c18ee195-c324-3a80-acaa-c68e14e9e318",
                                                "text": "That was expected, I suppose, because during the Trump era, the GOP was a battering ram against truth and reality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05c037e3-aff6-4721-a592-aad5946622b1",
                        "source_entry_id": "57279ba0-0692-3c81-b921-755c16c9804e",
                        "source_sense_description": "een toestel, balk, e.d. om een deur, poort te forceren",
                        "target_lang_word": "bélier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bélier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79a3db0f-6713-30bc-91e8-c1f9401c2ba5",
                                        "entry_id": "f29ac9e4-0241-331c-9c97-f0c32f94e19e",
                                        "glosses": [
                                            "Mouton mâle non châtré, caractérisé par ses cornes en spirales."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "695c75f8-1dd6-4c2a-973a-b962b7fa494d",
                                                "sense_id": "79a3db0f-6713-30bc-91e8-c1f9401c2ba5",
                                                "text": "[…] ici, les mères, en divers groupes : là, les agneaux ; plus loin, les béliers. À deux mois, on châtrait les mâles, qu’on élevait pour la vente : tandis qu’on gardait les femelles, afin de renouveler le troupeau des mères, dont on vendait chaque année les plus vieilles ; et les béliers couvraient les jeunes, à des époques fixes, des dishleys croisés de mérinos, superbes avec leur air stupide et doux, leur tête lourde au grand nez arrondi d’homme à passions."
                                            },
                                            {
                                                "example_id": "b4167270-046c-47d1-b04c-34ee4c31e96e",
                                                "sense_id": "79a3db0f-6713-30bc-91e8-c1f9401c2ba5",
                                                "text": "Le septième jour, les grands prêtres ont soufflé dans des trompettes de cornes de bélier et la ville est tombée, grâce à une intervention divine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                        "entry_id": "f29ac9e4-0241-331c-9c97-f0c32f94e19e",
                                        "glosses": [
                                            "Machine de guerre médiévale servant à enfoncer les portes blindées des châteaux-forts ; composée d’un tronc et d’une tête justement renforcée, rappelant la tête de l’animal."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21279a8f-d349-4962-b95b-82c28a1ee58b",
                                                "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                                "text": "[…] les autres allèrent couper un sapin qu’ils dépouillèrent de ses branches et dont ils firent un bélier pour enfoncer la porte."
                                            },
                                            {
                                                "example_id": "93a8e853-9819-4d02-b319-413b0d3f290e",
                                                "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                                "text": "Enfin la dernière nous paraît représenter le bosson, ou bélier des anciens, avec lequel on battait en brèche les murailles avant l’emploi de l’artillerie."
                                            },
                                            {
                                                "example_id": "c2439ba6-9143-4c88-9423-53893bc8505c",
                                                "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                                "text": "Cette lecture était fréquemment interrompue, non seulement par le choc de la rafale, qui frappait comme un bélier les murailles de la maison, mais aussi par les cris du bébé."
                                            },
                                            {
                                                "example_id": "5ea07c95-c09d-4364-9650-f332c560a6c2",
                                                "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                                "text": "À l’heure dite, les chevaux étaient devant notre maison, et Romero faisait bélier à notre porte avec la crosse de sa carabine."
                                            },
                                            {
                                                "example_id": "d97a7bdb-efc5-4af3-9644-1c3433f3dd88",
                                                "sense_id": "6fcbe949-f98a-3da6-8f69-78e760fc8a4f",
                                                "text": "Il fait bélier de ses reins. Un grand craquement en résulte. Le verrou a sauté ; la porte cède […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd481ef8-1b66-3fc5-9e39-498d03c93aad",
                                        "entry_id": "f29ac9e4-0241-331c-9c97-f0c32f94e19e",
                                        "glosses": [
                                            "Outil à enfoncer les pieux ou d’autres éléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c550d0-9905-42ed-9f00-bafc28439960",
                                                "sense_id": "fd481ef8-1b66-3fc5-9e39-498d03c93aad",
                                                "text": "Pilon/bélier utilisé pour enfoncer les poteaux de bois profondément en terre."
                                            },
                                            {
                                                "example_id": "5a582110-5596-4c22-8b2e-62d69ef34e79",
                                                "sense_id": "fd481ef8-1b66-3fc5-9e39-498d03c93aad",
                                                "text": "Pour bien faire passer le message, la brochure contient une publicité pleine page pour un pistolet d’abattage, une sorte de mini-bélier pneumatique portable dont la tige sort à toute vitesse pour défoncer le cervelet des animaux d’élevage et les tuer instantanément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f070ef-7043-3a10-bb7e-9bdaa64b6ac3",
                                        "entry_id": "f29ac9e4-0241-331c-9c97-f0c32f94e19e",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. À rapprocher de l’agneau, de l’agneau pascal, de la brebis ou du mouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f812998b-31ed-44eb-a77a-36437f82e3f7",
                                                "sense_id": "48f070ef-7043-3a10-bb7e-9bdaa64b6ac3",
                                                "text": "D’azur au bélier passant d’argent accorné et onglé d’or ; au chef d’hermine, qui est de Quimper → voir illustration « armoiries avec un bélier »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
