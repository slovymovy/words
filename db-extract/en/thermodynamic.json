                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1f4a131-2406-3416-9e92-5f5cd836d02e",
                        "entry_id": "9141d49d-0a9b-34f5-9baa-e9e6c5bfcaa0",
                        "glosses": [
                            "Of, or relating to the conversion of heat into other forms of energy."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e11931d9-1791-4b8e-b95b-c8d4c8d8f23c",
                                "sense_id": "c1f4a131-2406-3416-9e92-5f5cd836d02e",
                                "text": "The locomotive is designed to give a high and sustained tractive effort at moderate speed on steep gradients. To attain this result, M. Chapelon, in experiments dsting back to 1940, aimed at improving the thermodynamic efficiency."
                            }
                        ]
                    },
                    {
                        "sense_id": "3322b807-b1df-3e5a-b938-b8e2982ff7f3",
