                "senses": [
                    {
                        "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                        "entry_id": "d761fab7-9ae5-313d-8f95-0126f86cabbc",
                        "glosses": [
                            "Hirsch, dessen Geweih 14 Enden aufweist"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "0a13db33-8eb1-462e-9a79-3394a5f54c4e",
                                "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                                "text": "„Der Zwölfender erlag im Kampfe und der Vierzehner wurde dann vom Herzog geschossen.“"
                            },
                            {
                                "example_id": "8ef01cf1-2187-43b7-8ba0-676a1e811c48",
                                "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                                "text": "„Wenn ich nicht irre, so wurden dreizehn Hirsche erlegt, worunter zwei Vierzehner.“"
                            },
                            {
                                "example_id": "04a762de-c497-4fd8-9113-47e533ade76b",
                                "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                                "text": "„Stärkere Hirsche als Vierzehner sind nicht auf der Heide und im Bruche, wie er sagte.“"
                            },
                            {
                                "example_id": "3c445a3e-af69-4c6d-b466-1f7dd7142363",
                                "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                                "text": "„Diese beiden Hirsche haben in der Brunstzeit 1735 auf Schwander Wildfuhr sich dergestalt verkämpft, dass der ungerade Zwölfer dem ungeraden Vierzehner den Hals gebrochen und solchen auf 500 Schritte weit fortgeschleppt hat.“"
                            },
                            {
                                "example_id": "43102802-9e19-497b-97d0-78811dfecec4",
                                "sense_id": "94d35ff0-e2cb-39f0-98fe-73e618ecbf76",
                                "text": "„Der Zwölfender erlag im Kampfe und der Vierzehner wurde dann vom Herzog geschossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
