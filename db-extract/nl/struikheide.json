                    {
                        "sense_id": "4efc0ed1-e166-3fe3-b112-7fc9cf17afb3",
                        "entry_id": "71548667-c1bb-334e-acae-c3c50dda494b",
                        "glosses": [
                            "Calluna vulgaris struik van 10 tot 100 cm hoogte die de gewone heide vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da511ec3-3307-4249-9602-5a2eae1e000a",
                                "sense_id": "4efc0ed1-e166-3fe3-b112-7fc9cf17afb3",
                                "text": "Op antieke postkaarten uit het begin van de vorige eeuw is te zien hoe de Nolse landduinen het landschap bepalen en domineren. In die tijd is Kalmthout een grote witte zandbak met hier en daar een verloren boom en wat struikheide."
                            },
                            {
                                "example_id": "e6236ea5-3083-4186-b203-77412ee0c435",
                                "sense_id": "4efc0ed1-e166-3fe3-b112-7fc9cf17afb3",
                                "text": "Het grootste gebied is de Sallandse Heuvelrug, dat niet wordt beschermd vanwege het korhoen, maar om het grootste oppervlak droge heide (struikheide) dat er nog in West-Europa over is."
                            }
                        ]
                    }
