                "senses": [
                    {
                        "sense_id": "e6b7f2c5-c589-3e45-8018-a8a1cf806cbc",
                        "entry_id": "8abf27db-a2ad-310a-acc2-5c82728c39c5",
                        "glosses": [
                            "Avion bombardier d’eau, avion de lutte anti-incendie, avion de lutte contre les incendies, canadair, Canadair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce882ab2-923e-40f0-9a5d-ad08c64dc5db",
                                "sense_id": "e6b7f2c5-c589-3e45-8018-a8a1cf806cbc",
                                "text": "Erst durch den Einsatz der Löschflugzeuge konnte der Waldbrand wieder unter Kontrolle gebracht werden.",
                                "translation": "Seule l’intervention des avions de lutte anti-incendie a premis de reprendre le contrôle du feu de forêt."
                            },
                            {
                                "example_id": "a0e6fb7e-19b7-4912-ad85-ad5c35ee1320",
                                "sense_id": "e6b7f2c5-c589-3e45-8018-a8a1cf806cbc",
                                "text": "Nur wenn er einen Schluck aus der Flache brauchte, bewegte er sich, oder wenn er den Kopf einzog, weil das Löschflugzeug tief über die Pinien dröhnte, um eine weitere Ladung Wasser abzuwerfen.",
                                "translation": "Il ne faisait un geste que lorsqu’il voulait prendre une gorgée à sa bouteille ou bien lorsqu’il rentrait la tête entre les épaules parce que le Canadair vrombissait au-dessus des pins pour lâcher un nouveau chargement d’eau."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
