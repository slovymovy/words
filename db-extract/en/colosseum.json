                "senses": [
                    {
                        "sense_id": "bfb2af6d-ffea-3523-849d-8bc2daabf688",
                        "entry_id": "79558c12-7218-326d-9571-817749bd508e",
                        "glosses": [
                            "Alternative spelling of coliseum."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "63debf22-349b-43b2-9401-764683cb92a5",
                                "sense_id": "bfb2af6d-ffea-3523-849d-8bc2daabf688",
                                "text": "This design was also adopted for their amphitheatres, such as the colossea of Rome and Capua, the plan of which resembles the cavea of two theatres set together so as to enclose an oval space."
                            },
                            {
                                "example_id": "4e94791f-53ca-4005-a413-af900b9f312b",
                                "sense_id": "bfb2af6d-ffea-3523-849d-8bc2daabf688",
                                "text": "The temples and banking halls of Rome were turned into churches, and the deserted shells of the great monuments, the baths, the stadia and colossea, were used as quarries for buildings to come."
                            },
                            {
                                "example_id": "d04f2c6f-f3c1-4741-a5b4-33ae4c11895f",
                                "sense_id": "bfb2af6d-ffea-3523-849d-8bc2daabf688",
                                "text": "The colossea, games and temples declined."
                            }
                        ]
                    }
                ],
