                    {
                        "translation_id": "a8cd7960-0298-4e3a-be8e-02cf905ebacc",
                        "source_entry_id": "36b80840-df7b-3c5d-9c50-f5a4c805ad5d",
                        "source_sense_id": "9f5fea3d-163f-3be8-893f-0c4192c57abc",
                        "source_sense_description": "offizielle, veröffentlichte Verlautbarung",
                        "target_lang_word": "bulletin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulletin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d30e910-4277-334f-9af3-8882904690f6",
                                        "entry_id": "8a46f7c8-8fe7-3d74-b7c8-d1902d23741e",
                                        "glosses": [
                                            "Petit papier sur lequel on donne par écrit son vote pour concourir à une élection ou à une délibération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c884c38-0cbc-4f41-be85-6c1baa0fffdf",
                                                "sense_id": "7d30e910-4277-334f-9af3-8882904690f6",
                                                "text": "Quand fut achevé le dépouillement, on constata qu’il y avait 47 bulletins pour les Rouges et 47 bulletins pour les Blancs. Le président, abasourdi, et son bureau ahuri, prononcèrent le ballottage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39869381-20d7-304b-a9ab-91ca3f7910f2",
                                        "entry_id": "8a46f7c8-8fe7-3d74-b7c8-d1902d23741e",
                                        "glosses": [
                                            "Petit écrit par lequel on rend compte chaque jour de l’état actuel d’une chose qui intéresse le public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc3ecdc-329d-474f-9cf0-4bafba2edd16",
                                                "sense_id": "39869381-20d7-304b-a9ab-91ca3f7910f2",
                                                "text": "Jean-Pierre Baud […] fut aussi le rédacteur (du nᵒ 1 au nᵒ 15) de l’organe de ladite Amicale, ce bulletin « irrégulomadaire » (dixit Georges Mahé) qu'était à ses débuts notre cher Petit Diagonaliste."
                                            },
                                            {
                                                "example_id": "1cbcf151-41fb-4013-805a-9b6d43691285",
                                                "sense_id": "39869381-20d7-304b-a9ab-91ca3f7910f2",
                                                "text": "Bulletin de santé. — Les nouvelles du malade sont meilleures, les médecins n’ont pas publié de bulletin."
                                            },
                                            {
                                                "example_id": "e9d3c10a-6b20-4f94-8186-ade43189ef96",
                                                "sense_id": "39869381-20d7-304b-a9ab-91ca3f7910f2",
                                                "text": "Le prochain bulletin de circulation dans une heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc395689-bec6-32c0-bf30-268dec10159f",
                                        "entry_id": "8a46f7c8-8fe7-3d74-b7c8-d1902d23741e",
                                        "glosses": [
                                            "Petits billets ou écrits servant à constater certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4033d208-928a-4373-91c1-f06bc1a4c6d3",
                                                "sense_id": "bc395689-bec6-32c0-bf30-268dec10159f",
                                                "text": "Délivrer un bulletin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064765c7-1a14-3c83-acac-2a06d1705551",
                                        "entry_id": "8a46f7c8-8fe7-3d74-b7c8-d1902d23741e",
                                        "glosses": [
                                            "Bulletin de notes."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7edd0b73-5f48-4237-8515-76aa6cbb6403",
                                                "sense_id": "064765c7-1a14-3c83-acac-2a06d1705551",
                                                "text": "le bulletin trimestriel est envoyé chaque trimestre aux parents de l’élève pour rendre compte de sa conduite et de son travail durant cette période."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247c8b2e-6da0-3975-bd40-47af27ef6425",
                                        "entry_id": "8a46f7c8-8fe7-3d74-b7c8-d1902d23741e",
                                        "glosses": [
                                            "Bulletin de l'armée."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60bb658-decd-41b4-8727-1ae5f9621859",
                                                "sense_id": "247c8b2e-6da0-3975-bd40-47af27ef6425",
                                                "text": "Enfin je sentis ma conscience, je résolus de m’appuyer uniquement sur elle, de considérer les jugements publics, les récompenses éclatantes, les fortunes rapides, les réputations de bulletin, comme de ridicules forfanteries et un jeu de hasard qui ne valait pas la peine qu’on s’en occupât."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01aa2fa1-ad3e-404a-88f9-bad8793bcb33",
                        "source_entry_id": "36b80840-df7b-3c5d-9c50-f5a4c805ad5d",
                        "source_sense_id": "9f5fea3d-163f-3be8-893f-0c4192c57abc",
                        "source_sense_description": "offizielle, veröffentlichte Verlautbarung",
                        "target_lang_word": "бюллетень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бюллетень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5474557a-b672-39fd-9a0a-43786df864a1",
                                        "entry_id": "cfe48c0e-316d-3d33-a47d-2f858a2dc0aa",
                                        "glosses": [
                                            "краткое официальное сообщение о событиях, имеющих важное общественное значение, о ходе дел, состоянии кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4fc6ab-b919-4b41-afc3-e4c482c3ad41",
                                                "sense_id": "5474557a-b672-39fd-9a0a-43786df864a1",
                                                "text": "Бюллетень о состоянии здоровья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c754ce85-12c5-3882-a91d-24b3e68c9c60",
                                        "entry_id": "cfe48c0e-316d-3d33-a47d-2f858a2dc0aa",
                                        "glosses": [
                                            "периодическое или продолжающееся издание, содержащее краткие материалы о работе учреждений, общественных организаций, результаты исследований и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493ec516-f091-4d3c-b9f7-387b3ca173bd",
                                                "sense_id": "c754ce85-12c5-3882-a91d-24b3e68c9c60",
                                                "text": "Информационный бюллетень адресован, прежде всего, тем, кого интересует приобретение квартиры в рассрочку, а также всем, кто следит за реализацией программ, расширяющих сферу пермского потребительского рынка жилья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5378c2af-d3b3-36dc-a12e-6f89adf09d38",
                                        "entry_id": "cfe48c0e-316d-3d33-a47d-2f858a2dc0aa",
                                        "glosses": [
                                            "периодическое или однократное информационное сообщение о чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb7bb12-e01c-4d0b-9ced-dd5a98bb8cc5",
                                                "sense_id": "5378c2af-d3b3-36dc-a12e-6f89adf09d38",
                                                "text": "Смяте́ние пришло́ в тот миг, когда́ ра́дио пе́реда́ло бюллете́нь о здоро́вье Ста́лина: «Дыха́ние Чейн-Стокса… моча́… пульс… кровяно́е давле́ние…»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5209115-0cc9-3ec5-8448-5106a6cc06ae",
                                        "entry_id": "cfe48c0e-316d-3d33-a47d-2f858a2dc0aa",
                                        "glosses": [
                                            "документ для голосования с фамилиями кандидатов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c226511-e681-406d-83e0-26d1cf5b3a18",
                                                "sense_id": "f5209115-0cc9-3ec5-8448-5106a6cc06ae",
                                                "text": "Избирательные бюллетени являются документами строгой отчётности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a5e5b87-572f-378b-af31-7a149c7b0c1c",
                                        "entry_id": "cfe48c0e-316d-3d33-a47d-2f858a2dc0aa",
                                        "glosses": [
                                            "разг. листок нетрудоспособности по болезни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c0df15-aa42-4472-bc1b-f9dda01c9243",
                                                "sense_id": "9a5e5b87-572f-378b-af31-7a149c7b0c1c",
                                                "text": "Одна́ко поста́вила предположи́тельный диа́гноз ― транзиторная фо́рма гипертони́ческой боле́зни, вы́писала бюллете́нь и обеща́ла ещё присла́ть на́ дом невропато́лога."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
