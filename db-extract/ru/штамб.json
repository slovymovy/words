                "senses": [
                    {
                        "sense_id": "f89f9ce0-a17b-3271-a88f-1024ea3b5d4b",
                        "entry_id": "b7582685-b185-3326-9f1b-515bfad049bd",
                        "glosses": [
                            "агрон. часть ствола дерева от корневой шейки до первой скелетной ветви нижнего яруса кроны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12741fbd-bcbe-481b-87d2-db23361c5a41",
                                "sense_id": "f89f9ce0-a17b-3271-a88f-1024ea3b5d4b",
                                "text": "Белить надо не только нижнюю часть ствола ― штамб, но и основания крупных ветвей: в развилках трещины и ожоги бывают чаще."
                            }
                        ]
                    },
                    {
                        "sense_id": "53df79c0-d3af-3b1f-be1e-028dc2ea95a3",
                        "entry_id": "b7582685-b185-3326-9f1b-515bfad049bd",
                        "glosses": [
                            "полигр. вертикальный или наклонный элемент буквы в шрифте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa78207-a86e-4699-85df-0738afd4abb7",
                                "sense_id": "53df79c0-d3af-3b1f-be1e-028dc2ea95a3",
                                "text": "В милешевском шрифте линия, соединяющая два крайних штамба, закруглена и сильно опускается за нижнюю линию строки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08dba93d-6567-46c0-bd0c-43af3f48c6c8",
                        "source_entry_id": "b7582685-b185-3326-9f1b-515bfad049bd",
                        "source_sense_description": "часть ствола дерева",
                        "target_lang_word": "Stamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d58fa0b-a8a5-3e12-8e33-17a8ca9603c3",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "Teil des Baumes zwischen Wurzel und Krone"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a0ae31-cdde-4122-b958-0527d78ff6f7",
                                                "sense_id": "9d58fa0b-a8a5-3e12-8e33-17a8ca9603c3",
                                                "text": "Max klettert schnell den Stamm hinauf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "größere Gruppe von Menschen mit ethnischen Gemeinsamkeiten"
                                        ],
                                        "tags": [
                                            "Ethnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f5fc95-3cf3-4cde-85e7-9529fc2580cf",
                                                "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                                "text": "Ehemals lebte in Nordamerika eine Vielzahl von Stämmen, die zu den Indianern zählten."
                                            },
                                            {
                                                "example_id": "b84d8b37-0a64-43cd-9c7d-06982bd215f3",
                                                "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                                "text": "„Schockierend war an der Schreckensnachricht der Name des Anführers, der die Römer in die tödliche Falle geführt hatte: Arminius vom germanischen Stamm der Cherusker, die mit etwa 200000 Menschen zwischen Elbe, Weser und Harz siedelten.“"
                                            },
                                            {
                                                "example_id": "ca3d9870-c955-42e9-9b6e-a42d846e999a",
                                                "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                                "text": "„Die Stämme leben also keineswegs isoliert, sondern schließen Allianzen miteinander und stellen große Armeen auf.“"
                                            },
                                            {
                                                "example_id": "52b061d9-1e08-4cb1-a0b9-b80712b5ee2a",
                                                "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                                "text": "„Der ganze Stamm war aufgebrochen.“"
                                            },
                                            {
                                                "example_id": "c51b3328-4f4a-45b3-8d7c-cb6205069caa",
                                                "sense_id": "efac4c36-7259-3cdf-a020-f6be23826ecf",
                                                "text": "„Zwischen den Marianen und Samoa lebten zahlreiche Stämme mit verschiedenen Sprachen, andersartigen Kulturen und ungleichen Herrschaftssystemen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f7d83c18-e04c-34ef-ab17-9a6a7e113e32",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "Element der biologischen Taxonomie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a42776-9d77-4e03-b8e3-8268717b08e0",
                                                "sense_id": "f7d83c18-e04c-34ef-ab17-9a6a7e113e32",
                                                "text": "Die Insekten gehören zum Stamm der Gliederfüßer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2eee7ae9-8fd7-3f00-98d4-dcd023f4d0b1",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "kleine bearbeitbare Gruppe niederer Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3964d8c9-a12b-4197-b08c-2fb951ad613d",
                                                "sense_id": "2eee7ae9-8fd7-3f00-98d4-dcd023f4d0b1",
                                                "text": "Bei Bakterien, die im Hochsicherheitslabor gehalten werden müssen, reicht ein einziger Stamm für den nomenklatorischen Typus aus."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6ee2926a-de98-31b3-ad94-0c5e268ebf5d",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "personelle Grundlage, personeller Bestand bei Betrieben, beim Militär, in der Seefahrt und anderen Organisationen oder Zusammenschlüssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab7b6d2-498a-42d2-813b-d34cd19ade99",
                                                "sense_id": "6ee2926a-de98-31b3-ad94-0c5e268ebf5d",
                                                "text": "Diesen Auftrag arbeiten wir nur mit dem Stamm unserer Leute ab."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "58ea4006-2ee9-3baf-9311-1d481dea1d8a",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "einfache oder komplexe Grundform der Flexion eines Wortes (Wortstamm)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f7dadf-24f0-4410-8449-f3d9079b3274",
                                                "sense_id": "58ea4006-2ee9-3baf-9311-1d481dea1d8a",
                                                "text": "Der Stamm ist die Grundform eines Wortes, die flektiert werden kann."
                                            },
                                            {
                                                "example_id": "b6df7b81-0914-4437-bbf9-a0d01862ddd8",
                                                "sense_id": "58ea4006-2ee9-3baf-9311-1d481dea1d8a",
                                                "text": "„Die Flexion der Tempora und ihrer Modi kommt dadurch zustande, daß an den jeweiligen Stamm die Personalendungen treten.“"
                                            },
                                            {
                                                "example_id": "374786a1-29ff-455b-afc3-80e3f96f3227",
                                                "sense_id": "58ea4006-2ee9-3baf-9311-1d481dea1d8a",
                                                "text": "„Präfixe und Verbpartikeln lassen sich als Bestandteile von Stämmen in der Regel identifizieren, Suffixe aber durchaus nicht immer.“"
                                            },
                                            {
                                                "example_id": "63639654-65c8-4690-9923-e6ab9d915bf7",
                                                "sense_id": "58ea4006-2ee9-3baf-9311-1d481dea1d8a",
                                                "text": "„In Ansehung des Gebrauchs der Wörter Wurzel (radix) und Stamm, Stammwort herrscht bey den Grammatikern keine Consequenz. […] Der richtigere Sprachgebrauch ergibt sich schon aus dem jenen Ausdrücken zum Gunde liegenden Bilde (vergl. Schmitthenner Ursprachlehre §.48). Sowie aus der dem Auge verborgenen Wurzel des Baumes der sichtbare Stamm, aus diesem die Aeste und Sprossen hervorgehen, so wird man mit dem Worte Wurzel der Wörter nichts anderes als das oft unbekannte und problematische, häufig als Wort gar nicht vorkommende, nur durch Combination erforschte Urelement derselben bezeichnen dürfen, welches auch im Hebräischen meistens einsilbig ist (s. no. 2 des §.), unter Stamm, Stammwort aber die aus der Wurzel hervorgegangenen dreybuchstaben Wörter, sowohl Verba als Nomina, verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "a1a7bba3-9f51-36b4-bfff-240512e40a98",
                                        "entry_id": "00e75342-b8d4-333b-9bb1-3ec4bd009a69",
                                        "glosses": [
                                            "Grundwort einer Wortfamilie"
                                        ],
                                        "tags": [
                                            "Semantik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa31c71d-88e0-450a-9374-db33f94a531c",
                                                "sense_id": "a1a7bba3-9f51-36b4-bfff-240512e40a98",
                                                "text": "Zur Wortfamilie mit dem Grundwort/Stamm „Tisch“ gehören Ausdrücke wie „Tisch“, „auftischen“, „Nachtisch“."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
