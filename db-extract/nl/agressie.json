                                    {
                                        "sense_id": "deda7de9-01fc-382f-a196-1da95163a623",
                                        "entry_id": "6f6cae5c-de43-34c9-9f06-ae8d683e9835",
                                        "glosses": [
                                            "The act of initiating hostilities or invasion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8adef51-42d3-486e-a765-84d8c731c452",
                                                "sense_id": "deda7de9-01fc-382f-a196-1da95163a623",
                                                "text": "Control, dispossession, violence, and tyranny are not “defensive”: they are part of an organized, ongoing aggression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f63bab0-1c8f-3cc1-81dd-b59347612b22",
                                        "entry_id": "6f6cae5c-de43-34c9-9f06-ae8d683e9835",
                                        "glosses": [
                                            "The practice or habit of launching attacks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd8fbe4c-0c63-353b-a5b4-7849ffb02804",
                                        "entry_id": "6f6cae5c-de43-34c9-9f06-ae8d683e9835",
                                        "glosses": [
                                            "Hostile or destructive behavior or actions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fe5c74b-d13a-4a08-a6e2-0c6becc653cb",
                                                "sense_id": "dd8fbe4c-0c63-353b-a5b4-7849ffb02804",
                                                "text": "The decision to impose a steel and aluminum tariff is an act of aggression which makes trade war between the two pillars of the West a grim possibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abd4d00e-ca77-308d-ab04-449ddb905b5e",
                                        "entry_id": "6f6cae5c-de43-34c9-9f06-ae8d683e9835",
                                        "glosses": [
                                            "The initiation or threat of conflict; coercion."
                                        ],
                                        "tags": [
                                            "countable",
