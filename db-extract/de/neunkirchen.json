                        "glosses": [
                            "Bezirkshauptstadt im österreichischen Bundesland Niederösterreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e70c2b2-40de-4b1a-bce7-570e95b60f1a",
                                "sense_id": "50c12ad1-0343-38b6-9345-ff89154bf088",
                                "text": "Anlässlich 100 Jahre Stadt Neunkirchen wurde Autor und Historiker René Harather mit dem Verfassen des Werks beauftragt."
                            },
                            {
                                "example_id": "f2495439-84be-42a3-b282-a4cdd17e6f9e",
                                "sense_id": "50c12ad1-0343-38b6-9345-ff89154bf088",
                                "text": "Das Museum der Bezirkshauptstadt Neunkirchen lockt mit seinen umfangreichen Sammlungen, die in 13 Schauräumen ansprechend präsentiert werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
