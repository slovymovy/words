                        "glosses": [
                            "Rendre illettré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d66b854-58f9-4473-9085-1b5315de7922",
                                "sense_id": "add68c45-08f4-35a1-86ba-993b7c5b5c05",
                                "text": "Je crois que je m'illettrise."
                            },
                            {
                                "example_id": "d4880079-a238-4c5c-9c28-624cedeaa30d",
                                "sense_id": "add68c45-08f4-35a1-86ba-993b7c5b5c05",
                                "text": "En alphabétisant, on illettrise."
                            },
                            {
                                "example_id": "e1c3468c-9553-4e6e-a828-a19ead6450f7",
                                "sense_id": "add68c45-08f4-35a1-86ba-993b7c5b5c05",
                                "text": "Depuis que la compétence maximale requise par mes études en terme ^([sic : termes]) de qualités littéraires est de savoir colorier une case, tout se casse la gueule, je m'illettrise."
                            },
                            {
                                "example_id": "1bcf0e2e-a705-434f-a512-11c394cbe43b",
                                "sense_id": "add68c45-08f4-35a1-86ba-993b7c5b5c05",
                                "text": "Mais vous avez une responsabilité vis à vis des jeunes lecteurs et des moins jeunes qui s'illettrisent ainsi..."
                            }
                        ]
                    }
