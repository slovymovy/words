                    }
                },
                {
                    "sense_id": "929a3182-40b2-3b65-a015-db179dd72c64",
                    "sense_definition": "An overwhelming passion, impulse, or frenzy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In an sudden <w>oestrus</w> of inspiration, the poet wrote through the night without stopping.",
                            "target_lang_translations": {
                                "ru": "В неожиданном <w>порыве</w> вдохновения поэт писал всю ночь напролёт без остановки."
                            }
                        },
                        {
                            "text": "His violent outburst seemed driven by an irresistible <w>oestrus</w> that seized his mind.",
                            "target_lang_translations": {
                                "ru": "Его яростная вспышка, казалось, была вызвана непреодолимым <w>исступлением</w>, овладевшим его разумом."
                            }
