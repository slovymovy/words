    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "41a8dbfc-710f-3405-92d7-4eb75a97b800",
                "word": "oxen",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b924ed00-a691-3670-9ac6-c2818695f7a6",
                        "entry_id": "41a8dbfc-710f-3405-92d7-4eb75a97b800",
                        "glosses": [
                            "Of, relating to, or resembling an ox; oxlike"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb42960b-9ba5-44c3-a596-59e19046742a",
                                "sense_id": "b924ed00-a691-3670-9ac6-c2818695f7a6",
                                "text": "These included the adze, saws of different sizes with, very likely, different size teeth or cutting edges, axe, chisels of various sizes, drills with various size drill bits, a square, plumb line, hammer, maul, and awl, plus a sharpening stone of slate and an oxen horn used as an oil flask."
                            },
                            {
                                "example_id": "e7ad2ddb-919a-4a70-87a9-3faf03768452",
                                "sense_id": "b924ed00-a691-3670-9ac6-c2818695f7a6",
                                "text": "He also had a tail like an oxen tail only with a razor sharp bard that he used in conflict to stab or slice his victims."
                            },
                            {
                                "example_id": "3636e5be-7658-4a96-8a08-3b8c77d24297",
                                "sense_id": "b924ed00-a691-3670-9ac6-c2818695f7a6",
                                "text": "He took a great gulp of wine from an oxen horn goblet and with a sigh slammed it down on the conference table. “Warriors!” he bellowed, gazing about as if daring anyone to challenge him."
                            },
                            {
                                "example_id": "94ea7f0c-6eef-4786-b7ac-ab8f50dd0016",
                                "sense_id": "b924ed00-a691-3670-9ac6-c2818695f7a6",
                                "text": "Kvigr walked the oxen cart between the huts. There were many markings on each of the huts."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
