                                "target_senses": [
                                    {
                                        "sense_id": "1b4d1154-d8e4-3f01-b659-83469c8a0064",
                                        "entry_id": "da8a9702-9c9c-3579-8081-a19e04af9314",
                                        "glosses": [
                                            "Mali betreffend, aus Mali kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc86506d-7df1-4e88-b0b0-62b125b6c75c",
                                                "sense_id": "1b4d1154-d8e4-3f01-b659-83469c8a0064",
                                                "text": "„Die französischen und malischen Truppen im Norden Malis erzielen erste größere Erfolge.“"
                                            },
                                            {
                                                "example_id": "42a532e3-f49d-46cd-bdb7-7b53ba6b2252",
                                                "sense_id": "1b4d1154-d8e4-3f01-b659-83469c8a0064",
                                                "text": "„Im Jahr 2013 konnte eine Allianz aus französischen und malischen Soldaten die Terroristen zurückdrängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84530e1c-15a5-4e12-bff0-b7fc0038caa2",
                        "source_entry_id": "45905d05-0544-33c2-bfa3-f513815126cb",
                        "source_sense_id": "79e95ddc-a615-3d50-9485-4660ec037216",
