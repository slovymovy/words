                            {
                                "example_id": "a11e90a2-2872-4c82-b9ef-046a3c5ea33a",
                                "sense_id": "327a7604-965a-3ace-bb8f-52d1b7d326ac",
                                "text": "Dane demograficzne wskazują jednak wyraźnie, iż mamy współcześnie do czynienia z nasileniem się zjawiska bezdzietności w kulturze zachodniej"
