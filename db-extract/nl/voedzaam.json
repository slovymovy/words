                                    },
                                    {
                                        "sense_id": "9f6c021c-73c5-3384-b62c-eb36c1eb1697",
                                        "entry_id": "3500fb40-dfeb-32fa-9664-a788e07534aa",
                                        "glosses": [
                                            "Salutary."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76eccc01-1693-4c83-9879-ab26eb747a0f",
                                                "sense_id": "9f6c021c-73c5-3384-b62c-eb36c1eb1697",
                                                "text": "A cumbrous, circuitous, and often a sophisticative mode of commenting upon the Prophets, and of darkening their meaning, had taken the place of what might have been a nutritious popular instruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2c476fe-d8d5-467e-8cf8-07a5554b7446",
                        "source_entry_id": "85eb1bbd-7934-3897-9259-dd744c7b58a4",
                        "source_sense_id": "9132c5ff-b358-31ba-bd29-1722c7fdafe9",
                        "target_lang_word": "nourrissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nourrissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3aea3b9-644b-3851-a9e9-1693d6f870d4",
                                        "entry_id": "95e24ebc-ac19-34fb-8651-6ced9d2befd1",
                                        "glosses": [
                                            "Qui sustente ; qui nourrit beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9822dd9-3cd4-4391-85c0-8be1a0f8b93f",
                                                "sense_id": "f3aea3b9-644b-3851-a9e9-1693d6f870d4",
                                                "text": "La farine de blé, la plus riche en gluten, est celle qui donne le pain le plus nourrissant."
                                            },
                                            {
                                                "example_id": "789064e7-d97a-468b-8fee-b399fb997777",
                                                "sense_id": "f3aea3b9-644b-3851-a9e9-1693d6f870d4",
                                                "text": "Au mois du Ramadan, le jeûne quotidien est rompu avec une soupe nourrissante. L’harira remplit bien cette fonction, elle réunit légumineuses, légumes et céréale. Elle peut aussi contenir de la viande."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nourrissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43303a6a-0fca-358d-8f8f-d45f94639c4e",
                                        "entry_id": "694a5b6d-fc87-3f8b-a2e9-a5af92e2491d",
                                        "glosses": [
                                            "Participe présent de nourrir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4139698-8c80-4630-b4b7-a53f2cfe25a6",
                                                "sense_id": "43303a6a-0fca-358d-8f8f-d45f94639c4e",
                                                "text": "Un moucherolle paradisiaque indien mâle assume le rôle des deux parents en nourrissant ses poussins de seulement quatre jours après la mort de leur mère."
                                            },
                                            {
                                                "example_id": "f6dc3606-85c6-4ebc-925b-11fa2dc0429f",
                                                "sense_id": "43303a6a-0fca-358d-8f8f-d45f94639c4e",
                                                "text": "On a bien sûr réduit au minimum toutes les fonctions organiques, le corps ne se nourrissant, au fil de son évolution minute, que des éléments ultranutritifs autorégénérateurs qu’on lui a fournis dans l’utérus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
