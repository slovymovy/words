                        "glosses": [
                            "van iets of iemand die door ondervragen een onderzoek doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9669290-6abc-4e23-bad4-28db561ba9b1",
                                "sense_id": "a6f21aea-2ed7-3f96-97ee-49735a364fbc",
                                "text": "We kunnen bijvoorbeeld rogatoire commissies naar ginds sturen en de man daar op de rooster te leggen."
                            },
                            {
                                "example_id": "28fbda70-0d55-441f-a274-2b225a4c9ceb",
                                "sense_id": "a6f21aea-2ed7-3f96-97ee-49735a364fbc",
                                "text": "Omdat de antwoorden in India te zoeken zijn, wou de Antwerpse onderzoeksrechter met een rogatoire commissie naar India gaan. Ruim twee jaar na de feiten is die nog niet vertrokken. De Indiase autoriteiten hebben het licht nog niet op groen gezet, ondanks demarches van de Belgische ambassade."
                            }
                        ]
