                        ],
                        "examples": [
                            {
                                "example_id": "23792fc6-7452-4fab-8539-d92ca4e51297",
                                "sense_id": "f80cd0f6-da07-33bf-8734-c92d673bdb1b",
                                "text": "„[…] nur dass darunter wohl Fälle von sehr mangelhafter Entwickelung der seitlichen Lippentheile wirklicher Acheilia mitbegriffen sind.“"
                            },
                            {
                                "example_id": "b779f267-dddd-4601-b57b-4e1493621295",
                                "sense_id": "f80cd0f6-da07-33bf-8734-c92d673bdb1b",
                                "text": "„Unter allen Formfehlern der Lippen zeigt dieser Fehler, der Lippenmangel, Acheilia, die größten Verschiedenheiten, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
