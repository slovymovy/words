            "senses": [
                {
                    "sense_id": "33d94d35-44c6-3d4c-9e48-442ca8b7e621",
                    "sense_definition": "present participle and gerund of <w>juxtapose</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "juxtaposing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist created a striking effect by <w>juxtaposing</w> ancient sculptures with modern street art.",
                            "target_lang_translations": {
                                "de": "Der Künstler erzeugte eine bemerkenswerte Wirkung, indem er antike Skulpturen moderner Streetart <w>gegenüberstellte</w>."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>juxtaposing</w> different fabrics to see which colors matched best.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte den Nachmittag damit, verschiedene Stoffe <w>nebeneinanderzulegen</w>, um zu sehen, welche Farben am besten zusammenpassten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "juxtaposing contrasting elements",
                        "juxtaposing past and present"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von juxtapose; zwei oder mehr Dinge nebeneinanderstellen oder gegenüberstellen, meist um einen Kontrast oder Vergleich zu verdeutlichen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gegenüberstellend",
                                "target_lang_sense_clarification": "im Vergleich oder Kontrast nebeneinanderstellend"
                            },
                            {
                                "target_lang_word": "nebeneinanderstellend",
                                "target_lang_sense_clarification": "direkt nebeneinander platziert"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea645567-9ff1-3106-88f2-a488fcb59193",
                    "sense_definition": "An act of placing two or more things side by side, especially for comparison or contrast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juxtaposing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her careful <w>juxtaposing</w> of light and shadow gave the painting an unexpected depth.",
                            "target_lang_translations": {
                                "de": "Ihre sorgfältige <w>Gegenüberstellung</w> von Licht und Schatten verlieh dem Gemälde eine unerwartete Tiefe."
                            }
                        },
                        {
                            "text": "The critic noted that such deliberate <w>juxtaposings</w> served to highlight the novel's central theme.",
                            "target_lang_translations": {
                                "de": "Der Kritiker bemerkte, dass derart bewusste <w>Gegenüberstellungen</w> dazu dienten, das zentrale Thema des Romans hervorzuheben."
                            }
                        }
                    ],
                    "synonyms": [
                        "juxtaposition",
                        "collocation"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Vorgang des Nebeneinanderstellens oder Gegenüberstellens von zwei oder mehr Dingen, insbesondere zum Vergleich oder zur Kontrastierung"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Gegenüberstellung",
                                "target_lang_sense_clarification": "Vergleich oder Kontrastierung"
                            },
                            {
                                "target_lang_word": "das Nebeneinanderstellen",
                                "target_lang_sense_clarification": "räumliches oder thematisches Nebeneinander"
                            },
                            {
                                "target_lang_word": "die Juxtaposition",
                                "target_lang_sense_clarification": "Fachbegriff für Nebeneinanderstellung"
                            }
                        ]
