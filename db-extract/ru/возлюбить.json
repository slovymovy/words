                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13050f6d-8435-4aa0-86e5-dd67377a143b",
                                                "sense_id": "d7adc016-656f-3999-9f25-5b69c9f90ba6",
                                                "text": "Ich liebe dich."
                                            },
                                            {
                                                "example_id": "0acc495e-2f7d-4d3a-9862-4e8f7593c231",
                                                "sense_id": "d7adc016-656f-3999-9f25-5b69c9f90ba6",
                                                "text": "Sie lieben Nudeln, sie essen sie dreimal die Woche."
                                            }
