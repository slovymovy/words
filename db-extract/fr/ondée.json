                ],
                "senses": [
                    {
                        "sense_id": "420fad60-9097-32ec-90b2-48bfccd52d96",
                        "entry_id": "272b6b91-e89a-3de4-9606-3c4678ccc3fd",
                        "glosses": [
                            "Féminin singulier de ondé."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4687c1d6-34cd-40b4-8586-23df6e0760e4",
                                "sense_id": "420fad60-9097-32ec-90b2-48bfccd52d96",
                                "text": "Sur la rue, la maison présentait cette façade de moellons ravalée en plâtre, ondée par le temps et rayée par le crochet du maçon de manière à figurer des pierres de taille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                "word": "ondée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df316090-3887-4566-8293-7efacf843999",
                        "entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "ondées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                        "entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "glosses": [
                            "Pluie qui vient tout à coup et qui ne dure pas longtemps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6c70d6-5577-462a-92cd-e289b1e746f2",
                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                            },
                            {
                                "example_id": "6b94fc84-f5be-4dab-b244-932b96b24239",
                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                "text": "Vers midi et demi, nous tirons le déjeuner des sacs, au café de la Bagnolle. La fin du séjour est marquée par une violente ondée qui vide les terrasses !"
                            },
                            {
                                "example_id": "a3c68660-8b07-4c42-8e2e-74361700956a",
                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                "text": "Le ciel aujourd’hui avait fait son devoir : lorsque monsieur de Chateaudun parut, l’ondée cludienne avait sensiblement modifié la forme de son chapeau, la teinte de son veston, le pli de son pantalon."
                            },
                            {
                                "example_id": "ad0b8898-af0b-4c71-80d7-5944d0e0e4cf",
                                "sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                                "text": "Quand il fait sec, Diphylleia grayi, qui pousse sur les flancs de montagnes des régions les plus froides du Japon, arbore des pétales blancs tout ce qu’il y a de plus commun. Mais qu’une ondée l’arrose et ces derniers deviennent alors totalement transparents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b60ce045-2f3a-46c0-877b-ba14f87fcb26",
                        "source_entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "source_sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                        "target_lang_word": "Wasserguss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9edf918e-3b45-455a-97f0-00591bcdf4dd",
                        "source_entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "source_sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                        "target_lang_word": "Regenschauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenschauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                        "entry_id": "46b5d5fb-f93b-36c6-a182-489581f7c323",
                                        "glosses": [
                                            "kurzer Regenguss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24816e0e-1e28-4d81-9fe1-a31c0e16ec76",
                                                "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                                "text": "Beim Aufstieg auf den Brocken überraschte uns ein Regenschauer."
                                            },
                                            {
                                                "example_id": "47c0a659-6e68-4bf8-8116-c23280d5fb83",
                                                "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                                "text": "„Das Wetter war weiterhin bedeckt und Regenschauer zwangen uns zu häufigem Anhalten.“"
                                            },
                                            {
                                                "example_id": "cbbe7646-2900-4735-986b-2ccf1bb28f77",
                                                "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                                "text": "„Regenschauer ziehen vorbei.“"
                                            },
                                            {
                                                "example_id": "0c01dea3-cbae-4ac0-929d-3b78e3c30ac4",
                                                "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                                "text": "„Der Regenschauer wurde von einem heftigen Wind begleitet, der an Zeltleinen zerrte und Kleidungsstücke, Rennkarten und Klopapierfetzen durch das Camp wirbelte.“"
                                            },
                                            {
                                                "example_id": "f21f40ce-45f8-4c93-b2a0-84f70a0095d6",
                                                "sense_id": "3d0df221-99e2-3143-8b9b-9d2ac90ae6ef",
                                                "text": "„Es war ein Tag mit Sonne, Regenschauern, Wind und plötzlicher Stille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e02791b0-9dbe-476e-b2f3-0b8c1f94fad8",
                        "source_entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "source_sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
                        "target_lang_word": "Niederschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niederschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                        "entry_id": "bb5d5d0e-14ec-3dc4-a4d3-c67c44915138",
                                        "glosses": [
                                            "das infolge des Erreichen des Taupunktes auf den Boden fallende Wasser in Form von Regentropfen, Schneeflocken, Tau, Nebel, Raureif, Hagel oder Graupel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120a8205-d330-4456-9aa2-f63a37383a24",
                                                "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                                "text": "Täglich wird mehrmals die Menge des Niederschlags bestimmt."
                                            },
                                            {
                                                "example_id": "c79fde62-8cef-41f1-a6ac-f256867daa00",
                                                "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                                "text": "„Der Himmel hängt grau und tief und wird weitere Niederschläge bringen.“"
                                            },
                                            {
                                                "example_id": "b65008b9-ac81-4811-977a-5839f113d741",
                                                "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                                "text": "„Mit rund 67 Liter Niederschlag pro Quadratmeter erreichte der Januar 2023 knapp zehn Prozent mehr Niederschlag als die Referenzperiode.“"
                                            },
                                            {
                                                "example_id": "b2973fc7-f0ab-4c51-ac42-899e6be8658d",
                                                "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                                "text": "„Die teils ergiebigen Niederschläge im Januar entspannten die Situation in weiten Teilen Deutschlands nach der Trockenheit des vergangenen Sommers.“"
                                            },
                                            {
                                                "example_id": "5c539b07-76a9-4324-861f-ffecad684226",
                                                "sense_id": "4353b127-bd6e-366e-88f0-202e21e3b05e",
                                                "text": "„Draußen zog ein Sturm auf, bisher noch ohne Niederschlag, aber laut Wetterbericht war das nur eine Frage der Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27a72730-f192-3646-9fef-c9f614a2f055",
                                        "entry_id": "bb5d5d0e-14ec-3dc4-a4d3-c67c44915138",
                                        "glosses": [
                                            "feste Stoffe, die aus Flüssigkeiten ausfallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b797d028-3dc2-40e0-9321-4cb9b4c230bd",
                                                "sense_id": "27a72730-f192-3646-9fef-c9f614a2f055",
                                                "text": "Auf dem Glasboden setzte sich der Niederschlag ab."
                                            },
                                            {
                                                "example_id": "92af5167-168c-4453-bdf3-4021e12d690c",
                                                "sense_id": "27a72730-f192-3646-9fef-c9f614a2f055",
                                                "text": "„Böttger betrachtet wieder einmal enttäuscht den Niederschlag in der Retorte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eee5e4fe-4556-3a1b-af58-c45baf8d75ef",
                                        "entry_id": "bb5d5d0e-14ec-3dc4-a4d3-c67c44915138",
                                        "glosses": [
                                            "seinen Ausdruck finden, sich wiederfinden lassen in etwas; besonders auch das schriftliche Dokumentieren, Festhalten, Ausdrücken von Informationen"
                                        ],
                                        "tags": [
                                            "meist in Verbindung mit finden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edece58d-d08c-4626-8e12-6d38c10a8531",
                                                "sense_id": "eee5e4fe-4556-3a1b-af58-c45baf8d75ef",
                                                "text": "Alle seine Studien und Bemühungen fanden dann letztendlich auch im Ergebnis ihren Niederschlag."
                                            },
                                            {
                                                "example_id": "3b0c210e-1b2c-469f-bb8e-3def81104706",
                                                "sense_id": "eee5e4fe-4556-3a1b-af58-c45baf8d75ef",
                                                "text": "„Diese Konzeptionen finden großenteils in dem literarischen Erbe Einsteins und in seinen Briefen Niederschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "379e7be0-5e21-3b77-bfe0-d910deeb1ca5",
                                        "entry_id": "bb5d5d0e-14ec-3dc4-a4d3-c67c44915138",
                                        "glosses": [
                                            "Ereignis, das dazu führt, dass man nicht mehr auf seinen Beinen steht; das am Boden Sein, nachdem man niedergeschlagen wurde, auch bildhaft"
                                        ],
                                        "tags": [
                                            "Boxen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9681b47-d314-419f-8d75-31985a0c6ed9",
                                                "sense_id": "379e7be0-5e21-3b77-bfe0-d910deeb1ca5",
                                                "text": "Den Niederschlag in der ersten Runde muss man als peinlichen Ausrutscher deuten, denn Pauli gewann den Kampf klar nach Punkten."
                                            },
                                            {
                                                "example_id": "d6bd3525-b548-44c4-9960-e19fff5d4853",
                                                "sense_id": "379e7be0-5e21-3b77-bfe0-d910deeb1ca5",
                                                "text": "Der nächste Niederschlag erfolgte zu Pfingsten, als ihr Mann verstarb."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634dd1be-d6c5-4e37-9afe-2082b8dc27d8",
                        "source_entry_id": "30b9bd72-5af2-3b56-9e3b-0420cb84a8f0",
                        "source_sense_id": "90776e4f-e11b-3dd9-8698-8b1f978c8aa8",
