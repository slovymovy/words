                            "target_lang_translations": {
                                "en": "The reason for his departure was <w>twofold</w>: he wanted to travel and earn more."
                            }
                        },
                        {
                            "text": "Het doel van deze cursus is <w>tweeledig</w> namelijk taalverwerving en cultuurkennis.",
                            "target_lang_translations": {
                                "en": "The goal of this course is <w>dual</w>, namely language acquisition and cultural knowledge."
                            }
                        }
                    ],
