                "senses": [
                    {
                        "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                        "entry_id": "bb258237-bd48-3b3e-aa4d-08445da04f5e",
                        "glosses": [
                            "Qui a pour but de consoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1cdca7-21bd-4ac3-8fa2-a309630673f7",
                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                "text": "Épître, discours consolatoire."
                            },
                            {
                                "example_id": "a87abc6a-6c30-4c90-9c44-448cf5341e88",
                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                "text": "Après quelques propos consolatoires pour l’allegeance du deuil paternel…"
                            },
                            {
                                "example_id": "108ec4d8-a485-4a33-a23e-e5b494b1b29c",
                                "sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                                "text": "La lettre consolatoire de Plutarque à sa femme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6caaf7e4-1f6b-4e02-b779-6eba763c0010",
                        "source_entry_id": "bb258237-bd48-3b3e-aa4d-08445da04f5e",
                        "source_sense_id": "03dc3716-3e78-357e-a738-cbd970eac8de",
                        "target_lang_word": "consolatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consolatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                        "entry_id": "67f3076b-160c-37c1-8b40-dff67983498f",
                                        "glosses": [
                                            "Which consoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5d7a72-facf-44df-85ee-330fcdcc4567",
                                                "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                                "text": "[…] where in he reporteth of the coragius\nwordes that were moch consolatory […]"
                                            },
                                            {
                                                "example_id": "3a8bc39d-d76e-4f3e-b8de-20e7749de96e",
                                                "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                                "text": "1649, John Donne, Fifty Sermons, London: M.F., J. Marriot and R. Royston, Volume 2, “Sermon XVII. Preached at Lincolns Inne,” p. 140,\nWhere then is the restorative, the consolatory nature of these words? In this, beloved, consists our comfort […]"
                                            },
                                            {
                                                "example_id": "1a9e04ce-4a0c-4b09-a141-64d5cbba450b",
                                                "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                                "text": "The punishment of real tyrants is a noble and awful act of justice; and it has with truth been said to be consolatory to the human mind."
                                            },
                                            {
                                                "example_id": "19380ea8-d2c8-4d92-bdcb-a43ae411142e",
                                                "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                                "text": "“It is singularly reviving after such hurricanes to feel calm return, and from the opening clouds to receive a consolatory gleam, softly testifying that the sun is not quenched.”"
                                            },
                                            {
                                                "example_id": "81b1463b-9ca0-4ddb-bb4b-420e3e9b21f8",
                                                "sense_id": "41cbd265-a21e-3363-bd4a-8cf15caa686d",
                                                "text": "Supper had been eaten, the turkey had been trussed, the children at last persuaded into their beds. That was the consolatory side of family life, Grorley thought—the long, Olympian codas of the emotions were cut short by the niggling detail."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consolatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d417f078-f8ce-3c4f-8f3a-ec47ac8bdd31",
                                        "entry_id": "cf2b7728-8a62-3d71-aa7c-3ac6c8c17516",
                                        "glosses": [
                                            "That which consoles; a speech or writing intended for consolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90260bc-adf8-44b9-9815-55cb5dd40da5",
                                                "sense_id": "d417f078-f8ce-3c4f-8f3a-ec47ac8bdd31",
                                                "text": "1671, John Milton, Samson Agonistes, lines 658-662, in Paradise Regain’d […] to which is added Samson Agonistes, London: John Starkey, pp. 43-44,\nConsolatories writ\nWith studied argument, and much perswasion sought\nLenient of grief and anxious thought,\nBut with' afflicted in his pangs thir sound\nLittle prevails,"
                                            },
                                            {
                                                "example_id": "f39759e5-f4d2-4c84-9aa6-5c1267dbee26",
                                                "sense_id": "d417f078-f8ce-3c4f-8f3a-ec47ac8bdd31",
                                                "text": "How is it possible to imagine, that a woman, who has all these consolatories to reflect upon, will die of a broken heart?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
