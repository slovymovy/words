                    "sense_id": "2f78beef-afaa-3818-a3e8-291847b114db",
                    "sense_definition": "Muisachtig knaagdier uit het geslacht Rattus dat vaak gezien wordt als ongedierte.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat heeft gisteren een grote <w>rat</w> gevangen in de schuur.",
                            "target_lang_translations": {
                                "en": "The cat caught a big <w>rat</w> in the barn yesterday.",
                                "ru": "Вчера кошка поймала в сарае большую <w>крысу</w>.",
                                "pl": "Kot złapał wczoraj w stodole dużego <w>szczura</w>.",
                                "de": "Die Katze hat gestern eine große <w>Ratte</w> in der Scheune gefangen.",
                                "fr": "Le chat a attrapé un gros <w>rat</w> dans la grange hier.",
                                "it": "Il gatto ha catturato ieri un grosso <w>ratto</w> nel fienile.",
                                "cs": "Kočka včera ve stodole chytila velkou <w>krysu</w>.",
                                "tr": "Kedi dün ahırda büyük bir <w>sıçan</w> yakaladı.",
                                "es": "El gato atrapó ayer una <w>rata</w> grande en el granero.",
                                "zh": "猫昨天在谷仓里抓到了一只大<w>老鼠</w>。"
                            }
                        },
                        {
                            "text": "Hij voelde zich als een <w>rat</w> in de val toen hij geen uitweg meer zag.",
                            "target_lang_translations": {
                                "en": "He felt like a <w>rat</w> in a trap when he saw no way out.",
                                "ru": "Он чувствовал себя как <w>крыса</w> в ловушке, когда не видел выхода.",
                                "pl": "Czuł się jak <w>szczur</w> w pułapce, gdy nie widział już żadnego wyjścia.",
                                "de": "Er fühlte sich wie eine <w>Ratte</w> in der Falle, als er keinen Ausweg mehr sah.",
                                "fr": "Il s'est senti comme un <w>rat</w> pris au piège quand il n'a plus vu d'issue.",
                                "it": "Si sentiva come un <w>ratto</w> in trappola quando non ha visto più alcuna via d'uscita.",
                                "cs": "Cítil se jako <w>krysa</w> v pasti, když neviděl žádnou cestu ven.",
                                "tr": "Çıkış yolu bulamadığında kendini kapana kısılmış bir <w>sıçan</w> gibi hissetti.",
                                "es": "Se sintió como una <w>rata</w> atrapada cuando no vio ninguna salida.",
                                "zh": "当他发现无路可走时，感觉自己就像一只落入陷阱的<w>老鼠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "als een rat in de val",
                        "een dode rat"
                    ],
                    "target_lang_definitions": {
                        "en": "A mouse-like rodent of the genus Rattus, often regarded as a pest.",
                        "ru": "Мышеобразный грызун из рода Rattus, часто считающийся вредителем.",
                        "pl": "Gryzoń z rodziny myszowatych, często uważany za szkodnika.",
                        "de": "Ein mausähnliches Nagetier aus der Gattung Rattus, das oft als Schädling betrachtet wird.",
                        "fr": "Rongeur de la famille des Muridae, souvent considéré comme nuisible.",
                        "it": "Roditore simile al topo, appartenente al genere Rattus, spesso considerato un animale nocivo.",
                        "cs": "Hlodavec podobný myši z rodu Rattus, často považovaný za škůdce.",
                        "tr": "Rattus cinsinden, genellikle zararlı olarak görülen fare benzeri kemirgen.",
                        "es": "Roedor de aspecto similar al ratón, del género Rattus, a menudo considerado una plaga.",
                        "zh": "一种属于鼠属的鼠类啮齿动物，常被视为害虫。"
