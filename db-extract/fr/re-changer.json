                "senses": [
                    {
                        "sense_id": "f207aa4c-32ae-36e4-a7f1-bc89cc7b721c",
                        "entry_id": "1a9e89db-0f43-3a8d-bb95-4846076b4e06",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de rechanger (changer à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0a21a9-ef28-428c-a8cd-28c56346dcbb",
                                "sense_id": "f207aa4c-32ae-36e4-a7f1-bc89cc7b721c",
                                "text": "Il y a toujours dans le journalisme et la librairie de Paris des dessous et des variations dont l’exilé ne peut se douter et qui du soir au matin changent, re-changent, décollent, re-collent les situations."
                            },
                            {
                                "example_id": "dab50a66-2292-466d-a72f-dd59f556fa7a",
                                "sense_id": "f207aa4c-32ae-36e4-a7f1-bc89cc7b721c",
                                "text": "Je suppose que ça doit pas être recommandé de changer et re-changer des aimants comme ça."
                            },
                            {
                                "example_id": "09ca983d-222a-4a7a-abc7-b8466b3fef22",
                                "sense_id": "f207aa4c-32ae-36e4-a7f1-bc89cc7b721c",
                                "text": "Bien sûr tu peux changer et re-changer la batterie à chaque fois…"
                            }
                        ]
                    }
