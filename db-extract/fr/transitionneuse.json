                        "entry_id": "69e57053-9307-33ea-a40f-adcae922dc72",
                        "glosses": [
                            "Femme trans qui effectue une transition (sociale, administrative, médicale)."
                        ],
                        "tags": [
                            "Très rare",
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "bff0df9f-487c-4322-92dc-585de384936c",
                                "sense_id": "d697550a-d0e7-3ba3-b182-abaa266c11f4",
                                "text": "En général, et surtout lorsque la « transitionneuse » est jeune, laisser pousser ses cheveux naturels et prendre un traitement hormonal associant un antitestostérone va permettre d’obtenir une chevelure correcte."
                            }
                        ]
                    }
