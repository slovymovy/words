                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c670268-52d6-4035-9f63-5a4a737bec1a",
                                "sense_id": "046b1ccd-f9e5-3c6d-82c6-457303d2e5c5",
                                "text": "Dans cette saga, Alain Mercier nous offre les biographies simultanées du footballeur Zacharie, du tennisman Yannick et du basketteur Joakim."
                            },
                            {
                                "example_id": "f7abca0b-6b96-4353-8954-483ea87d8742",
                                "sense_id": "046b1ccd-f9e5-3c6d-82c6-457303d2e5c5",
                                "text": "Parmi les lauréats du prix Nobel de physique, décerné mardi, se trouve le Français Alain Aspect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7c53252-4e55-4f28-a455-908864ab4152",
                        "source_entry_id": "001d42fa-7ae0-34c0-9c6d-fb7eaff7516a",
                        "source_sense_id": "046b1ccd-f9e5-3c6d-82c6-457303d2e5c5",
                        "target_lang_word": "Alan",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
