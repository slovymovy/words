                    {
                        "sense_id": "31fcf1c7-0804-3cb8-b36e-dcad5abcfc34",
                        "entry_id": "c343bd02-f6e4-3e9c-aec6-c394955bc25e",
                        "glosses": [
                            "Qui a les caractéristiques d'une néoptile.→ voir néoptile#fr-nom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bfd38fc-e39b-4f3e-a93e-d6264e7e98cb",
                                "sense_id": "31fcf1c7-0804-3cb8-b36e-dcad5abcfc34",
                                "text": "Tout comme les plumes trichoptiles, les plumes néoptiles, i.e. le duvet des oiseaux nouveaux-nés, sont néonatales, mais les plumes trichoptiles ne sont pas pour autant des plumes néoptiles: ces dernières originent de cellules souches clairement différentes de celles dont proviennent les plumes trichoptiles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ba89491-4ed9-4243-9abb-fb5dba00cd0c",
                        "source_entry_id": "c343bd02-f6e4-3e9c-aec6-c394955bc25e",
                        "source_sense_id": "31fcf1c7-0804-3cb8-b36e-dcad5abcfc34",
                        "target_lang_word": "neoptile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoptile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f01e67-93bb-391b-8cd9-d01b5f81dee0",
                                        "entry_id": "5c6c0335-209d-35c7-b4b0-876707315178",
                                        "glosses": [
                                            "The down or light, fluffy feathers on a young bird."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f26a918-81d0-44c3-ac9b-d98004e6433e",
                                                "sense_id": "95f01e67-93bb-391b-8cd9-d01b5f81dee0",
                                                "text": "Newly hatched young are naked and pink, but within a few days a short white down known as the neoptile unfolds from the skin (Kniprath & Stier 2008)."
                                            },
                                            {
                                                "example_id": "5d798ef6-5530-4490-9d19-7e1591f92d17",
                                                "sense_id": "95f01e67-93bb-391b-8cd9-d01b5f81dee0",
                                                "text": "Among the neoptile feathers occur isolated bristle-like filaments, whose origin and function are unclear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "05780328-7442-392a-ab38-1f1d2c3b0be2",
                "word": "néoptile",
                "pos": "noun",
