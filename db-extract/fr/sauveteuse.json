                    {
                        "sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                        "entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "glosses": [
                            "Celle qui prend part à un sauvetage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7cfefc-4a95-4b2e-9623-255426689929",
                                "sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                                "text": "Le port du hijab pourrait s’avérer dangereux pour la personne dans l’eau et pour la sauveteuse, qui pourrait s’étrangler avec le foulard, plaide le YMCA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5adf5ba5-1097-4967-8050-c88d39f07dd0",
                        "source_entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "source_sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                        "target_lang_word": "Retterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
