    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f55f92a6-3c40-3b22-a107-a17c262ea250",
                    "sense_definition": "Чувство печали, лёгкого огорчения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sadness_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В его глазах появилась тихая <w>грусть</w>, когда он вспомнил о доме.",
                            "target_lang_translations": {
                                "en": "A quiet <w>sadness</w> appeared in his eyes when he remembered home."
                            }
                        },
                        {
                            "text": "Осенний дождь всегда навевает на меня лёгкую <w>грусть</w>.",
                            "target_lang_translations": {
                                "en": "Autumn rain always brings a light <w>melancholy</w> over me."
                            }
                        }
                    ],
                    "synonyms": [
                        "уныние",
                        "тоска",
                        "меланхолия"
                    ],
                    "antonyms": [
                        "веселье",
                        "радость"
                    ],
                    "common_phrases": [
                        "лёгкая грусть",
                        "навевать грусть"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of sadness or mild sorrow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sadness",
                                "target_lang_sense_clarification": "the state or emotion of being sad"
                            },
                            {
                                "target_lang_word": "melancholy",
                                "target_lang_sense_clarification": "thoughtful or introspective sadness"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "grief or regret"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dfe3a4c-fd1b-34a7-a0b0-eea8e0b0950e",
                    "sense_definition": "О том, что из-за своих плохих качеств вызывает разочарование, недовольство или низкую оценку.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disappointment_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Качество дорог в этом районе — просто полная <w>грусть</w>.",
                            "target_lang_translations": {
                                "en": "The quality of the roads in this area is just a complete <w>sad state</w>."
                            }
                        },
                        {
                            "text": "Работать с этим ленивым сотрудником — одна <w>грусть</w>.",
                            "target_lang_translations": {
                                "en": "Working with this lazy employee is a total <w>bummer</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "одна грусть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в переносном значении в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used colloquially to describe something that causes disappointment, dissatisfaction, or is of poor quality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sad state",
                                "target_lang_sense_clarification": "a disappointing or poor condition"
                            },
                            {
                                "target_lang_word": "bummer",
                                "target_lang_sense_clarification": "something disappointing or annoying"
                            },
                            {
                                "target_lang_word": "sad story",
                                "target_lang_sense_clarification": "a regrettable or pathetic situation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
