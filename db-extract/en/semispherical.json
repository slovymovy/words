                            {
                                "example_id": "e155538b-7d5b-48d4-9d51-e345dd118102",
                                "sense_id": "0f1e0258-5b03-34d4-86f2-4efd2051b8a5",
                                "text": "The thatched semispherical huts of palm tree leaves and tamarisk were also interesting, as was the windmill, identical with those already seen in Sistan."
                            },
                            {
                                "example_id": "38c12427-5387-43ca-8d68-e244893fdd20",
                                "sense_id": "0f1e0258-5b03-34d4-86f2-4efd2051b8a5",
                                "text": "The acorns, the largest among the oaks, are semispherical with the cups extremely shallow."
                            },
                            {
                                "example_id": "b45001b1-10a6-430c-b044-e26dd48fb74e",
                                "sense_id": "0f1e0258-5b03-34d4-86f2-4efd2051b8a5",
                                "text": "Hence, the fracture surface consists of a periodic array of semispherical bowls."
                            }
                        ]
