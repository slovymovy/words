                                    {
                                        "sense_id": "193fae8e-edd8-38b1-9681-ae047c1e05a1",
                                        "entry_id": "0975c957-ab61-39bf-9549-9ebc8243e58b",
                                        "glosses": [
                                            "ohne Hintergedanken blind vertrauend, nicht gekünstelt und aufrichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840dbca0-c648-43c6-9828-97e3f4d0597c",
                                                "sense_id": "193fae8e-edd8-38b1-9681-ae047c1e05a1",
                                                "text": "Du naiver Dummkopf, glaubst das wirklich?"
                                            },
                                            {
                                                "example_id": "a477f33f-b993-4284-9a32-0738d11adec2",
                                                "sense_id": "193fae8e-edd8-38b1-9681-ae047c1e05a1",
                                                "text": "Es ist schon naiv zu glauben, dass es hier nicht einzigalleine um die Wahrung der eigenen Interessen geht."
                                            },
                                            {
                                                "example_id": "8f0e14ca-7ad8-4c9d-ab50-11c7ed06791f",
                                                "sense_id": "193fae8e-edd8-38b1-9681-ae047c1e05a1",
                                                "text": "Wie kommst du darauf, dass ich so naiv wäre zu glauben, dass es denen um den Erhalt der Dorfgemeinschaft ginge?"
                                            },
                                            {
                                                "example_id": "d2a4cbfd-d09c-4845-99c3-065efd8926cb",
                                                "sense_id": "193fae8e-edd8-38b1-9681-ae047c1e05a1",
                                                "text": "[Zar Nikolaj II.:] „Man sieht im Telegramwechsel, dass Nikolaj ein Idealist, wenn nicht sogar naiv war und nicht realistisch gedacht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8c3884b-cd5f-32ff-be2a-ac887069327f",
                                        "entry_id": "0975c957-ab61-39bf-9549-9ebc8243e58b",
                                        "glosses": [
                                            "über wenig Erfahrung und/oder Sachkenntnis verfügen und daher nicht sehr scharfsinnig erscheinend"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f14afda-80e6-4f64-a6d8-0a63a5fbbe1d",
                                                "sense_id": "d8c3884b-cd5f-32ff-be2a-ac887069327f",
                                                "text": "„Vor dem Hintergrund der damaligen Praxis im internationalen Leistungssport, der intensiven nationalen Doping-Debatte und der verdeckten Dopingforschung in der BRD wäre es naiv anzunehmen, dass die Spieler in der Schweiz lediglich ‚Traubenzucker‘- oder Vitamin C-Injektionen erhalten haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c1a1d26e-735f-39be-8beb-b0a87b344ffa",
                                        "entry_id": "0975c957-ab61-39bf-9549-9ebc8243e58b",
                                        "glosses": [
                                            "gänzlich im Einklang mit der Natur sowie der Wirklichkeit stehend"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
