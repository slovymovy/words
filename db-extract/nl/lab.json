                "senses": [
                    {
                        "sense_id": "9e25967d-0832-370b-b8fd-31c650b51077",
                        "entry_id": "a6169b77-88de-3ce3-a5a3-789583577247",
                        "glosses": [
                            "een ruimte ingericht voor het doen van natuurwetenschappelijk onderzoek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49af7c92-c09a-4c02-aad8-e4d20c1f201e",
                                "sense_id": "9e25967d-0832-370b-b8fd-31c650b51077",
                                "text": "We hebben zowel een TGA als een DSC in ons lab."
                            },
                            {
                                "example_id": "ce071c99-2278-46b1-bde3-f07b776089d0",
                                "sense_id": "9e25967d-0832-370b-b8fd-31c650b51077",
                                "text": "\"Vanuit Delft zitten ze goed in de sommetjes, in Utrecht heb je bijvoorbeeld paleomagnetisme\", omschrijft Hoogendoorn het werkveld. \"En aan de VU zit heel veel systeemkennis. Vooral het lab waarmee de VU bijvoorbeeld sediment dateert is internationaal bekend. Er zijn volgens mij maar drie plekken in de wereld waar ze dat doen. Niet alleen de VU heeft dus een probleem: je haalt er ook internationaal meteen de stekker uit.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "642989d9-b0c4-3d69-acaf-af3a5d5a1ead",
                        "entry_id": "a6169b77-88de-3ce3-a5a3-789583577247",
                        "glosses": [
                            "een cursus gegeven in [1] waarin studenten geleerd wordt labwerk te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d105e0-8d2b-4ac8-b609-5708c4c7fbb2",
                                "sense_id": "642989d9-b0c4-3d69-acaf-af3a5d5a1ead",
                                "text": "In dit lab gaat het voornamelijk om het doen van zinnige metingen en het interpreteren van de resultaten in statistisch significante termen."
                            }
                        ]
                    },
                    {
                        "sense_id": "841a2b35-0519-3278-a122-71934a0fa598",
                        "entry_id": "a6169b77-88de-3ce3-a5a3-789583577247",
                        "glosses": [
                            "een gebouw waarin ruimtes zoals [1] gehuisvest zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da2098e-af88-4e2e-b1d4-6d4bb4da5457",
                                "sense_id": "841a2b35-0519-3278-a122-71934a0fa598",
                                "text": "Naast het wiskundegebouw staat een chemisch lab."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf7b8f2d-f427-40bc-b1d4-a2a3aa307cf4",
                        "source_entry_id": "a6169b77-88de-3ce3-a5a3-789583577247",
                        "source_sense_id": "9e25967d-0832-370b-b8fd-31c650b51077",
                        "source_sense_description": "een ruimte ingericht voor het doen van natuurwetenschappelijk onderzoek",
                        "target_lang_word": "Labor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                        "entry_id": "20f13d8c-79b8-30ca-bfcc-57b11d47e85c",
                                        "glosses": [
                                            "Räumlichkeit oder Einrichtung, in der wissenschaftliche, technische und medizinische Untersuchungen, Analysen und Versuche durchgeführt werden"
                                        ],
                                        "tags": [
                                            "Forschung",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54de3424-b3c5-4b7a-af42-c9b8fcf6eaa8",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "Die Arbeit im Labor war erfolgreich."
                                            },
                                            {
                                                "example_id": "ca60989b-5971-4b95-ae39-f0b309bdad0b",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Das Laboratorium ist kein modernes Labor aus Glas, mit Sauberkeit, Helle und Luft, es ist ein Spelunkenwinkel eines tüterigen Erfinders, der in einem Wust von Geräten, Ideen, Schutt und Schmutz ertrinkt.“"
                                            },
                                            {
                                                "example_id": "175e1019-5ff1-4292-aa60-d1f88e0dcc93",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Das Labor wurde zum Reinraum deklariert, der nur in kompletter Vermummung betreten werden durfte.“"
                                            },
                                            {
                                                "example_id": "fc1bfc6a-c446-4e3e-a77d-091e52749de9",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Thomas wanderte in die Küche zurück, um nach seinem Süppchen zu sehen, schnitt das Entenfleisch in Stücke und wanderte zurück ins Labor, um nach seinen Barren zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6856c13b-b94e-497f-a087-36a5ed8fd81b",
                        "source_entry_id": "a6169b77-88de-3ce3-a5a3-789583577247",
                        "source_sense_id": "9e25967d-0832-370b-b8fd-31c650b51077",
                        "source_sense_description": "een ruimte ingericht voor het doen van natuurwetenschappelijk onderzoek",
                        "target_lang_word": "Laboratorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laboratorium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                        "entry_id": "4ccc94d3-3451-30b6-9efa-7ec2300c8eb6",
                                        "glosses": [
                                            "Ort, an dem wissenschaftliche Untersuchungen, Analysen und Versuche durchgeführt werden"
                                        ],
                                        "tags": [
                                            "Forschung",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31e87930-3cac-4bda-b928-3774b5af20f2",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "Für chemische Experimente braucht man ein Laboratorium."
                                            },
                                            {
                                                "example_id": "073f013f-90da-4670-8db8-e3388424d9c0",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "„Man empfand es als Glück, daß Hund an diesem Tag nicht im Laboratorium war.“"
                                            },
                                            {
                                                "example_id": "96abe977-7ca6-47ac-be6c-1f4a335cd96c",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "„Das Laboratorium ist kein modernes Labor aus Glas, mit Sauberkeit, Helle und Luft, es ist ein Spelunkenwinkel eines tüterigen Erfinders, der in einem Wust von Geräten, Ideen, Schutt und Schmutz ertrinkt.“"
                                            },
                                            {
                                                "example_id": "b0349e85-8a75-4d8e-aedb-854d633398f2",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "„Wegen dieser Halskrankheit mußte sich Rotermund jeden Tag zu Untersuchungen in der Universitätsklinik und in verschiedenen Laboratorien einfinden.“"
                                            },
                                            {
                                                "example_id": "edbdcd01-2fd8-4528-bd4e-53edfad06c5c",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "„Anscheinend hatte man diese Dachkammer als chemisches Laboratorium eingerichtet.“"
                                            },
                                            {
                                                "example_id": "e860b133-2242-4ab0-809c-2248f149c39c",
                                                "sense_id": "310fc998-6745-32e9-855b-2a9a30eedf6b",
                                                "text": "„Dahinter fand ich, was allem Anschein nach das Laboratorium eines Alchemisten war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
