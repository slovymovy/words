                        "entry_id": "bc39381d-ec12-3f1c-8cf7-ed88e6c8fd49",
                        "glosses": [
                            "Partie postérieure d’un temple, et en particulier une salle où n’entrait pas le public."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e0f1d3d1-ea43-4080-9d34-75058389db99",
                                "sense_id": "0559a274-37e5-3d9e-ab28-c1793a633c13",
                                "text": "Le trésor d’Athènes était déposé dans l’opisthodome du Parthénon."
                            },
                            {
                                "example_id": "13900f8d-b550-4903-960b-65b2af077e45",
                                "sense_id": "0559a274-37e5-3d9e-ab28-c1793a633c13",
                                "text": "On pense à une statue, mais pas à une quelconque statue votive : à l’opisthodome, on n’est pas à l’intérieur des murs du temple, mais on est encore dans le temple."
                            }
                        ]
                    }
                ],
