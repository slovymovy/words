                "translations": [
                    {
                        "translation_id": "cde22ea4-c970-409a-b83e-6d4b6488fbe4",
                        "source_entry_id": "4ec7582a-3c2c-36e8-85a1-5b5f6702b755",
                        "source_sense_description": "embarking",
                        "target_lang_word": "embarquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embarquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9dee0d-bc40-32ae-8e0a-d1869910e3e5",
                                        "entry_id": "9a51efb4-ee1f-31b1-9966-0e90f1000032",
                                        "glosses": [
                                            "Action de s’embarquer, ou d’embarquer quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc49ff4c-e469-443c-ac8e-646f4292216e",
                                                "sense_id": "bc9dee0d-bc40-32ae-8e0a-d1869910e3e5",
                                                "text": "Le lendemain, si la mer se calmait, on achèverait l’embarquement."
                                            },
                                            {
                                                "example_id": "620147fe-2d90-45c2-8f07-377fe32ab42c",
                                                "sense_id": "bc9dee0d-bc40-32ae-8e0a-d1869910e3e5",
                                                "text": "L’embarquement et le débarquement s’opèrent à l’aide de barcasses d’un faible tirant d’eau, pouvant pénétrer dans une petite anse où les vagues viennent mourir au pied même des murs de la ville."
                                            },
                                            {
                                                "example_id": "7a168479-7f3e-4c30-8d06-b52085fa289b",
                                                "sense_id": "bc9dee0d-bc40-32ae-8e0a-d1869910e3e5",
                                                "text": "Ah ! c’était curieux à voir, l’embarquement de Dieudonné pour Rio de Janeiro, c’est moi qui vous le dis ! Ce fut un évènement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89b5cebe-a148-4413-86a9-fc10c033d7f8",
                        "source_entry_id": "4ec7582a-3c2c-36e8-85a1-5b5f6702b755",
                        "source_sense_description": "embarking",
                        "target_lang_word": "Einschiffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschiffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d17f22e9-23aa-328e-a597-4e7dfb5af515",
                                        "entry_id": "750a9b42-5c47-310f-99e7-e0e6eba6c184",
                                        "glosses": [
                                            "das Verbringen/Einladen/Einsteigen von Personen oder Gegenständen auf ein Schiff, das bald eine Fahrt beginnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd6ddd5-8d2d-4d4b-8c46-c65a76be790e",
                                                "sense_id": "d17f22e9-23aa-328e-a597-4e7dfb5af515",
                                                "text": "„Seit Beginn der Einschiffung waren vier Säuglinge geboren worden, »lauter Bengels«, wie ich zu hören bekam.“"
                                            },
                                            {
                                                "example_id": "f540cfdc-1e3c-4382-91f4-49dbc4b999dc",
                                                "sense_id": "d17f22e9-23aa-328e-a597-4e7dfb5af515",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "8ef9b515-b987-47c3-b44d-35476949cb3e",
                                                "sense_id": "d17f22e9-23aa-328e-a597-4e7dfb5af515",
                                                "text": "„Den Aufenthalt im Gefängnis betrachtete er als kleinen, wohlverdienten Erholungsurlaub vor der Einschiffung nach Südamerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f72686ce-62ef-4421-a50f-56d9d7685bed",
                        "source_entry_id": "4ec7582a-3c2c-36e8-85a1-5b5f6702b755",
                        "source_sense_description": "embarking",
                        "target_lang_word": "ambarkacja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e79d175b-ceb6-487e-92cd-b1f56b136ca7",
                        "source_entry_id": "4ec7582a-3c2c-36e8-85a1-5b5f6702b755",
                        "source_sense_description": "embarking",
                        "target_lang_word": "поса́дка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поса́дка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "549e1297-e579-318f-a283-9b5c77263656",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "действие по значению гл. сажать, посадить; размещение саженцев, семян и т. п. в земле с целью выращивания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564adc17-9c86-4561-91e9-d7f1a4d45e86",
                                                "sense_id": "549e1297-e579-318f-a283-9b5c77263656",
                                                "text": "Я работаю от утра до ночи. Все прививки я делаю сам, обрезку — сам, посадки — сам, всё — сам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcbf448-b0c4-3dc2-8069-b3382d96a546",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "результат такого действия; посаженные деревья, растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a9180c-e8f1-4e7f-8f66-980fd7a44c57",
                                                "sense_id": "efcbf448-b0c4-3dc2-8069-b3382d96a546",
                                                "text": "Зеленела трава, зеленели посадки в оголённых ещё огородах, и всё было так углублено в себя, так занято собою, так глубоко погружено в молчаливую творческую думу, что, если бы у травы и у деревьев было лицо, все лица были бы обращены к земле, все лица были бы задумчивы и чужды, все уста были бы скованы огромным бездонным молчанием."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e0f26a-b45e-31a1-a0f4-48e166626c84",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "впуск пассажиров в вагон поезда, в самолёт и т. п. для занятия мест"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24bfa09d-c10a-42c8-a733-b9bf514ca555",
                                                "sense_id": "81e0f26a-b45e-31a1-a0f4-48e166626c84",
                                                "text": "При посадке на авиарейс в Калгари устройство, призванное определять наличие металлических предметов у пассажиров, постоянно звенело, когда она проходила через него."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "спуск на землю, приземление (о летательных аппаратах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829a1c34-9283-4598-954e-33d5b0b1124c",
                                                "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                                "text": "На беду, мотор закапризничал, и мы сделали вынужденную посадку."
                                            },
                                            {
                                                "example_id": "0ea27795-c1f0-4998-a00a-c99e981ed90d",
                                                "sense_id": "132fca53-64db-3cc2-906c-fb7ac0c5dbda",
                                                "text": "На московском аэродроме совершил посадку шестиместный пассажирский самолёт, прилетевший из Крыма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "манера или способ держаться в седле при езде верхом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c15db0f-fc88-4e48-aa46-a6181df5b3f6",
                                                "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                                "text": "Я долго изучал горскую посадку: ничем нельзя так польстить моему самолюбию, как признавая моё искусство в верховой езде на кавказский лад."
                                            },
                                            {
                                                "example_id": "bcfeba5d-2097-4b49-99cb-440d9b91e01f",
                                                "sense_id": "36170346-3f16-32cb-8fc6-e78a23a0442f",
                                                "text": "Красивая голова её с выбившимися чёрными волосами из-под высокой шляпы, её полные плечи, тонкая талия в чёрной амазонке и вся спокойная грациозная посадка поразили Долли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9000ef9b-7322-3d4c-8d34-ffcf288ea33b",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "истор., ирон. лишение свободы, тюремное заключение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cae05e0-6beb-43b7-bb3a-dfa108d406af",
                                                "sense_id": "9000ef9b-7322-3d4c-8d34-ffcf288ea33b",
                                                "text": "Поступив на работу в Марфино и узнав, что Рубин, бывший коммунист, всюду похваляется, что остался им в душе, несмотря на посадку, — Мышин вызвал его на беседу о жизни вообще и о совместной работе в частности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbde5c9e-00d4-3c7f-824c-cab9f075b6db",
                                        "entry_id": "0e7ba85c-1109-3570-a768-269f77d180b1",
                                        "glosses": [
                                            "техн. соотношение между размерами деталей, обеспечивающее их соединение с натягом (внутренняя больше) или с зазором (внутренняя меньше)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
