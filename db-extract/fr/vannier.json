                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce3be85-7058-4d59-b121-249551e652b0",
                                "sense_id": "8a502ed4-6e93-3ea6-9971-06c13223deb3",
                                "text": "On sent qu’il aime dribbler, mais il en surjoue parfois, estime Pierre Vannier-Simon."
                            },
                            {
                                "example_id": "944d818e-4b58-47ba-acdf-7ee0b7c80e34",
                                "sense_id": "8a502ed4-6e93-3ea6-9971-06c13223deb3",
                                "text": "Paul Vannier affirme sur X (anciennement Twitter) que « 12 milliards d’euros d’argent public financent l’école chaque année »."
                            }
                        ]
                    }
