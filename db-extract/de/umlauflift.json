                ],
                "senses": [
                    {
                        "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                        "entry_id": "e89ca184-7088-322a-a427-b543b1803fad",
                        "glosses": [
                            "ein Lift, eine Seilbahn oder ein Aufzug, der ein endloses, dauernd umlaufendes Fördermittel (Seil, Kette) hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780dac6d-5c5f-4286-90ed-b4020b7b7405",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Weiters entstand ein Umlauflift für die übenden Soldaten in der Näher zur Winterleiten-Hütte.“"
                            },
                            {
                                "example_id": "621f7898-11d6-4e45-8e80-fbca4cfc7231",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„1979: Erneuerung des Pendelliftes auf einen Stemag Umlauflift“"
                            },
                            {
                                "example_id": "9e3700ad-134e-4a25-91bd-83e416d87068",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„1961 Bau des ersten Pendlerliftes und in den Jahren 1965 bis 1968 entstanden die beiden Umlauflifte mit einer Kapazität von 1300 Personen pro Stunde.“"
                            },
                            {
                                "example_id": "908f2361-24bd-4f6e-a11e-325be2d7efff",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Der rüstige Mann bediente seinerzeit den ersten Schlepplift, den einer seiner fünf Brüder aufgestellt hatte. Der 300 Meter lange Umlauflift ist längst Geschichte.“"
                            },
                            {
                                "example_id": "6577c4be-0bb6-4a23-be81-5f30f5b7b7cb",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„1961: Ein Pendellift wird für Schifahrer gebaut. 1962: Aufgrund des enormen Zustromes an Schifahrern wird der erste Umlauflift im Bezirk errichtet.“"
                            },
                            {
                                "example_id": "1fce9265-e916-4155-996b-4d2a89f4acab",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„1938 wurde der erste Umlauflift mit Einfachbügel in Zürs am Arlberg in Betrieb genommen.“"
                            },
                            {
                                "example_id": "32febffb-59b7-4b06-a334-f5d3fb057bca",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„So entstand 1958 der 1. Pendel-Schilift der Weststeiermark, dem 1961 der 1. Umlauflift folgte.“"
                            },
                            {
                                "example_id": "ac0538ff-1737-4a63-aec9-126710402a71",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Der Umlauflift wurde von der Firma Leitner in Sterzing/Südtirol nach dem neuesten Stand der Technik angefertigt. Der Schlepplift hatte eine Länge von 300 m und konnte in der Stunde 920 Personen befördern.“"
                            },
                            {
                                "example_id": "6a2abd42-9227-488e-80c8-7d20cc224941",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Zu den Ski-Anlagen gehören zwei Sessellifte und sechs stationäre Umlauflifte sowie mehrere mobile Schlepplifte.“"
                            },
                            {
                                "example_id": "0fd2c8d3-fc32-4d85-9067-2b79198d8123",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„1985: Ersetzung des ausgedienten Pendelliftes auf dem Bründlberg durch einen Umlauflift (Tellerlift).“"
                            },
                            {
                                "example_id": "c08d0cf0-b093-4171-9fc8-f1e0d60d61cd",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Aus Naturschutzgründen wurden hier keine Schleppankerlifte installiert, sondern so genannte Umlauflifte mit Mitnehmerbügel. Dadurch entfallen die störenden Liftmasten.“"
                            },
                            {
                                "example_id": "b94885b8-dfad-44a0-87da-b5c7cac8d8bc",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Sie besteht aus einem endlosen Doppelstahlseil, das etwa acht Meter über der Wasseroberfläche lokalisiert ist. An diesem Umlauflift befindet sich etwa alle 80 Meter ein Bügel-Paar, der sogenannte Mitnehmer.“"
                            },
                            {
                                "example_id": "826187c5-3504-4b1c-b86c-e79320f5323d",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Die 45 Jahre alte rote Gondelbahn soll durch einen Umlauflift ersetzt werden.“"
                            },
                            {
                                "example_id": "e39ba351-9bf4-4c4b-9d16-3b75bfcb3256",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Er [Paternoster im Haus der Industrie] wurde 1911 von Kaiser Franz Joseph eröffnet und ist einer der letzten beiden Umlauflifte in Wien, die noch im Originalzustand erhalten sind.“"
                            },
                            {
                                "example_id": "3e144ced-c253-49fe-b753-8c3e68199c1d",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„So wird beispielsweise der Umlauflift im Haus der Industrie am Schwarzenbergplatz ständig überprüft, ebenso im Wiener Rathaus.“"
                            },
                            {
                                "example_id": "4f3dd9bb-d945-4924-a540-cdf261390b03",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Denn das Einsteigen in den alten Umlauflift im NIG der Uni Wien sorgte auch bei routinierten Paternosterfahrern bisweilen für Nervosität.“"
                            },
                            {
                                "example_id": "668be4a1-060c-42e1-92e0-33b59dafc8e5",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Das Lager für Kleinteile erstreckt sich nun über zwei Etagen und ist mit einem Umlauflift ausgerüstet.“"
                            },
                            {
                                "example_id": "68fbcc0e-7224-4838-881b-52647b74a469",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„Herzstück der neuen, über 13 Meter hohen Halle sind das Kleinteile-Lager mit Umlauflift sowie die Kragarm-Regale.“"
                            },
                            {
                                "example_id": "e8ddd804-dfac-40c8-adf8-6faafd67d1b5",
                                "sense_id": "67e29c0f-202f-3253-b009-dfacb8369220",
                                "text": "„In den Nachschub von Produktionslinien integrierte Umlauflifte scheinen für Elektronikhersteller, die mit Surface Mounted Devices (SMD) arbeiten, eine ausgesprochene Erfolgsgeschichte zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
