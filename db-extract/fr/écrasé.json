                                        "glosses": [
                                            "Made flat by something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85408bb6-78dc-4375-bfc9-0e4e68620c58",
                                                "sense_id": "32b2b634-e702-3ea3-890b-c10c1aecf807",
                                                "text": "We removed the fallen tree from the flattened car."
                                            },
                                            {
                                                "example_id": "7bcdeefb-330e-4645-aa85-e161a01bb949",
                                                "sense_id": "32b2b634-e702-3ea3-890b-c10c1aecf807",
                                                "text": "Fibreglass mouldings form the domed roof at the driving ends and the drop roof of the motor coach, which joins the elliptical section of the flattened portion under the pantograph."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
