                                        "examples": [
                                            {
                                                "example_id": "bb2de36e-6340-45bd-a23b-c92a1008c5ce",
                                                "sense_id": "aca5db1b-6e1e-3084-b899-1d7383303ee9",
                                                "text": "Meine Bowle ist beim letzten Fest zu Bruch gegangen."
                                            }
