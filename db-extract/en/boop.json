            {
                "entry_id": "27a99762-89c4-3a8d-898c-15eccdacf74d",
                "word": "boop",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d61f068-e738-4ef2-aa77-23df259be879",
