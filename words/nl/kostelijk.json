                        {
                            "text": "Zij bezaten vele <w>kostelijke</w> schatten die van generatie op generatie waren doorgegeven.",
                            "target_lang_translations": {
                                "fr": "Ils possédaient de nombreux trésors <w>inestimables</w> transmis de génération en génération."
                            }
                        }
                    ],
                    "synonyms": [
                        "kostbaar",
                        "waardevol"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in hedendaags Nederlands wordt meestal 'kostbaar' of 'waardevol' gebruikt"
