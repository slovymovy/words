                "senses": [
                    {
                        "sense_id": "89b67868-c636-39bc-b73b-c3331817c5b5",
                        "entry_id": "86805219-55dc-3436-ad14-9e96d13097bc",
                        "glosses": [
                            "An advocate of extinctionism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b14ad6a-e67b-41ed-8810-171b930ea61c",
                                "sense_id": "89b67868-c636-39bc-b73b-c3331817c5b5",
                                "text": "The Voluntary Human Extinctionists among you would no doubt be thrilled. But how would that affect the remainder of your life? Knowing that yours is the last “batch” of humans, would your actions, your striving, still even make sense?"
                            }
                        ]
                    },
                    {
                        "sense_id": "260569b3-b0a1-3c35-b2a6-f3fe99c025c0",
                        "entry_id": "86805219-55dc-3436-ad14-9e96d13097bc",
                        "glosses": [
                            "A player who plays a roguelike game with the additional challenge of killing all creatures to extinction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e02730f-7cc4-420f-8d1d-dcd36bb6d445",
                                "sense_id": "260569b3-b0a1-3c35-b2a6-f3fe99c025c0",
                                "text": "What an Extinctionist tries to do is completely eliminate as many kinds of monsters from the game as possible, either through genocide if it's available, or from just depleting all the kinds of monsters that can be produced."
                            }
                        ]
                    }
