                                "target_senses": [
                                    {
                                        "sense_id": "cbd204dc-7b56-3ba0-9a0d-721a781ddfd4",
                                        "entry_id": "cf822535-fcdf-3f38-bb5f-969e767b0b59",
                                        "glosses": [
                                            "historische Landschaft im Nordosten der Volksrepublik China, Osten der Mongolei und Südosten Russlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc07f59d-bd09-4e59-9a3b-3b7005f5ca04",
                                                "sense_id": "cbd204dc-7b56-3ba0-9a0d-721a781ddfd4",
                                                "text": "„Die Mandschurei ist eine Schatzkammer“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe9dea15-7a62-3798-849a-7a0dae679cbc",
                                        "entry_id": "cf822535-fcdf-3f38-bb5f-969e767b0b59",
                                        "glosses": [
                                            "der Pekinger Konvention von 1860 folgend jener Teil von [1], der bei China verblieb; gleichbedeutend mit „innere Mandschurei“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13277997-09da-4472-87f5-6d5b2e30fe73",
                                                "sense_id": "fe9dea15-7a62-3798-849a-7a0dae679cbc",
                                                "text": "„Die Mandschurei ist eine Schatzkammer“"
                                            }
