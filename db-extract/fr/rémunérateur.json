            {
                "entry_id": "9e7c703a-52fa-387e-95fd-299445e5a653",
                "word": "rémunérateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1f9037b-6684-4bca-9534-0c0c52d71783",
                        "entry_id": "9e7c703a-52fa-387e-95fd-299445e5a653",
                        "tags": [
