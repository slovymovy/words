                ],
                "senses": [
                    {
                        "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                        "entry_id": "7c26fa5e-c21f-32f8-b75a-3c5c76cf92ca",
                        "glosses": [
                            "die Arme bedeckender besonders weit geschnittener Teil eines Kleidungsstückes (beispielsweise eines Hemds, einer Bluse oder eines Kleids)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abc66fba-7271-4a91-89be-7b104d347f1c",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "„Meike Schlecker lässt die Arme hängen, zieht den Mund schief, sie trägt eine Achtzigerjahre-Dauerwelle, einen bunten Pullover mit Fledermausärmeln und einen Jeansrock.“"
                            },
                            {
                                "example_id": "480f1e99-b5ea-4dc8-9590-f963b5b4221a",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "Fledermausärmel wurden Anfang des 20. Jahrhunderts wieder modern."
                            },
                            {
                                "example_id": "fd1e66e1-26c2-490e-bde7-67110d24598a",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "„Unsere Kunden haben sich noch nie über zu weite Mäntel beschwert, wir bieten sogar extraweite Fledermausärmel an.“"
                            },
                            {
                                "example_id": "99797942-a615-4df2-8d21-28781fb0fc15",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "[Das lilafarbene Spitzenkleid] „hatte Fledermausärmel aus Chiffon und war ansonsten schmal geschnitten.“"
                            },
                            {
                                "example_id": "d7f517a1-ebf4-45d3-9e28-5d046a93176b",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "„Die Fledermausärmel ihrer weißen Bluse flattern, Kirchner winkt ins Publikum, sie hält eine rote Rose in einer Hand.“"
                            },
                            {
                                "example_id": "bdc91bd8-c004-4593-aeb1-6bf86dc89087",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "[Jenny, mit 19 eine der Älteren in der Klasse, würde nie] „freiwillig ihr Grufti-Kleid mit den schwarzen Fledermausärmeln gegen eine Schuluniform tauschen […].“"
                            },
                            {
                                "example_id": "1de301e2-7aca-4a4a-95e9-73096a671788",
                                "sense_id": "4fc85b14-859a-3c9b-a19d-b483d09526dc",
                                "text": "„Verleihen Sie Ihrem Kleid einen dramatischen Touch durch Fledermausärmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
