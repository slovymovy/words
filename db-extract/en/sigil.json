                                                "example_id": "26656c01-669b-4d71-a56f-385b330eaf17",
                                                "sense_id": "1b5a2ce3-adc2-384f-b835-b22b3d9b9c8d",
                                                "text": "Een zegel kan van papier, lak of zelfs van klei vervaardigd zijn."
                                            }
