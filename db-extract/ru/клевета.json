                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c2dfd79-4ea4-4980-8bf8-8c81fdbb7590",
                        "source_entry_id": "ffb6e974-b35d-3d3e-9061-9e4b4c1c4f7b",
                        "target_lang_word": "slander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c4d178-5a1d-3b4a-8053-6878633c5c65",
                                        "entry_id": "ed46833c-f323-32ad-9f1b-22f5324904a4",
                                        "glosses": [
                                            "A false or unsupported, malicious statement (spoken, not written), especially one which is injurious to a person's reputation; the making of such a statement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2af364-b8f1-3f4f-a07f-d08c9d638894",
                                        "entry_id": "858dfcb2-06f1-3cd7-89b0-005774a5f1f8",
                                        "glosses": [
                                            "To utter a slanderous statement about; baselessly speak ill of; to wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d62d4a8-ce5f-4132-aa94-a077da5e9442",
                                                "sense_id": "fa2af364-b8f1-3f4f-a07f-d08c9d638894",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough?\n Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him.\n Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bddf0d1-0766-4750-8d82-88d65fe247f8",
                        "source_entry_id": "ffb6e974-b35d-3d3e-9061-9e4b4c1c4f7b",
                        "target_lang_word": "Verleumdung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verleumdung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Rufschädigung durch falsche Aussagen oder Behauptungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dca24f7-47c3-4147-8f1b-0310965f8578",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Die Verleumdung hinterlässt auch bei Widerruf ein schlechtes Image."
                                            },
                                            {
                                                "example_id": "18e5d9b8-d47c-44c9-8e33-e8ef27ae9cf1",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "Der Arbeitskollege meiner Tante wurde wegen Verleumdung angeklagt, weil er in der Abteilung behauptet hatte, er hätte meine Tante beim Ladendiebstahl beobachtet."
                                            },
                                            {
                                                "example_id": "0cff0c36-0fa2-4bef-87cf-74e1c37e7648",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Mengs schloß sich dem Gesandten an; er lud mich ein, bei ihm zu wohnen, damit ich nicht mehr der Verleumdung von Spitzeln ausgesetzt sei, von denen Madrid voll war.“"
                                            },
                                            {
                                                "example_id": "cd94be79-c71f-45cf-b9b6-0b843baddc1e",
                                                "sense_id": "d36ee819-d274-36f4-b579-f21d253f94c7",
                                                "text": "„Eine Verleumdung desjenigen, der anders in die Welt sieht, ist damit natürlich nicht per se gegeben, aber sie kann neheliegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a4156c3-c358-3663-a8fa-4239f2426ef4",
                                        "entry_id": "cee8490b-b862-32b4-ba2e-a784e5cd7d76",
                                        "glosses": [
                                            "Straftatbestand des § 187 StGB, der verwirklicht ist, wenn jemand wider besseres Wissen über einen anderen eine unwahre Tatsache, also Vorgänge oder Zustände der Vergangenheit oder der Gegenwart, die dem Beweis zugänglich sind, behauptet, das heißt, als nach seiner eigenen Überzeugung wahr hinstellt oder verbreitet, sie also als Gegenstand fremden Wissens weitergibt, die dazu geeignet ist, diesen verächtlich zu machen, ihn in der öffentlichen Meinung herabzuwürdigen oder seinen Kredit zu gefährden"
                                        ],
                                        "tags": [
                                            "deutsches Strafrecht"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
