                                "sense_id": "82fff332-758c-361d-9fda-3f70cc605f04",
                                "text": "Przykładane na prasie obciążenie odczytywaliśmy na archaicznym wskaźniku wyskalowanym w kilogramach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
