                                "target_senses": [
                                    {
                                        "sense_id": "e563387d-7b98-31d7-88e1-eceeaeea4eff",
                                        "entry_id": "a659d42d-5299-31dc-9753-3295699bf524",
                                        "glosses": [
                                            "The state of being geometrically normal, at a right angle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7438ae94-f3aa-388a-91d5-14b310083212",
                                        "entry_id": "a659d42d-5299-31dc-9753-3295699bf524",
                                        "glosses": [
                                            "The state of being normal; the fact of being normal; normality."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23db7ffb-4a53-4d0d-b085-755523f3d044",
                                                "sense_id": "7438ae94-f3aa-388a-91d5-14b310083212",
                                                "text": "America's present need is not heroics, but healing; not nostrums, but normalcy; not revolution, but restoration; not agitation, but adjustment; not surgery, but serenity; not the dramatic, but the dispassionate; not experiment, but equipoise; not submergence in internationality but sustainment in triumphant nationality."
                                            },
                                            {
                                                "example_id": "3b04d5e3-2302-4d7e-a311-db5fe01ca97a",
                                                "sense_id": "7438ae94-f3aa-388a-91d5-14b310083212",
                                                "text": "When so I ponder, here apart, / What shallow boons suffice my heart, / What dust-bound trivia capture me, / I marvel at my normalcy."
                                            },
                                            {
                                                "example_id": "42e19e8b-b2c9-47b6-bc01-2bb5e588374e",
                                                "sense_id": "7438ae94-f3aa-388a-91d5-14b310083212",
                                                "text": "The homosexual dismisses heterosexual love as a distasteful bondage to normalcy and bourgeois domestication, but the Platonic lover of the soul is dismissing all sexuality as bondage to the physical world."
                                            },
                                            {
                                                "example_id": "840f1aec-ba96-4c01-96fc-abe416fbde43",
                                                "sense_id": "7438ae94-f3aa-388a-91d5-14b310083212",
                                                "text": "I’ve been consistently awed by how good designers can create normalcy out of chaos; they can clearly communicate ideas through the organizing and manipulating of words and pictures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b528516-7b9f-4614-b6c3-8bc5aa912a11",
                        "source_entry_id": "1b1e4a90-ed20-3c98-9ba8-2d02e1958de4",
                        "source_sense_id": "67a927c0-6058-317f-8170-c6c25f586bf4",
