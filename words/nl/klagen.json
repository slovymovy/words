    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85f19865-11fa-305a-b467-06060dcae89d",
                    "sense_definition": "het uiten van ontevredenheid of ongenoegen over iets of iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ongenoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zolang je goed te eten hebt, heb je niet te <w>klagen</w>.",
                            "target_lang_translations": {
                                "en": "As long as you have good food to eat, you have nothing to <w>complain</w> about."
                            }
                        },
                        {
                            "text": "De buren <w>klagen</w> over het lawaai dat de studenten elke nacht maken.",
                            "target_lang_translations": {
                                "en": "The neighbors are <w>complaining</w> about the noise the students make every night."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen",
                        "reclameren"
                    ],
                    "antonyms": [
                        "prijzen",
                        "juichen"
                    ],
                    "common_phrases": [
                        "klagen over",
                        "niet te klagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To express dissatisfaction or annoyance about something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complain",
                                "target_lang_sense_clarification": "to express dissatisfaction"
                            },
                            {
                                "target_lang_word": "grumble",
                                "target_lang_sense_clarification": "to complain in a low, quiet voice"
                            },
                            {
                                "target_lang_word": "moan",
                                "target_lang_sense_clarification": "informal way of saying someone complains a lot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69dd5c0d-67bd-35da-bbae-ddb99b0c1409",
                    "sense_definition": "een juridische procedure starten tegen iemand bij een rechtbank",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het slachtoffer besloot de dader aan te <w>klagen</w> voor de geleden schade.",
                            "target_lang_translations": {
                                "en": "The victim decided to <w>sue</w> the perpetrator for the damages suffered."
                            }
                        },
                        {
                            "text": "Zij wilde <w>klagen</w> bij de tuchtraad over de onprofessionele houding van de arts.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>file a complaint</w> with the disciplinary board about the doctor's unprofessional attitude."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanklagen",
                        "dagvaarden"
                    ],
                    "common_phrases": [
                        "iemand aanklagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To initiate a legal procedure or formal accusation against someone in a court or official body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sue",
                                "target_lang_sense_clarification": "to start a legal case for damages"
                            },
                            {
                                "target_lang_word": "file a complaint",
                                "target_lang_sense_clarification": "to make a formal or legal accusation"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to formally accuse someone of a crime"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9411273-d5e2-3075-8fbe-a3a456fa8db8",
                    "sense_definition": "het uiten van diep verdriet of rouw",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdriet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De weduwe bleef nog lang <w>klagen</w> over het verlies van haar echtgenoot.",
                            "target_lang_translations": {
                                "en": "The widow continued to <w>lament</w> the loss of her husband for a long time."
                            }
                        },
                        {
                            "text": "In het oude gedicht hoor je de dichter <w>klagen</w> over de vergankelijkheid van het leven.",
                            "target_lang_translations": {
                                "en": "In the old poem, you hear the poet <w>bewailing</w> the transience of life."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammeren",
                        "treuren",
                        "lamenteren"
                    ],
                    "antonyms": [
                        "feesten",
                        "vieren"
                    ],
                    "common_phrases": [
                        "klagen en kermen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literaire of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To express deep sorrow, grief, or mourning, often in a literary or solemn context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lament",
                                "target_lang_sense_clarification": "to express deep grief or regret"
                            },
                            {
                                "target_lang_word": "mourn",
                                "target_lang_sense_clarification": "to feel or show deep sorrow for a loss"
                            },
                            {
                                "target_lang_word": "bewail",
                                "target_lang_sense_clarification": "to express great regret or disappointment over something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}