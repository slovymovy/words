                "senses": [
                    {
                        "sense_id": "8965a021-fc25-31d6-83f0-6a96f3a98551",
                        "entry_id": "a9d81037-ed94-3ed3-b330-b3f88ffdb36b",
                        "glosses": [
                            "Variante des Basketballspiels für Rollstuhlfahrer mit angepassten Regeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544cf766-473b-4ecf-a56c-c1db8d1c9789",
                                "sense_id": "8965a021-fc25-31d6-83f0-6a96f3a98551",
                                "text": "„In den Olympiastätten treten Athleten in klassischen Disziplinen wie Leichtathletik und Schwimmen an, aber auch in speziellen Behindertensportarten wie Goalball oder Rollstuhlbasketball.“"
                            },
                            {
                                "example_id": "0eafae53-66e5-46e3-b640-e013ae1b0256",
                                "sense_id": "8965a021-fc25-31d6-83f0-6a96f3a98551",
                                "text": "„Bis auf wenige Ausnahmen entspricht das Regelwerk im Rollstuhlbasketball dem des ‚Fußgänger-Basketballs‘.“"
                            },
                            {
                                "example_id": "d8bf66d8-9697-4117-87da-b0855f251caf",
                                "sense_id": "8965a021-fc25-31d6-83f0-6a96f3a98551",
                                "text": "„Die Konkurrenz hat sich verstärkt, der neueste Trend im Rollstuhlbasketball ist die Verpflichtung von Ausländern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
