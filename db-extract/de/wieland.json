                ],
                "senses": [
                    {
                        "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                        "entry_id": "c18bfaf4-aecb-3f30-8ede-0d80aaa90299",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d706a56d-6ec2-44bc-b042-bafd54efcc88",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Frau Wieland ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "813a09ea-14ae-4a40-973d-7f58e52da2cb",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Herr Wieland wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7551ab0d-492c-4af4-bdbf-401be4b374de",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Die Wielands fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "991334a4-2953-4c0c-b7a4-773fc0bd04df",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Der Wieland trägt nie die Schals, die die Wieland ihm strickt."
                            },
                            {
                                "example_id": "892cf462-f3fe-4958-803a-b01fb33747c3",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wieland kommt, geht der Herr Wieland.“"
                            },
                            {
                                "example_id": "b4a94d6d-46d3-45cd-9ab6-6bbd195949af",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Wieland kommt und geht."
                            },
                            {
                                "example_id": "1725150e-d863-4eef-9f0d-ff0540573d23",
                                "sense_id": "2e3f749a-5405-3de7-87c7-b8e14b710b87",
                                "text": "Wielands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
