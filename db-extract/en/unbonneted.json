                        ],
                        "examples": [
                            {
                                "example_id": "78f46fc5-cb85-4317-8a4f-8522d0d15eef",
                                "sense_id": "25e35d84-4603-30ea-9076-3127da143a01",
                                "text": "This night, wherein the cub-drawn bear would couch,\nThe lion and the belly-pinched wolf\nKeep their fur dry, unbonneted he runs,\nAnd bids what will take all."
                            },
                            {
                                "example_id": "93704a26-4feb-4cb3-81cd-81c9af83e44d",
                                "sense_id": "25e35d84-4603-30ea-9076-3127da143a01",
                                "text": "The effect on entrance is very striking: a crowd, where the majority are females, with gay-coloured dresses, and their heads unbonneted, always gives the idea of festival:..."
                            },
                            {
                                "example_id": "6d5d7a23-06f2-40c3-a298-53d34f456eb1",
                                "sense_id": "25e35d84-4603-30ea-9076-3127da143a01",
                                "text": "They walked in in the middle of the sermon in their wash dresses, sweaty and unbonneted […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a157566-1123-31d6-bc0d-104800b56842",
