                                        "sense_id": "156ac97f-1aa6-37d5-b7da-fd805b831f87",
                                        "entry_id": "a1033ea1-ee40-314b-912f-933788fc77c4",
                                        "glosses": [
                                            "meist Hauptstraße eines Dorfes; allgemeine Bezeichnung für Straßen eines Dorfes"
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9010d2-e5ef-420c-876e-b97e70d68c08",
                                                "sense_id": "156ac97f-1aa6-37d5-b7da-fd805b831f87",
                                                "text": "Unsere Dorfstraße wird morgen wegen Ausbesserungsarbeiten gesperrt."
                                            },
                                            {
                                                "example_id": "6525197d-0be6-453d-b720-30b3ef8a4382",
                                                "sense_id": "156ac97f-1aa6-37d5-b7da-fd805b831f87",
                                                "text": "„Er hatte keinen Blick mehr für die Gehöfte zu beiden Seiten der Dorfstraße, für die mit Stroh gedeckten Stallungen, die Lindenbäume, die in unregelmäßigen Abständen den Weg säumten.“"
                                            },
                                            {
                                                "example_id": "f8370f08-aa9d-49cf-9f47-04fd04e50fcd",
                                                "sense_id": "156ac97f-1aa6-37d5-b7da-fd805b831f87",
                                                "text": "„Die ganze Dorfstraße geht es hinunter, an den letzten Häusern vorüber ins Feld hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d379ce7a-25bc-301b-ba36-75012da6aa77",
