                ],
                "senses": [
                    {
                        "sense_id": "dcb32842-2d4b-39eb-9553-57bec9112ed2",
                        "entry_id": "d3cec6e7-df96-3cfc-a102-0d88c1cc229f",
                        "glosses": [
                            "Réaction chimique de l’ozone sur un alcène, ou un alcyne, consistant en plusieurs cycloadditions, dont le produit, appelé ozonure ou ozonide, est réduit ou oxydé pour former d’autres molécules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "accec4e0-6df4-4008-a0cc-7d36a7509fb7",
                                "sense_id": "dcb32842-2d4b-39eb-9553-57bec9112ed2",
                                "text": "En synthèse organique, on appelle ozonolyse l’action de l’ozone, qu’elle soit suivie d’un traitement réducteur ou oxydant de l’ozonide formé."
                            }
                        ]
                    },
                    {
                        "sense_id": "56eb220d-a2ea-347e-964d-538a8fc017d0",
                        "entry_id": "d3cec6e7-df96-3cfc-a102-0d88c1cc229f",
                        "glosses": [
                            "Ensemble des réactions chimiques de l’ozonolyse (sens 1) et du traitement de l’ozonide."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c35fda33-7774-4ff4-b031-ac5994c8404a",
                                "sense_id": "56eb220d-a2ea-347e-964d-538a8fc017d0",
                                "text": "L’ozonolyse consiste en un véritable cracking de molécules organiques."
                            }
                        ]
                    }
                ],
