{
    "word_family": [
        "astound",
        "astoundingly",
        "astoundment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc937fa4-3875-3e26-b4bd-9eb64130110f",
                    "sense_definition": "Very surprising or shocking; causing great wonder or amazement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team achieved an <w>astounding</w> victory against the league champions.",
                            "target_lang_translations": {
                                "ru": "Команда одержала <w>поразительную</w> победу над чемпионами лиги.",
                                "it": "La squadra ha ottenuto una vittoria <w>sbalorditiva</w> contro i campioni del campionato."
                            }
                        },
                        {
                            "text": "It is <w>astounding</w> how much the city has changed in just ten years.",
                            "target_lang_translations": {
                                "ru": "<w>Поразительно</w>, как сильно изменился город всего за десять лет.",
                                "it": "È <w>sorprendente</w> quanto la città sia cambiata in soli dieci anni."
                            }
                        }
                    ],
                    "synonyms": [
                        "amazing",
                        "extraordinary",
                        "fantastic",
                        "incredible",
                        "marvelous",
                        "phenomenal",
                        "remarkable",
                        "astonishing",
                        "awesome"
                    ],
                    "common_phrases": [
                        "astounding success",
                        "astounding result"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень удивительный, поразительный или шокирующий; вызывающий огромное изумление.",
                        "it": "Molto sorprendente o sbalorditivo; che suscita grande meraviglia o stupore."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поразительный",
                                "target_lang_sense_clarification": "вызывающий сильное удивление или восхищение"
                            },
                            {
                                "target_lang_word": "изумительный",
                                "target_lang_sense_clarification": "вызывающий крайнее удивление"
                            },
                            {
                                "target_lang_word": "ошеломляющий",
                                "target_lang_sense_clarification": "настолько удивительный, что лишает способности здраво мыслить"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sbalorditivo",
                                "target_lang_sense_clarification": "che suscita grandissimo stupore o meraviglia"
                            },
                            {
                                "target_lang_word": "strabiliante",
                                "target_lang_sense_clarification": "straordinario, incredibile per la sua eccezionalità"
                            },
                            {
                                "target_lang_word": "sorprendente",
                                "target_lang_sense_clarification": "inaspettato e degno di nota"
                            },
                            {
                                "target_lang_word": "impressionante",
                                "target_lang_sense_clarification": "che colpisce profondamente la mente o le emozioni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0086ce55-cc93-3f49-a011-0d242870972c",
                    "sense_definition": "Present participle and gerund of <w>astound</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician was <w>astounding</w> the audience with his clever card tricks.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>изумлял</w> публику своими ловкими карточными трюками.",
                                "it": "Il mago stava <w>sbalordendo</w> il pubblico con i suoi abili trucchi con le carte."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>astounding</w> his friends with stories of his travels.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, <w>поражая</w> друзей историями о своих путешествиях.",
                                "it": "Ha trascorso il pomeriggio a <w>stupire</w> i suoi amici con i racconti dei suoi viaggi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «изумлять» (поражать).",
                        "it": "Participio presente e gerundio di astound (sbalordire, stupire)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумляющий",
                                "target_lang_sense_clarification": "вызывающий удивление в процессе действия"
                            },
                            {
                                "target_lang_word": "поражающий",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sbalordire",
                                "target_lang_sense_clarification": "lasciare a bocca aperta per la sorpresa"
                            },
                            {
                                "target_lang_word": "stupire",
                                "target_lang_sense_clarification": "provocare grande meraviglia o stupore"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}