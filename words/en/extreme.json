{
    "word_family": [
        "extremely",
        "extremist",
        "extremism",
        "extremity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e9cbb5b-7b5a-3a0a-b1b5-8b4969b5d487",
                    "sense_definition": "In the greatest or highest degree; intense.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has an <w>extreme</w> aversion to needles and avoids doctors.",
                            "target_lang_translations": {
                                "ru": "У него <w>крайнее</w> отвращение к иглам, и он избегает врачей.",
                                "zh": "他对针头有<w>极度</w>的厌恶，所以总是避开医生。"
                            }
                        },
                        {
                            "text": "The explorers faced <w>extreme</w> cold during their expedition.",
                            "target_lang_translations": {
                                "ru": "Во время экспедиции исследователи столкнулись с <w>экстремальным</w> холодом.",
                                "zh": "探险队员在考察期间遭遇了<w>极端</w>的严寒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "greatest",
                        "highest",
                        "severe"
                    ],
                    "antonyms": [
                        "moderate",
                        "least"
                    ],
                    "common_phrases": [
                        "extreme heat",
                        "extreme cold",
                        "extreme poverty",
                        "extreme pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "В высшей степени; очень сильный или интенсивный.",
                        "zh": "在最高程度上的；强烈的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайный",
                                "target_lang_sense_clarification": "о ситуации или состоянии"
                            },
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "о степени проявления"
                            },
                            {
                                "target_lang_word": "экстремальный",
                                "target_lang_sense_clarification": "об условиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端的",
                                "target_lang_sense_clarification": "指程度或性质"
                            },
                            {
                                "target_lang_word": "极度的",
                                "target_lang_sense_clarification": "指感受或状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b01ce0-a0a9-3b07-8d6e-f93d23862d04",
                    "sense_definition": "Of sports, difficult or dangerous; performed in a hazardous environment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people enjoy <w>extreme</w> sports like bungee jumping.",
                            "target_lang_translations": {
                                "ru": "Многим молодым людям нравятся <w>экстремальные</w> виды спорта, такие как банджи-джампинг.",
                                "zh": "许多年轻人喜欢蹦极这类<w>极限</w>运动。"
                            }
                        },
                        {
                            "text": "He bought a new bike designed for <w>extreme</w> mountain riding.",
                            "target_lang_translations": {
                                "ru": "Он купил новый велосипед, предназначенный для <w>экстремальной</w> езды в горах.",
                                "zh": "他买了一辆专为<w>极限</w>山地骑行设计的新自行车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dangerous",
                        "hazardous"
                    ],
                    "common_phrases": [
                        "extreme sports"
                    ],
                    "target_lang_definitions": {
                        "ru": "О спорте: трудный, опасный или выполняемый в рискованных условиях.",
                        "zh": "指运动：困难的、危险的，或在有风险的环境中进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстремальный",
                                "target_lang_sense_clarification": "о спорте или развлечениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极限",
                                "target_lang_sense_clarification": "用于极限运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcae35f9-f56f-3155-b841-0293844a2faa",
                    "sense_definition": "Excessive, or far beyond the norm.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>extreme</w> political views often cause arguments at dinner.",
                            "target_lang_translations": {
                                "ru": "Его <w>крайние</w> политические взгляды часто вызывают споры за ужином.",
                                "zh": "他那<w>极端</w>的政治观点常在晚餐时引发争论。"
                            }
                        },
                        {
                            "text": "The organization is known for its <w>extreme</w> stance on environmental issues.",
                            "target_lang_translations": {
                                "ru": "Эта организация известна своей <w>радикальной</w> позицией по экологическим вопросам.",
                                "zh": "该组织以其在环境问题上的<w>过激</w>立场而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excessive",
                        "immoderate"
                    ],
                    "antonyms": [
                        "moderate",
                        "reasonable"
                    ],
                    "common_phrases": [
                        "extreme views",
                        "extreme caution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерный или выходящий далеко за рамки нормы.",
                        "zh": "过分的，或远超正常范围的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "о взглядах или мнениях"
                            },
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "бескомпромиссный"
                            },
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "излишний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端的",
                                "target_lang_sense_clarification": "指观点或立场"
                            },
                            {
                                "target_lang_word": "过激的",
                                "target_lang_sense_clarification": "指行为或态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4ed1119-7e3f-3bea-9053-9584cf10456a",
                    "sense_definition": "Drastic, or of great severity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced <w>extreme</w> measures to combat the crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело <w>чрезвычайные</w> меры для борьбы с кризисом.",
                                "zh": "政府采取了<w>极端</w>措施来应对这场危机。"
                            }
                        },
                        {
                            "text": "I think the new security laws are <w>extreme</w>.",
                            "target_lang_translations": {
                                "ru": "Я думаю, что новые законы о безопасности <w>чрезмерны</w>.",
                                "zh": "我认为新的安全法太<w>极端</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drastic",
                        "severe"
                    ],
                    "antonyms": [
                        "moderate"
                    ],
                    "common_phrases": [
                        "extreme measures",
                        "extreme circumstances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радикальный или очень суровый.",
                        "zh": "激进的，或非常严厉的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайный",
                                "target_lang_sense_clarification": "о мерах"
                            },
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "вынужденный"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "жесткий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端的",
                                "target_lang_sense_clarification": "指措施或手段"
                            },
                            {
                                "target_lang_word": "严厉的",
                                "target_lang_sense_clarification": "指程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d02b2287-64c4-3fc2-9cab-1dea997a2a8a",
                    "sense_definition": "Of a place, the most remote, farthest or outermost.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live on the <w>extreme</w> edge of the island.",
                            "target_lang_translations": {
                                "ru": "Они живут на <w>самом</w> краю острова.",
                                "zh": "他们住在岛屿的<w>最边缘</w>地带。"
                            }
                        },
                        {
                            "text": "The coating is very thin at the <w>extreme</w> ends.",
                            "target_lang_translations": {
                                "ru": "Покрытие очень тонкое на <w>самых</w> концах.",
                                "zh": "涂层在<w>最远端</w>非常薄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "farthest",
                        "outermost",
                        "remotest"
                    ],
                    "antonyms": [
                        "closest",
                        "nearest"
                    ],
                    "common_phrases": [
                        "extreme edge",
                        "extreme end"
                    ],
                    "target_lang_definitions": {
                        "ru": "О месте: самый отдаленный, дальний или внешний.",
                        "zh": "指地点：最偏远的、最远的或最外侧的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "находящийся с краю"
                            },
                            {
                                "target_lang_word": "самый дальний",
                                "target_lang_sense_clarification": "отдаленный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最边缘的",
                                "target_lang_sense_clarification": "指位置"
                            },
                            {
                                "target_lang_word": "最远端的",
                                "target_lang_sense_clarification": "指距离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e44743d-9f31-3266-8925-a532dae15164",
                    "sense_definition": "Ultimate, final or last.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He faced the <w>extreme</w> hour of his life with courage.",
                            "target_lang_translations": {
                                "ru": "Он встретил <w>последний</w> час своей жизни с мужеством.",
                                "zh": "他勇敢地面对了生命中<w>最后</w>的时刻。"
                            }
                        },
                        {
                            "text": "This was the <w>extreme</w> limit of his patience.",
                            "target_lang_translations": {
                                "ru": "Это был <w>последний</w> предел его терпения.",
                                "zh": "这是他耐心的<w>最后</w>底线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "final",
                        "ultimate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mostly found in literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательный, завершающий или последний.",
                        "zh": "最终的、结束的或最后的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "во времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后的",
                                "target_lang_sense_clarification": "指时间或终点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c40bdef-d489-3dcf-80d5-26d15aafe532",
                    "sense_definition": "Each of the things at opposite ends of a range or scale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert experiences <w>extremes</w> of temperature between day and night.",
                            "target_lang_translations": {
                                "ru": "В пустыне наблюдаются <w>экстремальные перепады</w> температур между днем и ночью.",
                                "zh": "沙漠昼夜温差<w>极端</w>。"
                            }
                        },
                        {
                            "text": "Her mood often swings from one <w>extreme</w> to the other.",
                            "target_lang_translations": {
                                "ru": "Ее настроение часто бросается из одной <w>крайности</w> в другую.",
                                "zh": "她的情绪经常在两个<w>极端</w>之间摇摆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pole"
                    ],
                    "common_phrases": [
                        "extremes of temperature",
                        "two extremes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоположности; вещи, находящиеся на разных концах шкалы.",
                        "zh": "处于范围或尺度两端的对立事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайность",
                                "target_lang_sense_clarification": "противоположность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端",
                                "target_lang_sense_clarification": "指对立面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "704ea7c9-8b7f-38b0-815e-200eb3ca6c46",
                    "sense_definition": "A drastic expedient or measure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people go to <w>extremes</w> to get attention on social media.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди впадают в <w>крайности</w>, чтобы привлечь внимание в социальных сетях.",
                                "zh": "有些人为了在社交媒体上博取关注会<w>走极端</w>。"
                            }
                        },
                        {
                            "text": "We do not need to go to such <w>extremes</w> to solve this problem.",
                            "target_lang_translations": {
                                "ru": "Нам не нужно доходить до таких <w>крайностей</w>, чтобы решить эту проблему.",
                                "zh": "我们没必要为了解决这个问题而<w>走极端</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go to extremes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радикальная мера или действие.",
                        "zh": "激进的手段或措施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайность",
                                "target_lang_sense_clarification": "чрезмерная мера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端做法",
                                "target_lang_sense_clarification": "指过激行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c3c004e-3367-397a-abb9-8e9078c9aa4c",
                    "sense_definition": "The greatest or utmost point, degree, or condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The behavior of the crowd was puzzling in the <w>extreme</w>.",
                            "target_lang_translations": {
                                "ru": "Поведение толпы было в <w>высшей степени</w> загадочным.",
                                "zh": "人群的行为<w>极度</w>令人费解。"
                            }
                        },
                        {
                            "text": "He was generous in the <w>extreme</w> with his time and money.",
                            "target_lang_translations": {
                                "ru": "Он был щедрым в <w>высшей степени</w>, тратя свое время и деньги.",
                                "zh": "他在时间和金钱上都<w>极度</w>慷慨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the extreme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшая точка или степень чего-либо.",
                        "zh": "某事物的最高点、程度或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высшая степень",
                                "target_lang_sense_clarification": "максимум"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极度",
                                "target_lang_sense_clarification": "用于程度副词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8572d6a9-09a8-3573-8c98-a6a7059054f0",
                    "sense_definition": "Either of the two numbers at the ends of a proportion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ratio one to two equals three to six, one and six are the <w>extremes</w>.",
                            "target_lang_translations": {
                                "ru": "В пропорции один к двум равно три к шести, один и шесть — это <w>крайние члены</w>.",
                                "zh": "在1比2等于3比6的比例中，1和6是<w>外项</w>。"
                            }
                        },
                        {
                            "text": "The product of the means equals the product of the <w>extremes</w>.",
                            "target_lang_translations": {
                                "ru": "Произведение средних членов равно произведению <w>крайних членов</w>.",
                                "zh": "内项之积等于<w>外项</w>之积。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из двух чисел, находящихся на концах пропорции.",
                        "zh": "比例中两端的任意一个数字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайний член",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外项",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}