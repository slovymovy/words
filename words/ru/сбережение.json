            "senses": [
                {
                    "sense_id": "562caf6f-ea7a-37c8-b114-c8670b67e318",
                    "sense_definition": "Накопленная сумма денег, сбережённые средства (чаще во множественном числе).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "накопления",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он потратил все личные <w>сбережения</w> на покупку новой квартиры.",
                            "target_lang_translations": {
                                "en": "He spent all his personal <w>savings</w> on buying a new apartment."
                            }
                        },
                        {
                            "text": "В период кризиса многие семьи стараются сохранить свои денежные <w>сбережения</w>.",
                            "target_lang_translations": {
                                "en": "During a crisis, many families try to preserve their financial <w>savings</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "растрата",
                        "трата"
                    ],
                    "common_phrases": [
                        "личные сбережения",
                        "денежные сбережения"
                    ],
                    "target_lang_definitions": {
                        "en": "An accumulated amount of money; saved financial funds (commonly used in the plural)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "savings",
                                "target_lang_sense_clarification": "accumulated money"
                            },
                            {
                                "target_lang_word": "nest egg",
                                "target_lang_sense_clarification": "money saved for the future"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eebd4623-d66a-3555-a154-24286c8d0278",
                    "sense_definition": "Действие по значению глаголов <w>сберегать</w>, <w>сберечь</w>; сохранение в целости или экономное расходование чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сохранение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи рекомендуют больше гулять для <w>сбережения</w> здоровья и хорошего самочувствия.",
                            "target_lang_translations": {
                                "en": "Doctors recommend walking more for the <w>preservation</w> of health and well-being."
                            }
                        },
                        {
                            "text": "Правильное хранение продуктов важно для <w>сбережения</w> свежести овощей.",
                            "target_lang_translations": {
                                "en": "Proper food storage is important for <w>preserving</w> the freshness of vegetables."
                            }
                        }
                    ],
                    "synonyms": [
                        "сохранение"
                    ],
                    "antonyms": [
                        "растрата",
                        "трата"
                    ],
                    "common_phrases": [
                        "для сбережения здоровья",
                        "сбережение энергии"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of keeping safe, conserving, or using resources economically; preservation or saving."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "preservation",
                                "target_lang_sense_clarification": "keeping safe or maintaining in intact condition"
                            },
                            {
                                "target_lang_word": "conservation",
                                "target_lang_sense_clarification": "careful use and saving of resources or energy"
                            },
                            {
                                "target_lang_word": "saving",
                                "target_lang_sense_clarification": "the act of economizing or not wasting something"
                            }
                        ]
                    }
                }
            ]
        }
