                    },
                    {
                        "translation_id": "a8791967-7745-4dd1-b820-5ddbb36e47fc",
                        "source_entry_id": "31e87203-da92-3642-929b-7f907831b624",
                        "source_sense_id": "13e57f26-4eac-3f53-b5f4-b033c1e78d59",
                        "source_sense_description": "of or pertaining to Czechoslovakia",
                        "target_lang_word": "tchécoslovaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchécoslovaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                        "entry_id": "5a0731ae-6b71-3897-8ae9-4ca2059d3722",
                                        "glosses": [
                                            "Relatif à la Tchécoslovaquie et à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a1e9f8-eff8-45ea-a3b4-7994c8f4af86",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Ah ! la bougresse ! Elle est maintenant entretenue par un banquier tchécoslovaque qui a réalisé une fortune colossale pendant la guerre dans les fournitures aux armées."
                                            },
                                            {
                                                "example_id": "b14bf61e-cd7b-49c3-8760-251dfe2c9a71",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Le 26 octobre prochain, une touchante cérémonie aura lieu à Chestres (Ardennes) (près de Vouziers). Un monument sera inauguré on souvenir des légionnaires tchécoslovaques morts en luttant pour le Droit et pour la Liberté."
                                            },
                                            {
                                                "example_id": "c53c6faa-c2ee-405c-aaca-856d876cae91",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "Avec le régiment de marche de la Légion étrangère, les volontaires tchécoslovaques se battirent quatre fois sur la Somme, trois fois sur l'Aisne, trois fois en Champagne, deux fois sur l'Oise, en Artois, en Alsace, à Verdun et à Saint Mihiel. Le 9 mai 1915, près d'Arras, la compagnie « Nazdar » prit un grand nombre de tranchées ennemies."
                                            },
                                            {
                                                "example_id": "e09d89b6-0966-4c25-901f-91df60a33cd9",
                                                "sense_id": "eb364a52-afa0-35ce-8107-ee8cc9adf958",
                                                "text": "En France, les 21ᵉ et 22ᵉ régiments d'infanterie tchécoslovaque, formant la première brigade tchécoslovaque, résistent vaillamment sur l'Aisne aux attaques allemandes d'octobre 1918."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchécoslovaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42309081-9105-33f1-94ee-acca592f73dc",
                                        "entry_id": "676bc69c-b33a-3894-b16e-2593a02c37cf",
                                        "glosses": [
                                            "Concept sociolinguistique et construction politique utilisée en Tchécoslovaquie de 1920 à 1938 pour définir la langue officielle du pays réunissant les langues tchèque et slovaque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "806a8c65-0231-4eb5-ad7a-96d5d35f806d",
                        "source_entry_id": "31e87203-da92-3642-929b-7f907831b624",
                        "source_sense_id": "13e57f26-4eac-3f53-b5f4-b033c1e78d59",
                        "source_sense_description": "of or pertaining to Czechoslovakia",
                        "target_lang_word": "tschechoslowakisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tschechoslowakisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87bea10e-1001-3b27-ab4c-193b3f2b109c",
                                        "entry_id": "a13a4b4b-7631-35af-8959-b43db3425959",
                                        "glosses": [
                                            "die Tschechoslowakei (ehemaliger Staat in Mitteleuropa) betreffend, zu ihr gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52a5ec3-a874-4ac8-8ca9-d06be72ce747",
                                                "sense_id": "87bea10e-1001-3b27-ab4c-193b3f2b109c",
                                                "text": "„Der Kremenez […] ist ein 1221 m hoher Berg mit seinem Gipfel auf der polnisch-ukrainischen Grenze bei den Bukovské vrchy der Waldkarpaten. In der Zwischenkriegszeit lag er auf der tschechoslowakisch-polnischen Grenze.“"
                                            },
                                            {
                                                "example_id": "6fc0d439-ccf1-4139-bffa-05aff581e597",
                                                "sense_id": "87bea10e-1001-3b27-ab4c-193b3f2b109c",
                                                "text": "„Am 1. November […] hatte die DDR wieder visafreie Reisen in die ČSSR zugelassen; zwei Tage später hatte sie der Öffnung der tschechoslowakischen Grenze zur Bundesrepublik für Bürger der DDR zugestimmt.“"
                                            },
                                            {
                                                "example_id": "63245ea2-d860-4c80-a215-33366fa67a2c",
                                                "sense_id": "87bea10e-1001-3b27-ab4c-193b3f2b109c",
                                                "text": "Die höheren Aufragungen, z.B. der Fichtelberg (1216 m) und der auf tschechoslowakischem Gebiet liegende Klinovec (Keilberg; 1244 m), sind vor allem an Glimmerschiefer, im Osterzgebirge außerdem an Quarzporphyr – Kahleberg 904 m – oder an einzelne Basaltreste – Geisingberg 823 m – gebunden, die insbesondere auch im Gebiet des mittleren Erzgebirges – Pöhlberg, Scheibenberg, Bärenstein – deutlich über die Hochfläche aufragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
