                        "form": "die Medizinstudenten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                        "entry_id": "ab371c4f-fd3a-363e-9455-699c39aa67b1",
                        "glosses": [
                            "Person, die Medizin studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82beb766-1366-422e-ba33-930720be95ca",
                                "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                                "text": "Jeder Medizinstudent muss sich im Laufe seines Studiums mit der Pathologie beschäftigen."
                            },
                            {
                                "example_id": "772ac86e-5fd1-47d9-a3e2-fa0aa74a6a64",
                                "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                                "text": "„Einer von ihnen stellte sich als Chefarzt der Stroke Unit vor und fragte mich, ob es mir recht sei, dass die Medizinstudenten bei der Visite anwesend waren.“"
                            },
                            {
                                "example_id": "80d15db3-3ed2-48e6-8c01-95e2880cb0e6",
                                "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                                "text": "„Ein Medizinstudent soll im gynäkologischen Praktikum an einer Puppe eine Zangengeburt demonstrieren.“"
                            },
                            {
                                "example_id": "24d5db53-a021-47a3-bcd9-d6b5cde9e049",
                                "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                                "text": "„In gleicher Weise erhielten die Medizinstudenten einen minimalen Anschauungsunterricht in bezug auf den menschlichen Leib.“"
                            },
                            {
                                "example_id": "82296776-3c52-4f79-a64e-2339008b792e",
                                "sense_id": "b9d492ea-f4d7-358e-9811-76606c663171",
                                "text": "„Jurastudenten besuchten das örtliche Gericht, Medizinstudenten wurden im Krankenhaus eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f38e179c-d804-4798-98e1-6a18e4d7ee38",
                        "source_entry_id": "ab371c4f-fd3a-363e-9455-699c39aa67b1",
