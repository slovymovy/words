                    {
                        "sense_id": "7b334567-61c7-3925-a95f-c60f09b7bb6a",
                        "entry_id": "bc71ef8a-7e2f-3fab-b616-c72bbbf53fc9",
                        "glosses": [
                            "niet vruchtbare vrouwelijke bij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45e887c-8d8b-4b90-9fc3-0203de9e012c",
                                "sense_id": "7b334567-61c7-3925-a95f-c60f09b7bb6a",
                                "text": "Wageningen, de meest westelijke bestemming in het vaarroutenetwerk, is de reis waard wegens Hotel De Wereld waar in 1945 de capitulatie bekrachtigd werd. En voor het Bijenhuis, waar een leerzame expositie snel duidelijk maakt dat de gemiddelde werkbij een slechte cao heeft."
                            },
                            {
                                "example_id": "43671430-3c00-492a-a536-87aea663c169",
                                "sense_id": "7b334567-61c7-3925-a95f-c60f09b7bb6a",
                                "text": "Ook tijdens de rest van haar leven krijgt de koningin – in tegenstelling tot de andere bijen – koninginnegelei te eten. Vermoedelijk leeft een koningin dankzij dit mengsel van water, eiwit, suiker, vet en verscheidene vitamines, mineralen en hormonen veel langer dan een werkbij: ongeveer vijf jaar tegenover enkele maanden."
                            }
                        ]
                    },
                    {
                        "sense_id": "269a9ead-2267-357f-b1a7-a6277d420eaf",
                        "entry_id": "bc71ef8a-7e2f-3fab-b616-c72bbbf53fc9",
                        "glosses": [
                            "een persoon die heel hard moet werken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "98564b2a-fd0d-4ace-8504-00baff89327c",
                                "sense_id": "269a9ead-2267-357f-b1a7-a6277d420eaf",
                                "text": "Aan het einde van de bijbehorende videoclip is de werkbij, het symbool van Manchester, te zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c18cba7-e24c-4f34-a426-b754f60db97d",
                        "source_entry_id": "bc71ef8a-7e2f-3fab-b616-c72bbbf53fc9",
