{
    "word_family": [
        "bilingualism",
        "bilingually"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "138c1447-b473-3336-bdf7-7fd3f3c84109",
                    "sense_definition": "Having the ability to speak two languages fluently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "language_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since she is <w>bilingual</w> she has them written in both English and Spanish.",
                            "target_lang_translations": {
                                "zh": "因为她是<w>双语者</w>，所以她用英语和西班牙语两种语言写了这些。"
                            }
                        },
                        {
                            "text": "Instead of nonnative speakers, we should be called <w>bilingual</w> or multilingual speakers.",
                            "target_lang_translations": {
                                "zh": "我们不应该被称为非母语者，而应该被称为<w>双语</w>或多语使用者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bilingual speaker"
                    ],
                    "target_lang_definitions": {
                        "zh": "指能够流利使用两种语言的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "双语的",
                                "target_lang_sense_clarification": "形容人具备两种语言能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "518103d8-9b09-37c9-9aa5-a0fa049d2210",
                    "sense_definition": "Spoken or written in two different languages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student used a <w>bilingual</w> dictionary to translate the difficult text.",
                            "target_lang_translations": {
                                "zh": "学生用一本<w>双语</w>词典翻译了那篇难懂的文章。"
                            }
                        },
                        {
                            "text": "All signage in the station is <w>bilingual</w> in Welsh and English.",
                            "target_lang_translations": {
                                "zh": "车站里的所有标识都是威尔士语和英语的<w>双语</w>标识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diglot"
                    ],
                    "common_phrases": [
                        "bilingual dictionary"
                    ],
                    "target_lang_definitions": {
                        "zh": "指以两种不同语言书写或表达的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "双语的",
                                "target_lang_sense_clarification": "形容事物或文本包含两种语言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ade3d43c-1779-3e17-9c1a-baa4933191ac",
                    "sense_definition": "Characterized by the use or presence of two languages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school offers a <w>bilingual</w> education program for young children.",
                            "target_lang_translations": {
                                "zh": "学校为幼儿提供<w>双语</w>教育项目。"
                            }
                        },
                        {
                            "text": "The official report was released in a <w>bilingual</w> format for all citizens.",
                            "target_lang_translations": {
                                "zh": "这份官方报告以<w>双语</w>格式发布，供所有公民阅读。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bilingual education"
                    ],
                    "target_lang_definitions": {
                        "zh": "指涉及或使用两种语言的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "双语的",
                                "target_lang_sense_clarification": "形容制度、环境或项目涉及两种语言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3a18c84-e5f2-30aa-a94b-e471a11e91bc",
                    "sense_definition": "A person who is able to use two languages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "language_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>bilinguals</w> can switch between languages very easily.",
                            "target_lang_translations": {
                                "zh": "许多<w>双语者</w>可以非常轻松地在两种语言之间切换。"
                            }
                        },
                        {
                            "text": "Studies show that <w>bilinguals</w> often have better cognitive flexibility.",
                            "target_lang_translations": {
                                "zh": "研究表明，<w>双语者</w>通常具有更好的认知灵活性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指能够使用两种语言的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "双语者",
                                "target_lang_sense_clarification": "指具备双语能力的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}