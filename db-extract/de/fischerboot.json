                                    {
                                        "sense_id": "2c491a9a-8ac6-39ad-9b11-52f8b2afd5b3",
                                        "entry_id": "862b65fb-4ecb-30c7-9fc4-9e3fc121cd31",
                                        "glosses": [
                                            "Bateau destiné à la pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e173455e-aabc-4ed8-9896-4111594ef800",
                                                "sense_id": "2c491a9a-8ac6-39ad-9b11-52f8b2afd5b3",
                                                "text": "En se dotant de la plus importante flotte de bateaux de pêche, le groupe de distribution alimentaire Intermarché profite de cette puissance pour fournir le marché (y compris ses concurrents) en poissons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af1a1d66-638c-4fa9-9283-28032b8dc4f3",
                        "source_entry_id": "10bd23bd-b158-3050-b286-d3fdd46e58de",
                        "source_sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                        "source_sense_description": "Boot, das für den Fang von Fischen und Meeresfrüchten genutzt wird",
                        "target_lang_word": "barque de pêche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "67bda106-3176-44c7-a688-382da034c4cc",
                        "source_entry_id": "10bd23bd-b158-3050-b286-d3fdd46e58de",
                        "source_sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                        "source_sense_description": "Boot, das für den Fang von Fischen und Meeresfrüchten genutzt wird",
                        "target_lang_word": "balancelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balancelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e24cd72a-2931-31eb-92b7-192a8a771451",
                                        "entry_id": "d2a19222-9714-3c33-89d5-f8409ef68299",
                                        "glosses": [
                                            "Sorte d’embarcation pointue des deux bouts et munie d’un mât unique à voile triangulaire et d’avirons, autrefois très en usage dans la Méditerranée."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9986ae0-ec25-4682-b999-0fd704d95a4b",
                                                "sense_id": "e24cd72a-2931-31eb-92b7-192a8a771451",
                                                "text": "Ce matin-là, la petite créole n’a pas pu se lever. Comme une balancelle mahonnaise prise dans les glaces du Nord, le froid l’étreint, la paralyse."
                                            },
                                            {
                                                "example_id": "1ee5d974-68ba-48f7-ae07-936620a14d46",
                                                "sense_id": "e24cd72a-2931-31eb-92b7-192a8a771451",
                                                "text": "Je le vois au début propriétaire de deux cargos […] avec lesquels il fait le transport et le commerce des oranges des Baléares. C’est la première concurrence sérieuse faite aux balancelles barcelonaises."
                                            },
                                            {
                                                "example_id": "96e9c9b3-d093-4360-8a54-adde6146e53d",
                                                "sense_id": "e24cd72a-2931-31eb-92b7-192a8a771451",
                                                "text": "Enfin, vers midi, une balancelle, montée par des corailleurs espagnols, aperçut nos signaux et la fumée de nos feux ; elle s’approcha et nous jeta un sac de biscuits de mer, du pain et du tabac, puis cingla vers Oran pour annoncer notre naufrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ce13c1-14b7-347b-b4c2-26d1a63fa746",
                                        "entry_id": "d2a19222-9714-3c33-89d5-f8409ef68299",
                                        "glosses": [
                                            "Plateau muni d’un crochet sur lequel on place les objets à transporter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4445a0cb-e2c4-4239-9f27-8854ec4c82e9",
                                                "sense_id": "d6ce13c1-14b7-347b-b4c2-26d1a63fa746",
                                                "text": "Pour gagner le wharf, nous prenons place à cinq ou six dans une sorte de balancelle qu’on suspend par un crochet à une élingue, et qu’une grue soulève et dirige à travers les airs, au-dessus des flots, vers une vaste barque, où le treuil la laisse lourdement choir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b787f35-0c1c-39be-b386-e8782aa9a4a2",
                                        "entry_id": "d2a19222-9714-3c33-89d5-f8409ef68299",
                                        "glosses": [
                                            "Plateau mobile généralement sur transporteur auquel on fixe des pièces à peindre au pistolet, des émaux à cuire, etc. — (Clément Duval, Raymonde Duval, Roger Dolique, Dictionnaire de la chimie et de ses applications, Presses scientifiques internationales, 1959 (2ᵉ édition))"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e4f6e4c-8071-3bd9-8e42-567e86cd2d13",
                                        "entry_id": "d2a19222-9714-3c33-89d5-f8409ef68299",
                                        "glosses": [
                                            "Siège de jardin, à plusieurs places, avec généralement un toit en tissu et des coussins assortis, mobile comme une balançoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb6b0910-36a1-44ce-b3d5-cf983f14c52c",
                                                "sense_id": "3e4f6e4c-8071-3bd9-8e42-567e86cd2d13",
                                                "text": "Carolyn se serait aussitôt attelée à la tâche, mais la balancelle sous le porche semblait l’appeler. Aussi s’accorda-t-elle quelques instants de repos. Elle se cala contre les coussins de la balancelle, le regard rivé sur la route."
                                            },
                                            {
                                                "example_id": "56740f5c-3c14-424c-8548-adb681fbc175",
                                                "sense_id": "3e4f6e4c-8071-3bd9-8e42-567e86cd2d13",
                                                "text": "Il s’approcha de la balancelle bleue installée au fond du jardin et d’un coup de talon se fit bercer. Les chaînes du divan suspendu grincèrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
