                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat sprong <w>bovenop</w> de hoge kast.",
                            "target_lang_translations": {
                                "en": "The cat jumped <w>on top of</w> the high cupboard.",
                                "ru": "Кошка запрыгнула <w>на</w> высокий шкаф.",
                                "pl": "Kot wskoczył <w>na</w> wysoką szafę.",
                                "de": "Die Katze sprang <w>oben auf</w> den hohen Schrank.",
                                "fr": "Le chat a sauté <w>sur</w> la haute armoire.",
                                "it": "Il gatto è saltato <w>sopra</w> l'alto armadio.",
                                "cs": "Kočka vyskočila <w>na</w> vysokou skříň.",
                                "tr": "Kedi yüksek dolabın <w>üzerine</w> atladı.",
                                "es": "El gato saltó <w>encima del</w> armario alto.",
                                "zh": "猫跳到了高柜子的<w>上面</w>。"
                            }
                        },
                        {
                            "text": "Leg de sleutels maar <w>bovenop</w> de stapel papieren.",
                            "target_lang_translations": {
                                "en": "Just put the keys <w>on top of</w> the stack of papers.",
                                "ru": "Положи ключи <w>поверх</w> стопки бумаг.",
                                "pl": "Połóż klucze <w>na wierzchu</w> stosu papierów.",
                                "de": "Leg die Schlüssel einfach <w>oben auf</w> den Papierstapel.",
                                "fr": "Pose les clés <w>sur</w> la pile de papiers.",
                                "it": "Metti pure le chiavi <w>in cima alla</w> pila di fogli.",
                                "cs": "Klíče prostě polož <w>navrch</w> hromady papírů.",
                                "tr": "Anahtarları kağıt yığınının <w>üzerine</w> bırak.",
                                "es": "Deja las llaves <w>encima de</w> la pila de papeles.",
                                "zh": "把钥匙放在那叠文件的<w>上面</w>就行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bovenop de kast",
