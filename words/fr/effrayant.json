            "senses": [
                {
                    "sense_id": "3b14bfb5-fa28-358d-9cb2-af8675972390",
                    "sense_definition": "Qui fait peur, qui inspire de l'effroi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont entendu un cri <w>effrayant</w> venant du fond du couloir obscur.",
                            "target_lang_translations": {
                                "en": "The children heard a <w>frightening</w> cry coming from the end of the dark corridor.",
                                "ru": "Дети услышали <w>страшный</w> крик, доносившийся из глубины тёмного коридора.",
                                "de": "Die Kinder hörten einen <w>unheimlichen</w> Schrei, der vom hinteren Ende des dunklen Flurs kam.",
                                "es": "Los niños oyeron un grito <w>espeluznante</w> que venía del fondo del pasillo oscuro.",
                                "zh": "孩子们听到从昏暗走廊深处传来一声<w>可怕</w>的叫声。"
                            }
                        },
                        {
                            "text": "Ce monstre porte un masque particulièrement <w>effrayant</w> qui terrifie tout le monde.",
                            "target_lang_translations": {
                                "en": "This monster wears a particularly <w>frightening</w> mask that terrifies everyone.",
                                "ru": "Это чудовище носит особенно <w>страшную</w> маску, которая всех пугает.",
                                "de": "Dieses Monster trägt eine besonders <w>furchterregende</w> Maske, die alle in Schrecken versetzt.",
                                "es": "Este monstruo lleva una máscara especialmente <w>aterradora</w> que aterroriza a todo el mundo.",
                                "zh": "这个怪物戴着一副格外<w>吓人</w>的面具，让所有人都感到害怕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "effroyable",
                        "glaçant"
                    ],
                    "common_phrases": [
                        "histoire effrayante",
                        "bruit effrayant"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing fear or dread; making someone feel frightened.",
                        "ru": "Вызывающий страх или ужас; заставляющий испытывать страх.",
                        "de": "Bei jemandem Angst oder Schrecken auslösend.",
                        "es": "Que causa miedo o inspira pavor.",
                        "zh": "使人感到害怕、心生恐惧的。"
                    },
