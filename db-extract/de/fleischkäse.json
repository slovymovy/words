                        "source_sense_id": "6a6b6cad-5cc1-320a-86a2-306b019a7546",
                        "source_sense_description": "eine achteckige Brühwurstsorte, die als Spezialität in Deutschland, Österreich und der Schweiz gilt",
                        "target_lang_word": "meatloaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meatloaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7a5bce-b18a-3b3b-9f52-082e2e5ddddc",
                                        "entry_id": "62932985-40fb-355f-8ff5-3c48d2484d97",
                                        "glosses": [
                                            "A dish of ground meat (usually made from ground beef, although lamb, pork, veal, venison, poultry and seafood are also used) formed into a loaf shape, mixed with egg and breadcrumbs, then baked or smoked, and usually served in slices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1918e5-4aae-4e69-bb7c-629ec6a9c9b5",
                                                "sense_id": "6d7a5bce-b18a-3b3b-9f52-082e2e5ddddc",
                                                "text": "For his meatloaf, he mixed the meat, eggs, chopped onion, breadcrumbs, tomato sauce and a can of beer according to the instructions, then diced in an apple he had lying around."
                                            },
                                            {
                                                "example_id": "5fce22f8-a5c5-42b6-b1a5-e1c5710f71ce",
                                                "sense_id": "6d7a5bce-b18a-3b3b-9f52-082e2e5ddddc",
                                                "text": "Meat Loaf.—Chop fine whatever cold meat you have, fat and lean together, add pepper, salt and finely chopped onion, two slices of bread which have been soaked in milk, and one egg mix well together and bake in form. This makes an admirable tea or breakfast dish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
