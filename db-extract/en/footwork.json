                        "entry_id": "9c765735-ccb5-3d97-b67f-a274f205f8a0",
                        "glosses": [
                            "Any movement of the feet, especially intricate or complex movement, as in sports or dancing."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8e46cefa-edfe-49d9-8294-64719783e801",
                                "sense_id": "c3b48077-662c-368f-a5a7-97410f4c993c",
                                "text": "The dancer impressed the crowd with his fancy footwork."
                            },
                            {
                                "example_id": "2f4ba619-3aa7-4899-9589-27b917904021",
                                "sense_id": "c3b48077-662c-368f-a5a7-97410f4c993c",
                                "text": "Everton defender Distin then demonstrated neat footwork to evade a succession of challenges inside the area before sending a rising, angled effort narrowly off target."
                            }
                        ]
                    },
                    {
                        "sense_id": "727d2774-cc4d-39dd-bfd5-a51ac10fce64",
                        "entry_id": "9c765735-ccb5-3d97-b67f-a274f205f8a0",
                        "glosses": [
                            "A subgenre of juke/ghetto house and style of street dance that originated in Chicago in the early 1990s."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "da5b7fb1-986d-48a9-947a-959fa7f587cd",
                                "sense_id": "727d2774-cc4d-39dd-bfd5-a51ac10fce64",
                                "text": "In April, DJ Rashad, a Chicago-based producer and pioneer of the increasingly popular footwork genre, died in a drug-related accident."
                            }
                        ]
                    }
                ],
