                        "glosses": [
                            "A practitioner of animal magnetism; a hypnotist."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "aed94ce3-d23f-4b59-be51-a0f2b987473f",
                                "sense_id": "94219382-7a4e-3921-a0f9-12880c0659d5",
                                "text": "From these delusions to those still more fashionable deceptions, practised by the whole tribe of magnetisers, the transition is very natural."
                            },
                            {
                                "example_id": "25bd9a67-4466-4d9d-92c6-ca6bc3949930",
                                "sense_id": "94219382-7a4e-3921-a0f9-12880c0659d5",
                                "text": "Many times a whole audience will not only be crowded into a small room, but are noisy disbelievers, call it all a humbug, distract the mind of the magnetizer, and added to these, absolutely outwill the magnetizer, in their wish to bring odium upon the science, and carry their points and gain their ends."
                            },
                            {
                                "example_id": "453b0623-e4cc-4c5d-8e27-c993de192bff",
                                "sense_id": "94219382-7a4e-3921-a0f9-12880c0659d5",
                                "text": "Mesmer had about a hundred people whom he had instructed as magnetisers, some of whom belonged to the nobility, who also \"mesmerised\" people by making passes over the affected parts of the body."
                            }
                        ]
                    },
                    {
                        "sense_id": "3987f1f2-7cb6-3273-8658-aef0ac79f2c8",
                        "entry_id": "4f3ddf08-abe4-3834-af2b-b1e80cbb3e10",
                        "glosses": [
                            "Someone or something that imparts magnetism."
                        ],
