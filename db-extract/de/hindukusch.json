                "senses": [
                    {
                        "sense_id": "0c60291b-9fe4-3eab-95f0-998a73a8d326",
                        "entry_id": "3bcd5d0d-7902-31d6-be0c-0335375bdfd8",
                        "glosses": [
                            "zentralasiatisches Gebirge in Afghanistan und Pakistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d9f671-0174-42d9-8a0f-89e2a938447d",
                                "sense_id": "0c60291b-9fe4-3eab-95f0-998a73a8d326",
                                "text": "Der höchste Gipfel des Hindukuschs ist der Tirich Mir mit 7708 Metern."
                            },
                            {
                                "example_id": "c89714a6-b933-4d7d-b59c-e0305c366455",
                                "sense_id": "0c60291b-9fe4-3eab-95f0-998a73a8d326",
                                "text": "„In der Mitte des 2. Jahrtausends v.Chr. dragen die vedischen Arier (Aria: die Edlen) über den Hindukusch und das westiranische Plateau in das Industal vor und besiegelten das Ende der Harappa-Kultur.“"
                            },
                            {
                                "example_id": "cbf64729-0110-4a8a-aab1-e8ea515dff51",
                                "sense_id": "0c60291b-9fe4-3eab-95f0-998a73a8d326",
                                "text": "„Seit dem Winter 1996/97 bekämpften sich die Taliban und die Nordallianz in Westafghanistan sowie an den strategisch wichtigen Pässen über den Hindukusch nördlich von Kabul.“"
                            },
                            {
                                "example_id": "f2c18e45-9a28-44df-9a77-77ef66a5cce0",
                                "sense_id": "0c60291b-9fe4-3eab-95f0-998a73a8d326",
                                "text": "„Von dort lief sie eifrig weiter, wie Wasser, das hangabwärts fließt, durch die Hügel und Täler des südlichen Hindukusch bis nach Pakistan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
