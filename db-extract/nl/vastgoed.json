                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "real estate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b2c2eb-82f3-37b0-81af-cf2bdd925939",
                                        "entry_id": "4e4611fe-4bda-3396-8909-9296ff073aed",
                                        "glosses": [
                                            "Property that cannot easily be moved, usually buildings and the ground on which they are built."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621c4e8f-50f2-4ead-a014-d116850f8ea7",
                                                "sense_id": "d4b2c2eb-82f3-37b0-81af-cf2bdd925939",
                                                "text": "They failed to find any investors for the construction of new real estate on the north side."
                                            },
                                            {
                                                "example_id": "bff2288e-86da-49d4-a921-ef317d853740",
                                                "sense_id": "d4b2c2eb-82f3-37b0-81af-cf2bdd925939",
                                                "text": "The \"Golden Horseshoe\", the commercial and industrial end of Lake Ontario, is the most crowded real estate in Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cdc293-f986-32bc-8557-c605a30dff7e",
                                        "entry_id": "4e4611fe-4bda-3396-8909-9296ff073aed",
                                        "glosses": [
                                            "Space used for a particular purpose."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aab07ea-c304-4a0a-9e1d-ce78237e95ec",
                                                "sense_id": "30cdc293-f986-32bc-8557-c605a30dff7e",
                                                "text": "Virtual desktops allow you to stretch your screen real estate well beyond its normal size."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
