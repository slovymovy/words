                ],
                "senses": [
                    {
                        "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                        "entry_id": "a80d94e4-b724-355a-97d6-0a655d6a70ac",
                        "glosses": [
                            "erstmals während einer Schwangerschaft auftretende Störung des Glucosestoffwechsels mit einer Glucosetoleranzstörung, die zu erhöhten Blutzuckerwerten der Mutter und in Folge dessen des Feten führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080b757a-8028-4a86-b293-0e78d155777f",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Eine konsequente Behandlung des Gestationsdiabetes kann diesen Komplikationen vorbeugen.“"
                            },
                            {
                                "example_id": "84e91f4f-32aa-443c-abf2-0a2eb250b67f",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Ein Gestationsdiabetes liegt definitionsgemäß vor, wenn einer von drei Blutzuckerparametern erreicht oder überschritten wird.“"
                            },
                            {
                                "example_id": "d9dfbc1e-345c-4548-921e-ebefbff7602e",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„2010 litten 3,7% aller Schwangeren an einem Gestationsdiabetes.“"
                            },
                            {
                                "example_id": "6b770d56-a616-490a-b2e4-82ee43b6987f",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Trotzdem haben Frauen mit Gestationsdiabetes ein höheres Risiko für einen späteren Diabetes mellitus und ihre Kinder ein erhöhtes Geburtsgewicht.“"
                            },
                            {
                                "example_id": "94ac8762-35c8-4f5a-8910-335f34431bf7",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Jedoch steigt der Anteil der Schwangeren mit Gestationsdiabetes aufgrund von zunehmender Adipositas und steigendem Gebäralter.“"
                            },
                            {
                                "example_id": "2f4530ad-7805-4160-aa95-a793b4b306c1",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Bisher gibt es lediglich Studien zu den Auswirkungen einer intensiven Betreuung von Schwangeren, bei denen Gestationsdiabetes diagnostiziert wurde.“"
                            },
                            {
                                "example_id": "136b598d-1e84-4021-aa18-4ef7eda03cdc",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Der Gestationsdiabetes mellitus (GDM) ist eine der häufigsten Komplikationen während der Schwangerschaft; in Deutschland waren im Jahr 2014 rund 4,5 Prozent aller Schwangeren davon betroffen.“"
                            },
                            {
                                "example_id": "a62ec066-d58d-4649-8347-291d9ef70f5a",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Bei normalen Blut- und Urintests lässt sich der so genannte Gestationsdiabetes nicht erkennen.“"
                            },
                            {
                                "example_id": "b9ea8944-baa7-40c3-91e0-9e8aab86677e",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Mit dem Verzehr von Äpfeln können werdende Mütter außerdem einem Schwangerschaftsdiabetes vorbeugen: Jede zusätzliche Portion Apfel pro Tag verringert das Risiko von Gestationsdiabetes um 25 Prozent, ermittelten amerikanische Epidemiologen.“"
                            },
                            {
                                "example_id": "61354413-ed83-4b2c-b1a1-0fe54c06673a",
                                "sense_id": "ba6f5b5a-52d2-33fa-81df-789af03f89fa",
                                "text": "„Ernährt sich die werdende Mutter überwiegend von raffinierten Kohlenhydraten, also Weißmehl und weißem Zucker, kann das die Entstehung eines Gestationsdiabetes begünstigen, der weitreichende Folgen für Mutter und Kind hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
