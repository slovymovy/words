                        "glosses": [
                            "Oberfläche, die aus dem Material Sand besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e798cba-fe02-4bdf-8255-7293cb5d57e1",
                                "sense_id": "f118e15f-67c2-385d-8f8f-b6d8ca4eb8c8",
                                "text": "„Etwas höher, etwa 7–8 m über dem Flusse, folgen die Sandflächen der Niederterrasse, die im allgemeinen nicht von Schlicken bedeckt sind und keine gewundenen Altläufe und sehr wenige Rinnen enthalten.“"
                            },
                            {
                                "example_id": "b7aabbbb-7c7f-4ffc-9ee0-578b1876c557",
                                "sense_id": "f118e15f-67c2-385d-8f8f-b6d8ca4eb8c8",
                                "text": "„In eine flache, vom Meer vollkommen nivellierte Sandfläche steckte er einen 2 m langen Stock und neigte ihn etwas nach Süden, von der Sonne weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
