                        "examples": [
                            {
                                "example_id": "297d18d6-86e3-4d6a-ad8f-b5ea55105648",
                                "sense_id": "e78647f6-bf92-36e3-ad30-446551c20420",
                                "text": "De snelle sportauto liet een grote stofwolk achter toen hij over de zandweg reed."
                            },
                            {
                                "example_id": "2dbfd4d8-6b02-4dda-b2be-84ddcc97641d",
                                "sense_id": "e78647f6-bf92-36e3-ad30-446551c20420",
                                "text": "Ik blies mijn rook uit in de richting van het stofwolkje dat de taxi als herinnering had achtergelaten in de verte aan het einde van de oprijlaan, waar het bos begon."
                            },
                            {
                                "example_id": "eee8ae84-6d88-454c-9d29-9100f8bdebbb",
                                "sense_id": "e78647f6-bf92-36e3-ad30-446551c20420",
                                "text": "Een jonge jongen in een Schotse rok kwam keihard in een stofwolk de berg af rennen en sprong onmiddellijk op Pogues rug."
                            }
                        ]
                    }
