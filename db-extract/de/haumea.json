                                        "glosses": [
                                            "A dwarf planet with two known moons orbiting in the Kuiper belt, roughly one-third the mass of Pluto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3cef936-c43a-4469-aba2-0a1a3548b237",
                                                "sense_id": "180e5988-66a1-3c9a-a97a-d190d7c49155",
                                                "text": "Deep searches for regular satellites around Kuiper belt objects are difficult due to observational limitations, but Haumea is one of the few for which sufficient data exist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
