                ],
                "senses": [
                    {
                        "sense_id": "5259318f-ca97-30f9-bd3b-e7f18d8b430f",
                        "entry_id": "33723497-c2b8-350c-9611-7898f1f8a202",
                        "glosses": [
                            "innerhalb der angesprochenen Galaxie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55563015-9ba0-4122-9942-8bbb12f35855",
                                "sense_id": "5259318f-ca97-30f9-bd3b-e7f18d8b430f",
                                "text": "„Die innergalaktische Schwerkraft ist auf Dauer keineswegs in der Lage, alle Sterne mit ihre Eigenbewegungen und die ganze sonstige Materie und Strahlung in einer Galaxie so im Zaum zu halten, dass die Struktur Bestand hat.“"
                            },
                            {
                                "example_id": "9eeeaeed-30bc-42b6-bd2f-e4efa8465309",
                                "sense_id": "5259318f-ca97-30f9-bd3b-e7f18d8b430f",
                                "text": "„Hin und wieder gelingt es dem innergalaktischen Schwarzen Loch dennoch, etwas Materie in seinen Bann zu ziehen und kurzfristig seinen Appetit zu stillen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
