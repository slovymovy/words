                "senses": [
                    {
                        "sense_id": "45b56416-0b79-32f9-8350-68da1e4f180c",
                        "entry_id": "6e6f9549-16be-3e90-8d4d-62319624f155",
                        "glosses": [
                            "ablehnende Haltung; verachtende Bemerkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbe0edd-ea6c-4e6e-bc05-8b98c5018e04",
                                "sense_id": "45b56416-0b79-32f9-8350-68da1e4f180c",
                                "text": "„Vielleicht ist es die Art, wie er weggeht, diese Abfälligkeit ihr gegenüber, die sie nach der Teetasse greifen und sie nach ihm werfen läßt.“"
                            },
                            {
                                "example_id": "e203a0e4-0aa0-41bb-be76-8ff801fcfd8d",
                                "sense_id": "45b56416-0b79-32f9-8350-68da1e4f180c",
                                "text": "„In seiner Miene war nichts von Verachtung, Abfälligkeit oder gar Ekel zu erkennen.“"
                            },
                            {
                                "example_id": "60358dc7-82db-4ff3-a313-e88f500031d2",
                                "sense_id": "45b56416-0b79-32f9-8350-68da1e4f180c",
                                "text": "„Theodor stellte seine Frage mit einem kaum wahrnehmbaren Hauch von Abfälligkeit in seiner Stimme.“"
                            },
                            {
                                "example_id": "ce2ff5a0-d401-447e-8436-bbf6416b8703",
                                "sense_id": "45b56416-0b79-32f9-8350-68da1e4f180c",
                                "text": "„Ihre Stimme verlor eine Spur Abfälligkeit, als sie hinzufügte: ‚Jetzt hoffe ich für dich, du warst erfolgreich.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
