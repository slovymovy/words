                                        "glosses": [
                                            "coinvolgimento in ciò che è bene o male oppure il trattenersi in situazioni in cui potrebbero verificarsi tentazione e/o trasgressioni e peccati"
                                        ],
                                        "tags": [],
                                        "examples": [
