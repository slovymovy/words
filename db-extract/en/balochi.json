                        "target_lang_word": "Belutschisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belutschisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cada9ca1-628f-3e2d-ac0d-d313cd6d260f",
                                        "entry_id": "6f23029d-20a1-3634-93e9-eeed8074457f",
                                        "glosses": [
                                            "eine iranische Sprache, die vor allem in Pakistan, aber auch in Teilen des Irans sowie Afghanistans vom Volk der Belutschen gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5455ecd-7361-4c6f-8d84-864c35054fe2",
                                                "sense_id": "cada9ca1-628f-3e2d-ac0d-d313cd6d260f",
                                                "text": "„Soviel Belutschisch habe ich damals noch nicht verstanden.“"
                                            },
                                            {
                                                "example_id": "0eb7d947-dc5c-4fd3-b92b-20db7ae88cff",
                                                "sense_id": "cada9ca1-628f-3e2d-ac0d-d313cd6d260f",
                                                "text": "„Daneben werden Turksprachen, Kurdisch, Arabisch, Belutschisch und weitere Sprachen gesprochen.“"
                                            },
                                            {
                                                "example_id": "8cee908e-05db-4021-9715-de95aafcc9bd",
                                                "sense_id": "cada9ca1-628f-3e2d-ac0d-d313cd6d260f",
                                                "text": "„[…] und nach Friedrich Müllers Urtheil sich näher an die eranischen als an die indischen Sprachen anschliessen, während Spiegel nur das Belutschische als entschieden eranisch bezeichnet.“"
                                            },
                                            {
                                                "example_id": "f466f7b2-da35-43a2-811f-938c0b4f5838",
                                                "sense_id": "cada9ca1-628f-3e2d-ac0d-d313cd6d260f",
                                                "text": "„Weitere stark verbreitete Sprachen sind Usbekisch und Turkmenisch in Nordafghanistan und Belutschisch im Süden des Landes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
