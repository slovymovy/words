                    },
                    {
                        "form_id": "a500cd4a-28e0-41f1-b786-281b85b52b18",
                        "entry_id": "ed110c28-1554-32bf-b59f-67b42172c50a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Nipponne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9f79deb-2987-3d6b-9e5a-727f6afacae8",
                        "entry_id": "ed110c28-1554-32bf-b59f-67b42172c50a",
                        "glosses": [
                            "Japonais. Habitant du Japon."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "12025d98-6932-4dd3-8301-319bf5270731",
                                "sense_id": "e9f79deb-2987-3d6b-9e5a-727f6afacae8",
                                "text": "Pour la troisième fois dans la journée, il venait de changer de blanc avant d’aller retrouver les Nippons à leur rendez-vous habituel."
                            },
                            {
                                "example_id": "32057542-8f08-4a7b-a63a-c011813f632a",
                                "sense_id": "e9f79deb-2987-3d6b-9e5a-727f6afacae8",
                                "text": "D’ailleurs, la brasserie de Yokohama vend sa bière à raison de 2 yens par douzaine de bouteilles, soit 8 yens la caisse de quatre douzaines, au détail. Les Nippons, eux, doivent céder la leur à bien meilleur marché."
                            },
                            {
                                "example_id": "2e2bbbd0-53b0-42c8-8498-89ec8c0e5ac4",
                                "sense_id": "e9f79deb-2987-3d6b-9e5a-727f6afacae8",
                                "text": "– Il est japonais maintenant. Personne à Nagano ne sait qu’il est coréen. Sa femme et ses enfants non plus. Tout le monde pense que c’est un Nippon de pure souche."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
