                    {
                        "translation_id": "e1e166eb-be95-4221-8723-0551ccc2788c",
                        "source_entry_id": "c85b4e6a-c164-3be6-968f-37b1cde1b9c7",
                        "source_sense_description": "a section of the stem between two nodes",
                        "target_lang_word": "Internodium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Internodium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbfd2e1-68de-37d1-b630-a2604ca4cf40",
                                        "entry_id": "8e7c379c-06e3-3fbe-8e51-dae78eeca800",
                                        "glosses": [
                                            "Stück der Sprossachse zwischen zwei Ansatzstellen der Blätter (Nodien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a6b11c-7896-466d-9841-3383be457743",
                                                "sense_id": "0fbfd2e1-68de-37d1-b630-a2604ca4cf40",
                                                "text": "Der Blütenstand ist mit dem Internodium und der Blattscheide verwachsen."
                                            },
                                            {
                                                "example_id": "a17d7010-6fc8-4772-97b9-1046b11e7fc3",
                                                "sense_id": "0fbfd2e1-68de-37d1-b630-a2604ca4cf40",
                                                "text": "Die Internodien der Langtriebe, die bei den Bäumen und Sträuchern das Längenwachstum bewirken, sind länger als die Kurztriebe."
                                            },
                                            {
                                                "example_id": "b148488c-907a-4e6c-9469-490dc6a00d08",
                                                "sense_id": "0fbfd2e1-68de-37d1-b630-a2604ca4cf40",
                                                "text": "Die Internodien der Sprossachsen sind bei fast allen Arten [von Ameisenbäumen] hohl und tragen nur am Rand eine dünne Schicht eines weißen, weichen Marks."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3920d98-9664-343d-9f42-14fd422596f1",
                                        "entry_id": "8e7c379c-06e3-3fbe-8e51-dae78eeca800",
                                        "glosses": [
                                            "myelinisierter Abschnitt eines Axons zwischen zwei Ranvierschen Schnürringen"
                                        ],
                                        "tags": [
                                            "Neuroanatomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2272b406-6237-4f36-ad70-2311aef3feb8",
                                                "sense_id": "f3920d98-9664-343d-9f42-14fd422596f1",
                                                "text": "Die Kontaktfläche des Myelins mit dem Axon wird untergliedert in Internodium, Paranodium und Juxtaparanodium, die jeweils besonders molekular spezialisiert sind."
                                            },
                                            {
                                                "example_id": "fea8c96c-07d1-4b9e-8d35-77981e2ed84b",
                                                "sense_id": "f3920d98-9664-343d-9f42-14fd422596f1",
                                                "text": "Bis zu diesem letzten Knotenpunkt ist die Umhüllung des Axons noch von einer Basalmembran umgeben und zählt zum peripheren Nervensystem, das nun folgende Internodium hat keine Basalmembran mehr und markiert den Anfang des zentralen Nervensystems."
                                            },
                                            {
                                                "example_id": "fabb25f2-c4df-4125-8f92-1752c3a2b453",
                                                "sense_id": "f3920d98-9664-343d-9f42-14fd422596f1",
                                                "text": "Liegt ein Internodium im mittleren Kompartiment, so findet man beim Annähern des Aktionspotentials an das Internodium und beim Verlassen des Internodiums nur einen Ausstrom aus dem Kompartiment und keinen Einstrom (nach Tasaki, 1959)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
