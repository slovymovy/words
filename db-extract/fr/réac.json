                        ],
                        "examples": [
                            {
                                "example_id": "b32ca845-cc75-428e-95b6-66070bf94657",
                                "sense_id": "3d91ff6d-5240-31be-b54a-6309ebe63ec5",
                                "text": "Je suis peut-être devenu réactionnaire sur certains domaines. J’ai un côté conservateur. Mais ce livre n’est pas réac, c’est simplement le livre d’un écrivain qui cherche un sens à ce qu’est être un homme aujourd’hui."
                            }
                        ]
                    }
