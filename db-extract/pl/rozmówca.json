                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f030b5c4-5403-46a7-9efa-976f026d9dcf",
                                "sense_id": "b789a754-aa21-3abc-8334-a135c5e34b33",
                                "text": "Brodziak odbezpieczył pistolet i wycelował w głowę rozmówcy"
