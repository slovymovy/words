                ],
                "senses": [
                    {
                        "sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                        "entry_id": "53dd05ad-705b-3e46-9d5a-26ae85eb6316",
                        "glosses": [
                            "Artère qui sort du ventricule gauche du cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628e104e-9623-4ce1-b5e1-18cb5c87f4d1",
                                "sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                                "text": "L'anévrisme de l’aorte."
                            },
                            {
                                "example_id": "9d53ae15-b6f9-4452-b734-1744c6d1cbe2",
                                "sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                                "text": "Moi, je suis au bout de mon rouleau, Mademoiselle, j’ai le cœur malade : l’aorte, ils appellent ça. Enfin, un vieux soufflet crevé, voilà ce que je suis."
                            },
                            {
                                "example_id": "fbbac1ac-419d-4b79-81ca-15c6adf5ff9b",
                                "sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                                "text": "Lʼévolution spontanée se fait rarement vers la stabilisation de la lésion ; il y a, en général, distension puis rupture de lʼaorte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b039ccc-05fb-46fd-ad64-145ebe13006f",
                        "source_entry_id": "53dd05ad-705b-3e46-9d5a-26ae85eb6316",
                        "source_sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                        "target_lang_word": "Aorta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aorta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b455fd9-3890-3d97-bb24-94f22f5fc4e9",
                                        "entry_id": "524fd967-d5c0-3076-a521-e6bcf8c781d5",
                                        "glosses": [
                                            "die Hauptschlagader (auch die große Körperschlagader genannt), ein Blutgefäß, das direkt auf der linken Seite des Herzens entspringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd160f19-79d0-4c82-8a75-68c8e97620d8",
                                                "sense_id": "6b455fd9-3890-3d97-bb24-94f22f5fc4e9",
                                                "text": "„Beim erwachsenen Menschen hat die Aorta in der Regel einen Durchmesser von etwa 2,5–3,5 cm und eine Länge von 30–40 cm.„"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c762315-ae95-4f12-9cf8-0beeca645928",
                        "source_entry_id": "53dd05ad-705b-3e46-9d5a-26ae85eb6316",
                        "source_sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                        "target_lang_word": "Hauptschlagader",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptschlagader",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1353c849-9c40-3bfb-8785-bdfc304082fd",
                                        "entry_id": "a6dacd18-896e-3c0a-9819-30557b802d86",
                                        "glosses": [
                                            "Arterie, die direkt auf der linken Seite des Herzens entspringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b300f330-6d79-46ed-97e4-3e81fdb2e056",
                                                "sense_id": "1353c849-9c40-3bfb-8785-bdfc304082fd",
                                                "text": "„Das Starttempo gibt das Herz vor: Indem es sich kräftig zusammenzieht, presst es Blut aus seiner linken Hauptkammer in die Hauptschlagader.“"
                                            },
                                            {
                                                "example_id": "a77624a5-c8b1-4962-90ab-a2c3ce3732a5",
                                                "sense_id": "1353c849-9c40-3bfb-8785-bdfc304082fd",
                                                "text": "„Von den Lungen aus gelangt das Blut aus den beiden Lungenvenen in den linken Vorhof, dann in die linke Herzkammer, von dort aus wird es über die Hauptschlagader (Aorta) in den Körperkreislauf gepumpt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b74b143-7f9f-4fcf-9744-53aff33f2402",
                        "source_entry_id": "53dd05ad-705b-3e46-9d5a-26ae85eb6316",
                        "source_sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
                        "target_lang_word": "große Pulsader",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e158c5b1-bee1-4b3f-898e-5952a27e4d63",
                        "source_entry_id": "53dd05ad-705b-3e46-9d5a-26ae85eb6316",
                        "source_sense_id": "0f08a49e-c1a1-3d8b-8bc0-a1c823bda157",
