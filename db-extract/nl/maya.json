                "senses": [
                    {
                        "sense_id": "6a1e10c3-a678-3728-8043-8c4f901602cc",
                        "entry_id": "e2517eb0-d76f-3002-9ebd-8e70756103fc",
                        "glosses": [
                            "groep talen uit Midden- en Zuid-Amerika"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "59a2ba93-8f2f-4b43-a3b8-5b8e5ad69f8c",
                                "sense_id": "6a1e10c3-a678-3728-8043-8c4f901602cc",
                                "text": "„Veel mensen uit Guatemala spreken alleen Maya”, zegt Ceci Herrera, directeur van buurtwerkorganisatie CEPCO."
                            },
                            {
                                "example_id": "c13146af-dc38-45a3-96a9-69535065495a",
                                "sense_id": "6a1e10c3-a678-3728-8043-8c4f901602cc",
                                "text": "Vlakbij Tulum vind je het biosfeerreservaat van Sian Ka’an. Deze naam komt uit het Maya en betekend letterlijk ‘geschenk uit de hemel’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbb9bd7b-077d-4fa5-ac29-6c6659642dbd",
                        "source_entry_id": "e2517eb0-d76f-3002-9ebd-8e70756103fc",
                        "source_sense_id": "6a1e10c3-a678-3728-8043-8c4f901602cc",
                        "target_lang_word": "Maya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0090cc3e-e269-3e6d-a8fd-14d89f7acdd0",
                                        "entry_id": "29ef6189-8769-3310-b8c0-aa9d56cb092a",
                                        "glosses": [
                                            "In Sanskrit, illusion; God's physical and metaphysical creation (literally, \\\"not this\\\")."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afbd3859-134c-3a34-8488-7e688440f9be",
                                        "entry_id": "29ef6189-8769-3310-b8c0-aa9d56cb092a",
                                        "glosses": [
                                            "A female given name from Sanskrit used in India."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94e173d-269d-4e97-91cf-a9a97b7dad9d",
                                                "sense_id": "afbd3859-134c-3a34-8488-7e688440f9be",
                                                "text": "Eventually, Pran and Savita decided by correspondence on Maya. Its two simple syllables meant, among other things: the goddess Lakshmi, illusion, fascination, art, the goddess Durga, kindness, and the name of the mother of Buddha. It also meant: ignorance, delusion, fraud, guile, and hypocrisy; but no one who named their daughter Maya ever paid any attention to those pejorative possibilities.\n- - - 'Why ever not, Ma?' said Meenakshi.'It's a very Bengali name, a very nice name.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Maya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f85a3fec-571d-3aae-8431-8f8f34f5ae96",
                                        "entry_id": "9f930c36-ecf8-37b9-a3cd-53d51a7ba160",
                                        "glosses": [
                                            "A female given name from Hebrew of modern usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86dc3ee-eb3d-4cc8-ae70-c9db1e944b4f",
                                                "sense_id": "f85a3fec-571d-3aae-8431-8f8f34f5ae96",
                                                "text": "When her little friends asked her what her name was, her father replied that it was Conchita - his diminutive for Maria de la Concepción. \"Con-what?\" they would ask again, aware, apparently, that con in French is a fool, an idiot. So her parents started calling her Maria, which from the little girl's lips soon began to sound like Maya. \"Maya!\" exclaimed her father. \"It's perfect. It means the greatest illusion on earth.\" So Maya it was from then on - Maya Walter."
                                            }
                                        ]
                                    }
                                ]
                            },
