                    ],
                    "common_phrases": [
                        "perturber le métabolisme",
                        "perturber le sommeil"
                    ],
                    "target_lang_definitions": {
                        "en": "To upset or impair the normal functioning of a mechanism, body, or system.",
                        "ru": "Нарушать нормальную работу механизма, организма или системы.",
                        "de": "Die normale Funktionsweise eines Mechanismus, Organismus oder Systems beeinträchtigen oder stören.",
                        "es": "Desajustar o perjudicar el funcionamiento normal de un mecanismo, un organismo o un sistema.",
                        "zh": "使机器、生物机体或系统的正常运作受到干扰而失常。"
