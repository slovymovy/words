                                    {
                                        "sense_id": "2604d740-d168-3cef-9345-59e2f016eb84",
                                        "entry_id": "f078377b-ea44-3c19-bf3d-027d565f9a9f",
                                        "glosses": [
                                            "The practice of hiding messages, so that the presence of the message itself is hidden, often by writing them in places where they may not be found until someone finds the secret message in whatever is being used to hide it."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f149ab3-3233-3893-b16a-62887d4a7a17",
                                        "entry_id": "f078377b-ea44-3c19-bf3d-027d565f9a9f",
                                        "glosses": [
                                            "Specifically: the use of small computer files to communicate secret information."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb07df57-ece0-4fb1-8443-5564ca6e5354",
                        "source_entry_id": "45d494f1-f611-3389-9220-79392a0acdc4",
                        "source_sense_id": "baeb6fe4-e318-3523-949f-bc7e8e89bec5",
                        "source_sense_description": "Kunst und Wissenschaft der verborgenen Speicherung oder Übermittlung von Informationen",
                        "target_lang_word": "stéganographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stéganographie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8800b4d5-bf25-35df-951d-5a059ecbd924",
                                        "entry_id": "0f6a0352-cf53-3f37-ad31-32240c57b919",
                                        "glosses": [
                                            "Art de dissimuler un message, d’utiliser diverses méthodes pour cacher quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6e6ccd-1e63-40fd-bf29-d8a2892a8ce8",
                                                "sense_id": "8800b4d5-bf25-35df-951d-5a059ecbd924",
                                                "text": "Sauf si l’État censeur interdit tout trafic crypté ! Dans ce cas, l’ultime solution est la stéganographie, qui consiste à dissimuler le message « interdit » dans un autre, anodin."
                                            },
                                            {
                                                "example_id": "8fa5012f-a61c-4fa4-939b-c8746068975b",
                                                "sense_id": "8800b4d5-bf25-35df-951d-5a059ecbd924",
                                                "text": "On appelle stéganographie cette méthode qui consiste à rendre inaperçu un message dans un autre message. Un exemple célèbre … est celui du roi de Sparte Démarate, qui grava son message sur le bois de sa tablette et fit couler ensuite la cire dessus, si bien qu'elle paraissait vierge."
                                            }
                                        ]
                                    }
                                ]
