                ],
                "senses": [
                    {
                        "sense_id": "6388d427-017e-351f-90b7-0642ba7e77a2",
                        "entry_id": "f2d3b021-c47c-3b56-8773-4f8f875f5304",
                        "glosses": [
                            "начать жужжать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c5a3b6-4b94-47ef-9ff9-be690ced9c0c",
                                "sense_id": "6388d427-017e-351f-90b7-0642ba7e77a2",
                                "text": "Прошло четверть часа, и на смену его басу зажужжал сиплый тенорок бухгалтера."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd9a3b33-d92c-4580-a3c2-f849f8503fc7",
                        "source_entry_id": "f2d3b021-c47c-3b56-8773-4f8f875f5304",
                        "source_sense_id": "6388d427-017e-351f-90b7-0642ba7e77a2",
                        "target_lang_word": "bourdonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourdonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42697a1-ea10-3817-a936-a0cfa3621157",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Émettre un bourdonnement en parlant principalement des battements d’ailes des insectes, des petits oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25cd3245-bf25-4d66-a1c0-720c33369495",
                                                "sense_id": "d42697a1-ea10-3817-a936-a0cfa3621157",
                                                "text": "Et soudain, au chocs des pots, aux grincements de la guitare, au rire des servantes, au brouhaha de la foule, succéda un silence à travers lequel eût bourdonné le vol d’une mouche."
                                            },
                                            {
                                                "example_id": "35b73e2d-da2e-4c3a-b3a8-1808f31d9381",
                                                "sense_id": "d42697a1-ea10-3817-a936-a0cfa3621157",
                                                "text": "De cette façon, ils ne perdirent pas de vue les abeilles […] ; elles entrèrent après avoir bourdonné un moment, dans un trou situé à plus de quatre-vingts pieds du sol."
                                            },
                                            {
                                                "example_id": "e710f690-f7da-48dc-ba1a-e4a72e854215",
                                                "sense_id": "d42697a1-ea10-3817-a936-a0cfa3621157",
                                                "text": "Les colibris bourdonnent autour de cet arbrisseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e275d69-ce30-3f4e-8f40-cbd0d49c1054",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Fait qu’un objet, qu’une machine, qu’une surface émette des vibrations plus ou moins sonores."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bada4e98-1741-4c02-af4a-3172472d054e",
                                                "sense_id": "7e275d69-ce30-3f4e-8f40-cbd0d49c1054",
                                                "text": "Tu m’as dit avoir éteint le moteur pourtant je l’entends bourdonner."
                                            },
                                            {
                                                "example_id": "ff39f7ce-dd45-4cba-86cb-a88eae9a66b3",
                                                "sense_id": "7e275d69-ce30-3f4e-8f40-cbd0d49c1054",
                                                "text": "Le sol bourdonne c’est à cause des travaux à proximité."
                                            },
                                            {
                                                "example_id": "8561d681-cd88-4078-a858-6db7904eb83c",
                                                "sense_id": "7e275d69-ce30-3f4e-8f40-cbd0d49c1054",
                                                "text": "La lumière a ses chants.\nC’est pour leur cri que j’aime les feux.\nAlors que les mèches des chandelles durant des siècles grésillèrent, le fil électrique bourdonne.\nPartout on retrouve ce bourdon propre à la lumière électrique dans le monde.\nC’est la « tonalité » du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f56ce0-d12f-390f-ba0b-8d6773f0cefa",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Quand un grand nombre de personnes émettent un murmure sourd et confus en discutant entre elles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c1feb0-9f99-4474-a36b-f064a332613d",
                                                "sense_id": "81f56ce0-d12f-390f-ba0b-8d6773f0cefa",
                                                "text": "Lorsqu’elle passait, ils bourdonnaient de médisance."
                                            },
                                            {
                                                "example_id": "1c3168c1-3784-4e25-acb0-7859d9b4954c",
                                                "sense_id": "81f56ce0-d12f-390f-ba0b-8d6773f0cefa",
                                                "text": "Je perdis la connaissance et le sentiment : j’entendais seulement bourdonner autour de moi des voix confuses et lointaines ; soit qu’elles parlassent, soit que les oreilles me tintassent, je ne distinguais rien que ce tintement qui durait."
                                            },
                                            {
                                                "example_id": "6f1d5514-a3f9-46d7-b0ed-8bcd7e8e6107",
                                                "sense_id": "81f56ce0-d12f-390f-ba0b-8d6773f0cefa",
                                                "text": "Quand il eut cessé de parler, on entendit bourdonner toute l’assemblée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a0f791-4a58-3ff3-88d5-fb685fb3f157",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Ressentir un bruit sourd et lancinant dans sa tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723a9e25-9b2c-4f63-8afb-5ed36b303939",
                                                "sense_id": "46a0f791-4a58-3ff3-88d5-fb685fb3f157",
                                                "text": "Les oreilles me bourdonnent ou alors j’ai les oreilles qui bourdonnent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8cba40-3907-3726-b69e-8eaab5f54e8e",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "S’agiter, bouillonner en parlant d’un lieu ou de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f26d79d-6d87-4675-96cc-501381d1510e",
                                                "sense_id": "6b8cba40-3907-3726-b69e-8eaab5f54e8e",
                                                "text": "— Eh bien ! Ça bourdonne dans les locaux de la direction. Qu’est-ce qui se passe ?\n— Visite surprise de l’inspection du travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c93ccf4-e73b-3817-9bb7-116ec9afdfd1",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Fredonner une chanson à mi-voix entre ses dents."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2e2b49-78b0-481e-b358-cbe9e9463d9e",
                                                "sense_id": "4c93ccf4-e73b-3817-9bb7-116ec9afdfd1",
                                                "text": "Il bourdonne toujours quelques vieux airs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02691fc7-36b0-37b2-bd20-4de076d5aeca",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Importuner par des paroles, des lamentations, des discours."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "159411ec-b3e0-4cde-8323-012775a2a17d",
                                                "sense_id": "02691fc7-36b0-37b2-bd20-4de076d5aeca",
                                                "text": "Que venez-vous nous bourdonner sans cesse ?"
                                            },
                                            {
                                                "example_id": "833bd341-67f7-4cfc-9219-b82ffb521fea",
                                                "sense_id": "02691fc7-36b0-37b2-bd20-4de076d5aeca",
                                                "text": "Il nous bourdonne ses soucis mais peu l’écoutent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d373bf-1e95-3cc1-972a-d33bf2609d05",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Faire résonner une cloche sans la sonner en branle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30dda414-1f38-44bc-b553-e70eb737c434",
                                                "sense_id": "b5d373bf-1e95-3cc1-972a-d33bf2609d05",
                                                "text": "Les cloches bourdonnent sourdement dans la tour pour le moine qui vient d’expirer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81a3b6b1-63bc-3449-98ed-df7de9b68a4b",
                                        "entry_id": "382e4518-2547-3f2a-8ca1-0088a64d5826",
                                        "glosses": [
                                            "Émettre un bourdon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec37dce8-172d-444e-b2f0-b675f1b155a7",
                                                "sense_id": "81a3b6b1-63bc-3449-98ed-df7de9b68a4b",
                                                "text": "Deux cordes de la vielle bourdonnent un fond sonore car elles ne sont pas affectées par les touches contrairement aux autres qui servent à jouer la mélodie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
