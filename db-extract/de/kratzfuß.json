                "senses": [
                    {
                        "sense_id": "6e47f805-e11f-347d-887a-5b33e4a2ef71",
                        "entry_id": "22828858-2db6-3864-b3ac-fa3f83599894",
                        "glosses": [
                            "bow and scrape (deep formal bow with one's right foot scraping backwards and one's left hand lain across the belly)"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ccbca31d-3a2b-4bd4-b91e-743c54dfff10",
                                "sense_id": "6e47f805-e11f-347d-887a-5b33e4a2ef71",
                                "text": "„Hab’ ich gemerkt“, sagte Wulckow; und indes Diederich abwechselnd ihm und seiner Frau dankerfüllte Kratzfüße machte, setzte der Präsident hinzu: „Bleiben wir lieber gleich beim Büfett.“"
                            }
                        ]
                    }
