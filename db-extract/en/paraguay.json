                                                "example_id": "8497261a-b2cf-4d67-bc0a-c0a90bbe0257",
                                                "sense_id": "b85227ad-781d-3daf-bc6b-1a70fd414efc",
                                                "text": "Asunción ist die Hauptstadt von Paraguay."
                                            },
