                        "sense_id": "892b1cf5-f587-368d-a171-027ace72d890",
                        "entry_id": "4a1a9803-1bb9-36d7-9b85-379146be3342",
                        "glosses": [
                            "Répartition d'un espace en plusieurs zones."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "f87c72e9-ea99-4b45-a8be-b217e6f1945a",
                                "sense_id": "892b1cf5-f587-368d-a171-027ace72d890",
                                "text": "Mais, plutôt que d'essayer de définir dès ce stade des zones de vocations culturales précises, il faut s'arrêter à une zonification des principales contraintes à la mise en valeur."
                            },
                            {
                                "example_id": "f4409a00-f82f-44f1-9fc6-c28acf16ad7f",
                                "sense_id": "892b1cf5-f587-368d-a171-027ace72d890",
                                "text": "Ces prises de positions se concrétiseront par un décret datant de juillet 1972 qui fixera pour la première fois une zonification des exonérations fiscales."
                            },
                            {
                                "example_id": "dbb2d39e-d624-47b8-8170-3588bb3b4f8e",
                                "sense_id": "892b1cf5-f587-368d-a171-027ace72d890",
                                "text": "En dépit de cette relative transparence, les cartes en donnent une interprétation floue, infléchie par l'échelle choisie, les discrétisations retenues, les zonifications changeantes."
                            }
                        ]
                    }
