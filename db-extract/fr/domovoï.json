                "senses": [
                    {
                        "sense_id": "b516f699-434c-3f60-99cd-58fb4b5d904a",
                        "entry_id": "429290da-897b-328b-8645-48173ab442a3",
                        "glosses": [
                            "Génie domestique du folklore russe."
                        ],
                        "tags": [
                            "Mythologie slave"
                        ],
                        "examples": [
                            {
                                "example_id": "b5eb0bd8-1151-49bd-9547-0307c6f7e625",
                                "sense_id": "b516f699-434c-3f60-99cd-58fb4b5d904a",
                                "text": "Je regarde le décolleté de maman, ses bras nus dorés, bronzés, et tout à coup en moi un diablotin, un petit esprit malicieux, comme les « domovoï » qui jouent toutes sortes de farces dans les maisons, m’envoie cette giclée, cette idée : « Maman a la peau d’un singe. »"
                            },
                            {
                                "example_id": "a2b85bde-f685-4f10-a863-6ba416887e13",
                                "sense_id": "b516f699-434c-3f60-99cd-58fb4b5d904a",
                                "text": "Le domovoï est une sorte de poltergeist, petit être espiègle qui, dans le folklore slave, est le vrai maître et protecteur du foyer (la racine du mot est dom, qui signifie « maison »)."
                            }
                        ]
                    }
                ],
