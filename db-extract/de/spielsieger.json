                "senses": [
                    {
                        "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                        "entry_id": "e7b86d8e-d62b-3fae-a7a5-40d69db012bf",
                        "glosses": [
                            "Person, Partei oder Mannschaft, die bei einem Wettspiel gewonnen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e561da-500e-4321-a7f9-d0de02c39585",
                                "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                                "text": "„Wer am Ende der Reise (also nach 24-maligem Würfeln) die höchste Gesamtpunktzahl aufweist, ist Spielsieger.“"
                            },
                            {
                                "example_id": "f9e4d4a1-5938-4ba3-a074-43ee5be7610e",
                                "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                                "text": "„Zur Ermittlung des Spielsiegers wird nicht die Selbsteinschätzung herangezogen."
                            },
                            {
                                "example_id": "7c0a3660-2526-43d4-a692-869cf03f0be7",
                                "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                                "text": "„Spielsieger ist die Partei, die den Angriffen der anderen am längsten widerstehen oder nach einer festgelegten Spielzeit die meisten Überlebenden aufweisen kann.“"
                            },
                            {
                                "example_id": "aa7cb52b-2424-4abf-8d1d-0cef993cce26",
                                "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                                "text": "„Schaffen es ein oder mehrere Opfer, nicht vom Mörder gefasst zu werden, sind sie die Spielsieger.“"
                            },
                            {
                                "example_id": "f612e657-a7bd-4af1-aa0e-ccef4a609842",
                                "sense_id": "be3d30b6-bc2c-34c8-8012-2343f59fd897",
                                "text": "„Diese 6 Städte muß der Spielsieger in jedem Fall besuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
