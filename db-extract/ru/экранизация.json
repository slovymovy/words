                        "translation_id": "f6e0ae36-c382-49a1-aa42-bd473dcd26d7",
                        "source_entry_id": "11217b94-435e-353e-9ea4-c82295e6a260",
                        "target_lang_word": "staging",
                        "target_lang_code": "en",
