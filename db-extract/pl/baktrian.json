                        "sense_id": "9db7385c-8283-34da-a6d5-35ffd66aa648",
                        "entry_id": "c14761df-52dc-39f3-acc7-dfe978eed589",
                        "glosses": [
                            "Camelus ferus Przewalski, duży ssak kopytny z rodziny wielbłądowatych występujący w stanie dzikim na stepach centralnej Azji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1032a6-a960-4e46-a587-a7ba237de2e4",
                                "sense_id": "9db7385c-8283-34da-a6d5-35ffd66aa648",
                                "text": "Baktriany żyją w dużej części Azji, nie tylko w Baktrii."
                            },
                            {
                                "example_id": "5320ae84-fad6-4ae6-9363-b6f885b309ff",
                                "sense_id": "9db7385c-8283-34da-a6d5-35ffd66aa648",
                                "text": "Na baktrianach jeździ się wierzchem i przewozi ładunki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
