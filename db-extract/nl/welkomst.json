                                        "glosses": [
                                            "Whose arrival is a cause of joy; received with gladness; admitted willingly to the house, entertainment, or company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3209c8-b674-435f-9d3c-3030fb249f89",
                                                "sense_id": "d7921fea-3bcf-310a-98c2-ba5e29b47aa6",
                                                "text": "a welcome visitor"
                                            },
                                            {
                                                "example_id": "c4a4ea23-89b1-4905-8c88-875123b83d3e",
                                                "sense_id": "d7921fea-3bcf-310a-98c2-ba5e29b47aa6",
                                                "text": "Refugees are welcome in our city!"
