                                "example_id": "27b15295-b45c-4597-9b6c-ed6a756605c5",
                                "sense_id": "17e39cb6-97d9-35be-b730-fd195843d0af",
                                "text": "Mit seiner Eismaschine konnte er für die Kinder einen leckeren Nachtisch zubereiten."
                            },
                            {
                                "example_id": "fc9b98fa-bc99-4b5d-a747-5f1e7a9faf3b",
                                "sense_id": "17e39cb6-97d9-35be-b730-fd195843d0af",
                                "text": "„Cavallo wurde als Entdecker der ersten Eismaschine weltberühmt, und Frau von Beerendonk blieb fröhlich bis an ihr Lebensende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
