                "translations": [
                    {
                        "translation_id": "eb7c6601-931e-437a-92d8-35852898073e",
                        "source_entry_id": "0901d6da-20e9-3b45-9877-7300a3c7d83d",
                        "source_sense_id": "35ba6357-3b6e-3a47-be57-061419cbeadd",
                        "source_sense_description": "bewertende Betrachtung vergangener Ereignisse",
                        "target_lang_word": "retrospect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retrospect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                        "entry_id": "4271d2f2-855b-37a3-99dc-d68a039b71e6",
                                        "glosses": [
                                            "Consideration of past times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100fc49c-d6b1-4d6d-922f-18105c21b2ae",
                                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                                "text": "My mind, calmer and stronger now than last night, made for itself some imperious rules, prohibiting under deadly penalties all weak retrospect of happiness past; commanding a patient journeying through the wilderness of the present..."
                                            },
                                            {
                                                "example_id": "fae6ae5c-1ab4-468e-b474-479fdc350ae5",
                                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                                "text": "Whether, like Colin, in retrospect Willie Lee and Baptist would feel that what has vanished was greater than what was achieved, is not something we can predict."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retrospect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e01e2f-36a6-345d-813d-74171274a4fc",
                                        "entry_id": "b13c9359-96a2-3449-b1c6-060a1b232143",
                                        "glosses": [
                                            "To look or refer back to; to reflect on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4541df6-1dea-4fa5-8d40-68501d32f3e8",
                                                "sense_id": "f2e01e2f-36a6-345d-813d-74171274a4fc",
                                                "text": "To give a correct idea of the circumstances which have gradually produced this conviction, it may be useful to retrospect to an early period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dfbb20c-a2c7-41d2-b169-8278a48214df",
                        "source_entry_id": "0901d6da-20e9-3b45-9877-7300a3c7d83d",
                        "source_sense_id": "35ba6357-3b6e-3a47-be57-061419cbeadd",
