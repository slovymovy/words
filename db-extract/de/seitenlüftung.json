                        "entry_id": "5d71d6e5-e011-3784-93fd-c9115bd6f863",
                        "glosses": [
                            "lüftungstechnische Zu- und Abluftführung durch Einbauelement in der Seitenwand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40014936-63b7-48a3-a0c6-17e8c059151b",
                                "sense_id": "f50e0235-a6b6-3e0a-b8c5-30e290777ab8",
                                "text": "„Die Seitenlüftung muss vor der Dach- und Frontenfolie montiert werden.“"
                            },
                            {
                                "example_id": "09fd8033-c332-49bc-8992-28fec6f59106",
                                "sense_id": "f50e0235-a6b6-3e0a-b8c5-30e290777ab8",
                                "text": "„Über ein zentrales Antriebsrohr erfolgt die Steuerung der Seitenlüftung als Hubfenster.“"
                            },
                            {
                                "example_id": "61583188-cf84-4d95-8c0d-d0d5fd3bd835",
                                "sense_id": "f50e0235-a6b6-3e0a-b8c5-30e290777ab8",
                                "text": "„Bestens geeignet ist hierfür die räumlich diagonale Anbringung z.B. einer Dach- oder Seitenlüftung und einer Bodenlüftung.“"
                            },
                            {
                                "example_id": "0e5e445f-dfb5-4327-a3fc-996876c52a7c",
                                "sense_id": "f50e0235-a6b6-3e0a-b8c5-30e290777ab8",
                                "text": "„Über ein zentrales Antriebsrohr erfolgt die Steuerung der Seitenlüftung als Hubfenster.“"
                            },
                            {
                                "example_id": "0ab48d46-976d-4b27-8fc8-5c0b6d7e9107",
                                "sense_id": "f50e0235-a6b6-3e0a-b8c5-30e290777ab8",
                                "text": "„Hauptsächlich zur Seitenlüftung von Stallungen oder Seitenverkleidungen im Vordachbereich von Futtergangsüberdachungen, sowie als regelbare Seitenverkleidung verwendbar.“"
                            }
                        ],
