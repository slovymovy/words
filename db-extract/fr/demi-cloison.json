                        "entry_id": "c35bfc8d-575f-30a9-92e5-0ff24408ac0b",
                        "glosses": [
                            "Cloison qui ne monte pas jusqu’au plafond, mais s’arrêtent environ à mi-hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b6bb0f-4d3d-4c17-832c-a18cf113ca9a",
                                "sense_id": "de64698e-e08b-3936-8549-de012fd60791",
                                "text": "Ils s’installèrent dans la partie séparée du zinc par une demi-cloison."
                            },
                            {
                                "example_id": "d4184c74-1367-42d2-ba24-fa2b3628f7f0",
                                "sense_id": "de64698e-e08b-3936-8549-de012fd60791",
                                "text": "Idéales pour délimiter un espace sans perdre en luminosité, les demi-cloisons existent sous différentes formes."
                            },
                            {
                                "example_id": "500a2a69-11a5-4f8d-b453-a15fd872cc92",
                                "sense_id": "de64698e-e08b-3936-8549-de012fd60791",
                                "text": "La demi-cloison, contrairement à la cloison au sens commun du terme, à savoir installée du sol au plafond, délimite un espace d’un autre sans pour autant obstruer la lumière présente dans la pièce initiale."
                            }
                        ]
                    }
