                                    {
                                        "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                        "entry_id": "dc962aad-be06-3449-a310-f15641c1d040",
                                        "glosses": [
                                            "Générateur de courant alternatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05734080-1b9d-4fde-b9a1-b1ee4a25141b",
                                                "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                                "text": "Un alternateur synchrone doit souvent mettre sous tension une ligne à haute tension lorsque cette dernière nʼest pas branchée au point dʼinterconnexion avec le réseau."
                                            },
                                            {
                                                "example_id": "fbcbfbef-af03-40ff-bdb4-355b1b0281e2",
                                                "sense_id": "7b13d776-663b-3637-a91f-c4ba039f9b2f",
                                                "text": "Les turbines convertissent la force motrice de l’eau en énergie mécanique, puis les alternateurs transforment cette énergie mécanique en électricité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bcd4cd3-0bec-46c2-bc00-20eb4127d71a",
                        "source_entry_id": "954a575e-578f-3dbe-9aee-d470818a1b89",
                        "source_sense_id": "f41ad538-4fe3-3e1d-9f0b-ebca41e67789",
