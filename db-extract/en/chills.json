                    {
                        "translation_id": "e38c7f3e-1f67-42fa-9b74-e2095bceb2eb",
                        "source_entry_id": "d34ff52b-fc7e-37c8-8efc-6102cb85eff6",
                        "source_sense_description": "medical symptom",
                        "target_lang_word": "Schüttelfrost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schüttelfrost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                        "entry_id": "878f362e-1bd6-375b-8034-010435170cbd",
                                        "glosses": [
                                            "Begleiterscheinung unterschiedlicher Erkrankungen, bei der man zittert und friert, während das Fieber meist ansteigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034bad75-b012-4dad-b802-28631b2b33f9",
                                                "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                                "text": "„Die Symptome der Malaria sind hohes, wiederkehrendes bis periodisches Fieber, Schüttelfrost, Beschwerden des Magen-Darm-Trakts und Krämpfe.“"
                                            },
                                            {
                                                "example_id": "6cf592e5-a7c0-41c3-933b-4ae4ef3492dc",
                                                "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                                "text": "„Er versuchte aufzustehen, aber Schwindel und Schüttelfrost vereitelten seinen Plan.“"
                                            },
                                            {
                                                "example_id": "ca0149a2-dcb5-42dc-bce3-3c459b1e683d",
                                                "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                                "text": "„1979, ein knappes Jahr nach Everetts erstem Eintreffen bei den Pirahã, bekamen Keren und ihre gemeinsame ältere Tochter Shannon hohes Fieber, Schüttelfrost und zitterten am ganzen juckenden Leib – die komplett gleiche Checkliste wie bei Everett, als er Typhus hatte.“"
                                            },
                                            {
                                                "example_id": "d857e969-39c1-4f69-be39-0c5d3a20914b",
                                                "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                                "text": "„Der Schüttelfrost und das Fieber begannen sich zu bewegen.“"
                                            },
                                            {
                                                "example_id": "928ae04c-e3a2-42ff-bd76-901f46b1a0a2",
                                                "sense_id": "c3da2ee6-150a-3100-9ec4-7bea54f25cdc",
                                                "text": "„Noch spürte sie nichts, aber sie legte sich trotzdem ins Bett, und just eine Stunde später: Schüttelfrost.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf3a86a-5bb1-464e-bc92-c5fc43e36b83",
                        "source_entry_id": "d34ff52b-fc7e-37c8-8efc-6102cb85eff6",
