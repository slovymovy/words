                    },
                    {
                        "form_id": "e2abbd68-0694-47ce-9918-97770d437930",
                        "entry_id": "d4f17cf6-7c60-3594-afae-3fb1282e101b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "municipales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                        "entry_id": "d4f17cf6-7c60-3594-afae-3fb1282e101b",
                        "glosses": [
                            "Qui concerne l’administration d’une municipalité ; qui est communal."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "4ad70e04-4caf-4204-9dc6-f80aeb6da369",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "[…], où il ne restait que les gardes municipaux et des pompiers travaillant à circonscrire l’incendie qu'ils n’espéraient plus éteindre."
                            },
                            {
                                "example_id": "c8839273-ac0b-4fe0-8e29-f1f5112e23b4",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "Méfiez-vous de cet essaim de charlatans et de faiseurs d'affaires qui viennent et reviennent sans cesse bourdonner autour de la caisse municipale, comme alléchés par l'odeur de la curée."
                            },
                            {
                                "example_id": "f3ad49d7-cf89-4985-9fb3-2624209e3e6e",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "Vivier. Vieux sénateur. Vieux cochon. Bon républicain. S'est fait pincer vingt fois dans un édicule municipal en posture d'exhibitionniste."
                            },
                            {
                                "example_id": "11feb079-0719-43b7-a7df-2fc296e86626",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "La garde municipale, le corps de troupes chargé d’assurer l’ordre dans les villes."
                            },
                            {
                                "example_id": "daf67598-2095-46f7-b998-bd3a0ef4359d",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "Un garde municipal, soldat de cette garde municipale."
                            },
                            {
                                "example_id": "3f5ad821-e34e-4c46-8967-92b5fd665c44",
                                "sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                                "text": "Dans ces conditions, comment (...) peut-elle retrouver des marges de manœuvre budgétaires, sans creuser la dette, sans augmenter la pression fiscale, sans réduire le service municipal rendu aux Parisiens? Elle se trouve au pied du mur budgétaire. Elle ne peut plus reculer. Pour équilibrer le budget et réduire la dette, elle doit réduire d'urgence les dépenses dont l'utilité n'est pas avérée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37aed96b-6b7c-4028-96c8-1ed8000388fd",
                        "source_entry_id": "d4f17cf6-7c60-3594-afae-3fb1282e101b",
                        "source_sense_id": "326cbea5-9b86-3661-957b-48a4b72699eb",
                        "target_lang_word": "munizipal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "munizipal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e8f5fc-3096-3ff5-9260-84516bade513",
                                        "entry_id": "d06fbfd6-e35e-30c2-a3b9-9b53279c68c9",
                                        "glosses": [
                                            "einer Stadt zugehörig, städtisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4659d330-6ccf-4480-9fdd-b48fe23e7eb5",
                                                "sense_id": "85e8f5fc-3096-3ff5-9260-84516bade513",
                                                "text": "„Im Zuge der munizipalen Verwaltungsreform in Russland wurde mit Gesetz vom 1. Juni 2009 die drei Kilometer östlich gelegene Siedlung Uschakowo (Ströpken) […] in die Stadt Osjorsk eingemeindet.“"
                                            },
                                            {
                                                "example_id": "e28d9f39-7493-48a6-98c5-e61610a1f203",
                                                "sense_id": "85e8f5fc-3096-3ff5-9260-84516bade513",
                                                "text": "„Bewährt hatte sich durch zahlreiche persönliche Beziehungen zwischen der vermischten und den munizipalen Aristokratien Italiens eng geknüpfte Band der Wehrgenossenschaft, die Hannibal trotz vielerlei Bemühungen und einiger Teilerfolge nicht zu sprengen vermochte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "620dc4ed-bf4a-46bf-98f1-e319896ebb4c",
                        "source_entry_id": "d4f17cf6-7c60-3594-afae-3fb1282e101b",
