        "fr-extract.jsonl": [
            {
                "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                "word": "pressentiment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d9159dd2-adb4-44d8-af93-82e4208c01d7",
                        "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "tags": [
                            "plural"
                        ],
                        "form": "pressentiments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                        "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "glosses": [
                            "Intuition d'un événement à venir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba51e69a-0ba8-4dfc-ac0d-264543abec2d",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "Au reste, ses pressentiments ne l’avaient pas trompée, à peine avait-elle fait vingt lieues, que son mari avait été pris d’une fièvre cérébrale."
                            },
                            {
                                "example_id": "75978f79-1208-4709-9a0f-06358d527fd1",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "Les bizarres pressentiments qui avaient si souvent agité Julie se trouvaient tout à coup réalisés."
                            },
                            {
                                "example_id": "936a27df-492d-4cc1-9a13-ad29a79c30ee",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "La jeune fille s’était jetée toute vêtue sur son lit, l’inquiétude la tenait éveillée, un secret pressentiment l’avertissait de se tenir sur ses gardes."
                            },
                            {
                                "example_id": "2f8fada5-8d5b-4d8a-9c46-24015a11f2c8",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "Nous trouvons ici de plus sombres pressentiments ; l’auteur se demande même si notre humanité atteindra sa véritable fin."
                            },
                            {
                                "example_id": "c46e7c3e-7637-4f77-a227-efe41ed9d163",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "Le cœur en émoi, secouée de pressentiments inquiets, Zaheira se vêtit et gagna le village voisin sur un âne."
                            },
                            {
                                "example_id": "4fda78b1-ca14-4070-b5d4-ee64a96d42d0",
                                "sense_id": "3fb4cc28-10a3-3dce-b7ec-d80af86f766d",
                                "text": "Le bruit, les allées et venues des gens m’alertèrent. J’accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a4fd7c1-2a9f-31d1-87c4-128cc82225c6",
                        "entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "glosses": [
                            "Idée intuitive d'un concept qui sera ou non confirmé plus tard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f73ef6-2b82-45eb-8880-720af62ae032",
                                "sense_id": "7a4fd7c1-2a9f-31d1-87c4-128cc82225c6",
                                "text": "Nous ne connaissons pas le contour précis de ce visage, ni sa réalisation concrète, nous en avons simplement le pressentiment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c87a868c-24a7-4d76-b1a8-30cfef4d1a9a",
                        "source_entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "target_lang_word": "Vorahnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorahnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                        "entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                                        "glosses": [
                                            "undeutliches Gefühl, dass etwas geschehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62cdfcf-f613-4aa6-87a9-38960969f53a",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Spät abends trieb es ihn wie in einer Vorahnung auf den Hof.“"
                                            },
                                            {
                                                "example_id": "f2f40cdd-5964-4935-87a1-4fabadf228f8",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Daher brach ich mit einer düsteren Vorahnung zu dieser Reise auf.\""
                                            },
                                            {
                                                "example_id": "8625351e-5492-40aa-bc90-ffa663163432",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Aber schon in das Hochgefühl der Siegesfeiern mischten sich dunkle Vorahnungen.“"
                                            },
                                            {
                                                "example_id": "d8ff349c-8e88-4bdb-8dbf-a7b5a9a35a73",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Hoffmann hat nicht nur ein sehr lebhaftes Traumleben, oft kommt es auch vor, daß ihm Wachträume erscheinen, er hat oft Vorahnungen und Gesichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "807b990d-8add-4754-95d0-d0ef42318cbb",
                        "source_entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "target_lang_word": "presentiment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presentiment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                        "entry_id": "bc4442c7-9f1f-34dc-869a-9d6f47ae790c",
                                        "glosses": [
                                            "A premonition; a feeling that something, often of undesirable nature, is going to happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c1e754-cdfe-4cdd-8806-108e5b5c5723",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "This unfortunate accident has upset me. I have a horrible presentiment that something of the kind may happen to me."
                                            },
                                            {
                                                "example_id": "f1b4dd20-bc4c-4e84-866e-af1e1c279374",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "A man, my good Sir, has seldom an offer of kindness to make to a woman, but she has a presentiment of it some moments before."
                                            },
                                            {
                                                "example_id": "7ccfbda7-4fa4-4cb4-98fc-7728ef51189a",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "A thousand alarming presentiments of evil to her beloved Catherine from this terrific separation must oppress her heart with sadness, and drown her in tears for the last day or two of their being together; […]"
                                            },
                                            {
                                                "example_id": "4862dda8-8846-4947-9aa0-688d97eb25a2",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "Oh, those women! They nurse and cuddle their presentiments, and make darlings of their ugliest thoughts, as they do of their deformed children."
                                            },
                                            {
                                                "example_id": "631c577f-1ef9-42d1-83ff-81c9a8fffce8",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "“No,” replied the girl, “it would not be strange, of course; but for some inexplicable reason I have one of those foolish feminine presentiments that all is not right with Mr. Caldwell. It is the strangest feeling—it is as though I knew that he was not on board the ship.”"
                                            },
                                            {
                                                "example_id": "2a0d91ae-661f-4522-9da2-ef057cea74ac",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "I had a presentiment that this would be my last journey to the Continent for many a long day to come; this, as events turned out, proved all too correct. [This was published posthumously, the author died on 19 November 1942.]"
                                            },
                                            {
                                                "example_id": "a5e15391-a7d7-4fff-a3f1-ee9810fedcf5",
                                                "sense_id": "970eea35-7e2a-30ca-a218-f022f4e77132",
                                                "text": "Everything on the surface appeared to be just as it ought to be. And yet Constantin Demiris still felt that vague sense of unease, a presentiment of trouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693c5ae5-c8a5-401d-b862-29c03a311337",
                        "source_entry_id": "0add890f-9689-350e-a60a-f4a4e02aca8b",
                        "target_lang_word": "feeling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73f94836-7c78-3127-9f7a-d19dc4eacbc9",
                                        "entry_id": "9ebb3224-52ed-3856-8aab-05b40232fdbd",
                                        "glosses": [
                                            "Emotionally sensitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05622ec0-ec38-44da-84c9-f9183c5dca32",
                                                "sense_id": "73f94836-7c78-3127-9f7a-d19dc4eacbc9",
                                                "text": "Despite the rough voice, the coach is surprisingly feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc2ea01-2e9f-3e95-b71e-c7f436b27b7f",
                                        "entry_id": "9ebb3224-52ed-3856-8aab-05b40232fdbd",
                                        "glosses": [
                                            "Expressive of great sensibility; attended by, or evincing, sensibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf42115-6f71-4fa4-94c6-438481e170b7",
                                                "sense_id": "bfc2ea01-2e9f-3e95-b71e-c7f436b27b7f",
                                                "text": "He made a feeling representation of his wrongs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "033a9968-4b5c-379f-a3ae-74eb4a5ab44f",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Sensation, particularly through the skin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff7d207-6ca8-4198-a4c9-37d26d10d347",
                                                "sense_id": "033a9968-4b5c-379f-a3ae-74eb4a5ab44f",
                                                "text": "The wool on my arm produced a strange feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotion; impression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f329c00-5a44-441e-88e4-86a14db40499",
                                                "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                                "text": "The house gave me a feeling of dread."
                                            },
                                            {
                                                "example_id": "17a943aa-01b4-4459-a799-1a3d879c3725",
                                                "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                                                "text": "Part of the 'western arcade' (as it's known) is lined with delis, cafes and other shops, giving it the feeling of a bazaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a15f4a9-6d7c-301d-8760-b6b19bea89c8",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotional state or well-being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59da4146-7833-40e7-a07d-e20de896b03c",
                                                "sense_id": "8a15f4a9-6d7c-301d-8760-b6b19bea89c8",
                                                "text": "You really hurt my feelings when you said that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Emotional attraction or desire."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89f946f3-fc49-428b-af96-06d0542740ff",
                                                "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                                "text": "Many people still have feelings for their first love."
                                            },
                                            {
                                                "example_id": "f0a68f0e-39e1-4992-aa0a-a9901d7abd73",
                                                "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling\nYou can say it's just the way you are\nMake a new excuse, another stupid reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "Intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd991c5-76b9-4983-ab99-eb08cdbc103b",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "He has no feeling for what he can say to somebody in such a fragile emotional condition."
                                            },
                                            {
                                                "example_id": "ab4e97c1-50f7-4a4e-8bb7-9614eadf847e",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "I've got a funny feeling that this isn't going to work."
                                            },
                                            {
                                                "example_id": "967cfed3-4668-47ac-9878-fb8bebeb8a48",
                                                "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                                                "text": "Got on a lucky one / Came in eighteen to one / I've got a feeling / This year's for me and you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e4c2c8-41b0-372c-9951-429e49c1a62c",
                                        "entry_id": "c243cc9f-04cc-358a-af89-c4fd61d94c01",
                                        "glosses": [
                                            "An opinion, an attitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8facd28-2dac-45fe-a2a9-2684d6fe2ada",
                                                "sense_id": "d8e4c2c8-41b0-372c-9951-429e49c1a62c",
                                                "text": "When you are tempted to speculate in cocoa, lie down until the feeling goes away."
                                            }
                                        ]
                                    }
                                ]
                            },
