                "senses": [
                    {
                        "sense_id": "feab54fe-98d7-371e-8aff-65330c52651e",
                        "entry_id": "e1cf564c-e829-3248-841e-d89b59d23825",
                        "glosses": [
                            "die Jahre 30 bis 39 des gegenwärtigen oder besagten Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5c4ce9-ce69-4d64-b58e-de01937f5748",
                                "sense_id": "feab54fe-98d7-371e-8aff-65330c52651e",
                                "text": "„Als ich »klein war«, Ende der Dreißigerjahre, gab es schon das Telefon.“"
                            },
                            {
                                "example_id": "288207bc-fbf2-4d4e-ac67-33e0051be488",
                                "sense_id": "feab54fe-98d7-371e-8aff-65330c52651e",
                                "text": "„In den Dreißigerjahren wurde die Schätzung korrigiert, nach unten.“"
                            },
                            {
                                "example_id": "714cd008-ba45-46a5-b6aa-0a161ce4c071",
                                "sense_id": "feab54fe-98d7-371e-8aff-65330c52651e",
                                "text": "„In den Dreißigerjahren blühte die antisemitische Demagogie.“"
                            },
                            {
                                "example_id": "2dd3dfdd-f052-4373-8349-1009ae50064c",
                                "sense_id": "feab54fe-98d7-371e-8aff-65330c52651e",
                                "text": "„Das mögen heute nur noch wenige lesen, in den Dreißigerjahren ist seine Leserschaft riesig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
