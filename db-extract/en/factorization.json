                    {
                        "sense_id": "a08a06b1-a8b7-327e-b014-6775684e0d50",
                        "entry_id": "d56fc26f-446b-36c2-aab9-4017a879f01f",
                        "glosses": [
                            "The process of creating a list of factors."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c1808cd-8ab6-41ac-830f-e0d183db331f",
                                "sense_id": "a08a06b1-a8b7-327e-b014-6775684e0d50",
                                "text": "A fifth-grade class will spend a set number of days on prime factorization and then move on to study greatest common factors — whether or not every student is ready."
                            }
                        ]
                    },
                    {
                        "sense_id": "55f608e2-a9d6-3f62-8830-64f077b43198",
                        "entry_id": "d56fc26f-446b-36c2-aab9-4017a879f01f",
                        "glosses": [
                            "An expression listing items that, when multiplied together, will produce a desired quantity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d4bc35fc-cc16-371c-81b0-69314672de24",
                        "entry_id": "d56fc26f-446b-36c2-aab9-4017a879f01f",
                        "glosses": [
                            "A list of factors."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f4038cbe-0d72-4212-a6a2-6329fb9a1260",
                                "sense_id": "d4bc35fc-cc16-371c-81b0-69314672de24",
                                "text": "Actual factorizations are now known for every p ≤ 89."
                            }
                        ]
                    }
                ],
