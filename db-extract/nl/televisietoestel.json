                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "744ca636-b819-4fab-8ad7-470cba370027",
                        "source_entry_id": "7258dc9e-5965-3172-9519-c133dff8acd0",
                        "source_sense_id": "cacfbf4c-13c2-3fd4-8de1-ef6a60bef7f8",
                        "source_sense_description": "een toestel dat een elektrisch of elektromagnetisch signaal omzet in beeld en geluid",
                        "target_lang_word": "Fernsehgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernsehgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0679ca6-56fc-3dd7-aa38-e02be163cafa",
                                        "entry_id": "cf77644e-85d8-36ac-b234-b1789b99d0cf",
                                        "glosses": [
                                            "Gerät zum Empfang von Signalen und zu deren akustischen und visuellen Wiedergabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034947f6-30cf-4302-a5dd-405426e2ece9",
                                                "sense_id": "f0679ca6-56fc-3dd7-aa38-e02be163cafa",
                                                "text": "Ich schaltete das Fernsehgerät ein."
                                            },
                                            {
                                                "example_id": "8bb20662-ad10-41af-972c-32e303674253",
                                                "sense_id": "f0679ca6-56fc-3dd7-aa38-e02be163cafa",
                                                "text": "„Er könne sich auch vorstellen, zu Beginn der Veranstaltung ein Fernsehgerät auf die Bühne zu stellen, um den Leuten den aktuellen Stand der schockierenden Terrortat vor Augen zu führen.“"
                                            },
                                            {
                                                "example_id": "9dea0048-23f6-49d0-9f51-2a62a4abe1fb",
                                                "sense_id": "f0679ca6-56fc-3dd7-aa38-e02be163cafa",
                                                "text": "„Tausende Nutzer beschweren sich in sozialen Medien und Foren des Herstellers darüber, dass ihr Fernsehgerät plötzlich nicht mehr funktioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdd74d01-619f-40f6-9f14-c63d2a071881",
                        "source_entry_id": "7258dc9e-5965-3172-9519-c133dff8acd0",
                        "source_sense_id": "cacfbf4c-13c2-3fd4-8de1-ef6a60bef7f8",
                        "source_sense_description": "een toestel dat een elektrisch of elektromagnetisch signaal omzet in beeld en geluid",
                        "target_lang_word": "Fernseher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernseher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                        "entry_id": "f43fa074-a5c8-3bfb-ac61-256fd75bb0be",
                                        "glosses": [
                                            "Gerät zum Empfang und zur Wiedergabe von Fernsehsignalen; Gerät, mit dem ferngesehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0dae70-079a-4ec1-a2d8-6748f19d8ab8",
                                                "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                                "text": "Mach mal endlich den Fernseher aus."
                                            },
                                            {
                                                "example_id": "4f4dadbd-8192-43fe-ad62-7f5a52e61264",
                                                "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                                "text": "„Die Fernbedienung war kaputtgegangen, infolgedessen blieb der Fernseher schwarz.“"
                                            },
                                            {
                                                "example_id": "245627d8-99b0-49c2-985c-aea549d7efd3",
                                                "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                                "text": "„Er schaltete den Fernseher ein.“"
                                            },
                                            {
                                                "example_id": "4329678f-4993-46cf-8a27-d0dd13abb17d",
                                                "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                                "text": "„Meine Großmutter saß im Halbdunkel auf der Couch, von den Bildern aus dem Fernseher in bläulichen Farben angestrahlt.“"
                                            },
                                            {
                                                "example_id": "d339a089-c798-4bad-aed8-e581e78457b3",
                                                "sense_id": "e98b6bd1-a887-3124-b5dd-5df7a98992c8",
                                                "text": "„Mein Fernseher läuft eigentlich immer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86db3d04-7958-32d9-bdec-18bbdbbbabdd",
                                        "entry_id": "f43fa074-a5c8-3bfb-ac61-256fd75bb0be",
                                        "glosses": [
                                            "Person, die Fernsehprogramme ansieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ef5572-0937-491d-9539-32b8e4d2f4a9",
                                                "sense_id": "86db3d04-7958-32d9-bdec-18bbdbbbabdd",
                                                "text": "Er ist ein leidenschaftlicher Fernseher."
                                            },
                                            {
                                                "example_id": "7a4c80c3-479b-4f72-a91c-368bd76aa743",
                                                "sense_id": "86db3d04-7958-32d9-bdec-18bbdbbbabdd",
                                                "text": "„Es war laut, laut ist es hier überall, weil die Fernseher immer brüllen oder pfeifen, die Männer schreien, Frauen sind weniger da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
