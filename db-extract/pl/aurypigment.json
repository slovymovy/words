                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ffb983-31bc-3ce1-9095-d615fe5a9466",
                                        "entry_id": "53b2f039-9b69-37b6-93b5-14417c6c1084",
                                        "glosses": [
                                            "gelbes Mineral, das zur Herstellung von Arsen verwendet wird"
                                        ],
                                        "tags": [
                                            "speziell Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d05213-4439-4a29-934c-a3de63d026ff",
                                                "sense_id": "a6ffb983-31bc-3ce1-9095-d615fe5a9466",
                                                "text": "„Eine weitere venezianische Spezialität waren die Auripigmente und Realgar: diese legte man wie einen dünnen glänzenden Schimmer auf eine Farboberfläche, so daß sie durch weiter aufgetragene Farbschichten hindurchschimmerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
