                                        "glosses": [
                                            "fornire una autocertificazione; dichiarare determinate informazioni personali e garantire, sotto piena responsabilità giuridica, che esse corrispondono al vero"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
