                    {
                        "translation_id": "649e8af1-359f-4c1f-a598-d646b4a1ccd3",
                        "source_entry_id": "ef0cdc6f-59f6-3a89-a189-6aac1f6bd352",
                        "source_sense_id": "0c50f0f2-c0c4-360d-998b-7934e522e914",
                        "target_lang_word": "Ovarial-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0f2af58-ffba-4a8e-a7c0-79269ef9c9e6",
                        "source_entry_id": "ef0cdc6f-59f6-3a89-a189-6aac1f6bd352",
                        "source_sense_id": "0c50f0f2-c0c4-360d-998b-7934e522e914",
                        "target_lang_word": "ovarien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovarien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "401030f3-8f05-3385-b880-1717443a17d9",
                                        "entry_id": "f33f1fdd-ae2d-359f-a5ba-61df17dee178",
                                        "glosses": [
                                            "Relatif aux ovaires des mammifères ou à l’ovaire des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e283ff-bf1d-4969-b12e-14484a14af3f",
                                                "sense_id": "401030f3-8f05-3385-b880-1717443a17d9",
                                                "text": "La suppression de la fonction ovarienne entraîne souvent une poussée d’obésité à laquelle s'associe l’empâtement des formes, du masculinisme avec hypertrichose, rappelant dans une certaine mesure le masculinisme cortico-surrénal."
                                            },
                                            {
                                                "example_id": "61f03f48-e8af-4a7a-9eec-e4e9f78671e4",
                                                "sense_id": "401030f3-8f05-3385-b880-1717443a17d9",
                                                "text": "La fausse puberté précoce isosexuelle est secondaire à une sécrétion œstrogénique anormale par une tumeur de l’ovaire ou des surrénales sans maturation ovarienne."
                                            },
                                            {
                                                "example_id": "11683ad6-0402-4a9b-8adb-99ae6a6e380b",
                                                "sense_id": "401030f3-8f05-3385-b880-1717443a17d9",
                                                "text": "Ainsi, le dicofol altère le métabolisme lipidique des crevettes, et inhibe la succinate déshydrogénase et la cytochrome c oxydase (Surendranath, 1991), tandis que le méthoxychlor provoque des altérations de l’anatomie ovarienne du type de celles produites par les œstrogènes (Martinez et al, 1991)."
                                            },
                                            {
                                                "example_id": "d915debb-bab9-45c2-8ab2-7ae6dc74cb6e",
                                                "sense_id": "401030f3-8f05-3385-b880-1717443a17d9",
                                                "text": "Cette procédure suppose plusieurs cycles de stimulation ovarienne avant le prélèvement d’ovocytes à féconder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c4836e-2fd7-3629-9af6-a8c25e33b7ce",
                                        "entry_id": "f33f1fdd-ae2d-359f-a5ba-61df17dee178",
                                        "glosses": [
                                            "Féminin."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14294f84-090c-430d-9787-799850d9a966",
                                                "sense_id": "f3c4836e-2fd7-3629-9af6-a8c25e33b7ce",
                                                "text": "Et si votre voisine vous susurre d’une voix ovarienne : « Voulez-vous me servir du vin ? », vous pouvez risquer votre genou, elle est sensible à votre présence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
