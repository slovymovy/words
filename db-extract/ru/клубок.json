                        "form": "клубке́"
                    },
                    {
                        "form_id": "2ccfea13-9c4f-45ed-9a30-244ec2192f76",
                        "entry_id": "75ae0019-6fe7-32fb-8dbd-1691a41cce4e",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "клубка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed4152a8-e5c0-360a-b036-f556c11e39fc",
                        "entry_id": "75ae0019-6fe7-32fb-8dbd-1691a41cce4e",
                        "glosses": [
                            "спутанные или смотанные в шарик нити"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1471016b-eb53-43c8-9fcd-db6bd1a5d8a5",
                                "sense_id": "ed4152a8-e5c0-360a-b036-f556c11e39fc",
                                "text": "Иногда Машенька заставляла князя держать шерсть, расставив широко руки, пока она мотала ее на клубок."
                            },
                            {
                                "example_id": "d8580816-09f7-47f6-8678-a59407ef58e4",
                                "sense_id": "ed4152a8-e5c0-360a-b036-f556c11e39fc",
                                "text": "Мама сматывает нитки в клубок, берет две тоненькие блестящие спицы и показывает дочке, как надо вязать."
                            }
                        ]
                    },
                    {
                        "sense_id": "061e2eb3-f9f2-3394-bec7-b8820eab6b42",
                        "entry_id": "75ae0019-6fe7-32fb-8dbd-1691a41cce4e",
                        "glosses": [
                            "запутанное переплетение чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d044ca15-3832-48b4-99c9-1191251f64b8",
                                "sense_id": "061e2eb3-f9f2-3394-bec7-b8820eab6b42",
                                "text": "Когда-то в детстве Хохлов видел маленькую картину: на сухой земле между каменьями тесно сплелись в клубок серые змеи."
                            },
                            {
                                "example_id": "e5628c92-aae9-4ea1-9e2c-160d60c8af14",
                                "sense_id": "061e2eb3-f9f2-3394-bec7-b8820eab6b42",
                                "text": "В голове спутался целый клубок противоречивых мыслей, позорных для него, оскорбительных для нее и невозможных с общечеловеческой точки зрения."
                            }
                        ]
                    }
                ],
