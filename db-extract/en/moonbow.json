                "senses": [
                    {
                        "sense_id": "8967612a-2fc0-3335-9171-3fd7bcd6d459",
                        "entry_id": "0d0e8fe3-12e9-3e3a-acfd-1d4bfab4fce5",
                        "glosses": [
                            "月虹"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1220e6-9d26-48b3-8ccf-7280e7f41a8e",
                                "sense_id": "8967612a-2fc0-3335-9171-3fd7bcd6d459",
                                "text": "Often rainbows by night or moonbows span the lake.",
                                "translation": "夜晚，湖面上常常会出现彩虹或月虹。"
                            },
                            {
                                "example_id": "fbc1a29f-3c12-47ff-9dbb-f38d3d1e9a87",
                                "sense_id": "8967612a-2fc0-3335-9171-3fd7bcd6d459",
                                "text": "Among the rarer optical effects associated with the moon are also moonbows or lunar rainbows.",
                                "translation": "与月亮相关的较为罕见的光学现象还包括月虹，或称“月彩虹”。"
                            },
                            {
                                "example_id": "9dd4ffab-cacb-4617-9df4-097788b9ca8c",
                                "sense_id": "8967612a-2fc0-3335-9171-3fd7bcd6d459",
                                "text": "When the sun shines over Kentucky's Cumberland Falls, the mist creates a rainbow on most days. If the moon shines brightly enough, it can create a moonbow, too!",
                                "translation": "当阳光照射在肯塔基州的坎伯兰瀑布上时，水雾通常会形成彩虹。如果月光足够明亮，甚至还能形成月虹！"
                            }
                        ]
                    }
                ],
