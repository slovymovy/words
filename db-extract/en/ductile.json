                    {
                        "translation_id": "452a2767-39d1-46f4-888d-a83d52205bd3",
                        "source_entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "source_sense_description": "molded easily into a new form",
                        "target_lang_word": "formbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bec579d0-f796-33f6-ab0a-7b5bbf99fe43",
                                        "entry_id": "6fa148c7-6bbf-33e8-a1a2-296eb0af4736",
                                        "glosses": [
                                            "so geartet, dass sich etwas in eine bestimmte Form bringen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e5e238-acd6-4164-8934-d1fd3a299a02",
                                                "sense_id": "bec579d0-f796-33f6-ab0a-7b5bbf99fe43",
                                                "text": "„Obwohl das wachsende Skelett der Kinder und Jugendlichen sehr formbar und flexibel ist, ‚wachsen‘ diese Fehlhaltungen nicht mehr ‚aus‘.“"
                                            },
                                            {
                                                "example_id": "357fbd28-8023-4750-8310-0f1bf9170dc5",
                                                "sense_id": "bec579d0-f796-33f6-ab0a-7b5bbf99fe43",
                                                "text": "„Kein anderes Metall ist so gut formbar und zugleich dicht genug, um seine Flugbahn einzuhalten.“"
                                            },
                                            {
                                                "example_id": "92a5304a-1dec-4e38-b926-84bd45f2db13",
                                                "sense_id": "bec579d0-f796-33f6-ab0a-7b5bbf99fe43",
                                                "text": "„Einerseits muss Feuchtigkeit für den Kleister vorhanden sein, andererseits darf die Masse nicht zu feucht sein, damit sie gut formbar ist.“"
                                            },
                                            {
                                                "example_id": "423e221d-1a30-4e9a-afea-cfeb1a02229f",
                                                "sense_id": "bec579d0-f796-33f6-ab0a-7b5bbf99fe43",
                                                "text": "„Durch das Erwärmen von Thermoplaste wird dieses jedoch weich und formbar, sodass das Plastik seine Form verändern kann, welche es bei Abkühlen beibehält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9326882-9549-3a69-9686-736a4535ef5e",
                                        "entry_id": "6fa148c7-6bbf-33e8-a1a2-296eb0af4736",
                                        "glosses": [
                                            "so geartet, dass sich die Beschaffenheit, der Charakter von etwas ändern lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f394dda3-d706-47ed-9815-f1a44dc973df",
                                                "sense_id": "d9326882-9549-3a69-9686-736a4535ef5e",
                                                "text": "„Wenn schon der physische Körper eines Kindes so formbar und leicht zu beeinflussen ist, trifft dies für seinen Astral- und Mentalkörper erst recht zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3870c09c-86b5-4c12-88f0-beadd3c20b5a",
                        "source_entry_id": "4bb60e33-ead0-38ba-89a5-37d4b4749395",
                        "source_sense_description": "molded easily into a new form",
                        "target_lang_word": "verformbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
