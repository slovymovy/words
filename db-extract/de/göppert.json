                ],
                "senses": [
                    {
                        "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                        "entry_id": "8684534f-4db3-3046-8560-a4e0906b3be6",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6038432-8d8d-47fb-ac23-5540608aebcb",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Frau Göppert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d04d7d1c-fdca-4097-a961-b2f253fdb388",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Herr Göppert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "102c993f-df3f-40e0-aa6e-b508b399b4e1",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Die Göpperts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e65bb492-b601-4786-9ffe-2b7fbbac5c6c",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Der Göppert trägt nie die Schals, die die Göppert ihm strickt."
                            },
                            {
                                "example_id": "87280dbf-628b-40ea-8dd9-5e77a598bc61",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Göppert kommt, geht der Herr Göppert.“"
                            },
                            {
                                "example_id": "4bc159c2-7962-4b89-805e-1fd07c7dcdaa",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Göppert kommt und geht."
                            },
                            {
                                "example_id": "ee1cac84-540a-4944-a01b-1f4340e3c26b",
                                "sense_id": "26560a11-b7e1-3839-bd3b-e56024eeff7b",
                                "text": "Göpperts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
