{
    "word_family": [
        "длить",
        "длиться",
        "длительный",
        "длительность",
        "длительно"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "eb69d30d-2284-3937-a3cd-7677a66f9326",
                    "sense_definition": "Указывает на лицо или предмет, для которого что-либо предназначено или совершается.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "purpose_and_beneficiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама купила подарок <w>для</w> сына.",
                            "target_lang_translations": {
                                "en": "Mom bought a gift <w>for</w> her son."
                            }
                        },
                        {
                            "text": "Этот учебник написан <w>для</w> начинающих студентов.",
                            "target_lang_translations": {
                                "en": "This textbook is written <w>for</w> beginner students."
                            }
                        }
                    ],
                    "synonyms": [
                        "ради"
                    ],
                    "common_phrases": [
                        "для детей",
                        "для всех"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the person or thing for whom something is intended or done."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "indicating the intended recipient or beneficiary"
                            },
                            {
                                "target_lang_word": "meant for",
                                "target_lang_sense_clarification": "intended for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5064d05-d9ff-3df0-956b-82351fa153ae",
                    "sense_definition": "Указывает на цель, задачу или предназначение какого-либо действия или предмета.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "purpose_and_beneficiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы учим русский язык <w>для</w> работы.",
                            "target_lang_translations": {
                                "en": "We are learning Russian <w>for</w> work."
                            }
                        },
                        {
                            "text": "Этот прибор нужен <w>для</w> измерения температуры.",
                            "target_lang_translations": {
                                "en": "This device is needed <w>for</w> measuring temperature."
                            }
                        }
                    ],
                    "synonyms": [
                        "в целях",
                        "с целью"
                    ],
                    "common_phrases": [
                        "для этого",
                        "для развития"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the aim, purpose, task, or function of an action or object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "indicating purpose or function"
                            },
                            {
                                "target_lang_word": "for the purpose of",
                                "target_lang_sense_clarification": "used with a purpose or aim"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "when followed by a verbal noun or activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ed53f9-5ec3-30b6-a440-77c0cdd3a66b",
                    "sense_definition": "Указывает на действие, совершаемое в пользу или на благо другого человека.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "purpose_and_beneficiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сделай это <w>для</w> меня, пожалуйста.",
                            "target_lang_translations": {
                                "en": "Please do it <w>for</w> me."
                            }
                        },
                        {
                            "text": "Она испекла <w>для</w> сына вкусные пироги.",
                            "target_lang_translations": {
                                "en": "She baked delicious pies <w>for</w> her son."
                            }
                        }
                    ],
                    "synonyms": [
                        "на благо",
                        "во благо",
                        "в пользу"
                    ],
                    "common_phrases": [
                        "для меня",
                        "для вас"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an action done for the benefit or good of another person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "done in someone's interests or for their benefit"
                            },
                            {
                                "target_lang_word": "for the sake of",
                                "target_lang_sense_clarification": "for the benefit of someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a7190c-c80f-335f-8e95-6010111c3714",
                    "sense_definition": "Обозначает субъект, с точки зрения которого оценивается ситуация или воспринимается событие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Для</w> меня это решение было очень сложным.",
                            "target_lang_translations": {
                                "en": "<w>For</w> me, this decision was very difficult."
                            }
                        },
                        {
                            "text": "<w>Для</w> него этот вопрос не имеет значения.",
                            "target_lang_translations": {
                                "en": "<w>For</w> him, this question does not matter."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Denotes the person from whose point of view a situation is evaluated or an event is perceived."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "from someone's point of view"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "in someone's opinion or experience"
                            },
                            {
                                "target_lang_word": "for someone",
                                "target_lang_sense_clarification": "from the perspective of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bddc1c6-6745-31f7-8c99-493a32fd962c",
                    "sense_definition": "Используется при сравнении свойств объекта с нормами или ожиданиями для его группы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Для</w> двухгодовалого ребёнка он очень хорошо говорит.",
                            "target_lang_translations": {
                                "en": "He speaks very well <w>for</w> a two-year-old child."
                            }
                        },
                        {
                            "text": "<w>Для</w> новичка он играет просто великолепно.",
                            "target_lang_translations": {
                                "en": "He plays absolutely wonderfully <w>for</w> a beginner."
                            }
                        }
                    ],
                    "synonyms": [
                        "по сравнению с"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in comparisons of an object's qualities with the norms or expectations for its group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "by the standards expected for that group"
                            },
                            {
                                "target_lang_word": "for a",
                                "target_lang_sense_clarification": "considering someone or something belongs to that category"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d31db26a-0301-3ae3-8008-3b436d1d3ac6",
                    "sense_definition": "Деепричастие настоящего времени от глагола <w>длить</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он смотрел на неё, <w>для</w> всё больше затягивая момент прощания.",
                            "target_lang_translations": {
                                "en": "He looked at her, <w>prolonging</w> the moment of parting more and more."
                            }
                        },
                        {
                            "text": "Разговор продолжался, <w>для</w> не желая заканчиваться.",
                            "target_lang_translations": {
                                "en": "The conversation went on, <w>seemingly prolonging itself</w> and not wanting to end."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма глагола"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present adverbial participle of the verb длить ('to prolong, make last')."
                    },
                    "translations": {
                        "en": []
                    }
                }
            ]
        }
    ]
}