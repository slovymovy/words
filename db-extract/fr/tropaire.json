                        "sense_id": "05381132-be76-30eb-897e-639d90d508eb",
                        "entry_id": "7a9d9799-bdd5-3400-8e50-b1bb02d11863",
                        "glosses": [
                            "Recueil de chants liturgiques notés sous forme de tropes, plus particulièrement dans la liturgie orthodoxe."
                        ],
                        "tags": [
                            "Liturgie",
                            "Christianisme orthodoxe"
                        ],
                        "examples": [
                            {
                                "example_id": "bb5b5f17-6ffa-43b6-8893-1723b40940f5",
                                "sense_id": "05381132-be76-30eb-897e-639d90d508eb",
                                "text": "Les tropaires et les hymnes étaient chantés, en chœur, par mon père et les anges."
                            },
                            {
                                "example_id": "0b7f8e8a-4b9a-4d56-8c09-d261a4e364df",
                                "sense_id": "05381132-be76-30eb-897e-639d90d508eb",
                                "text": "Le tropaire se compose d'une longue antienne, la stance, développée par une partie responsoriale."
                            },
                            {
                                "example_id": "723d05df-c91b-4f4e-b775-dbaeda6b2e86",
                                "sense_id": "05381132-be76-30eb-897e-639d90d508eb",
                                "text": "Tropaire de la nativité du Christ."
                            },
                            {
                                "example_id": "c603b7ff-48f4-4559-b54b-f9191621660d",
                                "sense_id": "05381132-be76-30eb-897e-639d90d508eb",
                                "text": "« Quelle est la fête patronale de ton église ? me demanda-t-il, à moi. — La Transfiguration. — Et le tropaire de ce jour-là, le connais-tu ? — Comment donc ! — Chante-le ! »"
                            }
                        ]
                    }
                ],
