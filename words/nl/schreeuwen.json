                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de verte hoorden we de <w>schreeuwen</w> van de meeuwen boven de zee.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard the <w>cries</w> of the gulls above the sea.",
                                "ru": "Вдалеке мы слышали <w>крики</w> чаек над морем."
                            }
                        },
                        {
                            "text": "De <w>schreeuwen</w> van de kinderen op het schoolplein waren tot hier te horen.",
                            "target_lang_translations": {
                                "en": "The <w>shouts</w> of the children on the schoolyard could be heard from here.",
                                "ru": "<w>Крики</w> детей на школьном дворе были слышны даже здесь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'shout' or 'scream'",
                        "ru": "множественное число от слова «крик»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shouts",
                                "target_lang_sense_clarification": "plural of a loud call"
                            },
                            {
                                "target_lang_word": "cries",
                                "target_lang_sense_clarification": "plural of a loud vocal sound or call"
                            },
                            {
                                "target_lang_word": "screams",
                                "target_lang_sense_clarification": "plural of a high-pitched loud cry"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крики",
                                "target_lang_sense_clarification": "громкие возгласы людей или звуки животных"
                            },
                            {
                                "target_lang_word": "возгласы",
                                "target_lang_sense_clarification": "громкие слова или звуки, выражающие чувства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}