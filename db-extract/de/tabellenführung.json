                        "examples": [
                            {
                                "example_id": "33dcb549-89e4-416d-afdb-09454c8532f9",
                                "sense_id": "ed68654c-4f5f-392b-a9fb-31e8a1054258",
                                "text": "Der deutsche Meister verlor die Tabellenführung."
                            },
                            {
                                "example_id": "a7125ffb-7bd2-4f0f-9366-ff3a0d4b8a3d",
                                "sense_id": "ed68654c-4f5f-392b-a9fb-31e8a1054258",
                                "text": "„Neun Punkte und die Eroberung der Tabellenführung lauteten die Ziele dieses ersten Lehrgangs unter dem 56-Jährigen.“"
                            },
                            {
                                "example_id": "5db79616-2b92-41bb-8552-74630cb60568",
                                "sense_id": "ed68654c-4f5f-392b-a9fb-31e8a1054258",
                                "text": "„Der Hamburger SV hat die Tabellenführung verloren. Das Team von Trainer Merlin Polzin kam gegen die SV Elversberg nicht über ein 0:0 hinaus.“"
                            }
                        ],
