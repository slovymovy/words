                    {
                        "sense_id": "467fd0c5-5b63-3a51-8afb-4412640e57aa",
                        "entry_id": "a8e2df30-0b55-3591-b161-e479f12352fb",
                        "glosses": [
                            "dreary之同義詞"
                        ],
                        "tags": [
                            "form-of",
