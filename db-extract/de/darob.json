        "de-extract.jsonl": [
            {
                "entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                "word": "darob",
                "pos": "adv",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "82430e67-db44-48c8-86d3-099753e01ef5",
                        "entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "tags": [
                            "variant"
                        ],
                        "form": "drob"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                        "entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "glosses": [
                            "deswegen, darüber"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0fe31898-a57e-49b3-8183-105eebfc7cea",
                                "sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                                "text": "»Soll man sich darob erzürnen, dass die Tasche entwendet wurde?«"
                            },
                            {
                                "example_id": "9e08fabf-3f73-4880-a7a8-c1ea9f03dd70",
                                "sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                                "text": "Weil man ihn ausgelacht, war er darob erbost."
                            },
                            {
                                "example_id": "601233e7-d1b1-478e-8042-4ab0422b2e84",
                                "sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                                "text": "Darob entbrannte ein heftiger Disput, welcher bis heute andauert."
                            },
                            {
                                "example_id": "f6b0443b-ef8e-4725-956d-314227a252e9",
                                "sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                                "text": "„Ich erriet, daß Sie sich für genasführt hielten, und daß Sie empört sein würden, und ich empfand darob einen unaussprechlichen Kummer; denn ich sah keine Möglichkeit, Ihnen vor dem nächsten Feiertag die Wahrheit kundzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b695f317-781f-4276-862b-b58094a7a134",
                        "source_entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "source_sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                        "source_sense_description": "veraltet: deswegen, darüber",
                        "target_lang_word": "because of it",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f94f4a75-4cb0-4431-a56c-9e3e2f561eab",
                        "source_entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "source_sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                        "source_sense_description": "veraltet: deswegen, darüber",
                        "target_lang_word": "therefore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therefore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "Consequently, by or in consequence of that or this cause; referring to something previously stated."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fbf13c-cc31-47d7-806b-6082eb0202d9",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Traditional values will always have a place—therefore, they will never lose relevance."
                                            },
                                            {
                                                "example_id": "22f9500b-699f-476c-b3b5-d34d86fc9150",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I've been explicitly forbidden to leave and therefore must stay longer."
                                            },
                                            {
                                                "example_id": "04756caf-c792-423c-8861-8f44559bd973",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I left the office at 5 o'clock. I was therefore not there when the fire started a quarter of an hour later."
                                            },
                                            {
                                                "example_id": "34821ae0-beb5-4463-8426-8a75d84efa86",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "I have married a wife, and therefore I can not come."
                                            },
                                            {
                                                "example_id": "db9c1fc7-05e9-44c6-ba04-91b1bc88e91b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Je pense, donc je suis (I think, therefore I am)"
                                            },
                                            {
                                                "example_id": "a9c74313-de9b-4036-9e6b-e7e870b9eb8b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts, […], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "026260e6-ab62-4f9b-9d70-58e6897be38b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "9d6442df-21d4-4bea-b78b-ffe4a6a9468b",
                                                "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                                                "text": "He blushes; therefore he is innocent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                        "entry_id": "dfe4845c-c283-3473-b130-6369e1ea8935",
                                        "glosses": [
                                            "for that; for it (in reference to a previous statement)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1190b7a3-60b3-48fc-83ab-dbd453e9c927",
                                                "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                                                "text": "Behold, we have forsaken all, and followed thee; what shall we have therefore?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f9ef9c6-7671-4cf0-9609-0a219cd8795a",
                        "source_entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "source_sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                        "source_sense_description": "veraltet: deswegen, darüber",
                        "target_lang_word": "pour cela",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b1eab009-0d10-4998-8a3f-3781ba5f8913",
                        "source_entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "source_sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
                        "source_sense_description": "veraltet: deswegen, darüber",
                        "target_lang_word": "daarom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daarom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                        "entry_id": "59293ee6-b6f8-301d-9ac3-a2237fbe2446",
                                        "glosses": [
                                            "aanwijzend (ver af) om+dat, om+die: met die reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16265c00-64cd-40f9-a3f1-d262e8b33869",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Het regende hard en daarom deed ik het raam dicht."
                                            },
                                            {
                                                "example_id": "3858d47b-336c-439a-930d-7b59542b3cac",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Daar deed hij het om."
                                            },
                                            {
                                                "example_id": "43f7689d-6465-4d82-9d74-4623047a6063",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Toen de lerares geen antwoord kon geven op de vraag waarom het Nederlands zo moeilijk is, gaf ze als antwoord daarom. Waarop ik antwoordde: daarom is geen reden, als je van de trap afvalt ben je gauw beneden!"
                                            },
                                            {
                                                "example_id": "56de7fab-1cf3-482c-a6e3-7ca20410e988",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Hij trok een gek gezicht en daar moest ik om lachten."
                                            },
                                            {
                                                "example_id": "502c6d0e-81ee-4a37-8ec4-1c9f4db7b6c3",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Volgens de Algemene Nederlandse Vereniging van Reisondernemingen (ANVR) en reisorganisatie TUI heeft de luchtvaart nauwelijks invloed op de luchtkwaliteit in Den Haag en is een lokaal verbod op fossiele reclames daarom niet zinvol. Ook vonden ze het verbod in strijd met de vrijheid van meningsuiting en de vrijheid van ondernemerschap."
                                            },
                                            {
                                                "example_id": "3621aef6-968b-4c86-af89-f66b09d28299",
                                                "sense_id": "ebf847db-0dbf-379e-9038-027c08e32546",
                                                "text": "Antimateriehypernuclei: Antihyperhelium-4 bestaat uit een mix van antimaterieversies van protonen, neutronen en deeltjes die hyperonen worden genoemd. Hyperonen zijn op zichzelf al exotisch, omdat ze een of meer quarks van het ‘vreemde’ type bevatten. Deze ‘vreemdheid’ is moeilijk te vinden en moeilijk te maken. Daarom begrijpen onderzoekers nog steeds niet helemaal hoe hyperonen zich gedragen in de natuur, waar ze vermoedelijk voorkomen in exotische omgevingen zoals het binnenste van neutronensterren, zegt Dönigus. Bovendien blijven er vragen bestaan over hoe antimaterieversies van deze en andere deeltjes op elkaar reageren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dbf30e3-4abf-409b-a37c-b87e07ca83b9",
                        "source_entry_id": "e6bf46cc-74db-3589-b05c-f10b86e2fc68",
                        "source_sense_id": "07e427a4-3111-3e3d-bef9-60ce65c2b79a",
