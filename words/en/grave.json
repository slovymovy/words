                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вырезать или высекать рисунок или буквы на твердой поверхности.",
                        "zh": "在坚硬的表面上雕刻或切割图案或文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гравировать",
                                "target_lang_sense_clarification": "наносить рисунок"
                            },
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "высекать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雕刻",
                                "target_lang_sense_clarification": "在硬物上刻字或图案"
                            },
                            {
                                "target_lang_word": "镌刻",
                                "target_lang_sense_clarification": "正式的雕刻"
                            }
                        ]
                    }
                }
            ]
        },
