        "fr-extract.jsonl": [
            {
                "entry_id": "824df985-fcfd-3c32-8fd6-9f12b52696ee",
                "word": "Poitiers",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                        "entry_id": "824df985-fcfd-3c32-8fd6-9f12b52696ee",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département de la Vienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4892471-a1a9-4e01-8bab-0860dac4d4f6",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "Et il jeta sur madame Hulot un regard comme Tartuffe en jette à Elmire, quand un acteur de province croit nécessaire de marquer les intentions de ce rôle, à Poitiers ou à Coutances."
                            },
                            {
                                "example_id": "3ce9a3bf-f76f-4759-a1e6-f75406695ca2",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "Le rendez-vous fut pris à un certain endroit hors des murs, dans un pré fort apprécié des duellistes de Poitiers pour sa solitude, fermeté de terrain et commodité naturelle."
                            },
                            {
                                "example_id": "1d73a589-3364-4160-9b81-31c53a9ae691",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "POITIERS – […] J’ai trouvé la ville si laide, si déplaisante à habiter, il y a douze ans ! Aujourd’hui elle m’amuse. Sur la montagne, avec ses rues tortueuses, ses bâtiments de tout âge et de toutes formes, empilés bizarrement, elle fournirait tous les vingt pas un motif de tableau à un peintre."
                            },
                            {
                                "example_id": "bea7cdcc-4864-49ee-8d2d-984f8017b7c2",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "Puis, à Poitiers, de la promenade Blossac, dont vous aurez gravi les deux cent cinquante marches de marbre, d’onyx et d’or, vous verrez notre lune, sur le ruisseau aux écrevisses, glisser à reculons, vous écouterez les chiens de garde se dire leur fait, les grenouilles coasser et coasser, croyant remonter le jour pour le lendemain, et alors, mes amis, vous saurez ce que c’est, que le soir."
                            },
                            {
                                "example_id": "82ea30f1-9de2-4f18-8246-892917895e0f",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "Pôle d'échanges multimodal de la gare de Poitiers, accueillant une gare routière, un dépose-minute ainsi qu’un tout nouveau parking de 700 places."
                            },
                            {
                                "example_id": "3ac4a377-3a7c-4cad-9316-ba3633933532",
                                "sense_id": "bf86413f-5945-3284-9065-dc437650dd13",
                                "text": "Contrairement à une idée popularisée au cours des siècles ultérieurs, la bataille de Poitiers, même si elle a été une victoire retentissante, ne marque que le début du reflux arabe."
                            }
                        ]
                    }
