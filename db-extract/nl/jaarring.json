                        "examples": [
                            {
                                "example_id": "7df08cb7-46f6-4846-8b0d-66a2019215f3",
                                "sense_id": "25d575e5-57e5-3368-ab1c-ab16396e63bf",
                                "text": "Je kunt de leeftijd van een boom tellen aan de hand van de jaarringen.",
                                "translation": "You can tell the age of a tree by counting the growth rings.",
                                "english": "You can tell the age of a tree by counting the growth rings."
                            },
                            {
                                "example_id": "de11a8ad-4fb1-48c8-bba5-f0311c924bc7",
                                "sense_id": "25d575e5-57e5-3368-ab1c-ab16396e63bf",
                                "text": "Elke jaarring vertegenwoordigt een jaar in het leven van de boom.",
                                "translation": "Each annual ring represents a year in the life of the tree.",
                                "english": "Each annual ring represents a year in the life of the tree."
                            },
                            {
                                "example_id": "3473dd1b-18f9-4f6b-a94c-28241830c360",
                                "sense_id": "25d575e5-57e5-3368-ab1c-ab16396e63bf",
                                "text": "De wetenschapper onderzocht de jaarringen om het klimaat uit het verleden te begrijpen.",
                                "translation": "The scientist examined the growth rings to understand the past climate.",
                                "english": "The scientist examined the growth rings to understand the past climate."
                            }
                        ]
                    },
