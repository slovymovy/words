                "senses": [
                    {
                        "sense_id": "376faa92-705d-3875-bc30-7d14b9895ac8",
                        "entry_id": "b11c3873-6dfc-3009-8888-78f1ef97f487",
                        "glosses": [
                            "A city on the Nile river, a few miles above Aga-nagara; the site of the first cataract of the Nile."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "feef3f58-f2f9-35c3-a666-c39c90c8fb46",
                        "entry_id": "b11c3873-6dfc-3009-8888-78f1ef97f487",
                        "glosses": [
                            "An inhabitant of this city."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ba2d8d-748c-4d7d-b811-791f7096df2e",
                                "sense_id": "feef3f58-f2f9-35c3-a666-c39c90c8fb46",
                                "text": "Catadupes never heard the roaring of the fall of Nilus, because the noiſe was ſo familiar unto them."
                            },
                            {
                                "example_id": "ae9e6852-bcd4-4cdd-898f-a649275329f1",
                                "sense_id": "feef3f58-f2f9-35c3-a666-c39c90c8fb46",
                                "text": "The inhabitants of Atures and Maypures, whatever the missionaries may have asserted in their works, are not more struck with deafness by the noise of the great cataracts, than the Catadupes of the Nile."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "081779f9-7fbd-3a6c-9244-caf045397d5f",
