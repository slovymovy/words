                    "frequency": "High",
                    "semantic_group_id": "telefonieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er war so wütend über die Nachricht, dass er mitten im Gespräch einfach <w>auflegte</w>."
                        },
                        {
                            "text": "Ich muss jetzt leider <w>auflegen</w>, weil mein Zug in wenigen Minuten am Bahnhof abfährt."
                        }
                    ],
                    "synonyms": [
