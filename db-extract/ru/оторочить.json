                "senses": [
                    {
                        "sense_id": "8b79b553-c8cd-3901-a667-a9fc8a898cfb",
                        "entry_id": "2a44e250-8108-3ba7-aaa0-e5e627515cb4",
                        "glosses": [
                            "разг. обшить, окантовать деталь по краям тканью, мехом, кожей, тесьмой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32944fa5-8db8-49eb-b3f9-6d97b5351937",
                                "sense_id": "8b79b553-c8cd-3901-a667-a9fc8a898cfb",
                                "text": "За ночь Вали сшила себе шляпку из коричневого бархата и оторочила её кусками рыжей лисы."
                            },
                            {
                                "example_id": "d38c92e7-f565-4e4d-acb7-374119bfdb6c",
                                "sense_id": "8b79b553-c8cd-3901-a667-a9fc8a898cfb",
                                "text": "И ты, конечно, захочешь оторочить верх панталон чем-нибудь багряным."
                            }
                        ]
                    }
