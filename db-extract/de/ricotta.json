                                "target_senses": [
                                    {
                                        "sense_id": "2e0a0994-c494-35a5-b4b3-06bcd99b1640",
                                        "entry_id": "f5dfdd7e-fdee-3159-84be-3d12e5e6ef16",
                                        "glosses": [
                                            "Produit laitier issu historiquement de la cuisson du lactosérum, sous-produit de la fabrication du fromage emprésuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691ba33c-4283-4b3a-9718-33f01d04825e",
                                                "sense_id": "2e0a0994-c494-35a5-b4b3-06bcd99b1640",
                                                "text": "Avant que nous ne le quittions, notre hôte tient à nous faire goûter à sa ricotta : fromage blanc obtenu avec le petit-lait que tu chauffes après y avoir ajouté un peu de présure."
                                            },
                                            {
                                                "example_id": "eddf4cde-f3db-4445-bc8f-51f7521194cd",
                                                "sense_id": "2e0a0994-c494-35a5-b4b3-06bcd99b1640",
                                                "text": "99% des ricottas vendues en France sont des fromages industriels au lait pasteurisé."
                                            },
                                            {
                                                "example_id": "28440b57-4df6-4cdc-bd98-13409c8780fd",
                                                "sense_id": "2e0a0994-c494-35a5-b4b3-06bcd99b1640",
                                                "text": "Côté cuisine, les plats sont d'une grande fraicheur et les assiettes bien présentées : raviolis niçois à la ricotta et copeaux de truffes, cabillaud demi-sel en aïoli et légumes du jardin, […]"
                                            },
                                            {
                                                "example_id": "6bbce58a-f592-477c-97e8-9d9c22778fda",
                                                "sense_id": "2e0a0994-c494-35a5-b4b3-06bcd99b1640",
                                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
