                        "glosses": [
                            "The state of being a bird, or of belonging to the world of birds; birds collectively."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1f5954b6-51d5-4a02-97a9-52015bcd1d4d",
                                "sense_id": "828b5a50-26d3-3407-8951-ded40b3af78d",
                                "text": "The parrot particularly, which may be considered the autocrat of the feathered tribes leads all birddom in the number and variety of diseases to which it is subject."
                            },
                            {
                                "example_id": "afded4ff-4c39-4a90-83a9-47333a2fd256",
                                "sense_id": "828b5a50-26d3-3407-8951-ded40b3af78d",
                                "text": "As March creeps into April, the panoply of summer birddom has begun to reassemble."
                            },
                            {
                                "example_id": "6c99be3f-a8c3-4924-ac16-dc33cbf964db",
                                "sense_id": "828b5a50-26d3-3407-8951-ded40b3af78d",
                                "text": "I doubt there is a zoo in the world which doesn't have at least a few of these gorgeous creatures strutting through the grounds, from time to time deigning to show off the most extravagant plumage in all of birddom."
                            }
                        ]
                    }
