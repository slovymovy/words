                        ],
                        "examples": [
                            {
                                "example_id": "010b94cb-690f-4fec-ab70-1e26f25ce5a6",
                                "sense_id": "ef909140-4ec6-3c7d-af51-61657ce41318",
                                "text": "You enter a skyscraper in an American city. The “theater” is a ten-floorer, the floors occupied by the theater running consecutively upward from ground. […] There are 10 auditoriums, one above the other in this 10-floorer, and in each auditorium the show is the same."
