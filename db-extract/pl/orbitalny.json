                                    {
                                        "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                        "entry_id": "6fe734fa-0679-3e4e-b212-bf39c530ebe9",
                                        "glosses": [
                                            "den Orbit betreffend, im Orbit befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264268d5-e90d-477f-8008-eb88821afb32",
                                                "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                                "text": "Mittels kabelloser Übertragungstechnik soll Strom von orbitalen Solarkollektoren auf die Erde gebeamt werden, um die Energieversorgung zu sichern."
                                            },
                                            {
                                                "example_id": "bbda536d-4fca-4579-b02e-e65f4e2a3b4f",
                                                "sense_id": "7579b277-4ad0-364a-98c9-0d743b330fdf",
                                                "text": "Zwei Tage vor dem Absturz können die Amerikaner aus orbitalen Ortungsdaten eine Gefahrenzone berechnen: Ein langer Streifen, der etwa 50 Kilometer in Ost-West-Richtung durchmisst und sich etwa 1000 Kilometer in Nord-Süd-Richtung ausdehnt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
