                        "glosses": [
                            "de belangrijkste rivier of beek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a7b9d4-f518-4c1f-8a93-82848ddcf2ad",
                                "sense_id": "d0395b3b-8ca2-3154-a937-2b361ed1a391",
                                "text": "Het WNF wil de rivieren meer ruimte geven. De organisatie denk bijvoorbeeld aan het verleggen van de hoofdgeul en langsdammen (stenen dammen in de vaargeul), het graven van nevengeulen, die min of meer parallel aan de hoofdstroom lopen, en het verlagen van zogeheten zomerkades."
                            }
                        ]
                    },
                    {
                        "sense_id": "43fd90fd-71a9-3e91-9dba-f38c5cb26507",
                        "entry_id": "e2523c06-ba60-3e90-92e2-93bb6a063cfc",
                        "glosses": [
                            "de gebruikelijke manier van doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecdaf697-fa50-49cf-ac59-4238c3433649",
                                "sense_id": "43fd90fd-71a9-3e91-9dba-f38c5cb26507",
                                "text": "De hoofdstroom waarin deze begrippen zich manifesteren en hun functie vervullen, blijft echter die van de historie."
                            },
                            {
                                "example_id": "114b3ed8-eea2-4cf5-a4a5-7287d390a4a2",
                                "sense_id": "43fd90fd-71a9-3e91-9dba-f38c5cb26507",
                                "text": "De uitdaging is echter om die producten de hoofdstroom (mainstream) te laten worden."
                            }
                        ]
                    }
