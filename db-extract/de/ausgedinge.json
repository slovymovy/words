                ],
                "senses": [
                    {
                        "sense_id": "a390b703-2f3f-32f8-b428-6e7248ef3456",
                        "entry_id": "8557e196-6808-3cf9-bc15-19136f212539",
                        "glosses": [
                            "Unterhalt auf Lebenszeit im bäuerlichen Umfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eeee865-64d5-4621-b053-ce3bd9582d8a",
                                "sense_id": "a390b703-2f3f-32f8-b428-6e7248ef3456",
                                "text": "„Der überlebende Ehegatte, der nicht Anerbe ist, hat das Recht, einen den ortsüblichen Lebensumständen angemessenen Unterhalt auf Lebenszeit (Ausgedinge) auf dem Erbhof zu verlangen.“"
                            },
                            {
                                "example_id": "5eab6b08-193f-4a71-bc5b-9ff12c21c636",
                                "sense_id": "a390b703-2f3f-32f8-b428-6e7248ef3456",
                                "text": "„Der Auszugsberechtigte kann dann, weil er durch den Auszugsverpflichteten schuldhafterweise außerstande gesetzt wurde, die bedungenen Naturalleistungen zu beziehen, eine Geldrente in Anspruch nehmen, die an die Stelle der ursprünglichen Leistung tritt und im übrigen die Natur des Ausgedinges bewahrt (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "efc139b7-d7ba-3f5c-942a-506193269b73",
                        "entry_id": "8557e196-6808-3cf9-bc15-19136f212539",
                        "glosses": [
                            "Posten, auf den jemand nach der eigentlichen Karriere abgeschoben wird"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "0ea09b05-cc85-444e-ac89-a5ef369a9d4a",
                                "sense_id": "efc139b7-d7ba-3f5c-942a-506193269b73",
                                "text": "„Letztes Jahr ordnete die Gesundheitsbehörde NIH, die die Forschung an Schimpansen mitfinanziert, die Reaktivierung von 186 Tieren an, die schon im Ausgedinge lebten.“"
                            },
                            {
                                "example_id": "e0adb9c9-1030-4f11-b61d-0aac03bf8c51",
                                "sense_id": "efc139b7-d7ba-3f5c-942a-506193269b73",
                                "text": "„Bratschko: […] Wenn ich davon ausgehe, dass der Uni-Rat das Ausgedinge für abgehalfterte Politiker sein wird, dann wird es problematisch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
