                                "target_senses": [
                                    {
                                        "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                        "entry_id": "8572f09e-c487-3c94-b545-7a0359a182f2",
                                        "glosses": [
                                            "A sword-like tool used for cutting large plants with a chopping motion, or used as a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a288495c-8c4e-4042-8dc4-57e886d8e103",
                                                "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                                "text": "Near-synonyms: (all sometimes or regionally synonymous) bolo, golok, panga, parang, sundang"
                                            },
                                            {
                                                "example_id": "f65547d0-a4b2-436f-a335-ee5e87838b0b",
                                                "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                                "text": "It breaks loose one rope at a time, haphazardly, tossing the Filipinos up into the air. A boy with a machete cuts the one remaining line, which pops up and lashes him across the face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645cec26-19c6-34a9-a4f3-c88235e47bdf",
                                        "entry_id": "8572f09e-c487-3c94-b545-7a0359a182f2",
                                        "glosses": [
                                            "A small stringed instrument from Madeira, Portugal, having a double bulged body, traditionally of wood, with a small rib and four metallic strings, sometimes attached by wooden pegs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "machete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2eba31-8a61-3dee-bd5f-e585fc732c58",
                                        "entry_id": "ffc5e569-404b-3f51-bc7c-3de974eca5a2",
                                        "glosses": [
                                            "To cut or chop with a machete."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb8b0da-dbe7-4aa1-ba6f-b0ce060a325c",
                                                "sense_id": "8f2eba31-8a61-3dee-bd5f-e585fc732c58",
                                                "text": "After some hours of intense work, we had macheted a path through the jungle to the bank of the river."
                                            }
                                        ]
                                    }
                                ]
                            }
