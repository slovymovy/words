                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous habitons dans ce quartier calme <w>depuis</w> plus de cinq ans."
                        },
                        {
                            "text": "Elle apprend le français à l'école <w>depuis</w> le mois de septembre."
                        }
                    ],
                    "common_phrases": [
