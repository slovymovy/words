                "senses": [
                    {
                        "sense_id": "e40fa76c-8e28-3894-bae4-e7d1381c4bf7",
                        "entry_id": "af36c83f-dc32-3dee-9e35-76259b432b27",
                        "glosses": [
                            "Alternative letter-case form of Zen: of or related to Zen Buddhism, particularly its focus on indirect teaching of wisdom through riddles and stories."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c7dfd1cd-90e4-4b5c-abc8-97001b23cd41",
                                "sense_id": "e40fa76c-8e28-3894-bae4-e7d1381c4bf7",
                                "text": "Greggs: You hung over? Just sayin', you look like shit.\nMoreland: You know what you need at a crime scene?\nGreggs: Rubber glove?\nMoreland: Soft eyes.\nGreggs: Like I'm s'posed to cry an' shit?\nMoreland: You got soft eyes, you can see the whole thing. You got hard eyes? You starin' at the same tree, missin' the forest.\nGreggs: Ah. Zen shit.\nMoreland: Soft eyes, grasshopper."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe787207-fb97-371e-bd15-3d9f75d0c353",
                        "entry_id": "af36c83f-dc32-3dee-9e35-76259b432b27",
                        "glosses": [
                            "Wise, displaying enlightenment or similar wisdom, insightful, unburdened and free of worries, extremely relaxed and capable."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    }
                ],
