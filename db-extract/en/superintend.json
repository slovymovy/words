                                    {
                                        "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Régler l'exécution d'une action, l'organiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a15730-87c0-4d89-9c19-2f1730669d4b",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger une manœuvre, une opération, une expédition."
                                            },
                                            {
                                                "example_id": "1496ff72-c93b-4028-80f2-7b2c09ea611c",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger un chantier, des travaux, des recherches."
                                            },
                                            {
                                                "example_id": "3110ea97-efbf-4120-a7a7-58e90227027f",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger un débat, une conversation, un interrogatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Commander, administrer un organisme, une institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e24805-61d2-4e03-955a-3b3be3d71c72",
                                                "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                                "text": "Diriger un hôpital, un théâtre, une école."
                                            },
                                            {
                                                "example_id": "5f6f9a86-2ede-4bc7-beff-1117795f6ef7",
                                                "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                                "text": "Il dirige une PME de 150 personnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Exercer une autorité sur un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c53f92-889c-4d07-999d-cdb242954146",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une nation."
                                            },
                                            {
                                                "example_id": "b23a3d3f-78d6-4df8-80b5-96fa3a55c372",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une armée, une classe, une équipe."
                                            },
                                            {
                                                "example_id": "d630ed84-85da-4f5d-964b-f928fe3c688d",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une chorale, un orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Exercer une autorité intellectuelle ou morale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e89019-9984-4f96-aa6f-3bffdde9d72d",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Diriger un élève dans son travail, un étudiant dans ses recherches."
                                            },
                                            {
                                                "example_id": "c5ce6669-1621-439b-b27b-5fc592b92e0d",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Diriger la conscience de quelqu’un."
                                            },
                                            {
                                                "example_id": "5318a5d1-748e-4a6f-b020-78575deec635",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Au bout de ces dix ans, elle sera au commencement de l’âge mûr, et si elle ne trouve pas un prêtre pour s’occuper d’elle exclusivement sous prétexte de diriger sa conscience, elle est ennuyée et malheureuse jusqu’à la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db35fad-2feb-4537-b302-da597f659365",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Pour remettre la machine en mouvement, on dirige d'abord l'arbre moteur dans le sens du vent, puis on écarte les voiles afin de garnir de nouveau les ailes."
                                            },
                                            {
                                                "example_id": "57621d29-a73a-416b-a0d1-f431f41edb20",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger ses pas, sa course, son vol vers quelque endroit."
                                            },
                                            {
                                                "example_id": "07d67eef-288f-4e2e-bdb1-bd319955f31e",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger ses regards sur un objet, vers un objet."
                                            },
                                            {
                                                "example_id": "b16ae697-a60f-4e22-a039-ecff257173bf",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger son attention sur quelque chose."
                                            },
                                            {
                                                "example_id": "9553d2c6-ddcb-4073-9117-fb3fe66d5395",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté.",
                                            "Guider vers un point donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af70ec3f-4997-4648-be96-413104469d7f",
                                                "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                                "text": "Diriger un navire vers le port."
                                            },
                                            {
                                                "example_id": "f11e3c49-0ae2-4f15-a481-9a1a001691c3",
                                                "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                                "text": "Diriger un avion vers la piste d'atterrissage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté.",
                                            "Fixer ou envoyer dans une direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1aa5157-defd-44e6-885b-6c206447c42f",
                                                "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                                "text": "On écrivit au maire d’Allemant qui répondit qu'en effet le capitaine Bordes-Pagès avait été transporté le 9 Septembre à Allemant et que de là on l’avait dirigé sur Linthes."
                                            },
                                            {
                                                "example_id": "15c352cc-50cf-4326-927a-2161d72112df",
                                                "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                                "text": "Pour le tango, la salle était plongée dans l'obscurité, et deux petits projecteurs dirigeaient leurs faisceaux sur la boule à facettes qui tournait lentement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Poursuivre, accuser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f76d24b-5b68-49fe-86eb-fac66eb652a6",
                                                "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                                "text": "Diriger une accusation."
                                            },
                                            {
                                                "example_id": "3c6f0b67-3a4a-454c-a1ac-b5fea2a51b00",
                                                "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                                "text": "Des poursuites furent dirigées contre lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7513a129-0f7b-3997-853f-a79d84d7bdf1",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Aller vers."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085871cf-d5fa-4df2-82b0-7f3751d3e244",
                                                "sense_id": "7513a129-0f7b-3997-853f-a79d84d7bdf1",
                                                "text": "[…] : il attendait, près du portant de gauche, le moment de se diriger du pas d'un homme qui rêve dans la direction de Jimmy, son partenaire, dont la mimique exprimait aussitôt une singulière jubilation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498a1e3c-4e8a-39f3-ac9a-c2c2d71f766e",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Trouver la bonne direction, trouver son chemin."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe37daf-380c-480a-8b84-2654ce744a83",
                                                "sense_id": "498a1e3c-4e8a-39f3-ac9a-c2c2d71f766e",
                                                "text": "Elle peine à se diriger dans l'obscurité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
