                "senses": [
                    {
                        "sense_id": "5244932c-9770-3012-acd2-c0441097b779",
                        "entry_id": "663be108-8b5d-3879-b463-0174a9519612",
                        "glosses": [
                            "Tag, an dem ein Land seine Souveränität erreichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d29f83-41f0-4963-8194-51128f9c0540",
                                "sense_id": "5244932c-9770-3012-acd2-c0441097b779",
                                "text": "„Doch Lumumbas Rede am Unabhängigkeitstag zerstört alle Hoffnungen der einstigen Kolonialherren, weiter Einfluss nehmen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "38404844-b329-3415-8357-f6f4bd570a84",
                        "entry_id": "663be108-8b5d-3879-b463-0174a9519612",
                        "glosses": [
                            "Jahrestag zur Erinnerung an den Tag, an dem die Souveränität eines Landes erreicht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c32a5cc-3856-4f3e-9280-5c226e128b61",
                                "sense_id": "38404844-b329-3415-8357-f6f4bd570a84",
                                "text": "„Anläßlich der Unabhängigkeitstage fordert die IGFM Gleichberechtigung und Schutz für religiöse Minderheiten.“"
                            },
                            {
                                "example_id": "7e64ef94-e61b-499e-97ed-49754b5f68fc",
                                "sense_id": "38404844-b329-3415-8357-f6f4bd570a84",
                                "text": "„Indiens Unabhängigkeitstag wird als einer von drei Nationalfeiertagen jährlich begangen.“"
                            },
                            {
                                "example_id": "c1852ebd-9ddc-4360-989f-febf0b2a5651",
                                "sense_id": "38404844-b329-3415-8357-f6f4bd570a84",
                                "text": "„Der Unabhängigkeitstag kam, und die Nachbarinnen fanden sich für dieses Ereignis zusammen.“"
                            },
                            {
                                "example_id": "4223120a-9c7b-413e-8256-ef90c306344a",
                                "sense_id": "38404844-b329-3415-8357-f6f4bd570a84",
                                "text": "„Der 4. Juli, der amerikanische Unabhängigkeitstag, folgte zwei Wochen auf den Tod ihrer Mutter und fiel auf einen Montag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
