                                                "example_id": "901220dd-7e4c-4f7f-bb1a-849352b5377b",
                                                "sense_id": "6521e327-1318-3906-8706-d212f80afec0",
                                                "text": "[Montrevel] valet et souverainement glorieux, deux qualités fort opposées qu’il avait toutes deux suprêmement,"
                                            },
                                            {
                                                "example_id": "a3fe30f2-5881-4de1-8d8e-7f9820bb1ac5",
                                                "sense_id": "6521e327-1318-3906-8706-d212f80afec0",
                                                "text": "Tout ce qui est ordonné de manière à produire le plus parfaitement l’effet qu’on se propose est suprêmement beau,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
