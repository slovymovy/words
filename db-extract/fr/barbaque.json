        "fr-extract.jsonl": [
            {
                "entry_id": "617ffcc7-772c-3ac5-834d-33d75e36268c",
                "word": "barbaque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "849f71e4-8b3e-45af-926c-78add30b2c5c",
                        "entry_id": "617ffcc7-772c-3ac5-834d-33d75e36268c",
                        "tags": [
                            "plural"
                        ],
                        "form": "barbaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                        "entry_id": "617ffcc7-772c-3ac5-834d-33d75e36268c",
                        "glosses": [
                            "ou Viande."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "acec63e6-91bf-45db-99ca-d0d7df2bfa4a",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "— R’garde ! Les mecs, à côté, i sont d’jà allés quérir leur plat de barbaque…"
                            },
                            {
                                "example_id": "57ada46a-2c57-4cca-a5ea-250349dc043d",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Mais l’obus suivant, percutant sur la chaussée, ne fit point de dégâts. Il y eut seulement, par le soupirail, une pluie de barbaque putréfiée et des jets d’un mélange visqueux de sang et d’humeur…"
                            },
                            {
                                "example_id": "94d910da-00f6-4eb5-aa36-fd5f30ba7f9f",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Enfin Mirandole siffla pour la soupe. De l’épaisse, extra, truffée de dés de barbaque."
                            },
                            {
                                "example_id": "60026496-62e5-4ef0-8851-a43151e26e6f",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Faut avaler d’la barbaque\nPour êt’e bien gras quand on claque"
                            },
                            {
                                "example_id": "f9450c36-5fff-4c20-8613-5fcebc4c4312",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Nous en fûmes quittes pour la peur ; seule, notre belle portion de barbaque fut ensevelie sous les décombres soulevés par cette chute."
                            },
                            {
                                "example_id": "67323d4f-68ad-427f-afd5-4b9b9477e97c",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Peut-on trouver l’inspiration par cette chaleur, surtout quand on a la corpulence de ce morceau de barbaque ?"
                            },
                            {
                                "example_id": "f4ed5fb2-f6d3-4073-8117-b1453360de3c",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "La barbaque est accompagnée de légumes ou de pâtes, c’est comme on veut. Pour le frometon, à pile ou face, on se prend camembert ou bleu."
                            },
                            {
                                "example_id": "f60e9f22-6223-48e6-bbf0-75bf8cfcb411",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "La nourriture était immangeable, des tranches fines d’une indéfinissable barbaque refroidie baignant dans un liquide violacé et acide qui arrachait l’estomac et que je rejetai dès la première bouchée."
                            },
                            {
                                "example_id": "6e621a14-10fb-4873-b855-c04c9defadda",
                                "sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                                "text": "Arrête tes salades, je ne mange que de la barbaque"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec2a0945-1c8a-4748-ae87-5ff582f3a4ab",
                        "source_entry_id": "617ffcc7-772c-3ac5-834d-33d75e36268c",
                        "source_sense_id": "7f63efb7-3bb5-30c7-86f6-ebbd2bccbbe6",
                        "target_lang_word": "meat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "584b8961-4d7c-3462-9e73-baf8f257ba9f",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "The flesh (muscle tissue) of an animal used as food, or a food designed to replicate its taste and texture (like plant-based meat)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c966a7a-116e-498d-96fc-f263ca8f7f2b",
                                                "sense_id": "584b8961-4d7c-3462-9e73-baf8f257ba9f",
                                                "text": "The homesteading teenager shot a deer to supply his family with wild meat for the winter."
                                            },
                                            {
                                                "example_id": "e71807fb-a69e-4ff7-97e4-0b8018f8a505",
                                                "sense_id": "584b8961-4d7c-3462-9e73-baf8f257ba9f",
                                                "text": "In many parts of the world, shark meat is an acceptable and desirable form of protein."
                                            },
                                            {
                                                "example_id": "36546895-17e6-4c4d-901c-e69f57056d89",
                                                "sense_id": "584b8961-4d7c-3462-9e73-baf8f257ba9f",
                                                "text": "While people who eat no meat at all are identified and identifiable as vegetarians, there is no commonly accepted term for people who eat it only a couple of times a week and are selective about its quality."
                                            },
                                            {
                                                "example_id": "d57fe493-3831-4417-af6d-5890fb3e5ef6",
                                                "sense_id": "584b8961-4d7c-3462-9e73-baf8f257ba9f",
                                                "text": "A large portion of domestic meat production comes from animals raised on factory farms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c700b1a7-6a76-37c1-b389-4a4486e2a22d",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A type of meat, by anatomic position and provenance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2903a9f7-9512-4522-9ada-d069c04b7c8c",
                                                "sense_id": "c700b1a7-6a76-37c1-b389-4a4486e2a22d",
                                                "text": "The butchery's profit rate on various meats varies greatly."
                                            },
                                            {
                                                "example_id": "ecb9ce16-b303-4607-8023-7cf2ff28ac23",
                                                "sense_id": "c700b1a7-6a76-37c1-b389-4a4486e2a22d",
                                                "text": "It should come as no surprise that while the peasants are expected to eat fermented fungi, lab-grown meats and maggot milkshakes, the Controligarchs — with their private chefs — have no intention of doing the same."
                                            },
                                            {
                                                "example_id": "a09fcf56-545a-4af3-8a71-4aa9b6c926d0",
                                                "sense_id": "c700b1a7-6a76-37c1-b389-4a4486e2a22d",
                                                "text": "Regularly eating red and processed meats in particular is associated with a higher risk of type 2 diabetes, according to an analysis of data from 31 study cohorts published Tuesday in the journal The Lancet Diabetes & Endocrinology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "Food, for animals or humans, especially solid food. See also meat and drink."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec00743c-897f-4c2a-9a5d-aa57c933fc03",
                                                "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                                "text": "I was anhongred, and ye gave me meate. I thursted, and ye gave me drinke."
                                            },
                                            {
                                                "example_id": "88fb3a65-b758-40ef-a082-59daf57611b7",
                                                "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                                "text": "And he was pleased to accompany them in their death; for, he pined away by abstaining from all manner of meat."
                                            },
                                            {
                                                "example_id": "2149152c-3fcd-4bdc-9fa3-cf14e958d1f8",
                                                "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                                "text": "Your greatest want is, you want much of meat: / Why should you want? Behold, the Earth hath Rootes[…]."
                                            },
                                            {
                                                "example_id": "b5ad376e-e439-408e-a754-c30a49affd7f",
                                                "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                                "text": "As full of fun and frolic as an egg is full of meat."
                                            },
                                            {
                                                "example_id": "a4da9a0f-4c20-46ff-a856-228fc8b99391",
                                                "sense_id": "0c23af3b-58a3-3ddc-ad98-993b87c1bc03",
                                                "text": "The way she said ‘dinner’ and the way she said ‘champagne’ gave meat and liquid their exact difference[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ed2d37d-1e9d-3782-9089-70c7218fca96",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A type of food, a dish."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a44c22f-4b3c-3f1e-ba6d-748a41e5f4fe",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A meal."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f14984a-25de-445e-abc7-b20a6b327566",
                                                "sense_id": "0a44c22f-4b3c-3f1e-ba6d-748a41e5f4fe",
                                                "text": "And hit cam to passe, thatt Jesus satt at meate in his housse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b190ea9a-da18-3f93-bcf5-d347b3fa9b8e",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "Meal; flour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc9b64f1-b775-3303-908f-7b3331e22f1b",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "Any relatively thick, solid part of a fruit, nut etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab2d5d1-33a9-4ed2-9590-e627419f5bfb",
                                                "sense_id": "dc9b64f1-b775-3303-908f-7b3331e22f1b",
                                                "text": "The apple looked fine on the outside, but the meat was not very firm."
                                            },
                                            {
                                                "example_id": "0378c294-c3c3-4a17-91b7-676b3cbc1fc2",
                                                "sense_id": "dc9b64f1-b775-3303-908f-7b3331e22f1b",
                                                "text": "She took her spoon and stirred the melted butter into the yellow meat of the yam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14e31cd-f74a-3e90-a9a7-051d4257a205",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A penis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8577e3-8a14-47b9-b1f8-5cd3cf731ea5",
                                                "sense_id": "e14e31cd-f74a-3e90-a9a7-051d4257a205",
                                                "text": "He sits me on the floor (the shower is still beating down on us). He lays me down and slides his huge meat into me."
                                            },
                                            {
                                                "example_id": "80323e51-ba35-4016-ac05-bcd2fc8cc7eb",
                                                "sense_id": "e14e31cd-f74a-3e90-a9a7-051d4257a205",
                                                "text": "Just the tight, hot caress of his bowels surrounding my meat gave me pleasures I had only dreamed of before that day."
                                            },
                                            {
                                                "example_id": "e0a8c9b6-154a-4a40-9ec6-97094b16bbdb",
                                                "sense_id": "e14e31cd-f74a-3e90-a9a7-051d4257a205",
                                                "text": "Both men were completely, and very actively into this face fucking! Suddenly Bill pulled off of Jim's meat and said,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30235bb9-c2b9-3fa3-8b84-dae68de9b0b7",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "The best or most substantial part of something."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea63701b-1056-479e-9939-86af7a73e70e",
                                                "sense_id": "30235bb9-c2b9-3fa3-8b84-dae68de9b0b7",
                                                "text": "[…]it is time to begin \"A Dialogue between Viator and Piscator,\" which is the meat of the matter."
                                            },
                                            {
                                                "example_id": "b13d5b14-4580-426a-b75a-1391231af2ac",
                                                "sense_id": "30235bb9-c2b9-3fa3-8b84-dae68de9b0b7",
                                                "text": "The editor called the new \"novels\" book-lengthers without the trivialities and slow development of the usual novel. \"They have all the plot complications, meat and excitement that readers demand,\" he stated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b4e174-684a-371a-ae2b-d2a79fb4a774",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "The sweet spot of a bat or club (in cricket, golf, baseball etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3277cfc5-b6b3-4637-b3c1-ad89d3f83790",
                                                "sense_id": "39b4e174-684a-371a-ae2b-d2a79fb4a774",
                                                "text": "He hit it right on the meat of the bat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ae9e9c-ab95-3979-9031-d014dc9c52a7",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A meathead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1825fa63-3438-4c0e-a224-a9be59329ad5",
                                                "sense_id": "f2ae9e9c-ab95-3979-9031-d014dc9c52a7",
                                                "text": "Throw it in here, meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                        "entry_id": "33112e1a-b02e-393c-ac30-0ac546edfd80",
                                        "glosses": [
                                            "A totem, or (by metonymy) a clan or clansman which uses it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c2e7a30-88d7-4b2e-a465-99268592d9c1",
                                                "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                                "text": "When a stranger comes to an aboriginal camp or settlement in north-western NSW, he is asked by one of the older aborigines: \"What meat (clan) are you?\""
                                            },
                                            {
                                                "example_id": "dc02d0fe-0553-46f1-8ea5-374187edec1c",
                                                "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                                "text": "Granny Sullivan was ‘dead against’ the match at first because they did not know \"what my meat was and because I was a bit on the fair side.\""
                                            },
                                            {
                                                "example_id": "8e207796-ef6d-4b0e-bec8-614e17a75bb5",
                                                "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                                "text": "Some people maintained that she was \"sung\" because her family had killed or eaten the \"meat\" (totem) of another group."
                                            },
                                            {
                                                "example_id": "ef42460e-d1ec-4621-a263-7e3378686b58",
                                                "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                                "text": "Our family[…]usually married the red kangaroo \"meat\"."
                                            },
                                            {
                                                "example_id": "ddde5844-6bac-48f8-99df-331719213984",
                                                "sense_id": "a1a1906c-733e-3c0b-8837-cb35b6e6aaa7",
                                                "text": "1993, J. Janson, Gunjies\nThat’s a beautiful goanna. […]. He’s my meat, can’t eat him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
