                        ],
                        "form": "das Momentum"
                    },
                    {
                        "form_id": "5bd6b7a9-eebb-4bba-8a10-8a5c745538b1",
                        "entry_id": "9afb5893-5b1b-3bca-96a2-e4436b9f7668",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Momentums"
                    },
                    {
                        "form_id": "aec14326-854d-45f6-a550-e529d53f528f",
                        "entry_id": "9afb5893-5b1b-3bca-96a2-e4436b9f7668",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Momentum"
                    },
                    {
                        "form_id": "0cb50c79-fd49-4cd1-bb08-1ee050a2bb5b",
                        "entry_id": "9afb5893-5b1b-3bca-96a2-e4436b9f7668",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Momentum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                        "entry_id": "9afb5893-5b1b-3bca-96a2-e4436b9f7668",
                        "glosses": [
                            "vorteilhafte Situation, deren Wahrnehmung und der daraus resultierende Schwung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2860abf7-f32e-4b4a-98ad-f52dc55c68af",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„Und weil nun auch der schon in der ersten Hälfte eingewechselte Torhüter Dejan Milosavljev mit einigen Paraden zum Faktor wurde, kippte das Momentum.“"
                            },
                            {
                                "example_id": "932098d9-80e6-4c0f-a122-bf8d0d5d6a53",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„Burkhard betonte am Rande der Zeremonie, die Eigenständigkeit der Werft könne über verschiedene Wege geschehen. ‚Wir haben jetzt ein Momentum durch Zeitenwende, auch durch ein volles Orderbuch.‘“"
                            },
                            {
                                "example_id": "d252c53f-da35-4966-99b7-547b6defa26a",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„José Negrete aus dem kalifornischen Anaheim etwa: ‚Nichts in dem neuen Vertrag zeigt, was wir 2020 für dieses Unternehmen geleistet haben. Das Momentum war auf unserer Seite.‘“"
                            },
                            {
                                "example_id": "ec34261f-f35c-49f9-8207-3541a0fc1ecb",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„Mit dem in Iowa gewonnenen obzitierten Momentum sollte der demokratische Sieger von Iowa eigentlich auch in New Hampshire gewinnen.“"
                            },
                            {
                                "example_id": "c5f164fb-02c4-4018-a771-1f6bb0483ef8",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„Selbst wenn man der Ausübung des Präsentationsrechts das Momentum einer Ungewissheit für die Dauer des ursprünglichen Bestandvertrages unterstellte, käme diesem Umstand als auflösende Bedingung in Anwendung des § 17 Abs. 4 GebG keine Bedeutung für die Entstehung der Gebührenschuld zu.“"
                            },
                            {
                                "example_id": "88a97a0c-6e33-441d-8bec-7dafa046629c",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„Das Momentum gibt grundsätzlich Aufschluss über das Tempo bzw. die Dynamik einer Kursbewegung. Hier kann das Momentum relevante Ergebnisse liefern.“"
                            },
                            {
                                "example_id": "f96d8eac-6850-44d9-a85f-afe19891d1a1",
                                "sense_id": "87f2a950-f551-30e2-8879-7854a4ee1d3d",
                                "text": "„In den vergangenen Wochen habe sich das Momentum noch einmal abgeschwächt, schrieb [IWF-Chefin] Georgiewa am Mittwoch in einem Blog vor dem Treffen der 20 führenden Industrie- und Schwellenländer (G20).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dce1079a-c1f9-4b0c-b745-1061a8dc24f7",
