{
    "word_family": [
        "crotched",
        "crotchless",
        "crotchety"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46d2240e-85d4-37b6-8e47-4352551c7dfd",
                    "sense_definition": "The area of the human body where the legs join the torso, specifically the region of the genitals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sharp pain in his <w>crotch</w> after falling off the bicycle.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал резкую боль в <w>промежности</w> после падения с велосипеда."
                            }
                        },
                        {
                            "text": "The jeans were too tight around the <w>crotch</w> area, making it hard to walk.",
                            "target_lang_translations": {
                                "ru": "Джинсы были слишком тесными в <w>шагу</w>, из-за чего было трудно ходить."
                            }
                        }
                    ],
                    "synonyms": [
                        "groin"
                    ],
                    "common_phrases": [
                        "kick in the crotch",
                        "crotch area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область человеческого тела, где ноги соединяются с туловищем, в частности область гениталий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промежность",
                                "target_lang_sense_clarification": "анатомическая область между бедрами"
                            },
                            {
                                "target_lang_word": "пах",
                                "target_lang_sense_clarification": "нижняя часть живота между бедрами"
                            },
                            {
                                "target_lang_word": "ширинка",
                                "target_lang_sense_clarification": "в контексте одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a633e157-7ae0-3b08-9640-8e3a579c2d37",
                    "sense_definition": "The place where a tree trunk or branch divides into two or more parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird built its nest securely in the <w>crotch</w> of the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Птица надежно свила гнездо в <w>развилке</w> старого дуба."
                            }
                        },
                        {
                            "text": "He found a comfortable <w>crotch</w> of a tree to sit in while he waited.",
                            "target_lang_translations": {
                                "ru": "Он нашел удобную <w>развилину</w> на дереве, чтобы посидеть, пока ждал."
                            }
                        }
                    ],
                    "synonyms": [
                        "fork",
                        "bifurcation",
                        "junction"
                    ],
                    "common_phrases": [
                        "crotch of a tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где ствол дерева или ветка разделяется на две или более части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развилка",
                                "target_lang_sense_clarification": "разветвление ветвей или ствола"
                            },
                            {
                                "target_lang_word": "развилина",
                                "target_lang_sense_clarification": "место разветвления"
                            },
                            {
                                "target_lang_word": "разветвление",
                                "target_lang_sense_clarification": "место, где что-либо расходится в стороны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071ae740-5aa3-36fa-8560-8ddbe2e68a3a",
                    "sense_definition": "The internal angle formed where two lines or strokes meet, such as in the letters V or Y.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The typographer adjusted the <w>crotch</w> of the letter Y to improve its appearance.",
                            "target_lang_translations": {
                                "ru": "Типограф подправил <w>развилку</w> буквы Y, чтобы улучшить её внешний вид."
                            }
                        },
                        {
                            "text": "In calligraphy, the <w>crotch</w> where the two strokes meet should be sharp and clean.",
                            "target_lang_translations": {
                                "ru": "В каллиграфии <w>угол</w>, где сходятся два штриха, должен быть острым и четким."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertex",
                        "angle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "typography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний угол, образованный в месте соединения двух линий или штрихов, например, в буквах V или Y."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развилка",
                                "target_lang_sense_clarification": "в типографике, место схождения штрихов"
                            },
                            {
                                "target_lang_word": "угол",
                                "target_lang_sense_clarification": "место соединения линий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d5f8dbc-ab0a-3797-8bc0-fa23746c022e",
                    "sense_definition": "To strike someone in the genital region.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler was accidentally <w>crotched</w> when he landed on the top rope.",
                            "target_lang_translations": {
                                "ru": "Рестлер случайно <w>получил удар в пах</w>, когда приземлился на верхний канат."
                            }
                        },
                        {
                            "text": "He doubled over in pain after his opponent <w>crotched</w> him during the scuffle.",
                            "target_lang_translations": {
                                "ru": "Он согнулся от боли после того, как противник <w>ударил его в пах</w> во время потасовки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports or stunts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо в область гениталий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить в пах",
                                "target_lang_sense_clarification": "нанести удар в область гениталий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "573c97a6-b4f6-39a0-9916-53dbcc6c2ff4",
                    "sense_definition": "To hide stolen or prohibited items between one's thighs or in underwear to smuggle them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>crotch</w> a small bottle of expensive perfume before leaving the store.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>спрятать в штанах</w> маленький флакон дорогих духов перед тем, как выйти из магазина."
                            }
                        },
                        {
                            "text": "Security caught the man who had <w>crotched</w> several items under his loose clothing.",
                            "target_lang_translations": {
                                "ru": "Охрана поймала мужчину, который <w>спрятал в промежности</w> несколько предметов под свободной одеждой."
                            }
                        }
                    ],
                    "synonyms": [
                        "smuggle",
                        "stash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прятать украденные или запрещенные предметы между бедрами или в нижнем белье для контрабанды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прятать в штаны",
                                "target_lang_sense_clarification": "скрывать что-либо в области промежности"
                            },
                            {
                                "target_lang_word": "засовывать в трусы",
                                "target_lang_sense_clarification": "сленг, прятать для кражи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa34199d-bb3f-3a58-b712-a48b8e7fb56f",
                    "sense_definition": "To shear wool from the area around the tail and between the hind legs of a sheep.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "farming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer spent the whole afternoon <w>crotching</w> the ewes before the lambing season began.",
                            "target_lang_translations": {
                                "ru": "Фермер провел весь день, <w>обстригая</w> овец перед началом сезона окота."
                            }
                        },
                        {
                            "text": "It is essential to <w>crotch</w> the sheep to prevent flies from bothering them in the summer.",
                            "target_lang_translations": {
                                "ru": "Необходимо <w>обстригать шерсть между ног</w> у овец, чтобы мухи не беспокоили их летом."
                            }
                        }
                    ],
                    "synonyms": [
                        "crutch"
                    ],
                    "common_phrases": [
                        "crotching the sheep"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стричь шерсть в области хвоста и между задними ногами овцы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обстригать",
                                "target_lang_sense_clarification": "шерсть вокруг хвоста и между ног овцы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}