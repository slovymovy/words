                    {
                        "translation_id": "edfc96a7-f1b2-4b10-bc44-437325da07f0",
                        "source_entry_id": "f79d9737-215d-3569-a72c-e2c221f0f11e",
                        "source_sense_id": "c7a67c25-fa7a-3741-aa46-40c04851bffb",
                        "source_sense_description": "resulting from an illusion",
                        "target_lang_word": "illusionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illusionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c588998-ae89-3b5e-af1e-9e226a903269",
                                        "entry_id": "560f5979-58fe-35a4-997d-056fe6c0e2e1",
                                        "glosses": [
                                            "auf Illusionen beruhend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43085c1f-3dc9-4b4d-b5f0-5bf4b6f8b5c3",
                                                "sense_id": "5c588998-ae89-3b5e-af1e-9e226a903269",
                                                "text": "Diese Gemeinplätze täuschen darüber hinweg, dass wesentliche Segmente unserer Gesellschaft mit dem Phänomen Jugend verlogen, illusionär, hysterisch, im schlimmsten Fall spekulativ umgehen."
                                            },
                                            {
                                                "example_id": "0c5fa148-b0a1-4b3e-9390-b60cb177101c",
                                                "sense_id": "5c588998-ae89-3b5e-af1e-9e226a903269",
                                                "text": "Andererseits haben sich alle Hoffnungen auf einen Kurswechsel als illusionär erwiesen, die sich mit Raúl Castro anfangs verbanden."
                                            },
                                            {
                                                "example_id": "b8762c6b-6204-4657-95bc-d0ccd6a01383",
                                                "sense_id": "5c588998-ae89-3b5e-af1e-9e226a903269",
                                                "text": "Sie suggerieren eine oft illusionäre, aber doch eifrig angenommene Sicherheit wie etwa vor einiger Zeit im burgenländischen Wahlkampf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26efccdd-b161-3ebd-a918-905211b3dc7a",
                                        "entry_id": "560f5979-58fe-35a4-997d-056fe6c0e2e1",
                                        "glosses": [
                                            "durch künstlerische Darstellung Illusionen, insbesondere hinsichtlich Körperlichkeit oder Raumtiefe, hervorrufend"
                                        ],
                                        "tags": [
                                            "Kunstwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b1cfdb-a176-4a1f-b68f-1559f5eb2e87",
                                                "sense_id": "26efccdd-b161-3ebd-a918-905211b3dc7a",
                                                "text": "Geometrische Flächen und Körper-Formen ordnete er in leuchtenden Farben mosaik- und puzzleartig so an, dass für das menschliche Doppel-Auge der illusionäre Eindruck von Raum und Bewegung entsteht."
                                            },
                                            {
                                                "example_id": "711259db-46a3-468c-b550-adf0f470e8da",
                                                "sense_id": "26efccdd-b161-3ebd-a918-905211b3dc7a",
                                                "text": "Das Bild soll nicht aus illusionären Elementen, vorgespiegelter Räumlichkeit, aufgebaut werden, sondern aus Flächen, die seiner eigenen Seinsweise als Fläche entsprechen; …"
                                            },
                                            {
                                                "example_id": "83bf2a95-d228-45c8-a2e4-3b09d88cc3c4",
                                                "sense_id": "26efccdd-b161-3ebd-a918-905211b3dc7a",
                                                "text": "Die Verschränkung verschiedener Bildträger und Sehebenen bezieht den realen und illusionären Raum bewusst ein und verwirrt den Blick des Betrachters."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ede38fcb-f48e-47ea-956d-f6755adb322d",
                        "source_entry_id": "f79d9737-215d-3569-a72c-e2c221f0f11e",
