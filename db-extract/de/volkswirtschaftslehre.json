                "translations": [
                    {
                        "translation_id": "d3c8d90d-1e4b-41ee-bd58-f663b436d160",
                        "source_entry_id": "0dc2bb48-f682-38c8-b1dd-45b8fe141140",
                        "source_sense_id": "55665203-acf3-3584-a382-8a045f7e17f8",
                        "source_sense_description": "Teilgebiet der Wirtschaftswissenschaft",
                        "target_lang_word": "economics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "economics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc013a41-4252-365c-b6f1-cc918d389b34",
                                        "entry_id": "59dfa816-751f-32e9-ab6e-5d5fd37c34a9",
                                        "glosses": [
                                            "The study of resource allocation, distribution and consumption; of capital and investment; and of management of the factors of production."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65084ba2-1f45-462f-9682-00c320921a17",
                                                "sense_id": "fc013a41-4252-365c-b6f1-cc918d389b34",
                                                "text": "Mary studied economics for five years before going into banking."
                                            },
                                            {
                                                "example_id": "ba28df8a-bdcc-48cf-8ab4-f1aafbd96390",
                                                "sense_id": "fc013a41-4252-365c-b6f1-cc918d389b34",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a4457bc-73c8-4f42-adce-671aa07dbda3",
                        "source_entry_id": "0dc2bb48-f682-38c8-b1dd-45b8fe141140",
                        "source_sense_id": "55665203-acf3-3584-a382-8a045f7e17f8",
                        "source_sense_description": "Teilgebiet der Wirtschaftswissenschaft",
                        "target_lang_word": "économie politique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économie politique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41f3ca98-3ef1-34b0-ba45-068a56d1db2f",
                                        "entry_id": "dc0b750e-6161-31f9-9646-9ff4180450cf",
                                        "glosses": [
                                            "Discipline des sciences sociales qui étudie les relations entre l’économie, le pouvoir politique et les institutions, notamment en matière de production, de distribution et de régulation des richesses. Elle comprend aussi les courants critiques opposés à une approche apolitique de l’économie."
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6f0d12-262b-4117-9e18-631b4a06507a",
                                                "sense_id": "41f3ca98-3ef1-34b0-ba45-068a56d1db2f",
                                                "text": "Dès que Dieu et les pontifes de l’économie politique interviennent, on peut être assuré que l’injustice et l’inégalité prévalent."
                                            },
                                            {
                                                "example_id": "a5f1a64d-bcd6-4e61-bd8f-2a6684d4eb67",
                                                "sense_id": "41f3ca98-3ef1-34b0-ba45-068a56d1db2f",
                                                "text": "Sur le plan de l’économie politique, les lettristes offrent des solutions, et je crois que les anarchistes devraient envisager ces solutions, et peut-être même agir avec nous si ces solutions semblent valables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37c7bcd7-cf8e-4aa0-a09c-36d55a55feb5",
                        "source_entry_id": "0dc2bb48-f682-38c8-b1dd-45b8fe141140",
                        "source_sense_id": "55665203-acf3-3584-a382-8a045f7e17f8",
                        "source_sense_description": "Teilgebiet der Wirtschaftswissenschaft",
                        "target_lang_word": "economie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "economie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7db3d2-545f-3b14-85c7-fb5481db3155",
                                        "entry_id": "a220eb14-515e-3772-9f94-9d81cd7acd02",
                                        "glosses": [
                                            "de leer die zich bezighoudt met de voortbrenging en verdeling van schaarse goederen en diensten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8feaa12-6de2-44f7-bc4b-c4d1097a8fc4",
                                                "sense_id": "fc7db3d2-545f-3b14-85c7-fb5481db3155",
                                                "text": "Ik had een onvoldoende voor economie, maar mocht toch naar de volgende klas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6792ba4c-d73c-308c-bb39-3cc173e35d27",
                                        "entry_id": "a220eb14-515e-3772-9f94-9d81cd7acd02",
                                        "glosses": [
                                            "de economische praktijk ofwel het geheel van productie, handelsverkeer en diensten binnen een bepaalde regio"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d909cfa-69fb-4bee-a922-4830254597dc",
                                                "sense_id": "6792ba4c-d73c-308c-bb39-3cc173e35d27",
                                                "text": "De economie loopt in dat land al jaren slecht."
                                            },
                                            {
                                                "example_id": "92f8a3b4-e24c-4d3b-bc86-731c68bc93b1",
                                                "sense_id": "6792ba4c-d73c-308c-bb39-3cc173e35d27",
                                                "text": "\"Onderzoekers zijn hier welkom\": Macron was vandaag kritisch over het beleid van zijn Amerikaanse collega. \"Wie had ooit kunnen denken dat zo'n grote democratie, met een economie die juist steunt op vrije wetenschap, zo'n grote fout zou maken\", zei Macron. Amerikaanse onderzoekers zijn hier welkom, voegde hij eraan toe. En om ze op te vangen heeft Parijs 100 miljoen euro beschikbaar. \"Europa moet een toevluchtsoord zijn voor wetenschappers die worden bedreigd.\""
                                            }
                                        ]
                                    },
