                "senses": [
                    {
                        "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                        "entry_id": "06ff2462-14d7-35d3-bf1a-02ecfb297fdd",
                        "glosses": [
                            "Ventilator aus Polymer zur Erzeugung eines Luftstroms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3310a23-4a65-445e-99bb-62f7928cfbda",
                                "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                                "text": "„Kunststofflüfter können in Baureihen zusammengefasst werden, solange die Ausführung sich lediglich durch unterschiedliche Größen unterscheiden und nicht konstruktiv.“"
                            },
                            {
                                "example_id": "67cda178-0605-4642-8899-5d6baee89868",
                                "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                                "text": "„Ein Kunststofflüfter sorgt für die Kühlung der Motoren.“"
                            },
                            {
                                "example_id": "d4447993-81c5-4739-96bc-d446f969cf45",
                                "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                                "text": "„Die Buchse des Kunststofflüfters auf eine Heizplatte legen und auf maximal 80 °C erwärmen. Der Kunststofflüfter darf dabei keinen direkten Kontakt mit der Heizplatte haben!“"
                            },
                            {
                                "example_id": "93dba092-36f2-4ec1-b35d-f654ac06fc38",
                                "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                                "text": "„Alle Motoren werden mit einem robusten und temperaturbeständigen Kunststofflüfter oder Aluminiumlüfter ausgerüstet.“"
                            },
                            {
                                "example_id": "41426bc0-1049-4499-b3f8-3ec6c698e8cd",
                                "sense_id": "853e515c-eb95-3e24-9043-af8ad9ccf67c",
                                "text": "„Je nach Montageart kann dieser geräuscharme Kunststofflüfter zur aktiven Be- oder Entlüftung im Terrarium eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
