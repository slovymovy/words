                            {
                                "example_id": "382aa44b-20d7-4075-9a8d-83450a7267f7",
                                "sense_id": "9328179d-b9f5-3809-b572-6d33d26c20ae",
                                "text": "Nieświadomie uniosłem rękę, by dotknąć świeżego rysunku, na którym zasychała warstewka limfy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
