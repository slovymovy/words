                                    {
                                        "sense_id": "4abb6dae-c26a-3c83-80c7-51a96ab4873b",
                                        "entry_id": "0ee97fd7-a1e6-3de7-963b-e632d62061ea",
                                        "glosses": [
                                            "Information über die Richtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d845c9-1451-4dcc-944e-82ba97674b28",
                                                "sense_id": "4abb6dae-c26a-3c83-80c7-51a96ab4873b",
                                                "text": "Die Journalisten konnten für diese Neuigkeit noch keine Bestätigung erhalten."
                                            },
                                            {
                                                "example_id": "a1db4201-ea05-4652-a9de-9e6280d3c186",
                                                "sense_id": "4abb6dae-c26a-3c83-80c7-51a96ab4873b",
                                                "text": "„Und sie erhielt die Bestätigung dafür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5c85a90-8863-3a0b-bb85-91dfc90ae4b5",
                                        "entry_id": "0ee97fd7-a1e6-3de7-963b-e632d62061ea",
                                        "glosses": [
                                            "Unterstützung für jemand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75df4292-7c54-4e58-962e-36f0799b2c59",
                                                "sense_id": "c5c85a90-8863-3a0b-bb85-91dfc90ae4b5",
                                                "text": "Für seine Bemühungen fand er viel Bestätigung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fc859c21-7b36-3cda-9bb1-3724c04f1f5e",
                                        "entry_id": "0ee97fd7-a1e6-3de7-963b-e632d62061ea",
                                        "glosses": [
                                            "amtliches Papier oder amtliche Verlautbarung über etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acebb749-5d37-47a4-8053-ac7edf1b8a8e",
                                                "sense_id": "fc859c21-7b36-3cda-9bb1-3724c04f1f5e",
                                                "text": "Das Finanzamt verlangt Bestätigungen für alle möglichen Ausgaben in Form von Belegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504b581b-e975-4cba-8782-240570c73d66",
                        "source_entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "source_sense_description": "that which is affirmed",
                        "target_lang_word": "Zustimmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zustimmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                        "entry_id": "acc6c578-97fe-3ac4-b462-419c97f900bd",
                                        "glosses": [
                                            "Aussage, dass man mit einer Meinung, einer Tat, einem Plan einverstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52852bc-21d1-496b-8871-ef7c91e5bf2b",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Da haben sie meine uneingeschränkte Zustimmung."
                                            },
                                            {
                                                "example_id": "76f2742c-3314-4831-b976-ca8974cdfa51",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Jedoch fand der Vorschlag in der Partei keine Zustimmung."
                                            },
                                            {
                                                "example_id": "65aa444e-3b2c-49eb-bed4-66854dea406d",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Mit dem Vorschlag, nochmals die Steuern anzuheben, werden sie in der Bevölkerung wohl kaum auf Zustimmung stoßen."
                                            },
                                            {
                                                "example_id": "979680a0-6202-4b26-abca-5ff6fdb83f18",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Die neue Regelung tritt ohne vorherige Zustimmung des Betriebsrates in Kraft."
                                            },
                                            {
                                                "example_id": "0ae8cc09-6396-4037-9a68-f497039a2726",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Die Kartellbehörde gab vergangenen Montag ihre endgültige Zustimmung zur Fusion der beiden Unternehmen."
                                            },
                                            {
                                                "example_id": "6a39f6bd-5bcd-42d1-91b1-0f9abfe884e2",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Für dieses Vorgehen benötigen wir die Zustimmung aller Beteiligten."
                                            },
                                            {
                                                "example_id": "e889d502-532c-4059-997c-d7c7d4083d0f",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "Vor der Organentnahme muss der Patient seine Zustimmung erklären."
                                            },
                                            {
                                                "example_id": "987d4a9f-049f-4ac4-a7bd-165c90880132",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "„In seinem Kampf um die Zustimmung zur Vertreibung der Deutschen und der Magyaren aus der Tschechoslowakei hatte Beneš also starke Verbündete.“"
                                            },
                                            {
                                                "example_id": "b051220a-1d79-4acd-ad8b-0be9e5f2b79e",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "„Enthusiastische Zustimmung für dieses Buch kam von Thomas Mann, Romain Rolland, Alfred Kerr, Maxim Gorki und Heinrich Mann.“"
                                            },
                                            {
                                                "example_id": "d0a116ef-bedc-4c7c-b0bf-a7dba3deb7e6",
                                                "sense_id": "0df8eb4e-be80-354c-ba95-14ea50cb766f",
                                                "text": "„Er murmelte etwas zur Zustimmung und verabschiedete sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
