                "senses": [
                    {
                        "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                        "entry_id": "2ce1c603-6d67-3437-9f3e-ae33194451f4",
                        "glosses": [
                            "an den Vorhöfen befindliche Ausstülpungen beim Herzen von Menschen und Säugetieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42f2b49-cdef-4b20-ae64-8993ff05fd1b",
                                "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                                "text": "„Der Schrittmacher leitet über die Sonde Stimulationsimpulse zum Herzen/Vorhofohr und detektiert darüber die elektrischen Signale des Herzens.“"
                            },
                            {
                                "example_id": "75706063-d6fa-461b-86d9-915d9e0cbb0f",
                                "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                                "text": "„Neben dem größeren Hohlraum des Vorhofs, der glatt ausgekleidet ist, gibt es im rechten und im linken Vorhof auch noch das Vorhofohr (Auriculum cordis).“"
                            },
                            {
                                "example_id": "e3015bb1-4126-465e-b48a-4831f119faee",
                                "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                                "text": "„Meist liegt zudem valvuläres Vorhofflimmern vor, was die Gefahr einer Thrombenbildung im linken Vorhofohr in sich birgt!“"
                            },
                            {
                                "example_id": "6a382445-1764-4a3e-888d-352c45875ce2",
                                "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                                "text": "„Das linke Vorhofohr ist eher fingerartig geformt, es besitzt keine breite Basis wie das rechte Vorhofohr.“"
                            },
                            {
                                "example_id": "a9d142d6-a1fe-4135-bae4-92ac9d5061e1",
                                "sense_id": "ce10dd58-e49d-3b63-9a7c-014e5ff21ffb",
                                "text": "„Vielfach wird das Vorhofohr für die Platzierung verwendet, da die Dislokationsrate hier geringer und die Werte vielfach gut sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
