                        "cross_references": [
                            {
                                "target_word": "Nanking",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "324ea922-e84d-3842-af77-672971a19c67",
                                        "entry_id": "ee090b7b-8aca-3f86-a7f5-abec0a86f453",
                                        "glosses": [
                                            "Hauptstadt der chinesischen Provinz Jiangsu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc870cb7-0549-432b-b576-6dc73f6b9034",
                                                "sense_id": "324ea922-e84d-3842-af77-672971a19c67",
                                                "text": "In Nanking gibt es mehrere Universitäten."
                                            },
                                            {
                                                "example_id": "618f842d-49a9-4741-9b03-53cc15f7e097",
                                                "sense_id": "324ea922-e84d-3842-af77-672971a19c67",
                                                "text": "„Zu jener Zeit traf Lai-bau mit dem Frachtschiff aus Nanking wieder ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nanking",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bda9c10-4fb5-3660-84a1-80b85cd33b0c",
                                        "entry_id": "8491e8c9-532d-3695-b97b-535434d38338",
                                        "glosses": [
                                            "glattes, dichtes Baumwollgewebe von gelblicher Farbe"
                                        ],
                                        "tags": [
                                            "Textilwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e852fde3-8cd2-4dea-93c9-b92131965c53",
                                                "sense_id": "3bda9c10-4fb5-3660-84a1-80b85cd33b0c",
                                                "text": "„Schliesslich setzte der Reisende sich in einem abgetragenen, mit Nanking überzogenen Schafspelz, Filzstiefel an den mageren, knochigen Beinen, auf den Diwan, legte seinen sehr grossen, an den Schläfen auffallend breiten, kurzgeschorenen Kopf gegen die Lehne und sah jetzt Besuchow an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2693a17-6e14-4fcc-92ef-5747668c9ccd",
                        "source_entry_id": "9a9ddccf-aeed-34f3-aa0e-a87b2204dc79",
                        "source_sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                        "target_lang_word": "Lanking",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d6f6f07-0d7a-4bcf-80b0-8e14fd7408c1",
                        "source_entry_id": "9a9ddccf-aeed-34f3-aa0e-a87b2204dc79",
                        "source_sense_id": "0e9c556f-76b7-3487-b4df-a038a38cf283",
                        "target_lang_word": "nankin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nankin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                        "entry_id": "c4c52ee3-3acc-3670-9ce7-08f864e73371",
                                        "glosses": [
                                            "Toile de coton épaisse de couleur jaune chamois, faite avec une variété de coton qui possède naturellement cette couleur sans teinture"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb0846c-7746-4274-8a32-c0e356d5e7b9",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "[…] vêtu d’un frac bleu-barbeau, d’un pantalon de nankin et d’un gilet blanc"
                                            },
                                            {
                                                "example_id": "8d455ca9-b298-4535-9579-db97a3def1ca",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "Il y a surtout, chez le fripier d’à côté, un habit de nankin et un cor de chasse qui m’agacent l’œil depuis longtemps."
                                            },
                                            {
                                                "example_id": "5f7646d1-2d1b-4269-ac28-f5c26dc6f8a0",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "Cette diligence était tapissée de nankin, et garnie de stores et de jalousies vertes. Elle nous parut le suprême de l’élégance après les abominables galères, sillas volantes et carrosses, où nous avions été secoués jusqu’alors."
                                            },
                                            {
                                                "example_id": "16cb5a04-4dbc-4265-8207-ae7eebac4c01",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "Quatre rubans de satin tombant du dais étaient tenus par deux bambins habillés en nankin jaune, brodé sur toutes les coutures."
                                            },
                                            {
                                                "example_id": "0e1a62f1-7f74-44ce-90e5-694c40bc8545",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "Ces matins ne sont plus où se voyaient de riches armateurs, en pantalon de nankin, sur le damier des quais."
                                            },
                                            {
                                                "example_id": "d20f9c03-cc54-48b8-b19e-e30d3ec7d012",
                                                "sense_id": "6e8df2e4-52f9-30fe-ae38-7744d78d918d",
                                                "text": "Il s’en fit faire en nankin et en soie sauvage, en toile de voile, en tiercelin et jusqu’en cuir d’ameublement."
                                            }
                                        ]
                                    }
                                ]
                            },
