                "senses": [
                    {
                        "sense_id": "52099927-4bfe-3264-8107-dfc8b7c2302f",
                        "entry_id": "416dbf05-1741-37dd-9d41-07ce9014dfe6",
                        "glosses": [
                            "ein Kartenspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45571f6e-b178-4243-8f6c-f086cc17a897",
                                "sense_id": "52099927-4bfe-3264-8107-dfc8b7c2302f",
                                "text": "„Er küsste Sara flüchtig zum Abschied und setzte sich dann zu Jochi und Finus in die Wohnstube, wo sie gut gelaunt Karnöffel spielten und Jochebed wie üblich gewinnen ließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c38b85a8-3be1-3f56-aa12-11a908ba3db9",
                        "entry_id": "416dbf05-1741-37dd-9d41-07ce9014dfe6",
                        "glosses": [
                            "eine zu [1] dienende Karte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a50299af-6f6e-4022-b00b-a3a9c5f26286",
                                "sense_id": "c38b85a8-3be1-3f56-aa12-11a908ba3db9",
                                "text": "„Im Karnöffelspiel stechen die mindern die mehrern, die untern die obern, und das Karnöffel sticht sie allesammt.“"
                            },
                            {
                                "example_id": "bcdcc797-72e7-4000-8554-3572b0613e66",
                                "sense_id": "c38b85a8-3be1-3f56-aa12-11a908ba3db9",
                                "text": "„Warumb doch der Karnöffel den Keiser sticht und den Babst, so er doch nach viel hochverstendiger leute deuttung ein schlechter Landsknecht ist, und der Oberman ein Reisiger, der Keiser ein Keiser, der Babst ein Babst?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ecd49ec4-37da-3be6-8407-671aea1d4c8a",
                        "entry_id": "416dbf05-1741-37dd-9d41-07ce9014dfe6",
                        "glosses": [
                            "Eingeweidebruch beim Mann, der eine Sonderform des Leistenbruches darstellt und bis zum Hodensack (Latein: scrotum ^(→ la)) reicht"
                        ],
                        "tags": [
                            "outdated"
                        ],
