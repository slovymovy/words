                "word": "désordonnément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4da50adb-b947-38f3-872c-7a0190f5c7e2",
                        "entry_id": "fb01f932-8caf-3ae0-b2a9-4700ab7b14b2",
                        "glosses": [
                            "D’une manière désordonnée, avec licence et désordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3668b720-b69f-4ec4-a429-c6778121dce6",
                                "sense_id": "4da50adb-b947-38f3-872c-7a0190f5c7e2",
                                "text": "Vivre désordonnément."
                            },
                            {
                                "example_id": "9b38b62c-9538-492c-ae74-c940e1d5006a",
                                "sense_id": "4da50adb-b947-38f3-872c-7a0190f5c7e2",
                                "text": "– Vous avez fait des vers libres un jour, c’est que, ce jour-là, vous avez eu l’âme de votre époque, vous avez senti que l’alexandrin ne vous suffisait pas, qu’il rognait vos ailes de poète, et alors, vous avez dit en vers libres ce qui chantait désordonnément en vous et dans le rythme où il y chantait."
                            },
                            {
                                "example_id": "939a3e44-f586-42fd-bdcb-5bc55dc5fd3b",
                                "sense_id": "4da50adb-b947-38f3-872c-7a0190f5c7e2",
                                "text": "[…] une espèce d'atmosphère théâtrale, comme à l'Opéra, quand le rideau bouge, et dans la fosse préludent désordonnément les violons et les flûtes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f042dd67-adc4-3c34-8884-47178fc7cbfc",
                        "entry_id": "fb01f932-8caf-3ae0-b2a9-4700ab7b14b2",
                        "glosses": [
                            "Excessivement, sans mesure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205766d4-4806-48fe-b9cb-10a368a542b4",
                                "sense_id": "f042dd67-adc4-3c34-8884-47178fc7cbfc",
                                "text": "Ce qu’ils aiment désordonnément."
                            },
                            {
                                "example_id": "766a5a9a-b2d1-41a7-9f19-d4ff280eb41d",
                                "sense_id": "f042dd67-adc4-3c34-8884-47178fc7cbfc",
                                "text": "Ils recherchent la science désordonnément."
                            }
                        ]
                    }
