                            },
                            {
                                "target_lang_word": "грохнуть",
                                "target_lang_sense_clarification": "разг., ударить с шумом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "砸",
                                "target_lang_sense_clarification": "猛力击打或砸下"
