                        "form": "die Gemeinsamkeit"
                    },
                    {
                        "form_id": "489b40f9-cf9e-4548-9aea-252e83fa9f40",
                        "entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gemeinsamkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                        "entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                        "glosses": [
                            "Eigenschaft, die bei zwei oder mehr Personen oder Gegenständen identisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb32ea84-5378-472d-8fce-f0abdc4200bd",
                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                "text": "Wir hatten einfach keinerlei Gemeinsamkeiten. Deshalb haben wir uns getrennt."
                            },
                            {
                                "example_id": "56d306a4-8b73-47a5-a7cc-5693a19d8a9d",
                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                "text": "Die Vertreter einer Pflanzengattung zeigen meist deutliche morphologische Gemeinsamkeiten."
                            },
                            {
                                "example_id": "d019920d-7911-4838-9b16-698fb9fc1a3f",
                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                "text": "„Auch die Biographien von Feuchtwanger und Kisch weisen eine Gemeinsamkeit auf, nämlich ihre Erfahrungen mit dem Exil.“"
                            },
                            {
                                "example_id": "40b1a3d6-8ba7-4410-9557-bd778d952a39",
                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                "text": "„Es gab hier eine Gemeinsamkeit der Atmosphäre, wie sie auch von den Einrichtungen und Gesten der Stadt ausging, zu der er nicht gehörte, die ihn aber immer stärker in den Bann zog.“"
                            },
                            {
                                "example_id": "0a96b449-c79c-444b-9cb5-24cfdc0b81af",
                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                "text": "„Die Gemeinsamkeit erschöpft sich auf den ersten Blick im lateinischen Alphabet, dessen einheitsstiftende Kraft durch eine Schriftreform mit der Einführung der karolingischen Minuskel allerdings noch verstärkt wurde, und einigen Merkmalen der zweiten Lautverschiebung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f60855bc-65bc-33ee-a434-d5a2f0d20a8b",
                        "entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                        "glosses": [
                            "friedliches, harmonisches Zusammensein von Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "669c3dd9-f7d3-42f1-ab9b-f989f8519bd8",
                                "sense_id": "f60855bc-65bc-33ee-a434-d5a2f0d20a8b",
                                "text": "Die beiden lebten in trauter Gemeinsamkeit zusammen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffd0818b-438b-4655-b826-1af57d069cbc",
                        "source_entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                        "source_sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                        "source_sense_description": "Eigenschaft, die bei zwei oder mehr Personen oder Gegenständen identisch ist",
                        "target_lang_word": "common ground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "common ground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf51e25-6cc7-3aa5-91e9-bf70f3f46f96",
                                        "entry_id": "4b63a210-f94b-3d51-ab2f-dbe3b942b502",
                                        "glosses": [
                                            "A characteristic or interest shared by multiple people or systems; any belief, etc. held in common."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf0ca42-0ce1-40fb-a3e2-1df63af03ff0",
                                                "sense_id": "4bf51e25-6cc7-3aa5-91e9-bf70f3f46f96",
                                                "text": "The first thing to do is to find common ground with the person you just met."
                                            },
                                            {
                                                "example_id": "cd790971-329c-4d41-aae8-cabbbe9862b4",
                                                "sense_id": "4bf51e25-6cc7-3aa5-91e9-bf70f3f46f96",
                                                "text": "You'll say, we've got nothing in common\nNo common ground to start from\nAnd we're falling apart"
                                            },
                                            {
                                                "example_id": "e73a9514-4fba-46be-a13f-b08bb5cb014d",
                                                "sense_id": "4bf51e25-6cc7-3aa5-91e9-bf70f3f46f96",
                                                "text": "On Monday, he tasked his third prime minister in 12 months, Sébastien Lecornu, to try again to find common ground between political parties dead set against doing so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81beb442-de7e-4b16-b063-1eb05f472f64",
                        "source_entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                        "source_sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                        "source_sense_description": "Eigenschaft, die bei zwei oder mehr Personen oder Gegenständen identisch ist",
                        "target_lang_word": "commonality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e972b1d7-95f5-3a4c-8309-90eb739921c5",
                                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                                        "glosses": [
                                            "The joint possession of a set of attributes or characteristics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66875ba2-ec59-4b7f-909b-fa47db85438e",
                                                "sense_id": "e972b1d7-95f5-3a4c-8309-90eb739921c5",
                                                "text": "Zunin sold the idea to his military superiors in the fearful jargon of his profession: \"In a situation where commonality of loss of the husband is present, the group can be exceedingly supportive.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667a386c-ebd8-3edc-b77f-c01ad49f8a56",
                                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                                        "glosses": [
                                            "Such a shared attribute or characteristic"
                                        ],
                                        "tags": [
                                            "countable",
