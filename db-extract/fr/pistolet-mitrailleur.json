                    {
                        "form_id": "93a16e89-451e-48e4-bdf3-829a06651530",
                        "entry_id": "16f4490f-ae5d-37b1-b4cc-67557588c166",
                        "tags": [],
                        "form": "pistolet mitrailleur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                        "entry_id": "16f4490f-ae5d-37b1-b4cc-67557588c166",
                        "glosses": [
                            "Synonyme de mitraillette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e2bbc4-e6cf-4932-bd1b-1b4e19f79e1f",
                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                "text": "Le pistolet-mitrailleur est une arme produite à grande échelle pendant la Seconde Guerre mondiale."
                            },
                            {
                                "example_id": "2e294578-632d-48ca-bec7-adb7cd175872",
                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                "text": "Nadine Lemercier sortit la première, suivie de l’adjudant-chef Greudin armé du pistolet-mitrailleur."
                            },
                            {
                                "example_id": "2de7ddc9-67a3-4388-8da3-38bebd5e6678",
                                "sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appeler un pistolet-mitrailleur propre ? »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f57dc670-562c-4622-b542-1bf817ea215c",
                        "source_entry_id": "16f4490f-ae5d-37b1-b4cc-67557588c166",
                        "source_sense_id": "c7599e09-0620-367a-a708-d29f3df6f04d",
                        "target_lang_word": "Maschinenpistole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maschinenpistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                        "entry_id": "f6ea9a0d-f2dd-3484-93ae-e42515a41ef5",
                                        "glosses": [
                                            "vollautomatische Handfeuerwaffe mit geringer Masse und kurzem Lauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2806774-a827-4e47-9ff3-9d0af8bc8b5d",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "Die Polizisten schossen mit ihren Maschinenpistolen auf die Demonstranten."
                                            },
                                            {
                                                "example_id": "86b26425-451a-41d9-bc94-680824bf78e0",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Zudem konnte schon bald jeder von uns die an Bord mitgeführten Handfeuerwaffen wie Maschinengewehre oder Maschinenpistolen fast schon mit verbundenen Augen zerlegen und pflegen.“"
                                            },
                                            {
                                                "example_id": "ce0c712f-1460-48e2-81f3-222b2ab3c6da",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Hinter ihm treten ein paar Männer in einem seltsamen Aufzug mit Maschinenpistolen aus dem Gebüsch.“"
                                            },
                                            {
                                                "example_id": "bcfd15f4-0ffa-4a59-955b-b68c8d4648dd",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Ich bekam meine Maschinenpistole.“"
                                            },
                                            {
                                                "example_id": "331e4a28-2f4c-4b5c-842a-45acf8180a71",
                                                "sense_id": "db585472-6fea-34ac-bfa3-b86e5b368f03",
                                                "text": "„Und kein Cherubim mit dem bloßen, hauenden Schwert, kein Russe mit seiner Maschinenpistole verwehrt den Zutritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
