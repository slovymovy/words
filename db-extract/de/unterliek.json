                        "target_lang_word": "foot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45a5f5d8-3ae5-3c3d-a1e4-8ce5ff474582",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "A biological structure found in many animals that is used for locomotion and that is frequently a separate organ at the terminal part of the leg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c99d146-c1f1-4edb-9d5b-4d284a8d62b9",
                                                "sense_id": "45a5f5d8-3ae5-3c3d-a1e4-8ce5ff474582",
                                                "text": "A spider has eight feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75e7036-de58-3b07-990f-bf7a3e2477fd",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "Specifically, a human foot, which is found below the ankle and is used for standing and walking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d16041a-0e56-4f8f-87cf-df588226782a",
                                                "sense_id": "d75e7036-de58-3b07-990f-bf7a3e2477fd",
                                                "text": "Southern Italy is shaped like a foot."
                                            },
                                            {
                                                "example_id": "1096bdfa-a670-4c44-9103-01e07dbad73e",
                                                "sense_id": "d75e7036-de58-3b07-990f-bf7a3e2477fd",
                                                "text": "And when I ſawe him, I fell at his feete as dead : and hee laid his right hand vpon me, ſaying vnto mee, Feare not, *I am the firſt,and the laſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c01be2-861e-3c95-9dbf-be6cd55aeefd",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "Travel by walking."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15287e30-b7bd-4587-bee9-c0b1a3a2f484",
                                                "sense_id": "43c01be2-861e-3c95-9dbf-be6cd55aeefd",
                                                "text": "We went there by foot because we could not afford a taxi."
                                            },
                                            {
                                                "example_id": "53f2f482-75d2-4daa-bbed-192c16b6e13d",
                                                "sense_id": "43c01be2-861e-3c95-9dbf-be6cd55aeefd",
                                                "text": "There is a lot of foot traffic on this street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baeac199-31d0-3a6e-8faa-39f94d9e48fb",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "The base or bottom of anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3142fe38-485f-4c84-a553-8fb50f46ee9b",
                                                "sense_id": "baeac199-31d0-3a6e-8faa-39f94d9e48fb",
                                                "text": "I'll meet you at the foot of the stairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377dc5f7-a080-301b-ad00-d8274d9d0e57",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "The part of a flat surface on which the feet customarily rest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6e9746-f462-4fed-95dc-2c9bae5220c8",
                                                "sense_id": "377dc5f7-a080-301b-ad00-d8274d9d0e57",
                                                "text": "We came and stood at the foot of the bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae31b259-0eee-3c5a-85fa-f3d2b2f76d0c",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "The end of a rectangular table opposite the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38442b2f-7776-4c98-a0aa-b9dc7a142559",
                                                "sense_id": "ae31b259-0eee-3c5a-85fa-f3d2b2f76d0c",
                                                "text": "The host should sit at the foot of the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b385a2dc-896f-319d-b51d-d69e621d6c7f",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "A short foot-like projection on the bottom of an object to support it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9ec9bc-fbd8-4ae3-9163-81356f1c42c9",
                                                "sense_id": "b385a2dc-896f-319d-b51d-d69e621d6c7f",
                                                "text": "The feet of the stove hold it a safe distance above the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                                        "entry_id": "df13d9e7-73d1-32b1-8956-dd894250280f",
                                        "glosses": [
                                            "A unit of measure equal to twelve inches or one third of a yard, equal to exactly 30.48 centimetres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd177ad-1e24-4195-ab08-2b42b4d88fc4",
                                                "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                                                "text": "The flag pole, which is 20 feet high, was hoisted by a six-foot tall man."
                                            },
                                            {
                                                "example_id": "4c8883f8-b87c-41b7-a74a-02a7d75b95b9",
                                                "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                                                "text": "My sis's just over six foot two."
                                            },
                                            {
                                                "example_id": "e1f73e0e-08f7-47bf-bb64-76aa50046f07",
                                                "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                                                "text": "No. I only opened the door a foot and put my head in. The street lamps shine into that room. I could see him. He was all right. Sleeping like a great grampus. Poor, poor chap."
                                            },
                                            {
                                                "example_id": "f861d830-de26-4d6b-b671-47eb88e0cfc0",
                                                "sense_id": "60e66c44-c1c7-3003-883a-e06e99b49fd1",
                                                "text": "No trees have grown on the windswept Falkland Islands in the South Atlantic Ocean for tens of thousands of years — just shrubs and other low-lying vegetation. That’s why a recent arboreal discovery nearly 20 feet (6 meters) beneath the ground caught researchers’ attention."
                                            }
                                        ]
                                    },
