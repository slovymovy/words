                        "examples": [
                            {
                                "example_id": "1018e01f-ffb5-4d27-85f0-38aa1e4a4aea",
                                "sense_id": "a7115b0f-1b6d-3c0b-942b-bd217a4e669f",
                                "text": "„»Entglibbert bloß meine Scheißhand«, sagt Y. T. Sie hat das alles schon einmillionmal gehört.“"
                            },
                            {
                                "example_id": "9b8566ce-a5c3-4d33-94c9-83ed48cdfbec",
                                "sense_id": "a7115b0f-1b6d-3c0b-942b-bd217a4e669f",
                                "text": "„Und ich hab nur gesehn, wie 'ne Scheißhand über mich langte und meinen Apfel abgriff.“"
                            },
                            {
                                "example_id": "decbff41-d242-4385-9561-edcc461a3271",
                                "sense_id": "a7115b0f-1b6d-3c0b-942b-bd217a4e669f",
                                "text": "„›Zwei Finger ... mit dem Rasiermesser ... abgeschnitten. Die Scheißhand blutet ... wie ein geköpftes Huhn.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
