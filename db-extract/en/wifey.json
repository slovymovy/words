                    }
                ],
                "senses": [
                    {
                        "sense_id": "68cbabe8-56cc-3c74-bec4-33b73c7c3802",
                        "entry_id": "5bd90189-eef7-3338-bbea-652fc4d88532",
                        "glosses": [
                            "Diminutive of wife."
                        ],
                        "tags": [
                            "diminutive",
                            "endearing",
                            "form-of",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a6aa0ea7-c1ed-451c-aea2-0340f882c5eb",
                                "sense_id": "68cbabe8-56cc-3c74-bec4-33b73c7c3802",
                                "text": "Wifey likes it when I cook her dinner."
                            },
                            {
                                "example_id": "6540e475-3c7d-4ebc-a84f-918e0a7ae1d4",
                                "sense_id": "68cbabe8-56cc-3c74-bec4-33b73c7c3802",
                                "text": "if wifie shuns\n your fond embrace\ndon't shoot the iceman\nfeel your face\nBurma-Shave"
                            },
                            {
                                "example_id": "6ebcb760-ddec-4ab5-b9f4-6818be08e282",
                                "sense_id": "68cbabe8-56cc-3c74-bec4-33b73c7c3802",
                                "text": "Four students from Yarra Valley grammar in Ringwood, in Melbourne’s east, were suspended last week after it came to light they had made the list. It included photos of female students ranking them as “wifeys”, “cuties”, “mid”, “object”, “get out” and “unrapable”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddd0d0ed-2232-49a3-bf9a-b4070151506c",
                        "source_entry_id": "5bd90189-eef7-3338-bbea-652fc4d88532",
                        "source_sense_id": "68cbabe8-56cc-3c74-bec4-33b73c7c3802",
                        "source_sense_description": "(informal, affectionate) wife",
                        "target_lang_word": "Angetraute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angetraute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                        "entry_id": "b6319f07-219f-3b18-aec4-7ba7e3596673",
                                        "glosses": [
                                            "Frau, mit der ein Mann verheiratet ist"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff6b124-a8de-4bbc-8ebc-bac873723a71",
                                                "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                                "text": "Wenn Herberts Angetraute sich etwas in den Kopf gesetzt hat, kann sie nichts davon abhalten, es auch in die Tat umzusetzen."
                                            },
                                            {
                                                "example_id": "d9eec3d5-5ad8-45e1-8319-5505710f0a71",
                                                "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                                "text": "Von der Oldtimersammlung seiner Angetrauten hat Kurt strikt die Finger zu lassen."
                                            },
                                            {
                                                "example_id": "3e8af42d-4f6d-4951-97d8-b7f654b69ae0",
                                                "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                                "text": "„Ein geiziger Ehemann in Iran ist von einem Gericht verdonnert worden, seiner Angetrauten mehr als 120'000 rote Rosen zu kaufen.“"
                                            },
                                            {
                                                "example_id": "ee19b109-da2e-46d0-bcc8-808463a6738e",
                                                "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                                "text": "„Der Erzbischof aus Afrika sitzt mit breitem Lächeln neben seiner Angetrauten, eine rote Nelke an die Jacke geheftet, und neben ihm strahlt Maria Sung, die frisch gebackene Mrs. Milingo.“"
                                            },
                                            {
                                                "example_id": "bbfb60dd-f1fc-4948-89c3-3322fd7cfa47",
                                                "sense_id": "603b9582-09e1-3097-a19c-8c77fe6fdd4f",
                                                "text": "„Der Händler segelt eher in ruhigeren Gewässern und muss eine Wirtschaftsmetropole aufbauen und seine holde Angetraute glücklich machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
