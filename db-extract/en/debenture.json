                                "target_senses": [
                                    {
                                        "sense_id": "837e10d2-8b8c-3be7-8410-3752daa3d4fa",
                                        "entry_id": "d9ee43ac-db31-34c4-af84-2f886924e5dc",
                                        "glosses": [
                                            "verzinsliches Wertpapier; mit der Begebung einer Anleihe borgt sich ein Unternehmen oder der Staat gegen Zahlung von Zinsen Geld von der Öffentlichkeit (statt es sich von Banken zu borgen)"
                                        ],
                                        "tags": [
                                            "Finanzwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c552219-657a-4621-b1d1-c408bc0f57ea",
                                                "sense_id": "837e10d2-8b8c-3be7-8410-3752daa3d4fa",
                                                "text": "Auf diese Anleihe wird ein Zins von 4,75% gezahlt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82bb0a21-9fc7-3ddc-940b-892e5de2913d",
                                        "entry_id": "d9ee43ac-db31-34c4-af84-2f886924e5dc",
                                        "glosses": [
                                            "Summe Geldes, die man sich leiht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a180c0cb-85cd-49f0-aef9-42eedf5df73e",
                                                "sense_id": "82bb0a21-9fc7-3ddc-940b-892e5de2913d",
                                                "text": "„Ich muss wieder eine kleine Anleihe bei dir machen. Schon wieder? Was bist du für ein Verschwender!“"
                                            }
