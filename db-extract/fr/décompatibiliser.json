                "senses": [
                    {
                        "sense_id": "147c89d6-f1eb-3cda-ac0e-ebb703d864e4",
                        "entry_id": "420fd28e-dd56-339d-8d69-1d44eb9dd887",
                        "glosses": [
                            "Faire perdre son caractère compatible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e212ea1f-01fb-4528-bd2b-89734db73a5f",
                                "sense_id": "147c89d6-f1eb-3cda-ac0e-ebb703d864e4",
                                "text": "J'ai un peu regardé son code, et je ne vois pas trop ce qui pourrait «décompatibiliser» ton fichier."
                            },
                            {
                                "example_id": "b754dd9d-4218-42b2-bffd-c8897bcced4b",
                                "sense_id": "147c89d6-f1eb-3cda-ac0e-ebb703d864e4",
                                "text": "En fait, je déteste tellement Bohrer que je l'ai décompatibilisé d'avec Age of Steam."
                            },
                            {
                                "example_id": "86e4d083-70ba-4876-a0a3-2b6f09c0228a",
                                "sense_id": "147c89d6-f1eb-3cda-ac0e-ebb703d864e4",
                                "text": "Qu'a donc bouiné Microsoft pour décompatibiliser tout ce matos qui marchait super bien, comme ce mec à qui j'ai vendu une carte rare pci 2 ports paralèlles, doit-il à 56 ans fermer son machin à imprimer sur céramique?"
                            }
                        ]
                    }
