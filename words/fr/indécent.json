                    "frequency": "Middle",
                    "semantic_group_id": "pudeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il portait une tenue jugée <w>indécente</w> pour entrer dans ce lieu de culte."
                        },
                        {
                            "text": "Ces propos <w>indécents</w> ont immédiatement provoqué la colère des personnes présentes."
                        }
                    ],
                    "synonyms": [
