                "senses": [
                    {
                        "sense_id": "9c40f13c-eff4-3583-adcc-d204dc413168",
                        "entry_id": "bd7f3697-1bdd-3710-bd1e-17146208dd8c",
                        "glosses": [
                            "scholier die voor straf langer op school moet blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4949ec5b-36bd-459e-baa9-7b670e7849f2",
                                "sense_id": "9c40f13c-eff4-3583-adcc-d204dc413168",
                                "text": "Pierre Dulaine, een inspirerende dansleraar uit Manhattan, zet zich vrijwillig in om een groep New Yorkse nablijvers in te wijden in het stijldansen."
                            },
                            {
                                "example_id": "28870ba4-e9da-475e-9d0b-806ab69e4008",
                                "sense_id": "9c40f13c-eff4-3583-adcc-d204dc413168",
                                "text": "Stil in de klas. Zeven nablijvers. 'De Bree liet een half uur niets doen, toen overschrijven uit het boek. Hij had geen lust zich in te spannen. Hij gaf expres geestdodend werk.'"
                            },
                            {
                                "example_id": "30908c77-4bb5-4e97-bd29-a647e07b8b1e",
                                "sense_id": "9c40f13c-eff4-3583-adcc-d204dc413168",
                                "text": "Maar positief of negatief, altijd is daar de school als een wereld die alles omvat, geuren en geluiden, lange gangen met rijen jassen aan de kapstok, stemmen uit andere lokalen, `s zomers bij open ramen de geluiden van de straat, en om half vier de ren naar de vrijheid, of de godverlaten ontvolktheid voor de nablijver."
                            }
                        ]
                    }
