                "senses": [
                    {
                        "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                        "entry_id": "77d870f7-9721-3ba0-95b6-7764b8b6cab8",
                        "glosses": [
                            "Teil einer Kernwaffe, der durch kernphysikalische Prozesse Energie freisetzt und die eigentliche Explosion bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1474b782-2947-4c21-8c06-23858daba677",
                                "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                                "text": "Russland und die USA einigten sich 2010, die Zahl der Atomsprengköpfe auf 1550 pro Land zu senken."
                            },
                            {
                                "example_id": "f385d0f3-247f-4765-a1d5-0fe3739e7052",
                                "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                                "text": "Noch immer arbeiten etliche Länder an der Entwicklung eines eigenen Atomsprengkopfes."
                            },
                            {
                                "example_id": "9c791102-d6fb-4416-a351-11d6490ddc06",
                                "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                                "text": "Mittelstreckenraketen können jeweils mit mehreren Atomsprengköpfen bestückt werden."
                            },
                            {
                                "example_id": "f6dc236c-11b1-4289-be8e-d199e586ecf3",
                                "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                                "text": "„Es dauerte bis 1998, ehe Pakistan ebenfalls seine ersten fünf Atomsprengköpfe zünden und so mit Indien gleichziehen konnte.“"
                            },
                            {
                                "example_id": "db259621-91db-448f-8e15-4166305990e8",
                                "sense_id": "16ca9732-ede8-308f-a3f9-38ce0c7f09ff",
                                "text": "„Im benachbarten Litauen zeigt sich die Regierung überzeugt, dass Atomsprengköpfe in der Oblast lagern; zumindest sei die dafür nötige Infrastruktur ausgebaut worden, heißt es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
