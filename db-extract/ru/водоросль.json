                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                        "entry_id": "40b0178a-f522-3fc0-8903-1795554aecd8",
                                        "glosses": [
                                            "Végétal aquatique poussant sous l’eau (par opposition aux nénufars) pouvant appartenir à des groupes phylogénétiques très différents (polyphylétique) et capables de photosynthèse, donc autotrophes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec672c37-9b85-4798-b012-59656193f6ee",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Il croît beaucoup d’algues sur les rivages de l’océan."
                                            },
                                            {
                                                "example_id": "33d74a4b-423d-4066-8929-01ed120f3519",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Comme l’algue fugitive, Sur quelque sable de la rive la vague aura roulé mes os."
                                            },
                                            {
                                                "example_id": "833f310a-2f19-4c7c-8253-6ae4a263e015",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "Les algues forment un groupe de plantes cryptogames."
                                            },
                                            {
                                                "example_id": "144dbf04-ca55-4dea-bcb4-2f260a41c528",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "De couleur violacée, parfois à tendance verdâtre ou brunâtre, cette algue se présente comme une lame fine, plus ou moins contoumée et lobée, relativement rêche au toucher."
                                            },
                                            {
                                                "example_id": "8bc88d67-9021-4ee8-beaa-d0af5ddd846c",
                                                "sense_id": "c18eeb5f-7eb8-3379-8fa6-26ba21eac2f3",
                                                "text": "À plus long terme, la Commission appelle à développer des protéines alternatives, complémentaires aux protéines cultivées, comme les insectes ou les algues."
                                            }
                                        ]
                                    }
                                ]
                            }
