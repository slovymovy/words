                "senses": [
                    {
                        "sense_id": "91c4f4a8-34f5-31ac-8bde-f9831bd38a78",
                        "entry_id": "11d47904-ece7-3250-989c-5e649f464469",
                        "glosses": [
                            "действие по значению гл. перекрещивать, перекрестить, перекрещиваться, перекреститься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb5f593-1761-4c5c-9d10-b7c8b6a22efa",
                                "sense_id": "91c4f4a8-34f5-31ac-8bde-f9831bd38a78",
                                "text": "В этой части происходит перекрест дыхательного и пищеварительного путей."
                            }
                        ]
                    },
                    {
                        "sense_id": "735115b3-07c6-3140-b2cc-1dc3b54bf04c",
                        "entry_id": "11d47904-ece7-3250-989c-5e649f464469",
                        "glosses": [
                            "место пересечения, перекрещивания чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9577b051-f7a5-405b-abf9-231fa58e6249",
                                "sense_id": "735115b3-07c6-3140-b2cc-1dc3b54bf04c",
                                "text": "Он довольно ясно представил себя со стороны — беспомощно корчащегося на полу, отлично видного в свете фонаря и в перекресте прицела, копошащегося бессмысленно, как улитка под занесенным сапогом."
                            }
                        ]
                    }
