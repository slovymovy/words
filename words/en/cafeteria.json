{
    "word_family": [
        "cafe"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d445caa-14b9-3f58-95ab-31e7c8e8fb39",
                    "sense_definition": "A restaurant where customers choose food from a counter and carry it to their table.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dining_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We grabbed our trays and walked through the <w>cafeteria</w> line to pick our lunch.",
                            "target_lang_translations": {
                                "zh": "我们拿上托盘，排队走过<w>自助餐厅</w>取餐区挑选午饭。"
                            }
                        },
                        {
                            "text": "The local <w>cafeteria</w> offers a wide variety of hot meals every single day.",
                            "target_lang_translations": {
                                "zh": "这家当地的<w>自助餐厅</w>每天都提供各种各样的热食。"
                            }
                        }
                    ],
                    "synonyms": [
                        "canteen"
                    ],
                    "common_phrases": [
                        "school cafeteria",
                        "cafeteria food"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种顾客从柜台自选食物并端到餐桌用餐的餐厅。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自助餐厅",
                                "target_lang_sense_clarification": "顾客自柜台取餐的餐厅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "435223af-5313-3bfe-ad73-f7a0ade7a065",
                    "sense_definition": "A dining area within an institution for employees or students to eat meals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dining_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most employees prefer to eat their lunch in the office <w>cafeteria</w> together.",
                            "target_lang_translations": {
                                "zh": "大多数员工更喜欢在公司<w>食堂</w>一起吃午饭。"
                            }
                        },
                        {
                            "text": "Students gathered in the university <w>cafeteria</w> to discuss their upcoming final exams.",
                            "target_lang_translations": {
                                "zh": "学生们聚在大学<w>食堂</w>讨论即将到来的期末考试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lunchroom",
                        "canteen"
                    ],
                    "common_phrases": [
                        "office cafeteria",
                        "company cafeteria"
                    ],
                    "target_lang_definitions": {
                        "zh": "机构内部供员工或学生用餐的区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "食堂",
                                "target_lang_sense_clarification": "指学校、公司等机构内部的用餐场所。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}