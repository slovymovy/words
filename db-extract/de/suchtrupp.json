                                "target_senses": [
                                    {
                                        "sense_id": "64977afa-df1a-36cf-82d1-77ed68690b0b",
                                        "entry_id": "30a7b1a3-382f-3676-8ed2-8a7b87983dce",
                                        "glosses": [
                                            "A group of people who search for someone or something lost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6eac2e-9aee-4f3c-9e72-336ff0f9c864",
                                                "sense_id": "64977afa-df1a-36cf-82d1-77ed68690b0b",
                                                "text": "Is this a report about the missing trooper?\nIt is, sir. Trooper B Four Seven Eleven was here with three other men. They left and he remained. And soon as they had gone, he packed a lot of food from this house and he robbed me blind. Then he took off to the hills.\nVery well. We'll send out a search party."
                                            },
                                            {
                                                "example_id": "942332d8-e038-47f9-9aa1-f4b797b4a3ad",
                                                "sense_id": "64977afa-df1a-36cf-82d1-77ed68690b0b",
                                                "text": "After their daughter went missing, her parents sent out a search party after her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
