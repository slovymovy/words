                "senses": [
                    {
                        "sense_id": "591a6971-88ae-34b4-81e2-95fca1a18a8c",
                        "entry_id": "15c7d027-d4d3-385c-b65d-727169c93023",
                        "glosses": [
                            "das äußere, sichtbare Erscheinungsbild eines Lebewesens, das durch die Erbanlagen und Umwelteinflüsse ausgeprägt wird"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "84fcb423-c22f-42b2-a0fb-69055da56bb8",
                                "sense_id": "591a6971-88ae-34b4-81e2-95fca1a18a8c",
                                "text": "Die Phänotypen der beiden Schwesterarten unterscheiden sich deutlich voneinander."
                            },
                            {
                                "example_id": "19343ce9-5f3c-4802-93a0-d47fbe92bc2e",
                                "sense_id": "591a6971-88ae-34b4-81e2-95fca1a18a8c",
                                "text": "„Veränderungen an relativ kleinen genetischen Regionen können große Auswirkungen auf die Phänotypen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac169733-3822-4278-903d-717bf1601e16",
