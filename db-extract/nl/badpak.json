                                        "entry_id": "9dd5532b-69aa-3aac-bd62-4a66841fc608",
                                        "glosses": [
                                            "Kleidung, die man beim Baden oder Schwimmen trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35a65a0-d485-46ca-b4c4-fc8b71ccd565",
                                                "sense_id": "a3391a54-f817-3c90-8984-0b6d9e6c6cf1",
                                                "text": "„Anders als in Europa behält man in der Sauna die Badebekleidung an.“"
                                            },
                                            {
                                                "example_id": "93758ed6-d8cb-4b06-afca-bfb233f1a889",
                                                "sense_id": "a3391a54-f817-3c90-8984-0b6d9e6c6cf1",
                                                "text": "„Groß ist auch das Angebot an Sportmode sowie trendiger Strand- und Badebekleidung.“"
                                            },
                                            {
                                                "example_id": "8f962874-60c4-4531-87e4-71052fb26cbd",
                                                "sense_id": "a3391a54-f817-3c90-8984-0b6d9e6c6cf1",
                                                "text": "„Der bisher noch relativ leere Pool füllte sich mit weiteren Gästen, die sich in knapper Badebekleidung vergnügten und Lärm machten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
