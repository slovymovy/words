    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb3537cc-9ecb-353e-8d14-0ce14900e428",
                    "sense_definition": "podążać za kimś lub czymś, kierując się pozostawionymi śladami lub zapachem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "śledzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myśliwy zaczął <w>tropić</w> rannego jelenia w gęstym lesie.",
                            "target_lang_translations": {
                                "ru": "Охотник начал <w>выслеживать</w> раненого оленя в густом лесу."
                            }
                        },
                        {
                            "text": "Pies myśliwski potrafi <w>tropić</w> zwierzynę nawet po wielu godzinach.",
                            "target_lang_translations": {
                                "ru": "Охотничья собака способна <w>выслеживать</w> дичь даже спустя много часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "śledzić",
                        "wytropić"
                    ],
                    "common_phrases": [
                        "tropić zwierzynę",
                        "tropić ślady"
                    ],
                    "target_lang_definitions": {
                        "ru": "идти по чьим-либо следам или запаху"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслеживать",
                                "target_lang_sense_clarification": "охотничий контекст, преследование зверя"
                            },
                            {
                                "target_lang_word": "идти по следу",
                                "target_lang_sense_clarification": "процесс отслеживания следов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b49ac5b7-fc3c-3683-961b-013e4d3b9df5",
                    "sense_definition": "aktywnie poszukiwać kogoś lub ścigać przestępcę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "śledzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detektyw zaczął <w>tropić</w> podejrzanego o kradzież biżuterii.",
                            "target_lang_translations": {
                                "ru": "Детектив начал <w>разыскивать</w> подозреваемого в краже ювелирных изделий."
                            }
                        },
                        {
                            "text": "Policja od tygodni <w>tropi</w> groźnego przestępcę ukrywającego się w mieście.",
                            "target_lang_translations": {
                                "ru": "Полиция неделями <w>преследует</w> опасного преступника, скрывающегося в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "ścigać",
                        "śledzić"
                    ],
                    "common_phrases": [
                        "tropić przestępcę"
                    ],
                    "target_lang_definitions": {
                        "ru": "активно искать кого-либо или преследовать преступника"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разыскивать",
                                "target_lang_sense_clarification": "активный поиск человека"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "погоня за преступником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6328a3f1-fc22-3867-bda0-ed92bb8afe36",
                    "sense_definition": "martwić się o coś lub odczuwać ból z jakiegoś powodu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bardzo mnie <w>tropi</w> ta sytuacja w rodzinie.",
                            "target_lang_translations": {
                                "ru": "Меня очень <w>беспокоит</w> эта ситуация в семье."
                            }
                        },
                        {
                            "text": "Nie <w>trop</w> się tym, wszystko będzie dobrze.",
                            "target_lang_translations": {
                                "ru": "Не <w>переживай</w> из-за этого, всё будет хорошо."
                            }
                        }
                    ],
                    "synonyms": [
                        "martwić",
                        "boleć"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane na Śląsku Cieszyńskim"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "беспокоиться о чем-то или испытывать душевную боль (региональное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "переживать из-за ситуации"
                            },
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "испытывать тревогу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}