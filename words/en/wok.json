{
    "word_family": [
        "stir-fry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d70b460-6a2c-39f5-904d-53d248ff0f29",
                    "sense_definition": "A large, round-bottomed cooking pan used in East Asian cooking.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking_vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wok</w> is an efficient, all-purpose metal cooking vessel used by every housewife in China.",
                            "target_lang_translations": {
                                "ru": "<w>Вок</w> — это эффективная универсальная металлическая посуда, которую использует каждая домохозяйка в Китае."
                            }
                        },
                        {
                            "text": "He heated the oil in a large <w>wok</w> before adding the vegetables.",
                            "target_lang_translations": {
                                "ru": "Он разогрел масло в большом <w>воке</w>, прежде чем добавить овощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "frying pan"
                    ],
                    "common_phrases": [
                        "large wok",
                        "carbon steel wok",
                        "cast iron wok"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая сковорода с круглым дном, используемая в восточноазиатской кухне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вок",
                                "target_lang_sense_clarification": "кухонная утварь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a31d0cb1-76d4-3ed8-9708-cb1dc2adcf60",
                    "sense_definition": "Any dish prepared using such a pan.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "food_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a delicious vegetable <w>wok</w> for dinner last night.",
                            "target_lang_translations": {
                                "ru": "Вчера на ужин мы заказали очень вкусный овощной <w>вок</w>."
                            }
                        },
                        {
                            "text": "The restaurant serves a variety of spicy chicken <w>woks</w>.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают разнообразные острые <w>воки</w> с курицей."
                            }
                        }
                    ],
                    "synonyms": [
                        "stir-fry"
                    ],
                    "common_phrases": [
                        "vegetable wok",
                        "chicken wok"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое блюдо, приготовленное в такой сковороде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вок",
                                "target_lang_sense_clarification": "блюдо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5b8b318-7d79-3008-943d-63e4678d8ed2",
                    "sense_definition": "To prepare oriental cuisine using a wok.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the evening <w>woking</w> a variety of traditional dishes for her guests.",
                            "target_lang_translations": {
                                "ru": "Она провела вечер, <w>готовя в воке</w> разнообразные традиционные блюда для своих гостей."
                            }
                        },
                        {
                            "text": "He learned how to <w>wok</w> properly during his trip to Shanghai.",
                            "target_lang_translations": {
                                "ru": "Во время своей поездки в Шанхай он научился правильно <w>готовить в воке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stir-fry"
                    ],
                    "common_phrases": [
                        "wok vegetables",
                        "wok meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить блюда восточной кухни с использованием вока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовить в воке",
                                "target_lang_sense_clarification": "процесс приготовления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}