                        ]
                    },
                    {
                        "translation_id": "39c437a1-f129-4433-9da7-7425bfdc6e43",
                        "source_entry_id": "731e5d5b-349c-3923-850e-31ab219cc729",
                        "source_sense_id": "b0b49f41-28f8-3820-a31e-22fbe43177de",
                        "target_lang_word": "purchase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purchase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a46f2aab-af77-37d8-be68-c09552c724bd",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "The acquisition of title to, or property in, anything for a price; buying for money or its equivalent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37cfa7a2-18ca-4ba2-84d3-ff8f8a3e7897",
                                                "sense_id": "a46f2aab-af77-37d8-be68-c09552c724bd",
                                                "text": "They offer a free hamburger with the purchase of a drink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1412cd6-a4d9-37e4-adc6-1b5ebeaa0326",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "That which is obtained for a price in money or its equivalent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918cbf85-cb5e-4aad-b725-2c06e00d9101",
                                                "sense_id": "b1412cd6-a4d9-37e4-adc6-1b5ebeaa0326",
                                                "text": "He was pleased with his latest purchase."
                                            },
                                            {
                                                "example_id": "3c080c08-8298-4239-b3a4-a71094d3a837",
                                                "sense_id": "b1412cd6-a4d9-37e4-adc6-1b5ebeaa0326",
                                                "text": "[Said by a shopkeeper] I really don't think you can carry any more purchases. You can come again after you sell something, or you can simply discard an item to lighten your load. Or, you might want to sell the things you don't need here!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f0bec4-7d5f-3386-910c-f8fd2e72e620",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "That which is obtained, got or acquired, in any manner, honestly or dishonestly; property; possession; acquisition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44368c0c-1422-3806-b324-a332c1331a7b",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "The act or process of seeking and obtaining something (e.g. property, etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785d3029-0d20-4953-9dd2-eb4d332ff159",
                                                "sense_id": "44368c0c-1422-3806-b324-a332c1331a7b",
                                                "text": "I'll […] get meat to save thee, / Or lose my life i’ th’ purchase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b374ef8-fb4d-3816-97f3-2a0ff5aa1d49",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "A price paid for a house or estate, etc. equal to the amount of the rent or income during the stated number of years."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bba0c61-7389-43b0-8c85-bad71d5c1066",
                                                "sense_id": "0b374ef8-fb4d-3816-97f3-2a0ff5aa1d49",
                                                "text": "Suppose a freehold house to be worth 20 years’ purchase […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46906557-5b69-3bbd-84bc-392c5e78cbc4",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "Any mechanical hold or advantage, applied to the raising or removing of heavy bodies, as by a lever, a tackle or capstan."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982f6e9c-80aa-4b84-bf39-eb64cc3a97c7",
                                                "sense_id": "46906557-5b69-3bbd-84bc-392c5e78cbc4",
                                                "text": "It is hard to get purchase on a nail without a pry bar or hammer."
                                            },
                                            {
                                                "example_id": "a9706d1f-8401-4525-8de3-5592aedc5d8c",
                                                "sense_id": "46906557-5b69-3bbd-84bc-392c5e78cbc4",
                                                "text": "The problem is that the model of individual responsibility assumed by most versions of ethics have little purchase on the behavior of Capital or corporations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d6738a-09d7-3879-9014-bdc150cdbf0c",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "The apparatus, tackle or device by which such mechanical advantage is gained and (in nautical terminology) the ratio of such a device, like a pulley, or block and tackle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c2331e-d3e1-4db4-bb10-328249df4ea0",
                                                "sense_id": "39d6738a-09d7-3879-9014-bdc150cdbf0c",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ad0c50-b7bc-3942-9c64-a12acda3a040",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "The amount of hold one has from an individual foothold or ledge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087b2ab6-9233-4ac1-9505-cabceda00cb5",
                                                "sense_id": "67ad0c50-b7bc-3942-9c64-a12acda3a040",
                                                "text": "At first, he was climbing down, testing for purchase with his feet. But soon, as the entire section of ground rotated, he was lifted into the air, and up and down flipped around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a50a54f-5217-3c74-a73e-0c8ed61dab2b",
                                        "entry_id": "4cf36d3f-10b2-386e-ac84-c406a8c9d0d9",
                                        "glosses": [
                                            "Acquisition of lands or tenements by means other than descent or inheritance, namely, by one's own act or agreement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5048bf84-fcc2-494e-9747-02b967ecb397",
                                                "sense_id": "0a50a54f-5217-3c74-a73e-0c8ed61dab2b",
                                                "text": "The difference […]between the acquisition of an estate by descent and by purchase"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purchase",
