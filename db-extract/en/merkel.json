                                "target_senses": [
                                    {
                                        "sense_id": "d625327f-c241-3b9a-ad3b-a2e3f84e102f",
                                        "entry_id": "57516244-be2b-3ba4-8c84-9ecdd8acf46e",
                                        "glosses": [
                                            "česká ženská varianta německého příjmení Merkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bf55c4-e34d-4d39-8ed4-7f279225c499",
                                                "sense_id": "d625327f-c241-3b9a-ad3b-a2e3f84e102f",
                                                "text": "Populární německá kancléřka Angela Merkelová se stala podle časopisu Time osobností roku 2015."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ab5f835-6fa6-4e2d-b7b4-6a1058379fb9",
                        "source_entry_id": "17a0d71b-e9f5-3984-99d9-e27019b5a347",
                        "source_sense_description": "surname",
                        "target_lang_word": "Merkel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Merkel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "117ea55a-49bb-347d-b116-fc6221b261c5",
                                        "entry_id": "a8158f5d-8b49-3641-a699-81140c3c2ed0",
                                        "glosses": [
                                            "Nom de famille allemand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a928388-49e6-4e28-8c5c-ab3229b5b4e0",
                                                "sense_id": "117ea55a-49bb-347d-b116-fc6221b261c5",
                                                "text": "Elle avait 11 ans, en 2011, quand l’ex-chancelière Angela Merkel avait promis la fermeture de toutes les centrales nucléaires allemandes en 2022."
                                            },
                                            {
                                                "example_id": "a7430718-2c68-4c1f-9533-46c46ed11c31",
                                                "sense_id": "117ea55a-49bb-347d-b116-fc6221b261c5",
                                                "text": "Reste que cette politique, qui faisait le pari d’allier la fermeté des sanctions au maintien du dialogue, a vite perdu toute crédibilité avec la décision prise par Berlin, en 2015, de construire un deuxième gazoduc, Nord Stream 2, acheminant du gaz russe en Allemagne via la mer Baltique. Une conséquence indirecte du choix fait par Angela Merkel, au lendemain de la catastrophe de Fukushima, en mars 2011, d’accélérer le calendrier de sortie du nucléaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383e7c01-fde2-48ba-add0-be83deb0e0c6",
                        "source_entry_id": "17a0d71b-e9f5-3984-99d9-e27019b5a347",
                        "source_sense_description": "surname",
                        "target_lang_word": "Merkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Merkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2d80e8-faa6-3f84-9387-a81c84902207",
                                        "entry_id": "c21e2516-ca25-3967-abfd-5d5ce94c6be4",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6385fd-5594-41d7-bd5d-cb030dea179c",
                                                "sense_id": "ca2d80e8-faa6-3f84-9387-a81c84902207",
                                                "text": "Der Herr Merkel kauft sich jedes Jahr einen neuen Roller."
                                            },
                                            {
                                                "example_id": "ee8e52dd-aa04-42c7-ae5b-b5fdd6765995",
                                                "sense_id": "ca2d80e8-faa6-3f84-9387-a81c84902207",
                                                "text": "Mit diesem Schema lässt sich die Lage der Eltern der Generation Merkel erfassen, die vor der Aufgabe stand, eine autoritäre Gesellschaft zu liberalisieren und die nationalsozialistische Schuld aufzudecken."
                                            },
                                            {
                                                "example_id": "179c3919-2ea5-4029-bc2f-b28d0e40c061",
                                                "sense_id": "ca2d80e8-faa6-3f84-9387-a81c84902207",
                                                "text": "„Die CDU-Vorsitzende Angela Merkel, der in der Partei schlechtes Krisenmanagement vorgeworfen wurde, ließ Meyer beschädigt zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f033535-c196-4e8c-9f0e-c2eda41cda3c",
                        "source_entry_id": "17a0d71b-e9f5-3984-99d9-e27019b5a347",
