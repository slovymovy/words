                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "Meanly; without spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b62883-ef1f-494d-886c-c6ef6b3819f9",
                                                "sense_id": "23851272-9987-3aa1-b1b6-06d00145187e",
                                                "text": "Nor is their courage or their wealth so low, / That from his wars they poorly would retire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077f8942-dc10-3479-83dc-b0c35be4bcd8",
                                        "entry_id": "6802cbe1-c6c2-31b4-a49a-0c198763a771",
                                        "glosses": [
                                            "Without skill or merit."
