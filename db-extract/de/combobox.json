                        ],
                        "examples": [
                            {
                                "example_id": "1f0bf5e7-ccd2-4210-9177-b641c9b1f386",
                                "sense_id": "db565a16-ae5d-3ed5-adfd-f4b065d3f3db",
                                "text": "„In der grafischen Entwicklungsumgebung von MS Access wird die Combobox im Erfassungsformular (im Beispiel für 'Aufträge') als Elementtyp 'Kombinationsfeld' angelegt und so wie in der nebenstehenden Grafik gezeigt angewendet. Der Entwickler spezifiziert in diesem Fall (bei Datenanzeige aus einem Datenbestand) für das Kombinationsfeld u. a. folgende Eigenschaften: Breite der Box; Anzahl Zeilen der Box; Datenquelle für die anzuzeigenden Personen; Name der ID im Datenbestand PERSON; Name des Fremdschlüssels im Datenbestand AUFTRAG u. v. a.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
