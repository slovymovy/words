                        {
                            "text": "Doctors are monitoring the blood <w>flow</w> to his heart.",
                            "target_lang_translations": {
                                "ru": "Врачи наблюдают за <w>притоком</w> крови к его сердцу.",
                                "nl": "Artsen houden de bloed<w>doorstroming</w> naar zijn hart in de gaten."
                            }
