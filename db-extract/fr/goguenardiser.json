                "senses": [
                    {
                        "sense_id": "67a8a717-f9d8-37ca-92b3-6fc06df154aa",
                        "entry_id": "cb9e85cd-15ac-341c-8b71-0d790c24d9dd",
                        "glosses": [
                            "S’exprimer de façon goguenarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635e589f-5504-4134-9174-f5deabaadce1",
                                "sense_id": "67a8a717-f9d8-37ca-92b3-6fc06df154aa",
                                "text": "J’en avais ras le bol de l’entendre goguenardiser sur les Africains qui se laissaient vivre le ventre au soleil et la tête dans les étoiles."
                            },
                            {
                                "example_id": "4b6ec12e-3de1-4c05-ade0-6e3bf0da3b4b",
                                "sense_id": "67a8a717-f9d8-37ca-92b3-6fc06df154aa",
                                "text": "À l’alinéa suivant, je me mets à goguenardiser derechef, les entendant invoquer le peuple."
                            },
                            {
                                "example_id": "57a5775a-ca3a-43b9-929c-1d71a196c899",
                                "sense_id": "67a8a717-f9d8-37ca-92b3-6fc06df154aa",
                                "text": "Je pourrais goguenardiser et vous glisser perfidement de vous adresser à leurs collaborateurs, mais ce serait un peu facile."
                            }
                        ]
                    }
                ],
