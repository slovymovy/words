                ],
                "senses": [
                    {
                        "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                        "entry_id": "4509c1da-d390-38ce-bf88-4c3480234eee",
                        "glosses": [
                            "langsame, schleichende Zerstörung oder Beeinträchtigung von etwas, oft durch heimliches Eindringen oder subtile Beeinflussung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b383ad50-be75-4efe-86c1-1007e0a1c58a",
                                "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                                "text": "„Nach der katastrophalen Niederlage der Westarmee in der Schlacht am Frigidus gegen die östlichen Streitkräfte unter Theodosius I. mussten ganze Stammesverbände als Föderaten im Reich angesiedelt werden, die schließlich zur Unterwanderung der staatlichen Institutionen führte und in die Bevormundung bzw. der faktischen Entmachtung der regierenden Kaiser durch ihre germanischen Heermeister mündete.“"
                            },
                            {
                                "example_id": "72fa36f2-ef36-4f5b-8541-707b49fc9e95",
                                "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                                "text": "„Bereits zur Zeit der Ersten Republik trat sie entschlossen gegen den politischen Antisemitismus und die schleichende Unterwanderung Österreichs durch den Nationalsozialismus auf.“"
                            },
                            {
                                "example_id": "f7c72c15-eb58-4ee6-b965-69bd83106563",
                                "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                                "text": "„Der Kalte Krieg hatte begonnen, und mit ihm wuchs eine pathologische Furcht vor Unterwanderung.“"
                            },
                            {
                                "example_id": "c1652aee-df36-4a68-9545-2adecb5689f8",
                                "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                                "text": "„Einen solchen – mäßigen – Eingriff in das Vertrauen der Normunterworfenen vermag aber der vom Gesetzgeber angestrebte Zweck zu rechtfertigen, ‚Vorziehkäufe‘ und damit die Unterwanderung des unbedenklichen fiskalischen Ziels zu verhindern.“"
                            },
                            {
                                "example_id": "ee769140-c571-4ed0-81d6-51a4eedc6e9e",
                                "sense_id": "bb980dc8-47b9-3cd3-8707-f10e5cb2f932",
                                "text": "„Reine Filiformkorrosion resultiert in einem äußerlichen Angriff der Oberfläche, die zu Unterwanderung, Abhebung und Abplatzung der Deckschicht führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
