                        ],
                        "form": "die Jagdgründe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28f9655b-6c2c-3342-97db-00b44bf1121d",
                        "entry_id": "6a277396-6fa5-3cb4-990a-7d7a1ed483e2",
                        "glosses": [
                            "Gebiet, in dem man jagen kann"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8ba7fb-fe8f-4731-9a85-09ad6c6a8f1d",
                                "sense_id": "28f9655b-6c2c-3342-97db-00b44bf1121d",
                                "text": "„Eisbären leiden häufiger Hunger, weil das Packeis und damit ihre Jagdgründe schwinden.“"
                            },
                            {
                                "example_id": "b9a2cea1-6ccc-412a-96c0-e7ea0c3e40a8",
                                "sense_id": "28f9655b-6c2c-3342-97db-00b44bf1121d",
                                "text": "„Meine Jagdgründe waren der kleine Bach, der angrenzende Wald und der Sackweiher, der so hieß, weil er der Familie Sack gehörte.“"
                            },
                            {
                                "example_id": "d0c7e630-5886-4565-af25-a4c3dbd7cbf5",
                                "sense_id": "28f9655b-6c2c-3342-97db-00b44bf1121d",
                                "text": "„Einige Monate später, der Kriminalfall Piontek ruht als vorläufig ungelöst in den Akten, zeigt ein Forstarbeiter bei der Polizei an, dass sein Labrador in einem Waldgebiet, das nach Feststellung der Polizei weiter entfernt von Pionteks Jagdgründen liegt, den offensichtlich nicht tief genug vergrabenen Kadaver eines mittelgroßen Hundes aufgespürt habe.“"
                            },
                            {
                                "example_id": "c9b7e5c2-369f-44b7-9bde-97c0176dc2ae",
                                "sense_id": "28f9655b-6c2c-3342-97db-00b44bf1121d",
                                "text": "„Und El Sol sah die Taten Blackeagles auf den Jagdgründen, und seine Seele war mit ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
