                                "target_senses": [
                                    {
                                        "sense_id": "1538c59f-7768-30e9-a6d1-7a14ab5c41d8",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "Flexibility, pliancy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e1c0bcc-ef3b-3924-92c2-d6d435bf2238",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "An act of flexing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c153baf6-a91c-4b79-978a-db51dfe292c1",
                                                "sense_id": "4e1c0bcc-ef3b-3924-92c2-d6d435bf2238",
                                                "text": "The hills become more rounded. The slopes are either the stooped shoulders of an aging colossus or the muscular flexes of a geologic youngster, but they are pleasant, comforting. This landscape is what most would think of […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a90bc9-7947-30b2-8d64-792b36ae6a52",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "Any flexible insulated electrical wiring."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59706f68-bb94-3ff9-99af-7df288596014",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "A flexible insulated electrical cord."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0448a5f5-8e09-4f23-a8fc-720792656ef0",
                                                "sense_id": "59706f68-bb94-3ff9-99af-7df288596014",
                                                "text": "The books lent her by Dr Grimble on period furniture and ceramics interested her deeply, and she studied them at night in the silence of the shop, where she had a flex and a reading lamp installed at her own expense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db55ab34-9f4e-3b65-a940-2a0d0ac1f49e",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "Flexible ductwork, typically flexible plastic over a metal wire coil to shape a tube."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14683245-efcc-47e1-b637-be631fcce205",
                                                "sense_id": "db55ab34-9f4e-3b65-a940-2a0d0ac1f49e",
                                                "text": "Flex is quick and cheaper to install than metallic systems, but it yields higher pressure loss than other types of ducts and requires runs of less than 15 feet, minimal turns and elimination of kinks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e778977-e969-3e59-bb8c-5c6b2be2181d",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "A point of inflection."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e08c75c0-cee2-36db-a7f9-d65e08d654c4",
                                        "entry_id": "6f5d77c9-0554-31b0-8a52-9f56a78c1584",
                                        "glosses": [
                                            "An act or instance of flaunting something; a boast or brag; something considered impressive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926ae25d-10c5-41fe-88e4-df51a26962f3",
                                                "sense_id": "e08c75c0-cee2-36db-a7f9-d65e08d654c4",
                                                "text": "Getting together with other power players at Masa is the ultimate flex of conspicuous consumption. […] A party of five or more requires a deposit of $200 per person at least one week prior to the reservation."
                                            },
                                            {
                                                "example_id": "61b7647e-f9b7-4e14-97f9-7157438ee588",
                                                "sense_id": "e08c75c0-cee2-36db-a7f9-d65e08d654c4",
                                                "text": "It's an achievement to stand out from other Marvel movies in terms of special effects, but this whole movie feels like a flex for those computer wizards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd293a4-b0a5-3fb6-b0db-f3f3bdd56588",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To bend something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "813581de-1f82-38ec-b4a0-51dd6e0ffb27",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To repeatedly bend one of one's joints."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e0fcd15-4434-3980-b9c5-df3e1b90149a",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To move part of the body using one's muscles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2381bb23-6b15-318f-8e85-c5477357ba33",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To tighten the muscles for display of size or strength."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f090e3fd-e250-4c80-806b-f947a0d9b219",
                                                "sense_id": "2381bb23-6b15-318f-8e85-c5477357ba33",
                                                "text": "He rubbed his hands together. \"Believe it or not, there was a time when I considered giving acting a go. What do you think, Miss Fox?\" He flexed impressive biceps. \"Would I have had a chance against the Schwarzeneggers and the Chuck Norris types?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9127aaa7-33d6-373a-8ca7-3ec4693e16b0",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To boast or brag about; to flaunt (something)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd55ee5-83c1-45e6-b0a8-64ff188a1295",
                                                "sense_id": "9127aaa7-33d6-373a-8ca7-3ec4693e16b0",
                                                "text": "I've got billions and billions of rhymes to flex / 'Cause I've got more rhymes than Carl Sagan's got turtlenecks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "972438f3-b361-3ec1-9b5b-7cf9bdca016e",
                                        "entry_id": "e62bc220-1a8d-328c-be33-5c71da623d18",
                                        "glosses": [
                                            "To flaunt one's superiority; to show off."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15736896-a7ec-44df-9618-62dd7434fc4c",
                                                "sense_id": "972438f3-b361-3ec1-9b5b-7cf9bdca016e",
                                                "text": "I shook my head, wondering if I was gonna have to knock Pimp on his ass. \"I don't know where,\" I flexed on him with my height advantage, \"you getting all this 'soft' bullshit from, dawg, but you just keep fuckin around. I can show you gangsta better than I can tell you.\""
                                            },
                                            {
                                                "example_id": "8b8a9175-e3bb-4780-ac01-7539a7e4ba5f",
                                                "sense_id": "972438f3-b361-3ec1-9b5b-7cf9bdca016e",
                                                "text": "They say it's lonely at the top, but this the best shit ever / Hey, don't you see me out here shinin'? Bitch I'm barely flexin'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
