                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1382e259-f6ba-332f-9bf4-8219e998dde2",
                                        "entry_id": "f0a080ce-0c70-3ce6-929b-2febe2605253",
                                        "glosses": [
