                    "sense_definition": "Relating to a house or the people living in it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "domestic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the weekend shopping for <w>household</w> goods and groceries.",
                            "target_lang_translations": {
                                "ru": "Мы провели выходные, покупая <w>хозяйственные</w> товары и продукты.",
                                "tr": "Hafta sonunu <w>ev</w> eşyaları ve gıda alışverişi yaparak geçirdik.",
                                "zh": "我们周末去采购了<w>家用</w>物品和食品杂货。",
                                "it": "Abbiamo passato il fine settimana a comprare <w>articoli per la casa</w> e generi alimentari."
                            }
                        },
                        {
                            "text": "Sharing <w>household</w> chores makes life easier for everyone in the family.",
                            "target_lang_translations": {
                                "ru": "Разделение <w>домашних</w> обязанностей облегчает жизнь всем в семье.",
                                "tr": "<w>Ev</w> işlerini paylaşmak ailedeki herkes için hayatı kolaylaştırır.",
                                "zh": "分担<w>家务</w>让家里的每个人生活得更轻松。",
                                "it": "Dividersi le <w>faccende domestiche</w> rende la vita più facile a tutti in famiglia."
                            }
