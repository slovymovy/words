{
    "word_family": [
        "connect",
        "connection",
        "connectivity",
        "connective",
        "disconnect",
        "reconnect",
        "interconnect"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c449474-bdcc-33ed-895e-3ef3fcec031f",
                    "sense_definition": "A device, such as a plug or socket, used to join electrical wires, cables, or hoses together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the <w>connector</w> is pushed all the way into the socket.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>разъём</w> вставлен в розетку до упора."
                            }
                        },
                        {
                            "text": "You might need a different cable <w>connector</w> for this specific model of television.",
                            "target_lang_translations": {
                                "ru": "Для этой конкретной модели телевизора вам может понадобиться другой кабельный <w>соединитель</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plug",
                        "coupling",
                        "adapter"
                    ],
                    "common_phrases": [
                        "cable connector",
                        "electrical connector",
                        "power connector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, такое как штекер или розетка, используемое для соединения электрических проводов, кабелей или шлангов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъём",
                                "target_lang_sense_clarification": "электрический или технический"
                            },
                            {
                                "target_lang_word": "коннектор",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "соединитель",
                                "target_lang_sense_clarification": "общее техническое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2909b3-1763-3e34-a6f9-e45397d915e1",
                    "sense_definition": "A person who excels at networking and bringing different people or groups together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a natural social <w>connector</w> who seems to know everyone in the industry.",
                            "target_lang_translations": {
                                "ru": "Она прирожденное <w>связующее звено</w> в обществе и, кажется, знает всех в этой индустрии."
                            }
                        },
                        {
                            "text": "As a <w>connector</w>, his main role is to introduce startup founders to potential investors.",
                            "target_lang_translations": {
                                "ru": "Как <w>посредник</w>, его основная роль заключается в том, чтобы знакомить основателей стартапов с потенциальными инвесторами."
                            }
                        }
                    ],
                    "synonyms": [
                        "networker",
                        "intermediary",
                        "liaison"
                    ],
                    "common_phrases": [
                        "social connector",
                        "natural connector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который преуспевает в нетворкинге и объединении различных людей или групп."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связующее звено",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "в общении"
                            },
                            {
                                "target_lang_word": "коннектор",
                                "target_lang_sense_clarification": "в нетворкинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52fedca9-af15-3800-bfed-da927b63e9bb",
                    "sense_definition": "A software component that enables an application to communicate with an external database or data source.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer installed a new database <w>connector</w> to improve the website's loading speed.",
                            "target_lang_translations": {
                                "ru": "Разработчик установил новый <w>коннектор</w> базы данных, чтобы увеличить скорость загрузки сайта."
                            }
                        },
                        {
                            "text": "You need to configure the <w>connector</w> settings before the app can access the cloud storage.",
                            "target_lang_translations": {
                                "ru": "Вам нужно настроить параметры <w>соединения</w>, прежде чем приложение сможет получить доступ к облачному хранилищу."
                            }
                        }
                    ],
                    "synonyms": [
                        "driver",
                        "interface"
                    ],
                    "common_phrases": [
                        "database connector",
                        "software connector"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программный компонент, позволяющий приложению взаимодействовать с внешней базой данных или источником данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коннектор",
                                "target_lang_sense_clarification": "программный модуль"
                            },
                            {
                                "target_lang_word": "драйвер",
                                "target_lang_sense_clarification": "интерфейс связи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9e18db-5776-381d-946b-a47c7f8a14bc",
                    "sense_definition": "A short road or highway that links two larger highways or main roads.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take the highway <w>connector</w> to switch from the I-95 to the local expressway.",
                            "target_lang_translations": {
                                "ru": "Воспользуйтесь дорожным <w>съездом</w>, чтобы перейти с трассы I-95 на местную скоростную дорогу."
                            }
                        },
                        {
                            "text": "Traffic is backed up on the <w>connector</w> due to a minor accident at the interchange.",
                            "target_lang_translations": {
                                "ru": "На <w>соединительной ветке</w> образовалась пробка из-за небольшого ДТП на развязке."
                            }
                        }
                    ],
                    "synonyms": [
                        "link",
                        "slip road"
                    ],
                    "common_phrases": [
                        "highway connector",
                        "freeway connector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая дорога или шоссе, соединяющее две более крупные автомагистрали или главные дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съезд",
                                "target_lang_sense_clarification": "на другую дорогу"
                            },
                            {
                                "target_lang_word": "соединительная ветка",
                                "target_lang_sense_clarification": "дорожная"
                            },
                            {
                                "target_lang_word": "развязка",
                                "target_lang_sense_clarification": "элемент дороги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eed6356-2a4e-3d04-97b0-b74e408f776c",
                    "sense_definition": "A line used in software to link two shapes or boxes, often staying attached when they are moved.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a curved <w>connector</w> to link the two boxes in your flowchart.",
                            "target_lang_translations": {
                                "ru": "Используйте изогнутую <w>линию</w>, чтобы соединить два блока в вашей блок-схеме."
                            }
                        },
                        {
                            "text": "The <w>connector</w> will automatically adjust its length when you move the shapes around.",
                            "target_lang_translations": {
                                "ru": "<w>Коннектор</w> автоматически изменит свою длину, когда вы будете перемещать фигуры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curved connector",
                        "elbow connector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия в программном обеспечении, используемая для связи двух фигур или блоков, часто остающаяся прикрепленной при их перемещении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединительная линия",
                                "target_lang_sense_clarification": "в графике"
                            },
                            {
                                "target_lang_word": "коннектор",
                                "target_lang_sense_clarification": "в блок-схемах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea771ac0-8b75-397f-bff9-444edd9d185c",
                    "sense_definition": "In poker, two or more cards of consecutive rank that have the potential to form a straight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to play the suited <w>connectors</w> hoping to hit a straight or a flush.",
                            "target_lang_translations": {
                                "ru": "Он решил разыграть одномастные <w>коннекторы</w> в надежде собрать стрит или флеш."
                            }
                        },
                        {
                            "text": "A <w>connector</w> like a seven and an eight can be a powerful starting hand.",
                            "target_lang_translations": {
                                "ru": "Такой <w>коннектор</w>, как семерка и восьмерка, может быть сильной стартовой рукой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suited connectors"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "poker terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В покере — две или более карты последовательного ранга, которые могут образовать стрит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коннектор",
                                "target_lang_sense_clarification": "карточный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}