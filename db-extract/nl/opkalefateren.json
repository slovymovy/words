        "nl-extract.jsonl": [
            {
                "entry_id": "676b4677-5f6b-3a3f-9947-7078d4a54313",
                "word": "opkalefateren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc67c095-e389-3527-a41d-6aedefbf5e77",
                        "entry_id": "676b4677-5f6b-3a3f-9947-7078d4a54313",
                        "glosses": [
                            "een houten schip met touw weer waterdicht maken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b3ec143-0683-39aa-bfff-bda09130f3ff",
                        "entry_id": "676b4677-5f6b-3a3f-9947-7078d4a54313",
                        "glosses": [
                            "iets opknappen dat beschadigd of versleten is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36d19e9-c9c5-4884-b4b2-34a0bb9bc030",
                                "sense_id": "5b3ec143-0683-39aa-bfff-bda09130f3ff",
                                "text": "Het hebben van een auto in Cuba stond vijftig jaar lang garant voor sleutelen, veel poetsen, en zo nu en dan opkalefateren met een lik verf. Ging er iets stuk dan had de trotse eigenaar met recht 'pech'."
                            },
                            {
                                "example_id": "19611187-0aa1-43d9-a6fe-8fccaf40de82",
                                "sense_id": "5b3ec143-0683-39aa-bfff-bda09130f3ff",
                                "text": "Toch moet ook Van Nieuwenhuizen erkennen dat Nederland staat voor 'een vrij grote opgave'. Rijkswaterstaat gaat oude bruggen en tunnel opkalefateren, werd begin dit jaar al bekend. Tot 2028 heeft Rijkswaterstaat minstens 80 objecten in het vizier die een opknapbeurt nodig hebben. Daar komt nu extra geld voor."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7c4f6d4-ac96-378b-8a08-805d25d2ea09",
                        "entry_id": "676b4677-5f6b-3a3f-9947-7078d4a54313",
                        "glosses": [
                            "iemand opknappen, iemand mooier maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c7d065-5949-41c6-b1f0-a7e2f2e5929d",
                                "sense_id": "d7c4f6d4-ac96-378b-8a08-805d25d2ea09",
                                "text": "Terug naar de cosmetische wereld. Privéklinieken die een beter uiterlijk en meer zelfvertrouwen beloven, lijken bij bosjes uit de grond gestampt te worden. Wat zijn dat voor artsen? Hebben die geen belangrijkere dingen te doen dan uitgezakte gezichten opkalefateren?"
                            }
                        ]
                    }
                ],
