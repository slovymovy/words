                            {
                                "example_id": "41f2e580-09e3-4e08-a5c7-c38d98637edc",
                                "sense_id": "0cb5f013-aaac-324d-b7c6-0cf744effca9",
                                "text": "„Die pensionierte Volksschullehrerin Elisabeth Gassner korrigiert die Aussprache, sie unterrichtet seit Kurzem wieder.“"
                            },
                            {
                                "example_id": "95c498fe-f999-4a11-a8fd-7762aa022949",
                                "sense_id": "0cb5f013-aaac-324d-b7c6-0cf744effca9",
                                "text": "„Monika T. kann ihren Karriereweg als Volksschullehrerin gar nicht mehr in Schultagen berechnen.“"
                            },
                            {
                                "example_id": "7ebb54ef-a0f2-40fd-ad34-c41aa80b19b2",
                                "sense_id": "0cb5f013-aaac-324d-b7c6-0cf744effca9",
                                "text": "„Andere blieben in der Provinz, wurden Volksschullehrerinnen, wurden brav und rund.“"
                            }
                        ],
