                        {
                            "text": "Ik wens jullie allemaal een heel <w>prettig</w> weekend.",
                            "target_lang_translations": {
                                "ru": "Я желаю вам всем очень <w>приятных</w> выходных.",
                                "en": "I wish you all a very <w>nice</w> weekend.",
                                "it": "Vi auguro a tutti un <w>piacevole</w> fine settimana.",
                                "pl": "Życzę wam wszystkim bardzo <w>przyjemnego</w> weekendu.",
                                "de": "Ich wünsche euch allen ein sehr <w>angenehmes</w> Wochenende.",
                                "fr": "Je vous souhaite à tous un très <w>agréable</w> week-end.",
                                "cs": "Přeji vám všem velmi <w>příjemný</w> víkend.",
                                "tr": "Hepinize çok <w>hoş</w> bir hafta sonu dilerim.",
                                "es": "Les deseo a todos un fin de semana muy <w>agradable</w>.",
                                "zh": "祝大家周末<w>愉快</w>。"
                            }
                        },
                        {
                            "text": "Het was een <w>prettige</w> verrassing om haar weer te zien.",
                            "target_lang_translations": {
                                "ru": "Было <w>приятным</w> сюрпризом увидеть её снова.",
                                "en": "It was a <w>pleasant</w> surprise to see her again.",
                                "it": "È stata una <w>piacevole</w> sorpresa rivederla.",
                                "pl": "To była <w>miła</w> niespodzianka zobaczyć ją ponownie.",
                                "de": "Es war eine <w>angenehme</w> Überraschung, sie wiederzusehen.",
                                "fr": "C'était une <w>agréable</w> surprise de la revoir.",
                                "cs": "Bylo <w>příjemným</w> překvapením ji znovu vidět.",
                                "tr": "Onu tekrar görmek <w>hoş</w> bir sürprizdi.",
                                "es": "Fue una sorpresa <w>agradable</w> verla de nuevo.",
                                "zh": "再次见到她真是一个<w>美好</w>的惊喜。"
                            }
                        }
