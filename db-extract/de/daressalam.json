                    {
                        "sense_id": "4bd0840f-d895-37e6-9904-378022e8aa44",
                        "entry_id": "5da0ac9b-111e-3730-a851-eae8d88d8fa5",
                        "glosses": [
                            "ehemalige Hauptstadt und heutiger Regierungssitz von Tansania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb258f9-33c4-42b2-be85-1e51f00c6861",
                                "sense_id": "4bd0840f-d895-37e6-9904-378022e8aa44",
                                "text": "Mein Cousin studiert in Daressalam."
                            },
                            {
                                "example_id": "84452eb9-fb21-4895-aad4-2d2d6c497bcd",
                                "sense_id": "4bd0840f-d895-37e6-9904-378022e8aa44",
                                "text": "„Den ganzen Tag verbrachte er nun, über das Mikroskop gebeugt, in den großen aus Daressalam entliehenen Landvermesserzelten.“"
                            },
                            {
                                "example_id": "a2d939f6-fc85-436a-8087-192dd4bc7158",
                                "sense_id": "4bd0840f-d895-37e6-9904-378022e8aa44",
                                "text": "„Als sie in Daressalam ankamen, wartete eine böse Überraschung auf sie, denn Nyerere dementierte empört Nkomos Aussage und hegte seitdem eine erkennbare Abneigung gegen ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
