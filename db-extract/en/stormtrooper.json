                    },
                    {
                        "translation_id": "c21e67f5-dda8-42b7-a7cf-5ab4b039ee4c",
                        "source_entry_id": "f783475a-9591-33b1-93a5-1a88c638e67f",
                        "source_sense_description": "a member of the Nazi Sturmabteilung",
                        "target_lang_word": "SA-Mann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SA-Mann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                        "entry_id": "b1380c51-4017-3133-8345-73564c5b66ed",
                                        "glosses": [
                                            "Angehöriger der Sturmabteilung, einer paramilitärischen Truppe der NSDAP"
                                        ],
                                        "tags": [
                                            "Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc27b57c-714f-4660-aec0-d8a66a06c97d",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Zum „Deutschen Tag“ in Coburg 1922 wird die Delegation der NSDAP von etwa 800 SA-Männern begleitet.“"
                                            },
                                            {
                                                "example_id": "33f1950a-dcaa-4941-a055-3cca1f2e6d5e",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "[In Berlin-Köpenick] „war im Juni 1933 ein SA-Kommando auf den Widerstand eines jungen Sozialdemokraten gestoßen, der drei SA-Männer erschoss.“"
                                            },
                                            {
                                                "example_id": "9b1a93e2-8175-4e5e-ac53-68009647b8b7",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Der Sozialdemokrat Anton Schmaus erschoss in Notwehr drei SA-Männer, worauf SA-Truppen aus Köpenick und Charlottenburg mit einem Rachefeldzug antworteten.“"
                                            },
                                            {
                                                "example_id": "40028793-c05a-453d-b4b2-fb1b37cdff00",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Mehrere Tausend SA-Männer standen bereit, jede abweichende Meinung im Publikum brutal zu unterdrücken.“"
                                            },
                                            {
                                                "example_id": "90761f2a-29de-4292-8e2e-3fffbfa3ad14",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Am 30. Januar 1933 marschierten 15.000 SA-Männer durch das Brandenburger Tor und bejubelten Adolf Hitler, der gegen Mittag zum Reichskanzler ernannt worden war.“"
                                            },
                                            {
                                                "example_id": "641368e0-0755-44eb-ad55-f404f320a173",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Gewaltbereite SA-Männer marschierten zusammen mit der Polizei oder allein, staatlich legitimiert und bewaffnet, durch die Straßen und rächten sich an Kommunisten, Sozialdemokraten, Reichsbannerleuten und Juden.“"
                                            },
                                            {
                                                "example_id": "cc880989-849d-4996-92b4-2e5527a6d43b",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Joachim, der Großvater von Melanie, war \"SA-Mann der ersten Stunde\" und machte nach der \"Machtergreifung\" Karriere.“"
                                            },
                                            {
                                                "example_id": "ddfd87b1-f0b3-4a08-9588-0e8032ec6efd",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "[Jüdischer Friedhof Steinbach (Fernwald):] „Beim Novemberpogrom 1938 wurde der Friedhof durch SA-Männer zerstört.“"
                                            },
                                            {
                                                "example_id": "0f9dba1e-97e4-4954-999f-c868aa3fcf01",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Auf dem Weg zu seiner kleinen Pension wurde er in dieser Nacht, die später als die Reichskristallnacht in die Geschichte einging, Zeuge, wie aufgehetzte Jugendliche und uniformierte SA-Männer jüdische Geschäfte und Wohnungen zerstörten.“"
                                            },
                                            {
                                                "example_id": "f1de6b64-5b71-447d-ab97-08852b9ba354",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Die ehemalige Synagoge in Aurich existierte von 1810 bis 1938. SA-Männer und andere Nationalsozialisten zerstörten das Bauwerk während der Novemberpogrome 1938.“"
                                            },
                                            {
                                                "example_id": "548fb01e-21ca-49c0-9a67-42a36320b023",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Vor 100 Jahren wurde Karl Carstens geboren, der einzige Bremer und erste SA-Mann, der die höchsten Ämter der Bundesrepublik bekleidete.“"
                                            },
                                            {
                                                "example_id": "d178545f-d59a-47ce-a12d-0db46e766bbc",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Bauer war nicht nur ein eifriger SA-Mann, Referent in der Reichsfilmkammer und 1942 in der Reichsfilmintendanz, die direkt dem Propagandaminister Joseph Goebbels unterstand; auch seine Meinung zum Film als Waffe ist bekannt.“"
                                            },
                                            {
                                                "example_id": "60e12834-274b-4a96-be76-3f5791b7cf7c",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "„Adolf Hitler pflanzte in seiner Partei das Götzenzeichen des charismatischen Führerkults auf: Jeder SA-Mann mußte ewige, blinde Treue dem Manne geloben, der den Anspruch erhob, in ihm verschmölzen Partei und Führung in eins.“"
                                            },
                                            {
                                                "example_id": "37833f5e-4c30-489b-89f7-2e27bdf7e8a5",
                                                "sense_id": "6b2460c0-487b-34bf-8f4c-99f005204b28",
                                                "text": "[Otto John:] „Der ehemalige SA-Mann hatte als Nazi-Staatsanwalt in politischen Prozessen Anklagen geführt, Juden und Kommunisten ins Zuchthaus gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
