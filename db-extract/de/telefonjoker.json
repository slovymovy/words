                "senses": [
                    {
                        "sense_id": "d903b333-74bd-36aa-9009-c6e07de215d0",
                        "entry_id": "f5c422ac-fda0-31c6-abc7-9f9472b3a3e7",
                        "glosses": [
                            "eine Option in einer TV-Spielshow Hilfe per Telefon zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a04767b-241e-4538-bffb-256c1b3768dd",
                                "sense_id": "d903b333-74bd-36aa-9009-c6e07de215d0",
                                "text": "Ich nehme den Telefonjoker."
                            },
                            {
                                "example_id": "b4364543-4b06-4366-8046-964feb978320",
                                "sense_id": "d903b333-74bd-36aa-9009-c6e07de215d0",
                                "text": "„Sie ging sogar so weit, von sich zu behaupten, \"kein Spezialgebiet\" zu haben. Aber dafür einen Edel-Telefonjoker: Dieter Chmelar, das wandelnde Lexikon, gehört zur \"Promi-Millionenshow\" wie Armin Assinger.“"
                            },
                            {
                                "example_id": "f56c05aa-14f1-4eb4-8d4f-5c4d55d8aeee",
                                "sense_id": "d903b333-74bd-36aa-9009-c6e07de215d0",
                                "text": "„Am Montagabend gab es einen neuen Rekord bei \"Wer wird Millionär\": Mit 101 Jahre wurde der älteste Telefonjoker, den es jemals in der Geschichte der Quizshow gab, angerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
