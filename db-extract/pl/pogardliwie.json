                    {
                        "translation_id": "01d52d34-2f0c-415f-9745-d749251783f5",
                        "source_entry_id": "b6b4c569-89ba-33b6-b869-afffc1c72c51",
                        "source_sense_id": "05fc0fe3-f60b-39d1-9fea-53dcdc709a8f",
                        "target_lang_word": "contemptuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemptuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                        "entry_id": "66bab208-706d-3761-bb19-d1d13b78b987",
                                        "glosses": [
                                            "In a disrespectful or discourteous manner; condescendingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa55c1c1-7805-41f7-9983-f33245cd44d7",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "He argued with the judge contemptuously, showing no respect or remorse for his actions."
                                            },
                                            {
                                                "example_id": "1ee77581-a956-42b6-9dcf-056866e570a7",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "Ralph, who was a thickset clownish figure, arrived at his full strength, and conscious of the most complete personal superiority, laughed contemptuously at the threats of the slight-made stripling."
                                            },
                                            {
                                                "example_id": "e6fdffd9-d7e4-4232-b822-a9ff51ab96b4",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "'They haven't no more philosophy nor political economy about 'em than that,' said the beadle, snapping his fingers contemptuously."
                                            },
                                            {
                                                "example_id": "dc83169e-e5bb-48f8-9d65-3f6c53a8206b",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "A eunuch is a negative creature. A beardless Moslem is contemptuously designated as manless."
                                            },
                                            {
                                                "example_id": "23c648de-0f49-4209-a209-737bb05ae506",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "He snapped his fingers contemptuously at the alarm clock. \"I fear thee not, thou ticking tyrant.\""
                                            },
                                            {
                                                "example_id": "5708bcdb-4ad2-4072-8982-90bb27397a4f",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "Under the statute an individual who \"publicly mutilates, tramples upon, defaces or treats contemptuously the flag of the United States[…]\" was subject to criminal liability."
                                            },
                                            {
                                                "example_id": "ec781ee6-2ae9-48a7-a60b-347e86e18068",
                                                "sense_id": "2b257b11-7b4e-3336-9869-ec4f02396870",
                                                "text": "The girl looked at Onisi contemptuously, then laughed jeeringly. He was then six years old and didn't know how to speak in English so he couldn't understand what she was saying but he sensed that it was derogatory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fbd2ef4-b3a5-4574-afb4-fff12a5e78c6",
                        "source_entry_id": "b6b4c569-89ba-33b6-b869-afffc1c72c51",
                        "source_sense_id": "05fc0fe3-f60b-39d1-9fea-53dcdc709a8f",
                        "target_lang_word": "scornfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scornfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa66016-a632-36c5-bcf4-2c872c22d2f7",
                                        "entry_id": "49bb70df-2bd0-3ae6-a478-b93c86f59d8c",
                                        "glosses": [
                                            "In a scornful manner; contemptuously, derisively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5bce8a6-be86-4bad-a376-d116e68bc138",
                                                "sense_id": "0aa66016-a632-36c5-bcf4-2c872c22d2f7",
                                                "text": "\"Do they not sneakingly bestow on me their crass inability to do anything with their own misbegotten progeny, a subterfuge which I scornfully fub off on text-books?\""
                                            },
                                            {
                                                "example_id": "1eccd3eb-773a-4d69-bcb1-e1fd4fc926d1",
                                                "sense_id": "0aa66016-a632-36c5-bcf4-2c872c22d2f7",
                                                "text": "'What does he look like?' asks John Halgard. 'A salesman,' says Gerontius scornfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba5fcbd2-0fd9-4861-8395-b5f60a99354d",
                        "source_entry_id": "b6b4c569-89ba-33b6-b869-afffc1c72c51",
                        "source_sense_id": "05fc0fe3-f60b-39d1-9fea-53dcdc709a8f",
                        "target_lang_word": "verächtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verächtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                        "entry_id": "d8173dfb-5597-37bb-aab0-2147a7e29052",
                                        "glosses": [
                                            "jemanden missachtend, verachtend; keinen Respekt einem anderen gegenüber zeigend; Verachtung hegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c398cd6-02a9-44b4-b113-4e9b979e0b10",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "Er machte dazu nur eine verächtliche Bemerkung."
                                            },
                                            {
                                                "example_id": "e9f89b78-b36d-45e5-a151-e7138f49a8fb",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Sollte der böse Geist zurückkehren, sollte er wieder verächtlich werden – verächtlich, wie er gewesen war?“"
                                            },
                                            {
                                                "example_id": "14b43f5f-27cd-40d7-8995-82ddab028299",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Die Schusterfrau, die Schlächtermeisterin, alle wandten sich verächtlich von ihm ab.“"
                                            },
                                            {
                                                "example_id": "687aa9ad-83b7-4ebe-9a64-db8da86ddb50",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Du hast Glück, dass deine Eltern dich nicht schon längst losgeworden sind«, sagte Fausta verächtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a47d460c-0d9d-4edd-8847-6da2970169ed",
                        "source_entry_id": "b6b4c569-89ba-33b6-b869-afffc1c72c51",
                        "source_sense_id": "05fc0fe3-f60b-39d1-9fea-53dcdc709a8f",
                        "target_lang_word": "abfällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abfällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb729ba-bcc1-3f69-9d9b-c98fd59eac92",
                                        "entry_id": "e5f95a92-6a89-379b-8c9a-9354a78da89e",
                                        "glosses": [
                                            "eine ablehnende Haltung zeigend, nur wenig wertschätzend, mit Verachtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9061b46b-d093-459e-8454-19250d3961c1",
                                                "sense_id": "5cb729ba-bcc1-3f69-9d9b-c98fd59eac92",
                                                "text": "„Wer sich abfällig über einen teuren Lieferanten äußert, sollte vorher geklärt haben, ob das nicht der beste Freund des Chefs ist.“"
                                            },
                                            {
                                                "example_id": "576fae3f-f8ab-4858-bcf0-3d5f7d69947d",
                                                "sense_id": "5cb729ba-bcc1-3f69-9d9b-c98fd59eac92",
                                                "text": "„Ihr Vater konnte diesen Auftritt gut gebrauchen, denn er lief Gefahr, durch seine abfälligen Äußerungen Frauen gegenüber in der Wählergunst abzusacken.“"
                                            },
                                            {
                                                "example_id": "71080981-80dc-4a1a-8033-202a2b0265ef",
                                                "sense_id": "5cb729ba-bcc1-3f69-9d9b-c98fd59eac92",
                                                "text": "„Dennoch zieht der Künstler Zorn auf sich, da er sich oft nicht genug informiert und viele Personen mit abfälligen Äußerungen brüskiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "605df010-d690-3a67-8e61-191856508049",
                                        "entry_id": "e5f95a92-6a89-379b-8c9a-9354a78da89e",
                                        "glosses": [
                                            "verbleibend, übrig geblieben"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66542ac0-3dc8-4c64-9c9e-e340765e707e",
                                                "sense_id": "605df010-d690-3a67-8e61-191856508049",
                                                "text": "„Am Seziertisch werden auch Körperteile beschädigt oder zerstört und damit abfällige Reste durch Schnitte produziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
