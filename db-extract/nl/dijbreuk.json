                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6b1995-5820-4f6f-b10a-53930f702d59",
                                "sense_id": "a422df88-fcab-349d-a61c-4c6a59bc12d7",
                                "text": "Ik heb negen uur op de grond gelegen met een hersenschudding en een dubbele dijbreuk. Niemand hoorde mijn hulpgeroep.'"
                            },
                            {
                                "example_id": "f7f1af20-c7f4-465c-b4fb-ea1b8629e0a7",
                                "sense_id": "a422df88-fcab-349d-a61c-4c6a59bc12d7",
                                "text": "Hij liep een open dijbreuk op en werd naar het ziekenhuis overgebracht."
                            },
                            {
                                "example_id": "3cfc6c1a-ca7d-481f-9f7d-9d54baea5be8",
                                "sense_id": "a422df88-fcab-349d-a61c-4c6a59bc12d7",
                                "text": "Welkom in Afrika: de kersverse voorzitter van een groot fonds beschrijft zijn eerste dag in het olierijke Nigeria. Hij ziet een zwaar auto-ongeval, een zesjarige jongen loopt een schedelbreuk en dijbreuk op met zware inwendige bloedingen."
                            }
                        ]
                    },
                    {
