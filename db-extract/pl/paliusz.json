                                "target_senses": [
                                    {
                                        "sense_id": "5ffb937b-fb28-3c91-8e2e-56dfcaf2aa19",
                                        "entry_id": "48b6167a-bb25-302c-b3d5-a7f187199009",
                                        "glosses": [
                                            "A large cloak worn by Greek philosophers and teachers."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f18d337-df81-3e0d-baf3-23cb578ecaa1",
                                        "entry_id": "48b6167a-bb25-302c-b3d5-a7f187199009",
                                        "glosses": [
                                            "A woolen liturgical vestment resembling a collar and worn over the chasuble in the Western Christian liturgical tradition, conferred on archbishops by the Pope, equivalent to the Eastern Christian omophorion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53525a32-3561-49ba-8761-264adcbb8abd",
                                                "sense_id": "3f18d337-df81-3e0d-baf3-23cb578ecaa1",
                                                "text": "Tut, tut, I have absolved thee: dost thou scorn me, / Because I had my Canterbury pallium / From one whom they dispoped?"
                                            },
                                            {
                                                "example_id": "50c65528-031d-43fa-a174-099527185be0",
                                                "sense_id": "3f18d337-df81-3e0d-baf3-23cb578ecaa1",
                                                "text": "Gregory sent Augustine a special liturgical stole, the pallium, a piece of official ecclesiastical dress borrowed from the garments worn by imperial officials."
                                            },
                                            {
                                                "example_id": "740b6acf-bce5-4651-9c68-cd768d7002ad",
                                                "sense_id": "3f18d337-df81-3e0d-baf3-23cb578ecaa1",
                                                "text": "Wynfrith, an Anglo-Saxon monk later known as St Boniface, who was the first archbishop of Mainz and a key figure in the Empire's church history, was given cloth that had lain across St Peter's tomb as his pallium in 752."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f527a785-1b01-33ca-aa0a-0b9003ee1791",
                                        "entry_id": "48b6167a-bb25-302c-b3d5-a7f187199009",
                                        "glosses": [
                                            "The mantle of a mollusc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc8a07cb-c352-3710-adcb-2dc4d1a48115",
