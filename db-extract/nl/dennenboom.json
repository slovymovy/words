                ],
                "senses": [
                    {
                        "sense_id": "8746cf0c-0bfa-345c-8e7f-31b3cbc61e02",
                        "entry_id": "0f95af25-4812-3ec0-a588-ae01774473e1",
                        "glosses": [
                            "bepaald soort naaldboom, Pinus sylvestris"
                        ],
                        "tags": [
                            "coniferen"
                        ],
                        "examples": [
                            {
                                "example_id": "b3ec9e36-4414-43a9-ad5d-e5ca3235a49b",
                                "sense_id": "8746cf0c-0bfa-345c-8e7f-31b3cbc61e02",
                                "text": "Een wandelaar tipte de politie gisteren op een tent aan de Lariksweg in Epe. Toen agenten een kijkje namen bij de tent vonden zij vijf hennepplanten. Aangezien de eigenaar onbekend was, besloten de agenten de planten ter plekke te vernietigen. Daarna bedacht een van de agenten het plan om in de lege potten van de mini-hennepkwekerij dennenboompjes te zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbd9eb6b-1f81-310e-8aca-83a4694273f6",
                        "entry_id": "0f95af25-4812-3ec0-a588-ae01774473e1",
                        "glosses": [
                            "boom die in huis staat tijdens kerstmis en versierd is met kerstballen en lichtjes (meestal gaat het dan overigens om een spar!)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4712c6-1567-4716-be0d-78d5e5f27ce4",
                                "sense_id": "cbd9eb6b-1f81-310e-8aca-83a4694273f6",
                                "text": "De taak van de kerstboom zit erop, en dus wordt hij meedogenloos uit de huiskamer verbannen. Onterecht, want een dennenboom is een bom vitamine C, die in de Lage Landen al van oudsher gebruikt werd om de winter door te komen wanneer fruit schaars was. Hoog tijd om de traditie van kerstboomkoken in ere te herstellen."
                            },
                            {
                                "example_id": "bf3246e5-b06d-4e8b-9586-d334c950dff2",
                                "sense_id": "cbd9eb6b-1f81-310e-8aca-83a4694273f6",
                                "text": "O dennenboom, o dennenboom,\nwat zijn uw takken wonderschoon.\nIk heb u laatst in 't bos zien staan,\ntoen zaten er geen kaarsjes aan.\nO dennenboom, o dennenboom,\nwat zijn uw takken wonderschoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02a1f5b3-8723-4a46-bbe0-61dbccc0a822",
                        "source_entry_id": "0f95af25-4812-3ec0-a588-ae01774473e1",
                        "source_sense_id": "8746cf0c-0bfa-345c-8e7f-31b3cbc61e02",
