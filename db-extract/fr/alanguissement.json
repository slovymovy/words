        "fr-extract.jsonl": [
            {
                "entry_id": "a9d467b5-212b-384a-bfb0-98cc0294aff3",
                "word": "alanguissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95808963-2a60-4619-8ee7-95c047586d6a",
                        "entry_id": "a9d467b5-212b-384a-bfb0-98cc0294aff3",
                        "tags": [
                            "plural"
                        ],
                        "form": "alanguissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40f7562b-0cff-3048-a3d7-36290e488149",
                        "entry_id": "a9d467b5-212b-384a-bfb0-98cc0294aff3",
                        "glosses": [
                            "État d’une personne rendue languissante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec29bc8-a226-4a0e-add5-e1acf68b92e9",
                                "sense_id": "40f7562b-0cff-3048-a3d7-36290e488149",
                                "text": "Simon avait des minutes de béatitude, de cet alanguissement qui suit les larmes, où il lui venait de grandes envies de s’endormir là, sur l’herbe, dans la chaleur."
                            },
                            {
                                "example_id": "62691b0e-04e0-46c2-a7f0-928a1b118702",
                                "sense_id": "40f7562b-0cff-3048-a3d7-36290e488149",
                                "text": "Ou bien, c’était pis encore, le soir, quand ils tardaient tous deux à faire apporter la lampe, un alanguissement sous la tombée lente de la nuit complice, une chute involontaire, l’irréparable, aux bras l’un de l’autre."
                            },
                            {
                                "example_id": "b9771fbf-1366-4a19-b244-7fc5e0d4c88c",
                                "sense_id": "40f7562b-0cff-3048-a3d7-36290e488149",
                                "text": "Mais ici, bien plus que là-bas, en France, dans l'alanguissement de cette vie monotone, dans sa solitude d'âme, il éprouvait le grand trouble des sens avides."
                            },
                            {
                                "example_id": "a43d7a35-7332-4553-862f-fc0d2be66627",
                                "sense_id": "40f7562b-0cff-3048-a3d7-36290e488149",
                                "text": "Quand je reviens en pensée sur ces journées unies et monotones, et pourtant pleines d’une attente et d’un éveil, pareilles à l’alanguissement nauséeux d’une femme grosse, je me rappelle avec étonnement combien Vanessa et moi nous semblions avoir peu à nous dire."
                            }
                        ]
                    },
                    {
                        "sense_id": "78c1fcce-1c53-394b-9058-66b87775be54",
                        "entry_id": "a9d467b5-212b-384a-bfb0-98cc0294aff3",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "abfda6f1-e33e-4e3a-846c-adbe608575ae",
                                "sense_id": "78c1fcce-1c53-394b-9058-66b87775be54",
                                "text": "Alanguissement du corps, alanguissement de l’esprit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3065e15-0f03-4a10-9cf6-139d737eb8ae",
                        "source_entry_id": "a9d467b5-212b-384a-bfb0-98cc0294aff3",
                        "target_lang_word": "loomheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loomheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                                        "entry_id": "b3578f37-04e3-3430-af2a-626fdaac54df",
                                        "glosses": [
                                            "het vermoeid, lui en loom zijn zowel geestelijk als lichamelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ec2852-96c0-4f62-9af7-2d5ffb2f89d7",
                                                "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                                                "text": "De zon laat de loomheid indalen in elke vezel en porie; alle stress en spanning glijden uit mijn systeem. Zon, zee, wijn en tapas, meer heeft een mens blijkbaar niet nodig om te ontspannen."
                                            },
                                            {
                                                "example_id": "9b438446-1cb6-41f0-a86e-18f377eec01f",
                                                "sense_id": "7d8dcc8c-e521-3d85-a976-edb9b6b9fc89",
                                                "text": "Zorg dat je mee gaat met het seizoen: kruip uit je winterslaap, schud de loomheid van je af en zorg dat je in de volgende versnelling komt. Hoe eerder je dat doet, hoe meer je al gaat genieten. Zo ben jij straks helemaal klaar voor de zomer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
