                                        "glosses": [
                                            "To deliver a monologue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93f5723-506e-4e89-9792-93a530337832",
                                                "sense_id": "f692552a-d118-33e7-bbbc-a358f9595191",
                                                "text": "Powerful parents, in her formulation, feeling themselves autonomous and powerful, give autonomy and power to their children; powerless ones, feeling themselves passive and controlled, in turn exert an excessive control on their children, and monologue at them, instead of having a dialogue with them."
                                            }
                                        ]
