            "pos": "noun",
            "senses": [
                {
                    "sense_id": "704fe8f3-f3e2-350a-ac00-309f14c95c3b",
                    "sense_definition": "Dispositif lumineux clignotant d'un véhicule servant à avertir les autres usagers d'un changement de direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "signalisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de mettre ton <w>clignotant</w> avant de tourner à droite."
                        },
                        {
                            "text": "Le conducteur a actionné son <w>clignotant</w> pour doubler le camion en toute sécurité."
                        }
                    ],
                    "synonyms": [
                        "clignoteur",
                        "cligno",
                        "feu indicateur de direction"
                    ],
                    "common_phrases": [
                        "mettre son clignotant",
                        "actionner le clignotant",
                        "clignotant gauche"
                    ]
                },
                {
                    "sense_id": "71c94537-976c-3629-8293-315447cbbfcb",
                    "sense_definition": "Indicateur ou signal d'alerte permettant de mesurer l'évolution d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signalisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les <w>clignotants</w> économiques sont au rouge depuis le début de la crise."
                        },
                        {
                            "text": "Le médecin surveille attentivement les premiers <w>clignotants</w> de fatigue chez son patient."
                        }
                    ],
                    "common_phrases": [
                        "clignotants au rouge",
                        "clignotants d'alerte"
                    ]
                }
            ]
        },
        {
