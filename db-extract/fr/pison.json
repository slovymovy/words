                        "entry_id": "89bc7271-5bb4-398d-bf2d-074553d203a4",
                        "glosses": [
                            "Batte pour piser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1219173-b992-42bc-8905-c8b74579d0e9",
                                "sense_id": "904386b4-2140-3218-a265-5038fefd79de",
                                "text": "La terre est comprimée à la main à l’aide d’un pison ou pisoir qui prend la forme d’une masse en bois."
                            },
                            {
                                "example_id": "f4b2baca-b9ba-461f-9b84-35861eed8160",
                                "sense_id": "904386b4-2140-3218-a265-5038fefd79de",
                                "text": "Les piseurs étaient généralement au nombre de trois, chacun avec un pison (instrument de damage) de module différent."
                            },
                            {
                                "example_id": "ada29b1b-fa84-4b91-bba2-57f4178f426d",
                                "sense_id": "904386b4-2140-3218-a265-5038fefd79de",
                                "text": "La terre est compactée manuellement à lʼaide dʼun pisoir (ou pison) entre deux coffrages en planches."
                            }
                        ]
                    }
