                ],
                "senses": [
                    {
                        "sense_id": "572aa61c-5200-3866-b598-4313682e14c0",
                        "entry_id": "a585f938-eb72-3888-bdef-eaaee1690a5c",
                        "glosses": [
                            "Exprimer à travers la ventriloquie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf168ffb-79fe-4aec-b8d9-cafd0a0d0750",
                                "sense_id": "572aa61c-5200-3866-b598-4313682e14c0",
                                "text": "Cet art interroge donc l'acte de la création : quelles sont les voix qui ventriloquent un créateur, qui viennent parler à travers lui ?"
                            },
                            {
                                "example_id": "b181d079-2a11-4f16-b2ab-027847532dba",
                                "sense_id": "572aa61c-5200-3866-b598-4313682e14c0",
                                "text": "Ses litanies issues des couches souterraines de l'esprit se réverbèrent dans votre crâne et ventriloquent vos propres pensées."
                            },
                            {
                                "example_id": "b1fa2afc-ad2d-4f86-909e-4ba7486ae821",
                                "sense_id": "572aa61c-5200-3866-b598-4313682e14c0",
                                "text": "Le résultat est clair: ils ventriloquent «par en bas» pour se dispenser de réfléchir «par en haut»."
                            }
                        ]
                    }
                ],
