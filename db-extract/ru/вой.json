                    {
                        "form_id": "ca0f323c-aace-44d6-b398-5cfa472fa0d3",
                        "entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "во́ях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e886598f-5ab5-3153-9feb-57c1bdf5d6ad",
                        "entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "glosses": [
                            "продолжительный, протяжный звук, издаваемый некоторыми животными (волком, собакой, шакалом и т. п.); завывание, вытьё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8610f835-3153-43c0-a004-3bf00bcd483a",
                                "sense_id": "e886598f-5ab5-3153-9feb-57c1bdf5d6ad",
                                "text": "Я слышал вой и лай собак и радовался, воображая, что город не далеко."
                            },
                            {
                                "example_id": "38ebb63d-0f56-4c7b-b80d-d0200dd91dad",
                                "sense_id": "e886598f-5ab5-3153-9feb-57c1bdf5d6ad",
                                "text": "Ночью просыпаюсь я и слышу вдали вой волков."
                            }
                        ]
                    },
                    {
                        "sense_id": "5abf8fde-3168-34dc-bf1b-f8f930adf1f0",
                        "entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "glosses": [
                            "перен., разг. громкий, протяжный плач, вопль; вытьё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3c699b-9e38-4aee-add9-c2abbb428f5f",
                                "sense_id": "5abf8fde-3168-34dc-bf1b-f8f930adf1f0",
                                "text": "Народ, пригнанный в лагерь, поставлен был на колени перед пушками. Женщины подняли вой. Им объявили прощение."
                            }
                        ]
                    },
                    {
                        "sense_id": "a010f298-aa78-3f5d-b851-cd79f38bb0ba",
                        "entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "glosses": [
                            "перен., разг. протяжные, заунывные, тревожные звуки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f120365c-ff7c-447e-9f77-564ea94f873c",
                                "sense_id": "a010f298-aa78-3f5d-b851-cd79f38bb0ba",
                                "text": ".. пронзительный свист и вой ветра сливались с беспрерывными ударами грома."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdffb8a0-13e4-385b-96b6-09087a9440d7",
                        "entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "glosses": [
                            "разг., сниж. шумный протест, громкое недовольство, возмущение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "882724cf-5183-4708-a334-14dd22ee361c",
                                "sense_id": "bdffb8a0-13e4-385b-96b6-09087a9440d7",
                                "text": "И не знаю — продолжать или кончить. // В зале, вроде, ни смешочков, ни вою… // Первый тоже, вижу, рожи не корчит, // А кивает мне своей головою!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60715fb7-9474-4b0e-9746-f4ec03927391",
                        "source_entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "source_sense_description": "продолжительный, протяжный звук, издаваемый некоторыми животными (волком, собакой, шакалом и т. п.); завывание, вытьё",
                        "target_lang_word": "Geheul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "170f1979-ec10-35d3-a0b4-ef49075e9e13",
                                        "entry_id": "c5adc6e8-039a-3c39-bcd0-9a71d7e33624",
                                        "glosses": [
                                            "intensives, durchdringendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a769b962-c6a9-4edb-9893-29347e084a52",
                                                "sense_id": "170f1979-ec10-35d3-a0b4-ef49075e9e13",
                                                "text": "„Das Geheul der Sirene durchschnitt die Höhenluft, und die kleine Festversammlung auf dem Dorfplatz hörte mit gemischten Gefühlen zu.“"
                                            },
                                            {
                                                "example_id": "4909bb77-5bb8-43ee-9cc9-a0c23e33f4dd",
                                                "sense_id": "170f1979-ec10-35d3-a0b4-ef49075e9e13",
                                                "text": "„Jetzt aber, in dem Erdbeben, in dem Geheul der Fliegersirenen, in dem Gejammer der flüchtenden Herden, wünsche ich mir das gewöhnliche Leben herbei wie Brot und Wasser.“"
                                            },
                                            {
                                                "example_id": "2f24746a-beff-4cab-87ae-90d8a3a9bd8c",
                                                "sense_id": "170f1979-ec10-35d3-a0b4-ef49075e9e13",
                                                "text": "„Wolf setzte sich nieder, hob den Kopf empor, sah seinem Herrn treuherzig in die Augen, warf sich mehrere Male unruhig von einem Vorderlauf auf den andern und stieß plötzlich ein klagendes Geheul aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd5e986b-ac78-3495-9f80-facd588c356f",
                                        "entry_id": "c5adc6e8-039a-3c39-bcd0-9a71d7e33624",
                                        "glosses": [
                                            "lautstarkes Jaulen, Schreien oder Weinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e1a8a0-d15b-4196-b826-b27ac6a4c4d7",
                                                "sense_id": "dd5e986b-ac78-3495-9f80-facd588c356f",
                                                "text": "Unter Geheul stoben die Kinder davon."
                                            },
                                            {
                                                "example_id": "089c7df0-006a-40c5-a506-4a2f673e8dc7",
                                                "sense_id": "dd5e986b-ac78-3495-9f80-facd588c356f",
                                                "text": "„Ein tobendes Geheul schallte ihm noch eine Weile nach, das sich allmählich in den Bergesklüften verlor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d596f60-2db3-4aa3-8ac2-cf44cd897c75",
                        "source_entry_id": "c73ec79f-1f4c-3f7b-99a8-f59641633bb7",
                        "source_sense_description": "продолжительный, протяжный звук, издаваемый некоторыми животными (волком, собакой, шакалом и т. п.); завывание, вытьё",
                        "target_lang_word": "hurlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Action de hurler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a26a9b-ef1c-40c9-9fd2-b62db98fc46c",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "La nuit était complètement venue, le désert s’éveillait peu à peu ; les hurlements des bêtes fauves résonnaient déjà dans la prairie."
                                            },
                                            {
                                                "example_id": "1e27edcc-5ee8-4836-998a-c8e0d2737d3f",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "– Si je pouvais l'instrumenter à ma guise, peut-être la guérirais-je.\n– Comment cela ?\n– En la rouant de coups. J'ai guéri de la sorte vingt paysannes dans un village où s'était déclarée cette furieuse folie russe, le hurlement ; une femme se met à hurler, sa commère hurle. Au bout de trois jours, tout un village hurle. À force de les rosser, j'en suis venu à bout."
                                            },
                                            {
                                                "example_id": "999df36e-5308-4831-a193-6b65792bafbd",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "Chacun peut s'adonner aux joies des paris. Il faut alors entendre les hurlements des parieurs, et les cris des spectateurs. Seul un habitué des gallodromes est capable de comprendre ce qui est en train de se passer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Bruit sinistre semblable au cri qui résulte de cette action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e91149-9e10-4172-8aca-83cec467631e",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "Là-haut sa voix tonnante domine souvent les hurlements de la tempête ou le tumulte des combats ; mais ici elle est douce et mélodieuse […]."
                                            },
                                            {
                                                "example_id": "42f084d6-88ff-4a49-8495-a977af85f1f8",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "À chaque coup de roulis ou de tangage le hurlement continu du vent s'amplifiait d'un sifflement sinistre ; […]."
                                            },
                                            {
                                                "example_id": "8d9c80e5-7195-4c07-bfb5-84bce6becf72",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "Une dernière voiture, en slalomant en peu, eut le temps de passer, avec un hurlement de klaxons, avant qu'ils ne barrent l'accès vers Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad305d7-2583-3bb7-a756-e0d316e8cc3a",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Cri du loup."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
