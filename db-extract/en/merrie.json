                                "example_id": "5237a26c-6c19-4a42-9905-83b0408232c5",
                                "sense_id": "2924fd05-b1b7-3bc0-a4ad-897a9934b1ea",
                                "text": "The annual meet of the National Archery Association will take place at the Soldiers’ Home next week, commencing on the 27th. It will be a merrie meet, and all the skilled bowsmen and bowswomen in the districts are expected to compete for the admirable prizes."
                            },
                            {
                                "example_id": "f4d1eb5c-8bee-47b2-a1d1-172359ff5a63",
                                "sense_id": "2924fd05-b1b7-3bc0-a4ad-897a9934b1ea",
                                "text": "Crossbowmen from such distant realms as Texas, Oklahoma, Tennessee, Missouri, Illinois, New York, New Jersey and Delaware, all right there in Merrie Olde Arkansas, in the non-medieval year of 1973."
                            },
                            {
                                "example_id": "458a76a0-fbc7-4dc1-8298-231f5fd06f9d",
                                "sense_id": "2924fd05-b1b7-3bc0-a4ad-897a9934b1ea",
                                "text": "And watch this ailing Knight of a Merrie day / Extend a sagging hand and fall into a chair; […]"
                            }
                        ]
