                "senses": [
                    {
                        "sense_id": "b1e6eab5-36e8-3c80-a1c9-c4861a6d531a",
                        "entry_id": "0cfb9197-4127-366a-a5b5-7fb565bf11df",
                        "glosses": [
                            "Spiel/Partie mit Würfeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57bd00b1-db64-4da5-89f5-ba35de0441ba",
                                "sense_id": "b1e6eab5-36e8-3c80-a1c9-c4861a6d531a",
                                "text": "„Während Simen Tjing und Sjä Si-da drei Würfelpartien spielten, erschienen auf einmal Li Ming und Wu Hwe und warfen sich aufs Antlitz.“"
                            },
                            {
                                "example_id": "cc7cd2a6-b312-4615-9c03-2b85d461c252",
                                "sense_id": "b1e6eab5-36e8-3c80-a1c9-c4861a6d531a",
                                "text": "„Spielen Sie gegen Karls Begleiter Manfred eine Würfelpartie und stehlen Sie danach im Gästezimmer den Brief, der Karl ins Kloster ruft.“"
                            },
                            {
                                "example_id": "19fd5f5f-5813-4c48-99dc-dc785287af37",
                                "sense_id": "b1e6eab5-36e8-3c80-a1c9-c4861a6d531a",
                                "text": "„Manche unserer Mitglieder feilen dabei weiter an der Zielgenauigkeit bei einer Runde Darts, andere testen ihr Glück in einer Würfelpartie oder suchen einfach das Gespräch mit Freunden bei einem kühlen Getränk.“"
                            },
                            {
                                "example_id": "2afa04ac-e893-4df0-b2cd-40b19561aacc",
                                "sense_id": "b1e6eab5-36e8-3c80-a1c9-c4861a6d531a",
                                "text": "„Und schon geht sie los, die wilde Würfelpartie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
