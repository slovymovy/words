                    {
                        "translation_id": "2137067c-47f9-4087-8415-104b9bbe350f",
                        "source_entry_id": "03d15ecb-5a90-332d-b051-4373884c2105",
                        "source_sense_id": "cec2fe09-95d8-3333-89e7-b009c50c60f6",
                        "source_sense_description": "Bestattung, bei der die Leiche des Verstorbenen als Ganzes/unverbrannt beerdigt wird",
                        "target_lang_word": "pohřeb",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pohřeb",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6354f09b-8adc-3121-a72a-fc8cd0421815",
                                        "entry_id": "a16ef669-c64a-34c0-8b93-24cccc2cfc83",
                                        "glosses": [
                                            "poslední (organizované, zpravidla slavnostní) rozloučení se zemřelým člověkem obvykle spojené s uložením ostatků zesnulého"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a0f653-817b-4978-bda5-a0e688381a7f",
                                                "sense_id": "6354f09b-8adc-3121-a72a-fc8cd0421815",
                                                "text": "Devětačtyřicetiletá Ruska se vzbudila na svém pohřbu ve chvíli, kdy nad rakví truchlili její příbuzní. Žena se hrozně vyděsila, začala křičet a dostala infarkt. Lékařům se ji už nepodařilo zachránit. Žena tak zemřela dvanáct minut po svém vlastním pohřbu."
                                            },
                                            {
                                                "example_id": "65b8053e-3d9e-4df9-a04e-9ff4543ae5a9",
                                                "sense_id": "6354f09b-8adc-3121-a72a-fc8cd0421815",
                                                "text": "„Včera jsme měli dva pohřby,“ zaváděl řeč na jiné pole kostelník od Svatého Apolináře. „To patrně někdo umřel,“ řekl druhý host, načež třetí dodal: „Byly ty pohřby s katafalkem?“ „Rád bych věděl,“ řekl Švejk, „jaký budou ve válce teď ty vojenský pohřby.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
