                        "sense_id": "f816557a-3411-3b48-984a-9a1f5f88f454",
                        "entry_id": "5fc013d4-a578-39d3-955c-c5361244a7e6",
                        "glosses": [
                            "A sexually mature person below, or appearing to be below, the legal age of consent, who is regarded, usually by an adult, as being sexually attractive and/or seductive."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "725cd64d-73a0-4ed8-9ffb-673604b0f1cb",
                                "sense_id": "f816557a-3411-3b48-984a-9a1f5f88f454",
                                "text": "\"The first time she modelled for Edward Weston, in March 1934, Charis Wilson knew she didn’t look good. At 20 she was “a piece of jailbait”, a mere child, especially with the stumpy plaits into which she sometimes twisted her hair.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79943447-aa7b-4055-baf2-6ec1a4991e58",
                        "source_entry_id": "5fc013d4-a578-39d3-955c-c5361244a7e6",
                        "source_sense_id": "f816557a-3411-3b48-984a-9a1f5f88f454",
