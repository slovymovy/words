                        "examples": [
                            {
                                "example_id": "f9672bb8-94e5-4273-875b-cd776b3ed590",
                                "sense_id": "c774f728-d0dc-3cd1-a823-c7d5b3729b17",
                                "text": "De wereldreiziger heeft al vele landen en continenten bezocht.",
                                "translation": "The globetrotter has visited many countries and continents.",
                                "english": "The globetrotter has visited many countries and continents."
                            },
                            {
                                "example_id": "b0cec2a6-b7c4-4afa-9939-47e56146f8a9",
                                "sense_id": "c774f728-d0dc-3cd1-a823-c7d5b3729b17",
                                "text": "Als wereldreiziger heeft hij veel avontuurlijke verhalen te vertellen.",
                                "translation": "As a globetrotter, he has many adventurous stories to tell.",
                                "english": "As a globetrotter, he has many adventurous stories to tell."
                            },
                            {
                                "example_id": "4af69677-0e01-4ede-8394-d5bb0a023d2a",
                                "sense_id": "c774f728-d0dc-3cd1-a823-c7d5b3729b17",
                                "text": "De wereldreizigertjes dromen ervan om later de wereld te verkennen.",
                                "translation": "The little globetrotters dream of exploring the world when they grow up.",
                                "english": "The little globetrotters dream of exploring the world when they grow up."
                            }
                        ]
                    }
