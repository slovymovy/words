                "translations": [
                    {
                        "translation_id": "5123ec30-5f49-401a-b8e9-3d7b78fecb80",
                        "source_entry_id": "f4904be4-c9da-302b-a651-b8501d8eb5cd",
                        "source_sense_description": "сутулить",
                        "target_lang_word": "courber",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courber",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                        "entry_id": "65d65255-1e10-37af-926c-01c853b69af4",
                                        "glosses": [
                                            "Rendre courbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c35d043-b776-4537-b4ce-91cf9f664698",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "D’une grosseur appétissante, fermes et opaques, long-pendues en trochets bien fournis, elles courbaient les longues branches."
                                            },
                                            {
                                                "example_id": "aa9ced59-b2d9-4414-b97b-e4bbdea8ffdb",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "Une charge trop forte a courbé cette pièce de bois, cette poutre."
                                            },
                                            {
                                                "example_id": "3d1d544c-13ec-4901-b712-f424a3687ca8",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "La vieillesse l’a tout courbé."
                                            },
                                            {
                                                "example_id": "7d89891d-f987-4bee-b22a-95c6f1b1dccf",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "Se courber pour ramasser quelque chose."
                                            },
                                            {
                                                "example_id": "ab0d40ff-3b00-4c97-83f2-a0d528e1bc9c",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "Courber un arc pour le bander."
                                            },
                                            {
                                                "example_id": "8804e5af-cfb0-43f2-b20e-0a76852f73a3",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "Courber une règle."
                                            },
                                            {
                                                "example_id": "c7f9452f-70eb-4c40-bd1e-e5fb8020be0d",
                                                "sense_id": "a3c1f56a-7615-39d8-9c15-fb826009b896",
                                                "text": "Les ans ont courbé sa tête, son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71fef21-d9af-3240-8952-24647e0dfc9e",
                                        "entry_id": "65d65255-1e10-37af-926c-01c853b69af4",
                                        "glosses": [
                                            "Sécher les cours."
                                        ],
                                        "tags": [
                                            "Suisse romande"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fba7f893-5de8-49b7-bcc6-62fe3f4076ac",
                                                "sense_id": "e71fef21-d9af-3240-8952-24647e0dfc9e",
                                                "text": "J'ai courbé la philo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd2d9a8-e282-35fc-8b35-9071be7a33ab",
                                        "entry_id": "65d65255-1e10-37af-926c-01c853b69af4",
                                        "glosses": [
                                            "Devenir courbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f5a8a1d-e55a-409b-9836-2927fe4b4c55",
                                                "sense_id": "4dd2d9a8-e282-35fc-8b35-9071be7a33ab",
                                                "text": "Il courbait sous le faix."
                                            },
                                            {
                                                "example_id": "2a9f5d55-0dd9-43ec-94bb-da3afbb0dd1a",
                                                "sense_id": "4dd2d9a8-e282-35fc-8b35-9071be7a33ab",
                                                "text": "Le roseau courbe sous le vent."
                                            },
                                            {
                                                "example_id": "950380e7-6e2d-4a90-8c8f-2776d7a11bcb",
                                                "sense_id": "4dd2d9a8-e282-35fc-8b35-9071be7a33ab",
                                                "text": "Cette poutre, cette branche se courbe."
                                            },
                                            {
                                                "example_id": "e7f74c6d-06e6-4c13-846e-985ba9fe5e9b",
                                                "sense_id": "4dd2d9a8-e282-35fc-8b35-9071be7a33ab",
                                                "text": "Il devient vieux, il commence à se courber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be233daf-5952-3ea7-82c4-5a0a00287f15",
                                        "entry_id": "65d65255-1e10-37af-926c-01c853b69af4",
                                        "glosses": [
                                            "Plier sous la volonté d’un autre, donner à quelqu’un des marques de soumission, de respect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c514570d-d40d-4502-a543-d46fa57acef4",
                                                "sense_id": "be233daf-5952-3ea7-82c4-5a0a00287f15",
                                                "text": "Tout se courbe, tout est courbé devant cet homme."
                                            },
                                            {
                                                "example_id": "0f4d51ed-99bf-49c4-9889-dc2f887c837e",
                                                "sense_id": "be233daf-5952-3ea7-82c4-5a0a00287f15",
                                                "text": "Se courber devant l’idole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adb5b249-539e-413e-a319-e7466cb55f1b",
                        "source_entry_id": "f4904be4-c9da-302b-a651-b8501d8eb5cd",
                        "source_sense_description": "выполнять тяжёлую работу",
                        "target_lang_word": "bosser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57777059-f826-3648-8572-92a94c0c1091",
                                        "entry_id": "003b8948-1ca9-313e-a4b2-af8d6f074da8",
                                        "glosses": [
                                            "Mettre l’ancre sur ses bossoirs, retenir avec des bosses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2521dd3-8950-4bc3-9a15-c8f050f3ed40",
                                                "sense_id": "57777059-f826-3648-8572-92a94c0c1091",
                                                "text": "Bosser un câble, un cordage. bosser les huniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592e29ec-ffa0-3c48-b122-99052459a712",
                                        "entry_id": "003b8948-1ca9-313e-a4b2-af8d6f074da8",
                                        "glosses": [
                                            "Faire une bosse."
                                        ],
                                        "tags": [
                                            "Taille de pierre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6296062-70fe-4f4f-ae3c-86494c5e3d57",
                                                "sense_id": "592e29ec-ffa0-3c48-b122-99052459a712",
                                                "text": "Fais gaffe à ne pas bosser sinon tu perdras du temps sur ta face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bosser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                        "entry_id": "fc17ffa0-fc55-3add-9541-a2302e717dcd",
                                        "glosses": [
                                            "Travailler."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33a57ee-dabb-4467-8da0-3092cbd25095",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "L’ouvrier monologuait encore : « On dit que l’ouvrier veut plus travailler ! Il a raison ! Celui qui “bosse” en ce moment est un beau con ! »"
                                            },
                                            {
                                                "example_id": "f886912b-dc4a-4431-9492-c6df8d1ee7c4",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "Lorsque le matin j’arrive dans la cour de l’usine, (...) je vous entends murmurer : « Oh ! Y’en a marre d’aller travailler ! D’aller bosser ! D’aller... Je ne sais quelles expressions triviales — d’aller turbiner ! » Qu’est-ce que ça veut dire, ça, hein ? On a l’impression que ça vous ennuie de venir travailler dans mon usine !"
                                            },
                                            {
                                                "example_id": "09101239-461e-4b4a-87f6-d0d73b5c6273",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "Dans la chambre, son cothurne est penché sur son bureau en train de pougner, comme tous les soirs. On dirait qu'il bosse des sciences de l'ingénieur, ce qu'il y a de plus chiant au monde."
                                            },
                                            {
                                                "example_id": "9ba4b5b2-e07f-4ee5-8659-3b4f13189bf2",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "Dans la police, on bosse, mon vieux, ça n'est pas comme dans l’Éducation nationale, et puis j'avais des récupes à prendre avant les vacances d’été, sinon elles passaient à l’as : j'allais pas en faire don à l’administration."
                                            },
                                            {
                                                "example_id": "32ee97ee-3dd7-42f8-be2c-8df7ddab37aa",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "Bosser sur le foot, ce n’était pas un sujet “légitime” dans ces milieux militants, c’était même un sujet tabou."
                                            },
                                            {
                                                "example_id": "160e87b8-b612-4946-883c-f71226b6db67",
                                                "sense_id": "cf4c22c0-18c6-37b6-913c-b5c8066257f2",
                                                "text": "Il n’y a jamais eu autant de jobistes en Belgique. La conséquence d’un assouplissement de la législation ces dix dernières années face à la pénurie dans certains secteurs. Mais qui sont ces étudiants-travailleurs et pourquoi sacrifient-ils leur été, et de plus en plus l’année entière, à bosser ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
