        "fr-extract.jsonl": [
            {
                "entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
                "word": "immensément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                        "entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
                        "glosses": [
                            "D’une manière immense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a8cdfc-ddf3-4ce8-a132-15d84b61f2be",
                                "sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                                "text": "Il est immensément riche."
                            },
                            {
                                "example_id": "efbba3c0-91a1-40cd-b4ff-41f58017fce6",
                                "sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                                "text": "Il en a coûté immensément pour achever cet édifice."
                            },
                            {
                                "example_id": "e8483745-663c-4fd4-aca5-b4c8e23b9ec1",
                                "sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                                "text": "Entre ses berges immensément reculées, la rivière était devenue une grande chose mouvante, dont le glissement emplissait l’ombre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d465f51e-de08-472d-8926-80bd979e179a",
                        "source_entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
                        "source_sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                        "target_lang_word": "hugely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hugely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "774adf57-2839-309d-b7f5-557866bec153",
                                        "entry_id": "899445a1-3d1f-3ce1-ac85-5362feebf6b4",
                                        "glosses": [
                                            "Greatly; to a huge extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d8daded-76a7-4e53-9d0e-9f2297e74ed2",
                                                "sense_id": "774adf57-2839-309d-b7f5-557866bec153",
                                                "text": "This new movie is hugely inspired from the 1930s cowboy movies."
                                            },
                                            {
                                                "example_id": "a1253115-dcda-4922-ae09-bcbc8d5af402",
                                                "sense_id": "774adf57-2839-309d-b7f5-557866bec153",
                                                "text": "It became hugely successful."
                                            },
                                            {
                                                "example_id": "5a41cce1-c8a2-4a81-b404-5e212ce43f45",
                                                "sense_id": "774adf57-2839-309d-b7f5-557866bec153",
                                                "text": "She turned around, grinning hugely."
                                            },
                                            {
                                                "example_id": "c9c492bd-dcf9-4cbf-a36a-67472cc77c76",
                                                "sense_id": "774adf57-2839-309d-b7f5-557866bec153",
                                                "text": "But the row highlighted the fall from grace of the ethnically diverse women Sarkozy once promoted but later cast aside, who are now rebelling. The former young sports minister, Rama Yade, outspoken and hugely popular, has not only quit the government: she has left Sarkozy's party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33bdb62e-1228-435e-aafb-b74102dd0954",
                        "source_entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
                        "source_sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                        "target_lang_word": "immensely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immensely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                        "entry_id": "f0599c2e-414a-3c02-a7bb-95c23ddb8e57",
                                        "glosses": [
                                            "Greatly; hugely; extremely; vastly; to a great extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa08dbe-1a69-423a-b149-5f26818e4a14",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "I enjoyed the party immensely."
                                            },
                                            {
                                                "example_id": "b0dd134c-6a32-46e6-a5dd-5b5c3e32cf53",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "This question is immensely difficult."
                                            },
                                            {
                                                "example_id": "21a48fe3-7741-4033-9d95-fbf0a3618600",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "Then, too, he was always ready to constitute himself a hostile army or a band of marauding Indians on the shortest possible notice: in brief, a distinctly able man, with talents, so far as we could judge, immensely above the majority."
                                            },
                                            {
                                                "example_id": "bb1888cc-c08e-42ec-91f2-eb5a9d25285a",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\"[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8181fb9-fe00-4a97-b8d7-7f2c4ed34a8c",
                        "source_entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
                        "source_sense_id": "7b5ea415-4ee8-398f-8aef-0dc96a5f01d2",
                        "target_lang_word": "tremendously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tremendously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b201375-6196-3515-9696-545f417fb32a",
                                        "entry_id": "430e6c02-fcb3-31af-81e6-45642994bcde",
                                        "glosses": [
                                            "Greatly; enormously"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca279ca9-38ba-4287-93c7-a0fba47a2625",
                                                "sense_id": "9b201375-6196-3515-9696-545f417fb32a",
                                                "text": "I enjoyed the performance tremendously."
                                            },
                                            {
                                                "example_id": "c60c3079-4e73-4f47-a04e-86c97c336bfc",
                                                "sense_id": "9b201375-6196-3515-9696-545f417fb32a",
                                                "text": "The noise was tremendously loud."
                                            },
                                            {
                                                "example_id": "79fb1640-8c82-4656-b5ff-da68aa53bcb3",
                                                "sense_id": "9b201375-6196-3515-9696-545f417fb32a",
                                                "text": "[…] until the Wicked Witch dies you will not see your Uncle and Aunt again. Remember that the Witch is Wicked—tremendously Wicked—and ought to be killed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "025b389e-2f83-4162-bd04-d1725bf2314e",
                        "source_entry_id": "b9dfb61f-27a0-32d5-9581-3f1690b90c08",
