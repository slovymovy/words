                "senses": [
                    {
                        "sense_id": "e7f03a81-98db-3eac-95bb-cb96892779aa",
                        "entry_id": "5b7654ae-2f8a-3122-b713-fd0a5dacdfbe",
                        "glosses": [
                            "het geluid van een hond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7dc6e01-8e7b-47cb-8f53-853e0b48ef07",
                                "sense_id": "e7f03a81-98db-3eac-95bb-cb96892779aa",
                                "text": "Onze hond heeft een zware blaf, maar gelukkig is hij erg rustig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38d4ea13-97e4-4ec5-a84f-6edea0c178a0",
                        "source_entry_id": "5b7654ae-2f8a-3122-b713-fd0a5dacdfbe",
                        "source_sense_id": "e7f03a81-98db-3eac-95bb-cb96892779aa",
                        "source_sense_description": "het geluid van een hond",
                        "target_lang_word": "bark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d401c4-cb86-3a5d-bf92-3a9d7894112c",
                                        "entry_id": "7274243b-4ddb-3a7c-a9ed-f37106ece50f",
                                        "glosses": [
                                            "To make a short, loud, explosive noise with the vocal organs (said of animals, especially dogs)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d5a394b-6b3b-4b85-b995-5a789b3e0e07",
                                                "sense_id": "e3d401c4-cb86-3a5d-bf92-3a9d7894112c",
                                                "text": "The neighbour's dog is always barking."
                                            },
                                            {
                                                "example_id": "40578433-d8c8-44ba-b193-2060826b107a",
                                                "sense_id": "e3d401c4-cb86-3a5d-bf92-3a9d7894112c",
                                                "text": "The seal barked as the zookeeper threw fish into its enclosure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6367f8e1-2ddc-3f20-9942-8a46ccba4cb0",
                                        "entry_id": "7274243b-4ddb-3a7c-a9ed-f37106ece50f",
                                        "glosses": [
                                            "To make a clamor; to make importunate outcries."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34befb66-d468-4d46-9a90-fa50c178b27f",
                                                "sense_id": "6367f8e1-2ddc-3f20-9942-8a46ccba4cb0",
                                                "text": "And therefore they bark, and say the scripture maketh heretics."
                                            },
                                            {
                                                "example_id": "539676c5-2ab4-416b-9944-484d8b101167",
                                                "sense_id": "6367f8e1-2ddc-3f20-9942-8a46ccba4cb0",
                                                "text": "Where there is the barking of the belly, there no other commands will be heard, much less obeyed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9cfb2f-c6e4-35ae-a2c9-33c1e1923788",
                                        "entry_id": "7274243b-4ddb-3a7c-a9ed-f37106ece50f",
                                        "glosses": [
                                            "To speak sharply."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34de2d3a-bb44-411b-8ae1-c9821a7bf87f",
                                                "sense_id": "6d9cfb2f-c6e4-35ae-a2c9-33c1e1923788",
                                                "text": "The sergeant barked an order."
                                            },
                                            {
                                                "example_id": "dd9fd1c9-7433-4f4c-857c-9ea8591da658",
                                                "sense_id": "6d9cfb2f-c6e4-35ae-a2c9-33c1e1923788",
                                                "text": "Plainly he was prepared to bark out an interminable succession of charges against the Wanderer."
                                            },
                                            {
                                                "example_id": "3cf15de4-5fbb-4cad-a57e-f16ca6176849",
                                                "sense_id": "6d9cfb2f-c6e4-35ae-a2c9-33c1e1923788",
                                                "text": "Sudden anger rose in him. “What I’m looking for,” he barked, “is to be left in peace.” His voice trembled with a rage far bigger than her intrusion merited, the rage which shocked him whenever it coursed through his nervous system, like a flood."
                                            },
                                            {
                                                "example_id": "675cce23-a9ab-4f52-974c-759bcf8bf969",
                                                "sense_id": "6d9cfb2f-c6e4-35ae-a2c9-33c1e1923788",
                                                "text": "While McCarthy prowled the touchline barking orders, his opposite number watched on motionless and expressionless and, with 25 minutes to go, decided to throw on Nicolas Anelka for Kalou."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6de6a58-80de-3104-90ea-bab6ca17f3c0",
                                        "entry_id": "286b94d9-b893-3ecf-9d07-d18520450c50",
                                        "glosses": [
                                            "The short, loud, explosive sound uttered by a dog, a fox, and some other animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c0dfd5-b3b7-3982-9de9-782a31200ec0",
                                        "entry_id": "286b94d9-b893-3ecf-9d07-d18520450c50",
                                        "glosses": [
                                            "An abrupt loud vocal utterance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faaf1d9d-39cd-412f-aefc-38a641f0b049",
                                                "sense_id": "f9c0dfd5-b3b7-3982-9de9-782a31200ec0",
                                                "text": "Fox’s clumsy figure, negligently dressed in blue and buff, seemed unprepossessing; only his shaggy eyebrows added to the expression of his face; his voice would rise to a bark in excitement."
                                            },
                                            {
                                                "example_id": "7b178df6-3002-4f92-af2a-3ae6cb56e540",
                                                "sense_id": "f9c0dfd5-b3b7-3982-9de9-782a31200ec0",
                                                "text": "Long before Shap platform showed up around a corner and the two arms on the gradient post drooped in both directions at once, Duchess of Buccleuch's amiable throbbing purr at the stack [funnel, chimney] had become a fierce freight-engine bark, as she resolutely dragged at her enormous load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33c45d6-a496-3c6e-96dc-767ee02b624b",
                                        "entry_id": "286b94d9-b893-3ecf-9d07-d18520450c50",
                                        "glosses": [
                                            "The quick opening of the hi-hat cymbal as it is hit, followed by its timely closing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8696b2d9-1a4f-3c80-8e75-f545db278091",
                                        "entry_id": "a5734113-d2e8-30f5-bee6-1feb7d266d08",
                                        "glosses": [
                                            "The sound of a dog barking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21233b14-c89c-306d-b18e-3adb5a8716f9",
                                        "entry_id": "d182cec9-7a16-36e2-9240-87c7529a90e6",
                                        "glosses": [
                                            "The exterior covering of the trunk and branches of a tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c27040-b655-418e-964f-d45030369c49",
                                                "sense_id": "21233b14-c89c-306d-b18e-3adb5a8716f9",
                                                "text": "The hardships of bark-collecting in the primeval forests of South America are of the severest kind, and undergone only by the half-civilized Indians and people of mixed race, in the pay of speculators or companies located in the towns. Those who are engaged in the business, especially the collectors themselves, are called Cascarilleros or Cascadores, from the Spanish word Cascara, bark."
                                            },
                                            {
                                                "example_id": "fe1bfabb-17b7-4df4-b125-cc5925a97a09",
                                                "sense_id": "21233b14-c89c-306d-b18e-3adb5a8716f9",
                                                "text": "Moving about 70 miles per hour, it crashed through the sturdy old-growth trees, snapping their limbs and shredding bark from their trunks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49fa1546-9e1d-3248-aaf9-8b01882697af",
                                        "entry_id": "d182cec9-7a16-36e2-9240-87c7529a90e6",
                                        "glosses": [
                                            "Peruvian bark or Jesuit's bark, the bark of the cinchona from which quinine is produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84f58e71-f724-3e53-a323-52b3db8afcb9",
                                        "entry_id": "d182cec9-7a16-36e2-9240-87c7529a90e6",
                                        "glosses": [
                                            "Hard candy made in flat sheets, for instance out of chocolate, peanut butter, toffee or peppermint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63ae123d-5b39-340b-9099-bcf2567d0de1",
                                        "entry_id": "d182cec9-7a16-36e2-9240-87c7529a90e6",
                                        "glosses": [
                                            "The crust formed on barbecued meat that has had a rub applied to it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65174526-14e2-4766-96bb-448370f666ed",
                                                "sense_id": "63ae123d-5b39-340b-9099-bcf2567d0de1",
                                                "text": "This softens the meat further, but at some loss of crunch to the bark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d3d79e-bedc-3b67-a98b-ead2709d3af5",
                                        "entry_id": "d182cec9-7a16-36e2-9240-87c7529a90e6",
                                        "glosses": [
                                            "The envelopment or outer covering of anything."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef17383f-ef99-34ac-a241-a0fd694c648e",
                                        "entry_id": "26fb16fa-637c-3764-8dba-7be25c12b8a8",
                                        "glosses": [
                                            "To strip the bark from; to peel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd3325a-c4f9-462d-9634-3469c632280c",
                                                "sense_id": "ef17383f-ef99-34ac-a241-a0fd694c648e",
                                                "text": "Along the river freshly felled and barked trees told of the activity of beaver, and in slow current and in eddies the tops of their winter's food supply lay like submerged brush fences projecting above the surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88352046-73f9-3f5e-97a5-b0d0a16512ea",
                                        "entry_id": "26fb16fa-637c-3764-8dba-7be25c12b8a8",
                                        "glosses": [
                                            "To abrade or rub off any outer covering from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec955a9b-12eb-4e03-8b82-ef740cef5a10",
                                                "sense_id": "88352046-73f9-3f5e-97a5-b0d0a16512ea",
                                                "text": "to bark one’s heel"
                                            },
                                            {
                                                "example_id": "e0321f72-3905-466e-ac64-8588c8c28eae",
                                                "sense_id": "88352046-73f9-3f5e-97a5-b0d0a16512ea",
                                                "text": "Barcelona had been harried and hurried and stretched thin by the midway point in the second half. Tackles flew in. Toes were crushed, shins barked, ankles hacked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b607b314-3a55-3be2-9a8a-9c419702fa9c",
                                        "entry_id": "26fb16fa-637c-3764-8dba-7be25c12b8a8",
                                        "glosses": [
                                            "To girdle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214f99c9-9855-3897-9283-89bf4316d140",
                                        "entry_id": "26fb16fa-637c-3764-8dba-7be25c12b8a8",
                                        "glosses": [
                                            "To cover or inclose with bark, or as with bark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f8cf3d-d5be-41f9-b837-eab0517e74b4",
                                                "sense_id": "214f99c9-9855-3897-9283-89bf4316d140",
                                                "text": "to bark the roof of a hut"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "798cc4e1-e0cd-34a4-b5c2-842c5f382102",
                                        "entry_id": "4f3fffdd-9be1-3996-b4b7-9f182f2e6016",
                                        "glosses": [
                                            "A small sailing vessel, e.g. a pinnace or a fishing smack; a rowing boat or barge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a5120d6-3013-3e6a-8fe4-c28e0856cea7",
                                        "entry_id": "4f3fffdd-9be1-3996-b4b7-9f182f2e6016",
                                        "glosses": [
                                            "A sailing vessel or boat of any kind."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da15fe1-d9a0-49e6-80a9-686ffaf15e0b",
                                                "sense_id": "6a5120d6-3013-3e6a-8fe4-c28e0856cea7",
                                                "text": "It is the star to every wandering bark"
                                            },
                                            {
                                                "example_id": "3b6c0417-a751-4c19-a6cb-6021beca03ab",
                                                "sense_id": "6a5120d6-3013-3e6a-8fe4-c28e0856cea7",
                                                "text": "We know not where we go, or what sweet dream\nMay pilot us through caverns strange and fair\nOf far and pathless passion, while the stream\nOf life our bark doth on its whirlpools bear,\nSpreading swift wings as sails to the dim air; […]"
                                            },
                                            {
                                                "example_id": "e597bcae-9353-4d60-bf13-b4477bc025aa",
                                                "sense_id": "6a5120d6-3013-3e6a-8fe4-c28e0856cea7",
                                                "text": "Whether my bark went down at sea, / Whether she met with gales, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e695df3-aba8-3d60-9629-6703551e19ee",
                                        "entry_id": "4f3fffdd-9be1-3996-b4b7-9f182f2e6016",
                                        "glosses": [
                                            "A vessel, typically with three (or more) masts, with the foremasts (or fore- and mainmasts) square-rigged, and mizzenmast schooner-rigged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd05366b-8429-4b42-b5ac-40821d90c388",
                                                "sense_id": "0e695df3-aba8-3d60-9629-6703551e19ee",
                                                "text": "Europeans would cross the ocean in large barks built for deck space and large holds."
                                            }
                                        ]
                                    }
                                ]
                            },
