                    {
                        "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                        "entry_id": "293eae38-1ea7-3c9b-a948-2629bcfe9711",
                        "glosses": [
                            "Alternative form of line (“flax, linen”)."
                        ],
                        "tags": [
                            "Ireland",
                            "Northern-England",
                            "Scotland",
                            "alt-of",
                            "alternative",
                            "especially",
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "be2ea026-8478-4dfe-9ec9-da6d02d62c36",
                                "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                                "text": "a lin apron, lin-break, lin-brake, a lin cap, lin-clout, lin-garn/lin-yarn, lin-man, lin-weaver/lin-webster, lin-wheel"
                            },
                            {
                                "example_id": "8a71f60c-eff6-4dbe-a550-3e00668080bb",
                                "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                                "text": "[…] to Sowerby-bridge, about twenty-four measured miles, wheel carriages would go in one day; and on that account they concluded that the manufacture of that place, Warrington, &c. would be much readier and cheaper supplied with lin-yarn, flax, &c. from the east, […]\n1641.—14 yards of femble cloth, 12s. ; 8 yards of linen, 6s. 8d. ; 20 yards of harden, 10s. ; 5 linen sheets, 1l. ; 7 linen pillow bears, 8s. ; 2 femble sheets and a line hard sheet, 10s. ; 3 linen towels, 4s. ; 6 lin curtains and a vallance, 12s. ; […]"
                            },
                            {
                                "example_id": "580953bd-7022-49e9-94a6-ac15c7e49fc7",
                                "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                                "text": "A yerd a gooid lin check."
                            },
                            {
                                "example_id": "b1d288ab-4341-4631-bae0-0596d312d375",
                                "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                                "text": "Paddeys wi' their feyne lin' ware."
                            },
                            {
                                "example_id": "3aee6f75-6757-4447-9adb-2e737617394b",
                                "sense_id": "d7b92b13-ba17-3b01-8fd1-aca7704f9eb6",
                                "text": "Hoo wur stonnin' i' th' front of a weshin'-mug, wi' a lin brat afore her."
                            }
                        ]
                    }
                ],
