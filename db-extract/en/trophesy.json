                        "glosses": [
                            "Malnourishment due to a disorder of the nervous system."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "51eb25d2-06bd-4265-8555-03ef8b97349e",
                                "sense_id": "f41216ce-ba30-3261-ad03-24c11feb139c",
                                "text": "Katabolic tendencies, depending upon deficient nutrition (trophesy, physiological disintegration), determine predominant maleness in the progeny."
                            },
                            {
                                "example_id": "7a398b98-656c-4c8f-b9a1-b78f7836ed6e",
                                "sense_id": "f41216ce-ba30-3261-ad03-24c11feb139c",
                                "text": "He points out that the regional sympathy which characterizes trophesies is well marked, and that, as regards baldness, it extends from two points, the forehead and the vertex, ending at a line which, \"carried round the head, would touch the occipital ridge posteriorly, and the eyebrows anteriorly."
                            },
                            {
                                "example_id": "6b133470-f5f5-47d8-885e-f3d41de05f06",
                                "sense_id": "f41216ce-ba30-3261-ad03-24c11feb139c",
                                "text": "The results here presented may prove an important contribution to the available information about the pathogenesis of acute mountain disease; they also suggest some risk of corneal trophesy in certain ophthalmic conditions or when using particular kinds of contact lenses."
                            }
                        ]
                    }
