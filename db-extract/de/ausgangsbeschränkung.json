                "senses": [
                    {
                        "sense_id": "31457ef7-c2dc-3ef3-87a3-5a146e33e1c4",
                        "entry_id": "f2b82a25-0da6-3f27-917e-75c0233c18f2",
                        "glosses": [
                            "Regel, die eine freie Bewegung in der Öffentlichkeit begrenzt/einschränkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acfbb0b-42ef-4039-b8f5-b56d8ae02e24",
                                "sense_id": "31457ef7-c2dc-3ef3-87a3-5a146e33e1c4",
                                "text": "„Im Saarland herrschen im Kampf gegen das Coronavirus weitreichende Einschränkungen im öffentlichen Leben, die so genannten Ausgangsbeschränkungen. Was noch erlaubt ist und was nicht, haben wir hier zusammengestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3362d59c-d4e7-31c0-b20d-70822e356a06",
                        "entry_id": "f2b82a25-0da6-3f27-917e-75c0233c18f2",
                        "glosses": [
                            "Disziplinarstrafe, die die freie Beweglichkeit einschränkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eeac25f-745b-4edb-af33-120523f3efdd",
                                "sense_id": "3362d59c-d4e7-31c0-b20d-70822e356a06",
                                "text": "„Als weitere einfache Disziplinarmaßnahme kann gegen den Soldaten eine Ausgangsbeschränkung verhängt werden, § 25 WDO.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
