                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa51678d-fd44-3dfe-8899-1ae8a2eed50a",
                                        "entry_id": "c0383158-09ef-380c-b909-aade4e370063",
                                        "glosses": [
                                            "In an immediate manner; instantly or without delay."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072154af-ef37-429c-a811-1489a25589f6",
                                                "sense_id": "aa51678d-fd44-3dfe-8899-1ae8a2eed50a",
                                                "text": "I hope we can begin immediately."
                                            },
                                            {
                                                "example_id": "4ee9c242-902a-4096-856a-29851d18cf4b",
                                                "sense_id": "aa51678d-fd44-3dfe-8899-1ae8a2eed50a",
                                                "text": "His unruly hair was slicked down with water, and as Jessamy introduced him to Miss Brindle his face assumed a cherubic innocence which would immediately have aroused the suspicions of anyone who knew him."
                                            },
                                            {
                                                "example_id": "2c27d2c4-7677-43ce-af04-d3b5c5b1ef7e",
                                                "sense_id": "aa51678d-fd44-3dfe-8899-1ae8a2eed50a",
                                                "text": "Spain failed to move through the gears despite exerting control for lengthy spells and a measure of perspective must be applied immediately to the outcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab4ad48-7b36-3081-b94c-cfa5b6cf387b",
                                        "entry_id": "c0383158-09ef-380c-b909-aade4e370063",
                                        "glosses": [
                                            "Without any intervening time or space."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dbe8eec-edb3-435d-b6c3-ba52fbd5ef4c",
                                                "sense_id": "0ab4ad48-7b36-3081-b94c-cfa5b6cf387b",
                                                "text": "A tri-tone chime whistle, operated from the cab by a flexible cable passing down the right hand handrail, is mounted on the top of the smokebox immediately behind the chimney."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immediately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa30bef8-a52c-36ed-8738-3eb403842b13",
                                        "entry_id": "394e9533-2418-3746-8d6e-5f33dedaf384",
                                        "glosses": [
                                            "As soon as, the moment that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14122b5a-785b-4128-b84e-2b0c692d2a16",
                                                "sense_id": "fa30bef8-a52c-36ed-8738-3eb403842b13",
                                                "text": "Immediately he saw the firm, he realised what he could do."
                                            },
                                            {
                                                "example_id": "6fdb1eb4-3153-4c72-8f45-cf9bd3838f73",
                                                "sense_id": "fa30bef8-a52c-36ed-8738-3eb403842b13",
                                                "text": "Immediately you transact on the Redemption and stop the impertinence of debate, God gives you the witness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94e179c1-0955-47f9-b8f4-6aad429a0f91",
                        "source_entry_id": "bd2840ac-54cf-375f-8e39-090262a5185d",
                        "source_sense_id": "e85131f0-3723-32fa-a2ea-2ed98fe6bf9c",
