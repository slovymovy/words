                "senses": [
                    {
                        "sense_id": "06329f79-b5e5-30d5-8c9d-119d5a83600c",
                        "entry_id": "37086d8e-b5cb-3772-aa50-355cd5f75e4c",
                        "glosses": [
                            "Wearing a gown."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4218440-1625-482d-a4fb-1bb223d6ac90",
                                "sense_id": "06329f79-b5e5-30d5-8c9d-119d5a83600c",
                                "text": "Deliberately, almost ‘augustly,’ the gowned and mortar-boarded figures followed one another through the great red turnstile and filed into the chamber beyond."
                            },
                            {
                                "example_id": "94dce086-3df9-4ba5-a1c6-7f15b79078ba",
                                "sense_id": "06329f79-b5e5-30d5-8c9d-119d5a83600c",
                                "text": "The economic and political dependence of this African neo-colonial bourgeoisie is reflected in its culture of apemanship and parrotry conforced on a restive population through police boots, barbed wire, a gowned clergy and judiciary […]."
                            },
                            {
                                "example_id": "3c33cebd-2619-4505-8b5a-d66c02a3a984",
                                "sense_id": "06329f79-b5e5-30d5-8c9d-119d5a83600c",
                                "text": "Pirates, buccaneers, the gowned ladies of the ancient pastoral – all the traditional subjects of imperial history – are among the images that take shape."
                            }
                        ]
                    }
