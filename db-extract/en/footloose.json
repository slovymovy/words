                        "entry_id": "200d192a-1238-31ed-9037-0d97629c3585",
                        "glosses": [
                            "Tending to travel or do as one pleases; readily without many commitments or responsibility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f71c12-61ed-46d0-ab4a-56b1d95788fd",
                                "sense_id": "103d3c1b-5af1-39b3-b192-36d5a1f2c5bd",
                                "text": "He was footloose in his youth."
                            },
                            {
                                "example_id": "1953cec5-3635-41b4-b107-7428b501d871",
                                "sense_id": "103d3c1b-5af1-39b3-b192-36d5a1f2c5bd",
                                "text": "Because we often imagine that immigrants are constantly on the move, footloose, able to change course at any moment."
                            },
                            {
                                "example_id": "b4fdb2d2-0810-4453-9d85-90e08c5f2683",
                                "sense_id": "103d3c1b-5af1-39b3-b192-36d5a1f2c5bd",
                                "text": "[…] They are footloose but also desperate, squeezed by rising inequality and a frayed safety net."
                            }
                        ]
                    },
