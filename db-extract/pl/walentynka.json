                            {
                                "target_word": "valentine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60b756b0-87fc-3366-9795-84990870238c",
                                        "entry_id": "48893043-ce73-3dc6-909d-0082d1511fb1",
                                        "glosses": [
                                            "An expression of affection, especially romantic affection, usually in the form of greeting card, gift, or message given the object of one's affection, especially on February 14th."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df6a23d-f81f-4e4a-b748-dc91994df40f",
                                                "sense_id": "60b756b0-87fc-3366-9795-84990870238c",
                                                "text": "Such an extravagant valentine was unexpected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e524ef7b-3fca-367f-affb-3c72997cec2f",
                                        "entry_id": "48893043-ce73-3dc6-909d-0082d1511fb1",
                                        "glosses": [
                                            "A person to whom a valentine is given or from whom it is received, especially on February 14th."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f4bab7-2825-491a-a07d-7c8a982e5881",
                                                "sense_id": "e524ef7b-3fca-367f-affb-3c72997cec2f",
                                                "text": "Won't you be my valentine?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4925868-d073-46d2-a0e9-4fbc4837c628",
                        "source_entry_id": "66991027-b0af-3ce6-8c65-207e529db642",
                        "source_sense_id": "702d861e-6b2d-33c2-b634-e44810779ae6",
                        "target_lang_word": "валентинка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "валентинка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc9fd32-d0b5-321c-80ee-9cff636fbaf6",
                                        "entry_id": "5e5c2949-ead0-3bf8-b0d3-1c1294894482",
                                        "glosses": [
                                            "разг. открытка любовного содержания, которую дарят в День святого Валентина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540c84a7-de5e-41bf-9ecf-e3c50934b8ee",
                                                "sense_id": "8fc9fd32-d0b5-321c-80ee-9cff636fbaf6",
                                                "text": "На Западе день святого Валентина (14 февраля) давно перестал быть церковным праздником. В этот день влюблённые пишут друг другу романтические послания на открытках, сделанных в форме сердца. Эти письма называются валентинками."
                                            },
                                            {
                                                "example_id": "b3e45803-27ee-4eae-9654-3add10a489d8",
                                                "sense_id": "8fc9fd32-d0b5-321c-80ee-9cff636fbaf6",
                                                "text": "Символом Дня святого Валентина стала фиалка. Этот цветок считался талисманом влюблённых. А «валентинки» — красочные открытки с изображением влюблённой парочки — присылали с непременной надписью: «I love you»."
                                            },
                                            {
                                                "example_id": "49fee253-3cde-4aec-a35d-dc9c2d1618d2",
                                                "sense_id": "8fc9fd32-d0b5-321c-80ee-9cff636fbaf6",
                                                "text": "О том, как праздновать день святого Валентина, или День всех влюблённых, согласно традициям, пожалуй, и в России знает не каждый. Ведь праздник-то католический. Тем не менее, и в России этот день иногда отмечают. Школьники и студенты дарят друг другу небольшие романтические подарки, а чаще «валентинки» — открытки или письма с признаниями в любви."
                                            },
                                            {
                                                "example_id": "76d46752-72d1-4c3f-b3a5-1589733c1188",
                                                "sense_id": "8fc9fd32-d0b5-321c-80ee-9cff636fbaf6",
                                                "text": "На четырнадцатое февраля получил от Машки огромную валентинку с признанием в любви .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
