                    "frequency": "Middle",
                    "semantic_group_id": "vullen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De havenkraan <w>laadde</w> het scheepsruim <w>vol</w> met zand voor het transport.",
                            "target_lang_translations": {
                                "en": "The harbor crane <w>loaded up</w> the ship's hold with sand for transport."
                            }
                        },
                        {
                            "text": "We moeten de vrachtwagen <w>volladen</w> voordat we aan de lange reis beginnen.",
                            "target_lang_translations": {
                                "en": "We need to <w>load up</w> the truck before we start the long journey."
                            }
                        }
                    ],
