        "fr-extract.jsonl": [
            {
                "entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
                "word": "gérontocratie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb640a5b-3c22-4f51-81f0-69de52053fd7",
                        "entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
                        "tags": [
                            "plural"
                        ],
                        "form": "gérontocraties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b1812db-a951-37f8-9c2b-313d62e1c3a7",
                        "entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
                        "glosses": [
                            "Gouvernement, domination des vieillards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81dc4d28-469a-4942-8916-36401fa7cac1",
                                "sense_id": "7b1812db-a951-37f8-9c2b-313d62e1c3a7",
                                "text": "Démocratie de nom, gérontocratie de fait. Comme en 1793, 1914 possédait, en puissance, ses jeunes généraux. Que leur manquait-il pour apparaître et se réaliser ? Une Révolution…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24caab92-6495-4007-a0c1-12cb488a80a9",
                        "source_entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
                        "source_sense_id": "7b1812db-a951-37f8-9c2b-313d62e1c3a7",
                        "target_lang_word": "Gerontokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerontokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71167d4-df19-33d8-8886-eea64890b195",
                                        "entry_id": "89003ba3-8097-33cc-8a63-a51924d73e21",
                                        "glosses": [
                                            "Herrschaftsform eines sozialen und politischen Systems, bei dem die Entscheidungsgewalt von älteren, erfahrenen Personen ausgeübt wird"
                                        ],
                                        "tags": [
                                            "Ethnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd48b610-01c3-4bfa-9700-07b90436ad62",
                                                "sense_id": "e71167d4-df19-33d8-8886-eea64890b195",
                                                "text": "„Haben sich Adelsherrschaften etabliert, perpetuiert die Gerontokratie in geschwächter Form ohne allerdings zu erlöschen.“"
                                            },
                                            {
                                                "example_id": "842bd79b-4cea-4df1-859f-d2c64308ee45",
                                                "sense_id": "e71167d4-df19-33d8-8886-eea64890b195",
                                                "text": "„Die wenigen älteren Repräsentanten mittelalterlicher Stände wurden demnach auch respektiert und aufgrund der Möglichkeit der Wissenstradierung geschätzt, hatten aber häufig keine wirkliche Macht, was jedoch nach Region und Berufsgruppe zu differenzieren ist, denn natürlich waren beispielsweise die Serenissima oder der Vatikan «ausgesprochene Gerontokratien» (Reinhard 2004, 177).“"
                                            },
                                            {
                                                "example_id": "4d65c3e3-fcfa-49a0-8022-a40827451d31",
                                                "sense_id": "e71167d4-df19-33d8-8886-eea64890b195",
                                                "text": "„Nun mag es schön sein, Hinweise darauf gewonnen zu haben, daß die Gesellschaft der Späthallstattzeit in Württemberg mit einer homerischen Gerontokratie vergleichbar ist (BURMEISTER 2000:210), doch verrät uns eine solche Beschreibung noch nicht, wie soziale Beziehungen zwischen Bevölkerungsgruppen, die nicht zur Gruppe der Gerontokraten gehörten, funktioniert haben könnten.“"
                                            },
                                            {
                                                "example_id": "1be19f21-d5e0-4a47-9bd2-0d1d47e64746",
                                                "sense_id": "e71167d4-df19-33d8-8886-eea64890b195",
                                                "text": "„Andererseits erwähnte de Beauvoir auch Kulturen mit Gerontokratien, in denen die Alten politisch und ökonomisch den Ton angaben:[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbf9ff63-03a7-3153-a11a-daff5e289320",
                                        "entry_id": "89003ba3-8097-33cc-8a63-a51924d73e21",
                                        "glosses": [
                                            "Herrschaft einer überalterten, privilegierten Führungsschicht, die durch Erstarrung und politische Unbeweglichkeit gekennzeichnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6ae892-f329-4804-9ab1-7f4c6a84ef51",
                                                "sense_id": "bbf9ff63-03a7-3153-a11a-daff5e289320",
                                                "text": "„Neuerdings sieht sich die saudische Gerontokratie allerdings wachsendem Widerstand konfrontiert.“"
                                            },
                                            {
                                                "example_id": "eba354c8-3c84-402b-a3e1-6dd9f8fbefe9",
                                                "sense_id": "bbf9ff63-03a7-3153-a11a-daff5e289320",
                                                "text": "„In mancher Hinsicht erinnert das an die Gerontokratien des kommunistischen Osteuropas.“"
                                            },
                                            {
                                                "example_id": "d1ec934c-4486-458a-9276-057236f2ce71",
                                                "sense_id": "bbf9ff63-03a7-3153-a11a-daff5e289320",
                                                "text": "„In Ländern wie Algerien, Tunesien, Libyen und Ägypten vermengen sich Demografie, Gerontokratie und Melancholie zu einem gefährlichen Gebräu.“"
                                            },
                                            {
                                                "example_id": "4155dc85-3fbb-4981-9580-6f89062f0b0f",
                                                "sense_id": "bbf9ff63-03a7-3153-a11a-daff5e289320",
                                                "text": "„Ausgerechnet der Jungstar, der angetreten ist, die italienische Gerontokratie zu beenden und die alte politische Kaste ‚zu verschrotten‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5642a6d5-7c01-43c1-a8a6-0caeb5cbd9b5",
                        "source_entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
                        "source_sense_id": "7b1812db-a951-37f8-9c2b-313d62e1c3a7",
                        "target_lang_word": "gerontocracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gerontocracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                        "entry_id": "168bbcaf-8f9f-34ac-9d0c-6a2805652a26",
                                        "glosses": [
                                            "Government by elders; government by elderly rulers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231e1df9-fa8f-4dbd-ae1d-242d84150943",
                                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                                "text": "Near-synonym: senilocracy"
                                            },
                                            {
                                                "example_id": "5b9b2d95-3d23-4481-9880-3809ab2952a9",
                                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                                "text": "It would come as no surprise to find that optimum science policy is apt to be developed neither by gerontocracy nor by juvenocracy but, like the community of scientists itself, by age-diversified meritocracy."
                                            },
                                            {
                                                "example_id": "6c6cb889-a78f-4e2c-aff5-2b960c681cf5",
                                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                                "text": "But in his 1996 novel, Holy Fire, [Bruce] Sterling imagines a rather different future: a world ruled by an all-powerful gerontocracy, which appropriates most of the world's wealth to pay for ever more costly life-extension techniques."
                                            },
                                            {
                                                "example_id": "aa6879a4-0d17-4b4d-8f29-5a444640b02b",
                                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                                "text": "Young people who are close to writing off the Democratic Party as a dinosaur, as a gerontocracy of prudish abuelos who gave birth by immaculate conception, may be in for a pleasant surprise."
                                            },
                                            {
                                                "example_id": "0e75ae05-7b6c-4571-a405-0e00da8921be",
                                                "sense_id": "8c3a7632-c591-34ff-a5ec-e24024b560b8",
                                                "text": "He [Koizumi] was what would pass for a political maverick among Japan's faceless gray gerontocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53cf0c7d-0560-468c-af83-ab90566d5c4f",
                        "source_entry_id": "3ef3df1c-db25-3b97-b335-48d24feb9567",
