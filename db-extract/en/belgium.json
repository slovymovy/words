                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "België",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2a348b8f-3eae-3fde-8127-731fbe01b2f0",
                                        "entry_id": "0e3b44e9-426c-339f-ac15-f4284c32ea8c",
                                        "glosses": [
                                            "een land in West-Europa met grenzen met Nederland, Frankrijk, Duitsland en Luxemburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a97f38f-e761-4948-99ad-c81139620615",
                                                "sense_id": "2a348b8f-3eae-3fde-8127-731fbe01b2f0",
                                                "text": "België wordt ook wel eens het hart van Europa genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "232a81ed-25d0-4048-a591-c91dc763e678",
                        "source_entry_id": "aa3819d4-ecd0-37bf-aa13-7b5a6848d0f4",
                        "source_sense_id": "39eda875-8ea7-3a0a-8313-7b16a37ce16e",
                        "source_sense_description": "country in Europe",
                        "target_lang_word": "Belgique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belgique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                        "entry_id": "45cb299b-243d-35b0-b281-43ded6e5dee7",
                                        "glosses": [
                                            "Pays de l’Europe de l’Ouest, entouré des Pays-Bas, de l’Allemagne, du Luxembourg, de la France et de la mer du Nord, dont la capitale est Bruxelles."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa1be1b-0e24-4fd3-8c2d-4cedd0447aa2",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "À peu de distance de Dinant, en Belgique, dans la vallée de la Lesse, il existe un assez grand nombre de ces grottes qui ont dû servir d’habitation ou de refuge à nos ancêtres."
                                            },
                                            {
                                                "example_id": "242adb3c-3164-4d6f-9b4c-7ae0c8c7e714",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "Quelques polémiques se sont élevées au sujet de l’existence d'une race de chèvre aborigène en Belgique."
                                            },
                                            {
                                                "example_id": "200b0e74-6665-4b92-b7ed-3fa2f9a00451",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "Il atteint le fossé qui délimite la Belgique et la France et, en dépit des feuilles pourries qui l’entravent, il le suit à toute allure."
                                            },
                                            {
                                                "example_id": "97ab6be3-8113-4be6-b3af-74710c5255a6",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "Le massif ardennais ne représente en France que 20 % d’un massif beaucoup plus vaste qui s’étend pour sa part la plus importante en Belgique et au Luxembourg."
                                            },
                                            {
                                                "example_id": "b901148a-bf56-420a-9ceb-ef410f9c28a9",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "La Belgique, créée en 1830, n’existait pas encore à l’époque comme royaume indépendant."
                                            },
                                            {
                                                "example_id": "df71de73-46db-43dd-b61d-29181f031716",
                                                "sense_id": "9ef29e7c-a6dc-3f3f-80f2-1793f543d57a",
                                                "text": "En Belgique, les questions linguistiques sont une source de tensions parfois violentes, et tout est fait pour ne pas froisser les deux communautés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302505c2-a50a-4a3d-81c6-55bc398ab54f",
                        "source_entry_id": "aa3819d4-ecd0-37bf-aa13-7b5a6848d0f4",
                        "source_sense_id": "39eda875-8ea7-3a0a-8313-7b16a37ce16e",
