    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c9528030-bcc7-30dd-8daf-193096929b38",
                    "sense_definition": "Немного, в незначительной степени; слегка.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кинозвёзды на фотографии улыбались, <w>чуть</w> разомкнув губы.",
                            "target_lang_translations": {
                                "en": "The movie stars in the photo were smiling, <w>slightly</w> parting their lips.",
                                "de": "Die Filmstars auf dem Foto lächelten und hatten die Lippen <w>leicht</w> geöffnet.",
                                "zh": "照片里的电影明星微笑着，嘴唇<w>稍微</w>张开着。"
                            }
                        },
                        {
                            "text": "Суп показался мне <w>чуть</w> недосоленным, но всё равно вкусным.",
                            "target_lang_translations": {
                                "en": "The soup seemed <w>a little</w> under-salted to me, but still tasty.",
                                "de": "Die Suppe schien mir <w>ein bisschen</w> ungesalzen zu sein, war aber trotzdem lecker.",
                                "zh": "我觉得汤<w>稍微</w>淡了点，但依然很好喝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "немного",
                        "слегка́",
                        "чу́точку",
                        "ма́ленько",
                        "чуто́к",
                        "капельку"
                    ],
                    "antonyms": [
                        "намного"
                    ],
                    "common_phrases": [
                        "чуть больше",
                        "чуть меньше",
                        "чуть позже",
                        "чуть лучше"
                    ],
                    "target_lang_definitions": {
                        "en": "A small amount, to an insignificant degree; slightly.",
                        "de": "Ein wenig, in geringem Maße; leicht.",
                        "zh": "表示程度轻微，稍微。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "degree"
                            },
                            {
                                "target_lang_word": "slightly",
                                "target_lang_sense_clarification": "degree"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "degree"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ein bisschen",
                                "target_lang_sense_clarification": "Gradangabe"
                            },
                            {
                                "target_lang_word": "leicht",
                                "target_lang_sense_clarification": "Gradangabe"
                            },
                            {
                                "target_lang_word": "etwas",
                                "target_lang_sense_clarification": "Gradangabe"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "表示程度轻微"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "表示少量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a9840b0-b775-3aa8-a643-9088f0f6cbc7",
                    "sense_definition": "Почти; указывает на то, что действие едва не совершилось (обычно с частицей «не»).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>чуть</w> не умер от страха, когда увидел в лесу медведя.",
                            "target_lang_translations": {
                                "en": "He <w>almost</w> died of fright when he saw a bear in the forest.",
                                "de": "Er wäre <w>fast</w> vor Angst gestorben, als er im Wald einen Bären sah.",
                                "zh": "他在森林里看到熊时，<w>差点</w>吓死。"
                            }
                        },
                        {
                            "text": "Мы так спешили на вокзал, что <w>чуть</w> не забыли билеты дома.",
                            "target_lang_translations": {
                                "en": "We were rushing to the station so much that we <w>nearly</w> forgot the tickets at home.",
                                "de": "Wir hatten es so eilig zum Bahnhof, dass wir die Fahrkarten <w>beinahe</w> zu Hause vergessen hätten.",
                                "zh": "我们赶往车站太匆忙，<w>差点</w>把票忘在家里了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "чуть не",
                        "чуть ли не",
                        "чуть было не"
                    ],
                    "target_lang_definitions": {
                        "en": "Almost; indicates that an action nearly happened (usually with the particle 'не').",
                        "de": "Fast; drückt aus, dass eine Handlung beinahe stattgefunden hätte (meistens mit der Partikel 'не').",
                        "zh": "表示几乎，差一点就发生了（通常与“没”或“没有”连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "proximity to action"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "proximity to action"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "Beinahe-Ereignis"
                            },
                            {
                                "target_lang_word": "beinahe",
                                "target_lang_sense_clarification": "Beinahe-Ereignis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差点",
                                "target_lang_sense_clarification": "表示几乎发生"
                            },
                            {
                                "target_lang_word": "几乎",
                                "target_lang_sense_clarification": "表示接近"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5013199f-b39b-3b79-b250-cdf9b0d4e24b",
                    "sense_definition": "С трудом, едва; очень слабо или еле заметно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В полной тишине был <w>чуть</w> слышен шум дождя за окном.",
                            "target_lang_translations": {
                                "en": "In the complete silence, the sound of rain outside the window was <w>barely</w> audible.",
                                "de": "In der völligen Stille war das Geräusch des Regens vor dem Fenster <w>kaum</w> zu hören.",
                                "zh": "在寂静中，窗外的雨声<w>隐约</w>可闻。"
                            }
                        },
                        {
                            "text": "Бабушка шла очень медленно и <w>чуть</w> переставляла больные ноги.",
                            "target_lang_translations": {
                                "en": "Grandma was walking very slowly and <w>hardly</w> moving her sore legs.",
                                "de": "Die Oma ging sehr langsam und bewegte ihre schmerzenden Beine nur <w>mühsam</w> vorwärts.",
                                "zh": "奶奶走得很慢，<w>勉强</w>挪动着病痛的双腿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "едва́",
                        "е́ле",
                        "с трудом",
                        "насилу",
                        "е́ле-е́ле",
                        "едва́-едва́"
                    ],
                    "common_phrases": [
                        "чуть слышно",
                        "чуть живой",
                        "чуть дыша"
                    ],
                    "target_lang_definitions": {
                        "en": "With difficulty, barely; very weakly or scarcely noticeably.",
                        "de": "Mit Mühe, kaum; sehr schwach oder kaum wahrnehmbar.",
                        "zh": "表示勉强、微弱或难以察觉。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "barely",
                                "target_lang_sense_clarification": "with difficulty or faintly"
                            },
                            {
                                "target_lang_word": "hardly",
                                "target_lang_sense_clarification": "scarcely"
                            },
                            {
                                "target_lang_word": "faintly",
                                "target_lang_sense_clarification": "perceptibility"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kaum",
                                "target_lang_sense_clarification": "mit Mühe oder schwach wahrnehmbar"
                            },
                            {
                                "target_lang_word": "schwach",
                                "target_lang_sense_clarification": "Wahrnehmbarkeit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勉强",
                                "target_lang_sense_clarification": "表示困难"
                            },
                            {
                                "target_lang_word": "隐约",
                                "target_lang_sense_clarification": "表示微弱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "9583b20c-c723-30d3-9ba8-efc06c1343d8",
                    "sense_definition": "Как только; в тот самый момент, когда.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Чуть</w> солнце взошло, рыбаки уже сидели на берегу реки.",
                            "target_lang_translations": {
                                "en": "<w>As soon as</w> the sun rose, the fishermen were already sitting on the riverbank.",
                                "de": "<w>Sobald</w> die Sonne aufgegangen war, saßen die Fischer schon am Flussufer.",
                                "zh": "<w>一</w>出太阳，渔夫们就已经坐在河岸边了。"
                            }
                        },
                        {
                            "text": "<w>Чуть</w> коснувшись подушки, уставший путник сразу же крепко уснул.",
                            "target_lang_translations": {
                                "en": "<w>The moment</w> he touched the pillow, the tired traveler immediately fell fast asleep.",
                                "de": "<w>Kaum</w> hatte der müde Wanderer das Kissen berührt, schlief er auch schon tief und fest ein.",
                                "zh": "疲惫的旅人<w>一</w>碰到枕头，立刻就睡熟了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как только",
                        "лишь только",
                        "едва́",
                        "едва только"
                    ],
                    "common_phrases": [
                        "чуть свет",
                        "чуть что"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in spoken or expressive language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "As soon as; at the very moment when.",
                        "de": "Sobald; in dem Moment, als.",
                        "zh": "表示一……就……，在某一时刻发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as soon as",
                                "target_lang_sense_clarification": "time conjunction"
                            },
                            {
                                "target_lang_word": "the moment",
                                "target_lang_sense_clarification": "time conjunction"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sobald",
                                "target_lang_sense_clarification": "zeitliche Konjunktion"
                            },
                            {
                                "target_lang_word": "kaum dass",
                                "target_lang_sense_clarification": "zeitliche Konjunktion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一",
                                "target_lang_sense_clarification": "表示时间紧接"
                            },
                            {
                                "target_lang_word": "刚",
                                "target_lang_sense_clarification": "表示动作刚发生"
                            }
                        ]
                    }
                }
            ]
        }
    ]
