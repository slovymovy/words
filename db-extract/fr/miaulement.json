        "fr-extract.jsonl": [
            {
                "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                "word": "miaulement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71098562-c890-43d9-a326-efabd5f48317",
                        "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                        "tags": [
                            "plural"
                        ],
                        "form": "miaulements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                        "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                        "glosses": [
                            "Cri du chat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca1bdfe-ffc4-410a-b19b-b8527007005c",
                                "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                                "text": "À quoi pouvait-il s’attendre, si ce n’est […] à voir sa sérénade, comme on l’appelle, aussi mal reçue que le miaulement d’un chat dans la gouttière ?"
                            },
                            {
                                "example_id": "b205f768-947c-4243-b928-dab7ced2964d",
                                "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                                "text": "Soudain, d’un seul élan, cela se précipita sur lui, avec un miaulement plaintif et la queue droite. C’était un jeune chat, menu et décharné, qui frottait sa tête contre les jambes de Bert, en ronronnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                        "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                        "glosses": [
                            "Bruit rappelant ce cri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c0f313-5176-462e-8570-46af2435fee8",
                                "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                                "text": "[…] la brise apporte les parfums du Généralife, énorme touffe de lauriers-roses épanouie au front de la colline prochaine, et le miaulement plaintif des paons qui se promènent sur les murs démantelés."
                            },
                            {
                                "example_id": "461057b9-84cd-4564-8d28-2e0a27ddb223",
                                "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                                "text": "Celui-là, il en a de la chance, dit-elle d'un air entendu, et par une suite d'onomatopées qui secouèrent son visage de tics et le rendirent simiesque, elle prétendit reproduire le miaulement de pneus qui venait à peine de s’estomper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fceb7b4-1527-435d-a6d9-04e078d75731",
                        "source_entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                        "source_sense_description": "Cri du chat",
                        "target_lang_word": "Miauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c88b50e-8178-3930-bc5b-abad6b2b1b25",
                                        "entry_id": "57b86f91-3e5d-3894-ab2e-3dfe7acf66e8",
                                        "glosses": [
                                            "Lautäußerung einer Katze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d88706d-d9ed-4878-9b90-047709938eac",
                                                "sense_id": "4c88b50e-8178-3930-bc5b-abad6b2b1b25",
                                                "text": "„Das hat offenbar funktioniert, denn Eiríkur kehrt mit zwei Koffern zurück, und der einäugige Kater empfängt ihn mit seinem Miauen und seiner aussichtslosen Liebe zu Hühnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a69213-da94-44dd-b608-6e8e7d5f8e70",
                        "source_entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                        "source_sense_description": "Cri du chat",
                        "target_lang_word": "Miau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "513678ea-9b10-3e0a-ad96-70e76d55d1bc",
                                        "entry_id": "76aad978-44af-38b8-98e3-43e5df77209f",
                                        "glosses": [
                                            "ein Laut, den eine Katze von sich gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995f1ffa-609d-45db-a311-facb070af81f",
                                                "sense_id": "513678ea-9b10-3e0a-ad96-70e76d55d1bc",
                                                "text": "„Auf der Mauer, auf der Lauer lag ein kleines Kätzchen. Wie sollte es wissen, daß diese Mauer ein antifaschistischer Schutzwall ist? Es wird es auch nicht begriffen haben, als die sozialistische Kugel durch sein Fell drang. Nun ist es berühmt. Ein Opfer Ulbrichts. Ein klägliches Miau wider den Bolschewismus, und ‚Bild‘-Berlin setzte ihr ein Denkmal.“"
                                            },
                                            {
                                                "example_id": "67992c2f-c6e7-4126-9ce7-51b1c781b1e6",
                                                "sense_id": "513678ea-9b10-3e0a-ad96-70e76d55d1bc",
                                                "text": "„Als sie die Tür aufmachte, sah sie keinen dort stehen und bevor sie die Tür wieder schloss, hörte sie ein Miau.“"
                                            },
                                            {
                                                "example_id": "879e7e48-20be-4d45-83d9-52ab8a0322bb",
                                                "sense_id": "513678ea-9b10-3e0a-ad96-70e76d55d1bc",
                                                "text": "„Sie gähnt mit einem langgezogenen Miau, dann kriecht sie auf seinen Schoß und schläft da weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d66e89c5-8ec3-4402-ac90-60c17aab4905",
                        "source_entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
