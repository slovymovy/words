                        "examples": [
                            {
                                "example_id": "4d351d8b-a2ff-43f7-98f4-c9b8fbf7877f",
                                "sense_id": "44893c88-8636-34d5-8415-d02148c08aad",
                                "text": "Vee was er genoeg, en Bisjoerin voorzag dat vlees en melk deze winter het hoofdvoedsel zouden zijn."
                            },
                            {
                                "example_id": "4dd5c9ce-76d4-466b-b173-fb6a2bd59b8d",
                                "sense_id": "44893c88-8636-34d5-8415-d02148c08aad",
                                "text": "De Kaapse Papegaai bijvoorbeeld is ernstig in het nauw gekomen door de grootschalige houtkap. Hij is zijn hoofdvoedsel kwijt: de vruchten van de Yellow Tree. Ook zijn favoriete nestplekjes, holtes in een dode boom, verdwijnen langzaam maar zeker. Als je de Kaapse Papegaai wilt redden, zul je het Yellow Tree bos moeten zien te bewaren. Dat kan alleen met hulp van de lokale bevolking."
                            }
                        ]
                    }
