                "senses": [
                    {
                        "sense_id": "e13aa9f5-770d-3cc0-95d6-b94dba8dea35",
                        "entry_id": "56382e92-efba-31f1-ad1c-f332f5338d76",
                        "glosses": [
                            "Halbjahresabonnement; Abonnement, das eine halbes Jahr Gültigkeit hat"
                        ],
                        "tags": [
                            "Kurzwort für"
                        ],
                        "examples": [
                            {
                                "example_id": "e21a3f9a-d16c-4014-9e63-c78de7569730",
                                "sense_id": "e13aa9f5-770d-3cc0-95d6-b94dba8dea35",
                                "text": "„Das Halbjahresabo war so teuer wie ein Kleinwagen, aber das konnte er sich angesichts stark gesunkener Kosten in anderer Hinsicht leisten.“"
                            },
                            {
                                "example_id": "93fb109c-1ffe-4635-8a98-8118f1513235",
                                "sense_id": "e13aa9f5-770d-3cc0-95d6-b94dba8dea35",
                                "text": "„Irgendwann hatte ich nicht mehr das Gefühl, dass ich ihr ein Jahresabonnement für den Bowlingclub bezahlten musste, sondern dass ein Halbjahresabo eventuell reichte.“"
                            },
                            {
                                "example_id": "6cb16c46-aab0-4f5a-8bac-c91dc2c6288a",
                                "sense_id": "e13aa9f5-770d-3cc0-95d6-b94dba8dea35",
                                "text": "„Bei einem Halbjahresabo ging es von 75 Euro steil aufwärts, je nach Anspruch und Ernsthaftigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
