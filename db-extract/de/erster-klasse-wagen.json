                "senses": [
                    {
                        "sense_id": "67de2110-5e61-3950-8d30-f46610a8214f",
                        "entry_id": "28fec637-bac5-3002-97a4-a48f9de2f9a6",
                        "glosses": [
                            "Eisenbahnwagen, dessen Abteile den höchsten Komfort für Reisende bieten (im Vergleich zu anderen Wagen des Zuges)"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "bc339319-2821-4c0f-a183-b3cc0c92158a",
                                "sense_id": "67de2110-5e61-3950-8d30-f46610a8214f",
                                "text": "„Der Nobelzug ‚Metropolitan‘ der Deutschen Bahn AG (DB) mit seinen sieben Erster-Klasse-Wagen soll vor allem dem Geschäftsreisenden eine Alternative zum Flugzeug und dem Auto bieten.“"
                            },
                            {
                                "example_id": "6895c6fa-ef8f-4dd1-a1a4-6f60b35be9c0",
                                "sense_id": "67de2110-5e61-3950-8d30-f46610a8214f",
                                "text": "„In den modernen Erster-Klasse-Wagen hat die Bundesbahn das Verhältnis Raucher- zu Nichtraucherabteilen zugunsten der Nichtraucher verändert; seit einigen Monaten ist Rauchen nur noch in zwei von den fünf Abteilen erlaubt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
