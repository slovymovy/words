                        "zh": [
                            {
                                "target_lang_word": "十点",
                                "target_lang_sense_clarification": "扑克牌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e100a0e1-9aad-3bac-8a8d-053b61a92e30",
                    "sense_definition": "An indefinite large number, usually referring to multiples of ten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were <w>tens</w> of thousands of people at the festival.",
