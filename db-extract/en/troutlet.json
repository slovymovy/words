                                        "glosses": [
                                            "Jeune truite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a499cb94-4250-4f42-841e-8ef84f610085",
                                                "sense_id": "d46806f8-2d8c-3d1a-8c50-c3163476aa98",
                                                "text": "– Ils auront au moins de l'huile, et nous avons dix goujons et une truitelle, nous !"
                                            },
                                            {
                                                "example_id": "96822c24-e569-4e1d-a33d-1b92e1c15d32",
                                                "sense_id": "d46806f8-2d8c-3d1a-8c50-c3163476aa98",
                                                "text": "Truitelles et ris d’agneau ? demanda-t-il en souriant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
