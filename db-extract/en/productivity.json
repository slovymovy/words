                                        "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                        "entry_id": "083252e9-f10d-3100-b366-f80c9093e67d",
                                        "glosses": [
                                            "Leistungsfähigkeit einer Person, eines Betriebes, einer Organisation, unter Berücksichtigung des Aufwandes Dienstleistungen zu erbringen oder Produkte herzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "102e6d56-e3e0-402c-b8b1-659c0704a4f6",
                                                "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                                "text": "Der Betrieb hat eine zu geringe Produktivität."
                                            },
                                            {
                                                "example_id": "9ef7c324-ff36-4aba-9f86-7a6e7e221fec",
                                                "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                                "text": "Das Wachstum fällt in diesem Jahr um einen halben Prozentpunkt auf nur noch 1,5 Prozent.„Leider wird sich auch die Produktivität enttäuschend entwickeln und nicht ansteigen. […]“ [der britische Schatzkanzler Philip Hammond im Unterhaus]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a33ece1e-927a-34f2-9f96-4773486a7334",
                                        "entry_id": "083252e9-f10d-3100-b366-f80c9093e67d",
                                        "glosses": [
                                            "Häufigkeit, mit der ein Affix (Wortbildungsmorphem) verwendet wird, um neue Wörter zu bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea230c78-9d6a-4452-9989-a4091778c1af",
                                                "sense_id": "a33ece1e-927a-34f2-9f96-4773486a7334",
                                                "text": "Die Produktivität des Präfixes \"un-\" im Deutschen ist sehr groß, die von \"miss-\" dagegen ist längst verloren gegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea308a8e-ce1d-422c-abba-43063549bd50",
                        "source_entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                        "source_sense_description": "state of being productive",
                        "target_lang_word": "Leistungsfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leistungsfähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7ebfcf-8f57-330b-b7f8-b914afde59c3",
                                        "entry_id": "f63bd94a-56f9-37ea-946a-3d78cf11fb77",
                                        "glosses": [
                                            "Eigenschaft, eine bestimmte Leistung erbringen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f1dce4-327c-490d-adeb-2d47314a3ecb",
                                                "sense_id": "9a7ebfcf-8f57-330b-b7f8-b914afde59c3",
                                                "text": "„Das ehrgeizige Ziel seiner Klinik lautet, die volle Leistungsfähigkeit der Patienten wiederherzustellen - und zwar auf Dauer.“"
                                            },
                                            {
                                                "example_id": "5879f609-ce49-4072-8b68-40d0ff1f7546",
                                                "sense_id": "9a7ebfcf-8f57-330b-b7f8-b914afde59c3",
                                                "text": "„Im zweiten Halbjahr 1915 stellten auch Industriebetriebe immer mehr Frauen ein, zu freilich deutlich niedrigeren Löhnen als ihre männlichen Kollegen, was mit geringerer Leistungsfähigkeit begründet wurde.“"
                                            },
                                            {
                                                "example_id": "1e45e825-d98e-49ac-a720-c6917a670d3c",
                                                "sense_id": "9a7ebfcf-8f57-330b-b7f8-b914afde59c3",
                                                "text": "„Das Deltafliegen stellt besonders hohe Ansprüche an die körperliche Leistungsfähigkeit, die physisch-technische Kompetenz, die Geländebeurteilung, das Erspüren von Aufwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
