                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "用手或物体用力击打"
                            },
                            {
                                "target_lang_word": "巴掌",
                                "target_lang_sense_clarification": "用手掌打"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e362c28-c936-3e00-a869-a814e1151b3a",
                    "sense_definition": "A hard-hit ball, especially a home run.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "blow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter sealed the championship with a massive <w>clout</w> deep into the left-field stands.",
                            "target_lang_translations": {
                                "zh": "击球手以一记直击左外野看台深处的强劲<w>全垒打</w>锁定了冠军胜局。"
                            }
                        },
                        {
                            "text": "His game-winning <w>clout</w> sailed clear over the outfield wall.",
                            "target_lang_translations": {
                                "zh": "他那记制胜的<w>强力击球</w>径直飞过了外野围墙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "homer",
                        "home run"
                    ],
                    "target_lang_definitions": {
                        "zh": "（棒球等运动中的）强力击球，尤指全垒打"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强力击球",
                                "target_lang_sense_clarification": "棒球中大力击出的球"
                            },
                            {
                                "target_lang_word": "全垒打",
                                "target_lang_sense_clarification": "强力击出场外的球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b89dd373-e343-3d1e-abef-0a7255476bd4",
                    "sense_definition": "A piece of cloth, rag, or patch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cloth",
                    "name_type": "no",
                    "examples": [
