                        "glosses": [
                            "Vêtement traditionnel coréen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffcb4a8-bfe5-4e3f-b9ba-80a0024787e4",
                                "sense_id": "142da575-ed1a-3bd9-8778-6167e597c9a3",
                                "text": "En tenue de deuil, hanbok noir, cheveux courts attachés par un élastique blanc, son visage était sérieux et calme."
                            },
                            {
                                "example_id": "1d8622e0-7500-4a23-9cde-4b1a0ff6e9e9",
                                "sense_id": "142da575-ed1a-3bd9-8778-6167e597c9a3",
                                "text": "Sur un ton grandiloquent, la présentatrice des grandes occasions de la télévision, vêtue d’un resplendissant hanbok (robe traditionnelle) rose bonbon, n’avait annoncé le départ du dirigeant pour le Vietnam que dimanche matin."
                            },
                            {
                                "example_id": "b7ede58d-1fff-42a4-83c3-c6eab0577f3f",
                                "sense_id": "142da575-ed1a-3bd9-8778-6167e597c9a3",
                                "text": "Dans son hanbok de mousseline blanche et son gilet de couleur foncée, elle faisait plus jeune encore que son âge."
                            }
                        ]
                    }
                ],
