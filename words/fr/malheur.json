                    "examples": [
                        {
                            "text": "Il semble poursuivi par le <w>malheur</w> depuis plusieurs années.",
                            "target_lang_translations": {
                                "en": "He seems to have been dogged by <w>misfortune</w> for several years.",
                                "ru": "Похоже, его уже несколько лет преследует <w>невезение</w>.",
                                "nl": "Hij lijkt al jaren door de <w>pech</w> achtervolgd te worden.",
                                "de": "Seit mehreren Jahren scheint ihn das <w>Pech</w> zu verfolgen.",
                                "pl": "Od kilku lat wygląda na to, że prześladuje go <w>pech</w>.",
                                "it": "Da vari anni sembra perseguitato dalla <w>sfortuna</w>.",
                                "cs": "Zdá se, že ho už několik let pronásleduje <w>smůla</w>.",
                                "tr": "Görünüşe göre birkaç yıldır peşini <w>şanssızlık</w> bırakmıyor.",
                                "es": "Desde hace varios años parece que la <w>desgracia</w> lo persigue.",
                                "zh": "这几年来，他似乎一直被<w>厄运</w>缠身。"
                            }
                        },
                        {
                            "text": "Nous avons joué de <w>malheur</w> pendant tout notre voyage à cause de la tempête.",
                            "target_lang_translations": {
                                "en": "We were plagued by <w>bad luck</w> throughout our trip because of the storm.",
                                "ru": "Из-за шторма всю поездку нас преследовало <w>невезение</w>.",
                                "nl": "Door de storm hadden we de hele reis <w>pech</w>.",
                                "de": "Wegen des Sturms hatten wir während der ganzen Reise <w>Pech</w>.",
                                "pl": "Przez cały wyjazd z powodu burzy mieliśmy ogromnego <w>pecha</w>.",
                                "it": "Per colpa della tempesta abbiamo avuto <w>sfortuna</w> per tutto il viaggio.",
                                "cs": "Kvůli bouři jsme měli během celé cesty <w>smůlu</w>.",
                                "tr": "Fırtına yüzünden bütün yolculuğumuz boyunca peşimizi <w>şanssızlık</w> bırakmadı.",
                                "es": "Durante todo el viaje, a causa de la tormenta, nos persiguió la <w>desgracia</w>.",
                                "zh": "因为那场暴风雨，我们整个旅途都<w>霉运</w>缠身。"
                            }
                        }
