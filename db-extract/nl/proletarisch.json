                        "entry_id": "31a20f7c-8997-3663-92b3-48133d6c66e2",
                        "glosses": [
                            "betrekking hebbend op de arbeidersklasse zonder bezit die is overgeleverd aan uitbuiting door gewetenloze kapitalisten"
                        ],
                        "tags": [],
