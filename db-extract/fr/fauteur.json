            {
                "entry_id": "ce21922d-562e-334b-8575-b7df86b1cef6",
                "word": "fauteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7f3c4a92-02c3-4c7a-afb8-4615a4a13e2d",
                        "entry_id": "ce21922d-562e-334b-8575-b7df86b1cef6",
                        "tags": [
