                "entry_id": "deee84da-df0f-3c4c-8348-318dbfa1d827",
                "word": "avances",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9216db2-f339-30a5-a62f-aa5d245d4e26",
                        "entry_id": "deee84da-df0f-3c4c-8348-318dbfa1d827",
                        "glosses": [
                            "Premières recherches ou premières démarches pour amener une réconciliation, un accommodement, un traité, voire pour former une liaison d’amour ou d’amitié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff43176f-0b2a-49a5-a57c-cc96b8c9ea77",
                                "sense_id": "e9216db2-f339-30a5-a62f-aa5d245d4e26",
                                "text": "Philippe se félicitait de son flair et mourait d'envie de serrer contre lui les rondeurs à la fois dissimulées et révélées par la robe moulante. Elle repoussa ses avances avec une pudeur de violette, qui ne fit que la lui rendre plus désirable."
                            },
                            {
                                "example_id": "a436ac4b-0104-4c22-91f6-3de9b8fd0fa5",
                                "sense_id": "e9216db2-f339-30a5-a62f-aa5d245d4e26",
                                "text": "Ce n’est pas lui qui a recherché cette femme, elle a fait les avances, toutes les avances."
                            },
                            {
                                "example_id": "c26cf735-ae1d-422c-9ad0-38f9ff968161",
                                "sense_id": "e9216db2-f339-30a5-a62f-aa5d245d4e26",
                                "text": "On a repoussé toutes leurs avances."
                            },
                            {
                                "example_id": "cf1bdbd0-7faf-4d1e-b6c5-950bb2059dc1",
                                "sense_id": "e9216db2-f339-30a5-a62f-aa5d245d4e26",
                                "text": "Mes avances ont été reçues froidement."
                            }
                        ]
                    }
                ],
