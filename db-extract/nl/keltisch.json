                                    },
                                    {
                                        "sense_id": "3e37a128-8eb9-3571-9b86-6ed225885e23",
                                        "entry_id": "e0beb524-fa84-3f53-b41b-28762b70311b",
                                        "glosses": [
                                            "Of the languages spoken by Celts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47e217c-81ae-4d56-9469-e75bd73cfc9c",
                                                "sense_id": "3e37a128-8eb9-3571-9b86-6ed225885e23",
                                                "text": "Sanskrit, Greek, Slavonic, Germanic, and Celtic names were all of this type, but there are also shorter names formed from the compound ones; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6547484b-4f58-45f1-b0e9-10414161da12",
                        "source_entry_id": "6a1e75b2-ff45-3ff3-8e75-73677cb03a83",
                        "source_sense_id": "fa9626fd-cd01-32cd-b1ee-275d67383885",
                        "source_sense_description": "met betrekking tot Kelten",
                        "target_lang_word": "celtique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celtique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                        "entry_id": "4a5ebf71-2838-31e9-9176-56f6c8a07661",
                                        "glosses": [
                                            "Qui appartient, qui est relatif aux Celtes, à leurs traditions, à leur langue, le celte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7cf6bf-0bde-462a-82ce-4dd6b8c174ca",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Le comité des fêtes de Barbezieux-Saint-Hilaire propose ce samedi 20 août, à 19 h, à l’église Saint-Hilaire, un concert de musique celtique, de gospel et de musique du monde."
                                            },
                                            {
                                                "example_id": "a2beb021-8953-47ef-a099-f0e58277df64",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Le crâne morvandeau, en définitive, semble trouver son indice moyen de largeur vers 84, ce qui le classe, sous ce rapport, avec les autres populations du type celtique."
                                            },
                                            {
                                                "example_id": "bd57e0a8-7127-4571-aa4c-cbe01d948776",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Et je m’étonnais que persistât cette charmante, cruelle et douloureuse race celtique, si pénétrée du désir de la mort, qu’il semblait qu’elle eût été depuis longtemps condamnée à s’éteindre. Mais non ! Elle avait beau désirer mourir, la vie restait de beaucoup la plus forte !"
                                            },
                                            {
                                                "example_id": "944540e4-aeb4-484a-9a2d-d7b354d972c0",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Les Bretons, ces émigrants celtiques venus de Grande-Bretagne au Vᵉ siècle de notre ère, avaient ramené en Armorique une langue très analogue à ce parler gaulois que d'ailleurs employait encore à cette époque, la population d'Auvergne."
                                            },
                                            {
                                                "example_id": "d18d42b5-cabb-490a-abee-0e371ecd42fe",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Ces lignes calligraphiées encadrent de festons et de rosaces les fleurs du souvenir, corolles concentriques aux corolles véritables, ou encore se pressent comme des vagues autour de chaque îlot floral desséché, rappelant les courbes dites « celtiques » des manuscrits d’Irlande, que Michel-Charles n’avait assurément jamais vus."
                                            },
                                            {
                                                "example_id": "d5a5ad5c-cee5-4ab9-bb3f-76ecd5271a94",
                                                "sense_id": "a4620b27-1f59-30e0-969c-86427d5009ef",
                                                "text": "Les consonnes subissent dans les langues celtiques divers traitements linguistiques dont la lénition interne. Ainsi les noms Péron, Pédron, Pezdron et Pezron sont tous des variantes d’un nom latin initial Petronem. Hormis le premier nom, les autres sont des archaïsmes."
                                            }
                                        ]
                                    }
                                ]
                            },
