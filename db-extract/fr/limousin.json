                "senses": [
                    {
                        "sense_id": "26ba1d0f-a610-30ec-a350-9678071aa187",
                        "entry_id": "a1322139-44d4-3ae9-b7b5-2a9b10f7f510",
                        "glosses": [
                            "Relatif à la région du Limousin, en France, ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c5a9c8-d900-4739-b8c2-27ae4a3f194b",
                                "sense_id": "26ba1d0f-a610-30ec-a350-9678071aa187",
                                "text": "Mon père, monsieur, était un pauvre gentilhomme limousin."
                            },
                            {
                                "example_id": "3492bc56-8e84-4085-ab3c-e3a29cca23a7",
                                "sense_id": "26ba1d0f-a610-30ec-a350-9678071aa187",
                                "text": "Les concours agricoles montrent que les éleveurs charolais, limousins ou normands, que les arboriculteurs rhodaniens ou roussillonnais sont à la tête du progrès et le renom de nos crus de vins démontre que nous avons des vignerons qui savent travailler."
                            },
                            {
                                "example_id": "83091b65-80e7-4616-b17f-8a294aa62063",
                                "sense_id": "26ba1d0f-a610-30ec-a350-9678071aa187",
                                "text": "Dans cette immense ferme restaurée à la lisière d’Aixe-sur-Vienne, un petit bourg limousin traversé de ruelles ombragées le long desquelles musardaient d’antiques bâtisses à colombages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35ddab25-e8cd-4539-852c-b1caf574e781",
                        "source_entry_id": "a1322139-44d4-3ae9-b7b5-2a9b10f7f510",
                        "source_sense_id": "26ba1d0f-a610-30ec-a350-9678071aa187",
