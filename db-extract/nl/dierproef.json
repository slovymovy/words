                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cadcb6df-cc84-42c6-9a4e-b0e32920c4af",
                                "sense_id": "46465878-0582-3d7e-aaed-3194deb22503",
                                "text": "Sinds kort kunnen sommige dierproeven vervangen worden door proeven met menselijke huid."
                            },
                            {
                                "example_id": "39fde5cd-6b18-46cc-b789-41e87403bb87",
                                "sense_id": "46465878-0582-3d7e-aaed-3194deb22503",
                                "text": "In 2016 zijn meer dieren bij Nederlandse instellingen die dierproeven mogen doen doodgegaan zonder dat ze in een proef zijn gebruikt dan in het jaar ervoor.\nIn totaal stierven in 2016 440.766 dieren voordat ze waren gebruikt in een dierproef, een stijging van 8,5 procent ten opzichte van 2015. Dat blijkt uit het jaarverslag dierproeven 2016 van de Nederlandse Voedsel- en Warenautoriteit (NVWA)."
                            }
                        ]
                    }
