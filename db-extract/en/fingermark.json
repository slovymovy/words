                        "sense_id": "ad45d49d-9453-372f-b32d-1d7bd9e27bc2",
                        "entry_id": "a6c30684-f651-38f5-a372-cf8d5ce9f0de",
                        "glosses": [
                            "A blemish made by a dirty finger; a fingerprint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816084a4-8026-401d-bb97-22b3d46f762a",
                                "sense_id": "ad45d49d-9453-372f-b32d-1d7bd9e27bc2",
                                "text": "He left his fingermark on the recently cleaned cloth."
                            },
                            {
                                "example_id": "c2e65e08-d079-404b-886f-9d3e399016d9",
                                "sense_id": "ad45d49d-9453-372f-b32d-1d7bd9e27bc2",
                                "text": "“No,” I said, rather surprised, “I know that there are no two finger-marks alike, but that’s as far as my science goes.”"
                            },
                            {
                                "example_id": "417a9af7-dd6a-430c-9467-7480fca3940f",
                                "sense_id": "ad45d49d-9453-372f-b32d-1d7bd9e27bc2",
                                "text": "[The cave] Paintings are almost all black, done in charcoal and oxide of manganese. The naturalistic scenes are crisscrossed with fingermarks and an array of signs and geometric designs, zigzagged, straight and curved."
                            }
                        ]
                    }
                ],
