                ],
                "senses": [
                    {
                        "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                        "entry_id": "6a783019-d72f-3f34-ac6d-0ab9c4aba4ef",
                        "glosses": [
                            "Unterbrechung einer Unterhaltung, eines Gesprächs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "723b1209-834c-41e0-989c-2eed9c26473c",
                                "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                                "text": "„Zwischen Rheinsalm und Wildschweinrücken wünscht Chantal eine mittelgroße Gesprächspause.“"
                            },
                            {
                                "example_id": "bf8b0a66-8067-403b-ba49-b8af4dd6b469",
                                "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                                "text": "„Während seines kurzen Besuches nahm Nikolai, wie man es immer macht, wenn Kinder da sind, in einer Gesprächspause seine Zuflucht zu dem kleinen Sohn des Fürsten Andrej, streichelte ihn und fragte ihn, ob er auch Husar werden wollte.“"
                            },
                            {
                                "example_id": "1e27cb5b-f3b3-49d2-bef1-f8e9c4db2d30",
                                "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                                "text": "„Es entstand eine Pause, in der man nur Monika Silvs hüsteln hörte, aber sobald Fredebeul im Zimmer ist, braucht kein Gastgeber Angst vor einer Gesprächspause zu haben.“"
                            },
                            {
                                "example_id": "070f95b3-dd62-4c45-9169-bd228f02242c",
                                "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                                "text": "„In einer Gesprächspause hörte Ernst das Gespräch am Nebentische.“"
                            },
                            {
                                "example_id": "de6f41b0-f646-4063-ae71-49a4c7043fa5",
                                "sense_id": "aa3ed24b-985c-3154-8466-fac42ab6df20",
                                "text": "„Eine kurze Gesprächspause gab ihm die Gelegenheit, das Thema zu wechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
