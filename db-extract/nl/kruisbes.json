                                "target_senses": [
                                    {
                                        "sense_id": "089bc285-fdb3-333c-82fb-2f1fd7d5d831",
                                        "entry_id": "8f4b2512-046a-3b28-a418-a0b1d5031298",
                                        "glosses": [
                                            "ботан. небольшой колючий ягодный кустарник (лат. Grossularia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d7b6df-a194-4d69-8518-62be99fbeba8",
                                                "sense_id": "089bc285-fdb3-333c-82fb-2f1fd7d5d831",
                                                "text": ".. а между гряд, или по сторонам оных, можно смородину белую, чёрную, красную, крыжовник и другия малыя кусты посадить."
                                            },
                                            {
                                                "example_id": "187f2f19-ccc4-4891-bbc8-dc41db44ce16",
                                                "sense_id": "089bc285-fdb3-333c-82fb-2f1fd7d5d831",
                                                "text": "С большой аллеи они повернули на дорожку роз, которые цвели и наполняли воздух своим ароматом, затем свернули на едва приметную тропинку в кустах крыжовника и смородины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ade0024-b7c7-3a4e-9c96-bb1238787cec",
                                        "entry_id": "8f4b2512-046a-3b28-a418-a0b1d5031298",
                                        "glosses": [
                                            "собир. кисло-сладкие ягоды этого кустарника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a217bf40-d422-43e5-8a86-c4d906868680",
                                                "sense_id": "4ade0024-b7c7-3a4e-9c96-bb1238787cec",
                                                "text": "Можно подавать к ним разные свежие и маринованные салаты, заменяя в них уксус соком из крыжовника."
                                            }
                                        ]
                                    }
                                ]
                            }
