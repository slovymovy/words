                        "sense_id": "c328bbb0-8bf0-3be1-9412-0918399d6b72",
                        "entry_id": "d8933ee9-344a-3043-8005-691e48e4d440",
                        "glosses": [
                            "een lamp gestookt op olie, petroleum of lampolie die geschikt is om in moeilijke buitenomstandigheden licht te blijven geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a78c5c3-cfb8-41e0-8544-495849b26f63",
                                "sense_id": "c328bbb0-8bf0-3be1-9412-0918399d6b72",
                                "text": "Het boek ”Stille Rebellen, de overval op de 20e deportatietrein naar Auschwitz” is meer dan een beschrijving van deze wat roekeloze daad. Dan zou het alleen maar gaan over Youra Livchitz, Jean Franklemon en Robert Maistriau, die uitgerust met drie tangen, een met rood papier beplakte stormlantaarn en een pistool een zwaarbewaakt transport tot stilstand brengen. Alleen het idee al getuigt -zeker achteraf- van een zekere naïviteit."
                            },
                            {
                                "example_id": "10ddfb34-9d59-4b21-abb7-c4e25cc298c1",
                                "sense_id": "c328bbb0-8bf0-3be1-9412-0918399d6b72",
                                "text": "In Wijhe zijn de straten maandag al grotendeels oranje. Elk jaar worden de straten versierd, maar met het koninklijk bezoek op komst doen de bewoners extra hun best. Met stormlantaarntjes, hoedjes en portretten van de koninklijke familie worden de straten opgefleurd. Een slijterij in de winkelstraat van Wijhe is voor de gelegenheid zelfs helemaal oranje geschilderd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa7e2524-a5cc-46d3-b27c-07c78bc5b3a1",
                        "source_entry_id": "d8933ee9-344a-3043-8005-691e48e4d440",
                        "source_sense_id": "c328bbb0-8bf0-3be1-9412-0918399d6b72",
                        "source_sense_description": "een lamp gestookt op olie, petroleum of lampolie die geschikt is om in moeilijke buitenomstandigheden licht te blijven geven",
                        "target_lang_word": "hurricane lamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurricane lamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4e5fe5-f3e8-39eb-b716-cf3330c9d32f",
                                        "entry_id": "d95eef53-464a-3003-a038-859fae1a565e",
                                        "glosses": [
                                            "A kerosene lantern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664ff871-dd51-4d0e-9a63-3131d51a4056",
                                                "sense_id": "ac4e5fe5-f3e8-39eb-b716-cf3330c9d32f",
                                                "text": "Most of the stock is third class, with wooden seats; many broken windows have been boarded up, and a number of the coaches are lighted by hurricane lamps."
                                            },
                                            {
                                                "example_id": "b3790b5c-69d4-42f3-8913-6c56d002cf51",
                                                "sense_id": "ac4e5fe5-f3e8-39eb-b716-cf3330c9d32f",
                                                "text": "She heard people, and saw light - light at last, and such a bright one! A hurricane lamp was bobbing towards her, and a woman’s voice, with a nervous edge to it, called, “Who’s that?”"
                                            },
                                            {
                                                "example_id": "f5347e7b-9309-407e-a6cf-81cb2d294fce",
                                                "sense_id": "ac4e5fe5-f3e8-39eb-b716-cf3330c9d32f",
                                                "text": "Patrick had risen early. As he lit the hurricane lamp he watched as it threw a wash of soft light through the window, illuminating the handrail on the porch beyond which nothing was visible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
