                "senses": [
                    {
                        "sense_id": "ad8f941c-a800-366a-b272-b55294d4e5cb",
                        "entry_id": "48bc4b76-3770-3489-bf44-e49bb619a0d3",
                        "glosses": [
                            "offizielle Hymne des Freistaats Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f373b4a5-1042-4828-979e-58e286d28583",
                                "sense_id": "ad8f941c-a800-366a-b272-b55294d4e5cb",
                                "text": "„Den Abschluss bilden die Pferdesegnung, die Ansprachen und die Auszeichnung langjähriger Martinireiter, das Tedeum und die Bayernhymne.“"
                            },
                            {
                                "example_id": "4b50e1da-1cd1-4a54-beb2-472788e630ef",
                                "sense_id": "ad8f941c-a800-366a-b272-b55294d4e5cb",
                                "text": "„Etwa 300 Startbahn-Gegner stehen auf und beginnen im Chor die Bayernhymne zu singen“"
                            },
                            {
                                "example_id": "68a936f1-15fd-423b-a61d-d13c42d5497e",
                                "sense_id": "ad8f941c-a800-366a-b272-b55294d4e5cb",
                                "text": "„Und wieso sangen die ausgerechnet die Bayernhymne?“"
                            },
                            {
                                "example_id": "53499668-0aaa-4a68-b9fe-e2a480225559",
                                "sense_id": "ad8f941c-a800-366a-b272-b55294d4e5cb",
                                "text": "„Denn am Ende macht Benedikt XVI. nicht nur bei den geistlichen Liedern mit, sondern auch bei der Bayernhymne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
