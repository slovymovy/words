                ],
                "senses": [
                    {
                        "sense_id": "4d391424-714e-3ce3-817f-cfa3125425ae",
                        "entry_id": "a56e9ad4-5d59-3a0e-af66-f76c2af23a02",
                        "glosses": [
                            "Devenir ou faire comme Dracula, vampiriser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0a1e3b-b957-4b35-ae16-198d4e90d3ff",
                                "sense_id": "4d391424-714e-3ce3-817f-cfa3125425ae",
                                "text": "Il oblige la pellicule à se draculiser. Il lui donne des leçons de ténèbres."
                            },
                            {
                                "example_id": "8a56948c-87e6-487d-9554-211bcda4c906",
                                "sense_id": "4d391424-714e-3ce3-817f-cfa3125425ae",
                                "text": "L’idée simplement illumine leurs visages qui draculisent de plaisir, et leurs yeux étincellent avec rage, rien que d’imaginer…"
                            },
                            {
                                "example_id": "1b5d5e55-5bbc-4753-af12-96dd5efb9fcf",
                                "sense_id": "4d391424-714e-3ce3-817f-cfa3125425ae",
                                "text": "La découverte du Portugais draculisé la fait piailler comme si c’était pure souris."
                            }
                        ]
                    }
                ],
