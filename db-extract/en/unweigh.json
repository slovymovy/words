                "senses": [
                    {
                        "sense_id": "421425a9-562b-3b98-b41f-a84af82d7c2a",
                        "entry_id": "1ff5c492-2fee-3998-83c6-687e4fd6bc72",
                        "glosses": [
                            "To shift weight off of or to have the weight shifted off of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e50df17b-5503-4ecb-a3e4-73482b8ee270",
                                "sense_id": "421425a9-562b-3b98-b41f-a84af82d7c2a",
                                "text": "Unweigh your stopping foot and turn it to an angle on the ice to produce a skid, and thus a stop."
                            },
                            {
                                "example_id": "d976d800-392d-41d3-9c37-6239e55a22d2",
                                "sense_id": "421425a9-562b-3b98-b41f-a84af82d7c2a",
                                "text": "Each hip unweighs as a result of the arm finishing its work and briefly acts as floating support until the next moving support is established ."
                            },
                            {
                                "example_id": "872fa541-aba7-454c-a6b5-b2f543345597",
                                "sense_id": "421425a9-562b-3b98-b41f-a84af82d7c2a",
                                "text": "Weight-supported treadmill training unweighs the patient and licenses the utilization of a mechanized treadmill for walking."
                            }
                        ]
                    },
                    {
                        "sense_id": "2363aea1-c01b-3f27-93b0-9e2f8ab8230e",
                        "entry_id": "1ff5c492-2fee-3998-83c6-687e4fd6bc72",
                        "glosses": [
                            "To lift (an anchor) so that it no longer holds something in place."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8457163e-325c-4b89-9074-c752719e74df",
                                "sense_id": "2363aea1-c01b-3f27-93b0-9e2f8ab8230e",
                                "text": "He gave the order to unweigh the anchor."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc216094-67ca-3359-ae2d-e771243d98ad",
                        "entry_id": "1ff5c492-2fee-3998-83c6-687e4fd6bc72",
                        "glosses": [
                            "To relieve from a burden."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ef687ebf-52eb-4300-af03-361d70e85ce7",
                                "sense_id": "fc216094-67ca-3359-ae2d-e771243d98ad",
                                "text": "Alaska would get more money and the oil companies would get more money, but I am quite sure the Japanese are not going to unweigh the system."
                            },
                            {
                                "example_id": "c0bccd32-3733-45a8-a238-0115abe99c5d",
                                "sense_id": "fc216094-67ca-3359-ae2d-e771243d98ad",
                                "text": "However, he cannot bear the burden on his own deeds and seeks to unweigh his conscience onto other's shoulders ."
                            },
                            {
                                "example_id": "a4738bd9-a589-44d3-bb86-990e5782f34a",
                                "sense_id": "fc216094-67ca-3359-ae2d-e771243d98ad",
                                "text": "I learn to unweigh myself of other people's problems."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e0b8c4f-4707-3efe-adb0-ca65accb77fb",
                        "entry_id": "1ff5c492-2fee-3998-83c6-687e4fd6bc72",
                        "glosses": [
                            "To discount from serious consideration."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "428443d9-9c20-44cf-9adc-b39294cda581",
                                "sense_id": "4e0b8c4f-4707-3efe-adb0-ca65accb77fb",
                                "text": "I arrived at that conclusion because I considered that this thing was inaugurated by men like the honorable member for South Bourke (Mr. Crews), who had not properly weighed their own convictions, or who, having weighed them, were willing to unweigh them on certain considerations."
                            },
                            {
                                "example_id": "3099bc10-325e-4916-bcb1-9fd0281d329b",
                                "sense_id": "4e0b8c4f-4707-3efe-adb0-ca65accb77fb",
                                "text": "I don't believe any problem is so complex that it requires a great amount of time contemplating, weighing and unweighing all of these problems."
                            }
                        ]
                    }
                ],
