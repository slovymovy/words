                        "target_lang_word": "magic word",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magic word",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d22cc82d-bae6-3cd7-b76c-12c10769f77b",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "Any word that has a magical effect when uttered."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "One of the words please, thank you, or hello."
                                        ],
                                        "tags": [
                                            "in teaching or training polite words to children"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c26bfff-e881-49c8-a569-1b1dac1bd625",
                                                "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                                "text": "If you learn to use magic words when you are little, it would be easy in your adulthood."
                                            },
                                            {
                                                "example_id": "0fdc95f2-902b-421b-9d90-511d3af42a1a",
                                                "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                                "text": "What's the magic word?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7175e7-472a-35ac-9484-0b467d5d59f3",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "Any word that is considered very significant in a certain situation or context."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b624cb-6865-46eb-9fde-7af88b19a5c1",
                                                "sense_id": "3b7175e7-472a-35ac-9484-0b467d5d59f3",
                                                "text": "When someone offers you drugs, the magic word is \"no\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "A string of text having some special function or purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b628f68-2e92-40fa-b98a-f115f31dee3a",
                                                "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                                "text": "One of the magic words used in the MediaWiki software is __NOTOC__, which hides the table of contents that would normally be on the page."
                                            },
                                            {
                                                "example_id": "06bba8ae-0bf0-4805-a799-57ecb4f38f8b",
                                                "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                                "text": "The header consists of an optional self-execution script, a magic word, a version number, and the word offset of the first instruction, relative to the magic word."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
