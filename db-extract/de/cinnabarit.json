                    {
                        "translation_id": "38d45059-a5ff-48a9-89a2-429beb5d06cf",
                        "source_entry_id": "2c485b5a-7260-3bb9-81ea-7439dae8ba05",
                        "source_sense_id": "bf41eef0-2bde-3f28-8069-a3c95e13b0c9",
                        "source_sense_description": "Mineralogie: häufig vorkommendes Mineral, eine chemische Verbindung aus Quecksilber und Schwefel",
                        "target_lang_word": "cinabre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinabre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "052307c8-64b7-3437-a896-590d494376b6",
                                        "entry_id": "efdee8c7-ad83-37fa-9347-30c25ba8173b",
                                        "glosses": [
                                            "Combinaison naturelle ou artificielle de mercure et de soufre, de formule HgS, dont on fait le vermillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364f639a-6005-4e17-9cf7-7a1e22a9eed3",
                                                "sense_id": "052307c8-64b7-3437-a896-590d494376b6",
                                                "text": "Mais l’étranger lui écrivit en réponse, sur un parchemin […] et avec des caractères rouges comme le cinabre."
                                            },
                                            {
                                                "example_id": "85b65b79-27be-4f6d-8467-cc69da5b9f1c",
                                                "sense_id": "052307c8-64b7-3437-a896-590d494376b6",
                                                "text": "Un éventail rouge tremblait comme un papillon de cinabre dans ses doigts chargés de bagues d’argent."
                                            },
                                            {
                                                "example_id": "5973258d-88c6-4896-b825-3b517e2e32e2",
                                                "sense_id": "052307c8-64b7-3437-a896-590d494376b6",
                                                "text": "Ces sauvages […] étaient […] peints de la manière la plus variée et la plus fantastique. La plupart avaient la figure toute entière avec du cinabre, d’autres étaient tout à fait noirs, avec une longue raie blanche sur chaque joue."
                                            },
                                            {
                                                "example_id": "90bcadf3-a954-4773-acb0-a60512d6bf23",
                                                "sense_id": "052307c8-64b7-3437-a896-590d494376b6",
                                                "text": "Les Chinois utilisaient le cinabre il y a 3600 ans comme encre, ou comme pigment pour les poteries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f7ec167-9c02-3d99-b80c-5df9e2e4d2e9",
                                        "entry_id": "efdee8c7-ad83-37fa-9347-30c25ba8173b",
                                        "glosses": [
                                            "Encre pourpre fabriquée à partir du cinabre. Cette encre était utilisée par les Byzantins pour authentifier les actes impériaux issus de la chancellerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ebccf7-a2f0-4a5e-b1e9-3b5c361a9131",
                                                "sense_id": "4f7ec167-9c02-3d99-b80c-5df9e2e4d2e9",
                                                "text": "— Éclatantes blancheurs recherchées, semble-t-il, pour encore plus fortement accentuer la rutilance vermillonne des bérets à pompon et des tailloles rouges, les « zaïelles », c’est tout ce cinabre au cœur qui vous monte à la tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4dbaf2-588e-35f0-82a4-5afff93f05b5",
                                        "entry_id": "efdee8c7-ad83-37fa-9347-30c25ba8173b",
                                        "glosses": [
                                            "Couleur rouge teinté d’orange."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
