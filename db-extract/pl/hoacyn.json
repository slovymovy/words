                "senses": [
                    {
                        "sense_id": "d4be7f16-90b3-3fea-80dd-02068a76e855",
                        "entry_id": "f3b3ebff-0bc3-3495-b13b-7a8e75fa897a",
                        "glosses": [
                            "Opisthocomus hoazin Müller, gatunek średniej wielkości tropikalnych ptaków z rodziny hoacynów"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "7a48569a-c257-4e46-aa1f-21ca932a44fb",
                                "sense_id": "d4be7f16-90b3-3fea-80dd-02068a76e855",
                                "text": "Na skutek dużej odmienności hoacynów od innych ptaków ich miejsce w systematyce jest trudne do jednoznacznego sklasyfikowania"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "292888c6-1516-3285-bb7f-f4aa940e964c",
                        "entry_id": "f3b3ebff-0bc3-3495-b13b-7a8e75fa897a",
                        "glosses": [
                            "ptak z gatunku hoacynów (1.1)"
                        ],
                        "tags": [],
