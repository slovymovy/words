                ],
                "senses": [
                    {
                        "sense_id": "b517e3f6-c937-3ffb-836a-54f826243df1",
                        "entry_id": "b8cc2347-b828-389a-a7c1-5cb3325a1360",
                        "glosses": [
                            "bunch, bundle, sheaf, usually of plants"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "f97802a0-7ea6-4156-9ebc-c67fc592bade",
                                "sense_id": "b517e3f6-c937-3ffb-836a-54f826243df1",
                                "text": "Na chodniku plątały się pod nogami wiechcie słomy, które wypadły spomiędzy desek fury.",
                                "translation": "Bundles of straw which had fallen from between the cart's boards got underfoot on the sidewalk.",
                                "english": "Bundles of straw which had fallen from between the cart's boards got underfoot on the sidewalk."
                            },
                            {
                                "example_id": "97f1232f-6fab-4075-84dd-d32c7f63d580",
                                "sense_id": "b517e3f6-c937-3ffb-836a-54f826243df1",
                                "text": "Różowość mozaiki znikła pod grubą warstwą kurzu, z ustawionych na niej doniczek sterczały wiechcie roślin, suche wiechcie zwisały z doniczek porozwieszanych wzdłuż galeryjki, [...]",
                                "translation": "The pink of the mosaic had disappeared under a thick layer of dust; bunches of plants stuck out of the flowerpots set up on it; dry bunches of twigs hung down from flowerpots hung up throughout the gallery...",
                                "english": "The pink of the mosaic had disappeared under a thick layer of dust; bunches of plants stuck out of the flowerpots set up on it; dry bunches of twigs hung down from flowerpots hung up throughout the gallery..."
                            },
                            {
                                "example_id": "e15c59b5-0906-4f11-b7db-fb0957021236",
                                "sense_id": "b517e3f6-c937-3ffb-836a-54f826243df1",
                                "text": "[...] każda marchewka ma zielony wiecheć z jednej strony, a pożywny pomarańczowy korzeń z drugiej [...]",
                                "translation": "Every carrot has a green bunch of stems on one end and an edible orange root on the other.",
                                "english": "Every carrot has a green bunch of stems on one end and an edible orange root on the other."
                            }
                        ]
                    },
