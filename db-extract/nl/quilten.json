                        "examples": [
                            {
                                "example_id": "794c5e36-24e8-4098-95b4-c8261b732ab5",
                                "sense_id": "444ec4e9-ee0c-3390-9db7-ceba079fc2a9",
                                "text": "In de loop van de week zullen onder meer twee vrouwen naar de Engelse partnerstad vertrekken die zich hebben bekwaamd in het quilten. \"Je weet wel van die lapjes\", meldt Blaak vanuit het land aan de andere kant van de Noordzee."
                            },
                            {
                                "example_id": "f821299e-4d73-4e65-84ce-e623ca1bb376",
                                "sense_id": "444ec4e9-ee0c-3390-9db7-ceba079fc2a9",
                                "text": "Deelnemers laten zich inspireren door een van de zeventien muurschilderingen in de kerk, en maken vervolgens hun eigen kunstwerk. Hoe of wat, daar zijn ze helemaal vrij in. Het kan bijvoorbeeld gaan om tekenen, quilten, breien, beeldhouwen of glaskunst."
                            }
                        ]
