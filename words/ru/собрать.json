{
    "word_family": [
        "сбор",
        "сборка",
        "сборник",
        "собрание",
        "сборщик",
        "собранность",
        "сборный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "091c0026-931e-3261-9957-4288113dc02e",
                    "sense_definition": "Сложить, соединить вместе разрозненные предметы или созвать людей в одно место.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель попросил учеников <собрать> тетради и положить их на стол.",
                            "target_lang_translations": {
                                "en": "The teacher asked the students to <collect> the notebooks and put them on the desk.",
                                "de": "Der Lehrer bat die Schüler, die Hefte <zusammenzusammeln> und sie auf den Tisch zu legen."
                            }
                        },
                        {
                            "text": "Мы решили <собрать> всех друзей на ужин в эту пятницу.",
                            "target_lang_translations": {
                                "en": "We decided to <gather> all our friends for dinner this Friday.",
                                "de": "Wir haben beschlossen, diesen Freitag alle Freunde zum Abendessen zu <versammeln>."
                            }
                        }
                    ],
                    "synonyms": [
                        "объединить",
                        "созвать",
                        "соединить",
                        "сложить"
                    ],
                    "antonyms": [
                        "разбросать",
                        "разогнать",
                        "распустить"
                    ],
                    "common_phrases": [
                        "собрать вещи",
                        "собрать деньги",
                        "собрать информацию",
                        "собрать документы",
                        "собрать совещание"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring together scattered items or call people to one place.",
                        "de": "Einzelne Gegenstände zusammenlegen oder Menschen an einem Ort versammeln."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "people or things"
                            },
                            {
                                "target_lang_word": "collect",
                                "target_lang_sense_clarification": "items or information"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sammeln",
                                "target_lang_sense_clarification": "Dinge oder Informationen"
                            },
                            {
                                "target_lang_word": "versammeln",
                                "target_lang_sense_clarification": "Personen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96b27f07-6291-3ac0-85d1-c5fbf3b7a40b",
                    "sense_definition": "Приготовить кого-либо или что-либо к отъезду, походу или какому-либо делу (уложить вещи).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно срочно <собрать> чемодан, так как поезд уходит через час.",
                            "target_lang_translations": {
                                "en": "I need to urgently <pack> my suitcase since the train leaves in an hour.",
                                "de": "Ich muss dringend meinen Koffer <packen>, da der Zug in einer Stunde fährt."
                            }
                        },
                        {
                            "text": "Мама помогла <собрать> ребёнка в школу рано утром.",
                            "target_lang_translations": {
                                "en": "Mom helped <get> the child <ready> for school early in the morning.",
                                "de": "Die Mutter hat morgens früh geholfen, das Kind für die Schule <fertigzumachen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подготовить",
                        "уложить"
                    ],
                    "common_phrases": [
                        "собрать чемодан",
                        "собрать в дорогу",
                        "собрать ребёнка",
                        "собрать сумку"
                    ],
                    "target_lang_definitions": {
                        "en": "To prepare someone or something for a trip or activity (e.g., packing things).",
                        "de": "Jemanden oder etwas für eine Abreise, eine Reise oder eine Aufgabe vorbereiten (Gepäck packen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pack",
                                "target_lang_sense_clarification": "luggage or bags"
                            },
                            {
                                "target_lang_word": "get ready",
                                "target_lang_sense_clarification": "a person for departure"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "packen",
                                "target_lang_sense_clarification": "Koffer oder Taschen"
                            },
                            {
                                "target_lang_word": "fertigmachen",
                                "target_lang_sense_clarification": "eine Person für den Aufbruch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7155cc9-ad9a-3ce1-bb52-4bb7288a7d67",
                    "sense_definition": "Составить целое из отдельных частей, соединить детали механизма или конструкции.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отец купил новый шкаф и пообещал <собрать> его в выходные.",
                            "target_lang_translations": {
                                "en": "Father bought a new wardrobe and promised to <assemble> it on the weekend.",
                                "de": "Der Vater hat einen neuen Schrank gekauft und versprochen, ihn am Wochenende <zusammenzubauen>."
                            }
                        },
                        {
                            "text": "Маленький мальчик смог быстро <собрать> сложный пазл из тысячи деталей.",
                            "target_lang_translations": {
                                "en": "The little boy was able to quickly <put together> a complex puzzle of a thousand pieces.",
                                "de": "Der kleine Junge konnte ein schwieriges Puzzle aus tausend Teilen schnell <zusammensetzen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "смонтировать",
                        "составить",
                        "сконструировать"
                    ],
                    "antonyms": [
                        "разобрать",
                        "сломать"
                    ],
                    "common_phrases": [
                        "собрать мебель",
                        "собрать конструктор",
                        "собрать пазл",
                        "собрать компьютер"
                    ],
                    "target_lang_definitions": {
                        "en": "To form a whole from separate parts; to connect details of a mechanism or structure.",
                        "de": "Ein Ganzes aus Einzelteilen zusammensetzen, Teile eines Mechanismus oder einer Konstruktion verbinden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assemble",
                                "target_lang_sense_clarification": "furniture or mechanisms"
                            },
                            {
                                "target_lang_word": "put together",
                                "target_lang_sense_clarification": "puzzles or parts"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zusammenbauen",
                                "target_lang_sense_clarification": "Möbel oder Mechanismen"
                            },
                            {
                                "target_lang_word": "zusammensetzen",
                                "target_lang_sense_clarification": "Puzzles oder Einzelteile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb834e7-013a-3ea1-aa1f-696e450bc13c",
                    "sense_definition": "Сорвать или срезать плоды, ягоды или грибы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Осенью мы поехали в лес, чтобы <собрать> грибы и подышать свежим воздухом.",
                            "target_lang_translations": {
                                "en": "In autumn we went to the forest to <pick> mushrooms and breathe fresh air.",
                                "de": "Im Herbst sind wir in den Wald gefahren, um Pilze zu <sammeln> und frische Luft zu tanken."
                            }
                        },
                        {
                            "text": "Фермеры спешат <собрать> богатый урожай пшеницы до начала сезона дождей.",
                            "target_lang_translations": {
                                "en": "Farmers are hurrying to <harvest> a rich wheat crop before the rainy season starts.",
                                "de": "Die Bauern beeilen sich, eine reiche Weizenernte vor Beginn der Regenzeit zu <ernten>."
                            }
                        }
                    ],
                    "synonyms": [
                        "нарвать",
                        "набрать"
                    ],
                    "common_phrases": [
                        "собрать урожай",
                        "собрать грибы",
                        "собрать ягоды",
                        "собрать цветы"
                    ],
                    "target_lang_definitions": {
                        "en": "To pick or cut fruits, berries, or mushrooms.",
                        "de": "Früchte, Beeren oder Pilze pflücken oder ernten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pick",
                                "target_lang_sense_clarification": "berries, mushrooms, or flowers"
                            },
                            {
                                "target_lang_word": "harvest",
                                "target_lang_sense_clarification": "crops"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sammeln",
                                "target_lang_sense_clarification": "Pilze oder Beeren"
                            },
                            {
                                "target_lang_word": "pflücken",
                                "target_lang_sense_clarification": "Blumen oder Früchte"
                            },
                            {
                                "target_lang_word": "ernten",
                                "target_lang_sense_clarification": "Nutzpflanzen und Erträge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}