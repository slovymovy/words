                "senses": [
                    {
                        "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                        "entry_id": "09f19159-11c5-31a8-a2d0-09cd67886216",
                        "glosses": [
                            "Stoff aus Proteinen (im Falle eines Coronaimpfstoffes aus künstlich hergestellten Spike-Proteinen und einem Wirkverstärker/Adjuvans), der dem Körper gegeben wird, um die Produktion von Antikörpern anzuregen und so eine Immunität gegen eine Krankheit zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8108fa4d-8890-4743-b067-32f61d09c3a9",
                                "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                                "text": "„Seit Dezember 2013 ist auch ein Proteinimpfstoff gegen Meningokokken der Serogruppe B für Personen mit erhöhtem Risiko verfügbar.“"
                            },
                            {
                                "example_id": "451a2788-f059-4ab2-a433-def06a51db65",
                                "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                                "text": "„Die Gentechnik bietet hier die Möglichkeit, die antigene Determinante des Virus als Proteinimpfstoff zu produzieren. Damit wird jegliches Restrisiko einer mit der Impfung einhergehenden Infektion ausgeschlossen.“"
                            },
                            {
                                "example_id": "c9d963bd-0a99-4b7a-a61d-c9a03098f6de",
                                "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                                "text": "„Nuvaxovid, ein adjuvantierter Proteinimpfstoff der Firma Novavax, ist seit dem 20.12.2021 in der EU für die Grundimmunisierung gegen COVID-19 zugelassen.“"
                            },
                            {
                                "example_id": "8aefff89-8fee-43ec-ab9e-072255d75841",
                                "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                                "text": "„Beim Novavax-Mittel Nuvaxovid handelt sich um einen Proteinimpfstoff - also eine andere Technologie als bei den bisher zumeist eingesetzten mRNA-Präparaten von Pfizer und Moderna, gegen die manche Menschen Bedenken haben.“"
                            },
                            {
                                "example_id": "10a1625d-e8b9-4ad0-9c8e-c5b436033eba",
                                "sense_id": "0ed2aeb7-3954-365c-8aec-ed8b77617a4f",
                                "text": "„Das Impfschema sieht zwei Impfungen im Abstand von 21 Tagen vor. Solche Proteinimpfstoffe haben sich schon gegen andere Krankheiten bewährt, allerdings können die Wirkverstärker Impfreaktionen auslösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
