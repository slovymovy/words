                                        "entry_id": "b07a6a83-e4bd-362b-987a-844a800fc6b8",
                                        "glosses": [
                                            "Sauveur d’Andromède, fille de Céphée et Cassiopée."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c8e0cba-9688-3201-8f0a-82478ccb6c6d",
                                        "entry_id": "b07a6a83-e4bd-362b-987a-844a800fc6b8",
                                        "glosses": [
                                            "Constellation du ciel boréal, bordée par Andromède, le Bélier, Cassiopée, le Cocher, la Girafe, le Taureau et le Triangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcfc87d-c7f6-47d3-9744-3259ea629914",
                                                "sense_id": "1c8e0cba-9688-3201-8f0a-82478ccb6c6d",
                                                "text": "Depuis le commencement du mois, il étudiait le ciel avant l’aube, la constellation de Persée se trouvant au zénith. Agalah se montrait à peine, Algol brillait moins, Mira-Cœti avait disparu ; d’où il augurait la mort d’un homme considérable, cette nuit même, dans Machærous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3192ccb-64a6-3c21-83ea-090808aeacad",
                                        "entry_id": "b07a6a83-e4bd-362b-987a-844a800fc6b8",
                                        "glosses": [
                                            "Le double amas de Persée (NGC 869 et 884)."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
