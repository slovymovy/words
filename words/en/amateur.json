{
    "word_family": [
        "amateurish",
        "amateurism",
        "amateurishly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94dc7fe5-f7bd-33b8-8911-5fd4a6629d53",
                    "sense_definition": "A person who engages in a pursuit, study, science, or sport on an unpaid basis rather than professionally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "non_professional_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis tournament is open to both professionals and <w>amateurs</w>.",
                            "target_lang_translations": {
                                "ru": "Теннисный турнир открыт как для профессионалов, так и для <w>любителей</w>.",
                                "zh": "这场网球锦标赛既向职业选手开放，也向<w>业余爱好者</w>开放。"
                            }
                        },
                        {
                            "text": "He is a talented <w>amateur</w> who plays the piano for his own enjoyment.",
                            "target_lang_translations": {
                                "ru": "Он талантливый <w>любитель</w>, который играет на пианино для собственного удовольствия.",
                                "zh": "他是一位很有天赋的<w>业余爱好者</w>，弹钢琴纯粹是为了自娱自乐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hobbyist",
                        "non-professional"
                    ],
                    "common_phrases": [
                        "talented amateur",
                        "enthusiastic amateur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся каким-либо делом, наукой или спортом на безвозмездной основе, а не профессионально.",
                        "zh": "指非职业地从事某项活动、研究、科学或运动的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любитель",
                                "target_lang_sense_clarification": "человек, занимающийся чем-то ради удовольствия"
                            },
                            {
                                "target_lang_word": "непрофессионал",
                                "target_lang_sense_clarification": "антоним слова «профессионал»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业余爱好者",
                                "target_lang_sense_clarification": "指出于兴趣而非职业从事某项活动的人"
                            },
                            {
                                "target_lang_word": "非专业人士",
                                "target_lang_sense_clarification": "指不以该项活动为职业的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69e40200-255f-3141-ad7a-a909ae12ccbd",
                    "sense_definition": "Someone who is unqualified or lacks sufficient skill to perform a task properly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unskilled_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a complete <w>amateur</w> when it comes to fixing cars.",
                            "target_lang_translations": {
                                "ru": "Я полный <w>дилетант</w>, когда дело доходит до ремонта машин.",
                                "zh": "说到修车，我完全是个<w>外行</w>。"
                            }
                        },
                        {
                            "text": "They hired a bunch of <w>amateurs</w> who completely ruined the project.",
                            "target_lang_translations": {
                                "ru": "Они наняли кучку <w>дилетантов</w>, которые полностью провалили проект.",
                                "zh": "他们雇了一群<w>外行</w>，结果把整个项目都搞砸了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dabbler",
                        "dilettante"
                    ],
                    "common_phrases": [
                        "rank amateur",
                        "bunch of amateurs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто не обладает достаточной квалификацией или навыками для надлежащего выполнения задачи.",
                        "zh": "指缺乏足够技能或资质来妥善完成某项任务的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилетант",
                                "target_lang_sense_clarification": "человек с поверхностными знаниями"
                            },
                            {
                                "target_lang_word": "непрофессионал",
                                "target_lang_sense_clarification": "человек без специальной подготовки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外行",
                                "target_lang_sense_clarification": "指对某事缺乏专业知识或技能的人"
                            },
                            {
                                "target_lang_word": "门外汉",
                                "target_lang_sense_clarification": "指对某领域一窍不通的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58d85775-3f01-3daf-9a73-79df145004c7",
                    "sense_definition": "A person who appreciates, admires, or is fond of a particular thing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lover_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a great <w>amateur</w> of fine wines and cheeses.",
                            "target_lang_translations": {
                                "ru": "Он был известен как большой <w>ценитель</w> хороших вин и сыров.",
                                "zh": "他以精通美酒和奶酪的<w>鉴赏家</w>而闻名。"
                            }
                        },
                        {
                            "text": "The museum was founded by a wealthy <w>amateur</w> of the arts.",
                            "target_lang_translations": {
                                "ru": "Музей был основан богатым <w>любителем</w> искусств.",
                                "zh": "这家博物馆是由一位富有的艺术<w>爱好者</w>创立的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "amateur of"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used with 'of'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ценит что-либо, восхищается или увлекается чем-либо.",
                        "zh": "指对某事物有鉴赏力、欣赏或喜爱的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценитель",
                                "target_lang_sense_clarification": "знаток, понимающий толк в чем-либо"
                            },
                            {
                                "target_lang_word": "любитель",
                                "target_lang_sense_clarification": "человек, имеющий пристрастие к чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鉴赏家",
                                "target_lang_sense_clarification": "指对艺术或特定事物有很高鉴赏能力的人"
                            },
                            {
                                "target_lang_word": "爱好者",
                                "target_lang_sense_clarification": "指对某事物有浓厚兴趣的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47e5968c-200d-3577-8d86-d88901ed6fcb",
                    "sense_definition": "Relating to or done by someone who engages in a pursuit as a hobby rather than a profession.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "non_professional_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She joined an <w>amateur</w> dramatic society to meet new people.",
                            "target_lang_translations": {
                                "ru": "Она вступила в <w>любительский</w> театральный кружок, чтобы познакомиться с новыми людьми.",
                                "zh": "她加入了一个<w>业余</w>戏剧社团以结识新朋友。"
                            }
                        },
                        {
                            "text": "My father enjoys communicating with people via <w>amateur</w> radio.",
                            "target_lang_translations": {
                                "ru": "Моему отцу нравится общаться с людьми по <w>любительскому</w> радио.",
                                "zh": "我父亲喜欢通过<w>业余</w>无线电与人交流。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "amateur sports",
                        "amateur radio",
                        "amateur photographer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к занятию или выполненный кем-то в качестве хобби, а не профессии.",
                        "zh": "指作为爱好而非职业进行的活动或与之相关的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любительский",
                                "target_lang_sense_clarification": "непрофессиональный, относящийся к увлечению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业余的",
                                "target_lang_sense_clarification": "指非职业性的，出于兴趣的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b2d564e-4307-330b-8a54-745456a76b9f",
                    "sense_definition": "Showing a lack of skill, experience, or professional standards.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unskilled_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was full of <w>amateur</w> mistakes that should have been caught.",
                            "target_lang_translations": {
                                "ru": "Отчет был полон <w>дилетантских</w> ошибок, которые следовало бы заметить.",
                                "zh": "这份报告里充满了本应被发现的<w>外行</w>错误。"
                            }
                        },
                        {
                            "text": "It was an <w>amateur</w> attempt at plumbing that caused a leak.",
                            "target_lang_translations": {
                                "ru": "Это была <w>дилетантская</w> попытка починить сантехнику, из-за которой случилась протечка.",
                                "zh": "那是一次<w>不专业的</w>管道维修尝试，导致了漏水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "amateur mistake",
                        "amateur hour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий недостаток мастерства, опыта или профессионализма.",
                        "zh": "指表现出缺乏技能、经验或未达到专业标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилетантский",
                                "target_lang_sense_clarification": "поверхностный, неумелый"
                            },
                            {
                                "target_lang_word": "непрофессиональный",
                                "target_lang_sense_clarification": "не соответствующий профессиональным стандартам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外行的",
                                "target_lang_sense_clarification": "指表现得不专业或缺乏相关知识"
                            },
                            {
                                "target_lang_word": "不专业的",
                                "target_lang_sense_clarification": "指未达到应有的专业水准"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}