                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ef18abe-9ea4-4a59-b2f5-f4cd3ec44b26",
                                "sense_id": "c712a1e4-9ac8-32c5-ab8f-d518fedef995",
                                "text": "„Eine wichtige Rolle gerade auch im Themenfeld der wirtschaftlichen Situation spielte der sogenannte »Übertrumpfungswitz«.“"
                            },
                            {
                                "example_id": "0d96719f-7e1f-48c7-a892-813e4c300fb1",
                                "sense_id": "c712a1e4-9ac8-32c5-ab8f-d518fedef995",
                                "text": "„Beide Themenfelder haben mich im Laufe der Jahre an den Rand des Wahnsinns gebracht und mehr Tränen vergießen lassen als manch schreckliche Erfahrung während meiner Flucht.“"
                            }
                        ],
