                        "examples": [
                            {
                                "example_id": "f38b42b4-2a48-4ab6-9fb2-26dd4dc9cb60",
                                "sense_id": "5f79374a-0c68-3f5f-a026-84ceed2f28f1",
                                "text": "Si la fille elle se sonne le piéno, ensauve-toi tout de suite aussinon ti es foutu ! Mieux qu’elle se sonne la tsibomba !"
                            },
                            {
                                "example_id": "67b64024-d49d-4a47-874a-b278c903ceb7",
                                "sense_id": "5f79374a-0c68-3f5f-a026-84ceed2f28f1",
                                "text": "Pour qui s’amuse le petit Pierre et que sa mère elle soye contente, j’y a fait le cerf-volant, une tzibomba, des castagnettes, une fronde qu’avec y s’a cassé deux carreaux, un tuyau pour lancer les noyaux qui s’a fermé un œil à sa governante, la pôvre."
                            }
                        ]
                    }
