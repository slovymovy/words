                ],
                "senses": [
                    {
                        "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                        "entry_id": "62db9875-237f-39e4-b65c-cc2d83e34668",
                        "glosses": [
                            "Mannschaft eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf5fee4-b187-405b-b729-eda7239bc97e",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "Der Kapitän ließ die Schiffscrew an Deck antreten."
                            },
                            {
                                "example_id": "312c538f-bb43-4c99-b1da-69e15b9a43d6",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "Die Schiffscrew eines Containerschiffs kommt oft aus vielen Nationen."
                            },
                            {
                                "example_id": "dfb06a37-c31c-47d6-ba89-87375ae2f289",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Die Schiffscrew versucht ein Dach über das Deck zu bauen, weil immer wieder Wellen über das Hauptdeck schwappen.“"
                            },
                            {
                                "example_id": "19ef679e-c39a-4ce0-9111-a3234932e439",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Die Schiffscrew und sämtliche Dienstleister an Bord bestanden überwiegend aus DDR-Bürgern.“"
                            },
                            {
                                "example_id": "b995590e-76e6-40fc-a3e4-d340eb57ac06",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Die Schiffscrew fährt mit letzter Kraft in sichere Gewässer, in den Oman.“"
                            },
                            {
                                "example_id": "4fed6c27-9ebf-4723-b25f-e54fe2e24f74",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "[…] „eine Schiffscrew ist größer und anders zusammengestellt als die eines Flugzeugs.“"
                            },
                            {
                                "example_id": "ba7debad-1b1a-4883-8259-646a87932b7c",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "[Roald Amundsen:] „Der Schiffscrew teilte er die Routenänderung erst auf See in Höhe von Madeira mit, wobei alle Mitglieder den Plan akzeptierten.“"
                            },
                            {
                                "example_id": "03fcd09d-311c-4a68-996e-8b1e13025a00",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Auch den meisten Mitgliedern der Schiffscrew hat die Fahrt mit den jungen Forschern gut gefallen.“"
                            },
                            {
                                "example_id": "92f1392c-aa9b-4b1b-a000-192a0f98ab01",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Der Kabinenjunge Richard Parker wird am 23. oder 24. Juli 1884 von drei älteren Mitgliedern einer havarierten Schiffscrew gegessen. Seit drei Wochen trieben die Seeleute auf dem Meer und töteten schließlich Parker, der bereits sehr geschwächt war, um dem Hungertod zu entkommen.“"
                            },
                            {
                                "example_id": "c0703811-3210-46cc-b51a-0aeef399e4b1",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„1840 siedelte sich eine philippinische Schiffscrew in Kalk Bay an, nachdem ihr Schiff in der False Bay untergegangen war, und bestritt ihren Lebensunterhalt fortan mit der Fischerei.“"
                            },
                            {
                                "example_id": "4b719008-8fd1-4065-bc06-3b02cc3d6da3",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Langsdorff ließ die Schiffscrew nach Argentinien evakuieren und manövrierte die \"Graf Spee\" in seichtes Gewässer, wo das Schiff am 17. Dezember 1939 gesprengt wurde.“"
                            },
                            {
                                "example_id": "6d04cf80-9ca1-476f-af0e-99c43ed64484",
                                "sense_id": "1e712695-a679-3aac-90c0-3b944ed037b2",
                                "text": "„Das Schiffsunglück hatte in Südkorea für Bestürzung und Empörung gesorgt. Denn bereits kurz danach stand fest, dass viele Menschen hätten gerettet werden können - wenn der Kapitän und die Schiffscrew die Passagiere nicht angewiesen hätten, unter Deck zu bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
