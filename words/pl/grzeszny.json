                },
                {
                    "sense_id": "e46dbecc-eb84-3aa2-aa64-2b18cf27ef72",
                    "sense_definition": "taki, który popełnia grzechy lub postępuje wbrew zasadom moralnym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niemoralny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy <w>grzeszny</w> człowiek ma prawo prosić o przebaczenie swoich win.",
