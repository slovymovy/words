                        "glosses": [
                            "Dose zur Aufbewahrung von Tee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a09c3c8-4cf8-4c5a-8c71-c77b66fe871e",
                                "sense_id": "9ad8a27e-6985-384c-9192-6e12fccb924a",
                                "text": "Loser Tee wird in einer Teedose aufbewahrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
