                ],
                "senses": [
                    {
                        "sense_id": "9a2a3cf1-b034-3e95-b827-74bca48354e8",
                        "entry_id": "d8ccebc0-9f5d-3fd7-a16b-f107f31f01ac",
                        "glosses": [
                            "plötzlich einsetzender Husten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72ab6bf-2e15-4bce-8d8e-f898e3d4c27f",
                                "sense_id": "9a2a3cf1-b034-3e95-b827-74bca48354e8",
                                "text": "„Ein Hustenanfall schnitt die Stimme ab, und als Poulsen wieder sprechen konnte, klang sein Stimme hart und gnadenlos.“"
                            },
                            {
                                "example_id": "b0f7ddfb-9018-4eac-bd02-0498a404f115",
                                "sense_id": "9a2a3cf1-b034-3e95-b827-74bca48354e8",
                                "text": "„Minni war keinen halben Meter von der schwarzen Handtasche entfernt, als sie plötzlich einen Hustenanfall bekam.“"
                            },
                            {
                                "example_id": "f3101600-1101-465c-b9f9-9fdc1206ce93",
                                "sense_id": "9a2a3cf1-b034-3e95-b827-74bca48354e8",
                                "text": "„Jemand erlaubt sich einen fünfminütigen Hustenanfall.“"
                            },
                            {
                                "example_id": "82caa6e2-01d9-4a6f-968a-49d4e92a1552",
                                "sense_id": "9a2a3cf1-b034-3e95-b827-74bca48354e8",
                                "text": "„Die Atemnot hatte sich wieder eingestellt in der letzten Zeit, und trockene Hustenanfälle und Nachtschweiße meldeten sich auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
