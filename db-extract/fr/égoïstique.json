                                "target_senses": [
                                    {
                                        "sense_id": "29026a27-e7af-3b72-8d54-dce0e61d72b5",
                                        "entry_id": "454551ad-2ac6-3334-9592-e0d1f7cbc824",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительными эгоизм, эгоист; проникнутый эгоизмом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893e407d-cc75-4b35-9164-8c3c73a2d2c1",
                                                "sense_id": "29026a27-e7af-3b72-8d54-dce0e61d72b5",
                                                "text": "Она глядела на него, и эгоистическое чувство превосходства любимой женщины над влюблённым приятно ласкало её."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a920d78a-d078-3379-a899-53cb147c5135",
                                        "entry_id": "454551ad-2ac6-3334-9592-e0d1f7cbc824",
                                        "glosses": [
                                            "заботящийся только о себе, о своих личных интересах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43925a73-de0c-4d60-9c80-8c374fa48f6b",
                                                "sense_id": "a920d78a-d078-3379-a899-53cb147c5135",
                                                "text": "Всякий писатель из категории «правых» или «буржуазных» заранее опорачивался в наших глазах, как ретроград и служитель эгоистических интересов, а потому, не доверяя его словам, мы избегали читать его."
                                            }
                                        ]
                                    }
                                ]
                            }
