                                        "entry_id": "0066564a-8064-39e8-9864-56ac27014acf",
                                        "glosses": [
                                            "(etwas, das zumeist wertvoll, unwiederbringlich oder dergleichen ist) unnützerweise, mit Nichtigkeiten verschwenden, vergeuden"
                                        ],
                                        "tags": [
