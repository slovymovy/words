                ],
                "senses": [
                    {
                        "sense_id": "ac9bf378-0a8f-32ab-b6e3-07f2a0baf661",
                        "entry_id": "a1997396-ec3f-3916-b841-2c4268189758",
                        "glosses": [
                            "osoba siejąca ziarno w polu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac85eef-ab86-4684-bca2-2b1108e32234",
                                "sense_id": "ac9bf378-0a8f-32ab-b6e3-07f2a0baf661",
                                "text": "Zaiste, podobnie jak ulewa i śnieg spadają z nieba i tam nie powracają, dopóki nie nawodnią ziemi, nie użyźnią jej i nie zapewnią urodzaju, tak iż wydaje nasienie dla siewcy i chleb dla jedzącego, tak słowo, które wychodzi z ust moich, nie wraca do Mnie bezowocne, zanim wpierw nie dokona tego, co chciałem, i nie spełni pomyślnie swego posłannictwa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "144da5e7-ff2b-3a13-9d51-d2f5dd7cb7a4",
                        "entry_id": "a1997396-ec3f-3916-b841-2c4268189758",
                        "glosses": [
                            "ktoś, kto propaguje, szerzy coś, co ma się rozpowszechnić wśród ludzi"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "52ebe558-cd8f-4e83-9f66-aca275da4413",
                                "sense_id": "144da5e7-ff2b-3a13-9d51-d2f5dd7cb7a4",
                                "text": "Obóz Narodowo-Radykalny stał się konsekwentnym siewcą antysemityzmu, rasizmu biologicznego i darwinizmu społecznego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b3cd8dd-6c84-46db-bb7b-d1d09e08c9a3",
                        "source_entry_id": "a1997396-ec3f-3916-b841-2c4268189758",
                        "source_sense_id": "ac9bf378-0a8f-32ab-b6e3-07f2a0baf661",
