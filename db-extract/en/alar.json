                "forms": [],
                "senses": [
                    {
                        "sense_id": "11f85863-91e2-3670-a2c0-a1fdc3e72a3b",
                        "entry_id": "f267746b-89a3-3c47-993a-e1a72d4cb06d",
                        "glosses": [
                            "of or relating to the armpit; axillary."
                        ],
