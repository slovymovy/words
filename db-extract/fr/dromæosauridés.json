                    {
                        "sense_id": "8a51c068-b171-31b6-a802-dbafb30325f7",
                        "entry_id": "e2f4016b-2ddc-377c-b94d-a69b6a8dd508",
                        "glosses": [
                            "Famille des Dromaeosauridae, de dinosaures théropodes carnivores bipèdes à griffes, couverts de plumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc988b30-a66f-4365-b6cf-890a5d8710e0",
                                "sense_id": "8a51c068-b171-31b6-a802-dbafb30325f7",
                                "text": "Le paradoxe temporel : la plupart des dinosaures théropodes, et en particulier les dromæosauridés ressemblant aux oiseaux, sont tous beaucoup plus récents selon les archives fossiles que l'archæoptéryx."
                            },
                            {
                                "example_id": "84eeb21e-948c-4da2-8735-1844aabd4a4f",
                                "sense_id": "8a51c068-b171-31b6-a802-dbafb30325f7",
                                "text": "Les dromaeosauridés du Crétacé supérieur d’Europe sont considérés comme des survivants d’une faune relativement homogène qui occupait l’Amérique du Nord et l’Europe au début du Crétacé."
                            },
                            {
                                "example_id": "6c284a12-f9fb-4b08-9a27-5d939e809c37",
                                "sense_id": "8a51c068-b171-31b6-a802-dbafb30325f7",
                                "text": "La présence de dromaeosauridés dès le Jurassique moyen a été confirmée par la découverte de dents fossiles isolées, mais aucun corps fossilisé de dromaeosauridé de cette époque n'a été retrouvé."
                            }
                        ]
                    }
