                        "glosses": [
                            "Stérol intermédiaire et précurseur dans la formation du cholestérol, de formule brute C₂₇H₄₄O."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0aa41b4-177c-4c9e-bbf6-769be3aa74ee",
                                "sense_id": "e0173be9-f282-3300-b3f3-8a7c27261f65",
                                "text": "Le zymostérol est oxydé par une enzyme spécifique qui crée une liaison éthylénique par soustraction des hydrogènes des carbones 5 et 6."
                            },
                            {
                                "example_id": "37d4c02e-d59c-4e9f-9f90-3389be41989e",
                                "sense_id": "e0173be9-f282-3300-b3f3-8a7c27261f65",
                                "text": "Les groupes méthyle fixés sur le C₁₄ et le C₄ sont éliminés pour former le 14-desméthyl lanostérol puis le zymostérol."
                            }
                        ]
                    }
