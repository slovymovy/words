                "entry_id": "b80f24a2-a8f7-3e6c-af51-3fd7788d31ad",
                "word": "fournil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4784970a-54b0-4002-97df-f29e9efddae6",
                        "entry_id": "b80f24a2-a8f7-3e6c-af51-3fd7788d31ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "fournils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                        "entry_id": "b80f24a2-a8f7-3e6c-af51-3fd7788d31ad",
                        "glosses": [
                            "Lieu où est le four et où l’on pétrit la pâte ; lieu de travail du boulanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818f23aa-53e1-44d3-8770-b79eb91ff6a0",
                                "sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                                "text": "Je lui ai donné la clef du fournil, et il entre ici en mon absence, bricole un peu partout."
                            },
                            {
                                "example_id": "3e1246c3-402d-4429-a40d-8fb543137a61",
                                "sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                                "text": "C’était uniquement pour le bois qu’il avait construit ce hangar. Le bois du fournil, évidemment, puisqu’en ce temps-là il ne cuisait qu’au bois."
                            },
                            {
                                "example_id": "20968298-8b27-4664-acc5-3bdec80954b1",
                                "sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                                "text": "Malgré l’interdiction, elle se plaisait à descendre en vêtements nocturnes dans le fournil où maintenant il pétrissait la pâte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0e82a1a-6601-4271-8a16-caf454d370b7",
                        "source_entry_id": "b80f24a2-a8f7-3e6c-af51-3fd7788d31ad",
                        "source_sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                        "target_lang_word": "Backstube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Backstube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                        "entry_id": "584ac589-e8ad-34fb-af07-1795f0b3bd54",
                                        "glosses": [
                                            "Raum, in dem die Produkte der Bäckerei und Konditorei hergestellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e05e3c-8d67-4942-a06d-af4476ee099a",
                                                "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                                "text": "In der Backstube stehen mehrere Mehlsäcke."
                                            },
                                            {
                                                "example_id": "34476000-8175-4f8d-aeab-3d3c9029fbab",
                                                "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                                "text": "„Und als die kleine Maus größer wurde, spazierte sie immer heimlich in der Backstube herum.“"
                                            },
                                            {
                                                "example_id": "119835d3-a7bf-4717-af7e-98eb22c1091a",
                                                "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                                "text": "„Die ersten Brote, die bei uns in der Backstube erscheinen, sind blaßgelb und breitgelaufen.“"
                                            },
                                            {
                                                "example_id": "ec95b599-2b9f-46dd-a0d6-2b24c9880833",
                                                "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                                "text": "„In der Backstube läuft schon der Kneter, erst zwei, dann drei Mitarbeiter sind am Werk.“"
                                            },
                                            {
                                                "example_id": "7010948e-1c3a-41df-b3ef-8db4d62a7cbd",
                                                "sense_id": "5e325d72-be33-3893-afe7-a6cfee1b6593",
                                                "text": "„Die mussten hart in Haushalt und Backstube anpacken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caeff44d-fd96-4b16-85ec-c38f2946ef02",
                        "source_entry_id": "b80f24a2-a8f7-3e6c-af51-3fd7788d31ad",
                        "source_sense_id": "b0aeab94-cddc-3faa-ab9d-a8f5e6c06834",
                        "target_lang_word": "bakehouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bakehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                        "entry_id": "01f03fb9-b938-3956-9bbe-23f461b7af27",
                                        "glosses": [
                                            "A building or an apartment used for the preparing and baking of bread and other baked goods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1809b69-c3c4-4fcf-b684-eea572c461ea",
                                                "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                                "text": "And they haue deuised for that purpose to make vs beleue in other vayne thynges by his pardonnes, as to haue remission of sinnes for praiynge on hallowed beades, for drinkyng of the bakehouse bole, as a Channon of Waltam Abbey, once tolde me, that when soeuer they putte theyr loaues of breade into the ouen, as manye as drancke of the pardon bolle shoulde haue pardon for drinckynge of it."
                                            },
                                            {
                                                "example_id": "d0af7d69-86a2-4224-b58b-676499565e35",
                                                "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                                "text": "This third scheme went to the relief of the poor at large, and indeed so did the fourth. One was a plan to sell them bread under the standard price, and the other meat. To carry the first into execution, a water-mill was built, and a bakehouse annexed to it."
                                            },
                                            {
                                                "example_id": "82a5a28b-09a1-4583-b7f6-48a64d001f74",
                                                "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                                "text": "Jude, finding the general attention again centering on himself, went out to the bakehouse, where he ate the cake provided for his breakfast."
                                            },
                                            {
                                                "example_id": "b8453515-facf-43ba-acf8-1a600d1681e4",
                                                "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                                "text": "Fresh bread and doughnuts are still baked in the brick ovens of the old bakehouse behind the village store."
                                            },
                                            {
                                                "example_id": "21d97d41-7ba3-4b7d-9790-a34a528605e2",
                                                "sense_id": "940d2600-6435-3e6d-b243-8e1863b32906",
                                                "text": "2004, Andrea Levy, Small Island, London: Review, Prologue, p. 3,\nGraham helped Father in the shed. He looked after the fire under the copper of pig swill, took the pork pies to the bakehouse when needed and generally ran round doing everything Father asked […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d6fe4c-0475-380d-95b4-b6978cd11b92",
                                        "entry_id": "01f03fb9-b938-3956-9bbe-23f461b7af27",
                                        "glosses": [
                                            "A building principally containing ovens."
                                        ],
