                        "sense_id": "e07c130b-0088-3c99-8670-816f1082dc00",
                        "entry_id": "f4462bbe-1cfe-3b5a-a194-71b405a14af0",
                        "glosses": [
                            "gw. (Warszawa) luźny, skrócony płaszcz męski z dwurzędowym zapięciem, noszony głównie wiosną albo latem"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cb241d53-19b6-49d7-9771-658ac2a06e77",
                                "sense_id": "e07c130b-0088-3c99-8670-816f1082dc00",
                                "text": "Ubrany był w szerokie, wykwintne, lekkie sakpalto, w jasne letnie spodnie, i w ogóle wszystko, co miał na sobie, było eleganckie, wygodne i prosto z igły"
                            },
                            {
                                "example_id": "2c7cc3aa-e455-46a9-ac2a-9e95bde61f8d",
                                "sense_id": "e07c130b-0088-3c99-8670-816f1082dc00",
                                "text": "Obserwował z daleka, gdy mecenas wyszedł z kawiarni, dobrze widoczny w swym eleganckim beżowym sakpalcie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
