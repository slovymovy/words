{
    "word_family": [
        "lachen",
        "lach",
        "lacher",
        "lachbui"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f9a47a94-0a16-3868-80b5-f5e463ec682c",
                    "sense_definition": "Geneigd om snel of veel te lachen, vaak op een giechelige of vrolijke manier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vrolijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De giechelige, <w>lacherige</w> meisjes keken aandachtig naar de uitsloverige jongens.",
                            "target_lang_translations": {
                                "en": "The giggly, <w>giddy</w> girls watched the show-off boys attentively."
                            }
                        },
                        {
                            "text": "Na het horen van de grap hing er een <w>lacherige</w> sfeer in het klaslokaal.",
                            "target_lang_translations": {
                                "en": "After hearing the joke, there was a <w>giggle-filled</w> atmosphere in the classroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "giechelig",
                        "lacherig"
                    ],
                    "antonyms": [
                        "serieus",
                        "ernstig"
                    ],
                    "common_phrases": [
                        "een lacherige sfeer",
                        "lacherig doen"
                    ],
                    "target_lang_definitions": {
                        "en": "Inclined to laugh quickly or a lot, often in a giggly or cheerful manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "giggly",
                                "target_lang_sense_clarification": "inclined to giggle or laugh easily"
                            },
                            {
                                "target_lang_word": "giddy",
                                "target_lang_sense_clarification": "silly and excited, laughing easily"
                            },
                            {
                                "target_lang_word": "laughing",
                                "target_lang_sense_clarification": "cheerful and prone to laughter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58923a26-a9fe-32b6-898a-57fa3adae771",
                    "sense_definition": "Geneigd om te lachen op een spottende, spottend-ongeloovige of spottend-minderwaardige manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed erg <w>lacherig</w> over haar serieuze plannen om een eigen bedrijf te starten.",
                            "target_lang_translations": {
                                "en": "He acted very <w>dismissively</w> about her serious plans to start her own business."
                            }
                        },
                        {
                            "text": "De reactie van het publiek was nogal <w>lacherig</w>, wat de spreker erg onzeker maakte.",
                            "target_lang_translations": {
                                "en": "The audience's reaction was rather <w>mocking</w>, which made the speaker very insecure."
                            }
                        }
                    ],
                    "synonyms": [
                        "spottend",
                        "smalend"
                    ],
                    "antonyms": [
                        "respectvol"
                    ],
                    "common_phrases": [
                        "lacherig doen over"
                    ],
                    "target_lang_definitions": {
                        "en": "Inclined to laugh in a mocking, dismissive, or scoffing manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mocking",
                                "target_lang_sense_clarification": "making fun of someone or something in a cruel way"
                            },
                            {
                                "target_lang_word": "scoffing",
                                "target_lang_sense_clarification": "dismissive and laughing at something with contempt"
                            },
                            {
                                "target_lang_word": "derisive",
                                "target_lang_sense_clarification": "expressing contempt or ridicule"
                            },
                            {
                                "target_lang_word": "dismissive",
                                "target_lang_sense_clarification": "treating something as unworthy of serious consideration"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}