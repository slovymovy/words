                                                "example_id": "9d96b8c8-4610-4800-be72-66a9f75e7c7e",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "我們差不多高。"
                                            },
                                            {
                                                "example_id": "a607c710-43ba-4ab6-889e-7808d7400a9e",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "我们差不多高。"
                                            },
                                            {
                                                "example_id": "f4a82601-e4e6-4da8-965b-227d73842246",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "差不多一個年"
                                            },
                                            {
                                                "example_id": "bb4ecc25-c473-4fc2-a069-af0eb937f770",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "差不多一个年"
                                            },
                                            {
                                                "example_id": "6ef434dc-81cc-4d17-ba59-79ca2ae3035d",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "無仝ê新聞台，竟然lóng報導差不多仝款ê新聞內容，che有影是不可思議ê現象。",
                                                "translation": "不同的新聞台，竟然報導幾乎一樣的新聞內容，這確實是個不可思議的現象。"
                                            },
                                            {
                                                "example_id": "7929055e-6180-46f9-acc6-eebe02082e1a",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "无仝ê新闻台，竟然lóng报导差不多仝款ê新闻内容，che有影是不可思议ê现象。",
                                                "translation": "不同的新聞台，竟然報導幾乎一樣的新聞內容，這確實是個不可思議的現象。"
                                            },
                                            {
                                                "example_id": "b150c1d1-e0bc-49ae-842a-cb033f939cd7",
                                                "sense_id": "7ba3766c-d9ca-319d-8d9e-2f56ff6188e7",
                                                "text": "差不多先生差不多要死的時候"
