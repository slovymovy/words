                                "example_id": "4c631059-5252-41f6-9547-90a1e361aa7f",
                                "sense_id": "d2cdb74a-87de-3a1e-a4c7-ab99edd526f4",
                                "text": "„Das Publikumsinteresse ist so groß, dass regelmäßig illustrierte Reiseberichte erscheinen.“"
                            },
                            {
                                "example_id": "04a1bb97-3212-4afd-9a31-db165ed4017d",
                                "sense_id": "d2cdb74a-87de-3a1e-a4c7-ab99edd526f4",
                                "text": "„Und Fragen nach Art und Herkunft der Wörter finden nun einmal ein großes Publikumsinteresse, so daß viele Sprachkritiker auch das etymologische Pferd reiten – oft genug zu Tode.“"
                            }
