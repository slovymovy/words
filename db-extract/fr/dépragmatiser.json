                "senses": [
                    {
                        "sense_id": "12b98b5e-d0d4-31d7-a017-d034a192cd82",
                        "entry_id": "1ad43580-f483-3551-9952-9043f725f2eb",
                        "glosses": [
                            "Enlever le caractère pragmatique de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300b7dde-2d67-4146-be2a-759f7a6d8eb5",
                                "sense_id": "12b98b5e-d0d4-31d7-a017-d034a192cd82",
                                "text": "C'est la facilité de dépragmatiser, de décontextualiser et la difficulté de repragmatiser."
                            },
                            {
                                "example_id": "6b2e33cd-a8b0-4eb9-bf3d-ef1a973f3c89",
                                "sense_id": "12b98b5e-d0d4-31d7-a017-d034a192cd82",
                                "text": "La métaphysique ne fait qu'élever à l'absolu les relativités de la pratique. Mais si elle en vient à se dépragmatiser, tout se renverse."
                            }
                        ]
                    }
