                ],
                "senses": [
                    {
                        "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                        "entry_id": "eb9bda91-84cb-3f85-a975-911670b391f7",
                        "glosses": [
                            "Boden, der im Laufe der Zeit durch einen Fluss angeschwemmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a6c58b-2c12-414a-8500-dc224e6819ee",
                                "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                                "text": "„Wie bereits erwähnt, ist der von St. Martin (Innviertel) zur Untersuchung entnommene, dort als typischer Schlier bezeichnete Boden kein Verwitterungsboden, sondern ein Niederungs-, ein Anschwemmungs- oder Flussmarschboden, ein von Gesteinsgrus und grobem Sand freier, feinsandiger und gleichartiger, humoser, trocken grau gefärbter Tonmergelboden.“"
                            },
                            {
                                "example_id": "8d1b78ff-91a8-4210-a029-63fc3683b074",
                                "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                                "text": "„Die in Rede stehende Untersuchung ergab: […] d. h. nicht mehr als in guter Kultur stehende Ackerkrumen und Flussmarschboden ganz gewöhnlich enthalten.“"
                            },
                            {
                                "example_id": "12e0e9a7-9ddd-4d1c-aa90-1c4d76b466b0",
                                "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                                "text": "„Von dem Flussmarschboden (Braakmoorboden) unterscheidet sich der Seemarschboden insbesondere dadurch, dass ersterer mehr zerriebenes Gestein und Eisenoxyd, Rollkörner von glasigem Quarz und Xichm als Bindemittel enthält.“"
                            },
                            {
                                "example_id": "c14add91-0ff6-47ed-b067-e6cfbc461259",
                                "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                                "text": "„Folgende Analysen, von denen A. die Bestandtheile eines Flussmarschbodens aus der Wesermarsch bei Hoya nach Sprengel, B. die Bestandtheile des Nilschlammes nach Girard, C. die Zusammensetzung von Marschen aus dem Oderbruche nach Crome zeigt, werden dies bestätigen.“"
                            },
                            {
                                "example_id": "43390902-0f63-4462-b55c-198b65a97ccd",
                                "sense_id": "9a098461-e9a0-34bf-beb8-885ae8b831b0",
                                "text": "„Um charakteristische Proben von Flussmarschböden der Elbe zu gewinnen, wählte er das Marschland der sog. Seehausener Wische (Wiese).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
