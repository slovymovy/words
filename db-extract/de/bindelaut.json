                "senses": [
                    {
                        "sense_id": "50944c42-4db3-30ab-b6bb-79bddedf257d",
                        "entry_id": "e9b3af52-6ee8-3422-95d7-fefda1be78aa",
                        "glosses": [
                            "andere Bezeichnung für Gleitlaut, das heißt für den zweiten, konsonantischen Bestandteil von Diphthongen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d9aa5d-bf42-4fc3-99df-ca7b064c0f1b",
                                "sense_id": "50944c42-4db3-30ab-b6bb-79bddedf257d",
                                "text": "Der zweite Bestandteil von Diphthongen (deutsche Diphthonge: [aɪ̯], [aʊ̯], [ɔɪ̯] und [ʊɪ̯]) ist ein Bindelaut (Übergangslaut) und kein reiner Vokal, was in der Lautschrift (Transkription) mit dem kleinen Bogen unter ihm angezeigt wird."
                            },
                            {
                                "example_id": "47913137-bffe-4ebd-81bd-eb439530ce4e",
                                "sense_id": "50944c42-4db3-30ab-b6bb-79bddedf257d",
                                "text": "„Dieser Bindelaut ist nicht unbedingt obligatorisch, aber wir wollen uns den Versuch ersparen, für seinen Gebrauch genaue Regeln aufzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca2744de-47dd-4c07-966a-877ad3be9241",
                        "source_entry_id": "e9b3af52-6ee8-3422-95d7-fefda1be78aa",
                        "source_sense_id": "50944c42-4db3-30ab-b6bb-79bddedf257d",
                        "source_sense_description": "andere Bezeichnung für Gleitlaut (zweiter, konsonantischer Bestandteil von Diphthongen)",
                        "target_lang_word": "glide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To move softly, smoothly, or effortlessly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e99af96-d036-43f5-aec0-e0d27c1598b6",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The river glideth at his own sweet will:"
                                            },
                                            {
                                                "example_id": "107c0741-19cd-47d4-adb5-587cacc21218",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "It is odd how easily the common-places of morality or of sentiment glide off in conversation. Well, they are \"exceedingly helpful,\" and so Lord Avonleigh found them."
                                            },
                                            {
                                                "example_id": "126f4aed-cffa-4fad-8ebc-81c71a4def0c",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The water over which the boats glided was black and smooth, rising into huge foamless billows, the more terrible because they were silent."
                                            },
                                            {
                                                "example_id": "187ceac6-f2ce-4a45-ae44-678a405c5957",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "But it was 37-year-old Giggs who looked like a care-free teenager as he glided across the pitch he knows so well to breathtaking effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To fly unpowered, as of an aircraft. Also relates to gliding birds and flying fish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022507fa-3c3d-40db-85d2-04867e856d90",
                                                "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f357a393-8dc0-309d-a7d6-d78f2282d84c",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To cause to glide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9389a0b-a587-351c-b292-7a646b56b138",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To pass with a glide, as the voice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
