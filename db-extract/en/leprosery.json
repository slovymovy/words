                    {
                        "translation_id": "37a51cd6-712e-493c-84fc-51c0856e78cd",
                        "source_entry_id": "5831ab6b-44a1-305a-af18-50af9a969194",
                        "source_sense_id": "46bf88d3-94ca-3825-a9be-9a624926f1b2",
