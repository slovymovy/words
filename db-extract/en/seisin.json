                                "target_senses": [
                                    {
                                        "sense_id": "b7bc151a-8baf-3e8c-9b45-40c02973b7ba",
                                        "entry_id": "36988fb4-ab04-36db-98b9-db6101d4a781",
                                        "glosses": [
                                            "nog een keer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e37b29a-cfed-4eea-80ae-95626f057b3e",
                                                "sense_id": "b7bc151a-8baf-3e8c-9b45-40c02973b7ba",
                                                "text": "Weer wordt een volk gehersenspoeld door een autoritaire regering\nWeer worden jonge soldaten gestuurd naar zinloze acties\nWeer komen zij terug in lijkenzakken of met afgehakte ledematen\nWeer moeten miljoenen burgers vluchten uit hun vertrouwde omgeving\nWeer viert het fervente nationalisme hoogtij"
                                            },
                                            {
                                                "example_id": "b7e4b56a-d664-49a7-99a8-fde75408e30b",
                                                "sense_id": "b7bc151a-8baf-3e8c-9b45-40c02973b7ba",
                                                "text": "Het vernieuwde Hoofdstation van Groningen moet op 13 juli weer volledig opengaan."
                                            },
                                            {
                                                "example_id": "dc382196-d404-49d9-839e-7501fb0eb702",
                                                "sense_id": "b7bc151a-8baf-3e8c-9b45-40c02973b7ba",
                                                "text": "Het KNGMG hoopt dat er nog gesprekken volgen met de vele instituten en bedrijven in binnen- en buitenland die gebruikmaken van de kennis en faciliteiten van de VU. \"We begrijpen dat de kosten hoog zijn voor de VU, en dat er financiële problemen zijn, maar dit is rücksichtslos. Dit moet je niet zelfstandig als instituut doen. Verschillende organisaties willen het gesprek aangaan. Verken nu eerst goed samen wat de mogelijkheden zijn voordat je iets afbreekt dat je niet snel weer opbouwt.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d53f98-188e-3722-b167-e73310d86a7a",
                                        "entry_id": "36988fb4-ab04-36db-98b9-db6101d4a781",
                                        "glosses": [
                                            "van de andere kant (vaak als eerste deel van samenstellingen als weerspraak en weerstrijd)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
