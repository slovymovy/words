                    {
                        "translation_id": "97810dfa-b3a6-4419-938c-fc0351e074d3",
                        "source_entry_id": "82e7d41e-bb19-3744-8983-c4907e2788a7",
                        "source_sense_id": "cae5da1a-b0cd-3684-bd81-8852b8b85684",
