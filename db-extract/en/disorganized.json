                "senses": [
                    {
                        "sense_id": "25c88d65-dda5-3f64-a6f7-24ac47de440c",
                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                        "glosses": [
                            "Lacking order or organization; confused; chaotic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f6984e-9bf4-411c-b15b-29b0b2b3f522",
                                "sense_id": "25c88d65-dda5-3f64-a6f7-24ac47de440c",
                                "text": "If we fail to repulse the enemy within the gates--unemployment, poverty, disorganized agriculture and the like--from whence may we expect the united strength and clear purpose to repulse any outside force?"
                            }
                        ]
                    },
                    {
                        "sense_id": "46e3e48c-3bb9-32f3-8cc9-d18dd123c976",
                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                        "glosses": [
                            "Lacking skills for organizing one's affairs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faaeff37-1389-40a1-8913-d5e8adde91fe",
                                "sense_id": "46e3e48c-3bb9-32f3-8cc9-d18dd123c976",
                                "text": "He is quite disorganized and has difficulty planning his day or remembering when his homework is due."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b483b0d-3acb-37c5-a67f-0dae6d9f37eb",
                        "entry_id": "f5890065-ac8b-3386-8831-853c8bde2510",
                        "glosses": [
                            "In a state of disruption of orderly psychological functioning; engaging in behavior that is chaotic, self-contradictory, or out of keeping with reality; (of a mental illness) poorly controlled and leading to a disorganized state."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
