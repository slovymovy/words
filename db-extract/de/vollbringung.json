                "senses": [
                    {
                        "sense_id": "7d0f0763-7987-38bb-aed9-027b8fac0900",
                        "entry_id": "25d1674a-c97c-34c7-bd25-ede5eae7daf0",
                        "glosses": [
                            "Handlung, Vorgang, etwas zu einem Abschluss zu bringen, zu leisten oder zu verwirklichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45e8c45-4ae5-4cd5-94ee-77074080550f",
                                "sense_id": "7d0f0763-7987-38bb-aed9-027b8fac0900",
                                "text": "„Nach Vollbringung des Werks gab die Autorin nur eine Audienz.“"
                            },
                            {
                                "example_id": "24fd9303-eaf1-442e-8d3e-c4b90e905277",
                                "sense_id": "7d0f0763-7987-38bb-aed9-027b8fac0900",
                                "text": "„Die Vollbringung des Preises ist abhängig von der erfolgreichen Unterzeichnung des Dokuments.“"
                            },
                            {
                                "example_id": "909bc369-4148-433a-87a5-85bd77e89b97",
                                "sense_id": "7d0f0763-7987-38bb-aed9-027b8fac0900",
                                "text": "„Auch die Vollbringung eines Wunders, weitere Voraussetzung für eine Seligsprechung, galt endlich als gegeben.“"
                            },
                            {
                                "example_id": "67f3bae7-16e6-41e2-a8f1-aa295685885d",
                                "sense_id": "7d0f0763-7987-38bb-aed9-027b8fac0900",
                                "text": "„Schon der Versuch einer Übeltat ist das Verbrechen, sobald der Bösgesinnte eine zur wirklichen Ausübung führende Handlung unternommen hat, die Vollbringung des Verbrechens aber nur wegen Unvermögenheit, wegen Dazwischenkunft eines fremden Hindernisses oder durch Zufall unterblieben ist.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
