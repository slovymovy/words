                                        "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Signifying something; carrying meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d50083ca-d662-4c0b-8221-6eff7a5557ae",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "a significant word or sound"
                                            },
                                            {
                                                "example_id": "d2c50b8b-740b-4b4d-b003-551560ec7572",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "a significant look"
                                            },
                                            {
                                                "example_id": "0ff2e66a-4b93-497b-ac15-80a4e7764b56",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "It was well said of Plotinus, that the stars were significant, but not efficient."
                                            },
                                            {
                                                "example_id": "0f716830-4a7a-49c0-8ae4-2840195b3939",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "As evening came on, it grew prematurely dark and cloudy; while the waves acquired that dull indigo tint so significant of ugly weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Having a noticeable or major effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e55726-65d0-4ddf-9544-0a5f74ec75c9",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "That was a significant step in the right direction."
                                            },
                                            {
                                                "example_id": "47cbac15-bf4a-4dda-82ae-98c75a24291c",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "The First World War was a significant event."
                                            },
                                            {
                                                "example_id": "462558ce-eda5-4528-a32f-318cf6f05823",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "The “little green men”—faces covered, wearing unmarked olive uniforms, speaking Russian and using Russian weapons—have played a significant role in both the occupation of Crimea and the civil war in eastern Ukraine.¹⁹⁶"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6b8afd-20b7-3342-a1a9-c72d63c7becc",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Reasonably large in number or amount."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a5a22a1-bca2-3b43-8a25-e74996d5fb33",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Having a covert or hidden meaning."
                                        ],
