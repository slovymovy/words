                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "948c5d50-dff7-3b42-9f14-8be1c48ad97e",
                                        "entry_id": "e5c5f83e-3e73-3e0b-9bff-f2432c43e721",
                                        "glosses": [
                                            "A white crystalline compound used in medicine as an anodyne to relieve pain and reduce fever."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac85f7e0-9cc8-4a00-96dc-0c20ca279550",
                                                "sense_id": "948c5d50-dff7-3b42-9f14-8be1c48ad97e",
                                                "text": "You need to take acetaminophen / Or just a little aspirin / acetylsalicylic for the pain"
                                            },
                                            {
                                                "example_id": "bbd3e90d-5ed3-4f01-8183-b7833fa24d7d",
                                                "sense_id": "948c5d50-dff7-3b42-9f14-8be1c48ad97e",
                                                "text": "“I [have] actually witnessed a resident have to be taken to the emergency room because of acetaminophen toxicity,” Lee recalls. “I was pushed to find a solution because I wanted to help the residents who I volunteer for.”"
                                            },
                                            {
                                                "example_id": "f6eb0110-df7d-490c-ac23-59664f074107",
                                                "sense_id": "948c5d50-dff7-3b42-9f14-8be1c48ad97e",
                                                "text": "Top U.S. health officials urged pregnant women not to use acetaminophen, the active ingredient in Tylenol, claiming it could cause autism, though studies have been inconclusive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
