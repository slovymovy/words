                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a acheté un nouveau <w>complet</w> bleu marine pour assister à une cérémonie officielle."
                        },
                        {
                            "text": "Cet homme porte toujours un <w>complet</w> élégant lorsqu'il se rend à son travail."
                        }
                    ],
                    "synonyms": [
                        "complet-veston",
                        "costard",
                        "costume",
                        "veston-cravate"
                    ],
                    "common_phrases": [
