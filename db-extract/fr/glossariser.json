                "senses": [
                    {
                        "sense_id": "5c9a8aa0-ec02-31eb-9da8-9110496cf94a",
                        "entry_id": "fb7ddb78-643b-33aa-8987-25274287a28f",
                        "glosses": [
                            "Définir sous forme de glossaire, réaliser un glossaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8be0804-975c-45ee-ac2d-2d06e08fa648",
                                "sense_id": "5c9a8aa0-ec02-31eb-9da8-9110496cf94a",
                                "text": "Ou encore, les contributeurs MOA nommés ne sont pas en capacité de glossariser l'ensemble des droits de leur périmètre applicatif."
                            },
                            {
                                "example_id": "4287c05c-dc20-4ce6-b0a1-5ae1e37b3961",
                                "sense_id": "5c9a8aa0-ec02-31eb-9da8-9110496cf94a",
                                "text": "On ne désespère pour autant car, à \" glossariser \", on vérifie qu'un savoir s'est déposé que nous parlons sans savoir."
                            },
                            {
                                "example_id": "b3df0d7a-2343-4b4b-aceb-085e3e33e2d8",
                                "sense_id": "5c9a8aa0-ec02-31eb-9da8-9110496cf94a",
                                "text": "Merci Catherine, c'est aussi ce que je me suis dit en découvrant cette entrée ce matin, mais seuls le demandeur et celui dont la réponse a été choisie sont autorisés à \"glossariser\", on peut tout au plus laisser une note ;-))"
                            }
                        ]
                    }
