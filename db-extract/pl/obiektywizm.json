                                                "text": "maintain objectivity"
                                            },
                                            {
                                                "example_id": "cc371a79-ca3a-4c4d-bab0-fdcceca09d7a",
                                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                                "text": "sense of objectivity"
                                            },
                                            {
                                                "example_id": "0c9723d3-31ca-4dca-961a-bdc3c8d21059",
                                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                                "text": "The scientist’s objectivity was questioned after the funding controversy."
                                            },
                                            {
                                                "example_id": "c73f2e30-f1f0-4930-9942-6f066761b2ef",
                                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                                "text": "Good journalism requires strict objectivity."
                                            }
                                        ]
                                    },
