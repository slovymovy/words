                                "target_senses": [
                                    {
                                        "sense_id": "d5a5b3c0-3d40-3e97-a593-bb68857d716f",
                                        "entry_id": "f89a36cd-901e-36c3-9f5c-df3b33a3e2ae",
                                        "glosses": [
                                            "A small fish, the dace"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
