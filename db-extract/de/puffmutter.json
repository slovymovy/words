                        "sense_id": "bdaa6e75-152a-383b-a193-ead9f01c0261",
                        "entry_id": "da57dccf-118f-34c7-b084-197f473053bd",
                        "glosses": [
                            "woman who owns or looks after a brothel; a madam"
                        ],
                        "tags": [
                            "feminine",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "372407ce-04ca-42e8-bab2-44a24515bad2",
                                "sense_id": "bdaa6e75-152a-383b-a193-ead9f01c0261",
                                "text": "Die Puffmutter liegt an der Spitze, die Spanier, der schwule Bretone, ich, reißen, schnippeln, bluten hinterher, der Sohn fährt mit Pferden vor.",
                                "translation": "The madam leads the way, while the Spaniards, the gay Breton and I tear, snip, and bleed behind, as the son drives up with his horses.",
                                "english": "The madam leads the way, while the Spaniards, the gay Breton and I tear, snip, and bleed behind, as the son drives up with his horses."
                            }
                        ]
                    }
