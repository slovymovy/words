                        "target_lang_word": "Pomp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pomp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4028f6d6-34af-3087-ba4d-cc3a66a9e941",
                                        "entry_id": "b12aca2d-a55d-3dee-994f-ae9bc4d65474",
                                        "glosses": [
                                            "übertriebene, der Schaustellung dienende Pracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138bbd8e-e250-4a68-9006-3a539c179a24",
                                                "sense_id": "4028f6d6-34af-3087-ba4d-cc3a66a9e941",
                                                "text": "Die Hochzeit wurde mit großem Pomp gefeiert."
                                            },
                                            {
                                                "example_id": "c46a1ad4-c54f-4233-abce-e289993cebea",
                                                "sense_id": "4028f6d6-34af-3087-ba4d-cc3a66a9e941",
                                                "text": "„Erst die Pietà, die gewaltige Kraft barmherziger Liebe, versöhnte mich mit dem gesalbten gottverlassenen Pomp der heiligen Halle.“"
                                            },
                                            {
                                                "example_id": "6530b22a-d872-4a67-85be-aaea04e63433",
                                                "sense_id": "4028f6d6-34af-3087-ba4d-cc3a66a9e941",
                                                "text": "„In seinem Wesen, das allem Pomp abhold war, glich er am ehesten einem indischen Heiligen, einem erwählten Guru.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47b7b44d-cb9a-4792-9a66-a5577b1ec610",
                        "source_entry_id": "30a33f89-bdd5-3f64-b7b4-f5942cc05a69",
                        "source_sense_description": "ostentation",
                        "target_lang_word": "Prunk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prunk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                                        "entry_id": "68a23470-1ac9-34fe-b7f8-5a1500f26354",
                                        "glosses": [
                                            "zur Schau gestellter Reichtum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d59bebf-554f-4a1d-ba8a-d9474e698e2c",
                                                "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                                                "text": "„Abt Mathias Fink, der auch Geheimschreiber Kaiser Friedrichs war und großes Ansehen genoss, legte jedoch viel Wert auf Prunk.“"
                                            },
                                            {
                                                "example_id": "91d302c2-5f1e-4095-9d0d-f64ddfce231c",
                                                "sense_id": "e6e33d35-d79d-395f-9372-c82b3fd652d1",
                                                "text": "„Das ist die Quintessenz dessen, was auch Sade bei seinem Aufenthalt in Neapel oder durch spätere Berichte erfahren haben dürfte: Sittenlosigkeit, Armut auf der einen, Prunk auf der anderen Seite, grausame Neigungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5d81ce4-51d3-4e29-ad69-4ea0ee4ee4b4",
                        "source_entry_id": "30a33f89-bdd5-3f64-b7b4-f5942cc05a69",
                        "source_sense_description": "ostentation",
                        "target_lang_word": "Pracht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f565f5-b41b-3200-8d26-15b724d81feb",
                                        "entry_id": "a4916c69-2109-33d8-a1f6-929afab4206b",
                                        "glosses": [
                                            "optisch überwältigender Zustand; enorme oder üppige Schönheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e51fec-0649-41d4-a7bd-2cd9fd9e3378",
                                                "sense_id": "c6f565f5-b41b-3200-8d26-15b724d81feb",
                                                "text": "Nur mit einem HD-Fernseher kann man die Grafik in ihrer vollen Pracht erleben."
                                            },
                                            {
                                                "example_id": "e4a91228-9900-4927-85c2-185367173cba",
                                                "sense_id": "c6f565f5-b41b-3200-8d26-15b724d81feb",
                                                "text": "„Ob die in Deutschland festgestellten vorrömischen Tempelgebäude die Pracht der gallischen Anlagen erreicht haben, ist noch ungewiss.“"
                                            },
                                            {
                                                "example_id": "5f07c863-c797-4425-a9f3-dd740f133044",
                                                "sense_id": "c6f565f5-b41b-3200-8d26-15b724d81feb",
                                                "text": "„Aber sie wissen auch, dass den städtischen Residenzen des frühen 16. Jahrhunderts eine Zukunft bevorstand, von deren barocker Pracht sich kein Landesfürst der Lutherzeit eine Vorstellung machen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc6f726-897a-4916-8eef-1a0d74f368c4",
