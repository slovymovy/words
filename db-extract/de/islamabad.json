                ],
                "senses": [
                    {
                        "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                        "entry_id": "585bbe01-6d67-3036-aad4-165c007ad13a",
                        "glosses": [
                            "Hauptstadt von Pakistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a448f0c-eb0f-4545-8b48-da73eab0c2b0",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„1961 hatte Ayub mit Islamabad eine neue Hauptstadt im Herzen der punjabischen Region Potwar gegründet; diese lag nicht von ungefähr in direkter Nachbarschaft von Rawalpindi, wo sich das militärische Oberkommando befand.“"
                            },
                            {
                                "example_id": "ea5acb67-c2e7-4df3-ae65-88788e158b06",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„Arnold Raphel war einer der Menschen in Islamabad, dessen Lebensqualität sich nach General Zias Verschwinden aus der Politik sicherlich verbessert hätte.“"
                            },
                            {
                                "example_id": "a71a4c3c-2ff9-4ede-825d-583c47099b85",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„Die Politik in Washington, die Politik in Kabul, die Politik in Islamabad. Irgendjemand in D.C. vertrat stets die Ansicht, dass es einen anderen empfindlich stören dürfte, wenn bekannt wurde, dass amerikanische Truppen in Pakistan herumliefen.“"
                            },
                            {
                                "example_id": "bf1f9a26-36d1-4116-8b37-baa028eadf00",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„Von der Madrasa aus waren sie im Konvoi nach Islamabad gefahren und hatten dort ein mit russischen Schriftzeichen beklebtes Flugzeug nach Kenia genommen.“"
                            },
                            {
                                "example_id": "3b9fc74d-78ab-4bfb-be12-a39ee4c222a0",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„Er wird mit seiner Familie noch einmal zu Abend essen, dann wird er in sein Computerlabor in Islamabad zurückkehren, und seine Brüder Nazir und Karimullah werden wieder ihren Kampf aufnehmen.“"
                            },
                            {
                                "example_id": "993e58ad-96aa-4217-814e-9e39eb2f7347",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„Offizielle Mitteilungen an ausländische Botschaften in Islamabad werden meistens von pakistanischen Beratern diktiert.“"
                            },
                            {
                                "example_id": "edb807ee-ef71-416c-8180-10b6fda3a2d9",
                                "sense_id": "838bcdfa-4e5b-3c23-8473-122f7f6d95bf",
                                "text": "„›Wann kehrst du nach Islamabad zurück?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
