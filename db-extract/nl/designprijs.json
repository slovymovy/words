                        "examples": [
                            {
                                "example_id": "0962483b-4d7a-40d5-be97-5e452cc6dccd",
                                "sense_id": "d857e286-9d9e-30b7-8f68-608401821127",
                                "text": "Lundgrens uitgangspunt bij het ontwerpen was dat de meubels voor veel mensen geschikt moesten zijn, zei de Zweed toen hem in 2012 een designprijs werd uitgereikt. \"Mijn producten zijn simpel, praktisch en door iedereen te gebruiken, ongeacht leeftijd een leefsituatie.\""
                            },
                            {
                                "example_id": "9ae0358b-34e3-4ab7-beed-8a1bf31c47a6",
                                "sense_id": "d857e286-9d9e-30b7-8f68-608401821127",
                                "text": "Een bedrijf uit Delft heeft een Duitse designprijs gewonnen voor een nieuw model condoom. De Wingman maakt het makkelijker om het voorbehoedsmiddel om te doen."
                            },
                            {
                                "example_id": "6c24ff2e-83fc-4e6e-af20-8c4992b8e246",
                                "sense_id": "d857e286-9d9e-30b7-8f68-608401821127",
                                "text": "De Red Dot is de grootste internationale designprijs ter wereld. De inzendingen worden elk jaar beoordeeld door een internationale jury. Grote bedrijven als Apple, Nike en BMW gingen Yalp al voor als winnaars."
                            }
                        ]
                    }
