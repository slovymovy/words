                                                "sense_id": "6a5f21d1-7e35-315b-9f07-08975623709b",
                                                "text": "Ars amatoria è il capolavoro della poesia erotica italiana"
                                            },
                                            {
                                                "example_id": "71978325-509f-461f-a105-d96c859a99cc",
                                                "sense_id": "6a5f21d1-7e35-315b-9f07-08975623709b",
