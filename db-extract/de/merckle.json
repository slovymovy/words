                ],
                "senses": [
                    {
                        "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                        "entry_id": "424cb843-8dbb-3f3c-847a-47c0edb7f227",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54966818-9d5d-4ea5-8bed-890641b8e5d5",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Frau Merckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "22031367-40cc-43e0-b278-9dbd799c745a",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Herr Merckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d0add71a-c85e-47f1-b351-6d2c96edeffc",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Die Merckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5215a747-468f-4adc-86d0-44f5b82491db",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Der Merckle trägt nie die Schals, die die Merckle ihm strickt."
                            },
                            {
                                "example_id": "f24aedcb-4acf-4508-8552-73ac65228853",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Merckle kommt, geht der Herr Merckle.“"
                            },
                            {
                                "example_id": "29fe9d6f-c4f7-45ec-95ac-ba5668530026",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Merckle kommt und geht."
                            },
                            {
                                "example_id": "00a8559c-bc78-42b5-b110-4585e45fc0d3",
                                "sense_id": "ef705149-0716-3ab2-8a34-703af62db909",
                                "text": "Merckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
