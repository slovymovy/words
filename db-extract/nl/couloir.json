                        "examples": [
                            {
                                "example_id": "f41ccbf8-0091-4e9a-93a4-2fbd137a8845",
                                "sense_id": "c674da53-bd05-382a-b080-efc47054742a",
                                "text": "Hier beginnen twee skiroutes én krijg je toegang tot de zeventig procent steile Nordhang, een berucht off-pisteterrein inclusief couloirs."
                            },
                            {
                                "example_id": "348282f6-7d54-42df-b126-bafb868629f1",
                                "sense_id": "c674da53-bd05-382a-b080-efc47054742a",
                                "text": "Draai jij je hand niet om voor couloirs en steile off-piste stroken? Schrijf je dan in voor King of the Mountain in Andermatt! Het idee is simpel, de uitvoering een stuk minder; zo snel mogelijk naar de finish op je (telemark)ski’s of snowboard."
                            },
                            {
                                "example_id": "7983c026-9c4f-441e-8120-1ae81ff0445d",
                                "sense_id": "c674da53-bd05-382a-b080-efc47054742a",
                                "text": "Een 48-jarige klimmer raakte op de Couloir Coolidge de controle kwijt en schoof 300 meter omlaag."
                            }
                        ]
                    }
