        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d04420fa-2247-3262-9422-df20d95ca2cb",
                    "sense_definition": "voltooid deelwoord van <w>verheugen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er waren veel bekende gezichten en ik was vooral <w>verheugd</w> om Savage weer te zien.",
                            "target_lang_translations": {
                                "en": "There were many familiar faces and I was especially <w>glad</w> to see Savage again.",
                                "fr": "Il y avait beaucoup de visages connus et j'étais particulièrement <w>content</w> de revoir Savage."
                            }
                        },
                        {
                            "text": "Zij heeft zich enorm <w>verheugd</w> op de komst van haar kleinkind.",
                            "target_lang_translations": {
                                "en": "She was <w>looking forward</w> immensely to the arrival of her grandchild.",
                                "fr": "Elle s'est énormément <w>réjouie</w> de l'arrivée de son petit-enfant."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of the verb 'verheugen' (to look forward to / to make happy)",
                        "fr": "participe passé du verbe 'verheugen' (se réjouir / réjouir)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pleased",
                                "target_lang_sense_clarification": "happy to see or experience something"
                            },
                            {
                                "target_lang_word": "delighted",
                                "target_lang_sense_clarification": "very happy to do or see something"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "réjoui",
                                "target_lang_sense_clarification": "participe passé de réjouir ou se réjouir"
