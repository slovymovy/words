                "senses": [
                    {
                        "sense_id": "c78700ec-29c3-394e-9eb7-c9999998cdc3",
                        "entry_id": "7ff4faa4-09a5-33f0-9b40-53f0cbaf2714",
                        "glosses": [
                            "cecha tego, co wydajne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbcb7e2f-549b-4262-aa09-b71959ab14fa",
                                "sense_id": "c78700ec-29c3-394e-9eb7-c9999998cdc3",
                                "text": "Proces tworzenia ściegu wiąże się z warunkami pracy nici szwalnej, gdyż ciągłe podnoszenie wydajności maszyn i ich szybkości powoduje, że nić jest najsłabszym i najbardziej zawodnym elementem procesu […]"
                            },
                            {
                                "example_id": "1d514f80-556f-474d-b700-a590332dfd77",
                                "sense_id": "c78700ec-29c3-394e-9eb7-c9999998cdc3",
                                "text": "Nowoczesne dyski twarde mają czujniki temperatury i samoregulują się, aby osiągnąć optymalną wydajność w danej temperaturze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08df859f-82f1-4b33-8094-0ee9d185b640",
                        "source_entry_id": "7ff4faa4-09a5-33f0-9b40-53f0cbaf2714",
                        "source_sense_id": "c78700ec-29c3-394e-9eb7-c9999998cdc3",
                        "target_lang_word": "efficiency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efficiency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4285f105-23fb-3561-9a98-da9f845ec66f",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c612d17-dfa1-453d-a9db-aacdab9721bb",
                                                "sense_id": "4285f105-23fb-3561-9a98-da9f845ec66f",
                                                "text": "In a letter DeJoy sent to Congress on Thursday, he said DOGE teams will “assist us in identifying and achieving further efficiencies,” saying the Elon Musk-led agency will focus on improving the management of USPS retirement assets and the Workers’ Compensation Program, as well as addressing the agency’s legislative mandates and regulatory requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b28e21b5-ed38-3159-87f7-30ba094282a6",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose.",
                                            "The ratio of useful work to energy expended. Often given the symbol η."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8e15ee-8ff6-4bb1-b06c-7f29e26b6922",
                                                "sense_id": "b28e21b5-ed38-3159-87f7-30ba094282a6",
                                                "text": "The efficiency of this loudspeaker is 40%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose.",
                                            "The extent to which time is well used for the intended task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c1244f-8f30-4544-9358-dfd14a604f9b",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "The efficiency of the planning department is deplorable."
                                            },
                                            {
                                                "example_id": "830af234-5fc2-4f0f-8d70-c43a62e18110",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "Even at the busiest periods, an air of quiet orderliness pervades the hall, and the first impression gained by the traveller is one of efficiency, neatness and cleanliness."
                                            },
                                            {
                                                "example_id": "3c5361e7-a0a9-475d-abfc-7fbcc1ca081f",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "The display and result must be placed in the context that was it was against a side that looked every bit their Fifa world ranking of 141 - but England completed the job with efficiency to record their biggest away win in 19 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b16e98-f747-3755-9cf1-6d56f4687eb8",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The quality of producing an effect or effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a3dc20-ca48-4bbb-80c0-7b08b628f0bc",
                                                "sense_id": "77b16e98-f747-3755-9cf1-6d56f4687eb8",
                                                "text": "The manner of this divine efficiency being far above us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad78a281-2c6d-3137-a10d-9ef9245c82b2",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "A one-room apartment."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283a4014-a0a8-4b6f-8a77-847975e2f289",
                                                "sense_id": "ad78a281-2c6d-3137-a10d-9ef9245c82b2",
                                                "text": "I have an efficiency available June through July."
                                            },
                                            {
                                                "example_id": "7139214c-0e01-42b8-9ee7-b800dc167f52",
                                                "sense_id": "ad78a281-2c6d-3137-a10d-9ef9245c82b2",
                                                "text": "fully-furnished efficiencies"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a184af06-4f34-41c2-bc96-0eba8a93e289",
                        "source_entry_id": "7ff4faa4-09a5-33f0-9b40-53f0cbaf2714",
                        "source_sense_id": "c78700ec-29c3-394e-9eb7-c9999998cdc3",
                        "target_lang_word": "эффективность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эффективность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a0f7e8-64ad-367a-a5bf-be269f46d386",
                                        "entry_id": "bef38d25-b73e-3b12-af6e-83f440826af1",
                                        "glosses": [
                                            "свойство по значению прилагательного эффективный; способность приводить к нужным результатам; действенность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2cef17a-afa2-4d37-b27c-8dd64da70cd0",
                                                "sense_id": "c9a0f7e8-64ad-367a-a5bf-be269f46d386",
                                                "text": "Первые результаты наблюдений за работой систем и оборудования подтверждают технико-экономические параметры, заложенные в проекте, а также эффективность его использования в пригородных и местных сообщениях. ❬…❭ Эффективность электропоездов может возрасти при внедрении систем бесконтактного регулирования на базе полупроводниковых преобразователей, обеспечивающих плавный безреостатный пуск и рекуперативное торможение практически до остановки поезда."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
