                "senses": [
                    {
                        "sense_id": "b1f039c7-5efe-35da-8c28-62fa41f0489a",
                        "entry_id": "93333968-7c87-3202-88ce-9a44f19e4937",
                        "glosses": [
                            "Themenbereich, auf den man einwirken kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23be8108-3b68-4c98-92d0-69760c98bc39",
                                "sense_id": "b1f039c7-5efe-35da-8c28-62fa41f0489a",
                                "text": "„Durch die zunehmende Privatisierung wird der Einflussbereich für demokratisches Regieren kleiner, die staatliche Macht konzentriert sich auf wenige Kernaufgaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e18ea396-a7e9-3656-ad89-ce8d62003cdd",
                        "entry_id": "93333968-7c87-3202-88ce-9a44f19e4937",
                        "glosses": [
                            "Territorium, auf das man Macht ausüben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8280c0-58b1-4378-98bf-7827da0566fa",
                                "sense_id": "e18ea396-a7e9-3656-ad89-ce8d62003cdd",
                                "text": "„Rhodes wollte den Transvaal mit britischem Territorium umgeben als ersten Schritt zu seiner faktischen Einverleibung in den britischen Einflussbereich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
