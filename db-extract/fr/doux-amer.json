                                                "sense_id": "f9a286f8-6ffa-3fbe-ab3d-4b0ea1733585",
                                                "text": "Die Schokolade hat einen seltsam bittersüßen Geschmack."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8968aca8-5146-35b4-8a70-f532d29b116a",
                                        "entry_id": "dbab2b00-15c0-3a8e-bc8b-a87f596c21c0",
                                        "glosses": [
                                            "von ambivalenten Gefühlen begleitet, gleichzeitig unangenehm und angenehm"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f32bac3-c98e-4350-83f9-e809a9766210",
                                                "sense_id": "8968aca8-5146-35b4-8a70-f532d29b116a",
                                                "text": "Als ich den beiden Frauen meinen fürchterlichen Nachnamen offenbart hatte, lächelten sie mir bittersüß zu und amüsierten sich darüber."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
