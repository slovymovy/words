                    {
                        "sense_id": "83183bd3-f0bf-357e-8480-3a69ffc1e1a6",
                        "entry_id": "a1186008-246d-3322-8a43-35791552b3b8",
                        "glosses": [
                            "Type d’anachronisme qui place un événement plus tard qu’il ne doit être placé. Opposé du prochronisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2628f34-b06b-422b-8d82-6edc9438698a",
                                "sense_id": "83183bd3-f0bf-357e-8480-3a69ffc1e1a6",
                                "text": "Proprement le parachronisme met l'événement plus tard, et l'anachronisme plus tôt qu'il n'est réellement."
                            },
                            {
                                "example_id": "d830a239-3338-4b62-af99-4fdd2a547fc6",
                                "sense_id": "83183bd3-f0bf-357e-8480-3a69ffc1e1a6",
                                "text": "Le parachronisme fonctionne lorsque, comme dans ce cas, des signes sont transposables et reconnaissables, et que cette transposition est un déplacement inadéquat du signifié (un quiproquo, en somme)."
                            },
                            {
                                "example_id": "431b251c-600f-4e91-9629-e444da69cc0a",
                                "sense_id": "83183bd3-f0bf-357e-8480-3a69ffc1e1a6",
                                "text": "Marignan 1616\n(au lieu de 1515)"
                            }
                        ]
                    }
                ],
