                    {
                        "sense_id": "471cc18f-a64f-3b51-8606-f1d223ec0c96",
                        "entry_id": "28b487a5-322c-3c48-aada-0e08a5a07527",
                        "glosses": [
                            "wyrażenie lub działanie zachęcające do wykonania określonego czynu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eacd1a1-3573-4736-858f-2b4f94a15996",
                                "sense_id": "471cc18f-a64f-3b51-8606-f1d223ec0c96",
                                "text": "Doping kibiców był dla niemieckich piłkarzy zbyt słabą podnietą wobec przewagi drużyny z Mediolanu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3415cd99-7614-3169-b0c7-641f4463541f",
                        "entry_id": "28b487a5-322c-3c48-aada-0e08a5a07527",
                        "glosses": [
                            "stan zachwytu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "10102566-3232-4412-abc8-713d669692bc",
                                "sense_id": "3415cd99-7614-3169-b0c7-641f4463541f",
                                "text": "Ale masz podnietę z kupna tego Rolexa! Naprawdę nie ma się czym chwalić!"
                            },
                            {
                                "example_id": "be46feea-a294-4d17-80cb-6fe5dfa9a192",
                                "sense_id": "3415cd99-7614-3169-b0c7-641f4463541f",
                                "text": "Ten film jest byle jaki, a ty masz z niego tyle podniety."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6db1e4b0-3787-4553-8e89-08351edb5ebb",
                        "source_entry_id": "28b487a5-322c-3c48-aada-0e08a5a07527",
                        "source_sense_id": "471cc18f-a64f-3b51-8606-f1d223ec0c96",
                        "target_lang_word": "incentive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incentive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a01b9e54-9bce-3cd0-9e88-21fcc436e7a6",
                                        "entry_id": "831ce258-dc2a-331c-9a94-a0bd253fcc06",
                                        "glosses": [
                                            "Something that motivates, rouses, or encourages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7f486b-59a6-4e05-a292-8afd358a3d28",
                                                "sense_id": "a01b9e54-9bce-3cd0-9e88-21fcc436e7a6",
                                                "text": "I have no incentive to do housework right now."
                                            },
                                            {
                                                "example_id": "ea9ae759-9ccc-48b1-9d63-3851d10444e9",
                                                "sense_id": "a01b9e54-9bce-3cd0-9e88-21fcc436e7a6",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8ad0c9a-bcc9-3bd2-aac8-b034de7f5fca",
                                        "entry_id": "831ce258-dc2a-331c-9a94-a0bd253fcc06",
                                        "glosses": [
                                            "A bonus or reward, often monetary, to work harder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83e16813-99ab-4b8f-963d-263e3a9843ca",
                                                "sense_id": "d8ad0c9a-bcc9-3bd2-aac8-b034de7f5fca",
                                                "text": "Management offered the sales team a $500 incentive for each car sold."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incentive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8569ce5d-aacb-3d4f-9afe-3426cfaf54f9",
                                        "entry_id": "1daa9f0a-a294-360a-98fc-29e4cbf1f484",
                                        "glosses": [
                                            "Inciting; encouraging or moving; rousing to action; stimulating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727c9282-6181-403a-be3d-799189e562c8",
                                                "sense_id": "8569ce5d-aacb-3d4f-9afe-3426cfaf54f9",
                                                "text": "Competency is of all other proportions the most incentive to industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eadf8b0-c67f-34cf-9f27-d9011f82a7ed",
                                        "entry_id": "1daa9f0a-a294-360a-98fc-29e4cbf1f484",
                                        "glosses": [
                                            "Serving to kindle or set on fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e4d60b6-b7e1-424d-bd39-275845e54575",
                                                "sense_id": "7eadf8b0-c67f-34cf-9f27-d9011f82a7ed",
                                                "text": "Part incentive reed / Provide, pernicious with one touch of fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94a9dc56-477e-4029-b239-7c3b069d51da",
                        "source_entry_id": "28b487a5-322c-3c48-aada-0e08a5a07527",
                        "source_sense_id": "471cc18f-a64f-3b51-8606-f1d223ec0c96",
                        "target_lang_word": "stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "An external phenomenon that has an influence on a system, by triggering or modifying an internal phenomenon; for example, a spur or incentive that drives a person to take action or change behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1673c75e-91ac-4454-824f-7fc119abce87",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "an economic stimulus"
                                            },
                                            {
                                                "example_id": "d5c0027f-fc3b-4f67-9864-2013335786f1",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "From the beginning of the show to the end, vanity is the sole stimulus and reward of action—vanity, that never looks beyond the present."
                                            },
                                            {
                                                "example_id": "d64d9582-1846-4e54-aa5e-dab35f68a905",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "Democrats, meanwhile, point out that Republicans seem to have made a conscious decision, beginning with the stimulus, to oppose anything the president put forward, dooming any chance of renewed cooperation between the parties."
                                            },
                                            {
                                                "example_id": "6b812202-831b-45d8-b904-b384f02a7332",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "respond to a stimulus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "Something external that elicits or influences a physiological or psychological activity or response, or that affects any of the sensory apparatuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb9862-11e9-433b-8433-c72738f4fe1d",
                                                "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                                "text": "Even light nonpainful stimuli can provoke or exacerbate spontaneous pain; this is not limited to tactile, thermal, or vibratory stimuli, because auditory, visual, olfactory, and visceral stimuli also may be problematic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "A stinging part on the body of a plant or insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747203e2-52c2-446e-a3bb-9339dd948f48",
                                                "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                                "text": "Many plants, like many animals, are furnished with arms for their protection; these are either aculei, prickles […]; or stimuli, stings, as in the nettles, which are armed with a venomous fluid for the annoyance of naked animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
