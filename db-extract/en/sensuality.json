                                "target_senses": [
                                    {
                                        "sense_id": "615e3ca0-6870-38c5-804a-c0a2d2036ca8",
                                        "entry_id": "cd5ecbb5-b152-3ee0-9098-02b0a598bed4",
                                        "glosses": [
                                            "cecha tego, co zmysłowe, erotyczne, ponętne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01d2235-11e7-4dcc-952b-8ce78c0dcb42",
                                                "sense_id": "615e3ca0-6870-38c5-804a-c0a2d2036ca8",
                                                "text": "Seks bez zmysłowości jest wulgarny, ona to bowiem dodaje mu pieprzyku, tajemniczości"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "732541b1-a335-3e54-9971-0d5e566ed44c",
                                        "entry_id": "cd5ecbb5-b152-3ee0-9098-02b0a598bed4",
                                        "glosses": [
                                            "cecha tego, co odnosi się do zmysłów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c65e3e-df36-415f-80fb-628f10ddd086",
                                                "sense_id": "732541b1-a335-3e54-9971-0d5e566ed44c",
                                                "text": "Władza poznawania objawia się w nas, jako postrzegająca albo jako myśląca: w pierwszym razie nazywa się zmysłowością, a w drugim razie rozumem. Zmysłowość jest władzą bierną i mimowolną, a rozum władzą czynną i samodzielną; obie zaś te władze podlegają odmiennym, właściwym sobie prawom"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22127441-d897-4503-859c-ad953ae85267",
                        "source_entry_id": "39b6fe87-d330-3584-a826-54846ca9db68",
                        "source_sense_description": "the state of being sensual or sensuous",
                        "target_lang_word": "чувственность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чувственность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b613c04a-ef96-3541-9ccb-71bb6cb76fe3",
                                        "entry_id": "c82fa8d0-100e-3e83-9c71-8ed96ac678ac",
                                        "glosses": [
                                            "книжн. свойство по значению прилагательного чувственный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350f1068-7900-4414-9f90-0a7cc2630c58",
                                                "sense_id": "b613c04a-ef96-3541-9ccb-71bb6cb76fe3",
                                                "text": "Чувственность предмета."
                                            },
                                            {
                                                "example_id": "93cc74f9-ecc2-4cce-94e4-6ea353905ea2",
                                                "sense_id": "b613c04a-ef96-3541-9ccb-71bb6cb76fe3",
                                                "text": "Чувственность влечения."
                                            },
                                            {
                                                "example_id": "11c5dc63-f3f9-49eb-a730-abf30e764469",
                                                "sense_id": "b613c04a-ef96-3541-9ccb-71bb6cb76fe3",
                                                "text": "Чувственность взгляда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b28fa8a-ee71-3051-aeff-eaddf5cf76b3",
                                        "entry_id": "c82fa8d0-100e-3e83-9c71-8ed96ac678ac",
                                        "glosses": [
                                            "филос. способность воспринимать чувствами, иметь чувственные восприятия, ощущения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b1fd12-2f3c-4c48-a6b4-c3f872dac254",
                                                "sense_id": "9b28fa8a-ee71-3051-aeff-eaddf5cf76b3",
                                                "text": "Вот почему проблема реальности внешнего мира представляет такой тяжелый крест для идеалистической философии, ибо эта реальность недоказуема мыслительными средствами, она только ощутима чувственностью, и в этом же состоит причина нерасторжимости логического и алогического начал, столь характерной для всего бытия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a6c8aa-e260-371b-b751-f7dfe66e7c3d",
                                        "entry_id": "c82fa8d0-100e-3e83-9c71-8ed96ac678ac",
                                        "glosses": [
                                            "наличие телесных, плотских влечений в ком-либо, склонном преимущественно к удовлетворению таких влечений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26018a41-1f91-4d44-9c8d-43d8ee415b9f",
                                                "sense_id": "c3a6c8aa-e260-371b-b751-f7dfe66e7c3d",
                                                "text": "А между тем Шалико ждал, когда она привыкнет к его поцелуям и ласки его вызовут в ней ответную вспышку чувственности."
                                            },
                                            {
                                                "example_id": "52f6810b-ac27-4e58-80ed-dc249a8fb82a",
                                                "sense_id": "c3a6c8aa-e260-371b-b751-f7dfe66e7c3d",
                                                "text": "Лицо у него было молодое, умное и даже кроткое; высокий лоб и впалые, но ещё блестящие глаза намекали на присутствие мысли, на возможность прекрасных и благородных движений души; только концы губ были несколько опущены, и это как будто разрушало гармонию целого лица, придавая ему оттенок чувственности и сладострастия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
