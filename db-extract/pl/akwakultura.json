                ],
                "translations": [
                    {
                        "translation_id": "5615061c-7b95-428d-9ee4-59c18adb446f",
                        "source_entry_id": "068f3e69-af14-3d87-9678-ca952888ad8c",
                        "source_sense_id": "fd5694cd-b0e9-30fb-8c09-57f7ab434043",
                        "source_sense_description": "Biologie: Zucht von Wassertieren und/oder Wasserpflanzen; Aquakultur",
                        "target_lang_word": "Aquakultur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquakultur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                        "entry_id": "2077a5d4-c94d-3cd7-a460-c836763d3eb3",
                                        "glosses": [
                                            "„systematische Bewirtschaftung des Meeres“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da12a9d-a9be-4c77-836d-6ec2a36b061b",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Zuchtperlen aus Japan zählen zu den bekanntesten Produkten der Aquakultur.“"
                                            },
                                            {
                                                "example_id": "3bbf3040-ac21-45d5-95b3-c569e2cfeee2",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Die weltweit zunehmende Aquakultur kann zu einem Rückgang wild lebender Fischarten führen.“"
                                            },
                                            {
                                                "example_id": "8c915169-75ca-4ffd-88dc-1b4788f67128",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Für jedes Kilogramm Fisch aus Aquakultur würden schätzungsweise zwei Kilogramm Futterfisch benötigt.“"
                                            },
                                            {
                                                "example_id": "f14c7a89-8b5f-45c8-8460-4e20017fe326",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Andererseits leiste Aquakultur einen wichtigen Beitrag für die Ernährung der Weltbevölkerung, betonten die Wissenschaftler.“"
                                            },
                                            {
                                                "example_id": "fe6667d9-02e7-4f55-bd01-b7c1bd0760a3",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Mit einem jährlichen Wachstum von elf Prozent gehört die Aquakultur zum bedeutendsten Sektor der Nahrungsmittelindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                        "entry_id": "2077a5d4-c94d-3cd7-a460-c836763d3eb3",
                                        "glosses": [
                                            "„Anlage zur Fischzüchtung und Fischproduktion“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b0ee04-788d-44b2-b510-e0ad3d523529",
                                                "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                                "text": "„Die Intensivierung der Aquakulturen birgt auch Gefahren: So verschmutzt die Massenhaltung in erheblichem Maße die Umgebung und greift in das natürliche marine Gleichgewicht ein.“"
                                            },
                                            {
                                                "example_id": "2dc84813-aefe-4bf0-a878-c0be988e47b2",
                                                "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                                "text": "„In den Tropen werden für Aquakulturen vielerorts die Mangrovenwälder der Küste, ein wichtiger Schutz vor Überschwemmungen, zerstört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
