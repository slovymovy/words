                                "example_id": "40d5fc50-4e51-4ca5-abaf-c2ffbb4e32d6",
                                "sense_id": "03d98b23-1853-3ff3-ba6f-083e715270e2",
                                "text": "Om in aanmerking te komen voor de hoofdrol in de nieuwe film moest ik eerst auditie doen."
                            },
                            {
                                "example_id": "2c72b216-3001-401d-96cf-c5919fc083af",
                                "sense_id": "03d98b23-1853-3ff3-ba6f-083e715270e2",
                                "text": "'Sorry, wat zei je?' 'Jean-Luc wil graag dat jij auditie komt doen voor de rol van Irene, de hoofdrol."
                            },
                            {
                                "example_id": "f560505c-b3a6-427d-b8c3-ea22c5f70795",
                                "sense_id": "03d98b23-1853-3ff3-ba6f-083e715270e2",
                                "text": "De musicalactrice en zangeres ontmoette List voor het eerst tijdens de auditie voor de musical."
                            }
                        ]
