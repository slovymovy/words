{
    "word_family": [
        "proscription",
        "proscripteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "beb2cb4f-4733-37c3-9cf6-753b385b81d4",
                    "sense_definition": "Interdire formellement ou rejeter catégoriquement une coutume, un usage ou une pratique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a vivement conseillé de <w>proscrire</w> le sucre raffiné de mon alimentation quotidienne."
                        },
                        {
                            "text": "Ces méthodes pédagogiques archaïques sont désormais totalement à <w>proscrire</w> dans nos écoles."
                        }
                    ],
                    "synonyms": [
                        "interdire",
                        "bannir",
                        "supprimer"
                    ],
                    "antonyms": [
                        "autoriser",
                        "admettre",
                        "prescrire"
                    ],
                    "common_phrases": [
                        "à proscrire"
                    ]
                },
                {
                    "sense_id": "fd33c7cb-68e9-3a5f-ae1e-1b2df98d5ee8",
                    "sense_definition": "Condamner une personne au bannissement ou l'expulser hors de son pays ou de son groupe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bannissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le coup d'État, les chefs militaires ont décidé de <w>proscrire</w> plusieurs membres influents du gouvernement déchu."
                        },
                        {
                            "text": "De nombreux intellectuels furent <w>proscrits</w> et trouvèrent refuge dans des capitales étrangères."
                        }
                    ],
                    "synonyms": [
                        "bannir",
                        "exiler",
                        "expulser"
                    ],
                    "antonyms": [
                        "accueillir",
                        "rappeler"
                    ],
                    "common_phrases": [
                        "proscrire un opposant"
                    ]
                },
                {
                    "sense_id": "7c572c97-16fe-3ab7-a62f-012712e9d4d6",
                    "sense_definition": "Condamner à mort sans procès régulier en publiant le nom des victimes sur une liste publique, notamment dans l'Antiquité romaine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "condamnation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À Rome, Sylla <w>proscrivit</w> plusieurs milliers de citoyens pour éliminer ses ennemis politiques et confisquer leurs biens."
                        },
                        {
                            "text": "Les triumvirs n'hésitèrent pas à <w>proscrire</w> des sénateurs illustres qui s'opposaient à leur pouvoir absolu."
                        }
                    ],
                    "common_phrases": [
                        "proscrire des citoyens"
                    ]
                }
            ]
        }
    ]
}