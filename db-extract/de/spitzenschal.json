                "senses": [
                    {
                        "sense_id": "f943008e-53b3-3317-89a5-12f091635cda",
                        "entry_id": "99ee13ae-0bc6-3acc-811f-c73f467e5159",
                        "glosses": [
                            "Schal mit/aus Spitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3456587-46cf-46bf-ba8c-c78d8532b0a3",
                                "sense_id": "f943008e-53b3-3317-89a5-12f091635cda",
                                "text": "„Um den Spitzenschal, mit dem er Anna hatte überraschen wollen, und den Knotenstock, der ihn auf seinen Wanderungen durch die Stadt begleiten sollte, sah er sich geprellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f762e2f6-65e2-47fa-967c-093d83be101c",
                        "source_entry_id": "99ee13ae-0bc6-3acc-811f-c73f467e5159",
                        "source_sense_id": "f943008e-53b3-3317-89a5-12f091635cda",
                        "source_sense_description": "Kleidung: Schal mit/aus Spitzen",
                        "target_lang_word": "mantille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mantille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                        "entry_id": "40e7c7f9-fbbc-3c6f-b522-743612b2f9c9",
                                        "glosses": [
                                            "Fichu de soie ou de dentelle dont les Espagnoles se couvrent la tête et les épaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c32bd7-f97a-40d4-834c-8a6e39120365",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Je trouvai deux jeunes demoiselles de seize à dix-huit ans, commodément établies sur des chaises, et s’éventant de l’air du monde le plus dégagé. Toutes les deux étaient fort jolies, et à leurs robes de soie noire fort propres, à leurs souliers de satin et à leurs mantilles garnies de dentelles, je jugeai qu’elles devaient être les filles de quelque bourgeois aisé."
                                            },
                                            {
                                                "example_id": "abe79180-0619-4c0f-8385-88d07749661f",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "La mantille espagnole est donc une vérité ; j’avais pensé qu’elle n’existait plus que dans les romances de M. Crevel de Charlemagne : elle est en dentelles noires ou blanches, plus habituellement noires, et se pose à l’arrière de la tête sur le haut du peigne ; quelques fleurs placées sur les tempes complètent cette coiffure qui est la plus charmante qui se puisse imaginer. Avec une mantille, il faut qu’une femme soit laide comme les trois vertus théologales pour ne pas paraître jolie ; malheureusement, c’est la seule partie du costume espagnol que l’on ait conservée : le reste est à la française."
                                            },
                                            {
                                                "example_id": "7ca87137-6a47-4cf7-bba6-a36207aa468a",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "La femme du Maltais est toujours simple, modeste et jolie. On la reconnaît à sa tenue discrète, et surtout à une sorte de mantille particulière, noire et raide comme une capote de cabriolet."
                                            },
                                            {
                                                "example_id": "ce58bbb5-a416-431f-8ca9-4a501ad08b74",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Padre Pugnaccio, le crâne hors du capuce, montait les escaliers du dôme Saint-Pierre, entre deux dévotes enveloppées de mantilles."
                                            },
                                            {
                                                "example_id": "ee24fee2-38f6-4dea-9242-3e997daee47c",
                                                "sense_id": "157c61b4-2e9c-3c5d-bafd-9c83cdbd2bbe",
                                                "text": "Autrefois Anny emportait dans tous ses bagages une immense valise pleine de châles, de turbans, de mantilles, de masques japonais, d’images d’Épinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62430c93-2fbc-3e4d-ba1c-a941728c1031",
                                        "entry_id": "40e7c7f9-fbbc-3c6f-b522-743612b2f9c9",
                                        "glosses": [
                                            "Diverses imitations de cette pièce de toilette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc0d00c-3cc8-4c06-b25d-c90b037620e4",
                                                "sense_id": "62430c93-2fbc-3e4d-ba1c-a941728c1031",
                                                "text": "Une mantille garnie de velours, de dentelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
