                        "sense_id": "1525d03e-7374-36f6-85c6-f19247c31bd0",
                        "entry_id": "5092d95b-e70c-36e9-b5cf-b1c1901f02d3",
                        "glosses": [
                            "высок. вызывать, возбуждать какие-либо чувства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462c2a4c-0c1f-4f78-87b6-1d9d9860a375",
                                "sense_id": "1525d03e-7374-36f6-85c6-f19247c31bd0",
                                "text": "Звуки лир, юных дев / Сладострастный напев / Возжигают любовь."
                            }
                        ]
                    }
