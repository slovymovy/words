                                "example_id": "861fa908-f33b-4199-bbb2-b9fe79bcb487",
                                "sense_id": "a532c3f1-ba59-36ee-a34c-712910c2e997",
                                "text": "De schipper navigeerde het schip behendig door de smalle grachten.",
                                "translation": "The skipper skillfully navigated the ship through the narrow canals.",
                                "english": "The skipper skillfully navigated the ship through the narrow canals."
                            },
                            {
                                "example_id": "15e75bb1-b7d7-415c-989a-25a7b0485b4e",
                                "sense_id": "a532c3f1-ba59-36ee-a34c-712910c2e997",
                                "text": "De ervaren schipper stuurde het schip veilig de haven binnen.",
                                "translation": "The experienced captain safely guided the ship into the harbor.",
                                "english": "The experienced captain safely guided the ship into the harbor."
                            },
                            {
                                "example_id": "f0a65a0b-98e7-408b-b775-afd18c1bdc39",
                                "sense_id": "a532c3f1-ba59-36ee-a34c-712910c2e997",
                                "text": "De schipper had de verantwoordelijkheid voor het welzijn van de bemanning en lading.",
                                "translation": "The skipper was responsible for the well-being of the crew and cargo.",
                                "english": "The skipper was responsible for the well-being of the crew and cargo."
                            }
                        ]
