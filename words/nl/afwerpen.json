                        "opbrengen",
                        "produceren"
                    ],
                    "antonyms": [
                        "kosten"
                    ],
                    "common_phrases": [
                        "vruchten afwerpen",
                        "winst afwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To yield, produce, or result in profit, benefit, or positive outcomes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to produce results or profit"
                            },
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to produce fruit or results"
                            },
                            {
                                "target_lang_word": "bring in",
                                "target_lang_sense_clarification": "to generate income or profit"
                            }
                        ]
