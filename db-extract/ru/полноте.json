                        "entry_id": "302cdeea-6517-3013-8ab1-fe5bbae5669e",
                        "glosses": [
                            "Expresses doubt, disagreement or objection; now, now, come on, hold on"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a2f3b3c1-87f7-4546-8761-d4e97f9e309c",
                                "sense_id": "ceaf6bee-362e-35c2-9977-58ba89af69a1",
                                "text": "По́лноте, ба́рышня: всё не так бы́стро изме́нится.",
                                "translation": "Hold on, young lady; things won't change that quickly.",
                                "english": "Hold on, young lady; things won't change that quickly."
                            }
                        ]
