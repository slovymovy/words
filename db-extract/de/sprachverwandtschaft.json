                ],
                "senses": [
                    {
                        "sense_id": "79befe9f-aa5e-3a35-a89e-a69dd7d85cc1",
                        "entry_id": "95cc6a6e-f61f-3a28-aec6-efd6914a05d4",
                        "glosses": [
                            "Zusammengehörigkeit von Sprachen aufgrund der Tatsache, dass sie von einer gemeinsamen Ursprache/Protosprache abstammen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0323506-cbc5-4c6d-80cc-5021966f1a2f",
                                "sense_id": "79befe9f-aa5e-3a35-a89e-a69dd7d85cc1",
                                "text": "Sprachfamilien wie die der germanischen oder romanischen Sprachen werden aufgrund des Kriteriums der Sprachverwandtschaft gebildet."
                            },
                            {
                                "example_id": "03fe248b-290a-4377-a103-00215f69f70b",
                                "sense_id": "79befe9f-aa5e-3a35-a89e-a69dd7d85cc1",
                                "text": "Die Sprachverwandtschaft kann eng oder weniger eng sein, je nach dem, wie sehr Sprachen sich im Laufe der Zeit auseinanderentwickelt haben. So ist die Sprachverwandtschaft zwischen Deutsch und Englisch recht eng, zwischen Deutsch und Russisch zwar auch gegeben, aber nicht so eng."
                            },
                            {
                                "example_id": "a67ecd99-c119-4187-8814-3c0cead0575b",
                                "sense_id": "79befe9f-aa5e-3a35-a89e-a69dd7d85cc1",
                                "text": "„Es scheint, daß die Anregungen zur Erforschung der Geschichte der indogermanischen Sprachen wesentlich vom Phänomen der Sprachverwandtschaft ausgegangen sind, das heißt detaillierte Untersuchungen erst begannen, nachdem man die Verwandtschaft der europäischen Sprachen mit dem Indischen entdeckt hatte.“"
                            },
                            {
                                "example_id": "a616d466-5eec-484e-bcb7-ea8528e429ec",
                                "sense_id": "79befe9f-aa5e-3a35-a89e-a69dd7d85cc1",
                                "text": "Zu einer denkbaren Sprachverwandtschaft zwischen Koreanisch und Japanisch erklärt Lehmann: „Jedoch ist das Material, das für den Nachweis einer solchen Sprachverwandtschaft zur Verfügung steht, so dürftig, daß es nicht angeht, beide Sprachen miteinander zu verbinden, geschweige denn sie jener größeren Gruppe zuzuordnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75de3a54-0b84-3734-a84e-58580e0c2bb3",
                        "entry_id": "95cc6a6e-f61f-3a28-aec6-efd6914a05d4",
                        "glosses": [
                            "strukturelle/typologische Ähnlichkeit von Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ee36f8-9b39-4b32-ae22-9853395c83e4",
                                "sense_id": "75de3a54-0b84-3734-a84e-58580e0c2bb3",
                                "text": "„Bisweilen wird auch in der Sprachtypologie von Sprachverwandtschaft gesprochen, wenn strukturale Ähnlichkeiten zwischen einzelnen Sprachen notiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e5860acb-65fc-3f89-af45-d4b07b0ce147",
                        "entry_id": "95cc6a6e-f61f-3a28-aec6-efd6914a05d4",
                        "glosses": [
                            "Ähnlichkeit aufgrund kultureller Einflüsse durch Sprachkontakt/Sprachmischung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5d6254-71cd-4f3b-98a4-1f9d43c0d496",
                                "sense_id": "e5860acb-65fc-3f89-af45-d4b07b0ce147",
                                "text": "Zur Annäherung des Ungarischen („Magyarischen“) an die westeuropäischen Sprachen sagt Bach: „Hier durchkreuzt also die kulturelle Sprachverwandtschaft die genealogische.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
