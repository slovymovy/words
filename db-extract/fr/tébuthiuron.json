                        "glosses": [
                            "Substance phytosanitaire, de formule chimique C₉H₁₆N₄OS, à usage de désherbant des zones non cultivées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ffc610-b81b-4d30-b648-794bdf754637",
                                "sense_id": "76f15d66-c305-3d47-9d78-b97ac461ce74",
                                "text": "Trois dérivés de l'urée, le thiazafluron, le tebuthiuron et l'éthidimuron, tous trois utilisés en désherbage industriel, sont considérés comme particulièrement persistants (persistance supérieure à 1 an)."
                            },
                            {
                                "example_id": "f6a47c8f-0dd1-460a-8319-3a2cd451e292",
                                "sense_id": "76f15d66-c305-3d47-9d78-b97ac461ce74",
                                "text": "Le tébuthiuron est un herbicide non sélectif utilisé aux fins de l’éradication systématique des mauvaises herbes dicotylédones et graminées, annuelles et vivaces, dans les zones incultes comme les pâturages continus, les talus de chemins de fer, les bords de route et les emprises routières."
                            }
                        ]
                    }
