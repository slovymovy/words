                        "examples": [
                            {
                                "example_id": "37fec2ad-d173-451a-b3cc-26b57658fdd4",
                                "sense_id": "6479dfe6-6605-3c0f-8768-528d2f15836a",
                                "text": "(Für die Ernte) werden unter den Olivenbäumen große Netze ausgelegt. Danach werden die Bäume in einem Arbeitsgang beschnitten und die Oliven per Hand geerntet.",
                                "translation": "(Pour la récolte), de grands filets sont étendus sous les oliviers. Ensuite, les arbres sont taillés en une seule opération et les olives sont récoltées à la main."
                            }
                        ]
                    }
