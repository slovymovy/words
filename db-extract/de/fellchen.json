                        "glosses": [
                            "kleines, meist weiches Stück Fell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781945b9-7799-44f9-b8ec-215eb825ae52",
                                "sense_id": "52d8c4ac-86b7-344f-bad6-67a9bfa5fb67",
                                "text": "„Nach dem Filzen wird das Fellchen gut ausgespült evt. im letzten Gang noch mit etwas Essigwasser.“"
                            },
                            {
                                "example_id": "f76def16-1549-4367-ae3e-d0918d9d1b56",
                                "sense_id": "52d8c4ac-86b7-344f-bad6-67a9bfa5fb67",
                                "text": "„Ob das Fellchen oder das Wesen dieser anhänglichen „Maus“ weicher ist, lässt sich schwer sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
