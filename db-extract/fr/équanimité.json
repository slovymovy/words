                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d30fa91b-ad8e-37fc-92a7-ef397c9b5300",
                                        "entry_id": "c703c085-4fe0-3550-a365-b235ebcb995e",
                                        "glosses": [
                                            "состояние равнодушного человека, безучастное, лишённое интереса, пассивное отношение к окружающему"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955b3e18-bfec-4046-81cb-984417000558",
                                                "sense_id": "d30fa91b-ad8e-37fc-92a7-ef397c9b5300",
                                                "text": "Равнодушие к общественному делу было всеобщее; на выборы ездили очень немногие."
                                            },
                                            {
                                                "example_id": "b5755f80-4787-404b-8c6a-e7bbb8359285",
                                                "sense_id": "d30fa91b-ad8e-37fc-92a7-ef397c9b5300",
                                                "text": "Проявить полное равнодушие."
                                            },
                                            {
                                                "example_id": "28564009-e541-48cf-91af-0af41f641e61",
                                                "sense_id": "d30fa91b-ad8e-37fc-92a7-ef397c9b5300",
                                                "text": "Бюрократическое равнодушие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
