                            "target_lang_translations": {
                                "en": "It is important to exercise <w>regularly</w> to maintain one's health.",
                                "ru": "Важно <w>регулярно</w> заниматься спортом, чтобы сохранять здоровье.",
                                "nl": "Het is belangrijk om <w>regelmatig</w> te sporten om je gezondheid te behouden.",
                                "de": "Es ist wichtig, <w>regelmäßig</w> Sport zu treiben, um seine Gesundheit zu erhalten.",
                                "pl": "Ważne jest, by <w>regularnie</w> uprawiać sport, żeby zachować zdrowie.",
                                "it": "È importante praticare <w>regolarmente</w> uno sport per preservare la propria salute.",
