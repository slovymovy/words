                        "entry_id": "f8452e2f-465f-39c9-8ae1-b78991c9654b",
                        "glosses": [
                            "jet-black in color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f389b4-b9b9-4620-b4cd-478014d29c80",
                                "sense_id": "00b80953-d09c-367d-ae19-45da09c099d3",
                                "text": "Male atrous leadcolourd^([sic]) on the upper side, under side a mixture of whitish and ferruginous with cuspidate fasciae ;"
                            },
                            {
                                "example_id": "aba09c49-15b8-4f57-b33d-cb31855c1df9",
                                "sense_id": "00b80953-d09c-367d-ae19-45da09c099d3",
                                "text": "Head atrous, viridescent on lateral frontal spaces and occiput, gulae, basal part of mentum on each side of median tooth brightly viridescent; prothorax atrous, with viridescent tints on disc and wide brassy-green basal and lateral margins."
                            },
                            {
                                "example_id": "d48554d0-6649-491b-8c5d-01f8d4f0c6c5",
                                "sense_id": "00b80953-d09c-367d-ae19-45da09c099d3",
                                "text": "Perithecia sparse, innate, then erumpent for apical portion, subglobose, atrous, with ostiollar portion a little enlarged."
                            },
                            {
                                "example_id": "d7d8ebe3-f36c-4529-a4a2-21625db34f28",
                                "sense_id": "00b80953-d09c-367d-ae19-45da09c099d3",
                                "text": "An imposing portrait of a Caucasian male holding an atrous book with a sheepish smile hung ominously over the bed."
                            },
                            {
                                "example_id": "1d30ee37-f974-4e8b-a340-d0c9bd2c5b00",
                                "sense_id": "00b80953-d09c-367d-ae19-45da09c099d3",
                                "text": "The throng shouted, female Eligor flung flowers from the roofs as the rhythmic chiming of iron-shod riding beasts came clearer, and the first of the mighty array swung into view in the broad, atrous streets that curved round the spired Grand Union of Imperial Opal."
                            }
                        ]
                    }
                ],
