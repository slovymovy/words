    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef8f2ff1-9998-39bb-9b46-917978a0ed6f",
                    "sense_definition": "Participe passé masculin singulier de <w>envelopper</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a soigneusement <w>enveloppé</w> le cadeau dans du papier brillant.",
                            "target_lang_translations": {
                                "en": "He carefully <w>wrapped</w> the present in shiny paper.",
                                "ru": "Он аккуратно <w>завернул</w> подарок в блестящую бумагу.",
                                "de": "Er hat das Geschenk sorgfältig in glänzendes Papier <w>eingewickelt</w>.",
                                "es": "Ha <w>envuelto</w> cuidadosamente el regalo en papel brillante.",
                                "zh": "他小心地用闪亮的纸把礼物<w>包裹</w>了起来。"
                            }
                        },
                        {
                            "text": "Un épais brouillard a <w>enveloppé</w> toute la vallée dès le lever du jour.",
                            "target_lang_translations": {
                                "en": "A thick fog <w>enveloped</w> the whole valley from daybreak.",
                                "ru": "С самого рассвета густой туман <w>окутал</w> всю долину.",
                                "de": "Seit Tagesanbruch hat ein dichter Nebel das ganze Tal <w>eingehüllt</w>.",
                                "es": "Una espesa niebla ha <w>envuelto</w> todo el valle desde el amanecer.",
                                "zh": "从天亮起，一层浓雾就<w>笼罩</w>了整个山谷。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of envelopper, meaning wrapped up or surrounded.",
                        "ru": "Страдательное причастие прошедшего времени от глаголов «завернуть» и «окутать».",
                        "de": "Maskuline Singularform des Partizip Perfekt von „envelopper“, bedeutet eingewickelt oder umhüllt.",
                        "es": "Forma masculina singular del participio pasado de envolver, que significa envuelto o rodeado.",
                        "zh": "envelopper的阳性单数过去分词，意为包裹起来或被周围的东西围住。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrapped",
                                "target_lang_sense_clarification": "past participle, covering or packaging"
                            },
                            {
                                "target_lang_word": "enveloped",
                                "target_lang_sense_clarification": "past participle, typically with fog or darkness"
                            }
                        ],
                        "ru": [
