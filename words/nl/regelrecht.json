            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "beb6837d-8bad-3c2c-8b2c-adbfc35bda10",
                    "sense_definition": "zonder omwegen of vertraging naar een doel gaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "directheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De manager ging <w>regelrecht</w> op zijn doel af om de deal te sluiten.",
                            "target_lang_translations": {
                                "en": "The manager went <w>straight</w> for his goal to close the deal."
                            }
                        },
                        {
                            "text": "Na de lange vergadering liep hij <w>regelrecht</w> naar de uitgang.",
                            "target_lang_translations": {
                                "en": "After the long meeting, he walked <w>directly</w> to the exit."
                            }
                        }
                    ],
                    "synonyms": [
                        "direct",
                        "rechtstreeks",
                        "onmiddellijk"
                    ],
                    "antonyms": [
                        "indirect",
                        "omslachtig"
                    ],
                    "common_phrases": [
                        "regelrecht op het doel af"
                    ],
                    "target_lang_definitions": {
                        "en": "going to a goal without detours or delays"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "directly towards a destination"
                            },
                            {
                                "target_lang_word": "directly",
                                "target_lang_sense_clarification": "without stopping or changing direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b4dfa04-409b-3c11-a583-b3821ff15946",
                    "sense_definition": "in alle opzichten zo te noemen; echt of puur",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benadrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitverkoop werd een <w>regelrechte</w> ramp voor de kleine winkelier.",
                            "target_lang_translations": {
                                "en": "The sale became a <w>downright</w> disaster for the small shopkeeper."
                            }
                        },
                        {
                            "text": "Het was een <w>regelrechte</w> leugen wat hij gisteren tegen ons zei.",
                            "target_lang_translations": {
                                "en": "It was an <w>outright</w> lie what he told us yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "onmiddellijk",
                        "direct"
                    ],
                    "common_phrases": [
                        "een regelrechte ramp",
                        "een regelrechte leugen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be called such in every respect; real or pure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "downright",
                                "target_lang_sense_clarification": "used to emphasize something negative"
                            },
                            {
                                "target_lang_word": "outright",
                                "target_lang_sense_clarification": "complete and total"
                            },
                            {
                                "target_lang_word": "veritable",
                                "target_lang_sense_clarification": "truly such, often used for emphasis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d5869f-e5e6-33bf-ae35-4fbeff75263f",
                    "sense_definition": "volgens een rechte lijn zonder bochten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De weg loopt <w>regelrecht</w> door het uitgestrekte polderlandschap.",
                            "target_lang_translations": {
                                "en": "The road runs <w>straight</w> through the vast polder landscape."
                            }
                        },
                        {
                            "text": "Trek een <w>regelrechte</w> lijn tussen deze twee punten op de kaart.",
                            "target_lang_translations": {
                                "en": "Draw a <w>straight</w> line between these two points on the map."
                            }
                        }
                    ],
                    "synonyms": [
                        "lijnrecht"
                    ],
                    "antonyms": [
                        "krom",
                        "bochtig"
                    ],
                    "common_phrases": [
                        "een regelrechte lijn"
                    ],
                    "target_lang_definitions": {
                        "en": "following a straight line without curves"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "in a linear fashion"
                            },
                            {
                                "target_lang_word": "dead straight",
                                "target_lang_sense_clarification": "perfectly linear"
                            }
                        ]
                    }
                }
