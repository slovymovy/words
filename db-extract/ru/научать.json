                    }
                ],
                "translations": [
                    {
                        "translation_id": "c786a0d6-24f5-4a60-bf13-846835006af3",
                        "source_entry_id": "99250401-1c2b-3d09-a4d5-2e2a5298c57c",
                        "source_sense_id": "c3c49bb0-b846-3ee8-b795-89c7a26d12e7",
                        "target_lang_word": "apprendre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apprendre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Acquérir une connaissance ou un savoir-faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8417ed6e-c555-470e-8424-5f640f99ddef",
                                                "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                                                "text": "Comme je paraissais faible et que je boitais un peu, ma mère avait voulu me faire apprendre un métier plus doux que ceux de notre village ; […]."
                                            },
                                            {
                                                "example_id": "d5ec21db-3f29-4dc2-ae36-8b86a5a190ca",
                                                "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                                                "text": "Ce sont des harrâba, des soldats dressés à Gibraltar pour servir d’instructeurs à leurs camarades; mais ils se sont empressés d’oublier ce qu’ils avaient appris et ne se distinguent guère des autres troupiers marocains."
                                            },
                                            {
                                                "example_id": "df9d10ee-2640-47f7-b628-c37fc3382d07",
                                                "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                                                "text": "Dès sa première communion, gagé par l’un ou par l’autre, […], il était sans l’avoir appris devenu habille à menuiser, à charronner, à réparer un coutre, à ferrer un cheval."
                                            },
                                            {
                                                "example_id": "bf910e51-9689-4b82-b6c4-acea6488eea0",
                                                "sense_id": "58856ebc-c5b3-31c8-9ef9-e7f2e8747416",
                                                "text": "Elle débute comme perchwoman sur The Guard from the Underground de Kiyoshi Kurosawa. Elle fera durant dix ans ce travail où elle dit avoir beaucoup appris sur la mise en scène, avant de se lancer dans la réalisation, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb16e137-2cdb-3fac-bc9c-5d10512a7648",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Contracter une disposition ou une habitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4239e23-c538-4280-a107-aca6f63c4239",
                                                "sense_id": "fb16e137-2cdb-3fac-bc9c-5d10512a7648",
                                                "text": "Si le son du canon glace d’effroi les assiégés, c'est par ce même son que certains s’accoutument à l'obus, apprennent à deviner les trajectoires et les impacts."
                                            },
                                            {
                                                "example_id": "98866627-a7e0-4e4a-bfb2-d947b3769ff2",
                                                "sense_id": "fb16e137-2cdb-3fac-bc9c-5d10512a7648",
                                                "text": "Les multirécidivistes sont paranos, ils connaissent le travail de la police et font des contre-observations. À chaque fois qu'ils tombent, ils analysent en détail le dossier judiciaire pour connaître ce qui leur a été fatal, apprenant de leurs maladresses."
                                            },
                                            {
                                                "example_id": "3b9bf02e-fe31-4d93-9e02-d090f1731619",
                                                "sense_id": "fb16e137-2cdb-3fac-bc9c-5d10512a7648",
                                                "text": "Il apprit à régler ses passions. — J’ai appris de vous à modérer mes désirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Connaître par une information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bef72f-10d6-49db-b056-6cccb0401dbd",
                                                "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                                                "text": "Il me fait d’abord un cours de géographie, et j’apprends que la terre est un disque dont l’Arabie occupe le centre."
                                            },
                                            {
                                                "example_id": "8ef5bf0c-9089-4083-97ca-0b542fcfe27c",
                                                "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                                                "text": "Je passe quelques jours à Serbonnes, jusqu’au 15 août. Au retour j’apprends quelques détails rétrospectifs."
                                            },
                                            {
                                                "example_id": "122cb624-a681-49b6-8333-0a7b2a0649ac",
                                                "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                                                "text": "14 mai. - On apprend que le haut clergé bouddhique a commencé une grève de la faim pour protester contre la discrimination dont il s'estime victime."
                                            },
                                            {
                                                "example_id": "44c4d143-c5b2-4d93-878b-97d19b08ab91",
                                                "sense_id": "048d1b17-1221-3bc1-be4b-53124bc01d79",
                                                "text": "Ma belle-mère m’avait appris, dans un moment d’égarement, qu'il avait été en prison pendant vingt ans pour inceste sur ses propres filles en Normandie et interdit de séjour depuis lors dans sa région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03611d1-ce0c-35ba-8111-1a69534ab517",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Retenir dans sa mémoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0d1476-2254-4c8c-9bbe-f1247a29264e",
                                                "sense_id": "a03611d1-ce0c-35ba-8111-1a69534ab517",
                                                "text": "Les maîtres d’école prétendent que ce qu’on écrit se fourre plus avant dans la cervelle que ce qu’on apprend par cœur, et que c’est pour ça qu’ils font faire des devoirs aux enfants, au lieu de se contenter de leur faire réciter des leçons."
                                            },
                                            {
                                                "example_id": "0d54e619-84f8-4eca-8cd0-acc693e5fd93",
                                                "sense_id": "a03611d1-ce0c-35ba-8111-1a69534ab517",
                                                "text": "— Les vers s’apprennent plus facilement que la prose. — L’anglais s’apprend dès le primaire maintenant"
                                            },
                                            {
                                                "example_id": "e231921d-f524-4662-a651-b018ec11dbb5",
                                                "sense_id": "a03611d1-ce0c-35ba-8111-1a69534ab517",
                                                "text": "— Il apprend bien ; il refuse d’apprendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Enseigner, donner quelque connaissance à une personne, faire savoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d75171-19b9-4eca-8852-e9cf2e4845f3",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "C’est lui qui m’a appris ce que je sais."
                                            },
                                            {
                                                "example_id": "13e48d4b-712e-421f-bb33-5352a13ae983",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "Le maitre qui lui a appris le dessin."
                                            },
                                            {
                                                "example_id": "b993f9dc-76e2-4d7e-bc63-05603a8f5fa5",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "Il nous a appris de grandes nouvelles."
                                            },
                                            {
                                                "example_id": "a6766421-b90e-4e31-a76a-724435542126",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "On m’apprend qu’il se marie."
                                            },
                                            {
                                                "example_id": "516dd799-8416-496c-af13-14c76ff382d6",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "Il y a des choses que l’usage seul apprend."
                                            },
                                            {
                                                "example_id": "839736ac-92de-4f71-9800-27ad61306960",
                                                "sense_id": "c7c254d8-f220-3533-8298-fcfb8cc80241",
                                                "text": "La tradition nous apprend que… Cette mésaventure lui apprendra à être circonspect, à se conduire avec prudence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Éduquer par la menace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1c826c-6de5-4c55-8b91-c88dbb2c2129",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "Je vous apprendrai à mentir, Je vous apprendrai ce qu’il en coute de mentir."
                                            },
                                            {
                                                "example_id": "13c73f6c-91f5-4a5c-b9d2-66858749bab7",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "« Vilain Crapaud, s’écria Agnella, je t’apprendrai à venir manger mes belles cerises ! »"
                                            },
                                            {
                                                "example_id": "dee9839a-8f54-4b5f-95b3-fb8791aa3187",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "Je lui apprendrai bien à vivre, je lui apprendrai bien son devoir, Je le rangerai à son devoir."
                                            },
                                            {
                                                "example_id": "522f09c1-fbe4-411e-a01a-388c03b1bde1",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "Je lui apprendrai à parler, Je le forcerai de parler avec plus de convenance, de respect."
                                            },
                                            {
                                                "example_id": "a7285adc-fca6-4a5d-b483-25831243717b",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "Bref, j’ai entendu Rivaud dire au procureur qu’il considérait ta démarche comme une goujaterie et que, en arrivant ici, il avait une forte envie de t’apprendre à vivre…"
                                            },
                                            {
                                                "example_id": "3591f6a0-b24d-4dc7-a1e0-8d65663909e8",
                                                "sense_id": "c7bb36d7-3d58-36f9-84f8-2829fc484e8c",
                                                "text": "— Espèce de petit saligaud. Je vais t’apprendre…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Donner une leçon ; tenir lieu de punition."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64872622-d3d7-4020-8a34-5180e88b3880",
                                                "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                                                "text": "[…], Peter s'était fait brusquement corriger sur le trottoir par des Québécois. Pas à cause des larfeuilles sur lesquels ils ne soupçonnaient rien, mais pour lui apprendre à être viril."
                                            },
                                            {
                                                "example_id": "0b680070-08a4-4f53-95e8-eb2ad40cd95f",
                                                "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                                                "text": "Il a eu un accident de voiture ? C’est bien fait ! Ça lui apprendra à faire des queues de poisson."
                                            },
                                            {
                                                "example_id": "4c8d8f4f-6107-4eea-8cf4-6cd59a6ed852",
                                                "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                                                "text": "Prends ça ! Ça t’apprendra à me raconter des salades."
                                            },
                                            {
                                                "example_id": "9a56a758-3bc8-48ce-8ec8-dde7cc1a799f",
                                                "sense_id": "af3d8e71-d6a3-3118-af7a-b2de269d7420",
                                                "text": "S’il se fait expulser du lycée, je serai la première à fêter son départ, et ça lui apprendra à faire accuser les gens à sa place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e6af2a-b763-3282-a7d4-f842c69a6c47",
                                        "entry_id": "d0463e10-d8ea-3f99-813a-fa94a841191d",
                                        "glosses": [
                                            "Développer ses connaissances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc305d88-665d-4641-878b-2385e1d2d38a",
                                                "sense_id": "63e6af2a-b763-3282-a7d4-f842c69a6c47",
                                                "text": "Il a réussi à savoir lire et écrire sans faute. Il aimait apprendre. (On disait apprendre tout court, comme boire ou manger.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b45804b-cc41-4c81-850e-fe7bb7373ee4",
                        "source_entry_id": "99250401-1c2b-3d09-a4d5-2e2a5298c57c",
                        "source_sense_id": "c3c49bb0-b846-3ee8-b795-89c7a26d12e7",
                        "target_lang_word": "enseigner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enseigner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e316da1-0b7e-3504-be21-bbebdaf84a72",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Indiquer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41540cb1-bfae-4aaa-8249-de10def45c58",
                                                "sense_id": "5e316da1-0b7e-3504-be21-bbebdaf84a72",
                                                "text": "Enseignez-nous un peu le chemin qui mène à la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b2a770-e3bf-3efd-87a2-c7eae8426dbe",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Inculquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636ac692-3328-443d-ad81-8ebc5f1fea72",
                                                "sense_id": "17b2a770-e3bf-3efd-87a2-c7eae8426dbe",
                                                "text": "Le statut d’entrepreneur individuel spécialisé dans la chnouf semble en contradiction avec une vocation de pédagogue se destinant à enseigner les valeurs du sport. À moins de se spécialiser dans le cyclisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c6894d-b781-3903-8ee6-b141489f6c78",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Faire apprendre (une idée, un principe)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3ee849-82f4-446c-a71b-e575420d7dfd",
                                                "sense_id": "74c6894d-b781-3903-8ee6-b141489f6c78",
                                                "text": "Ils ont ainsi émis la thèse selon laquelle la vie de l'homme préhistorique, pour bienheureuse qu'elle était, ainsi que nous l’a enseigné Rousseau, n'en était pas moins aussi ennuyeuse, à telle enseigne que cet homme d’autrefois fut naturellement amené à inventer un art pour se distraire."
                                            },
                                            {
                                                "example_id": "a211532a-ce84-4aa3-9dcf-1888ab164237",
                                                "sense_id": "74c6894d-b781-3903-8ee6-b141489f6c78",
                                                "text": "La nature nous enseigne que tous les excès sont pernicieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "405bb557-0516-3293-96c0-27292844068b",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Faire connaître (un auteur) en profondeur dans un cadre pédagogique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5e8d0b-5639-470a-989f-f0c251afaf03",
                                                "sense_id": "405bb557-0516-3293-96c0-27292844068b",
                                                "text": "Il nous enseignait les auteurs qui conjuguaient philosophie et spiritualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Instruire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f889e87-66a5-4e0f-810d-81c4c465d174",
                                                "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                                                "text": "Enseigner la jeunesse."
                                            },
                                            {
                                                "example_id": "db1a8ba7-0d54-46b9-bbd2-8b066573a25a",
                                                "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                                                "text": "Enseigner les ignorants."
                                            },
                                            {
                                                "example_id": "61d58278-4f4c-4574-9c9b-cef0025d1f07",
                                                "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                                                "text": "Le premier devoir des pauvres filles qui nous enseignaient, c’était de répartir également les éloges et les bons points à notre académie de prodiges."
                                            },
                                            {
                                                "example_id": "b1aeb52a-0141-4941-a72f-9662f6ee890a",
                                                "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                                                "text": "À ses yeux, il n’y avait point de circonstance atténuante qui valût pour un garçon instruit, de bonne famille, et enseigné par son père dans l’amour du bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aeb9aa0-55e4-375c-a4bf-1207fe9447ee",
                                        "entry_id": "df16c803-b805-3ee4-9a1b-2fdde7974149",
                                        "glosses": [
                                            "Faire apprendre dans un but de maîtrise d'un art, d'une activité"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409aa1b8-32f9-4bae-aa44-c679476b6ff3",
                                                "sense_id": "6aeb9aa0-55e4-375c-a4bf-1207fe9447ee",
                                                "text": "C’était Staline qui enseignait le casatchok à Dummi-Dummi pendant que les Forces Alliées faisaient la claque."
                                            },
                                            {
                                                "example_id": "2f19352c-d9ce-489a-8dd9-35c03aae3c03",
                                                "sense_id": "6aeb9aa0-55e4-375c-a4bf-1207fe9447ee",
                                                "text": "Hanser enseigna d'abord à Méhul les premières règles du contrepoint rigoureux, et le mit bientôt en état de le remplacer à l'orgue pour les offices du matin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
