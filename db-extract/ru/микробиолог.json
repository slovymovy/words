                                        "glosses": [
                                            "specjalista zajmujący się mikrobiologią"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae8a4f1b-8431-46f8-9655-7596a04fdf8e",
                                                "sense_id": "1def55a0-88fc-35c8-ab2a-6bbb0089e160",
                                                "text": "Mikrobiolodzy są zatrudniani nie tylko w szpitalach lub sanepidach, ale również w przemyśle."
