{
    "word_family": [
        "creviced"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17a15dca-fc1e-39a6-81a9-f73d47360a5d",
                    "sense_definition": "A narrow crack or fissure, especially in a rock or wall.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small lizard hid inside a deep <w>crevice</w> in the stone wall.",
                            "target_lang_translations": {
                                "cs": "Malá ještěrka se schovala do hluboké <w>štěrbiny</w> v kamenné zdi.",
                                "de": "Die kleine Eidechse versteckte sich in einer tiefen <w>Spalte</w> der Steinmauer."
                            }
                        },
                        {
                            "text": "Tiny plants often grow in the <w>crevices</w> of a rocky cliff.",
                            "target_lang_translations": {
                                "cs": "Drobné rostliny často rostou ve <w>skulinách</w> skalnatého útesu.",
                                "de": "Kleine Pflanzen wachsen oft in den <w>Felsspalten</w> einer steilen Klippe."
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "fissure",
                        "cleft",
                        "gap"
                    ],
                    "common_phrases": [
                        "rocky crevice",
                        "deep crevice"
                    ],
                    "target_lang_definitions": {
                        "cs": "Úzká trhlina nebo štěrbina, zejména ve skále nebo ve zdi.",
                        "de": "Eine schmale Spalte oder ein Riss, besonders in einem Felsen oder einer Mauer."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "štěrbina",
                                "target_lang_sense_clarification": "obecné označení pro úzký otvor nebo trhlinu"
                            },
                            {
                                "target_lang_word": "trhlina",
                                "target_lang_sense_clarification": "prasklina v pevném materiálu"
                            },
                            {
                                "target_lang_word": "skulina",
                                "target_lang_sense_clarification": "úzký prostor mezi dvěma předměty"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Spalte",
                                "target_lang_sense_clarification": "schmaler Einschnitt oder Öffnung in Stein oder Mauerwerk"
                            },
                            {
                                "target_lang_word": "Ritze",
                                "target_lang_sense_clarification": "enger, schmaler Zwischenraum"
                            },
                            {
                                "target_lang_word": "Spalt",
                                "target_lang_sense_clarification": "rissförmige schmale Öffnung"
                            },
                            {
                                "target_lang_word": "Felsspalte",
                                "target_lang_sense_clarification": "Spalte oder Spalt speziell im Gestein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c624e483-8f0f-34cd-916b-d26515b0b968",
                    "sense_definition": "A slang term for the vagina.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term is sometimes used in explicit literature to describe a <w>crevice</w>.",
                            "target_lang_translations": {
                                "cs": "Tento výraz se někdy používá v explicitní literatuře k popisu <w>škvíry</w>.",
                                "de": "Der Begriff wird manchmal in expliziter Literatur verwendet, um eine <w>Spalte</w> zu beschreiben."
                            }
                        },
                        {
                            "text": "This usage of <w>crevice</w> is highly informal and often considered vulgar.",
                            "target_lang_translations": {
                                "cs": "Toto použití slova <w>škvíra</w> je velmi neformální a často považované za vulgární.",
                                "de": "Diese Verwendung von <w>Spalte</w> ist höchst umgangssprachlich und gilt oft als vulgär."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in a sexual or vulgar context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Slangový výraz pro ženské pohlavní orgány.",
                        "de": "Ein vulgärer Slangausdruck für die Vagina."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škvíra",
                                "target_lang_sense_clarification": "vulgární slangový výraz"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Spalte",
                                "target_lang_sense_clarification": "vulgärer Begriff für die Vagina"
                            },
                            {
                                "target_lang_word": "Ritze",
                                "target_lang_sense_clarification": "vulgärer Begriff für die Vagina"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e5dd19f-b02a-3391-afcf-54d9c4fae2cb",
                    "sense_definition": "To cause to crack or develop a flaw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat began to <w>crevice</w> the dry clay surface.",
                            "target_lang_translations": {
                                "cs": "Intenzivní žár začal <w>rozpraskávat</w> povrch suchého jílu.",
                                "de": "Die intensive Hitze begann, die trockene Lehmoberfläche <w>rissig zu machen</w>."
                            }
                        },
                        {
                            "text": "Heavy pressure will eventually <w>crevice</w> the brittle material.",
                            "target_lang_translations": {
                                "cs": "Velký tlak nakonec způsobí <w>popraskání</w> křehkého materiálu.",
                                "de": "Starker Druck wird das spröde Material schließlich <w>zerklüften</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "split"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit vznik trhliny nebo praskliny v materiálu.",
                        "de": "Risse in einem Material verursachen oder rissig werden lassen."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozpraskat",
                                "target_lang_sense_clarification": "způsobit vznik mnoha trhlin"
                            },
                            {
                                "target_lang_word": "popraskat",
                                "target_lang_sense_clarification": "vytvořit trhliny vlivem vnějších podmínek"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rissig machen",
                                "target_lang_sense_clarification": "eine Oberfläche mit Rissen versehen"
                            },
                            {
                                "target_lang_word": "zerklüften",
                                "target_lang_sense_clarification": "mit tiefen Spalten versehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
