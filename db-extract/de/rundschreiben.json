                    {
                        "translation_id": "7b27712f-2728-4961-9ba8-b0747adba235",
                        "source_entry_id": "03be002e-8d38-30a4-99d1-90adef720fe3",
                        "source_sense_id": "c2b5e01c-62cb-3636-a41d-31d75c8c8060",
                        "source_sense_description": "schriftliche Nachricht an alle Mitglieder einer bestimmten Gruppe",
                        "target_lang_word": "circulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da1ae021-c6db-38c7-9b68-f264980d424b",
                                        "entry_id": "262a7307-0385-3cee-930a-e814ccbce2a3",
                                        "glosses": [
                                            "Relatif au cercle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69edb7c3-baf9-4f4f-8cf2-3ceafc80f73e",
                                                "sense_id": "da1ae021-c6db-38c7-9b68-f264980d424b",
                                                "text": "Forme circulaire. — Figure circulaire. — Ligne circulaire. — Mouvement circulaire. — Lettre circulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8ace91-88b1-382d-9188-44981403f919",
                                        "entry_id": "262a7307-0385-3cee-930a-e814ccbce2a3",
                                        "glosses": [
                                            "En forme de cercle ou, par extension, de disque."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e84e936-1d20-4661-ae30-852f3ca9837f",
                                                "sense_id": "fa8ace91-88b1-382d-9188-44981403f919",
                                                "text": "L’ouvrier se sert d'une lame courte et tranchante, engagée dans un manche d’os, avec laquelle il pratique, au bas de l’arbre, une entaille circulaire et assez profonde pour arriver jusqu'à l’aubier."
                                            },
                                            {
                                                "example_id": "ad0cd723-e869-4f3e-bfee-ef711b9b7361",
                                                "sense_id": "fa8ace91-88b1-382d-9188-44981403f919",
                                                "text": "On arriva sur une petite place circulaire, où étaient dressées quelques boutiques, un bal, un manège. Il n’y avait pas grande foule, quelques badauds seulement circulaient."
                                            },
                                            {
                                                "example_id": "18a80f2f-aa46-4e19-bf86-b71a4cbe55c6",
                                                "sense_id": "fa8ace91-88b1-382d-9188-44981403f919",
                                                "text": "Des bégonias rose thé étaient massés sous la fenêtre de la façade et des pensées formaient un tapis circulaire au pied d’un acacia."
                                            },
                                            {
                                                "example_id": "a8ae23b1-f4f9-4d1e-8f20-a6b2eef75a0b",
                                                "sense_id": "fa8ace91-88b1-382d-9188-44981403f919",
                                                "text": "Dans le brouhaha qui a suivi, parmi les mouvements circulaires d'une foule vibrionique qui tourne autour des Habits Verts, Étienne s'est senti fier de la présenter à quelques relations qui la jugent, qui la jaugent, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d6058c4-6a45-39e3-b7f8-7abdc5bfc5fb",
                                        "entry_id": "262a7307-0385-3cee-930a-e814ccbce2a3",
                                        "glosses": [
                                            "Qui embrasse l'alentour dans son entier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50789672-c91a-4527-9fa9-4b172d230b3f",
                                                "sense_id": "8d6058c4-6a45-39e3-b7f8-7abdc5bfc5fb",
                                                "text": "Il n’avait pas son fusil et, inconsciemment, jetant un regard circulaire autour de lui, chercha une arme meurtrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "circulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                        "entry_id": "1e8c062c-fbbb-3b64-89d5-fa81ebd80764",
                                        "glosses": [
                                            "Lettre reproduite à plusieurs exemplaires et adressée à plusieurs personnes pour le même objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81153503-caf2-4dcd-bf66-6abfb5bcb84b",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Distribuer, répandre une circulaire, des circulaires."
                                            },
                                            {
                                                "example_id": "92fc36bc-24be-4a33-99cf-ed1daa44d8a4",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Recevoir une circulaire."
                                            },
                                            {
                                                "example_id": "e16917c9-bcc1-4036-b764-6f1cf0db7d1a",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Je ferai toutes les circulaires de mon mari, car il n’a pas de style."
                                            },
                                            {
                                                "example_id": "619144c8-67c3-429a-ae49-9d52e8e32708",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "M. Jules Simon, par une circulaire aux préfets, interdit le colportage de la pétition réclamant une intervention de la France en faveur du Saint-Siège, […]."
                                            },
                                            {
                                                "example_id": "686daddd-6326-44eb-b2f7-5b67e6720a87",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Camarades lycéens, Il est temps que vous secouiez le joug d'un aussi avilissant esclavage. Sans doute, plusieurs proviseurs se sont déjà émus et semblent disposés à faire tout leur devoir. Nous les en félicitons. Mais ce n'est pas une circulaire qui vous rendra libres."
                                            },
                                            {
                                                "example_id": "948b604c-97cc-4ee1-8d17-bd6c409057e4",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Il adressa une circulaire à tous ses correspondants."
                                            },
                                            {
                                                "example_id": "f75a769a-3c8c-48f4-900d-cdfa1c0ee44a",
                                                "sense_id": "61bee22e-ce45-3fdd-9ff6-130347eab64a",
                                                "text": "Circulaire ministérielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62b9617-897d-37b3-9936-78484edf6198",
                                        "entry_id": "1e8c062c-fbbb-3b64-89d5-fa81ebd80764",
                                        "glosses": [
                                            "Dépliant publicitaire distribué dans les boîtes aux lettres."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "circulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d12f68f7-c761-3033-9864-7d7c69f1d9bf",
                                        "entry_id": "1b643318-ce42-33cc-aaa2-a2abdef0154d",
                                        "glosses": [
                                            "Voyage circulaire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a0bc0fe-7718-4415-a56d-1a12164307bd",
                                                "sense_id": "d12f68f7-c761-3033-9864-7d7c69f1d9bf",
                                                "text": "« En juin, nous plaquons Paris pour six bonnes semaines de Montigny ; fin juillet, Vittel… Et puis, il faut absolument caser, à mi-septembre, un petit circulaire dont j’ai l’idée vers la Forêt-Noire, quelque chose de démodé, de second empire… Qu’est-ce que tu en dis, chérie ? »"
                                            }
                                        ]
                                    }
                                ]
                            }
