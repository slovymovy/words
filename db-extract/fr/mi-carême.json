        "fr-extract.jsonl": [
            {
                "entry_id": "e26b0ff3-65f3-355e-9e86-d32c0a433e25",
                "word": "mi-carême",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                        "entry_id": "e26b0ff3-65f3-355e-9e86-d32c0a433e25",
                        "glosses": [
                            "Jeudi de la troisième semaine du Carême, jour de fête populaire qui marque un répit dans l’abstinence prescrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4341ad-dfd2-4640-8a9a-315de4e4a93e",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Fêter la mi-carême."
                            },
                            {
                                "example_id": "fca375f7-bd0a-4ff9-9ad8-9d6f219e4fac",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Se déguiser pour la mi-carême."
                            },
                            {
                                "example_id": "c9dc726e-fb46-4e24-a717-c521638d45bf",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Donner congé pour la mi-carême."
                            },
                            {
                                "example_id": "ac50beb5-261f-413e-bd52-dd9f10784b97",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Cela ne l’empêchait pas de préparer une fête splendide pour le jeudi de la mi-carême."
                            },
                            {
                                "example_id": "3489094b-df70-4fc4-b9b0-42f4f23c0e85",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Les réjouissances de la mi-carême avaient dû attirer la grande foule, au centre de Paris, sur le passage des chars, car il n’y avait, par les allées, que des cavaliers et des équipages, de belles promeneuses descendues des coupés et des landaus, avec des nourrices enrubannées, portant des poupons en pelisses de dentelle, toute la haute élégance du Bois, tout le mouvement mondain des jours choisis, où les petites gens n’y viennent point."
                            },
                            {
                                "example_id": "a91e3cf6-6a23-4f12-ae12-3c364f947acc",
                                "sense_id": "e811bf84-548d-3d97-824e-3282c6f6842f",
                                "text": "Après que la paix fut signée, ennemis et amis, ensemble on banqueta. Et comme était venue alors la Mi-Carême, jeûne rompu, on s’en donna."
                            }
                        ]
                    }
                ],
