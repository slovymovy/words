                ],
                "senses": [
                    {
                        "sense_id": "3b996187-081b-3805-a753-8b2589830a3d",
                        "entry_id": "104da8a9-442a-3804-8d4f-009a88b7bd81",
                        "glosses": [
                            "von Militärs gebildete Regierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4ca31d-11fe-4fbf-b0a5-289dffbb192b",
                                "sense_id": "3b996187-081b-3805-a753-8b2589830a3d",
                                "text": "„Wiewohl er und all die anderen Daimyos die absolute Herrschaft in ihrem Herrschaftsgebiet innehatten, unterstanden sie dennoch der Oberherrschaft des Rats der Regenten, der regierenden Militärjunta, in deren Hände der Taikō seine Macht während der Minderjährigkeit seines Sohnes gelegt, und mussten sich außerdem an Edikte halten, die der Taikō noch zu seinen Lebzeiten hatte ergehen lassen und die immer noch in Kraft waren.“"
                            },
                            {
                                "example_id": "403e3a9d-e4b1-4bcc-9a17-9a95ab1d65b1",
                                "sense_id": "3b996187-081b-3805-a753-8b2589830a3d",
                                "text": "„Zur Zeit der Militärjunta war der alte Mann ein General gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
