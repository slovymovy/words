                "senses": [
                    {
                        "sense_id": "017a7811-9e32-3841-ae0b-dd7e75143b1d",
                        "entry_id": "2b1be184-d42d-36aa-8084-7840f33c61df",
                        "glosses": [
                            "Investir insuffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ad91b9-8743-41b5-a1b5-d808a805928f",
                                "sense_id": "017a7811-9e32-3841-ae0b-dd7e75143b1d",
                                "text": "Pour l'essentiel, ce sont les entreprises relevant de branches d'activité nouvelles qui seront amenées à sous-investir, alors que le sur-investissement concerne plutôt les entreprises de branches économiques arrivées à maturité."
                            },
                            {
                                "example_id": "93c90239-c952-4451-97dd-e2294eac0371",
                                "sense_id": "017a7811-9e32-3841-ae0b-dd7e75143b1d",
                                "text": "Ce résultat est dû au fait que la règle de dommages incite à surinvestir alors que la règle d'exécution forcée incite à sous-investir."
                            }
                        ]
                    }
