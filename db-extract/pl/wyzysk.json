                                    {
                                        "sense_id": "a92134b1-7815-33c6-950c-a3299e255260",
                                        "entry_id": "2317bf77-3849-3f79-8623-706f3488e3b3",
                                        "glosses": [
                                            "The act of utilizing something; industry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af4f5d1-227e-438c-9dfa-5ce01dc44b62",
                                                "sense_id": "a92134b1-7815-33c6-950c-a3299e255260",
                                                "text": "Whereas in the middle ages the idea of acquiring wealth was limited by a body of moral rules imposed under the sanction of religious authority, after 1500 those rules, and the institutions, habits, and ideas to which they had given birth, were no longer deemed adequate. They were felt as constraint. There were evaded, criticized, abandoned, because it was felt that they interfered with the exploitation of the means of production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84c9b879-be37-3a4e-89ab-440705a6d247",
                                        "entry_id": "2317bf77-3849-3f79-8623-706f3488e3b3",
                                        "glosses": [
                                            "The improper use of something for selfish purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6573eddf-fead-482a-bcc5-e9a53bb99f8b",
                                                "sense_id": "84c9b879-be37-3a4e-89ab-440705a6d247",
                                                "text": "the exploitation of children in beauty pageants"
                                            },
                                            {
                                                "example_id": "e75504cb-d49e-4e1d-a6e5-869141828436",
                                                "sense_id": "84c9b879-be37-3a4e-89ab-440705a6d247",
                                                "text": "\"The second function is for seers who have used magic, but do not know about the second function. This criteria selects the informed while preventing premeditated exploitation of this function.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf4ead4-0e97-3f62-8c84-b9bcb46edb98",
                                        "entry_id": "2317bf77-3849-3f79-8623-706f3488e3b3",
                                        "glosses": [
                                            "The act or result of forcibly depriving someone of something to which they have a right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34eef85-a807-4a5f-8861-06ae55a02571",
                                                "sense_id": "2bf4ead4-0e97-3f62-8c84-b9bcb46edb98",
                                                "text": "Undocumented migrants are vulnerable to exploitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda2cb9c-8b1b-3558-aef8-c6fdb8891316",
                                        "entry_id": "2317bf77-3849-3f79-8623-706f3488e3b3",
                                        "glosses": [
                                            "The marketing and promotion of a film."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a32592-c7a8-4188-96eb-a3cd84f0a779",
                                                "sense_id": "eda2cb9c-8b1b-3558-aef8-c6fdb8891316",
                                                "text": "This territory continued to be the greatest field for the exploitation and distribution of our films non-theatrically, […]"
                                            },
                                            {
                                                "example_id": "d570df4f-70e7-4bdf-8bca-e91c794c929a",
                                                "sense_id": "eda2cb9c-8b1b-3558-aef8-c6fdb8891316",
                                                "text": "The difference is that obtaining increased financial input during the production phase of the film reduces the risk during the exploitation phase."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7749068e-0fd4-46a2-a2f0-d8d76a4f3d3d",
                        "source_entry_id": "93068095-78b1-38fb-9df4-5b8a46c57e64",
                        "source_sense_id": "7c5a2707-e259-3d29-b960-59fc04f6e29e",
                        "target_lang_word": "exploitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exploitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bff8cdd3-1a9e-345c-a415-58202d8526cd",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Action d’exploiter, de faire valoir une chose, d'en tirer le profit du produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016ffe02-4c5a-49d4-aef5-37ceca71a8ea",
                                                "sense_id": "bff8cdd3-1a9e-345c-a415-58202d8526cd",
                                                "text": "C'est vers le milieu du XIᵉ siècle que parait avoir été établie la première exploitation de la houille dans les environs de Newcastle en Angleterre, du moins en ce qui concerne l'Europe, car, d'après les récits des missionnaires, les Chinois se seraient servis de ce combustible bien avant notre ère."
                                            },
                                            {
                                                "example_id": "db07b702-82cd-4afa-ab5c-13891cb7d691",
                                                "sense_id": "bff8cdd3-1a9e-345c-a415-58202d8526cd",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            },
                                            {
                                                "example_id": "0905fae5-412c-40c5-b676-333f04ccec04",
                                                "sense_id": "bff8cdd3-1a9e-345c-a415-58202d8526cd",
                                                "text": "A Arles, l'archevêque, qui avait le monopole de l'exploitation de la graine d'écarlate, avec laquelle on fabriquait le teinture rouge, ne traitait, pour la vente de ses récoltes, qu'avec les juifs."
                                            },
                                            {
                                                "example_id": "a2eb3ea6-0818-48b7-9364-da87d1c94c84",
                                                "sense_id": "bff8cdd3-1a9e-345c-a415-58202d8526cd",
                                                "text": "L’exploitation des mines de la côte Ouest du Spitzberg a fait surgir à Kings Bay comme à Advent Bay des villages peuplés toute l'année; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517f7d1b-d3b2-3fb0-8e47-58ae2ef12ade",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Unité de production agricole gérée de façon indépendante (ferme, domaine, GAEC, EARL, etc.), formant une entité technique, économique et juridique sous une même gestion, quelle que soit la dispersion des parcelles et des bâtiments ; → voir exploitation agricole."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5ffe3b-0600-40fb-839a-9f15f3f69ced",
                                                "sense_id": "517f7d1b-d3b2-3fb0-8e47-58ae2ef12ade",
                                                "text": "Suspectant un foyer de grippe aviaire dans un élevage de canards, la préfecture des Landes a mis en place un périmètre de contrôle temporaire autour de cette exploitation qui est en cours de dépeuplement à titre préventif."
                                            },
                                            {
                                                "example_id": "f8cc22c0-3b87-419c-b584-ef7d3c5dca69",
                                                "sense_id": "517f7d1b-d3b2-3fb0-8e47-58ae2ef12ade",
                                                "text": "C’est grâce aux 9 millions d’exploitations agricoles européennes – et au secteur agroalimentaire au sens large – que l’Europe dispose des aliments les plus sains et de la qualité la plus élevée au monde. Il s’agit d’un atout stratégique, signifiant que l’Europe est vitale pour la sécurité alimentaire mondiale"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86086cb-d91c-3249-8df5-0b4183a06795",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Action de tirer de quelque chose ou de quelqu'un un profit illicite ou excessif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f41fd1a4-ca3a-460f-96ad-5910dbeebe23",
                                                "sense_id": "f86086cb-d91c-3249-8df5-0b4183a06795",
                                                "text": "Pour les radicaux, les multinationales sont des profiteuses de la faim qui jouent un rôle prépondérant dans l’exploitation des pauvres. L’aide et le commerce alimentaires sont « principalement des armes politiques dans les mains des puissants pour maintenir leur domination »."
                                            },
                                            {
                                                "example_id": "12a0bb28-0bf0-4e77-aec7-9a03b6d9d82a",
                                                "sense_id": "f86086cb-d91c-3249-8df5-0b4183a06795",
                                                "text": "Exploitation de la crédulité publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d01491f-098f-30c7-a526-c49eb91d6715",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Appropriation par le capital de la plus-value issue du surtravail des salariés, rendue possible par la séparation d’avec les moyens de production, indépendamment de toute illégalité."
                                        ],
                                        "tags": [
                                            "Marxism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd57d75a-26d3-4ece-a0d2-5ed765681790",
                                                "sense_id": "0d01491f-098f-30c7-a526-c49eb91d6715",
                                                "text": "Le grand capital voit dans le fascisme le moyen suprême qui lui permet de prolonger sa domination et son exploitation sur le monde du travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f816d3-674f-3f91-b6ac-e792a171fb9b",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Ensemble des activités nécessaires pour mettre en œuvre une installation, par exemple, un réseau de télécommunication."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "740701f9-d1a9-3426-b555-0ec91c31fcae",
                                        "entry_id": "48512577-2417-3531-9177-21fbfaf66c56",
                                        "glosses": [
                                            "Action ou processus d’exploiter une vulnérabilité afin de provoquer un comportement non prévu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a514c2e-069c-47da-998e-bb28f3afb483",
                                                "sense_id": "740701f9-d1a9-3426-b555-0ec91c31fcae",
                                                "text": "L’exploitation de cette faille peut permettre à un attaquant ayant accès au réseau local et non authentifié de corrompre la mémoire afin d’injecter du code arbitraire permettant de contourner le mécanisme d'amorçage sécurisé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
