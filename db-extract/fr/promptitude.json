        "fr-extract.jsonl": [
            {
                "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                "word": "promptitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a1ac07b-fb0f-407a-a063-3fa9c5b599b0",
                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "promptitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75814c02-1352-3159-93da-da0cfdd25839",
                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "glosses": [
                            "Rapidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a46a3e8-f91f-4e11-9c4c-a77b568e6a1d",
                                "sense_id": "75814c02-1352-3159-93da-da0cfdd25839",
                                "text": "Maintenant que j'ai exposé le procédé de M. Mathieu, je dois ajouter de suite que son expérience lui a appris que toutes les bruyères ne s'enracinent pas avec la même promptitude, et que, s'il y en a qui se trouvent bien enracinées après deux mois de couchage, il en est d'autres auxquelles il faut quatre, cinq ou six mois, et encore davantage."
                            }
                        ]
                    },
                    {
                        "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "glosses": [
                            "Disposition qui fait qu’on ne met aucun délai à entreprendre ou à exécuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19217ffc-cb96-4c6e-b71f-4ce506f03c63",
                                "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                                "text": "Le chevalier en fit autant avec une justesse et une promptitude qui tenaient de la magie."
                            },
                            {
                                "example_id": "eb6140fe-9bd2-4c53-8b60-0eaf711abdba",
                                "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                                "text": "— Mais […] la promptitude avec laquelle s’agitaient, à la moindre émotion, sa lèvre et ses épaisses moustaches, annonçaient évidemment que la tempête n’était qu’assoupie et se réveillerait facilement."
                            }
                        ]
                    },
                    {
                        "sense_id": "938d3ce8-aac1-3f23-b007-f232b04c9b99",
                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "glosses": [
                            "Vivacité de l’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e876ba9-b4c1-4a73-a9fe-053724db2c1a",
                                "sense_id": "938d3ce8-aac1-3f23-b007-f232b04c9b99",
                                "text": "Il lui arrivait même de s'émerveiller de la facilité, de la promptitude avec laquelle il avait illuminé ces arcanes, hier encore ténébreux et rébarbatifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36e97f28-dce0-4926-a265-597f0bcf7d6f",
                        "source_entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "target_lang_word": "promptitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promptitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bda087b2-5719-345a-b4fa-095b075152c1",
                                        "entry_id": "1db324af-711e-34a9-9898-b716bea16151",
                                        "glosses": [
                                            "The quality of being prompt; alacrity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1850ee4a-6dbb-466d-9214-25c18007cd14",
                                                "sense_id": "bda087b2-5719-345a-b4fa-095b075152c1",
                                                "text": "The pleasure evinced by Sir Charles was only less than that of his lady, and, as he appeared every way worthy of her, and sensible of her value, Mr. Glentworth bade her adieu with the more cheerfulness, and, on their return to the hotel, Isabella had ceased to lament the transaction, and all agreed to praise that promptitude of action which had enabled him to perform his wishes so happily."
                                            },
                                            {
                                                "example_id": "cee9c1af-fa44-4085-b114-063e5040a5ba",
                                                "sense_id": "bda087b2-5719-345a-b4fa-095b075152c1",
                                                "text": "\"I've been directed here to find Miss Susan Pike,\" the man outside explained, between fresh coughings. ¶ \"Well, then, mog your boots out of this as quick as ever you can!\" my Aunt replied, with great promptitude. \"You won't find her here!\""
                                            },
                                            {
                                                "example_id": "bc4f1bd7-0355-44bd-a31b-8f0c68fd1c84",
                                                "sense_id": "bda087b2-5719-345a-b4fa-095b075152c1",
                                                "text": "Small wonder then that the Indomitable's Captain, though in general a man of rapid decision, felt that circumspectness not less than promptitude was necessary."
                                            },
                                            {
                                                "example_id": "5104fdb8-7266-45c5-abad-d26899473b2f",
                                                "sense_id": "bda087b2-5719-345a-b4fa-095b075152c1",
                                                "text": "Also, much depended on an exceptional esprit de corps which permeated the whole staff, and achieved miracles of promptitude in such details as engine-changing and the marshalling of trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0093ec1-c305-443e-8c2a-a7d32dd0c9b5",
                        "source_entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                        "target_lang_word": "prontitud",
                        "target_lang_code": "es",
