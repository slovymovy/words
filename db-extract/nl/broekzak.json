                    {
                        "sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                        "entry_id": "6fb378ad-d020-3bed-b72e-9ee6f209a5af",
                        "glosses": [
                            "zak in een broek, meestal aan een van de zijkanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b903b1cd-d54b-44e6-ac48-02b2b5a06b18",
                                "sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                                "text": "Hij had zijn portemonnee in zijn broekzak."
                            },
                            {
                                "example_id": "cb7ed340-dc17-4253-bb5e-964d3823ea98",
                                "sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                                "text": "Ik greep in mijn broekzak en duwde mijn sleutels in de hand van Solange."
                            },
                            {
                                "example_id": "8bc6aa6a-408c-40d3-9d80-214e2e188665",
                                "sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                                "text": "Mijn hand gaat naar mijn broekzak en grijpt het wapen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9be782c1-0061-49b9-a869-6523077c578f",
                        "source_entry_id": "6fb378ad-d020-3bed-b72e-9ee6f209a5af",
                        "source_sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                        "source_sense_description": "zak in een broek",
                        "target_lang_word": "Hosentasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hosentasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5ea8e7f-8c33-3454-bfe0-69d32df901e3",
                                        "entry_id": "a9537fb0-6d09-3683-a8a3-12a85cb84c20",
                                        "glosses": [
                                            "Tasche, die an oder in einer Hose angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127295c7-186b-494a-9899-615a865cf830",
                                                "sense_id": "e5ea8e7f-8c33-3454-bfe0-69d32df901e3",
                                                "text": "„Noch mehr Kopfzerbrechen aber bereitete den Ermittlern der Inhalt seiner Hosentasche: Dort fanden sie zwei beschriebene Papierzettel - die einzig möglichen Hinweise auf die mysteriösen Umstände dieses Todesfalls.“"
                                            },
                                            {
                                                "example_id": "a76e1d5b-0e95-423c-a517-db025954ebcf",
                                                "sense_id": "e5ea8e7f-8c33-3454-bfe0-69d32df901e3",
                                                "text": "„Der Mann nahm ein Taschentuch aus einer Hosentasche und trocknete die Tränen, und dann kam er auf mich zu und wollte auch mich sofort umarmen.“"
                                            },
                                            {
                                                "example_id": "c926a432-74c7-45dd-a448-776f57d7ae22",
                                                "sense_id": "e5ea8e7f-8c33-3454-bfe0-69d32df901e3",
                                                "text": "„Danach wartete er, die Hand in der rechten Hosentasche um die entsicherte Waffe gespannt.“"
                                            },
                                            {
                                                "example_id": "f020b05a-c675-4330-a32e-488bb9c47822",
                                                "sense_id": "e5ea8e7f-8c33-3454-bfe0-69d32df901e3",
                                                "text": "„Zuletzt zieht sie aus ihrer Hosentasche die Autoschlüssel und legt sie vor Anrath auf den Tisch, als wäre er der Wagenlenker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77c05c22-05e1-40c2-9c36-c0de51f4fb25",
                        "source_entry_id": "6fb378ad-d020-3bed-b72e-9ee6f209a5af",
                        "source_sense_id": "458d8f9c-cb14-30fe-b029-f218e4694c66",
                        "source_sense_description": "zak in een broek",
                        "target_lang_word": "pocket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cee465-a535-36b4-9558-3ddc7013baba",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "A bag stitched to an item of clothing, used for carrying small items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516513e4-95dd-4f61-81ca-1f8d66e5bdf9",
                                                "sense_id": "c7cee465-a535-36b4-9558-3ddc7013baba",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bf4f6f0-6409-3c05-b6bd-c54e603de2c8",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "A person's financial resources."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9d8baa-24dd-41ea-82c2-66a9e7c6d828",
                                                "sense_id": "1bf4f6f0-6409-3c05-b6bd-c54e603de2c8",
                                                "text": "I paid for it out of my own pocket."
                                            },
                                            {
                                                "example_id": "f7314b6b-491a-41f6-b169-1df56f290b64",
                                                "sense_id": "1bf4f6f0-6409-3c05-b6bd-c54e603de2c8",
                                                "text": "There was, for much of the period, no cheap public transport; and even the Underground, or one of Shillibeer's horse-drawn omnibuses, was beyond the pocket of many of the poor."
                                            },
                                            {
                                                "example_id": "4b9f2f7c-fc25-4297-adcd-73a10c3d01db",
                                                "sense_id": "1bf4f6f0-6409-3c05-b6bd-c54e603de2c8",
                                                "text": "\"The financial impact of the fuel duty cut on people's pockets will in fact be minimal, […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d33392-95c1-37ea-a86e-ef96808cf7d8",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "An indention and cavity with a net sack or similar structure (into which the balls are to be struck) at each corner and one centered on each side of a pool or snooker table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bce23947-d1ca-3582-8af4-a7289228f4b2",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "An enclosed volume of one substance surrounded by another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffb2900-bd52-4309-aef9-8708dd359b81",
                                                "sense_id": "bce23947-d1ca-3582-8af4-a7289228f4b2",
                                                "text": "She knew from avalanche safety courses that outstretched hands might puncture the ice surface and alert rescuers. She knew that if victims ended up buried under the snow, cupped hands in front of the face could provide a small pocket of air for the mouth and nose. Without it, the first breaths could create a suffocating ice mask."
                                            },
                                            {
                                                "example_id": "8fdb1f1c-5250-4a29-9963-9d7d9166d9d8",
                                                "sense_id": "bce23947-d1ca-3582-8af4-a7289228f4b2",
                                                "text": "The drilling expedition discovered a pocket of natural gas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088ff282-6deb-360f-a250-8f4a827daf7d",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "An area of land surrounded by a loop of a river."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1095a292-243c-3ec8-bfd8-7b50b5494216",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "The area of the field to the side of the goal posts (four pockets in total on the field, one to each side of the goals at each end of the ground). The pocket is only a roughly defined area, extending from the behind post, at an angle, to perhaps about 30 meters out."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d3362c0-856e-31fe-a296-97fd1cc443eb",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "The area behind the line of scrimmage subject to certain rules regarding intentional grounding, illegal contact, etc., formally extending to the end zone but more usually understood as the central area around the quarterback directly protected by the offensive line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0dfc832-43eb-41ce-80bd-0bfdfdbbf0bf",
                                                "sense_id": "3d3362c0-856e-31fe-a296-97fd1cc443eb",
                                                "text": "For many years, the popular belief among NFL analysts was that the success of an NFL team comes with a quarterback who can stand tall in the pocket and deliver the ball downfield. Members of the elite group of active quarterbacks, Peyton Manning, Tom Brady and Drew Brees, for instance, also earned their reputation by making plays almost exclusively from the pocket."
                                            },
                                            {
                                                "example_id": "e8dcb806-942b-48cc-916b-83ee4be9fb40",
                                                "sense_id": "3d3362c0-856e-31fe-a296-97fd1cc443eb",
                                                "text": "With some notable exceptions, NFL teams that are successful on dropbacks outside the pocket have tended to win more games"
                                            },
                                            {
                                                "example_id": "3b2a478b-6ade-4057-881f-5c7f40654105",
                                                "sense_id": "3d3362c0-856e-31fe-a296-97fd1cc443eb",
                                                "text": "The Pocket Area is the area between the outside edges of the normal tackle positions on each side of the center extending backward to the offensive team's end line. After the ball leaves the pocket area, this area no longer exists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e78fad-5d79-3a05-b36c-7913ccbe4452",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "An area where military units are completely surrounded by enemy units."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58ecc197-9349-3b58-abaf-c259ef7c2c9f",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "The position held by a second defensive middle, where an advanced middle must retreat after making a touch on the attacking middle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41ebbe0-895a-45af-afdc-710f4fd3c711",
                                                "sense_id": "58ecc197-9349-3b58-abaf-c259ef7c2c9f",
                                                "text": "Matt Stevens was crumpled by Euan Murray in another scrum, allowing Parks to kick for the corner, and when Richie Gray's clean take from the subsequent line-out set up a series of drives under the posts, Parks was back in the pocket to belt over a drop-goal to make it 9-3 at the interval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c4e865-5a1f-3d24-b7de-5d0cfe070656",
                                        "entry_id": "35954e65-d902-3a2c-9424-e6a86d46d61e",
                                        "glosses": [
                                            "The unbroken part of a wave that offers the surfer the most power."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
