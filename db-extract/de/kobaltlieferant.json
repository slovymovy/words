                "senses": [
                    {
                        "sense_id": "efbc2c32-5edb-362b-8dd3-49a2a5ff774d",
                        "entry_id": "c942a8bb-2e3b-3509-86c2-761e43cffbb5",
                        "glosses": [
                            "Unternehmen oder Land, das Kobalt fördert, verkauft und/oder exportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a92e5c3-3197-4e1c-8a0e-766bb447b1ba",
                                "sense_id": "efbc2c32-5edb-362b-8dd3-49a2a5ff774d",
                                "text": "„Ein großer Kobaltlieferant ließe sich mitten im Hochlauf der Elektromobilität auf die Schnelle kaum ersetzen.“"
                            },
                            {
                                "example_id": "968640a5-73be-4402-9f32-8b79905f8579",
                                "sense_id": "efbc2c32-5edb-362b-8dd3-49a2a5ff774d",
                                "text": "„Nach 1923 trat Belgisch - Kongo als bedeutender Kobaltlieferant auf den Plan.“"
                            },
                            {
                                "example_id": "3f9d00a0-74a3-429f-bac3-8a368fe9e08f",
                                "sense_id": "efbc2c32-5edb-362b-8dd3-49a2a5ff774d",
                                "text": "„2004 galt Subsahara-Afrika als Chinas bedeutsamster Kobaltlieferant (85 % der chinesischen Importe) und deckte mehr als 30% des chinesischen Manganbedarfes und rund ein Sechstel der chinesischen Holzimporte.“"
                            },
                            {
                                "example_id": "cbb0bc1d-61b7-4542-80c3-8cc6470251e8",
                                "sense_id": "efbc2c32-5edb-362b-8dd3-49a2a5ff774d",
                                "text": "„Trotz erheblicher Erzreserven und bedeutender Förderung sind die Lagerstätten dieses Typus als Kobaltlieferanten nicht besonders wichtig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
