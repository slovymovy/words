                                "target_lang_word": "are",
                                "target_lang_sense_clarification": "second person singular of 'to be'"
                            },
                            {
                                "target_lang_word": "find yourself",
                                "target_lang_sense_clarification": "to be in a particular place or situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2e798b8-c374-3108-861d-c5bc054b825e",
                    "sense_definition": "de gebiedende wijs van <w>bevinden</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bevind</w> u niet op verboden terrein om een boete te voorkomen.",
                            "target_lang_translations": {
                                "en": "Do not <w>be</w> on prohibited grounds to avoid a fine."
                            }
                        },
                        {
                            "text": "<w>Bevind</w> u in de startpositie zodra het startschot klinkt.",
                            "target_lang_translations": {
                                "en": "<w>Be</w> in the starting position as soon as the starting shot sounds."
                            }
