                    "frequency": "VeryLow",
                    "semantic_group_id": "ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient priest made a solemn <w>libation</w> of wine at the sacred altar."
                        },
                        {
                            "text": "Before beginning the ceremony, they offered a <w>libation</w> to the memory of their ancestors."
