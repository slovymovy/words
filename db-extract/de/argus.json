                ],
                "senses": [
                    {
                        "sense_id": "c5310a72-6313-3b3d-8b30-98c5d9a77849",
                        "entry_id": "6c5cb3dc-b513-3869-84af-82d53c255e26",
                        "glosses": [
                            "Name eines hundertäugigen Riesen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3cb30dcf-595c-4f0c-b3fa-56c186f347d0",
                                "sense_id": "c5310a72-6313-3b3d-8b30-98c5d9a77849",
                                "text": "Argus, Sohn des Arestor und der Nymphe Mykene, diente der Göttin Hera als Bewacher der Io, einer Geliebten des Zeus."
                            },
                            {
                                "example_id": "1437b3af-d9d2-4721-a8b9-d26440a442e3",
                                "sense_id": "c5310a72-6313-3b3d-8b30-98c5d9a77849",
                                "text": "„Mögen auch Augen so viel dich bewachen, als Argus besessen, / Wirst du sie hintergehn, wenn du den Willen nur hast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72a69c94-93dd-38ee-a10a-bdb41e881292",
                        "entry_id": "6c5cb3dc-b513-3869-84af-82d53c255e26",
                        "glosses": [
                            "Wächter, der scharf und misstrauisch beobachtet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ecbd7a4c-7319-4e2c-a2e8-9ce6c8f78184",
                                "sense_id": "72a69c94-93dd-38ee-a10a-bdb41e881292",
                                "text": "„Nein, kein Argus behielt von allen seinen Augen nicht zwei im Bette offen, zumal da er die Flöte zum Einschläfern selber bläst.“"
                            },
                            {
                                "example_id": "4dd1980e-5b44-4b5b-a330-d1552c0c4f8b",
                                "sense_id": "72a69c94-93dd-38ee-a10a-bdb41e881292",
                                "text": "„Ohne die Gegenwart des ekelhaften Argus hätten alle diese Geschichten ohne Zweifel ihre natürliche Wirkung auf mich geübt, wenn ich sie auch nicht liebte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
