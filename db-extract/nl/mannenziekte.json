                        "entry_id": "7c12a5a7-bd69-36c2-83d1-8eeb0ed52ff5",
                        "glosses": [
                            "aandoening die meer bij mannen dan bij vrouwen voorkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29606ff2-fded-4c99-8bab-57cfb9b13fda",
                                "sense_id": "112eeb30-a3fa-35b8-beab-17abb0df1d52",
                                "text": "Vroeger was longkanker vooral een mannenziekte. Maar wij vrouwen zijn met een fikse inhaalslag bezig. Hier wel dus."
                            }
                        ]
