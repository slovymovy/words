{
    "word_family": [
        "bouillon",
        "bouillonnement",
        "bouillonnant",
        "bouillir",
        "bouillotte"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d623697d-74b7-3cc1-8af6-249b829bbb0a",
                    "sense_definition": "Former des bulles ou des remous sous l'effet de la chaleur ou d'une vive agitation, en parlant d'un liquide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La soupe commence à <w>bouillonner</w> dans la grande marmite posée sur le feu."
                        },
                        {
                            "text": "L'eau de la cascade tombait avec force en faisant <w>bouillonner</w> le torrent."
                        }
                    ],
                    "synonyms": [
                        "mousser",
                        "frémir"
                    ],
                    "common_phrases": [
                        "faire bouillonner"
                    ]
                },
                {
                    "sense_id": "d6e7b4f8-3435-3b61-8bdd-06e9d988a412",
                    "sense_definition": "Éprouver une vive émotion contenue, particulièrement de la colère ou de l'impatience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à tant d'injustice, il ne disait rien mais <w>bouillonnait</w> de colère au fond de lui."
                        },
                        {
                            "text": "Elle <w>bouillonne</w> d'impatience à l'idée d'ouvrir enfin tous ses cadeaux."
                        }
                    ],
                    "synonyms": [
                        "enrager"
                    ],
                    "common_phrases": [
                        "bouillonner de colère",
                        "bouillonner d'impatience"
                    ]
                },
                {
                    "sense_id": "893c2c7d-2531-3f02-ada1-bbc6d607e6f5",
                    "sense_definition": "Être animé d'une grande vivacité, d'un foisonnement d'idées ou d'une activité intense.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "activite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'esprit du jeune créateur <w>bouillonne</w> d'idées nouvelles pour son prochain projet."
                        },
                        {
                            "text": "Ce quartier historique de la ville <w>bouillonne</w> d'activité dès le début de la matinée."
                        }
                    ],
                    "synonyms": [
                        "foisonner",
                        "fourmiller"
                    ],
                    "common_phrases": [
                        "bouillonner d'idées",
                        "bouillonner de vie"
                    ]
                },
                {
                    "sense_id": "50ff45b4-d091-3d7a-aa26-11a52c903569",
                    "sense_definition": "Garnir une étoffe ou un vêtement de plis amples et gonflés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière a choisi de <w>bouillonner</w> le bas de la robe pour lui donner du volume."
                        },
                        {
                            "text": "Elle préférait <w>bouillonner</w> les rideaux du salon pour créer un effet plus spectaculaire."
                        }
                    ]
                }
            ]
        }
    ]
}