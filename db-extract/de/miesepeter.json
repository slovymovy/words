                ],
                "senses": [
                    {
                        "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                        "entry_id": "0db4c18a-de0a-3ae7-839c-33df58f57334",
                        "glosses": [
                            "Person, die Vieles schlecht findet oder macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482d4a5d-f675-45ff-8d90-1c989827395f",
                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                "text": "Ich habe noch selten einen Miesepeter wie ihn erlebt."
                            },
                            {
                                "example_id": "56603988-307b-4d6d-ac78-856c91dc8473",
                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                "text": "„Der Miesepeter hielt fortan seinen Mund, und so konnte Laura Leonore ihrem Enthusiasmus freie Bahn lassen.“"
                            },
                            {
                                "example_id": "186b8ce4-e882-4828-8585-5f99d934a5f5",
                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                "text": "„Meine Beschäftigung mit den kleinsten Einzelheiten der Vergangenheit, die mir soviel Vergnügen bereitet und die menschliche Natur auf eine Art erhellt, die sie mir erträglich macht, werden als Korinthenkackerei angesehen oder als Beweis für einen geistigen Miesepeter, der mit sich selbst im Streit liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28cea765-2c6c-4a24-9fc9-b2a7719eb5db",
                        "source_entry_id": "0db4c18a-de0a-3ae7-839c-33df58f57334",
                        "source_sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                        "source_sense_description": "Person, die Vieles schlecht findet oder macht",
                        "target_lang_word": "whinger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc00d823-5c97-3875-9797-2007a7fd079b",
                                        "entry_id": "d0d3819b-2522-3062-8825-b335d229373d",
                                        "glosses": [
                                            "One who whinges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a1b2b7-6fc9-4ed3-9d16-8c6329896751",
                                                "sense_id": "fc00d823-5c97-3875-9797-2007a7fd079b",
                                                "text": "The idea of a British warship supposedly menacing Spain is ludicrous. Is it meant to bomb Cadiz? Will its guns lift a rush-hour tailback in a colony that most Britons regard as awash with tax dodgers, drug dealers and right-wing whingers? The Gibraltarians have rights, but why British taxpayers should send warships to enforce them, even if just \"on exercise\", is a mystery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb9f54e-11c2-3d02-8f48-3ac15f4d22f4",
                                        "entry_id": "78ce1ee4-9138-39be-a32b-fdc9fbe57947",
                                        "glosses": [
                                            "A whinyard."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7c09ed-a757-410e-9be2-63128669c251",
                                                "sense_id": "2cb9f54e-11c2-3d02-8f48-3ac15f4d22f4",
                                                "text": "“Fye on you, why do you not strike your whingers into me, or blow me up with a barrel of powder, rather than torture me thus unmercifully?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
