                            },
                            {
                                "target_lang_word": "personality",
                                "target_lang_sense_clarification": "a famous person, celebrity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f07b5873-c057-353a-a34a-2a22817dc79b",
                    "sense_definition": "Podmiot stosunków prawnych, posiadający zdolność prawną.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każda <w>osoba</w> fizyczna ma prawo do ochrony swoich danych osobowych.",
                            "target_lang_translations": {
                                "ru": "Каждое физическое <w>лицо</w> имеет право на защиту своих персональных данных.",
                                "en": "Every natural <w>person</w> has the right to the protection of their personal data."
                            }
                        },
                        {
                            "text": "Nasza firma współpracuje zarówno z <w>osobami</w> prawnymi, jak i prywatnymi przedsiębiorcami.",
                            "target_lang_translations": {
                                "ru": "Наша фирма сотрудничает как с юридическими <w>лицами</w>, так и с частными предпринимателями.",
                                "en": "Our company cooperates with both legal <w>entities</w> and private entrepreneurs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "osoba fizyczna",
                        "osoba prawna"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "termin prawniczy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Субъект правоотношений, обладающий правоспособностью.",
                        "en": "An entity with legal rights and duties, such as a natural person or a corporation."
