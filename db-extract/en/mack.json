                "translations": [
                    {
                        "translation_id": "4d19aec9-6d05-4c0f-903a-a58f3638641d",
                        "source_entry_id": "e6f6df1e-3375-3473-998a-9c48f9581db3",
                        "source_sense_description": "To act as pimp; to pander",
