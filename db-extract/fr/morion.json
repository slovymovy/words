            {
                "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                "word": "morion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e709eb5-0db2-42d9-965b-44c708772882",
                        "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                        "tags": [
                            "plural"
                        ],
                        "form": "morions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                        "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                        "glosses": [
                            "Sorte d’armure de tête plus légère que le casque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826ba622-c282-443e-8a6b-e631cb1023c7",
                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                "text": "Il n’avait qu’un simple morion."
                            },
                            {
                                "example_id": "6cc74feb-32de-42b3-9c4e-144fad126d35",
                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                "text": "Sous la camisole de mailles et le morion d'acier, les deux hommes devaient être en nage, mais ils s'abstinrent de toute plainte."
                            },
                            {
                                "example_id": "ddcd4adf-7d5d-4e48-8454-644961440ec5",
                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                "text": "Notre troupe comptait en tout une dizaine de blessés, dont trois des nôtres […] Cabusse, d'une balle qui, ayant percé son morion et rasé son cuir chevelu, le faisait saigner comme un boeuf."
                            },
                            {
                                "example_id": "80e0e7dc-fdf0-414e-83cd-d0000440d535",
                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                "text": "Il tenait son morion de vache à la main, comme un paysan intimidé devant son propriétaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                        "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                        "glosses": [
                            "Punition militaire qui consistait en des coups de hampe de hallebarde, etc., sur le derrière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48904d37-fd1d-4dc1-b090-84f6f468b8db",
                                "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                                "text": "Donner le morion."
                            },
                            {
                                "example_id": "542e52f9-19bd-438d-9625-c85f548a1c91",
                                "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                                "text": "Que sur peine de morion,\nAutant chevalier que pion,\nPersonne ne mit pied à terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ade3186e-d7e5-4030-95d2-1541adf3238d",
                        "source_entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                        "source_sense_description": "armure de tête",
                        "target_lang_word": "morion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                        "entry_id": "dec81638-1bad-39d0-81e0-6d19181e9273",
                                        "glosses": [
                                            "A kind of open brimmed helmet used by footsoldiers in the 16th and 17th centuries, having no visor or bevor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b199f661-92f7-4765-8a98-a58e2916952d",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "The Roman footmen caried not their morions, sword and target only, as for other armes (saith Cicero) they were so accustomed to weare them continually, that they hindered them no more than their limbs[…]."
                                            },
                                            {
                                                "example_id": "47b6fb05-7205-40ae-9783-15f55dfa3ac1",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "This unlucky defect, however, his industry supplied by a vizor, which he made of paste-board, and fixed so artificially to the morrion, that it looked like an intire helmet."
                                            },
                                            {
                                                "example_id": "18b7a180-f1b9-48c5-8d2d-ade9d0c609ce",
                                                "sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                                                "text": "The morion is a kind of open helmet, without visor or bever, somewhat resembling a hat; it was commonly worn by the harqubussiers and musqueteers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "262e791c-f10a-3661-a5c2-84fb658d7aad",
                                        "entry_id": "9a0cb8ac-0200-3da9-a9a8-f0d162e650dd",
                                        "glosses": [
                                            "A brown or black variety of quartz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
