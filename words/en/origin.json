                                "target_lang_sense_clarification": "事物的发端"
                            },
                            {
                                "target_lang_word": "开端",
                                "target_lang_sense_clarification": "开始的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7315ad52-0e32-39fe-bcb8-d9d62652e84b",
                    "sense_definition": "The source from which something comes, such as a river, information, or goods.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to verify the country of <w>origin</w> for these imported goods.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проверить страну <w>происхождения</w> этих импортных товаров.",
                                "zh": "我们需要核实这些进口商品的<w>产地</w>。"
                            }
                        },
                        {
                            "text": "They hiked for days to find the <w>origin</w> of the river.",
                            "target_lang_translations": {
                                "ru": "Они шли несколько дней, чтобы найти <w>исток</w> реки.",
                                "zh": "他们徒步数日去寻找这条河流的<w>源头</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "source"
                    ],
                    "antonyms": [
                        "destination"
                    ],
                    "common_phrases": [
                        "country of origin",
                        "certificate of origin"
                    ],
                    "target_lang_definitions": {
