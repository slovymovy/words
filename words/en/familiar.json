{
    "word_family": [
        "familiarity",
        "familiarize",
        "familiarly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                    "sense_definition": "Well-known or easily recognized; frequently seen or experienced.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "knowledge_recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face looks <w>familiar</w>, but I cannot remember her name.",
                            "target_lang_translations": {
                                "ru": "Её лицо кажется <w>знакомым</w>, но я не могу вспомнить её имя.",
                                "zh": "她的脸看起来很<w>熟悉</w>，但我记不起她的名字了。"
                            }
                        },
                        {
                            "text": "This song sounds very <w>familiar</w> to me.",
                            "target_lang_translations": {
                                "ru": "Эта песня кажется мне очень <w>знакомой</w>.",
                                "zh": "这首歌听起来让我感到很<w>熟悉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "known",
                        "recognizable"
                    ],
                    "antonyms": [
                        "unknown",
                        "unfamiliar",
                        "strange",
                        "unaccustomed"
                    ],
                    "common_phrases": [
                        "look familiar",
                        "sound familiar",
                        "familiar face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо известный или легко узнаваемый; часто встречающийся.",
                        "zh": "众所周知的或容易辨认的；经常见到或经历过的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомый",
                                "target_lang_sense_clarification": "известный, виденный ранее"
                            },
                            {
                                "target_lang_word": "известный",
                                "target_lang_sense_clarification": "общепризнанный, популярный"
                            },
                            {
                                "target_lang_word": "привычный",
                                "target_lang_sense_clarification": "обыденный, традиционный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熟悉",
                                "target_lang_sense_clarification": "了解并能辨认"
                            },
                            {
                                "target_lang_word": "常见",
                                "target_lang_sense_clarification": "经常见到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9381e1c-8ae4-30c4-9373-59d782d7f448",
                    "sense_definition": "Having knowledge or experience of a particular subject or method.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "knowledge_acquaintance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>familiar</w> with the safety rules of this building?",
                            "target_lang_translations": {
                                "ru": "Вы <w>знакомы</w> с правилами безопасности в этом здании?",
                                "zh": "你<w>熟悉</w>这栋大楼的安全规定吗？"
                            }
                        },
                        {
                            "text": "I am not <w>familiar</w> with this type of computer software.",
                            "target_lang_translations": {
                                "ru": "Я не <w>знаком</w> с этим типом компьютерных программ.",
                                "zh": "我不<w>熟悉</w>这种类型的计算机软件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acquainted"
                    ],
                    "antonyms": [
                        "unacquainted",
                        "ignorant"
                    ],
                    "common_phrases": [
                        "familiar with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий знаниями или опытом в определенном предмете или методе.",
                        "zh": "对特定主题或方法有了解或经验。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомый",
                                "target_lang_sense_clarification": "осведомленный, знающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熟悉",
                                "target_lang_sense_clarification": "了解某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                    "sense_definition": "Close, friendly, or informal in personal relationships.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_intimacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They seem to be on very <w>familiar</w> terms with the director.",
                            "target_lang_translations": {
                                "ru": "Кажется, они в очень <w>близких</w> отношениях с директором.",
                                "zh": "他们和导演的关系似乎非常<w>亲密</w>。"
                            }
                        },
                        {
                            "text": "Do not be too <w>familiar</w> with clients you have just met.",
                            "target_lang_translations": {
                                "ru": "Не будьте слишком <w>фамильярны</w> с клиентами, которых вы только что встретили.",
                                "zh": "不要对刚见面的客户表现得太<w>随便</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intimate",
                        "friendly",
                        "close",
                        "personal"
                    ],
                    "antonyms": [
                        "distant",
                        "cold",
                        "unfriendly",
                        "impersonal",
                        "standoffish"
                    ],
                    "common_phrases": [
                        "on familiar terms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий, дружеский или неформальный в личных отношениях; иногда бесцеремонный.",
                        "zh": "在个人关系中亲密、友好或非正式的；有时指过于随便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фамильярный",
                                "target_lang_sense_clarification": "бесцеремонный, панибратский"
                            },
                            {
                                "target_lang_word": "близкий",
                                "target_lang_sense_clarification": "доверительный, дружеский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲密",
                                "target_lang_sense_clarification": "关系密切"
                            },
                            {
                                "target_lang_word": "随便",
                                "target_lang_sense_clarification": "过于不拘礼节"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                    "sense_definition": "A spirit, often in the form of an animal, that serves a witch or magician.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The black cat was said to be the witch's <w>familiar</w>.",
                            "target_lang_translations": {
                                "ru": "Говорили, что черный кот был <w>фамильяром</w> ведьмы.",
                                "zh": "据说那只黑猫是女巫的<w>使魔</w>。"
                            }
                        },
                        {
                            "text": "The wizard summoned his <w>familiar</w> to carry a secret message.",
                            "target_lang_translations": {
                                "ru": "Волшебник призвал своего <w>фамильяра</w>, чтобы передать тайное послание.",
                                "zh": "魔法师召唤了他的<w>使魔</w>去传递秘密信息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "witch's familiar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дух, часто в форме животного, который служит ведьме или магу.",
                        "zh": "一种通常以动物形式出现的、侍奉女巫或魔法师的灵体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фамильяр",
                                "target_lang_sense_clarification": "дух-помощник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使魔",
                                "target_lang_sense_clarification": "魔法中的灵体助手"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}