                "senses": [
                    {
                        "sense_id": "6a14b0b0-cfd3-376f-b8e1-59879c8b2d2f",
                        "entry_id": "dfae8325-70e6-3da2-a5c2-1230f7b68dc0",
                        "glosses": [
                            "ein Schädelknochen des Karpfens; ein knorpelartiger Knochen, welcher etwas linsenförmig und dreieckig, hart und auswendig grau ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46965cd7-fa6d-4806-a959-e5e9eddb4323",
                                "sense_id": "6a14b0b0-cfd3-376f-b8e1-59879c8b2d2f",
                                "text": "„Sie sind schmal und hoch gebaut, haben keine Zähne in den Kiefern, dagegen auf den Schlundknochen, und diese Zähne wirken gegen eine hornige Platte des Gaumens, den Karpfenstein; die davor gelegene Gaumenhaut (Karpfenzunge) ist sehr dick, wulstig und nervenreich; der ganze Körper mit Ausnahme des Kopfes ist mit runden Schuppen bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
