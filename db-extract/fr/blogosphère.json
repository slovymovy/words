                        "cross_references": [
                            {
                                "target_word": "blogosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                        "entry_id": "6112bd62-a7ae-3fa5-906a-41e523ca1017",
                                        "glosses": [
                                            "The totality of blogs, especially the unique jargon, cultures and shared interests created by their interconnection."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca268126-5776-4c6c-a319-2eac0a6f04f8",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "2004 Air America Radio http://www.airamericaradio.com/\nRegular guest and blogger, Kos of DailyKos.com, provides Sam and Janeane the latest information from the blogosphere."
                                            },
                                            {
                                                "example_id": "5a123103-fe69-4902-bd97-83559a8c4142",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "The blogosphere is relentless: It rightfully hammered Eason Jordan and CNN from day one and refuses to stop."
                                            },
                                            {
                                                "example_id": "23fa6098-0a68-4f4e-8e41-11f1397d446b",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "there's some talk, as you said, on the blogosphere, that this book is controversial, but I think more properly it's a contribution..."
                                            },
                                            {
                                                "example_id": "29809c7b-738d-49f8-b57a-e05128ab771e",
                                                "sense_id": "d991a20c-0e3b-3e60-913d-0cf75d57713f",
                                                "text": "And the liberal blogosphere has long labeled Clinton part of the neoconservative wing, a conservative intellectual movement that supports an interventionist foreign policy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
