                "senses": [
                    {
                        "sense_id": "59265afa-4881-3f4c-82e3-ca93fbb947ca",
                        "entry_id": "09eace7b-5bb2-3326-9d6a-d83cd7e1ceb0",
                        "glosses": [
                            "sehr erniedrigt, in seiner Würde stark herabgesetzt, in seinem Stolz sehr verletzt, Schande auf sich geladen habend"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "ec48aed7-683b-45b7-8ab1-0d8f4c96e1c0",
                                "sense_id": "59265afa-4881-3f4c-82e3-ca93fbb947ca",
                                "text": "„Der Wille der Fürstin siegte, der Henker waltete seines Amtes und Dietlieb’s Weib und Kinder wurden schmachbeladen aus den Thoren der Stadt gejagt, den Diamant jedoch hatte man nicht wieder gefunden.“"
