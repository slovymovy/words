                "senses": [
                    {
                        "sense_id": "aa3fc2cf-396a-3354-a87b-68d9b05e0832",
                        "entry_id": "febda9f2-52cd-37f7-bf98-178de642868d",
                        "glosses": [
                            "мифол., фант. относящийся ко времени после апокалипсиса (мифического конца света)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcb6b1d7-d9e9-487a-aeea-86f4dea8b9af",
                                "sense_id": "aa3fc2cf-396a-3354-a87b-68d9b05e0832",
                                "text": "В постапокалиптической Британии есть даже телевидение: канал BBC перешёл на адресное вещание."
                            },
                            {
                                "example_id": "8c4d3c14-43fe-4a4b-af27-0726592e2ed7",
                                "sense_id": "aa3fc2cf-396a-3354-a87b-68d9b05e0832",
                                "text": "12 июня вышел третий постапокалиптический роман Дмитрия Глуховского о жизни в московском метро после ядерной войны."
                            }
                        ]
                    }
                ],
