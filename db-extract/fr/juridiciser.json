                "senses": [
                    {
                        "sense_id": "d6bc358f-07c5-3f49-9f95-bb74612ef3d6",
                        "entry_id": "032b8f20-4b27-3401-9741-b41a34841c0f",
                        "glosses": [
                            "Donner un caractère juridique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6300eff9-cb08-4e7f-bcca-88fbaa388710",
                                "sense_id": "d6bc358f-07c5-3f49-9f95-bb74612ef3d6",
                                "text": "Elle ne croit pas que la solution consisterait à juridiciser à l’extrême ces situations."
                            },
                            {
                                "example_id": "519c495f-a181-4dbf-9d92-95d085452cd0",
                                "sense_id": "d6bc358f-07c5-3f49-9f95-bb74612ef3d6",
                                "text": "Ainsi en est-il aujourd’hui de la notion de patrimoine génétique ou de celle d’espèce humaine, issue de la biologie et qu’il faut juridiciser."
                            },
                            {
                                "example_id": "a753222c-747e-4046-aa22-eedee60d5797",
                                "sense_id": "d6bc358f-07c5-3f49-9f95-bb74612ef3d6",
                                "text": "Cette évolution jurisprudentielle vient chambouler le modèle de la normalisation technique. En effet, vu que ces normes se juridicisent et seront désormais gratuites, le mode de production et de financement de ces organismes de normalisation ainsi que le modèle de protection de la propriété intellectuelle doivent être repensés sans tarder."
                            }
                        ]
                    }
