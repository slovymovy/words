        "nl-extract.jsonl": [
            {
                "entry_id": "42234bc6-fe1e-3fac-87b9-979c660e9ef2",
                "word": "autonoom",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                        "entry_id": "42234bc6-fe1e-3fac-87b9-979c660e9ef2",
                        "glosses": [
                            "op zichzelf staand, zelfstandig, onafhankelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbba33e4-cb6e-4306-8f5c-cd4587a3ce1a",
                                "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                                "text": "Google gaat zijn zelfrijdende auto’s leren meer als mensen te rijden. Dat betekent dat de autonome voertuigen bochten gaan afsnijden en over dubbele doorgetrokken strepen zullen rijden."
                            },
                            {
                                "example_id": "6bb5c57a-e4d6-4175-9f58-003cae867ad6",
                                "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                                "text": "De autonome ontwikkeling van kinderen is misschien wel belangrijker dan het gereguleerde onderwijs."
                            },
                            {
                                "example_id": "ebe45dc9-5c6f-40d0-90ab-1afe837e62a7",
                                "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                                "text": "Het alleen zijn maakte me juist wakker. Wellicht was ik door mijn drukke agenda thuis wat mat en ingeslapen geraakt. Deze wakkerheid gaf me een autonoom gevoel. Ik leefde geheel afgezonderd in mijn eigen bubbel, in mijn eigen werkelijkheid en zolang ik niet gek zou worden vond ik het heerlijk."
                            },
                            {
                                "example_id": "8b23fcda-b51b-4193-a945-ca228467f848",
                                "sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                                "text": "Met weemoed denk ik aan Benjamin en hoe autonoom hij al is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05e4ac13-1529-47b9-b5b5-2f10f20aee2d",
                        "source_entry_id": "42234bc6-fe1e-3fac-87b9-979c660e9ef2",
                        "source_sense_id": "272ff162-492a-34f6-8a62-e887238f8be6",
                        "source_sense_description": "op zichzelf staand",
                        "target_lang_word": "autonom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ad59e3-c538-36f0-9ca4-f5d05e5c595b",
                                        "entry_id": "7e5984b5-2d6d-3703-9aa6-215ddacd77a0",
                                        "glosses": [
                                            "sich eigene Gesetze gebend, nach eigenen Gesetzen lebend, verwaltungsmäßig selbstständig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f019d57-af20-42bd-8703-be90d41b6c3b",
                                                "sense_id": "e2ad59e3-c538-36f0-9ca4-f5d05e5c595b",
                                                "text": "„Manager Alsworth-Elvey hofft nun auf noch mehr Absatz, im autonomen Staat könnte mehr getrunken werden.“"
                                            },
                                            {
                                                "example_id": "cef3b9e8-699c-418f-ad14-a9fc120a2e27",
                                                "sense_id": "e2ad59e3-c538-36f0-9ca4-f5d05e5c595b",
                                                "text": "„Hannibals politische Konzeption gipfelte in dem Bestreben, Karthago als ein außerhalb des römischen Machtmonopols stehendes, autonomes Staatswesen zu erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "567d7346-7eec-392d-b716-5bd014423728",
                                        "entry_id": "7e5984b5-2d6d-3703-9aa6-215ddacd77a0",
                                        "glosses": [
                                            "frei von äußeren Einflüssen und/oder Regeln"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c28956-e9a1-41c3-ad30-9a27118628da",
                                                "sense_id": "567d7346-7eec-392d-b716-5bd014423728",
                                                "text": "„Bei den Kuna handelt es sich vielleicht um eine der autonomsten und unabhängigsten indigenen Gemeinschaften in Lateinamerika.“"
                                            },
                                            {
                                                "example_id": "04e37356-ae88-4d21-833f-dc0d1ff4a58f",
                                                "sense_id": "567d7346-7eec-392d-b716-5bd014423728",
                                                "text": "„Pichler ist einer der bedeutendsten und autonomsten Künstler der Gegenwart.“"
                                            },
                                            {
                                                "example_id": "e3012882-a364-4c41-a279-d09bcb635a8a",
                                                "sense_id": "567d7346-7eec-392d-b716-5bd014423728",
                                                "text": "„Dabei sieht Hackenberg das autonome Fahren vornehmlich als Hilfsangebot, um den Fahrer vor folgenreichen Fehlern zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4e6a8279-443b-3dce-a579-a2af248efe54",
                                        "entry_id": "7e5984b5-2d6d-3703-9aa6-215ddacd77a0",
                                        "glosses": [
                                            "sich auf die Autonomen beziehend, von den Autonomen ausgehend, zu den Autonomen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b6dda309-403c-3542-89a4-48fa8c509ad3",
                                        "entry_id": "7e5984b5-2d6d-3703-9aa6-215ddacd77a0",
                                        "glosses": [
                                            "für sich gesondert"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
