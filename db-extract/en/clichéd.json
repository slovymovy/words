                "senses": [
                    {
                        "sense_id": "354ddf69-89a2-3249-a698-e931d33e6b26",
                        "entry_id": "22671fbe-96f1-32c9-a56c-e95a8c049ecc",
                        "glosses": [
                            "Repeated so often that it has become stale or commonplace; hackneyed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fcf0ea-1354-4ae5-bddf-6dfbbe343e1d",
                                "sense_id": "354ddf69-89a2-3249-a698-e931d33e6b26",
                                "text": "While most of these small, family-owned eateries were mired in drab décor and had clichéd names like Golden Wok or China Gate, they made up for the kitsch with inexpensive prices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62175a27-5a0b-4656-8d13-94ab8bb4a15d",
                        "source_entry_id": "22671fbe-96f1-32c9-a56c-e95a8c049ecc",
                        "source_sense_id": "354ddf69-89a2-3249-a698-e931d33e6b26",
                        "source_sense_description": "repeated often",
                        "target_lang_word": "klischeehaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klischeehaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                        "entry_id": "adae2548-f96e-3157-be91-eb9e09e74755",
                                        "glosses": [
                                            "in der Art eines Klischees, einem Klischee entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c571857e-ab76-4a91-b6b0-b11d0c7770cb",
                                                "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                                "text": "„Leon Uris’ Roman Exodus nutzte 1958 den Shoah-Effekt, um Israels Kampf ein Jahrzehnt nach der Staatsgründung zu rechtfertigen. Die flache, klischeehafte Geschichte über ein marodes Flüchtlingsschiff, das die britischen Behörden in Haifa abwiesen, ist ein wesentlicher Bestandteil zionistischer Mythologie.“"
                                            },
                                            {
                                                "example_id": "1902026d-618f-44d9-a65c-b74b516ae27a",
                                                "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                                "text": "„So gesehen ist es ziemlich klischeehaft und primitiv, wenn man in der Hölle ankommt und heult und mit den Zähnen klappert und sich die Kleider zerreißt, bloß weil man plötzlich in ungeklärte Abwässer getunkt oder auf glühend heiße Rasierklingen geschmissen wird.“"
                                            },
                                            {
                                                "example_id": "a98265cd-b444-4166-8fa0-db73b9fef9f8",
                                                "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                                "text": "„Die klischeehafte Wahrnehmung Israels als ein ›von Feinden umgebenes kleines Land‹ entsprach der Wirklichkeit und spiegelte ein Gefühl des Eingeschlossenseins wider.“"
                                            },
                                            {
                                                "example_id": "8e83d05d-4585-4a2f-9dc2-733f0547c437",
                                                "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                                "text": "„Kurz vor der Kasse fiel ihm noch ein langer schwarzer Stockschirm ins Auge, der gut zu einem klischeehaften Briten passte.“"
                                            },
                                            {
                                                "example_id": "abbaba27-6ec3-410d-bf33-3d3040e05f89",
                                                "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                                                "text": "„Das war eine so typische Umgebung für eine Schule, dass es fast schon klischeehaft wirkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1b5a8dc-4024-4bd4-8c21-381fc098da9f",
