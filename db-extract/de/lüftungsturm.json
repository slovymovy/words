                "senses": [
                    {
                        "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                        "entry_id": "6a9c5b38-75c1-3d30-ab50-ad415fc6d9f4",
                        "glosses": [
                            "hoher, schlanker, freistehender Hohlkörper durch den Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30524941-c001-445a-8047-7a73c83d3d2b",
                                "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                                "text": "„Durch Kombination dieser Bauteile ist es möglich, einen auf Ihre Bedürfnisse zugeschnittenen Lüftungsturm zu konzipieren, der eine Verbindung zwischen moderner Architektur und technischer Nutzung schafft.“"
                            },
                            {
                                "example_id": "6e92acdc-c3c1-4947-8045-ff49f5adba61",
                                "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                                "text": "„Durch den Einbau von Schalldämmkulissen direkt in den Lüftungsturm sparen Sie wertvollen Platz in der Technik-Zentrale.“"
                            },
                            {
                                "example_id": "fba5d2eb-df6d-4049-a47d-1a34884492da",
                                "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                                "text": "„Das Standrohr ist das statisch tragende Element des Lüftungsturms.“"
                            },
                            {
                                "example_id": "493455df-f815-4412-a8c3-1a98da31527f",
                                "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                                "text": "„ In Bremen liegen beide oberen Eingänge in einer Flucht (auch der zweite Bremer Bunker hatte beide oberen Eingänge identisch zum Vulkan-Bunker in einer Flucht - identisch zur Lage des Lüftungsturmes Vulkan - angelegt), während dies in Rostock aufgrund der geschilderten Tatsache nicht der Fall ist.“"
                            },
                            {
                                "example_id": "c90bbf45-9ee9-4958-bb8b-b01f1b163ebf",
                                "sense_id": "95a2b1fb-32c8-3627-bdf9-311956439d70",
                                "text": "„Sie machen gegen den geplanten Lüftungsturm mobil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
