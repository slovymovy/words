                                        "entry_id": "a3161441-848c-3129-b20e-972065f5d4f5",
                                        "glosses": [
                                            "To cover the stem or leaves of plants with soil, as to encourage root growth or protect from cold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "741d42aa-da63-47ea-8e13-7f7f73d4283b",
                                                "sense_id": "a4feba71-8f45-3989-b298-341920e7fb60",
                                                "text": "Earth up a potato crop several times during the season to encourage more tubers to grow."
                                            }
