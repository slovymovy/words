                ],
                "senses": [
                    {
                        "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                        "entry_id": "4bce41ba-d64a-3447-a383-9b31f2e82b2c",
                        "glosses": [
                            "das Asien, Europa, Afrika, die arabische Inselwelt, Indien, Hinterindien und Nordamerika umfassende zoogeografische Gebiet"
                        ],
                        "tags": [
                            "Zoogeografie"
                        ],
                        "examples": [
                            {
                                "example_id": "eb39e0bc-ed2f-42cc-9b08-f673535d7c74",
                                "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                                "text": "Huxley nimmt an, dass die Landfauna sich ursprünglich auf zwei grosse Ländergebiete verteilt habe, und bezeichnet das eine der Nordhemisphäre angehörende als Arktogäa, das andere südhemisphärische als Notogäa."
                            },
                            {
                                "example_id": "e7a41e25-5baa-4c9f-8a71-e4e4c4cd09a0",
                                "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                                "text": "Die Arktogäa wird der Neogäa (Neotropis) und der Notogäa (Australis) gegenübergestellt."
                            },
                            {
                                "example_id": "64260bf7-f8fb-4269-af26-d4895a5f9397",
                                "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                                "text": "Diese Arktogäa enthält, wie sie die Hauptmasse des Festlandes darstellt, so die Hauptmasse der Landtiere, auch der Säugetiere."
                            },
                            {
                                "example_id": "4957e24d-548a-428d-8b47-b818a62278c2",
                                "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                                "text": "Alle Ordnungen sind hier vertreten bis auf die Beutel- und Kloakentiere; die Arktogäa muß daher als die Heimat und Bildungsstätte der höheren Säugetiere betrachtet werden."
                            },
                            {
                                "example_id": "b76953a4-ec49-4ef8-a243-a2c1e8d05486",
                                "sense_id": "92072f59-a8ab-3921-8781-38aaa22ffdeb",
                                "text": "Deshalb sind nur wenige Formen bis Südafrika vorgedrungen, und die heutige reiche Tierwelt des großen Kontinents drang erst, als die syrische Brücke gangbar wurde, mit ihren zahllosen Scharen von der Arktogäa herein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
