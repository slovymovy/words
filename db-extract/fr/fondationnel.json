                "senses": [
                    {
                        "sense_id": "b64ffef5-3f18-310f-a6c2-0be5da600973",
                        "entry_id": "686b4704-826d-3d63-9699-bec2111db491",
                        "glosses": [
                            "Qui pose les bases d’une œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "311a5882-c5b6-4002-9574-95bd002f1af9",
                                "sense_id": "b64ffef5-3f18-310f-a6c2-0be5da600973",
                                "text": "Certaines chercheures insistent plutôt sur la dimension de la différence entre les sexes et s'appliquent à caractériser et à valoriser cette différence, à en réclamer la légitimité et à la considérer comme fondationnelle d'un nouveau rapport entre les sexes."
                            },
                            {
                                "example_id": "e4a12979-4e11-4551-80f2-ec8addb0db47",
                                "sense_id": "b64ffef5-3f18-310f-a6c2-0be5da600973",
                                "text": "Est-ce seulement à cause de son travail mathématique — immense, atypique, génial, fondationnel — ou bien aussi à cause de sa personnalité — folle — ou encore à cause de sa vie — tragique — qu’Alexandre Grothendieck (1928-2014) est en passe de devenir une figure quasi-christique ?"
                            },
                            {
                                "example_id": "27d2c8d6-3ae8-4bd4-b83b-3dff389fa125",
                                "sense_id": "b64ffef5-3f18-310f-a6c2-0be5da600973",
                                "text": "Il utilise également les ensembles dans ses travaux fondationnels pour définir les nombres réels (voir la Droite, Bibliothèque Tangente 59) et les entiers naturels."
                            }
                        ]
                    }
