                                        "glosses": [
                                            "eine künstlerische oder bauliche Verzierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ae6e95-d131-4486-afca-225721d1e1c7",
                                                "sense_id": "498f92df-4fd7-311f-9f2a-0d437abb749c",
                                                "text": "Das Ornament ist eine der ursprünglichsten Kunstformen der Menschen."
                                            },
                                            {
                                                "example_id": "40b5a6d8-2a11-42ab-a660-1d7103937bf8",
                                                "sense_id": "498f92df-4fd7-311f-9f2a-0d437abb749c",
                                                "text": "An Gebäuden befinden sich Ornamente in allen Stilrichtungen."
                                            },
                                            {
                                                "example_id": "66da1b95-8a5d-4530-ac73-2f562ee30228",
                                                "sense_id": "498f92df-4fd7-311f-9f2a-0d437abb749c",
                                                "text": "Stuckdecken werden oft mit Ornamenten verziert."
                                            },
                                            {
                                                "example_id": "622f8a36-3475-4c77-84c2-2299a7361f26",
                                                "sense_id": "498f92df-4fd7-311f-9f2a-0d437abb749c",
                                                "text": "„Außer den feinen persischen Ornamenten über dem Portal war kein Schmuck weiter daran.“"
                                            },
                                            {
                                                "example_id": "be34655f-2f68-484b-9735-38a43df573c8",
                                                "sense_id": "498f92df-4fd7-311f-9f2a-0d437abb749c",
                                                "text": "„Die Wände der Stube zeigten die rohen und unbehauenen Baumstämme, deren einzige Ornamente breite Streifen von Lehm waren, welche die Zwischenräume ausfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
