                        ],
                        "examples": [
                            {
                                "example_id": "d8b855de-bbbf-481e-b447-47c143b2abbb",
                                "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                                "text": "I wanna bine him\n[…] Grip that skeng, aim up and blast"
                            },
                            {
                                "example_id": "4695d7fe-12a9-4983-9ef0-1ee525ea3a35",
                                "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                                "text": "Three waps up and a couple of shanks (Just in case)\nBut I got faith that these tools won't jam\nDinger that whip, plates doing mileage\nWho's that cycling? Jump out bine him\nPerfect timing, Snap said \"Five mins\" then he held bineage\nThey want me to rap, I want to close eyelids\nJuggling both, pretty exciting"
                            },
                            {
                                "example_id": "e913be7a-fd0b-4a4a-866f-7e68da2a756e",
                                "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                                "text": "My bro loco, wants nothing but violence\nGot a .9 of course it's firing\nCatch him in sight and light him light him\nBark some teeth, made the teeth dem bine him"
                            },
                            {
                                "example_id": "edb1c26f-7fb7-4130-b700-e82ae3fc422c",
                                "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                                "text": "Fuck that, I'm riding ’round\nI'm sliding 'round, spot opp, I'mma bine him now (Grr bow)\nSix in the spin I’mma slime him out\nSix in the spin tryna lie him down (Let's go)"
                            },
                            {
                                "example_id": "fd014fb8-dfaf-4d9b-beaa-835312b7f68c",
                                "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                                "text": "I see him, I bine him, do him up clean\nI shoot, you're driving, pussio, please\nChange your mindset, get off the streets"
                            }
                        ]
                    }
