    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bd78ce10-36df-3265-8f43-6fb628647cde",
                "word": "Wellerism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "22d4839c-ee35-42ad-a49b-04287e848bef",
                        "entry_id": "bd78ce10-36df-3265-8f43-6fb628647cde",
                        "tags": [
                            "plural"
                        ],
                        "form": "Wellerisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                        "entry_id": "bd78ce10-36df-3265-8f43-6fb628647cde",
                        "glosses": [
                            "A proverb, often a fatuous one, attributed to speaker in a situation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7457c0a-bedc-4a32-ac49-821840413c00",
                                "sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                                "text": "Examples of Romance Wellerisms are rather infrequent in literature and must be gathered from oral tradition."
                            },
                            {
                                "example_id": "37032974-755f-4a0a-bf8b-40941c98f254",
                                "sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                                "text": "An examination of recent literature for Wellerisms might prove productive."
                            },
                            {
                                "example_id": "d6321559-220e-4e95-bc27-439f88f4b2b7",
                                "sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                                "text": "The Wellerism, which has its name from Sam Weller's use of many of them in Pickwick Papers, is much older than Dickens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de769331-3fa6-4fd7-8e8a-ac0973a73894",
                        "source_entry_id": "bd78ce10-36df-3265-8f43-6fb628647cde",
                        "source_sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                        "source_sense_description": "proverb",
                        "target_lang_word": "Wellerismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wellerismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05f485bb-be06-35c5-b65c-ec215b08d6ef",
                                        "entry_id": "209f8467-a309-309f-ba63-c32703e1589f",
                                        "glosses": [
                                            "Phraseologismus, bei dem die Aussage einem Sprecher mit einer Wendung wie „sagte er/sie\\\" zugewiesen wird“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268edc17-5b25-437b-ada3-919a2df37deb",
                                                "sense_id": "05f485bb-be06-35c5-b65c-ec215b08d6ef",
                                                "text": "„Jünger als das Sprichwort und auch heute noch in immer neuen Beispielen auftretend, ist das sogenannte Sagwort, auch Wellerismus (so nach der Figur Samuel Weller in Charles Dickens' ‚Pickwick Papers‘).“"
                                            },
                                            {
                                                "example_id": "1d203be8-4978-48cb-a28d-0b8864914437",
                                                "sense_id": "05f485bb-be06-35c5-b65c-ec215b08d6ef",
                                                "text": "„Berühmt wurden die sogenannten ‚Sagwörter‘ oder Wellerismen - so benannt nach der Figur des Dieners Samuel Weller, der in Charles Dickens' Roman »The Posthumous Papers of the Pickwick Club« (1837) u. a. diese makabren Worte von sich gab: »‚Business first, pleasure afterwards‘ as King Richard III said when he stabbed the other king in the tower afore he smothered the babies.« (»‚Erst die Arbeit, dann das Vergnügen‘, wie König Richard III. sagte, als er den andern König im Turm niederstach, bevor er die Babies zerschmetterte.«)“"
                                            },
                                            {
                                                "example_id": "6efb516e-ad60-4465-8560-9dc0df98324b",
                                                "sense_id": "05f485bb-be06-35c5-b65c-ec215b08d6ef",
                                                "text": "„Dies geschieht auf dem Weg der Umprägung eines Sprichworts in Form des Beispielsprichworts oder Sagworts (Wellerismus).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29aee9ff-96cc-4da1-912d-492c08a034b5",
                        "source_entry_id": "bd78ce10-36df-3265-8f43-6fb628647cde",
                        "source_sense_id": "99fb5f0e-83a8-3a0e-83c6-fadabb542d1f",
                        "source_sense_description": "proverb",
                        "target_lang_word": "Sagwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sagwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                        "entry_id": "e89a4ef7-bac2-34cd-9822-979d8ae76b55",
                                        "glosses": [
                                            "Phraseologismus, bei dem die Aussage einem Sprecher mit einer Wendung wie „sagte er/sie\\\" zugewiesen wird“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cc1d2c-cdb8-4a47-9ab7-c1eb6b2eceaa",
                                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                                "text": "„Jünger als das Sprichwort und auch heute noch in immer neuen Beispielen auftretend, ist das sogenannte Sagwort, auch ‚Wellerismus‘ (so nach der Figur Samuel Weller in Charles Dickens' ‚Pickwick Papers‘).“"
                                            },
                                            {
                                                "example_id": "88f144df-7a21-44d9-94a4-7b1ae1945f55",
                                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                                "text": "Spalding zitiert ein bekanntes Sagwort: „Wo man singt, da laß dich ruhig nieder, sagte der Teufel, und setzte sich auf einen Bienenschwarm.“"
                                            },
                                            {
                                                "example_id": "08cebbbc-5cb3-49f6-954c-6aa5e224c89b",
                                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                                "text": "„Für Sagwörter ist der Zusammenprall zweier Konzepte konstitutiv.“"
                                            },
                                            {
                                                "example_id": "aab5c124-09ad-4cdb-bb25-f6ca3a3f38a1",
                                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                                "text": "„Dies geschieht auf dem Weg der Umprägung eines Sprichworts in Form des Beispielsprichworts oder Sagworts (Wellerismus).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
