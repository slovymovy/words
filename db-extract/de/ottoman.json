                                "example_id": "9dd8d175-e84e-44e1-9d8f-62538c15630c",
                                "sense_id": "cb1a2442-4bb8-3b5d-a379-8278046177ba",
                                "text": "Der Ottoman ist ein querrippiger Bezugsstoff für Möbel."
                            },
                            {
                                "example_id": "f1487717-baa6-4bd1-b3cf-6b00f95b7bbd",
                                "sense_id": "cb1a2442-4bb8-3b5d-a379-8278046177ba",
                                "text": "Wie bei einem japanischen Holzschnitt gibt der schwarze Ottoman den Rahmen für den Jacquard vor."
                            }
