                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>noté</w> plusieurs citations intéressantes dans les marges de son livre."
                        },
                        {
                            "text": "J'ai pris soin de <w>noter</w> les paragraphes essentiels au crayon à papier."
