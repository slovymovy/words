                "senses": [
                    {
                        "sense_id": "9c67435a-df4c-39be-8233-7c6739ba131d",
                        "entry_id": "0200d8a7-8049-309b-a4d6-5f6768b5db46",
                        "glosses": [
                            "Busy, lively; vibrant, dynamic; fashionable."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8a616a90-0a29-4029-8a70-4058ae6ebcb7",
                                "sense_id": "9c67435a-df4c-39be-8233-7c6739ba131d",
                                "text": "“[…]San Francisco is not exactly the most happening place, you know.”"
                            },
                            {
                                "example_id": "905bc0ad-1e79-4701-9e05-4393b83e83c8",
                                "sense_id": "9c67435a-df4c-39be-8233-7c6739ba131d",
                                "text": "When the show ends, the circular, sunken floor is one of the more happening dance clubs in town."
                            },
                            {
                                "example_id": "be2c0f66-8abb-4e01-b023-b735088d88a3",
                                "sense_id": "9c67435a-df4c-39be-8233-7c6739ba131d",
                                "text": "They're a little noisy if you open your balcony door but otherwise offer a glimpse of one of Disney World's more happening places."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a41d635-f514-3ce0-a922-cb875e5e9bf4",
                        "entry_id": "0200d8a7-8049-309b-a4d6-5f6768b5db46",
                        "glosses": [
                            "Trendy, up-to-the-minute."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9a9c527-b2c4-4cd0-8d86-ef6593e5bb22",
                                "sense_id": "0a41d635-f514-3ce0-a922-cb875e5e9bf4",
                                "text": "Every show has its hottest, most happening trends. If I were to isolate just one for hardware and one for software, this year's hot hardware would be the 386 machines, and the happening software would be desktop publishing."
                            },
                            {
                                "example_id": "f607b114-c080-4c45-8ad6-70f61550528e",
                                "sense_id": "0a41d635-f514-3ce0-a922-cb875e5e9bf4",
                                "text": "Going strong since 2006, this ephemeral nightclub (it's open only for 50 nights each year, in July and August) has become the hottest ticket in DJ land, a combination of the most happening names in music and its spectacular setting at the heart of the Palais des Festivals."
                            },
                            {
                                "example_id": "ef58a747-4c2d-40e6-a749-9976069dc569",
                                "sense_id": "0a41d635-f514-3ce0-a922-cb875e5e9bf4",
                                "text": "San Antonio is the newest, tiniest, and most “happening” wine appellation in Chile, with just four boutique wineries that focus on quality, not quantity, producing fine pinot noir, sauvignon blanc, and syrah."
                            }
                        ]
                    }
