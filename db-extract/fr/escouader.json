                "senses": [
                    {
                        "sense_id": "8a16f0e8-eb2a-34a9-a264-946e09488681",
                        "entry_id": "d2bff7c3-5bb4-3359-96df-bff108d5a764",
                        "glosses": [
                            "Accompagner par une escouade."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a9baed22-ceeb-4933-b349-bdc34ed4810f",
                                "sense_id": "8a16f0e8-eb2a-34a9-a264-946e09488681",
                                "text": "Ils nous disaient d'y aller et nous donnaient de petites tapes sur la tête mais ils n'allaient pas risquer de se faire escouader, pensez-vous."
                            },
                            {
                                "example_id": "533e3d05-13f5-41e2-bae2-0e24566681de",
                                "sense_id": "8a16f0e8-eb2a-34a9-a264-946e09488681",
                                "text": "Papa a été escouadé"
                            },
                            {
                                "example_id": "96fd5692-d14c-49ff-9c4b-1da9da999c55",
                                "sense_id": "8a16f0e8-eb2a-34a9-a264-946e09488681",
                                "text": "Mouai, enfin pour le moment vu le potentiel de la guilde, tu dois pas escouader avec grand monde"
                            },
                            {
                                "example_id": "14bd8e3d-1f3d-4fb2-bc49-e685ea4f756c",
                                "sense_id": "8a16f0e8-eb2a-34a9-a264-946e09488681",
                                "text": "Je vais bientôt finir par croire que je vais me faire escouader par la police de la pensée si je continue à douter du réchauffement."
                            }
                        ]
                    }
                ],
