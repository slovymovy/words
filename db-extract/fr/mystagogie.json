                    {
                        "sense_id": "7a116a94-83ea-39cc-b756-1266d2795ffd",
                        "entry_id": "8244128d-6871-370d-8e43-338ba7bb1e82",
                        "glosses": [
                            "Initiation aux mystères d’un culte religieux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fe2bbec3-b77f-3559-b156-d0ad7bd38dbd",
                        "entry_id": "8244128d-6871-370d-8e43-338ba7bb1e82",
                        "glosses": [
                            "Introduction de mystère, dans le rite, pour en conserver le caractère mystique et supra-rationnel (que la raison humaine ne peut saisir, du fait de ses limites)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a65d325a-1d91-42bc-aa0a-6dd40edc8dc2",
                                "sense_id": "fe2bbec3-b77f-3559-b156-d0ad7bd38dbd",
                                "text": "D’autre part, si nous empruntons au pape Innocent III ses idées sur la mystagogie des gemmes, nous découvrons que la chalcédoine, qui pâlit à la lumière et brasille dans la nuit, est le synonyme de l’humilité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "593a7126-48fb-49c9-94df-0087f23c0784",
                        "source_entry_id": "8244128d-6871-370d-8e43-338ba7bb1e82",
                        "target_lang_word": "Mystagogie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mystagogie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46ee53d8-7ee3-3a26-9c44-991c6f009c00",
                                        "entry_id": "78fd6fa5-a47b-3769-828e-48d5d47cf27e",
                                        "glosses": [
                                            "Hinführung zu einem Glaubensgeheimnis (Mysterium), so in alten, kultischen Religionen, in der modernen christlichen Theologie im Kontext der Taufkatechese"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625b0d9f-5534-4794-8fb1-f8fa20c4d195",
                                                "sense_id": "46ee53d8-7ee3-3a26-9c44-991c6f009c00",
                                                "text": "„Entsprechend dem Charakter der exemplarischen Prophetie haben die Unterscheidungslehren in Indien durchweg mehr rein praktisch-ethischen, oder, ihrer inneren Verwandtschaft mit der Mystagogie entsprechend, rituellen Charakter.“"
                                            },
                                            {
                                                "example_id": "76589c5a-ff7f-4d6d-ad21-c135d8affaf7",
                                                "sense_id": "46ee53d8-7ee3-3a26-9c44-991c6f009c00",
                                                "text": "„Oder aber es nimmt die Intellektuellenreligiosität die Form der Mystagogie mit einer Hierarchie von Weihen an – wie in der Gnosis und verwandten Kulten –, von deren Erreichung der unerleuchtete »Pistiker« ausgeschlossen bleibt.“"
                                            },
                                            {
                                                "example_id": "8d0e939e-10b3-40e4-a16f-db0b39df4d5f",
                                                "sense_id": "46ee53d8-7ee3-3a26-9c44-991c6f009c00",
                                                "text": "„Wer die Zukunft des Christentums in einer mystischen Spiritualität sieht, steht vor der Aufgabe, eine zeitgenössische Mystagogie zu entwickeln. […] Mystagogie ist die Kunst der Initiation, der Hineinführung in das Geheimnis der eigenen Existenz, insofern die meisten Menschen Begleitung auf dem Weg zur Erkenntnis ihrer eigenen Wahrheit benötigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
