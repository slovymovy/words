                    },
                    {
                        "sense_id": "60ab863b-8d66-33fa-b5b3-414777da1ca7",
                        "entry_id": "7afdc41b-73a0-3498-a41d-2a78b93ba43d",
                        "glosses": [
                            "To read or interpret in a new way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88419c64-6876-4e56-ae80-cb0aec392b08",
                                "sense_id": "60ab863b-8d66-33fa-b5b3-414777da1ca7",
                                "text": "My first book, Strange Natures: Futurity, Empathy, and the Queer Ecological Imagination (Seymour 2013), has further contributed to the development of queer ecology, rereading well-known contemporary queer novels and films as environmental polemics and theorizing why such reaadings have not been possible before."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6544954c-729a-47b8-b348-8260c82729fe",
                        "source_entry_id": "7afdc41b-73a0-3498-a41d-2a78b93ba43d",
                        "source_sense_description": "to read again",
                        "target_lang_word": "znovu přečíst",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cc7a42d4-c3f3-45c8-88ba-868024acf357",
                        "source_entry_id": "7afdc41b-73a0-3498-a41d-2a78b93ba43d",
                        "source_sense_description": "to read again",
                        "target_lang_word": "relire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b726cdf9-a912-37dc-abbf-860ad925fb78",
                                        "entry_id": "23c8fe1b-418f-33b0-9ebe-467b10e43341",
                                        "glosses": [
                                            "Lire de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e18063c-2241-4580-9236-5abb44a859e6",
                                                "sense_id": "b726cdf9-a912-37dc-abbf-860ad925fb78",
                                                "text": "\"Dis-moi ce que tu lis, je te dirai qui tu es\" : il est vrai, mais je te connaîtrai mieux si tu me dis ce que tu relis."
                                            },
                                            {
                                                "example_id": "406af32c-ca47-4876-bcde-5c64bb81927d",
                                                "sense_id": "b726cdf9-a912-37dc-abbf-860ad925fb78",
                                                "text": "26 octobre 41 – Grand-mère s’affaire et grand-père se tait. Il relit Balzac.\n– Oh ! tu sais ma fille, à mon âge, on ne peut plus que relire."
                                            },
                                            {
                                                "example_id": "f7956282-23d0-48ae-b3f5-f41e1c6fa44d",
                                                "sense_id": "b726cdf9-a912-37dc-abbf-860ad925fb78",
                                                "text": "Il faut lire, relire, re-relire, et presque apprendre par cœur le discours que prononça André Malraux, dans le vent glacé de cet hiver 1964, sous les yeux d’un De Gaulle plus marmoréen que de coutume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a038e5a6-72b5-36e5-a97f-1e88386f3396",
                                        "entry_id": "23c8fe1b-418f-33b0-9ebe-467b10e43341",
                                        "glosses": [
                                            "Lire à des fins de correction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b496ec2-cf48-4601-8663-4d5a2dfd6eba",
                                                "sense_id": "a038e5a6-72b5-36e5-a97f-1e88386f3396",
                                                "text": "Bon, pour Sanofi, cela représente près de huit cents notices à relire et à réécrire, si on compte les différentes formes galéniques…"
                                            },
                                            {
                                                "example_id": "4c42cdfb-87e2-4834-aba7-39cddd471abe",
                                                "sense_id": "a038e5a6-72b5-36e5-a97f-1e88386f3396",
                                                "text": "Il est prudent de se relire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
