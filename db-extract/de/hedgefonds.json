                        "entry_id": "de09ebec-ffd7-3bf7-87c2-89dd357ce8e1",
                        "glosses": [
                            "Konstrukt zu einer spekulativen Geldanlage, das einerseits Chancen auf extrem hohe Renditen bietet und andererseits mit großen Risiken behaftet ist"
                        ],
                        "tags": [
                            "Finanzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "885f120b-8f95-40d0-9e08-52a407006c05",
                                "sense_id": "1c577b74-f061-3d5c-b052-6fcf88e52d32",
                                "text": "„Hedgefonds setzten auf fallende Kurse – und haben sich nun die Finger verbrannt.“"
                            },
                            {
                                "example_id": "4e7974f6-eb1a-44d1-a377-e148814b9295",
                                "sense_id": "1c577b74-f061-3d5c-b052-6fcf88e52d32",
                                "text": "„Den Bonus von Bankmanagern zu kassieren oder Hedgefonds das Zocken mit riskanten Papieren zu verbieten wird den Abschwung jetzt nicht mehr aufhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
