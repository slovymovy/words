                        "cs": "Flákat se, polevovat v práci, vyhýbat se povinnostem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельничать",
                                "target_lang_sense_clarification": "проводить время в праздности вместо работы"
                            },
                            {
                                "target_lang_word": "сачковать",
                                "target_lang_sense_clarification": "разговорный термин для уклонения от работы"
                            },
                            {
                                "target_lang_word": "лениться",
                                "target_lang_sense_clarification": "испытывать нежелание работать"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "flákat se",
                                "target_lang_sense_clarification": "nepracovat s plným nasazením"
                            },
                            {
                                "target_lang_word": "polevovat",
                                "target_lang_sense_clarification": "snižovat pracovní úsilí"
                            },
                            {
                                "target_lang_word": "ulejvat se",
                                "target_lang_sense_clarification": "vyhýbat se práci"
                            }
                        ]
