                "senses": [
                    {
                        "sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                        "entry_id": "9e6b227f-cd3b-39a6-b6db-a07cb68646dd",
                        "glosses": [
                            "In a fitful manner; irregularly or unsteadily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77729e26-a798-441d-8724-696026fb692b",
                                "sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                                "text": "He slept fitfully, plagued by bad dreams and a persistent cough."
                            },
                            {
                                "example_id": "5b738cfb-6782-4ace-acc8-72698b0388d9",
                                "sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                                "text": "The cabin lamp—taking long swings this way and that— was burning fitfully, and casting fitful shadows upon the old man’s bolted door […]"
                            },
                            {
                                "example_id": "12cd30b7-4835-4457-83f8-397d78840df8",
                                "sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                                "text": "The train for Marmion left Boston at four o'clock in the afternoon, and rambled fitfully toward the southern cape, while the shadows grew long in the stony pastures […]"
                            },
                            {
                                "example_id": "3e9254d7-85de-4587-8d4c-3dc72cfc7bf1",
                                "sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                                "text": "We shivered miserably throughout the night. Now and again fitfully slept, but the pain of the cold always aroused me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7cb584f-d687-4b79-84d2-9f2a0d6d4953",
                        "source_entry_id": "9e6b227f-cd3b-39a6-b6db-a07cb68646dd",
                        "source_sense_id": "6b9e98f1-8b2d-3fd5-8983-baea8b515d25",
                        "source_sense_description": "in a fitful manner",
                        "target_lang_word": "су́дорожно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́дорожно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                                        "entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                                        "glosses": [
                                            "наречие к судорожный; таким образом, как при судороге"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043214ff-8b4f-485b-bb28-6a57458aa0eb",
                                                "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                                                "text": "Миша схватил её локти и судорожно сжал их между своими ладонями."
                                            },
                                            {
                                                "example_id": "a57ee93e-29f6-407f-a5f9-c95f12d8d54e",
                                                "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                                                "text": "Глаза незнакомца широко раскрылись, он тяжело дышал, нижняя челюсть судорожно тряслась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73703cb0-2d0c-3376-b8ed-afc556201db3",
                                        "entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                                        "glosses": [
                                            "перен. суетливо и тревожно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d78b39-d807-4ea4-9103-db0d5620a9d4",
                                                "sense_id": "73703cb0-2d0c-3376-b8ed-afc556201db3",
                                                "text": "Ему не придется посреди улицы судорожно искать в карманах таблетку нитроглицерина, чтобы унять боль в груди."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
