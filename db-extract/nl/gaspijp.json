                        "entry_id": "af1f1e2f-71f8-34db-9df4-44a3da1a1528",
                        "glosses": [
                            "een buis waardoor men een (aard)gas zoner lekkage kan vervoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020e28f2-734e-4aa4-afee-bae67333742f",
                                "sense_id": "b18be326-c81c-3d21-88f3-7ca082995ef1",
                                "text": "Fluxys had manuele peilingen moeten uitvoeren om de ligging van de gaspijp te controleren"
                            },
                            {
                                "example_id": "ed8fd08d-06a6-4191-b5f8-d0192476ff8c",
                                "sense_id": "b18be326-c81c-3d21-88f3-7ca082995ef1",
                                "text": "De Nabucco-gaspijp, die tegen 2012-2013 gas vanuit het Kaspische Zeegebied (en Iran) via Turkije en de Balkan naar Oostenrijk zou moeten brengen, is een van de belangrijkste alternatieven om de Russische machtspositie te breken."
                            }
                        ]
                    }
