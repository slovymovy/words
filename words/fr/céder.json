{
    "word_family": [
        "cession",
        "cessible",
        "incessible",
        "cessionnaire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51666c39-7a80-337d-9cc6-22e4f388e19f",
                    "sense_definition": "Laisser ou abandonner l'usage d'une place, d'un espace ou d'un avantage à quelqu'un d'autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'autobus bondé, l'adolescent poli <w>cède</w> immédiatement sa place à une dame âgée."
                        },
                        {
                            "text": "En arrivant au carrefour, l'automobiliste doit ralentir pour <w>céder</w> le passage aux piétons."
                        }
                    ],
                    "common_phrases": [
                        "céder sa place",
                        "céder le passage"
                    ]
                },
                {
                    "sense_id": "5418b12f-72f5-3052-838b-ab743f4a8678",
                    "sense_definition": "Cesser de résister, se soumettre ou succomber face à une pression, une exigence ou un sentiment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de négociation, le représentant a refusé de <w>céder</w> aux exigences imposées."
                        },
                        {
                            "text": "Face aux difficultés économiques imprévues, le chef de projet ne doit pas <w>céder</w> à la panique."
                        }
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "céder à la panique",
                        "céder à la tentation",
                        "céder du terrain"
                    ]
                },
                {
                    "sense_id": "50914c3b-2350-39a1-833b-198344278a46",
                    "sense_definition": "Transférer la propriété légale ou les droits d'un bien à autrui, à titre gratuit ou onéreux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir à la retraite, le commerçant envisage de <w>céder</w> son fonds de commerce."
                        },
                        {
                            "text": "Ce collectionneur a finalement accepté de <w>céder</w> plusieurs tableaux rares à un musée national."
                        }
                    ],
                    "synonyms": [
                        "donner",
                        "vendre"
                    ],
                    "common_phrases": [
                        "céder un bien",
                        "céder ses parts",
                        "céder son entreprise"
                    ]
                },
                {
                    "sense_id": "ce388f47-5e8c-33b0-800a-96f08d3e0cae",
                    "sense_definition": "Rompre, casser ou fléchir sous l'action d'une contrainte mécanique ou d'une force trop vive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille branche d'arbre risque de <w>céder</w> sous le poids important de la neige."
                        },
                        {
                            "text": "Sous la violence du choc, les gonds rouillés ont fini par <w>céder</w> d'un coup sec."
                        }
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "céder sous le poids"
                    ]
                }
            ]
        }
    ]
}