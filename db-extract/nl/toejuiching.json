                                                "example_id": "b5dbbb32-93cb-4b3a-a49b-71f55994afdb",
                                                "sense_id": "826bc0a7-15ba-3387-957d-8648e54292cb",
                                                "text": "I'm going to wear my new cheer shoes at cheer today."
