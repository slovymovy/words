                ],
                "senses": [
                    {
                        "sense_id": "fcfd1129-5cfc-34a0-9c9f-d3e2cb37e091",
                        "entry_id": "3a695ebd-c8f2-3fd7-8944-840e061333e5",
                        "glosses": [
                            "aus Früchten hergestellter Schnaps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2369b3a1-a163-4a83-bb29-23a24e7c1f19",
                                "sense_id": "fcfd1129-5cfc-34a0-9c9f-d3e2cb37e091",
                                "text": "Der Mindestalkoholgehalt eines Obstlers beträgt 37,5 Volumenprozent."
                            },
                            {
                                "example_id": "9e0fd97c-67fc-4b98-93df-cfa97c7eaf60",
                                "sense_id": "fcfd1129-5cfc-34a0-9c9f-d3e2cb37e091",
                                "text": "„Betroffen und nervös von dem, was er gehört hatte, sprach auch Thomas jetzt dem Obstler kräftig zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e906cfde-a4f4-3790-95c6-5162bf0ca463",
                        "entry_id": "3a695ebd-c8f2-3fd7-8944-840e061333e5",
                        "glosses": [
                            "Obsthändler"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "1215baf1-e057-46a6-9548-91ff0dd465a8",
                                "sense_id": "e906cfde-a4f4-3790-95c6-5162bf0ca463",
                                "text": "Die Obstler, besonders die Großhändler jammern auf einer Seiten, auf der andern lachen's schön für sich hin."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcb5831b-806c-4d45-b577-bac3d0145b4e",
                        "source_entry_id": "3a695ebd-c8f2-3fd7-8944-840e061333e5",
                        "source_sense_id": "fcfd1129-5cfc-34a0-9c9f-d3e2cb37e091",
