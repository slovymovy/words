                                "target_senses": [
                                    {
                                        "sense_id": "bd0595d4-dda4-3cc6-b3e6-790bb5799bdb",
                                        "entry_id": "d84a95d3-9fde-36dd-98d8-2fef9f1bcd45",
                                        "glosses": [
                                            "The keeper, manager of a library."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae6e74f-05a0-4e3b-b993-9642c4ed0ee1",
                                                "sense_id": "bd0595d4-dda4-3cc6-b3e6-790bb5799bdb",
                                                "text": "The amenities of the institute include a well-arranged open-access library of 18,000 volumes, and a small but valuable reference library of railway literature; the present writer is Librarian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c74184-c859-3993-a26e-5dd158764b6e",
                                        "entry_id": "d84a95d3-9fde-36dd-98d8-2fef9f1bcd45",
                                        "glosses": [
                                            "One who cares for the publications, files etc. in a library, whether staff or volunteer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "312d3754-3bc1-3080-9718-445c6d322765",
                                        "entry_id": "d84a95d3-9fde-36dd-98d8-2fef9f1bcd45",
                                        "glosses": [
                                            "A person who processes and organizes information."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c91e991-407f-40ba-a392-b42c2b74a8f3",
                        "source_entry_id": "3f37da61-2e9d-3eff-aa9c-614d49612ac2",
                        "source_sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                        "source_sense_description": "Mitarbeiter einer Bibliothek",
                        "target_lang_word": "bibliothécaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliothécaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb373968-c879-302a-9cb1-1d7061c35d10",
                                        "entry_id": "3c446f0f-56fa-3cd2-87c0-1d168ebc6104",
                                        "glosses": [
                                            "Personne travaillant dans une bibliothèque."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cfa6e2e-c6f9-4f6a-82e3-a9650a94471a",
                                                "sense_id": "eb373968-c879-302a-9cb1-1d7061c35d10",
                                                "text": "Un bibliothécaire adjoint."
                                            },
                                            {
                                                "example_id": "d57245de-3032-4eac-a9f1-3d13caa686f4",
                                                "sense_id": "eb373968-c879-302a-9cb1-1d7061c35d10",
                                                "text": "Le bibliothécaire de l’institut est très serviable."
                                            },
                                            {
                                                "example_id": "740566b9-6358-4ce8-a26f-31818b328a1c",
                                                "sense_id": "eb373968-c879-302a-9cb1-1d7061c35d10",
                                                "text": "Le chignon de la bibliothécaire remplace la voussure du dos du bibliothécaire."
                                            },
                                            {
                                                "example_id": "3077086a-1a8e-4603-bb00-bc1828477165",
                                                "sense_id": "eb373968-c879-302a-9cb1-1d7061c35d10",
                                                "text": "Chères bibliothécaires, gardiennes du temple, il est heureux que tous les titres du monde aient trouvé leur alvéole dans la parfaite organisation de vos mémoires (comment m’y retrouverais-je, sans vous, moi dont la mémoire tient du terrain vague ?), il est prodigieux que vous soyez au fait de toutes les thématiques ordonnées dans les rayonnages qui vous cernent... mais qu’il serait bon, aussi, de vous entendre raconter vos romans préférés aux visiteurs perdus dans la forêt des lectures possibles... comme il serait beau que vous leur fassiez l’hommage de vos meilleurs souvenirs de lecture ! Conteuses, soyez – magiciennes – et les bouquins sauteront directement de leurs rayons dans les mains du lecteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
