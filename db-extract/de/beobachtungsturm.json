                                "target_senses": [
                                    {
                                        "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                        "entry_id": "e1e95255-47cb-3e99-8e6e-d6973c044392",
                                        "glosses": [
                                            "Tour de surveillance, poste d’observation, surtout dans un camp de prisonniers ou une prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a8f0aa-00db-4afd-b28a-7fa243d8b8bd",
                                                "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                                "text": "J’avais essayé, grâce à l’amitié d’un sergent téléphoniste du mirador, de lui faire parvenir à mon tour un message rassurant…"
                                            },
                                            {
                                                "example_id": "b14c289c-d3aa-427e-8c9b-e1709e5eafc2",
                                                "sense_id": "2bff2639-8cff-3a48-9987-6047de308404",
                                                "text": "Le long de cours d’eau qui creuse la région sauvage et montagneuse de la Transcarpatie, les gardes-frontières ne lésinent pas sur les moyens pour arrêter les fuyards : drones de surveillance thermiques, miradors, sentinelles postées en permanence aux affluents..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "020c4176-2278-4cf6-881e-0f53a1584c0d",
                        "source_entry_id": "a3b4fbc6-15d3-3b2a-a7e3-15472359d757",
                        "source_sense_id": "d811ca06-6c44-3d96-b940-7a7cb90ba891",
                        "source_sense_description": "Turm, der der Kontrolle und Bewachung eines Geländes dient",
                        "target_lang_word": "tour de guet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tour de guet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79121b01-a968-30a5-9ada-c78386de670c",
                                        "entry_id": "dc52ffbe-4669-3880-8013-670757132dad",
                                        "glosses": [
                                            "Construction haute permettant de surveiller, de faire le guet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2804d725-0299-4f4e-9803-b002108f31d4",
                                                "sense_id": "79121b01-a968-30a5-9ada-c78386de670c",
                                                "text": "Ces horizons balayés, où s’ébattaient d’immenses troupeaux de nuages, étaient rendus plus semblables encore à ceux du large par l’apparition, de place en place, de hautes tours de guet normandes, semées irrégulièrement sur les steppes rases, et qui surveillaient la plaine nue comme des phares."
                                            },
                                            {
                                                "example_id": "6400a6be-9dcb-4e3f-b2cc-799dcb4696c6",
                                                "sense_id": "79121b01-a968-30a5-9ada-c78386de670c",
                                                "text": "Ce cocon de verdure qui entourait l’airial de Marie a aussi disparu sur la route de Joué, où la tour de guet culmine, esseulée, au milieu d’un paysage lunaire."
                                            },
                                            {
                                                "example_id": "1a56e2ed-fb99-495f-94ec-b467ca20c4b7",
                                                "sense_id": "79121b01-a968-30a5-9ada-c78386de670c",
                                                "text": "Elle pâlit pourtant en découvrant l’immense complexe - baraquements précaires et tours de guet - qui s’étendait le long de la rive glacée du Tom, où enfin ils s’arrêtèrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
