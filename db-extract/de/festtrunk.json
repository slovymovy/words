                "senses": [
                    {
                        "sense_id": "ee31478e-cd2e-3a10-9b3a-753f2b5efe03",
                        "entry_id": "4c175ff8-d5a4-347f-a806-5208d0dfe882",
                        "glosses": [
                            "Apéro, verrée de fête, pour fêter une occasion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe6ee16b-b84c-46b6-95dc-8da976ff7b49",
                                "sense_id": "ee31478e-cd2e-3a10-9b3a-753f2b5efe03",
                                "text": "Hohe Festversammlung! Liebe Kommilitonen! Seit langen Jahren zum erstenmal wieder sieht heute Tübingen viele Gäste und viel frühere Tübinger Studenten aus allen Landen, seine Dozentenschaft und Studentenschaft anlässlich des 450jährigen Jubiläums zum Festtrunk vereinigt.",
                                "translation": "Honorable assemblée ! Chers camarades d’études ! Pour la première fois depuis de nombreuses années, Tübingen voit aujourd’hui de nombreux invités et d’anciens étudiants de Tübingen de tous les pays, son corps professoral et son corps étudiant réunis pour une verrée à l’occasion du jubilé des 450 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "7acbf98c-2590-3ed4-b24c-75de522ca18f",
                        "entry_id": "4c175ff8-d5a4-347f-a806-5208d0dfe882",
                        "glosses": [
                            "Boisson bue dans le cadre de (1)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4743bc-760d-4ef3-baab-4154b89db1ba",
                                "sense_id": "7acbf98c-2590-3ed4-b24c-75de522ca18f",
                                "text": "Als Festtrunk hat der Schleißheimer Remonte Bräu sich endgültig durchgesetzt.",
                                "translation": "En tant que boisson de la fête, la bière Remonte de Schleißheim s’est définitivement imposée."
                            }
                        ]
                    }
