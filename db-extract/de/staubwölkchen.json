                ],
                "senses": [
                    {
                        "sense_id": "06edacb9-4218-3fdc-87e9-040ba807c34d",
                        "entry_id": "2d3a835f-a7b7-3232-ab92-fedb8a98ce34",
                        "glosses": [
                            "kleine Menge aus Staub in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611a5dce-c49e-42bb-a300-253c8ac5d3f7",
                                "sense_id": "06edacb9-4218-3fdc-87e9-040ba807c34d",
                                "text": "„Bei jedem Schritt wirbelte ein Staubwölkchen vom Boden auf und schien reglos in der Luft hängen zu bleiben.“"
                            },
                            {
                                "example_id": "3f4e1e47-fe51-4dc9-ba6d-1ff88740627a",
                                "sense_id": "06edacb9-4218-3fdc-87e9-040ba807c34d",
                                "text": "„Schüsse erklangen, und kleine Staubwölkchen zeigten an, wo die Querschläger vom Stein abprallten.“"
                            },
                            {
                                "example_id": "ad732c8f-a22c-43d7-9887-759e7e2b1cd7",
                                "sense_id": "06edacb9-4218-3fdc-87e9-040ba807c34d",
                                "text": "„Eine Kurve vor einer sechs Meter kurzen Brücke über einen schmalen Abwasserkanal zwang sie zum Abbremsen, und Courts Hoffnung, ihr Konvoi würde einfach durchgelassen, verflog, als Staubwölkchen auf der Straße direkt vor dem MG-Wagen der Wüstenfalken emporpufften.“"
                            },
                            {
                                "example_id": "6f9de71c-953a-48ad-a3b9-65d71d23f1a5",
                                "sense_id": "06edacb9-4218-3fdc-87e9-040ba807c34d",
                                "text": "„Klein und unwirklich lag Butcher’s Crossing vor ihm, als er auf der Straße langsam zurück in die Stadt ging; seine Füße scharrten über den Sand; der Blick folgte den Staubwölkchen, über die seine Stiefel hinwegschritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
