                "senses": [
                    {
                        "sense_id": "0e10287c-d306-3808-baaf-59922faadc7b",
                        "entry_id": "75adf72e-8086-3a99-a031-bfc13190e35f",
                        "glosses": [
                            "der Lebensraum des freien Wassers in Binnenseen und im Meer von der durchlichteten Stufe bis zum Grund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd03dc5-609f-4abd-822b-4e17ed735022",
                                "sense_id": "0e10287c-d306-3808-baaf-59922faadc7b",
                                "text": "„Im Pelagial […] ist die Verbreitung der Organismen viel mehr von ökologischen als von historischen Faktoren abhängig, so daß sich in der Zusammensetzung vor allem ein circumterrestrisches Warmwasserpelagial von einem nördlichen und südlichen Kaltwasserpelagial unterscheiden läßt.“"
                            },
                            {
                                "example_id": "51671c20-5a43-4186-be89-8c0a8bbd879b",
                                "sense_id": "0e10287c-d306-3808-baaf-59922faadc7b",
                                "text": "Die im Pelagial lebenden Organismen gehören dem passiv treibenden Plankton oder dem aktiv schwimmenden Nekton an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5b15c5e4-d610-3453-885c-0e4e4c3ca7fe",
                        "entry_id": "75adf72e-8086-3a99-a031-bfc13190e35f",
                        "glosses": [
                            "die Gesamtheit der im freien Teil von Gewässern lebenden Organismen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9189ccf-5c2a-4cc4-948a-a7bb8ef9a33c",
                                "sense_id": "5b15c5e4-d610-3453-885c-0e4e4c3ca7fe",
                                "text": "Nur die Globigerinen gehören dem Pelagial an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
