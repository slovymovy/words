                            {
                                "example_id": "f4429c9e-7c2f-4f5a-bd6b-4a4b29065c35",
                                "sense_id": "a371197d-b3a3-316c-994c-b21970a220cd",
                                "text": "Nadat hij naast Alice Cooper had geacteerd in de video van de heavymetalband Twisted Sister, speelde hij in de soaps Loving en Another World."
                            },
                            {
                                "example_id": "78c729dc-3d8e-41c9-9ba5-891faef7557c",
                                "sense_id": "a371197d-b3a3-316c-994c-b21970a220cd",
                                "text": "Twee jaar later werd Vinnie Paul de drummer van de heavymetalband Hellyeah, en dat bleef hij tot zijn dood. Waaraan Vinnie Paul is overleden is niet bekendgemaakt."
                            },
                            {
                                "example_id": "866cbbf0-794d-4e96-b2cb-985a703844de",
                                "sense_id": "a371197d-b3a3-316c-994c-b21970a220cd",
                                "text": "\"Hij is zanger, piloot, presentator, schrijver én acteur!\" Natasha Battel komt woorden tekort om Bruce Dickinson, leadzanger van heavymetalband Iron Maiden, te omschrijven. Achter Natasha staat 'Ed Force One', het vliegtuig van de band dat zojuist aan de grond is gezet door Dickinson."
                            }
                        ]
