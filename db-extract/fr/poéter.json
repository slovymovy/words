                "senses": [
                    {
                        "sense_id": "3f998ad2-e6ce-3d8c-8734-b69554b4b675",
                        "entry_id": "f7efc502-ea95-3be6-87e6-d38da8c14d52",
                        "glosses": [
                            "Faire de la poésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d0f14d1-4393-4180-96fa-2fe0fe6edaea",
                                "sense_id": "3f998ad2-e6ce-3d8c-8734-b69554b4b675",
                                "text": "« Il a résolu de ne plus poéter et de renoncer à Sa belle madonna, la poésie, pour ne pas tomber dans l’inconvénient des Vieux cygnes ses confrères […] », annonce Louise."
                            },
                            {
                                "example_id": "9f4263b5-7643-4c91-a007-2a40168677ef",
                                "sense_id": "3f998ad2-e6ce-3d8c-8734-b69554b4b675",
                                "text": "« Poète, il ne faut pas poéter au-dessus de ton luth », sermonnait Pierre Dac."
                            },
                            {
                                "example_id": "c5fd2013-44db-4af0-8398-48cbdc3fdc9c",
                                "sense_id": "3f998ad2-e6ce-3d8c-8734-b69554b4b675",
                                "text": "Lequel Raymond retournait la langue comme une veste, la forgeait, la forait ; à force de contrepéter, d’onomatopéter, il poétait."
                            },
                            {
                                "example_id": "857125e3-f432-4d1f-88ac-3b1b57b5e0dd",
                                "sense_id": "3f998ad2-e6ce-3d8c-8734-b69554b4b675",
                                "text": "Poéter sur l’eau et le vent qui caressent les visages ou sur les arbres et herbages auprès desquels on pédale heureux ?"
                            }
                        ]
                    }
                ],
