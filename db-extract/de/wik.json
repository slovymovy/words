                ],
                "senses": [
                    {
                        "sense_id": "fecfb11d-fd27-3f4c-b034-2eca7e442f3e",
                        "entry_id": "d5c219ab-92b7-3859-bd39-5000bab825c9",
                        "glosses": [
                            "im frühen Mittelalter (zwischen dem 7. und 9. Jahrhundert) befestigter Ort (am Wasser) für Kaufleute mit nur teils fester Anwohnerschaft, an dem Handel/Fernhandel betrieben und Güter umgeschlagen wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58e851e-a514-40b6-b70e-7c8b6bd099ec",
                                "sense_id": "fecfb11d-fd27-3f4c-b034-2eca7e442f3e",
                                "text": "„Soweit die Wiken innerhalb des fränkischen Reiches lagen, waren sie einem königlichen Beamten, dem »Wikgrafen«, unterstellt, der den Handelsverkehr überwachte, die Gerichtsbarkeit ausübte, die Verteidigung leitete und die Abgaben für den König einzog.“"
                            },
                            {
                                "example_id": "104b20ae-554a-4bbc-9841-afef42f767bb",
                                "sense_id": "fecfb11d-fd27-3f4c-b034-2eca7e442f3e",
                                "text": "„Südlich und westlich der Hamburg entstand in dieser Frühzeit ein Wik aus Hütten, die mit Flechtwänden oder aus Holzbohlen gebaut und mit Strohdächern versehen waren.“"
                            },
                            {
                                "example_id": "109a92e8-33db-4c95-806b-502d8288b0b1",
                                "sense_id": "fecfb11d-fd27-3f4c-b034-2eca7e442f3e",
                                "text": "„Es sei, erklärt Meibeyer, jedenfalls offensichtlich so, dass für die Menschen im Mittelalter ein Wik ein Handelsort gewesen sei, zumal das Wort Wik auch in die sorbische und andere slawische Sprachen eingedrungen sei, […].“"
                            },
                            {
                                "example_id": "2e922428-105f-4d70-a682-d3933d425b87",
                                "sense_id": "fecfb11d-fd27-3f4c-b034-2eca7e442f3e",
                                "text": "„Emden gibt daher ein klassisches Beispiel für die Entwicklung eines Wiks zur Stadtsiedlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
