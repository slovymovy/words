                                "target_senses": [
                                    {
                                        "sense_id": "fb39b1be-088a-3f3a-85ae-8528b7283565",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The act of identifying (i.e., which one, which thing)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffde4fc-66bf-4a07-a1d3-12a6fdf53df4",
                                                "sense_id": "fb39b1be-088a-3f3a-85ae-8528b7283565",
                                                "text": "In many network protocols, identification is complemented by authentication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af23113c-6ede-3b54-90e0-1a029bd07d2d",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The combination of identifying (which one, which thing) and validating the identity (proving or confirming it); identifying and authenticating viewed as a unitary concept in cognition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5470e1-f9be-4d06-95dd-ecf7dc4015f5",
                                                "sense_id": "af23113c-6ede-3b54-90e0-1a029bd07d2d",
                                                "text": "Much education and experience is required for proper identification of bird species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89ee101-7829-3129-bc81-cb011128dd0e",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "The state of being identified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75d8d9c-4846-43f6-b777-c761d57588f4",
                                                "sense_id": "a89ee101-7829-3129-bc81-cb011128dd0e",
                                                "text": "The problem's identification was the first step toward dealing with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a53aa0-e896-317b-8850-7481446bd2fb",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A particular instance of identifying something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b515e647-c760-4191-b5d0-46bd091f3c62",
                                                "sense_id": "a8a53aa0-e896-317b-8850-7481446bd2fb",
                                                "text": "information necessary to make a good identification"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c22eaa-3c40-3b0a-a02f-fa38f1531d57",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A document or documents serving as evidence of a person's identity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a3f547-b71b-4e63-9dda-e721a6cc9b22",
                                                "sense_id": "06c22eaa-3c40-3b0a-a02f-fa38f1531d57",
                                                "text": "The authorities asked for his identification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                        "entry_id": "940940f4-b603-30c9-b457-505d04796cc2",
                                        "glosses": [
                                            "A feeling of support, sympathy, understanding, or belonging towards somebody or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e1ca7c-6d3e-4e7c-970f-5ac2b3535f14",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "identification with the tribe"
                                            },
                                            {
                                                "example_id": "44a6e274-94e9-4e56-a006-5aa057538b4b",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "In several actions where FagRaggers were personally involved […] Brill provided sensitive information about our activities to police. Such intervention revealed Brill's identification with authority and his inadequate understanding of how to change the condition of those without power."
                                            },
                                            {
                                                "example_id": "c728c3ac-ec12-47d6-8776-6d6bd6113f00",
                                                "sense_id": "b107588b-db2e-36a4-b9d7-c24482f39d53",
                                                "text": "In the English South and Midlands, identification with Britain ran well ahead of identification with the region; in Yorkshire and the northern England, identification with the region ran about equal to identification with Britain; and in Scotland and Wales (but more especially in Scotland) identification with the region ('Scotland' or 'Wales') ran well ahead of identification with Britain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
