                    {
                        "sense_id": "26b6758c-1083-3d06-82c8-3e8dfdbf5b23",
                        "entry_id": "228d5bf3-1ff0-3f7d-b6a9-186ad94fc740",
                        "glosses": [
                            "Reporter, der über Ereignisse im Zusammenhang mit Polizeiarbeit berichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24b386c-0da5-41f1-9dc9-f4449025d74b",
                                "sense_id": "26b6758c-1083-3d06-82c8-3e8dfdbf5b23",
                                "text": "„Aber soweit ich sie verstand, waren die Ausführungen des Polizeireporters über die Abteilung für öffentliche Sicherheit der Tokioter Polizei ziemlich interessant.“"
                            },
                            {
                                "example_id": "e5530a74-989e-4d0c-af46-abdbebd5227c",
                                "sense_id": "26b6758c-1083-3d06-82c8-3e8dfdbf5b23",
                                "text": "„Sie las gern französisch, und sie hatte Simenon schon gelesen, als er noch Polizeireporter war."
                            }
                        ],
