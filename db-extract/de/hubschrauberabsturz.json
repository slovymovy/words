                "senses": [
                    {
                        "sense_id": "0e48f0e3-c7ea-30eb-b7c4-b54f2eae7df9",
                        "entry_id": "1e80cf5b-4ec0-3bac-88b5-1b88241ca6e4",
                        "glosses": [
                            "Unfall, bei dem ein Hubschrauber zu Boden oder ins Wasser stürzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ed7e265-484e-414f-9668-158c0f75627b",
                                "sense_id": "0e48f0e3-c7ea-30eb-b7c4-b54f2eae7df9",
                                "text": "„Nach dem Hubschrauberabsturz mit einem Toten bei einer Bundesheerübung am Dienstag in der Wattener Lizum in Tirol befinden sich die beiden schwerverletzten Besatzungsmitglieder nicht in Lebensgefahr.“"
                            },
                            {
                                "example_id": "c341a7a2-fe36-4542-9161-a265ca5c8d87",
                                "sense_id": "0e48f0e3-c7ea-30eb-b7c4-b54f2eae7df9",
                                "text": "„Acht Menschen sind bei dem Hubschrauberabsturz in Glasgow gestorben, darunter ist die Besatzung des Helikopters.“"
                            },
                            {
                                "example_id": "865abd9c-abe4-47aa-88d2-eaf8664765eb",
                                "sense_id": "0e48f0e3-c7ea-30eb-b7c4-b54f2eae7df9",
                                "text": "„Die Basketballwelt trauert um einen ihrer besten Spieler: Der frühere NBA-Superstar Kobe Bryant kommt bei einem Hubschrauberabsturz ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
