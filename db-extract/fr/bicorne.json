                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicornio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9603bcfb-05d2-3311-967e-0ae8ea72d4c2",
                                        "entry_id": "995aa1c4-69c1-3c57-ba88-d0da564471ff",
                                        "glosses": [
                                            "Sombrero de dos puntas y dos alas recogidas hacia arriba, que era fácilmente plegable. Fué usado por Napoléon Bonaparte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c8e6e9d-3b38-4669-93bb-d9a21f6b29c5",
                                                "sense_id": "9603bcfb-05d2-3311-967e-0ae8ea72d4c2",
                                                "text": "“Ahora soy un simple ciudadano. En el curso de mi gobierno, he ejercido con una grande amplitud de autoridad, ” Se volvió a la Junta, y tomando su bicornio, les dijo: “Mi prescencia a cesado de ser necesaria aquí.”."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee6e3293-61e5-4782-bf12-56bc523877d0",
                        "source_entry_id": "c8cf6c7d-c054-37b8-833b-58c870b69537",
                        "source_sense_id": "9b78bc0c-9827-3b79-8201-05a3a5573733",
