                    {
                        "sense_id": "255f03bb-501a-3c69-9eb7-cfb573ddc30f",
                        "entry_id": "f5e36b46-0c2a-3676-be57-215ac1f46f33",
                        "glosses": [
                            "Produit vectoriel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309ecd7e-b8d3-4e6d-aa91-21e3885f61c6",
                                "sense_id": "255f03bb-501a-3c69-9eb7-cfb573ddc30f",
                                "text": "Das Kreuzprodukt steht senkrecht auf seinen Faktoren.",
                                "translation": "Le produit vectoriel est perpendiculaire à ses facteurs."
                            },
                            {
                                "example_id": "3ff2e197-aecd-4b93-9c47-1a5340225089",
                                "sense_id": "255f03bb-501a-3c69-9eb7-cfb573ddc30f",
                                "text": "Das Kreuzprodukt zweier Vektoren, mittels des Skalarproduktes mit einem dritten multipliziert, ergibt das Spatprodukt.",
                                "translation": "Le produit vectoriel de deux vecteurs, multiplié par un troisième au moyen du produit scalaire, donne le produit mixte."
                            }
                        ]
                    }
                ],
