                    }
                ],
                "senses": [
                    {
                        "sense_id": "930e1efc-fae4-3cad-979a-95304241fec7",
                        "entry_id": "bf9175ff-5ef1-37a1-93bd-45c5ea9a1cd3",
                        "glosses": [
                            "Science qui s’intéresse à l’étude des planètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43590f2-9be2-4b68-99dc-71c1e47df79f",
                                "sense_id": "930e1efc-fae4-3cad-979a-95304241fec7",
                                "text": "Une des branches les plus importantes de la Planétologie est la géodésie, qui a pour objectif l’étude de la forme de la Terre, basée sur des mesures de précision."
                            },
                            {
                                "example_id": "312e0c6d-4c25-44b7-846b-f4e01ad8a079",
                                "sense_id": "930e1efc-fae4-3cad-979a-95304241fec7",
                                "text": "Indépendamment de ces six grandes réunions SETI, de nombreux symposiums sont, au cours de cette phase extrêmement active, organisés sur des sujets annexes tels que la planétologie, ou l’humanologie, directement liés à SETI."
                            },
                            {
                                "example_id": "47d15620-2d9b-4725-8f92-ddf46ee0d8c7",
                                "sense_id": "930e1efc-fae4-3cad-979a-95304241fec7",
                                "text": "La planétologie comparée devrait se développer au XXIᵉ siècle et enrichir la géologie et la géophysique traditionnelles."
                            },
                            {
                                "example_id": "2e7836f4-1b1d-4406-ac39-cfaf7529b118",
                                "sense_id": "930e1efc-fae4-3cad-979a-95304241fec7",
                                "text": "La planétologie d’aujourd'hui peut se définir autour de deux grands axes : d’une part, l’étude de l’origine et de l’évolution du système solaire (notamment à partir de l’étude du système solaire extérieur et de la matière extraterrestre) et, d’autre part, l’étude comparative des objets du système solaire (qu’il s’agisse de leur intérieur, de leur surface, de leur atmosphère ou de leur magnétosphère)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
