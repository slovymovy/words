                "senses": [
                    {
                        "sense_id": "1c7c957b-316e-39cf-be58-7229d0ef60d2",
                        "entry_id": "3ee94d3d-bf70-3a99-aeaa-75fa7644a1e1",
                        "glosses": [
                            "Eigenschaft eines Klimas, von einer Wassermasse (Weltmeer) geprägt zu sein; Grad, in dem das Klima nicht kontinental ist (sondern maritim)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc8ddfe6-c9af-4a18-a44f-b60a1ce4deae",
                                "sense_id": "1c7c957b-316e-39cf-be58-7229d0ef60d2",
                                "text": "„Kontinentalität und Maritimität des Klimas sind durch die Jahresamplitude der Temperatur (thermische Kontinentalität) zu kennzeichnen.“"
                            },
                            {
                                "example_id": "8c07ef60-c41a-49a8-af57-50c08e170177",
                                "sense_id": "1c7c957b-316e-39cf-be58-7229d0ef60d2",
                                "text": "„Maritimität bezeichnet relativ ausgeglichene Klimaverhältnisse, meist in Bezug auf Temperaturschwankungen.“"
                            },
                            {
                                "example_id": "bf1d03c0-478a-4321-976a-9dfb248b6299",
                                "sense_id": "1c7c957b-316e-39cf-be58-7229d0ef60d2",
                                "text": "„Die randlichen und die zentralen Gebiete der Kontinente unterscheiden sich dadurch, daß der Einfluß des Meeres mit wachsender Entfernung von der Küste immer geringer wird und daher die Maritimität (Beeinflussung durch das Meer) zunehmend durch kontinentale Klimazüge (Kontinentalität) ersetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
