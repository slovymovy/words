                "translations": [
                    {
                        "translation_id": "410b9f53-da89-4597-a1bc-fd4f39fb7ccf",
                        "source_entry_id": "66f9ad10-d101-348c-a9de-bd2523252cbd",
                        "source_sense_id": "6fb3a03d-9ba5-3e8f-8778-ff91539a2c91",
                        "target_lang_word": "интернированный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "интернированный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7327ebaf-280c-34d1-ab87-d64b87653ac3",
                                        "entry_id": "362179ad-16b9-3402-aa75-c83e339f35d0",
                                        "glosses": [
                                            "страд. прич. прош. вр. от интернировать; принудительно задержанный на территории нейтрального государства или на территории противника до окончания войны"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f42148b5-6171-4b5d-86db-b325191b997c",
                                                "sense_id": "7327ebaf-280c-34d1-ab87-d64b87653ac3",
                                                "text": "Мы вели длительную переписку и разговоры по поводу захвата французами черноморского транспорта и возвращения интернированных судов русского военного флота…"
                                            },
                                            {
                                                "example_id": "59c2f3f0-4c75-4ef6-a18a-ea4a4f22726a",
                                                "sense_id": "7327ebaf-280c-34d1-ab87-d64b87653ac3",
                                                "text": "Он выразил благодарность российским органам юстиции за содействие в поисках и предоставлении архивных документов о военнопленных и лицах, противозаконно интернированных в лагерях бывшего Советского Союза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4162c2c7-6cf1-3f11-8d20-60a37e9e4582",
                                        "entry_id": "362179ad-16b9-3402-aa75-c83e339f35d0",
                                        "glosses": [
                                            "субстантивир. интернированный (1) человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955f07cb-aac3-4e90-92d8-faebc47b9152",
                                                "sense_id": "4162c2c7-6cf1-3f11-8d20-60a37e9e4582",
                                                "text": "Дмитрий Волкогонов в своем жизнеописании Троцкого утверждает, что интернированных освободили после нескольких решительных протестов в газете «Правда»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
