                                        "examples": [
                                            {
                                                "example_id": "f594fbd7-6c75-4df8-9726-1229e3213bf9",
                                                "sense_id": "b9bf9a67-120e-3c76-a71c-155c616ca742",
                                                "text": "La première fut une mort en soirée, qui interrompit le film du mardi soir, un flash laconique annonçant la mort du président de la République Georges Pompidou."
                                            },
                                            {
                                                "example_id": "1e25130b-0c59-48fb-a6af-b4c3a6e62896",
                                                "sense_id": "b9bf9a67-120e-3c76-a71c-155c616ca742",
                                                "text": "Discours laconique."
                                            },
                                            {
                                                "example_id": "fdeecd2b-b056-4064-b53f-b02d5ad715ca",
                                                "sense_id": "b9bf9a67-120e-3c76-a71c-155c616ca742",
                                                "text": "Style laconique."
                                            },
                                            {
                                                "example_id": "b2315d50-63dd-43a0-aa58-f03a2079dcd8",
                                                "sense_id": "b9bf9a67-120e-3c76-a71c-155c616ca742",
                                                "text": "Réponse laconique."
                                            }
                                        ]
