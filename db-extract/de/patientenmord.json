                    {
                        "sense_id": "35c9ba22-8663-3365-b744-504ed26f5386",
                        "entry_id": "75b815ba-3ca2-3a0b-97d0-d53266fcfee6",
                        "glosses": [
                            "der Mord an einem Patienten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafeaafe-306b-45d2-a539-b690cbdeb74e",
                                "sense_id": "35c9ba22-8663-3365-b744-504ed26f5386",
                                "text": "„Nach Angaben der Zeitung ‚New York Times‘ hat ein Pfleger in Ohio und Kentucky, der nach eigenen Angaben 37 Menschen tötete, die bisher meisten Patientenmorde gestanden.“"
                            },
                            {
                                "example_id": "d682a645-565b-4b1a-962f-c5a2a9123c12",
                                "sense_id": "35c9ba22-8663-3365-b744-504ed26f5386",
                                "text": "„Und auch wenn er in der Heilanstalt Schussenried von den Patientenmorden der Nationalsozialisten verschont blieb, fühlte er sich doch bedroht und eingeengt.“"
                            },
                            {
                                "example_id": "c13a2cbc-5ae2-47a4-8a8f-9382685f1523",
                                "sense_id": "35c9ba22-8663-3365-b744-504ed26f5386",
                                "text": "„Der wegen einer Serie von Patientenmorden angeklagte ehemalige Krankenpfleger aus Niedersachsen hat nach Angaben eines psychiatrischen Gutachters rund 30 Tötungen eingeräumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
