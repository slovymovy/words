                "senses": [
                    {
                        "sense_id": "5864056f-4060-31f4-95c0-5bbdd352bd52",
                        "entry_id": "c57d281e-458d-3c67-9c4e-00fb4908283f",
                        "glosses": [
                            "Verbot des Konsums und/oder Verkaufs von alkoholischen Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbcf4dc-3673-4742-8f24-1e3be98a674c",
                                "sense_id": "5864056f-4060-31f4-95c0-5bbdd352bd52",
                                "text": "„Ein Alkoholverbot verhinderte weitere Opfer bei den folgenden Spielen – trotzdem gab es jedes Mal weit über tausend Schlägereien.“"
                            },
                            {
                                "example_id": "adc01c23-66dd-474f-a35d-89079ab3155c",
                                "sense_id": "5864056f-4060-31f4-95c0-5bbdd352bd52",
                                "text": "„Viele Experten sehen das Alkoholverbot sogar als Geburtshelfer der organisierten Kriminalität in den USA.“"
                            },
                            {
                                "example_id": "75063116-ed19-42ad-878c-7c41ffd4fbf2",
                                "sense_id": "5864056f-4060-31f4-95c0-5bbdd352bd52",
                                "text": "„Nach dem Becherwurf erwägt der VfL Bochum ein Alkoholverbot in Stadien.“"
                            },
                            {
                                "example_id": "a01cc04d-6d1c-44d3-8bbd-aae38bbd3148",
                                "sense_id": "5864056f-4060-31f4-95c0-5bbdd352bd52",
                                "text": "„Beim Revierderby zwischen Schalke 04 und Borussia Dortmund am Samstag (11.03.) gilt ein Alkoholverbot. Die Polizei Gelsenkirchen hat am Mittwoch bekannt gegeben, dass im Stadion und im Stadionumfeld aus Sicherheitsgründen kein Alkohol verkauft werden darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
