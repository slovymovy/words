                                        "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Constantly travelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3cf9a2-934d-4d25-aa1d-4b323b913e39",
                                                "sense_id": "23e54833-1042-32a7-af82-290d57261946",
                                                "text": "After peripatetic upbringing that took her from America to Portugal, Switzerland, Belgium and England, [Mary-Kay] Wilmers read French and Russian at Oxford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                        "entry_id": "490aa911-b9fc-37e4-b784-e68e70d96789",
                                        "glosses": [
                                            "Alternative letter-case form of Peripatetic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "capitalized",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cfe68d-d09a-442a-8f6a-ca151da5a18e",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "Demetreius of Phalerum, a peripatetic philosopher of the fourth century B.C., wrote an amatory treatise entitled Eroticus - no longer, however, extant."
                                            },
                                            {
                                                "example_id": "4fa707ef-e595-4c6c-9ac1-a577de52d464",
                                                "sense_id": "c0478c4d-e4c3-3d46-92bd-909815bd17b7",
                                                "text": "The true peripatetic school."
                                            }
                                        ]
                                    }
                                ]
                            },
