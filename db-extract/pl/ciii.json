                                "target_senses": [
                                    {
                                        "sense_id": "3f6de40b-5b39-38e1-a567-03573aacf565",
                                        "entry_id": "a595896b-1046-3c2c-b32f-a8b3ab6ad33a",
                                        "glosses": [
                                            "An utterance of shh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c140a015-1f2e-4780-aa1a-00371dd9219f",
                                                "sense_id": "3f6de40b-5b39-38e1-a567-03573aacf565",
                                                "text": "“Shh,” says Jenny’s mother, “shh. / Give a shh and a giddyap with your borscht.” / A knock is heard on Gloria’s door. / “Remember is someone asleep in the house!” / Jenny gives a shh and laps up her borscht."
                                            },
                                            {
                                                "example_id": "f56a35ad-bda1-40f6-bf28-c6f5bcd6c67c",
                                                "sense_id": "3f6de40b-5b39-38e1-a567-03573aacf565",
                                                "text": "Twenty-five million dollars each?! There were hmms and shhs around the table."
                                            },
                                            {
                                                "example_id": "92d0fb30-f1f4-4459-bee5-f13039f006ee",
                                                "sense_id": "3f6de40b-5b39-38e1-a567-03573aacf565",
                                                "text": "And, unlike with a film, or a TV show, or a dreary drinks party, you can’t just leave when the boredom descends like an itchy blanket. You are imprisoned by the etiquette of theatre. You can’t even commit suicide without attracting a chorus of shhes as you splash arterial blood all over the orchestra pit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe406b9-ac91-376a-bffc-147bc40025ff",
                                        "entry_id": "3fb1e6ce-100f-3550-94c3-e7b32e71ceb8",
                                        "glosses": [
                                            "To utter shh."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed63f5f8-cf54-4e13-800b-c47ada927c5e",
                                                "sense_id": "dbe406b9-ac91-376a-bffc-147bc40025ff",
                                                "text": "“Hey,” the test-taker who’d shhed sat up, glared, saw the exec, shut up, and hunched down over the test."
                                            },
                                            {
                                                "example_id": "2d92ad92-5067-4ac8-9598-a3bf25fd4af0",
                                                "sense_id": "dbe406b9-ac91-376a-bffc-147bc40025ff",
                                                "text": "‘No!’ Matt shhes."
                                            },
                                            {
                                                "example_id": "d7c6ebd9-7d57-4215-bde1-28c0af4c03f2",
                                                "sense_id": "dbe406b9-ac91-376a-bffc-147bc40025ff",
                                                "text": "Deep breathing in your baby’s ear is just as effective as white noise, if not more. Try to avoid ‘shhing’ your baby as this can become more violent if done frequently and loudly. The other drawback is that shhing involves your stomach muscles and when you shh you become tense; the more you shh the more tense you become."
                                            },
                                            {
                                                "example_id": "b71cbe63-05fb-47d7-b849-e1a4026fc862",
                                                "sense_id": "dbe406b9-ac91-376a-bffc-147bc40025ff",
                                                "text": "“I brought coffee,” Landon says but Aurora shhs him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shh",
                                "target_lang_code": "en",
                                "target_senses": [
