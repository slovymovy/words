                        "entry_id": "757095b8-2872-3c03-8c55-4712ae50b1c7",
                        "glosses": [
                            "Vertreter der gleichnamigen Pflanzengattung aus der Unterfamilie Scilloideae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f673652-8807-494e-82ba-e1ec5afb38d3",
                                "sense_id": "dcfe7a3b-12a9-3262-bcbf-84e79b98d626",
                                "text": "Auf den Balkons blühen auch im Herbst noch in verschiedenen Farben Sternhyazinthen."
                            },
                            {
                                "example_id": "b8ae4ce1-a608-40a7-8606-bc837d01b8d8",
                                "sense_id": "dcfe7a3b-12a9-3262-bcbf-84e79b98d626",
                                "text": "„Die Sternhyazinthen (Chionodoxa), auch Schneeglanz und Schneestolz genannt, sind eine Pflanzengattung innerhalb der Unterfamilie Scilloideae.“"
                            }
                        ],
