                "senses": [
                    {
                        "sense_id": "91b2005c-d072-3e05-a14e-ddb1000e0a08",
                        "entry_id": "824c2e0a-ba50-309b-92a6-2be83666505c",
                        "glosses": [
                            "Petit balai, parfois sans manche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bbc34d5-06f8-44c1-9ae3-c3dec01b542a",
                                "sense_id": "91b2005c-d072-3e05-a14e-ddb1000e0a08",
                                "text": "Pour fourguer une balayette à chiotte, il faisait une tragédie shakespearienne. Il vendait en poète. C’était un artiste."
                            },
                            {
                                "example_id": "3281acfe-24de-437c-a98f-d1632d358db9",
                                "sense_id": "91b2005c-d072-3e05-a14e-ddb1000e0a08",
                                "text": "Au moins, si je passais un coup de balayette, je garderais mes mains occupées."
                            },
                            {
                                "example_id": "127819bd-c16e-463e-9291-de9769a6b426",
                                "sense_id": "91b2005c-d072-3e05-a14e-ddb1000e0a08",
                                "text": "Verena, qui a saisi une balayette et une pelle, ramasse le verre brisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b64a65e-1a5f-3058-b38c-584dd2b77cc5",
                        "entry_id": "824c2e0a-ba50-309b-92a6-2be83666505c",
                        "glosses": [
                            "Petit balai de bruyère utilisé dans le filage des cocons de soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "03619921-19dd-3202-bf2a-b37bb6102fac",
                        "entry_id": "824c2e0a-ba50-309b-92a6-2be83666505c",
                        "glosses": [
                            "Coup de pied sec porté au niveau de la cheville ou du tibia dans le but de faire chuter quelqu’un."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "07ae3665-97fd-43d5-9a87-8ebfdd3f3be8",
                                "sense_id": "03619921-19dd-3202-bf2a-b37bb6102fac",
                                "text": "Parvenant à se relever, le jeune homme prend la fuite mais, rattrapé, propulsé au sol par une balayette, il essuie une seconde salve de tirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0a69b21-64c0-3537-b10b-4b667f8a4b0c",
                        "entry_id": "824c2e0a-ba50-309b-92a6-2be83666505c",
                        "glosses": [
