                "senses": [
                    {
                        "sense_id": "2ad7eaf8-7430-33e3-83f0-aeb62bdc5954",
                        "entry_id": "22f0f470-91f6-3236-8438-a5d9c501ede7",
                        "glosses": [
                            "Supérieure dans un monastère de femmes, soit en chef, soit sous une abbesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771500aa-0c73-4f7c-b3b1-54ae0b214549",
                                "sense_id": "2ad7eaf8-7430-33e3-83f0-aeb62bdc5954",
                                "text": "Comme l’atteste cette charte, moi Oicie, prieuresse de la Fougereuse, et tout le couvent, nous donnons et concédons à Geoffroi du Jarri et à ses héritiers la meunerie du moulin Aumont : à condition que la prieuresse pourvoiera à toutes les nécessités du moulin, sauf la roue, la rotonde et l’arbre que Geoffroi et ses héritiers doivent charpenter, ainsi que la cinquième partie du chapus ; et le jour où ils feront quelque travail au moulin, ils doivent vivre sur le commun."
                            },
                            {
                                "example_id": "501179c9-3fb3-42de-bafa-9eb158a43c39",
                                "sense_id": "2ad7eaf8-7430-33e3-83f0-aeb62bdc5954",
                                "text": "Elle fut aussitôt admise et elle y mourut, âgée de plus de cent ans, en odeur de sainteté, simple religieuse, ne sachant ni lire ni écrire selon les uns, prieuresse suivant les autres, la veille de la Nativité de la Très Sainte Vierge, l’an du Seigneur 1589."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53824ab2-bbcd-4cc5-8828-1369d3ddec68",
                        "source_entry_id": "22f0f470-91f6-3236-8438-a5d9c501ede7",
                        "source_sense_id": "2ad7eaf8-7430-33e3-83f0-aeb62bdc5954",
                        "target_lang_word": "Priorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1077e75b-6e3f-3d70-9048-ff665c3ae519",
                                        "entry_id": "9eadf92b-b08e-333c-95d0-dad32772a563",
                                        "glosses": [
                                            "Vorsteherin eines Klosters für Frauen, als Generalpriorin auch eines Ordens"
                                        ],
                                        "tags": [
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9699dcb8-4f32-4b0d-8ee8-dbb676eadc6e",
                                                "sense_id": "1077e75b-6e3f-3d70-9048-ff665c3ae519",
                                                "text": "„Heute am 5. Oktober 2017 wurde Schwester M. Jacinta Rohner im Beisein von Abt Christian Meyer, Engelberg, als Mutter Priorin wiedergewählt.“"
                                            },
                                            {
                                                "example_id": "3c4739a5-245b-45f2-95db-e16c3ab592f7",
                                                "sense_id": "1077e75b-6e3f-3d70-9048-ff665c3ae519",
                                                "text": "„Die Priorin hat Weisung, mich von niemandem besuchen zu lassen und mir keinerlei brieflichen Verkehr, mit wem auch immer, zu erlauben; aber ich bin bereits sicher, daß ich Dir trotz ihres Verbotes schreiben kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
