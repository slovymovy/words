                    {
                        "sense_id": "e60d632e-8255-3c55-8e9b-a62a0649b17e",
                        "entry_id": "a079f1bf-0f82-3a5d-81c4-6fcffa335c8d",
                        "glosses": [
                            "Dépasser le stade de, dépasser l'âge de."
