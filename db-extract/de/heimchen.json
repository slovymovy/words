                            "derogatory",
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a5deefc4-23c5-435d-ad4c-310ec99e2693",
                                "sense_id": "65ab8192-ad7d-30cc-acac-d017095ae25f",
                                "text": "Heimchen am Herd"
                            },
                            {
                                "example_id": "a96bb77e-e23a-4280-aa61-a849dca59a66",
                                "sense_id": "65ab8192-ad7d-30cc-acac-d017095ae25f",
                                "text": "Vielschichtiger gestaltet sind hier übrigens die Frauenrollen, egal ob Heimchen oder Kriegerin. Aber das ist ja auch Norwegen und nicht Deutschland."
                            }
                        ]
                    }
