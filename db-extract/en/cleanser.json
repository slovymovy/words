                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ee2f35-8bfb-4b19-99de-d556b60e2c45",
                                "sense_id": "be2c1ac8-1649-3c15-833c-b61d8b715981",
                                "text": "The Breeding of Worms in your Desks we cannot prevent, but for the moulding of the books, it may soon be remedied, if the Cleanser of the Library do his duty."
                            },
                            {
                                "example_id": "b6b4a6c9-ec20-47b4-bb41-bc23669c3ada",
                                "sense_id": "be2c1ac8-1649-3c15-833c-b61d8b715981",
                                "text": "Lorraine Massey, a founder of Devachan, simply rinses and agitates her scalp with fingers (or uses a nonlathering cleanser like Devachan No-Poo)."
                            },
                            {
                                "example_id": "b13862bb-b75c-4244-a593-18957e3982eb",
                                "sense_id": "be2c1ac8-1649-3c15-833c-b61d8b715981",
                                "text": "Dr. Khorana added that this is especially true of cleansers that feature surfactants like sodium lauryl sulfate, as this class of ingredients can cause “dryness, irritation and eczema.”"
                            }
                        ]
