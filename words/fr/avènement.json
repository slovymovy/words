                    "frequency": "Middle",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>avènement</w> d'Internet a profondément transformé notre façon de communiquer au quotidien."
                        },
                        {
                            "text": "De nombreux historiens étudient l'<w>avènement</w> de la démocratie moderne en Europe."
                        }
                    ],
                    "synonyms": [
                        "apparition",
                        "venue",
                        "émergence"
                    ],
                    "antonyms": [
                        "déclin",
                        "disparition",
                        "fin"
                    ],
                    "common_phrases": [
