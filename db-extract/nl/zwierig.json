                                "target_senses": [
                                    {
                                        "sense_id": "52819259-89ef-3fc2-b7a1-300409ee828e",
                                        "entry_id": "df6cf1fb-30d0-3209-9428-96834aaeb1b1",
                                        "glosses": [
                                            "Characterised by or exhibiting elegance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46934590-f8b3-43f1-a353-3eee95377c42",
                                                "sense_id": "52819259-89ef-3fc2-b7a1-300409ee828e",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25ba882-d6bd-3c12-8433-83da3bb025d0",
                                        "entry_id": "df6cf1fb-30d0-3209-9428-96834aaeb1b1",
                                        "glosses": [
                                            "Characterised by minimalism and intuitiveness while preserving exactness and precision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7689b603-df37-465f-a8cd-62043d85d52f",
                                                "sense_id": "f25ba882-d6bd-3c12-8433-83da3bb025d0",
                                                "text": "an elegant solution"
                                            },
                                            {
                                                "example_id": "2ae1c069-4450-43b1-8a1e-ce1bd24a318a",
                                                "sense_id": "f25ba882-d6bd-3c12-8433-83da3bb025d0",
                                                "text": "\"For myself, because of the baggage of 30 years of balkanisation, I think the elegant solution is to take operations back into the public sector. It will mean you can have a whole-industry approach to running the railway, unencumbered by contractual differences.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f813da-565d-3da7-b32d-f442646a0b95",
                                        "entry_id": "df6cf1fb-30d0-3209-9428-96834aaeb1b1",
                                        "glosses": [
                                            "Fine; doing well."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "archaic",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c38495a-77e4-4d07-a6dd-db0384f3dfe4",
                                                "sense_id": "f3f813da-565d-3da7-b32d-f442646a0b95",
                                                "text": "'An' how are ye, Jemmie—how's every inch iv you?' enquired Moggy of the boy, when his agitation was a little blown over.\n'I'm elegant, thank ye,' he answered; 'an' what's the matther wid ye all? I cum through the kitchen, and seen no one.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elegant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b830be04-efb4-31b8-8c2d-4d93d6e7c8ce",
                                        "entry_id": "10a7ddfd-8dab-3ee5-b321-60a7527284a0",
                                        "glosses": [
                                            "An elegant parrot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233c2d65-17ca-433c-b528-054f36324926",
                                                "sense_id": "b830be04-efb4-31b8-8c2d-4d93d6e7c8ce",
                                                "text": "But if the Aviarist be ambitious to keep the lovely, but destructive, members of the Parrot family, he must be content with grass alone, because Parrakeets (except the weak-billed Turquoisines and Elegants) would destroy the shrubs and trees in a day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
