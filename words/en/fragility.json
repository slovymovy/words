                    "frequency": "Middle",
                    "semantic_group_id": "physical_or_general_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique vase was packaged with great care due to its extreme <w>fragility</w>."
                        },
                        {
                            "text": "Looking down at the Earth from space reminds astronauts of the <w>fragility</w> of life."
                        }
                    ],
                    "synonyms": [
                        "brittleness",
                        "delicacy",
                        "frangibility"
                    ],
