                        "cross_references": [
                            {
                                "target_word": "estremismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "984197dc-77d5-3b95-aa93-43f423d99c2c",
                                        "entry_id": "b114a5e4-9cd4-3ad8-9118-5a6726aab8c7",
                                        "glosses": [
                                            "atteggiamento di chi, nell'azione politica, propone l'attuazione intransigente e radicale di un programma"
                                        ],
                                        "tags": [],
