{
    "word_family": [
        "frons",
        "gefrons"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12ee36df-ac24-3c1d-83b4-10f9199d0ec6",
                    "sense_definition": "het samentrekken van de wenkbrauwen als teken van concentratie, verbazing of ongenoegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>fronste</w> haar wenkbrauwen in verwarring toen ze de moeilijke vraag las.",
                            "target_lang_translations": {
                                "en": "She <w>frowned</w> her eyebrows in confusion when she read the difficult question."
                            }
                        },
                        {
                            "text": "Hij <w>fronste</w> toen hij het slechte nieuws over de vertraging hoorde.",
                            "target_lang_translations": {
                                "en": "He <w>frowned</w> when he heard the bad news about the delay."
                            }
                        },
                        {
                            "text": "Je moet niet zo diep <w>fronsen</w> als je nadenkt, want dat geeft rimpels.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>frown</w> so deeply when you think, because that causes wrinkles."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wenkbrauwen fronsen",
                        "diep fronsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to contract the eyebrows as a sign of concentration, surprise, or displeasure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frown",
                                "target_lang_sense_clarification": "to wrinkle the forehead"
                            },
                            {
                                "target_lang_word": "knit one's brows",
                                "target_lang_sense_clarification": "to frown in concentration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9993e2a8-e000-3bea-ad07-c409e7c51748",
                    "sense_definition": "je wenkbrauwen ophalen als teken van afkeuring of morele twijfel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd door velen <w>gefronst</w> toen het controversiële nieuws eindelijk verteld werd.",
                            "target_lang_translations": {
                                "en": "Many <w>frowned</w> when the controversial news was finally told."
                            }
                        },
                        {
                            "text": "De critici zullen de wenkbrauwen <w>fronsen</w> bij dit vreemde voorstel van de minister.",
                            "target_lang_translations": {
                                "en": "Critics will <w>raise their eyebrows</w> at this strange proposal from the minister."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de wenkbrauwen fronsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to raise or furrow the eyebrows as a sign of disapproval or moral doubt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frown upon",
                                "target_lang_sense_clarification": "to show disapproval"
                            },
                            {
                                "target_lang_word": "raise an eyebrow",
                                "target_lang_sense_clarification": "to show skepticism or surprise"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29ac9358-145c-39a7-9f1b-ca1dd7eef857",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>frons</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stonden diepe <w>fronzen</w> in zijn voorhoofd na jaren van hard werken.",
                            "target_lang_translations": {
                                "en": "There were deep <w>frowns</w> in his forehead after years of hard work."
                            }
                        },
                        {
                            "text": "Zij probeert de <w>fronzen</w> op haar gezicht te verbergen met een glimlach.",
                            "target_lang_translations": {
                                "en": "She tries to hide the <w>frowns</w> on her face with a smile."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'frown', referring to the lines or expression on the forehead"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frowns",
                                "target_lang_sense_clarification": "plural of the facial expression"
                            },
                            {
                                "target_lang_word": "furrows",
                                "target_lang_sense_clarification": "deep lines in the forehead"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}