                        "sense_id": "92cf656f-2285-3c09-a027-0a232f4359a4",
                        "entry_id": "77494194-8b25-3139-bbc1-c8304745dd4c",
                        "glosses": [
                            "actie waarbij men in een relatief beperkte tijd zeer veel mensen vaccineert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f460f23-c621-445b-8328-40c2a1eb6104",
                                "sense_id": "92cf656f-2285-3c09-a027-0a232f4359a4",
                                "text": "Voor hun onderzoek bekeken de wetenschappers het eerste half jaar van de vaccinatiecampagne met de zogenoemde mRNA-vaccins van Pfizer en Moderna, schrijven ze in het medische vaktijdschrift The Lancet. Dat kwam neer op bijna 299 miljoen prikken, waar ruim 340.000 meldingen over binnenkwamen bij het VAERS-systeem."
                            },
                            {
                                "example_id": "f11743e9-564b-43ef-a22f-15e9cb9ecdf2",
                                "sense_id": "92cf656f-2285-3c09-a027-0a232f4359a4",
                                "text": "De Belgische overheid begint dit najaar een nieuwe vaccinatiecampagne tegen COVID-19. Alle volwassen Belgen kunnen als ze dat willen een tweede boosterprik tegen het virus krijgen, hebben de Belgische ministers van Volksgezondheid besloten. Wel zijn eerst de risicogroepen en het zorgpersoneel aan de beurt."
                            }
                        ]
                    }
