                "senses": [
                    {
                        "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                        "entry_id": "b81a661c-d9e9-357f-aa04-fc3463db7d67",
                        "glosses": [
                            "Funktion zur Verkettung von Zeichenketten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67bd63c8-cab7-44a9-b662-c81c1f4dfe8c",
                                "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                                "text": "„Unter einem Konkatenationsoperator versteht man einen Operator, der für das Aneinanderhängen von zwei Zeichenketten steht.“"
                            },
                            {
                                "example_id": "c3b253d2-66c6-4474-a569-c26d76ef8b0f",
                                "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                                "text": "„Als Konkatenationsoperator wird das Pluszeichen + verwendet.“"
                            },
                            {
                                "example_id": "4e0b7642-5c07-4671-a466-2c5c580e197d",
                                "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                                "text": "„Steht das +-Zeichen zwischen zwei Operanden, von denen einer dem String-Typ, der andere einem numerischen Typ angehört, wandelt der Compiler den numerischen Wert automatisch in einen String um und interpretiert das + als Konkatenationsoperator.“"
                            },
                            {
                                "example_id": "764b25ac-5ead-4adf-93d5-12eef0095bd4",
                                "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                                "text": "„Textdarstellungen für die Werte von Datenobjekten werden auch weiterhin mit den überladenen Str-Funktionen erzeugt und gemeinsam mit konstanten Zeichen und Zeichenketten mit dem Konkatenationsoperator ‚&‘ zu Ausgabetexten zusammengefügt.“"
                            },
                            {
                                "example_id": "968d6953-4097-4716-90a6-35d383949258",
                                "sense_id": "64481a49-920d-3611-981c-6133860942c8",
                                "text": "„Da eine neue Sequenz sₐ eines Updates immer ans Ende einer bestehenden Sequenz s angehängt wird, ist es effizienter, die daraus resultierende Sequenz s′ = s ∘ sₐ (mit ∘ als Konkatenationsoperator) vom Ende zum Anfang hin zu durchlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
