                ],
                "senses": [
                    {
                        "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                        "entry_id": "8a031686-9764-365e-a8c5-d98485333209",
                        "glosses": [
                            "federiger, runder Kranz aus Federstahl oder dünnem Metall der aus vielen einzelnen Kontaktfedern zur Abdichtung, Übertragung oder Ableitung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e3d6e3-fa26-4b83-b5ce-ebe61d08fcb6",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Mit der Flanschplatte ist ein Kontaktfederkranz verbunden, der den Ringbund koaxial umgibt.“"
                            },
                            {
                                "example_id": "320f85a9-8638-4823-bb5a-cee2db9c2012",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Statt einer länglichen Kontaktfeder, wurde ein längliches Rohr mit einem stirnseitigen Kontaktfederkranz ersetzt.“"
                            },
                            {
                                "example_id": "50a8f51b-9691-42b3-b743-a693ba9f8156",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Dies ist besonders wichtig, wenn der Raum um die Röhre durch einen Topfkreis verbaut ist, da Kontaktfederkränze und andere Schirmbleche oft im Luftstromkreis liegen, und den Luftzyklus behindern können.“"
                            },
                            {
                                "example_id": "583616e4-55ef-4f5a-a012-c4af05754475",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Ein Kontaktfederkranz bewirkt bei Einsetzen der Optik den simultanen Anschluß aller Blenden (Vielfachdurchführung im Grundkörper)“"
                            },
                            {
                                "example_id": "8ceb31af-b63c-475b-8b8c-2984b645d381",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Ausstattung:· Äußeres Gitter, die Kathode, ist aus einem V2A-Metallgestrick; Glasrohr, besteht aus Quarzglas; Inneres Lochblech, die Anode, ist aus Alu-Blech; Innerer Distanzbolzen ist aus Alu-Rohr und trägt stirnseitig den Kontaktfederkranz, der aus V2A-Federstahl gefertigt ist.“"
                            },
                            {
                                "example_id": "1142ae00-c101-4ba4-8370-9badc90baa82",
                                "sense_id": "bbbb81bc-c166-3787-84ae-dc355634e0fc",
                                "text": "„Die angelegte Hochspannung gelangt vom Transformator über einen Gewindezapfen in der einseitigen Abschlusskappe des Glaskolbens und einem inneren Stehbolzen mit stirnseitigem Kontaktfederkranz zum inneren Lochblech, welches als Elektrode diente“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
