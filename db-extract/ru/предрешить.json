                ],
                "senses": [
                    {
                        "sense_id": "fbd76756-9d54-3479-879c-685076b3fc15",
                        "entry_id": "e6de22c0-095c-3e49-a154-e2c1fe028fe5",
                        "glosses": [
                            "заранее решить, определить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca8dd7e-0e8f-4dfa-9c13-39a03c6d6a41",
                                "sense_id": "fbd76756-9d54-3479-879c-685076b3fc15",
                                "text": "Все это крайне возмутило Петра, и он вперед предрешил осмотреть эту крепость силой."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd3dc9a4-b0cd-3d3f-9463-ec33d080e58a",
                        "entry_id": "e6de22c0-095c-3e49-a154-e2c1fe028fe5",
                        "glosses": [
                            "явиться причиной чего-либо, предопределить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bb2705-01f5-4439-a00e-5f9e6a55cdea",
                                "sense_id": "fd3dc9a4-b0cd-3d3f-9463-ec33d080e58a",
                                "text": "Энергетическое язычество, охватившее мир в прошлом столетии, предрешило нашу судьбу."
                            }
                        ]
                    }
                ],
