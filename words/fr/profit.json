                },
                {
                    "sense_id": "d745b6a0-1e5b-35c9-b8b8-b908d46a694f",
                    "sense_definition": "Gratification, pourboire ou petit avantage accessoire que recevaient autrefois les domestiques en plus de leurs gages.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le valet complétait ses modestes gages réguliers grâce aux <w>profits</w> laissés par les invités."
