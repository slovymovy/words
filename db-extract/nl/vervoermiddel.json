                    {
                        "translation_id": "13f72887-f9f9-46ff-be53-28a9f116d2e8",
                        "source_entry_id": "6b908df4-2f51-3089-98d9-eb8bf2272b04",
                        "source_sense_id": "cf312047-4d6d-37d3-b538-e29c993e9500",
                        "source_sense_description": "voorwerp bestemd om personen of goederen naar een andere plaats te brengen",
                        "target_lang_word": "транспортное средство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "транспортное средство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e145ac6c-2339-3b30-ac4b-cb35b85d7c0e",
                                        "entry_id": "0f30107e-119f-3acc-8c6c-d4045d811b4b",
                                        "glosses": [
                                            "автомоб., офиц. устройство, предназначенное для перевозки людей, грузов или установленного на нём оборудования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9175d1b4-eabc-4336-a599-a25f6bc060fc",
                                                "sense_id": "e145ac6c-2339-3b30-ac4b-cb35b85d7c0e",
                                                "text": "Дело в том, что с появлением конных пассажирских экипажей (например, омнибусов) там получил распространение довольно необычный тип их вождения ― кучера сидели сзади или на крыше вверенного им транспортного средства. И, соответственно, при правостороннем движении кучер-правша, размахиваясь, бил кнутом не только лошадей, но и прохожих."
                                            },
                                            {
                                                "example_id": "d128dfd4-e496-48c1-9302-d401c91e6a8b",
                                                "sense_id": "e145ac6c-2339-3b30-ac4b-cb35b85d7c0e",
                                                "text": "Действительно, паспорт транспортного средства никаких новых сведений не содержал ― обычный «Дэу-Матиз» цвета «амазонская зелень»."
                                            },
                                            {
                                                "example_id": "748f826d-ac4f-4a33-a634-f7b2f3a47924",
                                                "sense_id": "e145ac6c-2339-3b30-ac4b-cb35b85d7c0e",
                                                "text": "Завидев издали любое транспортное средство, он затаивался, а когда машина подъезжала ближе, выскакивал и с лаем мчался следом."
                                            },
                                            {
                                                "example_id": "5235dc17-ffa4-4b69-954a-c232d24674f2",
                                                "sense_id": "e145ac6c-2339-3b30-ac4b-cb35b85d7c0e",
                                                "text": "Первой к 2030―2040-м годам подорожает нефть, что ещё раньше спровоцирует перевод большинства транспортных средств в развитых странах на альтернативные (например, электрические двигатели)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb2d178-89b1-358d-ad86-aad0714e7ec5",
                                        "entry_id": "0f30107e-119f-3acc-8c6c-d4045d811b4b",
                                        "glosses": [
                                            "экон. техническое средство доставки из одного места в другое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c2bb5f-b01a-4cec-b0d1-ec6ae93eb4f1",
                                                "sense_id": "bbb2d178-89b1-358d-ad86-aad0714e7ec5",
                                                "text": "Однако самолет, автобус, поезд ― это разные транспортные средства."
                                            },
                                            {
                                                "example_id": "57745f55-f95b-47d4-9a4b-33aac99a0bec",
                                                "sense_id": "bbb2d178-89b1-358d-ad86-aad0714e7ec5",
                                                "text": "Поэтому в июне 1940 года у вермахта почти не было транспортных средств для масштабного десанта."
                                            },
                                            {
                                                "example_id": "47263fc5-cddd-4e86-a84f-cc8b557662ea",
                                                "sense_id": "bbb2d178-89b1-358d-ad86-aad0714e7ec5",
                                                "text": "В итоге была получена возможность использовать новый корабль, как в многодневных автономных полетах, так и, после соответствующих доработок, в качестве транспортного средства для доставки экипажей и снабжения на орбитальные станции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
