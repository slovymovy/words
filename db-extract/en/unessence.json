                    {
                        "sense_id": "fd02bbde-62ab-39d8-961b-018a71bd8ce8",
                        "entry_id": "593407bf-8a04-340c-b6f9-64ed55ec95ac",
                        "glosses": [
                            "To deprive of its essential nature."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "39d34076-41f3-40cc-bf8c-d911945372ff",
                                "sense_id": "fd02bbde-62ab-39d8-961b-018a71bd8ce8",
                                "text": "Not only does truth, in these long intervals, unessence herself, but (what is harder) one cannot venture a crude fiction for the fear that it may ripen into a truth upon the voyage."
                            },
                            {
                                "example_id": "01a80694-d968-4b50-bfb1-f30ec11927c9",
                                "sense_id": "fd02bbde-62ab-39d8-961b-018a71bd8ce8",
                                "text": "Education is a vital process involving intelligent, growing, sensitive and dynamic human elements and it becomes mechanical at the risk of unessencing itself."
                            }
                        ]
                    }
