        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a9006f2d-365d-3535-8255-6fed0cbf0166",
                "word": "bap",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0faf0cb-6b41-3b2e-aace-196656bc1422",
                        "entry_id": "a9006f2d-365d-3535-8255-6fed0cbf0166",
                        "glosses": [
                            "The sound of a light blow or slap."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "9785d64e-b2ec-44c7-a442-954f4ce998d3",
                                "sense_id": "d0faf0cb-6b41-3b2e-aace-196656bc1422",
                                "text": "Damian rolls Mr. McNutt over and beats the tar out of him with a series of punches, glasses on or not.\nBAP! BAP! SMACK! BAP! BAP! \"You and your men are going to get my family killed!\" hollers Damian."
                            },
                            {
                                "example_id": "3f0f1f57-4115-4c50-91dd-d82580c3a31e",
                                "sense_id": "d0faf0cb-6b41-3b2e-aace-196656bc1422",
                                "text": "Elizabeth continued into the living room and saw Velvet napping on the cool linoleum under the dining room table. She stopped to stroke her silky side and the puppy's tail went bap, bap, bap against the floor in greeting."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bf5632ec-b16e-3e85-9c74-db76153c3b90",
                "word": "BAP",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ace4b335-308b-3ae5-95f8-8803033657f8",
                        "entry_id": "bf5632ec-b16e-3e85-9c74-db76153c3b90",
                        "glosses": [
                            "Initialism of Bronze Age Pervert, a far-right Internet personality."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "2d7d9e7d-6c5f-4ab2-ae98-da384bc54b89",
                                "sense_id": "ace4b335-308b-3ae5-95f8-8803033657f8",
                                "text": "In a speech earlier this year, Peter Thiel said that while he found BAP’s solutions to modern problems “tempting,” he disagreed with his “distortions to the Judeo-Christian tradition.”"
                            },
                            {
                                "example_id": "67ed165f-d50f-49ed-9848-5cea45286ea4",
                                "sense_id": "ace4b335-308b-3ae5-95f8-8803033657f8",
                                "text": "It is hard to convey precisely what BAP believes, in part because his views are so outlandish that even when stated simply, they sound like incoherent ranting."
                            },
                            {
                                "example_id": "aa623777-8520-4c54-98e5-bfc75048bede",
                                "sense_id": "ace4b335-308b-3ae5-95f8-8803033657f8",
                                "text": "BAP has produced an ungrammatical and meandering but refreshingly brief “exhortation” (as he terms it) that reveals a widely read mind."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
