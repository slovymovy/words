                                "target_senses": [
                                    {
                                        "sense_id": "3b82ae7a-cbdd-3a68-8925-cf7b987da17f",
                                        "entry_id": "8c1f5440-5701-3734-871d-b33b4f323bff",
                                        "glosses": [
                                            "Feverish, or having a high temperature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6d56dc-97e4-4eec-86b7-6de2328a9870",
                                                "sense_id": "3b82ae7a-cbdd-3a68-8925-cf7b987da17f",
                                                "text": "Aurora's orange sun (Baley scarcely noted the orange tinge now) was mildly warm on his back, lacking the febrile heat that Earth's sun had in summer (but, then, what was the climate and season on this portion of Aurora right now?)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c083c23b-a8c3-392e-a069-0f73792eb70c",
                                        "entry_id": "8c1f5440-5701-3734-871d-b33b4f323bff",
                                        "glosses": [
                                            "Involving fever as a symptom or cause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd29fc8a-1fab-3069-a153-5ed21c6bc511",
                                        "entry_id": "8c1f5440-5701-3734-871d-b33b4f323bff",
                                        "glosses": [
                                            "Full of nervous energy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89667bfe-8a16-41ca-bee6-0a576844b54b",
                                                "sense_id": "dd29fc8a-1fab-3069-a153-5ed21c6bc511",
                                                "text": "An already febrile atmosphere within the ground before the start had been stoked still further when France's players formed an arrow formation to face down the haka, and then advanced slowly over halfway as the capacity crowd roared."
                                            },
                                            {
                                                "example_id": "f24a45d7-7e62-460b-941a-6ad245f4c8e2",
                                                "sense_id": "dd29fc8a-1fab-3069-a153-5ed21c6bc511",
                                                "text": "Out in the ground, meanwhile, it was particularly disappointing to hear former England captain Andrew Strauss put the febrile atmosphere down to “people who don’t normally come to Lord’s”."
                                            },
                                            {
                                                "example_id": "a735303d-f2df-42f6-91eb-89c7644d5e99",
                                                "sense_id": "dd29fc8a-1fab-3069-a153-5ed21c6bc511",
                                                "text": "Harry Potter has become such a febrile battleground that the pattern has already become well worn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
