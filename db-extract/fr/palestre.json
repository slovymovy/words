                "senses": [
                    {
                        "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                        "entry_id": "305c9ac9-a899-3a41-9991-c2491a99cba6",
                        "glosses": [
                            "Lieu public, chez les Grecs, où les jeunes gens se formaient aux différents exercices du corps."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0f4b51d6-e2d3-4e91-9869-ea55b5fd5df6",
                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                "text": "Le sable des palestres était toujours aussi blond qu’autrefois ; Phidias et Socrate ne les fréquentaient plus , mais les jeunes hommes qui s’y exerçaient ressemblaient encore au délicieux Charmide."
                            },
                            {
                                "example_id": "9d79957f-19a6-4688-bfdf-b5ab69f7f6be",
                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                "text": "Il y avait dans les palestres des portiques, des bains chauds et froids, et même des salles pour les leçons de philosophie et de grammaire."
                            },
                            {
                                "example_id": "88d2b29b-2a55-4e8e-b5e2-32853a6ec341",
                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                "text": "Vitruve a laissé le plan d’une palestre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0d8ded6-b461-3a3d-9232-083208e5330d",
                        "entry_id": "305c9ac9-a899-3a41-9991-c2491a99cba6",
                        "glosses": [
                            "Les exercices mêmes, c’est-à-dire la lutte, le pugilat, la course, le saut, le disque, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
