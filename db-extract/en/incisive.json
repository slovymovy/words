                    {
                        "sense_id": "625b60d2-de1a-3f02-9ad5-865dbb2a5835",
                        "entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "glosses": [
                            "Intelligently analytical and concise. (of a person or mental process)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4b28cf9a-9415-3d44-8590-b7268afc3c5d",
                        "entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "glosses": [
                            "Intelligently analytical and concise. (of a person or mental process)",
                            "Accurate and sharply focused. (of an account)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddb19b3b-2ff7-3dc7-9a61-a5eaffa05066",
                        "entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "glosses": [
                            "Quickly proceeding to judgment and forceful in expression. (of an action)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2db211-2969-417d-a299-eb958aa85841",
                                "sense_id": "ddb19b3b-2ff7-3dc7-9a61-a5eaffa05066",
                                "text": "An incisive producer, who expressed vehement disapproval with my pitch upon my first sentence."
                            },
                            {
                                "example_id": "8ba9e5de-b5bb-49cd-8cf6-d9b93281add6",
                                "sense_id": "ddb19b3b-2ff7-3dc7-9a61-a5eaffa05066",
                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry. His wooing had been brief but incisive."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfdc7895-1259-3738-a061-5fa689f9be7e",
                        "entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "glosses": [
                            "Having the quality of incising, cutting, or penetrating, as with a sharp instrument; trenchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878b5d43-3b66-4081-9fc9-2c9e0b322489",
                                "sense_id": "bfdc7895-1259-3738-a061-5fa689f9be7e",
                                "text": "An incisive, high voice."
                            },
                            {
                                "example_id": "2297d424-695d-4740-8b39-e32ebfabdd22",
                                "sense_id": "bfdc7895-1259-3738-a061-5fa689f9be7e",
                                "text": "And her incisive smile accrediting / That treason of false witness in my blush."
                            }
                        ]
                    },
                    {
                        "sense_id": "48b0f7ec-58c0-3c03-9980-0b11639ce936",
                        "entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "glosses": [
                            "Of or relating to the incisors."
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d2fbb3-5c9d-4cd4-8a9e-89e6d7c5ea93",
                                "sense_id": "48b0f7ec-58c0-3c03-9980-0b11639ce936",
                                "text": "the incisive bones, the premaxillaries"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3552de54-49f4-4e42-8e12-b005c811f4cb",
                        "source_entry_id": "76fd4889-39ae-3226-be8e-36390fe8f499",
                        "source_sense_description": "quickly proceeding to judgment",
                        "target_lang_word": "incisif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incisif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2647fc4-c080-3a30-960c-b7c4f535bf58",
                                        "entry_id": "6ca3bc61-db2d-3bd7-b4bf-86745a7febd7",
                                        "glosses": [
                                            "Qui coupe ou qui est propre à couper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ebf3be-a14b-4d6d-90c4-a7c5d1b68f72",
                                                "sense_id": "a2647fc4-c080-3a30-960c-b7c4f535bf58",
                                                "text": "Dents incisives ou, substantivement, les incisives, dents de devant, qui sont faites pour couper les aliments."
                                            },
                                            {
                                                "example_id": "e82620a0-7d33-4013-92a1-2a5765c59ccb",
                                                "sense_id": "a2647fc4-c080-3a30-960c-b7c4f535bf58",
                                                "text": "Muscles incisifs, muscles de la lèvre supérieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5ba510-f4ff-3462-a66e-6e0116769cbc",
                                        "entry_id": "6ca3bc61-db2d-3bd7-b4bf-86745a7febd7",
                                        "glosses": [
                                            "Qui a quelque chose de tranchant, en parlant de la façon de s’exprimer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913f34ea-d345-448d-8a09-bb65fa6e38de",
                                                "sense_id": "ca5ba510-f4ff-3462-a66e-6e0116769cbc",
                                                "text": "Je tâchai de résumer les discussions par des mots plus ou moins incisifs, profonds ou spirituels."
                                            },
                                            {
                                                "example_id": "53fcf00c-70ac-4776-bd1b-ee7bf3074065",
                                                "sense_id": "ca5ba510-f4ff-3462-a66e-6e0116769cbc",
                                                "text": "« Le mouvement perpétuel est impossible : il faut se tenir loin de ceux qui le trouvent. » Cet aphorisme incisif et précis est de Joseph Bertrand ; il devrait être écrit sur les murs des bureaux de brevets, car il détournerait peut-être certains inventeurs de la poursuite d'une vaine chimère."
                                            },
                                            {
                                                "example_id": "53c3c8e9-bf44-4e8b-b79a-61e9a0f07e04",
                                                "sense_id": "ca5ba510-f4ff-3462-a66e-6e0116769cbc",
                                                "text": "Un orateur incisif."
                                            },
                                            {
                                                "example_id": "88ab53d0-7a33-490a-8e80-c7b7bddabd3e",
                                                "sense_id": "ca5ba510-f4ff-3462-a66e-6e0116769cbc",
                                                "text": "Déjà un des meilleurs parlementaires malgré sa courte expérience au Salon bleu. À la fois incisif et éloquent. Ses prises de position sont étayées d’arguments qui font réfléchir, même lorsqu’on est en désaccord."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incisif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "997e07c8-ad37-3281-ad72-ba68d4db023e",
                                        "entry_id": "34447cae-b5c4-3fda-bdbf-702fc3f5867f",
                                        "glosses": [
                                            "Muscle de la lèvre supérieure."
                                        ],
