                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d1b04e0-84ab-4ae6-9800-07427abfdf7f",
                        "source_entry_id": "ac66ca71-8b9d-37dd-81c0-2211f895d798",
                        "source_sense_description": "животное",
                        "target_lang_word": "mangusta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "33ea869b-db49-4837-92df-cfd81b157ee2",
                        "source_entry_id": "ac66ca71-8b9d-37dd-81c0-2211f895d798",
                        "source_sense_description": "животное",
                        "target_lang_word": "ichneumon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichneumon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                        "entry_id": "374e2971-1b60-3156-bf65-01dd16c7cef9",
                                        "glosses": [
                                            "Mangouste d’Égypte que les Égyptiens révéraient dans l’Antiquité parce qu’elle tue les serpents et les jeunes crocodiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adcd32fe-d8c3-43e2-9b60-34f801975690",
                                                "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                                "text": "L’ichneumon, quand il doit venir aux prises avec le crocodile, munit son corps, l’enduit et le crouste tout à l’entour, de limon bien serré et bien paistry, comme d’une cuirasse."
                                            },
                                            {
                                                "example_id": "c0157527-7331-4799-8e30-1f41af0253c2",
                                                "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                                "text": "Nourrissez les ours, appelez les vautours, sifflez les crocodiles et l’ichneumon sur le rivage !"
                                            },
                                            {
                                                "example_id": "5372f9d7-43c9-4bf5-813e-f166054ecd14",
                                                "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                                "text": "L’ichneumon qui est très-friand des œufs de crocodile, qui les cherche et les dévore."
                                            },
                                            {
                                                "example_id": "bec6072e-918d-44df-8456-f958c943eb68",
                                                "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                                "text": "Le crocodile affreux, dont le Nil cache l’antre,\nEt qui laisse aux roseaux la marque de son ventre,\nA peur de l’ichneumon."
                                            },
                                            {
                                                "example_id": "f4727696-c74b-499e-b842-f5fe68877415",
                                                "sense_id": "25d17e84-82f1-3d41-bcff-09f2776263fd",
                                                "text": "Tanios est venu me voir dans mon bureau pour m’expliquer la situation dramatique dans laquelle se trouvait son village, qu’il a comparé à un ichneumon pris au piège et qui attend la lame du trappeur…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5856103-f1f0-3c2a-9a92-de63d8937f1a",
                                        "entry_id": "374e2971-1b60-3156-bf65-01dd16c7cef9",
                                        "glosses": [
                                            "Insecte hyménoptère pourvu d’un aiguillon comme les abeilles et qui dépose ses œufs dans le corps des chenilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99957aa-4b96-46d1-8b52-fcc4d0f44d87",
                                                "sense_id": "b5856103-f1f0-3c2a-9a92-de63d8937f1a",
                                                "text": "Le plus terrible ennemi de l’araignée, l’ichneumon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
