                        "examples": [
                            {
                                "example_id": "05f9c837-ef49-4646-b443-b427e8ab6fd5",
                                "sense_id": "6a185ac1-7397-36f1-9dc7-a70c565cc5ab",
                                "text": "Jamais la police prussienne en France, jamais les reptiles n’ont été plus occupés […]. A Paris, la commande de surveillance, d’excitation, de fausses nouvelles, est si grosse, que le bataillon de reptiles a été augmenté de moitié, malgré le chiffre irrespectable auquel il était parvenu depuis deux ans."
                            },
                            {
                                "example_id": "6552b61e-cf9a-456c-99c9-d3366a27a2af",
                                "sense_id": "6a185ac1-7397-36f1-9dc7-a70c565cc5ab",
                                "text": "[…] mais se laisser aller paresseusement à la voile pouvant procurer un plaisir, est considéré comme outrageant gravement le Seigneur, par conséquent répréhensible, choquant et irrespectable au plus haut chef."
                            },
                            {
                                "example_id": "53475988-ba9b-4ee5-8ff2-4b0d7d3204d1",
                                "sense_id": "6a185ac1-7397-36f1-9dc7-a70c565cc5ab",
                                "text": "Il y a quelque chose d’indécent à vivre trop frénétiquement, soit par la jeunesse irrespectueuse, soit par la vieillesse irrespectable."
                            }
                        ]
                    }
