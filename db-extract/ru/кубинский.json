                                                "example_id": "f62ac809-f0c7-4cd7-8311-124f4995b0bc",
                                                "sense_id": "b618e782-3a8e-3639-a079-af8b5d5fd4bb",
                                                "text": "„Die Sandinisten mit ihrer Mischung aus Nationalismus, Befreiungstheologie und Marxismus näherten sich zunehmend der kubanischen Position an.“"
                                            },
                                            {
                                                "example_id": "20a20966-bf9d-4a2d-852d-7ea96134d122",
                                                "sense_id": "b618e782-3a8e-3639-a079-af8b5d5fd4bb",
                                                "text": "Und daher war die Tabakwirtschaft immer die kubanischere, ja >havannischere<, da sie von der Hauptstadt der Insel regiert wurde, wohingegen die Zuckerwirtschaft nie von Kubanern, sondern von abwesenden Ausländern gelenkt wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
