                "senses": [
                    {
                        "sense_id": "b821e980-940d-395d-90c5-93d23bf1cdec",
                        "entry_id": "c699d9aa-8fb8-30e0-8af1-791f32b8f99d",
                        "glosses": [
                            "ein in einen Orden oder in eine Kongregation Neueingetretener während der ersten Probezeit, dem sogenannten Postulat vor dem Noviziat"
                        ],
                        "tags": [
                            "Christliche Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "cefa40ad-b510-438c-9b3f-14f6d01f7117",
                                "sense_id": "b821e980-940d-395d-90c5-93d23bf1cdec",
                                "text": "Die Postulanten gingen zur heiligen Messe."
                            },
                            {
                                "example_id": "268da4a4-8745-4f41-9eb3-db240dad34c0",
                                "sense_id": "b821e980-940d-395d-90c5-93d23bf1cdec",
                                "text": "„Dann sah er sich jedoch höchst deprimiert gezwungen, seiner finanziellen Nöte wegen das Studium abzubrechen und als Postulant den Augustiner-Eremiten in Alt-Brünn beizutreten.“"
                            }
                        ],
