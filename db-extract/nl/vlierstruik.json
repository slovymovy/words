                                        "entry_id": "b26d1fde-bd26-3a3a-8a22-4411a2dd63d0",
                                        "glosses": [
                                            "beerentragender Strauch aus der Gattung Sambucus mit gelblich weißen Blüten in schirmförmiger Trugdolde und dunkelgrünen, gefiederten Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3064862-2ce6-4542-99dd-b05ed8f33c3c",
                                                "sense_id": "fca6789d-e320-31c4-ac1d-ccaa38368ecd",
                                                "text": "In Mitteleuropa sind drei Arten von Holunder heimisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88c99f33-e85c-36b7-9031-893b873a6902",
                                        "entry_id": "b26d1fde-bd26-3a3a-8a22-4411a2dd63d0",
                                        "glosses": [
                                            "speziell der Schwarze Holunder (Sambucus nigra)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d298d73-a826-4803-86aa-acdfafbf4d42",
                                                "sense_id": "88c99f33-e85c-36b7-9031-893b873a6902",
                                                "text": "Der Holunder ist in Europa weit verbreitet."
                                            },
                                            {
                                                "example_id": "08866604-9255-4fb3-9208-1ab66ed8dee0",
                                                "sense_id": "88c99f33-e85c-36b7-9031-893b873a6902",
                                                "text": "„Sie war da, wo sie damals war, wo verliebte Leute noch heute sind, bei den Weiden am Rhein, den verschwiegenen Auen zwischen Holunder und Erlengebüsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0a66599-d5ae-3f89-a9d7-aa0ce8e06228",
                                        "entry_id": "b26d1fde-bd26-3a3a-8a22-4411a2dd63d0",
                                        "glosses": [
