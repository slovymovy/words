            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8aa3cbac-e133-3923-9c78-5a0903beb3bf",
                    "sense_definition": "Taper sur un clavier d'ordinateur, un écran de téléphone ou les touches d'un appareil électronique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe des heures à <w>pianoter</w> sur son téléphone portable au lieu de travailler."
                        },
                        {
                            "text": "Assise devant son écran, elle <w>pianote</w> sur le clavier pour répondre rapidement à ses courriels."
                        }
                    ],
                    "synonyms": [
                        "pitonner"
                    ],
                    "common_phrases": [
                        "pianoter sur son portable",
                        "pianoter sur un clavier"
                    ]
                },
                {
                    "sense_id": "feae9d82-2288-34ee-9aaf-ec26fee5fc67",
                    "sense_definition": "Tapoter nerveusement ou distraitement avec le bout des doigts sur une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Impatient d'obtenir une réponse, il <w>pianotait</w> sur la table avec nervosité."
                        },
                        {
                            "text": "Elle écoutait la conférence en <w>pianotant</w> doucement des doigts sur son carnet."
                        }
                    ],
                    "common_phrases": [
                        "pianoter sur la table",
                        "pianoter des doigts"
                    ]
                },
                {
                    "sense_id": "cb94b445-6dcd-332f-8717-6b73a5c8e9c1",
                    "sense_definition": "Jouer du piano de manière dilettante, sans application ou maladroitement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant que nous discutions, il <w>pianotait</w> distraitement un vieil air sur l'instrument du salon."
                        },
                        {
                            "text": "Elle ne sait pas vraiment jouer de la musique, mais elle aime <w>pianoter</w> de temps en temps."
                        }
                    ],
                    "common_phrases": [
                        "pianoter un air"
                    ]
                }
            ]
        }
    ]
