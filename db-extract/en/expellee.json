                    {
                        "translation_id": "482dcc17-9f72-4c45-b320-07434416b122",
                        "source_entry_id": "b64664d5-dd39-3848-96eb-7185067a428b",
                        "source_sense_id": "72eb8beb-ffcc-3e3a-88a8-042bfab83c98",
