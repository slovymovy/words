{
    "word_family": [
        "merriment",
        "merrily",
        "merriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                    "sense_definition": "Cheerful, jolly, and full of high spirits.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We wish you a <w>merry</w> Christmas and a happy new year.",
                            "target_lang_translations": {
                                "ru": "Мы желаем вам <w>счастливого</w> Рождества и счастливого Нового года."
                            }
                        },
                        {
                            "text": "The children were in a <w>merry</w> mood after receiving their gifts.",
                            "target_lang_translations": {
                                "ru": "Дети были в <w>весёлом</w> настроении после того, как получили подарки."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "happy",
                        "jovial",
                        "joyful"
                    ],
                    "antonyms": [
                        "miserable",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "merry Christmas",
                        "merry mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнерадостный, весёлый и в приподнятом настроении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "настроенный радостно"
                            },
                            {
                                "target_lang_word": "радостный",
                                "target_lang_sense_clarification": "полный радости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddb35f58-d9dc-33fc-86f1-a79211c8d0f7",
                    "sense_definition": "Festive and characterized by fun, laughter, and social enjoyment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "festivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village held a <w>merry</w> feast to celebrate the end of the harvest.",
                            "target_lang_translations": {
                                "ru": "В деревне устроила <w>весёлый</w> пир, чтобы отпраздновать окончание сбора урожая."
                            }
                        },
                        {
                            "text": "Everyone was <w>merry</w> at the party, dancing and singing until late at night.",
                            "target_lang_translations": {
                                "ru": "На вечеринке все были <w>веселы</w>, танцуя и напевая до поздней ночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "convivial",
                        "jovial"
                    ],
                    "common_phrases": [
                        "merry feast",
                        "make merry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздничный, характеризующийся весельем, смехом и социальным общением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "о празднике или компании"
