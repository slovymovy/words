                    {
                        "sense_id": "c4c9a8ca-1e1b-3993-bd15-a08eb46e5c4c",
                        "entry_id": "6937abf3-9a79-3450-bb72-f5d07a93d2d5",
                        "glosses": [
                            "Lehre und Wissenschaft von Verfahren, Probleme zu lösen; methodische Anleitung, Anweisung zur Gewinnung neuer Erkenntnisse"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "cc9089e4-e4b7-4153-b8ae-5a04bac596d2",
                                "sense_id": "c4c9a8ca-1e1b-3993-bd15-a08eb46e5c4c",
                                "text": "Günther bereitete das Referat für den Schein in Heuristik vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df4148de-0b69-35f3-809c-505118b081e8",
                        "entry_id": "6937abf3-9a79-3450-bb72-f5d07a93d2d5",
                        "glosses": [
                            "ein aus der Heuristik [1] gewonnenes Verfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05492267-75ed-4fce-b980-f6d9194b5737",
                                "sense_id": "df4148de-0b69-35f3-809c-505118b081e8",
                                "text": "„Problemspezifische Heuristiken nutzen spezielle Eigenschaften der Problemstruktur und sind deshalb bei Änderungen der Problemstellung oft nicht mehr einsetzbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b8b498f5-0934-3906-9d3d-0e2e91ecf7d7",
                        "entry_id": "6937abf3-9a79-3450-bb72-f5d07a93d2d5",
                        "glosses": [
                            "unsicheres, inexaktes oder nicht für alle Eingabewerte funktionierendes Verfahren zur Lösung eines Problems, oft als Ersatz eines Algorithmus, der zwar theoretisch eine genauere oder sogar beste Lösung liefert, aber dazu zu viel Zeit oder zu großen anderweitigen Aufwand erfordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de8229c6-a8e5-447b-b05a-028ac02652d1",
                                "sense_id": "b8b498f5-0934-3906-9d3d-0e2e91ecf7d7",
                                "text": "Heuristik führt nicht zum besten Ergebnis, aber in der Regel zu einem guten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
