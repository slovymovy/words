                        "entry_id": "2f332d74-1720-3026-8f45-d6209c2a1cd1",
                        "glosses": [
                            "The charging of the cost of business resources to the departments that use them."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b6f93f6-7e54-4585-97a6-eb40f26c8cfb",
                                "sense_id": "2ab16ab2-5483-3033-95a7-8b2757a24cf4",
                                "text": "An effective way to build accountability is to charge back workers' compensation costs to each department. Usually the costs are sufficiently high to provide incentive and the chargeback places these costs into the regular system of accountability."
                            }
                        ]
                    }
                ],
