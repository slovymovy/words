                                "target_lang_word": "拼凑",
                                "target_lang_sense_clarification": "粗劣地凑合在一起"
                            },
                            {
                                "target_lang_word": "胡乱拼凑",
                                "target_lang_sense_clarification": "拙劣地组合"
                            }
                        ]
                    }
                },
