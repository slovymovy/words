                    },
                    {
                        "translation_id": "81b9088e-d5ef-42b0-81fd-3e4d55549c09",
                        "source_entry_id": "6233f29f-7f8a-322a-94f0-c179d3ddafe9",
                        "source_sense_id": "2ad8021e-20a8-3170-9175-621ebad80398",
                        "source_sense_description": "ein Ort der, ein Ereignis, das Interesse erweckt, hervorruft, eine Attraktion",
                        "target_lang_word": "attraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0fc83a-292a-3a97-b298-b9ecc69ec076",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The tendency to attract."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdc504c1-3d8a-48c9-b97f-2d1bbf272678",
                                                "sense_id": "2f0fc83a-292a-3a97-b298-b9ecc69ec076",
                                                "text": "The Moon is held in its orbit by the attraction of the Earth's gravity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The feeling of being attracted (to something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588b7682-6480-43a2-adbf-da74afb2d9da",
                                                "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                                "text": "I felt a strange attraction towards the place."
                                            },
                                            {
                                                "example_id": "a1051571-6d38-40b7-a821-f180473663a4",
                                                "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The feeling of being attracted (to something).",
                                            "Sexual or romantic desire (especially for a specified individual, kind of person, etc)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24007ca8-7d4d-441a-86b1-9ec7d3f215e3",
                                                "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                                "text": "Murphy struggled with his attraction to men while remaining happily married all his life, daily negotiating the challenges of living in two locations simultaneously. These doublings of desire and emotional attachment left their trace in the multiple doublings within […] the billboard painting he made to signpost the home he created with his wife Sara […]"
                                            },
                                            {
                                                "example_id": "d3efdcbc-3366-4f89-b4d3-712270a72d87",
                                                "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                                "text": "\"I'm asexual,\" Yazhiisai said, the words spilling out faster than she intended. \"I don't experience attraction the way most people do. I'm telling you this because I don't want there to be any surprises.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "An event, location, or business that has a tendency to draw interest from visitors, and in many cases, local residents."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6df023-eabe-4a38-a40b-3d78e5f92c6f",
                                                "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                                "text": "The new mall should be a major attraction."
                                            },
                                            {
                                                "example_id": "27fde16d-a88c-439d-8e21-eeced8e7242c",
                                                "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                                "text": "Star Tours is a very cool Disney World attraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e4d7aac-c396-3fdc-a5ed-28be48bad1a2",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The sacrifice of pieces in order to expose the enemy king."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4d41a67-eaca-37f8-b7ef-6bd836688085",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
