                        "glosses": [
                            "für sie, ihr/ihnen zuliebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36ae417-5563-4c01-adc7-790c7cb8484d",
                                "sense_id": "814aeac0-9eb5-365e-bbdb-44f1edd7c58c",
                                "text": "Wir haben uns ihretwegen viel Mühe gegeben."
                            }
                        ],
                        "sense_index_json": "\"2\""
