                        ],
                        "form": "die Geschichtsbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4eaaf48-3d99-3d29-b6e6-995df716d267",
                        "entry_id": "a6b45a3d-99c9-3ac9-ba01-18175839e8f9",
                        "glosses": [
                            "Buch über vergangene Ereignisse und Entwicklungen, das vor allem als Lehrwerk in Schulen eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18aec985-c4b0-4522-a219-05c58e460fe4",
                                "sense_id": "d4eaaf48-3d99-3d29-b6e6-995df716d267",
                                "text": "„Gesteine sind das Geschichtsbuch der Erde: Ihre Mineralien geben Auskunft, unter welchen äußeren Bedingungen sie entstanden waren, ihre Isotopenverteilung verrät das Alter, und eingeschlossene Fossilien gewähren Einblicke in vergangene Ökosysteme.“"
                            },
                            {
                                "example_id": "d8d38ebd-2de7-48fb-95ed-d6d94e43b46c",
                                "sense_id": "d4eaaf48-3d99-3d29-b6e6-995df716d267",
                                "text": "„An dem Treffen bei Ostrowa, von dem die Geschichtsbücher später schrieben, es sei das erste nennenswerte Blutvergießen des russischen Feldzuges gewesen, nahm Martins Batterie teil.“"
                            },
                            {
                                "example_id": "a958ea52-616c-4833-85ca-c694640a13a4",
                                "sense_id": "d4eaaf48-3d99-3d29-b6e6-995df716d267",
                                "text": "„So heisst es in den Geschichtsbüchern.“"
                            },
                            {
                                "example_id": "1ca1df7f-39e1-4a01-9bcf-3dc6560c0064",
                                "sense_id": "d4eaaf48-3d99-3d29-b6e6-995df716d267",
                                "text": "„In der Region, in der die Hisatsinom siedelten, begann um 1130 eine rund 300 Jahre lang andauernde Trockenperiode, die als Große Dürre in die Geschichtsbücher einging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
