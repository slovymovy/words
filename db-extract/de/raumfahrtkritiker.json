                "senses": [
                    {
                        "sense_id": "e16ed752-1808-3a01-85e3-e51ebb8702b6",
                        "entry_id": "c8bfff59-548f-3ffc-8ee6-a99bd55c67d3",
                        "glosses": [
                            "Person, die bestimmte oder alle Handlungen zur Erforschung des Weltalls (wie Flüge im Weltraum) negativ sieht/kritisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a4a476-7c80-4bc7-bdf4-0f8ef4a08b7e",
                                "sense_id": "e16ed752-1808-3a01-85e3-e51ebb8702b6",
                                "text": "„Mit diesen und ähnlichen Worten warnen Raumfahrtkritiker vor der Reise zum roten Nachbarplaneten.“"
                            },
                            {
                                "example_id": "f2afba16-6ce5-4585-80af-f259188dccbe",
                                "sense_id": "e16ed752-1808-3a01-85e3-e51ebb8702b6",
                                "text": "„Jeder detaillierte Fahrplan hat ein Preisschild. Und eine zu teure Vision kann in politischen Debatten schnell unter die Räder geraten. Das musste die Nasa lernen, als George Bush senior 1989 ankündigte, Menschen bis 2018 auf den Mars zu bringen. Das sollte bis zu 540 Milliarden Dollar kosten und war ein gefundenes Fressen für Raumfahrtkritiker.“"
                            },
                            {
                                "example_id": "30242c68-d503-41ee-9709-7d31b8a31009",
                                "sense_id": "e16ed752-1808-3a01-85e3-e51ebb8702b6",
                                "text": "„Beim Steuerzahler und bei Raumfahrtkritikern wirbt die NASA damit,dass die Kosten für das neue Teleskop nur halb so hoch sind wie alleAusgaben, die inzwischen für ‚Hubble‘ aufgelaufen sind.“"
                            },
                            {
                                "example_id": "70e83ff7-1b33-453e-a7f1-2cfe21002f48",
                                "sense_id": "e16ed752-1808-3a01-85e3-e51ebb8702b6",
                                "text": "„Unterstützung bekommt die Nasa von Raumfahrtkritikern allein dafür, dass sie bei der Erforschung des Mars auf Roboter setzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
