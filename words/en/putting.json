{
    "word_family": [
        "put",
        "putt",
        "putter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d119be37-a815-3d9b-8966-2ff6c40079ee",
                    "sense_definition": "The present participle and gerund of <w>put</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>putting</w> the books back on the shelf.",
                            "target_lang_translations": {
                                "ru": "Она <w>кладет</w> книги обратно на полку."
                            }
                        },
                        {
                            "text": "He is <w>putting</w> a lot of effort into his new project.",
                            "target_lang_translations": {
                                "ru": "Он <w>вкладывает</w> много усилий в свой новый проект."
                            }
                        }
                    ],
                    "common_phrases": [
                        "putting away",
                        "putting on"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола «класть», «ставить» или «помещать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кладущий",
                                "target_lang_sense_clarification": "причастие от глагола класть"
                            },
                            {
                                "target_lang_word": "помещение",
                                "target_lang_sense_clarification": "процесс размещения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5083c9e9-52c3-3f9d-86c7-5b9e75991f72",
                    "sense_definition": "The present participle and gerund of <w>putt</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>putting</w> the ball toward the hole on the green.",
                            "target_lang_translations": {
                                "ru": "Он <w>выполняет пат</w> в сторону лунки на грине."
                            }
                        },
                        {
                            "text": "The golfer is <w>putting</w> very well today.",
                            "target_lang_translations": {
                                "ru": "Гольфист сегодня очень хорошо <w>паттует</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола «паттовать» (в гольфе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паттование",
                                "target_lang_sense_clarification": "процесс выполнения удара пат в гольфе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0db29bfc-5327-38ae-80b6-03449389b66d",
                    "sense_definition": "The act or result of placing or setting something somewhere.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The careful <w>putting</w> of the vase on the table prevented it from breaking.",
                            "target_lang_translations": {
                                "ru": "Осторожное <w>размещение</w> вазы на столе предотвратило её падение."
                            }
                        },
                        {
                            "text": "His <w>putting</w> of the documents into the wrong folder caused a delay.",
                            "target_lang_translations": {
                                "ru": "То, что он <w>положил</w> документы не в ту папку, вызвало задержку."
                            }
                        }
                    ],
                    "synonyms": [
                        "placement",
                        "positioning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или результат размещения или установки чего-либо в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещение",
                                "target_lang_sense_clarification": "процесс расположения предметов"
                            },
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "действие по приведению в определенное положение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70bf479-ff25-39b9-8e9c-77e533a1ab39",
                    "sense_definition": "The act of inciting or encouraging someone to do something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>putting</w> of fear into the hearts of the citizens was a cruel tactic.",
                            "target_lang_translations": {
                                "ru": "<w>Внушение</w> страха в сердца граждан было жестокой тактикой."
                            }
                        },
                        {
                            "text": "His <w>putting</w> of ideas into their minds led to the rebellion.",
                            "target_lang_translations": {
                                "ru": "То, что он <w>внушил</w> им эти идеи, привело к восстанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "instigation",
                        "incitement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подстрекательства или побуждения кого-либо к действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внушение",
                                "target_lang_sense_clarification": "процесс внедрения идей или чувств"
                            },
                            {
                                "target_lang_word": "подстрекательство",
                                "target_lang_sense_clarification": "побуждение к совершению чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b60b3a72-784c-3af2-b32e-23550323b34b",
                    "sense_definition": "The act of hitting a golf ball gently on the green.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "golf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>putting</w> improved significantly after he practiced for hours.",
                            "target_lang_translations": {
                                "ru": "Его техника <w>паттинга</w> значительно улучшилась после многочасовых тренировок."
                            }
                        },
                        {
                            "text": "The professional golfer is known for his excellent <w>putting</w> technique.",
                            "target_lang_translations": {
                                "ru": "Профессиональный гольфист известен своей превосходной техникой <w>паттинга</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника выполнения легкого удара по мячу для гольфа на грине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паттинг",
                                "target_lang_sense_clarification": "техника удара в гольфе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00183085-e6d7-3c2a-8f1f-8a986662e078",
                    "sense_definition": "A variation of golf focused on short-distance shots into holes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "golf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the afternoon playing <w>putting</w> at the local course.",
                            "target_lang_translations": {
                                "ru": "Они провели день, играя в <w>паттинг</w> на местном поле."
                            }
                        },
                        {
                            "text": "The <w>putting</w> green was perfectly manicured for the tournament.",
                            "target_lang_translations": {
                                "ru": "Грин для <w>паттинга</w> был идеально подстрижен к турниру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "putting green"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность гольфа, сфокусированная на коротких ударах в лунку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паттинг",
                                "target_lang_sense_clarification": "игра или тренировка коротких ударов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}