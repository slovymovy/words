                ],
                "senses": [
                    {
                        "sense_id": "cdf0aedc-7917-3e88-8d04-e74fde737e6b",
                        "entry_id": "8041f2ad-928b-3fac-bd95-dd57cdcd08af",
                        "glosses": [
                            "Défaire de ce qui englue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fe3bf4-1f0b-4bf7-921f-d9833500f045",
                                "sense_id": "cdf0aedc-7917-3e88-8d04-e74fde737e6b",
                                "text": "Quand cet accident arrive à un couteau, on l’essuie sur le bord du récipient aux déchets ; mais comment désengluer un hérisson ?"
                            },
                            {
                                "example_id": "bbae14e2-f8f7-45a4-afd1-87508aad7df8",
                                "sense_id": "cdf0aedc-7917-3e88-8d04-e74fde737e6b",
                                "text": "Pas de piscine aujourd'hui pour me désengluer de la nuit, de ses images ténébreuses."
                            },
                            {
                                "example_id": "c71d8edd-74b5-43d3-92cc-e221ae29a50c",
                                "sense_id": "cdf0aedc-7917-3e88-8d04-e74fde737e6b",
                                "text": "Sa souplesse le sauve et le tire de l'ornière d'où plus d'un élève de Massenet n'a pu se désengluer."
                            }
                        ]
                    }
                ],
