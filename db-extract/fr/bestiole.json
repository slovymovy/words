        "fr-extract.jsonl": [
            {
                "entry_id": "a4a8ec2e-1a1d-3ea8-8fec-d4c1390fda55",
                "word": "bestiole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ac21314-57b4-45cc-b60f-5cf47c8a9ddd",
                        "entry_id": "a4a8ec2e-1a1d-3ea8-8fec-d4c1390fda55",
                        "tags": [
                            "plural"
                        ],
                        "form": "bestioles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f95b7753-6e10-35de-8911-af0d5e4b62fe",
                        "entry_id": "a4a8ec2e-1a1d-3ea8-8fec-d4c1390fda55",
                        "glosses": [
                            "Petit animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "708f9137-f52d-4e00-9762-ff6a6a66c7dc",
                                "sense_id": "f95b7753-6e10-35de-8911-af0d5e4b62fe",
                                "text": "Soudain la vagabonde bestiole s’envolait, abandonnant dans mon giron, — ô horreur! — une larve monstrueuse et difforme à tête humaine!"
                            },
                            {
                                "example_id": "a5c74fc9-af22-47ed-a487-5bc28463f037",
                                "sense_id": "f95b7753-6e10-35de-8911-af0d5e4b62fe",
                                "text": "Je suis ainsi que la bestiole, sur laquelle s’est jeté le putois ; j’ai beau me rouler sur le sol, me débattre désespérément pour échapper à ses crocs, le putois me tient, et il ne me lâche pas…"
                            },
                            {
                                "example_id": "4d81b200-c00a-4a2e-a516-818f8ecfd94e",
                                "sense_id": "f95b7753-6e10-35de-8911-af0d5e4b62fe",
                                "text": "Bien qu’il s’attaque de préférence à d’assez grosses bestioles, le crapaud ne dédaigne pas, à l’occasion, de mobiliser sa langue pour engluer quelques pucerons."
                            },
                            {
                                "example_id": "f1da470f-e332-4703-9d00-5b1972faf903",
                                "sense_id": "f95b7753-6e10-35de-8911-af0d5e4b62fe",
                                "text": "Soudain, le chat, Guillaume, surgissant de nulle part, qui bondit sur la table, qui vient lécher le sang du lapin. Combien de fois il lui a interdit, à cette satanée bestiole, de venir fourrer son sale museau dans la nourriture ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6a2ba95-9bec-35e9-af32-7659624c545a",
                        "entry_id": "a4a8ec2e-1a1d-3ea8-8fec-d4c1390fda55",
                        "glosses": [
                            "Jeune fille sans esprit."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "ironic",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75c00617-9945-4cd9-884e-00f74ced9b5d",
                        "source_entry_id": "a4a8ec2e-1a1d-3ea8-8fec-d4c1390fda55",
                        "source_sense_description": "Petit animal",
                        "target_lang_word": "Tierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                        "entry_id": "01f3126e-e6e5-3e76-a7ab-d67388a9d0fa",
                                        "glosses": [
                                            "kleines Tier, junges Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3dabbeb-e7bd-4732-a673-90503692a613",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "Die Kinder pflegten das verletzte Tierchen wieder gesund."
                                            },
                                            {
                                                "example_id": "a957090e-d927-4e8b-85d6-7f5b3509d130",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Der Wirt schmeckt an seiner Plombe, man muß den Stieglitz mehr ans Fenster rücken, solch Tierchen will auch ein bißchen Licht.“"
                                            },
                                            {
                                                "example_id": "f851dd53-5b4a-4d50-9cb0-7c0f31183260",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Uns, als künftigen Weltraumpassagieren, drängt sich die Frage auf, was die Tierchen unter diesen ungewöhnlichen Umständen bewogen haben mag, sich so kühn zu vermehren.“"
                                            },
                                            {
                                                "example_id": "76c336d2-381d-4ae8-bcaa-10de9ce89218",
                                                "sense_id": "fca83fa2-324b-3744-8edd-71e1b0c0ac2e",
                                                "text": "„Im Schrank roch es seltsam, und sie war sicher, dass allerlei Tierchen herumkrabbelten, aber dort konnte ihr niemand etwas anhaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
