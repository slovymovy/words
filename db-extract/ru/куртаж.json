                                                "example_id": "f5046f6d-4655-4f5e-aed5-115194fd545e",
                                                "sense_id": "df7597b7-8902-3cf6-a8ac-c62fcede55f7",
                                                "text": "Deux pour cent de commission, un quart pour cent de courtage."
                                            },
                                            {
                                                "example_id": "f47472f9-a376-40b1-b433-c21f60540a32",
                                                "sense_id": "df7597b7-8902-3cf6-a8ac-c62fcede55f7",
                                                "text": "Il a d'autres sources de revenu. Ses courtages, d'abord."
                                            }
