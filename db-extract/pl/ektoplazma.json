                                "target_senses": [
                                    {
                                        "sense_id": "eb72b838-92bd-3ae9-a81b-fc68c937a004",
                                        "entry_id": "d90863bb-9360-3770-a316-091e1af87cea",
                                        "glosses": [
                                            "Teil des Zytoplasma zwischen der Zellmembram und dem -kern; äußere Schicht des Protoplasmas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2dc5f70-2a35-4450-b637-ff0ff3c3b4dc",
                                                "sense_id": "eb72b838-92bd-3ae9-a81b-fc68c937a004",
                                                "text": "Das Endo- und Ektoplasma lassen sich in ihrer Konsistenz voneinander unterscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80ba9b7b-d6de-36ef-8af5-190efcb86047",
                                        "entry_id": "d90863bb-9360-3770-a316-091e1af87cea",
                                        "glosses": [
                                            "Bezeichnung eines paranormalen Stoffes, der überwiegend gasförmig ist und angeblich aus den Körperöffnungen eines Mediums¹⁰ oder Sensitiven¹ austritt"
                                        ],
                                        "tags": [
                                            "Parapsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6330e3db-ce56-4cf8-95c4-b64ea7fa2968",
                                                "sense_id": "80ba9b7b-d6de-36ef-8af5-190efcb86047",
                                                "text": "Der Begriff Ektoplasma wird häufig mit spiritueller Chirurgie in Verbindung gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
