        "fr-extract.jsonl": [
            {
                "entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                "word": "vélocité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84648baa-d552-4cbe-b321-eca643006641",
                        "entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "tags": [
                            "plural"
                        ],
                        "form": "vélocités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dec0ba67-310b-3917-aa51-c61a149dfda7",
                        "entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "glosses": [
                            "Vitesse, rapidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa92be51-90ed-4db0-b194-c9d149dd08c1",
                                "sense_id": "dec0ba67-310b-3917-aa51-c61a149dfda7",
                                "text": "Cette chute dont le retentissement arriva jusqu’à Maurice, loin de l’arrêter, parut donner, une nouvelle impulsion à la vélocité de sa course, …."
                            },
                            {
                                "example_id": "d3e84c1f-e109-4719-8204-6676d273c831",
                                "sense_id": "dec0ba67-310b-3917-aa51-c61a149dfda7",
                                "text": "Elles regrettaient ces liaisons de diligence qu’amène presque forcément un contact immédiat, prolongé pendant trois ou quatre jours, et qu’arrêtera sans doute la vélocité magique des locomotives."
                            },
                            {
                                "example_id": "1f5b30f9-3940-4a0a-9b28-dcae1141294e",
                                "sense_id": "dec0ba67-310b-3917-aa51-c61a149dfda7",
                                "text": "La Tête-d’Aigle […] commença à ramper avec une adresse et une vélocité extrêmes dans la direction du village."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7f2bbe3-e412-32fc-a55b-9954d7a77d20",
                        "entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "glosses": [
                            "Vecteur vitesse, vecteur représentant la vitesse et la direction d’un mouvement, par opposition à la vitesse, qui ne comprend pas la direction."
                        ],
                        "tags": [
                            "Anglicism",
                            "physical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c4a2dbb-e845-4fa1-b4a0-057e8c7798e4",
                        "source_entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "target_lang_word": "Schnelligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnelligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9c918e-123d-3f5f-bf30-0df7c31e3079",
                                        "entry_id": "b2785364-9a47-309d-bea6-df9cc13b8303",
                                        "glosses": [
                                            "Fähigkeit, Entfernungen schnell zurückzulegen oder Dinge schnell zu bewältigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241d416a-0064-4e12-bf19-5ff1ca72de3c",
                                                "sense_id": "ab9c918e-123d-3f5f-bf30-0df7c31e3079",
                                                "text": "Trotz erhöhter Schnelligkeit macht er nicht schlapp."
                                            },
                                            {
                                                "example_id": "a6ec925e-3d04-408e-9d66-323712fac471",
                                                "sense_id": "ab9c918e-123d-3f5f-bf30-0df7c31e3079",
                                                "text": "Die Aufgaben wurden mit beeindruckender Schnelligkeit gemeistert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bca9ba6e-67cf-4b38-9f6f-194dce424d61",
                        "source_entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "target_lang_word": "Geschwindigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwindigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca81155-88ca-3bfb-9a46-2fe32980e4e3",
                                        "entry_id": "67423383-9ad5-3868-9ee8-4090f4553580",
                                        "glosses": [
                                            "Verhältnis von zurückgelegter Strecke zur dafür benötigten Zeit (Geschwindigkeit = Strecke/Zeit)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a5d1d81-2e9b-4ecb-8b77-9aa25aa2ccbe",
                                                "sense_id": "fca81155-88ca-3bfb-9a46-2fe32980e4e3",
                                                "text": "Meine Geschwindigkeit beträgt 8 km/h."
                                            },
                                            {
                                                "example_id": "d85b1e9c-44d4-49c3-bbf0-5cc64d17be1b",
                                                "sense_id": "fca81155-88ca-3bfb-9a46-2fe32980e4e3",
                                                "text": "„Mit einer Geschwindigkeit von rund 13 Kilometern in der Stunde gehe es nicht um Spitzensport, so der Veranstalter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                        "entry_id": "67423383-9ad5-3868-9ee8-4090f4553580",
                                        "glosses": [
                                            "Schnelligkeit, Tempo"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0320c79-36ca-4100-a664-b222e2cca988",
                                                "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                                "text": "Aber 180 km/h auf der Autobahn ist doch keine Geschwindigkeit!"
                                            },
                                            {
                                                "example_id": "245955c0-9ae4-4518-82de-fe6b1df2199d",
                                                "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                                "text": "„Wer wandert, wer sich auf ein Fahrrad setzt und in einer gemütlichen Geschwindigkeit fährt, der reist entschleunigt.“"
                                            },
                                            {
                                                "example_id": "c9ac2ec9-47a3-4dd0-9dd1-266b56b050dd",
                                                "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                                "text": "„Er drosselte die Geschwindigkeit ein wenig und fuhr neugierig auf die Stelle zu.“"
                                            },
                                            {
                                                "example_id": "8a1a5f67-8532-4fd1-a867-649a29faacb1",
                                                "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                                "text": "„Höhere Geschwindigkeiten zwingen den Blick nur auf die eintönige Fahrbahn, und ein Aufprall auf den Vordermann ist bei sechzig Stundenkilometern ja kein Beinbruch.“"
                                            },
                                            {
                                                "example_id": "3d2f9430-ebd5-4062-b526-1b5e3c5ec341",
                                                "sense_id": "bb39acd0-ca74-38ab-877c-4f46a6098a55",
                                                "text": "„Hierzu verwenden sie ein Gerät namens Tachistoskop, das einzelne Wörter in hoher Geschwindigkeit auf einem Bildschirm aufblitzen lässt, ohne Verweilen, ohne Wiederholung, sondern stetig auf der Stelle laufend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ef2b3a5-61b4-4b7a-8b90-d1cc90bde603",
                        "source_entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "target_lang_word": "Geläufigkeit (Musik)",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6c2cf204-df46-4b8a-89ae-1b922529986a",
                        "source_entry_id": "ba2ed8ec-5b05-303c-8e1e-3cb54f652771",
                        "target_lang_word": "velocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "velocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                        "entry_id": "ab80acfd-46b1-3d43-b54d-2aaba905566b",
                                        "glosses": [
                                            "A vector quantity that denotes the rate of change of position with respect to time, combining speed with a directional component."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dde5831-7476-4610-8998-fbec5a106615",
                                                "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                                "text": "A car racing in a circle may retain the same speed while continually changing its velocity."
                                            },
                                            {
                                                "example_id": "77d7712c-f50e-4120-bd9c-822fcca7b26a",
                                                "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                                "text": "Usually, however, confluence is associated with an increase in air velocity and diffluence with a decrease. In the intermediate case, confluence is balanced by an increase in wind velocity and diffluence by a decrease in velocity."
                                            },
                                            {
                                                "example_id": "a4192610-221f-409a-8b0e-709d64bbb79b",
                                                "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                                "text": "Such angular distances imply undecelerated ejecta knot transverse velocities of 15,600 and 12,700 km/s respectively, assuming an explosion date ~1670 AD and a distance of 3.4 kpc."
                                            },
                                            {
                                                "example_id": "42a7f852-35bb-4dd5-9793-479cacb03f89",
                                                "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                                "text": "When an ultrasonic beam is fired at the microcannons, the emulsion evaporates, expanding rapidly into gas. This creates enough force to push the nanobullets out at velocities reaching several metres per second."
                                            },
                                            {
                                                "example_id": "1e69327c-8e6c-4c5a-8222-711018500eab",
                                                "sense_id": "c94bb6b9-707d-33a8-8eb6-ea2c5827f61f",
                                                "text": "By combining the data from multiple telescopes, astronomers determined the star’s position and velocity in space, allowing them to predict that it will exit the Milky Way at some point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08b741d-10d9-3333-a9f1-f34926124a5a",
                                        "entry_id": "ab80acfd-46b1-3d43-b54d-2aaba905566b",
                                        "glosses": [
                                            "Rapidity of motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2bdc31-faf7-4102-829a-53df53642401",
                                                "sense_id": "d08b741d-10d9-3333-a9f1-f34926124a5a",
                                                "text": "The train was travelling at a slower velocity than usual."
                                            },
                                            {
                                                "example_id": "e1d664c7-046e-42bf-8c0b-c31fcd743a59",
                                                "sense_id": "d08b741d-10d9-3333-a9f1-f34926124a5a",
                                                "text": "Over the winter-solid Roads, goes a great seething,— of mounted younger Gentlemen riding together by the dozens upon rented horses, Express Messengers in love with pure Velocity, Disgruntl'd Suitors with Pistols stuff'd in their Spatterdashes, seal'd Waggons not even a western Black-Boy would think of detaining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b4c4439-e0c1-34c3-ad0e-9073d6e4224a",
                                        "entry_id": "ab80acfd-46b1-3d43-b54d-2aaba905566b",
                                        "glosses": [
                                            "The rate of occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "638a9873-7925-3bea-b1a2-b39fec82aa2d",
                                        "entry_id": "ab80acfd-46b1-3d43-b54d-2aaba905566b",
                                        "glosses": [
                                            "The number of times that an average unit of currency is spent during a specific period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e54dc96-4d64-3835-a1e6-dd4177d6027f",
                                        "entry_id": "ab80acfd-46b1-3d43-b54d-2aaba905566b",
                                        "glosses": [
                                            "The value corresponding to how hard a key is struck on a MIDI controller or keyboard."
                                        ],
