                        "glosses": [
                            "Romantiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd14c556-f80e-42bf-8f50-1f6d48964bc6",
                                "sense_id": "6436f105-3e89-3212-8585-34e346535c1c",
                                "text": "Ce qu'il faut, c'est reromantiser son mariage."
                            },
                            {
                                "example_id": "bb958af2-ea0d-4989-9d69-e77393a455dd",
                                "sense_id": "6436f105-3e89-3212-8585-34e346535c1c",
                                "text": "Une fois que le couple a créé cette capacité de découvrir l’autre, on l’encourage à se «reromantiser», à créer consciemment ce qui s’est créé inconsciemment au début de son histoire."
                            }
                        ]
