                        "form_id": "cd988e16-6f83-46d8-8330-8c69990063b5",
                        "entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Laizismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d21fda4a-394b-356e-ab99-cafd05799c64",
                        "entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "glosses": [
                            "Weltanschauung oder Haltung, die fordert, Kirche und Staat voneinander zu trennen und die jeden kirchlichen Einfluss auf staatliche Belange ablehnt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a254fe8e-f33e-49c8-955a-1058bb45dd9e",
                        "source_entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "source_sense_id": "d21fda4a-394b-356e-ab99-cafd05799c64",
                        "target_lang_word": "laicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c28a6c1a-b527-30b0-9c37-5ee10fc563b3",
                                        "entry_id": "aaa0a473-91ad-396d-b49b-e2a3847f6ece",
                                        "glosses": [
                                            "Secularism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e477f687-0fe9-4384-809f-ffd2b1b8fccc",
                                                "sense_id": "c28a6c1a-b527-30b0-9c37-5ee10fc563b3",
                                                "text": "In a speech in commemoration of the 67th anniversary of the insertion of the principle of laicism into the Turkish constitution, he gave the following ideal typical Kemalist account of laicism: National sovereignty is grounded in the foundation of laicism."
                                            },
                                            {
                                                "example_id": "d8f5ba90-9e43-486b-adee-f5a48a10d9e3",
                                                "sense_id": "c28a6c1a-b527-30b0-9c37-5ee10fc563b3",
                                                "text": "As a matter of fact the Enlightment culture was based on a philosophy inspired to an ethical laicism whose aim was to create a better society based on principles such as solidarity, equality of rights and duties, and full freedom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "565364f9-46f3-42df-ad21-bf0671e499f3",
                        "source_entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "source_sense_id": "d21fda4a-394b-356e-ab99-cafd05799c64",
                        "target_lang_word": "laïcisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laïcisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2241d56-c9e0-3120-926c-c8aaadf659fe",
                                        "entry_id": "1673902d-c0d7-37d9-b5b7-e513c4c646f2",
                                        "glosses": [
                                            "Position qui tend à donner aux institutions un caractère non religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a7f8b7-c6b9-4fe8-ba50-4e7bf9de83c5",
                                                "sense_id": "f2241d56-c9e0-3120-926c-c8aaadf659fe",
                                                "text": "Ce que l’école primaire de la troisième République et le laïcisme intégral ont pu créer de valable se trouve en toute sa force représenté dans l’Yonne mieux qu’en aucune autre région."
                                            },
                                            {
                                                "example_id": "29625dca-2f27-4886-bfd6-e550ccc5c47f",
                                                "sense_id": "f2241d56-c9e0-3120-926c-c8aaadf659fe",
                                                "text": "C’était plus qu’il n’en fallait pour inquiéter les partisans des régimes d’autorité […] Pour enrayer les progrès du laïcisme et des mouvements revendicatifs, ceux-ci mirent tout en action, essayant jusqu’à des coups d’État."
                                            },
                                            {
                                                "example_id": "64c3d939-e21e-462f-894c-5f000a9b19d2",
                                                "sense_id": "f2241d56-c9e0-3120-926c-c8aaadf659fe",
                                                "text": "Malheureusement, il n’existait aucun attachement philosophique au laïcisme et à ses valeurs de scepticisme, d’expérimentation et de tolérance, si essentielles au pluralisme politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e46e2a72-999d-3eac-a714-baee8a614cdb",
                                        "entry_id": "1673902d-c0d7-37d9-b5b7-e513c4c646f2",
                                        "glosses": [
                                            "Défense excessive de la laïcité, notamment par prise de position anti-religieuse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae68669c-bfb7-44ed-b7a4-d3ec8c7dd2be",
                                                "sense_id": "e46e2a72-999d-3eac-a714-baee8a614cdb",
                                                "text": "Il convient de répéter ici qu'il ne s'agit pas de ce que certains appellent un « laïcisme » ou pire une « laïcardise ». La religion et les institutions religieuses, les postures religieuses, les pensées religieuses, font partie de notre histoire et elles participent au débat démocratique et à la société civile, […]."
                                            },
                                            {
                                                "example_id": "9e625bd3-ce8a-4a52-a25b-de0110594cca",
                                                "sense_id": "e46e2a72-999d-3eac-a714-baee8a614cdb",
                                                "text": "Depuis une vingtaine d'années, un laïcisme agressif s'est ainsi réveillé, incriminant le fait religieux en général de susciter de l'intolérance. Le catholicisme est à nouveau sur la sellette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0700fcee-dac3-315d-be70-c39fb403f98a",
                                        "entry_id": "1673902d-c0d7-37d9-b5b7-e513c4c646f2",
                                        "glosses": [
                                            "Doctrine tendant à réserver aux laïcs une certaine part dans le gouvernement de l’église."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a52a21-1140-4c41-8c28-9de0d1c311c0",
                        "source_entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "source_sense_id": "d21fda4a-394b-356e-ab99-cafd05799c64",
                        "target_lang_word": "laïcité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laïcité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Principe de séparation entre l'État et les institutions religieuses, l’État n’exerçant aucun pouvoir religieux et les Églises aucun pouvoir politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2057300c-c4d5-4d0d-96dc-f0a1cc7e21e9",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "La laïcité est engagée dans une lutte âpre et décisive contre le cléricalisme. L'État se bat contre l'Église."
                                            },
                                            {
                                                "example_id": "406764cc-6257-4b7a-af2e-d8acf23ce564",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Le terme d’islamophobie remplit plusieurs fonctions: nier pour mieux la légitimer la réalité d’une offensive intégriste en Europe, attaquer la laïcité en l’assimilant à un nouveau fondamentalisme."
                                            },
                                            {
                                                "example_id": "498de622-9f38-4183-a0b9-33efcd84a1d6",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Nous sommes en chemin vers une affirmation paradoxale : plus je suis croyant, moins je devrais le montrer. La laïcité est anticléricale et non antireligieuse, comme l’actera la loi de décembre 1905."
                                            },
                                            {
                                                "example_id": "72af345c-7650-4eee-9fd1-4cfbb3df2153",
                                                "sense_id": "4974fac2-5261-33a0-83f3-a5250a854982",
                                                "text": "Jésus avait pourtant créé la laïcité en déclarant « Rendez à César ce qui revient à César, à Dieu ce qui revient à Dieu » ou « Qui m'a établi pour vous juger ou régler vos partages? », or le contraire se développait : le religieux, loin de s’affranchir du politique, du militaire, de l’économique et du civil, s’y infiltrait, voire les préemptait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53bf2e0f-6fa9-3f59-89b6-edb958f7dbb1",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Caractère de neutralité religieuse, d’indépendance à l’égard de toutes Églises et confessions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3622191f-068d-48ba-b84b-fc9dec2befe0",
                                                "sense_id": "53bf2e0f-6fa9-3f59-89b6-edb958f7dbb1",
                                                "text": "À coup sûr, l’essence de la laïcité, mis à part la séparation de la religion et de l’État, est l’acceptation de la proposition selon laquelle il n’y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef045e6f-fcb3-34c3-9e88-93e2a2ccf3cb",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Absence d’emprise de la religion sur la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadf95d3-d2ac-4852-b70e-082099d0547c",
                                                "sense_id": "ef045e6f-fcb3-34c3-9e88-93e2a2ccf3cb",
                                                "text": "D’un point de vue philosophique, la laïcité est une construction intellectuelle tendant à empêcher l’emprise de toute confession sur la société, ce qui a pour conséquence de proscrire l’imposition d’une religion civile par le politique tout en renvoyant les affaires spirituelles à la sphère privée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6813dcb5-f19e-36ca-9df4-f817e130fd2c",
                                        "entry_id": "79a7728a-474c-35d8-8d19-aa0deea1c74b",
                                        "glosses": [
                                            "Vision de la société préconisant l'exclusion de toute référence à la religion dans la sphère publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0b2d7b-4a32-437f-a55e-c2deb50f22cc",
                                                "sense_id": "6813dcb5-f19e-36ca-9df4-f817e130fd2c",
                                                "text": "Leur conception de la laïcité tend à exclure les religions de la sphère publique et, en particulier, de l'espace scolaire, y compris par la suppression de la culture religieuse, en affirmant que l'approche culturelle du religieux, proposant des connaissances sur les religions, relève essentiellement d'une démarche confessionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ae77e52-0658-44a8-9af4-9c3bea24d7ae",
                        "source_entry_id": "9d5615c8-2cfc-3bf8-8506-58d991ce4c32",
                        "source_sense_id": "d21fda4a-394b-356e-ab99-cafd05799c64",
                        "target_lang_word": "laicismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laicismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c3f993-d335-36cc-92cb-d308dcc69040",
                                        "entry_id": "1518b2ec-4df0-33b8-8db9-eb27de6f6770",
                                        "glosses": [
                                            "atteggiamento ideologico e pratico che afferma l'indipendenza del pensiero e dell'attività politica e sociale da ogni principio o confessione religiosa, e ritiene che il clero debba restare fuori da ogni attività della vita civile"
                                        ],
                                        "tags": [],
                                        "examples": []
