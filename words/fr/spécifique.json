            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22cba9ad-ae5a-33ec-806f-a508bff31e80",
                    "sense_definition": "Qui est propre ou particulier à quelqu'un, à une chose ou à une situation déterminée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce logiciel répond à un besoin très <w>spécifique</w> de notre entreprise moderne."
                        },
                        {
                            "text": "Chaque région possède des traditions culinaires qui lui sont totalement <w>spécifiques</w>."
                        }
                    ],
                    "synonyms": [
                        "particulier",
                        "propre"
                    ],
                    "antonyms": [
                        "commun",
                        "général"
                    ],
                    "common_phrases": [
