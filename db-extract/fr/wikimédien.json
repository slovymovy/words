                        "glosses": [
                            "Collaborateur à l’un des projets de la Fondation Wikimedia."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "5bcb3d95-dc33-4a1a-a30a-d1ea4f029105",
                                "sense_id": "63ed5600-1cbe-3e64-999b-c166b8035f33",
                                "text": "En octobre, c'est la ville de Toulouse qui signait un accord de partenariat global avec Wikimédia France, décliné pour l'instant de façon concrète avec deux belles réalisations : un fonds de photographiques de très bonne qualité basé sur les collections du Muséum de Toulouse, photos prises par des wikimédiens, […]."
                            }
                        ]
                    }
                ],
                "translations": [
