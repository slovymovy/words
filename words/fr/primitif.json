{
    "word_family": [
        "primitivisme",
        "primitivité",
        "primitivement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81168b01-3775-3a8a-834c-4436436c7258",
                    "sense_definition": "Qui appartient ou se rapporte aux premiers temps de l'humanité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les peintures découvertes dans cette grotte témoignent de la vie de l'homme <w>primitif</w>."
                        },
                        {
                            "text": "Cette communauté isolée a préservé un mode de vie <w>primitif</w> au cœur de la jungle."
                        }
                    ],
                    "synonyms": [
                        "préhistorique"
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
                        "homme primitif",
                        "art primitif",
                        "société primitive"
                    ]
                },
                {
                    "sense_id": "5c0e7699-4a84-3e2a-9899-7c5363914efe",
                    "sense_definition": "Qui est le premier dans le temps, originel ou le plus ancien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les architectes ont restauré ce monument historique dans son état <w>primitif</w>."
                        },
                        {
                            "text": "La forêt <w>primitive</w> abritait autrefois des essences végétales aujourd'hui disparues."
                        }
                    ],
                    "synonyms": [
                        "originel",
                        "initial"
                    ],
                    "antonyms": [
                        "secondaire"
                    ],
                    "common_phrases": [
                        "forêt primitive",
                        "état primitif",
                        "forme primitive"
                    ]
                },
                {
                    "sense_id": "029040e6-c6df-3026-af84-b0c2e77c25e6",
                    "sense_definition": "Qui est très simple, rudimentaire ou peu développé techniquement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les naufragés ont fabriqué un abri de fortune à l'aide d'outils <w>primitifs</w>."
                        },
                        {
                            "text": "Cette machine à calculer paraît bien <w>primitive</w> à côté de nos ordinateurs actuels."
                        }
                    ],
                    "synonyms": [
                        "rudimentaire",
                        "sommaire",
                        "fruste"
                    ],
                    "antonyms": [
                        "sophistiqué",
                        "perfectionné"
                    ],
                    "common_phrases": [
                        "outils primitifs",
                        "méthode primitive"
                    ]
                },
                {
                    "sense_id": "edecce6e-361e-34a5-b677-53b343ab953c",
                    "sense_definition": "Se dit d'une race de chien très ancienne restée proche des premiers chiens domestiqués.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le husky et le basenji appartiennent à la catégorie du chien <w>primitif</w>."
                        },
                        {
                            "text": "Ces races <w>primitives</w> se distinguent par un instinct naturel particulièrement vif."
                        }
                    ],
                    "common_phrases": [
                        "chien primitif",
                        "races primitives"
                    ]
                },
                {
                    "sense_id": "8b80c048-b355-3484-b1d0-53e9b97f1e77",
                    "sense_definition": "Se dit d'une langue ancienne que l'on suppose n'être issue d'aucune autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spécialistes cherchaient jadis à reconstituer la langue <w>primitive</w> de l'humanité."
                        },
                        {
                            "text": "L'existence d'une forme linguistique <w>primitive</w> unique est largement contestée aujourd'hui."
                        }
                    ],
                    "common_phrases": [
                        "langue primitive"
                    ]
                },
                {
                    "sense_id": "93c62dcd-8ba5-3403-a48e-83bf55165607",
                    "sense_definition": "En grammaire, qui sert de racine ou de base et dont se forment d'autres mots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mot <w>primitif</w> juste a donné des dérivés tels que justice et justifier."
                        },
                        {
                            "text": "Cette liste recense chaque terme <w>primitif</w> avec la totalité de ses composés."
                        }
                    ],
                    "synonyms": [
                        "radical"
                    ],
                    "antonyms": [
                        "dérivé"
                    ],
                    "common_phrases": [
                        "mot primitif"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d4cf618-fc43-3e81-9aa4-7eec74227c68",
                    "sense_definition": "Personne appartenant aux premiers temps de l'humanité ou à une société traditionnelle ancestrale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'anthropologue a étudié les croyances religieuses de ce <w>primitif</w> d'autrefois."
                        },
                        {
                            "text": "Les récits coloniaux dépeignaient souvent les indigènes comme des <w>primitifs</w> naïfs."
                        }
                    ]
                },
                {
                    "sense_id": "6ba4b9af-60d6-3fd5-95b5-c003e2cc8f95",
                    "sense_definition": "Artiste peintre ou sculpteur précédant les grandes époques classiques, notamment de la fin du Moyen Âge ou du début de la Renaissance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée consacre une aile entière aux chefs-d'œuvre des grands <w>primitifs</w> flamands."
                        },
                        {
                            "text": "L'expressivité des visages chez ce <w>primitif</w> italien annonce déjà la Renaissance."
                        }
                    ],
                    "common_phrases": [
                        "primitifs flamands",
                        "primitifs italiens"
                    ]
                },
                {
                    "sense_id": "ffba3b69-5c7d-317c-a95d-f37c51afcd36",
                    "sense_definition": "Tableau ou œuvre d'art réalisée par un peintre primitif.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La collection municipale compte plusieurs remarquables <w>primitifs</w> du quatorzième siècle."
                        },
                        {
                            "text": "Ce collectionneur passionné vient d'acquérir un rare <w>primitif</w> de l'école toscane."
                        }
                    ]
                },
                {
                    "sense_id": "ae5cd404-2f9e-3ff6-a00c-020ce45f9a64",
                    "sense_definition": "En linguistique, mot simple ou radical dont sont issus des mots dérivés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant analyse ce <w>primitif</w> pour retracer l'évolution de la famille lexicale."
                        },
                        {
                            "text": "Chaque dérivé du dictionnaire renvoie directement au <w>primitif</w> dont il dépend."
                        }
                    ],
                    "synonyms": [
                        "radical"
                    ],
                    "antonyms": [
                        "dérivé"
                    ]
                }
            ]
        }
    ]
}