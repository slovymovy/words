                    {
                        "form_id": "3e014774-3d8d-4b29-8699-b020503c1026",
                        "entry_id": "b2b47f5b-e698-3b1a-8045-6dc30ce32c77",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtschaftsflüchtlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3e3cc72-9f10-3188-ad85-c512bdfd7876",
                        "entry_id": "b2b47f5b-e698-3b1a-8045-6dc30ce32c77",
                        "glosses": [
                            "Person, die ihre Heimat verlässt, um ihre wirtschaftliche Lage in einem anderen Land zu verbessern"
                        ],
                        "tags": [
                            "auch abwertend verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "ded26926-f9ba-4cd8-9f51-c72972d1f317",
                                "sense_id": "e3e3cc72-9f10-3188-ad85-c512bdfd7876",
                                "text": "„Politisch Verfolgte würden wir ja eh nehmen, die haben einen Anspruch auf Asyl – aber leider, leider geben sich daher so viele Wirtschaftsflüchtlinge als politisch verfolgt aus, da muss man genau und hart prüfen.“"
                            },
                            {
                                "example_id": "8a614649-4947-4e06-bae8-0789f15e83bb",
                                "sense_id": "e3e3cc72-9f10-3188-ad85-c512bdfd7876",
                                "text": "„Die Unterscheidung zwischen (erzwungener) Flucht und (freiwilliger) Migration, zwischen den »guten« Flüchtlingen, den politisch Verfolgten, und den »schlechten«, den sogenannten Wirtschaftsflüchtlingen, wird der Realität nicht gerecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8d78026-8a71-4545-8b21-3fdd4b4b7a97",
