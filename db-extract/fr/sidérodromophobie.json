                    }
                ],
                "senses": [
                    {
                        "sense_id": "6586fa20-a906-3bf9-8887-b7cd31304492",
                        "entry_id": "ebbfaedc-8432-38cd-8252-eea4bde71df8",
                        "glosses": [
                            "Peur irraisonnée de prendre le train."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435ddb31-5270-4671-8474-797f8b480dd9",
                                "sense_id": "6586fa20-a906-3bf9-8887-b7cd31304492",
                                "text": "Ce sont des cas que l'auteur interprète en appelant à son aide l'existence d'un état nerveux particulier, la sidérodromophobie, qui s'empare volontiers des employés de la traction qui ont éprouvé un accident , pourvu qu'ils offrent déjà quelque prédisposition de ce genre."
                            },
                            {
                                "example_id": "1a37cc73-b0d3-4de6-80bf-0526b48a6c0d",
                                "sense_id": "6586fa20-a906-3bf9-8887-b7cd31304492",
                                "text": "Une phobie traumatique assez commune est la sidérodromophobie ; les personnes qui en sont atteintes ne peuvent entendre le sifflet d'une locomotive ou voir rouler un train sans éprouver une crise d'angoisse qui peut aller jusqu'à la perte de connaissance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df3ce8b9-f1cf-4f5a-a314-69e4ece5b900",
                        "source_entry_id": "ebbfaedc-8432-38cd-8252-eea4bde71df8",
                        "source_sense_id": "6586fa20-a906-3bf9-8887-b7cd31304492",
                        "target_lang_word": "siderodromophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "siderodromophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbea6a2-4d52-327e-8794-2aff6efc28df",
                                        "entry_id": "e355e383-ce14-3ef7-bcc1-2ad847808069",
                                        "glosses": [
                                            "A morbid fear of railways."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da136fe5-a2b3-4653-af07-e03399067875",
                                                "sense_id": "ecbea6a2-4d52-327e-8794-2aff6efc28df",
                                                "text": "[…] or fear of microbes; siderodromophobia, or dread of railways; pathophobia, or fear of disease — with many subdivisions, of which the most important and most frequent are […]"
                                            },
                                            {
                                                "example_id": "79e8651f-a46e-4b1e-ba5b-c851a060e7ab",
                                                "sense_id": "ecbea6a2-4d52-327e-8794-2aff6efc28df",
                                                "text": "But because your interpreter has the job of making sense of your scared feelings, it connects your sensation of panic to the train. Welcome to siderodromophobia, the fear of trains!"
                                            },
                                            {
                                                "example_id": "a87fe2ba-cd7f-4073-8f07-a3f83f44d218",
                                                "sense_id": "ecbea6a2-4d52-327e-8794-2aff6efc28df",
                                                "text": "Anxiety dream redux; my subconscious couldn't frighten me with naked-on-the-streets-of-London, so it's iterated through loss-anxiety to a healthy dose of siderodromophobia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
