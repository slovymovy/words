                "senses": [
                    {
                        "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                        "entry_id": "64f732d5-b90c-32cc-893a-05a275774f98",
                        "glosses": [
                            "Remarkable; wonderful; excellent; terrific."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d91e422e-5172-44a9-ab84-6e473954e82f",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "To see their faces brighten and to hear their 'Thanks Cobber, that was bonzer!' was a joy"
                            },
                            {
                                "example_id": "c123f297-8c28-4562-bc04-bca8a8de1563",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "To all the earth she gives the soft glad-eye;\nShe picks no fav′rits in this world o′ men;\nShe peeps in nooks, where ′appy lovers sigh,\nTo make their joy more bonzer still; an′ then,\nO′er Spadger′s Lane she waves a podgy ′and,\nAn′ turns the scowlin′ slums to Fairyland."
                            },
                            {
                                "example_id": "e5a77a80-5416-498c-a2d6-0eacd1d284af",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "You’ll make the bonzerest couple ever seen this side the Tropic."
                            },
                            {
                                "example_id": "27670fc1-190e-436e-8309-e20168a867a7",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "By cripes, you couldn′t have a more bonzer place for doing the thing in style with girls."
                            },
                            {
                                "example_id": "fac7c7eb-bb11-4f8a-a5d2-9711b072314a",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "Inside sat one of the most bonzer sights she′d ever seen."
                            },
                            {
                                "example_id": "17a94a55-459f-4b7c-b9a9-e751cdbe4070",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "The sadness about his father left his face, and he smiled. He seemed pleased to have something positive to do. / 'That's bonzer, Annie. Thanks' he said. 'You're a good sort. And as for Ches, well, he's real bonzer too.'"
                            },
                            {
                                "example_id": "d15b8c53-b9f4-4edb-8784-245ecb72f9ac",
                                "sense_id": "828ed5cb-7d89-3c17-80d2-065b2d265527",
                                "text": "If playin' hero is so bonzer, what're you doin' in this job? Y'oughta be workin' for one o' those scandal rags, or with a crowd o' do-gooders, or for some investigation outfit or somethin'."
                            }
                        ]
                    }
                ],
