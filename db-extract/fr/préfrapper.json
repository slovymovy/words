                        "glosses": [
                            "Frapper préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97897bcb-7c76-4baa-9518-2856ce2fc5e5",
                                "sense_id": "0f7ae4b6-2a40-32a8-8f8c-1f63abab1f02",
                                "text": "Le plomb devait être 'préfrappé' à l'effigie de saint Vincent de Paul, il suffisait ensuite de marquer les date, lieu et numéro en creux comme on le voit sur le plomb."
                            },
                            {
                                "example_id": "e48f0b80-bf35-49bf-bebb-67f60749f962",
                                "sense_id": "0f7ae4b6-2a40-32a8-8f8c-1f63abab1f02",
                                "text": "A noter le K (Kompanie) barré, ce qui indique que cette plaque était préfrappée : ce soldat n'a pas été dirigé vers une affectation de campagne mais vers le dépôt de recrues."
                            }
                        ]
                    }
