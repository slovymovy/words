                "senses": [
                    {
                        "sense_id": "8c7671e0-dc8e-358a-8bab-4c337bb7355e",
                        "entry_id": "70b38a68-58c3-3b5b-bc8c-faa17cfa4e01",
                        "glosses": [
                            "Statue von Buddha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137ca2fb-ce95-4615-9bb5-0a709d2efc57",
                                "sense_id": "8c7671e0-dc8e-358a-8bab-4c337bb7355e",
                                "text": "„Halb verdautes Tofu spritzte auf eine Buddhastatue.“"
                            },
                            {
                                "example_id": "f2a96e46-0a45-4cbd-bf2e-cea572c993e9",
                                "sense_id": "8c7671e0-dc8e-358a-8bab-4c337bb7355e",
                                "text": "„Die Zerstörung der Buddhastatuen rüttelte einige Länder wach und öffnete ihnen die Augen für die Gefahr, die von den Taliban ausging.“"
                            },
                            {
                                "example_id": "8b8c0a43-eee5-422d-bde6-bbebd393eb04",
                                "sense_id": "8c7671e0-dc8e-358a-8bab-4c337bb7355e",
                                "text": "„Bevor es ganz dunkel wurde, stapfte er durch den Schnee in ein langgestrecktes Holzhause, atmete den Weihrauch ein, der vor einer Buddhastatue qualmte, dann stieg er die Treppe hinauf zu seiner Zelle, einer vier Mal vier Meter großen Kammer, in der es nach Kiefernholz roch, und setzte sich auf sein kang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
