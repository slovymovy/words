    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13267437-646f-3b18-ac76-18d96a6e7429",
                    "sense_definition": "Événement inespéré, heureux et extraordinaire qui semble relever d'une chance incroyable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hasard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les passagers sont sortis indemnes de cet accident de voiture par <w>miracle</w>."
                        },
                        {
                            "text": "C'est un véritable <w>miracle</w> que personne n'ait été blessé durant cette violente tempête."
                        }
                    ],
                    "synonyms": [
                        "prodige"
                    ],
                    "antonyms": [
                        "catastrophe"
                    ],
                    "common_phrases": [
                        "par miracle",
                        "crier au miracle",
                        "tenir du miracle"
                    ]
                },
                {
                    "sense_id": "58f57f70-6b34-30ea-8787-a3e4547afc1e",
                    "sense_definition": "Fait extraordinaire et surnaturel attribué à une puissance divine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux fidèles se rassemblent dans ce sanctuaire pour espérer un <w>miracle</w>."
                        },
                        {
                            "text": "La guérison subite du malade a été reconnue comme un <w>miracle</w> religieux."
                        }
                    ],
                    "common_phrases": [
