                    "sense_id": "a4ab09d6-dd99-3dd4-96fa-92c8c593022d",
                    "sense_definition": "Satisfactory, acceptable, or in a state of well-being.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "satisfactory_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry, everything will be <w>alright</w> in the end.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, в конце концов всё будет <w>в порядке</w>.",
                                "zh": "别担心，最后一切都会<w>没问题</w>的。",
                                "nl": "Maak je geen zorgen, alles komt uiteindelijk <w>in orde</w>.",
                                "pl": "Nie martw się, wszystko w końcu będzie <w>w porządku</w>.",
                                "de": "Mach dir keine Sorgen, am Ende wird alles <w>in Ordnung</w> sein.",
                                "fr": "Ne t'inquiète pas, tout finira par <w>bien se passer</w>.",
                                "it": "Non preoccuparti, alla fine tutto andrà <w>bene</w>.",
                                "cs": "Nedělej si starosti, nakonec bude všechno <w>v pořádku</w>.",
                                "tr": "Endişelenme, sonunda her şey <w>iyi</w> olacak.",
                                "es": "No te preocupes, todo estará <w>bien</w> al final."
                            }
                        },
                        {
                            "text": "The movie was <w>alright</w>, but I have seen better ones.",
                            "target_lang_translations": {
                                "ru": "Фильм был <w>нормальный</w>, но я видел и получше.",
                                "zh": "这部电影<w>还可以</w>，但我看过更好的。",
                                "nl": "De film was <w>redelijk</w>, maar ik heb betere gezien.",
                                "pl": "Film był <w>w porządku</w>, ale widziałem lepsze.",
                                "de": "Der Film war <w>ganz gut</w>, aber ich habe schon bessere gesehen.",
                                "fr": "Le film était <w>correct</w>, mais j'en ai vu des meilleurs.",
                                "it": "Il film era <w>discreto</w>, ma ne ho visti di migliori.",
                                "cs": "Ten film byl <w>docela dobrý</w>, ale viděl jsem i lepší.",
                                "tr": "Film <w>fena değildi</w> ama daha iyilerini izlemiştim.",
                                "es": "La película estuvo <w>bien</w>, pero he visto mejores."
                            }
                        }
                    ],
