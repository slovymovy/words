                "senses": [
                    {
                        "sense_id": "accf8295-2c3c-359a-a213-e417b064e380",
                        "entry_id": "077d33e0-3cda-3292-b0a0-0c2f5d8d356d",
                        "glosses": [
                            "кулин. мясной суп, чаще всего с овощами и жирной бараниной, получивший распространение на мусульманском Востоке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f74fb67-7069-4e6b-b61b-5016fd7d7285",
                                "sense_id": "accf8295-2c3c-359a-a213-e417b064e380",
                                "text": "За жирным, пряными травами приправленным пловом, за душистой шурпой вспоминали отличившихся наездников и коней."
                            },
                            {
                                "example_id": "95da7158-4db0-43b6-9ac7-83f518894959",
                                "sense_id": "accf8295-2c3c-359a-a213-e417b064e380",
                                "text": "Кипит в большом казане шурпа, на блюде горячие лепёшки-фатиры."
                            }
                        ]
                    }
                ],
