        "de-extract.jsonl": [
            {
                "entry_id": "03149bb9-1e79-389d-898e-98037fd467bc",
                "word": "uterus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "50e30f0f-f39b-349e-b76e-43409d7d6f7a",
                        "entry_id": "03149bb9-1e79-389d-898e-98037fd467bc",
                        "glosses": [
                            "Gebärmutter, Uterus"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1317fc13-307d-466c-ba22-e84e3862200b",
                        "source_entry_id": "03149bb9-1e79-389d-898e-98037fd467bc",
                        "source_sense_id": "50e30f0f-f39b-349e-b76e-43409d7d6f7a",
                        "source_sense_description": "Gebärmutter, Uterus",
                        "target_lang_word": "Gebärmutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebärmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                        "entry_id": "2b805671-7953-32c6-8c89-b8735dd37441",
                                        "glosses": [
                                            "ein Abschnitt der Ausleitungswege der weiblichen Geschlechtsorgane zwischen Eileiter und Scheide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3371d31-08be-45c0-a43b-39a08cfc0402",
                                                "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                                "text": "Die Gebärmutter dehnt sich während der Schwangerschaft."
                                            },
                                            {
                                                "example_id": "db9ac8ea-5819-4feb-8207-8e812d1a865f",
                                                "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                                "text": "„Und was Kinder angeht: Nach Chisom hatten sich keine mehr in ihrer Gebärmutter einnisten wollen.“"
                                            },
                                            {
                                                "example_id": "e145a440-7075-4644-8948-fb96ab8e7534",
                                                "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                                "text": "„Die Frau meinte, das seien hysterische Zustände, und der Arzt sagte, es habe mit der Gebärmutter gar nichts zu tun.“"
                                            },
                                            {
                                                "example_id": "fa77ebc3-1b67-400e-b406-c094d40b0ab2",
                                                "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                                "text": "„Es handelt sich um einen mit frischem Wasser gefüllten Brunnen, um eine Quelle, und im übertragenen Sinn um die Gebärmutter oder die Vagina der Frau.“"
                                            },
                                            {
                                                "example_id": "5009bb96-edb1-403a-8463-af747c6df5fe",
                                                "sense_id": "64248804-1cb4-3b6e-ada6-be7e5270fe52",
                                                "text": "„Ravic zog die Darmschlinge mit äußerster Vorsicht aus dem Loch in der Gebärmutter und wickelte sie Stück um Stück in sterile Tücher, um sie Sepsis zu verhüten, bis die verletzte Stelle heraus war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "400b548c-0ec0-4062-b9d0-d19670192af2",
                        "source_entry_id": "03149bb9-1e79-389d-898e-98037fd467bc",
                        "source_sense_id": "50e30f0f-f39b-349e-b76e-43409d7d6f7a",
                        "source_sense_description": "Gebärmutter, Uterus",
                        "target_lang_word": "Uterus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uterus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                                        "entry_id": "d94ab611-2c94-3a70-8245-d30a9bf3f4f5",
                                        "glosses": [
                                            "weibliches Geschlechtsorgan bei Säugetieren und anderen lebendgebärenden Wirbeltieren, in dem der Fötus bis zur Geburt heranreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af01fdf-58ae-415f-8d18-e6052966f13c",
                                                "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                                                "text": "Während der Schwangerschaft dehnt sich der Uterus stark aus."
                                            },
                                            {
                                                "example_id": "859d9db6-3d47-47c1-a1f5-6967696ed4dd",
                                                "sense_id": "3949879a-9d07-367b-a315-b9ee2fad1b2d",
                                                "text": "„Der Autor behauptete, der Uterus sei zwar wirklich etwas Tierisches, er vermöge jedoch nichts über die Vernunft der Frau, weil die Anatomie noch nie den geringsten Verbindungsgang zwischen diesem Eingeweide, der Hülle des Fötus, und dem Gehirn entdeckt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b2c176f-0e05-4e18-9350-160ccb28a059",
                        "source_entry_id": "03149bb9-1e79-389d-898e-98037fd467bc",
                        "source_sense_id": "50e30f0f-f39b-349e-b76e-43409d7d6f7a",
                        "source_sense_description": "Gebärmutter, Uterus",
                        "target_lang_word": "utérus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utérus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9050e83f-94cd-374d-85b7-6f184d75549c",
                                        "entry_id": "866c18b7-4bfa-3060-ae8f-077ce3cb5f70",
                                        "glosses": [
                                            "Organe de la gestation en forme de poche situé dans le bas-ventre chez les femmes et les femelles des autres mammifères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589a389f-35da-4fa6-9c5a-83378fc5b41a",
                                                "sense_id": "9050e83f-94cd-374d-85b7-6f184d75549c",
                                                "text": "C’est le typique bon époux, bon père, bon chrétien à bons revenus, encore arrondis par ceux de sa femme qui, pour compenser, dans la pure tradition de l’utérus héroïque, s’arrondit elle-même en moyenne une fois tous les deux ans. Ce n’est plus une maison, c’est une garenne ! se serait écrié Madame Mère après l’arrivée d'un petit neuvième."
                                            },
                                            {
                                                "example_id": "a40f6173-7bfd-4f0d-b4e3-6954708c3566",
                                                "sense_id": "9050e83f-94cd-374d-85b7-6f184d75549c",
                                                "text": "L’utérus est doté de parois épaisses composées de muscles qui se détendent considérablement pour contenir l’embryon puis le fœtus pendant la gestation."
                                            },
                                            {
                                                "example_id": "7751af50-17f9-4c4c-a844-3d3e4125218b",
                                                "sense_id": "9050e83f-94cd-374d-85b7-6f184d75549c",
                                                "text": "L’insémination intra-utérine intraconjugale en laboratoire ou cabinet médical, qui allie induction d’ovulation et préparation-lavage du sperme qui sera injecté dans l’utérus, lors d’une infertilité masculine ou féminine."
                                            },
                                            {
                                                "example_id": "94c1c733-b89f-4006-b703-949dfc988a61",
                                                "sense_id": "9050e83f-94cd-374d-85b7-6f184d75549c",
                                                "text": "En égyptien, le vocable bi signifie « utérus » et « galerie de mine ». … De telles intuitions archaïques ont la vie dure. On a vu que la désignation delph (= utérus) s’était conservée dans le nom d’un des sanctuaires les plus sacrés de l’hellénisme, Delphes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
