                        "entry_id": "05aca7ec-7dc7-3e71-bca2-17e7763fbac8",
                        "glosses": [
                            "To issue or confer a plaudit upon."
                        ],
                        "tags": [
                            "in-plural",
                            "often",
                            "rare",
                            "transitive",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "70693af5-4bf7-4b4d-84a6-53ad3c888ab7",
                                "sense_id": "70c4e042-670e-3294-8ad1-05d460c4a419",
                                "text": "Floris grumpily yammered on about how the actors hardly deserved to be plaudited."
                            },
                            {
                                "example_id": "bc32dc77-222a-4f92-b099-a2e3ac0ef881",
                                "sense_id": "70c4e042-670e-3294-8ad1-05d460c4a419",
                                "text": "Dunces may take degrees, and we have ſeene / Authors and Poets, come forth at foureteene. / The like lucke haunts the Court, he that has wit / To flaſh a line, and friends to plaudite it."
                            },
                            {
                                "example_id": "8e52a531-56ae-4303-b8cb-79467c226566",
                                "sense_id": "70c4e042-670e-3294-8ad1-05d460c4a419",
                                "text": "Much plaudited by Sir Adrian Cadbury and practised by companies as prestigious as BP, the policy governance model is at once both complex and simple."
                            }
                        ]
                    }
