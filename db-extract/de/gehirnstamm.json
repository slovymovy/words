                    {
                        "sense_id": "050274ee-1a3d-3d89-bc9b-ce4d626fe55e",
                        "entry_id": "8b916afe-8ce4-39cc-b95d-570ec57b9162",
                        "glosses": [
                            "vegetative Funktionen steuernder Teil des Gehirns unter dem Zwischenhirn (ohne Kleinhirn)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25786363-4017-4e3a-b7b9-4aeb9ea34be7",
                                "sense_id": "050274ee-1a3d-3d89-bc9b-ce4d626fe55e",
                                "text": "„Eine Kugel bringt einen Menschen zu Fall, indem sie eines von zwei Dingen bewirkt: Entweder sie hat das Gehirn, den Gehirnstamm oder das Rückenmark getroffen und unmittelbar das zentrale Nervensystem beschädigt. Oder sie hat das kardiovaskuläre System in einem Umfang geschädigt, dass es zu einem massiven Blutverlust kommt, das Gehirn nicht mehr ausreichend mit Sauerstoff versorgt wird und das Opfer schließlich kollabiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
