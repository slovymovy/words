                "entry_id": "500d1933-f762-35b6-96f0-609fb1b5e70b",
                "word": "vrijpostigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2efca27a-192f-4b66-88d1-ce3ae9270d9d",
                        "entry_id": "500d1933-f762-35b6-96f0-609fb1b5e70b",
                        "tags": [
                            "plural"
                        ],
                        "form": "vrijpostigheden"
