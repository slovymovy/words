                        "cross_references": [
                            {
                                "target_word": "delincuente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bb5c8240-4a78-3eba-9a37-962168d904de",
                                        "entry_id": "5b14d82e-1f17-314f-989e-1d17941a8b43",
                                        "glosses": [
                                            "Persona que comete un delito o crimen."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325d2db2-b200-43f4-a29f-94fe2962f199",
                                                "sense_id": "bb5c8240-4a78-3eba-9a37-962168d904de",
                                                "text": "“La mayoría de los delincuentes son personas que, a consecuencia de la desviación momentánea o crónica de su sistema normativo, han cometido una agresión contra los valores del grupo al que pertenecen”."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b0c777f-471b-4c62-88aa-f9727694ec84",
                        "source_entry_id": "f65cb7c8-ac80-3f8f-8efd-06e22c20181a",
                        "source_sense_id": "0bdca0d8-2066-3531-8d93-917ae3213453",
                        "target_lang_word": "Verbrecherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrecherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "addb1def-4ca8-3b59-833c-1760237d24c3",
                                        "entry_id": "59d7d6aa-068c-33af-b431-90d980fdc976",
                                        "glosses": [
                                            "weibliche Person, die [ein] Verbrechen begeht oder begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8833f137-107f-4d45-8ffa-df830f6d923f",
                                                "sense_id": "addb1def-4ca8-3b59-833c-1760237d24c3",
                                                "text": "„Aus einem fröhlichen Mädchen mit guten Zukunftsaussichten war eine verurteilte Verbrecherin geworden, die in einem Provinzgefängnis auf faulem Stroh schlief und in die Fremde verbannt werden sollte.“"
                                            },
                                            {
                                                "example_id": "8ad805ed-140c-4770-831e-a1460d7e57ae",
                                                "sense_id": "addb1def-4ca8-3b59-833c-1760237d24c3",
                                                "text": "„Sie blickten stumm vor Schrecken sie an, daß es weder im Himmel noch auf Erden oder in der Welt der Elfen einen Richterstuhl geben sollte, vor dem diese Verbrecherin freigesprochen werden könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
