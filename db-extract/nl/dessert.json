                        ],
                        "form": "desserten, desserts"
                    },
                    {
                        "form_id": "1dad7e2b-da4f-4e94-a2db-f2759c9b76ce",
                        "entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "dessertje"
                    },
                    {
                        "form_id": "b4766eaf-9d3e-4f8b-9b81-86b160168762",
                        "entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "dessertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                        "entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "glosses": [
                            "het (meestal zoete) gerecht waarmee een maaltijd wordt afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6613bd-6a67-4ffb-b79e-c16834e747a8",
                                "sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                                "text": "Eén van ons ruilt het dessert in voor iets héél spannends van de toetjeskaart: eendenlever met eekhoorntjesbrood, macadamia, karamel, kip en balsamico (supplement 5,-)… ja echt, dit heet een dessert!"
                            },
                            {
                                "example_id": "281fc73d-d909-4717-af46-28775d35b978",
                                "sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                                "text": "Nu moet Le Mistral het hebben van die paar oude getrouwen die van de snelweg afslaan. Echte Franse truckers, routiers die van goed eten houden. 'Voor mij is een fatsoenlijke maaltijd: entree, plat, kaas, dessert', zegt Frédéric Deidier (49), terwijl hij enthousiast op zijn enorme buik kletst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4df12845-bf9b-45d5-8974-8bf8e2e74a03",
                        "source_entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "source_sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                        "target_lang_word": "Dessert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dessert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                        "entry_id": "363c1a5f-b1cb-33f5-8d04-6937f27269dd",
                                        "glosses": [
                                            "letzter, oft süßer Gang einer Mahlzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611e1e2a-9509-44cf-a2d7-34bd68876e03",
                                                "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                                "text": "Und zum Dessert gibt es frische Erdbeeren mit Schlagsahne."
                                            },
                                            {
                                                "example_id": "2b833597-eb48-431c-87be-1510b23fa555",
                                                "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                                "text": "„Nach dem sehr guten Essen, für das wir komischerweise sehr viel mehr Zeit brauchten als sonst für das Essen, fragte uns die Kellnerin noch, ob wir ein Dessert wünschten.“"
                                            },
                                            {
                                                "example_id": "3c56613a-08b6-4d2a-99d8-e5d79f59ed4a",
                                                "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                                "text": "„Silvestri bestellte beim Kellner, den er wie einen alten Bekannten behandelte, sobald er seinen Florentiner Akzent hörte, ein besonderes Dessert und einen dreifachen Espresso.“"
                                            },
                                            {
                                                "example_id": "8f25f60a-e33c-4e69-97de-f2a469c8618d",
                                                "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                                "text": "„Ihre Desserts sind wunderbar.“"
                                            },
                                            {
                                                "example_id": "214650aa-29ea-43d4-be25-a21a63057faf",
                                                "sense_id": "c00ffe19-63e8-37ea-a65a-eb31149d75cc",
                                                "text": "„Beim Dessert kamen drei oder vier weitere Offiziere und eine Viertelstunde später zwei unappetitliche Freudenmädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6db18303-b212-4bce-a318-52bb0ecebbef",
                        "source_entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "source_sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                        "target_lang_word": "Nachtisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                        "entry_id": "e92afa05-4eb2-31ae-abca-0a1d0af5135a",
                                        "glosses": [
                                            "der letzte Gang einer ausgedehnten Mahlzeit, der nach der Hauptspeise serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6911b35d-15d1-4152-84d3-b72da8489909",
                                                "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                                "text": "Zum Nachtisch gibt es Götterspeise."
                                            },
                                            {
                                                "example_id": "109888bb-aa74-4dd4-b889-592a55b07220",
                                                "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                                "text": "„Nachtisch gab es erst, wenn der Teller leer war.“"
                                            },
                                            {
                                                "example_id": "0985ccab-30e6-4a25-8303-ac1ffadf56d5",
                                                "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                                "text": "„Sie aßen ihren Nachtisch so schnell wie möglich, bevor er kalt wurde.“"
                                            },
                                            {
                                                "example_id": "766023a8-bf4b-42ca-9e6c-5ef0e5c36e7f",
                                                "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                                "text": "„Sie läutete erst, um den Nachtisch und alles das bringen zu lassen, was man zum Punsch braucht.“"
                                            },
                                            {
                                                "example_id": "360c49f5-bd23-415f-9efd-206874cd22cc",
                                                "sense_id": "9b95ec2c-2be8-314a-a5bf-97557a60f406",
                                                "text": "„Es gab Brennsuppe, als Hauptgericht Kartoffeln mit Soße und zum Nachtisch einen Apfel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b74b71f-06ec-4f6a-be70-feb45e23c71a",
                        "source_entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "source_sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                        "target_lang_word": "dessert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc9d304-24dc-3af4-bc1c-f314f62adf70",
                                        "entry_id": "6a93f4ed-0dc0-3f46-8e88-3d3f4e5db7bf",
                                        "glosses": [
                                            "The last course of a meal, consisting of fruit, sweet confections etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354b29ff-6de4-4bfb-84c7-c40e0f018aa0",
                                                "sense_id": "5fc9d304-24dc-3af4-bc1c-f314f62adf70",
                                                "text": "I ordered hummus for a starter, a steak as the main course, and chocolate cake for dessert."
                                            },
                                            {
                                                "example_id": "09b0ca8f-5194-486c-a6e7-bc13404da057",
                                                "sense_id": "5fc9d304-24dc-3af4-bc1c-f314f62adf70",
                                                "text": "Can I see the dessert menu, please?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb789d8-0d2c-31b0-8729-be1f52c3b988",
                                        "entry_id": "6a93f4ed-0dc0-3f46-8e88-3d3f4e5db7bf",
                                        "glosses": [
                                            "A sweet dish or confection served as the last course of a meal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0a1642-46c4-42ba-9969-6d11076a817f",
                                                "sense_id": "dfb789d8-0d2c-31b0-8729-be1f52c3b988",
                                                "text": "Trifle is a favourite dessert of the English, but rivalled by pavlova in Australia and New Zealand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c94bd9b-6ff8-4548-830c-03995fe6904a",
                        "source_entry_id": "c7021b80-03e0-3dd0-b407-9ddf291cc827",
                        "source_sense_id": "496ce64e-c235-31ea-b811-14b831d0a252",
                        "target_lang_word": "dessert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abad9efb-4f3a-3164-b3cc-7f091e42398e",
                                        "entry_id": "57b906d2-36c8-3d10-937d-58b7625ce549",
                                        "glosses": [
                                            "Mets généralement sucré habituellement servi à la fin d’un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d59ed2-e2a7-4f10-92b1-527b8bf13ce9",
                                                "sense_id": "abad9efb-4f3a-3164-b3cc-7f091e42398e",
                                                "text": "Sorbet, gâteau au chocolat, tarte au pommes, crème caramel, mousse au chocolat. Je vous récite la litanie mais il n'y a qu'un dessert qui compte : nos îles flottantes. Il est impératif que vous goûtiez nos îles flottantes. Spécialité absolue."
                                            },
                                            {
                                                "example_id": "56791ecd-8de1-4807-b123-f122394200ce",
                                                "sense_id": "abad9efb-4f3a-3164-b3cc-7f091e42398e",
                                                "text": "Le but de l'étude consistait à optimaliser les propriétés sensorielles et rhéologiques des desserts lactés UHT, en recherchant les types adéquats et les quantités appropriées d’amidon et de carragénate, et en ajustant la technologie du procédé UHT direct."
                                            },
                                            {
                                                "example_id": "dea3584f-ad3f-4d19-9a5f-55da88d148ef",
                                                "sense_id": "abad9efb-4f3a-3164-b3cc-7f091e42398e",
                                                "text": "— Je connais des enfants qui, si le choix leur était donné, préféreraient la fessée à la privation de dessert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd3354b-cdb2-3c84-91a0-bdb11e8ad8ac",
                                        "entry_id": "57b906d2-36c8-3d10-937d-58b7625ce549",
                                        "glosses": [
                                            "Moment où ce mets est sur la table."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bb5689-82ca-406a-bdf0-a486fce0399f",
                                                "sense_id": "dfd3354b-cdb2-3c84-91a0-bdb11e8ad8ac",
                                                "text": "Une discussion avait fait traîner le dessert en longueur, et les gens tardaient à servir le café."
                                            },
                                            {
                                                "example_id": "df31a3fc-8c9a-4e5d-b579-2e89f79da056",
                                                "sense_id": "dfd3354b-cdb2-3c84-91a0-bdb11e8ad8ac",
                                                "text": "Les hors-d’œuvre disparaissaient avec les banalités d'une conversation qui attend le dessert pour se dessiner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dessert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a2aa515-cf16-368a-ba89-d5aba06a2b5a",
                                        "entry_id": "212a4e9a-3e2e-3d2d-bfc1-7fa0a5139ed4",
                                        "glosses": [
                                            "Troisième personne du présent de l’indicatif de desservir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4b528b-e8cd-41c4-9b08-bb1449f1ae0c",
                                                "sense_id": "3a2aa515-cf16-368a-ba89-d5aba06a2b5a",
                                                "text": "À Saint-Germain, un escalier dessert tout au plus deux logis par niveau et les « allées » ne sont utilisées systématiquement que pour « désassujetir » les garde-robes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
