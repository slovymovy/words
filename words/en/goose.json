{
    "word_family": [
        "gosling",
        "goosey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3784991a-4200-3101-8b4d-a7ac96d9e75e",
                    "sense_definition": "A large water bird with a long neck, webbed feet, and short legs, generally larger than a duck.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a flock of <w>geese</w> on the pond.",
                            "target_lang_translations": {
                                "ru": "На пруду стая <w>гусей</w>.",
                                "zh": "池塘里有一群<w>鹅</w>。"
                            }
                        },
                        {
                            "text": "A group of <w>geese</w> is called a gaggle.",
                            "target_lang_translations": {
                                "ru": "Группа <w>гусей</w> называется стаей.",
                                "zh": "一群<w>鹅</w>被称为“gaggle”。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild goose",
                        "flock of geese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная водоплавающая птица с длинной шеей, перепончатыми лапами и короткими ногами, обычно крупнее утки.",
                        "zh": "一种大型水鸟，有长脖子、蹼足和短腿，通常比鸭子大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гусь",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹅",
                                "target_lang_sense_clarification": "鸟类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cbb8cbe-f293-3f90-bc19-2e1c2d7e3f29",
                    "sense_definition": "The meat of a goose eaten as food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered roast <w>goose</w> for the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Мы заказали жареного <w>гуся</w> к праздничному ужину.",
                                "zh": "我们为节日晚餐点了烤<w>鹅肉</w>。"
                            }
                        },
                        {
                            "text": "The chef knows how to cook a <w>goose</w> perfectly.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар знает, как идеально приготовить <w>гуся</w>.",
                                "zh": "厨师知道如何完美地烹饪<w>鹅肉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast goose",
                        "Christmas goose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо гуся, употребляемое в пищу.",
                        "zh": "作为食物食用的鹅肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гусь",
                                "target_lang_sense_clarification": "блюдо"
                            },
                            {
                                "target_lang_word": "гусятина",
                                "target_lang_sense_clarification": "мясо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹅肉",
                                "target_lang_sense_clarification": "肉类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                    "sense_definition": "A foolish or silly person, often used affectionately.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for you, but you are such a <w>goose</w>.",
                            "target_lang_translations": {
                                "ru": "Мне жаль тебя, но ты такой <w>глупыш</w>.",
                                "zh": "我很同情你，但你真是个<w>傻瓜</w>。"
                            }
                        },
                        {
                            "text": "Don't be such a <w>goose</w> and come inside.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дурачком</w> и заходи внутрь.",
                                "zh": "别像个<w>傻瓜</w>一样，快进来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly goose"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often affectionate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или недалекий человек, часто используется ласково.",
                        "zh": "指愚蠢或傻气的人，常用于亲昵的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупыш",
                                "target_lang_sense_clarification": "ласково"
                            },
                            {
                                "target_lang_word": "дурачок",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "亲昵称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b35e424d-a8e9-3137-b964-dcd93414ef5c",
                    "sense_definition": "A female goose, as distinguished from a male gander.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult sometimes to distinguish ganders from <w>geese</w>.",
                            "target_lang_translations": {
                                "ru": "Иногда трудно отличить гусаков от <w>гусынь</w>.",
                                "zh": "有时很难区分公鹅和<w>母鹅</w>。"
                            }
                        },
                        {
                            "text": "The farmer keeps two <w>geese</w> for breeding.",
                            "target_lang_translations": {
                                "ru": "Фермер держит двух <w>гусынь</w> для разведения.",
                                "zh": "农夫养了两只<w>母鹅</w>用于繁殖。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самка гуся, в отличие от самца (гусака).",
                        "zh": "雌性鹅，与雄性公鹅相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гусыня",
                                "target_lang_sense_clarification": "самка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母鹅",
                                "target_lang_sense_clarification": "雌性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e362b6ac-7274-3094-83cd-543ec0fa4a89",
                    "sense_definition": "A heavy iron used by tailors for pressing clothes, historically heated in coals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor heated his <w>goose</w> on the stove.",
                            "target_lang_translations": {
                                "ru": "Портной нагрел свой <w>утюг</w> на печи.",
                                "zh": "裁缝在炉子上加热了他的<w>裁缝熨斗</w>。"
                            }
                        },
                        {
                            "text": "Use the <w>goose</w> to press the heavy fabric.",
                            "target_lang_translations": {
                                "ru": "Используй этот <w>утюг</w>, чтобы разгладить плотную ткань.",
                                "zh": "用这个<w>裁缝熨斗</w>来熨烫厚重的布料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goose iron"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый портновский утюг для разглаживания одежды, который раньше нагревали на углях.",
                        "zh": "一种裁缝用来熨烫衣服的重型铁熨斗，历史上曾用煤炭加热。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портновский утюг",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裁缝熨斗",
                                "target_lang_sense_clarification": "历史用具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2488247-a07b-3900-ac4b-b0acf79d4051",
                    "sense_definition": "An old board game where players move pieces on a board marked with pictures of geese.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children played the game of <w>goose</w> in the parlor.",
                            "target_lang_translations": {
                                "ru": "Дети играли в <w>гусёк</w> в гостиной.",
                                "zh": "孩子们在客厅里玩<w>鹅棋</w>。"
                            }
                        },
                        {
                            "text": "He won the match at the game of <w>goose</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл партию в <w>гусёк</w>.",
                                "zh": "他赢得了那场<w>鹅棋</w>比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "game of goose"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical game"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная настольная игра, в которой игроки передвигают фишки по полю с изображениями гусей.",
                        "zh": "一种古老的棋盘游戏，玩家在印有鹅图案的棋盘上移动棋子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гусёк",
                                "target_lang_sense_clarification": "игра"
                            },
                            {
                                "target_lang_word": "игра «Гусь»",
                                "target_lang_sense_clarification": "название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹅棋",
                                "target_lang_sense_clarification": "游戏名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d154a93e-c5bb-3028-b2a9-0392b041a48b",
                    "sense_definition": "To poke or pinch someone's buttocks unexpectedly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>goosed</w> him as a joke while he was cooking.",
                            "target_lang_translations": {
                                "ru": "Она в шутку <w>ущипнула</w> его, пока он готовил.",
                                "zh": "她在他做饭时开玩笑地<w>掐</w>了他一下。"
                            }
                        },
                        {
                            "text": "He complained that someone had <w>goosed</w> him in the crowd.",
                            "target_lang_translations": {
                                "ru": "Он пожаловался, что кто-то <w>ущипнул</w> его в толпе.",
                                "zh": "他抱怨在人群中被人<w>掐</w>了屁股。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданно ущипнуть или шлепнуть кого-то за ягодицы.",
                        "zh": "出其不意地捏或戳某人的臀部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ущипнуть",
                                "target_lang_sense_clarification": "за ягодицу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掐",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29e891ff-6525-3d16-bee6-1c183eaf4b8f",
                    "sense_definition": "To stimulate, encourage, or increase the activity of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tax cuts were designed to <w>goose</w> the economy.",
                            "target_lang_translations": {
                                "ru": "Снижение налогов было призвано <w>подстегнуть</w> экономику.",
                                "zh": "减税政策旨在<w>刺激</w>经济。"
                            }
                        },
                        {
                            "text": "They tried to <w>goose</w> the ratings with a celebrity guest.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>поднять</w> рейтинги с помощью приглашенной звезды.",
                                "zh": "他们试图通过邀请名人嘉宾来<w>推动</w>收视率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "goose the economy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стимулировать, поощрять или повышать активность чего-либо.",
                        "zh": "刺激、鼓励或提高某事物的活跃度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстегнуть",
                                "target_lang_sense_clarification": "стимулировать"
                            },
                            {
                                "target_lang_word": "повысить",
                                "target_lang_sense_clarification": "увеличить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺激",
                                "target_lang_sense_clarification": "促进"
                            },
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "促进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "969ee267-5a35-3e6d-b8f4-febdf71447fe",
                    "sense_definition": "To press the accelerator of a vehicle briefly to rev the engine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>goosed</w> the engine to keep it from stalling.",
                            "target_lang_translations": {
                                "ru": "Он <w>газанул</w> двигателем, чтобы тот не заглох.",
                                "zh": "他<w>猛踩油门</w>以防发动机熄火。"
                            }
                        },
                        {
                            "text": "You need to <w>goose</w> the gas pedal a little.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно немного <w>поддать газу</w>.",
                                "zh": "你需要稍微<w>猛踩油门</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратковременно нажать на педаль газа автомобиля, чтобы увеличить обороты двигателя.",
                        "zh": "短暂地踩下车辆油门以提高发动机转速。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газануть",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "поддать газу",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛踩油门",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
