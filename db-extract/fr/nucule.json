                        "entry_id": "7e07c6ec-ca58-3c16-8fa9-526d2ac91397",
                        "glosses": [
                            "Akène doté d'une paroi particulièrement coriace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e87aa0-059c-420f-8949-b5e9d99b323c",
                                "sense_id": "5fe8eec9-941a-30e4-94c8-e05e7a09cdc3",
                                "text": "La noisette est une nucule."
                            }
                        ]
                    },
                    {
                        "sense_id": "f625e17f-e297-3fd6-b39b-be388539ae69",
                        "entry_id": "7e07c6ec-ca58-3c16-8fa9-526d2ac91397",
                        "glosses": [
                            "Chacun des petits noyaux d’un nuculaine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1c21651c-96f0-4c38-a651-ad67521bb781",
                                "sense_id": "f625e17f-e297-3fd6-b39b-be388539ae69",
                                "text": "La nèfle contient cinq nucules."
                            }
                        ]
                    },
                    {
                        "sense_id": "05676548-2d1b-351b-9006-66b96bbd38a9",
                        "entry_id": "7e07c6ec-ca58-3c16-8fa9-526d2ac91397",
                        "glosses": [
                            "Genre de mollusques bivalves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa953b0-509c-424b-abb1-85aad134b79a",
                                "sense_id": "05676548-2d1b-351b-9006-66b96bbd38a9",
                                "text": "Il y a peu d'espèces de Nucules. Elles se servent de leur pied pour fouir le sable. La coquille, nacrée, est ovale, mince et faiblement quadrillée. … La Nucule fréquente les fonds sableux ou graveleux fins."
                            }
                        ]
                    }
                ],
