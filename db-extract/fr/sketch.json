                    },
                    {
                        "form_id": "b1e585b4-1347-405d-84db-4bd25efdbd8c",
                        "entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
                        "tags": [
                            "plural"
                        ],
                        "form": "sketches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b19b0391-b025-3c38-92b6-3660c9e551b4",
                        "entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
                        "glosses": [
                            "Une petite comédie destinée spécialement à faire rire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573ecc50-f54e-44c8-b7d6-a86a99778daf",
                                "sense_id": "b19b0391-b025-3c38-92b6-3660c9e551b4",
                                "text": "Nous jouions une ample comédie aux cent sketches divers : le flirt, les malentendus vite dissipés, les taquineries débonnaires et les gronderies gentilles, le dépit amoureux, les cachotteries tendres et la passion."
                            },
                            {
                                "example_id": "da4347ad-c371-4631-be4b-e91555f2ff83",
                                "sense_id": "b19b0391-b025-3c38-92b6-3660c9e551b4",
                                "text": "Nous avons choisi de travailler un sketch de Muriel Robin « Le noir » dans un contexte d 'enseignement du français à des étrangers parce qu'il nous a semblé que ce sketch par son thème et par ses procédés humoristiques permettaient de mettre en relief des éléments liés à une culture particulière d'une part et au fonctionnement universel de l'humour."
                            },
                            {
                                "example_id": "07aeb708-6f8a-4cf1-9efd-9e1d971b7aa9",
                                "sense_id": "b19b0391-b025-3c38-92b6-3660c9e551b4",
                                "text": "Il y a six ans, l’émission humoristique This hour has 22 minutes, a présenté un sketch sur le « divorce » possible entre le Canada (personnifié par un sympathique bonhomme bedonnant) et le Québec (interprété par une femme hystérique avec un fort accent parisien)."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d0344ea-a979-3e91-9065-3e4d469bd6de",
                        "entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
                        "glosses": [
                            "Une situation bizarre, amusante."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "90e97440-a5f3-475d-814a-ec82d939e6d0",
                                "sense_id": "3d0344ea-a979-3e91-9065-3e4d469bd6de",
                                "text": "Mon gars, hier dès que les flics se sont montrés, c’était un sketch !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a28380dc-2e98-3d31-9fff-36271233a5b3",
                        "entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
                        "glosses": [
                            "Une personne qui provoque souvent ce genre de situations."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "543101ae-d570-486d-b3dd-bbd308787ed7",
                                "sense_id": "a28380dc-2e98-3d31-9fff-36271233a5b3",
                                "text": "T’es vraiment un sketch !… Laisse-la tranquille !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5bb27d9-043e-4850-acb0-a7fed800471a",
                        "source_entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
                        "target_lang_word": "skit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd866f0b-90bc-37a6-aed2-e5d3cedc5a24",
                                        "entry_id": "879910b3-20e0-3251-b48e-0486b8538bf1",
                                        "glosses": [
                                            "A short comic performance done by amateurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d710435e-d8e7-34af-b9ad-564269c489f9",
                                        "entry_id": "879910b3-20e0-3251-b48e-0486b8538bf1",
                                        "glosses": [
                                            "A jeer or sally; a brief satire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf67caa-2fad-4014-aaca-eebe6675bac1",
                                                "sense_id": "d710435e-d8e7-34af-b9ad-564269c489f9",
                                                "text": "That is a mere skit compared with this strange performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27051c65-e81a-37f0-aa88-d7050b1646af",
                                        "entry_id": "879910b3-20e0-3251-b48e-0486b8538bf1",
                                        "glosses": [
                                            "A wanton girl; a wench."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdc58bf-14f5-4621-adff-d97bca0f14ba",
                                                "sense_id": "27051c65-e81a-37f0-aa88-d7050b1646af",
                                                "text": "However, terrible as it may seem to the tall maiden sisters of J.P.'s in Queen Anne houses with walled vegetable gardens, this courtesan, strumpet, harlot, whore, punk, fille de joie, street-walker, this trollop, this trull, this baggage, this hussy, this drab, skit, rig, quean, mopsy, demirep, demimondaine, this wanton, this fornicatress, this doxy, this concubine, this frail sister, this poor Queenie—did actually solicit me, did actually say 'coming home to-night, dearie' and my soul was not blasted enough to call a policeman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ea5877-5605-306e-ad7d-e4163b41ffa7",
                                        "entry_id": "879910b3-20e0-3251-b48e-0486b8538bf1",
                                        "glosses": [
                                            "A short, sharp shower (of rain)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9e304b-d411-4b47-89c3-4ce8c6c92fe9",
                                                "sense_id": "98ea5877-5605-306e-ad7d-e4163b41ffa7",
                                                "text": "... there come on a 'skit' of rain, and I made for one of his barns for shelter."
                                            },
                                            {
                                                "example_id": "7adc576e-b09b-4d6c-995c-8efbbfbd01b7",
                                                "sense_id": "98ea5877-5605-306e-ad7d-e4163b41ffa7",
                                                "text": "Suddenly there came a little volley of sharp drops - not of the liquid he desired - dashed into the trumpeter's red face , and against the back of the parson's hat - the first skit of rain, that seemed rather to rise as if from a blow-pipe, than fall from the clouds."
                                            },
                                            {
                                                "example_id": "caf9b245-e7a9-495d-99c3-f3524dee0242",
                                                "sense_id": "98ea5877-5605-306e-ad7d-e4163b41ffa7",
                                                "text": "Diana did not obey him, but stood in the rain. 'I don't care for a skit of rain.' 'Get in, quick.' When she did not move he sprang up, and catching her up in his arms, set her down in the hollow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                                        "entry_id": "879910b3-20e0-3251-b48e-0486b8538bf1",
                                        "glosses": [
                                            "Diarrhea, in livestock; the scour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27faadea-8b82-4585-b654-37647cbe8d65",
                                                "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                                                "text": "The Cause and Nature of the Skit, or Scour, of Sheep and Lambs."
                                            },
                                            {
                                                "example_id": "d9080df2-dc87-43a2-8c32-93e9786b52a6",
                                                "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                                                "text": "[…] quality in the seeds which he cannot account for, that of killing lambs at about ten days old; they die of the skit, or scouring; and it is particularly experienced in new inclosures; […]"
                                            },
                                            {
                                                "example_id": "a3f60ecf-6abf-4356-8d48-044b45aebfbd",
                                                "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                                                "text": "... the \"skit.\" A practised eye can generally tell for two or three days before it commences what is coming on. The lambs look dull, their coats are staring. Generally the scour is of a dark greenish colour - sometimes almost[…]"
                                            },
                                            {
                                                "example_id": "59bf879a-b884-42e4-8f37-2d59cbfadd48",
                                                "sense_id": "9b0d42f5-888d-3465-a8b2-f87db4e522a2",
                                                "text": "... lambs, and on the appearance of the skit or scour, the necessity for a change of food is indicated."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53db364f-633d-32b8-aca8-e552d220c483",
                                        "entry_id": "582937f2-37cd-36ec-8dd1-330a6368f1e7",
                                        "glosses": [
                                            "To make fun of."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Merseyside",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                                        "entry_id": "582937f2-37cd-36ec-8dd1-330a6368f1e7",
                                        "glosses": [
                                            "To caper; to skip or run lightly and quickly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8527eeb-dcfd-4bfb-88e4-17372caac43a",
                                                "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                                                "text": "Yet soon's she hears me mention Muirland Willie, / She skits an' flings like ony towmont filly- […]"
                                            },
                                            {
                                                "example_id": "e53d54b1-bf41-4653-ad2f-edde68f0d646",
                                                "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                                                "text": "The big man stood across, as if to hide the cart; but the man behind the horse skitted back into a bush, very nimble and clever, but not quite smart enough."
                                            },
                                            {
                                                "example_id": "a609707b-1dc8-4df1-b94a-b15c187dbf97",
                                                "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                                                "text": "I could feel her eyes skitting over to me after she said something that might have shocked me - but I stayed quiet."
                                            },
                                            {
                                                "example_id": "e3d79f18-5bbe-4a3b-aa7f-0d27370a15e4",
                                                "sense_id": "a0f6896e-0a5d-3561-87b6-3d2df6e983bc",
                                                "text": "Micah watched the cloudcast shadows skitting over the snowfields before him – then screwed his face up in surprise when some of them seemed to come to a halt. He looked up. The clouds were still moving , and when he looked back at the plains he realized that the motionless grey shapes were not shadows at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d41b733-ad03-431b-977c-cadbc4a8a682",
                        "source_entry_id": "2de3760a-df50-3c46-97da-77bb8b672027",
