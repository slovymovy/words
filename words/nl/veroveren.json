                            },
                            {
                                "target_lang_word": "conquer",
                                "target_lang_sense_clarification": "a market, a difficulty"
                            },
                            {
                                "target_lang_word": "capture",
                                "target_lang_sense_clarification": "a position, market share"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "conquérir",
