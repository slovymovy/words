                                        "sense_id": "65744ffe-c2fd-3182-a807-95b1a1fb5d2a",
                                        "entry_id": "a7247992-b67c-3160-9f72-6ae6e475196d",
                                        "glosses": [
                                            "großer, schwarzer Singvogel mit gelbem Schnabel aus der Familie der Drosseln"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d43e460c-2bc4-495a-a07e-e02884e4d851",
                                                "sense_id": "65744ffe-c2fd-3182-a807-95b1a1fb5d2a",
                                                "text": "Die weibliche Amsel baut dreimal im Jahr ein Nest."
                                            },
                                            {
                                                "example_id": "d04a8114-1e69-4dc7-aff3-ea877fc63c48",
                                                "sense_id": "65744ffe-c2fd-3182-a807-95b1a1fb5d2a",
                                                "text": "„Eine Amsel war auch gekommen.“"
                                            },
                                            {
                                                "example_id": "dd0ed256-5211-48b0-a0b9-841ba12a531d",
                                                "sense_id": "65744ffe-c2fd-3182-a807-95b1a1fb5d2a",
                                                "text": "„Die Sonne scheint milde, ein Duft von Frühling würzt die Luft, Rotkehlchen perlen ihre Lieder, die Amseln flöten, und sogar Lerchen tirilieren bereits.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
