                        ],
                        "form": "brandweertje"
                    },
                    {
                        "form_id": "45f02475-5f06-4cba-b181-4a319021bd5e",
                        "entry_id": "eeb3919d-869a-33a3-b76f-3b546519e984",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "brandweertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1ba6499-363d-39bb-bbb0-65d3a19766bd",
                        "entry_id": "eeb3919d-869a-33a3-b76f-3b546519e984",
                        "glosses": [
                            "instantie die zich bezighoudt met het voorkomen en bestrijden van branden en het redden van mensen of dieren"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "dac1390f-c91a-4186-b44f-30b8f18dcb2e",
                                "sense_id": "a1ba6499-363d-39bb-bbb0-65d3a19766bd",
                                "text": "Canada heeft op moederdag hulp gekregen van Moeder Natuur. Dankzij lichte regen en dalende temperaturen breidden de aanhoudende natuurbranden in de provincie Alberta zich minder snel uit dan verwacht. De brandweer zegt voor het eerst grip te krijgen op de situatie."
                            },
                            {
                                "example_id": "512890af-7cd3-4ed3-a6c2-28df9dc6dc52",
                                "sense_id": "a1ba6499-363d-39bb-bbb0-65d3a19766bd",
                                "text": "Door snel ingrijpen van de brandweer is een grote bosbrand in het Almelose Nijreesbos dinsdagmiddag voorkomen."
                            },
                            {
                                "example_id": "8acd97f6-0125-4eb1-bed5-f383e465b281",
                                "sense_id": "a1ba6499-363d-39bb-bbb0-65d3a19766bd",
                                "text": "Als het huis in de fik vloog, nam hij waarschijnlijk niet eens de moeite om de brandweer te bellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8f053ec-bfff-4a5e-9b46-d3dc6f0c6a7b",
                        "source_entry_id": "eeb3919d-869a-33a3-b76f-3b546519e984",
                        "source_sense_id": "a1ba6499-363d-39bb-bbb0-65d3a19766bd",
                        "target_lang_word": "Feuerwehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                        "entry_id": "1bcfff13-c540-3cda-9db1-e3153f01ff87",
                                        "glosses": [
                                            "berufsmäßig oder freiwillig aufgebaute Mannschaft zur Brandbekämpfung, für Notfälle, Katastrophenschutz und andere Aufgaben"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffbad37-1be4-4c4b-b135-a59a8f4a9d95",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Er sei Mitglied der deutschen Feuerwehr und werde für die nächsten Wahlen seine Einschreibung in den deutschen Wahlkataster veranlassen.“"
                                            },
                                            {
                                                "example_id": "15365904-02fb-4d3c-8fff-73b9284c621a",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "Ein Nachbar alarmierte rasch die Feuerwehr."
                                            },
                                            {
                                                "example_id": "49315789-e46b-4fec-ba6a-49cf8bea4f09",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Ein Grossbrand in einem Wolkenkratzer von Dubai hält die Feuerwehr kurz vor dem Jahreswechsel in Atem.“"
                                            },
                                            {
                                                "example_id": "8fa9e16a-6f47-40e3-916f-c637439c9d05",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Instinktiv löste Carlos in diesem Moment den Alarm für die Feuerwehr aus.“"
                                            },
                                            {
                                                "example_id": "948ee618-1247-4323-b360-5f00f42157db",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Keine Feuerwehren rückten aus, keiner schleppte Wassereimer, um zu löschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                        "entry_id": "1bcfff13-c540-3cda-9db1-e3153f01ff87",
                                        "glosses": [
                                            "Mitglieder der Feuerwehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca0eeaa-e0f0-4b4b-b549-457c1f007b68",
                                                "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                                "text": "Die Feuerwehr kommt."
                                            },
                                            {
                                                "example_id": "03e84c8f-302a-43ba-90ac-efa36d6d021b",
                                                "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                                "text": "„Wo immer es loderte, rückte die Feuerwehr aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96b28a50-47ad-3c14-a703-b1734f73c476",
                                        "entry_id": "1bcfff13-c540-3cda-9db1-e3153f01ff87",
                                        "glosses": [
                                            "für Löschfahrzeuge und andere Fahrzeuge der ^([1]) und aus dem Bestand von ^([2])"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f65d8b-70b6-4672-b449-2cab6804e373",
                                                "sense_id": "96b28a50-47ad-3c14-a703-b1734f73c476",
                                                "text": "In die Feuerwehr passen vier Leute plus Fahrer und Beifahrer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
