                "senses": [
                    {
                        "sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                        "entry_id": "3191a9b2-0a86-341e-a7a9-bd2fe789103e",
                        "glosses": [
                            "Plan, wie man etwas hinter sich lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0928b7fe-e92c-463d-bef3-a3a080b36fbd",
                                "sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                                "text": "„Welche Exit-Strategie tatsächlich gewählt wird, hängt von mehreren Faktoren ab.“"
                            },
                            {
                                "example_id": "c650e5f3-7991-4a25-86fe-24ddb7152dcc",
                                "sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                                "text": "„Alle Aktivitäten mit Einfluss auf die Exit-Strategie werden weniger zielstrebig betrieben und sind in ihrem Umfang geringer ausgeprägt.“"
                            },
                            {
                                "example_id": "cff17dc7-c4e9-4738-8aa1-5a890c84977c",
                                "sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                                "text": "„Der Finanzinvestor hat anders als der strategische Käufer eine Exit-Strategie, die es ihm erlaubt, das Unternehmen nach 3 oder 4 Jahren mit Gewinn zu verkaufen oder an die Börse zu bringen.“"
                            },
                            {
                                "example_id": "7b6e47a6-bce5-4dc3-8f44-0c75b1bf01ce",
                                "sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                                "text": "„Auch die führenden deutschen Ökonomen sind sich uneinig über die Exit-Strategie aus den Corona-Maßnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "965484cb-df20-42cc-bc69-2ff1f05a5e43",
                        "source_entry_id": "3191a9b2-0a86-341e-a7a9-bd2fe789103e",
                        "source_sense_id": "0c657636-87b9-3605-ae1b-b00afc208bba",
                        "source_sense_description": "Plan, wie man etwas hinter sich lässt",
                        "target_lang_word": "exit strategy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exit strategy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                        "entry_id": "51cbd800-35e4-373b-831c-fc9d9cb67a28",
                                        "glosses": [
                                            "A well-defined plan for bringing involvement in a mission, activity, or commitment to an acceptable conclusion."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc67225-2289-4c21-b66a-5837a192a89b",
                                                "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                                "text": "Near-synonym: exit policy"
                                            },
                                            {
                                                "example_id": "120933a9-c21e-447d-a29f-a97f602fb113",
                                                "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                                "text": "Seeking an exit strategy before sailing in harm's way is smart, but it must be related to the mission's goal."
                                            },
                                            {
                                                "example_id": "474e421f-fb0b-4f3e-8c52-51c9c2b3d823",
                                                "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                                "text": "\"But most of all, we need an exit strategy so that we know what victory is and how we can get there.\""
                                            },
                                            {
                                                "example_id": "d695a11a-b775-41d6-8a3e-e1db3cc67948",
                                                "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                                "text": "Mergers, acquisitions and IPOs are no longer a reliable exit strategy with capital markets tanking and buyers wary."
                                            },
                                            {
                                                "example_id": "a382c5db-2c6d-4c51-af7b-3942b9fbc92a",
                                                "sense_id": "79f3dadb-60b8-334f-9179-c8f996157c00",
                                                "text": "“If your question is, ‘Do I think we should be more aggressive with Belarus,” my answer is no,” he said, emphasizing that Western leaders needed to offer Mr. Lukashenko an “exit strategy.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
