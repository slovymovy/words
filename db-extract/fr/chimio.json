                        ],
                        "examples": [
                            {
                                "example_id": "beebb0ff-b429-4a6e-bdf4-4470c5c8bcd8",
                                "sense_id": "3290e73f-d921-3b6b-bb51-695e13a8ac65",
                                "text": "C’était très difficile de lui faire accepter la chimio."
                            },
                            {
                                "example_id": "cbcd964f-ed21-475c-97aa-c4dfbf17644a",
                                "sense_id": "3290e73f-d921-3b6b-bb51-695e13a8ac65",
                                "text": "Mais, dans la mesure où les premières séances de chimio sont passées sans trop de mal, j’ai décidé d’être aussi présent sur les Cross Battles."
                            },
                            {
                                "example_id": "6d50a6fc-45c2-47ab-9da5-43aa638c8c0b",
                                "sense_id": "3290e73f-d921-3b6b-bb51-695e13a8ac65",
                                "text": "Tout au long des mois de chimio et de radiothérapie, Murielle était mon soleil. Toujours avec moi pour mes traitements."
                            }
                        ]
                    }
                ],
