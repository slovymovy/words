                ],
                "senses": [
                    {
                        "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                        "entry_id": "ded86334-5385-35e4-bc78-67c0550a5cd9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d941196f-0bab-42aa-89d2-58317f0eede6",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Frau Gericke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "863f6204-04bb-4038-b44e-34c799317422",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Herr Gericke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "46f8292a-a430-4345-aabe-fe97968df3bd",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Die Gerickes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "34583cad-22f2-4719-b6cd-2969d6371367",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Der Gericke trägt nie die Schals, die die Gericke ihm strickt."
                            },
                            {
                                "example_id": "f3bfedb8-468e-4f38-a6a1-56b2d27e6ed6",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gericke kommt, geht der Herr Gericke.“"
                            },
                            {
                                "example_id": "939fa322-959c-4aae-bef0-a1e81bbe1e28",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Gericke kommt und geht."
                            },
                            {
                                "example_id": "65bbb4c0-d613-4836-97f4-94eb57be000e",
                                "sense_id": "dc31800e-22ea-3667-abd0-258d5892116b",
                                "text": "Gerickes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
