                "senses": [
                    {
                        "sense_id": "b9e6c99e-1ec0-33b4-aaf8-cac264aa98ec",
                        "entry_id": "8e1f4f3e-7d28-36bd-a73b-1fd527db512a",
                        "glosses": [
                            "Versuch, einen Umsturz herbeizuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ea667f-02f6-4ff9-a919-1d442a78709e",
                                "sense_id": "b9e6c99e-1ec0-33b4-aaf8-cac264aa98ec",
                                "text": "„Nachdem der Umsturzversuch scheiterte, ging die Regierung mit Härte gegen Oppositionelle und potenzielle Putschisten vor.“"
                            },
                            {
                                "example_id": "3c38d091-c025-4617-9cf0-4733daec391b",
                                "sense_id": "b9e6c99e-1ec0-33b4-aaf8-cac264aa98ec",
                                "text": "„Einen Umsturzversuch der USA und Südkoreas in Nordkorea werde China aber verhindern, hieß es in der chinesischen Zeitung \"Global Times\".“"
                            },
                            {
                                "example_id": "50ef2ad7-3cfe-47c0-914f-8660af38b72b",
                                "sense_id": "b9e6c99e-1ec0-33b4-aaf8-cac264aa98ec",
                                "text": "„Erstes prominentes Opfer war der frühere Premierminister Maiwandwal, dem ein Umsturzversuch vorgeworfen wurde; er wurde 1973 festgenommen und beging nach offizieller Lesart Selbstmord.“"
                            }
                        ],
