                        "glosses": [
                            "Resembling a peach, peach-like."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917b511c-08f6-4c60-8e4b-ecbbeacd456f",
                                "sense_id": "09333091-35f6-3817-b149-f57e6621b2fb",
                                "text": "Although this is an apricot pie, it tastes peachy."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9d94e43-edfe-3c54-949c-9f9c0a4ecf8b",
                        "entry_id": "a945ab45-bb4b-3113-986e-1f321e0f55db",
                        "glosses": [
                            "Very good, excellent, typically used sarcastically to indicate a state of misery, resentment or great frustration."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ac136631-01ab-4381-9271-87958382e4a8",
                                "sense_id": "a9d94e43-edfe-3c54-949c-9f9c0a4ecf8b",
                                "text": "Oh, life is just peachy now that winter has come, it’s snowing all the time, and I’m freezing my backside off"
                            }
                        ]
                    }
                ],
                "translations": [
