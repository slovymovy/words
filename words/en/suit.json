{
    "word_family": [
        "suitable",
        "suitability",
        "suitor",
        "suitcase",
        "unsuitable",
        "lawsuit",
        "swimsuit",
        "bodysuit",
        "tracksuit",
        "pantsuit",
        "jumpsuit"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                    "sense_definition": "To be convenient or acceptable for someone; to fit someone's needs or schedule.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Does the meeting time <w>suit</w> you, or should we reschedule for later?",
                            "target_lang_translations": {
                                "ru": "Вам <w>подходит</w> время встречи или нам стоит перенести её на попозже?"
                            }
                        },
                        {
                            "text": "This new job <w>suits</w> me perfectly because I can work from home.",
                            "target_lang_translations": {
                                "ru": "Эта новая работа мне идеально <w>подходит</w>, потому что я могу работать из дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "agree"
                    ],
                    "common_phrases": [
                        "suit your needs",
                        "suit everyone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть удобным или приемлемым для кого-либо; соответствовать чьим-либо потребностям или графику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "быть удобным по времени или условиям"
                            },
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "быть приемлемым для кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff83c152-ef99-3a59-adfc-82ac461ab91f",
                    "sense_definition": "To look good on someone or be appropriate for their appearance or image.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That blue dress really <w>suits</w> you and brings out your eyes.",
                            "target_lang_translations": {
                                "ru": "Это синее платье тебе очень <w>идет</w> и подчеркивает твои глаза."
                            }
                        },
                        {
                            "text": "Short hair doesn't <w>suit</w> her as much as long hair does.",
                            "target_lang_translations": {
                                "ru": "Короткие волосы ей не так <w>идут</w>, как длинные."
                            }
                        }
                    ],
                    "synonyms": [
                        "match"
                    ],
                    "common_phrases": [
                        "suit you well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо смотреться на ком-либо или соответствовать чьему-либо внешнему виду или имиджу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "быть к лицу"
                            },
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "соответствовать внешности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                    "sense_definition": "To be appropriate, apt, or right for a particular purpose or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nickname Bullet <w>suits</w> her because she is such a fast runner.",
                            "target_lang_translations": {
                                "ru": "Прозвище Пуля ей <w>подходит</w>, потому что она очень быстро бегает."
                            }
                        },
                        {
                            "text": "We need to find a venue that <w>suits</w> the formal nature of the event.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти место, которое <w>соответствует</w> официальному характеру мероприятия."
                            }
                        }
                    ],
                    "synonyms": [
                        "match",
                        "answer"
                    ],
                    "common_phrases": [
                        "suit the occasion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть уместным, подходящим или правильным для конкретной цели или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "соответствовать ситуации или цели"
                            },
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть уместным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2053698a-2372-371e-9b8f-f4a124b09524",
                    "sense_definition": "To correspond or be in harmony with something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriateness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His actions do not <w>suit</w> with the promises he made during the campaign.",
                            "target_lang_translations": {
                                "ru": "Его действия не <w>согласуются</w> с обещаниями, которые он давал во время кампании."
                            }
                        },
                        {
                            "text": "The somber music <w>suited</w> the mood of the rainy afternoon.",
                            "target_lang_translations": {
                                "ru": "Мрачная музыка <w>соответствовала</w> настроению дождливого дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "agree",
                        "match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствовать или находиться в гармонии с чем-либо другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "гармонировать с чем-либо"
                            },
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в согласии с чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d39b93-2931-3dc6-84ab-6ae708f432b2",
                    "sense_definition": "To adapt or modify something to make it appropriate for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>suit</w> the action to the word to be a convincing actor.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>сообразовывать</w> действие со словом, чтобы быть убедительным актером."
                            }
                        },
                        {
                            "text": "The curriculum was <w>suited</w> to meet the needs of advanced students.",
                            "target_lang_translations": {
                                "ru": "Учебная программа была <w>адаптирована</w> под нужды продвинутых студентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suit the action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Адаптировать или изменять что-либо, чтобы сделать это подходящим для конкретной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспосабливать",
                                "target_lang_sense_clarification": "адаптировать под нужды"
                            },
                            {
                                "target_lang_word": "сообразовывать",
                                "target_lang_sense_clarification": "приводить в соответствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c93220-584c-3fb9-ae43-71e3872a817a",
                    "sense_definition": "To dress or clothe someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights were <w>suited</w> in heavy armor before the battle began.",
                            "target_lang_translations": {
                                "ru": "Рыцари были <w>облачены</w> в тяжелые доспехи перед началом битвы."
                            }
                        },
                        {
                            "text": "He was <w>suited</w> in his finest silks for the royal banquet.",
                            "target_lang_translations": {
                                "ru": "Он был <w>одет</w> в свои лучшие шелка для королевского банкета."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать или облачать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачать",
                                "target_lang_sense_clarification": "одевать в специальную одежду"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "одевать в доспехи или форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53fb9601-97f2-3f58-8f65-3615cbfb0f69",
                    "sense_definition": "A set of matching clothes, typically including a jacket and trousers or a skirt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a dark blue <w>suit</w> to his job interview.",
                            "target_lang_translations": {
                                "ru": "На собеседование он надел темно-синий <w>костюм</w>."
                            }
                        },
                        {
                            "text": "Nick decided to hire a navy-blue <w>suit</w> for the wedding.",
                            "target_lang_translations": {
                                "ru": "Ник решил взять напрокат темно-синий <w>костюм</w> на свадьбу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "business suit",
                        "three-piece suit",
                        "wear a suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комплект подходящей друг к другу одежды, обычно включающий пиджак и брюки или юбку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "комплект одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16085acb-0ac5-3c1e-acc3-6a40acbf7123",
                    "sense_definition": "Any of the four sets in a deck of playing cards (spades, hearts, diamonds, or clubs).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hearts is my favorite <w>suit</w> when playing this card game.",
                            "target_lang_translations": {
                                "ru": "Черви — моя любимая <w>масть</w> в этой карточной игре."
                            }
                        },
                        {
                            "text": "You must play a card of the same <w>suit</w> if you have one.",
                            "target_lang_translations": {
                                "ru": "Вы должны ходить картой той же <w>масти</w>, если она у вас есть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow suit",
                        "card suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из четырех наборов в колоде игральных карт (пики, черви, бубны или трефы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масть",
                                "target_lang_sense_clarification": "категория карт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c90cbf8-7d7f-390a-8432-49ab8c5d6e97",
                    "sense_definition": "A specialized set of garments for a specific activity, such as a space <w>suit</w> or swim<w>suit</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronaut checked his space <w>suit</w> for leaks before the walk.",
                            "target_lang_translations": {
                                "ru": "Астронавт проверил свой <w>скафандр</w> на герметичность перед выходом."
                            }
                        },
                        {
                            "text": "Don't forget to pack your swim <w>suit</w> for the beach trip.",
                            "target_lang_translations": {
                                "ru": "Не забудь упаковать <w>купальник</w> для поездки на пляж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "space suit",
                        "diving suit",
                        "protective suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированный набор одежды для определенной деятельности, например, скафандр или купальник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "специальная одежда"
                            },
                            {
                                "target_lang_word": "комбинезон",
                                "target_lang_sense_clarification": "цельный защитный костюм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d543f1-9930-3279-bb0f-be6fbd53e995",
                    "sense_definition": "A process in a court of law where one person or party claims a right or seeks a remedy; a lawsuit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is facing a <w>suit</w> for breach of contract.",
                            "target_lang_translations": {
                                "ru": "Компании грозит <w>иск</w> за нарушение контракта."
                            }
                        },
                        {
                            "text": "If you take my advice, you will file a <w>suit</w> against him immediately.",
                            "target_lang_translations": {
                                "ru": "Если вы послушаете моего совета, вы немедленно подадите на него в <w>суд</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "file a suit",
                        "civil suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс в суде, в ходе которого лицо или сторона заявляет о праве или требует возмещения; судебный иск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иск",
                                "target_lang_sense_clarification": "судебное требование"
                            },
                            {
                                "target_lang_word": "тяжба",
                                "target_lang_sense_clarification": "судебное разбирательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                    "sense_definition": "A person who works in business or management, often used to imply they are boring or corporate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>suits</w> from the head office are coming to inspect the factory.",
                            "target_lang_translations": {
                                "ru": "<w>Пиджаки</w> из головного офиса едут с проверкой на завод."
                            }
                        },
                        {
                            "text": "He didn't want to be just another one of the <w>suits</w> in a skyscraper.",
                            "target_lang_translations": {
                                "ru": "Он не хотел быть просто очередным <w>белым воротничком</w> в небоскребе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate suits"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used disparagingly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, работающий в бизнесе или управлении, часто используется для обозначения скучного корпоративного сотрудника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белый воротничок",
                                "target_lang_sense_clarification": "офисный работник"
                            },
                            {
                                "target_lang_word": "пиджак",
                                "target_lang_sense_clarification": "пренебрежительно о чиновнике или бизнесмене"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aba063ad-b249-3ac3-9b99-c4baf4af8a4a",
                    "sense_definition": "The act of trying to win someone's love or hand in marriage; courtship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pressed his <w>suit</w> with flowers and poetry, hoping to win her heart.",
                            "target_lang_translations": {
                                "ru": "Он настойчиво <w>ухаживал</w>, даря цветы и стихи, надеясь завоевать её сердце."
                            }
                        },
                        {
                            "text": "After months of persistent <w>suit</w>, she finally agreed to marry him.",
                            "target_lang_translations": {
                                "ru": "После месяцев настойчивых <w>ухаживаний</w> она наконец согласилась выйти за него замуж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "press your suit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "more common in literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка завоевать чью-то любовь или руку и сердце; ухаживание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сватанье",
                                "target_lang_sense_clarification": "предложение брака"
                            },
                            {
                                "target_lang_word": "ухаживание",
                                "target_lang_sense_clarification": "попытка добиться расположения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eddf3856-4040-301b-9d1e-76ab639cd48f",
                    "sense_definition": "A formal request or petition made to a person of high rank.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The humble peasant brought a <w>suit</w> before the king for justice.",
                            "target_lang_translations": {
                                "ru": "Смиренный крестьянин предстал перед королем с <w>прошением</w> о правосудии."
                            }
                        },
                        {
                            "text": "She made a <w>suit</w> to the governor to pardon her brother.",
                            "target_lang_translations": {
                                "ru": "Она обратилась к губернатору с <w>ходатайством</w> о помиловании брата."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная просьба или прошение, обращенное к лицу высокого ранга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прошение",
                                "target_lang_sense_clarification": "официальное обращение"
                            },
                            {
                                "target_lang_word": "ходатайство",
                                "target_lang_sense_clarification": "официальная просьба"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "79c9c1c0-1290-34cd-8130-29ba9ecc0d81",
                    "sense_definition": "A family name or <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Suit</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Сьют</w> жила в этом городе на протяжении многих поколений."
                            }
                        },
                        {
                            "text": "He introduced himself as Mr. <w>Suit</w>.",
                            "target_lang_translations": {
                                "ru": "Он представился как мистер <w>Сьют</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сьют",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}