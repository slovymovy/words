{
    "word_family": [
        "concerted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9c94ba4-a092-39c3-b6f5-65cde9bfc27f",
                    "sense_definition": "A public musical performance in which several performers or instruments take part.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought two tickets for the rock <w>concert</w> next Friday.",
                            "target_lang_translations": {
                                "ru": "Я купил два билета на рок-<w>концерт</w> в следующую пятницу.",
                                "zh": "我买了下周五摇滚<w>音乐会</w>的两张票。"
                            }
                        },
                        {
                            "text": "The band played a live <w>concert</w> in the city park.",
                            "target_lang_translations": {
                                "ru": "Группа дала живой <w>концерт</w> в городском парке.",
                                "zh": "乐队在城市公园里举办了一场现场<w>音乐会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gig",
                        "show",
                        "performance"
                    ],
                    "common_phrases": [
                        "rock concert",
                        "live concert",
                        "give a concert",
                        "concert hall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное музыкальное представление, в котором участвуют несколько исполнителей или инструментов.",
                        "zh": "一种公开的音乐表演，由多名表演者或多种乐器参与。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концерт",
                                "target_lang_sense_clarification": "музыкальное мероприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音乐会",
                                "target_lang_sense_clarification": "正式的音乐表演"
                            },
                            {
                                "target_lang_word": "演唱会",
                                "target_lang_sense_clarification": "流行歌手的音乐表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0d7e7d-8a1f-3a53-a8ce-b21496a4adc9",
                    "sense_definition": "Agreement in design, plan, or action; harmony or union formed by mutual communication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police worked in <w>concert</w> with local officials to solve the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция действовала в <w>согласии</w> с местными властями, чтобы раскрыть преступление.",
                                "zh": "警方与当地官员<w>协作</w>破获了这起案件。"
                            }
                        },
                        {
                            "text": "There was a lack of <w>concert</w> between the different departments.",
                            "target_lang_translations": {
                                "ru": "Между различными отделами не хватало <w>согласованности</w>.",
                                "zh": "各部门之间缺乏<w>协调</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in concert",
                        "in concert with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласие в замыслах, планах или действиях; гармония или единство.",
                        "zh": "在设计、计划或行动上达成一致；通过相互沟通形成的和谐或联合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласие",
                                "target_lang_sense_clarification": "единство мнений"
                            },
                            {
                                "target_lang_word": "согласованность",
                                "target_lang_sense_clarification": "гармония действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "协作",
                                "target_lang_sense_clarification": "共同配合行动"
                            },
                            {
                                "target_lang_word": "一致",
                                "target_lang_sense_clarification": "意见或行动上的统一"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b30bced-398a-3552-a84b-f6a205a6f267",
                    "sense_definition": "To plan, arrange, or devise something together by mutual agreement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaders <w>concerted</w> a plan to improve the economy.",
                            "target_lang_translations": {
                                "ru": "Лидеры <w>согласовали</w> план по улучшению экономики.",
                                "zh": "领导人们<w>商定</w>了一项改善经济的计划。"
                            }
                        },
                        {
                            "text": "They <w>concerted</w> their efforts to ensure the project was a success.",
                            "target_lang_translations": {
                                "ru": "Они <w>скоординировали</w> свои усилия, чтобы гарантировать успех проекта.",
                                "zh": "他们<w>协调</w>各自的努力以确保项目成功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "concert a plan",
                        "concert measures"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать, устраивать или разрабатывать что-либо совместно по взаимному согласию.",
                        "zh": "通过相互协议共同计划、安排或设计某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласовывать",
                                "target_lang_sense_clarification": "приходить к общему мнению"
                            },
                            {
                                "target_lang_word": "координировать",
                                "target_lang_sense_clarification": "упорядочивать действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "协调",
                                "target_lang_sense_clarification": "使各方配合一致"
                            },
                            {
                                "target_lang_word": "商定",
                                "target_lang_sense_clarification": "共同商量并确定"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}