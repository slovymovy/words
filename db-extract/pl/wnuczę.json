                                        "examples": [
                                            {
                                                "example_id": "170624f5-92cd-4c1b-bfdd-6f519197fa77",
                                                "sense_id": "77c9e3e8-66b1-32b7-93fa-3e64d521c335",
                                                "text": "Babičce přišla popřát k narozeninám všechna vnoučata."
                                            },
                                            {
                                                "example_id": "be7b8497-1075-4152-acc7-0486ee3885bb",
                                                "sense_id": "77c9e3e8-66b1-32b7-93fa-3e64d521c335",
                                                "text": "Dědové bývají zábavní, nejsou při hlídání vnoučat úzkostní na každou maličkost, sem tam nějaké to ušpinění je nestresuje, ve společnosti vnoučat bývají hraví a stávají se z nich znovu kluci. Pro děti je báječné, když se podaří dobrý vztah s oběma dědečky vybudovat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
