        "fr-extract.jsonl": [
            {
                "entry_id": "feaf586c-2eaf-3082-a0d2-445c676c449c",
                "word": "épidermique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8991a6a7-0deb-47bc-92cf-4f08c7021de0",
                        "entry_id": "feaf586c-2eaf-3082-a0d2-445c676c449c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "épidermiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5c94319-07b4-3f02-b7e1-b0cc02fb68b5",
                        "entry_id": "feaf586c-2eaf-3082-a0d2-445c676c449c",
                        "glosses": [
                            "Qui intéresse l’épiderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98af062-ac55-4b50-bc2d-eeffe6c69e2f",
                                "sense_id": "f5c94319-07b4-3f02-b7e1-b0cc02fb68b5",
                                "text": "[…] ; mais on conçoit qu'une lésion ainsi limitée à la base du cheveu, sans fracture du cheveu, sans déglabration de la plaque, sans lésion épidermique, ne soit pour ainsi dire jamais remarquée"
                            },
                            {
                                "example_id": "8b88442e-34dc-4f6f-a09e-ffe0c83c85b5",
                                "sense_id": "f5c94319-07b4-3f02-b7e1-b0cc02fb68b5",
                                "text": "La barrière épidermique, fonction vitale pour l'organisme, est assurée par la couche cornée de l'épiderme."
                            }
                        ]
                    },
                    {
                        "sense_id": "db8b8a3c-78b3-3759-a532-7d99e14bed20",
                        "entry_id": "feaf586c-2eaf-3082-a0d2-445c676c449c",
                        "glosses": [
                            "Vif et immédiat, en parlant d’une réaction."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4f4bc946-a7b9-4436-a9da-4163840b9f19",
                                "sense_id": "db8b8a3c-78b3-3759-a532-7d99e14bed20",
                                "text": "C'est le racisme, inné ou répandu par l'usage commun, que l'on pourrait qualifier de sentimental ou d’épidermique et qui n'est qu'une forme de l’allophobie c'est-à-dire de la crainte de ceux qui sont autres, comme le sont aussi la xénophobie, l’esprit de clocher, etc."
                            },
                            {
                                "example_id": "8815f480-c1bf-44df-8771-4e512374742c",
                                "sense_id": "db8b8a3c-78b3-3759-a532-7d99e14bed20",
                                "text": "Naturellement, on pense de façon épidermique, que la nouvelle idéologie aura pour tâche essentielle de désintellectualiser et de désélitiser l’École, donc de supprimer ce coût-là, du moment que la masse des individus aura l’accès libre devant l’Enseignement secondaire et devant l’Enseignement supérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87acb24c-df28-49a0-932b-6d6d6b9b09d4",
                        "source_entry_id": "feaf586c-2eaf-3082-a0d2-445c676c449c",
                        "target_lang_word": "oberflächlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oberflächlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a989871-b9b5-3b29-8602-fc8123c87269",
                                        "entry_id": "0e87d6cc-58e7-3457-b7a3-a9e4d4b88be5",
                                        "glosses": [
                                            "die Oberfläche eines Gegenstandes oder einer Sache betreffend, sich auf die Oberfläche beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84e5dcd-4d33-4478-b6d6-0558a64e36bf",
                                                "sense_id": "2a989871-b9b5-3b29-8602-fc8123c87269",
                                                "text": "Die Berge waren oberflächlich von Schnee bedeckt."
                                            },
                                            {
                                                "example_id": "75e4c17a-e881-442b-879f-497f0f1759cf",
                                                "sense_id": "2a989871-b9b5-3b29-8602-fc8123c87269",
                                                "text": "Aus Krampfadern kann eine oberflächliche Venenentzündung entstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                        "entry_id": "0e87d6cc-58e7-3457-b7a3-a9e4d4b88be5",
                                        "glosses": [
                                            "nicht gründlich oder auch nicht gründlich genug, nur das Äußere beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611a86d6-b2ff-4417-bfa8-bf619b556ce4",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Eine hingeschluderte Arbeit nennt man oberflächlich."
                                            },
                                            {
                                                "example_id": "ad1be78d-126f-4273-a84c-155064668110",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Er hat viele Tiere und kann sich nicht um jedes kümmern, kann nur oberflächlich arbeiten."
                                            },
                                            {
                                                "example_id": "644b68be-eefb-4314-9a14-c82443b3b176",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Oberflächlich betrachtet, ist die Frage schnell zu beantworten, aber wenn man weiter nachdenkt, wird es schwieriger."
                                            },
                                            {
                                                "example_id": "10b86f5e-5f32-4a1b-ae03-24bd6eb588b6",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Die Frage der Finanzierung wurde nur oberflächlich gestreift."
                                            },
                                            {
                                                "example_id": "d5835093-c320-45cb-959c-63138900c405",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Leider ist seine neue Freundin ein recht oberflächlicher Mensch, sie hat nur Mode und Disko im Kopf."
                                            },
                                            {
                                                "example_id": "fa84a82e-8bca-4e01-a26c-8bec048afcea",
                                                "sense_id": "f62c9a4e-2f10-3d58-b2d8-d39dbc997101",
                                                "text": "Welch ein oberflächlicher Angeber!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
