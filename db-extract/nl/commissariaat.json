                                        "entry_id": "6e4f6ad2-7996-3d3b-9210-3a30f455b952",
                                        "glosses": [
                                            "Dienststelle eines Kommissars beziehungsweise der Polizei, vor allem der Kriminalpolizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904ca105-e78b-49e0-a719-3a20b265a221",
                                                "sense_id": "879b1c0a-bb69-3502-b241-47f252f22169",
                                                "text": "„Eben darauf warteten wir, als ich einen Anruf von Inspektor Dávila erhielt, der mein Erscheinen in Begleitung meines Sekretärs und Buchhalters auf dem Kommissariat erwünschte.“"
                                            }
