                "senses": [
                    {
                        "sense_id": "8d061701-dc70-34fc-9d95-9a438d6178ca",
                        "entry_id": "85b882c6-02f6-3bd5-9df8-5b40304a79f8",
                        "glosses": [
                            "Kennwert, der die Durchschnittsrendite aller inländischen, bereits emittierten Anleihen erster Bonität (vor allem Staatsanleihen) angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c2a37b9-8e9e-4e90-900b-55a420425410",
                                "sense_id": "8d061701-dc70-34fc-9d95-9a438d6178ca",
                                "text": "„Dabei kommen Indizes wie der Euribor (Interbanken-Geldmarktsatz für eine Woche, sowie für Ein- bis Zwölf-Monatsgelder) oder die Sekundärmarktrendite (aus den Renditen der am Sekundärmarkt umlaufenden Forderungspapiere wird regelmäßig die durchschnittliche Sekundärmarkt-Rendite ermittelt) in Frage.“"
                            },
                            {
                                "example_id": "c936c849-2573-49d6-8691-eb3d11628eeb",
                                "sense_id": "8d061701-dc70-34fc-9d95-9a438d6178ca",
                                "text": "„Ein bisschen plakativ gesprochen (die Sekundärmarktrendite bezieht sich ja nicht auf neu ausgegebene Anleihen), muss man also bereits dafür bezahlen, der Schweiz Geld leihen zu dürfen.“"
                            },
                            {
                                "example_id": "9e7cee59-969d-4fc5-9012-77420b3e4fb6",
                                "sense_id": "8d061701-dc70-34fc-9d95-9a438d6178ca",
                                "text": "„Mit 1. April ist die Sekundärmarktrendite inländische Banken ausgelaufen – eine Kennzahl des Kapitalmarktes, die die Durchschnittsverzinsung von Anleihen angezeigt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
