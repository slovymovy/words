                "senses": [
                    {
                        "sense_id": "15f07bec-6101-3d9d-aa44-871590e28c6c",
                        "entry_id": "bfe3b8b3-e159-3740-a5fc-a45a7e5388d0",
                        "glosses": [
                            "grotesk-witziges, aus fünf Zeilen bestehendes Gedicht mit dem festen Reimschema AABBA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e026c7-2ce2-4986-8844-4c19b575bec8",
                                "sense_id": "15f07bec-6101-3d9d-aa44-871590e28c6c",
                                "text": "Ein Beispiel für einen deutschen Limerick:",
                                "translation": "„Nach dem Krieg fand im Essen in Peine\nein Gast eine Kippe, ’ne kleine.\nDer Ober drauf fix:\n»Mann, sagen Sie nix,\nsonst wollen die andern auch eine!«“"
                            },
                            {
                                "example_id": "952a47d8-6720-4b40-a1e1-aba629308910",
                                "sense_id": "15f07bec-6101-3d9d-aa44-871590e28c6c",
                                "text": "„Ein Indiz dafür ist die Tatsache, daß mehrere große Zeitungen ihre Spalten für regelmäßige Einsendungen von Limericks offenhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb25ca5-8c2c-4d50-a01a-838f5e56594e",
                        "source_entry_id": "bfe3b8b3-e159-3740-a5fc-a45a7e5388d0",
                        "source_sense_id": "15f07bec-6101-3d9d-aa44-871590e28c6c",
                        "source_sense_description": "grotesk-witziges, aus fünf Zeilen bestehendes Gedicht mit dem festen Reimschema AABBA",
                        "target_lang_word": "limerick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limerick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                        "entry_id": "9c43ee59-db35-3a1b-818a-c72a38723e17",
                                        "glosses": [
                                            "A humorous, often bawdy verse of five anapaestic lines, with the rhyme scheme aabba, and typically having an 8–8–5–5–8 cadence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8a02e9-5abb-42bb-8c0a-c688eb9e6aca",
                                                "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                                "text": "The limerick, it would appear,\nIs a verse form we owe Edward Lear;\nTwo long and two short\nLines rhymed, as was taught,\nAnd a fifth just to bring up the rear."
                                            },
                                            {
                                                "example_id": "52b698f9-4da9-4695-9d7a-2c32ffba3a7b",
                                                "sense_id": "37d2d56a-9fe9-3c63-933a-5627bb75f851",
                                                "text": "Take a look. That’s Buffy, Muffy, and Fluffy.\nDo they have anything in common other than names you could write a limerick around?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
