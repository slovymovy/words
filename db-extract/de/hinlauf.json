                ],
                "senses": [
                    {
                        "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                        "entry_id": "d24b6f16-5ab7-317b-938d-3c4798933dd0",
                        "glosses": [
                            "Hinlaufen zu einer bestimmten Stelle; Bewegung auf etwas hin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d25cdf5-c7f3-4924-9b74-488a76b51e48",
                                "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                                "text": "„Beim Hinlauf wird im Prozeß I dem Gas Wärme aus einem höher temperierten Wärmebehälter zugeführt und im Prozeß III an einen tiefer temperierten Wärmebehälter abgegeben.“"
                            },
                            {
                                "example_id": "92884f05-a9af-4114-837c-fe2a429c9b51",
                                "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                                "text": "„Bei jedem Rücklauf wird der Strahlstrom unterbrochen, so daß nur die beim Hinlauf geschriebenen Zeilen sichtbar sind.“"
                            },
                            {
                                "example_id": "76dc2ab7-0949-4668-90e5-d84e59992511",
                                "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                                "text": "„Der Rücklauf des Schlittens erfolgt in der Regel dreimal so schnell als der Hinlauf.“"
                            },
                            {
                                "example_id": "d3cc669b-f9da-464b-abf0-291854bc9705",
                                "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                                "text": "„Beim Hinlauf zu positiven Potentialen laufen Oxidationsreaktionen ab, beim Rücklauf zu negativen Potentialen Reduktionsreaktionen.“"
                            },
                            {
                                "example_id": "9f7abf5e-efbe-499f-89f2-78ffeeb22aa8",
                                "sense_id": "3badff73-77d2-37d5-b5b5-e5499c290ff0",
                                "text": "„Erfolgt der Hinlauf über die Katheten eines rechtwinkligen Dreiecks, der Rücklauf dagegen in Richtung der Hypotenuse, liegen die Suchpunkte genau in der durch den Pythagoras-Satz gegebenen Entfernung vom Start.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
