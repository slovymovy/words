                ],
                "senses": [
                    {
                        "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                        "entry_id": "c14aa5d9-4acf-3f3a-bdc9-3a421d8c577e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45eb431-8cb6-46cd-8d4a-3e4a5d3cbae0",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Frau Händle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "05f4dc6c-471d-45c1-b302-f6d67cdcd4fa",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Herr Händle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1c7b47fc-9f01-42c7-ad4e-f00e945173f1",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Die Händles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ea634b89-d253-4f5d-a22d-4618712ba181",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Der Händle trägt nie die Schals, die die Händle ihm strickt."
                            },
                            {
                                "example_id": "38e7b5b3-5edf-40cd-8b55-4800bc750523",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Händle kommt, geht der Herr Händle.“"
                            },
                            {
                                "example_id": "eac6a7a7-7a22-4e8b-8eca-80dd7149416f",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Händle kommt und geht."
                            },
                            {
                                "example_id": "afcb8de7-8cdd-45a9-b309-88db2ae3e425",
                                "sense_id": "e78dd7b9-53e0-3b7b-a026-b2d56c2a4bb9",
                                "text": "Händles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
