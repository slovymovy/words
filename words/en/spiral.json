{
    "word_family": [
        "spirally",
        "spiralize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85e00c9b-e8e3-316b-a9d4-ccfcd1a61cbe",
                    "sense_definition": "A shape or line that curves around a central point, moving further away from it as it goes around, or a shape that winds around a cylinder like a screw.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smoke rose in a lazy <w>spiral</w> from the chimney.",
                            "target_lang_translations": {
                                "ru": "Дым ленивой <w>спиралью</w> поднимался из трубы.",
                                "zh": "烟雾从烟囱里悠闲地升起，形成了一道<w>螺旋</w>。"
                            }
                        },
                        {
                            "text": "She drew a perfect <w>spiral</w> in the center of the page.",
                            "target_lang_translations": {
                                "ru": "Она нарисовала идеальную <w>спираль</w> в центре страницы.",
                                "zh": "她在页面中央画了一个完美的<w>螺旋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "helix",
                        "curl",
                        "twist",
                        "whirl"
                    ],
                    "common_phrases": [
                        "draw a spiral",
                        "spiral galaxy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма или линия, которая изгибается вокруг центральной точки, удаляясь от неё по мере вращения, или форма, обвивающая цилиндр, подобно винту.",
                        "zh": "一种围绕中心点弯曲并逐渐远离的形状或线条，或者像螺丝一样缠绕在圆柱体上的形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спираль",
                                "target_lang_sense_clarification": "форма или линия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "螺旋",
                                "target_lang_sense_clarification": "指螺旋状的物体或线条"
                            },
                            {
                                "target_lang_word": "螺旋线",
                                "target_lang_sense_clarification": "指几何上的螺旋形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d25c56d-09f8-3989-8b0d-3d442ba0eabc",
                    "sense_definition": "A continuous change in a situation, usually getting worse and becoming difficult to control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company went into a downward <w>spiral</w> of debt and mismanagement.",
                            "target_lang_translations": {
                                "ru": "Компания вошла в нисходящую <w>спираль</w> долгов и бесхозяйственности.",
                                "zh": "这家公司陷入了债务和管理不善的<w>恶性循环</w>。"
                            }
                        },
                        {
                            "text": "High inflation can trigger an economic <w>spiral</w> that hurts everyone.",
                            "target_lang_translations": {
                                "ru": "Высокая инфляция может спровоцировать экономическую <w>спираль</w>, которая ударит по всем.",
                                "zh": "高通胀可能引发伤害每个人的经济<w>恶性循环</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "downward spiral",
                        "death spiral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывное изменение ситуации, обычно в худшую сторону, которое становится трудно контролировать.",
                        "zh": "指情况持续恶化且难以控制的连锁反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спираль",
                                "target_lang_sense_clarification": "перен. цепная реакция, обострение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶性循环",
                                "target_lang_sense_clarification": "指情况不断变坏的循环"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d29d377-39d3-35cf-83a4-afa2f2e541d2",
                    "sense_definition": "To move in a winding path that circles around a central point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle <w>spiraled</w> down from the sky to catch its prey.",
                            "target_lang_translations": {
                                "ru": "Орел <w>спустился по спирали</w> с неба, чтобы схватить добычу.",
                                "zh": "老鹰从天空中<w>盘旋</w>而下，去捕捉猎物。"
                            }
                        },
                        {
                            "text": "Dead leaves <w>spiraled</w> to the ground in the autumn breeze.",
                            "target_lang_translations": {
                                "ru": "Мертвые листья, <w>кружась</w>, падали на землю на осеннем ветру.",
                                "zh": "枯叶在秋风中<w>盘旋</w>着落向地面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "swirl",
                        "twist"
                    ],
                    "common_phrases": [
                        "spiral down",
                        "spiral up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться по извилистой траектории, кружась вокруг центральной точки.",
                        "zh": "沿着围绕中心点的弯曲路径移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигаться по спирали",
                                "target_lang_sense_clarification": "перемещаться винтообразно"
                            },
                            {
                                "target_lang_word": "кружить",
                                "target_lang_sense_clarification": "летать или двигаться кругами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘旋",
                                "target_lang_sense_clarification": "指绕着圈移动"
                            },
                            {
                                "target_lang_word": "螺旋式移动",
                                "target_lang_sense_clarification": "指以螺旋轨迹运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c39db768-7f97-3bbb-8466-55e15eb25deb",
                    "sense_definition": "To increase, decrease, or change rapidly and uncontrollably.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project costs began to <w>spiral</w> out of control very quickly.",
                            "target_lang_translations": {
                                "ru": "Расходы на проект начали очень быстро <w>стремительно расти</w> и выходить из-под контроля.",
                                "zh": "项目成本开始迅速<w>失控</w>。"
                            }
                        },
                        {
                            "text": "Violence <w>spiraled</w> in the city following the controversial decision.",
                            "target_lang_translations": {
                                "ru": "Насилие в городе <w>стремительно возросло</w> после спорного решения.",
                                "zh": "在那项充满争议的决定之后，城里的暴力事件<w>急剧上升</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "escalate",
                        "soar",
                        "plunge"
                    ],
                    "antonyms": [
                        "stabilize"
                    ],
                    "common_phrases": [
                        "spiral out of control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и неконтролируемо увеличиваться, уменьшаться или изменяться.",
                        "zh": "指数值或情况迅速且失控地增加、减少或变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремительно расти",
                                "target_lang_sense_clarification": "о ценах, расходах"
                            },
                            {
                                "target_lang_word": "выходить из-под контроля",
                                "target_lang_sense_clarification": "становиться неуправляемым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "急剧上升",
                                "target_lang_sense_clarification": "指数值快速增长"
                            },
                            {
                                "target_lang_word": "失控",
                                "target_lang_sense_clarification": "指情况变得无法管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eefa05ff-ec7e-372f-8bfd-d089b8ccf8db",
                    "sense_definition": "To throw or kick a ball so that it spins around its axis as it flies.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quarterback <w>spiraled</w> the ball perfectly into the receiver's hands.",
                            "target_lang_translations": {
                                "ru": "Квотербек идеально <w>закрутил</w> мяч прямо в руки принимающего.",
                                "zh": "四分卫将球完美地<w>旋转投掷</w>到了接球手手中。"
                            }
                        },
                        {
                            "text": "You need to practice if you want to <w>spiral</w> a football correctly.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно тренироваться, если хочешь правильно <w>закручивать</w> футбольный мяч.",
                                "zh": "如果你想正确地<w>旋转投掷</w>橄榄球，你需要多加练习。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать или пинать мяч так, чтобы он вращался вокруг своей оси во время полета.",
                        "zh": "投掷或踢球时使其在飞行过程中绕轴旋转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закручивать",
                                "target_lang_sense_clarification": "бросать с вращением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转投掷",
                                "target_lang_sense_clarification": "指带旋转的投球动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "685a4c3b-c804-3393-a9c4-ce00e762d2f3",
                    "sense_definition": "Having the shape of a curve that winds around a central point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We climbed the narrow <w>spiral</w> staircase to reach the top of the tower.",
                            "target_lang_translations": {
                                "ru": "Мы поднялись по узкой <w>винтовой</w> лестнице, чтобы добраться до вершины башни.",
                                "zh": "我们爬上狭窄的<w>螺旋形</w>楼梯到达了塔顶。"
                            }
                        },
                        {
                            "text": "Every student needs a <w>spiral</w> notebook for the math class.",
                            "target_lang_translations": {
                                "ru": "Каждому ученику нужна тетрадь на <w>спирали</w> для уроков математики.",
                                "zh": "每个学生都需要一本<w>螺旋式</w>笔记本上数学课。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coiled",
                        "helical",
                        "winding",
                        "twisted"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "spiral staircase",
                        "spiral notebook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму кривой, которая огибает центральную точку.",
                        "zh": "具有围绕中心点弯曲的形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винтовой",
                                "target_lang_sense_clarification": "о лестнице"
                            },
                            {
                                "target_lang_word": "спиральный",
                                "target_lang_sense_clarification": "имеющий форму спирали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "螺旋形的",
                                "target_lang_sense_clarification": "形容物体的形状"
                            },
                            {
                                "target_lang_word": "螺旋式的",
                                "target_lang_sense_clarification": "形容结构或排列方式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}