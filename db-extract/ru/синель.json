                                "example_id": "00a68b18-e603-470a-ad96-7a63d5521747",
                                "sense_id": "6016553a-cfbf-3e23-9411-72b0445fbd32",
                                "text": "Между тем Северин, вместо того чтоб, идти домой, пробрался тайно в сад и скрылся за кустом синели подле самого крыльца."
                            },
                            {
                                "example_id": "9993f867-2f75-4417-b5d6-1671efc4e2ff",
                                "sense_id": "6016553a-cfbf-3e23-9411-72b0445fbd32",
                                "text": "Набресть на свежий дух синели."
                            }
                        ]
                    }
