                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4ff2558-573c-37f5-9062-53c61deb4702",
                        "entry_id": "520c9223-ae81-3c85-b0a5-2fa197854525",
                        "glosses": [
                            "de maaltijd die men 's avonds nuttigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3978e27b-4db1-44a4-84dd-24739c5f38f4",
                                "sense_id": "d4ff2558-573c-37f5-9062-53c61deb4702",
                                "text": "Wij eten 's-avonds zo lekker en uitgebreid dat we het avondmaal steevast een diner noemen."
                            },
                            {
                                "example_id": "b8adb1a0-f4a7-4843-90ec-4837f69b1388",
                                "sense_id": "d4ff2558-573c-37f5-9062-53c61deb4702",
                                "text": "'Geysery my friend,' roept hij verheugd, me begroetend alsof we elkaar maanden niet hebben gezien, terwijl ik vanmiddag nog aan zijn lange keukentafel heb gezeten om te zien welke schotel hij ging bereiden voor het avondmaal (moshari kokkinisto, kalfsvlees in tomatensaus)."
                            },
                            {
                                "example_id": "d12be133-290a-4816-87ab-234c11c2300d",
                                "sense_id": "d4ff2558-573c-37f5-9062-53c61deb4702",
                                "text": "Het was weer eens een lange, hete dag en ik stopte pas toen ik in een diepe kloof bij een kleine poel met stilstaand groen water aankwam waar het stikte van de muggen. Ik filterde zo snel mogelijk een liter water voor mijn avondmaal en zocht een wat hogerop gelegen plek in de hoop daar wat minder last van de insecten te hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "4566906b-d976-36dd-82d3-9c52728da0c5",
                        "entry_id": "520c9223-ae81-3c85-b0a5-2fa197854525",
                        "glosses": [
                            "de rituele viering van het laatste avondmaal dat Jesus met zijn leerlingen nuttigde voor zijn terechtstelling aan het kruis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c9f877-0ce6-45e4-89fe-7dcd801cb53a",
                                "sense_id": "4566906b-d976-36dd-82d3-9c52728da0c5",
                                "text": "In protestantse kerken wordt niet iedere zondag avondmaal gevierd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58398cb6-5ebc-4196-a821-b9121311657e",
                        "source_entry_id": "520c9223-ae81-3c85-b0a5-2fa197854525",
                        "source_sense_id": "d4ff2558-573c-37f5-9062-53c61deb4702",
                        "source_sense_description": "de maaltijd die men 's avonds nuttigt",
                        "target_lang_word": "Abendessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abendessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                        "entry_id": "848de6f5-7ded-373e-b095-26226c7e9f9b",
                                        "glosses": [
                                            "Mahlzeit, die zu Tagesende verzehrt wird"
                                        ],
                                        "tags": [
                                            "in Teilen Nord- und Ostdeutschlands sowie in der Schweiz warme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ac30fb-3c1e-4e7b-b4ed-0af1bbdb4e35",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Zum Abendessen gibt es heute einen besonders guten Wein."
                                            },
                                            {
                                                "example_id": "2db83211-22c1-4175-afe4-09cb42f71a67",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Während des Abendessens möchten wir nicht gestört werden."
                                            },
                                            {
                                                "example_id": "7adc6140-e4d8-4941-908f-1bca1e8be959",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "Die Abendessen fallen bei uns nicht so reichhaltig aus wie die anderen Mahlzeiten."
                                            },
                                            {
                                                "example_id": "b0b113e6-13ff-49ab-928d-d13f4b515551",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Die abendlichen Wanderungen hatten mir einen ordentlichen Muskelkater beschert, und so war ich heilfroh, dass ich zu meinem Abendessen mit Ton nicht auch noch radeln musste.“"
                                            },
                                            {
                                                "example_id": "307b0f6a-c4a4-44a0-8080-08e8bbf48dc1",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Es macht ihm anscheinend nichts aus, daß er zum Frühstück Kaffee-Ersatz trinken und sich beim Abendessen mit Schwarzbrot in Wasser begnügen muß.“"
                                            },
                                            {
                                                "example_id": "e785b458-0c02-4661-927d-25981d89eb98",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Das Abendessen war kurz und lief ab wie gewohnt.“"
                                            },
                                            {
                                                "example_id": "48cfa21b-9906-46e0-9d22-36459cea486a",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Bevor er zum Abendessen ging, blätterte er gedankenverloren in Ruges Text.“"
                                            },
                                            {
                                                "example_id": "495632f8-4b98-4924-9e03-e1629f5fc368",
                                                "sense_id": "6d5a538e-9a41-31b3-ae4e-4a421042f0be",
                                                "text": "„Ein Abendessen mit einem befreundeten Verlagsvertreter veränderte alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c45bdc4-5ac1-46a2-8fd1-f1295b280e37",
                        "source_entry_id": "520c9223-ae81-3c85-b0a5-2fa197854525",
