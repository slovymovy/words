                "senses": [
                    {
                        "sense_id": "3b52da4e-32ea-3306-bd61-87c6bb6e9b05",
                        "entry_id": "7a5ab74b-031c-34cf-b2c1-cdb542e1d3f3",
                        "glosses": [
                            "Donner un caractère apocryphe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d64454-4589-437d-aacd-cee2590a7a5e",
                                "sense_id": "3b52da4e-32ea-3306-bd61-87c6bb6e9b05",
                                "text": "La plupart des traductions omettent ce passage, qui a suffi à lui seul pour apocryphiser le livre, car il pourrait justifier l'esclavagisme et la fellation."
                            },
                            {
                                "example_id": "311de7c8-83ea-4a40-92c1-7e7e33419fbc",
                                "sense_id": "3b52da4e-32ea-3306-bd61-87c6bb6e9b05",
                                "text": "Pffffff, va falloir que j'apocryphise."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c12fbac-616e-368e-a7b5-b54e21b853e8",
                        "entry_id": "7a5ab74b-031c-34cf-b2c1-cdb542e1d3f3",
                        "glosses": [
                            "Qualifier [quelque chose] d'apocryphe, en dénier l'authenticité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3de359-86f5-413f-9aad-8c120fe80838",
                                "sense_id": "0c12fbac-616e-368e-a7b5-b54e21b853e8",
                                "text": "Toutes les sources doivent être retenues et traitées de la même manière, qu’elles relèvent du corpus canonisé ou du corpus apocryphisé, d’autant que le phénomène du canon est à considérer sur un temps long et non sur un temps bref, ce dernier supposant une autorité centralisée qui n’existe cependant pas aux IIe-IIIe siècles comme ce sera le cas à partir du IVe siècle dans certaines régions de l’Empire romain – ce même si certaines communautés chrétiennes possèdent dès la fin du IIe siècle un canon de leurs Écritures saintes à l’exemple du document de Muratori [37]"
                            }
                        ]
                    }
