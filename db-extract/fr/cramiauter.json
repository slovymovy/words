                ],
                "senses": [
                    {
                        "sense_id": "b7bf32b2-969e-31cd-95a5-34f252417dfa",
                        "entry_id": "b597a8ea-4595-34af-b5ea-884acdef3c9f",
                        "glosses": [
                            "Cracher."
                        ],
                        "tags": [
                            "Beaujolais",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "e3b84ca0-da6d-48d6-9a1f-b628be508409",
                                "sense_id": "b7bf32b2-969e-31cd-95a5-34f252417dfa",
                                "text": "Il existe sinon des produits anti-buée évitant de cramiauter sur sa voiture."
                            },
                            {
                                "example_id": "3ff0bf6a-4f99-42c1-9726-afa1f8ad1cf6",
                                "sense_id": "b7bf32b2-969e-31cd-95a5-34f252417dfa",
                                "text": "Ça, mon Blacheuon il l’a pas oublié, et crois moi qu’il préfèrerait lui cramiauter à la gueule plutôt que d’lui serrer la main."
                            },
                            {
                                "example_id": "8a41903e-f70d-4e64-b77a-3da620ce28cf",
                                "sense_id": "b7bf32b2-969e-31cd-95a5-34f252417dfa",
                                "text": "En tout cas, comptez pas sur moi pour aller saluer leur cuchon d’gras qui leur sert de président : quand on m’cramiaute sur la gueule, j’ai pas l’habitude d’aller faire des gâtés derrière."
                            }
                        ]
                    }
