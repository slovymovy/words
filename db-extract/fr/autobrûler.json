                "senses": [
                    {
                        "sense_id": "c80e7a4f-ccf1-38db-8f80-44e60dcc6dcd",
                        "entry_id": "6af4c51f-9cfc-33a7-83f8-69a2c520b2c7",
                        "glosses": [
                            "Se brûler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8a8192-fccd-4b75-992d-0e8cac2881d8",
                                "sense_id": "c80e7a4f-ccf1-38db-8f80-44e60dcc6dcd",
                                "text": "On dirait le cratère d'un volcan éteint dont les lèvres sont béantes, qui a craché son feu a l'intérieur comme pour mieux se détruire lui-même, s’autobrûler jusqu’à la mort intime et l’anéantissement total."
                            },
                            {
                                "example_id": "d0e2dfc2-f119-4fc5-86e1-f1bf892ad5c6",
                                "sense_id": "c80e7a4f-ccf1-38db-8f80-44e60dcc6dcd",
                                "text": "Ils ne sont pas fous, ils ne vont pas s’autobrûler, oui bon je sais c'est du cliché."
                            },
                            {
                                "example_id": "6807f561-7805-4e07-ae2f-616f31aeff37",
                                "sense_id": "c80e7a4f-ccf1-38db-8f80-44e60dcc6dcd",
                                "text": "On ne peut pas répondre trop tôt, sauf si on est du genre à s’autobrûler par over-intensité."
                            },
                            {
                                "example_id": "d6998fc9-49dd-47cc-9376-365093e593ab",
                                "sense_id": "c80e7a4f-ccf1-38db-8f80-44e60dcc6dcd",
                                "text": "D’ailleurs, la réalité a confirmé cette hypothèse et le four a déjà fonctionné sans apport de fuel en autobrûlant des boues à 40 % de matières sèches dont 37 % seulement de matières organiques."
                            }
                        ]
                    }
