                                                "text": "Der Seehase treibt Brutpflege."
                                            },
                                            {
                                                "example_id": "7f23f58e-eea3-465e-9a56-51543c9a587f",
                                                "sense_id": "b25325f3-3517-3424-9dc2-1d7d4afffd62",
