{
    "word_family": [
        "immunity",
        "immunize",
        "immunization",
        "immunology",
        "immunologist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aaaa3a24-db4a-33e6-a7b7-6a0ddc971814",
                    "sense_definition": "Protected against a particular disease or infection, usually by vaccination or natural resistance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>immune</w> to chicken pox because I had it as a child.",
                            "target_lang_translations": {
                                "ru": "Я <w>невосприимчив</w> к ветрянке, потому что переболел ею в детстве.",
                                "zh": "我小时候得过水痘，所以现在对它<w>免疫</w>。"
                            }
                        },
                        {
                            "text": "The vaccine makes people <w>immune</w> to the virus for several years.",
                            "target_lang_translations": {
                                "ru": "Вакцина делает людей <w>невосприимчивыми</w> к вирусу на несколько лет.",
                                "zh": "这种疫苗能让人在几年内对该病毒产生<w>免疫力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resistant",
                        "protected"
                    ],
                    "antonyms": [
                        "susceptible",
                        "vulnerable",
                        "nonimmune"
                    ],
                    "common_phrases": [
                        "immune to infection",
                        "immune to disease",
                        "immune to virus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищённый от определённой болезни или инфекции, обычно благодаря вакцинации или естественной сопротивляемости.",
                        "zh": "指对某种疾病或感染具有抵抗力，通常是通过接种疫苗或自然免疫获得的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невосприимчивый",
                                "target_lang_sense_clarification": "обладающий сопротивляемостью к болезни"
                            },
                            {
                                "target_lang_word": "иммунный",
                                "target_lang_sense_clarification": "обладающий иммунитетом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "免疫",
                                "target_lang_sense_clarification": "对疾病具有抵抗力"
                            },
                            {
                                "target_lang_word": "有免疫力",
                                "target_lang_sense_clarification": "具备抵抗某种疾病的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43754261-3966-3d92-b569-0415215b9663",
                    "sense_definition": "Relating to the body's system for fighting infection and disease.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A healthy <w>immune</w> system is essential for fighting off colds.",
                            "target_lang_translations": {
                                "ru": "Здоровая <w>иммунная</w> система необходима для борьбы с простудой.",
                                "zh": "健康的<w>免疫</w>系统对于抵御感冒至关重要。"
                            }
                        },
                        {
                            "text": "We examined the patient's <w>immune</w> response to the new treatment.",
                            "target_lang_translations": {
                                "ru": "Мы изучили <w>иммунный</w> ответ пациента на новое лечение.",
                                "zh": "我们检查了患者对新疗法的<w>免疫</w>反应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "immune system",
                        "immune response",
                        "immune deficiency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к системе организма, предназначенной для борьбы с инфекциями и болезнями.",
                        "zh": "与人体抵御感染和疾病的系统有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иммунный",
                                "target_lang_sense_clarification": "относящийся к иммунитету (напр. система, ответ)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "免疫",
                                "target_lang_sense_clarification": "与免疫系统相关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e17e5845-fd55-3b4d-84a3-f0c37ea6e42e",
                    "sense_definition": "Officially excused from a duty, law, or punishment that applies to others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a diplomat, she is <w>immune</w> from prosecution in this country.",
                            "target_lang_translations": {
                                "ru": "Как дипломат, она <w>неприкосновенна</w> для судебного преследования в этой стране.",
                                "zh": "作为外交官，她在该国享有司法<w>豁免</w>权。"
                            }
                        },
                        {
                            "text": "No citizen should be <w>immune</w> from the laws of the land.",
                            "target_lang_translations": {
                                "ru": "Ни один гражданин не должен быть <w>освобождён</w> от законов страны.",
                                "zh": "任何公民都不应<w>豁免</w>于国家法律之外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exempt",
                        "protected"
                    ],
                    "common_phrases": [
                        "immune from prosecution",
                        "immune from suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально освобождённый от обязанностей, законов или наказаний, применимых к другим.",
                        "zh": "正式免除适用于他人的义务、法律或惩罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприкосновенный",
                                "target_lang_sense_clarification": "защищённый от преследования (о дипломатах)"
                            },
                            {
                                "target_lang_word": "освобождённый",
                                "target_lang_sense_clarification": "избавленный от обязанности или ответственности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "豁免",
                                "target_lang_sense_clarification": "免除责任或惩罚"
                            },
                            {
                                "target_lang_word": "不受……影响",
                                "target_lang_sense_clarification": "指在法律上享有特权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a53cf74c-1a27-3026-9599-be6efeffd66a",
                    "sense_definition": "Not affected, upset, or influenced by something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seems completely <w>immune</w> to criticism from his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он кажется совершенно <w>невосприимчивым</w> к критике своих коллег.",
                                "zh": "他似乎完全<w>不受</w>同事批评的影响。"
                            }
                        },
                        {
                            "text": "The new electronic device is <w>immune</w> to water damage.",
                            "target_lang_translations": {
                                "ru": "Новое электронное устройство <w>устойчиво</w> к повреждению водой.",
                                "zh": "这款新电子设备具有防水功能，<w>耐</w>水损。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impervious",
                        "resistant",
                        "unsusceptible"
                    ],
                    "antonyms": [
                        "susceptible",
                        "vulnerable",
                        "affectable"
                    ],
                    "common_phrases": [
                        "immune to criticism",
                        "immune to charms",
                        "immune to logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подверженный влиянию, воздействию или расстройству от чего-либо.",
                        "zh": "不受某事的影响、干扰或触动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невосприимчивый",
                                "target_lang_sense_clarification": "равнодушный к воздействию (напр. к критике)"
                            },
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "способный выдержать воздействие (напр. к воде)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不受……影响",
                                "target_lang_sense_clarification": "对某事无动于衷或不被干扰"
                            },
                            {
                                "target_lang_word": "耐",
                                "target_lang_sense_clarification": "指对某种物理损害具有抵抗力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de41bde0-731b-3e7e-9045-556e14530c7f",
                    "sense_definition": "A person who is not susceptible to infection by a particular disease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study tracked the number of <w>immunes</w> in the population after the outbreak.",
                            "target_lang_translations": {
                                "ru": "В исследовании отслеживалось количество <w>лиц с иммунитетом</w> в популяции после вспышки.",
                                "zh": "这项研究追踪了疫情爆发后人群中<w>免疫者</w>的数量。"
                            }
                        },
                        {
                            "text": "Vaccination campaigns aim to increase the ratio of <w>immunes</w> to susceptibles.",
                            "target_lang_translations": {
                                "ru": "Кампании по вакцинации направлены на увеличение соотношения <w>иммунных</w> и восприимчивых.",
                                "zh": "疫苗接种运动旨在提高<w>免疫者</w>与易感人群的比例。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in technical or epidemiological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, невосприимчивый к заражению определённой болезнью.",
                        "zh": "对某种特定疾病具有免疫力的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо с иммунитетом",
                                "target_lang_sense_clarification": "человек, имеющий иммунитет"
                            },
                            {
                                "target_lang_word": "иммунный",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "免疫者",
                                "target_lang_sense_clarification": "具有免疫力的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "725955e0-3ed6-381b-9748-f7e2261019ff",
                    "sense_definition": "To make someone resistant to a disease.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor hoped the treatment <w>immuned</w> the patient against the fever.",
                            "target_lang_translations": {
                                "ru": "Врач надеялся, что лечение <w>иммунизировало</w> пациента против лихорадки.",
                                "zh": "医生希望这种治疗能使病人对这种热病产生<w>免疫</w>。"
                            }
                        },
                        {
                            "text": "Natural exposure often <w>immunes</w> the population over time.",
                            "target_lang_translations": {
                                "ru": "Естественный контакт с инфекцией часто <w>иммунизирует</w> население с течением времени.",
                                "zh": "随着时间的推移，自然接触往往会使人群产生<w>免疫</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "modern usage prefers 'immunize'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо устойчивым к болезни.",
                        "zh": "使某人对某种疾病产生抵抗力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иммунизировать",
                                "target_lang_sense_clarification": "создавать иммунитет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……免疫",
                                "target_lang_sense_clarification": "赋予免疫能力"
                            },
                            {
                                "target_lang_word": "免疫",
                                "target_lang_sense_clarification": "指通过医学手段产生抗体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}