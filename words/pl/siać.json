                            "comment": "obecnie częściej używa się formy przesiewać"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пропускать сыпучий материал через сито для очистки или разделения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "муку, песок через сито"
                            },
                            {
                                "target_lang_word": "просеивать",
                                "target_lang_sense_clarification": "через сито"
                            }
                        ]
                    }
                },
                {
