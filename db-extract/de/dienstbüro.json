                "senses": [
                    {
                        "sense_id": "ec8c06f3-dbb8-3be3-a0e0-08767549e121",
                        "entry_id": "6dde2698-49a0-303d-b8ed-8ef89dcd8c9c",
                        "glosses": [
                            "Büro, in dem jemand seinen Dienst verrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a4eb255-b3d8-4964-876b-cbf3e97e89ba",
                                "sense_id": "ec8c06f3-dbb8-3be3-a0e0-08767549e121",
                                "text": "„Im Zentralen Dienstbüro Hermeskeil begrüßen Sie die Pfarrsekretärinnen (…).“"
                            },
                            {
                                "example_id": "50582607-63f8-4418-8658-9ef8e8d79e24",
                                "sense_id": "ec8c06f3-dbb8-3be3-a0e0-08767549e121",
                                "text": "„Das Gemeinsame Dienstbüro der ACA-Gemeinschaft in der deutschsprachigen Region (Deutschland, Österreich, Schweiz) berät und beschließt Angelegenheiten, die ACA in der Region als Ganzes betreffen und wählt die Bediensteten für die überregionalen Dienste.“"
                            },
                            {
                                "example_id": "4816b11d-6727-47c3-876d-3bb84fdc8afd",
                                "sense_id": "ec8c06f3-dbb8-3be3-a0e0-08767549e121",
                                "text": "„Er erfuhr, daß der Soldat, übrigens ein junges Gesicht mit einem Käppi, in Roberts Dienstbüro verständigt worden war, daß Herr Doktor Lindhoff bis über den Abend hin sich hier aufhalte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
