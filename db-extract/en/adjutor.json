                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a5fbc45-860e-3395-adad-bf779a2daaba",
                        "entry_id": "2ae221ab-2c1d-3558-934e-5ba2cbc081a3",
                        "glosses": [
                            "Helfer, Adjutant"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9d58599-e4f0-4c5b-9d01-e0083e46b9ed",
                        "source_entry_id": "2ae221ab-2c1d-3558-934e-5ba2cbc081a3",
                        "source_sense_id": "4a5fbc45-860e-3395-adad-bf779a2daaba",
                        "source_sense_description": "veraltet: Helfer, Adjutant",
                        "target_lang_word": "Helfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                        "entry_id": "1d08b87b-3487-31cd-84ff-5119e1c9a402",
                                        "glosses": [
                                            "Person, die jemanden hilft oder unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e110886a-8b84-491c-bf2c-b95b6fc43f73",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Das THW hat 15 Spezialisten nach Haiti geschickt. Wie die Helfer arbeiten und mit der Belastung umgehen, erzählt Oliver Hochedez aus dem THW-Leitungsstab.“"
                                            },
                                            {
                                                "example_id": "c9f6a856-985d-4c3a-a77a-d28b993bcb8d",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Nach dem doppelten Terroranschlag in der Moskauer Metro mit 39 Toten fahnden die russischen Ermittler nach den Helfern der beiden Selbstmordattentäterinnen.“"
                                            },
                                            {
                                                "example_id": "24640487-5da3-41c4-9214-4d9eeed138e1",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Das unsichtbare Netz der Helfer wird schon tragen.“"
                                            },
                                            {
                                                "example_id": "344eaba6-d340-4c35-9768-a744286f6947",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Diese Helfer aus dem Ausland banden die ganze Gemeinschaft mit ein, angefangen bei in Dörfern lebenden Schülern, die Ältere dazu ermuntern sollten, über die Vergangenheit zu sprechen und Geschichten zu erzählen.“"
                                            },
                                            {
                                                "example_id": "ed54d74f-6e39-45f7-b9e7-bcca92c649cf",
                                                "sense_id": "e9d64fbd-95cd-3d9b-9561-b5ef922983e6",
                                                "text": "„Der Motor des Schleppflugzeugs wird auf Touren gebracht, ein Helfer hebt den Flügel des Segelflugzeuges an, und nun zieht der Motorflieger an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "565cdf7a-9870-3c83-90c7-5a2e3cc100b9",
                                        "entry_id": "1d08b87b-3487-31cd-84ff-5119e1c9a402",
                                        "glosses": [
                                            "eine Sache, die eine Unterstützung bietet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2640f4a-1ddf-43f5-a809-6f16b4f32d27",
                                                "sense_id": "565cdf7a-9870-3c83-90c7-5a2e3cc100b9",
                                                "text": "Seit ich mir ein Netbook gekauft habe, habe ich den kleinen Helfer immer dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c146768-085f-40ee-ad39-2feb200bad2e",
                        "source_entry_id": "2ae221ab-2c1d-3558-934e-5ba2cbc081a3",
                        "source_sense_id": "4a5fbc45-860e-3395-adad-bf779a2daaba",
                        "source_sense_description": "veraltet: Helfer, Adjutant",
                        "target_lang_word": "Adjutant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adjutant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                        "entry_id": "d167015f-59cb-3532-833c-84139fdbfdb6",
                                        "glosses": [
                                            "einem ranghöheren Befehlshaber beigeordneter Offizier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79259dba-4eb4-4205-ab11-e20593f7ac61",
                                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                                "text": "Im Oktober 1856 wurde er zum Leutnant befördert und in der Folge vielfach als Adjutant verwendet."
                                            },
                                            {
                                                "example_id": "e9c62e12-7e31-4439-8757-09733d509ec5",
                                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                                "text": "„Zwei Tage später wurde ich vom persönlichen Adjutanten Ihrer Majestät empfangen.“"
                                            },
                                            {
                                                "example_id": "31502705-1399-4b2f-a164-ab2b2a952e9a",
                                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                                "text": "„Wo sein Adjutant geblieben war, wußte man nicht.“"
                                            },
                                            {
                                                "example_id": "ec31791c-966e-44ee-8cbc-632e06a44658",
                                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                                "text": "„Der Adjutant kam in scharfem Trab geritten.“"
                                            },
                                            {
                                                "example_id": "0e2a4ac9-5267-43d1-a39a-e3824576ad1f",
                                                "sense_id": "712644a4-6474-3190-8834-114772f39ae8",
                                                "text": "„In den Privaträumen nebenan tranken die Sekretärinnen und Adjutanten anschließend einen Schluck auf das frisch getraute Paar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
