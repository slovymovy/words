                        "sense_id": "8acc1bcb-2ebc-3b27-b29f-dd30281f790f",
                        "entry_id": "d176df60-f579-3921-94f6-fa313846ad99",
                        "glosses": [
                            "nördlicher Teil von Kanada mit kälterem Klima"
