                    },
                    {
                        "translation_id": "ecdfd8ba-dc71-4c8e-a821-580ab91457eb",
                        "source_entry_id": "965f5e2b-8fa3-3ded-80fa-7d7b73b47b72",
                        "source_sense_id": "e6512a5b-8b34-35e9-bda1-aab37bf23042",
                        "source_sense_description": "in an unusual manner",
                        "target_lang_word": "непривы́чно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "непривы́чно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "abe93a97-5327-3703-aa4f-6af3940777da",
                                        "entry_id": "3f3926a4-9e33-3192-bb82-8aa7a643ceb0",
                                        "glosses": [
                                            "наречие к непривычный; непривычным образом; иначе, чем было ранее"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d444d76b-0082-4e29-a88b-cebf1c007107",
                                                "sense_id": "abe93a97-5327-3703-aa4f-6af3940777da",
                                                "text": "Потом он облачался в металлические доспехи, которые оказались непривычно тяжёлыми и неуклюжими."
                                            },
                                            {
                                                "example_id": "a44620a4-8bd5-4bfd-9e62-f99c2ab10ba4",
                                                "sense_id": "abe93a97-5327-3703-aa4f-6af3940777da",
                                                "text": "Голос её непривычно звенел, похоже, она была на грани ― срыва, истерики, не знаю чего."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f37c1e-128c-3266-b6f4-11c770435457",
                                        "entry_id": "3f3926a4-9e33-3192-bb82-8aa7a643ceb0",
                                        "glosses": [
                                            "наречие к непривычный; не имея привычки к чему-либо; проявляя незнакомство с чем-либо или неумение делать что-либо"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "343a2edd-3d0a-4cf8-a0ce-62b49299aab0",
                                                "sense_id": "c4f37c1e-128c-3266-b6f4-11c770435457",
                                                "text": "Непривычно поклонилась иконам, перекрестилась и встретила смеющиеся голубые глаза хозяйки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9daa7885-74e3-365f-a02c-80690b86d734",
                                        "entry_id": "3f3926a4-9e33-3192-bb82-8aa7a643ceb0",
                                        "glosses": [
                                            "является непривычным; обозначает ощущение неловкости, новизны, испытываемое кем-либо"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06860809-f515-4ff4-bf6b-6392b8067a7d",
                                                "sense_id": "9daa7885-74e3-365f-a02c-80690b86d734",
                                                "text": "Она не вникала в смысл, ей было непривычно и интересно само то, как он говорит: гладко, красиво, занимательно."
                                            },
                                            {
                                                "example_id": "e8d02448-5da6-4d33-a661-7f1dca9482a9",
                                                "sense_id": "9daa7885-74e3-365f-a02c-80690b86d734",
                                                "text": "Красиво, только непривычно ― козырька нет, кокарда круглая…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
