                "senses": [
                    {
                        "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                        "entry_id": "f15bb8fa-9c82-37f2-b955-d00e9286a241",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed257a05-dcbf-483f-97b6-8d9bad23434a",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Frau Geigert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fec1c8a9-37d7-4bd5-adfb-9a8a90f0f1af",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Herr Geigert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5fab318a-de28-4351-acae-0c9be72b50bb",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Die Geigerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "58ca919c-f7d8-43ae-8f7e-9e2206ac5893",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Der Geigert trägt nie die Schals, die die Geigert ihm strickt."
                            },
                            {
                                "example_id": "cfc59504-f53b-498f-994c-859be7033d70",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geigert kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "1bd30ddd-1fd3-42b2-8cae-b623e08f45cd",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Geigert kommt und geht."
                            },
                            {
                                "example_id": "650300da-11d9-4a3d-881d-29c6d28612ca",
                                "sense_id": "b45c77a4-52ae-3620-9ea1-b11d81dc5bbb",
                                "text": "Geigerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
