                            {
                                "example_id": "ff737c7a-8a54-4d37-bb30-611994643941",
                                "sense_id": "71adbbee-44e5-37a7-9de0-e69505bc3475",
                                "text": "Wat is de invloed van werkkledij op het hedendaagse kleedgedrag? Met deze vraag ging ontwerpster Monique van Heist als gastcurator voor Museum Rotterdam aan de slag. Antwoorden zijn te zien op de expositie ”Werkstijl”."
                            },
                            {
                                "example_id": "be844c7a-720b-4f36-9ead-8f75331d2d31",
                                "sense_id": "71adbbee-44e5-37a7-9de0-e69505bc3475",
                                "text": "De laatste tijd zouden er meer minirokjes en hoge hakken in het straatbeeld verschijnen, wat een teken van toegenomen openheid tegenover het Westen zou zijn. Vanouds lopen vrouwen er in traditionele of in maoïstische werkkledij."
                            }
                        ]
