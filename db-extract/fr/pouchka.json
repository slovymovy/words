                                    },
                                    {
                                        "sense_id": "77b48ec6-c833-32d3-bc42-b38449864f6f",
                                        "entry_id": "ea1afc32-a224-36b9-bebf-dad17ee01bca",
                                        "glosses": [
                                            "(gunning for something or gunning to do something) make a great effort."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
