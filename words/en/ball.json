                            },
                            {
                                "target_lang_word": "клубок",
                                "target_lang_sense_clarification": "смотанные нити или шерсть"
                            },
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "геометрическая поверхность или полый объект"
                            },
                            {
                                "target_lang_word": "шарик",
                                "target_lang_sense_clarification": "маленький круглый предмет"
                            }
                        ],
                        "zh": [
