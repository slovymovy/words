                "senses": [
                    {
                        "sense_id": "731792c8-e03e-3dc8-8a8f-8376c7d7950b",
                        "entry_id": "520141c9-78f8-3cd8-b239-b0f8d8df2716",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8718d338-cb0f-4a1d-8b21-d5c09d716c45",
                                "sense_id": "731792c8-e03e-3dc8-8a8f-8376c7d7950b",
                                "text": "Philippe Beaulieu ne voit aucun problème à utiliser l’eau du robinet pour les nourrissons et les bébés."
                            },
                            {
                                "example_id": "20930acd-6900-454b-9c8e-02e019aa1e86",
                                "sense_id": "731792c8-e03e-3dc8-8a8f-8376c7d7950b",
                                "text": "Les gens qui réduisent ses romans à ça ne l’ont jamais lue, souligne Baptiste Beaulieu auteur et ami de l’écrivaine à succès."
                            },
                            {
                                "example_id": "07c91f2c-ecfe-4553-9cff-1caa1aa0e5bc",
                                "sense_id": "731792c8-e03e-3dc8-8a8f-8376c7d7950b",
                                "text": "À 59 ans, Philippine Leroy-Beaulieu est devenue l’icône du cool pour toute la jeune génération en incarnant Sylvie Grateau, la patronne bitchy d’Emily in Paris."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
