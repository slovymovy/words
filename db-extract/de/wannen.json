        "de-extract.jsonl": [
            {
                "entry_id": "7f56d6d1-7925-329e-a43a-fed9348c4b78",
                "word": "wannen",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                        "entry_id": "7f56d6d1-7925-329e-a43a-fed9348c4b78",
                        "glosses": [
                            "woher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d27bc7-aac9-4451-a955-66d0f9efa71b",
                                "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                                "text": "„Es hat aber niemand gesehen, wo die Speisen gekocht und zubereitet worden; auch niemand die zierlichen und willfährigen Diener gekannt oder Wissenschaft gehabt, wer und wannen sie seien, und jedermann voll großer Verwunderung über all die Anstellung und Bereitschaft gewesen.“"
                            },
                            {
                                "example_id": "ab56dbc0-0876-4173-8ee5-ca1922ee8244",
                                "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                                "text": "„Dein Sohn entflieht – O frag ihn nicht:",
                                "translation": "Wie kommst du und wannen wieder?“"
                            },
                            {
                                "example_id": "dbbded68-826d-4f6f-9617-f05598584373",
                                "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                                "text": "„Albaster war die Mauer, Gold die Zinne,",
                                "translation": "In's Herz und rinnen wird der letzte schwere.“"
                            },
                            {
                                "example_id": "154e01c3-2a1f-40cd-8c5d-dc27b8899776",
                                "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                                "text": "„Er hat so schönes Vorbild gegeben, mit zwei, drei Worten alles zu messen, auf zwei, drei Regimentsformen, denen man's leicht ansieht, wannen und wie eingeschränktes Maßes und Zeitraums sie sind – auf sie alles hinzuführen.“"
                            },
                            {
                                "example_id": "115c5801-d672-46ad-99ab-8f57bba5f0df",
                                "sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                                "text": "„Und hatten drei Festungen und Burgen im Lande, Arentsburg, Tinseborg und Ratsborg, dazu oben bei Heidum einen Wachtturm wohl und fest verwahrt, daß sie allda des Tages sehen konnten, wannen und wo die Feinde wären.“",
                                "translation": "[1 (2)] „Wannen hat er dan, fragte ich, so hohe Geheimnussen erlangt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a87b604b-c6ab-3014-85e9-abbf59e393a2",
                        "entry_id": "7f56d6d1-7925-329e-a43a-fed9348c4b78",
                        "glosses": [
                            "wo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6b323e-ab28-4cb5-b191-c85b89de8b7b",
                                "sense_id": "a87b604b-c6ab-3014-85e9-abbf59e393a2",
                                "text": "„Banckarte sind tapffre Leute;",
                                "translation": "wannen kümmt doch dieses her?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e29970b-92b5-400d-96a3-e66c675a74cf",
                        "source_entry_id": "7f56d6d1-7925-329e-a43a-fed9348c4b78",
                        "source_sense_id": "3a8bbd40-6517-33d1-beb4-a3cd00c6cdc5",
                        "source_sense_description": "woher",
                        "target_lang_word": "whence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                        "entry_id": "982597d0-f102-3379-a34c-f69229e97cb0",
                                        "glosses": [
                                            "From where; from which place or source."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c190e763-fbac-460f-8d98-acd9fb278500",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "Whence came I?"
                                            },
                                            {
                                                "example_id": "327b797f-6d23-408f-af82-06649e0cd063",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "\"Pork\" comes from French, whence we get most of our modern cooking terms."
                                            },
                                            {
                                                "example_id": "8f1bb53c-d505-4534-91f9-a81a90d3c18b",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "Go to whence you came!"
                                            },
                                            {
                                                "example_id": "0dc213a0-7e49-4527-900c-69590fb70abb",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "Ieſus anſwered, and ſaid vnto them, Though I beare record of my ſelfe, yet my record is true: for I know whence I came, and whither I goe: but ye cannot tell whence I come, and whither I goe."
                                            },
                                            {
                                                "example_id": "1d956866-71c9-40f2-b3f5-f05a00abd86d",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "I could plainly diſcover from whence one Family derives a long Chin; why a ſecond hath abounded with Knaves for two Generations, and Fools for two more; why a third happened to be crack-brained, and a fourth to be Sharpers."
                                            },
                                            {
                                                "example_id": "7b8171e6-5ade-411d-93bb-c9dde5913e2a",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "Whence, I often asked myself, did the principle of life proceed?"
                                            },
                                            {
                                                "example_id": "f290798e-1815-4930-bdbc-b70f8be1f0f3",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "[W]hat greatly encouraged me, it was in an opposite direction from that whence the blind man had made his appearance, and whither he had presumably returned."
                                            },
                                            {
                                                "example_id": "02a2913e-7ec3-42d3-af2a-e0e835f17ec0",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "O suitably-attired-in-leather-boots\nHead of a traveller, wherefore seeking whom\nWhence by what way how purposed art thou come\nTo this well-nightingaled vicinity?"
                                            },
                                            {
                                                "example_id": "67974457-5875-4f1b-820f-899c8bc7adae",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deservest all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "adc96f50-6080-46b7-85cb-24ec49447b3e",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "At first I could not tell what this new sound was, nor whence it came, and now it seemed a little noise close by, and now a great noise in the distance. And then it grew nearer and more defined, and in a moment I knew it was the sound of voices talking."
                                            },
                                            {
                                                "example_id": "7bc8be3e-cf4b-4153-8bdb-e45e7e53e6b0",
                                                "sense_id": "0c4cd25d-097d-32f5-87a9-8718a0b96753",
                                                "text": "They swore all the gold should go back\nDeep into the earth whence it came."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afc0fb87-1136-3857-947f-b2e8a2908c9e",
                                        "entry_id": "ca567b5f-0d08-3f8b-bf40-41f8e01a10bc",
                                        "glosses": [
                                            "Used for introducing the result of a fact that has just been stated; thence"
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3f8183-fa09-4057-b9ca-35a50d54c3f2",
                                                "sense_id": "afc0fb87-1136-3857-947f-b2e8a2908c9e",
                                                "text": "The work is slow and dangerous, whence the high costs."
                                            },
                                            {
                                                "example_id": "e7b6c602-3d29-4983-9a40-7b2b4108a1a8",
                                                "sense_id": "afc0fb87-1136-3857-947f-b2e8a2908c9e",
                                                "text": "I scored more than you in the exam, whence we can conclude that I am better at the subject than you are."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
