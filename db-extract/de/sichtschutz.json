                ],
                "senses": [
                    {
                        "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                        "entry_id": "5fd99b59-efa2-3cb5-922a-88d580780b56",
                        "glosses": [
                            "Vorrichtung/Abtrennung, die etwas vor fremden Blicken schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550c3fa2-c023-4643-a1cc-c4b54c04c366",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "Wir pflanzten eine Hecke, um einen Sichtschutz für den Garten zu haben."
                            },
                            {
                                "example_id": "e54e6787-0c46-465b-99bf-1e8f9bc13476",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Ob als Sichtschutz oder als Abgrenzung zum Nachbargrundstück - Hecken eignen sich optimal als Gartenteiler.“"
                            },
                            {
                                "example_id": "5586aa11-9569-4f72-bf88-e20b7f01d409",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Lärchen und Schwarzkiefern dienten auf dem Truppenübungsplatz über Jahrzehnte als militärischer Sichtschutz.“"
                            },
                            {
                                "example_id": "07f4ab13-be65-4994-84d0-aef27e091737",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Der Goldrohrbambus ist sehr gut als Sichtschutz oder Hecke geeignet.“"
                            },
                            {
                                "example_id": "a45389dd-2fbd-45a2-aa08-867df92af9bd",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Zum Wohlfühlen im Garten oder auf dem Balkon gehört für viele ein Sichtschutz.“"
                            },
                            {
                                "example_id": "04c69a9a-0949-4b81-a656-e3cab4edddfc",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Ein Sichtschutz aus Bambusrohren ist einfach selbst zu bauen und bringt viel natürliches Flair in den Außenbereich.“"
                            },
                            {
                                "example_id": "5264da66-94f4-4bb6-ac88-4f6a11734966",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "Holländer haben oft keine Gardinen in den Fenstern, sie verzichten auf einen Sichtschutz."
                            },
                            {
                                "example_id": "563b12fc-c073-46b2-a6b7-675b4e41ac23",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "[Wahlkabine:] „Oftmals hat die Kabine einen bis zur halben Höhe herunterreichenden Vorhang, um den Sichtschutz sicherzustellen.“"
                            },
                            {
                                "example_id": "a655a8d6-70cf-41fc-88b3-241fdd1b9776",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "[Über den dänischen Fußballer Christian Eriksen:] „Kapitän Kjaer war es, der Eriksen nach dessen Zusammenbruch mit seinen Erste-Hilfe-Maßnahmen womöglich das Leben rettete und seine Mitspieler auf dem Rasen als Sichtschutz für den Verunglückten zusammenrief.“"
                            },
                            {
                                "example_id": "5433481a-a84b-41c2-93f5-1365768882e9",
                                "sense_id": "94f9ca2a-cb74-37a3-8244-cfbed397654e",
                                "text": "„Aktivistinnen von Femen haben am internationalen Frauentag an der Hamburger Herbertstraße einen Sichtschutz abmontiert, umso „die sexuelle Ausbeutung von Frauen, Menschenhandel und sexuelle Gewalt anzuprangern“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
