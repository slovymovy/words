{
    "word_family": [
        "fretful",
        "fretfulness",
        "fretwork"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09d64e3f-9c25-3fd9-9b09-6d77c594f8ce",
                    "sense_definition": "A state of anxiety, worry, or irritation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He keeps his mind in a continual <w>fret</w> about the future.",
                            "target_lang_translations": {
                                "de": "Er ist in ständiger <w>Sorge</w> um die Zukunft."
                            }
                        },
                        {
                            "text": "She tried to hide her <w>fret</w> during the difficult meeting.",
                            "target_lang_translations": {
                                "de": "Sie versuchte, ihre <w>Unruhe</w> während des schwierigen Treffens zu verbergen."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxiety",
                        "worry",
                        "agitation"
                    ],
                    "antonyms": [
                        "calm",
                        "peace"
                    ],
                    "common_phrases": [
                        "in a fret"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand von Angst, Sorge oder Gereiztheit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sorge",
                                "target_lang_sense_clarification": "allgemeiner Zustand der Besorgnis"
                            },
                            {
                                "target_lang_word": "Unruhe",
                                "target_lang_sense_clarification": "Zustand der inneren Anspannung"
                            },
                            {
                                "target_lang_word": "Ärger",
                                "target_lang_sense_clarification": "Gefühl von Gereiztheit oder Missmut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad3b627c-1e2c-32c9-9991-f80bf18f109a",
                    "sense_definition": "A small metal bar on the neck of a stringed instrument that marks where to press the string to change the pitch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist pressed his finger firmly against the <w>fret</w> to produce a clear note.",
                            "target_lang_translations": {
                                "de": "Der Gitarrist drückte seinen Finger fest gegen den <w>Bund</w>, um einen klaren Ton zu erzeugen."
                            }
                        },
                        {
                            "text": "The <w>fret</w> was worn down from years of constant playing.",
                            "target_lang_translations": {
                                "de": "Das <w>Bundstäbchen</w> war durch jahrelanges ständiges Spielen abgenutzt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines Metallstäbchen auf dem Griffbrett eines Saiteninstruments, das die Position zur Tonhöhenveränderung markiert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bund",
                                "target_lang_sense_clarification": "Metallsteg auf dem Griffbrett"
                            },
                            {
                                "target_lang_word": "Bundstäbchen",
                                "target_lang_sense_clarification": "präzise Bezeichnung für das einzelne Metallstück"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79292952-c816-3924-8ce4-24bd6ee8bab4",
                    "sense_definition": "An ornamental pattern made of repeated straight lines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient vase was decorated with a delicate geometric <w>fret</w>.",
                            "target_lang_translations": {
                                "de": "Die antike Vase war mit einem feinen geometrischen <w>Mäander</w> verziert."
                            }
                        },
                        {
                            "text": "The architect included a traditional <w>fret</w> design along the ceiling border.",
                            "target_lang_translations": {
                                "de": "Der Architekt fügte ein traditionelles <w>Fries</w>-Design entlang der Deckenkante hinzu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pattern",
                        "ornament"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein dekoratives Muster aus wiederholten geraden Linien."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mäander",
                                "target_lang_sense_clarification": "spezifisches geometrisches Ornament"
                            },
                            {
                                "target_lang_word": "Fries",
                                "target_lang_sense_clarification": "dekoratives Band an Wänden oder Decken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c018cf0-3100-37d0-b37c-f10717495596",
                    "sense_definition": "To be anxious or worried about something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>fret</w> over things you cannot change.",
                            "target_lang_translations": {
                                "de": "Mach dir keine <w>Sorgen</w> über Dinge, die du nicht ändern kannst."
                            }
                        },
                        {
                            "text": "She <w>fretted</w> about the exam results all weekend.",
                            "target_lang_translations": {
                                "de": "Sie hat sich das ganze Wochenende wegen der Prüfungsergebnisse <w>gegrämt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "worry",
                        "agonize"
                    ],
                    "antonyms": [
                        "relax"
                    ],
                    "common_phrases": [
                        "fret over"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich wegen etwas Sorgen machen oder beunruhigt sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich sorgen",
                                "target_lang_sense_clarification": "sich Gedanken machen"
                            },
                            {
                                "target_lang_word": "sich grämen",
                                "target_lang_sense_clarification": "sich über längere Zeit bekümmern"
                            },
                            {
                                "target_lang_word": "beunruhigt sein",
                                "target_lang_sense_clarification": "Zustand der Sorge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dcc8775-f61b-337a-9b2e-696fb81c2084",
                    "sense_definition": "To press a string down against a fret on a musical instrument.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>fret</w> the string correctly to get the right pitch.",
                            "target_lang_translations": {
                                "de": "Du musst die Saite korrekt <w>greifen</w>, um die richtige Tonhöhe zu erhalten."
                            }
                        },
                        {
                            "text": "He <w>fretted</w> the note cleanly with his index finger.",
                            "target_lang_translations": {
                                "de": "Er hat den Ton sauber mit seinem Zeigefinger <w>gegriffen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Saite auf einem Musikinstrument gegen ein Bundstäbchen drücken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "greifen",
                                "target_lang_sense_clarification": "die Saite am Bund niederdrücken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}