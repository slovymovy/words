                    {
                        "sense_id": "7809e5e5-23c0-3604-82d1-6a21fde1067a",
                        "entry_id": "ad0404cc-a948-3188-992e-48ca2c6ccea1",
                        "glosses": [
                            "eine Stadt in Bayern, Deutschland"
