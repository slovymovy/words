                "senses": [
                    {
                        "sense_id": "3685e28c-37e4-313d-97a9-5741b46bab24",
                        "entry_id": "b67ef97b-51c9-3ec7-a001-fdd472a1244b",
                        "glosses": [
                            "Rivière de Grèce qui prend sa source au mont Hélicon et se jette dans le lac Copaïs ; elle arrose la demeure des Muses et leur est consacrée."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "e856383a-889f-4b48-a907-4c8bfcdb6cf8",
                                "sense_id": "3685e28c-37e4-313d-97a9-5741b46bab24",
                                "text": "Fréquenter les bords du Permesse, cultiver la poésie, faire des vers."
                            },
                            {
                                "example_id": "0c4f9d2b-008a-4caf-96b0-833aeeafa517",
                                "sense_id": "3685e28c-37e4-313d-97a9-5741b46bab24",
                                "text": "Par un coup du sort au grand jour amené,\nEt du bord du Permesse à la cour entraîné."
                            },
                            {
                                "example_id": "ac27a9b6-0f5b-478b-9d67-e9ad530178d8",
                                "sense_id": "3685e28c-37e4-313d-97a9-5741b46bab24",
                                "text": "OLMIUM, (Géog. anc.) ville de l’Asie mineure dans la dépendance d’Ephese ; c’est aussi, selon Etienne le géographe, une ville de Grèce dans la Béotie, & qui étoit arrosée par une riviere nommée Olmus. Cette rivière avoit sa source dans le mont Hélicon, & les Muses s’y baignoient, ainsi que dans le Permesse ou dans l’Hippocrène."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8d4c1a-6718-309f-a927-53e5bb6c61c2",
                        "entry_id": "b67ef97b-51c9-3ec7-a001-fdd472a1244b",
                        "glosses": [
                            "Dieu-fleuve de ce cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c03f3d8-4ad7-418b-8bcb-d8d3fda61310",
                                "sense_id": "8b8d4c1a-6718-309f-a927-53e5bb6c61c2",
                                "text": "Dans la mythologie grecque, Aganippe, fille du dieu fleuve Permessos ou Termessos, est une nymphe associée à une source. Elle coulait au pied de l'Hélicon, en Béotie. Les Muses en ont fait une source sacrée, quiconque en boit trouve l'inspiration."
                            }
                        ]
                    }
