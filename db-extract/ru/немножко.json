                                "sense_id": "631f3ea2-79b8-392f-89d3-0aa24818318b",
                                "text": "Я взял немножко яблок"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cb09abe-71f0-4a99-89b5-1f20683e5560",
