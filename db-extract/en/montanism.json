                                "example_id": "25095869-75cf-4186-ae9f-e3c621a73267",
                                "sense_id": "cc4b4400-9602-3b91-8543-50e0121c258f",
                                "text": "The disappearance of charismatic wandering Christian teachers or prophets and the assertion of the authority of bishops were probably sealed by the Catholic Church's confrontation in the later second century with a movement known as Montanism or ‘the New Prophecy’."
                            }
                        ]
                    }
