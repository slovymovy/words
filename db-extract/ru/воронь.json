                "senses": [
                    {
                        "sense_id": "7867b82a-2cea-3c34-a794-2da064a4fe78",
                        "entry_id": "5284dc8a-78f2-3bf8-be80-fcb7ceabf9ca",
                        "glosses": [
                            "чернь, наведённая на металл"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18159602-375f-42d3-a088-0b4ba2924acf",
                                "sense_id": "7867b82a-2cea-3c34-a794-2da064a4fe78",
                                "text": "Вытащив пистолет со сношенной во́ронью, метнулся к оврагам комроты Филькин."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f76fa2b-65b6-385e-81a3-fcd76025541e",
                        "entry_id": "5284dc8a-78f2-3bf8-be80-fcb7ceabf9ca",
                        "glosses": [
                            "чернота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1815b3c-8caa-40bd-9afd-90f8255f5843",
                                "sense_id": "2f76fa2b-65b6-385e-81a3-fcd76025541e",
                                "text": "Изабелла, прежде чем запеть, демонстративно выдернула заколку, и сиреневая материя опала на её плечи, обнажив шею с голубыми жилками, голову с едва отросшим, во́ронью отливающим волосом."
                            }
                        ]
                    }
