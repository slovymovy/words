                    "sense_id": "f0325c11-24a3-39e4-a8ca-0283d185dd74",
                    "sense_definition": "Процедура избрания представителей власти или руководящих лиц с помощью голосования.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В это воскресенье в стране пройдут <w>выборы</w> президента.",
                            "target_lang_translations": {
                                "en": "The presidential <w>election</w> will be held in the country this Sunday.",
                                "zh": "这个星期天，全国将举行总统<w>选举</w>。"
                            }
                        },
                        {
                            "text": "Все граждане должны прийти на <w>выборы</w> и проголосовать.",
                            "target_lang_translations": {
                                "en": "All citizens must go to the <w>polls</w> and vote.",
                                "zh": "所有公民都应该参加<w>选举</w>并进行投票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "избрание"
                    ],
                    "common_phrases": [
