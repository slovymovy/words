                    },
                    {
                        "translation_id": "790a9e79-f102-4924-a2c1-e80782eb7b6a",
                        "source_entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "source_sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                        "source_sense_description": "Qui suscite des relations favorables ou agréables",
                        "target_lang_word": "convivial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convivial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13613fc1-2260-3982-9cc1-252314d14151",
                                        "entry_id": "6064b3d1-e4b2-392a-8c91-17133e01fbc6",
                                        "glosses": [
                                            "Having elements of a feast or of entertainment, especially when it comes to eating and drinking, with accompanying festivity"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5aa8b5-394e-49e8-8552-54f78df9d3ee",
                                                "sense_id": "13613fc1-2260-3982-9cc1-252314d14151",
                                                "text": "I put the chief of police behind the bar, instructed him in his duties, and we four convivial spirits sprawled along the counter drinking ale and telling yarns till cockcrow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74ff9001-f640-49fd-82f0-58cb7ee2bce2",
                        "source_entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "source_sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
