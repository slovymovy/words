                        "examples": [
                            {
                                "example_id": "66449322-0e15-4f03-b8a1-f5f651861ad1",
                                "sense_id": "34aa600f-6571-3d73-aa6a-38c7febce1d7",
                                "text": "When it comes to advertising, he says, the much talked-about idea that luxe is recession-proof has been proven not to be the case."
                            },
                            {
                                "example_id": "a2fbeea8-476f-46e1-b5fe-2cf3d69eebac",
                                "sense_id": "34aa600f-6571-3d73-aa6a-38c7febce1d7",
                                "text": "With sleek bucket bags, totes and backpacks priced from $460 to $950, Mansur Gavriel is targeting women who want low-key luxe and value without overt logos or labeling."
                            }
                        ]
                    }
