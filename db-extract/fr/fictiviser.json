                "senses": [
                    {
                        "sense_id": "a29bedc2-c901-3e6d-8d29-1e96eb1448cc",
                        "entry_id": "3b0f4553-2270-38ea-bc04-0ebf2d0c88ab",
                        "glosses": [
                            "Donner un caractère fictif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066deb7a-f313-4b5f-92cf-34cef9db3fbb",
                                "sense_id": "a29bedc2-c901-3e6d-8d29-1e96eb1448cc",
                                "text": "Il ne s’agit donc nullement de fictiviser, fantômaliser ou virtualiser le prodrome calculatoire."
                            },
                            {
                                "example_id": "dcded69f-996d-47e3-aee8-79bdb83b59ad",
                                "sense_id": "a29bedc2-c901-3e6d-8d29-1e96eb1448cc",
                                "text": "Le nom peut être un vecteur de rêverie au risque de fictiviser l’existence de son détenteur : leur patronyme éloigne les frères Bakroot du lycée de Guéret pour les mener vers une Flandre de légende (VM 102103) ou alors il constitue une antiphrase : Achille, surnom ironique d’un professeur de latin chahuté (VM 104105), ou celui de « père Foucault » qui prête à sourire les infirmières de l’hôpital où il se soigne en rapprochant le vieillard illettré d’un « philosophe en vogue » et d’un « missionnaire illustre » (VM 150)."
                            }
                        ]
                    }
