                                "example_id": "d637de20-37a7-426b-b74c-ebe3ce841248",
                                "sense_id": "681d34c5-1a72-39ac-89d1-6e13bb9f6529",
                                "text": "Chez Paul Inézi, la conversation allait bon train autour d'un barbeuque reconstituant, nos amis étant arrivés à trois heures de l'après-midi, les oreilles pleines de bruits d'hélice mais l'estomac vide […]."
                            },
                            {
                                "example_id": "684acf8e-122a-4f7b-adf0-94adf20bfd74",
                                "sense_id": "681d34c5-1a72-39ac-89d1-6e13bb9f6529",
                                "text": "Kit et Suzanna voudraient passer ce soir pour l'apéritif ? Ce serait fun,table ouverte à partir de 19 heures, venez comme vous êtes, barbeuque s'il ne pleut pas comme vache qui pisse."
                            },
                            {
                                "example_id": "3b5722d9-937c-4790-94d0-3c5879e6ba79",
                                "sense_id": "681d34c5-1a72-39ac-89d1-6e13bb9f6529",
                                "text": "Ils nous ont invités à barbeuque sur le quai, à peine deux heures après."
                            }
                        ]
