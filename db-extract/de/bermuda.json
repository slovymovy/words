                                    {
                                        "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                        "entry_id": "72497546-df65-336b-afe4-73d3d2f1fc96",
                                        "glosses": [
                                            "Archipel situé au nord-ouest de l’océan Atlantique Nord, possession britannique, dont la ville principale est Saint-George, et la capitale, Hamilton."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab18c7f9-f7ec-4760-810c-d6415153f547",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Dans mon demi-sommeil je pense à ces défectuosités du gréement […] et à tout ce qu'il faudra réparer aux îles Bermudes, avant de continuer ma croisière."
                                            },
                                            {
                                                "example_id": "9c515e66-227a-4bfe-b582-a1101fd58036",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Je suis monté sur le yacht, dit Gaspard, et je suis allé aux Bermudes."
                                            },
                                            {
                                                "example_id": "c93f0182-24f2-4eb0-a5a2-c6f263b1568a",
                                                "sense_id": "a76451bc-1492-370c-89dc-5cdc37151319",
                                                "text": "Le pétrel des Bermudes, l’oiseau emblématique de cet archipel britannique situé dans l’océan Atlantique, a été redécouvert en 1951, près de 300 ans après sa prétendue extinction."
                                            }
                                        ]
                                    }
                                ]
                            }
