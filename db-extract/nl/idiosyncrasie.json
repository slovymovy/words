                                        "examples": []
                                    },
                                    {
                                        "sense_id": "369c24da-5f4f-324e-85d9-9bd21e3b1c88",
                                        "entry_id": "c5936884-17c9-3bdb-b593-3975a4f3384c",
                                        "glosses": [
                                            "A peculiar individual reaction to a generally innocuous substance or factor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63dc063e-ae8d-4329-b134-72773c989c09",
                                                "sense_id": "369c24da-5f4f-324e-85d9-9bd21e3b1c88",
                                                "text": "See also: risk factor and host factor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e0b795-2dfe-3157-be1a-e5dfa20f98d9",
                                        "entry_id": "c5936884-17c9-3bdb-b593-3975a4f3384c",
                                        "glosses": [
                                            "A peculiarity that serves to distinguish or identify."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a676b57a-4570-4246-8a74-c209437e4132",
                                                "sense_id": "44e0b795-2dfe-3157-be1a-e5dfa20f98d9",
                                                "text": "He mastered the idiosyncrasies of English spelling and speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9014e679-dd07-4435-8b1a-bfe52e57a276",
                        "source_entry_id": "3e3be41e-f9db-3883-b5c7-fe60e474b756",
                        "source_sense_id": "a6f23029-aa11-3d48-8e0d-22ba49ba2032",
                        "source_sense_description": "aangeboren overgevoeligheid voor bepaalde voedings- en geneesmiddelen",
                        "target_lang_word": "idiosyncrasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiosyncrasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2ca6de-ebc5-35db-af9d-664e8f1c1d99",
                                        "entry_id": "a855de1c-70a3-3e4b-ad0e-00e359903892",
                                        "glosses": [
                                            "Disposition particulière en vertu de laquelle chaque individu reçoit d’une façon qui lui est propre les influences des divers agents qui affectent ses organes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f87ccc-d6ae-458a-b69b-9b4c55d4d8eb",
                                                "sense_id": "4a2ca6de-ebc5-35db-af9d-664e8f1c1d99",
                                                "text": "Ces intolérances, strictement individuelles, sont considérées par les médecins comme des cas d’« idiosyncrasie anaphylactique » entraînant de graves réactions allergiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e75870ee-2fd8-31d3-ad60-a2c489715211",
                                        "entry_id": "a855de1c-70a3-3e4b-ad0e-00e359903892",
                                        "glosses": [
                                            "Caractères propres au comportement d’un individu particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f7f928-2569-4b65-8820-fd68fdca24dd",
                                                "sense_id": "e75870ee-2fd8-31d3-ad60-a2c489715211",
                                                "text": "Un médecin a souvent l’occasion d’observer ces répulsions dans le domaine sexuel. À vrai dire je n’ai jamais compris les hommes en qui le plus petit défaut physique chez une femme crée une sorte d’idiosyncrasie."
                                            },
                                            {
                                                "example_id": "6cfb0972-f3a4-45d2-a99a-f2866e61b003",
                                                "sense_id": "e75870ee-2fd8-31d3-ad60-a2c489715211",
                                                "text": "Par-delà les idiosyncrasies, quasi insondables, qui influaient nécessairement sur les trajectoires individuelles, divers facteurs socioculturels expliquent ces mobilités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7cbc9f-5d50-336a-a16d-c3479f0b6930",
                                        "entry_id": "a855de1c-70a3-3e4b-ad0e-00e359903892",
                                        "glosses": [
                                            "Personnalité psychique individuelle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d714099-d2af-354b-9c90-9e7183ceb901",
                                        "entry_id": "a855de1c-70a3-3e4b-ad0e-00e359903892",
                                        "glosses": [
                                            "Caractère propre à une langue."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c9e74a-f246-4381-ae65-6c2d90c3b1fa",
                                                "sense_id": "3d714099-d2af-354b-9c90-9e7183ceb901",
                                                "text": "La traduction de proverbes est donc un exercice difficile, dans lequel le traducteur doit reproduire dans le texte de la nouvelle langue toute l’idiosyncrasie qui lui était propre dans sa langue d’origine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
