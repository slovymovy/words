                "senses": [
                    {
                        "sense_id": "84f186f4-dc23-3c46-afe3-86351f69819c",
                        "entry_id": "788bd407-bbd8-3b2f-87d5-844192ef6639",
                        "glosses": [
                            "een op een speciale manier ingepakt cadeau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d288e90-6646-4fbb-84c1-0754c6d387b5",
                                "sense_id": "84f186f4-dc23-3c46-afe3-86351f69819c",
                                "text": "Voor Sinterklaas had hij een extra grote surprise gemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "947b9130-7f46-3d36-9841-7d3519b5b12e",
                        "entry_id": "788bd407-bbd8-3b2f-87d5-844192ef6639",
                        "glosses": [
                            "verrassing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a097c6-960a-4de4-b82b-2e076f4eb03a",
                                "sense_id": "947b9130-7f46-3d36-9841-7d3519b5b12e",
                                "text": "Daarachter ontvouwde zich het tweede deel van het plein, als een verborgen surprise, geflankeerd door het onwereldse dogepaleis, dat leek te zweven met twee breekbaar ogende, opengewerkte benedenverdiepingen onder een stoere, middeleeuwse bovenbouw, en de twee zuilen waarachter het plaveisel zonder muurtje, hek, verkeersbord of waarschuwing overging in het water van Canal Grande, de lagune en de open zee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c475b85-c1d3-467f-9e16-26405173873b",
                        "source_entry_id": "788bd407-bbd8-3b2f-87d5-844192ef6639",
                        "source_sense_id": "84f186f4-dc23-3c46-afe3-86351f69819c",
                        "source_sense_description": "een op een speciale manier ingepakt cadeau",
                        "target_lang_word": "Überraschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überraschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                        "entry_id": "89a2ac9b-6d0f-3194-aba8-e249e6f1d1eb",
                                        "glosses": [
                                            "das Gefühl nach einem unerwarteten Ereignis"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b0acc23-814d-4fa0-b0b3-1737fb11da7e",
                                                "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                                "text": "Nach dieser unerwartet guten Rede machte sich große Überraschung breit."
                                            },
                                            {
                                                "example_id": "ca3bddfc-af6e-4aea-8c1c-99802d2b3dea",
                                                "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                                "text": "„Trotzdem scheint es Eos, als sollte dieser Ton nur seine Überraschung über ihren Meinungswandel verdecken, darüber, daß sie ihm zuvorgekommen ist und als erste begonnen hat, Abschied zu nehmen.“"
                                            },
                                            {
                                                "example_id": "431ec86e-477a-438b-8c88-c33465b8a102",
                                                "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                                "text": "„Zu seiner Überraschung erschien Csoma beinahe umgehend vor seinem Zelt.“"
                                            },
                                            {
                                                "example_id": "94c10ac0-9edf-4875-bcd1-f37b64b53ff2",
                                                "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                                "text": "„Zu ihrer eigenen Überraschung fielen ihr die Zeilen plötzlich wieder ein, konnte sie sie mühelos hersagen.“"
                                            },
                                            {
                                                "example_id": "1831ee71-8486-4b70-9ad2-794146159bcb",
                                                "sense_id": "be8a4d4a-b9cb-3238-969e-9586a6f87647",
                                                "text": "„Immerhin bin ich keine Abenteuerreisende oder Forscherin, sondern Restauratorin, und meine Toleranz gegenüber Aufregung und Überraschung ist auch nicht gerade die größte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63098232-1669-3f73-a6d0-9de75d9e84cb",
                                        "entry_id": "89a2ac9b-6d0f-3194-aba8-e249e6f1d1eb",
                                        "glosses": [
                                            "nicht vorhergesehene Wendung beziehungsweise Gegebenheit; etwas Unerwartetes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776f4e12-839a-4315-ba33-762b906716ca",
                                                "sense_id": "63098232-1669-3f73-a6d0-9de75d9e84cb",
                                                "text": "„Geben wir zu, wir sind auf jede Überraschung vorbereitet, nur die alltäglichen Dinge brechen über uns herein wie Katastrophen.“"
                                            },
                                            {
                                                "example_id": "67abe30d-57bd-4596-9232-a79a9e8c79e9",
                                                "sense_id": "63098232-1669-3f73-a6d0-9de75d9e84cb",
                                                "text": "„Wir haben eine kleine Überraschung für dich vorbereitet.“"
                                            },
                                            {
                                                "example_id": "54a50dfa-055f-411d-886b-983f31d59857",
                                                "sense_id": "63098232-1669-3f73-a6d0-9de75d9e84cb",
                                                "text": "„Kaum hat sich die Überraschung ins erneuerte Stimmengewirr aufgelöst, ins Kichern und Lachen hier und dort, folgt der Auftritt von Vater Jesko.“"
                                            },
                                            {
                                                "example_id": "881e3023-27e2-486f-b3d8-257bf13b8b1e",
                                                "sense_id": "63098232-1669-3f73-a6d0-9de75d9e84cb",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f2feec11-bc9c-39e4-9018-27db7beef773",
                                        "entry_id": "89a2ac9b-6d0f-3194-aba8-e249e6f1d1eb",
                                        "glosses": [
                                            "etwas Unerwartetes, das schön ist, häufig ein Geschenk"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b9f15b-fd7d-48b1-9859-6d8909d4e6e0",
                                                "sense_id": "f2feec11-bc9c-39e4-9018-27db7beef773",
                                                "text": "Aus dem Urlaub brachte er seinen Kindern kleine Überraschungen mit."
                                            },
                                            {
                                                "example_id": "f9bd8cdf-f7f8-4c1b-81fc-b36b9d7e43b4",
                                                "sense_id": "f2feec11-bc9c-39e4-9018-27db7beef773",
                                                "text": "„Alan hatte als Überraschung für sie Schallplatten der Ile Joyeuse besorgt.“"
                                            },
                                            {
                                                "example_id": "768e7835-0b9d-40f0-b07a-2aa6dc8b0154",
                                                "sense_id": "f2feec11-bc9c-39e4-9018-27db7beef773",
                                                "text": "„Und so war auch das Mahl, das sich gleich mit einer kleinen Überraschung einleitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab332587-0522-430e-9737-d2ef18024dde",
                        "source_entry_id": "788bd407-bbd8-3b2f-87d5-844192ef6639",
                        "source_sense_id": "84f186f4-dc23-3c46-afe3-86351f69819c",
