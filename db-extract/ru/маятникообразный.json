                "senses": [
                    {
                        "sense_id": "a0c895aa-abf2-3e1d-9ee8-d2001bc443a3",
                        "entry_id": "35e479ca-ee5d-3d5f-8d72-74bca4b24ec9",
                        "glosses": [
                            "pendulumlike"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38784274-a927-4a3e-a633-0918387a323a",
                                "sense_id": "a0c895aa-abf2-3e1d-9ee8-d2001bc443a3",
                                "text": "Снача́ла маятникообра́зные, ме́рные кива́ния мужика́ каза́лись ему́ курьёзными, производи́мыми для всео́бщей поте́хи, но когда́ он вгляде́лся в лицо́ мужика́, ему́ ста́ло жу́тко, и он по́нял, что э́тот мужи́к нестерпи́мо бо́лен.",
                                "translation": "At first the man's regular pendulum-like movements seemed to him curious, and he thought they were done for the general amusement, but when he looked into the man's face he felt frightened, and realised that he was terribly ill.",
                                "english": "At first the man's regular pendulum-like movements seemed to him curious, and he thought they were done for the general amusement, but when he looked into the man's face he felt frightened, and realised that he was terribly ill."
                            }
                        ]
                    }
