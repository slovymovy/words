                        "glosses": [
                            "Cesser de contenir, libérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d16f9318-9251-4734-b041-9bfb75717f15",
                                "sense_id": "b600545f-270d-3734-bc04-b7b533ebb5f4",
                                "text": "Lorsqu’on commence à les décontenir, ces pré-adolescents trouvent d’autres dispositifs de contention, par exemple en se mettant dans des cartons, dans des tunnels de jeu, moments où ils montrent qu’ils peuvent reprendre à leur compte cette expérience psychosomatique qu’est la contention."
                            },
                            {
                                "example_id": "ed5bd1cf-1d99-4324-87ab-91eaf591b54f",
                                "sense_id": "b600545f-270d-3734-bc04-b7b533ebb5f4",
                                "text": "Au début on lui décontient une seule main – décontenir les deux serait trop risqué – afin qu’il puisse dessiner."
                            },
                            {
                                "example_id": "28a073df-7987-4b4c-8cb1-def6d6c796ff",
                                "sense_id": "b600545f-270d-3734-bc04-b7b533ebb5f4",
                                "text": "Il s’agit alors de défaire le moi, de le décontenir."
                            }
                        ]
                    }
                ],
