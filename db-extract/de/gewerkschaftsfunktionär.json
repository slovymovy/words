                ],
                "senses": [
                    {
                        "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                        "entry_id": "361a7cda-f376-356f-ba71-95ebf203dcf0",
                        "glosses": [
                            "Funktionär einer Gewerkschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968e8107-3167-4d3e-a3c8-1afede2b1a3a",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„25 Jahre arbeitete [Simon Zwanzger] […] bei \"Salesis\", bis zur 1980 erfolgten Pensionierung. Während dieser Jahre vertrat er als Gewerkschaftsfunktionär der Privatangestellten die Interessen der sozial Schwachen und Benachteiligten.“"
                            },
                            {
                                "example_id": "daf8d338-f5f7-4e41-88ec-e97aa1896463",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Umgekehrt sitzen in den Fraktionen der SPD und der Linkspartei etliche aktive Gewerkschaftsfunktionäre.“"
                            },
                            {
                                "example_id": "3e5b7b36-3cb1-45dd-a2fc-834d7bd4fd11",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Seine Unterstützer fordern nun, dass die Gewerkschaftsfunktionäre, die Behr respektlos behandelt hätten, die „überzogenen Angriffe“ auf den Professor unterlassen und sich mit seinen Thesen auseinandersetzen.“"
                            },
                            {
                                "example_id": "5f5bd095-df0d-4ebc-a767-8ce102898343",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Der in Österreich geborene ehemalige Gewerkschaftsfunktionär [Paul Singer] warnt nun sogar vor einer Spaltung der Partei.“"
                            },
                            {
                                "example_id": "a201ccdc-2dc8-4250-89ff-5dd9f2ff056f",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Die ZANU war stärker von Intellektuellen dominiert, während die ZAPU mehr Unterstützung bei afrikanischen und asiatischen Geschäftsleuten fand, von denen einige gleichzeitig Gewerkschaftsfunktionäre waren.“"
                            },
                            {
                                "example_id": "c9bf9119-65a1-40be-bf70-1a4b76635a59",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Für die Linke sagte Direktkandidat und Gewerkschaftsfunktionär Mark Baumeister, seine Partei wolle 1200 Euro Mindesteinkommen und Mindestrente gegen die Altersarmut sowie einen Wegfall der gesundheitlichen Zuzahlungskosten für Brillen, Zahnersatz und Medikamente.“"
                            },
                            {
                                "example_id": "6ace1734-b75f-46d1-a344-2a585c0006f2",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Er sagt, er sei nicht nur als Gewerkschaftsfunktionär gekommen, sondern auch als Vater.“"
                            },
                            {
                                "example_id": "c8c04f5c-6e1a-41d1-9c78-728ed9bea33c",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Kein Gewerkschaftsfunktionär hat jemals so viele Pfeile auf sich gezogen wie der Sachse mit den von ihm initiierten Streiks.“"
                            },
                            {
                                "example_id": "0c4b2336-5b4c-4deb-a91e-dbf3b17a0e1b",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„Denn rasch wird klar: Der Lehrer Larry, ein hoher Gewerkschaftsfunktionär, sollte verhaftet werden.“"
                            },
                            {
                                "example_id": "f74ce463-2395-43f5-8b5d-53e25a7c6ad9",
                                "sense_id": "ced80941-0efc-3ee0-b24c-6cfff15aac2e",
                                "text": "„‚Die Zahl der Zurückweisungen von Asyl- und Schutzsuchenden ist tatsächlich sehr gering, der Aufwand für die Bundespolizei dagegen riesig‘, sagte der bei der GdP für die Bundespolizei zuständige Gewerkschaftsfunktionär Andreas Roßkopf der Augsburger Allgemeinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
