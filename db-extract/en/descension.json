                        "examples": [
                            {
                                "example_id": "dd2cf877-48e7-46dc-8839-7a030f04ca6d",
                                "sense_id": "89abd065-c04c-3202-9e50-edb95d5f8f03",
                                "text": "Death is followed by either ascension into a higher plane or descension into a lower plane."
                            },
                            {
                                "example_id": "a8ad7b3f-af97-4925-9d02-774ae757300c",
                                "sense_id": "89abd065-c04c-3202-9e50-edb95d5f8f03",
                                "text": "From a God to a Bull? a heavy descension. It was Jove's case."
                            }
                        ]
                    },
                    {
                        "sense_id": "e81376ca-d4e5-3ebd-af84-dfb299d43cc9",
                        "entry_id": "9cbb7128-32e4-3f14-8d2b-be0dcbb44f80",
                        "glosses": [
                            "The descent below the horizon of a celestial body."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8a0f287-745b-4d4a-975b-b633e62cefdc",
                                "sense_id": "e81376ca-d4e5-3ebd-af84-dfb299d43cc9",
                                "text": "For in regard of time (as we elsewhere declare) the stars do vary their longitudes, and consequently the times of their ascension and descension."
                            }
                        ]
                    }
