            {
                "entry_id": "04e8f33a-2dba-3b6c-98de-75f6f7bf3b6d",
                "word": "siding",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b87b0b11-9905-3ed4-82f4-66dae5cbf5da",
                        "entry_id": "04e8f33a-2dba-3b6c-98de-75f6f7bf3b6d",
                        "glosses": [
                            "present participle and gerund of side"
                        ],
                        "tags": [
                            "form-of",
                            "gerund",
                            "participle",
                            "present"
                        ],
                        "examples": [
                            {
                                "example_id": "89a34bff-1ca1-4442-9b8b-62ad040331c4",
                                "sense_id": "b87b0b11-9905-3ed4-82f4-66dae5cbf5da",
                                "text": "Whenever he hears an argument, he can't help siding with one party or the other."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e3aadca-903b-45f4-942a-6feec9417995",
                        "source_entry_id": "04e8f33a-2dba-3b6c-98de-75f6f7bf3b6d",
                        "source_sense_id": "b87b0b11-9905-3ed4-82f4-66dae5cbf5da",
                        "source_sense_description": "siding with one party or another",
                        "target_lang_word": "zu jemandem halten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zu jemandem halten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                        "entry_id": "ef9b15b8-52eb-3db0-8d4c-5f6ffb78d14d",
                                        "glosses": [
                                            "jemanden unterstützen, insbesondere dann, wenn Dritte sich von dieser Person abwenden; jemandem (in Not) beistehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e907585-0d92-4dd2-9ddc-4104b5b13b6c",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "In der Situation extremer Not und Bedrängnis hielt Eva Klemperer in Dresden bedingungslos zu ihrem jüdischen Mann Victor und rettete ihm dadurch das Leben."
                                            },
                                            {
                                                "example_id": "40a1fbdc-57a8-43c5-a127-31cbe18fa538",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„Sie [Anm.: Anne Sinclair, die dritte Gattin von Dominique Strauss-Kahn] hielt zu ihrem Mann, egal was ihm vorgeworfen wurde.“"
                                            },
                                            {
                                                "example_id": "cb454cce-7aa6-478e-8457-86655be18fb8",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„[…] der Putsch der algerischen Offiziere [kam] nicht recht voran. Zwar kapitulierten die Garnisonen von Oran und Constantine vor den Fremdenlegionären und Paras, aber das Gros der Algerien-Armee hielt zu de Gaulle.“"
                                            },
                                            {
                                                "example_id": "3722eaad-b304-4894-8e89-e3966d15e102",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„[…] der damalige Premier David Cameron hielt zu Hunt, zu der Zeit Kultur- und Medienminister, und machte ihn wenig später zum Gesundheitsminister.“"
                                            },
                                            {
                                                "example_id": "eb130694-6026-4539-b588-18e03ca7febb",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„Einige bezichtigten ihren Kollegen Morell, Hitler vergiftet zu haben - doch der hielt zu seinem Leibarzt.“"
                                            },
                                            {
                                                "example_id": "0cd14b74-d5d3-46dd-b15f-744f01101416",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„Bislang kam es nur zu vereinzelten, sporadischen Rebellionen unterer Ränge, das Offizierskorps hielt zu Maduro.“"
                                            },
                                            {
                                                "example_id": "175b4b21-7d80-44f0-ae05-4503806cb2b3",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„Comedian Will Arnett […] brachte es auf den Punkt: »Niemand will, dass die Patriots gewinnen. Ich denke, nicht einmal die Patriots halten zu den Patriots.«“"
                                            },
                                            {
                                                "example_id": "7dcc1ab9-58f6-4dbf-b594-530bd9d3a212",
                                                "sense_id": "b7194587-f301-3788-b482-ecf9ee816ca3",
                                                "text": "„‚Sag mal, jetzt wo die WM gerade läuft und die Türken nicht dabei sind, zu welcher Mannschaft hältst du, zu den Deutschen?‘, fragte der Doktor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
