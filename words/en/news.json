                                "target_lang_sense_clarification": "известия, слухи"
                            },
                            {
                                "target_lang_word": "известия",
                                "target_lang_sense_clarification": "полученные сообщения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消息",
                                "target_lang_sense_clarification": "关于某人或某事的新情况"
                            },
                            {
                                "target_lang_word": "好消息",
                                "target_lang_sense_clarification": "令人高兴的消息"
                            }
                        ]
                    }
