                {
                    "sense_id": "9f1f41d6-229a-38ec-bfb2-62a52065d990",
                    "sense_definition": "Completely through something; piercing from one side to the other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp arrow pierced <w>throughout</w> the wooden shield.",
                            "target_lang_translations": {
                                "ru": "Острая стрела пронзила деревянный щит <w>насквозь</w>.",
                                "tr": "Keskin ok ahşap kalkanı <w>baştan başa</w> delip geçti."
                            }
                        },
                        {
                            "text": "A sudden cold feeling went <w>throughout</w> his body.",
                            "target_lang_translations": {
                                "ru": "Внезапный холод прошел <w>по всему</w> его телу.",
                                "tr": "Vücudunun <w>her yerini</w> ani bir soğukluk kapladı."
                            }
