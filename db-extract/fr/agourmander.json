                        ],
                        "examples": [
                            {
                                "example_id": "0eaf9545-62bc-4e21-b71f-7493bd2d713a",
                                "sense_id": "96ac774c-18bc-39b0-985d-8f4cf7c3b00b",
                                "text": "Nous tâchions de les agourmander à l'aide de beaux et gros vers rouges qui se tordaient au bout de l'hameçon ; mais nous avions assez mauvaise réussite."
                            }
                        ]
                    },
                    {
                        "sense_id": "89655167-79f8-38e4-9673-2f98c7952347",
                        "entry_id": "7f4f71a6-a0d5-37b8-8ab5-f59f2f9a9e4d",
                        "glosses": [
                            "Devenir gourmand, se régaler."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8ead5237-2fbc-400b-949a-c0039d75d679",
                                "sense_id": "89655167-79f8-38e4-9673-2f98c7952347",
                                "text": "S'approchant de sa maîtresse la jument baie aurait bien voulu s'agourmander de quelque chose."
                            }
                        ]
