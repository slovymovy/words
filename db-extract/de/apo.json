                ],
                "senses": [
                    {
                        "sense_id": "2c7f045b-a5ce-3fcb-ae7f-247ce6bf7a40",
                        "entry_id": "d3413b4c-36af-3b9e-8f06-1c206e11ad8b",
                        "glosses": [
                            "außerparlamentarische Opposition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9f209c-a4fd-4bb6-a9c3-3986f9bb3334",
                                "sense_id": "2c7f045b-a5ce-3fcb-ae7f-247ce6bf7a40",
                                "text": "„Die Bezeichnung der Bundeswehr als ‚Bürgerkriegsarmee‘ leitet die APO aus der verabschiedeten Notstandsgesetzgebung ab, nach der in besonderen Notsituationen auch der Einsatz der Bundeswehr im Inneren möglich ist.“"
                            },
                            {
                                "example_id": "5ec3a1ca-b352-430a-8264-c33e377c0f1c",
                                "sense_id": "2c7f045b-a5ce-3fcb-ae7f-247ce6bf7a40",
                                "text": "„Zwar wehte um sie die Luft der jungen Rebellion, APO oder dergleichen, aber eine richtige Studentin war sie wohl nicht, sie hatte breite Bildungslücken und trumpfte mit ihnen auf.“"
                            },
                            {
                                "example_id": "5bfdbd8c-cbb0-4ae7-8ad2-0376cb953021",
                                "sense_id": "2c7f045b-a5ce-3fcb-ae7f-247ce6bf7a40",
                                "text": "„Ich geriet jedenfalls damals mit dem Lehrer aus Berlin in einen Streit, weil er in dieser Bar plötzlich anfing, sich damit aufzublasen, wie er in der APO für die Veränderung der Gesellschaft gekämpft habe, während wir uns in unserem Ruhm gesonnt hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
