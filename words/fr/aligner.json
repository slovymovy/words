                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande aux enfants d'<w>aligner</w> leurs chaises devant le tableau avant de partir."
                        },
                        {
                            "text": "Sur l'étagère de la cuisine, elle <w>aligne</w> soigneusement ses bocaux d'épices par ordre de taille."
                        }
                    ],
                    "synonyms": [
