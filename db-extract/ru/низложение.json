                    {
                        "translation_id": "a7b9ffba-670a-41fd-9206-05b341ef7c93",
                        "source_entry_id": "e891d008-c5b2-38e2-83bb-8175a75ecf12",
                        "source_sense_id": "ebb10d00-a5a5-30d0-94d7-93d56d02abf6",
                        "target_lang_word": "déposition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déposition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da500f87-2440-3aca-829f-697880a437cf",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Destitution, privation de certaines dignités, de certaines fonctions."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac05c2f-a4c4-4e78-a2ad-af324fb2b17d",
                                                "sense_id": "da500f87-2440-3aca-829f-697880a437cf",
                                                "text": "La déposition du sultan. - La déposition de cet empereur fut suivie de guerres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24519db0-3b20-3e41-b026-269ca2c5cbc8",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Ce dont un témoin dépose, ce qu’il affirme par-devant le juge qui l’entend."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69fa0818-bc0f-4dbb-84bf-b9b757587764",
                                                "sense_id": "24519db0-3b20-3e41-b026-269ca2c5cbc8",
                                                "text": "Il avait pris la déposition sur le bureau et la fixait attentivement, bien que ses yeux passassent au travers des lettres, cherchant dans un lointain vague la solution à ses tracas."
                                            },
                                            {
                                                "example_id": "9904c923-e998-49ba-9a0c-bde7501f0b9a",
                                                "sense_id": "24519db0-3b20-3e41-b026-269ca2c5cbc8",
                                                "text": "Contrairement à des accusations plus ou moins calomniatrices, leurs dépositions au cours du procès doivent être comprises comme des déclarations minimales et non comme des exagérations ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a13456b8-2caa-3823-a9de-80f8132fd24d",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Dépôt d'un texte, d'une motion, d'une proposition, etc., pour alimenter un débat."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c82e4b-1eb1-461d-96e6-7025e1d0b184",
                                                "sense_id": "a13456b8-2caa-3823-a9de-80f8132fd24d",
                                                "text": "En effet, au cours de la période de 15 jours entre la déposition de la motion et son examen au sein d’une plénière, Elyès Fakhfakh pourrait remettre la démission de son gouvernement au chef de l’État […]."
                                            },
                                            {
                                                "example_id": "ec530bbb-d23f-44c0-8eb4-4532ef4c62a3",
                                                "sense_id": "a13456b8-2caa-3823-a9de-80f8132fd24d",
                                                "text": "5G à Bruxelles: un large débat parlementaire avant la déposition des textes en 2021."
                                            },
                                            {
                                                "example_id": "c4569ce6-9a54-4445-9adf-07d38a39b097",
                                                "sense_id": "a13456b8-2caa-3823-a9de-80f8132fd24d",
                                                "text": "Samedi 24 octobre, le Conseil national du Parti socialiste se réunissait, initialement pour ouvrir la période de Congrès, avec la déposition des textes d’orientation et la clôture du dépôt des contributions thématiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef4d1d1-df9b-390d-8764-9e4c134e8a47",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Transition de phase, changement d’état, lorsqu’un gaz ou une vapeur se condense en solide."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62bba00-78ea-3688-b325-c604d676be0d",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Phénomène conduisant à la formation d’un dépôt, à partir de particules en suspension dans un fluide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1f8edfa-eaed-3e6f-bbe9-f01ba6771fea",
                                        "entry_id": "1085cb5c-26d8-3bf8-b467-d310bd74e7f8",
                                        "glosses": [
                                            "Descente du corps du Christ de la croix où il a été crucifié."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2f8418e-aa75-485e-bf07-b3af312c11c1",
                        "source_entry_id": "e891d008-c5b2-38e2-83bb-8175a75ecf12",
                        "source_sense_id": "ebb10d00-a5a5-30d0-94d7-93d56d02abf6",
                        "target_lang_word": "détrônement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détrônement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                        "entry_id": "190fe674-cd2e-31bc-9ddb-6f00edd452ee",
                                        "glosses": [
                                            "Action de détrôner ou le fait d’être détrôné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c938de31-0a0c-444b-a346-e8130689451d",
                                                "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                                "text": "La mort de ce prince suivit de près son détrônement."
                                            },
                                            {
                                                "example_id": "38c846b4-29ca-4017-b54b-326ad8c5e350",
                                                "sense_id": "7851cc4e-403b-3512-8591-100b8f8ec071",
                                                "text": "Rabelais dépeint le détrônement de deux rois : Picrochole dans Gargantua et Anarche dans Pantagruel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                        "entry_id": "190fe674-cd2e-31bc-9ddb-6f00edd452ee",
                                        "glosses": [
                                            "Perte de la première place, de la position de meneur, de son rang et donc le fait de passer en arrière-plan au profit d’un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d67dff-cd3c-4aa4-a9ee-68a9b953acc1",
                                                "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                                "text": "Depuis son détrônement lors de son dernier championnat, il déprime."
                                            },
                                            {
                                                "example_id": "3aa10e96-4193-41bc-8291-1b4089cfdbc5",
                                                "sense_id": "9bd47f73-1076-328c-bf2f-9b5fc228c5cf",
                                                "text": "Suite à son détrônement dans le numérique, l’entreprise se réoriente vers l'argentique."
                                            },
