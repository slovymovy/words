                "senses": [
                    {
                        "sense_id": "c758b344-5565-3f55-9bf6-cea0ec884fed",
                        "entry_id": "b337d3c0-f774-37f4-8900-1798ef97327e",
                        "glosses": [
                            "Art und Weise, wie jemand seine Geschäfte durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a11d60a5-5e39-4c2a-bc13-7f1eb1022f8b",
                                "sense_id": "c758b344-5565-3f55-9bf6-cea0ec884fed",
                                "text": "„Pücklers Geschäftsgebaren war ein ständiges Jonglieren mit Soll und Haben, ein ständiger Kampf, die Flut wachsender Ausgaben aus neuen Einnahmequellen zu speisen.“"
                            },
                            {
                                "example_id": "4c69530a-c554-4c9b-8eaf-5e9611d7b6ed",
                                "sense_id": "c758b344-5565-3f55-9bf6-cea0ec884fed",
                                "text": "„Drei Jahre und drei Monate muss Max Strauß wegen Steuerhinterziehung hinter Gitter, das Urteil der Richter über seine Geschäftsgebaren ist knallhart ausgefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
