                ],
                "senses": [
                    {
                        "sense_id": "045077a1-da4a-3373-9d6e-fd85529e7c05",
                        "entry_id": "9f4cdb18-39b2-3ac0-9c9d-0191eedebf8d",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным губернатор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c75b8905-f77d-4473-b9c2-aba3373f8730",
                                "sense_id": "045077a1-da4a-3373-9d6e-fd85529e7c05",
                                "text": "Забывая ради такой встречи все мелкие счёты с губернатором, Яков Львович стоял впереди собранных дворян в большой зале губернаторского дома с богатым вызолоченым блюдом и хлебом-солью от земства."
                            },
                            {
                                "example_id": "2ef9c130-465a-4266-bcf8-f8b322ffecae",
                                "sense_id": "045077a1-da4a-3373-9d6e-fd85529e7c05",
                                "text": "И тут, как вообще во всех губернских театрах, был туман повы́ше люстры, шумно беспокоилась галёрка; в первом ряду пе́ред началом представления стояли местные франты, заложив руки назад; и тут, в губернаторской ложе, на первом месте сидела губернаторская дочь в боа́, а сам губернатор скромно прятался за портьерой, и видны были только его руки; качался за́навес, оркестр долго настраивался."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99800e0c-2f92-4a2d-8240-1285ddc73c03",
                        "source_entry_id": "9f4cdb18-39b2-3ac0-9c9d-0191eedebf8d",
                        "source_sense_id": "045077a1-da4a-3373-9d6e-fd85529e7c05",
                        "target_lang_word": "gubernatorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gubernatorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8e5dc66-b21c-345b-9d71-95c7105976fc",
                                        "entry_id": "a77cc2f0-57a9-3a2c-b3aa-22d87e3a4a8f",
                                        "glosses": [
                                            "Of or pertaining to a governor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b35553e-3a7e-447e-b623-2ac813c51840",
                                                "sense_id": "b8e5dc66-b21c-345b-9d71-95c7105976fc",
                                                "text": "The RNC entered June with about $72.4 million in cash reserves, nearly five times the $15 million stockpiled by the DNC, as the two parties gear up for gubernatorial races this fall and next year’s costly midterm elections for Congress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ae764e2-7e38-4961-be77-2746e5545cf7",
