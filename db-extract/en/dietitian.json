                    {
                        "translation_id": "c07ef52d-dd6c-4cac-8b17-cdbe261d06a6",
                        "source_entry_id": "70bcebea-4cd1-38c9-bec8-348bca4afe52",
                        "source_sense_id": "b57623c9-c284-317b-8b41-c55911b5c582",
