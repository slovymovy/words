                    {
                        "translation_id": "6128c300-d638-4af0-a4f3-63a6725078e6",
                        "source_entry_id": "c6c89483-315d-3595-8b62-365db023cf27",
                        "source_sense_id": "90ca5671-f8b3-3efb-b75a-7eb815b42ec6",
                        "target_lang_word": "observance",
