                                "target_senses": [
                                    {
                                        "sense_id": "63f4de2b-e905-3119-9d20-941122aa1c2b",
                                        "entry_id": "2f79c9e3-ffe9-316c-a6c8-f52922e0081d",
                                        "glosses": [
                                            "Any of various wading birds of the subfamily Charadriinae."
