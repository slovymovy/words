                            {
                                "example_id": "6de5b4c8-6ef3-4fe6-a667-e0909099d3be",
                                "sense_id": "7be4c903-c00c-30c7-b11d-1b10587be76e",
                                "text": "Het kabinet moest alleen met goede voorwaarden komen over wie er naar die hele stroom informatie zou gaan kijken, stelden Kamerleden. Het kabinet heeft daar een schema voor bedacht. Voor elke fase in het proces (vergaren, voorbewerken of verwerken van data) moet er toestemming komen van de minister."
                            },
                            {
                                "example_id": "e2d30870-b6fc-4c31-b206-f86850dd1b65",
                                "sense_id": "7be4c903-c00c-30c7-b11d-1b10587be76e",
                                "text": "Door de kleverige smurrie moet het lak van de auto's eerst worden voorbewerkt voordat die door de wasstraat kunnen, zegt een woordvoerder van Rijkswaterstaat."
                            }
                        ]
                    }
