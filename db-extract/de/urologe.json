                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                        "entry_id": "f604a913-01cd-3d53-bfba-94e645a752ae",
                        "glosses": [
                            "Facharzt für Urologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3990a1f3-904c-4b12-adc8-a9e2ecff4294",
                                "sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                                "text": "Besuchen beim Urologen fiebert Gisbert immer schon Wochen vorher entgegen."
                            },
                            {
                                "example_id": "e5d5776d-8c72-437e-b897-ddb024e95a0d",
                                "sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                                "text": "„Obwohl die Seneszenz des Mannes primär in den Kompetenzbereich der Urologen fällt, haben sich neben den Urologen die Internisten, die internistischen Endokrinologen, die Gynäkologen und die Epidemiologen des alternden Mannes angenommen.“"
                            },
                            {
                                "example_id": "0beae1e0-eb58-46fe-8622-a90b2260bf35",
                                "sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                                "text": "„Bei den Geburten meiner Kinder war ich dabei und vor etwas über einem Jahr bei einer Vorsorgeuntersuchung beim Urologen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c976e87b-6347-4ff9-8737-d2f7027cdb84",
                        "source_entry_id": "f604a913-01cd-3d53-bfba-94e645a752ae",
                        "source_sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                        "source_sense_description": "Facharzt für Urologie",
                        "target_lang_word": "urologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                        "entry_id": "220cf29b-9cd6-3837-903f-a0bbb16f430c",
                                        "glosses": [
                                            "A doctor of urology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041f5a91-2c55-4b2f-9fe0-10b931370ff6",
                                                "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                                "text": "Dr. Schirren: The members of this round table keep on speaking about urologists and gynecologists but you never mention andrologists."
                                            },
                                            {
                                                "example_id": "723786d3-9da2-4ec4-97e3-afebfc55e1e8",
                                                "sense_id": "d590fdb3-e97b-3d2f-b8b4-5422927abab2",
                                                "text": "In fact, at the Mayo Clinic in Rochester, Minn., so many men sign up for vasectomies during March Madness that appointments reach “max capacity,” said Dr. Tobias S. Kohler, a urologist and men’s health expert at the medical center who has observed this phenomenon ever since he was an attending physician a decade ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720e3502-3e3c-4a80-bda4-a0e949dfcb58",
                        "source_entry_id": "f604a913-01cd-3d53-bfba-94e645a752ae",
                        "source_sense_id": "c0637210-46d3-3b6f-88b8-801b4f2f9739",
                        "source_sense_description": "Facharzt für Urologie",
                        "target_lang_word": "urologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22556e86-9b49-33c9-962a-647d7600c681",
                                        "entry_id": "4b696a5f-63aa-39a6-b689-a319f31f6f83",
                                        "glosses": [
                                            "Spécialiste des voies urinaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b106ae-b7ba-408c-a65f-5d5c46148704",
                                                "sense_id": "22556e86-9b49-33c9-962a-647d7600c681",
                                                "text": "Il ne lit quasiment plus que des ouvrages de médecine, Marc, depuis que l’urologue a détecté un germe de cancer"
                                            },
                                            {
                                                "example_id": "d0141792-7212-42ca-a2fd-e4f7d03e02eb",
                                                "sense_id": "22556e86-9b49-33c9-962a-647d7600c681",
                                                "text": "Vincent Hupertan, urologue, explique que le besoin d’uriner peut être « connecté à des éléments émotionnels, en cas de stress, par exemple »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1398f63c-a429-4201-89b8-08f5670ea0b4",
