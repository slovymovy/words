                        "examples": [
                            {
                                "example_id": "0810fd97-c190-4908-bdb4-e64eb8e8de5a",
                                "sense_id": "36a69b76-ed79-3987-9879-d53ffd4a41b2",
                                "text": "A good shallow young fellow. ’A would have made a pantler; ’a would ha’ chipp’d bread well."
                            },
                            {
                                "example_id": "53ee113d-e53d-4a8a-be4a-d460b61714cc",
                                "sense_id": "36a69b76-ed79-3987-9879-d53ffd4a41b2",
                                "text": "Fie, daughter! when my old wife lived, upon\nThis day she was both pantler, butler, cook,\nBoth dame and servant; welcomed all, served all;"
                            }
                        ]
