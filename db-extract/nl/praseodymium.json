                                        "entry_id": "9b21d90e-00c4-39b3-a343-d2244df2edd4",
                                        "glosses": [
                                            "A chemical element (symbol Pr) with an atomic number of 59, a soft, silvery, malleable and ductile rare earth metal, valued for its magnetic, electrical, chemical, and optical properties."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233514e2-11f0-4fa3-ad98-9e7dcf4d0f6d",
                                                "sense_id": "98a01cd0-0eb9-39a9-bc2f-3bc1c5c2c5a3",
                                                "text": "But the government also gave MP Materials a decade-long guaranteed price floor for its products, such as the rare earths neodymium-praseodymium, at twice recent market rates (leaving aside the fact prices have soared this week as MP Materials has cut ties with China)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
