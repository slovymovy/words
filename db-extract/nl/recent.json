                                    {
                                        "sense_id": "06dd71c2-f8d5-340c-8454-fce73a3c7a63",
                                        "entry_id": "efe752df-3fb5-3aec-aa4a-057b11278d9c",
                                        "glosses": [
                                            "Having happened a short while ago."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737f2226-3b36-40e0-b98a-8118aadc2e72",
                                                "sense_id": "06dd71c2-f8d5-340c-8454-fce73a3c7a63",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola. A recent study explored the ecological variables that may contribute to bats’ propensity to harbor such zoonotic diseases by comparing them with another order of common reservoir hosts: rodents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eccc7c1b-0ed5-37a3-808f-c36af83282b7",
                                        "entry_id": "efe752df-3fb5-3aec-aa4a-057b11278d9c",
                                        "glosses": [
                                            "Up-to-date; not old-fashioned or dated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02f51558-39ed-3b99-b0a2-d34b8c7e6f4d",
                                        "entry_id": "efe752df-3fb5-3aec-aa4a-057b11278d9c",
                                        "glosses": [
                                            "Having done something a short while ago that distinguishes them as what they are called."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f981eb10-8272-4f3b-9a1c-f7bf4577afc6",
                                                "sense_id": "02f51558-39ed-3b99-b0a2-d34b8c7e6f4d",
                                                "text": "The cause has several hundred recent donors."
                                            },
                                            {
                                                "example_id": "9e616e5a-77b5-4ae4-8923-237c62043157",
                                                "sense_id": "02f51558-39ed-3b99-b0a2-d34b8c7e6f4d",
                                                "text": "I met three recent graduates at the conference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217f1db6-ebf6-3aa8-9fb1-0b613ecdbf46",
                                        "entry_id": "efe752df-3fb5-3aec-aa4a-057b11278d9c",
                                        "glosses": [
                                            "Particularly in geology, palaeontology, and astronomy: having occurred a relatively short time ago, but still potentially thousands or even millions of years ago."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41029db3-8548-45a1-b7d1-2992630cbf5a",
                                                "sense_id": "217f1db6-ebf6-3aa8-9fb1-0b613ecdbf46",
                                                "text": "Finding it now means it was produced in more recent times, in astronomical terms."
                                            }
                                        ]
                                    }
                                ]
                            },
