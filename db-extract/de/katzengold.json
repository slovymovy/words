                        "target_lang_word": "or des fous",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "or des fous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdaa7483-1f62-3b76-8367-8f30662aca32",
                                        "entry_id": "961087c4-0658-322d-a668-270b92b63e4a",
                                        "glosses": [
                                            "Pyrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9adc4dc6-9b20-4b79-ac61-3884071ccb31",
                                                "sense_id": "fdaa7483-1f62-3b76-8367-8f30662aca32",
                                                "text": "« L’or des fous » est un terme commun datant des années 1870 qui a été donné à un minéral nommé « pyrite » en particulier la pyrite de fer. Cette expression « l’or des fous » a été inventée pendant la fièvre de l’or aux Etats-Unis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
