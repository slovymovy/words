        "nl-extract.jsonl": [
            {
                "entry_id": "b2ee77d7-7710-36a5-bca6-2f679866ae69",
                "word": "nijd",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "84e84144-cd4d-3132-a0d9-9f85fe516ce0",
                        "entry_id": "b2ee77d7-7710-36a5-bca6-2f679866ae69",
                        "glosses": [
                            "grondige afkeer van iemand en het misgunnen van zijn bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b211b8d7-07f6-42c6-b2ab-e8ab81163c5b",
                                "sense_id": "84e84144-cd4d-3132-a0d9-9f85fe516ce0",
                                "text": "Er heerste alleen maar haat en nijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d96f5bfe-38e1-4a0f-a348-304c8370ad41",
                        "source_entry_id": "b2ee77d7-7710-36a5-bca6-2f679866ae69",
                        "source_sense_id": "84e84144-cd4d-3132-a0d9-9f85fe516ce0",
                        "source_sense_description": "grondige afkeer",
                        "target_lang_word": "Neid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23d9789e-838b-31c2-b710-c52cd2386034",
                                        "entry_id": "6fcc695d-d132-3002-b076-33d6e3a45c4f",
                                        "glosses": [
                                            "der intensive negative Gefühlszustand von Menschen, wenn sie den Besitz, Erfolg, den körperlichen Vorzug oder das Glück eines anderen beobachten können, das sie nicht haben, aber ihm missgönnen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba48146-07d5-4ff9-b6d7-50c8f6d9081a",
                                                "sense_id": "23d9789e-838b-31c2-b710-c52cd2386034",
                                                "text": "Sein verhohlener Neid machte ihn zu einem unausstehlichen und tückischen Zeitgenossen."
                                            },
                                            {
                                                "example_id": "8431d7b5-90f9-4394-9f8d-2ada6507cbfc",
                                                "sense_id": "23d9789e-838b-31c2-b710-c52cd2386034",
                                                "text": "Ihr Neid ließ sie wünschen, dass jemand ihrer Klassenkameradin einmal einen Schuss Säure in ihre hübsche Larve schütten möge."
                                            },
                                            {
                                                "example_id": "12c85979-a07e-40e0-aa85-f480c02ffce4",
                                                "sense_id": "23d9789e-838b-31c2-b710-c52cd2386034",
                                                "text": "„Wenn Elsa von Filmvorführungen, Tanzveranstaltungen oder ihrem Heinz erzählte, war da dieses feine Brennen der Sehnsucht, das immer öfter nach bitterem Neid schmeckte.“"
                                            },
                                            {
                                                "example_id": "baeae9ba-2c6f-47ec-ba74-f1794aacad59",
                                                "sense_id": "23d9789e-838b-31c2-b710-c52cd2386034",
                                                "text": "„Ich glaube, es gibt niemanden auf der Welt, der einen Clown versteht, nicht einmal ein Clown versteht den anderen, da ist immer Neid oder Mißgunst im Spiel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1156ac20-796d-4cf9-8996-98be7115dd2b",
                        "source_entry_id": "b2ee77d7-7710-36a5-bca6-2f679866ae69",
                        "source_sense_id": "84e84144-cd4d-3132-a0d9-9f85fe516ce0",
                        "source_sense_description": "grondige afkeer",
                        "target_lang_word": "envy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0459d4-d262-39c9-8fe0-edc47464868a",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "Resentful desire of something possessed by another or others (but not limited to material possessions)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df86713b-70d4-4f5c-af81-0921b92fdf97",
                                                "sense_id": "6d0459d4-d262-39c9-8fe0-edc47464868a",
                                                "text": "No bliss enjoyed by us excites his envy more."
                                            },
                                            {
                                                "example_id": "197a1b0f-9b87-460b-be89-0c703b66b6e0",
                                                "sense_id": "6d0459d4-d262-39c9-8fe0-edc47464868a",
                                                "text": "Envy, to which the ignoble mind's a slave,\n Is emulation in the learned or brave."
                                            },
                                            {
                                                "example_id": "0d12a168-d459-4cb0-97d4-af3bb93ecfa2",
                                                "sense_id": "6d0459d4-d262-39c9-8fe0-edc47464868a",
                                                "text": "distilling therefrom an acid envy that robbed her napoleon of all its savour."
                                            },
                                            {
                                                "example_id": "46e6aaa9-7a8a-41be-88b1-812577fcc90b",
                                                "sense_id": "6d0459d4-d262-39c9-8fe0-edc47464868a",
                                                "text": "Theodorus assures Socrates that no envy will prevent the Stranger from responding"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3025d920-103a-338e-b6f1-b22e5eea97ac",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "An object of envious notice or feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9fb033a-92b5-4ae5-bacd-9fc6c91fc767",
                                                "sense_id": "3025d920-103a-338e-b6f1-b22e5eea97ac",
                                                "text": "This constitution in former days used to be the envy of the world[.]"
                                            },
                                            {
                                                "example_id": "1650c338-a495-40fc-a1b2-7d6ee394b7ac",
                                                "sense_id": "3025d920-103a-338e-b6f1-b22e5eea97ac",
                                                "text": "Blacke Foryst of Despayr, taking photos of the band\n Put 'em up on Myspace you're the envy of the land"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5358d79b-67c7-3df0-940a-4ceda23c836c",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "Hatred, enmity, ill-feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86fb8c79-d5c1-4f62-82a3-c408781eb257",
                                                "sense_id": "5358d79b-67c7-3df0-940a-4ceda23c836c",
                                                "text": "Syre said laūcelot vnto Arthur by this crye that ye haue made ye wyll put vs that ben aboute yow in grete Ieopardy\n for there be many Knyghtes that haue grete enuye to vs\n therfore whan we shal mete at the daye of Iustes there wille be hard skyfte amonge vs"
                                            },
                                            {
                                                "example_id": "a493a24d-beb3-43e8-a198-3253bde6ed7d",
                                                "sense_id": "5358d79b-67c7-3df0-940a-4ceda23c836c",
                                                "text": "But let me tell the World,\n If he out-liue the enuie of this day,\n England did neuer owe so sweet a hope,\n So much misconstrued in his Wantonnesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a247b8b8-302e-3fd3-9a73-0046d48455b6",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "Emulation; rivalry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ab2449-f2a0-430b-90b0-08b82e163769",
                                                "sense_id": "a247b8b8-302e-3fd3-9a73-0046d48455b6",
                                                "text": "c. 1631-1636, John Ford, The Fancies Chaste and Noble\nSuch as cleanliness and decency\nPrompt to a virtuous envy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a97f349-5cf2-3458-85fa-acf77fae8cec",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "Public odium; ill repute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f295b330-a4ab-4303-9065-c900223be779",
                                                "sense_id": "7a97f349-5cf2-3458-85fa-acf77fae8cec",
                                                "text": "to lay the envy of the war upon Cicero"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d91f4a8-4ba7-3aa2-9a94-cb5bd11927d0",
                                        "entry_id": "d03d0644-b275-3d68-a91c-33b6e67ed0c2",
                                        "glosses": [
                                            "A red-skinned variety of eating apple."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "envy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef33b9d-dc4f-3019-aecb-b3b23470ff5f",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To feel displeasure or hatred towards (someone) for their good fortune or possessions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b195e1e3-d9fc-4965-be89-9250965ed773",
                                                "sense_id": "6ef33b9d-dc4f-3019-aecb-b3b23470ff5f",
                                                "text": "Moon and Kim took a cable car together to Heaven Lake, a caldera at the top of the mountain, and walked around the area with their wives and officials from both sides.\nPictures showed Moon and Kim smiling and posing with their wives, and Moon filling a bottle with water from the lake.\n“The Chinese envy us because they can’t go down to the lake from their side but we can,” Kim said.\n“We should write another chapter of history between the North and the South by reflecting our new history on this Heaven Lake.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864bc6a7-c771-3bd0-a0c7-0fb38886d2d9",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To resentfully or discontentedly desire (something someone else has that one lacks)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f520b467-8f0c-3e7a-8edf-4cee78136bef",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To have envious feelings (at)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "897a8326-62bd-40dc-89b2-17281efbe8e2",
                                                "sense_id": "f520b467-8f0c-3e7a-8edf-4cee78136bef",
                                                "text": "I do not envy at their wealth, titles, offices;[…]let me live quiet and at ease."
                                            },
                                            {
                                                "example_id": "0ea023af-5f1b-49bf-a348-24b0b935c67c",
                                                "sense_id": "f520b467-8f0c-3e7a-8edf-4cee78136bef",
                                                "text": "Who envy at the prosperity of the wicked?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e7bf9e-ec27-3963-91a3-4bf1078ac3a5",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To give (something) to (someone) grudgingly or reluctantly; to begrudge."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4133348-0407-4e0b-b876-a5c426470613",
                                                "sense_id": "85e7bf9e-ec27-3963-91a3-4bf1078ac3a5",
                                                "text": "But that sweet Cordiall, which can restore\n A loue-sick hart, she did to him enuy[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2eda77-7e96-34de-9088-18433995afe3",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To show malice or ill will; to rail."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1ba88b-2337-4467-9465-060d433d32d0",
                                                "sense_id": "df2eda77-7e96-34de-9088-18433995afe3",
                                                "text": "He has[…]envied against the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66bb0579-ffeb-3cc0-9593-e5d0691dbad6",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To do harm to; to injure; to disparage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15a565b0-7026-41c7-afe1-7499a6a48267",
                                                "sense_id": "66bb0579-ffeb-3cc0-9593-e5d0691dbad6",
                                                "text": "If I make a lie\n To gain your love and envy my best mistress,\n Put me against a wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd20647c-1947-3f5b-a22e-24f50da217e3",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To hate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6582e6e7-f095-4b9d-9518-6595925f03d0",
                                                "sense_id": "cd20647c-1947-3f5b-a22e-24f50da217e3",
                                                "text": "Both jealous of my love, envied each other"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec014ce-9ec3-39ea-86cd-95853f0e120b",
                                        "entry_id": "b6bf7e9c-3ca8-35c4-8558-2bbf6a3ca427",
                                        "glosses": [
                                            "To emulate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f73f018-6aa3-4fbb-9404-001565debf3d",
                                                "sense_id": "7ec014ce-9ec3-39ea-86cd-95853f0e120b",
                                                "text": "Let later age that noble vse enuie,\nVile rancour to auoid, and cruell surquedrie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
