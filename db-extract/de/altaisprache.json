                        "entry_id": "4395f966-9378-3a50-967f-97d95b68af25",
                        "glosses": [
                            "Gruppe von drei Sprachfamilien mit etwa 60 Sprachen und rund 160 Millionen Sprechern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8d5f7b-8b64-4d5d-8b9d-efee521499de",
                                "sense_id": "d95afe19-65e5-3aad-8d42-dedd29a4066b",
                                "text": "„Die koreanische Sprache wird von einigen Sprachwissenschaftlern zu den Altaisprachen gezählt, von anderen als isolierte Sprache angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
