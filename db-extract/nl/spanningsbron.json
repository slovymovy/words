                        "sense_id": "e7bdc14a-5b4c-34f9-813f-527b509b87ea",
                        "entry_id": "0931f338-5fb8-3e1b-95e0-b07f27705f00",
                        "glosses": [
                            "een ideale spanningsbron is een schakeling die een elektrische spanning afgeeft waarvan de grootte onafhankelijk is van de belasting"
                        ],
                        "tags": [],
