                                "example_id": "81473258-7215-401d-ac2a-27ba33e1f163",
                                "sense_id": "72ec07d5-dd6e-32e4-b37b-29163efdd5c1",
                                "text": "Dit moest uiteraard een wachtperiode zijn, en intussen moest ik proberen me rustig neer te leggen bij ongeacht wat het lot voor me in petto had."
                            },
                            {
                                "example_id": "02a9ca23-15c0-4261-88f0-2550a31451fa",
                                "sense_id": "72ec07d5-dd6e-32e4-b37b-29163efdd5c1",
                                "text": "Ze hopen lering te trekken uit het gebeuren. \"Desnoods moet er een overkapping komen voor de wachtperiode, zodat de coureurs in ieder geval in de schaduw staan.\""
                            }
                        ]
                    }
