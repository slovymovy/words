                    {
                        "translation_id": "ec3ebf10-a7b7-436c-af19-9c46fbfdd0ca",
                        "source_entry_id": "de8c695e-5d0f-3b45-a6fd-073713af5ee1",
                        "source_sense_id": "20d9ac71-e8c6-3490-84ea-126feeebe488",
                        "source_sense_description": "in an indescribable manner",
                        "target_lang_word": "inexprimablement",
