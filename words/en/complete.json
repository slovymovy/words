{
    "word_family": [
        "completely",
        "completeness",
        "completion",
        "incompleteness",
        "incomplete",
        "uncompleted"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61f430e5-c848-33d6-9fb3-3c4508652e2d",
                    "sense_definition": "To finish; to make done; to reach the end.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>completed</w> the assignment on time.",
                            "target_lang_translations": {
                                "ru": "Он <w>завершил</w> задание вовремя."
                            }
                        },
                        {
                            "text": "You must <w>complete</w> the task before you can leave the office.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>выполнить</w> задачу, прежде чем сможете покинуть офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "finish",
                        "conclude",
                        "finalize",
                        "end",
                        "accomplish"
                    ],
                    "common_phrases": [
                        "complete the task",
                        "complete the assignment",
                        "complete the course"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закончить; довести до конца; достичь финала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершить",
                                "target_lang_sense_clarification": "довести дело до конца"
                            },
                            {
                                "target_lang_word": "закончить",
                                "target_lang_sense_clarification": "прекратить выполнение"
                            },
                            {
                                "target_lang_word": "выполнить",
                                "target_lang_sense_clarification": "справиться с заданием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21380046-56a3-3458-bca8-cc4f6cbf3f14",
                    "sense_definition": "To make whole or entire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_whole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The last chapter <w>completes</w> the book nicely.",
                            "target_lang_translations": {
                                "ru": "Последняя глава удачно <w>дополняет</w> книгу."
                            }
                        },
                        {
                            "text": "This beautiful painting <w>completes</w> the collection perfectly.",
                            "target_lang_translations": {
                                "ru": "Эта прекрасная картина идеально <w>завершает</w> коллекцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "perfect",
                        "consummate"
                    ],
                    "common_phrases": [
                        "complete the collection",
                        "complete the set"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать полным или целым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "делать завершенным"
                            },
                            {
                                "target_lang_word": "укомплектовать",
                                "target_lang_sense_clarification": "собрать полный набор"
                            },
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "служить финальным штрихом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df3d079-f137-3581-ab4e-c8191bd7c998",
                    "sense_definition": "To call from the small blind in an unraised pot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>complete</w> from the small blind rather than raising.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>доставить</w> с малого блайнда вместо того, чтобы делать рейз."
                            }
                        },
                        {
                            "text": "In this situation, it is often better to <w>complete</w> and see the flop.",
                            "target_lang_translations": {
                                "ru": "В этой ситуации часто лучше <w>закомплитить</w> и посмотреть флоп."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "poker terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уравнять ставку с малого блайнда в неразыгранном поте (покер)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплитить",
                                "target_lang_sense_clarification": "покерный сленг"
                            },
                            {
                                "target_lang_word": "доставить",
                                "target_lang_sense_clarification": "до малого блайнда"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03e34b02-804e-37e4-87a8-8d6d71d8c272",
                    "sense_definition": "With all parts included; with nothing missing; full.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After she found the rook, the chess set was <w>complete</w>.",
                            "target_lang_translations": {
                                "ru": "После того как она нашла ладью, шахматный набор стал <w>полным</w>."
                            }
                        },
                        {
                            "text": "She offered me <w>complete</w> control of the project.",
                            "target_lang_translations": {
                                "ru": "Она предложила мне <w>полный</w> контроль над проектом."
                            }
                        }
                    ],
                    "synonyms": [
                        "entire",
                        "whole",
                        "full",
                        "total"
                    ],
                    "antonyms": [
                        "incomplete"
                    ],
                    "common_phrases": [
                        "complete set",
                        "complete control",
                        "complete list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Со всеми включенными частями; без недостающих элементов; полный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "весь набор"
                            },
                            {
                                "target_lang_word": "целый",
                                "target_lang_sense_clarification": "неделимый"
                            },
                            {
                                "target_lang_word": "целостный",
                                "target_lang_sense_clarification": "обладающий единством"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac44245b-6259-3009-833c-2fe00dbf77f2",
                    "sense_definition": "Finished; ended; concluded; completed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finished_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When your homework is <w>complete</w>, you can go and play with Martin.",
                            "target_lang_translations": {
                                "ru": "Когда твоя домашняя работа будет <w>готова</w>, ты сможешь пойти поиграть с Мартином."
                            }
                        },
                        {
                            "text": "The construction of the new bridge is finally <w>complete</w>.",
                            "target_lang_translations": {
                                "ru": "Строительство нового моста наконец-то <w>завершено</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "finished",
                        "done",
                        "concluded",
                        "ended"
                    ],
                    "antonyms": [
                        "incomplete"
                    ],
                    "common_phrases": [
                        "nearly complete",
                        "finally complete"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законченный; завершенный; подошедший к концу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершенный",
                                "target_lang_sense_clarification": "о процессе или работе"
                            },
                            {
                                "target_lang_word": "готовый",
                                "target_lang_sense_clarification": "полностью сделанный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "633143a9-941c-3932-8319-ae47f24c5810",
                    "sense_definition": "Used as an intensifier to mean total or absolute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our vacation was a <w>complete</w> disaster.",
                            "target_lang_translations": {
                                "ru": "Наш отпуск был <w>полным</w> провалом."
                            }
                        },
                        {
                            "text": "It was a <w>complete</w> shock when he turned up on my doorstep.",
                            "target_lang_translations": {
                                "ru": "Это был <w>настоящий</w> шок, когда он появился у меня на пороге."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "total",
                        "utter",
                        "downright",
                        "thorough"
                    ],
                    "common_phrases": [
                        "complete disaster",
                        "complete shock",
                        "complete stranger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления в значении «полный» или «абсолютный»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный"
                            },
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "крайняя степень"
                            },
                            {
                                "target_lang_word": "сущий",
                                "target_lang_sense_clarification": "настоящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f22b1cb-ad0f-36bb-b0f2-e195f11ed6a8",
                    "sense_definition": "In which every Cauchy sequence converges to a point within the space.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The set of real numbers is a <w>complete</w> metric space.",
                            "target_lang_translations": {
                                "ru": "Множество вещественных чисел является <w>полным</w> метрическим пространством."
                            }
                        },
                        {
                            "text": "A <w>complete</w> space ensures that limits of sequences remain inside the space.",
                            "target_lang_translations": {
                                "ru": "<w>Полное</w> пространство гарантирует, что пределы последовательностей остаются внутри пространства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "complete metric space"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В котором каждая последовательность Коши сходится к точке внутри пространства (математика)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о метрическом пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e87e5c-77de-3dfd-bb59-b04cc7ad9f3e",
                    "sense_definition": "In which every semantically valid well-formed formula is provable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gödel showed that certain logical systems cannot be both consistent and <w>complete</w>.",
                            "target_lang_translations": {
                                "ru": "Гёдель показал, что определенные логические системы не могут быть одновременно непротиворечивыми и <w>полными</w>."
                            }
                        },
                        {
                            "text": "A <w>complete</w> system allows us to prove every true statement within its language.",
                            "target_lang_translations": {
                                "ru": "<w>Полная</w> система позволяет нам доказать любое истинное утверждение на её языке."
                            }
                        }
                    ],
                    "antonyms": [
                        "incomplete"
                    ],
                    "common_phrases": [
                        "complete logical system"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В котором каждая семантически верная формула является доказуемой (логика)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о логической системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ee11e4-ebab-34c1-8af0-746b1b0f6fc8",
                    "sense_definition": "Belonging to a complexity class such that every other problem in the class can be reduced to it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveling salesman problem is NP-<w>complete</w>.",
                            "target_lang_translations": {
                                "ru": "Задача коммивояжера является NP-<w>полной</w>."
                            }
                        },
                        {
                            "text": "We know of no <w>complete</w> languages for certain complexity classes.",
                            "target_lang_translations": {
                                "ru": "Нам не известны <w>полные</w> языки для определенных классов сложности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "NP complete"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий к классу сложности, такому что любая другая задача в классе сводится к ней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о классе сложности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d1ea27c-0be8-3c1b-9a42-fa1baa011bd9",
                    "sense_definition": "A completed survey or questionnaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "survey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would be difficult to get enough <w>completes</w> for this lengthy survey.",
                            "target_lang_translations": {
                                "ru": "Будет трудно получить достаточное количество <w>заполненных анкет</w> для такого длинного опроса."
                            }
                        },
                        {
                            "text": "The market research team needs fifty more <w>completes</w> by Friday.",
                            "target_lang_translations": {
                                "ru": "Команде по исследованию рынка нужно еще пятьдесят <w>заполненных форм</w> к пятнице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get completes"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "market research jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполненная анкета или опросник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заполненная анкета",
                                "target_lang_sense_clarification": "единица исследования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}