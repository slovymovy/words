                        "entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                        "tags": [
                            "past"
                        ],
                        "form": "slalomed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0996845f-e98c-301c-afb1-760d0d6b90a9",
                        "entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                        "glosses": [
                            "To race in a slalom."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                        "entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                        "glosses": [
                            "To move in a slalom-like manner."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9d769e06-60ec-466f-a239-e68c1ba72485",
                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                "text": "Snow fell, swirled, slalomed past our windows."
                            },
                            {
                                "example_id": "8300973b-a17e-4758-967a-95a56a6396ea",
                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                "text": "Hiro climbs on his bike, eases it through the neighbourhood and onto the street, and then gosses it up to a few hundred miles an hour, slaloming between the stanchions of the monorail, practicing."
                            },
                            {
                                "example_id": "88183ae3-99d5-4061-b43b-9d085d84f463",
                                "sense_id": "a9cd97bd-4780-3f79-a5b9-d15b259eaf0b",
                                "text": "Gerrard plainly had other ideas as he set off on that final, driving run into the opposition penalty area, slaloming between Kamil Glik and Grzegorz Wojtkowiak and getting his shot away as a third defender, Artur Jedzejczyk, and the goalkeeper, Wojciech Szczesny, tried to close him out."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55adc8ba-6328-458a-91da-d757cd15d5d7",
                        "source_entry_id": "4ad1b814-2ac1-379a-aa9b-9e9bce3b3f36",
                        "source_sense_description": "to race in a slalom",
                        "target_lang_word": "slalomer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slalomer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                        "entry_id": "d50e94b6-9261-3b8d-a9ee-ed529bef88a9",
                                        "glosses": [
                                            "Se déplacer en slalom, en zigzaguant entre des obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0300235-280d-4daa-b072-dd5fdeb7a9d5",
                                                "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                                "text": "L’eau ruisselait sur la façade verdie par les traces d’humidité et slalomait entre les écailles de la peinture grasse."
                                            },
                                            {
                                                "example_id": "2d80ebef-7843-4958-a15c-5372804c6808",
                                                "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                                "text": "Mais Esmé est légère elle aussi, elle sait encore slalomer autour des creux et des bosses et donner le sec petit coup de guidon pour faire sauter la roue avant par-dessus les bords de trottoir."
                                            },
                                            {
                                                "example_id": "d3a63ae9-a796-4aa1-95ca-77f6c243919a",
                                                "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                                "text": "Je retrouvai, au bas d’une pile, mes brodequins provinciaux et, cédant à mon affolement maintenant incontrôlable, slalomai à toutes jambes à travers le magasin jusqu’à une sortie : je pris la fuite."
                                            },
                                            {
                                                "example_id": "b17ebcb9-f173-44d3-b7e9-83f031c66ec9",
                                                "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                                "text": "Des poubelles éventrées, des détritus qui parsèment les trottoirs, des voitures contraintes de slalomer entre les sacs de déchets en divagation..."
                                            },
                                            {
                                                "example_id": "955264e7-8b7f-4ca4-9bbc-8ca30ca1781d",
                                                "sense_id": "518e1aa7-0f41-39a1-8dc0-31093473108b",
                                                "text": "Aujourd’hui du Lac et moi nous félicitions de ne rien savoir des gueules entre lesquelles nous slalomions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
