                "senses": [
                    {
                        "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                        "entry_id": "ba03cc99-1d82-3dda-b6d4-0895dfffe728",
                        "glosses": [
                            "(meist zeitlich begrenzte) Herausforderung im Bereich des Laufens, in der Regel um die Teilnehmer fürs Laufen zu motivieren"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca3ad70-f965-4aa0-b096-593ed843f02b",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„‚[…] Aber die größte Motivation vor und während des Laufs war für mich, dass wir mit der Laufchallenge auf zwei großartige Projekte (Elterninitiative Kinderkrebs/Helping Hands) aufmerksam machen können, die jederzeit Unterstützung gebrauchen können‚‘ freute sich Dombrowka.“"
                            },
                            {
                                "example_id": "cad0fe4b-15c2-4996-9140-4b016f3b11d7",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„Unser Schulleiter Herr Kösters hat zu Beginn unserer Laufchallenge gesagt, dass er gerne nach Honolulu laufen würde.“"
                            },
                            {
                                "example_id": "e5c9a9b1-11f0-493e-a4e6-8cb86fdb83e4",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„Nicht nur, weil sie gerade an einer Laufchallenge teilnimmt, wo die Gruppe gemeinsam zum Mond rennt, sondern auch, weil sie doch optimal vorbereitet sein soll für das coole Laufevent, das am Samstag startet und wo auch die Mama Moni mit von der Partie sein wird.“"
                            },
                            {
                                "example_id": "bb0f73fe-ccdf-4235-94b7-6ccedf7264d0",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„Mit dem neuen Gruppenbildschirm siehst du mehr Informationen rund um den Beitrag des Teams zu den Laufchallenges.“"
                            },
                            {
                                "example_id": "e98aef2e-a44f-463c-9280-2c6039722eeb",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„Eine Strecke von fast einhundert Marathonläufen haben 32 Polizeibeamte des Unterstützungskommandos (USK) Mittelfranken im Rahmen ihrer ‚Laufchallenge‘ absolviert – und das für den guten Zweck.“"
                            },
                            {
                                "example_id": "e53cf433-cced-4dc4-821a-2b1a9478fe2d",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "Durch eine Laufchallenge, die im Monat Januar absolviert wurde, ist unser Fitnessstand auf einem sehr guten Level.“"
                            },
                            {
                                "example_id": "c042226a-4f89-4693-b02f-d4dc6ad1f7cd",
                                "sense_id": "3de7cb92-70ec-3994-b159-856b2e57c4d7",
                                "text": "„Die Laufchallenge ist genau richtig für alle, die mit dem Joggen anfangen wollen, vorher noch nie gelaufen sind oder nach einer längeren Pause wieder mit dem Laufen einsteigen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
