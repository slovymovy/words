                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23680548-0f33-4129-8132-04977241e616",
                                                "sense_id": "5701c893-fc6b-3941-9bf1-99f0071308a1",
                                                "text": "In analogous studies in humans, when subjects view unpleasant pictures, there is an increase in the magnitude of the eyeblink reflex (measured from surface electromyographic recording from the orbicularis oculi muscle) in response to a brief burst of noise (28 )."
                                            },
                                            {
                                                "example_id": "aa581eaa-5d96-48d5-bdea-6f83e9f5d95b",
                                                "sense_id": "5701c893-fc6b-3941-9bf1-99f0071308a1",
                                                "text": "Recordings of electromyographic activity from the arm during practice of this task suggest that participants gradually learn to recruit new arm muscles and precisely control the timing of activations of these muscles in order to compensate for the force field (30 )."
                                            }
                                        ]
                                    }
