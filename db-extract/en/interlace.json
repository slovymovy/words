                    },
                    {
                        "sense_id": "bb6127d3-110e-38b5-b2be-c3c6446a61cc",
                        "entry_id": "0913d274-2e47-3989-b77d-19297148d08e",
                        "glosses": [
                            "To cross one another as if woven together; to intertwine; to blend intricately."
                        ],
