                                                "example_id": "6a5b8392-67d4-4614-bfb1-db6094a71cfb",
                                                "sense_id": "b57b316c-e0aa-36a4-9c1e-44e5becfba32",
                                                "text": "Newspapers in \"capitalist\" ownership, universities presided over by \"reactionary\" governing bodies, broadcasting systems owned by conservative governments have all been known to influence public opinion in the direction of socialism, because this was the conviction of the personnel."
                                            },
                                            {
                                                "example_id": "75e5a51f-b7b7-4cab-b81c-b4623b4461dd",
                                                "sense_id": "b57b316c-e0aa-36a4-9c1e-44e5becfba32",
                                                "text": "George Soros remains a favorite target of conservative conspiracy theorists, seeing his corrupting influence behind every liberal movement and within every nook and cranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fdecc0-ef09-342b-9637-27efb7abfa70",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Relating to the Conservative Party."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b977a985-57bc-4fb4-97ae-93e739ea14ea",
                                                "sense_id": "e6fdecc0-ef09-342b-9637-27efb7abfa70",
                                                "text": "We have always been conscientiously attached to what is called the Tory, and which might with more propriety be called the Conservative, party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c83bbcf-2913-3262-8873-cf7b656c5676",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Neither creating nor destroying a given quantity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96e3176d-ac43-3548-93f1-e75fc12a6344",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Having power to preserve in a safe or entire state, or from loss, waste, or injury; preservative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4509fd95-ed2d-4514-a679-9c99bf08b465",
                                                "sense_id": "96e3176d-ac43-3548-93f1-e75fc12a6344",
                                                "text": "Without the conservative organs, the body would receive no nourishment; and without nourishment, it would soon decay and perish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714973ea-664b-3f35-96dd-0c848a155ea5",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Relating to Conservative Judaism."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71500eb-0570-3760-ab6e-c678bede5f49",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Conventional, traditional, and moderate in style and appearance; not extreme, excessive, faddish, or intense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2a1e8d-66bc-358e-a4b4-6303cb1c9651",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Not including any operation or intervention (said of a treatment, see conservative treatment)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9900a770-b5d8-4fc3-ad51-d811b748f5b3",
                                                "sense_id": "3a2a1e8d-66bc-358e-a4b4-6303cb1c9651",
                                                "text": "Operative treatment should be reserved for those patients in whom conservative treatment has failed and who are motivated with regard to sports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13639235-0569-3f4f-a5cb-80d6ad50ed04",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "Having few changes relative to an older form, especially in comparison to related varieties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81065367-71e1-466a-bf4d-8519a76a0691",
                                                "sense_id": "13639235-0569-3f4f-a5cb-80d6ad50ed04",
                                                "text": "While innovative in its verbal system, Sardinian is the most conservative Romance language in its vocabulary and phonology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3c69f5-04a9-3fc4-a2e1-eb080884c03d",
                                        "entry_id": "3d34e25c-363e-3b6d-bf96-c1d0b8a77d30",
                                        "glosses": [
                                            "That is the gradient of a function."
                                        ],
