                                        "entry_id": "ca8d26df-4a24-3e48-bfb2-8f018f04fc94",
                                        "glosses": [
                                            "gasförmiges, farbloses, brennbares, süßlich riechendes Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9695db87-b7e5-444c-8419-82294d3ab88d",
                                                "sense_id": "890923cf-0a9b-33df-8726-d265bd0edc3b",
                                                "text": "„Es ist das einfachste Alken, ein ungesättigter Kohlenwasserstoff mit einer Kohlenstoff-Kohlenstoff-Doppelbindung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
