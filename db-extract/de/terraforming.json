                    {
                        "translation_id": "dddf8fee-fdee-488b-80bd-491f01ee8097",
                        "source_entry_id": "93b531b6-1b63-3922-b886-39ac4427af54",
                        "source_sense_id": "b5a99561-3c3c-3eef-a444-b5a36945db7e",
                        "target_lang_word": "terraformation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terraformation",
