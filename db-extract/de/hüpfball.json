                "senses": [
                    {
                        "sense_id": "cc4fee3a-f1ef-3a5f-b2b8-fff4d3c80e6a",
                        "entry_id": "a846bc55-9555-315e-af06-04027cb893bf",
                        "glosses": [
                            "Spielgerät in Form eines größeren Gummiballs mit Griff(en), mit dem man sich hüpfend fortbewegen kann, indem man sich darauf sitzend mit den Füßen vom Boden abstößt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925d9763-de76-4299-9885-3ed08ee1241f",
                                "sense_id": "cc4fee3a-f1ef-3a5f-b2b8-fff4d3c80e6a",
                                "text": "Roberta macht es großen Spaß, im Garten die Katze auf dem Hüpfball zu verfolgen."
                            },
                            {
                                "example_id": "98af1286-c2f8-4f55-bc46-61d2d7649729",
                                "sense_id": "cc4fee3a-f1ef-3a5f-b2b8-fff4d3c80e6a",
                                "text": "Von allen Spielgeräten im Kindergarten mag Vincent am liebsten die Hüpfbälle."
                            },
                            {
                                "example_id": "1e1d48cc-fdc6-4f10-ae11-5a2572523298",
                                "sense_id": "cc4fee3a-f1ef-3a5f-b2b8-fff4d3c80e6a",
                                "text": "„Aus der Stadt brachte Mama mir zum Trost ein Buch und einen Hüpfball mit, knallig orange, mit blauem Griff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
