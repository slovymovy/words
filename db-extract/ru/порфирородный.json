                "senses": [
                    {
                        "sense_id": "2bbe25c1-eef5-3229-b97a-e27ca00de505",
                        "entry_id": "20b232cc-4197-3b90-98ac-9c3745edcd23",
                        "glosses": [
                            "устар., поэт. принадлежащий к царскому роду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18ab9bb-cd7e-4c06-a888-37bc2e5cae69",
                                "sense_id": "2bbe25c1-eef5-3229-b97a-e27ca00de505",
                                "text": "Греческое царство, обуреваемое тогда внутренними смятениями, заговорами, убийством порфирородных лиц и непрестанными ссорами о правилах веры, отверзло ему путь к устремлению на разные пределы оного и основанию столицы своей в Вифинии."
                            }
                        ]
                    }
