{
    "word_family": [
        "dine",
        "diner",
        "dinner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4881eb16-7546-34ee-b664-8ca08c5dcbfb",
                    "sense_definition": "Present participle and gerund of <w>dine</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>dining</w> with our neighbors at a local restaurant tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы <w>ужинаем</w> с нашими соседями в местном ресторане.",
                                "zh": "我们今晚要在当地一家餐馆和邻居<w>用餐</w>。"
                            }
                        },
                        {
                            "text": "He prefers <w>dining</w> out on weekends rather than cooking at home.",
                            "target_lang_translations": {
                                "ru": "По выходным он предпочитает <w>обедать</w> в ресторане, а не готовить дома.",
                                "zh": "他周末更喜欢在外面<w>吃饭</w>，而不是在家里做饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eating"
                    ],
                    "common_phrases": [
                        "dining out",
                        "dining in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола dine (обедать/ужинать).",
                        "zh": "动词 dine 的现在分词和动名词形式，指用餐或进餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обедать",
                                "target_lang_sense_clarification": "принимать пищу в середине дня"
                            },
                            {
                                "target_lang_word": "ужинать",
                                "target_lang_sense_clarification": "принимать пищу вечером"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用餐",
                                "target_lang_sense_clarification": "正式或礼貌地进餐"
                            },
                            {
                                "target_lang_word": "吃饭",
                                "target_lang_sense_clarification": "日常进餐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85984a6f-4711-339b-8a4f-c72514f970b9",
                    "sense_definition": "The act of eating dinner, especially as a formal or social event.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers an exceptional fine <w>dining</w> experience for its guests.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает своим гостям исключительные впечатления от <w>изысканной кухни</w>.",
                                "zh": "这家酒店为客人提供卓越的精致<w>用餐</w>体验。"
                            }
                        },
                        {
                            "text": "We bought a new set of chairs for the <w>dining</w> room.",
                            "target_lang_translations": {
                                "ru": "Мы купили новый комплект стульев для <w>столовой</w>.",
                                "zh": "我们为<w>餐厅</w>买了一套新椅子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feasting",
                        "eating"
                    ],
                    "common_phrases": [
                        "fine dining",
                        "dining room",
                        "dining table",
                        "casual dining",
                        "dining hall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс приема пищи, особенно ужина, часто как официальное или светское мероприятие; также используется для обозначения места приема пищи.",
                        "zh": "指进餐的行为，尤指正式或社交场合的用餐；也常用于构成与用餐相关的名词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужин",
                                "target_lang_sense_clarification": "вечерний прием пищи"
                            },
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "основной прием пищи"
                            },
                            {
                                "target_lang_word": "трапеза",
                                "target_lang_sense_clarification": "торжественный или формальный прием пищи"
                            },
                            {
                                "target_lang_word": "столовая",
                                "target_lang_sense_clarification": "в значении комнаты (dining room)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用餐",
                                "target_lang_sense_clarification": "指进餐的过程或体验"
                            },
                            {
                                "target_lang_word": "餐厅",
                                "target_lang_sense_clarification": "指用餐的房间或场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26bd5ee9-a718-3617-b514-f224cb3d7db4",
                    "sense_definition": "The act of entertaining someone with dinner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was exhausted by the constant <w>dinings</w> and social events required by her job.",
                            "target_lang_translations": {
                                "ru": "Она была измотана постоянными <w>зваными ужинами</w> и светскими мероприятиями, которых требовала её работа.",
                                "zh": "她被工作所需的频繁<w>宴请</w>和社交活动搞得精疲力竭。"
                            }
                        },
                        {
                            "text": "His schedule was full of late-night <w>dinings</w> with potential clients.",
                            "target_lang_translations": {
                                "ru": "Его расписание было заполнено поздними <w>ужинами</w> с потенциальными клиентами.",
                                "zh": "他的日程表排满了与潜在客户的深夜<w>应酬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entertaining"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угощение кого-либо ужином, прием гостей за столом.",
                        "zh": "指通过宴请他人用餐来进行社交活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "званый ужин",
                                "target_lang_sense_clarification": "мероприятие с приглашением гостей"
                            },
                            {
                                "target_lang_word": "застолье",
                                "target_lang_sense_clarification": "праздничный стол с угощением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宴请",
                                "target_lang_sense_clarification": "正式邀请他人用餐"
                            },
                            {
                                "target_lang_word": "应酬",
                                "target_lang_sense_clarification": "指为了工作或社交而进行的用餐活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}