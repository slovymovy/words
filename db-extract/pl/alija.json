                                        "entry_id": "b5988199-4f80-3841-846b-e1b807bbaeb2",
                                        "glosses": [
                                            "The immigration of Jews to Israel."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a319359-fca0-4d58-9f9f-f2d6cab12bf0",
                                                "sense_id": "e3f08541-bbf8-3266-80e7-7d259cc83d53",
                                                "text": "In the past, Yemenite Jews did not have a Bar Mitzvah ceremony at all; they first encountered this ceremony when they made Aliyah to Israel."
                                            }
