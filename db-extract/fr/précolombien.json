                                        "entry_id": "6801a8ff-4038-3817-9c66-866756cfc025",
                                        "glosses": [
                                            "Referring to the cultures of the Americas before the European influence, specifically to the era before the continent was visited by Christopher Columbus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4471a656-dbc0-4619-af12-f480d06e8f62",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "pre-Columbian cultures"
                                            },
                                            {
                                                "example_id": "151841f7-587d-47ad-92fa-c921eea77b91",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "pre-Columbian civilizations"
                                            },
                                            {
                                                "example_id": "538e03a1-f1a3-4bc9-8997-215da7cdfa78",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "In fact, the dating of pre-Columbian Andean cultures was largely a matter of guesswork."
                                            },
                                            {
                                                "example_id": "4a9cb004-c468-4e42-b6f1-4750ff2e933e",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "Boys trained to be warriors, but why did pre-Columbian peoples battle one another?"
                                            }
