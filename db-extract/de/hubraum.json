                "senses": [
                    {
                        "sense_id": "93e327b1-ae15-34f9-b5ea-8dd30b1bd87a",
                        "entry_id": "bb7cf5cd-2c62-37ab-9219-564a45395060",
                        "glosses": [
                            "Volumen, das bei einem Verbrennungsmotor durch den Hub aller Kolben insgesamt verdrängt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bc37e6-4972-4fff-ba1c-fd37f00b2062",
                                "sense_id": "93e327b1-ae15-34f9-b5ea-8dd30b1bd87a",
                                "text": "„Der Zweizylinder-Motor im Fiat 500L mit seinen gerade mal 875 Kubikzentimetern Hubraum hat nun die 100-PS-Grenze überwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c3119d0-7949-45a3-96b4-9f3fa168d000",
                        "source_entry_id": "bb7cf5cd-2c62-37ab-9219-564a45395060",
                        "source_sense_id": "93e327b1-ae15-34f9-b5ea-8dd30b1bd87a",
