                                "tr": "Deneyimli dedektifler, tüm kanıtları toplamadan önce gerçeği genellikle <w>sezgiyle kavrarlar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "perceive",
                        "sense",
                        "grasp"
                    ],
                    "common_phrases": [
