                                        "examples": [
                                            {
                                                "example_id": "e93f1d86-1fb9-4d1a-af66-717c65b8e7f3",
                                                "sense_id": "2aa5c101-b639-3032-9983-1de207062bfd",
                                                "text": "I'm off with the raggle-taggle gypsy-oh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "149c95e4-d1ab-389c-9e73-f5a1b2b386fb",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Expression of mild scepticism."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa87c09-10b7-470c-8126-8fd100d187e2",
                                                "sense_id": "149c95e4-d1ab-389c-9e73-f5a1b2b386fb",
                                                "text": "\"You should watch where you're going!\" \"Oh?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876234de-e9ad-392d-a684-c38cc6413324",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "A word to mark a spoken phrase as imaginary."
