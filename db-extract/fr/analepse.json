                "senses": [
                    {
                        "sense_id": "85e84f04-6d40-3829-be38-393f48c8dc01",
                        "entry_id": "b3cfdcf1-ea6b-3a1e-8925-f298bad7803b",
                        "glosses": [
                            "Retour en arrière dans une ligne narratrice."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "80d3d765-7ea3-4ef9-b626-dbd8f73e3061",
                                "sense_id": "85e84f04-6d40-3829-be38-393f48c8dc01",
                                "text": "L’analepse sert à éclairer le passé des personnages et, ce faisant, justifier la psychologie des personnages."
                            },
                            {
                                "example_id": "30b53d67-629c-48dc-9eb9-78450d2e9de7",
                                "sense_id": "85e84f04-6d40-3829-be38-393f48c8dc01",
                                "text": "Toutes ces figures, comme on le sait, peuvent se ramener à une question d’énonciation, l’analepse étant attribuée à l’instance narrative première et la focalisation désignant le savoir du narrateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32eb2de1-a35d-4d31-9eee-d33fc4d5b5a2",
                        "source_entry_id": "b3cfdcf1-ea6b-3a1e-8925-f298bad7803b",
                        "source_sense_id": "85e84f04-6d40-3829-be38-393f48c8dc01",
                        "source_sense_description": "retour en arrière",
                        "target_lang_word": "Analepse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analepse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
                                        "entry_id": "06a86f7f-bec1-3170-8fe1-7f004366f472",
                                        "glosses": [
                                            "Erzähltechnik, bei der von vergangenen Geschehnissen erst im Nachhinein berichtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439d45a7-c07e-48df-bc94-96256bc5637b",
                                                "sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
                                                "text": "„Zusätzlich wird dann dem Risikoforscher Roger Kasperson eine Art Analepse zugeschrieben.“"
                                            },
                                            {
                                                "example_id": "e61f82cf-5617-4db9-80e5-8a896d133894",
                                                "sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
                                                "text": "„Mit dieser Gegebenheit beginnt der Film, sodass die nachfolgende Geschichte eine Analepse bildet.“"
                                            },
                                            {
                                                "example_id": "656517ef-a05c-4cb9-8f74-9aaca7843565",
                                                "sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
                                                "text": "„In dieser Analepse erzählt ein Sänger und ehemaliger Sekretärsschüler von seiner Liebe zu einem Mädchen und seiner Not.“"
                                            },
                                            {
                                                "example_id": "eb84d56f-15a2-4f81-82c9-bdb8b3d9ee6f",
                                                "sense_id": "ee274563-d8a8-330d-a72f-857e9be60133",
                                                "text": "„In jedem Fall müssen sie aufgrund der Linearität der Erzählung nacheinander geschildert werden, wobei im zweiten Fall keine Analepse zu sehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
