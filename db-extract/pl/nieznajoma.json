                        "cross_references": [
                            {
                                "target_word": "незнакомка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3c5c8f47-0f15-39ef-b6bc-ad229cea9e73",
                                        "entry_id": "76adf23c-dd17-3fab-aa98-2bd58f6b0c55",
                                        "glosses": [
                                            "женск. к незнакомец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19df17d4-f66d-4100-b677-b77bdbc9da9d",
                                                "sense_id": "3c5c8f47-0f15-39ef-b6bc-ad229cea9e73",
                                                "text": "Но таинственная незнакомка в тот самый миг, когда он добрался до второй двери, исчезла за нею, успев прищемить ему руку, и до того больно, что он с полминуты корчился, прежде чем вышел на белый свет."
                                            },
                                            {
                                                "example_id": "e37d50f1-0440-4381-a5e2-da1369fdfb35",
                                                "sense_id": "3c5c8f47-0f15-39ef-b6bc-ad229cea9e73",
                                                "text": "Ну уж нет, Соня выше этого, она печальная незнакомка среди всех этих людей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
