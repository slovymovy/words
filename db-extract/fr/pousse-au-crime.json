        "fr-extract.jsonl": [
            {
                "entry_id": "45465330-4bd9-311f-846e-ce5ef87d5615",
                "word": "pousse-au-crime",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7dfad47c-1c6b-3c4e-b1ab-954a6613296c",
                        "entry_id": "45465330-4bd9-311f-846e-ce5ef87d5615",
                        "glosses": [
                            "Qui incite à faire quelque chose qu’on ne doit pas faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54663623-2dbd-4dfa-8242-6b86a908b438",
                                "sense_id": "7dfad47c-1c6b-3c4e-b1ab-954a6613296c",
                                "text": "Que ces éminences méditent ensemble les évolutions planétaires est légitime – mais là où le bât blesse, c'est que « l'homme de Davos » couvre, dès la décennie 2000, les pratiques d'une « finance pousse-au-crime » ; et rejette avec horreur l’idée même d’une « face noire de la mondialisation »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b516e6e9-12e5-30eb-9e15-89fd097c8af1",
                "word": "pousse-au-crime",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e59f0d5b-9972-39dc-af6a-b1f365c32202",
                        "entry_id": "b516e6e9-12e5-30eb-9e15-89fd097c8af1",
                        "glosses": [
                            "Personne ou chose qui incite à faire quelque chose qu’on ne doit pas faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0549fc-dae5-4909-94de-f86002db7bce",
                                "sense_id": "e59f0d5b-9972-39dc-af6a-b1f365c32202",
                                "text": "Sans doute, au cours de ces bectances de marché noir, on doit se laisser aller facile de combine en compromission, entre la poire et le fromage, du pousse-café au pousse-au-crime."
                            },
                            {
                                "example_id": "abb1c4b1-1ceb-4928-ae6b-850ea522d011",
                                "sense_id": "e59f0d5b-9972-39dc-af6a-b1f365c32202",
                                "text": "Toujours positif, drôle et entraînant, Rémi joue la carte de l’ami complice, en aucun cas au pousse-au-crime."
                            },
                            {
                                "example_id": "f9bd67b9-8635-4f68-8517-aa654eec9c21",
                                "sense_id": "e59f0d5b-9972-39dc-af6a-b1f365c32202",
                                "text": "La volonté de plaire était peut-être un pousse-au-crime plus puissant encore que la méchanceté ou la cupidité."
                            }
                        ]
                    },
                    {
                        "sense_id": "1579adda-6996-3751-ab7b-282110ae1183",
                        "entry_id": "b516e6e9-12e5-30eb-9e15-89fd097c8af1",
                        "glosses": [
                            "Vin rouge bas de gamme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5480002d-5c7f-4503-9e0a-2d4ee8d08651",
                                "sense_id": "1579adda-6996-3751-ab7b-282110ae1183",
                                "text": "De pousse-au-crime, point, mais rien que des vins choisis, secs, gouleyants et de bonne tenue tels que Moulin-à-Vent, Fleurie, Châblis, Meursault, Gamay et Pernand-Vergelesse ; même des vins vieux arrosèrent cette franche lippée et, tout comblés, les estomacs se mirent gaillardement au travail."
                            }
                        ]
                    }
                ],
