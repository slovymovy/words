                ],
                "senses": [
                    {
                        "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                        "entry_id": "389729c8-fb0b-339c-9b7f-d15921e0132d",
                        "glosses": [
                            "weibliche Person, welche sich für die Rechte für Frauen einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e0f77a-01de-442f-b721-155afecdabb9",
                                "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                                "text": "Sie ist mindestens so streitlustig wie umstritten, dabei werden ihre Verdienste um die Gleichberechtigung allgemein anerkannt – Alice Schwarzer ist Deutschlands bekannteste Frauenrechtlerin."
                            },
                            {
                                "example_id": "96859faa-446d-4013-8b7f-0cea64493f92",
                                "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                                "text": "„Seit 1957, dachte ich unwillkürlich, und war nun zur Besänftigung von Herrn Jackopp sogar gezwungen, die Sache der Frauenrechtlerinnen zu vertreten, denen allerdings, wie man weiß, auch ich mit großen Vorbehalten begegne.“"
                            },
                            {
                                "example_id": "98317145-7c86-48e3-a644-2a01cd03285a",
                                "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                                "text": "„Die Frauenrechtlerin scherte sich darum aber nicht, sondern setzte ihre Arbeit in München einfach illegal fort.“"
                            },
                            {
                                "example_id": "4d028f66-620b-495e-a453-3e9a3842db85",
                                "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                                "text": "„Deshalb hoffen viele auf frischen Wind durch die pragmatische Frauenrechtlerin.“"
                            },
                            {
                                "example_id": "b83b52af-d37a-40a4-9156-8a3fefd3117c",
                                "sense_id": "57e72de2-97b6-3b1f-9a6d-7ad67d9b41e6",
                                "text": "„Dass der Streit zwischen Transaktivisten und traditionellen Frauenrechtlerinnen um die politisch korrekte Kennzeichnung von Bedürfnisanstalten in Frankfurt nun sogar in Gewalttätigkeit mündete, macht es nicht leichter, das Thema ernst zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e82b6fcd-686f-4a9f-adac-0675bd835cf0",
