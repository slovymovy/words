                {
                    "sense_id": "35ee1860-b8a8-37a6-bd79-cd297cb0e11d",
                    "sense_definition": "Qui ne laisse aucun espoir d'amélioration, d'issue favorable ou de guérison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médecins ont annoncé à la famille que l'état du patient était devenu <w>désespéré</w>.",
                            "target_lang_translations": {
                                "en": "The doctors told the family that the patient's condition had become <w>hopeless</w>.",
                                "ru": "Врачи сообщили семье, что состояние пациента стало <w>безнадёжным</w>.",
                                "de": "Die Ärzte teilten der Familie mit, dass der Zustand des Patienten <w>aussichtslos</w> geworden war.",
                                "es": "Los médicos comunicaron a la familia que el paciente se encontraba en una situación <w>desesperada</w>.",
                                "zh": "医生告诉家属，病人的病情已经<w>无望</w>。"
                            }
                        },
                        {
                            "text": "Dans un effort <w>désespéré</w>, l'équipe a tenté d'égaliser avant le coup de sifflet final.",
                            "target_lang_translations": {
                                "en": "In a <w>desperate</w> effort, the team tried to equalise before the final whistle.",
                                "ru": "В <w>отчаянной</w> попытке команда пыталась сравнять счёт до финального свистка.",
                                "de": "In einem <w>aussichtslosen</w> Versuch bemühte sich das Team, vor dem Schlusspfiff noch den Ausgleich zu erzielen.",
                                "es": "En un esfuerzo <w>desesperado</w>, el equipo intentó empatar antes del pitido final.",
                                "zh": "终场哨响前，球队做出了一次<w>绝望</w>的努力，试图扳平比分。"
                            }
                        }
                    ],
                    "synonyms": [
