                        "cross_references": [
                            {
                                "target_word": "vorfertigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "537703d9-aa87-398f-97ff-47e8cf0da61e",
                                        "entry_id": "9f33a9ca-b028-3690-9167-97b993d6efce",
                                        "glosses": [
                                            "für eine spätere Verwendung, einen späteren Zusammenbau/Einsatz herstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f1cce56-0f7e-4493-86f0-1e172dd711e1",
                                                "sense_id": "537703d9-aa87-398f-97ff-47e8cf0da61e",
                                                "text": "„Es muß angestrebt werden, nach Möglichkeit die Betonfertigteile für den jeweiligen Bauabschnitt in voller Anzahl vorzufertigen, damit die Montage fließend vonstatten geht.“"
                                            },
                                            {
                                                "example_id": "fb3eaeff-403f-4ed7-b1e2-0e6f07d7306e",
                                                "sense_id": "537703d9-aa87-398f-97ff-47e8cf0da61e",
                                                "text": "„Wer Lerninhalte im Voraus rundweg ablehnt oder wer eine vorgefertigte Meinung hat, von der er nicht abweicht, kann nicht wirklich lernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
