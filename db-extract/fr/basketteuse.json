                "senses": [
                    {
                        "sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                        "entry_id": "c5dc3496-643c-3a0e-b032-7000b0393ff1",
                        "glosses": [
                            "Sportive pratiquant le basket-ball."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a55e2a2-49a0-4cc7-9f47-5be54a4814fc",
                                "sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                                "text": "J’ai commencé à faire du sport à l’école normale d’institutrice. J’ai commencé par une pratique de basketteuse. J’ai fait du basket jusqu’à il y a pas très longtemps encore."
                            },
                            {
                                "example_id": "60359a11-19bb-4ec0-93ad-5ebf1f0710ab",
                                "sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                                "text": "La justice russe avait rejeté le 25 octobre l’appel de la basketteuse américaine, condamnée en Russie à neuf ans de prison pour trafic de cannabis, sur fond de très fortes tensions entre Moscou et Washington."
                            },
                            {
                                "example_id": "d2ed49cb-334f-4ed4-be2a-4e0623a67382",
                                "sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                                "text": "La Russie a annoncé, jeudi, avoir échangé avec les États-Unis la basketteuse américaine Brittney Griner, emprisonnée pour trafic de cannabis, contre le célèbre marchand d’armes russe Viktor Bout, détenu par les Américains depuis plus de dix ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67e0b284-9ee1-40da-b2f7-df2c4059e284",
                        "source_entry_id": "c5dc3496-643c-3a0e-b032-7000b0393ff1",
                        "source_sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                        "source_sense_description": "Sportive pratiquant le basket-ball",
                        "target_lang_word": "Basketballerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basketballerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a1340e-5a51-3422-9e79-6231988ff8f9",
                                        "entry_id": "1a8f391e-c835-385e-aaca-571ac003981d",
                                        "glosses": [
                                            "Sportlerin, die das Basketballspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc60ea3-4a3b-4731-962c-9e5cda773fbd",
                                                "sense_id": "e7a1340e-5a51-3422-9e79-6231988ff8f9",
                                                "text": "Nach einer schnellen Drehung konnte die Basketballerin den Ball im Korb versenken."
                                            },
                                            {
                                                "example_id": "1edc474e-b10c-4110-8ed7-b7c54fa11c84",
                                                "sense_id": "e7a1340e-5a51-3422-9e79-6231988ff8f9",
                                                "text": "„Seit ihr Herz sieben Minuten lang stillstand, spielt Rebecca Tobin mit implantiertem Defibrillator. Das finden nicht alle Ärzte gut - doch ein anderes Leben kann sich die Basketballerin nicht vorstellen.“"
                                            },
                                            {
                                                "example_id": "d08af63a-327b-48e2-a3e6-59f294cc1984",
                                                "sense_id": "e7a1340e-5a51-3422-9e79-6231988ff8f9",
                                                "text": "„Die Basketballerinnen aus Frankreich haben bei der EM die Schweiz mit einer historischen Niederlage nach Hause geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6384515-f067-4e94-a146-0a5f63c2a1d9",
                        "source_entry_id": "c5dc3496-643c-3a0e-b032-7000b0393ff1",
                        "source_sense_id": "ec8ab23a-a19d-3cea-a340-6ae09f201960",
                        "source_sense_description": "Sportive pratiquant le basket-ball",
                        "target_lang_word": "Basketballspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basketballspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f61505ed-3e06-326a-b33b-75ea95253c47",
                                        "entry_id": "bf013c14-ebf7-3e13-b334-9a33d6c6a66e",
                                        "glosses": [
                                            "Sportlerin, die das Basketballspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c254f4-b1ad-48be-a6e2-9303be221592",
                                                "sense_id": "f61505ed-3e06-326a-b33b-75ea95253c47",
                                                "text": "Die Basketballspielerin fällt wegen einer Knieverletzung für diese Saison aus."
                                            },
                                            {
                                                "example_id": "df838ce1-b434-47a0-a98a-fc58b6aa23e7",
                                                "sense_id": "f61505ed-3e06-326a-b33b-75ea95253c47",
                                                "text": "„Ein dunkler Teil seiner Vergangenheit hat den Entertainer eingeholt. Die frühere Basketballspielerin Andrea Constand, die er einst an der Temple Universität kennenlernte, wirft ihm vor, sie an einem Abend 2004 sexuell missbraucht zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "075e0730-0f4f-4350-8f83-ed8cc87a8a3c",
