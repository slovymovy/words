                        "sense_id": "d2a0dc10-4d09-3f34-b31a-3ec205a2ee40",
                        "entry_id": "2943a6cb-9d43-355a-9aac-8aa53e3f8d22",
                        "glosses": [
                            "Form des Unterrichts, bei der meist ein Wechsel von Präsenzunterricht in der Schule und Fernunterricht zuhause stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95585c43-bb19-4b11-89f6-d346136ae0f3",
                                "sense_id": "d2a0dc10-4d09-3f34-b31a-3ec205a2ee40",
                                "text": "„Ob und wie Wechselunterricht umgesetzt wird, entscheiden weiter die Länder oder die Schulen vor Ort.“"
                            },
                            {
                                "example_id": "10ea5bef-c7a9-4996-b312-e537415b333c",
                                "sense_id": "d2a0dc10-4d09-3f34-b31a-3ec205a2ee40",
                                "text": "„Wechselunterricht sei in Baden-Württemberg bereits zwischen Pfingsten und den Sommerferien ausprobiert worden – allerdings ohne durchschlagenden Erfolg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
