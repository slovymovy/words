                        "source_entry_id": "a759e099-baa5-3edd-8610-7b42bc70ffe2",
                        "source_sense_id": "0f847e1a-424b-386f-ac88-6c969fce7a77",
                        "source_sense_description": "(Jewish) marriage broker, matchmaker",
                        "target_lang_word": "Schadchen",
