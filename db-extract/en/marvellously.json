                        "glosses": [
                            "In a marvellous manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c9a4100-e15f-4ddf-be94-df9073f1c24d",
                                "sense_id": "5ed46fdf-d54b-34bc-92bc-1b7348eaf0f6",
                                "text": "The plan worked marvellously, even better than we had expected."
                            }
                        ]
                    },
                    {
                        "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                        "entry_id": "ae034daf-a3f5-3b11-b41b-8472d66b24b0",
                        "glosses": [
                            "To a great or impressive degree; very."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3141e0b-5e04-4c22-af49-403be0f41c4a",
                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                "text": "[N]eyther hys ſeruantes nor hymſelf ſuffered to gone^([sic – meaning go?]) oute, parceiuyng well ſo greate a thyng without his knowledge not begun for noughte, comparyng this maner preſẽ[n]t with this laſt nightes chere, ĩ[n] ſo few houres ſo gret a chaunge marueylouſlye miſliked."
                            },
                            {
                                "example_id": "1649bebf-b581-4e5a-8de8-55d3ab5eec75",
                                "sense_id": "052e2166-1399-3b18-b4e6-93bd728e1c7d",
                                "text": "I groaned with hunger. I had seen a marvellously large penny loaf at a baker's—the largest I could possibly get for the price."
                            }
                        ]
                    }
                ],
