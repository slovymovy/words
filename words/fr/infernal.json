                    ]
                },
                {
                    "sense_id": "cce4a2de-539b-3449-872f-dbffafc40dc1",
                    "sense_definition": "Excessif, intolérable ou impossible à rompre, rappelant les tourments de l'enfer.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensite_penible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pays tente d'échapper à cette spirale <w>infernale</w> d'inflation et de chômage."
                        },
                        {
                            "text": "Nous avons subi une chaleur <w>infernale</w> pendant plusieurs semaines d'été."
