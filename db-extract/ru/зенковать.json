                    },
                    {
                        "translation_id": "2e128aa9-a362-40ee-bce2-adfa5cf2af32",
                        "source_entry_id": "e8fdfd03-f808-3e88-8b6f-0d72f94cf56b",
                        "source_sense_id": "3416eedd-4495-362a-ae82-81d2250c487b",
                        "target_lang_word": "senken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d17f5ab-0fc3-3c72-a38c-87d9c4aee434",
                                        "entry_id": "7520bd39-d5aa-33cc-974c-e0d2253546e1",
                                        "glosses": [
                                            "in eine niedrigere Position bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527f790e-f0c8-46da-93c3-977873f10529",
                                                "sense_id": "6d17f5ab-0fc3-3c72-a38c-87d9c4aee434",
                                                "text": "Der Boden senkt sich jedes Jahr einige Zentimeter."
                                            },
                                            {
                                                "example_id": "ec0555d5-e7f3-4a98-8913-eade9069cd0f",
                                                "sense_id": "6d17f5ab-0fc3-3c72-a38c-87d9c4aee434",
                                                "text": "Mit gesenktem Haupt stand er vor mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38c3bff2-dfd6-3846-8bc7-8eacb4d42604",
                                        "entry_id": "7520bd39-d5aa-33cc-974c-e0d2253546e1",
                                        "glosses": [
                                            "ermäßigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5434cc09-b7c0-4215-b7e7-0dc1a9b0ee8d",
                                                "sense_id": "38c3bff2-dfd6-3846-8bc7-8eacb4d42604",
                                                "text": "Man könnte die Preise senken."
                                            },
                                            {
                                                "example_id": "0188c4b8-9fe0-4836-80a2-bcfa7d6579dc",
                                                "sense_id": "38c3bff2-dfd6-3846-8bc7-8eacb4d42604",
                                                "text": "Der Internationale Währungsfonds warnt vor einer neuen globalen Wirtschaftskrise. Weil die Konjunktur schlechter läuft als bisher angenommen, senkte die Organisation ihren Ausblick weiter."
                                            },
                                            {
                                                "example_id": "a2fb2aca-34a3-477e-9dae-093298815389",
                                                "sense_id": "38c3bff2-dfd6-3846-8bc7-8eacb4d42604",
                                                "text": "Die EZB senkt den Leitzins, verhängt einen Strafzins für Banken - und spült Milliarden in die Finanzmärkte."
                                            },
                                            {
                                                "example_id": "6065d162-fdba-46a8-8b5c-5049a12af770",
                                                "sense_id": "38c3bff2-dfd6-3846-8bc7-8eacb4d42604",
                                                "text": "Die Absatzprognose senkte der Konzern [Toyota] […] leicht von 9,05 Millionen Fahrzeugen auf neun Millionen Autos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7bf0b839-7aeb-343d-bebc-35dc45d64261",
                                        "entry_id": "7520bd39-d5aa-33cc-974c-e0d2253546e1",
                                        "glosses": [
                                            "auf einen niedrigeren Wert bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5bf567-96b7-48bd-89a8-c8560f8a608b",
                                                "sense_id": "7bf0b839-7aeb-343d-bebc-35dc45d64261",
                                                "text": "Das senkt den Blutzuckerspiegel."
                                            },
                                            {
                                                "example_id": "7b57f70c-33cb-4ce7-93ed-73ca94270d02",
                                                "sense_id": "7bf0b839-7aeb-343d-bebc-35dc45d64261",
                                                "text": "In den USA zog man nach ähnlichen Zwischenfällen [Beinahe-Flugunfällen nach völliger Übermüdung von Piloten in Europa] Anfang des Jahres Konsequenzen und senkte die Arbeitszeit der Piloten in der Nacht auf neun Stunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "01fcd557-d7da-3506-a659-7b95dea2a694",
                                        "entry_id": "7520bd39-d5aa-33cc-974c-e0d2253546e1",
                                        "glosses": [
                                            "abwärts bewegen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f9f447-6a50-4618-b875-2a5f7c8bbdcf",
                                                "sense_id": "01fcd557-d7da-3506-a659-7b95dea2a694",
                                                "text": "Der Wasserspiegel senkte sich sichtlich."
                                            },
                                            {
                                                "example_id": "c2894e82-5e2e-4e69-8ba6-849a68c45336",
                                                "sense_id": "01fcd557-d7da-3506-a659-7b95dea2a694",
                                                "text": "Gegen den sich senkenden Beckenboden müssen wir etwas unternehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3eacef9-3d07-4179-8859-c07f28ed4ed5",
                        "source_entry_id": "e8fdfd03-f808-3e88-8b6f-0d72f94cf56b",
                        "source_sense_id": "3416eedd-4495-362a-ae82-81d2250c487b",
                        "target_lang_word": "versenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec253057-a5be-3254-a18b-192c7a88c2e5",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "in einem anderen Objekt bündig verschwinden lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f3b483-07b4-4f07-a490-2cc616fffad3",
                                                "sense_id": "ec253057-a5be-3254-a18b-192c7a88c2e5",
                                                "text": "„Schrauben, die mit Metallteilen des Apparates in Berührung sind, wird man immer versenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57039a37-8df6-3808-9ff4-bd93d666f058",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "(Schiffe) untergehen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1509c69b-7678-4c67-a16e-e6b50543e089",
                                                "sense_id": "57039a37-8df6-3808-9ff4-bd93d666f058",
                                                "text": "„Um ein 90 Meter großes Loch im Damm bei Fischbeck zu stopfen, wurden am Samstag zwei Lastkähne in der Elbe versenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bba93a8-25d7-32d8-8035-f7adc7124ad4",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "sich in eine Tätigkeit vertiefen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ef5222-52bd-4104-9261-5108c931c363",
                                                "sense_id": "8bba93a8-25d7-32d8-8035-f7adc7124ad4",
                                                "text": "„Die Suche nach dem Weg war also nicht mehr nur auf die stille Zen-Halle beschränkt, wo man sich sitzend in Meditation versenkte; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fdc62cec-d2f0-3ba4-9f19-5e9cad3aa91f",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "(ins Tor) treffen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a506e4d-8a9d-463e-80ba-3078c46fc22e",
                                                "sense_id": "fdc62cec-d2f0-3ba4-9f19-5e9cad3aa91f",
                                                "text": "„Steilpass Bein, Ball nach drei Minuten trocken versenkt - erstes Tor. Freistoß ins linke untere Toreck - Nummer zwo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "73b2bfb5-7fe1-30f5-9760-78e8d21488d6",
                                        "entry_id": "8180fdd8-f0aa-35d3-9b9f-8980b8180cdd",
                                        "glosses": [
                                            "tief eintauchen"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94e9eaf-4c9f-48d6-b7b9-b3b7a211592f",
                                                "sense_id": "73b2bfb5-7fe1-30f5-9760-78e8d21488d6",
                                                "text": "„[…]: saß er nieder und versenkte die Augen in die Züge seines Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
