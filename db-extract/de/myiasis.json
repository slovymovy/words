                                        "glosses": [
                                            "Parasitose causée par les larves de mouches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdf064f-f801-4db3-9910-501f3c4b9b93",
                                                "sense_id": "202b44ea-9472-352b-bcba-4ca0cc68c54f",
                                                "text": "Myiase cavitaire, cutanée, intestinale."
                                            },
                                            {
                                                "example_id": "7fcaa7a2-ded9-470f-a68a-7005bb1dae20",
                                                "sense_id": "202b44ea-9472-352b-bcba-4ca0cc68c54f",
                                                "text": "Le terme de myiase désigne l’ensemble des désordres produits dans l’organisme d’un animal par une larve de Diptère."
                                            },
                                            {
                                                "example_id": "24901594-71b1-4d3b-bd0f-3319a6664c55",
                                                "sense_id": "202b44ea-9472-352b-bcba-4ca0cc68c54f",
                                                "text": "Les myiases s’observent chez tous les animaux, mais elles sont plus fréquentes et plus graves chez les moutons. L’homme peut également en être victime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
