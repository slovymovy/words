                "senses": [
                    {
                        "sense_id": "3866d627-a781-356e-b815-264950664e92",
                        "entry_id": "9ccc7a9b-3c63-3b8e-b0e4-f445895b5c8f",
                        "glosses": [
                            "Assurer le portage de son bateau sur une section où il ne peut pas naviguer."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "3c9d4d46-3db5-4438-a27a-16d2db24b741",
                                "sense_id": "3866d627-a781-356e-b815-264950664e92",
                                "text": "La façon la plus efficace pour portager est qu'une personne porte le canoë renversé sur les épaules, au moyen du joug."
                            },
                            {
                                "example_id": "e5a4e609-cfb2-4652-9b1a-de2922873aed",
                                "sense_id": "3866d627-a781-356e-b815-264950664e92",
                                "text": "Heureusement, vous n'avez pas à portager."
                            },
                            {
                                "example_id": "88f01322-fa0e-422f-9c4a-ce48e275b708",
                                "sense_id": "3866d627-a781-356e-b815-264950664e92",
                                "text": "Si tu n'as pas l'intention de portager ton canot, le poids n'est pas un problème."
                            }
                        ]
                    }
                ],
