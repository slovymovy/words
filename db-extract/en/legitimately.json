                                                "sense_id": "0b5a0a6b-94f4-35b7-b83c-e287082fcfeb",
                                                "text": "Sein Verhalten war legitim."
                                            },
                                            {
                                                "example_id": "b4af5d25-be9f-4f6e-98f4-c6d3233310a0",
                                                "sense_id": "0b5a0a6b-94f4-35b7-b83c-e287082fcfeb",
                                                "text": "Das ist ein legitimer Einwand."
                                            },
                                            {
                                                "example_id": "c704fcb9-4b91-46aa-9a2c-15f725dcfc44",
                                                "sense_id": "0b5a0a6b-94f4-35b7-b83c-e287082fcfeb",
                                                "text": "\"Formell war er [Claus Schenk Graf von Stauffenberg] ein Hochverräter, aber ich halte das, was er getan hat [das Attentat auf A. Hitler am 20. Juli 1944], für legitim."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "347325a9-819e-3c42-8994-7a61ae562144",
                                        "entry_id": "3353859f-5b76-38a1-bea2-f59cfff91566",
