                                        "entry_id": "9fefb21e-57b9-30d2-b586-133ff61cf02c",
                                        "glosses": [
                                            "Insular (withdrawn) behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "330ca462-5156-4817-b8f5-b64027248b23",
                                                "sense_id": "82490d80-2f3f-36fe-87e7-2478b6a3d99b",
                                                "text": "So many voices of so various countries cannot be simply set aside: unless we wrap ourselves in an insolent insularism, we are bound at least to ask what is the meaning of their concurrent testimony."
                                            }
                                        ]
                                    }
                                ]
                            }
