    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d23869da-f7cf-366a-bad8-48962764d52d",
                    "sense_definition": "Een automaat waar iemand met een bankpas geld van zijn of haar rekening kan halen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geldautomaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet eerst even langs de <w>pinautomaat</w> om wat contant geld op te nemen.",
                            "target_lang_translations": {
                                "en": "I first need to stop by the <w>ATM</w> to withdraw some cash."
                            }
                        },
                        {
                            "text": "Er staat een lange rij voor de <w>pinautomaat</w> in de supermarkt.",
                            "target_lang_translations": {
                                "en": "There is a long queue in front of the <w>cash machine</w> in the supermarket."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld uit de pinautomaat"
                    ],
                    "target_lang_definitions": {
                        "en": "A machine where someone can withdraw money from their bank account using a debit card."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ATM",
                                "target_lang_sense_clarification": "automated teller machine"
                            },
                            {
                                "target_lang_word": "cash machine",
                                "target_lang_sense_clarification": "machine for withdrawing cash"
                            },
                            {
                                "target_lang_word": "cashpoint",
                                "target_lang_sense_clarification": "UK term for cash machine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fff359-c30f-3912-8efb-bc93a94c52ac",
                    "sense_definition": "Een apparaat in een winkel of horecagelegenheid waarmee klanten elektronisch kunnen betalen met een bankpas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "betaalterminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkelier vroeg of ik de pas tegen de <w>pinautomaat</w> wilde houden.",
                            "target_lang_translations": {
                                "en": "The shopkeeper asked if I wanted to hold the card against the <w>card reader</w>."
                            }
                        },
                        {
                            "text": "Helaas is de <w>pinautomaat</w> bij de kassa momenteel buiten werking.",
                            "target_lang_translations": {
                                "en": "Unfortunately, the <w>payment terminal</w> at the cash register is currently out of order."
                            }
                        }
                    ],
                    "synonyms": [
                        "betaalautomaat"
                    ],
                    "common_phrases": [
                        "de pinautomaat bij de kassa"
                    ],
                    "target_lang_definitions": {
                        "en": "A device in a shop or restaurant that allows customers to pay electronically using a debit card."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "card reader",
                                "target_lang_sense_clarification": "device for card payments"
                            },
                            {
                                "target_lang_word": "payment terminal",
                                "target_lang_sense_clarification": "electronic payment device"
                            },
                            {
                                "target_lang_word": "card machine",
                                "target_lang_sense_clarification": "terminal used in shops"
                            }
                        ]
                    }
                }
            ]
        }
    ]
