                "senses": [
                    {
                        "sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                        "entry_id": "4588d286-4445-30f0-a406-0d113d3778fb",
                        "glosses": [
                            "het verschijnsel waarbij een ster en twee of meer andere hemellichamen in één lijn komen te staan, waardoor de schaduw van het ene hemellichaam het andere verduistert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ff7964-cbaa-4fd2-96f2-a8773510f51a",
                                "sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                                "text": "De zons- en maansverduistering zijn de voor de mens meest zichtbare eclipsen."
                            },
                            {
                                "example_id": "51e7a348-6a26-4609-867a-0a18b6379d9b",
                                "sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                                "text": "Het verduisteren van de maan begon rond 04.30 uur en een uur later begon de totale eclips. Maar doordat een kwartiertje later de zon alweer opkwam in Nederland, kon alleen de start worden waargenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a258aedf-e3de-4080-8884-ac3d3cb485ba",
                        "source_entry_id": "4588d286-4445-30f0-a406-0d113d3778fb",
                        "source_sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                        "source_sense_description": "het verschijnsel waarbij een ster en twee of meer andere hemellichamen in één lijn komen te staan, waardoor de schaduw van het ene hemellichaam het andere verduistert",
                        "target_lang_word": "Eklipse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eklipse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccc061c-a902-3844-ac14-23078c59ae58",
                                        "entry_id": "cafd693d-b2f1-3897-87b8-145d2a6d8c85",
                                        "glosses": [
                                            "die Verdunkelung oder das Verschwinden von Himmelskörpern wie Sonne oder Mond durch Überdeckung durch andere Körper"
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46fd30a-4678-42ba-a326-86df3681ec75",
                                                "sense_id": "2ccc061c-a902-3844-ac14-23078c59ae58",
                                                "text": "„Für diejenigen, die nicht zum Zentrum der Eklipse im Süden Deutschlands reisen können, soll das eine Entschädigung sein.“"
                                            },
                                            {
                                                "example_id": "a69f5d5b-2b2c-46ca-ae38-2e173e4f54a7",
                                                "sense_id": "2ccc061c-a902-3844-ac14-23078c59ae58",
                                                "text": "„Grundsätzlich: Eine irdische Sonnenfinsternis oder eine Eklipse tritt ein, wenn die Sonne durch den Mond ganz oder teilweise verdeckt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "895c6a4e-cb4f-3927-82a1-e41531233d5e",
                                        "entry_id": "cafd693d-b2f1-3897-87b8-145d2a6d8c85",
                                        "glosses": [
                                            "Stadium der Virusinfektion zwischen dem Zelleintritt und der Replikation"
                                        ],
                                        "tags": [
                                            "Virologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d09dfdd-2846-4d57-9f22-b649ae265bbc",
                                                "sense_id": "895c6a4e-cb4f-3927-82a1-e41531233d5e",
                                                "text": "„Im Falle der Retroviren, mancher DNA-Viren (z. B. Adeno-assoziierte Viren), und temperenter Phagen, kann die DNA in das Genom der Wirtszelle integriert werden. Die Eklipse umfasst also auch, wenn vorhanden, den lysogenen Zyklus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f0773ce4-d77a-3e73-9da5-e23979a7a5ce",
                                        "entry_id": "cafd693d-b2f1-3897-87b8-145d2a6d8c85",
                                        "glosses": [
                                            "bestimmte Art der Anlautmutation in inselkeltischen Sprachen"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6e31ff-2481-4a45-92bc-a7d6e0e6998f",
                                                "sense_id": "f0773ce4-d77a-3e73-9da5-e23979a7a5ce",
                                                "text": "„Umgekehrt manifestiert sich Eklipse bei vokalischen Anlauten als n-Vorschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3a34beb-a97c-4134-bb86-b07adf48d473",
                        "source_entry_id": "4588d286-4445-30f0-a406-0d113d3778fb",
                        "source_sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                        "source_sense_description": "het verschijnsel waarbij een ster en twee of meer andere hemellichamen in één lijn komen te staan, waardoor de schaduw van het ene hemellichaam het andere verduistert",
                        "target_lang_word": "eclipse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eclipse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62e31246-39db-35b0-9e2e-e3aa508a9ded",
                                        "entry_id": "f05433e5-73b4-393d-97fc-69427f4ea5b0",
                                        "glosses": [
                                            "An alignment of astronomical objects whereby one object comes between the observer (or notional observer) and another object, thus obscuring the latter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45d38d59-84e5-3b1c-b1d7-6d2400efb0cd",
                                        "entry_id": "f05433e5-73b4-393d-97fc-69427f4ea5b0",
                                        "glosses": [
                                            "Especially, an alignment whereby a planetary object (for example, the Moon) comes between the Sun and another planetary object (for example, the Earth), resulting in a shadow being cast by the middle planetary object onto the other planetary object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e05c876b-bbb8-30f5-900a-4b9636c8cd41",
                                        "entry_id": "f05433e5-73b4-393d-97fc-69427f4ea5b0",
                                        "glosses": [
                                            "A seasonal state of plumage in some birds, notably ducks, adopted temporarily after the breeding season and characterised by a dull and scruffy appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                        "entry_id": "f05433e5-73b4-393d-97fc-69427f4ea5b0",
                                        "glosses": [
                                            "Obscurity, decline, downfall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75694fd7-d89e-495a-be05-23599f3aff13",
                                                "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                                "text": "a. 1618, Walter Raleigh, quoted in Eclipse, entry in 1805, Samuel Johnson, A Dictionary of the English Language, Volume 2, unnumbered page,\nAll the posterity of our first parents suffered a perpetual eclipse of spiritual life."
                                            },
                                            {
                                                "example_id": "d4e07f78-473c-4736-80d2-901678bbfdd2",
                                                "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                                "text": "As in the soft and sweet eclipse,\n When soul meets soul on lovers' lips."
                                            },
                                            {
                                                "example_id": "9612c96a-1abf-4181-9cd3-7e09c37dddaf",
                                                "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                                "text": "Nor were the wool prospects much better. The pastoral industry, which had weathered the severe depression of the early forties by recourse to boiling down the sheep for their tallow, and was now firmly re-established as the staple industry of the colony, was threatened once more with eclipse."
                                            },
                                            {
                                                "example_id": "f02b5bcb-d792-4ec8-b69b-10da26a10271",
                                                "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                                "text": "Aubrey was rapturous. All her other playthings went into eclipse and the doings of the Geezenstacks occupied most of her waking thoughts."
                                            },
                                            {
                                                "example_id": "50f11c2b-3989-4233-b4e2-4f9dd1c560f0",
                                                "sense_id": "6ef1a3a9-d813-3182-bab6-454b8f3c26ff",
                                                "text": "From the standpoint of the Buddhist historian, it would be futile to attempt to distinguish, on the basis of doctrine, between the T’ien-t’ai Buddhism of the Sui and the various T’ang schools, since they share common ideals. Yet despite the “T’ang” character of the T’ien-t’ai school, it entered an almost total eclipse during the first half of the T’ang dynasty."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eclipse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43398ed9-3fec-39d9-9da4-091606cf3388",
                                        "entry_id": "3da3f4a7-909d-3e65-ba44-b1455c1bf06c",
                                        "glosses": [
                                            "Of astronomical or atmospheric bodies, to cause an eclipse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c92aaf-a51c-4a48-ab23-4409e52f95d2",
                                                "sense_id": "43398ed9-3fec-39d9-9da4-091606cf3388",
                                                "text": "The Moon eclipsed the Sun."
                                            },
                                            {
                                                "example_id": "8cbcc754-cacb-4ecd-a9af-e6e8b767d064",
                                                "sense_id": "43398ed9-3fec-39d9-9da4-091606cf3388",
                                                "text": "She turned to the casement on which the moon was shining; for the high wind had driven aside the clouds, whose huge dark masses threatened soon to eclipse the pale and dim circle of passing light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                        "entry_id": "3da3f4a7-909d-3e65-ba44-b1455c1bf06c",
                                        "glosses": [
                                            "To overshadow; to be better or more noticeable than."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67b730db-5fd6-4636-a9c7-0ed331c4954c",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "For, till I see them here, by doubtful fear / My joy of liberty is half eclips'd."
                                            },
                                            {
                                                "example_id": "01593236-f0b6-440f-92f2-c23b35a16e97",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "[H]is ſupercilious glances grevv humbled, yea, his dazeling ſplendor (eclipſt in the ſetting [i.e., death] of his Maſter) becomes quickly darkned: […]"
                                            },
                                            {
                                                "example_id": "3a7210f6-2a35-4ede-9548-403cecf64fa5",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "I wish I could prevail on Ethel to come up to London, if it were but for the sake of eclipsing her rival. I will stand godmother to the town's admiration, and promise and vow three things in its name:—first, that she will forget her faithless swain in the multitude of new ones; secondly, that she will be universally ran after; and, thirdly, that she will be brilliantly married."
                                            },
                                            {
                                                "example_id": "e7ed0962-5d3d-4506-919e-d47da785211a",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "The name of the eclipsing girl, whatever it was, has not been handed down; but she was envied by all as the first who enjoyed the luxury of a masculine partner that evening."
                                            },
                                            {
                                                "example_id": "75612f6b-cbe7-48d0-af78-23533dbc555f",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "The Util.System namespace eclipses the top-level System namespace."
                                            },
                                            {
                                                "example_id": "75cef0a9-798a-4f0d-8152-a64261307f18",
                                                "sense_id": "9d9bf1f9-a135-3b9a-a888-cf2398025054",
                                                "text": "Everything about her year-old restaurant […] reflects her love of bringing people to the table for good, simple food that's not eclipsed by bells and whistles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde5f035-1eb9-302a-b8db-223176c4b2f7",
                                        "entry_id": "3da3f4a7-909d-3e65-ba44-b1455c1bf06c",
                                        "glosses": [
                                            "To undergo eclipsis."
                                        ],
                                        "tags": [
                                            "Irish"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa36ad78-d6cb-4a29-9269-a95fb3df37ae",
                        "source_entry_id": "4588d286-4445-30f0-a406-0d113d3778fb",
                        "source_sense_id": "3a3da189-8c63-311b-99f8-65d5c6cbe264",
                        "source_sense_description": "het verschijnsel waarbij een ster en twee of meer andere hemellichamen in één lijn komen te staan, waardoor de schaduw van het ene hemellichaam het andere verduistert",
                        "target_lang_word": "éclipse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclipse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                        "entry_id": "d2494d20-9184-3101-b322-8acc331c7de3",
                                        "glosses": [
                                            "Occultation totale ou partielle d'un corps céleste par un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbb296c-aa37-44cf-8de5-44cfbfdacbf4",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Éclipse de soleil : lorsque la Lune passe entre le Soleil et la Terre."
                                            },
                                            {
                                                "example_id": "8ce95b03-f28e-4da8-af15-a40a73b2f7ad",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Éclipse de lune : lorsque la Terre passe entre la Lune et le Soleil et projette son ombre sur la Lune."
                                            },
                                            {
                                                "example_id": "df5a5aec-ba9d-4302-9d96-dfaa3e223061",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Une éclipse de soleil et de lune peut résulter aussi bien d’une extinction - comme auprès de nous l’on voit cela arriver - qu’également d’une interposition d’autres corps, soit la terre, soit le ciel, ou un autre du même type ; […]."
                                            },
                                            {
                                                "example_id": "a324e6d3-40aa-4696-8bf2-4cb4b0dbced2",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "On sait que pendant une éclipse totale de soleil, la lune est entourée d’une couronne lumineuse. Mais quelle est l’origine de cette couronne ?"
                                            },
                                            {
                                                "example_id": "c3828e30-cd97-4d84-99fa-31218505cf6f",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "En 1919, lors d'une éclipse totale du soleil […], une des prédictions de cette théorie était vérifiée pour la première fois, soit la déviation d'un rayon lumineux par une masse imposante, celle du soleil."
                                            },
                                            {
                                                "example_id": "67d44992-c63f-4bdb-9c2b-55e604091929",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Dans son mouvement autour de la Terre, la Lune peut se placer entre le Soleil et la Terre. Le Soleil devient alors invisible pour les points de la Terre qui se trouvent dans l'ombre portée par la lune. Il y a pour ces points éclipse totale de soleil."
                                            },
                                            {
                                                "example_id": "37ef70ff-8864-401d-9c93-7cca6f92c34d",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Pendant les éclipses, attribuées à un dragon désireux d'avaler le soleil, c'est un vacarme de gongs et de pétards à faire frémir pour épouvanter le dragon et le mettre en fuite."
                                            },
                                            {
                                                "example_id": "34027dc5-ff9b-43ff-921f-73752d7cee72",
                                                "sense_id": "20e1b7d4-fb91-331a-a7fb-0065dc1c71e7",
                                                "text": "Toute la tribu, dans une bonne intention, donnait un charivari à la lune pour l'éveiller car une éclipse l'avait cachée à tous les regards. J'ai su depuis que les Indiens se trompaient souvent en prenant ces immenses nuages noirs et immobiles, si fréquents sous l'équateur, pour des éclipses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2dec7de-cb2a-34a0-9097-b94e10b537f2",
                                        "entry_id": "d2494d20-9184-3101-b322-8acc331c7de3",
                                        "glosses": [
                                            "Période d'obscurcissement passager, d'affaiblissement ou de disparition totale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb391dc-b98b-4a91-a3df-37525b070331",
                                                "sense_id": "a2dec7de-cb2a-34a0-9097-b94e10b537f2",
                                                "text": "Il existait en 1914 trois principaux courants de pensée à la S.F.I.O. : le syndicalisme révolutionnaire, le jaurésisme et le guesdisme. Dans l’entre-deux-guerres, deux de ces courants connaissent une éclipse durable, au profit du troisième."
                                            },
                                            {
                                                "example_id": "1db32705-c1c5-4b32-b33b-57caec63a763",
                                                "sense_id": "a2dec7de-cb2a-34a0-9097-b94e10b537f2",
                                                "text": "À partir de 1953, l'année de la mort de Staline, le lyssenkisme connut une éclipse partielle, due à une conjonction de plusieurs facteurs : le décès de son protecteur, le caractère rocambolesque de la métamorphose des espèces […]."
                                            },
                                            {
                                                "example_id": "79bb7be7-e821-4e4c-9100-a7a6bdd2c08a",
                                                "sense_id": "a2dec7de-cb2a-34a0-9097-b94e10b537f2",
                                                "text": "Si l'Église ne semble plus répondre aux attentes de la population, y a-t-il pour autant une éclipse du sacré?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4d22635-e8a5-3888-a887-9e5fa52aaa3d",
                                        "entry_id": "d2494d20-9184-3101-b322-8acc331c7de3",
                                        "glosses": [
                                            "Absence inattendue et plus ou moins prolongée."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa932805-4aeb-4b8a-9fd3-a183d512136b",
                                                "sense_id": "d4d22635-e8a5-3888-a887-9e5fa52aaa3d",
                                                "text": "Un grand jeune blondin, que je me souviens de n’avoir point vu durant l’éclipse de la belle, rentra en catimini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bebb9349-5b84-3f41-a506-6f0e706c73b0",
                                        "entry_id": "d2494d20-9184-3101-b322-8acc331c7de3",
                                        "glosses": [
                                            "Disparition provisoire ou définitive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ab040e-5a41-44b9-ac8b-c1bdefcc7432",
                                                "sense_id": "bebb9349-5b84-3f41-a506-6f0e706c73b0",
                                                "text": "Les éclipses de la raison, du sentiment."
                                            },
                                            {
                                                "example_id": "7dd7070a-0a13-4e73-9830-09a214998104",
                                                "sense_id": "bebb9349-5b84-3f41-a506-6f0e706c73b0",
                                                "text": "Il n’y a point de gloire qui ne souffre quelquefois des éclipses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee1a0f2f-a05c-3ea3-a8b3-76c1e0f6500c",
                                        "entry_id": "d2494d20-9184-3101-b322-8acc331c7de3",
                                        "glosses": [
                                            "Brèves pertes de la conscience, de la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99995e0a-8dce-4404-9f6b-c93778d566ae",
                                                "sense_id": "ee1a0f2f-a05c-3ea3-a8b3-76c1e0f6500c",
                                                "text": "Éclipses cérébrales, éclipses visuelles."
                                            }
                                        ]
                                    }
                                ]
                            },
