                    },
                    {
                        "translation_id": "3fa8e486-95cc-47fe-9c64-3983a05ca7ac",
                        "source_entry_id": "cddae967-e2c5-345e-abf3-37822a24a1d1",
                        "source_sense_description": "ancient kingdom",
                        "target_lang_word": "Nubie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nubie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                        "entry_id": "cc04e58c-0a67-3b11-95d4-60d605bba755",
                                        "glosses": [
                                            "Région du nord du Soudan et du sud de l’Égypte, longeant le Nil."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4ff606-dfd2-434c-b1b5-3218dd6aedba",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Le sanctuaire d’Isis fait partie des biens de Nubie qui ont été inscrits au patrimoine mondial de l’Unesco en 1979."
                                            },
                                            {
                                                "example_id": "72df8f5f-8432-4ba7-87c8-0382a3ac5d73",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Vu que ces mines n’étaient pas suffisantes, les pharaons obtenaient les quantités voulues d’or des pays voisins comme la Nubie, la Syrie et d’autres pays que l’Égypte dominait, sous la forme de tribut."
                                            },
                                            {
                                                "example_id": "7f3b21ed-184a-4889-8736-9f2009e37219",
                                                "sense_id": "69c353a4-556e-34b9-9f4e-47835f211ac9",
                                                "text": "Elle portait le pagne étriqué et collant que les Égyptiennes du temps des Pharaons léguèrent à la Nubie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae877824-0222-4fb8-88a6-b9485ee14ae2",
                        "source_entry_id": "cddae967-e2c5-345e-abf3-37822a24a1d1",
                        "source_sense_description": "ancient kingdom",
                        "target_lang_word": "Nubien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nubien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                        "entry_id": "47900c85-9696-3b53-898d-0311f4988f05",
                                        "glosses": [
                                            "das Gebiet zwischen dem 1. und 4. Katarakt des Nils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac231c74-f653-48ef-ac3e-533ef1e838c7",
                                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                                "text": "„Nubien gilt als Schnittstelle zwischen dem eher dem Mittelmeerraum zuzurechnenden Ägypten und Schwarzafrika.“"
                                            },
                                            {
                                                "example_id": "9ebf1da1-2bc7-436e-a881-94abc453a076",
                                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                                "text": "Im antiken Nubien wurden nicht nur Könige in Pyramiden begraben."
                                            },
                                            {
                                                "example_id": "552de951-fe79-447f-b636-278c8c61ebc9",
                                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                                "text": "„Die Herrschaft der Pharaonen des Neuen Reiches hinterließ in Nubien zahlreiche ägyptische Bauwerke.“"
                                            },
                                            {
                                                "example_id": "e0d228c4-1032-4377-ba98-fbf158928454",
                                                "sense_id": "e41b594b-e230-339c-89f1-09fc349e655c",
                                                "text": "„Nubien verfügte über große Goldvorkommen und zog Gewinn aus seinen Handelswegen nach Zentralafrika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
