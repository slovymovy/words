                ],
                "senses": [
                    {
                        "sense_id": "4ec45327-622c-331e-92cc-a324877df23b",
                        "entry_id": "b9baef30-68ef-3ddb-89ff-12db26ac2db9",
                        "glosses": [
                            "Wohnung, die aus drei Zimmern besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "645d0a11-9c50-4e28-be3e-5cc11465215e",
                                "sense_id": "4ec45327-622c-331e-92cc-a324877df23b",
                                "text": "„Dort in der Dreizimmerwohnung im Mezzanin hat sie sich ein Zimmer ganz für sich erobert, das von ihrem als monströs empfundenen Stiefvater nicht betreten werden darf.“"
                            },
                            {
                                "example_id": "57cea6af-f09b-49ed-8bc7-24d9a617aa4b",
                                "sense_id": "4ec45327-622c-331e-92cc-a324877df23b",
                                "text": "„Für den halben Preis hätte unser Jüngling leicht anderwärts eine hübsche Dreizimmerwohnung mieten können.“"
                            },
                            {
                                "example_id": "8b2122ac-41ec-4906-98b1-c3f9fffabfee",
                                "sense_id": "4ec45327-622c-331e-92cc-a324877df23b",
                                "text": "„Kristina und ihr Mann leben in einer Dreizimmerwohnung mit Balkon.“"
                            },
                            {
                                "example_id": "627c6afe-0fa9-4257-9f1b-b54806e72a5e",
                                "sense_id": "4ec45327-622c-331e-92cc-a324877df23b",
                                "text": "„Er hat eine schöne Dreizimmerwohnung in Kurfürstendammnähe, Roscherstraße 16, Berlin-Charlottenburg, ruhig gelegen im Gartenhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
