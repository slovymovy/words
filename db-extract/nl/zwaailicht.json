                "senses": [
                    {
                        "sense_id": "e34c9532-fb66-3e9b-9053-4cc73bf64bfe",
                        "entry_id": "854a597e-6874-346d-9e50-ee1c5a6e2664",
                        "glosses": [
                            "een ronddraaiend licht dat gemonteerd staat op politieauto's, brandweerauto’s, ambulances"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484df05b-b2fd-4ce0-b880-023b28e0e8c7",
                                "sense_id": "e34c9532-fb66-3e9b-9053-4cc73bf64bfe",
                                "text": "Er werden opnamen uit Memphis getoond die waren gemaakt over het zwaailicht van een patrouillewagen heen."
                            },
                            {
                                "example_id": "f5216546-076b-40e8-bbd9-d3aada90a51c",
                                "sense_id": "e34c9532-fb66-3e9b-9053-4cc73bf64bfe",
                                "text": "Een eenzame fietser steekt het plein over; een vuilniswagen met zwaailicht leegt overvolle containers, stille getuigen van een bruisende avond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dc5002b-1fe2-4d41-bcec-d9ac5abbbe54",
                        "source_entry_id": "854a597e-6874-346d-9e50-ee1c5a6e2664",
                        "source_sense_id": "e34c9532-fb66-3e9b-9053-4cc73bf64bfe",
                        "target_lang_word": "Blaulicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blaulicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e18b778-4f46-3b9b-b351-f4761c2f3342",
                                        "entry_id": "9ea016a9-f716-3c8e-82ce-90f9d05a4ff0",
                                        "glosses": [
                                            "blaues Licht, etwa für medizinische Zwecke/zur Heilung oder auch um den Schlaf-/Wachzustand (oder Wach- und Schlafzyklen) zu beeinflussen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990ca0dc-1aff-4bc8-9e49-e4dc1109131a",
                                                "sense_id": "2e18b778-4f46-3b9b-b351-f4761c2f3342",
                                                "text": "„Dabei wurden die teilnehmenden Patienten nach einem genau festgelegten Protokoll über mehrere Monate am ganzen Körper mit Blaulicht bestrahlt.“"
                                            },
                                            {
                                                "example_id": "b2a38e20-df37-4f84-91bd-d7521c37cd85",
                                                "sense_id": "2e18b778-4f46-3b9b-b351-f4761c2f3342",
                                                "text": "„[…] Die Wellenlängen des Blauspektrums wirken zwar am effektivsten auf den Biorhythmus und sind bei der Behandlung entsprechender Beschwerden und von SAD hilfreich, es gibt derzeit jedoch keinerlei Hinweise darauf, dass Blaulicht allein eine bessere Wirkung hat als die Vollspektrum-Lichttherapie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3485cd92-54fb-3768-ab14-03eb923489c1",
                                        "entry_id": "9ea016a9-f716-3c8e-82ce-90f9d05a4ff0",
                                        "glosses": [
                                            "ein Sondersignal beziehungsweise Sonderzeichen von Einsatzfahrzeugen; zum Beispiel von Polizei, Feuerwehr, Rettungswagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55324c4-135a-4b3d-998b-cf0a69795aa4",
                                                "sense_id": "3485cd92-54fb-3768-ab14-03eb923489c1",
                                                "text": "Die Polizeifahrzeuge fahren mit eingeschaltetem Blaulicht zum Einsatzort."
                                            },
                                            {
                                                "example_id": "1cd1a6ca-50bd-4f39-9385-dd1b9eedfa8a",
                                                "sense_id": "3485cd92-54fb-3768-ab14-03eb923489c1",
                                                "text": "„Da sah ich das rotierende Blaulicht im Rückspiegel.“"
                                            },
                                            {
                                                "example_id": "8d7d5265-507d-4c40-8a04-b22851dbbcf5",
                                                "sense_id": "3485cd92-54fb-3768-ab14-03eb923489c1",
                                                "text": "„Das Blaulicht rotierte tonlos über die Hausfassaden.“"
                                            },
                                            {
                                                "example_id": "925916f2-6346-41ae-8de9-57381c61bac8",
                                                "sense_id": "3485cd92-54fb-3768-ab14-03eb923489c1",
                                                "text": "„Das Blaulicht war eingeschaltet, es fegte in der Nachmittagsdämmerung über Fassaden, Balkons und Baumkronen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf08c17-1ee9-4d23-8d3a-bebb5c248b67",
                        "source_entry_id": "854a597e-6874-346d-9e50-ee1c5a6e2664",
