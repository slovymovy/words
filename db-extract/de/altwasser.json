                ],
                "senses": [
                    {
                        "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                        "entry_id": "0117b0e5-eb2a-391b-92ad-40c46bd5aa1a",
                        "glosses": [
                            "durch Verlegung eines Flusses stillgelegte Arme und Schlingen, die sich mit Grundwasser gefüllt haben"
                        ],
                        "tags": [
                            "Physische Geografie"
                        ],
                        "examples": [
                            {
                                "example_id": "1efed222-f834-42c9-ac2f-2353cf989b84",
                                "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                                "text": "„Altwässer, Auwälder und Kiesbänke breiten sich am Fluss aus, wo die Deiche weiter im Binnenland stehen – die warmen Herbsttage verleiten noch zum Sonnenbaden.“"
                            },
                            {
                                "example_id": "e673963f-bc4e-4616-a81f-9a34590d380a",
                                "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                                "text": "„Die kürzere Strecke führte Richtung Umspannstation, am Altwasser der Brenz entlang Richtung Flugplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee692844-b803-47ac-a7ec-9058430a4b0b",
