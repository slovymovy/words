                "translations": [
                    {
                        "translation_id": "d6341a0d-252a-430d-a590-d957f3ded268",
                        "source_entry_id": "cefba188-1692-3a9a-bac0-f30d1aaa8149",
                        "source_sense_id": "61ba188b-c3c5-3d1e-a746-24545ef5e093",
                        "source_sense_description": "Gesicht mit weichen Zügen, jugendlich/kindlich wirkendes Gesicht",
                        "target_lang_word": "babyface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babyface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef01b117-bbf9-32db-b30b-f5582bd17e3a",
                                        "entry_id": "b9b97028-d3d4-37ae-8cb3-2c1a587c5afc",
                                        "glosses": [
                                            "Alternative form of baby face."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db14dd79-f90d-45ca-aa2e-3cd75a611e85",
                                                "sense_id": "ef01b117-bbf9-32db-b30b-f5582bd17e3a",
                                                "text": "The smooth babyface of the man in the chair broke into a shy smile; he looked at the camera and said, \"Hello, folks. Excuse me for sitting down. I'm still weak.\""
                                            },
                                            {
                                                "example_id": "5a39de42-14bb-4e34-9270-c26596f32d58",
                                                "sense_id": "ef01b117-bbf9-32db-b30b-f5582bd17e3a",
                                                "text": "[Jim] Freedman began his analysis by noting two important facts about professional wrestling: First, that heels triumph considerably more often than do babyfaces and, second, that they triumph by different means, relying on secret holds, sly managers, secret weapons, and illegal maneuvers, whereas babyfaces trust to their physical abilities and athletic training alone."
                                            },
                                            {
                                                "example_id": "a789e7d1-9507-4a09-a586-40482834e9c2",
                                                "sense_id": "ef01b117-bbf9-32db-b30b-f5582bd17e3a",
                                                "text": "A babyface’s success depends a great deal on the heels he’s facing. It’s all in how you make them look. A good heel will make your babyface look like Superman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7d09536-77df-45de-860d-8f255cf69e66",
                        "source_entry_id": "cefba188-1692-3a9a-bac0-f30d1aaa8149",
                        "source_sense_id": "61ba188b-c3c5-3d1e-a746-24545ef5e093",
                        "source_sense_description": "Gesicht mit weichen Zügen, jugendlich/kindlich wirkendes Gesicht",
                        "target_lang_word": "faccia d'angelo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5d529b40-928c-4917-a657-fc81cd1a7877",
                        "source_entry_id": "cefba188-1692-3a9a-bac0-f30d1aaa8149",
                        "source_sense_id": "e916a22a-adfd-35e4-9720-e6270407d2b5",
                        "source_sense_description": "Person mit einem jugendlich/kindlich wirkenden Gesicht",
                        "target_lang_word": "milksop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milksop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "150c5797-4b35-3996-93a7-fc0996da2bd3",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A piece of bread sopped in milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae5aadcf-2ea7-37f7-be30-b124c2d3077e",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A dish consisting of bread pieces in a bowl, sprinkled with sugar and covered in hot milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "An easily frightened, ineffectual, or weak person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e002abb7-0ac5-443c-a13b-c7039f3380eb",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "And vvho doth lead them but a paltrey fellovv,? / Long kept in Brittaine at our mothers coſt, / A milkeſopt, one that neuer in his life / Felt ſo much colde as ouer ſhooes in ſnovv: […]"
                                            },
                                            {
                                                "example_id": "804068f6-ebf0-4553-89f6-3d1d90a84154",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "“That milksop of a creature pretend to be worthy of such a woman as Mrs. Pendennis,” broke out the Doctor: “where will impudence stop next!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
