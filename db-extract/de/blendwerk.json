                ],
                "senses": [
                    {
                        "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                        "entry_id": "cb89dd8f-b08a-382a-a828-130d3b1b6670",
                        "glosses": [
                            "etwas Vorgetäuschtes; etwas, das einen falschen Eindruck erweckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778c72a3-ea19-4284-80c1-adfb41d60a8a",
                                "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                                "text": "„Es ist, mein Vater, keineswegs ein Blendwerk des Teufels, sondern mein wahrer Gott, Der dich und mich erschaffen, und im Anfange Himmel und Erde gemacht hat.“"
                            },
                            {
                                "example_id": "bef4c864-c932-4f8d-8d9e-a654e66779c2",
                                "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                                "text": "„Allerdings beruhen die Aussagen der letzteren seiner Meinung nach nicht auf Wirklichkeit, sondern auf Blendwerk der Dämonen.“"
                            },
                            {
                                "example_id": "a15f1467-cf18-4a2d-bde1-0a28cc515e1e",
                                "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                                "text": "„Der Schwindler der durch Blendwerk und Vorspiegelung falscher Tatsachen einen anderen in Schaden und Nachteil bringt, heißt praestigiator; jenes Blendwerk oder Schwindel praestigiae.“"
                            },
                            {
                                "example_id": "0c24c698-7593-4ca2-aeed-fda381103ec9",
                                "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                                "text": "„Der haushaltspolitische Sprecher der FDP, Jürgen Koppelin, nannte den Haushaltsentwurf ein Blendwerk.“"
                            },
                            {
                                "example_id": "20ddc5a4-b3ab-4d68-b273-361ccad79042",
                                "sense_id": "15490ebf-6d70-3d5f-a9c7-7f398cc3ecca",
                                "text": "„Höchst wahrscheinlich war er ein gewandter Gaukler, der die Wundersucht der Zeit mit großem Geschick auszubeuten und durch Blendwerke zu täuschen wußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
