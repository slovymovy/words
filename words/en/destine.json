{
    "word_family": [
        "destiny",
        "destination",
        "predestine",
        "predestination"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de110966-7d93-3bab-b99a-94290bca2adb",
                    "sense_definition": "To determine or settle in advance by fate, divine will, or necessity; to preordain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many believed that fate would <w>destine</w> the young prince to lead his country through war.",
                            "target_lang_translations": {
                                "ru": "Многие верили, что судьба <w>предопределит</w> юному принцу вести свою страну через войну."
                            }
                        },
                        {
                            "text": "Her exceptional talents seemed to <w>destine</w> her for a brilliant career in scientific research.",
                            "target_lang_translations": {
                                "ru": "Казалось, исключительные таланты <w>предназначали</w> её для блестящей карьеры в научных исследованиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "fate",
                        "foreordain",
                        "predestine",
                        "preordain"
                    ],
                    "common_phrases": [
                        "destine for greatness",
                        "destine to fail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее определять судьбой, божественной волей или необходимостью; предназначать, предопределять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "судьбой или обстоятельствами"
                            },
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "для определенной роли или участи"
                            },
                            {
                                "target_lang_word": "судить",
                                "target_lang_sense_clarification": "в значении суждено судьбой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd2d8e32-5baa-3629-9345-cc2a242d0255",
                    "sense_definition": "To direct toward or designate for a specific physical destination or recipient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "designation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will <w>destine</w> these shipments for overseas markets across Asia.",
                            "target_lang_translations": {
                                "ru": "Компания <w>направит</w> эти поставки на зарубежные рынки по всей Азии."
                            }
                        },
                        {
                            "text": "The logistical team chose to <w>destine</w> the remaining cargo for the northern port.",
                            "target_lang_translations": {
                                "ru": "Логистическая группа решила <w>направить</w> оставшийся груз в северный порт."
                            }
                        }
                    ],
                    "synonyms": [
                        "route",
                        "send"
                    ],
                    "common_phrases": [
                        "destine for shipment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять или адресовать в определенное место назначения или конкретному получателю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "к месту назначения"
                            },
                            {
                                "target_lang_word": "адресовать",
                                "target_lang_sense_clarification": "получателю или пункту"
                            },
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "для определенного рынка или пункта доставки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55e4ab84-5b30-3ccc-bd61-43f1dbbaf089",
                    "sense_definition": "To designate or set apart something, especially financial resources, for a specific purpose or use.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "designation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The council decided to <w>destine</w> the surplus funds for local park improvements.",
                            "target_lang_translations": {
                                "ru": "Совет решил <w>предназначить</w> излишки средств на благоустройство местного парка."
                            }
                        },
                        {
                            "text": "They planned to <w>destine</w> a large portion of the budget to community healthcare programs.",
                            "target_lang_translations": {
                                "ru": "Они планировали <w>выделить</w> значительную часть бюджета на программы общественного здравоохранения."
                            }
                        }
                    ],
                    "synonyms": [
                        "allocate",
                        "earmark",
                        "reserve"
                    ],
                    "common_phrases": [
                        "destine funds for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять или предназначать что-либо (особенно финансовые средства) для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "для конкретной цели"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "средства или ресурсы"
                            },
                            {
                                "target_lang_word": "ассигновать",
                                "target_lang_sense_clarification": "бюджетные средства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}