                            {
                                "example_id": "d5d48bf9-25ba-4f1d-b641-b82da8047b04",
                                "sense_id": "4176cfdd-44ef-36f2-8fae-ce50e90405a3",
                                "text": "„1. Anodenseitig und kathodenseitig gerade Kanäle, senkrecht zueinander eingebracht und kathodenseitig zur Atmosphäre offen,",
                                "translation": "3. Anoden- und kathodenseitig gerade Kanalstruktur; alle Kanäle mit quadratischem Kanalquerschnitt (1x1mm).“"
                            },
                            {
                                "example_id": "412caa8b-12bb-4ffe-bc64-23664d244172",
                                "sense_id": "4176cfdd-44ef-36f2-8fae-ce50e90405a3",
                                "text": "„Wasserstoffprotonen wandern in einer Solvathülle durch die Membran und reagieren kathodenseitig mit Luftsauerstoff zu Wasser beziehungsweise Wasserdampf. […] Mit dieser Betriebsweise kann ein starker Abfall der Zellspannung vermieden werden. Aus dem Stack treten nun anodenseitig ein abgereichertes Gas und kathodenseitig Luft aus, die eine erhöhte H₂O-Konzentration aufweist.“"
                            },
                            {
                                "example_id": "44b9824f-b195-44b1-8ab0-a503e3ea5471",
                                "sense_id": "4176cfdd-44ef-36f2-8fae-ce50e90405a3",
                                "text": "„Der metallische Entladungsraum bildet dann das anodenseitige Röhrenende und weist nur noch kathodenseitig einen angeschmolzenen oder über Spezialdichtungen aufgepreßtem Glas- oder Keramikzylinder auf (Abb. 89).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
