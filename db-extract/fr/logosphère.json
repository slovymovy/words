                        "examples": [
                            {
                                "example_id": "670a199a-5955-4b31-8b0c-f1a2557a7a15",
                                "sense_id": "e9ad495d-93f7-36fa-a687-dfd36070116e",
                                "text": "C’est une idée qui marche : l’imprimé a vécu, le temps du numérique est venu ! Après la logosphère, la graphosphère, la vidéosphère, voici la numérisphère."
                            },
                            {
                                "example_id": "7009a4e5-1b21-4666-a2c8-0531bd5de1e2",
                                "sense_id": "e9ad495d-93f7-36fa-a687-dfd36070116e",
                                "text": "Par analogie à la lithosphère, espace où se déploient les substances minérales, à la biosphère, espace d’échange entre êtres vivants, et à la logosphère, espace de communication des êtres doués de langage, Luciano Floridi qualifie l’espace dans lequel se meuvent et s’épanouissent ces orins d’infosphère."
                            }
                        ]
