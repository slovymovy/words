{
    "word_family": [
        "кокосовый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e1cc6220-f907-3df7-8ea6-0240fa699eb1",
                    "sense_definition": "Крупный округлый плод кокосовой пальмы с твёрдой волокнистой скорлупой, белой мякотью и жидкостью внутри.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На десерт мы решили расколоть спелый <w>кокос</w> и выпить сладкую воду.",
                            "target_lang_translations": {
                                "fr": "Pour le dessert, nous avons décidé de casser une <w>noix de coco</w> mûre et de boire son eau douce."
                            }
                        },
                        {
                            "text": "В супермаркете продавался свежий <w>кокос</w> по очень привлекательной цене.",
                            "target_lang_translations": {
                                "fr": "Au supermarché, on vendait de la <w>noix de coco</w> fraîche à un prix très attractif."
                            }
                        }
                    ],
                    "synonyms": [
                        "кокосовый орех"
                    ],
                    "common_phrases": [
                        "расколоть кокос",
                        "свежий кокос"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fruit volumineux et arrondi du cocotier, à coque dure et fibreuse, contenant une pulpe blanche et une eau sucrée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "noix de coco",
                                "target_lang_sense_clarification": "fruit du cocotier"
                            },
                            {
                                "target_lang_word": "coco",
                                "target_lang_sense_clarification": "noix de coco, forme raccourcie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e7eab57-1c45-3c70-96c3-3c0b870f8767",
                    "sense_definition": "Тропическое дерево семейства пальмовых, приносящее такие плоды; кокосовая пальма.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вдоль песчаного берега океана рос высокий <w>кокос</w>, усыпанный плодами.",
                            "target_lang_translations": {
                                "fr": "Le long de la rive sablonneuse de l'océan poussait un grand <w>cocotier</w> chargé de fruits."
                            }
                        },
                        {
                            "text": "Обезьяна ловко забралась на <w>кокос</w> и сбросила вниз несколько орехов.",
                            "target_lang_translations": {
                                "fr": "Le singe grimpa habilement sur le <w>cocotier</w> et fit tomber plusieurs noix."
                            }
                        }
                    ],
                    "synonyms": [
                        "кокосовая пальма"
                    ],
                    "target_lang_definitions": {
                        "fr": "Arbre tropical de la famille des palmiers qui produit ces fruits ; cocotier."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cocotier",
                                "target_lang_sense_clarification": "arbre tropical produisant les noix de coco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d847ecb-d698-3c9a-a99c-b3cb95b8e664",
                    "sense_definition": "Наркотическое вещество белого цвета; кокаин.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция обнаружила в тайнике крупную партию опасного вещества, известного как <w>кокос</w>.",
                            "target_lang_translations": {
                                "fr": "La police a découvert dans une cachette une importante cargaison d'une substance dangereuse, connue sous le nom de <w>coco</w>."
                            }
                        },
                        {
                            "text": "В криминальных кругах этот порошок часто называли словом <w>кокос</w>.",
                            "target_lang_translations": {
                                "fr": "Dans le milieu criminel, cette poudre était souvent appelée la <w>coco</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "кокаин"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное обозначение наркотика"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Substance stupéfiante sous forme de poudre blanche ; cocaïne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "coco",
                                "target_lang_sense_clarification": "cocaïne en argot"
                            },
                            {
                                "target_lang_word": "cocaïne",
                                "target_lang_sense_clarification": "drogue stimulante"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}