                        "sense_id": "2beafcf6-6351-39a9-bfba-7fe0aa05e76b",
                        "entry_id": "9df2df45-4083-3961-8234-654ddedb30d9",
                        "glosses": [
                            "Person, die den gleichen Beruf ausübt wie man selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70b4d35-8fc7-4a3a-b207-ae3595936c9f",
                                "sense_id": "2beafcf6-6351-39a9-bfba-7fe0aa05e76b",
                                "text": "„Die Leute da, seine Berufskollegen, waren nicht leichtfertiger, nicht geltungsbedürftiger, als Menschen dieses Gewerbes nun einmal sind.“"
                            },
                            {
                                "example_id": "90db490f-163b-4d70-a913-d9fb834c3322",
                                "sense_id": "2beafcf6-6351-39a9-bfba-7fe0aa05e76b",
                                "text": "„Die 18-jährige Tirolerin Marina Knabl, die kürzlich die Lokführerprüfung bestanden hat, ist eine von 33 Lokführerinnen und zudem die Jüngste unter den 4.300 Berufskollegen bei den ÖBB, gab das Unternehmen am Donnerstag bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
