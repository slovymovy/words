                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "235240c9-a40b-46e1-abf0-e25e82ef90d7",
                                                "sense_id": "d4e0632a-9f22-36ee-8e93-b451fcb77855",
                                                "text": "Dat is iets geweldloos..."
                                            }
                                        ]
                                    }
