                    {
                        "form_id": "64f4b7a0-9799-4953-8721-1425096d489f",
                        "entry_id": "3951cbe7-ae7b-3ff1-babd-b60877d7d08d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "поло́вах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a0c36eb-2a78-3c44-8bc2-93e6be97f4f9",
                        "entry_id": "3951cbe7-ae7b-3ff1-babd-b60877d7d08d",
                        "glosses": [
                            "с.-х. отходы при обмолоте и очистке зерна хлебных злаков и некоторых других культур; мякина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c763d4f3-767b-4afb-aa19-e4d80134dd03",
                                "sense_id": "7a0c36eb-2a78-3c44-8bc2-93e6be97f4f9",
                                "text": "Сломишь колос, пошелушишь, сдуешь полову, полюбуешься и в рот сыпанешь янтарь зерен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a1b77f-0901-4390-a99b-03f902943f6f",
                        "source_entry_id": "3951cbe7-ae7b-3ff1-babd-b60877d7d08d",
                        "source_sense_id": "7a0c36eb-2a78-3c44-8bc2-93e6be97f4f9",
                        "target_lang_word": "chaff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f73740b-64b8-311f-8355-e57273635758",
                                        "entry_id": "bce4dd97-d1d2-335d-a574-7fcfec7b9f55",
                                        "glosses": [
                                            "The inedible parts of a grain-producing plant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e237e4-71fc-4674-918f-946c48039640",
                                                "sense_id": "6f73740b-64b8-311f-8355-e57273635758",
                                                "text": "To separate out the chaff, early cultures tossed baskets of grain into the air and let the wind blow away the lighter chaff."
                                            },
                                            {
                                                "example_id": "c85f8fde-27f1-442a-83b7-f842d5d95a8c",
                                                "sense_id": "6f73740b-64b8-311f-8355-e57273635758",
                                                "text": "So take the corn and leave the chaff behind."
                                            },
                                            {
                                                "example_id": "dab441b9-7419-425c-ac6b-9389235b6b9a",
                                                "sense_id": "6f73740b-64b8-311f-8355-e57273635758",
                                                "text": "In the passage outside the door, the threshers, who had done their day's work, were stamping the snow off their feet before they came in, - their hair full of chaff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ea167df-cf1e-3c08-98ba-14a1c524a8c5",
                                        "entry_id": "bce4dd97-d1d2-335d-a574-7fcfec7b9f55",
                                        "glosses": [
                                            "Straw or hay cut up fine for the food of cattle."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1d1b8e6-7fc1-4e81-b44a-c8cd3ee78cd2",
                                                "sense_id": "9ea167df-cf1e-3c08-98ba-14a1c524a8c5",
                                                "text": "By adding chaff to his corn, the horse must take more time to eat it, and time is given for the commencement of digestion, before fermentation can occur. In this way chaff is very useful, especially after long fasts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52058183-d3a8-3669-b66f-981343d622fe",
                                        "entry_id": "bce4dd97-d1d2-335d-a574-7fcfec7b9f55",
                                        "glosses": [
                                            "Any excess or unwanted material, resource, or person; anything worthless."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d20c33-f9cc-450c-b5c2-037b6bc4a05b",
                                                "sense_id": "52058183-d3a8-3669-b66f-981343d622fe",
                                                "text": "the chaff and ruin of the times"
                                            },
                                            {
                                                "example_id": "9804a4da-29d6-4730-a883-89c2fff7fd85",
                                                "sense_id": "52058183-d3a8-3669-b66f-981343d622fe",
                                                "text": "Who that has prided himself on his spiritual strength has not seen it humbled to the dust? A knowledge of religion, as distinguished from experience, seems but chaff in such moments of trial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fae9daa-edf0-3f50-80ba-d6ee0d6b8e6b",
                                        "entry_id": "bce4dd97-d1d2-335d-a574-7fcfec7b9f55",
                                        "glosses": [
                                            "Light jesting talk; banter; raillery."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b461eab-aee0-4165-85ad-508bd4443d9c",
                                                "sense_id": "3fae9daa-edf0-3f50-80ba-d6ee0d6b8e6b",
                                                "text": "As for Huxter, perfectly at good-humour with himself, and the world, it never entered his mind that he could be disagreeable to anybody; and the little dispute, or “chaff,” as he styled it, of Vauxhall, was a trifle which he did not in the least regard."
                                            },
                                            {
                                                "example_id": "d4e09421-9481-4659-9951-68732eff1076",
                                                "sense_id": "3fae9daa-edf0-3f50-80ba-d6ee0d6b8e6b",
                                                "text": "It was the chaff of the College at the time, but I could not help it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be6f510-bc6a-3913-bfc8-6f9c5126e295",
                                        "entry_id": "bce4dd97-d1d2-335d-a574-7fcfec7b9f55",
                                        "glosses": [
                                            "Loose material, e.g. small strips of aluminum foil dropped from aircraft, intended to interfere with radar detection."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102e8b47-72c6-3568-b1b6-3513d30e408d",
                                        "entry_id": "2a81f8fb-a944-3185-874a-6a1ece918cbb",
                                        "glosses": [
                                            "To use light, idle language by way of fun or ridicule; to banter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "520f5f02-bfff-35f3-b158-659ab0242eb5",
                                        "entry_id": "2a81f8fb-a944-3185-874a-6a1ece918cbb",
                                        "glosses": [
                                            "To make fun of; to turn into ridicule by addressing in ironical or bantering language."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aef4567-7160-40c9-9f7a-afda9384adb4",
                                                "sense_id": "520f5f02-bfff-35f3-b158-659ab0242eb5",
                                                "text": "We were talking about it at mess, yesterday, and chaffing Derby Oaks—until he was as mad as a hatter."
                                            },
                                            {
                                                "example_id": "3520177b-375c-493b-ad3f-618f4d4993b0",
                                                "sense_id": "520f5f02-bfff-35f3-b158-659ab0242eb5",
                                                "text": "I’ve fallen asleep on my step as the ’bus was going on, and almost fallen off. I have often to put up with insolence from vulgar fellows, who think it fun to chaff a cad, as they call it."
                                            },
                                            {
                                                "example_id": "b5e40b99-c37c-43d3-9f9f-64da427e5cd1",
                                                "sense_id": "520f5f02-bfff-35f3-b158-659ab0242eb5",
                                                "text": "Bobby Wick stormed through the tents of his Company, rallying, rebuking, mildly, as is consistent with the Regulations, chaffing the faint-hearted[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b18272f-bac3-3cec-aa2f-eaf3bceea58e",
                                        "entry_id": "2a81f8fb-a944-3185-874a-6a1ece918cbb",
                                        "glosses": [
                                            "To cut up (straw or hay) for use as cattle feed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
