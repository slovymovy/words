                                                "example_id": "0918d05f-fbd8-4fef-8062-f97296cf88d7",
                                                "sense_id": "e9443bb8-ba8e-31c4-b28a-67de9181c960",
                                                "text": "The third tree from the left is my favorite."
                                            },
                                            {
                                                "example_id": "ee4c7b97-3f1e-4c0e-a7bc-78d56532f5d3",
                                                "sense_id": "e9443bb8-ba8e-31c4-b28a-67de9181c960",
                                                "text": "The second and third quarters of the shield are indecipherable on the stone but clearer in two other representations of the arms, a painted wooden funeral hatchment for Mary Davie[…]"
                                            },
                                            {
                                                "example_id": "7723bb7a-d513-48d3-a8b0-be4adf7dbaed",
                                                "sense_id": "e9443bb8-ba8e-31c4-b28a-67de9181c960",
                                                "text": "“Congress took the lead on putting the HBCU funding in those bills and passing them. The third COVID-19 bill, passed under President Biden, included as much funding for HBCUs as both of the first two Covid-19 bills under President Trump,” he said."
                                            }
                                        ]
