                        "glosses": [
                            "In a freehearted manner; lightly and without constraint or worry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77031684-a780-4fcc-a74f-ec041459c2aa",
                                "sense_id": "ccbaec0d-ba9c-3dff-84b8-2d78121c98cf",
                                "text": "Before dawn on Sunday ew had put Nagasaki behind us and were off on our 445 mile sail to Shanghai, regretful at leaving a country and a people who had entertained us so lavishly and free-heartedly for a week that always will be a luster of red letter days in the memory of all."
                            },
                            {
                                "example_id": "bd66b128-0521-4504-a6e0-9e36923044a8",
                                "sense_id": "ccbaec0d-ba9c-3dff-84b8-2d78121c98cf",
                                "text": "So now, I think, you know all about it, — and you see you may do what you can for me, freeheartedly — without fear of harm — and for Aracoeli sake."
                            }
                        ]
                    }
