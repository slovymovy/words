                                "target_senses": [
                                    {
                                        "sense_id": "4ece2d1d-79af-37c1-b9ca-1f151c6e3eae",
                                        "entry_id": "084f42d1-30fa-3a17-bb66-2fec9d2b8b3d",
                                        "glosses": [
                                            "Papierschnipsel, die bei Festlichkeiten als Papierregen verteilt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315114a1-7670-4758-8228-0e1fbdccd904",
                                                "sense_id": "4ece2d1d-79af-37c1-b9ca-1f151c6e3eae",
                                                "text": "Das Konfetti wurde am Silvesterabend verteilt."
                                            },
                                            {
                                                "example_id": "9461252b-4554-42cb-b6bf-4d587899c6e6",
                                                "sense_id": "4ece2d1d-79af-37c1-b9ca-1f151c6e3eae",
                                                "text": "„Der Saal wird tagelang von den Abiturienten geschmückt, mit Luftballons, Fotos und Konfetti.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae229711-1402-4bf5-a6c3-ded539caf2de",
                        "source_entry_id": "9b2a9df5-3ec6-30dd-8c4c-268721b28603",
