                                "target_senses": [
                                    {
                                        "sense_id": "e02b2a3b-086a-31f5-bcfe-f6567fa06d42",
                                        "entry_id": "643cc1c6-84a5-3007-99e9-0ac042c4b0ed",
                                        "glosses": [
                                            "An individual's interpersonal relationships with people within their immediate surroundings or general public."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bf7e75b-4af8-34d0-bef4-5469b0027ae4",
                                        "entry_id": "643cc1c6-84a5-3007-99e9-0ac042c4b0ed",
                                        "glosses": [
                                            "Those public activities performed in association with others for the purpose of pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93556820-a3e0-49c0-af7b-dd445dccf721",
                                                "sense_id": "6bf7e75b-4af8-34d0-bef4-5469b0027ae4",
                                                "text": "Its place in the social life of Derby and of the railway world is well assured, [...]."
                                            },
                                            {
                                                "example_id": "573f7fea-042a-48be-8a3a-8a02eb82d01c",
                                                "sense_id": "6bf7e75b-4af8-34d0-bef4-5469b0027ae4",
                                                "text": "While I was blithely putting my safety at risk and ignoring my social life in the name of exercise, my friends were going out, dating, getting married, getting pregnant, getting divorced."
                                            },
                                            {
                                                "example_id": "b72ca70c-2b28-48c2-b54a-16954d893507",
                                                "sense_id": "6bf7e75b-4af8-34d0-bef4-5469b0027ae4",
                                                "text": "And this was a Christian university, so my social life wasn't all that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90261e09-14db-36a9-a2a7-7a5d91268118",
                                        "entry_id": "643cc1c6-84a5-3007-99e9-0ac042c4b0ed",
                                        "glosses": [
                                            "Dating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7fa193-cc12-47fc-95e9-2d7f58af431d",
                                                "sense_id": "90261e09-14db-36a9-a2a7-7a5d91268118",
                                                "text": "And it is ruining my social life. face keeps breaking out with pimples and I know I look repulsive, so how can I ever expect to have boy friends?"
                                            },
                                            {
                                                "example_id": "467187a1-02da-4fda-9667-909d4b56cffd",
                                                "sense_id": "90261e09-14db-36a9-a2a7-7a5d91268118",
                                                "text": "My social life is in ruins. / How is it possible for me to find a woman who will accept me as I am."
                                            },
                                            {
                                                "example_id": "4f3dc31c-5331-413f-8ac5-7178a269c59c",
                                                "sense_id": "90261e09-14db-36a9-a2a7-7a5d91268118",
                                                "text": "I lay my head back and close my eyes, contemplating the circumstances of my social life. I think “Why can't I connect with just one woman ...."
                                            },
                                            {
                                                "example_id": "29ade12c-83fc-4fa9-9c73-bdd2fb559976",
                                                "sense_id": "90261e09-14db-36a9-a2a7-7a5d91268118",
                                                "text": "“Which explains my social life lately,” Rachel muttered. “No, working all hours to get that promotion explains your social life lately,” Sabrina countered. “There are plenty of men who are up to your speed."
                                            }
                                        ]
                                    }
                                ]
                            }
