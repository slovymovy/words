                ],
                "senses": [
                    {
                        "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                        "entry_id": "c00e11d1-b3ad-3816-b52d-d518671b0fcb",
                        "glosses": [
                            "Spaziergang bei Dämmerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3281ec0-4aca-44ba-bac2-f166428763e0",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "Hast Du Lust auf einen Dämmerungsspaziergang mit mir?"
                            },
                            {
                                "example_id": "c05a0fe1-c6ae-48f9-b568-1a95c69f66dc",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Bei dem Dämmerungsspaziergang an diesem Freitag, 22. Juli, um 19 Uhr erhalten Erwachsene und Kinder Antwort auf viele Fragen rund um den Schlaf der Vögel.“"
                            },
                            {
                                "example_id": "3f3928bc-0748-4d9a-a26d-bbcb057a2b6e",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Dass wir auf einem Dämmerungsspaziergang viele Tiere hören, liegt aber auch an unserer eigenen Wahrnehmung. Wenn wir abends weniger sehen, werden andere Sinne wichtiger, weshalb wir aufmerksamer hinhören als am helllichten Tag.“"
                            },
                            {
                                "example_id": "8d167fc8-14e7-4ada-a7a9-e84c6c16d652",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Es schien ihr indeß doch nicht zu mißfallen, daß der so entschieden Abgewiesene ihr mit Adelheid und Herrn Mellnitz dahin folgte und daß er meinte, die warme Luft lade zu einem Dämmerungsspaziergang ein.“"
                            },
                            {
                                "example_id": "c7bc7b0c-10c4-4517-818a-5ea15ccf0b11",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Nach einem schönen Dämmerungsspaziergang ins Tal und einem reichlichen Pranzo erinnerte sich Peter eines sogenannten Rendezvous.“"
                            },
                            {
                                "example_id": "73abca00-4cf7-4529-b5e3-7f1d4ca3272e",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Doch hatte ich noch immer die stille Hoffnung, ihr einmal wieder zu begegnen, und dehnte meine abendlichen Dämmerungsspaziergänge immer weiter und in immer andere Gegenden aus.“"
                            },
                            {
                                "example_id": "6fb868dd-995f-4f81-871b-ec43e8ee0433",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Ich erquicte mich lieber an meinen Dämmerungsspaziergängen unter den entlaubten Zweigen der prachtvollen Eichen und Buchen des großen Parkes, wo ich stillen Betrachtungen nachhing und moralisirte wie der melancholische Jaques im Wald von Arden; und einmal dehnte ich meine Wanderung aus bis zum Strand von Scheveningen.“"
                            },
                            {
                                "example_id": "c71502ce-9d2f-4ab6-9542-7888dfb2f484",
                                "sense_id": "ed6caad7-394b-3ee2-8666-8b36f968dfcd",
                                "text": "„Auf einem dämmerungsspaziergange im thiergarten rückte ich endlich mit meinem anliegen heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
