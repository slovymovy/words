                ],
                "senses": [
                    {
                        "sense_id": "ff047d75-ef3e-395c-b668-327c1b04b2e3",
                        "entry_id": "bb3000cd-5d12-3545-9bd7-e3ec259f688f",
                        "glosses": [
                            "iemand die buiten de stad woont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c43ba3-c957-4acf-bab1-f8de10232a89",
                                "sense_id": "ff047d75-ef3e-395c-b668-327c1b04b2e3",
                                "text": "Op zijn zoektocht naar ongerepte natuur ontmoet hij plattelanders en stedelingen, Amerikaanse wielrenners en Oostenrijkse toeristen. De schrijver filosofeert erop los, klaagt over de teloorgang van het platteland en citeert uit Giono, Pessoa, Xenophon en Sloterdijk, ‘die er altijd uitzag alsof hij wakker was geschrokken van zijn eigen gedachten’."
                            },
                            {
                                "example_id": "dad205be-5cee-4f56-97b1-b4750042d2ac",
                                "sense_id": "ff047d75-ef3e-395c-b668-327c1b04b2e3",
                                "text": "Hans Peter Benschop van Trendbureau Overijssel herkent zich in die woorden. “Ik denk dat in andere delen van het land met verwondering is gekeken naar de documentaire (Brommers Kiek'n). Dat op 1,5 uur rijden van Amsterdam zo’n andere leefwereld bestaat, zullen mensen gedacht hebben. Aan de andere kant zullen veel plattelanders met een gevoel van herkenning hebben gekeken.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91833ad6-5883-4069-a4ac-3ac1d095a670",
                        "source_entry_id": "bb3000cd-5d12-3545-9bd7-e3ec259f688f",
                        "source_sense_id": "ff047d75-ef3e-395c-b668-327c1b04b2e3",
                        "source_sense_description": "iemand die buiten de stad woont",
                        "target_lang_word": "countryman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "countryman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f3e152a-24cc-3e1c-8d04-bce434bd79fb",
                                        "entry_id": "8c6179b2-d27c-3ed9-9193-afc53b037262",
                                        "glosses": [
                                            "Somebody from a certain country."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dd11f9c-77a1-37ac-8edf-601a6af8a68e",
                                        "entry_id": "8c6179b2-d27c-3ed9-9193-afc53b037262",
                                        "glosses": [
                                            "Somebody from one's own country; a fellow countryman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f9fa33-e08f-4240-8cc7-9a4b34eea867",
                                                "sense_id": "3dd11f9c-77a1-37ac-8edf-601a6af8a68e",
                                                "text": "Friends, Romans, Countrymen, lend me your ears: / I come to bury Cæſar, not to praiſe him:"
                                            },
                                            {
                                                "example_id": "12e3aa06-1c00-48f2-a63a-3e2082533b5d",
                                                "sense_id": "3dd11f9c-77a1-37ac-8edf-601a6af8a68e",
                                                "text": "You don’t need to wait. Here, there she is. There, there she is right now, embodying the harsh irony that is her existence, because at that moment next week, she will be a queen with fake power visiting a fake kingdom which arguably has more impact on the lives of her countrymen than she does."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8cba247-60fe-3c05-a8c2-d7772af746b9",
                                        "entry_id": "8c6179b2-d27c-3ed9-9193-afc53b037262",
                                        "glosses": [
                                            "A man who is a country dweller, especially a follower of country pursuits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c333d3e7-f4d2-37a8-a651-4382bcd58c09",
                                        "entry_id": "8c6179b2-d27c-3ed9-9193-afc53b037262",
                                        "glosses": [
                                            "A settled person, as opposed to a traveller."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
