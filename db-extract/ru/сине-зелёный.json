                "senses": [
                    {
                        "sense_id": "53e6c840-bb4f-3498-b827-4cb9380318f0",
                        "entry_id": "02fcb7bc-5f71-3906-a14c-f0bc39eb4301",
                        "glosses": [
                            "имеющий цвет, промежуточный между синим и зелёным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5444c101-61d2-4526-8ea8-9a1bab5d2ed0",
                                "sense_id": "53e6c840-bb4f-3498-b827-4cb9380318f0",
                                "text": ".. бледный, сине-зелёный, как морская вода у берега, вериллий .."
                            },
                            {
                                "example_id": "0a082a5c-3ade-4fb9-bad9-097bf77bb029",
                                "sense_id": "53e6c840-bb4f-3498-b827-4cb9380318f0",
                                "text": "Время от времени он ложится на спину и проверяет свой курс по едва заметному просвету в густом сине-зелёном полумраке."
                            }
                        ]
                    }
                ],
