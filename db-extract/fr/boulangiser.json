                "senses": [
                    {
                        "sense_id": "2c1039ab-5761-387b-98c1-738abf8f6b9b",
                        "entry_id": "a4369023-fbb7-3998-b570-21107eb5474c",
                        "glosses": [
                            "Donner un caractère boulangiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff4c392-79f6-4609-9501-2db2359be734",
                                "sense_id": "2c1039ab-5761-387b-98c1-738abf8f6b9b",
                                "text": "Mentionnons en passant les récentes protestations du Monde contre les conseillers qui veulent « boulangiser » le duc d’Orléans, le lancer dans les plaisirs, les festins ; bref, en faire un « fin de siècle » digne de goûter les œuvres de M. Barrès."
                            },
                            {
                                "example_id": "0fe3e040-7a93-4dac-b20f-03b68541f1d0",
                                "sense_id": "2c1039ab-5761-387b-98c1-738abf8f6b9b",
                                "text": "Il importe de ne pas laisser Paris se boulangiser."
                            },
                            {
                                "example_id": "3d3ccf68-7ac5-47dd-9618-6b9057e644df",
                                "sense_id": "2c1039ab-5761-387b-98c1-738abf8f6b9b",
                                "text": "M. le comte de Paris est d’avis que le parti national doit boulangiser, et le fameux comité de la consultation nationale, le comité des douze, est enlisé dans le boulangisme jusqu’aux oreilles."
                            }
                        ]
                    }
