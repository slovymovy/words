                ],
                "senses": [
                    {
                        "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                        "entry_id": "6146731f-c8b4-3ac1-83b8-db7a8a8c107a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa27182-20bb-414e-b17f-e6e781379eb5",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Frau Kienzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9dd1d700-cf25-4a59-8282-4a91c9eecb8b",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Herr Kienzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "33669f04-444f-406e-b6c4-8bf18e33fd47",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Die Kienzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fcecb8e2-c34d-4690-932d-58bf53df2a28",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Der Kienzle trägt nie die Schals, die die Kienzle ihm strickt."
                            },
                            {
                                "example_id": "3176abcf-9fcf-4dff-ac8f-d2e4e613f0fe",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kienzle kommt, geht der Herr Kienzle.“"
                            },
                            {
                                "example_id": "25edf6bd-81d7-42a8-a994-db962fae45e4",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Kienzle kommt und geht."
                            },
                            {
                                "example_id": "b9a0e6b5-1718-4d69-bf94-0f05aad4e2e3",
                                "sense_id": "9924a5a8-c05a-3cd3-9e34-6ca04a772e26",
                                "text": "Kienzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
