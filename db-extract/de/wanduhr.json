                        ],
                        "form": "den Wanduhren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08a6b87d-a0b3-32a8-b0ac-9299fcdc87a4",
                        "entry_id": "bfcee86f-bbb5-30dc-aced-e7d0e55a8ec6",
                        "glosses": [
                            "Horloge, horloge murale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b18bc1-1f1f-4dbd-98f2-96ee920b4166",
                                "sense_id": "08a6b87d-a0b3-32a8-b0ac-9299fcdc87a4",
                                "text": "Die Wanduhr befindet sich über der Eingangstür.",
                                "translation": "L'horloge se trouve au-dessus de la porte d'entrée."
                            },
                            {
                                "example_id": "52c1c1db-4368-41bf-913e-170925580087",
                                "sense_id": "08a6b87d-a0b3-32a8-b0ac-9299fcdc87a4",
                                "text": "Es gibt digitale und analoge Wanduhren, des Weiteren können sie nach Funkwanduhren oder mechanischen Wanduhren unterschieden werden. Zusätzlich gibt es Wanduhren mit Batteriebetrieb oder mit Stromkabel.",
                                "translation": "Il y a des horloges digitales et analogiques, qui sont différentes des radio-réveils et des horloges mécaniques. Il existe aussi des horloges à piles ou fonctionnant avec un câble électrique."
                            },
                            {
                                "example_id": "7aeb7045-36e1-428a-b91d-a8b7c103e4ad",
                                "sense_id": "08a6b87d-a0b3-32a8-b0ac-9299fcdc87a4",
                                "text": "Neben den Möbelgruppen sind alte Lampenschirme aufgestellt, an der Wand lehnt eine große dunkle Wanduhr, auf den Tischen stehen Vasen mit geschmückten Tannenzweigen.",
                                "translation": "De vieux abat-jours sont disposés à côté des groupes de meubles, une grande horloge murale sombre est adossée au mur, des vases avec des branches de sapin décorées sont posés sur les tables."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
