                "translations": [
                    {
                        "translation_id": "7c8d40c6-dd8a-41d2-a76f-2bde63a93c41",
                        "source_entry_id": "d7611a67-427e-32e3-89f3-d078098ebf76",
                        "source_sense_description": "получать доход от продажи",
                        "target_lang_word": "marchander",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marchander",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                        "entry_id": "efb93d50-04a4-3744-bec9-6c0563751670",
                                        "glosses": [
                                            "Demander le prix d’une chose, d’un produit, et le plus souvent, en débattre pour obtenir un prix inférieur au prix proposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8563f986-e597-4cc6-810d-5772265f3658",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "M. Marsillat marchande toutes les pouliches du pays sans rien acheter ! ou bien, quand il achète, il fait semblant de se dégoûter bien vite, et il revient pour troquer."
                                            },
                                            {
                                                "example_id": "fd6a0d51-35f3-441b-a9e1-fbd78fca01cf",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Il faut avoir une santé de vieux chêne pour vendre des livres sur les quais, car il n’est pas un élément qui ne s’occupe de vous agacer : le vent, la chaleur, le gel, le bruit, le marchandage des clients, étant entendu qu’on n’achète jamais un livre sans marchander."
                                            },
                                            {
                                                "example_id": "f89ebafb-4710-4816-86d9-0071d74f00b4",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Après avoir composé de fulgurants poèmes, le jeune Rimbaud à cessé d’écrire à 20 ans et quitte l’Europe pour marchander en Afrique ."
                                            },
                                            {
                                                "example_id": "884f086a-6da2-4eae-98a2-30cce6af887e",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Il a marchandé ce cheval."
                                            },
                                            {
                                                "example_id": "237fd03b-24e1-47d5-bde5-77ae36e5c943",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Il a manqué cette affaire, à force de marchander."
                                            },
                                            {
                                                "example_id": "d822f995-ba80-4b7b-b38f-4761516590a3",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Il a acheté ce tableau sans marchander."
                                            },
                                            {
                                                "example_id": "b80b7275-7a26-4680-aaf2-f76c7f7dce54",
                                                "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                                                "text": "Il ne faut pas marchander avec lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89178c60-77c1-3d31-b640-c17b1c4be84e",
                                        "entry_id": "efb93d50-04a4-3744-bec9-6c0563751670",
                                        "glosses": [
                                            "Discuter pour lésiner."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e351b266-5687-4e43-a5fd-36dc51504569",
                                                "sense_id": "89178c60-77c1-3d31-b640-c17b1c4be84e",
                                                "text": "Il a manqué cette affaire, à force de marchander."
                                            },
                                            {
                                                "example_id": "3cfbecd0-e64d-4c54-b761-812f796225cb",
                                                "sense_id": "89178c60-77c1-3d31-b640-c17b1c4be84e",
                                                "text": "On suppute le prix d'une colonne, on marchande l'épaisseur des dorures, bientôt il ne sera plus permis d'allumer une rampe au fronton de l'Élysée, sans entendre crier quelque part qu'un mètre de gaz coûte vingt centimes, […]."
                                            },
                                            {
                                                "example_id": "cbf4ab30-6c42-4146-b1c7-f326af479812",
                                                "sense_id": "89178c60-77c1-3d31-b640-c17b1c4be84e",
                                                "text": "Pouvais-je marchander au destin d’autres journées comme celle que je venais de vivre ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a91ea1e-b062-368a-a5b4-b296f1f5ac4d",
                                        "entry_id": "efb93d50-04a4-3744-bec9-6c0563751670",
                                        "glosses": [
                                            "Hésiter, balancer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a79c83e5-3274-4167-9d81-547ff57a0dc2",
                                                "sense_id": "4a91ea1e-b062-368a-a5b4-b296f1f5ac4d",
                                                "text": "Il n’y a pas à marchander, il faut se décider."
                                            },
                                            {
                                                "example_id": "3e0b8fc6-79ba-4f49-a80d-cdc6e631c647",
                                                "sense_id": "4a91ea1e-b062-368a-a5b4-b296f1f5ac4d",
                                                "text": "Il fit le sacrifice de sa vie, sans marchander."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                                        "entry_id": "efb93d50-04a4-3744-bec9-6c0563751670",
                                        "glosses": [
                                            "Accorder sans lésiner."
                                        ],
                                        "tags": [
                                            "Dans un tour négatif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75bb9557-bb28-49e7-a2c7-735e1f1b54eb",
                                                "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                                                "text": "Quant à M. Verdurin, il ne marchanda pas sa gaieté, car il avait trouvé depuis peu pour la signifier un symbole autre que celui dont usait sa femme, mais aussi simple et aussi clair."
                                            },
                                            {
                                                "example_id": "1f477c5c-2291-4f6e-9ef5-fe1a14729584",
                                                "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                                                "text": "J’aime mon corps ; il m’a bien servi, et de toutes les façons, et je ne lui marchande pas les soins nécessaires."
                                            },
                                            {
                                                "example_id": "57df84f4-4d00-4d75-8f99-de4da48020b3",
                                                "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                                                "text": "Ne pas marchander les éloges à quelqu’un."
                                            },
                                            {
                                                "example_id": "d381af81-f870-4706-b5c5-2001eefbea68",
                                                "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                                                "text": "Ne pas marchander sa vie, l’accorder sans hésiter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
