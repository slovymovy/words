                                "target_senses": [
                                    {
                                        "sense_id": "1deaa0a6-fbaf-3f7c-b0e6-171298c6cb37",
                                        "entry_id": "7e6efc20-f70d-3535-bfd5-e6e5b86cf047",
                                        "glosses": [
                                            "Of a plant; pertaining to or grown using hydroponics, a method of growing plants using mineral nutrient solutions in water, without soil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae7bb71-b936-4076-a459-a2ce79d669c4",
                                                "sense_id": "1deaa0a6-fbaf-3f7c-b0e6-171298c6cb37",
                                                "text": "Sid was now living in a small commune in the Shetland Islands, where he and his fellow communards were dedicated to the growing of implausibly large hydroponic onions."
                                            },
                                            {
                                                "example_id": "a8be5997-bddc-4296-87aa-e1c9962cea2c",
                                                "sense_id": "1deaa0a6-fbaf-3f7c-b0e6-171298c6cb37",
                                                "text": "She had been offended because he had seen her every day for ten days, then when she’d finally obtained 50 grams of genetically enhanced hydroponic marijuana for him[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
