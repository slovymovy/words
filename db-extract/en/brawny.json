                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51912f6f-f485-4651-96bd-dde7eb6bf007",
                                                "sense_id": "ee2e73ea-01c7-3818-a515-14c676b6ea5a",
                                                "text": "Le dernier exercice était vraiment balèze !"
                                            },
                                            {
                                                "example_id": "14a4f03b-4a19-4a15-9520-69709d0350b8",
                                                "sense_id": "ee2e73ea-01c7-3818-a515-14c676b6ea5a",
                                                "text": "— C’était un truc balèze, ça, de pleurer tout le temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e638411-0934-33fa-a602-b19eaf2076f2",
                                        "entry_id": "efc1c38e-c5f0-3e75-ace2-4ff55c5da6a7",
                                        "glosses": [
                                            "Doué."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c35cfb9-3769-46f2-a296-6d549b6ab194",
                                                "sense_id": "1e638411-0934-33fa-a602-b19eaf2076f2",
                                                "text": "C’était un mec mince, brun, beau, élancé. Le genre de mec nerveux, beaucoup plus balèze qu’on ne croit."
                                            },
                                            {
                                                "example_id": "6bce5804-ccf6-4bfa-865f-a1c28a3fd855",
                                                "sense_id": "1e638411-0934-33fa-a602-b19eaf2076f2",
                                                "text": "Ô qu’il est balèze le Gus, comme on dit chez nous… Mais ça change rien à la discutabilité de son intégrité…"
                                            }
                                        ]
                                    }
                                ]
