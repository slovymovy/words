                "senses": [
                    {
                        "sense_id": "40f43a03-829e-399e-9860-7bb974a22e27",
                        "entry_id": "c05cc295-ffca-3a35-9201-8449ec1befdf",
                        "glosses": [
                            "Wörterbuch, das für Zwecke des Unterrichts entwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1009d17-067f-4dba-9bab-62067f580365",
                                "sense_id": "40f43a03-829e-399e-9860-7bb974a22e27",
                                "text": "Ein Schulwörterbuch bringt den Wortschatz der eigenen oder einer Fremdsprache in der Auswahl und Aufbereitung, die für den Unterricht benötigt wird."
                            },
                            {
                                "example_id": "6803b567-2794-4d4d-b913-417e75708720",
                                "sense_id": "40f43a03-829e-399e-9860-7bb974a22e27",
                                "text": "„Das vorliegende Buch ist zum Teil ein Auszug aus dem Stowasserschen Schul- und Handwörterbuche und beruht als solcher auf den Vorarbeiten zu dessen vierter Auflage.“"
                            },
                            {
                                "example_id": "ae644972-09c0-430d-a138-5e938236c7f3",
                                "sense_id": "40f43a03-829e-399e-9860-7bb974a22e27",
                                "text": "„Doch auch unsere Schulwörterbücher reichen für die immer weitere Kreise ziehenden Schulbedürfnisse nicht aus…“"
                            },
                            {
                                "example_id": "94034ace-7f74-4ba1-91fd-ae6677ebb26a",
                                "sense_id": "40f43a03-829e-399e-9860-7bb974a22e27",
                                "text": "„2003 wurde das Schulwörterbuch als eigenständiges Projekt abgetrennt (Deutsch-niedersorbisches Schulwörterbuch; geplanter Umfang: ca. 10.000 Stichwörter).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
