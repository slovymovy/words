                        ],
                        "examples": [
                            {
                                "example_id": "8010e136-3e3f-448e-b977-576a51c3efd7",
                                "sense_id": "b23132d2-2722-306c-b53c-6942ecf998c0",
                                "text": "Le 2 août aura lieu le cortège d’ouverture de 17h30 à 20h. Il sera suivi de l’oberbayern avec «Die Kamaraden Blaskapelle» de 20h à 2h, orchestre qui reviendra le lendemain également de 20h à 2h."
                            }
                        ]
                    }
