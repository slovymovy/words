                "senses": [
                    {
                        "sense_id": "8ba4285e-e958-31b0-a702-654fbc23b6a9",
                        "entry_id": "5a26537f-e94d-3f27-b544-2a0dc3f90140",
                        "glosses": [
                            "synonym of politie (“police”)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "85598351-30da-415b-a239-c543013a9ef9",
                                "sense_id": "8ba4285e-e958-31b0-a702-654fbc23b6a9",
                                "text": "We denken allemaal hetzelfde: dat is geen politie. De popo klopt niet aan. Die beukt de deur in. Die komt schreeuwend binnen met een schijnwerper en het geweer in de aanslag."
                            },
                            {
                                "example_id": "b1b8a1f5-b7c7-46e6-bcd5-ece0d226a4ff",
                                "sense_id": "8ba4285e-e958-31b0-a702-654fbc23b6a9",
                                "text": "Maar toen de politie arriveerde had niet iedereen tijdig kunnen vluchten. Na kreten van 'O shit! De popo! De popo!' waren Robbies vrienden over een hek gesprongen en hadden zich rennend over de heuvels in veiligheid gebracht."
                            },
                            {
                                "example_id": "5248ad54-bf88-4f2e-9fff-c4319feb3803",
                                "sense_id": "8ba4285e-e958-31b0-a702-654fbc23b6a9",
                                "text": "Te veel nachtwerk op dezelfde locatie gaf de popo, zoals Sebastien de politie noemde, te veel aanleiding om te snuffelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fabfbf0-378a-39ce-8bac-17db046101c8",
                        "entry_id": "5a26537f-e94d-3f27-b544-2a0dc3f90140",
                        "glosses": [
                            "synonym of politieagent (“police officer”)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ce53442a-cd69-49b8-89d9-c7fac22e4832",
                                "sense_id": "7fabfbf0-378a-39ce-8bac-17db046101c8",
                                "text": "Niet moeilijk, want veel kans om wat te zeggen gaven die popo me niet. De ene na de andere vraag werd op me afgevuurd. Waarom hebben jullie Daniël Bootsma vermoord? Waarom ben je niet naar de politie gegaan als je onschuldig bent?"
                            }
                        ]
                    }
                ],
