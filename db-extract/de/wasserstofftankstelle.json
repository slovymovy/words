                ],
                "senses": [
                    {
                        "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                        "entry_id": "27152eeb-c01d-310d-b281-2d1df5828d36",
                        "glosses": [
                            "Station, an der die Wasserstofftanks von Brennstoffzellenfahrzeugen wiederbefüllt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588b653c-8fb2-4a7b-bab2-f535390516da",
                                "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                                "text": "„Nach einer Explosion in einer Wasserstofftankstelle in Norwegen liefern die Autobauer Hyundai und Toyota bis auf weiteres in dem Land keine Fahrzeuge mit Wasserstoffantrieb mehr aus.“"
                            },
                            {
                                "example_id": "ac0c0441-5e56-4c55-8ca2-beefd720f8a2",
                                "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                                "text": "„Im Herbst 2016 will Coop die erste öffentliche Wasserstofftankstelle der Schweiz eröffnen.“"
                            },
                            {
                                "example_id": "abdbb80f-abc2-4440-b893-3a0a2bee28d0",
                                "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                                "text": "„Noch fehlt im Kreis Groß-Gerau eine passende Wasserstofftankstelle. Und auch die für die beabsichtigte Flottenumrüstung benötigten Brennstoffzellenbusse existieren bis dato nur auf dem Papier.“"
                            },
                            {
                                "example_id": "31ac2bd3-8afd-4358-8a4b-3a4f22cabbd5",
                                "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                                "text": "„Für die flächendeckende Nutzung von Wasserstoff als Treibstoff müsste ein dichtes Netz an Wasserstofftankstellen vorhanden sein.“"
                            },
                            {
                                "example_id": "b86bc515-1654-4126-948e-df6551e09f6f",
                                "sense_id": "6f6f35aa-d10a-3036-911b-ea0584136b2d",
                                "text": "„Im Jahr 2013 gab es jedoch nur etwa 40 Wasserstofftankstellen in ganz Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
