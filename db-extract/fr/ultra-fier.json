                        "examples": [
                            {
                                "example_id": "2efbeda2-7124-4ef3-8c66-ffecdfab0169",
                                "sense_id": "17e48145-55e0-3efb-866f-7be9fad0df64",
                                "text": "Ils sont toujours ultra-fiers de montrer à leurs amis qu’elle y a son nom, comme si cela faisait d’elle une personnalité."
                            },
                            {
                                "example_id": "05537310-e145-402b-b866-5d9c47828304",
                                "sense_id": "17e48145-55e0-3efb-866f-7be9fad0df64",
                                "text": "Tout ça pour dire que je suis ultra-fière de moi pour la job que je viens de faire et, surtout, infiniment contente que le changement plaise à madame Cartier."
                            },
                            {
                                "example_id": "7e550ae1-3f75-4035-9e12-52c950feb284",
                                "sense_id": "17e48145-55e0-3efb-866f-7be9fad0df64",
                                "text": "Et tu seras ultra-fière de toi après, crois-moi."
                            }
                        ]
                    }
