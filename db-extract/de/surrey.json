                "senses": [
                    {
                        "sense_id": "a205094e-ea3c-3c1f-acc6-397b3554f57b",
                        "entry_id": "6cdf08f7-0ccb-36ad-97de-8366a270a170",
                        "glosses": [
                            "Grafschaft in Südengland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be875e99-530f-4c0d-a1f8-f91025f81527",
                                "sense_id": "a205094e-ea3c-3c1f-acc6-397b3554f57b",
                                "text": "„Ich wohnte zu jener Zeit in London, und der Brief des Professors war irgendwo in Surrey verfasst worden, so dass es keine großen Schwierigkeiten bereitete, ein Treffen zu vereinbaren.“"
                            },
                            {
                                "example_id": "21a9b2d1-91fa-40d2-ba37-cf019dd19e04",
                                "sense_id": "a205094e-ea3c-3c1f-acc6-397b3554f57b",
                                "text": "„›Das lernt man in Mount Browne. Das war noch zu der Zeit, als ich bei der Polizei von Surrey war.‹“"
                            },
                            {
                                "example_id": "f358d091-befc-4d37-ae02-2b9456ec5076",
                                "sense_id": "a205094e-ea3c-3c1f-acc6-397b3554f57b",
                                "text": "„›Scusi, Babe‹, erwidert Pollyanna. Scusi. Als wär sie nicht aus Surrey.“"
                            },
                            {
                                "example_id": "970072c4-cba0-41c9-8109-b2b586b29107",
                                "sense_id": "a205094e-ea3c-3c1f-acc6-397b3554f57b",
                                "text": "„Zunächst hatte ich ihre Spur bis zu einem Haus in Surrey verfolgt, einem Haus, das ein Jahr zuvor der Schauplatz der Ermordung eines gewissen Titus Pettifer gewesen war, eines Milliardärs, den einer seiner eigenen Leibwächter erschossen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
