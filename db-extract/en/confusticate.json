                ],
                "senses": [
                    {
                        "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                        "entry_id": "bee15f89-a8da-3ab3-834b-ff11e2d978cd",
                        "glosses": [
                            "To confuse, confound, or perplex."
                        ],
                        "tags": [
                            "US",
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8865b7f8-50f2-4705-967e-b95f51a17109",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "Massa Clifford’s eye sezs, plain as eber eye did, dat de niggers dat ’specs to confusticate him, mus’ be smarter dan eber yer was, or will be ter de fift’ generation."
                            },
                            {
                                "example_id": "f2b5636e-b8c2-4dc9-bf34-983f9bad708c",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "I had to come and go,\nReceive with pomp and show\nFrom nations, deputations,\nWhich confusticate one so !"
                            },
                            {
                                "example_id": "44822242-4cbc-42a2-b2a2-bf71adccc018",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "‘Confusticate and bebother these dwarves!’ he said aloud."
                            },
                            {
                                "example_id": "ba38e6d6-841a-4c42-a718-b9087d46d5fe",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "it is bound to make of medical malpractice trials veritable wars of even more lengthy attrition; with each side employing such a published congeries of conflicting medical views as would thoroughly confusticate any jury..."
                            },
                            {
                                "example_id": "7b11a34e-3395-4811-bc73-3c80e238efdd",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "well it sorta isn't YOU, it is rather you quoting me and him quoting you quoting me see how many little greater than signs there are? But it doesn't work if what comes after *my* line is his line and not yours, easy to get confusticated eh?"
                            },
                            {
                                "example_id": "6df7b8ab-e0d3-4774-9398-bbd84721b3dc",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "He tapped the side of his pack: on it was written: CHARMED, ENCHANTED, ENSORCELLED AND CONFUSTICATED. 'I used to be confusticated,' he confided, 'but you know how these things go.'"
                            },
                            {
                                "example_id": "afbba2a8-48a3-4c52-b672-41778f227607",
                                "sense_id": "a7f3471f-61db-3181-8a7a-f52bded3fa56",
                                "text": "The shoulder-Satan whispered into Fred’s ear, “How many chances do you get to confusticate Satan himself?”"
                            }
                        ]
                    }
