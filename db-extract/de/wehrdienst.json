                                "sense_id": "f07ee3db-a911-3a09-bf11-ef37f5709fa1",
                                "text": "„Weil es in einem Gebäude in Freiburg nach Gas roch, haben die Wehrdienste rund 50 Personen vorübergehend evakuiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
