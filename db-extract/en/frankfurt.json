                "senses": [
                    {
                        "sense_id": "1396ee17-07bf-3881-bd37-e1939aa4bb4b",
                        "entry_id": "ad5a5a2e-1370-3926-b4e0-5b9aa0373e4b",
                        "glosses": [
                            "A frankfurter; a hot dog sausage."
                        ],
                        "tags": [
                            "Australia",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "270055b6-5c62-453b-8005-65a7ff03fc6c",
                                "sense_id": "1396ee17-07bf-3881-bd37-e1939aa4bb4b",
                                "text": "Sample of frankfurts procured from Stanley Kwiatkowski, Grand Rapids, Mich. Contains excessive amount of cereal."
                            },
                            {
                                "example_id": "3d10e6b3-8270-4f29-8eca-05964a4f77f9",
                                "sense_id": "1396ee17-07bf-3881-bd37-e1939aa4bb4b",
                                "text": "Frankfurts of the highest quality are prepared generally from a mixture of approximately half beef and half pork."
                            },
                            {
                                "example_id": "05c83e4c-16fc-4021-955f-c6b861b09aad",
                                "sense_id": "1396ee17-07bf-3881-bd37-e1939aa4bb4b",
                                "text": "As a kid in the 50s, (before we became infested with the current mish-mash of liquorice allsorts) pork fritz, devon, sliced ham, frankfurts, pork sausages...were all about as common a staple as you care to name. Even the Italians and Greeks of the time ate (and continue to eat) the stuff!!"
                            }
                        ]
                    }
