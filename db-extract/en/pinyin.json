                                "target_senses": [
                                    {
                                        "sense_id": "66bd9cda-6566-33ff-9e9d-719fdcae38ef",
                                        "entry_id": "84ac423a-4d80-33d5-95d1-3b07441d9c9c",
                                        "glosses": [
                                            "Langue bantoïde parlée dans la Région du Nord-Ouest au Cameroun."
