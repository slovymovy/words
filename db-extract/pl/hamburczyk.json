                                        "glosses": [
                                            "Personne habitant ou originaire de Hambourg, ville allemande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dc72fe-adbf-4fca-92e1-1922dcdf6dda",
                                                "sense_id": "e5b7f058-7243-3842-ad20-032a9dea93fd",
                                                "text": "Lieu de détente et de promenade très prisé des Hambourgeois, le lac Alster se prête à la balade le long de ses rives bordées d’espaces verts, de cafés et de restaurants."
                                            }
                                        ]
