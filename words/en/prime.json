                        {
                            "text": "The <w>prime</w> objective of this mission is to gather intelligence.",
                            "target_lang_translations": {
                                "ru": "<w>Основная</w> цель этой миссии — сбор разведданных.",
                                "zh": "这次任务的<w>主要</w>目标是收集情报。"
                            }
