                "translations": [
                    {
                        "translation_id": "8dd51697-1ee0-4422-ab3c-b0a7003bfed8",
                        "source_entry_id": "a03825c2-42e5-3e3d-9951-6948b402f7ee",
                        "source_sense_id": "76853d79-e5e9-3140-9b4a-25b0505ab6cd",
                        "target_lang_word": "mikado",
