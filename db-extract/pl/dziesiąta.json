                    }
                ],
                "translations": [
                    {
                        "translation_id": "a13e697d-1fe2-499d-b9f2-cc29d750cc39",
                        "source_entry_id": "db6fab4c-acf7-382e-b7d4-866343074227",
                        "source_sense_id": "bc100022-2e57-32f6-a90f-6e7e1b864087",
                        "target_lang_word": "ten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7499a0e-9499-3854-9446-0df8a3f11608",
                                        "entry_id": "d31073e0-862d-3c12-9250-74e8a169bc52",
                                        "glosses": [
                                            "The number occurring after nine and before eleven, represented in Arabic numerals (base ten) as 10 and in Roman numerals as X."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6947d18-419c-4149-be93-8aa95b9b84c9",
                                                "sense_id": "d7499a0e-9499-3854-9446-0df8a3f11608",
                                                "text": "There is a melody upon the Earth as though ten thousand streams all sang together for their homes that they had forsaken in the hills."
                                            },
                                            {
                                                "example_id": "85b7c57d-43e3-44b9-8a0a-89f4a9f99b8a",
                                                "sense_id": "d7499a0e-9499-3854-9446-0df8a3f11608",
                                                "text": "A ten frame is a simple graphic tool that allows people to “see” numbers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e9878d-9d71-3632-9047-395e8034afb1",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "A set or group with ten elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35914512-ee5e-4061-904d-40a9acfeb7f2",
                                                "sense_id": "d6e9878d-9d71-3632-9047-395e8034afb1",
                                                "text": "We divided the chocolates into tens to hand out to Hallowe'en visitors."
                                            },
                                            {
                                                "example_id": "68289a01-35ab-4cf2-97a7-457af8dc63e8",
                                                "sense_id": "d6e9878d-9d71-3632-9047-395e8034afb1",
                                                "text": "They can readily state the number of tens in a hundred. But somehow they do not have a full appreciation of the \"tenness\" of our system and how the system is structured."
                                            },
                                            {
                                                "example_id": "ffa7bc73-4787-4018-a2d5-fab7f2b4b86e",
                                                "sense_id": "d6e9878d-9d71-3632-9047-395e8034afb1",
                                                "text": "Understanding that numbers are composed of tens and ones is an important foundational concept, setting the stage for work with larger numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e100a0e1-9aad-3bac-8a8d-053b61a92e30",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "An inexact quantity, typically understood to be between 20 and 100."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c6c38e-6a68-42e4-ac39-d6cb7667e81f",
                                                "sense_id": "e100a0e1-9aad-3bac-8a8d-053b61a92e30",
                                                "text": "Our houses are tens of meters apart, so we don't have to worry about noise from our neighbours."
                                            },
                                            {
                                                "example_id": "b90f23c7-2945-4515-93c6-63696c2abf20",
                                                "sense_id": "e100a0e1-9aad-3bac-8a8d-053b61a92e30",
                                                "text": "tens of thousands of voters"
                                            },
                                            {
                                                "example_id": "4a4777da-65a4-4db4-93b0-c798ed678304",
                                                "sense_id": "e100a0e1-9aad-3bac-8a8d-053b61a92e30",
                                                "text": "No trees have grown on the windswept Falkland Islands in the South Atlantic Ocean for tens of thousands of years — just shrubs and other low-lying vegetation. That’s why a recent arboreal discovery nearly 20 feet (6 meters) beneath the ground caught researchers’ attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7d10aa-3526-32a5-bc5e-7d8be5c7a91a",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "A card in a given suit with a value of ten."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64c41ff5-4df4-366f-8fc7-0740aae44470",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "A denomination of currency, such as a banknote, with a value of ten units."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a1bec9-9698-47a6-bde4-c27693912f86",
                                                "sense_id": "64c41ff5-4df4-366f-8fc7-0740aae44470",
                                                "text": "Can you give me two tens for this twenty?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617521d4-cdc3-380d-84de-909ce2a4fc35",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "A perfect specimen, (particularly) a physically attractive person."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40edaf29-e556-4856-829f-51105c929e39",
                                                "sense_id": "617521d4-cdc3-380d-84de-909ce2a4fc35",
                                                "text": "I was in the Woodley Park–Zoo in D.C. and mom and sister were waiting to see the pandas, so me and my pops broke away to check out the monkey house. Well, there was a beautiful teacher, I mean we're talking a ten, she was blond, had a low-cut dress on, just gorgeous. And she has about eight or nine students and she's pointing out all the different monkeys. And me and my dad noticed this huge orangutan kind of fiddling with himself. And on close [censored] And we kept checking it out and he was looking directly at the teacher. Well, a couple minutes passed by [censored] he proceeds to [censored] that's when the teacher noticed and, you know, took the kids away very hurriedly. But I looked at my dad and said, you know, they're so much like us."
                                            },
                                            {
                                                "example_id": "a95098ca-045f-40c0-9fc3-b490183ca7eb",
                                                "sense_id": "617521d4-cdc3-380d-84de-909ce2a4fc35",
                                                "text": "An Office Ten is a person who falls somewhere between average to mildly good-looking in the world at large but skyrockets to wildly attractive within the confines of an open-concept desk plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184c98a5-6f21-3c67-92d2-aa14403156e0",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "A high level of intensity."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7228111-0302-4871-a5b5-9fddfe72c732",
                                                "sense_id": "184c98a5-6f21-3c67-92d2-aa14403156e0",
                                                "text": "\"Intensities in 10 Cities\""
                                            },
                                            {
                                                "example_id": "2f4bcda3-bd3b-4f16-9ae2-c8903e9bc454",
                                                "sense_id": "184c98a5-6f21-3c67-92d2-aa14403156e0",
                                                "text": "...\nMarty Di Bergi (Rob Reiner): \"Why don't you just make ten louder, and make ten be the top number?\"\nNigel Tufnel (Christopher Guest): \"These go to eleven.\""
                                            },
                                            {
                                                "example_id": "9257f44a-668b-46da-96e1-0ed94fe90e3c",
                                                "sense_id": "184c98a5-6f21-3c67-92d2-aa14403156e0",
                                                "text": "...\nWayne Campbell (Mike Myers): \"You guys kick ass. You're Double Live Gonzo. Intensities in 10 Cities. Live at Budokan.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c993b669-f3df-3d55-8948-ecff2071dc54",
                                        "entry_id": "862fcd74-c687-3269-ae79-982eae9338a9",
                                        "glosses": [
                                            "The act of rowing ten strokes flat out."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e97c4fa-211b-4939-b846-732325ad16e5",
                                                "sense_id": "c993b669-f3df-3d55-8948-ecff2071dc54",
                                                "text": "At the 1,000-metres post we gave a ten, which raised our lead to 1⅔ lengths; the Belgians were rowing hard, but one felt that they still had plenty of spurting power."
                                            },
                                            {
                                                "example_id": "189014e4-65a2-4d75-90bb-ce35631a5684",
                                                "sense_id": "c993b669-f3df-3d55-8948-ecff2071dc54",
                                                "text": "Morris gave a ten, and an unbelievable surge ran through the boat, one that I had never felt before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b8e799-dabc-4912-889c-5a58378ca3a6",
                        "source_entry_id": "db6fab4c-acf7-382e-b7d4-866343074227",
                        "source_sense_id": "bc100022-2e57-32f6-a90f-6e7e1b864087",
                        "target_lang_word": "o'clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "o'clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "In conjunction with a numeral, indicates the time within a twelve-hour period (midnight to noon or noon to midnight), specifically the time when the hour hand of a clock points precisely to the symbol or marking corresponding to the designated numeral, i.e., at the hour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3036e6b-bbc9-47a6-bb3f-01ea23e64a1d",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "We are expected to be there at six o'clock in the morning!"
                                            },
                                            {
                                                "example_id": "3748c75a-5f08-4f1e-af16-4548a0188b3e",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "It is two o'clock."
                                            },
                                            {
                                                "example_id": "e56858d2-53cd-4e56-ab66-1cdd50420023",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "What o'clock is it?"
                                            },
                                            {
                                                "example_id": "4afbf226-a50a-4f2b-a94a-f150a005f22e",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "I say, Watson, what o'clock is it?"
                                            },
                                            {
                                                "example_id": "457515ae-0d4c-4f91-b73c-9c02fba31090",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            },
                                            {
                                                "example_id": "91493ca0-d54e-4f41-b799-92e2d5678afa",
                                                "sense_id": "5dc0eb98-5ac4-3c8a-b9e2-b44d887855b6",
                                                "text": "Shortly before five o'clock in the afternoon of Thursday, April 12, 1945, after the Senate adjourned, I went to the office of House Speaker Sam Rayburn. I went there to get an agreement between the Speaker and the Vice-President on certain legislation and to discuss the domestic and world situation generally. As I entered, the Speaker told me that Steve Early, the President's press secretary, had just telephoned, requesting me to call the White House."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "Used to indicate that it is time to do a specific action, or time for a specific action to occur."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179d4602-2fb7-4105-8932-5ada8a761172",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "I'm feeling peckish; I think it must be nearly dinner o'clock."
                                            },
                                            {
                                                "example_id": "e1cd6770-3ced-41b8-b0b9-aa22dec27395",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "We're here at Waffle House, and it's waffles o'clock!",
                                                "translation": "We're here at Waffle House, and it's time to eat waffles.",
                                                "english": "We're here at Waffle House, and it's time to eat waffles."
                                            },
                                            {
                                                "example_id": "1551bc29-c59e-4c19-b772-882434c9446c",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "Hooray! Beer o'clock!"
                                            },
                                            {
                                                "example_id": "36361d5a-3a52-40e5-8968-4536af0eada6",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "That same evening at tea-time — (I am sorry to have to introduce you to another eating-scene, but the hours in English households are usually marked by repasts. It is a daily calendar of feasts — breakfast o’clock, dinner o’clock, &c.,[…])."
                                            },
                                            {
                                                "example_id": "62d9287b-304e-48d3-99ff-f5a889c8c396",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "“My sister requires your attendance at supper o’clock this evening — no excuse accepted.”"
                                            },
                                            {
                                                "example_id": "05d77c9c-a9ae-4880-b709-bbb9de8910b6",
                                                "sense_id": "1ceb4582-08a3-3cb0-a9e8-72c803f89467",
                                                "text": "“It's lunch o’clock. Wanna go out to eat?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                        "entry_id": "04fea43f-58d0-385b-b263-405948482118",
                                        "glosses": [
                                            "In conjunction with a numeral, indicates the direction, relative to the speaker or a vehicle, especially an aircraft, corresponding to the direction the hour hand is pointing at the time corresponding to the numeral, with twelve representing directly ahead on a horizontal plane, or directly up on a vertical plane, and three being to the right on either."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "with-numeral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbbe401d-97f7-460c-a435-f306850d98c7",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "It's at nine o'clock about two feet in from the edge of the branch. You need to know your \"o'clocks\" (nondigital) to spot birds."
                                            },
                                            {
                                                "example_id": "ac0d2399-0839-44a2-b96c-3fcbfc426c20",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Without moving your head, move your gaze upward to look at twelve o’clock. Now look down at six o’clock. Repeat three times, then blink several times, and rest with your eyes closed."
                                            },
                                            {
                                                "example_id": "92466fb1-b617-4ab8-b9de-9589d199a03c",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Thus, you could tell them to \"look at three o'clock,\" or \"look just off-center toward nine o'clock,\" and so forth. Alternatively, in some microscopes a thin black line appears to cut across the field of view"
                                            },
                                            {
                                                "example_id": "fc01a88f-892d-49f3-b189-77cb6f37d91f",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "Three o'clock and nine o'clock would be at the outer right and outer left sides of the tree, respectively, and so on. The clock technique is a very helpful way for one bird watcher to direct others to a hard-to-spot perched bird."
                                            },
                                            {
                                                "example_id": "06b047d7-8631-4804-84dc-48b00d89910b",
                                                "sense_id": "3be88b9f-1ed6-3cf5-b371-f38b3ca450bf",
                                                "text": "At 1057 we were just over the islands and at 1100 the tail gunner reported flak at six o’clock, below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
