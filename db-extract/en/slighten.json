                "senses": [
                    {
                        "sense_id": "00113a54-2148-3d3a-8959-90a22e642cc1",
                        "entry_id": "c3e19327-f20e-3b58-a028-080233387070",
                        "glosses": [
                            "To make or become slight; make or become less pronounced, less noticeable, or less obvious."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "64586e1d-0cc2-4b27-9789-6f75e032fba6",
                                "sense_id": "00113a54-2148-3d3a-8959-90a22e642cc1",
                                "text": "His smile slightened as if he knew they talked of him."
                            },
                            {
                                "example_id": "15bd8d7e-642f-4608-b16f-52ca275b1560",
                                "sense_id": "00113a54-2148-3d3a-8959-90a22e642cc1",
                                "text": "With tissue I softened my rouge, slightened my lipstick; studying my redesigns in my green compact's mirror I marveled, seeing yet another strange face."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cf576b2-ebe3-31d9-81ab-882930138f5c",
                        "entry_id": "c3e19327-f20e-3b58-a028-080233387070",
                        "glosses": [
                            "To slight."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2202a41-9fd2-4c70-9bc1-3e231de01a20",
                                "sense_id": "3cf576b2-ebe3-31d9-81ab-882930138f5c",
                                "text": "[…] as God forbid that anyone should hint a slightening word of what our sons and brothers are doing just now, and doing for us!"
                            },
                            {
                                "example_id": "ff48e1b5-a3c1-4818-b169-98d6b4f3ad59",
                                "sense_id": "3cf576b2-ebe3-31d9-81ab-882930138f5c",
                                "text": "They may take ill or feel slightened for not having been approached directly."
                            },
                            {
                                "example_id": "536fdd9e-d9fc-4e10-bc58-27c858b93830",
                                "sense_id": "3cf576b2-ebe3-31d9-81ab-882930138f5c",
                                "text": "It is an odious wisdom to blaspheme, / Much more to slighten, or deny their powers"
                            }
                        ]
                    },
                    {
                        "sense_id": "34c83507-3a5d-3f76-828c-77ac057be5c3",
                        "entry_id": "c3e19327-f20e-3b58-a028-080233387070",
                        "glosses": [
                            "To level out, smooth, or flatten."
                        ],
                        "tags": [
