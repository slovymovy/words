                                "target_senses": [
                                    {
                                        "sense_id": "66896c4a-5c09-36fb-95c1-aff8b96762bf",
                                        "entry_id": "ff942042-8e89-37e3-9582-cd340af6c7ff",
                                        "glosses": [
