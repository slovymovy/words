                "senses": [
                    {
                        "sense_id": "3562fe22-4a2c-34d5-ab3b-698136c66d6c",
                        "entry_id": "e02a270a-8635-30ca-8f86-9989a1344f34",
                        "glosses": [
                            "Donner un caractère churchillien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20655d42-2174-4d90-8dec-42f7c92d3f63",
                                "sense_id": "3562fe22-4a2c-34d5-ab3b-698136c66d6c",
                                "text": "Il est vrai qu’avec cette biographie, Churchill inaugure une nouvelle méthode de rédaction : au lieu de tout écrire lui-même comme auparavant, il fait rédiger par ses assistants de recherche l’essentiel des chapitres, qu’il entreprend ensuite de « churchilliser »."
                            },
                            {
                                "example_id": "1ebb0a5a-4956-45b9-a4b9-f7aea728c69b",
                                "sense_id": "3562fe22-4a2c-34d5-ab3b-698136c66d6c",
                                "text": "Bientôt, grâce à cette humiliation publique, j’aurai la chance d'être moi… pas cet animal replet en passe de se churchilliser !"
                            },
                            {
                                "example_id": "c5fe11c6-e6fc-4903-8175-c3dd4a649fb5",
                                "sense_id": "3562fe22-4a2c-34d5-ab3b-698136c66d6c",
                                "text": "Nicolas Sarkozy doit-il désormais « se churchilliser » ?"
                            }
                        ]
                    }
