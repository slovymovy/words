                    {
                        "sense_id": "b1c6c767-a785-3637-a1cc-bd907842d01a",
                        "entry_id": "cfacd4b6-0e78-3074-b590-b80e4e11e5af",
                        "glosses": [
                            "A woman who withholds sex in order to get her way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4305b476-4ee5-4ebc-852c-f296e57ebb0b",
                                "sense_id": "b1c6c767-a785-3637-a1cc-bd907842d01a",
                                "text": "Lysistratas among the Indian [Iroquois] women proclaimed a boycott on lovemaking and childbearing."
                            },
                            {
                                "example_id": "96d9b0a6-d11f-4aa0-9d10-f8050d1f61b5",
                                "sense_id": "b1c6c767-a785-3637-a1cc-bd907842d01a",
                                "text": "Despite all this, the Western media framed these women as modern-day Lysistratas."
                            }
                        ]
                    }
                ],
