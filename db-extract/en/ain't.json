                        ],
                        "examples": [
                            {
                                "example_id": "42e0cc66-5dcd-495f-9e07-88e721c7b016",
                                "sense_id": "d1512e45-9244-3e29-a96b-1ec012581aa3",
                                "text": "I ain’t ready yet; gimme a sec."
                            },
                            {
                                "example_id": "03ecc343-544c-4a64-a478-7e044f60ed2c",
                                "sense_id": "d1512e45-9244-3e29-a96b-1ec012581aa3",
                                "text": "Ain’t I a woman?"
                            },
                            {
                                "example_id": "cbbe707b-c907-49fa-9368-fd5cd725116d",
                                "sense_id": "d1512e45-9244-3e29-a96b-1ec012581aa3",
                                "text": "Ain’t I a woman?"
                            }
                        ]
                    },
                    {
                        "sense_id": "78133672-a827-3d69-9d72-b4d4083bd9bc",
                        "entry_id": "68cdbd1a-39dc-31bc-b365-21aeeb654138",
                        "glosses": [
                            "Are not, aren’t; is not, isn’t."
                        ],
                        "tags": [
                            "dialectal",
                            "informal",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "98ec2096-8a4a-4709-b44f-b6a0d037d832",
                                "sense_id": "78133672-a827-3d69-9d72-b4d4083bd9bc",
                                "text": "That ain't right."
                            },
                            {
                                "example_id": "730bb4a8-0d5c-4ce7-862e-e6261502a3df",
                                "sense_id": "78133672-a827-3d69-9d72-b4d4083bd9bc",
                                "text": "We figure in lively paint:\nOur attitude’s queer and quaint —\nYou’re wrong if you think it ain’t, oh!"
                            },
                            {
                                "example_id": "38741399-cafb-4a00-9f3a-77f874e5080b",
                                "sense_id": "78133672-a827-3d69-9d72-b4d4083bd9bc",
                                "text": "You ain’t nothin’ but a hound dog."
                            },
                            {
                                "example_id": "e611b993-27aa-4bc0-ae73-9e49f8267452",
                                "sense_id": "78133672-a827-3d69-9d72-b4d4083bd9bc",
                                "text": "It ain’t me you’re looking for."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cc83712-8a44-3a06-bce0-c77e01622e68",
                        "entry_id": "68cdbd1a-39dc-31bc-b365-21aeeb654138",
                        "glosses": [
                            "Have not, haven’t; has not, hasn’t, when used as an auxiliary."
                        ],
                        "tags": [
                            "dialectal",
                            "informal",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "5db08a37-2802-4c6a-b828-c94343144700",
                                "sense_id": "6cc83712-8a44-3a06-bce0-c77e01622e68",
                                "text": "These people ain’t seen a brown skin man since their grandparents bought one"
                            },
                            {
                                "example_id": "8d4d496e-2354-4ccf-b017-dca25246cabf",
                                "sense_id": "6cc83712-8a44-3a06-bce0-c77e01622e68",
                                "text": "Got a pile of sins to pay for and I ain’t got time to hide / I’d walk through a blazing fire, baby, if I knew you was on the other side."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                        "entry_id": "68cdbd1a-39dc-31bc-b365-21aeeb654138",
                        "glosses": [
                            "Don’t, doesn’t."
                        ],
                        "tags": [
                            "dialectal",
                            "informal",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "31dd6a45-7e3a-4441-936d-8da637c6ec2a",
                                "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                                "text": "Well, I ain’t wanna do that though."
                            },
                            {
                                "example_id": "852fadeb-b246-4586-94b7-308e240c6193",
                                "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                                "text": "“I ain’t like it; I ain’t like it a tall.^([sic])” Jesse leaned down to help Israel. Then he stood back up and shouted again, “Youes crazy! Youes both crazy!” “Crazy we’z may be, but we’z still living and Ben dare ain’t.”"
                            },
                            {
                                "example_id": "743353e8-4286-483a-be5d-7f6d20981e74",
                                "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                                "text": "We ain’t able to go on out there telling folks in this world what we wanna be and what we ain’t wanna be. That ain’t our world honey, and learning is fine, ya done good, that’s for sure, but ain’t no time for dreaming."
                            },
                            {
                                "example_id": "62a700c3-b7cf-43ce-ad1f-2e9a36801907",
                                "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                                "text": "“He ain’t love me.” She brings me back to the now. “I knew he ain’t the first time he put his hands on me.”"
                            },
                            {
                                "example_id": "b3521eb4-096e-49c5-aa4f-42031ca49131",
                                "sense_id": "5b99ca41-75fe-33ae-8475-afec4a9a2de9",
                                "text": "I ask her if we can do it during fifth period cause I ain’t like econ. She say no, we gotta do it in fourth."
                            }
                        ]
                    },
                    {
                        "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                        "entry_id": "68cdbd1a-39dc-31bc-b365-21aeeb654138",
                        "glosses": [
                            "Didn’t."
                        ],
                        "tags": [
                            "dialectal",
                            "informal",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "9f8e0c0b-7776-4a98-aa5c-143d9c21a6c6",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "I ain’t go into the bathroom last night that late."
                            },
                            {
                                "example_id": "dda36b1e-8a68-4ba5-8667-3845a8d5e6e4",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "My son died, he ain’t live but I still try to think positive ’cause in life God take, God give."
                            },
                            {
                                "example_id": "c73110c1-a592-47d5-a4b7-7bce74a1ebab",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "Prince Williams ain’t do it right, if you ask me. ’Cause I was him, I would have married Kate and Ashley."
                            },
                            {
                                "example_id": "cbb5e68f-145c-4e98-b70c-27e38ded3943",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "“[...] ’Cause if I ain’t love you as much as I do, we wouldn’t be together right now. Don’t sit over there actin’ like you did somethin’ magical,” Jada vented."
                            },
                            {
                                "example_id": "74e05aef-70a0-4c8f-bd76-c09c65e12a53",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "Could've got the Beamer. I ain't really want it.[…]Man, I should've got the Lex. Dropped the top on em, I ain't wanna flex. Would've hit your girl, I ain't want the sex."
                            },
                            {
                                "example_id": "328d97d3-b9f7-4473-93ab-54ba48f3c702",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "She ain’t want da state to split us up so she dropped er last yur’a high school to take cur’a us."
                            },
                            {
                                "example_id": "2b6a1c99-f26d-4698-9e7b-21296ce8b709",
                                "sense_id": "b93fd50d-d818-3501-82d7-2d089abd9727",
                                "text": "[Verse 3: DaBaby]: I just put diamonds on all of my teeth, now they probably think I ain’t intelligent. In the homicide unit interrogation, asking questions, you know I ain’t tell ’em shit."
                            }
                        ]
                    }
