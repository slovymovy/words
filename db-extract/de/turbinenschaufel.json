                ],
                "senses": [
                    {
                        "sense_id": "7eebab00-fcf1-3360-847c-288c189f96ae",
                        "entry_id": "c7efee2f-8ba5-33e3-badc-5643b8ddb1d7",
                        "glosses": [
                            "besonders geformte Schaufel, an der Tangentialkräfte und Zentrifugalkräfte wirken und eine Drehbewegung erfährt; Kraftmaschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf071d5-48dc-4e7e-a620-a786ec0244fc",
                                "sense_id": "7eebab00-fcf1-3360-847c-288c189f96ae",
                                "text": "„Bei den zu betrachtenden Komponenten handelt es sich um eine Turbinenschaufel, welche in zwei verschiedenen Varianten in einem Turbinenkranz gelagert ist.“"
                            },
                            {
                                "example_id": "ef99fcca-a68f-48ca-a615-32052152c53f",
                                "sense_id": "7eebab00-fcf1-3360-847c-288c189f96ae",
                                "text": "„Die von Dr. Werner Stamm (links) entwickelte, nur 300 µm dünne Schicht verlängert die Lebensdauer von Turbinenschaufeln – auch die der weltgrößten Gasturbine (unten).“"
                            },
                            {
                                "example_id": "28f43f8a-e90e-4cd6-b923-fdd18d7fb924",
                                "sense_id": "7eebab00-fcf1-3360-847c-288c189f96ae",
                                "text": "„Um Fehler auf Turbinenschaufeln rechtzeitig zu entdecken, dürfen sie nicht von Schmutz oder Funktionsschichten überlagert sein.“"
                            },
                            {
                                "example_id": "4cbe3b3f-7276-432b-9de5-402638c3e1ee",
                                "sense_id": "7eebab00-fcf1-3360-847c-288c189f96ae",
                                "text": "„Turbinenschaufeln und andere Komponenten stationärer Generatoren sowie von Flugzeugtriebwerken zeichnen sich vielfach durch ihre komplexe Geometrien und Freiformflächen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
