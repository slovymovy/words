                "senses": [
                    {
                        "sense_id": "5a841b32-a5dc-3fc4-bc4c-c02eb68098fd",
                        "entry_id": "91441fdb-06d9-3779-ac51-d048003bb97e",
                        "glosses": [
                            "Se nommer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbf41aa-e5fe-4892-92da-afbb274eaa23",
                                "sense_id": "5a841b32-a5dc-3fc4-bc4c-c02eb68098fd",
                                "text": "Au sein de celui-ci, chacun certes est libre de s’auto-dénominer à son gré ;"
                            },
                            {
                                "example_id": "c01c7394-91cd-49c8-bee8-6e134bc173b2",
                                "sense_id": "5a841b32-a5dc-3fc4-bc4c-c02eb68098fd",
                                "text": "Par contre leur vocabulaire royaliste (empereur, impératrice, reine, roi, prince, princesse, altesse et Cie) me fait soit sourire (jaune), soit m'indiffère, soit m'énerve, car je ne comprends pas ce culot de s'auto-dénominer ainsi."
                            },
                            {
                                "example_id": "fa2bfa0b-e247-40a8-b060-9ac2c5aae4eb",
                                "sense_id": "5a841b32-a5dc-3fc4-bc4c-c02eb68098fd",
                                "text": "Une sorte de coalition de cause se forme alors autour du vote de la loi;"
                            }
                        ]
                    }
