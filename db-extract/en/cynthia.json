                    }
                ],
                "senses": [
                    {
                        "sense_id": "e15540aa-567c-3388-98ef-267759ab067e",
                        "entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                        "glosses": [
                            "Artemis (Greek goddess)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37d32962-1afd-3ab5-a808-1d59125d2a0b",
                        "entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                        "glosses": [
                            "The Moon."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7f207786-3735-49d7-a231-26cb26d2c8b6",
                                "sense_id": "37d32962-1afd-3ab5-a808-1d59125d2a0b",
                                "text": "As when faire Cynthia, in darkesome night, / Is in a noyous cloud enveloped [...]."
                            },
                            {
                                "example_id": "0444a392-258e-49d3-bd42-f2c2621ea553",
                                "sense_id": "37d32962-1afd-3ab5-a808-1d59125d2a0b",
                                "text": "[...] Cynthia's shining orb was made / Heav'n to clear when day did close [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc51cfc-dc9f-3e40-b12e-f5e65d946cf1",
                        "entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1519aca4-a6d5-47ce-abf7-96a45b8372aa",
                                "sense_id": "9bc51cfc-dc9f-3e40-b12e-f5e65d946cf1",
                                "text": "“Cynthia seems to me such an out-of-the-way name, only fit for poetry, not for daily use.”"
                            },
                            {
                                "example_id": "78e413d3-1582-456e-b130-7539455a12d5",
                                "sense_id": "9bc51cfc-dc9f-3e40-b12e-f5e65d946cf1",
                                "text": "Cynthia, the domestic-minded, looked as dashing as a young commando. It was a pity that her spelling was so bad, but perhaps there was something Elizabethan about her spelling as well as about her name."
                            },
                            {
                                "example_id": "38133537-f4f6-4e60-bf82-3efad3039a8a",
                                "sense_id": "9bc51cfc-dc9f-3e40-b12e-f5e65d946cf1",
                                "text": "Her twin daughters were on the playground equipment. Cynthia and Melinda, reduced to Cindy and Mindy, as Carella had dreaded would happen from the moment she named them."
                            },
                            {
                                "example_id": "251aac73-eda8-4b2a-b188-72295f0ef992",
                                "sense_id": "9bc51cfc-dc9f-3e40-b12e-f5e65d946cf1",
                                "text": "This hierarchisation of deaths has been challenged by gender scholars, with Cynthia Enloe coining the notion of “womenandchildren” in her 1990 text \"Bananas, Beaches and Bases\" to critique the use of this abstract category."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "419aed0f-a7b9-48c3-bc07-02b13bff8dfc",
                        "source_entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Cynthia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cynthia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31d0b098-24b9-3561-bb66-6a299445431f",
                                        "entry_id": "8444b4b0-d4d1-3b27-9e5f-e41e07ab2c8e",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "137bd2f6-db5d-4836-a379-9b594d65f698",
                                                "sense_id": "31d0b098-24b9-3561-bb66-6a299445431f",
                                                "text": "« Les gens ont été beaucoup confinés en couple. Donc, parmi les nouveaux joueurs, il y a beaucoup de couples », explique Cynthia Rebérac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc7c2d0-667c-491e-9537-aaad106b1b6d",
                        "source_entry_id": "f960def9-f332-3bfc-a58b-0ff5d520b8e2",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Cynthie",
