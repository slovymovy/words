                            {
                                "example_id": "44fa7741-73c0-49f7-b3c9-886cba159cb3",
                                "sense_id": "72538ff5-6b63-34a0-baa5-260e8de52381",
                                "text": "Vous savez que quant li pechierres veut penre le poisson à l’aing, il cuevre lou fer de l’èche ; et li poissons cuide mangier l’èche et li fers lou prent."
                            },
                            {
                                "example_id": "120110c8-3314-4939-9fc4-0c6734575ca0",
                                "sense_id": "72538ff5-6b63-34a0-baa5-260e8de52381",
                                "text": "Je savais que les carpes se tiennent d'ordinaire au fond, c'était donc là qu'il fallait aller les chercher ; mais le fond était composé de vase et la vase forme à sa partie supérieure une couche trés-molle dans laquelle mon èche serait cachée sans que le poisson pût la voir, à moins de grand hasard."
                            }
                        ]
                    }
