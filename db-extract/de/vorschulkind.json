                "senses": [
                    {
                        "sense_id": "ec7f6daa-bb78-33f2-840f-d350474cd612",
                        "entry_id": "3dd22b6a-e091-377d-89d2-1bb901c0752b",
                        "glosses": [
                            "Kind, das noch nicht schulpflichtig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150c50cc-918e-496f-a31a-3bf09b973bb6",
                                "sense_id": "ec7f6daa-bb78-33f2-840f-d350474cd612",
                                "text": "„Diese und andere hier angeschnittene Probleme haben die Wichtigkeit der sozialen Interaktion des Vorschulkindes hervorgehoben.“"
                            },
                            {
                                "example_id": "2bc1bd11-0ff4-414e-bd1f-79e7d9181f42",
                                "sense_id": "ec7f6daa-bb78-33f2-840f-d350474cd612",
                                "text": "„Spielen ist die dem Vorschulkind und dem Schulanfänger gemäße Lernform.“"
                            },
                            {
                                "example_id": "99189e86-5e7b-4618-8973-091ace4fdaf8",
                                "sense_id": "ec7f6daa-bb78-33f2-840f-d350474cd612",
                                "text": "„Weiterhin ist die Wahrnehmung für das Vorschulkind bedeutsamer als die Logik, sodass das logische Denken noch eingeschränkt ist.“"
                            },
                            {
                                "example_id": "3efdd836-3383-466a-b287-4a03a3b5984b",
                                "sense_id": "ec7f6daa-bb78-33f2-840f-d350474cd612",
                                "text": "„Mit der wachsenden Selbstständigkeit Ihres Vorschulkindes verändert sich Ihre Rolle als Eltern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
