                        ],
                        "examples": [
                            {
                                "example_id": "ffd5fa15-b453-4478-9b6d-ba4f1ee55bec",
                                "sense_id": "8549a797-5160-34ef-a00e-6c670df864c6",
                                "text": "Na ławie oskarżonych siedzieli zabójczyni dziecka i jej konkubent."
