                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df7dfea-0c16-4f51-9e3f-a73b0f75c717",
                                "sense_id": "d059119b-4d82-3a8b-8f70-da6f80df6919",
                                "text": "„Das Lamm gehört mehr zu Ostern als der Hase: im Alten Testament das klassische Opfertier, biblisches Symbol für die Leiden Christi. Vor allem in katholischen Gegenden ist es auf jeder Kaffeetafel zu finden, ein schlichter, leichter, mit Puderzucker bestäubter Biskuitkuchen, der sich bestens in den Kaffee stippen lässt.“"
                            }
                        ],
