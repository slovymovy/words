                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0767a999-ced0-4a16-8781-64966d713853",
                        "source_entry_id": "f21b741b-cf10-30e8-8883-170229d9f1f4",
                        "source_sense_description": "Japanese organized crime gang",
                        "target_lang_word": "яку́дза",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "яку́дза",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7b592061-eff2-34b1-a81e-d3b6dfd0fb14",
                                        "entry_id": "8d2c8a50-8ca2-349c-aad7-6f106dbb281f",
                                        "glosses": [
                                            "исч. член соперничающих между собой групп традиционной организованной преступности в Японии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c12304-6da3-4da1-9fb5-622cc0bd76a6",
                                                "sense_id": "7b592061-eff2-34b1-a81e-d3b6dfd0fb14",
                                                "text": "Сын японца, молодой якудза, следил за автомобилем, но не ездил на нём, потому что у него был свой."
                                            },
                                            {
                                                "example_id": "e971cb8a-d7dd-46e3-9899-11fb6a98ee0f",
                                                "sense_id": "7b592061-eff2-34b1-a81e-d3b6dfd0fb14",
                                                "text": "Бедный студент Широ и его порочный демонический друг Тамура сбивают ночью на дороге пьяного якудзу и скрываются с места преступления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fda7c96-142d-3688-b7d1-ff515ac7ba7e",
                                        "entry_id": "8d2c8a50-8ca2-349c-aad7-6f106dbb281f",
                                        "glosses": [
                                            "собир. общее название таких групп"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730fa953-53b6-4a45-88f8-0bfcae85b887",
                                                "sense_id": "4fda7c96-142d-3688-b7d1-ff515ac7ba7e",
                                                "text": "В «Точке кипения» хилый механик с автозаправки, преодолев робость, схлестнулся с якудзой."
                                            },
                                            {
                                                "example_id": "465ca6c0-0773-4511-b7f3-c10596bf7ef8",
                                                "sense_id": "4fda7c96-142d-3688-b7d1-ff515ac7ba7e",
                                                "text": "Восток есть Восток: даже разборки японских якудза выглядят полуфилософским занятием, если снимал их Такаси Исии .."
                                            },
                                            {
                                                "example_id": "bdbb6e44-cec9-4577-acc1-1cf2d1808d1c",
                                                "sense_id": "4fda7c96-142d-3688-b7d1-ff515ac7ba7e",
                                                "text": "К нему, большому рослому иностранцу с татуировками на руках, японцы сразу отнеслись с подозрением, ведь татуировки в Японии — признак якудза, японской мафии."
                                            },
                                            {
                                                "example_id": "aa4c0588-66af-481a-9ec4-0c257563c4dd",
                                                "sense_id": "4fda7c96-142d-3688-b7d1-ff515ac7ba7e",
                                                "text": "Это напомнило японцам о землетрясении 1995 года в Кобе, когда во многие разрушенные стихией районы члены якудза сумели добраться быстрее официальной помощи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07011176-ecd8-34af-abed-86519a50def1",
                                        "entry_id": "8d2c8a50-8ca2-349c-aad7-6f106dbb281f",
                                        "glosses": [
                                            "кино жанр японских гангстерских боевиков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c55d34-8590-4d6f-b6ec-177920b38fe2",
                                                "sense_id": "07011176-ecd8-34af-abed-86519a50def1",
                                                "text": "Жанры «эро» и «якудза» оказались на переднем плане. ❬…❭ «Якудза» ― это как раз те фильмы из бандитского быта, о которых упоминали когда-то Ильф и Петров, рассказывая о четырёх стандартах Голливуда .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
