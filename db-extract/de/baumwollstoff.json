                                        "sense_id": "671e37cc-8657-3083-adb8-689febdeadc6",
                                        "entry_id": "e059d740-570c-3487-8239-8ebaa77e7639",
                                        "glosses": [
                                            "A kind of light cotton or linen fabric, often woven in openwork patterns, used for curtains, etc,."
                                        ],
                                        "tags": [
                                            "countable",
