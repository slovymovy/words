                                                "sense_id": "b83dfadb-6070-3e9f-8bd5-5dd42dee8346",
                                                "text": "一個很成功的人"
                                            },
                                            {
                                                "example_id": "96da5dbe-32f2-4d56-abf8-55e9f4e598ae",
                                                "sense_id": "b83dfadb-6070-3e9f-8bd5-5dd42dee8346",
                                                "text": "一个很成功的人"
                                            },
                                            {
                                                "example_id": "5aa2d73a-dd86-4c22-947b-6723469d09af",
                                                "sense_id": "b83dfadb-6070-3e9f-8bd5-5dd42dee8346",
                                                "text": "他成功獲得哈佛大學獎學金，前往美國深造。"
                                            },
                                            {
                                                "example_id": "007e5bfe-95ff-4f6d-8064-65d9f5be9649",
                                                "sense_id": "b83dfadb-6070-3e9f-8bd5-5dd42dee8346",
                                                "text": "他成功获得哈佛大学奖学金，前往美国深造。"
                                            }
                                        ]
                                    }
                                ]
                            },
