                "forms": [],
                "senses": [
                    {
                        "sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                        "entry_id": "6b2c2733-7c92-3b00-9785-bd8d2c824379",
                        "glosses": [
                            "Avec finesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aacca9f-91c7-4083-b9fc-cc85f66cc490",
                                "sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                                "text": "Corselet transversal, arrondi et bordé latéralement, très-fortement ponctué sur les bords, plus lisse et finement ponctué au milieu, où il est marqué d'une ligne longitudinale : […]."
                            },
                            {
                                "example_id": "df9649a4-e8ba-47b1-91ad-52a8b2babb00",
                                "sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                                "text": "L’involucre, cette collerette de bractées finement découpées qui entourent l’inflorescence chez certaines espèces, chez les ombellifères en particulier, ne constitue jamais, comme chez la nigelle de Damas, l’attrait principal de la plante."
                            },
                            {
                                "example_id": "dc94824d-01a3-4d51-a9ff-62b0ed06c2cc",
                                "sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                                "text": "Marcas s'arrêta devant un présentoir rempli d'accessoires SM et prit une paire de menottes, finement cloutées à l'intérieur. Il secoua la tête en souriant.\n— Ce n'est pas le modèle homologué par la police nationale, chère madame."
                            },
                            {
                                "example_id": "22a16402-bc37-4b11-9664-6a5a867ab588",
                                "sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                                "text": "— As-tu toujours réponse à tout, Jonah ? s'enquit le marchand.\n— Je m'y efforce, monseigneur. Vous êtes mon modèle..., répondit finement le secrétaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "873274ac-07ba-4c0d-bc71-a68f5c2a21a8",
                        "source_entry_id": "6b2c2733-7c92-3b00-9785-bd8d2c824379",
                        "source_sense_id": "38a399ec-29b5-31eb-8461-3f4416b283ce",
                        "target_lang_word": "finely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c74e4153-2616-3fc4-a3ec-0260ce112ad0",
                                        "entry_id": "eb067659-218c-3529-893b-a66bb54f99fb",
                                        "glosses": [
                                            "So as to produce a fine texture; into small, thin, or delicate pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221f4365-190f-4063-a243-63ad6fa67619",
                                                "sense_id": "c74e4153-2616-3fc4-a3ec-0260ce112ad0",
                                                "text": "Fledglings can only be fed finely chopped meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                        "entry_id": "eb067659-218c-3529-893b-a66bb54f99fb",
                                        "glosses": [
                                            "In a fine, handsome or attractive way; very well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7072d13a-4e5b-4170-a92e-862be776818c",
                                                "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                                "text": "This girl could not be above eighteen: her face regular and sweet-featur'd, her shape exquisite; nor could I help envying her two ripe enchanting breasts, finely plump'd out in flesh",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "13e7ccf4-cc60-4598-856c-e2fb22b24fa7",
                                                "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                                "text": "Looking back, Yewdale Crag stands finely over the waterhead; Brantwood is opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
