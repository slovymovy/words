                "senses": [
                    {
                        "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                        "entry_id": "cea0257b-42f5-31c8-ab07-388b162a128f",
                        "glosses": [
                            "Incessant; never slackening."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743b3a4d-e3c4-4e80-a221-55a69246096f",
                                "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                                "text": "These thoughts supported my spirits, while I pursued my undertaking with unremitting ardour."
                            },
                            {
                                "example_id": "33e551f0-e60d-4583-82d5-ffaae638f315",
                                "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                                "text": "1961: J. A. Philip. Mimesis in the Sophistês of Plato. In: Proceedings and Transactions of the American Philological Association 92. p. 467.\nWe can achieve this god‐likeness only by unremitting and strenuous effort of the intellect."
                            },
                            {
                                "example_id": "224f36d8-c73e-4fe5-9a63-fd0dc49e8be3",
                                "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                                "text": "The human life span will be extended to 200 years, but the last 150 will be spent in unremitting pain and sadness."
                            },
                            {
                                "example_id": "6935e14e-3ec2-4ca9-a0c5-6a5baa86b632",
                                "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                                "text": "In fact, eighteenth-century British erotica has been the subject of unremitting attention for the last two decades."
                            },
                            {
                                "example_id": "000cb7e8-03dd-4053-9cc6-6adc66a9dc42",
                                "sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                                "text": "\"To meet the ambitions set-out by the Williams-Shapps Plan for Rail, we need to have an unremitting focus upon sustainable delivery, innovation and collaboration. [...].\""
                            }
                        ]
                    }
                ],
