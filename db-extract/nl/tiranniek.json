                    }
                ],
                "senses": [
                    {
                        "sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                        "entry_id": "5ffcb768-27ae-3faf-afc0-d14704626e62",
                        "glosses": [
                            "als passend bij een alleenheerser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c683764-56d8-4f27-83c7-711e971ecf4c",
                                "sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                                "text": "Een combinatie van geheugenverlies en bewuste misleiding doen zowel kijker als dokter twijfelen aan wat ‘waarheid’ nu precies is. We krijgen verhalen over misbruik in het gekkenhuis, over een tirannieke vader, over fout afgelopen abortussen, over ziekte, kots en dood in de buik van een op hol geslagen schip, over vrouwen die vastzitten in de onderste lagen van de maatschappij en hopen op beter."
                            },
                            {
                                "example_id": "06f4f208-a68c-4600-99dc-a69dd22bf22a",
                                "sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                                "text": "Het kunstwerk, vervaardigd uit groen en rood porfier, serpentijn en glas, deed dienst als decoratie op een van de schepen van de extravagante en tirannieke Romeinse keizer Caligula."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89576963-99f3-4195-91c5-3b5113ebb404",
                        "source_entry_id": "5ffcb768-27ae-3faf-afc0-d14704626e62",
                        "source_sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                        "target_lang_word": "tyrannical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "259439ae-f5c9-3c96-a3b6-119e0e492e15",
                                        "entry_id": "0df873d8-dc3b-3bde-ad35-55c5ed6b8cbd",
                                        "glosses": [
                                            "Of, or relating to tyranny or a tyrant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6970a799-84a3-3747-9c79-9a77334ae39d",
                                        "entry_id": "0df873d8-dc3b-3bde-ad35-55c5ed6b8cbd",
                                        "glosses": [
                                            "Despotic, oppressive, or authoritarian."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a326092e-166b-4902-b327-8fe72740e1af",
                                                "sense_id": "6970a799-84a3-3747-9c79-9a77334ae39d",
                                                "text": "a tyrannical regime"
                                            },
                                            {
                                                "example_id": "5fccca62-fb06-4c20-b952-8fced97140de",
                                                "sense_id": "6970a799-84a3-3747-9c79-9a77334ae39d",
                                                "text": "tyrannical rulers"
                                            },
                                            {
                                                "example_id": "d7fdcb39-22ba-4898-ab4c-5ed132a85e44",
                                                "sense_id": "6970a799-84a3-3747-9c79-9a77334ae39d",
                                                "text": "She met more than a quarter of all the American presidents who have ever lived, five popes, hundreds of national leaders, from the saintly, such as Nelson Mandela, to the tyrannical, including Robert Mugabe and Nicolae Ceausescu[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f49a8de-c4c7-4793-8ad4-42cb30ce80cb",
                        "source_entry_id": "5ffcb768-27ae-3faf-afc0-d14704626e62",
                        "source_sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                        "target_lang_word": "tyrannous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f998636d-8fa8-36db-be63-2fa7292f5fde",
                                        "entry_id": "8d85a8b5-1196-343e-94cd-09c7c7ece851",
                                        "glosses": [
                                            "Tyrannical, despotic or oppressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c8ff65-524d-438b-96ac-fb8cba6d96f6",
                                                "sense_id": "f998636d-8fa8-36db-be63-2fa7292f5fde",
                                                "text": "[…] that Elfe,\nThat man and beast with powre imperious\nSubdeweth to his kingdome tyrannous:"
                                            },
                                            {
                                                "example_id": "fcc6b5d8-2c32-4dc9-89d9-fee7ec4a3ec0",
                                                "sense_id": "f998636d-8fa8-36db-be63-2fa7292f5fde",
                                                "text": "Yield up, O love, thy crown and hearted throne\nTo tyrannous hate!"
                                            },
                                            {
                                                "example_id": "9f7dc7cc-22b3-4d95-b51f-be154d6cc724",
                                                "sense_id": "f998636d-8fa8-36db-be63-2fa7292f5fde",
                                                "text": "It is extraordinary that as the wicked arts of this regicide and tyrannous faction increase in number, variety, and atrocity, the desire of punishing them becomes more and more faint […]"
                                            },
                                            {
                                                "example_id": "add5b727-e2e8-4503-86cd-ca79592e20cb",
                                                "sense_id": "f998636d-8fa8-36db-be63-2fa7292f5fde",
                                                "text": "As life wears on and finds no rest,\nThe individual in each breast\nIs tyrannous to sunder them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb9c248-9d6e-4dce-9e3b-2e67321b2ae6",
                        "source_entry_id": "5ffcb768-27ae-3faf-afc0-d14704626e62",
                        "source_sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                        "target_lang_word": "tyrannic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb51499-a3ed-3cee-a0ca-8b906650d8a7",
                                        "entry_id": "e267fb40-5a95-3f7c-9971-edea6f4f1106",
                                        "glosses": [
                                            "Tyrannical."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313c8037-e520-448f-a8c7-4be0c0412ce0",
                                                "sense_id": "2cb51499-a3ed-3cee-a0ca-8b906650d8a7",
                                                "text": "The meek intelligence of thoſe dear eyes / (Bleſt be the art that can immortalize, / The art that baffles time's tyrannic claim / To quench it) here ſhines on me ſtill the ſame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c6cc457-676f-45f9-b24e-f8be791d9482",
                        "source_entry_id": "5ffcb768-27ae-3faf-afc0-d14704626e62",
                        "source_sense_id": "b338967d-fd22-304c-9a45-fa1c2f313e62",
                        "target_lang_word": "despotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1701b9-5987-3c1b-8007-506f87db21d6",
                                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                                        "glosses": [
                                            "Of or pertaining to a despot or tyrant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493d7530-d103-4e43-8956-c5c13f45d1f6",
                                                "sense_id": "5a1701b9-5987-3c1b-8007-506f87db21d6",
                                                "text": "This despotic age of the empire ended in a revolt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34dd180d-a714-32ca-8f67-f042ae0f4270",
                                        "entry_id": "19f1b396-793f-302c-add4-55aeafecc7d0",
                                        "glosses": [
                                            "Acting or ruling as a despot, tyrannical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065692a4-86b8-4ea5-a513-a43015c20133",
                                                "sense_id": "34dd180d-a714-32ca-8f67-f042ae0f4270",
                                                "text": "The despotic king dissolved the parliament, and took personal control of the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
