                    {
                        "translation_id": "e9d40231-9b02-449a-aae5-3b989c99f412",
                        "source_entry_id": "f36fc75f-1656-347c-af4f-acbdb4f453a8",
                        "source_sense_description": "chaotic, without law or order",
                        "target_lang_word": "anarchisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea926c7-f3b3-3bac-b006-caae7ca288b0",
                                        "entry_id": "14cec88b-de70-3a74-9a85-06a7eaf85059",
                                        "glosses": [
                                            "dem Zustand der Anarchie entsprechend; ohne Herrschaftsordnung auskommend"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faec013b-a8c5-4a89-8802-57c4866b84f4",
                                                "sense_id": "7ea926c7-f3b3-3bac-b006-caae7ca288b0",
                                                "text": "Er entwirft hier die Theorie einer anarchischen Gesellschaft."
                                            },
                                            {
                                                "example_id": "bbe8da37-49be-4c95-ac20-a4c8bfe241ad",
                                                "sense_id": "7ea926c7-f3b3-3bac-b006-caae7ca288b0",
                                                "text": "Diese anarchische Gesellschaft hat sich seit der frühen Neuzeit in Europa herausgebildet und umfasst mittlerweile die ganze Welt."
                                            },
                                            {
                                                "example_id": "442b581b-cd02-4a40-b1ea-c0baec1e9a4a",
                                                "sense_id": "7ea926c7-f3b3-3bac-b006-caae7ca288b0",
                                                "text": "Edgar wird in ein System jenseits der Systeme eingeführt, eine anarchische Gemeinschaft im Schatten der Sicherheitszone."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "282faff1-878c-317e-892e-f731cb4699ac",
                                        "entry_id": "14cec88b-de70-3a74-9a85-06a7eaf85059",
                                        "glosses": [
                                            "aus dem Fehlen einer gesetzlichen Ordnung resultierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ee0546-512a-4f86-b4d9-cbec4cfa4c67",
                                                "sense_id": "282faff1-878c-317e-892e-f731cb4699ac",
                                                "text": "Im Jahre 1017 erreichten sie Unteritalien, wo zu dieser Zeit praktisch anarchische Zustände herrschten."
                                            },
                                            {
                                                "example_id": "38295aed-8167-45e2-8017-37d6ba9efa2e",
                                                "sense_id": "282faff1-878c-317e-892e-f731cb4699ac",
                                                "text": "In einigen Katastrophengebieten der Insel Leyte haben am Mittwoch fast anarchische Zustände geherrscht: Im Dorf Abucay nahe der fast völlig zerstörten Stadt Tacloban lieferten sich Sicherheitskräfte Feuergefechte mit Plünderern."
                                            },
                                            {
                                                "example_id": "a721952a-81a2-4d9a-8d41-2401ffd2ea30",
                                                "sense_id": "282faff1-878c-317e-892e-f731cb4699ac",
                                                "text": "Die anarchische Wirkkraft der Gelblinge ist gefürchtet: Im Mai 2008 diskutieren die venezolanischen Behörden ein Sendeverbot."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
