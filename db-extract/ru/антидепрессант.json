                "translations": [
                    {
                        "translation_id": "6419655e-fa53-4f03-a35f-d6ec276013b8",
                        "source_entry_id": "34129f2f-dc83-3888-a527-46d900bbe9d3",
                        "source_sense_id": "6d07cb13-1a3b-3dc4-a49f-eecc9268cd98",
                        "target_lang_word": "antidepressant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidepressant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                        "entry_id": "9cd047d5-d0fd-38f4-808b-3871dd432e08",
                                        "glosses": [
                                            "An agent that prevents or counteracts depression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cffa35b5-61bc-4449-be4b-428f381c8962",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "Some women with postpartum depression and thyroid imbalance may require antidepressants and psychiatric therapy."
                                            },
                                            {
                                                "example_id": "c1500701-868b-4239-bcd7-cd0166b0ece0",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "She had a history of depression and was taking phenelzine, an antidepressant."
                                            },
                                            {
                                                "example_id": "d5697c9e-cf7f-451d-82a3-8ec3e398d6ea",
                                                "sense_id": "fcf6578d-3dc2-395e-8cbf-9fa9593cf492",
                                                "text": "Dr. Melanie met with Annabelle and delivered her diagnosis: Benny was in the prodromal phase of schizoaffective disorder, and she was recommending that they stop the Ritalin and start him on an antidepressant for the mood disorder and an antipsychotic to treat the auditory hallucinations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidepressant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8bdbc02-efd7-3e7b-ab65-1d80c34641c6",
                                        "entry_id": "f058169c-1c97-339e-9bf2-cbc803a0d1d2",
                                        "glosses": [
                                            "Preventing or counteracting depression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc87d17a-6b50-4327-8dfa-0db3418b45ed",
                        "source_entry_id": "34129f2f-dc83-3888-a527-46d900bbe9d3",
                        "source_sense_id": "6d07cb13-1a3b-3dc4-a49f-eecc9268cd98",
                        "target_lang_word": "Antidepressivum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antidepressivum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                        "entry_id": "dae27eab-2fe8-31f7-babf-e613c1e5c12c",
                                        "glosses": [
                                            "Medikament gegen Depressionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8f2de9-b9a6-40e7-a35b-df97722696c0",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "Ein depressiver Patient muss sein Antidepressivum auch dann einnehmen, wenn es ihm besser geht."
                                            },
                                            {
                                                "example_id": "a7100348-b444-4dcc-a921-bc5c09ff6d48",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Die Deutschen schlucken denn auch doppelt so viele Antidepressiva wie noch vor zehn Jahren.“"
                                            },
                                            {
                                                "example_id": "348869a8-bff2-437e-a5fa-ce3f3684c8d3",
                                                "sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a26b8394-0676-430b-ac0c-39541421897f",
                        "source_entry_id": "34129f2f-dc83-3888-a527-46d900bbe9d3",
                        "source_sense_id": "6d07cb13-1a3b-3dc4-a49f-eecc9268cd98",
