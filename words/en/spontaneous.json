{
    "word_family": [
        "spontaneity",
        "spontaneously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d70de168-41f8-3a4d-b8d8-c9dd7a51e2da",
                    "sense_definition": "Done by one's own free choice or without prior planning.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unplanned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They made a <w>spontaneous</w> decision to travel across the country for the weekend.",
                            "target_lang_translations": {
                                "zh": "他们<w>一时兴起</w>，决定周末横穿全国去旅行。"
                            }
                        },
                        {
                            "text": "The <w>spontaneous</w> applause from the audience showed how much they enjoyed the performance.",
                            "target_lang_translations": {
                                "zh": "观众席上响起的<w>自发</w>掌声表明他们有多喜欢这场演出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impulsive",
                        "unplanned",
                        "impromptu"
                    ],
                    "antonyms": [
                        "planned"
                    ],
                    "common_phrases": [
                        "spontaneous decision",
                        "spontaneous applause"
                    ],
                    "target_lang_definitions": {
                        "zh": "出自自愿或未做事先计划的；自发的，即兴的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自发的",
                                "target_lang_sense_clarification": "出于本能或自愿，非勉强或策划"
                            },
                            {
                                "target_lang_word": "即兴的",
                                "target_lang_sense_clarification": "没有事先准备的，临时决定的"
                            },
                            {
                                "target_lang_word": "一时冲动的",
                                "target_lang_sense_clarification": "未加思索、临时起意的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b55e9381-1ced-309f-b3a4-15fceaef2443",
                    "sense_definition": "Happening suddenly and without warning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd broke into <w>spontaneous</w> applause when the results were announced.",
                            "target_lang_translations": {
                                "zh": "结果宣布时，人群中爆发出了<w>自发的</w>掌声。"
                            }
                        },
                        {
                            "text": "Her <w>spontaneous</w> decision to leave the party surprised all of her friends.",
                            "target_lang_translations": {
                                "zh": "她<w>突然</w>决定离开聚会，让所有的朋友都很惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sudden",
                        "abrupt"
                    ],
                    "common_phrases": [
                        "spontaneous change",
                        "spontaneous movement"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然且毫无预警发生的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自发的",
                                "target_lang_sense_clarification": "情不自禁、自然而然突然发生的"
                            },
                            {
                                "target_lang_word": "突发的",
                                "target_lang_sense_clarification": "突然发生、毫无先兆的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "122a2cf3-75a9-3ce7-9337-f024f9847a35",
                    "sense_definition": "Proceeding from natural feeling or native tendency without external constraint.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "natural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>spontaneous</w> laughter revealed her genuine happiness during the conversation.",
                            "target_lang_translations": {
                                "zh": "交谈中她那<w>发自内心</w>的笑声流露出真切的快乐。"
                            }
                        },
                        {
                            "text": "The child showed a <w>spontaneous</w> interest in the colorful flowers in the garden.",
                            "target_lang_translations": {
                                "zh": "那个孩子对花园里色彩缤纷的花朵表现出了<w>自然的</w>兴趣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spontaneous laughter",
                        "spontaneous interest"
                    ],
                    "target_lang_definitions": {
                        "zh": "出自天然情感或天性，非受外力强加的；自然的，真情流露的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自然的",
                                "target_lang_sense_clarification": "流于天性、不做作的"
                            },
                            {
                                "target_lang_word": "由衷的",
                                "target_lang_sense_clarification": "出自内心真情实感的"
                            },
                            {
                                "target_lang_word": "自发的",
                                "target_lang_sense_clarification": "源自内部情感倾向的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46204dc5-fc08-3033-8b22-993ed0cfa3ba",
                    "sense_definition": "Produced naturally without human cultivation or labor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "natural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was filled with <w>spontaneous</w> vegetation that grew without any human help.",
                            "target_lang_translations": {
                                "zh": "森林里到处都是在没有任何人工干预下生长的<w>自生</w>植物。"
                            }
                        },
                        {
                            "text": "They gathered <w>spontaneous</w> fruits found growing wild along the edge of the woods.",
                            "target_lang_translations": {
                                "zh": "他们采集了林缘自然生长的<w>野生</w>浆果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spontaneous vegetation",
                        "spontaneous fruits"
                    ],
                    "target_lang_definitions": {
                        "zh": "（植物等）自然生长而非人工培育的；野生的，自生的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "自生的",
                                "target_lang_sense_clarification": "自然孕育而生的"
                            },
                            {
                                "target_lang_word": "野生的",
                                "target_lang_sense_clarification": "未经人工培植的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}