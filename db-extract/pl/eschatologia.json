                "senses": [
                    {
                        "sense_id": "354cd98a-3ab2-347a-b89f-675ab6feb82e",
                        "entry_id": "868604b0-4d46-34ea-a087-f12afc850ad3",
                        "glosses": [
                            "dział teologii i filozofii dotyczący spraw ostatecznych: śmierci, końca świata, życia pozagrobowego, rodzajów sądu pośmiertnego, świata zmarłych itp."
