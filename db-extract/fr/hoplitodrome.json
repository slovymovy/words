                        "glosses": [
                            "Coureur couvert d’une armure qui, dans les jeux publics, disputait le prix de la course."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "395fbac1-980d-4fad-b190-26c98ff62544",
                                "sense_id": "47a5a3ee-7758-3929-8589-5064b055894b",
                                "text": "Coureur simple ou « hoplitodrome » , coureur en armes : l’attitude est la même, avec le bras droit tendu, tirant l’épaule vers l’avant."
                            },
                            {
                                "example_id": "96f2777a-53d1-46fa-9930-3a4188c67739",
                                "sense_id": "47a5a3ee-7758-3929-8589-5064b055894b",
                                "text": "La course des hoplitodromes avoit toujours fait partie des jeux néméens ; mais ils ne furent admis aux olympiques que dans la soixante-cinquieme olympiade."
                            }
                        ]
                    }
