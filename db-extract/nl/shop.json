                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "707d801b-5b78-4b75-bf97-d5cafdd8f58c",
                        "source_entry_id": "3b63cb32-47b5-3456-9214-60d7ab105118",
                        "source_sense_id": "cc26cf11-0e81-32f0-9a7b-28bc7affc5b2",
