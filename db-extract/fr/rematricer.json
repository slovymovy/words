                "senses": [
                    {
                        "sense_id": "0a574ac6-fe57-3c6e-8ab3-61b00ac7ef24",
                        "entry_id": "f1286835-5872-3c99-9d01-97026901d7b0",
                        "glosses": [
                            "Refaire la matrice d’un enregistrement, numériquement à partir d’un original, afin d’en améliorer la qualité."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "588ce822-f3c1-4aa4-addb-09c4be1e0976",
                                "sense_id": "0a574ac6-fe57-3c6e-8ab3-61b00ac7ef24",
                                "text": "Bref, des fois quand j'entends certains trucs je préfère limite repasser en stéréo et laisser l'ampli rematricer derrière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b26ff22f-b57a-45d2-99ee-03f2056a3dd9",
