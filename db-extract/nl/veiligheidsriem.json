                    {
                        "sense_id": "4c155730-ba27-3f43-8c2d-8addea64a7f3",
                        "entry_id": "cba1e703-ee80-320b-8129-bd28208bebac",
                        "glosses": [
                            "twee banden van sterk weefsel met een sluiting die iemand in een veilige positie vast te houden bij een botsing of sterke vertraging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ebf8f6-1342-4a30-86ef-6541614b60b2",
                                "sense_id": "4c155730-ba27-3f43-8c2d-8addea64a7f3",
                                "text": "Maak uw veiligheidsriem vast en zet uw stoel rechtop."
                            },
                            {
                                "example_id": "45d74143-af21-4e7a-8372-fc3c0c4a59db",
                                "sense_id": "4c155730-ba27-3f43-8c2d-8addea64a7f3",
                                "text": "Het overgrote deel van vliegtuigongevallen gebeurt tijdens start of landing. De snelheden zijn dan vergelijkbaar met die van snelle auto’s. De overlevingskans is heel behoorlijk, mits de veiligheidsriem wordt gedragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7543be9f-5dfa-3c79-b6bb-e782e0b30562",
                        "entry_id": "cba1e703-ee80-320b-8129-bd28208bebac",
                        "glosses": [
                            "band van sterk weefsel om iemand in een veilige positie vast te houden bij een botsing of sterke vertraging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09af9581-cd10-4704-85dc-3422cafe21ec",
                                "sense_id": "7543be9f-5dfa-3c79-b6bb-e782e0b30562",
                                "text": "Zijn auto is ‘een hermetisch afgesloten ruimte waarbinnen alles is wat het is en blijft wat het is, voor nu en altijd: de hendels en knopjes, de lampjes naast de snelheidsmeter, het zwart van de veiligheidsriem schuin over mijn bollende buik’ (…)."
                            }
                        ]
