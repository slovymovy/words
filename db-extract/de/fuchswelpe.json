                                            {
                                                "example_id": "0c13cb87-904c-4627-aad8-59f3d1167b83",
                                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                                                "text": "Deux renardeaux s’affrontent sur l’herbe, sous une sublime lumière de fin de journée."
                                            },
                                            {
                                                "example_id": "2dee2dbe-a310-45b5-8b5a-fcf8ec7cef3b",
                                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
                                                "text": "Un petit ampède s’amuse d’un renardeau en venant se poser sur son museau."
                                            },
                                            {
                                                "example_id": "ff277bd8-5f39-4076-9e2e-c31c8f881787",
                                                "sense_id": "e0206379-6011-3ed3-a66c-c7f54cead30f",
