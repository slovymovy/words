                ],
                "senses": [
                    {
                        "sense_id": "e274270a-896f-38b4-b8a8-e06505e91aeb",
                        "entry_id": "7fd925de-3ecc-34e8-aff8-6121c5cedc68",
                        "glosses": [
                            "разг. жаловаться, сетовать (на кого-либо, что-либо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95d8448-2f30-4c16-b3db-832c2d188ddb",
                                "sense_id": "e274270a-896f-38b4-b8a8-e06505e91aeb",
                                "text": "— \"Милостивый государь, — отвечала я ему очень учтиво, — я нимало не думаю пенять на свою судьбу и очень довольна своим состоянием; а потому-то и ваше сожаление очень не у места."
                            },
                            {
                                "example_id": "b6fa7035-dae5-4c27-bd8b-80626c502975",
                                "sense_id": "e274270a-896f-38b4-b8a8-e06505e91aeb",
                                "text": "Того и гляди придется пенять отцу и матери, зачем на свет родили!"
                            }
                        ]
                    },
                    {
                        "sense_id": "cc56e1ec-21b4-3b16-8292-89872772d23d",
                        "entry_id": "7fd925de-3ecc-34e8-aff8-6121c5cedc68",
                        "glosses": [
                            "выговаривать, выражать недовольство по поводу чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3f05c7-fe41-49b3-9d74-aa26c2ef4362",
                                "sense_id": "cc56e1ec-21b4-3b16-8292-89872772d23d",
                                "text": "Старик заходил ко мне и пенял мне, зачем я позабыл их."
                            },
                            {
                                "example_id": "48b01217-ddd4-47dc-a439-88a36cd2e620",
                                "sense_id": "cc56e1ec-21b4-3b16-8292-89872772d23d",
                                "text": "Мало-по-малу приучился я сидеть один у себя дома. Василиса Егоровна сначала за то мне пеняла, но видя мое упрямство, оставила меня в покое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98e40971-37ab-48e3-8876-a5472acd53fa",
                        "source_entry_id": "7fd925de-3ecc-34e8-aff8-6121c5cedc68",
                        "target_lang_word": "blame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56517be5-7350-351a-8fdf-60661ed15d68",
                                        "entry_id": "7268fe96-5513-3806-a58e-a47aa1e4f0d2",
                                        "glosses": [
                                            "Censure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60bd7848-0f54-4405-b48b-971f128e8943",
                                                "sense_id": "56517be5-7350-351a-8fdf-60661ed15d68",
                                                "text": "Blame came from all directions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90ecd7f-9c16-31ed-bf9b-aaa1dc1a4119",
                                        "entry_id": "7268fe96-5513-3806-a58e-a47aa1e4f0d2",
                                        "glosses": [
                                            "Culpability for something negative or undesirable."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8293143c-6040-424a-bf04-79b0ff0a7603",
                                                "sense_id": "b90ecd7f-9c16-31ed-bf9b-aaa1dc1a4119",
                                                "text": "The blame for starting the fire lies with the arsonist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37102bc-3ede-3367-8396-21b23b1657f3",
                                        "entry_id": "7268fe96-5513-3806-a58e-a47aa1e4f0d2",
                                        "glosses": [
                                            "Responsibility for something meriting censure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1dc38e4-8528-43e3-ab4e-a53e06c9b351",
                                                "sense_id": "a37102bc-3ede-3367-8396-21b23b1657f3",
                                                "text": "They accepted the blame, but it was an accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc929a39-b026-32aa-8574-874c3a4f1ce1",
                                        "entry_id": "7268fe96-5513-3806-a58e-a47aa1e4f0d2",
                                        "glosses": [
                                            "A source control feature that can show which user was responsible for a particular portion of the source code."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                                        "entry_id": "9c65897d-c7a2-3b37-82df-50ec6be4f104",
                                        "glosses": [
                                            "To assert or consider that someone is the cause of something negative; to place blame; to attribute responsibility (for something negative or for doing something negative)."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "564d04fc-b04c-4345-9328-378fd9509e40",
                                                "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                                                "text": "The student driver was blamed for the accident."
                                            },
                                            {
                                                "example_id": "0c22df94-5dc4-4552-a4d3-63d7dab8ddb5",
                                                "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                                                "text": "After what happened at the wedding, I wouldn't blame you if you never spoke to them again."
                                            },
                                            {
                                                "example_id": "9e0ab058-a17e-4e55-8e57-e5a62ab3a7da",
                                                "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                                                "text": "These peculiarities of Dorothea's character caused Mr Brooke to be all the more blamed in neighbouring families for not securing some middle-aged lady as guide and companion to his nieces."
                                            },
                                            {
                                                "example_id": "25c80b92-dfc5-4af1-aa2a-d1efcf10faac",
                                                "sense_id": "bd38b496-84f5-3e4c-88fc-a57dcfa8ea9e",
                                                "text": "That was the year that Sir Richard was writing his volume on Domestic Life in Tartary. The critics all blamed it for a lack of concentration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e598cff0-a639-32f2-acca-95f12f834416",
                                        "entry_id": "9c65897d-c7a2-3b37-82df-50ec6be4f104",
                                        "glosses": [
                                            "To assert the cause of some bad event."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7308cca-d8de-49d6-aaca-b3e3ab7d3c47",
                                                "sense_id": "e598cff0-a639-32f2-acca-95f12f834416",
                                                "text": "We blamed the accident on the student driver."
                                            },
                                            {
                                                "example_id": "57dfa6a7-74ae-437c-bd75-fc466cffee93",
                                                "sense_id": "e598cff0-a639-32f2-acca-95f12f834416",
                                                "text": "Have to catch an early train, got to be to work by nine\nAnd if I had an airplane, I still couldn't make it on time\n'Cause it takes me so long just to figure out what I'm gonna wear\nBlame it on the train, but the boss is already there"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6d90bb-38a7-35b3-86e1-e208f90cabf1",
                                        "entry_id": "9c65897d-c7a2-3b37-82df-50ec6be4f104",
                                        "glosses": [
                                            "To censure (someone or something); to criticize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d8bece-a2a8-4bf0-9219-aee475f51aaf",
                                                "sense_id": "8f6d90bb-38a7-35b3-86e1-e208f90cabf1",
                                                "text": "though my loue be not so lewdly bent, / As those ye blame, yet may it nought appease / My raging smart [...]."
                                            },
                                            {
                                                "example_id": "6f927906-a862-452a-b26c-e048cf10f283",
                                                "sense_id": "8f6d90bb-38a7-35b3-86e1-e208f90cabf1",
                                                "text": "I covered the serious programmes too, and indeed, right from the start, I spent more time praising than blaming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a71cb6-5e67-33dd-b7d4-c5535ca32b18",
                                        "entry_id": "9c65897d-c7a2-3b37-82df-50ec6be4f104",
                                        "glosses": [
                                            "To bring into disrepute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de225ba1-5be3-4f95-8d62-a79810607078",
                                                "sense_id": "c1a71cb6-5e67-33dd-b7d4-c5535ca32b18",
                                                "text": "For knighthoods loue, do not so foule a deed, / Ne blame your honour with so shamefull vaunt / Of vile reuenge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b2bffe-be15-3c81-be38-4c29e253ee0c",
                                        "entry_id": "5cd9684e-497a-3c9e-b407-071abd883bc0",
                                        "glosses": [
                                            "euphemism of damn (intensifier)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36f2fac-3d20-4457-8130-72383339643f",
                                                "sense_id": "c2b2bffe-be15-3c81-be38-4c29e253ee0c",
                                                "text": "\"He yarns good,\" said Tom Platt. \"T'other night he told us abaout a kid of his own size steerin' a cunnin' little rig an' four ponies up an' down Toledo, Ohio, I think 'twas, an' givin' suppers to a crowd o' sim'lar kids. Cur'us kind o' fairy-tale, but blame interestin'. He knows scores of 'em.\""
                                            },
                                            {
                                                "example_id": "50c04bc6-e302-4c7a-8287-dcd98818a97b",
                                                "sense_id": "c2b2bffe-be15-3c81-be38-4c29e253ee0c",
                                                "text": "“What do you want with one of those blame things?” / I asked him well beforehand. “Don’t you get one!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
