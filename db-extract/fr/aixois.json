                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4de35c4-f999-41c1-8428-fc051aa3d44b",
                                                "sense_id": "83945ce5-bcda-3bca-81e5-e128844369a1",
                                                "text": "Sind Sie etwa Aachener? – Ich bin Berliner."
                                            },
                                            {
                                                "example_id": "8a2a8f64-d47e-455e-ab3a-a8c44f64ab2a",
                                                "sense_id": "83945ce5-bcda-3bca-81e5-e128844369a1",
                                                "text": "„Die Aachener entscheiden an diesem Sonntag über den Bau einer umstrittenen Straßenbahn, der sogenannten Campusbahn.“"
