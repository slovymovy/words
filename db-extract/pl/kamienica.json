                        "examples": [
                            {
                                "example_id": "1077d150-ffb3-4c02-a1a2-c971d4a09890",
                                "sense_id": "a554d5f9-2dbd-31aa-888d-6d02ae9d8c98",
                                "text": "Późnym wieczorem król nareszcie znużony przypomniał o matce, a że ona już się była przeniosła do kamienicy ks. Fantoniego, udał się do niej.",
                                "translation": "Поздно вечером король вспомнил о матери, которая уже переехала в каменный дом ксендза Фантония, и отправился к ней."
                            }
                        ]
                    }
