                                                "example_id": "5a038a85-6c47-470f-9e74-cb3f8b534cc8",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Mom: Oh you stupid car! What's wrong with you now?!?\nCalvin: That's it, Mom! Go ahead and swear! We don't mind!"
                                            },
                                            {
                                                "example_id": "b07262c5-b593-4ed5-b2a3-64da5c0f7e3f",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Calvin, be quiet and eat the stupid lima beans."
                                            },
                                            {
                                                "example_id": "e87e7ca7-19e7-46fa-ac64-4f4fcde37902",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Dewey: \"It's too narrow for all three of us. Oh, bummer!\"\nHuey: \"Or we could just go single file.\"\nDewey: \"Stupid smart Huey...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9426cc5b-ac7a-3385-a69b-1aa12e6bd6fd",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "To the point of stupor."
