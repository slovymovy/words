                    {
                        "translation_id": "2d58f38a-9622-4b7d-a8df-fad935dab15f",
                        "source_entry_id": "b4bc0216-6cd0-32bd-97b6-3d7d89305e85",
                        "source_sense_id": "537bd276-0bb2-325a-86e9-4b4a7c8d225c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "interventionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interventionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94b68e51-1401-3cb0-b1d6-b397e8ac0fe2",
                                        "entry_id": "21ca393f-0bf9-32b8-a84e-251225861179",
                                        "glosses": [
                                            "Relatif à l’interventionnisme, partisan de l'interventionnisme en général ou d'une intervention dans un cas particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33f013b-83aa-499f-b214-5f1fb8f39997",
                                                "sense_id": "94b68e51-1401-3cb0-b1d6-b397e8ac0fe2",
                                                "text": "Sur l’intervention au Mali, l’opposition demandait un débat parlementaire qu’elle aurait certainement condamné au temps de Sarkozy et la gauche devient interventionniste alors qu’elle est plutôt pacifiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5255e38a-7081-4b44-9bc1-8d06ae3c8dad",
                        "source_entry_id": "b4bc0216-6cd0-32bd-97b6-3d7d89305e85",
                        "source_sense_id": "537bd276-0bb2-325a-86e9-4b4a7c8d225c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "interventionistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interventionistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3d85ac-aecc-33e8-8075-4117e3a04049",
                                        "entry_id": "af109c80-7a86-3f3e-8965-f64e126494a9",
                                        "glosses": [
                                            "den Interventionismus betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51087c46-8431-4e9e-bff5-6e76a9ac3ae1",
                                                "sense_id": "2f3d85ac-aecc-33e8-8075-4117e3a04049",
                                                "text": "Die Finanzkrise machte einen Strich durch seine Rechnung. Wirtschaftsliberalismus war auf einmal out. Seither wurstelt sich die Regierung mit Klientelpolitik en détail und interventionistischem Verbalradikalismus en gros durch."
                                            },
                                            {
                                                "example_id": "c3c1dddb-c889-43c1-877a-ce103bfa839b",
                                                "sense_id": "2f3d85ac-aecc-33e8-8075-4117e3a04049",
                                                "text": "Wir haben zwei Jahrzehnte einer interventionistischen Außenpolitik unter amerikanischer Führung hinter uns – vom Balkan über Afghanistan bis zum Irak."
                                            },
                                            {
                                                "example_id": "75046aae-6532-4992-a7a7-9f956f629c5c",
                                                "sense_id": "2f3d85ac-aecc-33e8-8075-4117e3a04049",
                                                "text": "Mehrere Mitgliedsstaaten, an vorderster Front Frankreich, haben sich unverhohlen der nationalen Dominanz einer interventionistisch orientierten Industriepolitik verschrieben und blockieren auch die intergouvernementale Zusammenarbeit der großen Industrienationen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c462eef-a8a1-4181-b73f-2c5a8c008d47",
                        "source_entry_id": "b4bc0216-6cd0-32bd-97b6-3d7d89305e85",
