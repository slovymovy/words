                "senses": [
                    {
                        "sense_id": "e7c0a4ff-93b2-3c9b-9859-be64e6175fea",
                        "entry_id": "512385da-c9e1-39a1-b20c-02634d98ea55",
                        "glosses": [
                            "спец. режущий инструмент, использующийся в технике резцовой гравюры и ксилографии; тонкий стальной стержень ромбовидного, клинообразного или полуовального сечения со срезанным концом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7479740-6117-45b2-9db5-b94e56f154f2",
                                "sense_id": "e7c0a4ff-93b2-3c9b-9859-be64e6175fea",
                                "text": "Потом я увлеклась цветной линогравюрой. Гравировала специальными инструментами ― штихелями по линолеуму."
                            }
                        ]
                    }
                ],
