                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cidden",
                                "target_lang_sense_clarification": "gerçekten, şakasız"
                            },
                            {
                                "target_lang_word": "şaka bir yana",
                                "target_lang_sense_clarification": "ciddi bir konuya geçerken"
                            },
                            {
                                "target_lang_word": "harbi",
                                "target_lang_sense_clarification": "samimi konuşma dili"
                            }
                        ]
                    }
                }
            ]
