                                    {
                                        "sense_id": "ad150d09-1f0c-3176-8368-d6d5306985c0",
                                        "entry_id": "f7544701-0e87-3779-b3ca-53e03ee6a814",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3cc2c3-440c-49ad-b827-98ee90e61aa4",
                                                "sense_id": "ad150d09-1f0c-3176-8368-d6d5306985c0",
                                                "text": "Barbarians-Tonga : la compo des Baa-Baas avec Coly titulaire et Hervé remplaçant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hervé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e01c146a-f1fa-3689-be97-cc4c3f67fd61",
                                        "entry_id": "d01f12c3-b6d8-3ec1-869b-218a92cc5c6e",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0288ce-2b0b-43fd-9c1e-d95d2ae84ed9",
                                                "sense_id": "e01c146a-f1fa-3689-be97-cc4c3f67fd61",
                                                "text": "Elle n’était cependant pas fâchée de devenir baronne et surtout châtelaine, mais elle aimait vraiment Hervé pour lui-même, et elle attendait avec impatience que le jour de son mariage fût fixé, […]."
                                            },
                                            {
                                                "example_id": "333b5a9d-7c3c-422c-94a7-df280790a6c1",
                                                "sense_id": "e01c146a-f1fa-3689-be97-cc4c3f67fd61",
                                                "text": "Laissons à Hervé Bourges — qui n’est pas le plus méchant envers l’institution, loin s’en faut — le soin de portraiturer les personnalités désignées pour y siéger."
                                            },
                                            {
                                                "example_id": "54444389-74d0-4d67-a555-6271d602e980",
                                                "sense_id": "e01c146a-f1fa-3689-be97-cc4c3f67fd61",
                                                "text": "Hervé Decambrais se présenta sur le pas de sa porte quelques minutes avant le début de la criée de huit heures trente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
