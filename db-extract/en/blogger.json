                                        "entry_id": "ed984fc7-c10c-35d4-bd1d-ce17293ec8a4",
                                        "glosses": [
                                            "Autrice d’un blogue, femme utilisant Internet comme un moyen de communication pour s’exprimer et diffuser de l’information sur différents sujets pour lesquels elle a une expertise ou une passion."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4455be58-3dca-43e5-ad6e-dc72bc904d09",
                                                "sense_id": "b8065eea-463e-3bc3-b6bc-5647d5e9f0cb",
                                                "text": "Veronika Belotserkovskaïa, blogueuse et autrice de plusieurs livres de cuisine qui vit en France, est accusée du même crime."
                                            },
                                            {
                                                "example_id": "48c96614-b333-456d-8218-f32223f420e4",
                                                "sense_id": "b8065eea-463e-3bc3-b6bc-5647d5e9f0cb",
                                                "text": "Lyse Petitjean est la fameuse blogueuse Yummix, blog le plus célèbre de la sphère Thermomix."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blogueuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24c46447-0e85-344f-aaef-0ca648b30286",
                                        "entry_id": "28ac8c35-9fae-341f-b55f-847619a3cf6f",
