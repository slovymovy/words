                ],
                "senses": [
                    {
                        "sense_id": "78eb3c0a-4d60-3d79-880c-e3fb863ffafa",
                        "entry_id": "19cef213-cde7-3cee-a07d-1bffaee35dd5",
                        "glosses": [
                            "вложение, размещение капитала с целью получения прибыли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f99ca2e-1f49-4e4f-aa56-b54d4e7e2f4e",
                                "sense_id": "78eb3c0a-4d60-3d79-880c-e3fb863ffafa",
                                "text": "Затраты на науку надо рассматривать как затраты на капиталовложения, так как в результате научной работы страна получит опыт и знания, которые могут быть использованы для культурного строительства, поднятия благополучия граждан и обороноспособности государства."
                            },
                            {
                                "example_id": "b29a24fb-6cd6-4dc9-917c-e8a4b0073ba6",
                                "sense_id": "78eb3c0a-4d60-3d79-880c-e3fb863ffafa",
                                "text": "Министерство экономического развития и торговли нашло способ повысить эффективность государственных капиталовложений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b31e76bc-5061-4c57-9646-83307a9407d1",
                        "source_entry_id": "19cef213-cde7-3cee-a07d-1bffaee35dd5",
                        "source_sense_id": "78eb3c0a-4d60-3d79-880c-e3fb863ffafa",
                        "target_lang_word": "investment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af667ac-0d7c-3ad1-8f22-cdb88c2f1f35",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "The act of investing, or state of being invested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0decc7e6-7191-4cb5-98c5-de59a30c8ba4",
                                                "sense_id": "7af667ac-0d7c-3ad1-8f22-cdb88c2f1f35",
                                                "text": "Giving your children a good education is a wise long-term investment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A placement of capital in expectation of deriving income or profit from its use or appreciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365efd08-79ee-40a0-9b6e-0f9bedabbcec",
                                                "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                                "text": "An investment in ink, paper, and steel pens."
                                            },
                                            {
                                                "example_id": "78de4469-1ecd-4d1c-bea3-9e9b1e4d9ea7",
                                                "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe.[…]The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b81535-9e7c-314c-9391-355b653911d5",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A vestment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6bb2ae8-b95e-40e3-ba9a-048333ba68e6",
                                                "sense_id": "77b81535-9e7c-314c-9391-355b653911d5",
                                                "text": "Whose white investments figure innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "The act of surrounding, blocking up, or besieging by an armed force, or the state of being so surrounded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "342032f4-07b8-4ba5-90e4-acb172c11a1e",
                                                "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                                "text": "the investment of the fort"
                                            },
                                            {
                                                "example_id": "37458221-a874-4c6a-8456-d49e7771053b",
                                                "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                                "text": "In 1858, the Governor of Kuangsi applied for his services, but the Viceroy Tsêng Kuo-fan, under whom he had served for a number of years and who recognised his value, declined to part with him. In 1860 he assisted in the defeat of the rebel reinforcements at the Hsiao-ch‘ih post station and took part in the capture of Taihu, investment of An-ch‘ing and destruction of the rebel camp at Linghu. For his services in the capture of Anch‘ing he was rewarded with the title of Baturu and placed on the list of Brigade Generals. He was next sent to Chihchow in Anhui to make reconnaissances of the country and occupy the commanding situations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df2e5fe-fa93-3e2e-bc43-ddc3b1b0be59",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A mixture of silica sand and plaster which, by surrounding a wax pattern, creates a negative mold of the form used for casting, among other metals, bronze."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
