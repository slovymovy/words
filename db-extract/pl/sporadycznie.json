                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b87e167-c3eb-44e7-bfe3-a00b1c6075d6",
                                "sense_id": "e44a3918-b822-322f-8dfd-2754f15f963c",
                                "text": "Nasz szef chwali pracowników tylko sporadycznie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05a0c268-c782-443f-bffd-d3b1d8df6242",
                        "source_entry_id": "289d261a-e0d2-375c-80e8-11953c009328",
                        "source_sense_id": "e44a3918-b822-322f-8dfd-2754f15f963c",
                        "target_lang_word": "sporadically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sporadically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0a76c88-9c11-3682-9b45-23835e5b5bc4",
                                        "entry_id": "ba22a20e-079b-3e68-b19f-3b55370dce81",
                                        "glosses": [
                                            "At an occasional, infrequent, or irregular frequency."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3799a50d-087a-40ad-a869-3caa9ceabce9",
                                                "sense_id": "b0a76c88-9c11-3682-9b45-23835e5b5bc4",
                                                "text": "Valencia threatened sporadically in the first half with Miguel having a decent effort deflected wide by Ashley Cole, while Jordi Alba's near-post cross was flicked into the sidenetting by Pablo Hernandez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f2ab1a-fdc3-4544-ae39-f91a0c10c9c0",
                        "source_entry_id": "289d261a-e0d2-375c-80e8-11953c009328",
                        "source_sense_id": "e44a3918-b822-322f-8dfd-2754f15f963c",
                        "target_lang_word": "hardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Barely, only just, almost not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbc64f0-0d04-413a-b6b4-2468c3defa70",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "They hardly ever watch television."
                                            },
                                            {
                                                "example_id": "4e11a184-c869-4af2-b2c4-b0277b6b3c42",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "It's hardly possible he could lose the election."
                                            },
                                            {
                                                "example_id": "7810b1da-8b27-4127-9763-96122912a36e",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "Hardly did I arrive when he left."
                                            },
                                            {
                                                "example_id": "533b1569-90de-4cd1-a4a6-4bf2defc40af",
                                                "sense_id": "f5fbc8ba-d20b-3d6b-95f6-3c109f9b046e",
                                                "text": "How lonely they looked as they lay there, and how ill assorted! That little heap had been for two thousand years the wisest, loveliest, proudest creature - I can hardly call her woman - in the whole universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Certainly not; not at all."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239a05e8-daf0-4811-8e4a-7fb0a5238309",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "I hardly think they'll come in this bad weather!"
                                            },
                                            {
                                                "example_id": "5f23d5ed-da99-4a7e-ba6f-c742279ddd91",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "With this the second of three games in seven days for Stoke, it was hardly surprising to see nine changes from the side that started against Newcastle in the Premier League on Monday."
                                            },
                                            {
                                                "example_id": "c60b62a6-7543-4485-b953-1b95ece74f36",
                                                "sense_id": "fb68ce87-0e3b-3a33-8b24-940d55e910fc",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "With difficulty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1103ead-7834-4756-a824-f6c230808372",
                                                "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                                "text": "And what gentle flame soever doth warme the heart of young virgins, yet are they hardly drawne to leave and forgoe their mothers, to betake them to their husbands […]."
                                            },
                                            {
                                                "example_id": "64307183-296b-44ff-b535-e97145a2f664",
                                                "sense_id": "f78af57f-df19-3828-8cbe-54699b3a4901",
                                                "text": "While in Chelsea, Anne Smiley pined, taking very hardly to her unaccustomed role of wife abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Harshly, severely; in a hard manner."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab45d19a-4c60-4cbd-98dd-162f9eb70963",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "I was a fool when I married him; and I am so far an incurable fool on that subject, that, for the sake of what I once believed him to be, I wouldn’t have even this shadow of my idle fancy hardly dealt with."
                                            },
                                            {
                                                "example_id": "6fb5a34d-bc80-4c7f-b537-ec782ea2de8b",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "\"Mr. Cholmondeley, the young men out here are much too hardly worked to allow them time for paying impertinent compliments.\""
                                            },
                                            {
                                                "example_id": "0cd6c1f5-4803-4860-becb-ebd0e79965ef",
                                                "sense_id": "1a4ffbbe-5bb3-37b6-b304-b4a53226c2ec",
                                                "text": "Only I wasn't at all pleased with that; I saw that he was simply sorry for me because I was so hardly treated by grandmother, and that was all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                        "entry_id": "ba34ebd5-3f92-33d5-85c1-bd9687de851f",
                                        "glosses": [
                                            "Firmly, vigorously, with strength or exertion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4d624d3-ffa4-49de-9f66-718a9c747d0e",
                                                "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                                "text": "Let him hardly be possest with an honest curiositie to search out the nature and causes of all things […]."
                                            },
                                            {
                                                "example_id": "1e783f7a-9ed9-4512-98ed-2ca2c1954690",
                                                "sense_id": "c2baf242-fe61-3b67-ae17-c6aaea2e56fd",
                                                "text": "Sometimes my pulse beat so quickly and hardly, that I felt the palpitation of every artery; at others, I nearly sank to the ground through languor and extreme weakness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "068567fa-54fe-3ea2-8e30-6061d421bd2a",
                                        "entry_id": "815a44e3-e868-31d4-9011-2bd0cf165861",
                                        "glosses": [
                                            "Not really."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b0f9df-70c0-4468-bf6b-ab6426aabc8f",
                                                "sense_id": "068567fa-54fe-3ea2-8e30-6061d421bd2a",
                                                "text": "I think the Beatles are a really overrated band. ― Hardly!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2d33fe1-cdee-4a65-87f9-d7f04c542df9",
                        "source_entry_id": "289d261a-e0d2-375c-80e8-11953c009328",
                        "source_sense_id": "e44a3918-b822-322f-8dfd-2754f15f963c",
                        "target_lang_word": "ever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                        "entry_id": "e1b7288f-46b6-3cb9-9088-c195338e7f0b",
                                        "glosses": [
                                            "Always, frequently, forever."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d96dda-8f54-4eb5-8aee-8b7cfb8b8529",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "It was ever thus."
                                            },
                                            {
                                                "example_id": "37fad330-3018-4cae-b608-51328d2531d4",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "[…] the Lord Treasurer, who ever secretly feigned himself to be a Moderator and Mollifier of the Catholicks Afflictions […]"
                                            },
                                            {
                                                "example_id": "c5165e59-1f8c-4129-8d1a-030a6991aa44",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "Let us ever remember that our conception, our comprehension, our feeling of God must be ever imperfect, yet should be ever advancing. We must not make God: we must find Him and feel Him more and more."
                                            },
                                            {
                                                "example_id": "0b50735e-d532-4df5-9c6b-8157f0124368",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            },
                                            {
                                                "example_id": "d976bc92-adf7-42b7-a43e-5e7eced04c7b",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "The library staffs of the Karaton Surakarta's Sasana Pustaka, the Mangku- nagaran's Reksa Pustaka, and the Museum Radyapustaka were ever helpful and generous with their time."
                                            },
                                            {
                                                "example_id": "e15f574f-8094-4d19-85f7-a4a027a65aa7",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "As with the rest of macroeconomics, the issues have to be rethought in a way that makes the ever-imperfect knowledge of market participants and policymakers an integral part of the analysis."
                                            },
                                            {
                                                "example_id": "d8daf1b9-4aa1-4ec8-aba1-54755623c5e5",
                                                "sense_id": "fe4cda28-f18f-3518-aadd-577d15f43c79",
                                                "text": "Kane picked up the ball 25 yards out with 18 minutes left before proving he is ever the opportunist by flashing a dipping swerving drive beyond the deceived Szczesny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6c7c47-9aea-35d0-b482-d9a3d4b07247",
                                        "entry_id": "e1b7288f-46b6-3cb9-9088-c195338e7f0b",
                                        "glosses": [
                                            "Continuously, constantly, all the time (for the complete duration)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "767efdfc-425d-4e8e-bdc8-9942fde987f8",
                                                "sense_id": "0d6c7c47-9aea-35d0-b482-d9a3d4b07247",
                                                "text": "People struggled to cope with the ever-increasing cost of living."
                                            },
                                            {
                                                "example_id": "3e1e28af-fb63-4822-a6cf-5eac9660cd05",
                                                "sense_id": "0d6c7c47-9aea-35d0-b482-d9a3d4b07247",
                                                "text": "For what seemed ages piled on ages, I lay there, frozen with the most awful fears, not daring to drag away my hand; yet ever thinking that if I could but stir it one single inch, the horrid spell would be broken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                        "entry_id": "e1b7288f-46b6-3cb9-9088-c195338e7f0b",
                                        "glosses": [
                                            "At any time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162bc757-e2a6-4a74-b323-56760d3d163e",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "We've only ever talked on the phone."
                                            },
                                            {
                                                "example_id": "47db37e0-0775-44eb-b1d1-fbeabfeb09cf",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "I scarcely ever see you anymore!."
                                            },
                                            {
                                                "example_id": "ff5195b5-bc4b-40bb-8599-12c0755dac84",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "If that ever happens, we’re in deep trouble."
                                            },
                                            {
                                                "example_id": "cce052e2-be0e-432a-9cd8-8b32eb76b0cf",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "This is one of the best movies ever."
                                            },
                                            {
                                                "example_id": "08fe552e-1f60-418c-8c12-92c4a5b77bf0",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "He's back and better than ever."
                                            },
                                            {
                                                "example_id": "c34c5e36-72ec-40cc-bb74-cd06123b865c",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "I’ll stop your ever doing that again."
                                            },
                                            {
                                                "example_id": "8ada8a61-93a3-4396-821a-254393914601",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            },
                                            {
                                                "example_id": "69cf2a41-ad29-43fc-8d7d-6c4ce6c2bc5e",
                                                "sense_id": "64d1480f-e5eb-3199-92c3-314d2a8fdc94",
                                                "text": "He said the study provides clear evidence that AI technologies are growing at a faster rate than ever and will continue to do so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91f7bb11-55a2-3fca-9722-6b1a839a691d",
                                        "entry_id": "e1b7288f-46b6-3cb9-9088-c195338e7f0b",
                                        "glosses": [
                                            "As intensifier following an interrogative word."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf2e256-9871-42df-8f65-0640dc33d607",
                                                "sense_id": "91f7bb11-55a2-3fca-9722-6b1a839a691d",
                                                "text": "Was I ever glad to see you!"
                                            },
                                            {
                                                "example_id": "46ede183-d3d7-49ec-98e1-1405f32c3a63",
                                                "sense_id": "91f7bb11-55a2-3fca-9722-6b1a839a691d",
                                                "text": "Did I ever!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65095646-5e00-369e-a9d3-31e40c0e3539",
                                        "entry_id": "e1b7288f-46b6-3cb9-9088-c195338e7f0b",
                                        "glosses": [
                                            "Indicates experiential aspect, once; has or have (done something) before."
                                        ],
                                        "tags": [
                                            "Manglish",
                                            "Singlish",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a5b57d-19cc-47c5-bbc9-ff72bebb1f33",
                                                "sense_id": "65095646-5e00-369e-a9d3-31e40c0e3539",
                                                "text": "but i ever ran 5mins using the 1400 cells and the type RR 23T motor..."
                                            },
                                            {
                                                "example_id": "66efed03-4121-46ae-b0fa-2347d4494a30",
                                                "sense_id": "65095646-5e00-369e-a9d3-31e40c0e3539",
                                                "text": "i ever walked from the south to MacRitchie Reservoir....."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0218756a-215f-365e-a8c6-e4e01b3e15e1",
                                        "entry_id": "31cc44f1-3675-3caa-8c3f-69672553662f",
                                        "glosses": [
                                            "Occurring at any time, occurring even but once during a timespan."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177cc615-9961-4977-954e-f5beed8d45ac",
                                                "sense_id": "0218756a-215f-365e-a8c6-e4e01b3e15e1",
                                                "text": "This family empathy measure is highly related to ever use of birth control but not to any measure of continuous use."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd66f9a8-3b76-3047-a7e0-744905aab2ed",
                                        "entry_id": "986f35ab-f0e4-31b1-bb98-551979fa3450",
                                        "glosses": [
                                            "Shortening of every"
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44d246d-c48e-4810-96b1-6003d44c825a",
                                                "sense_id": "dd66f9a8-3b76-3047-a7e0-744905aab2ed",
                                                "text": "\"Ever place you look there's houses and more houses.\""
                                            },
                                            {
                                                "example_id": "428e54e1-45df-4934-86da-0e6f5afd5c6b",
                                                "sense_id": "dd66f9a8-3b76-3047-a7e0-744905aab2ed",
                                                "text": "Queen Anne's lace ever place you look."
                                            },
                                            {
                                                "example_id": "1d2063c7-a7a9-42ce-b5fa-35074ce8d1a1",
                                                "sense_id": "dd66f9a8-3b76-3047-a7e0-744905aab2ed",
                                                "text": "A sign at the entrance to the road going up Snake Hollow reads, “Snake Hollow is a wonderful place to be, Ever place you look there is a beautiful green tree. Snake Hollow makes you feel alive and free.” Lets keep it that way, for you and me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d39168a7-0673-42d9-9d11-2e4c346293d1",
                        "source_entry_id": "289d261a-e0d2-375c-80e8-11953c009328",
                        "source_sense_id": "e44a3918-b822-322f-8dfd-2754f15f963c",
                        "target_lang_word": "occasionnellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occasionnellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "089b78ab-7745-34f7-a145-f439cef75aa4",
                                        "entry_id": "060cbdd3-c2d0-35a4-9cf7-1b0cadd1f98a",
                                        "glosses": [
                                            "Dans certaines circonstances ; de manière occasionnelle ; par occasion. Note d’usage : Très occasionnellement signifie des événements moins fréquents que occasionnellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22fdee6a-a4b7-496c-ab77-6fbf7b0b51ee",
                                                "sense_id": "089b78ab-7745-34f7-a145-f439cef75aa4",
                                                "text": "Autant que je sache, ici à Malte occasionnellement, on peut encore voir cette coutume lors de la fête des Saint Jean, les feux de la Saint Jean."
                                            },
                                            {
                                                "example_id": "34e2c1b3-0d9d-4854-950a-2852c27b4555",
                                                "sense_id": "089b78ab-7745-34f7-a145-f439cef75aa4",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse et l'on peut voir se manifester à la fois coopération et stratégie d'encerclement et de diversion dans la chasse aux petits potamochères."
                                            },
                                            {
                                                "example_id": "3c39735c-60fb-4628-a2a0-77ba7d28437f",
                                                "sense_id": "089b78ab-7745-34f7-a145-f439cef75aa4",
                                                "text": "A l’exception de quelques espèces lichénivores, fongivores ou occasionnellement voire exclusivement prédatrices, les larves sont phytophages (généralement oligophage ou monophage). Parmi les espèces nuisibles rencontrées en serres, la majorité sont polyphages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
