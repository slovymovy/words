                                        "entry_id": "332fde1c-3dff-3aa3-8d89-7b8e3b599b63",
                                        "glosses": [
                                            "Makeup used to outline the eye, generally applied along or close to the lashline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0817bdae-c95b-4d42-a7d5-ec8aa8be74c5",
                                                "sense_id": "e0e343e5-0d45-3922-b544-eb924673df03",
                                                "text": "Do you need to wear eyeliner? As with any makeup step, eyeliner is completely optional. From an artistic perspective, if you are wearing eyeshadow, I almost always recommend wearing eyeliner, unless your eyelids and eyelashes are obscured by the eyebrow area. Eyeliner is a basic part of an eye-makeup design because it shapes and defines the eyes and makes the eyelashes look thicker."
                                            }
                                        ]
                                    }
                                ]
