                ],
                "senses": [
                    {
                        "sense_id": "8da788ae-b0cb-3d27-9aeb-3f806e7bd763",
                        "entry_id": "1e201612-210c-3f3a-8931-2dcc31019cf7",
                        "glosses": [
                            "Person, die zu einer der keltischen Sprachgemeinschaften auf dem europäischen Festland oder in Anatolien gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9e0988-d2a2-4b3d-9f3b-774592601a8b",
                                "sense_id": "8da788ae-b0cb-3d27-9aeb-3f806e7bd763",
                                "text": "„Die vorliegenden Schriftquellen stammen einerseits von griechischen und römischen Autoren und beziehen sich auf die Festlandkelten, andererseits bezieht sich die christliche Literatur des Mittelalters auf die Inselkelten in Irland, Schottland und Wales.“"
                            },
                            {
                                "example_id": "a1b6c8af-f768-470e-b1fb-4fef6cfd790f",
                                "sense_id": "8da788ae-b0cb-3d27-9aeb-3f806e7bd763",
                                "text": "„Nach ihrer geographischen Verteilung in Europa werden die keltischen Ethnien in zwei Hauptgruppen eingeteilt, in die Inselkelten auf den britischen Inseln und in die Festlandkelten (Kelten des europäischen Festlandes).“"
                            },
                            {
                                "example_id": "e6c24859-aa6c-4708-baa9-01cdc98adb4e",
                                "sense_id": "8da788ae-b0cb-3d27-9aeb-3f806e7bd763",
                                "text": "„Wenn man sich mit den Festlandkelten beschäftigt, so geht es dabei um die riesige Zeitspanne von ca. 1000 Jahren und um kein einheitliches keltisches Volk, sondern um eine Vielzahl von verschiedenen in Mitteleuropa lebenden Stämmen, die gewisse kulturelle, sie als Kelten definierende Gemeinsamkeiten aufwiesen.“"
                            },
                            {
                                "example_id": "68749f0a-47c9-4bc1-819c-6a206c33b14e",
                                "sense_id": "8da788ae-b0cb-3d27-9aeb-3f806e7bd763",
                                "text": "„Die Mythologie der Festlandkelten ist grossteils verschollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
