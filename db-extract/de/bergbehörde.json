                "senses": [
                    {
                        "sense_id": "b5041d71-825b-3b29-9bbd-eb76feb02a06",
                        "entry_id": "ee22f4e0-87e9-3c4e-8a50-57b959058b17",
                        "glosses": [
                            "Behörde, die für Bergaufsicht und Regulierung von Bergbauangelegenheiten zuständig ist"
                        ],
                        "tags": [
                            "Verwaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "12ad39b4-ac4e-4430-a519-752acd8ecc3a",
                                "sense_id": "b5041d71-825b-3b29-9bbd-eb76feb02a06",
                                "text": "„Die Aufsichtspflicht wird durch Bergbehörden als Sonderbehörden der Länder wahrgenommen.“"
                            },
                            {
                                "example_id": "a46c406f-84b8-4c17-aa50-78b06f08bb33",
                                "sense_id": "b5041d71-825b-3b29-9bbd-eb76feb02a06",
                                "text": "„Die Bergbehörden können auf der Grundlage des BBergG für die Regelung spezieller Fragen entsprechende Verordnungen und Anordnungen erlassen und wachen über deren Einhaltung.“"
                            },
                            {
                                "example_id": "cd9cd6e8-affa-4c67-849e-e60515d03b47",
                                "sense_id": "b5041d71-825b-3b29-9bbd-eb76feb02a06",
                                "text": "„Den Bergbehörden obliegt die Aufsicht über das Aufsuchen, Gewinnen und Aufbereiten von bergfreien und grundeigenen Bodenschätzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
