                "senses": [
                    {
                        "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                        "entry_id": "4fc0e0bd-0e0c-36ce-814a-ed2c908f574a",
                        "glosses": [
                            "Großunternehmen, das rund um die Erde tätig ist; Großunternehmen, das weltweit operiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7520687e-c0ed-4fef-a689-bb1260266d3f",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Stromzähler machten Landis & Gyr zum Weltkonzern.“"
                            },
                            {
                                "example_id": "d5a65f10-beda-4dc6-96d3-c9292bfd207b",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Vor 40 Jahren begann der Aufstieg des schwedischen Möbelhauses Ikea zum Weltkonzern.“"
                            },
                            {
                                "example_id": "86c96623-eb82-40a4-a871-4a32006b7988",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "[Dieselskandal:] „Nach bisherigem Stand reichte die kriminelle Energie \"einiger Weniger\" aus, um mit Software - dem neuen Rad der Industrie - einen Weltkonzern aus den Angeln zu heben.“"
                            },
                            {
                                "example_id": "77ab73e7-4464-4bda-a6b5-113160f4cab6",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Im Jahr 1980 kontaktierte der Weltkonzern IBM Bill Gates auf der Suche nach einem billigen Betriebssystem für einen Personal Computer.“"
                            },
                            {
                                "example_id": "f831fe07-5683-4558-9ef4-49b9d444ccd1",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Während der Weltkonzern Siemens auf dem Weg in die Zukunft sich von diesem und jenem trennt und voll und ganz auf Zukunftstechnologien setzt, machen andere ganz bewusst das genaue Gegenteil.“"
                            },
                            {
                                "example_id": "7cd3ee37-fe1d-4de3-9d12-7803bbc12a9f",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Am ersten Arbeitstag des neuen Jahres hatten die Aktionäre das letzte Wort. Aus den beiden Autokonzernen mit ihren Wurzeln in Frankreich, Italien, Deutschland und den USA soll ein Weltkonzern mit neuem Namen werden.“"
                            },
                            {
                                "example_id": "1d2dd26b-ad26-46f4-a7ae-4a3f55cc0571",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Obwohl er zu diesem Zeitpunkt bereits 50 Jahre alt war, entwickelte Petitjean sein Unternehmen zu einem Weltkonzern und zu einem der Aushängeschilder der Luxusindustrie in Frankreich.“"
                            },
                            {
                                "example_id": "0ce78601-fde2-48d4-a4f9-fc46dc14ce14",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„So viele schlechte Nachrichten auf einmal wie in diesen Tagen hat selbst ein Weltkonzern wie Boeing selten zu verdauen.“"
                            },
                            {
                                "example_id": "a7549785-046d-4359-a41c-21c87c518ec7",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "[Abkommen über Kinderarbeit und Firmenhaftung bei Menschenrechtsverstößen:] „Was Nestlé macht, ist jedoch freiwillig und nicht verbindlich. Der Weltkonzern entscheidet, ob und wann er gegen Menschenrechtsverletzungen in der Liefer- und Produktionskette etwas unternimmt.“"
                            },
                            {
                                "example_id": "2d2dd33f-e3bf-4184-bf73-1f86fc2b2d23",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Der größte Arbeitgeber im Industriepark Schwarza Rudolstadt ist heute die BASF mit 110 Mitarbeitern – ein vergleichsweise winziger Standort des Weltkonzerns.“"
                            },
                            {
                                "example_id": "cfb1e56b-006c-467a-9dff-ce956afe56de",
                                "sense_id": "60110e3d-0468-3ecd-94f7-21e76f97418b",
                                "text": "„Ein Bericht der „New York Times“ zu den Arbeitsbedingungen in der Managementebene bei Amazon bringt dem Weltkonzern erneut viel Kritik ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
