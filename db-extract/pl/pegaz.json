                        ],
                        "examples": [
                            {
                                "example_id": "16f46223-89b5-4ddf-9eb5-c90f687172b6",
                                "sense_id": "8f7c8f4e-adfd-35d7-814f-e3ba02dfe875",
                                "text": "Wiadomo, że Pegaz uderzeniem kopyta stworzył źródło Hippokrene, u stóp Helikonu, siedziby Muz"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "76e24a3b-457a-334b-a3a7-6b214a1c14d6",
