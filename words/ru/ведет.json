                    "sense_id": "6e84e0da-46a9-379e-b39e-5604511f91e7",
                    "sense_definition": "Форма настоящего времени третьего лица единственного числа изъявительного наклонения глагола <w>вести</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта извилистая тропинка <w>ведет</w> прямо к лесному озеру.",
                            "target_lang_translations": {
                                "en": "This winding path <w>leads</w> straight to the forest lake.",
                                "tr": "Bu virajlı patika doğrudan orman gölüne <w>götürür</w>."
                            }
                        },
                        {
                            "text": "Он <w>ведет</w> себя очень вежливо и воспитанно в обществе.",
                            "target_lang_translations": {
                                "en": "He <w>behaves</w> very politely and well-manneredly in society.",
                                "tr": "Toplum içinde çok kibar ve terbiyeli <w>davranıyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ведет себя",
