                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emphasis_accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam przy sobie <w>akurat</w> pięć złotych.",
                            "target_lang_translations": {
                                "ru": "У меня с собой <w>как раз</w> пять злотых.",
                                "en": "I have <w>exactly</w> five zlotys with me.",
                                "nl": "Ik heb <w>precies</w> vijf zloty bij me.",
                                "de": "Ich habe <w>gerade</w> fünf Złoty bei mir.",
                                "fr": "J'ai <w>juste</w> cinq zlotys sur moi.",
                                "it": "Ho con me <w>esattamente</w> cinque zloty.",
                                "cs": "Mám u sebe <w>právě</w> pět zlotých.",
                                "tr": "Yanımda <w>tam</w> beş zloty var.",
                                "es": "Tengo <w>justo</w> cinco zlotys conmigo.",
                                "zh": "我身上<w>正好</w>有五兹罗提。"
                            }
                        },
                        {
                            "text": "Tak się <w>akurat</w> złożyło, że spotkałem go w sklepie.",
                            "target_lang_translations": {
                                "ru": "Так <w>как раз</w> сложилось, что я встретил его в магазине.",
                                "en": "It <w>just</w> so happened that I met him at the store.",
                                "nl": "Het kwam <w>toevallig</w> zo uit dat ik hem in de winkel tegenkwam.",
                                "de": "Es hat sich <w>gerade</w> so ergeben, dass ich ihn im Laden getroffen habe.",
                                "fr": "Il se trouve <w>justement</w> que je l'ai croisé au magasin.",
                                "it": "È <w>proprio</w> successo che l'ho incontrato in negozio.",
                                "cs": "Tak se <w>zrovna</w> sešlo, že jsem ho potkal v obchodě.",
                                "tr": "Onu mağazada <w>tam da</w> denk gelip karşılaştım.",
                                "es": "Se dio la casualidad de que <w>justo</w> me lo encontré en la tienda.",
                                "zh": "真<w>凑巧</w>，我在商店遇见了他。"
                            }
                        }
