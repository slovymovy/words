                            {
                                "example_id": "a3adc030-2648-4400-8a3f-6a9b6a529334",
                                "sense_id": "257b800a-2fde-3362-93c9-a7b9c0d184ee",
                                "text": "Na jarenlang kleurenonderzoek heeft deskundige Ruth Jongsma bekendgemaakt dat de kerk de kleur 'dodekop' krijgt, historisch rozerood. Dat liet het museum maandag weten."
                            },
                            {
                                "example_id": "fef6e530-516f-4b36-a99c-0e9e3f477144",
                                "sense_id": "257b800a-2fde-3362-93c9-a7b9c0d184ee",
                                "text": "De afgelopen twee jaar is hard gewerkt aan het pand met de woonruimtes. Maar ook de schuilkerk is onder handen genomen. Zo werd de gele verf overgeschilderd met 'dodekop'."
                            }
                        ]
                    }
                ],
