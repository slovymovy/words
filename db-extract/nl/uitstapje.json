                                    {
                                        "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "A performance in public, for example in a drama, film, on a musical album, as a sports contestant etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a8e216-900d-4ebe-b721-50bf52211c23",
                                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                                "text": "The role is the latest dramatic outing for Radcliffe since the end of the successful Potter franchise."
                                            },
                                            {
                                                "example_id": "3c349553-2181-4623-a661-7fd8acd61663",
                                                "sense_id": "5a172fb4-cc62-3429-8018-bdc578f32678",
                                                "text": "Other erstwhile stalwarts are also wavering. Southampton had two of the best full-backs in the league last season but Ryan Bertrand has been below par this season and Cédric Soares made an uncharacteristic lapse that led to Stoke’s winning goal in Southampton’s last outing."
                                            }
                                        ]
                                    },
                                    {
