                    {
                        "sense_id": "d804d68b-010d-34cb-8e79-575e9f7c2bbe",
                        "entry_id": "0241175b-0751-3de9-b878-73d0cf6c7907",
                        "glosses": [
                            "A historical region shared between the modern countries of France, Italy and Switzerland."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a0ea9906-3e50-3392-b27f-12da86881ac9",
                        "entry_id": "0241175b-0751-3de9-b878-73d0cf6c7907",
                        "glosses": [
                            "A former duchy existing from 1416 to 1847, whose maximal extent included parts of modern southeastern France, northwestern Italy, and southwestern Switzerland; in full, Duchy of Savoy."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
