                "senses": [
                    {
                        "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                        "entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                        "glosses": [
                            "геогр. город в Азии, столица КНДР"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f123008-65ec-46af-ab3c-0c5664a215cd",
                                "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                                "text": "Численность населения современного Пхеньяна с пригородами превышает 4 млн человек."
                            },
                            {
                                "example_id": "0a6b9b15-d9ab-40cf-b8a3-df12dfad41e5",
                                "sense_id": "bb085a05-c58e-352f-b9f6-a80aea9b670d",
                                "text": "Я ожидал увидеть сутолоку узеньких улиц, суету базаров, причудливую на взгляд европейца архитектуру. Ничего этого я не нашёл в Пхеньяне."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                        "entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                        "glosses": [
                            "метоним., полит. правительство КНДР"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88dd8ac-8e56-47c2-9bd0-c027d7cf1068",
                                "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                                "text": "Официальный Пхеньян эти слухи пока не комментирует."
                            },
                            {
                                "example_id": "f20b13eb-e5d1-47bf-80ee-cb65ce96f843",
                                "sense_id": "ae119f82-fb71-3be5-9e56-c6546cef461e",
                                "text": "Правительство Китая обратилось к Пхеньяну с просьбой принять меры, чтобы сократить поток беженцев из КНДР."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e748fa-8092-48bf-9a75-ea9b0dd5d5e8",
                        "source_entry_id": "a35422b0-c453-3936-bf93-b67f65ca5bb1",
                        "source_sense_description": "город в Азии, столица КНДР",
                        "target_lang_word": "Pyongyang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyongyang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58c83cc3-4535-33fb-9be5-88f304de0a5d",
                                        "entry_id": "59576ec0-1416-3ff8-992f-5331aadf8c43",
                                        "glosses": [
                                            "The capital city of North Korea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4caec1ed-b4fa-4ef3-ac09-39593eb3d7fb",
                                                "sense_id": "58c83cc3-4535-33fb-9be5-88f304de0a5d",
                                                "text": "The British and subsequent Foreign Treaties with Korea stipulated for the opening of a further Treaty Port, Yang-hwa-chin on the river Han, as a river-port for the capital. If the steam-traffic on the Han is developed, Yong-san or Byong-san, which is only three miles from Söul, might be selected. The greatest advantage would result to the country from the opening of Pyong-yang on the Taidong river, which is only served by small native steamers and junks."
                                            },
                                            {
                                                "example_id": "298251a2-37dc-43e9-84fe-ca2acd2c52d7",
                                                "sense_id": "58c83cc3-4535-33fb-9be5-88f304de0a5d",
                                                "text": "Forty-seven countries host a North Korean embassy, while 24 have an embassy in Pyongyang. Most of the countries that do not have an embassy in North Korea handle their diplomatic affairs with the country from their embassies in neighboring China or South Korea."
                                            },
                                            {
                                                "example_id": "a3f11d16-ef7e-4c08-be54-cd45c1af7104",
                                                "sense_id": "58c83cc3-4535-33fb-9be5-88f304de0a5d",
                                                "text": "Hundreds of personnel in camouflage uniforms from the Korean People's Army medical units were seen rallying in the capital Pyongyang in photos released by the official Korean Central News Agency (KCNA).\nThe military \"urgently deployed its powerful forces to all pharmacies in Pyongyang City and began to supply medicines under the 24-hour service system\", KCNA said."
                                            },
                                            {
                                                "example_id": "73e8f6bf-07c7-402d-9611-4de03d88d0b3",
                                                "sense_id": "58c83cc3-4535-33fb-9be5-88f304de0a5d",
                                                "text": "While other cities remain far behind, Mr. Kim has concentrated his resources on the capital, positioning Pyongyang as a model of urban development. Under Mr. Kim, North Korea has opened a new terminal at the city’s international airport, renovated subway stations and opened new amusement parks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691c362d-30a9-3764-8dfc-85a705ee6c82",
                                        "entry_id": "59576ec0-1416-3ff8-992f-5331aadf8c43",
                                        "glosses": [
                                            "The North Korean government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "198644a5-b960-43c1-aba8-88be61157e5b",
                                                "sense_id": "691c362d-30a9-3764-8dfc-85a705ee6c82",
                                                "text": "The US State Department said it welcomed talks between Pyongyang and Seoul on North Korea’s participation in the Pyeongchang Winter Olympics, despite a US lawmaker’s call for America to boycott the Games."
                                            },
                                            {
                                                "example_id": "b48ea115-b8bd-4084-b42b-d1228d77f507",
                                                "sense_id": "691c362d-30a9-3764-8dfc-85a705ee6c82",
                                                "text": "The sister of the North Korean leader Kim Jong-un has lambasted South Korea’s foreign minister for casting doubt over Pyongyang’s claim that the country has no coronavirus cases. North Korea closed its borders in January to avoid a spread of the virus and has insisted that it has had no cases."
                                            },
                                            {
                                                "example_id": "e21731c5-a293-4c18-ae6f-5783f6e6882c",
                                                "sense_id": "691c362d-30a9-3764-8dfc-85a705ee6c82",
                                                "text": "Pyongyang successfully launched a reconnaissance satellite on Tuesday after two failed attempts in May and August.\nNorth Korean leader Kim Jong-un and Russian President Vladimir Putin met in September at Russia’s Vostochny Cosmodrome.\nBoth parties reportedly agreed that Pyongyang would receive technical assistance from Moscow in the aerospace field in exchange for weapons to fight the Ukraine war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
