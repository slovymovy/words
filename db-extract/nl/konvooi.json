                        "glosses": [
                            "groep uit veiligheidsreden, samenreizende voertuigen of schepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9de68c3-38a8-4ea1-894f-624eb05c6627",
                                "sense_id": "e03581bb-24df-3c87-992a-71fc82763ac3",
                                "text": "De aanvallen op konvooien met bevoorrading nemen toe."
                            }
                        ]
