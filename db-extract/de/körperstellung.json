                    }
                ],
                "translations": [
                    {
                        "translation_id": "20686a86-925c-4be5-bc5a-e60190d02786",
                        "source_entry_id": "f87c89c4-62af-34d3-b837-07efaf44af6b",
                        "source_sense_id": "345a13dc-1b66-3cc9-9540-2aaf02970867",
                        "source_sense_description": "Position oder Haltung des Körpers",
                        "target_lang_word": "body position",
