{
    "word_family": [
        "factitiously",
        "factitiousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adb8977f-e33f-3656-b01d-897c483139b3",
                    "sense_definition": "Produced artificially or insincerely; fabricated rather than genuine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unreal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a <w>factitious</w> calm that failed to hide his underlying terror.",
                            "target_lang_translations": {
                                "nl": "Hij sprak met een <w>gemaakte</w> kalmte die zijn onderliggende angst niet wist te verbergen."
                            }
                        },
                        {
                            "text": "The patient was diagnosed with a <w>factitious</w> disorder after fabricating symptoms.",
                            "target_lang_translations": {
                                "nl": "Bij de patiënt werd een <w>nagebootste</w> stoornis vastgesteld nadat deze symptomen had gefingeerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "fabricated",
                        "counterfeit",
                        "bogus",
                        "fake"
                    ],
                    "antonyms": [
                        "genuine",
                        "authentic",
                        "sincere"
                    ],
                    "common_phrases": [
                        "factitious disorder",
                        "factitious enthusiasm",
                        "factitious calm"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kunstmatig of onoprecht opgewekt; geveinsd of gefingeerd in plaats van echt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nagebootst",
                                "target_lang_sense_clarification": "geveinsd of voorgewend, zoals symptomen"
                            },
                            {
                                "target_lang_word": "geveinsd",
                                "target_lang_sense_clarification": "onoprecht of onecht"
                            },
                            {
                                "target_lang_word": "gemaakt",
                                "target_lang_sense_clarification": "onnatuurlijk of geforceerd"
                            },
                            {
                                "target_lang_word": "gefingeerd",
                                "target_lang_sense_clarification": "verzonnen of voorgewend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d48ba30e-54a8-3b3f-a7fe-be97723ec5e2",
                    "sense_definition": "Created by human effort or artifice; artificial rather than natural.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unreal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many social conventions are entirely <w>factitious</w> and lack any foundation in nature.",
                            "target_lang_translations": {
                                "nl": "Veel sociale conventies zijn volkomen <w>kunstmatig</w> en ontberen elke natuurlijke grondslag."
                            }
                        },
                        {
                            "text": "They were burdened by the <w>factitious</w> needs created by modern advertising.",
                            "target_lang_translations": {
                                "nl": "Ze gingen gebukt onder de <w>kunstmatige</w> behoeften die door de moderne reclame waren gecreëerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "artificial",
                        "synthetic",
                        "man-made"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "common_phrases": [
                        "factitious needs",
                        "factitious demands"
                    ],
                    "target_lang_definitions": {
                        "nl": "Door menselijk toedoen of kunstgrepen ontstaan; kunstmatig en niet natuurlijk van oorsprong."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kunstmatig",
                                "target_lang_sense_clarification": "niet van nature ontstaan"
                            },
                            {
                                "target_lang_word": "artificieel",
                                "target_lang_sense_clarification": "door de mens gecreëerd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}