                "senses": [
                    {
                        "sense_id": "6287f684-9fb5-318c-a6ba-8c5740b772dd",
                        "entry_id": "3c2ff73c-600c-378a-9b80-fa0f8569f26c",
                        "glosses": [
                            "vervangt *onder het"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d9ce1e-18a0-41bb-aa3e-3c55edea1b16",
                                "sense_id": "6287f684-9fb5-318c-a6ba-8c5740b772dd",
                                "text": "We zetten een streep eronder."
                            },
                            {
                                "example_id": "be3de829-97fa-4400-9fdd-24fd0264efa8",
                                "sense_id": "6287f684-9fb5-318c-a6ba-8c5740b772dd",
                                "text": "Op een dag als deze, onder zo'n blauwe hemel, met land dat door zijn groeizame overvloed Bijbels aandoet, was het misschien wel makkelijk om onder dat oppervlak met edelstenen te glijden, kennis te maken met de forellen en snoeken die eronder leefden en de keuze te maken nooit meer terug te gaan."
                            },
                            {
                                "example_id": "61a79fc7-eb07-446f-bb76-f1c5b0f1c14d",
                                "sense_id": "6287f684-9fb5-318c-a6ba-8c5740b772dd",
                                "text": "Daar stonden ze voor de garage, zij tussen Mutti en vader in, op het erf eronder wachtte de hele familie met Noorse, Duitse en Zweedse vlaggen in hun handen, ze was de eerste Zweedse studente van de familie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbf066e9-7730-4005-957f-4d4e209883f8",
                        "source_entry_id": "3c2ff73c-600c-378a-9b80-fa0f8569f26c",
