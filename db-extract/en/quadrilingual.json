    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee2a86af-df26-3e36-93ae-80043da5546a",
                "word": "quadrilingual",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08663e7f-a94b-3be5-9c80-1aecec0318db",
                        "entry_id": "ee2a86af-df26-3e36-93ae-80043da5546a",
                        "glosses": [
                            "Involving four languages."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4be8cda2-14a7-4fe3-aa35-f3b0829e4bf7",
                                "sense_id": "08663e7f-a94b-3be5-9c80-1aecec0318db",
                                "text": "Part of the rationale for this quadrilingual language policy is the desire to preserve ‘Asian values’, viewed as inherent in Asian languages, in the face of ‘Western values’ associated with globalisation and the use of English."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7e7a574-731a-3412-b6e6-d31109b670db",
                        "entry_id": "ee2a86af-df26-3e36-93ae-80043da5546a",
                        "glosses": [
                            "Of a text, written in four languages."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "485bfb83-df73-377a-9e87-956e4d1f7d53",
                        "entry_id": "ee2a86af-df26-3e36-93ae-80043da5546a",
                        "glosses": [
                            "Of a person, able to speak four languages."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e91263-2c5e-4c98-b385-4cb80fb9e1df",
