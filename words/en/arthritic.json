                    "sense_id": "38b1427e-bc3c-3723-b40c-dfe9f98f3da8",
                    "sense_definition": "Relating to, caused by, or affected by arthritis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>arthritic</w> wrists bothered her most in the winter.",
                            "target_lang_translations": {
                                "de": "Ihre <w>arthritischen</w> Handgelenke machten ihr im Winter am meisten zu schaffen."
                            }
                        },
                        {
                            "text": "He found it difficult to open jars with his <w>arthritic</w> fingers.",
                            "target_lang_translations": {
                                "de": "Es fiel ihm schwer, Gläser mit seinen <w>arthritischen</w> Fingern zu öffnen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arthritic joints",
                        "arthritic fingers",
                        "arthritic pain"
                    ],
                    "target_lang_definitions": {
                        "de": "Arthritis betreffend, dadurch verursacht oder davon befallen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "arthritisch",
                                "target_lang_sense_clarification": "medizinisch / bezogen auf Arthritis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26f51dfe-6883-3100-8ca6-fd1ae4fd88c7",
                    "sense_definition": "A person who suffers from arthritis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Swimming can provide gentle exercise and relief for many <w>arthritics</w>.",
                            "target_lang_translations": {
                                "de": "Schwimmen kann für viele <w>Arthritiker</w> eine schonende Bewegung und Linderung bieten."
                            }
                        },
                        {
                            "text": "The clinic offers special programs tailored to help <w>arthritics</w> manage daily pain.",
                            "target_lang_translations": {
                                "de": "Die Klinik bietet spezielle Programme an, die darauf zugeschnitten sind, <w>Arthritiskranken</w> bei der Bewältigung ihrer täglichen Schmerzen zu helfen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
