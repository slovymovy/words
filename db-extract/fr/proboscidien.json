                                    {
                                        "sense_id": "ba7ef3d4-841d-3b1a-9985-49c6b553b1fe",
                                        "entry_id": "2073cd90-948c-3d15-9974-14783ef7abd1",
                                        "glosses": [
                                            "ein Tier aus der Ordnung Proboscidea mit den Elefanten als einzige rezente Familie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0332d0d3-97f8-4d7e-a3fe-6e86210e78dc",
                                                "sense_id": "ba7ef3d4-841d-3b1a-9985-49c6b553b1fe",
                                                "text": "Paläontologen haben die Überreste eines bisher unbekannten Rüsseltiers entdeckt."
                                            },
                                            {
                                                "example_id": "f741b659-8828-45f0-b34b-cd48fd0512de",
                                                "sense_id": "ba7ef3d4-841d-3b1a-9985-49c6b553b1fe",
                                                "text": "„Mammute und andere zottelige Rüsseltiere trotteten durch die Steppe; Säbelzahnkatzen stellten Riesenhirschen und wildschweingroßen Bibern nach; weiter südlich fraßen sich drei Meter hohe Faultiere und 200 Kilogramm schwere Gürteltiere satt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
