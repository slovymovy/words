                        ],
                        "form": "proefkonijntje"
                    },
                    {
                        "form_id": "e3e15eaa-0793-4648-88ab-527bf387394a",
                        "entry_id": "c35e040d-154b-3b4c-ae47-1e775b5362a8",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "proefkonijntjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7c1d465-1dc3-3e1d-989d-266a11bb8d4c",
                        "entry_id": "c35e040d-154b-3b4c-ae47-1e775b5362a8",
                        "glosses": [
                            "konijn waarop proeven of experimenten gedaan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac992361-3de0-4f80-b33e-ca0ce2ba8d01",
                                "sense_id": "a7c1d465-1dc3-3e1d-989d-266a11bb8d4c",
                                "text": "Veel mensen zijn tegen het gebruik van proefkonijn voor experimenten."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e7fb5f2-4f2c-3014-a4ce-b61145f3db36",
                        "entry_id": "c35e040d-154b-3b4c-ae47-1e775b5362a8",
                        "glosses": [
                            "proefpersoon"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "28728a25-9629-4776-ac89-87c1a42d73e6",
                                "sense_id": "6e7fb5f2-4f2c-3014-a4ce-b61145f3db36",
                                "text": "Gelukkig, dat zij nog bijtijds tot de ontdekking komt, dat het dezen modernen artist geen ernst is en dat zij voor hem weinig meer is geweest dan een proefkonijn, geschikt voor experimentatie, zoodat ten slotte nog alles goed terechtkomt, dank zij vooral het gezond verstand van den ingenieur."
                            },
                            {
                                "example_id": "5df5e8e8-edc7-4e9d-9ee8-0b5fbcf799d6",
                                "sense_id": "6e7fb5f2-4f2c-3014-a4ce-b61145f3db36",
                                "text": "Olga, ik geloof nu dat je wèrkelijk van hem hield. Wat valt er dan te vergeven? Ik haatte je toen ik daaraan twijfelde, toen ik dacht dat jíj Hans als een proefkonijn op de snijtafel had inplaats van het leven jòu... Hans heeft met me gesproken... ik begrijp nu wat je gedaan hebt en waarom en Hans zal ook zeker ééns anders over je denken dan nu."
                            },
                            {
                                "example_id": "abe1051b-d412-4451-8e24-f10b31da5eac",
                                "sense_id": "6e7fb5f2-4f2c-3014-a4ce-b61145f3db36",
                                "text": "Jij bent ons proefkonijn om te kijken of de techniek werkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4270ce7-176d-4569-88f7-ff9fb1eb75e9",
                        "source_entry_id": "c35e040d-154b-3b4c-ae47-1e775b5362a8",
                        "source_sense_id": "a7c1d465-1dc3-3e1d-989d-266a11bb8d4c",
                        "source_sense_description": "konijn waarop er geëxperimenteerd wordt",
                        "target_lang_word": "Versuchskaninchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versuchskaninchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e26779-5eaf-3413-b006-c95721e087e8",
                                        "entry_id": "606dbb30-0f9c-3452-9f02-9ebc30e8ba48",
                                        "glosses": [
                                            "Kaninchen, an dem Testversuche durchgeführt werden (zum Beispiel für die Kosmetikindustrie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc4e19d-7efd-4532-bda8-e6f34c10178f",
                                                "sense_id": "81e26779-5eaf-3413-b006-c95721e087e8",
                                                "text": "„Den Medizinern vom Wake Forest Institut für Wiederherstellungsmedizin in Winston-Salem, North Carolina, gelang es, aus körpereigenen Zellen der Versuchskaninchen einen Schwellkörper zu züchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "995829ab-9360-30d4-b1a1-f821798725ce",
                                        "entry_id": "606dbb30-0f9c-3452-9f02-9ebc30e8ba48",
                                        "glosses": [
                                            "Mensch, an dem etwas getestet wird, der etwas ausprobieren muss"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e300c062-4ce6-450f-a1ab-240454f1b187",
                                                "sense_id": "995829ab-9360-30d4-b1a1-f821798725ce",
                                                "text": "Ich lade gerne Gäste ein, wenn ich etwas Neues koche – sie dienen mir dann als Versuchskaninchen."
                                            },
                                            {
                                                "example_id": "dbf53982-cd09-4a9d-bb91-d056497ab3ca",
                                                "sense_id": "995829ab-9360-30d4-b1a1-f821798725ce",
                                                "text": "„Wenn gegen die furchtbare Cholera ein Mittel gefunden würde und ausprobiert werden sollte, ich würde mich dem Professor als Versuchskaninchen zur Verfügung stellen, ja auf Ehre! Habe ich da nicht ein Recht, mit einer Maus Experimente zu machen?“"
                                            },
                                            {
                                                "example_id": "b81a5432-f372-489b-978e-bd5b66afab6b",
                                                "sense_id": "995829ab-9360-30d4-b1a1-f821798725ce",
                                                "text": "„Lilly war seit Jahren das Versuchskaninchen des Dalai Lama für neue Kuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b9cb71b-79c4-4a37-9ef0-f74c6591ad75",
                        "source_entry_id": "c35e040d-154b-3b4c-ae47-1e775b5362a8",
