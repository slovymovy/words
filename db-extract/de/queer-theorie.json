                ],
                "senses": [
                    {
                        "sense_id": "999f2f66-681f-3d95-ab48-efedaeabdad9",
                        "entry_id": "42e1d68b-a072-36e7-9b4f-25d60f55da62",
                        "glosses": [
                            "Lehre, der zufolge Geschlechtsidentität und sexuelle Orientierung durch Handlungen erzeugt, somit (kulturell) „konstruiert“ werden"
                        ],
                        "tags": [
                            "Sozialwissenschaften"
                        ],
                        "examples": [
                            {
                                "example_id": "104c4413-cfaf-49b4-ad05-1b934137bef6",
                                "sense_id": "999f2f66-681f-3d95-ab48-efedaeabdad9",
                                "text": "„Neben Foucault, dessen Machtanalytik vor allem in den Arbeiten von Judith Butler ein starkes Gewicht bekommt, hat sich die Queer-Theorie die von Jacques Derrida entwickelte Dekonstruktion zu eigen gemacht.“"
                            },
                            {
                                "example_id": "90a92cf6-464b-47b8-83ed-c14d59ae5b09",
                                "sense_id": "999f2f66-681f-3d95-ab48-efedaeabdad9",
                                "text": "„Die Queer-Theorie geht stets davon aus, dass das Verständnis von Geschlecht und sexueller Orientierung ein kulturelles Konstrukt ist.“"
                            },
                            {
                                "example_id": "4391bc4b-6dec-48d6-b963-f9c2b458216d",
                                "sense_id": "999f2f66-681f-3d95-ab48-efedaeabdad9",
                                "text": "„Der Fehler der Schwulenbewegung ist der Schulterschluss mit den Anhängern der Queer-Theorie. Wer die Biologie leugnet, eröffnet Fragen, die längst als beantwortet galten.“"
                            },
                            {
                                "example_id": "728d51c2-e17b-44b8-9c60-91fd7871b82b",
                                "sense_id": "999f2f66-681f-3d95-ab48-efedaeabdad9",
                                "text": "„Ursache der atmosphärischen Spannungen ist eine tiefe Spaltung des Feminismus in die dominant gewordene Gender- und Queer-Theorie auf der einen Seite und die traditionelle Frauenforschung auf der anderen, oder, was die publizistische Ebene betrifft, in das lifestylige ‚Missy Magazine‘ und die altvordere ‚Emma‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
