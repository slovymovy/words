                                    {
                                        "sense_id": "33abff8e-5ea9-3042-83e9-d49f3075d1f7",
                                        "entry_id": "223b75c4-df87-35ba-b0e7-9de4f1082135",
                                        "glosses": [
                                            "North Atlantic Treaty Organization, zu deutsch Nordatlantikvertrag-Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8ceab5-0a9c-4019-b0bf-0e786bbfcbdd",
                                                "sense_id": "33abff8e-5ea9-3042-83e9-d49f3075d1f7",
                                                "text": "Die NATO wurde 1949 gegründet und hat heute ihren Sitz in Brüssel."
                                            },
                                            {
                                                "example_id": "31e28688-455b-4183-b8cb-0d0d388639e2",
                                                "sense_id": "33abff8e-5ea9-3042-83e9-d49f3075d1f7",
                                                "text": "„In Brüssel trafen sich die Verteidigungsminister der NATO zu einem eilig einberufenen Sondergipfel.“"
                                            },
                                            {
                                                "example_id": "4497ac40-2a05-42d1-b3bf-705a3a4f3320",
                                                "sense_id": "33abff8e-5ea9-3042-83e9-d49f3075d1f7",
                                                "text": "„Da nirgendwo verlässlich niedergeschrieben ist, wie oft CIA, Pentagon oder NATO in schweinebuchtähnliche Situationen geraten sind und wie sie sich dann verhalten haben, können die beiden jetzt ewig weiterstreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
