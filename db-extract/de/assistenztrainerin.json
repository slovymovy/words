                            {
                                "example_id": "47f949c3-0243-49d6-b3f5-177354fce0d7",
                                "sense_id": "2534a451-5f8e-3897-97cc-99c568f28c56",
                                "text": "„Ich war nicht unzufrieden mit meinem Job als Assistenztrainerin bei meinem Großvater.“"
                            },
                            {
                                "example_id": "9fd73fac-643c-47b9-94e6-4f3d7d2ec351",
                                "sense_id": "2534a451-5f8e-3897-97cc-99c568f28c56",
                                "text": "„Ms Train war unsere Assistenztrainerin, obwohl sie von Fußball keine Ahnung hatte.“"
                            },
                            {
                                "example_id": "3028f00d-3a39-4394-8320-f1004000422e",
                                "sense_id": "2534a451-5f8e-3897-97cc-99c568f28c56",
                                "text": "„Jetzt arbeitete sie unter anderem als Assistenztrainerin für die verschiedenen Jungenmannschaften.“"
                            }
                        ],
