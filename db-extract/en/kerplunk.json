                        "entry_id": "fd9cba6d-1a10-3390-a63f-c2e56b76cf09",
                        "glosses": [
                            "A sound of someone or something falling and landing heavily."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "38347974-67ea-413a-8963-fcc7dca5899e",
                                "sense_id": "e11200c6-3196-34c7-8f33-2eb933a2b8a4",
                                "text": "If my life were a Saturday-morning cartoon, you would have heard a loud kerplunk as my stomach dropped. My poor starving stomach. It was under such stress already, and now this."
                            }
                        ]
                    },
                    {
                        "sense_id": "81ab951c-2cae-3f7e-b301-66d65fb3cdcb",
