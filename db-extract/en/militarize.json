                                            {
                                                "example_id": "05a95c97-2682-4f49-913f-8d52941c2499",
                                                "sense_id": "e40598c5-a2b0-34f3-8690-58d4b04cbc48",
                                                "text": "Selon les investigations du Centre de recherche sur les catastrophes, la décision de militariser la zone a également eu pour conséquence d'augmenter le nombre des victimes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5a93239-9382-4b9c-b4ef-3af6a2c12a8a",
                        "source_entry_id": "f5e69052-0ec4-3fe0-aca3-21cd00c430d4",
                        "source_sense_description": "to give military character to",
                        "target_lang_word": "militarisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "militarisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26050716-96c4-3e71-b4c1-c05e08f42230",
                                        "entry_id": "84e17e8a-2584-343f-aff4-99e4e3525d4e",
                                        "glosses": [
                                            "Solches errichten und einführen, das die Möglichkeit zu Verteidigung und Angriff eröffnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1281af5-c7b9-41ef-807b-d2e8d3b692eb",
                                                "sense_id": "26050716-96c4-3e71-b4c1-c05e08f42230",
                                                "text": "Das Land wurde erst ein Vierteljahrhundert nach Kriegsende wieder militarisiert."
                                            },
                                            {
                                                "example_id": "06336e2a-e6a8-4c4c-98a1-8be9ae3a9cbc",
                                                "sense_id": "26050716-96c4-3e71-b4c1-c05e08f42230",
                                                "text": "„Die Hochgebirgsregion ist vor allem in politischer Hinsicht problematisch: Sie wird seit 1972 von der Line of Control (LoC) durchzogen, die den indischen vom pakistanischen Teil des einstigen Fürstentums Kaschmir trennt und eine der am stärksten militarisierten Grenzen der Welt bildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98154d4c-b562-311e-b379-e2d6c548ea1b",
                                        "entry_id": "84e17e8a-2584-343f-aff4-99e4e3525d4e",
                                        "glosses": [
                                            "militärische Wertvorstellungen und Interessen in der Gesellschaft verbreiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c76fc28-c95f-47e4-8eab-2a57ca67ecfb",
                                                "sense_id": "98154d4c-b562-311e-b379-e2d6c548ea1b",
                                                "text": "Wenn die Uniform zur normalen Regelbekleidung wird, ist die Gesellschaft schon recht weit militarisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "528ec7b0-7c96-441f-896f-d0ebbc8b7b73",
                        "source_entry_id": "f5e69052-0ec4-3fe0-aca3-21cd00c430d4",
                        "source_sense_description": "to give military character to",
                        "target_lang_word": "милитаризи́ровать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "милитаризи́ровать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "26b12429-3fc8-38f1-8927-db733d1b0c5a",
                                        "entry_id": "39a7b908-f9da-32a5-81c1-bb961865c0f5",
                                        "glosses": [
                                            "усиливать (усилить) роль военных в чём-либо; подчинять (подчинить) что-либо (экономику, политику, общественную жизнь и т. п.) военным целям; придавать (придать) чему-либо военный, милитаристский характер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13225b64-de09-4f81-98f7-10baf402eb00",
                                                "sense_id": "26b12429-3fc8-38f1-8927-db733d1b0c5a",
                                                "text": "Во внутреннем же плане постоянная угроза терроризма, запуганность рядового израильтянина помогают милитаризовать общество, облегчают командование им, несмотря на существование развитых демократических институтов."
                                            },
                                            {
                                                "example_id": "4e00c92d-c18d-4661-8e91-3e9cd8364ac0",
                                                "sense_id": "26b12429-3fc8-38f1-8927-db733d1b0c5a",
                                                "text": "Напомню хотя бы о том, что неизбывная тяга немцев к «орднунгу» сначала помогла Гитлеру прийти к власти, сломать хребет оппозиции, модернизировать и милитаризовать Германию, а затем ему же помогала дисциплинированно насаждать фашизм, т.е. рабство, в остальной Европе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eb6659e-f6e7-4a8a-8e25-d4ba4516a105",
                        "source_entry_id": "f5e69052-0ec4-3fe0-aca3-21cd00c430d4",
                        "source_sense_description": "to give military character to",
                        "target_lang_word": "милитаризова́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "милитаризова́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2a84ed8c-1f77-34f2-8301-124adb003c22",
                                        "entry_id": "df9e7739-918c-3511-90e4-4670af777ab7",
                                        "glosses": [
                                            "книжн. подчинять (подчинить) военной дисциплине, военным целям, законам; приспосабливать (приспособить) к военным целям (об экономике, о политике, быте и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7f3cea-89d6-448b-9854-897838094e80",
                                                "sense_id": "2a84ed8c-1f77-34f2-8301-124adb003c22",
                                                "text": "Необходимо милитаризовать партию, как мы милитаризовали промышленность."
                                            },
                                            {
                                                "example_id": "fb3a0385-ed01-4214-a209-8f3e95c24b3a",
                                                "sense_id": "2a84ed8c-1f77-34f2-8301-124adb003c22",
                                                "text": "Его цель была — милитаризовать страну, спровоцировать мировую войну, вступить в нее в самый удобный момент и остаться в конечном счете единственным победителем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
