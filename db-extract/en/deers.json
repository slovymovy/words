                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9d9ee183-fc3d-468a-9305-394ef3012f94",
                                "sense_id": "64a41057-162e-31c8-88e7-e5593518142b",
                                "text": "“Not dem kinda deers, dese de kine wit′ antling.”\nShe say, “I′m goin′ witcha.”\nHe say, “I'll be damned, iss not′ing but a dirty ol′ men's camp an′ you can′t go.”\nWell, she bawled an′ squalled and raise some sand, but he went to hont dem deers."
                            },
                            {
                                "example_id": "6d77c77b-6b36-4228-a886-d7e3105cf5a6",
                                "sense_id": "64a41057-162e-31c8-88e7-e5593518142b",
                                "text": "\"Tris is sure to shirr the deers out\""
                            },
                            {
                                "example_id": "66c88013-7113-4908-8bf9-ccae3437bce6",
                                "sense_id": "64a41057-162e-31c8-88e7-e5593518142b",
                                "text": "“They there to scare the deers away from the garden. Deers, they slip in here at night and make a mess eating up things,” she says."
                            },
                            {
                                "example_id": "c5d5b5c3-08f1-4c6e-9ba6-0404a91e1f39",
                                "sense_id": "64a41057-162e-31c8-88e7-e5593518142b",
                                "text": "“I thought he used to be a hunter or something,” Hardin said.\n“If you call shooting deers in some kind of deer zoo great sport,” Sarah said."
                            }
                        ]
                    }
