        "fr-extract.jsonl": [
            {
                "entry_id": "dce01cf0-bdff-3614-b7c8-f9c12521cb84",
                "word": "garde-boue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fe73b46c-71df-4622-bf55-231077657b3b",
                        "entry_id": "dce01cf0-bdff-3614-b7c8-f9c12521cb84",
                        "tags": [
                            "plural"
                        ],
                        "form": "garde-boues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d2dcdd1-dcf9-3287-b40d-6c4a03daafd9",
                        "entry_id": "dce01cf0-bdff-3614-b7c8-f9c12521cb84",
                        "glosses": [
                            "Pièce de métal ou de plastique incurvée placée autour des roues d’un véhicule (vélo, moto, voiture…) pour protéger de l’eau et de la boue son conducteur et la carrosserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d90ec0-fa1c-4f93-9885-775ee4192c9a",
                                "sense_id": "1d2dcdd1-dcf9-3287-b40d-6c4a03daafd9",
                                "text": "Bonjour ! vous seriez gentil s’il vous plaît de me détordre mon garde-boue, il fait un bruit insupportable, et puis vous regarderez par la même occasion si le radiateur ne fuit pas."
                            },
                            {
                                "example_id": "6e4c9980-27b9-4050-9679-a52205fe7735",
                                "sense_id": "1d2dcdd1-dcf9-3287-b40d-6c4a03daafd9",
                                "text": "Une vraie automobile, une Züst 25/35 au long nez doré, aux garde-boue conquérants, qui sortit de la fournaise pour s’arrêter devant nous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "592b6b44-4848-4a11-be3f-f8aeedfea109",
                        "source_entry_id": "dce01cf0-bdff-3614-b7c8-f9c12521cb84",
                        "source_sense_id": "1d2dcdd1-dcf9-3287-b40d-6c4a03daafd9",
                        "target_lang_word": "Schutzblech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutzblech",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                                        "entry_id": "65239c0a-d41c-38cd-be54-1a8a24967440",
                                        "glosses": [
                                            "über dem Vorder- und Hinterrad angebrachte Schutzeinrichtung, die den Fahrradfahrer vor Spritzwasser schützt"
                                        ],
                                        "tags": [
                                            "Fahrradtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2390ee11-61ba-4b25-900a-10e8aaf69c1b",
                                                "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                                                "text": "„Das Canyon Commuter kommt zwar mausgrau lackiert daher, hat es aber in sich. Hier waren Designer am Werk, die wissen, dass ein Rad im Alltag auch Beleuchtung und Schutzbleche braucht. Diese Ingredienzien sind am und im Rahmen unauffällig integriert und stören nicht den Look, ganz im Gegenteil.“"
                                            },
                                            {
                                                "example_id": "c5fa1613-7883-4856-bd1f-2eb7767e15aa",
                                                "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                                                "text": "„Die Handbremse funktionierte jetzt, auch der Dynamo und beide Scheinwerfer, die Kette war frisch geölt und das vordere Schutzblech saß wieder fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7a45e7e-5825-3418-93a9-951746ded6c0",
                                        "entry_id": "65239c0a-d41c-38cd-be54-1a8a24967440",
                                        "glosses": [
                                            "schützende Blechvorrichtung über beweglichen Maschinenteilen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a2ff994-dcf2-422f-b86a-cbfd4ec851c5",
                        "source_entry_id": "dce01cf0-bdff-3614-b7c8-f9c12521cb84",
                        "source_sense_id": "1d2dcdd1-dcf9-3287-b40d-6c4a03daafd9",
                        "target_lang_word": "Kotflügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kotflügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                        "entry_id": "5d1d6f36-44c0-35b9-a949-5f4f63e66af5",
                                        "glosses": [
                                            "Bauteil/Teil der Karosserie eines Kraftfahrzeuges/Autos, das zur Abdeckung von Fahrzeugrädern dient"
                                        ],
                                        "tags": [
                                            "Kraftfahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "077c4e6f-0914-479d-bc93-8e2429dcf829",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "An meinem Auto ist ein Kotflügel verbeult."
                                            },
                                            {
                                                "example_id": "2cf32b11-c4ae-4802-9435-8bd6517aa372",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Mist, da stand der Blumenkübel im Weg. Jetzt ist der Kotflügel leicht eingedellt und verkratzt.“"
                                            },
                                            {
                                                "example_id": "f36c61e5-6cdc-46f6-b209-5f277bbec950",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Beim Putzen merkt er, dass unten am hinteren Kotflügel ein böser Kratzer im Lack ist. Den kann er fachmännisch selber ausbessern. Denn: Stefan ist Lackierer.“"
                                            },
                                            {
                                                "example_id": "7c1c84e1-4aa1-4e59-b18a-3369cc282a39",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„[…] als unsere Familienkutsche einen neuen Kotflügel braucht, da legt sich meine Frau mit Werkzeug unters Auto [und baut ihn selber an].“"
                                            },
                                            {
                                                "example_id": "2ea9aae3-de83-4979-96f2-e3798f141d30",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„[Der] Cisitalia Berlinetta, der bereits 1946 entstanden ist, [ist ein] Sportwagen, wo erstmals die Kotflügel in die Karosserie integriert sind. Vor dem Zweiten Weltkrieg waren die Kotflügel fast immer angeschraubt.“"
                                            },
                                            {
                                                "example_id": "01f29ab7-375a-4f02-aa4f-6e2157b1b6d7",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Einen Kotflügel aus Blech [für einen Oldtimer] neu zu konstruieren kostet zahlreiche Stunden und rund 4000 Euro.“"
                                            },
                                            {
                                                "example_id": "c97903c0-5f40-4a3a-a1a3-65807dba4d39",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Vom Kotflügel über Telefonhörer bis zur Computermaus: Es gibt kaum ein Industrieprodukt, bei dessen Design nicht auch der Computer mitgeholfen hätte.“"
                                            },
                                            {
                                                "example_id": "af2a7fb1-43d3-4dc7-9066-70e378fceff2",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "[17.8.1896:] „Beim Versuch, eine stark belebte Straße zu überqueren, schlingerte eines dieser noch äußerst seltenen Automobile auf Bridget Driscoll zu und erwischte sie mit dem rechten Kotflügel.“"
                                            },
                                            {
                                                "example_id": "65197e56-81dc-4256-8966-b32b558acba0",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Auch kleine Schäden, etwa eine Delle im Kotflügel, können in der Reparatur richtig teuer werden.“"
                                            },
                                            {
                                                "example_id": "32fd5869-1f33-4cae-94ce-6290ef3f8382",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Ein blauer Fiat Punto wurde [in der Kreitmayrstraße in Augsburg-Lechhausen] am hinteren linken Kotflügel beschädigt. Der Sachschaden liegt bei etwa 800 Euro.“"
                                            },
                                            {
                                                "example_id": "0cef773a-29ff-488d-9edb-87db103462c5",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Die Heckscheibe und die Seitenscheiben auf der Fahrerseite sind kaputt, die Windschutzscheibe hat auch was abgekommen, im Blech auf der Fahrerseite sind einige Dellen und der Kotflügel ist verzogen.“"
                                            },
                                            {
                                                "example_id": "0375f758-2c50-46c8-8cd9-bf906a96b3e3",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„[Wolfram K. aus Lübeck] hatte sein Auto vor dem Haus geparkt. Eine Frau fährt beim Rangieren rückwärts auf seinen Wagen. Stoßstange, Blinker und Kotflügel sind kaputt. Der Schaden liegt bei mehr als 3.000 Euro.“"
                                            },
                                            {
                                                "example_id": "ae4ceb8c-a039-4920-8d45-d9c88e423f10",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Der Paragraf der Unfallflucht sieht […] drakonische Strafen vor. Übersteigt der Schaden 1500 Euro, und das kann bei einer Delle im Kotflügel, der neu lackiert werden muss, schnell passieren, ist meist auch der Führerschein erst einmal weg.“"
                                            },
                                            {
                                                "example_id": "6d4b44f3-c803-4305-8c12-e35c76ca1f5e",
                                                "sense_id": "f7101e35-a50a-3368-ad29-c40607718918",
                                                "text": "„Beim Autobahnzoll Weil-Otterbach haben Schweizer Grenzwächter schon Ende März einen speziellen Fall von Schmuggel aufgedeckt: sie hielten eine 40jährige Frau an, die versuchte, im Kotflügel ihres Autos 3000 Ecstasy-Pillen […] von Deutschland in die Schweiz zu schmuggeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
