                "senses": [
                    {
                        "sense_id": "934afbd9-5fd1-3b6a-8c02-aa417bba39b0",
                        "entry_id": "578561c2-96d2-3c66-92b0-f595c47a7572",
                        "glosses": [
                            "Arrêter de considérer comme relevant du droit criminel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94227189-f309-4edc-81f1-f7d3d6ccb7bd",
                                "sense_id": "934afbd9-5fd1-3b6a-8c02-aa417bba39b0",
                                "text": "Seul le législateur peut modifier la sanction. Autrement dit, il peut décriminaliser un acte et le correctionnaliser (transformer un crime en délit), il peut aussi contraventionner et inversement."
                            },
                            {
                                "example_id": "af61397d-d044-477b-8ea1-522257efd1d0",
                                "sense_id": "934afbd9-5fd1-3b6a-8c02-aa417bba39b0",
                                "text": "Les autorités gambiennes ont affirmé, mardi 23 juin, qu’elles n’avaient aucune intention de décriminaliser l’homosexualité, ni même d’ouvrir le débat sur ce sujet sensible dans ce petit pays anglophone d’Afrique de l’Ouest, après plusieurs semaines d’une vive polémique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "192a1a41-e280-405f-b691-9145da09e86c",
                        "source_entry_id": "578561c2-96d2-3c66-92b0-f595c47a7572",
                        "source_sense_id": "934afbd9-5fd1-3b6a-8c02-aa417bba39b0",
                        "target_lang_word": "decriminalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decriminalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97ada5f-07ee-3926-920e-69277c301c0d",
                                        "entry_id": "c0a5ab33-aac2-3d78-b41b-b445dc5cef22",
                                        "glosses": [
                                            "To change the laws so something is no longer a crime."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db8865fb-0496-47d9-a35c-5264ae2b0692",
                                                "sense_id": "f97ada5f-07ee-3926-920e-69277c301c0d",
                                                "text": "The march to decriminalize drugs moved further across the nation on Tuesday despite continued federal prohibition."
                                            },
                                            {
                                                "example_id": "a211e348-f094-4e0c-a018-9308a5f2caf5",
                                                "sense_id": "f97ada5f-07ee-3926-920e-69277c301c0d",
                                                "text": "The House of Representatives approved decriminalizing marijuana at the federal level on Friday in the first time Congress has acted on the issue."
                                            },
                                            {
                                                "example_id": "9855fb76-3419-4f2b-ac58-fb39a13bf2a2",
                                                "sense_id": "f97ada5f-07ee-3926-920e-69277c301c0d",
                                                "text": "Last fall Oregon voters decriminalized possession of small amounts of almost all hard drugs, taking a groundbreaking step away from the arrest, charge and jail model for possession that's been a centerpiece of American drug policy since President Richard Nixon declared his War on Drugs 50 years ago this week."
                                            },
                                            {
                                                "example_id": "13ed53f2-9053-4ba1-b4ca-d5b68a48448d",
                                                "sense_id": "f97ada5f-07ee-3926-920e-69277c301c0d",
                                                "text": "The court’s decision decriminalizes abortions in the first 24 weeks of pregnancy, and means that any woman should be able to seek the procedure from a health professional without fear of criminal prosecution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c20d39a-2731-4fbd-b56d-8ab58172452b",
                        "source_entry_id": "578561c2-96d2-3c66-92b0-f595c47a7572",
