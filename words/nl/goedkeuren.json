    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7a602d7-3702-36b4-8fbd-f60284a5a643",
                    "sense_definition": "toestemming verlenen of iets officieel accepteren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toestemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vader <w>keurde</w> het <w>goed</w> dat ik met die jongen naar de film ging.",
                            "target_lang_translations": {
                                "en": "Father <w>approved</w> of me going to the movies with that boy.",
                                "ru": "Отец <w>одобрил</w>, что я пошла в кино с тем парнем."
                            }
                        },
                        {
                            "text": "De directeur moet het plan eerst <w>goedkeuren</w> voordat we kunnen beginnen.",
                            "target_lang_translations": {
                                "en": "The director must first <w>approve</w> the plan before we can start.",
                                "ru": "Директор должен сначала <w>утвердить</w> план, прежде чем мы сможем начать."
                            }
                        }
                    ],
                    "synonyms": [
                        "goedvinden",
                        "toestaan"
                    ],
                    "antonyms": [
                        "afkeuren"
                    ],
                    "common_phrases": [
                        "een plan goedkeuren",
                        "officieel goedkeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "To grant permission or to officially accept something.",
                        "ru": "Дать разрешение или официально принять что-либо."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approve",
                                "target_lang_sense_clarification": "to officially sanction or ratify"
                            },
                            {
                                "target_lang_word": "give the go-ahead",
                                "target_lang_sense_clarification": "to give permission to proceed"
                            },
                            {
                                "target_lang_word": "authorize",
                                "target_lang_sense_clarification": "to give official permission for something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "выражать согласие или давать официальное согласие"
                            },
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "официально принимать план, бюджет или документ"
                            },
                            {
                                "target_lang_word": "санкционировать",
                                "target_lang_sense_clarification": "давать официальное разрешение на действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2fea561-7a93-382b-af67-63a4fc2d2726",
                    "sense_definition": "bevestigen dat iets aan de eisen voldoet of moreel aanvaardbaar is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De inspecteur heeft de nieuwe installatie na een lange controle <w>goedgekeurd</w>.",
                            "target_lang_translations": {
                                "en": "The inspector <w>passed</w> the new installation after a long inspection.",
                                "ru": "Инспектор <w>признал годной</w> новую установку после долгой проверки."
                            }
                        },
                        {
                            "text": "Ik kan dit gedrag absoluut niet <w>goedkeuren</w> in deze situatie.",
                            "target_lang_translations": {
                                "en": "I absolutely cannot <w>condone</w> this behavior in this situation.",
                                "ru": "Я абсолютно не могу <w>одобрить</w> такое поведение в этой ситуации."
                            }
                        }
                    ],
                    "antonyms": [
                        "afkeuren"
                    ],
                    "common_phrases": [
                        "gedrag goedkeuren",
                        "een aanvraag goedkeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "To confirm that something meets requirements or is morally acceptable.",
                        "ru": "Подтвердить, что что-то соответствует требованиям или является морально приемлемым."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approve",
                                "target_lang_sense_clarification": "to regard as good or acceptable"
                            },
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to judge something as meeting a required standard"
                            },
                            {
                                "target_lang_word": "condone",
                                "target_lang_sense_clarification": "to accept or allow behavior that is considered wrong"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "признавать годным",
                                "target_lang_sense_clarification": "подтверждать соответствие техническим нормам"
                            },
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "считать поведение или поступок правильным"
                            },
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "соглашаться с чем-либо как с допустимым"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}