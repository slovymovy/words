                        "sense_id": "b220f8fe-1652-3761-a6c0-1bca21b580a8",
                        "entry_id": "bc81bde7-28c7-32bf-8d8a-110024b47b7b",
                        "glosses": [
                            "rechterlijke samenwerking tussen verschillende staten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b364a61c-762f-4d40-9f14-d3d88c4302ef",
                                "sense_id": "b220f8fe-1652-3761-a6c0-1bca21b580a8",
                                "text": "De informatie over de reizen naar België kan niet onmiddellijk bevestigd worden. Het federaal parket laat weten dat het vanzelfsprekend actief zal meewerken aan iedere vraag van de Spaanse autoriteiten om rechtshulp."
                            }
                        ]
