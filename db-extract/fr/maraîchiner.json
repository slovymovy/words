                "senses": [
                    {
                        "sense_id": "ab7cfcdb-f2ff-3fcf-8fc4-afc78d6bc0f1",
                        "entry_id": "867444b4-9b90-32f4-a8ed-f07175a5cdbc",
                        "glosses": [
                            "Embrasser voluptueusement d'un baiser intrabuccal."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e8243433-e618-4249-889c-7ca69a4b8b6e",
                                "sense_id": "ab7cfcdb-f2ff-3fcf-8fc4-afc78d6bc0f1",
                                "text": "Quand ils reviennent, ceux de l'Herbaudière\ndansent avec les mômes sardinières,\n et volontiers se pass'raient de dîner\n pour le plaisir de les maraîchiner."
                            },
                            {
                                "example_id": "35473b87-3213-4fef-bd59-a36a521d42c2",
                                "sense_id": "ab7cfcdb-f2ff-3fcf-8fc4-afc78d6bc0f1",
                                "text": "Seuls les garçons et les filles à marier maraîchinent. Ils le font, encore de nos jours, en pleine rue, à la vue de tous, debout, ou au milieu de la foule, […]"
                            }
                        ]
                    }
                ],
