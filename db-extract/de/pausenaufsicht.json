                        "glosses": [
                            "Verantwortung für Kinder, die in einer unterrichtsfreien Zeit auf dem Schulhof sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e2259c-9416-4aa6-9731-811354416c76",
                                "sense_id": "c87db4ce-2f5a-33f8-a379-1245933993d5",
                                "text": "Die Pausenaufsicht in der großen Pause übernehmen heute die Referendare."
                            }
