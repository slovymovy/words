                ],
                "senses": [
                    {
                        "sense_id": "dbd5d0d3-e716-356d-bc3d-53192b0c2116",
                        "entry_id": "a8c3a260-c27e-3d0b-b827-23b6aa6e90e2",
                        "glosses": [
                            "Philosophie der Sprache; „im Rahmen der Philosophie Vielzahl von Bestrebungen und Richtungen, die sich mit Fragen über Ursprung, Eigenschaften, Funktionsweise und Leistung von Sprache beschäftigen“, mit einem Schwerpunkt auf interdisziplinären Fragestellungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23fa6e0d-7bfd-4162-a9d2-531d8342e493",
                                "sense_id": "dbd5d0d3-e716-356d-bc3d-53192b0c2116",
                                "text": "Lorenz entwickelt in seinem Überblicksartikel ein Panorama von Themen der Sprachphilosophie."
                            },
                            {
                                "example_id": "64d84a95-07e2-4069-8718-7653934b77fb",
                                "sense_id": "dbd5d0d3-e716-356d-bc3d-53192b0c2116",
                                "text": "„Alle heute maßgebenden Richtungen der Linguistik und der Sprachphilosophie haben in irgendeiner Beziehung an die Forschungen des bedeutenden Schweizer Sprachwissenschaftlers Ferdinand de Saussure (1857-1913) angeknüpft.“"
                            },
                            {
                                "example_id": "85b3a4f1-1b94-4ca8-ab51-db9b9ff67942",
                                "sense_id": "dbd5d0d3-e716-356d-bc3d-53192b0c2116",
                                "text": "Zu August Schleicher führt Arens aus: „Einerseits trennt er, was bei Humboldt eins war: spezielle und allgemeine Sprachwissenschaft, andererseits sanktioniert er den bestehenden Zustand der einseitigen Pflege der speziellen Sprachwissenschaft, erhebt aber das, was man im allgemeinen Sprachphilosophie nennt, zum zusammenfassenden und sinngebenden Überbau, ohne den alles übrige nur eine Sammlung von Einzelgrammatiken wäre.“"
                            },
                            {
                                "example_id": "98e4da30-c846-4171-b813-57b40f9c90d2",
                                "sense_id": "dbd5d0d3-e716-356d-bc3d-53192b0c2116",
                                "text": "Der Herausgeber über Benjamin Lee Whorf: „Seine eigentliche und außergewöhnliche Bedeutung liegt jedoch auf den Gebieten der sogenannten Metalinguistik und der Sprachphilosophie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
