                {
                    "sense_id": "3b448063-815d-339c-b536-0465e3e97738",
                    "sense_definition": "upaść gwałtownie, runąć lub załamać się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "upadek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary mur wreszcie <w>legł</w> pod naporem silnego wiatru i ulewnego deszczu.",
                            "target_lang_translations": {
                                "ru": "Старая стена наконец <w>рухнула</w> под напором сильного ветра и проливного дождя."
                            }
                        },
                        {
                            "text": "Wszystkie ich ambitne plany nagle <w>legły</w> w gruzach z powodu kryzysu finansowego.",
                            "target_lang_translations": {
                                "ru": "Все их амбициозные планы внезапно <w>разбились</w> в прах из-за финансового кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "upaść",
                        "paść",
                        "zwalić się"
                    ],
                    "common_phrases": [
                        "lec w gruzach"
                    ],
                    "target_lang_definitions": {
                        "ru": "рухнуть, повалиться или разрушиться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "упасть, обвалиться"
                            },
                            {
                                "target_lang_word": "пасть",
                                "target_lang_sense_clarification": "разрушиться, обрушиться"
                            },
                            {
                                "target_lang_word": "повалиться",
                                "target_lang_sense_clarification": "упасть на землю"
                            }
                        ]
                    }
