                        "entry_id": "341c683a-de61-3239-852e-8b72f53324c5",
                        "glosses": [
                            "To add too many annotations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a391b3-c6c8-4c43-ab64-e6529d75c1b1",
                                "sense_id": "9bbc6aab-5f86-3f14-9c7f-22023c068e3f",
                                "text": "In most instances, a majority of the notes will be focused here, since one can never overannotate in the area of fundamental meaning."
                            },
                            {
                                "example_id": "7bda376b-fbb4-4be1-ac8e-30813161e30b",
                                "sense_id": "9bbc6aab-5f86-3f14-9c7f-22023c068e3f",
                                "text": "Care must be taken not to overannotate."
                            },
                            {
                                "example_id": "64d328eb-86c3-4a00-9d44-aca89649e7d9",
                                "sense_id": "9bbc6aab-5f86-3f14-9c7f-22023c068e3f",
                                "text": "I do tell them that if they overannotate they will kill the book, and that if they underannotate they will not get to levels of deeper reading."
                            }
                        ]
                    }
