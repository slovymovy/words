                    "frequency": "Middle",
                    "semantic_group_id": "sensibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette magnifique mélodie a touché le fond de son <w>âme</w>."
                        },
                        {
                            "text": "Il a agi en toute bonne foi et en son <w>âme</w> et conscience."
