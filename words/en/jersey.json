                },
                {
                    "sense_id": "fffe2ed2-340b-3336-bb1d-da5ea10aae61",
                    "sense_definition": "A cow of a breed originally from the Island of Jersey, known for producing milk with high butterfat content.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a herd of <w>Jerseys</w> for their rich and creamy milk.",
                            "target_lang_translations": {
                                "ru": "Фермер держит стадо <w>коров джерсейской породы</w> ради их жирного и сливочного молока.",
                                "zh": "农场主养了一群<w>泽西牛</w>，因为它们的奶质浓郁香醇。"
                            }
                        },
                        {
                            "text": "A purebred <w>Jersey</w> is relatively small compared to other dairy cattle.",
                            "target_lang_translations": {
                                "ru": "Чистокровная <w>джерси</w> относительно мала по сравнению с другим молочным скотом.",
                                "zh": "与其他奶牛相比，纯种<w>泽西牛</w>体型相对较小。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Jersey cow",
                        "herd of Jerseys"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порода коров родом с острова Джерси, известная молоком с высокой жирностью.",
                        "zh": "原产于泽西岛的一种奶牛品种，以产出高乳脂含量的牛奶而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джерсейская порода",
                                "target_lang_sense_clarification": "порода коров"
                            },
                            {
                                "target_lang_word": "джерси",
                                "target_lang_sense_clarification": "корова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泽西牛",
                                "target_lang_sense_clarification": "奶牛品种"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3955cd4a-ba0f-3141-a420-95e6363c23e2",
                    "sense_definition": "An island in the English Channel between France and England; the largest of the Channel Islands.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They took a ferry to <w>Jersey</w> for their summer holiday.",
                            "target_lang_translations": {
                                "ru": "Они сели на паром до <w>Джерси</w>, чтобы провести там летний отпуск.",
                                "zh": "他们乘渡轮去<w>泽西岛</w>度暑假。"
                            }
                        },
                        {
                            "text": "The laws in <w>Jersey</w> are slightly different from those in the United Kingdom.",
                            "target_lang_translations": {
                                "ru": "Законы на <w>Джерси</w> немного отличаются от законов в Соединенном Королевстве.",
                                "zh": "<w>泽西岛</w>的法律与英国的法律略有不同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "island of Jersey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остров в проливе Ла-Манш между Францией и Англией; самый крупный из Нормандских островов.",
                        "zh": "位于英吉利海峡的岛屿，是海峡群岛中最大的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джерси",
                                "target_lang_sense_clarification": "остров"
