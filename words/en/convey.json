{
    "word_family": [
        "conveyance",
        "conveyor",
        "conveyable",
        "reconvey"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b59dd74-bc91-3bc2-a60c-213a2153733d",
                    "sense_definition": "To make ideas, feelings, or information known or understood by someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>convey</w> my sincere apologies to your manager for the delay.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>передайте</w> мои искренние извинения вашему менеджеру за задержку.",
                                "pl": "Proszę, <w>przekaż</w> moje szczere przeprosiny swojemu menedżerowi za opóźnienie."
                            }
                        },
                        {
                            "text": "The artist used dark colors to <w>convey</w> a sense of sadness and isolation.",
                            "target_lang_translations": {
                                "ru": "Художник использовал темные цвета, чтобы <w>передать</w> чувство грусти и одиночества.",
                                "pl": "Artysta użył ciemnych barw, aby <w>wyrazić</w> poczucie smutku i izolacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "express",
                        "relay",
                        "impart",
                        "communicate"
                    ],
                    "common_phrases": [
                        "convey a message",
                        "convey a sense",
                        "convey meaning",
                        "convey information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщать, выражать или делать понятными идеи, чувства или информацию.",
                        "pl": "Przekazywać, wyrażać lub czynić zrozumiałymi idee, uczucia lub informacje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "сообщение, информацию, чувства"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "эмоции, смысл"
                            },
                            {
                                "target_lang_word": "доносить",
                                "target_lang_sense_clarification": "смысл до собеседника"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przekazywać",
                                "target_lang_sense_clarification": "informacje, wiadomości, uczucia"
                            },
                            {
                                "target_lang_word": "wyrażać",
                                "target_lang_sense_clarification": "emocje, sens, idee"
                            },
                            {
                                "target_lang_word": "donosić",
                                "target_lang_sense_clarification": "przekazywać sens lub treść"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1b7744-1618-30a9-a7dd-48b6a9aa58dc",
                    "sense_definition": "To transport or carry something from one place to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Large trucks are used to <w>convey</w> goods from the factory to the store.",
                            "target_lang_translations": {
                                "ru": "Большие грузовики используются, чтобы <w>перевозить</w> товары с завода в магазин.",
                                "pl": "Duże ciężarówki są używane do <w>przewożenia</w> towarów z fabryki do sklepu."
                            }
                        },
                        {
                            "text": "The pipes are designed to <w>convey</w> hot water throughout the building.",
                            "target_lang_translations": {
                                "ru": "Трубы предназначены для того, чтобы <w>транспортировать</w> горячую воду по всему зданию.",
                                "pl": "Rury są zaprojektowane tak, aby <w>transportować</w> gorącą wodę w całym budynku."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "carry"
                    ],
                    "common_phrases": [
                        "convey goods",
                        "convey water",
                        "convey sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить или перемещать что-либо из одного места в другое.",
                        "pl": "Transportować lub przemieszczać coś z jednego miejsca do drugiego."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить",
                                "target_lang_sense_clarification": "грузы, товары"
                            },
                            {
                                "target_lang_word": "транспортировать",
                                "target_lang_sense_clarification": "техническое или официальное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przewozić",
                                "target_lang_sense_clarification": "towary, ładunki"
                            },
                            {
                                "target_lang_word": "transportować",
                                "target_lang_sense_clarification": "techniczne lub formalne przemieszczanie"
                            },
                            {
                                "target_lang_word": "przenosić",
                                "target_lang_sense_clarification": "przemieszczać coś niosąc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2631346d-f0de-3efa-86bd-4fabf3da6e0a",
                    "sense_definition": "To take or carry someone to a specific destination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An ambulance was called to <w>convey</w> the injured player to the hospital.",
                            "target_lang_translations": {
                                "ru": "Была вызвана скорая помощь, чтобы <w>доставить</w> травмированного игрока в больницу.",
                                "pl": "Wezwano karetkę, aby <w>dostarczyć</w> kontuzjowanego zawodnika do szpitala."
                            }
                        },
                        {
                            "text": "A private carriage was waiting to <w>convey</w> the guests to the wedding venue.",
                            "target_lang_translations": {
                                "ru": "Частный экипаж ожидал, чтобы <w>доставить</w> гостей к месту проведения свадьбы.",
                                "pl": "Prywatny powóz czekał, by <w>przewieźć</w> gości na miejsce ślubu."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "escort",
                        "conduct",
                        "accompany"
                    ],
                    "common_phrases": [
                        "convey passengers",
                        "convey someone home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доставлять или отвозить кого-либо в определенное место.",
                        "pl": "Zabrać lub przewieźć kogoś do określonego miejsca docelowego."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставлять",
                                "target_lang_sense_clarification": "пассажиров, людей к месту назначения"
                            },
                            {
                                "target_lang_word": "перевозить",
                                "target_lang_sense_clarification": "людей (транспортом)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dostarczać",
                                "target_lang_sense_clarification": "osoby do miejsca przeznaczenia"
                            },
                            {
                                "target_lang_word": "przewozić",
                                "target_lang_sense_clarification": "osoby środkiem transportu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36a21849-6c66-30c1-adbc-e86b8f0a4a77",
                    "sense_definition": "To officially transfer the legal ownership of property or land to someone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deed serves to <w>convey</w> the title of the property to the new owner.",
                            "target_lang_translations": {
                                "ru": "Этот документ служит для того, чтобы <w>передать</w> правовой титул на собственность новому владельцу.",
                                "pl": "Akt notarialny służy do <w>przeniesienia</w> prawa własności nieruchomości na nowego właściciela."
                            }
                        },
                        {
                            "text": "He decided to <w>convey</w> ownership of the company to his daughter.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>передать</w> право собственности на компанию своей дочери.",
                                "pl": "Postanowił <w>przekazać</w> własność firmy swojej córce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convey title",
                        "convey ownership",
                        "convey property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально передавать юридические права собственности на имущество или землю.",
                        "pl": "Oficjalnie przekazywać prawa własności do nieruchomości lub ziemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "права, собственность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przenosić",
                                "target_lang_sense_clarification": "prawa własności"
                            },
                            {
                                "target_lang_word": "scedować",
                                "target_lang_sense_clarification": "formalne przekazanie praw"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84a76ce5-c401-3b23-b271-54eaa7328561",
                    "sense_definition": "To take something away secretly or steal it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief managed to <w>convey</w> the jewels out of the palace unseen.",
                            "target_lang_translations": {
                                "ru": "Вору удалось <w>вынести</w> драгоценности из дворца незамеченным.",
                                "pl": "Złodziejowi udało się niezauważenie <w>wynieść</w> klejnoty z pałacu."
                            }
                        },
                        {
                            "text": "He was accused of trying to <w>convey</w> the money into his own pocket.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в попытке <w>переправить</w> деньги в свой собственный карман.",
                                "pl": "Oskarżono go o próbę <w>przerzucenia</w> pieniędzy do własnej kieszeni."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно уносить или красть что-либо.",
                        "pl": "Potajemnie wynosić lub kraść coś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похищать",
                                "target_lang_sense_clarification": "устаревшее значение"
                            },
                            {
                                "target_lang_word": "уносить",
                                "target_lang_sense_clarification": "тайно"
                            },
                            {
                                "target_lang_word": "переправлять",
                                "target_lang_sense_clarification": "тайно перемещать что-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wynosić",
                                "target_lang_sense_clarification": "potajemnie"
                            },
                            {
                                "target_lang_word": "kraść",
                                "target_lang_sense_clarification": "użycie archaiczne"
                            },
                            {
                                "target_lang_word": "przerzucać",
                                "target_lang_sense_clarification": "potajemnie przenieść, przemycić"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe521ae-6c66-305e-a130-a9d0e457bb8a",
                    "sense_definition": "To manage or carry out a matter, often with privacy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought to <w>convey</w> the business without alerting his rivals.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>вести</w> дела, не настораживая соперников.",
                                "pl": "Starał się <w>prowadzić</w> interesy, nie alarmując swoich rywali."
                            }
                        },
                        {
                            "text": "The diplomat had to <w>convey</w> the matter with great discretion.",
                            "target_lang_translations": {
                                "ru": "Дипломат должен был <w>вести</w> это дело с большой осмотрительностью.",
                                "pl": "Dyplomata musiał <w>prowadzić</w> tę sprawę z wielką dyskrecją."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или осуществлять дело, часто конфиденциально.",
                        "pl": "Zarządzać lub prowadzić sprawę, często w sposób dyskretny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "дела, бизнес"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "prowadzić",
                                "target_lang_sense_clarification": "sprawy, interesy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}