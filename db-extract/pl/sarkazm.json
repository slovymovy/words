                "senses": [
                    {
                        "sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "glosses": [
                            "złośliwy, pesymistyczny sposób wyrażania się o rzeczywistości, spotęgowana ironia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ba3d10c-0417-4871-b52b-d058d23f415c",
                                "sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                                "text": "Przyzwyczajenie do ironii, tak samo jak przyzwyczajenie do sarkazmu, psuje zresztą charakter, stopniowo nadaje mu cechy wyższości, radującej się z cudzej krzywdy…"
                            },
                            {
                                "example_id": "464372a5-ce0e-4a89-b5d5-2cb4e6e1b3da",
                                "sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                                "text": "Francuski antropolog Claude Levi-Strauss w jednym z wywiadów stwierdził z sarkazmem, że 75 procent wysiłku współczesnych naukowców idzie na rozwiązywanie nieoczekiwanych problemów stwarzanych przez naukę i technikę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e939752d-be44-4557-92f0-f302575c8662",
                        "source_entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "source_sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "target_lang_word": "sarcasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345cf3da-79c3-38cb-b865-835ee839ffa2",
                                        "entry_id": "0236e9fd-fa86-39fe-8d00-ec55fc37b896",
                                        "glosses": [
                                            "Use of acerbic language to mock or convey contempt, often using verbal irony and (in speech) often marked by overemphasis and sneering."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63e8371-c776-4fd3-baf6-0886b24b1461",
                                                "sense_id": "345cf3da-79c3-38cb-b865-835ee839ffa2",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "321904ff-b632-42dc-a4d4-a9992f434ca2",
                                                "sense_id": "345cf3da-79c3-38cb-b865-835ee839ffa2",
                                                "text": "2015, Alex Kozinski, Demuth v. County of Los Angeles, 798 F.3d 837, 839 (9th Cir. 2015).\nWhile challenging someone equipped with a badge, handcuffs and a gun to “arrest me” was unwise on Demuth’s part, we fail to see what legal difference her statement makes. Demuth certainly could not authorize her own arrest and, in any event, Li could not reasonably have believed that Demuth was volunteering for handcuffs. Demuth was obviously employing “a literary device known as sarcasm.” [Citation omitted.] Her statement was a snide way of refusing; no reasonable officer could have thought otherwise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14a81f70-7beb-3c33-a60f-f9113e053c0d",
                                        "entry_id": "0236e9fd-fa86-39fe-8d00-ec55fc37b896",
                                        "glosses": [
                                            "An individual act of the above."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d17d2d94-9c4e-458b-9238-d2036faf1776",
                        "source_entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "source_sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "target_lang_word": "sarkasmus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarkasmus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "811ec9ee-cf13-3990-b9a1-6ac9cde67ea9",
                                        "entry_id": "0aefeafb-d352-3ce4-9e32-a8cd405e4c15",
                                        "glosses": [
                                            "výrok nebo výroky vyjadřující opak jejich skutečného významu, sloužící ke kritice nebo zesměšnění"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784e5b29-fc44-4d96-9d47-991b5fd7e933",
                                                "sense_id": "811ec9ee-cf13-3990-b9a1-6ac9cde67ea9",
                                                "text": "Mohl bys na chvíli přestat s tím svým sarkasmem?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d93a2a55-191f-4984-9a7c-84299c4705ef",
                        "source_entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "source_sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "target_lang_word": "sarcasme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b73a97fd-acff-371b-a50d-71c402cef191",
                                        "entry_id": "feb74e49-bcf5-350c-a35f-fafaa44161f1",
                                        "glosses": [
                                            "Raillerie amère et cruelle ; ironie méchante, mordante, acerbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b733347-484e-4df1-a335-48920f24c0db",
                                                "sense_id": "b73a97fd-acff-371b-a50d-71c402cef191",
                                                "text": "Il y a un tour de Fiction, au moyen duquel la pensée ne doit pas être entendue littéralement comme elle est énoncée, mais qui laisse apercevoir le véritable point de vûe en le rendant seulement plus sensible & plus intéressant par la Fiction même. De là naissent l’Hyperbole, la Litote, l’Interrogation, la Dubitation, la Prétérition, la Réticence, l’Interruption, le Dialogisme, l’Épanorthose, l’Épitrope, & l’Ironie ; celle-ci se soudivise, à raison des points de vûe ou des tons, en six espèces ; savoir, la Mimèse, le Chleuasme ou Persifflage, l’Astéisme, le Charientisme, le Diasirme, & le Sarcasme."
                                            },
                                            {
                                                "example_id": "e0d820a1-7b95-4b73-9dc0-08374e48124b",
                                                "sense_id": "b73a97fd-acff-371b-a50d-71c402cef191",
                                                "text": "Veut-on avoir la preuve de la parfaite inutilité de tous les livres de morale, de sermons, etc. ? Il n’y a qu’à jeter les yeux sur le préjugé de la noblesse héréditaire. Y a-t-il un travers contre lequel les philosophes, les orateurs, les poètes, aient lancé plus de traits satiriques, qui ait plus exercé les esprits de toute espèce, qui ait fait naître plus de sarcasmes ?"
                                            },
                                            {
                                                "example_id": "266fe509-3008-4c5c-8a81-d2493a3f8fa1",
                                                "sense_id": "b73a97fd-acff-371b-a50d-71c402cef191",
                                                "text": "Dès les premières attaques, elle couvrit de sarcasmes plaisants Caylus et ses alliés."
                                            },
                                            {
                                                "example_id": "9a2ce730-e1ae-4e91-93b5-471521b19892",
                                                "sense_id": "b73a97fd-acff-371b-a50d-71c402cef191",
                                                "text": "Antoine passa le nez en l’air, apostolique, indifférent aux sarcasmes de ces populations rurales à peine frottées de civilisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c65d2526-4228-4868-8f12-73cbbb6428bb",
                        "source_entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "source_sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "target_lang_word": "sarcasmo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcasmo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "12f2a584-e1a1-3890-b36e-809c671e7e9f",
                                        "entry_id": "628b4e7e-296a-39f3-9a9b-234b8b2d61d5",
                                        "glosses": [
                                            "Un tipo de ironía que se realiza con el fin de herir u ofender a una persona o institución."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4675522-59f3-4e00-8b09-58a48f31c150",
                        "source_entry_id": "3c96cbff-0fc1-328d-9295-263ea2e6ae5f",
                        "source_sense_id": "1fe50636-eb83-30ac-9737-a52e6921629b",
                        "target_lang_word": "Sarkasmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarkasmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                        "entry_id": "25e8a4a3-7c18-33e8-865f-3f78561c606a",
                                        "glosses": [
                                            "beißender, verletzender Hohn oder Spott"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e197df56-3cb2-4b73-bd9a-f6ff0bf64cc4",
                                                "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                                "text": "Was ist der Unterschied zwischen Sarkasmus und Zynismus?"
                                            },
                                            {
                                                "example_id": "1f41c5e3-0d26-46f1-88a3-82293b133520",
                                                "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                                "text": "„Sein Lächeln war wärmer und breiter, als meine sarkastische Bemerkung es rechtfertigte; aber dann begriff ich, dass er den Sarkasmus gar nicht bemerkt hatte.“"
                                            },
                                            {
                                                "example_id": "3a7243da-7a62-4085-bfab-8ec6ad99c633",
                                                "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                                "text": "„Ironie und Sarkasmus sind nur eine Schutzfolie, die den Verlustschmerz frisch hält.“"
                                            },
                                            {
                                                "example_id": "47e73515-e8f0-46df-9872-9f3bd577638e",
                                                "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                                "text": "„Es kommt auch vor, daß der Künstler zu Lebzeiten aus kindlicher Verschmitztheit, aus Sarkasmus oder auch bloß aus morbider Neugier, zu sehen, wieweit Dummheit gehen kann, den Bürgerschreck zu spielen versucht.“"
                                            },
                                            {
                                                "example_id": "035d9527-ba3e-47e7-b325-4b28cc02403c",
                                                "sense_id": "02a4f5de-1dcd-3219-bf6b-e85516e25c14",
                                                "text": "„Ich war noch sehr jung und weder Herr meines Sarkasmus noch meines Tonfalls.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49a1e541-cb81-36ad-baf4-4b082f720fcd",
