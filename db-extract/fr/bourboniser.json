                "senses": [
                    {
                        "sense_id": "79c8b745-3165-35fe-bdce-b54bfc19a360",
                        "entry_id": "267f9b64-af22-3be8-9c59-10fb0b1746fa",
                        "glosses": [
                            "Donner un caractère bourbonien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8de7bd2-74bd-4fc8-874e-afa54158935d",
                                "sense_id": "79c8b745-3165-35fe-bdce-b54bfc19a360",
                                "text": "Masquer de honteuses dilapidations, en autoriser de plus honteuses encore, essayer de faire venir la servitude du fond de l’Espagne, bourboniser une armée nationale, et métamorphoser un idiot en héros, tel était le quintuple but que se proposait la congrégation."
                            },
                            {
                                "example_id": "10f36cc6-d887-4aef-912a-50d9d87c708a",
                                "sense_id": "79c8b745-3165-35fe-bdce-b54bfc19a360",
                                "text": "Le nez commence à se busquer, à se « bourboniser », justifiant le sobriquet qui va bientôt le poursuivre de « Long-nez », le nez de François Iᵉʳ."
                            }
                        ]
                    }
                ],
