                            "participle",
                            "past"
                        ],
                        "form": "угора́здив"
                    },
                    {
                        "form_id": "f42c95bf-c363-4907-bd2b-ff09efbae73c",
                        "entry_id": "f6b23319-5879-3466-968a-137ee0900130",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "угора́здивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                        "entry_id": "f6b23319-5879-3466-968a-137ee0900130",
                        "glosses": [
                            "безл., разг. побудить, надоумить кого-либо сделать, устроить что либо (обычно ненужное, нелепое, в ущерб себе)"
                        ],
                        "tags": [
                            "кого с инф."
                        ],
                        "examples": [
                            {
                                "example_id": "4c4272a9-0666-4770-8b4f-9c4e38c07085",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "― Где это тебя угораздило выучиться по-французски, а?"
                            },
                            {
                                "example_id": "c1859922-9e59-45b3-b1f9-562c584c0764",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "Из чего вдруг угораздило тебя сказать, что у меня седой волос?"
                            },
                            {
                                "example_id": "5cc5e503-e673-4e91-a0bb-b0b93f7c1d37",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "Господин этот присвистывал, потому что однажды, когда он запрягал лошадь, ту угораздило как-то вышибить ему два передних зуба."
                            },
                            {
                                "example_id": "249fa7dc-101b-4d24-8877-8a49d0fe7cae",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "Угораздило ж меня с этой Парашкой связаться!.."
                            },
                            {
                                "example_id": "a1b1498c-347c-4395-99f6-e4d359645837",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "― А кто её знает, что её черт угораздил сделать!"
                            },
                            {
                                "example_id": "97295705-f6be-4200-8ac9-5ad885c69e82",
                                "sense_id": "900644e5-3967-3692-9bee-12f5126704b9",
                                "text": "Только вижу, что тут же, в швейцарской, и камердинер особы стоит ― и угоразди меня нелегкая в разговор с ним вступить."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad28ff3a-1886-33a6-abc7-b69c9b13b8ba",
                        "entry_id": "f6b23319-5879-3466-968a-137ee0900130",
                        "glosses": [
                            "разг. попасть, угодить куда-либо"
                        ],
                        "tags": [
                            "во что."
                        ],
                        "examples": [
                            {
                                "example_id": "4191c77f-92e1-4209-ae8b-7fcc88ac4c87",
                                "sense_id": "ad28ff3a-1886-33a6-abc7-b69c9b13b8ba",
                                "text": "― В прошлом году, в посту, из барабана зуб выскочил и угораздил прямо в старика Калмыкова, в голову, так что мозг видать было, и доктор сказал, что помрёт; одначе, до сих пор жив и работает, только после этой штуки заикаться стал."
                            }
                        ]
                    }
                ],
