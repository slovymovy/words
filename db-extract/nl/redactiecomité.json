                            {
                                "example_id": "2bf976e9-674f-4dd8-a5d2-0e9afba2e8b2",
                                "sense_id": "dccb41ee-5ca7-3da4-b050-c2146aa1463b",
                                "text": "Het redactiecomité ‘wil de burgers informeren dat de personeelsleden van de publieke omroep van Spanje (RTVE) veel beter zouden kunnen doen, maar dat dat wordt verhinderd’, zo zegt het orgaan in een mededeling."
                            },
                            {
                                "example_id": "66acda9f-5e16-4c65-9c3e-0abf633661ea",
                                "sense_id": "dccb41ee-5ca7-3da4-b050-c2146aa1463b",
                                "text": "Daarnaast wordt het redactiecomité, dat de redactionele lijn van het agentschap uitzet en de niet-ondertekende editorialen opstelt, opgeschort."
                            }
                        ]
