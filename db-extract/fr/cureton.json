                "senses": [
                    {
                        "sense_id": "ecc259f4-a55c-3f77-9b8a-b4713326894d",
                        "entry_id": "5140abf8-a541-3011-bedd-6d74d4bc941a",
                        "glosses": [
                            "Prêtre, curé."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9d8e718e-b0f0-4b1e-993c-8596f2673e10",
                                "sense_id": "ecc259f4-a55c-3f77-9b8a-b4713326894d",
                                "text": "Comme Brown avait fait ses études chez les jésuites, les flics disaient de lui que c’était le cureton le plus cinglé depuis Raspoutine, le penchant pour la fesse en moins."
                            },
                            {
                                "example_id": "45a11d89-5fbe-4e1e-bf21-a7a78b760f4f",
                                "sense_id": "ecc259f4-a55c-3f77-9b8a-b4713326894d",
                                "text": "Zeitsev avait deux idoles : le pape et « padre Piou » comme il disait, en fait le padre Pio, cureton italien, sorte de demi-saint illuminé ou quelque chose comme ça."
                            },
                            {
                                "example_id": "686616d3-f6a0-4f72-b373-d55d1fcde35a",
                                "sense_id": "ecc259f4-a55c-3f77-9b8a-b4713326894d",
                                "text": "– Je donnerai de tes nouvelles aux copains et je te promets de repasser un de ces soirs avant que tu partes chez les curetons."
                            }
                        ]
                    }
                ],
