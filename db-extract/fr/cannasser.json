                "senses": [
                    {
                        "sense_id": "b15ea228-1edc-3590-8b25-faa20c0b5a5b",
                        "entry_id": "d3ee0f1d-7596-3f3f-abc0-47479959c1b9",
                        "glosses": [
                            "Verrouiller, cadenasser, en particulier en parlant de quelque chose qu’on veut cacher, qu’on ne veut pas divulguer. Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "e61c67bc-c97c-4351-ae61-78bd3b0516f6",
                                "sense_id": "b15ea228-1edc-3590-8b25-faa20c0b5a5b",
                                "text": "Dans ce pays, il y a le principe de la séparation des Pouvoirs qui permet au Pouvoir judiciaire de cannasser divers dossiers afin de protéger des secrets de la Loge, tel que le dossier de Julie et Melissa et bien d'autres."
                            },
                            {
                                "example_id": "294f9dab-def3-4845-bb82-72b11fef72bb",
                                "sense_id": "b15ea228-1edc-3590-8b25-faa20c0b5a5b",
                                "text": "Les médias ne veulent agir pour la liberté d'un peuple, La Belgique est un petit pays et il est facile de cannasser la vérité."
                            },
                            {
                                "example_id": "e56cb618-14b2-4bbd-bfef-acddad971473",
                                "sense_id": "b15ea228-1edc-3590-8b25-faa20c0b5a5b",
                                "text": "Comme je le signale souvent, on peut cannasser une vérité dans des services, mais on ne peux jamais empêcher qu'elle triomphe."
                            },
                            {
                                "example_id": "5c17b6e8-636d-49c1-a7ca-f945d8a57a1e",
                                "sense_id": "b15ea228-1edc-3590-8b25-faa20c0b5a5b",
                                "text": "Savez-vous qu'au SAJ de Liège, des dossiers sont cannassés et au détriment d'enfants."
                            }
                        ]
                    }
                ],
