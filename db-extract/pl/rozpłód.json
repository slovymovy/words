                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierzucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef3bc602-8ae0-31e9-81b6-e2d7caded394",
                                        "entry_id": "b1af957c-b1e5-3407-9b28-707bc3292fe7",
                                        "glosses": [
                                            "kontrollierte Vermehrung von Tieren mit dem Ziel, die gewünschten Eigenschaften an die Nachkommen weiterzuvererben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09864c52-5c83-45bc-bedf-61b1497ee488",
                                                "sense_id": "ef3bc602-8ae0-31e9-81b6-e2d7caded394",
                                                "text": "„Daß sich in der Tierzucht der Fortschritt langsamer vollzieht als in der Pflanzenzucht, ist wohl begreiflich, da z.B. bei Pferden und Rindern die Neuzucht einer Generation mehrere Jahre in Anspruch nimmt, während die Pflanzen alljährlich Samen und Nachwuchs bringen“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36f59d6d-eacf-4dd6-8849-abc0beaca8cd",
                        "source_entry_id": "980c059d-d039-35be-9aa7-14fb8f14df5c",
                        "source_sense_id": "cd4390ae-2781-33fd-bc3d-a4a219bacb12",
                        "target_lang_word": "Zucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcc6b0c7-87f7-3985-8beb-ae19d2e6f2e7",
                                        "entry_id": "620b1a90-a5aa-3d05-baeb-c7c9759f9293",
                                        "glosses": [
                                            "die kontrollierte Vermehrung von Pflanzen oder Tieren mit dem Ziel, die gewünschten Eigenschaften an die Nachkommen weiterzuvererben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3680ddd5-0096-42e1-bee7-51704e4a83f4",
                                                "sense_id": "bcc6b0c7-87f7-3985-8beb-ae19d2e6f2e7",
                                                "text": "Die Zucht von gentechnisch veränderten Mais ist sehr umstritten."
                                            },
                                            {
                                                "example_id": "1c4c0a26-e88c-46d4-9535-ab2e125e10e9",
                                                "sense_id": "bcc6b0c7-87f7-3985-8beb-ae19d2e6f2e7",
                                                "text": "„Man kultivierte die nobleren Beschäftigungen, nicht nur das Tennisspiel, sondern vor allem die Jagd und die Zucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "785e05da-f408-3a0d-be7a-bdb037907652",
                                        "entry_id": "620b1a90-a5aa-3d05-baeb-c7c9759f9293",
                                        "glosses": [
                                            "durch [1] entstandene Pflanzen oder Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd117d2c-d27b-47b4-868e-10cfb8967f64",
                                                "sense_id": "785e05da-f408-3a0d-be7a-bdb037907652",
                                                "text": "Die Zucht von diesem Jahr muss komplett gegen Parasiten geimpft werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d56dcba-7acf-3c1a-a3ba-70432a9fe9df",
                                        "entry_id": "620b1a90-a5aa-3d05-baeb-c7c9759f9293",
                                        "glosses": [
