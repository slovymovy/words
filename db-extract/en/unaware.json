                                        "glosses": [
                                            "geistig abwesend, nicht auf eine Sache konzentriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf09ff20-1932-4cc2-a2db-833b285e9246",
                                                "sense_id": "5f68d1f6-71f1-3e8b-817e-57d535da6e7a",
                                                "text": "Der Schüler wirkte sehr unaufmerksam während des Unterrichts und nicht bei der Sache."
                                            },
                                            {
                                                "example_id": "2a972307-9070-48eb-856f-49567c291e70",
                                                "sense_id": "5f68d1f6-71f1-3e8b-817e-57d535da6e7a",
                                                "text": "„Extrem unaufmerksames Verhalten kann schnell zu Unfällen führen.“"
                                            },
                                            {
                                                "example_id": "fe14c620-8cdb-4fdd-a828-b66d6d0e117e",
                                                "sense_id": "5f68d1f6-71f1-3e8b-817e-57d535da6e7a",
                                                "text": "„Origi hatte immerhin den Überblick, als Yunus Malli dem unaufmerksamen VfB-Außenverteidiger Andreas Beck den Ball abnahm und passte: Überlegt schob Origi die Kugel aus rund 20 Metern zur Führung ins lange Eck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e789f51f-057a-3bb2-8dec-5f45d9eb0053",
                                        "entry_id": "d4b9de89-7e39-3262-80f6-5577125bfbeb",
                                        "glosses": [
                                            "wenig Zuvorkommenheit zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5383e535-958d-4270-88c5-a8e8b354c4c9",
                                                "sense_id": "e789f51f-057a-3bb2-8dec-5f45d9eb0053",
                                                "text": "Wie unaufmerksam von mir! Deinen Geburtstag vor einer Woche habe ich leider ganz vergessen."
                                            },
                                            {
                                                "example_id": "97f04c60-fbad-4f18-8b56-aa0c0c7cbbdb",
                                                "sense_id": "e789f51f-057a-3bb2-8dec-5f45d9eb0053",
                                                "text": "„Bei diesen Anlässen beanspruchte ihn entweder Selina oder er diskutierte mit Dominik und Oliver über aktuelle und längst vergangene Ereignisse der Weltgeschichte. Was nicht hieß, dass er sich ihr gegenüber gleichgültig oder unaufmerksam verhielt.“"
                                            },
                                            {
                                                "example_id": "4823f56c-7efa-4920-8335-11ecdf715bf7",
                                                "sense_id": "e789f51f-057a-3bb2-8dec-5f45d9eb0053",
                                                "text": "„Wenn jemand unaufmerksam oder unhöflich ist, dann ärgert einen das.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
