{
    "word_family": [
        "разум",
        "разумный",
        "разуметь",
        "подразумевать",
        "недоразумение"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "04676ef4-24b7-32e0-ae6d-54cde8f2de16",
                    "sense_definition": "Вводное слово, выражающее уверенность в истинности высказывания; то же, что «конечно» или «безусловно».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>разумеется</w>, поможем вам с переездом в новую квартиру.",
                            "target_lang_translations": {
                                "en": "We will, <w>of course</w>, help you with the move to the new apartment.",
                                "tr": "Yeni daireye taşınmanızda size <w>elbette</w> yardımcı olacağız."
                            }
                        },
                        {
                            "text": "Это, <w>разумеется</w>, была всего лишь безобидная шутка.",
                            "target_lang_translations": {
                                "en": "It was, <w>naturally</w>, just a harmless joke.",
                                "tr": "Bu, <w>doğal olarak</w> sadece zararsız bir şakaydı."
                            }
                        }
                    ],
                    "synonyms": [
                        "безусловно",
                        "бесспорно",
                        "естественно",
                        "конечно",
                        "несомненно",
                        "само собой",
                        "очевидно"
                    ],
                    "antonyms": [
                        "вряд ли"
                    ],
                    "common_phrases": [
                        "само собой разумеется"
                    ],
                    "target_lang_definitions": {
                        "en": "An introductory word expressing confidence in the truth of a statement; equivalent to \"of course\" or \"undoubtedly\".",
                        "tr": "Bir ifadenin doğruluğuna olan güveni belirten giriş sözü; \"elbette\" veya \"kuşkusuz\" ile eş anlamlıdır."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of course",
                                "target_lang_sense_clarification": "standard expression of certainty"
                            },
                            {
                                "target_lang_word": "naturally",
                                "target_lang_sense_clarification": "implying something is expected or logical"
                            },
                            {
                                "target_lang_word": "certainly",
                                "target_lang_sense_clarification": "emphatic affirmation"
                            },
                            {
                                "target_lang_word": "obviously",
                                "target_lang_sense_clarification": "indicating something is easily perceived or understood"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "elbette",
                                "target_lang_sense_clarification": "kesinlik bildiren standart ifade"
                            },
                            {
                                "target_lang_word": "kuşkusuz",
                                "target_lang_sense_clarification": "şüphe duyulmadığını belirten ifade"
                            },
                            {
                                "target_lang_word": "doğal olarak",
                                "target_lang_sense_clarification": "beklenen veya mantıklı bir durumu ifade eder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7649e842-ae0f-3584-957b-25bca68f45f6",
                    "sense_definition": "Употребляется при ответе для выражения полного согласия или подтверждения; соответствует словам «да», «конечно».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты пойдёшь с нами в кино? — <w>Разумеется</w>!",
                            "target_lang_translations": {
                                "en": "Are you coming to the movies with us? — <w>Of course</w>!",
                                "tr": "Bizimle sinemaya gelecek misin? — <w>Elbette</w>!"
                            }
                        },
                        {
                            "text": "Можно мне взять эту книгу почитать? — <w>Разумеется</w>, бери.",
                            "target_lang_translations": {
                                "en": "Can I borrow this book to read? — <w>Certainly</w>, take it.",
                                "tr": "Bu kitabı okumak için alabilir miyim? — <w>Tabii ki</w>, alabilirsin."
                            }
                        }
                    ],
                    "synonyms": [
                        "конечно",
                        "естественно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in a response to express full agreement or confirmation; corresponds to \"yes\", \"certainly\".",
                        "tr": "Tam bir mutabakatı veya onayı ifade etmek için cevap olarak kullanılır; \"evet\", \"tabii ki\" sözcüklerine karşılık gelir."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of course",
                                "target_lang_sense_clarification": "common affirmative response"
                            },
                            {
                                "target_lang_word": "certainly",
                                "target_lang_sense_clarification": "polite agreement or permission"
                            },
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "casual agreement"
                            },
                            {
                                "target_lang_word": "by all means",
                                "target_lang_sense_clarification": "enthusiastic permission"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "elbette",
                                "target_lang_sense_clarification": "yaygın onaylama yanıtı"
                            },
                            {
                                "target_lang_word": "tabii ki",
                                "target_lang_sense_clarification": "kibar onay veya izin verme"
                            },
                            {
                                "target_lang_word": "elbette olur",
                                "target_lang_sense_clarification": "istekli bir şekilde izin verme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04547985-c03e-3998-8b58-fc1888351858",
                    "sense_definition": "Форма третьего лица единственного числа настоящего времени глагола <w>разуметься</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Под этим термином обычно <w>разумеется</w> совсем другое понятие.",
                            "target_lang_translations": {
                                "en": "By this term, a completely different concept is usually <w>meant</w>.",
                                "tr": "Bu terimle genellikle bambaşka bir kavram <w>kastedilmektedir</w>."
                            }
                        },
                        {
                            "text": "В этом договоре <w>разумеется</w>, что все расходы берёт на себя заказчик.",
                            "target_lang_translations": {
                                "en": "In this contract, it <w>is understood</w> that the client bears all costs.",
                                "tr": "Bu sözleşmede tüm masrafların müşteri tarafından karşılanacağı <w>anlaşılmaktadır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "само собой разумеется"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present indicative imperfective"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person singular present tense form of the verb \"разуметься\" (to be understood, to be meant).",
                        "tr": "\"разуметься\" (anlaşılmak, kastedilmek) fiilinin üçüncü tekil şahıs şimdiki zaman çekimi."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "is meant",
                                "target_lang_sense_clarification": "passive voice indicating signification"
                            },
                            {
                                "target_lang_word": "is understood",
                                "target_lang_sense_clarification": "passive voice indicating comprehension or agreement"
                            },
                            {
                                "target_lang_word": "is implied",
                                "target_lang_sense_clarification": "indicating something suggested without being explicitly stated"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kastedilmektedir",
                                "target_lang_sense_clarification": "bir şeyin anlamını belirtmek için edilgen çatı"
                            },
                            {
                                "target_lang_word": "anlaşılmaktadır",
                                "target_lang_sense_clarification": "bir durumun veya kuralın kabul edildiğini belirtmek için"
                            },
                            {
                                "target_lang_word": "ima edilmektedir",
                                "target_lang_sense_clarification": "açıkça söylenmeden kastedilen durumlar için"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}