                "senses": [
                    {
                        "sense_id": "f94a86df-8472-3072-a7e3-200157701197",
                        "entry_id": "10c2111c-0985-3eb9-8f3a-ac05028d6a00",
                        "glosses": [
                            "Linguistik: die an einem bestimmten Ort spezifische Varietät einer Mundart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6abcc1-c80c-464b-a354-4785d7ac91c8",
                                "sense_id": "f94a86df-8472-3072-a7e3-200157701197",
                                "text": "„Die grammatischen Systeme der einzelnen Ortsmundarten, das heißt im wesentlichen der in den einzelnen Mundarten vorhandenen Laute inklusive der Regeln ihrer Kombinierbarkeit, unterscheiden sich über weite Strecken nicht.“"
                            },
                            {
                                "example_id": "47b43fdd-09ed-4229-92ae-ccac0a641515",
                                "sense_id": "f94a86df-8472-3072-a7e3-200157701197",
                                "text": "„Eine zweite Idealisierung ging über die Ortsmundart hinaus, indem allen einerseits als ortsmundartlich qualifizierten Wörtern andererseits ein überregionales Semem zugeschrieben wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
