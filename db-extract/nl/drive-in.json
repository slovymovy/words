                                                "sense_id": "e84d256f-99db-3c88-a875-399815d04acc",
                                                "text": "I switched banks so that I could use a drive-through branch near my home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76f3bf4-db20-3b25-859a-58a276822339",
                                        "entry_id": "0cc0d47a-2411-323f-93bb-1de268db10cd",
                                        "glosses": [
                                            "Of a feature of such an establishment (especially a window), adapted to provide such service."
                                        ],
