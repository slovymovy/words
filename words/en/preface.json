{
    "word_family": [
        "prefatory",
        "prefaceless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                    "sense_definition": "An introductory section at the beginning of a book or document, typically written by the author, explaining its subject, scope, or aims.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "book_introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote a brief <w>preface</w> to explain why she decided to update the textbook."
                        },
                        {
                            "text": "I usually skip the <w>preface</w> of a book and start reading the first chapter directly."
                        }
                    ],
                    "synonyms": [
                        "foreword",
                        "introduction",
                        "prologue"
                    ],
                    "antonyms": [
                        "afterword",
                        "epilogue"
                    ],
                    "common_phrases": [
                        "brief preface",
                        "author's preface"
                    ]
                },
                {
                    "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                    "sense_definition": "An introduction or preliminary statement made before speaking or writing about the main subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without any further <w>preface</w>, let us begin our discussion on the quarterly budget."
                        },
                        {
                            "text": "His long <w>preface</w> to the announcement made everyone in the room feel very anxious."
                        }
                    ],
                    "synonyms": [
                        "preamble",
                        "introduction",
                        "prelude"
                    ],
                    "common_phrases": [
                        "without further preface"
                    ]
                },
                {
                    "sense_id": "5c8cbef0-44b7-3e1d-9f7e-87bb79fa4195",
                    "sense_definition": "A prayer of thanksgiving that serves as the introduction to the Eucharistic Prayer in Christian liturgy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liturgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The congregation stood as the priest began to chant the solemn <w>preface</w> of the Mass."
                        },
                        {
                            "text": "Each liturgical season has its own specific <w>preface</w> that highlights the theological theme of the day."
                        }
                    ]
                },
                {
                    "sense_id": "5bdd8572-5c21-3602-9281-26c2b657017c",
                    "sense_definition": "An honorific title or epithet placed before a person's name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was proud to have the <w>preface</w> of 'Doctor' added to his name after years of hard work."
                        },
                        {
                            "text": "The official document listed his full name along with the traditional <w>preface</w> of 'Sir'."
                        }
                    ],
                    "synonyms": [
                        "title",
                        "prefix",
                        "honorific"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0d4d107-3031-3614-9ca5-19c150a0d1a9",
                    "sense_definition": "To introduce or precede a statement, speech, or action with preliminary remarks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduce_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>preface</w> my remarks by thanking everyone for coming today."
                        },
                        {
                            "text": "She chose to <w>preface</w> her presentation with a short, humorous story to ease the tension."
                        }
                    ],
                    "synonyms": [
                        "introduce",
                        "precede",
                        "herald"
                    ],
                    "common_phrases": [
                        "preface my remarks",
                        "preface by saying"
                    ]
                },
                {
                    "sense_id": "3fbf5916-aaf6-3b27-9722-094a99c7b10c",
                    "sense_definition": "To provide a book, document, or speech with an introductory text or preface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "provide_introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <w>preface</w> the new edition with an essay by a prominent scholar."
                        },
                        {
                            "text": "It is customary to <w>preface</w> a historical biography with a timeline of key events."
                        }
                    ],
                    "synonyms": [
                        "introduce",
                        "foreword"
                    ],
                    "common_phrases": [
                        "preface a book"
                    ]
                }
            ]
        }
    ]
}