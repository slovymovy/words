                                        "entry_id": "8f87de01-fdcc-3a56-a375-0329f5e09398",
                                        "glosses": [
                                            "In a splendid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fcce73-54a0-4117-a43d-cdc48913978e",
                                                "sense_id": "b162371e-46a3-31f9-be2e-bf4020b58c78",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "e0d43273-e41c-49da-a692-142f59cd32c9",
                                                "sense_id": "b162371e-46a3-31f9-be2e-bf4020b58c78",
                                                "text": "\"Despite restrictions I did manage to talk a couple of colleagues into doing a sponsored walk [...]. Due to COVID-19 we had to organise this ourselves, but it went off splendidly and the three of us walked 12 miles along the Basing Canal on the River Wey and Thames. [...].\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29062edb-003f-4f7e-bada-b76939ccb16d",
                        "source_entry_id": "678df94c-873b-3733-9da1-57c995bc9fd1",
                        "source_sense_id": "f498504c-edc8-3536-b6e8-22fa50b18982",
                        "target_lang_word": "wonderfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wonderfully",
