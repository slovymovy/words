                                "target_lang_sense_clarification": "разговорное название марки автомобиля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ddcfca2f-118e-37ce-afd8-1b3928858b6d",
                    "sense_definition": "pierwszy w kolejności, oznaczający początkowy etap lub rodzaj (np. promieniowania, wersji oprogramowania)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Promieniowanie <w>alfa</w> ma niewielki zasięg w powietrzu.",
                            "target_lang_translations": {
                                "ru": "<w>Альфа-излучение</w> имеет небольшой радиус действия в воздухе."
                            }
                        },
                        {
                            "text": "Obecnie testujemy wczesną wersję <w>alfa</w> naszej aplikacji.",
                            "target_lang_translations": {
                                "ru": "В настоящее время мы тестируем раннюю <w>альфа-версию</w> нашего приложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "pierwszy"
                    ],
                    "antonyms": [
                        "ostatni"
                    ],
                    "common_phrases": [
                        "promieniowanie alfa",
                        "cząstka alfa",
                        "wersja alfa"
                    ],
                    "target_lang_definitions": {
                        "ru": "первый по порядку, обозначающий начальный этап или тип (например, излучения, версии ПО)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа-",
                                "target_lang_sense_clarification": "в составе сложных слов, например, альфа-версия"
                            },
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "в физике и ИТ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "997ecbe3-5649-3d00-ae4b-f6684f30cf81",
                    "sense_definition": "najważniejszy, dominujący w grupie (zwykle w odniesieniu do ludzi lub zwierząt)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_hierarchy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W stadzie wilków tylko samiec <w>alfa</w> ma prawo do rozmnażania.",
                            "target_lang_translations": {
                                "ru": "В волчьей стае только <w>альфа-самец</w> имеет право на размножение."
                            }
                        },
                        {
                            "text": "On zachowuje się w biurze jak typowy samiec <w>alfa</w>.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя в офисе как типичный <w>альфа-самец</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "numer jeden"
                    ],
                    "common_phrases": [
                        "samiec alfa"
                    ],
                    "target_lang_definitions": {
                        "ru": "самый важный, доминирующий в группе (обычно о людях или животных)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альфа-",
                                "target_lang_sense_clarification": "доминирующая особь, например, альфа-самец"
                            },
                            {
                                "target_lang_word": "альфа",
                                "target_lang_sense_clarification": "доминирующий человек"
                            }
                        ]
                    }
                }
            ]
