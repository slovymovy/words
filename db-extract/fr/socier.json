                "senses": [
                    {
                        "sense_id": "d6d2a07d-7882-3383-aa35-d2f3a599c837",
                        "entry_id": "f492238c-a393-3981-ab2e-b041e864174b",
                        "glosses": [
                            "Joindre, unir, associer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "73b4b5c5-091d-415a-b6b1-5f72eb2b4131",
                                "sense_id": "d6d2a07d-7882-3383-aa35-d2f3a599c837",
                                "text": "Socier plusieurs personnes"
                            },
                            {
                                "example_id": "b212b1e6-409d-4a4f-abc6-2bfc4752c945",
                                "sense_id": "d6d2a07d-7882-3383-aa35-d2f3a599c837",
                                "text": "Ne pouvoir socier ensemble\" — (Napoléon Landais, Dictionnaire général et grammatical des dictionnaires français, 1834)"
                            }
                        ]
                    },
                    {
                        "sense_id": "12278d4e-ec9e-3cdc-870b-14cfc2df2dab",
                        "entry_id": "f492238c-a393-3981-ab2e-b041e864174b",
                        "glosses": [
                            "S’accorder, faire alliance."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e49eeeb1-c1e9-48a9-8d6d-4b1f1b0bed73",
                                "sense_id": "12278d4e-ec9e-3cdc-870b-14cfc2df2dab",
                                "text": "Ils socient parce qu’ils s’en trouvent bien."
                            },
                            {
                                "example_id": "6c4ce26a-720f-4cbf-b793-874fe3afa351",
                                "sense_id": "12278d4e-ec9e-3cdc-870b-14cfc2df2dab",
                                "text": "Socier avec le méchant, c’est s’exposer à le devenir"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3f07538-ae57-3d2d-ba53-1a775d8edbb6",
                        "entry_id": "f492238c-a393-3981-ab2e-b041e864174b",
                        "glosses": [
                            "Faire société avec quelqu’un, le fréquenter."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "48f7e892-1de5-45e3-97d9-cf2d2b1a8942",
                                "sense_id": "f3f07538-ae57-3d2d-ba53-1a775d8edbb6",
                                "text": "Vous ne verrez jamais les moines socier qu’avec de petits esprits ou des femmelettes ; parce que ce n’est qu’avec ces gens-là qu’ils font ce qu’ils appellent leurs bons coups."
                            }
                        ]
                    }
