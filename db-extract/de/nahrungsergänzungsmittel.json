                                "target_senses": [
                                    {
                                        "sense_id": "666c6d70-b993-3a2f-b12f-948296c8c687",
                                        "entry_id": "532ed7fc-2fbe-3997-88ea-66e6eb537aab",
                                        "glosses": [
                                            "Denrée alimentaire dont le but est de fournir un complément de nutriments présents en quantités insuffisantes dans le régime alimentaire."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0daa135-5e09-4d06-8395-a67c76c46724",
                                                "sense_id": "666c6d70-b993-3a2f-b12f-948296c8c687",
                                                "text": "Je croule sous les sachets de compléments alimentaires, des boissons d’effort ultravitaminées, j’en ai emporté une quarantaine, un sachet par jour suffit."
                                            },
                                            {
                                                "example_id": "a58998ca-0f6c-426d-8b42-ca165356b8f9",
                                                "sense_id": "666c6d70-b993-3a2f-b12f-948296c8c687",
                                                "text": "Que ce soit pour des vitamines, des pilules anti-âges, des anti-douleurs, des compléments alimentaires, la figure féminine est récurrente."
                                            },
                                            {
                                                "example_id": "f51b14ed-7830-4890-99ea-46de4488299b",
                                                "sense_id": "666c6d70-b993-3a2f-b12f-948296c8c687",
                                                "text": "« Il s’agit de pays où l’on trafique les compléments alimentaires, avec des filières qui ressemblent à celles des narcotrafiquants », avance Gérard Dine, médecin spécialiste du dopage."
                                            }
                                        ]
                                    }
                                ]
                            }
