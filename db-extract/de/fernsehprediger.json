                        "source_sense_id": "05e279c9-4ddf-3889-9da9-e4856a663003",
                        "source_sense_description": "Geistlicher, dessen religiöse Ansprache an die Gläubigen über das Medium Fernsehen verbreitet wird",
                        "target_lang_word": "televangelist",
