        "fr-extract.jsonl": [
            {
                "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                "word": "shop",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3eb2297-8c78-43b7-8b9a-1f159252c2d8",
                        "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "tags": [
                            "plural"
                        ],
                        "form": "shops"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a54a450-4301-3936-8046-a6306b5bc214",
                        "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "glosses": [
                            "Atelier, espace de travail, endroit où on fabrique quelque chose."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "52e9c756-4fd9-3f05-a161-a13f2f8e256e",
                        "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "glosses": [
                            "Usine, fabrique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "6a6cfa37-a3c0-49be-a4d6-0be2ebeebc68",
                                "sense_id": "52e9c756-4fd9-3f05-a161-a13f2f8e256e",
                                "text": "La «shop» a été remplacée par le progrès en recherche et développement, l’élaboration de logiciels et les demandes toujours plus fortes des citoyens en soins de santé, en éducation et dans le monde du divertissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "876375a7-70f9-31c2-89b8-ae64afa2e85c",
                        "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "glosses": [
                            "Salon de tatouage, lieu où travaille une personne qui réalise des tatouages."
                        ],
                        "tags": [
                            "Tatouage"
                        ],
                        "examples": [
                            {
                                "example_id": "522e7eef-6217-4a0e-90e1-ede3325d71b7",
                                "sense_id": "876375a7-70f9-31c2-89b8-ae64afa2e85c",
                                "text": "Au fil des épisodes, animés par Denitsa Ikonomova, ils seront évalués par un jury composé de Kalie (« la première à avoir eu son shop dans le centre de Paris »), Dimitri HK et Mikael de Poissy qui, « en plus d’être connu pour le style vitrail qu’il a créé, a écrit beaucoup de livres sur le sujet », souligne la production."
                            }
                        ]
                    },
                    {
                        "sense_id": "a652df43-5ea8-3009-987f-b8ba5a9bc98a",
                        "entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "glosses": [
                            "Magasin, boutique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "2f6b402b-7b73-49d4-9382-51161d4f2dd2",
                                "sense_id": "a652df43-5ea8-3009-987f-b8ba5a9bc98a",
                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6512e9c-7a9d-4606-8edf-05a60ee7fd8d",
                        "source_entry_id": "f76cdb0f-b3e6-3b29-b302-52e744937fd7",
                        "target_lang_word": "shop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5766eb3f-8b10-32f1-936f-9324f411f6aa",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "An establishment that sells goods or services to the public; originally only a physical location, but now a virtual establishment as well."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830e6303-6d4e-44ad-b592-68aaa1c922ef",
                                                "sense_id": "5766eb3f-8b10-32f1-936f-9324f411f6aa",
                                                "text": "From shop to shop\n Wandering, and littering with unfolded silks\n The polished counter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4698ba44-8ac4-318b-bd78-f79d9f8cf5fa",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "A place where things are manufactured or crafted; a workshop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ca299c-8dc1-4d84-ba24-51c933f0b742",
                                                "sense_id": "4698ba44-8ac4-318b-bd78-f79d9f8cf5fa",
                                                "text": "A tailor called me in his shop."
                                            },
                                            {
                                                "example_id": "e055eaa8-2176-4b49-8d4c-a0bf4efc84dd",
                                                "sense_id": "4698ba44-8ac4-318b-bd78-f79d9f8cf5fa",
                                                "text": "I just left Dannemora and the same thing is happening here at Auburn prison […] They don't want to put me in the plate shop or let me have a good paying job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bb46056-22ad-3b2b-84b3-85841c41b032",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "A large garage where vehicle mechanics work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08f127b-a8d5-469c-a4be-8b4d21e48b85",
                                                "sense_id": "9bb46056-22ad-3b2b-84b3-85841c41b032",
                                                "text": "The car's in the shop right now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c8e0ea-2ff4-38bd-ae91-72359116c21f",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "Workplace; office. Used mainly in expressions such as shop talk, closed shop and shop floor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02a1bc55-a08d-330e-82af-944d51f2990a",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "Discussion of business or professional affairs."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea94b0c-c9ce-4798-aaa7-90262985e09d",
                                                "sense_id": "02a1bc55-a08d-330e-82af-944d51f2990a",
                                                "text": "What struck me about the occasion was the quiet though cheerful tone of the gathering, the restraint, noticeable also in the very few speeches. Chemistry was taboo, by common consent — no \"shop\" allowed."
                                            },
                                            {
                                                "example_id": "5dbf9f1a-0617-4caa-ae54-fe06f507fdff",
                                                "sense_id": "02a1bc55-a08d-330e-82af-944d51f2990a",
                                                "text": "But Mary cut her short.\n\"We don't allow shop at tea, Sally,\" she said firmly."
                                            },
                                            {
                                                "example_id": "b59b4d61-4b57-4c7a-88e5-6e1881bd0f3b",
                                                "sense_id": "02a1bc55-a08d-330e-82af-944d51f2990a",
                                                "text": "Nothing but shop was ever talked on any of these occasions. I am sure these close relationships were necessary for the conduct of the war, and I could not have grasped the whole position without them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1fb877a-ecfd-36dd-a85f-7ba1edc2d777",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "A variety of classes taught in junior or senior high school that teach vocational skills."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0d572b7-51d3-38da-ba46-96cffd4cf89d",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "An establishment where a barber or beautician works."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016609d9-ee80-402b-9ef3-87a7477e527e",
                                                "sense_id": "b0d572b7-51d3-38da-ba46-96cffd4cf89d",
                                                "text": "a barber shop"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1dc6a0-6802-3c23-b31d-e8f80e5f84e7",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "An act of shopping, especially routine shopping for food and other domestic supplies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "017d7308-67a8-4e60-bba4-9722c7111827",
                                                "sense_id": "8e1dc6a0-6802-3c23-b31d-e8f80e5f84e7",
                                                "text": "This is where I do my weekly shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce6c682-62b4-366e-8e36-294683bbe12c",
                                        "entry_id": "5856e74f-0f82-3401-bad4-52d643c17577",
                                        "glosses": [
                                            "The collective items bought (or to be bought) on a shopping trip."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94a3220-9e54-479d-8e2e-29f83cfc9e3e",
                                                "sense_id": "3ce6c682-62b4-366e-8e36-294683bbe12c",
                                                "text": "I’ve got a big shop, so feel free to go in front."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54c7a86-7a71-31fe-ab6e-f8055b6a05ed",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To visit stores or shops to browse or explore merchandise, especially with the intention of buying such merchandise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff7071c-355a-429c-b392-6038a71fba1c",
                                                "sense_id": "f54c7a86-7a71-31fe-ab6e-f8055b6a05ed",
                                                "text": "Why don’t you come shopping for gifts with me, early before the Christmas rush?"
                                            },
                                            {
                                                "example_id": "416afd91-c5f2-4473-a558-3b190974d1ad",
                                                "sense_id": "f54c7a86-7a71-31fe-ab6e-f8055b6a05ed",
                                                "text": "He’s (goen) shopping for clothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471308d4-d1f0-3348-9488-3b39398d7f5b",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To browse or purchase products from (a catalog, an internet website, etc.), mostly from home."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6efefc4b-0e68-4a0e-9561-17496b326169",
                                                "sense_id": "471308d4-d1f0-3348-9488-3b39398d7f5b",
                                                "text": "Shop our new arrivals."
                                            },
                                            {
                                                "example_id": "70d7a95f-1ae2-4909-8c97-ebc06f992d0f",
                                                "sense_id": "471308d4-d1f0-3348-9488-3b39398d7f5b",
                                                "text": "You fantasized about having unhurried afternoons before the baby arrived to leisurely shop your favorite boutiques. Then the first crash hits — you no longer have the money to shop your favorite boutiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9793d333-0f59-3b4e-a05c-865f928f89e1",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To report the criminal activities or whereabouts of someone to an authority."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7518f62-2258-49c2-a39c-8818e9e19a3f",
                                                "sense_id": "9793d333-0f59-3b4e-a05c-865f928f89e1",
                                                "text": "He shopped his mates in to the police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9777c63-b8df-377a-9aec-0ac92b1c4302",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To imprison."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12843f5f-8e31-3a27-a165-17ab4db502e2",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To photoshop; to digitally edit a picture or photograph."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "590d67e9-42aa-3069-9ea3-f89b7b9164ce",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To dismiss from employment."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "642fe802-c84b-3c32-a285-bb4c521d70e9",
                                        "entry_id": "7fa67cec-32dc-3109-bd04-b2185489d388",
                                        "glosses": [
                                            "To investigate or evaluate as a mystery shopper."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f48165b-9d33-4bd6-b8e3-65dff78bb0c1",
                                                "sense_id": "642fe802-c84b-3c32-a285-bb4c521d70e9",
                                                "text": "A grocery clerk who, after he had been \"shopped\" on occasions, was discharged because he had admitted that on one occasion he had not rung up a sale immediately after the transaction, as required by the company rule, but had recorded it later when he had remembered it, held discharged, but not for misconduct connected with his work […]"
                                            },
                                            {
                                                "example_id": "c5ad124a-b8bf-42c5-9d2a-19446560fcee",
                                                "sense_id": "642fe802-c84b-3c32-a285-bb4c521d70e9",
                                                "text": "Because mystery shoppers' reports are presented to employees some time (often several days) after they have \"been shopped,\" employees may not be able to recall who the mystery shopper was, even after the fact — and, consequently, they may be unable to judge the accuracy and fairness of these reports."
                                            }
                                        ]
                                    }
                                ]
                            },
