                "translations": [
                    {
                        "translation_id": "d215970a-35e8-4473-b81f-3eddfaa52329",
                        "source_entry_id": "c606cbc5-b967-305e-a94b-715eb081beaf",
                        "source_sense_id": "6f0ab2a7-f021-3117-a7fe-64da250e2791",
                        "target_lang_word": "sunroof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunroof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7dcacb3-200b-3915-a168-ef7d57f589b5",
                                        "entry_id": "1708b380-0604-3cca-9bba-164aecfc8afd",
                                        "glosses": [
                                            "A fixed or operable opening in a vehicle roof (car or truck) which allows fresh air and/or light to enter the passenger compartment. A sunroof may include a transparent or opaque panel and may be manually operated or power driven."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88ca7439-9a30-4b63-ab0d-f8068ca577fc",
                        "source_entry_id": "c606cbc5-b967-305e-a94b-715eb081beaf",
                        "source_sense_id": "6f0ab2a7-f021-3117-a7fe-64da250e2791",
                        "target_lang_word": "toit ouvrant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toit ouvrant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42d55964-9740-378d-81c6-330de8c71003",
                                        "entry_id": "3760203a-6929-3a8b-9744-eda19a4fef74",
                                        "glosses": [
                                            "Dispositif situé sur le toit d’un véhicule et qui peut être ouvert pour faire de l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1d2876-caa5-4c7b-8bbb-7d261f4da6fa",
                                                "sense_id": "42d55964-9740-378d-81c6-330de8c71003",
                                                "text": "Dans les voitures suiveuses aussi, on avait baissé les vitres et profité des toits ouvrants."
                                            },
                                            {
                                                "example_id": "04a1dcb5-4bc8-4574-8683-672aa14adb1d",
                                                "sense_id": "42d55964-9740-378d-81c6-330de8c71003",
                                                "text": "Malgré les offres de sortie au restaurant, je veux retourner à ma voiture, car j’ai oublié de fermer le toit ouvrant."
                                            },
                                            {
                                                "example_id": "ade759d8-8514-441b-acfe-7db4649047fb",
                                                "sense_id": "42d55964-9740-378d-81c6-330de8c71003",
                                                "text": "On est venu nous offrir des bières par le toit ouvrant, alors que les gens qui nous les tendaient ne nous connaissaient pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28fe9300-48f2-4775-8465-a717099a3b61",
                        "source_entry_id": "c606cbc5-b967-305e-a94b-715eb081beaf",
                        "source_sense_id": "6f0ab2a7-f021-3117-a7fe-64da250e2791",
                        "target_lang_word": "techo corredizo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "68b859dd-f498-4188-ac75-629a3a8d589e",
                        "source_entry_id": "c606cbc5-b967-305e-a94b-715eb081beaf",
                        "source_sense_id": "6f0ab2a7-f021-3117-a7fe-64da250e2791",
                        "target_lang_word": "Schiebedach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiebedach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                        "entry_id": "53cd3370-348f-3f31-9d7c-4854049e3029",
                                        "glosses": [
                                            "Teil des Verdecks eines Fahrzeugs, der geöffnet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "933458ca-3716-4c8f-a9a3-804d089e6037",
                                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                                "text": "„Die Sonne scheint senkrecht durch das Schiebedach, legt sich auf ihre Schultern und kitzelt ihr Dekolleté.“"
                                            },
                                            {
                                                "example_id": "224ed7f9-2056-4ef6-a1a1-af318f73ff4d",
                                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                                "text": "„Papa hatte einen grünen Peugeot 404 gekauft, mit Schiebedach und vier Türen und viel mehr Platz auf der Hinterbank als im Käfer.“"
                                            },
                                            {
                                                "example_id": "ef441bba-ca37-4f05-9df2-5ae4d8267d38",
                                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                                "text": "„Durch das Schiebedach brennt uns die heiße Augustsonne auf den Pelz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
