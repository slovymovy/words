                "senses": [
                    {
                        "sense_id": "57dfbb4e-ff44-300c-8d75-d8c14e0dedbf",
                        "entry_id": "294d0685-9a93-3388-9ecd-f4e2954da0ce",
                        "glosses": [
                            "The god of wine, ivy and grapes, specifically its intoxication and social influence, but also the patron of agriculture and the theater. Also related to the mystery of religion, as in \\\"spiritual intoxication\\\"."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "a984b10c-0c7a-40f0-b699-4565f6697fdf",
                                "sense_id": "57dfbb4e-ff44-300c-8d75-d8c14e0dedbf",
                                "text": "All hail slain and risen God / All hail Dionysus / Come blessed Dionysus, various nam'd, bull-fac'd / Begot from the thunder, Bacchus fam'd"
                            }
                        ]
                    }
                ],
