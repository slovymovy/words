                    },
                    {
                        "translation_id": "165a4a13-5fa4-41f9-a580-542181a2fbb4",
                        "source_entry_id": "87daf013-e72e-39bd-bf73-c5373ea5af03",
                        "source_sense_id": "9aafa73e-5988-372e-a1e8-224fb4723ea0",
                        "target_lang_word": "empoisonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empoisonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                        "entry_id": "92c2dbcd-befe-314f-b6f0-2dc22ee0cc9d",
                                        "glosses": [
                                            "Action d’empoisonner ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41721ea-1208-446b-af27-cd41f5325302",
                                                "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                                "text": "L’empoisonnement des esprits. — L’empoisonnement des mœurs."
                                            },
                                            {
                                                "example_id": "b3ef9dd4-3214-4742-898e-1ff8d34bdc46",
                                                "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                                "text": "Quelques observations d’empoisonnement à la suite d'injection vaginales avec de l’eau de Goulard, de l'usage de collyres à base de plomb, montrent que l'absorption se fait par les diverses muqueuses."
                                            },
                                            {
                                                "example_id": "9b80901c-9ed7-4a95-8028-c3c071140578",
                                                "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                                "text": "Et tout le village bientôt, à des degrés variant selon la constitution et la force de résistance de chacun, fut en proie à des malaises étranges, symptômes inexplicables d’empoisonnement."
                                            },
                                            {
                                                "example_id": "d1e2007b-e8fc-467c-bccb-7c892b8da5cb",
                                                "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                                "text": "Le travail de Nathalie Jas touche à l’histoire des empoisonnements en milieu professionnel et à domicile, ainsi qu’à l’histoire de la phytopharmacie et de la phytopathologie."
                                            },
                                            {
                                                "example_id": "30b71c9f-f7c3-4baa-86b0-bfead7c30dea",
                                                "sense_id": "9735269b-3294-3bce-9aa0-53d76966d326",
                                                "text": "— L’empoisonnement d’une région par les gaz asphyxiants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fccc44fd-253e-3385-b1b3-66680cfbf84d",
                                        "entry_id": "92c2dbcd-befe-314f-b6f0-2dc22ee0cc9d",
                                        "glosses": [
                                            "Ralentissement de la réaction nucléaire causé par la présence d’un absorbeur de neutrons."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73351f6d-3190-4013-bab3-39aea48ca65f",
                                                "sense_id": "fccc44fd-253e-3385-b1b3-66680cfbf84d",
                                                "text": "L’empoisonnement du cœur par les produits de désintégration se poursuit et il est difficile d’accroître davantage la puissance à cause du faible excédent de réactivité disponible, qui est à ce moment-là nettement inférieur au niveau réglementaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7339a762-40d8-3005-823b-8dc312d8569f",
                                        "entry_id": "92c2dbcd-befe-314f-b6f0-2dc22ee0cc9d",
                                        "glosses": [
                                            "Attaque informatique consistant à corrompre les données d’un système afin de modifier son comportement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f28ccb-d5ba-48c8-96a6-c4d5f5fb898d",
                                                "sense_id": "7339a762-40d8-3005-823b-8dc312d8569f",
                                                "text": "L’empoisonnement du cache DNS ou pollution de cache DNS est une technique permettant de leurrer les serveurs DNS afin de leur faire croire qu’ils reçoivent une requête valide alors qu’elle est en fait frauduleuse. Une fois que le serveur DNS a accepté ces requêtes (une fois qu’il a été empoisonné), il met ces informations dans son cache, rendant ainsi vulnérables tous les utilisateurs de ce serveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb206a73-1a0b-31c7-ba70-6dc6bdec6b52",
                                        "entry_id": "92c2dbcd-befe-314f-b6f0-2dc22ee0cc9d",
                                        "glosses": [
                                            "Ennui, embêtement, emmerdement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "626d6578-1f1a-4ef9-898f-25fdc4fa8e74",
                                                "sense_id": "eb206a73-1a0b-31c7-ba70-6dc6bdec6b52",
                                                "text": "J’avais déjà suffisamment d’empoisonnements comme ça, vous comprenez, depuis que j’étais arrivé, et même depuis que j’avais reçu cette lettre du notaire […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
