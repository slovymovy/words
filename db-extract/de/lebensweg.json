                        "form": "die Lebenswege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3be00182-2696-3d5f-b1d9-2cca8f45d5d0",
                        "entry_id": "560ec499-5831-3e02-a910-417f2f863e78",
                        "glosses": [
                            "Weg durch das Leben; Gesamtheit der wichtigen Ereignisse, die jemand durchlebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513b1411-5b4a-4e33-93ae-aea683fe2d07",
                                "sense_id": "3be00182-2696-3d5f-b1d9-2cca8f45d5d0",
                                "text": "„Immer schon wollte ich mich mit ihrem Lebensweg befassen.“"
                            },
                            {
                                "example_id": "cb433a06-fccd-4ff1-8dff-21b7504bc3a9",
                                "sense_id": "3be00182-2696-3d5f-b1d9-2cca8f45d5d0",
                                "text": "„Dann gab er mir viele Ratschläge für meinen künftigen Lebensweg und erinnerte mich daran, wie viel ich durch meine frühen Fehlentscheidungen verloren hätte.“"
                            },
                            {
                                "example_id": "7faa1ee6-5eda-4a37-9d78-fed8580b8118",
                                "sense_id": "3be00182-2696-3d5f-b1d9-2cca8f45d5d0",
                                "text": "„Zudem entwirft Wieland seinen Tifan als eine von den menschlichen Anlagen her ebenso wie von seinem Herkommen und den Glücksumständen seines Lebenswegs so unwahrscheinliche Gestalt, dass man zuweilen versucht ist, Satire zu vermuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
