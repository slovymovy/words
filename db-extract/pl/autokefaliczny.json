                        "glosses": [
                            "zwłaszcza w chrześcijaństwie: związany ze statusem autokefalii, mający status autokefalii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23675a16-07f8-4fd0-8800-f31564b86909",
                                "sense_id": "cb25114e-7160-3b98-85d5-de19119fd000",
                                "text": "Właścicielem tej działki jest Polski Autokefaliczny Kościół Prawosławny."
