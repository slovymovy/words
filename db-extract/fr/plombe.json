                                "sense_id": "d357e399-61fe-30fa-9dee-bc6a09ee0495",
                                "text": "Ca m'a pris une plombe de venir jusqu'ici.",
                                "translation": "It took me ages to get here.",
                                "english": "It took me ages to get here."
                            },
                            {
                                "example_id": "6d8f574c-ac5d-40d7-8af8-9729af20d931",
                                "sense_id": "d357e399-61fe-30fa-9dee-bc6a09ee0495",
                                "text": "Ha ! Ha ! Ça fait plaisir la petite piscine, une plombe que j'y étais pas allé.",
                                "translation": "Ha ha! I like the swimming pool; it's ages since I've been.",
                                "english": "Ha ha! I like the swimming pool; it's ages since I've been."
                            }
                        ]
