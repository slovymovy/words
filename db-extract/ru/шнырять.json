                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "шныря́вши"
                    },
                    {
                        "form_id": "d0daeed7-ef25-45c6-aa48-cf9dd7223e99",
                        "entry_id": "b715c122-6bb1-3a49-b317-69bcb57b7062",
