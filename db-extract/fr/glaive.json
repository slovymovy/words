                    }
                ],
                "senses": [
                    {
                        "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                        "entry_id": "834d0c4b-d304-3641-8197-351746355780",
                        "glosses": [
                            "Épée tranchante et courte que les Romains utilisaient."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "741ec041-e286-4fcf-b964-715466906069",
                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                "text": "Il lui plongea son glaive dans le sein."
                            },
                            {
                                "example_id": "c0b070c5-689d-46f2-ab19-f220172cfb00",
                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                "text": "Tirer le glaive."
                            },
                            {
                                "example_id": "a25997f2-af41-4b56-ba45-cc779d513ef9",
                                "sense_id": "72c06611-0069-3a1b-8c08-fe978581a689",
                                "text": "Il brave en souriant le glaive meurtrier ;\nIl console et bénit, et le Dieu qu’il adore\nDescend à son appel et l’écoute prier."
                            }
                        ]
                    },
                    {
                        "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                        "entry_id": "834d0c4b-d304-3641-8197-351746355780",
                        "glosses": [
                            "Symbole du combat contre ce qui nuit à la société."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd1555a-60fe-4bd2-8945-8bfcdd3e0719",
                                "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                                "text": "[…] je feins de m'intéresser à une sorte de chromo hideux qui représente une Thémis de contrebande, le glaive à la main."
                            },
                            {
                                "example_id": "81acfd90-d37a-475f-8cd6-b563f8610af3",
                                "sense_id": "63bb6749-ee73-3f13-a6ae-dd4ef9bdf3f4",
                                "text": "Je ne suis pas venu apporter la paix, mais le glaive [Matthieu 10:34]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "120140c6-c2ce-41b5-8426-6d8d3c5df8b1",
                        "source_entry_id": "834d0c4b-d304-3641-8197-351746355780",
                        "target_lang_word": "Kurzschwert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzschwert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2fd0da-9052-383b-b369-3db4d60612c2",
                                        "entry_id": "45aaf6b5-3006-3df2-ba1a-c9e49928d04e",
                                        "glosses": [
                                            "Schwert mit kurzer Klinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621c23d9-db2e-48fc-993c-3305a35b8676",
                                                "sense_id": "ee2fd0da-9052-383b-b369-3db4d60612c2",
                                                "text": "„Insgesamt waren im Frühling 1525 an die 300000 Mann unter Waffen, zu denen Sauspieße, Sensen und Kurzschwerter gehörten, aber auch erbeutete Geschütze und Büchsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70b33028-1c0e-432d-9d20-bafa5a1eb310",
                        "source_entry_id": "834d0c4b-d304-3641-8197-351746355780",
                        "target_lang_word": "Schwert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                        "entry_id": "788efe00-ddbe-36f5-abc9-00dee4f2d9b8",
                                        "glosses": [
                                            "aus Metall bestehende Klingenwaffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638ca073-6701-4d71-a069-e6ddceb26c4b",
                                                "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                                "text": "Er zückte sein Schwert."
                                            },
                                            {
                                                "example_id": "88613ed8-290b-4cff-8082-7aac0c84ed6b",
                                                "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                                "text": "„In einer Zeremonie zerstören sie die Trophäen, brechen die Schwerter entzwei und zerschlagen die Schilde.“"
                                            },
                                            {
                                                "example_id": "2b8dda1d-2ff6-49ba-adab-f9aa12313278",
                                                "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                                "text": "„Wie stolz ein Krieger auf sein Schwert war, zeigen z.B. vergoldete Schlagmarken oder geätzte bildliche Darstellungen an den Klingen und Schwertscheiden.“"
                                            },
                                            {
                                                "example_id": "8a29f902-b607-4426-abd4-96bdba6841ea",
                                                "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                                "text": "„Die Soldaten kämpfen mit Schwert, Speer und Wurfspieß.“"
                                            },
                                            {
                                                "example_id": "87f92708-ae3d-47b1-b974-f73b7aeb4b1c",
                                                "sense_id": "7a0e6b74-730c-3f70-9335-20da239d4524",
                                                "text": "„An der Decke baumelt ein zwei Meter langer Torpedo, Schwerter und Krummsäbel liegen auf dem Boden, an der Wand sehe ich eine Maschinenpistole.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c8f6d9a-a757-3043-9508-5a82f1f1a83a",
                                        "entry_id": "788efe00-ddbe-36f5-abc9-00dee4f2d9b8",
                                        "glosses": [
                                            "meist aus Metall oder Holz bestehende Platte, die in einer Jolle (Segelboot) hochgezogen und heruntergelassen werden kann. Das Schwert verhindert die Abdrift am Wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261187c3-ca27-48fb-a178-6ddebcfdb756",
                                                "sense_id": "1c8f6d9a-a757-3043-9508-5a82f1f1a83a",
                                                "text": "Beim Kentern des Bootes kann das Schwert durchrutschen."
                                            },
                                            {
                                                "example_id": "cdf93004-2f00-4485-8817-71a804e06a7f",
                                                "sense_id": "1c8f6d9a-a757-3043-9508-5a82f1f1a83a",
                                                "text": "„Eine Plastiktüte sieht harmlos aus, kann aber, wenn sie sich um das Schwert des Bootes wickelt, rennentscheidend sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae053e00-39d0-3701-86ab-266784de2e1f",
                                        "entry_id": "788efe00-ddbe-36f5-abc9-00dee4f2d9b8",
                                        "glosses": [
                                            "Rückenflosse (Finne) bei einigen Walarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2475132-c750-4192-b0f9-bed9a753298d",
                                                "sense_id": "ae053e00-39d0-3701-86ab-266784de2e1f",
                                                "text": "Schwertwale werden auch als Orcas bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "624168e9-00c8-3067-80c6-2f41a8efd738",
                                        "entry_id": "788efe00-ddbe-36f5-abc9-00dee4f2d9b8",
                                        "glosses": [
                                            "Hornfortsatz am Kopf einer Fischart"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "90d983a8-653a-3fdf-9cf9-61a664a45b03",
                                        "entry_id": "788efe00-ddbe-36f5-abc9-00dee4f2d9b8",
                                        "glosses": [
                                            "Ketten-Schiene einer Motorsäge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0beec2cf-4271-4cb0-b0b3-27a8e1af615e",
                                                "sense_id": "90d983a8-653a-3fdf-9cf9-61a664a45b03",
                                                "text": "Das Schwert meiner Motorsäge ist verzogen, ich muss es austauschen"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a485fc08-4487-454d-b4c1-5df854c696ba",
                        "source_entry_id": "834d0c4b-d304-3641-8197-351746355780",
                        "target_lang_word": "glaive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fdf1644-c0dc-3070-b064-b5347f05a534",
                                        "entry_id": "834ae36d-a042-3997-b47c-dd4a51405b7d",
                                        "glosses": [
                                            "A light lance with a long, sharp-pointed head."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663d118e-5e40-496f-bcfe-f89ec4653527",
                                                "sense_id": "5fdf1644-c0dc-3070-b064-b5347f05a534",
                                                "text": "The lance, or glaive as it is often called, of the eleventh and twelfth centuries was quite straight and smooth; a vamplate was added in the fourteenth, small at first but larger later, for the protection of the right arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c72147d-1377-3c43-bed2-38badeb10a33",
                                        "entry_id": "834ae36d-a042-3997-b47c-dd4a51405b7d",
                                        "glosses": [
                                            "A weapon consisting of a pole with a large blade fixed on the end, the edge of which is on the outside curve."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d9cb9a1-3b52-448b-be5d-0bc627e61d9a",
                                                "sense_id": "0c72147d-1377-3c43-bed2-38badeb10a33",
                                                "text": "The Welch Glaive is a kind of bill, ſometimes reckoned among the pole axes. They were formerly much in uſe. [...] In the Britiſh Muſeum there is an entry of a warrant, granted to Nicholas Spicer, authoriſing him to impreſs ſmiths for making two thouſand Welch bills or glaives."
                                            },
                                            {
                                                "example_id": "8b4e7bb3-a218-4f66-8a3f-a5a0202962ba",
                                                "sense_id": "0c72147d-1377-3c43-bed2-38badeb10a33",
                                                "text": "With the spear comes the use of the shield; yet the San Cristoval spearmen use no such defence, but turn off spears thrown at them with long curved glaives, and the shields in use in Florida are not made in that island."
                                            },
                                            {
                                                "example_id": "46bb7ce9-72bd-411d-bdf5-5b37be7b03da",
                                                "sense_id": "0c72147d-1377-3c43-bed2-38badeb10a33",
                                                "text": "At that moment Ilane swung the bladed staff—glaive, Kel remembered as it swung, they called it a glaive—in a wide side cut, slicing one pirate across the chest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                        "entry_id": "834ae36d-a042-3997-b47c-dd4a51405b7d",
                                        "glosses": [
                                            "A sword, particularly a broadsword."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274f2044-5a4f-4638-8f0a-9bfeb2a0c045",
                                                "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                                "text": "[T]he glaiue which he did wield / He gan forthwith t'auale, and way vnto me yield."
                                            },
                                            {
                                                "example_id": "db6f2827-553e-4036-9031-62f4a0c3f922",
                                                "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                                "text": "Wherefore do you ſo ill tranſlate yourſelf, / Out of the ſpeech of peace, that bears ſuch grace, / Into the harſh and boiſt'rous tongue of war? / Turning your books to glaives, your ink to blood, / Your pens to lances, and your tongue divine / To a loud trumpet, and a point of war?"
                                            },
                                            {
                                                "example_id": "2a1d4c67-2386-48c9-8ee6-fa47c3bce589",
                                                "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                                "text": "Juſtice were cruel weakly to relent; / From Mercy’s Self ſhe got her ſacred Glaive: / Grace be to thoſe who can, and will, repent; / But Penance long, and dreary, to the Slave, / Who muſt in Floods of Fire his groſs ſoul Spirit lave."
                                            },
                                            {
                                                "example_id": "51d7b1bd-ef2a-4aba-840f-9dea3e4ea65a",
                                                "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                                "text": "Thus furth he drew his truſty glaive, / While thouſands all arround, / Drawn frae their ſheaths glanſt in the ſun, / And loud the bougills ſound."
                                            },
                                            {
                                                "example_id": "b6a1b047-6080-400f-be32-0f30718ca181",
                                                "sense_id": "defef7fc-a5f6-3a13-9547-c8cc9c150d6c",
                                                "text": "Yea, that same awful angel with the glaive / Which in disparadising orbit swept / Lintel and pilaster and architrave"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6f932f7-f092-4327-9396-436733573888",
                        "source_entry_id": "834d0c4b-d304-3641-8197-351746355780",
