                "senses": [
                    {
                        "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                        "entry_id": "c94eae4c-b3d1-308f-b6eb-7a4da965f4df",
                        "glosses": [
                            "een onbestaande machine waarmee men zich door de tijd en vaak ook door de ruimte kan verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6897905-6dea-4374-a4e2-2d78798f9635",
                                "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                                "text": "Het leek of ik in de teletijdmachine van professor Barabas terecht was gekomen. Opeens zat ik op een andere plek."
                            },
                            {
                                "example_id": "6c5d004d-4053-4487-9c53-aa24554a1628",
                                "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                                "text": "Op mijn tiende las ik ‘Kruistocht in Spijkerbroek’, de jeugdroman van Thea Beckman waarin de vijftienjarige Dolf met behulp van een teletijdmachine in een kinderkruistocht belandt."
                            },
                            {
                                "example_id": "5c963b81-ded9-4938-85e5-c7ddf1963f31",
                                "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                                "text": "Dus we zouden Zwarte Kerouac natuurlijk naar de toekomst kunnen teleporteren. Maar laten we de teletijdmachine alsjeblieft goed instellen, voor we de hendel overhalen."
                            },
                            {
                                "example_id": "67403d4a-99f4-4126-b180-3431d4fd3262",
                                "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                                "text": "Bij de aanblik van het zakmes flitst de teletijdmachine van mijn gedachten me terug naar mijn schooljeugd in Haaksbergen."
                            },
                            {
                                "example_id": "d5088d40-7f61-4896-b305-775836971d70",
                                "sense_id": "6d760321-3895-3113-8478-a72870d1b8d6",
                                "text": "Als ik ooit in een teletijdmachine kan stappen, dan flits ik mezelf terug naar het Wenen van voor de Eerste Wereldoorlog."
                            }
                        ]
                    }
                ],
