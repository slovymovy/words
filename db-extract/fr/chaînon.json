                                        "examples": [
                                            {
                                                "example_id": "5527c1cb-f964-45b4-84e8-2db96517a6ce",
                                                "sense_id": "e5c4c911-674e-377b-8b6a-d269a5b6fb27",
                                                "text": "All the tribes and nations that composed it [the Roman Empire] were linked together, not only by the same laws and the same government, but by all the facilities of commodious intercourse, and of frequent communication."
                                            }
                                        ]
                                    },
                                    {
