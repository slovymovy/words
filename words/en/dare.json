{
    "word_family": [
        "daring",
        "daredevil"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                    "sense_definition": "To have enough courage or boldness to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "courage_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wouldn't <w>dare</w> argue with my boss about the schedule.",
                            "target_lang_translations": {
                                "ru": "Я бы не <w>посмел</w> спорить с начальником о расписании.",
                                "zh": "我可不<w>敢</w>跟老板争论日程安排。"
                            }
                        },
                        {
                            "text": "No one <w>dares</w> to criticize his decisions during the meeting.",
                            "target_lang_translations": {
                                "ru": "Никто не <w>смеет</w> критиковать его решения во время собрания.",
                                "zh": "开会时，没人<w>敢</w>批评他的决定。"
                            }
                        },
                        {
                            "text": "How <w>dare</w> you speak to your mother like that?",
                            "target_lang_translations": {
                                "ru": "Как ты <w>смеешь</w> так разговаривать с матерью?",
                                "zh": "你怎么<w>敢</w>那样跟你妈妈说话？"
                            }
                        }
                    ],
                    "synonyms": [
                        "venture",
                        "risk"
                    ],
                    "antonyms": [
                        "cower",
                        "fear"
                    ],
                    "common_phrases": [
                        "how dare you",
                        "don't you dare",
                        "dare not"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used as a semi-modal verb, especially in negative or interrogative sentences"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь достаточно мужества, смелости или наглости, чтобы сделать что-то.",
                        "zh": "有足够的勇气或胆量去做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сметь",
                                "target_lang_sense_clarification": "иметь смелость; часто используется в отрицаниях и вопросах"
                            },
                            {
                                "target_lang_word": "осмеливаться",
                                "target_lang_sense_clarification": "решаться на поступок"
                            },
                            {
                                "target_lang_word": "посметь",
                                "target_lang_sense_clarification": "совершенный вид; часто выражает возмущение наглостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敢",
                                "target_lang_sense_clarification": "有胆量做某事；最常用说法"
                            },
                            {
                                "target_lang_word": "敢于",
                                "target_lang_sense_clarification": "较正式，表示敢于去做"
                            },
                            {
                                "target_lang_word": "胆敢",
                                "target_lang_sense_clarification": "多用于责问或表示“竟敢”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "890fdbd0-9fec-30d3-84a9-3d6b5a5f5aa3",
                    "sense_definition": "To challenge or provoke someone to do something, often to prove their courage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "challenge_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>dare</w> you to jump into the cold water.",
                            "target_lang_translations": {
                                "ru": "Я <w>бросаю</w> тебе <w>вызов</w>: прыгни в холодную воду.",
                                "zh": "我<w>挑战</w>你跳进冰冷的水里。"
                            }
                        },
                        {
                            "text": "She <w>dared</w> him to ask for a promotion.",
                            "target_lang_translations": {
                                "ru": "Она <w>подзадорила</w> его попросить о повышении.",
                                "zh": "她一<w>激</w>他，他就去要求加薪了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "defy",
                        "provoke"
                    ],
                    "common_phrases": [
                        "I dare you"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бросать вызов или провоцировать кого-то сделать что-то, часто чтобы проверить смелость («брать на слабо»).",
                        "zh": "向某人发出挑战或故意刺激其去做某事，常常是为了考验其胆量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзадоривать",
                                "target_lang_sense_clarification": "провоцировать, подстрекать к действию"
                            },
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "вызывать на состязание или проверку смелости"
                            },
                            {
                                "target_lang_word": "брать на «слабо»",
                                "target_lang_sense_clarification": "разговорное выражение для провокации смелости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "激对方去做某事，带有“你敢不敢”的挑动意味"
                            },
                            {
                                "target_lang_word": "激",
                                "target_lang_sense_clarification": "用言语刺激对方去做某事"
                            },
                            {
                                "target_lang_word": "激将",
                                "target_lang_sense_clarification": "故意刺激别人证明胆量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f891a3a6-2d28-361e-849b-727498eddbcb",
                    "sense_definition": "To face or endure something dangerous or difficult with courage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courage_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers decided to <w>dare</w> the harsh conditions of the Arctic.",
                            "target_lang_translations": {
                                "ru": "Исследователи решили <w>бросить вызов</w> суровым условиям Арктики.",
                                "zh": "探险家们决定<w>冒险</w>面对北极的恶劣环境。"
                            }
                        },
                        {
                            "text": "He was willing to <w>dare</w> death to save his friend.",
                            "target_lang_translations": {
                                "ru": "Он был готов <w>взглянуть в лицо</w> смерти, чтобы спасти друга.",
                                "zh": "为了救朋友，他愿意<w>冒着</w>生命危险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brave",
                        "confront",
                        "face"
                    ],
                    "antonyms": [
                        "avoid",
                        "flee"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or rhetorical style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Противостоять чему-то опасному или трудному с мужеством.",
                        "zh": "勇敢地面对或承受危险或困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "смело противостоять стихии или опасности"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "идти на риск"
                            },
                            {
                                "target_lang_word": "смело встречать",
                                "target_lang_sense_clarification": "смотреть опасности в лицо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒险",
                                "target_lang_sense_clarification": "不顾危险去做；侧重承担风险"
                            },
                            {
                                "target_lang_word": "敢于面对",
                                "target_lang_sense_clarification": "勇敢面对危险或困难"
                            },
                            {
                                "target_lang_word": "冒着……危险",
                                "target_lang_sense_clarification": "常用于“冒着……危险”这类说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "391ab8d5-6d8d-3f55-a129-c0c97ccb80a0",
                    "sense_definition": "A challenge to do something dangerous, foolish, or difficult, usually to prove courage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "challenge_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only sang karaoke on a <w>dare</w> from my friends.",
                            "target_lang_translations": {
                                "ru": "Я пел в караоке только на <w>спор</w> с друзьями.",
                                "zh": "我只是因为朋友们的<w>激将</w>才去唱卡拉OK的。"
                            }
                        },
                        {
                            "text": "He accepted the <w>dare</w> to climb the tall tree.",
                            "target_lang_translations": {
                                "ru": "Он принял <w>вызов</w> залезть на высокое дерево.",
                                "zh": "他接受了爬那棵高树的<w>挑战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "provocation"
                    ],
                    "common_phrases": [
                        "on a dare",
                        "take a dare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызов сделать что-то опасное или глупое, обычно чтобы доказать смелость.",
                        "zh": "为了证明胆量而让人去做危险、愚蠢或困难事情的挑战。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "пари, действие «на спор»"
                            },
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "провокационное предложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激将",
                                "target_lang_sense_clarification": "怂恿别人去做冒险或蠢事的挑战"
                            },
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "要求别人证明胆量的挑战"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f942eb32-6c47-39de-bf5e-e3f724b92b24",
                    "sense_definition": "The option in the game 'Truth or Dare' where a player must perform a challenged action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "challenge_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked truth or dare, she picked <w>dare</w>.",
                            "target_lang_translations": {
                                "ru": "Когда её спросили «правда или действие», она выбрала <w>действие</w>.",
                                "zh": "当被问到“真心话还是大冒险”时，她选了<w>大冒险</w>。"
                            }
                        },
                        {
                            "text": "The <w>dare</w> was to run around the block in a costume.",
                            "target_lang_translations": {
                                "ru": "<w>Задание</w> заключалось в том, чтобы пробежать вокруг квартала в костюме.",
                                "zh": "这个<w>大冒险</w>是穿着戏服绕着街区跑一圈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "truth or dare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант выбора в игре «Правда или действие», требующий выполнения задания.",
                        "zh": "在“真心话大冒险”游戏中，要求玩家完成指定动作的那个选项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действие",
                                "target_lang_sense_clarification": "вариант в игре «Правда или действие»"
                            },
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "задание, которое нужно выполнить (в игре)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大冒险",
                                "target_lang_sense_clarification": "“真心话大冒险”里要求执行任务的选项"
                            },
                            {
                                "target_lang_word": "任务",
                                "target_lang_sense_clarification": "指该游戏中被分配的具体动作或任务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "408607b1-b420-3c5e-b529-ab4f8a79a653",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Dare</w> to the meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Дэйра</w> на встречу.",
                                "zh": "我们邀请了<w>戴尔</w>先生来参加会议。"
                            }
                        },
                        {
                            "text": "Virginia <w>Dare</w> was the first English child born in the New World.",
                            "target_lang_translations": {
                                "ru": "Вирджиния <w>Дэйр</w> была первым английским ребёнком, рождённым в Новом Свете.",
                                "zh": "弗吉尼娅·<w>戴尔</w>是新大陆出生的第一个英国孩子。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дэйр",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴尔",
                                "target_lang_sense_clarification": "英文姓氏的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80fae6ee-7527-393f-8f06-5846a208792b",
                    "sense_definition": "Acronym of Drug Abuse Resistance Education.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The police officer visited the school to talk about the <w>DARE</w> program.",
                            "target_lang_translations": {
                                "ru": "Полицейский посетил школу, чтобы рассказать о программе <w>DARE</w>.",
                                "zh": "那位警官到学校来介绍<w>药物滥用预防教育</w>项目。"
                            }
                        },
                        {
                            "text": "Students wore red ribbons to support <w>DARE</w> week.",
                            "target_lang_translations": {
                                "ru": "Студенты носили красные ленточки в поддержку недели <w>DARE</w>.",
                                "zh": "学生们戴上红丝带，支持<w>药物滥用预防教育</w>宣传周。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним программы DARE (обучение устойчивости к злоупотреблению наркотиками).",
                        "zh": "“药物滥用预防教育”的缩写，指美国的一项教育项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "DARE",
                                "target_lang_sense_clarification": "название американской образовательной программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药物滥用预防教育",
                                "target_lang_sense_clarification": "美国一项青少年禁毒教育项目的名称缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}