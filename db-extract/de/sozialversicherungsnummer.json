                "senses": [
                    {
                        "sense_id": "12a8a4ab-63e2-3a1f-b32a-28951ecd1c72",
                        "entry_id": "eb0c93ac-0de1-3d03-9450-c114aa53a9ef",
                        "glosses": [
                            "aus Buchstaben oder Ziffern bestehendes Personenkennzeichen zur Identifikation im Sozialversicherungswesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7c57b7-f488-46a7-9dca-4f5ca5b84d2e",
                                "sense_id": "12a8a4ab-63e2-3a1f-b32a-28951ecd1c72",
                                "text": "„Rapp wirkte erst skeptisch, dann peinlich berührt, als der grauhaarige Mann seine komplette Lebensgeschichte herunterratterte, inklusive Geburtsdatum, Sozialversicherungsnummer, den Namen seiner Eltern, seinen sportlichen Errungenschaften und bekannten Stärken und Schwächen.“"
                            },
                            {
                                "example_id": "5cd45ec7-d81b-4d0f-b0e6-3600c969d854",
                                "sense_id": "12a8a4ab-63e2-3a1f-b32a-28951ecd1c72",
                                "text": "„Eben noch versuche ich, ein kanadisches Aids-Mädchen zu mir in die Hölle zu locken, und plötzlich sehe ich meinem geliebten Goran nach, der jetzt einen knallrosa Overall trägt, mit so was wie einer Sozialversicherungsnummer auf der Brust.“"
                            },
                            {
                                "example_id": "4a86214b-22a7-49a8-921c-34000ddaa2a2",
                                "sense_id": "12a8a4ab-63e2-3a1f-b32a-28951ecd1c72",
                                "text": "„Wie ist ihre Sozialversicherungsnummer?“"
                            },
                            {
                                "example_id": "d2e16c98-43ff-4f8b-819c-fc39423003a3",
                                "sense_id": "12a8a4ab-63e2-3a1f-b32a-28951ecd1c72",
                                "text": "„Dann sprach er flüsternd in das Mikrofon. ›Guten Morgen, liebe Kameltreiber und Turbanträger. Mein Name ist Zachary Paul Hightower. Meine Sozialversicherungsnummer lautet 413-555-1287. Präsident Abbud lutscht Kamelschwänze.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
