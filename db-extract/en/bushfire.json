                "senses": [
                    {
                        "sense_id": "c1101fc9-d0a6-3e0a-afdb-0c30d0c8ed93",
                        "entry_id": "ede63758-d283-38b6-8ef9-75f5659ee8a3",
                        "glosses": [
                            "An uncontrolled fire in a wooded or grassy area; a wildfire."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "9c11f4d1-e615-4d65-beef-0b7327ede090",
                                "sense_id": "c1101fc9-d0a6-3e0a-afdb-0c30d0c8ed93",
                                "text": "1985, Australian House of Representatives, Parliamentary Debates, House of Representatives, Weekly Hansard, Issues 4-6, page 1322,\nMany homes, a great deal of property and a number of lives were lost as a result of the bushfires in this country."
                            },
                            {
                                "example_id": "ecf2421c-98bb-4cfa-ac44-407d5ebc3096",
                                "sense_id": "c1101fc9-d0a6-3e0a-afdb-0c30d0c8ed93",
                                "text": "It should also be kept in mind that often bushfires start and move quickly and the information relating to their location and activity may take some time to assemble and make available."
                            },
                            {
                                "example_id": "c6357bba-ab08-4b95-823f-a2bb0d0abce5",
                                "sense_id": "c1101fc9-d0a6-3e0a-afdb-0c30d0c8ed93",
                                "text": "The Black Saturday bushfires were a series of apocalyptic blazes that burned on – and for some weeks after – Saturday, 7 February 2009. As a result of the bushfires, 173 people died. It was the nation′s largest loss of life from a bushfire event, and 414 people were injured."
                            }
                        ]
                    }
