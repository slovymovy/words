{
    "word_family": [
        "develop",
        "development",
        "redevelop",
        "redevelopment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57c91dcd-0165-3d27-a9d4-c2b5de6754b1",
                    "sense_definition": "A person or company that creates, designs, or modifies computer software and applications.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "agent_creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>developer</w> fixed the critical bug in the application before the launch.",
                            "target_lang_translations": {
                                "ru": "<w>Разработчик</w> исправил критическую ошибку в приложении перед запуском.",
                                "zh": "<w>开发人员</w>在发布前修复了应用程序中的关键错误。"
                            }
                        },
                        {
                            "text": "She works as a senior web <w>developer</w> for a major technology firm.",
                            "target_lang_translations": {
                                "ru": "Она работает старшим веб-<w>разработчиком</w> в крупной технологической фирме.",
                                "zh": "她在一家大型科技公司担任高级网页<w>开发人员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "programmer",
                        "coder",
                        "software engineer"
                    ],
                    "common_phrases": [
                        "software developer",
                        "web developer",
                        "app developer",
                        "game developer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или компания, которые создают, проектируют или модифицируют компьютерное программное обеспечение и приложения.",
                        "zh": "指创建、设计或修改计算机软件及应用程序的个人或公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разработчик",
                                "target_lang_sense_clarification": "программного обеспечения"
                            },
                            {
                                "target_lang_word": "программист",
                                "target_lang_sense_clarification": "пишущий код"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发人员",
                                "target_lang_sense_clarification": "软件开发人员"
                            },
                            {
                                "target_lang_word": "程序员",
                                "target_lang_sense_clarification": "编写代码的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0de00fe1-1a09-3887-9d6a-83ffe2b1600a",
                    "sense_definition": "A person or company that buys land or existing buildings to build new houses, offices, or shops.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agent_creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>developer</w> plans to turn the old factory site into luxury apartments.",
                            "target_lang_translations": {
                                "ru": "<w>Застройщик</w> планирует превратить территорию старой фабрики в элитные квартиры.",
                                "zh": "该<w>开发商</w>计划将旧工厂用地改建成豪华公寓。"
                            }
                        },
                        {
                            "text": "Local residents protested against the property <w>developer</w> building a mall in the park.",
                            "target_lang_translations": {
                                "ru": "Местные жители протестовали против того, чтобы <w>застройщик</w> строил торговый центр в парке.",
                                "zh": "当地居民抗议房地产<w>开发商</w>在公园里建造购物中心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "builder"
                    ],
                    "common_phrases": [
                        "property developer",
                        "real estate developer",
                        "land developer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или компания, покупающие землю или здания для строительства новых домов, офисов или магазинов.",
                        "zh": "指购买土地或现有建筑物以建造新住宅、办公楼或商店的个人或公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застройщик",
                                "target_lang_sense_clarification": "строительная организация"
                            },
                            {
                                "target_lang_word": "девелопер",
                                "target_lang_sense_clarification": "предприниматель в недвижимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发商",
                                "target_lang_sense_clarification": "房地产开发商"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6bf5a6e-1e12-3b4d-b4b3-7de709364674",
                    "sense_definition": "A person or entity responsible for creating or improving specific products or ideas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agent_creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a product <w>developer</w>, his job is to design innovative toys for children.",
                            "target_lang_translations": {
                                "ru": "Как <w>разработчик</w> продуктов, он занимается дизайном инновационных игрушек для детей.",
                                "zh": "作为产品<w>开发者</w>，他的工作是为孩子们设计创新的玩具。"
                            }
                        },
                        {
                            "text": "The <w>developer</w> of this new theory received a prestigious scientific award.",
                            "target_lang_translations": {
                                "ru": "<w>Разработчик</w> этой новой теории получил престижную научную награду.",
                                "zh": "这一新理论的<w>开发者</w>获得了一项著名的科学奖项。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creator",
                        "inventor",
                        "designer"
                    ],
                    "common_phrases": [
                        "product developer",
                        "business developer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или организация, ответственные за создание или улучшение конкретных продуктов или идей.",
                        "zh": "负责创造或改进特定产品或理念的个人或实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разработчик",
                                "target_lang_sense_clarification": "создатель продукта"
                            },
                            {
                                "target_lang_word": "создатель",
                                "target_lang_sense_clarification": "автор идеи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发者",
                                "target_lang_sense_clarification": "产品或理论的创造者"
                            },
                            {
                                "target_lang_word": "创始人",
                                "target_lang_sense_clarification": "理念或项目的发起人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d019f1c0-25fe-3a36-99f7-1662a9ba84b6",
                    "sense_definition": "A chemical liquid used to process photographic film or paper to make the image visible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must soak the photo paper in the <w>developer</w> for exactly two minutes.",
                            "target_lang_translations": {
                                "ru": "Вы должны держать фотобумагу в <w>проявителе</w> ровно две минуты.",
                                "zh": "你必须将相纸浸泡在<w>显影液</w>中整整两分钟。"
                            }
                        },
                        {
                            "text": "The photographer mixed the <w>developer</w> in the darkroom before starting the process.",
                            "target_lang_translations": {
                                "ru": "Фотограф смешал <w>проявитель</w> в темной комнате перед началом процесса.",
                                "zh": "摄影师在开始冲洗前，在暗房里配制了<w>显影液</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "film developer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая жидкость, используемая для обработки фотопленки или бумаги, чтобы сделать изображение видимым.",
                        "zh": "用于处理摄影胶片或相纸以使影像显现的化学液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявитель",
                                "target_lang_sense_clarification": "фотография"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显影液",
                                "target_lang_sense_clarification": "摄影化学品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}