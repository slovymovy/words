                        "entry_id": "0f8e6dd6-db22-360b-baf8-8126bfb65fd9",
                        "glosses": [
                            "Assistance d’urgence pratiquée par des personnes ayant des connaissances nécessaires et maitrisant les techniques pour sauver des accidentés ou des personnes dont la vie est en danger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d48ca1-eaf1-4c5e-8d43-f51347860c0a",
                                "sense_id": "66f073b2-7fa9-37e9-8208-3b4c18581db3",
                                "text": "Les associations de secourisme sont des auxiliaires des pouvoirs publics."
                            },
                            {
                                "example_id": "cffdea0e-d09c-4853-872a-126825a69b2f",
                                "sense_id": "66f073b2-7fa9-37e9-8208-3b4c18581db3",
                                "text": "Connaître les bases du secourisme est indispensable pour tout citoyen souhaitant pouvoir assurer sa propre sécurité et celle de ses proches."
                            }
                        ]
                    }
                ],
