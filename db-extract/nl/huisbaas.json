                    {
                        "sense_id": "7d44d7fd-83d8-3286-8dee-33a370497d48",
                        "entry_id": "300f3d17-954b-3f6a-82c4-2eb031a45e21",
                        "glosses": [
                            "a landlord, who rents a home he owns, or room(s) in it, to one or more tenants"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ab10580f-8da6-47a8-b97b-9dba4fe95280",
                                "sense_id": "7d44d7fd-83d8-3286-8dee-33a370497d48",
                                "text": "De huisbaas heeft de huurprijs van het appartement verhoogd.",
                                "translation": "The landlord increased the rent for the apartment.",
                                "english": "The landlord increased the rent for the apartment."
                            },
                            {
                                "example_id": "4596eba5-51c8-4270-b263-3227639e9c13",
                                "sense_id": "7d44d7fd-83d8-3286-8dee-33a370497d48",
                                "text": "De nieuwe huisbaas is erg behulpzaam en zorgt goed voor het pand.",
                                "translation": "The new landlord is very helpful and takes good care of the property.",
                                "english": "The new landlord is very helpful and takes good care of the property."
                            },
                            {
                                "example_id": "5657aa65-f2cc-4c23-aaa6-36257f790f69",
                                "sense_id": "7d44d7fd-83d8-3286-8dee-33a370497d48",
                                "text": "De huisbaas heeft aangekondigd dat er renovaties in het gebouw zullen plaatsvinden.",
                                "translation": "The landlord announced that there will be renovations in the building.",
                                "english": "The landlord announced that there will be renovations in the building."
                            }
                        ]
                    }
                ],
