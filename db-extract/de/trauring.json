                        "entry_id": "f7ab5ee9-3fd1-3b1d-b2de-bed500986b2d",
                        "glosses": [
                            "Fingerring, der ein Symbol für die Ehe darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26930c8-bbde-4ff5-af49-85393a524a8d",
                                "sense_id": "d437281a-33b3-3d57-8382-274b18ed92cf",
                                "text": "Der Bräutigam steckte ihr den Trauring an."
                            },
                            {
                                "example_id": "a27076de-aebd-44db-b95f-4564a2aa1dc4",
                                "sense_id": "d437281a-33b3-3d57-8382-274b18ed92cf",
                                "text": "„Pierre zog hastig seinen Geldbeutel und seine Uhr hervor, konnte aber den Trauring lange nicht von dem feisten Finger herunterbekommen.“"
                            }
                        ],
