                    {
                        "sense_id": "3515e5c1-d363-3f63-9eb3-dc3ed0fe18a0",
                        "entry_id": "f20b2ed0-7675-3a9f-9259-4cd0b739082a",
                        "glosses": [
                            "Endoscope souple constitué de fibres optiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8faa01-3c7b-48d5-9ca5-8d7b47f1e156",
                                "sense_id": "3515e5c1-d363-3f63-9eb3-dc3ed0fe18a0",
                                "text": "Un fibroscope est un appareil flexible fait de fibres optiques qui comporte une lentille à une extrémité et un oculaire à l’autre. Il est utilisé pour inspecter des espaces restreints."
                            },
                            {
                                "example_id": "01151170-b187-4b7b-bc31-2a5b2f3ea5d1",
                                "sense_id": "3515e5c1-d363-3f63-9eb3-dc3ed0fe18a0",
                                "text": "Le fibroscope est une variété d’endoscope souple (système lumineux constitué de fibres de verre possédant la propriété de conduire les rayons lumineux) destiné à explorer certains conduits, certaines cavités du corps comme l’œsophage, les bronches, le duodénum, le canal cholédoque, le colon, la vessie etc…"
                            }
                        ]
                    }
                ],
