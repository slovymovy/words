                        "sense_id": "a853f877-d398-3824-92c5-2f2e485b74ab",
                        "entry_id": "7a5b8864-b048-35a4-abcb-7c0d52853687",
                        "glosses": [
                            "Petite causerie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d6c9b4-9eb3-4031-9223-ea096d32eaac",
                                "sense_id": "a853f877-d398-3824-92c5-2f2e485b74ab",
                                "text": "Mais Fromentel feignit de regarder ailleurs. Au coucher, il témoigna pareille indulgence, tolérant les causettes longtemps après l’extinction des feux."
                            },
                            {
                                "example_id": "137a8e12-5932-4d52-adcc-87e4b3cf4869",
                                "sense_id": "a853f877-d398-3824-92c5-2f2e485b74ab",
                                "text": "Personne ne m'attendait, ni femme, ni fille pour un brin de causette ou d'inconduite, comme on voudra."
                            },
                            {
                                "example_id": "df21ec1c-57b1-4c73-a0ce-564c77d1df2d",
                                "sense_id": "a853f877-d398-3824-92c5-2f2e485b74ab",
                                "text": "Le haut-parleur avait interpellé Aldo, isolé comme un naufragé sur un océan d’inconscience, en pleine causette avec son nouveau pote."
                            },
                            {
                                "example_id": "5c6fb90a-5f64-4db6-a374-77c9de592253",
                                "sense_id": "a853f877-d398-3824-92c5-2f2e485b74ab",
                                "text": "Juste le vrombissement sourd de tous les amphibiens du quartier, venus taper la causette sur le perron."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa1384cf-a058-3c55-b194-3429d22989cd",
                        "entry_id": "7a5b8864-b048-35a4-abcb-7c0d52853687",
                        "glosses": [
                            "Communication informelle entre plusieurs personnes sur l'internet, par échange de messages affichés sur leurs écrans."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
