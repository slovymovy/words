                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969b83a7-0c03-4e12-8d3b-c2779b41bb0e",
                                "sense_id": "7ebd6c90-bbe5-3b4f-91ed-11aba30882df",
                                "text": "„Im Mittelpunkt stand jedoch der neue Wein- und Sektjahrgang, der präsentiert wurde.“"
                            },
                            {
                                "example_id": "95379858-3384-4b46-8e64-6797ec104782",
                                "sense_id": "7ebd6c90-bbe5-3b4f-91ed-11aba30882df",
                                "text": "„Weil uns das Ergebnis so überzeugt hat, ist unser nächster Sektjahrgang bereits im Werden.“"
                            },
                            {
                                "example_id": "cd88b4fb-9560-42e7-92b8-eeb3d54555cc",
                                "sense_id": "7ebd6c90-bbe5-3b4f-91ed-11aba30882df",
                                "text": "„Einige Sektjahrgänge werden Florian Lauer und seine Kolleginnen und Kollegen noch produzieren, denn Experten erwarten, dass es bis zu sechs Jahre dauern kann, bis der Rechtsstreit auch vor dem Europäischen Gerichtshof in Luxemburg landet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
