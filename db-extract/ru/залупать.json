                "senses": [
                    {
                        "sense_id": "4be3c413-4221-3477-afd2-2ed978400efe",
                        "entry_id": "020bebc1-9fb4-3cf8-82bf-c66137a99fb8",
                        "glosses": [
                            "устар. то же, что залуплять; лупя, задирать, отгибать (кору, кожицу и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fd635e-b4db-4bd1-bd2f-c25dcf10ba7e",
                                "sense_id": "4be3c413-4221-3477-afd2-2ed978400efe",
                                "text": "Ноготь залупила."
                            }
                        ]
                    },
                    {
                        "sense_id": "7519d899-51e5-3445-b8bb-cc5358721d0b",
                        "entry_id": "020bebc1-9fb4-3cf8-82bf-c66137a99fb8",
                        "glosses": [
                            "рег. поднимать, заворачивать"
                        ],
                        "tags": [
                            "о платье, рубахе"
                        ],
                        "examples": [
                            {
                                "example_id": "14fce005-3fc7-49d5-abe0-50c66f0763a0",
                                "sense_id": "7519d899-51e5-3445-b8bb-cc5358721d0b",
                                "text": "Залупила платье выше головы."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfcbf99f-dc87-36d6-88da-b9197e8ba16d",
                        "entry_id": "020bebc1-9fb4-3cf8-82bf-c66137a99fb8",
                        "glosses": [
                            "прост., вульг. запрашивать непомерно высокую цену; заламывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eba845b-3cf8-4b7b-864c-18b043174a1d",
                                "sense_id": "dfcbf99f-dc87-36d6-88da-b9197e8ba16d",
                                "text": "Цены безумные за свой дрянной товарец залупаешь, а хату хочешь по халявке снять."
                            }
                        ]
                    },
                    {
                        "sense_id": "013adbf3-6ca6-316d-a7ec-d6671c83ac12",
                        "entry_id": "020bebc1-9fb4-3cf8-82bf-c66137a99fb8",
                        "glosses": [
                            "прост. бран. приставать к кому-либо, вызывая на ссору, драку; задираться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2485087c-1e7b-4acf-97cb-cd7532cab2db",
                                "sense_id": "013adbf3-6ca6-316d-a7ec-d6671c83ac12",
                                "text": "— На кого это ты залупаешь?"
                            }
                        ]
                    }
