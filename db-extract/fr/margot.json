                    },
                    {
                        "translation_id": "f4f2e6f6-3205-4007-9e20-9e7fa9ffbbe0",
                        "source_entry_id": "b6630a3e-2c67-3a2b-bde0-01fdf74255cf",
                        "target_lang_word": "Małgorzata",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Małgorzata",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f480a387-0a49-3152-8c10-f425577724a7",
                                        "entry_id": "f8870223-bc38-312a-9818-fd3fcc0129c6",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f925e6-9c50-4b93-b558-9c962bd36b87",
                                                "sense_id": "f480a387-0a49-3152-8c10-f425577724a7",
                                                "text": "Moja pani od chemii ma na imię Małgorzata."
                                            },
                                            {
                                                "example_id": "7acb74fc-0f16-4420-86b1-fcf1ac71771d",
                                                "sense_id": "f480a387-0a49-3152-8c10-f425577724a7",
                                                "text": "Na biurku Małgorzaty pojawiły się przybory do pisania."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "eb84390d-285f-3960-9c0d-292604d1d394",
                "word": "margot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d4aee71a-f196-423b-9c31-f0e212bdac0d",
                        "entry_id": "eb84390d-285f-3960-9c0d-292604d1d394",
                        "tags": [
                            "plural"
                        ],
                        "form": "margots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0dbf0fb-1be9-331f-b09c-bc98a7f79c72",
                        "entry_id": "eb84390d-285f-3960-9c0d-292604d1d394",
                        "glosses": [
                            "Pie bavarde."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a56573f5-c5b8-4d28-a223-c08f9add5093",
                                "sense_id": "d0dbf0fb-1be9-331f-b09c-bc98a7f79c72",
                                "text": "Il n’eut pas de peine à faire entendre ses intentions à son premier ministre : mais il en aurait eu d’infinies à les exprimer, sans le secours des perroquets et des pies, vulgairement appelées margots."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f3f53bb-d832-3aff-8796-4d7e5ae1f4a4",
                        "entry_id": "eb84390d-285f-3960-9c0d-292604d1d394",
                        "glosses": [
                            "Femme bavarde (comme une pie)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6c91fcf7-817f-4aed-b992-ee1c4e9f5cad",
                                "sense_id": "0f3f53bb-d832-3aff-8796-4d7e5ae1f4a4",
                                "text": "C’étaient des conseils pratiques sur l’amour, […] toutes sortes d’histoires de margots qui s’étaient bien repenties d’y avoir passé."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae89d442-b52f-34fd-9696-89e0f1586b77",
                        "entry_id": "eb84390d-285f-3960-9c0d-292604d1d394",
                        "glosses": [
                            "Femme aux mœurs légères."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bc3700c8-1b61-4340-bb8c-327c6c0dee35",
                                "sense_id": "ae89d442-b52f-34fd-9696-89e0f1586b77",
                                "text": "Nana grandissait, devenait garce. À quinze ans, elle avait poussé comme un veau, très blanche de chair, très grasse, si dodue même qu’on aurait dit une pelote. Oui, c’était ça, quinze ans, toutes ses dents et pas de corset. Une vraie frimousse de margot."
                            },
                            {
                                "example_id": "8cdc84da-deab-439c-bef8-6bf5e5e5eab0",
                                "sense_id": "ae89d442-b52f-34fd-9696-89e0f1586b77",
                                "text": "Nous savons où demeure sa margot; et s'il disait quelque chose, nous le menacerions d'éventer la mèche."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
