                            "comparative"
                        ],
                        "form": "more rapidly"
                    },
                    {
                        "form_id": "3f949fbf-96de-4461-b821-1ce588c80233",
                        "entry_id": "d72a8b9c-ffb1-34c1-b726-7798ae9cd0a9",
