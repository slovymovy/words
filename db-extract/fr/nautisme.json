                                    {
                                        "sense_id": "2b3f5d10-243e-304c-b23d-69a8c6568696",
                                        "entry_id": "84151460-90fc-3ba7-859d-9b658058747f",
                                        "glosses": [
                                            "Sportart, die im Wasser ausgeübt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b8140e-60dd-47b5-98ab-badd84cda8ef",
                                                "sense_id": "2b3f5d10-243e-304c-b23d-69a8c6568696",
                                                "text": "„Er zog sich also nach Havre zurück, kaufte eine Barke und wurde aus Liebhaberei Schiffer. Seine beiden Söhne, Hans und Peter, blieben in Paris, ihre Studien fortzusetzen, und kamen nur von Zeit zu Zeit in den Ferien, um an dem Wassersport ihres Vaters Teil zu nehmen.“"
                                            },
                                            {
                                                "example_id": "0a10d75d-64ef-40fb-9fe0-facf1cb2ab76",
                                                "sense_id": "2b3f5d10-243e-304c-b23d-69a8c6568696",
                                                "text": "„Auch von der Moselbevölkerung selbst wird der Wassersport sehr gepflegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
