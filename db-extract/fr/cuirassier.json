                        "sense_id": "43fe6408-e673-32aa-9f5d-11ae461d86f0",
                        "entry_id": "68ef20dd-226b-31ab-9938-3310f45aaeab",
                        "glosses": [
                            "Cavalier armé d’une cuirasse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                        "entry_id": "68ef20dd-226b-31ab-9938-3310f45aaeab",
                        "glosses": [
                            "Soldat d’un corps de cavalerie lourde dont la cuirasse et le casque étaient d’acier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe9484f-f3d2-4d7f-ab2f-b4282d9a23ce",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Un régiment de cuirassiers."
                            },
                            {
                                "example_id": "d0ce3edb-96a3-41bd-842d-b97f8be6dadc",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Capitaine de cuirassiers."
                            },
                            {
                                "example_id": "2f8f6ffd-8c3a-4735-b932-c7e677277757",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Une charge de cuirassiers."
                            },
                            {
                                "example_id": "63187f46-06bd-43a2-9548-7cdae6e39f1f",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Des tentes d’un régiment de ligne, je passais aux tentes d’un bataillon de chasseurs de Vincennes; je tombais d’un escadron de cuirassiers dans un escadron de hussards; je me perdais entre des batteries dont les canons luisaient au soleil."
                            },
                            {
                                "example_id": "744e77f1-73cc-416f-a0ae-c959bae28a5d",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Mlle Berthe, toute rougissante, osait à peine lever les yeux sur le beau lieutenant de cuirassiers."
                            },
                            {
                                "example_id": "8c602c6b-ac1d-4a26-b33b-779027434efb",
                                "sense_id": "dce06bc1-4728-31c0-9d73-52799dc0ea1a",
                                "text": "Maillat pensa tout d’un coup à une bande d’actualités qu’il avait vue, dans un cinéma avant la guerre. Sur l’écran un journaliste interviewait le dernier survivant des cuirassiers de Reichschoffen."
                            }
                        ]
                    }
