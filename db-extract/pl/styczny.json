                                    },
                                    {
                                        "sense_id": "fb5223e3-8532-3cc5-9d88-21a08ec196db",
                                        "entry_id": "6231b282-afcb-30a4-a9b3-aefb5c8285b2",
                                        "glosses": [
                                            "Straight; not horizontally curved."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c7a940-0058-4fde-a5c7-98396653e480",
                                                "sense_id": "fb5223e3-8532-3cc5-9d88-21a08ec196db",
                                                "text": "The collision occurred on a two-mile stretch of tangent track."
                                            }
                                        ]
