                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "villainy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d812aa46-6b5b-3c71-93f0-3f1b283bb317",
                                        "entry_id": "1e37dcf5-3edb-3151-9907-a98c428edc38",
                                        "glosses": [
                                            "Characteristic of a villain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ddd1a1-bdfd-49f0-84e9-2ec32eaf7d89",
                                                "sense_id": "d812aa46-6b5b-3c71-93f0-3f1b283bb317",
                                                "text": "We are all villainy— very villainy, as I am a Christian man."
                                            },
                                            {
                                                "example_id": "8a86f0c4-0a0b-4975-9e80-55b163898929",
                                                "sense_id": "d812aa46-6b5b-3c71-93f0-3f1b283bb317",
                                                "text": "Apparently, in both domestic and foreign movies, you can't get too villainy to displease an audience."
                                            },
                                            {
                                                "example_id": "1788a269-5d94-4ff2-842a-63520e6a20f0",
                                                "sense_id": "d812aa46-6b5b-3c71-93f0-3f1b283bb317",
                                                "text": "Yet here, actual reality offers you the worst villain ever and you say, sorry, he is too villainy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
