                ],
                "senses": [
                    {
                        "sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                        "entry_id": "c092811a-dd01-3eed-8e19-ad454df69293",
                        "glosses": [
                            "повторно изготовленный экземпляр оригинального документа, предмета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea63eb2-7bc4-4aa9-90c9-5e455f554cf2",
                                "sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                                "text": "― У меня же ваш ключ, дубликат есть."
                            },
                            {
                                "example_id": "f747c757-1215-43d8-9944-5614d5d706fe",
                                "sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                                "text": "Скорее это не копии, а дубликаты, ибо подписи лиц, производивших обыски, сделаны не через копирку, а непосредственно химическим карандашом."
                            },
                            {
                                "example_id": "ea74446d-a361-46f6-9dd8-d58c19d301f9",
                                "sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                                "text": "Вера сидит у меня, переписывает на машинке некоторые мои вещи, чтобы были дубликаты."
                            },
                            {
                                "example_id": "72e4714a-633a-4ca0-8a0b-152d7a431a1c",
                                "sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                                "text": "Конечно, японский флот пострадал много, и как лучшее доказательство этого служит заказ Японией ста восьми дубликатов броневых плит в Англии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13aae555-0b66-4f15-8435-6abfb9701965",
                        "source_entry_id": "c092811a-dd01-3eed-8e19-ad454df69293",
                        "source_sense_id": "762781db-0f38-34f7-a24f-d2faee097ceb",
                        "target_lang_word": "duplicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
